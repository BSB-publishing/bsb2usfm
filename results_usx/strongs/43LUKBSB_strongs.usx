  <para style="p"> <verse style="v" number="32" /><char style="w" strong="G1161">Meanwhile</char> <char style="w" strong="G4074">Peter</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3588">his companions</char> <char style="w" strong="G1510">were</char> <char style="w" strong="G916">overcome</char> <char style="w" strong="G5258">by sleep</char>, <char style="w" strong="G1161">but</char> <char style="w" strong="G1235">when they awoke</char>, <char style="w" strong="G3708">they saw</char> <char style="w" strong="G846">Jesus’</char> <char style="w" strong="G1391">glory</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G1417">two</char> <char style="w" strong="G435">men</char> <char style="w" strong="G4921">standing with</char> <char style="w" strong="G846">Him</char>. <verse style="v" number="33" /><char style="w" strong="G2532">As</char> <char style="w" strong="G846">Moses and Elijah</char> <char style="w" strong="G1316">were leaving</char>, <char style="w" strong="G4074">Peter</char> <char style="w" strong="G2036">said</char> <char style="w" strong="G4314">to</char> <char style="w" strong="G2424">Jesus</char>, “<char style="w" strong="G1988">Master</char>, <char style="w" strong="G1510">it is</char> <char style="w" strong="G2570">good</char> <char style="w" strong="G1473">for us</char> <char style="w" strong="G1510">to be</char> <char style="w" strong="G5602">here</char>. <char style="w" strong="G4160">Let us put up</char> <char style="w" strong="G5140">three</char> <char style="w" strong="G4633">shelters</char><note style="f" caller="+"><char style="fr">9:33 </char><char style="ft">Or </char><char style="fqa">three tabernacles</char></note>— <char style="w" strong="G1520">one</char> <char style="w" strong="G4771">for You</char>, <char style="w" strong="G1520">one</char> <char style="w" strong="G3475">for Moses</char>, <char style="w" strong="G2532">and</char> <char style="w" s