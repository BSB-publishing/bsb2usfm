  <para style="p"> <verse style="v" number="24" /><char style="wj"><char style="w" strong="G3752">When</char> <char style="w" strong="G169">an unclean</char> <char style="w" strong="G4151">spirit</char> <char style="w" strong="G1831">comes out</char> <char style="w" strong="G575">of</char> <char style="w" strong="G444">a man</char>, <char style="w" strong="G1330">it passes</char> <char style="w" strong="G1223">through</char> <char style="w" strong="G504">arid</char> <char style="w" strong="G5117">places</char> <char style="w" strong="G2212">seeking</char> <char style="w" strong="G372">rest</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G2147">does not find it</char>. <char style="w" strong="G5119">Then</char> <char style="w" strong="G3004">it says</char>, ‘<char style="w" strong="G5290">I will return</char> <char style="w" strong="G1519">to</char> <char style="w" strong="G1473">the</char> <char style="w" strong="G3624">house</char> <char style="w" strong="G1831">I left</char>.’ <verse style="v" number="25" /><char style="w" strong="G2064">On its return</char>, <char style="w" strong="G2147">it finds the house</char> <char style="w" strong="G4563">swept clean</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G2885">put in order</char>. <verse style="v" number="26" /><char style="w" strong="G5119">Then</char> <char style="w" strong="G4198">it goes</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3880">brings</char> <char style="w" strong="G2033">seven</char> <char style="w" strong="G2087">other</char> <char style="w" strong="G4151">spirits</char> <char style="w" strong="G4190">more wicked</char> <char style="w" strong="G1438">than itself</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G1525">they go in</char> <char style="w" strong="G2730">and dwell</char> <char style="w" strong="G1563">there</char>. <char style="w" strong="G2532">And</char> <char style="w" strong="G358