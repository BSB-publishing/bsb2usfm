  <para style="p"> <verse style="v" number="34" /><char style="w" strong="G1161">While</char> <char style="w" strong="G846">Peter</char> <char style="w" strong="G3004">was speaking</char>, <char style="w" strong="G3507">a cloud</char> <char style="w" strong="G1096">appeared</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G1982">enveloped</char> <char style="w" strong="G846">them</char>, <char style="w" strong="G1161">and</char> <char style="w" strong="G5399">they were afraid</char> <char style="w" strong="G1722">as</char> <char style="w" strong="G846">they</char> <char style="w" strong="G1525">entered</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3507">cloud</char>. <verse style="v" number="35" /><char style="w" strong="G2532">And</char> <char style="w" strong="G5456">a voice</char> <char style="w" strong="G1096">came</char> <char style="w" strong="G1537">from</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3507">cloud</char>, <char style="w" strong="G3004">saying</char>, “<char style="w" strong="G3778">This</char> <char style="w" strong="G1510">is</char> <char style="w" strong="G1473">My</char> <char style="w" strong="G5207">Son</char>, <char style="w" strong="G1586">whom I have chosen</char>.<note style="f" caller="+"><char style="fr">9:35 </char><char style="ft">BYZ and TR </char><char style="fqa">This is My beloved Son</char><char style="ft">; see <ref loc="MAT 17:5">Matthew 17:5</ref>.</char></note> <char style="w" strong="G191">Listen</char> <char style="w" strong="G846">to Him</char>!”</para>
  <para style="p"> <verse style="v" number="36" /><char style="w" strong="G2532">After</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G5456">voice</char> <char style="w" strong="G1096">had spoken</char>, <char style="w" strong="G3441">only</char> <char style="w" strong="G2424">Jesus</char> <char style="w" strong="G2147">was present with them</char>. <char style="w" strong="G846">The disciples</char> <char style="w" strong="G4601">kept this to themselves</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G1565">those</char> <char style="w" strong="G2250">days</char> <char style="w" strong="G518">they did not tell anyone</char> <char style="w" strong="G3739">what</char> <char style="w" strong="G3708">they had seen</char>.</para>
