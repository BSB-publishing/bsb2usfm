char>. <verse style="v" number="30" /><char style="w" strong="G1325">Give</char> <char style="w" strong="G3956">to everyone who</char> <char style="w" strong="G154">asks</char> <char style="w" strong="G4771">you</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G3588">if anyone</char> <char style="w" strong="G142">takes</char> <char style="w" strong="G3588">what is</char> <char style="w" strong="G4674">yours</char>, <char style="w" strong="G3361">do not</char> <char style="w" strong="G523">demand it back</char>. <verse style="v" number="31" /><char style="w" strong="G4160">Do</char> <char style="w" strong="G846">to others</char> <char style="w" strong="G2531">as</char> <char style="w" strong="G2309">you would have</char> <char style="w" strong="G444">them</char> <char style="w" strong="G4160">do</char> <char style="w" strong="G4771">to you</char>.</char></para>
  <para style="p"> <verse style="v" number="32" /><char style="wj"><char style="w" strong="G1487">If</char> <char style="w" strong="G25">you love</char> <char style="w" strong="G3588">those who</char> <char style="w" strong="G25">love</char> <char style="w" strong="G4771">you</char>, <char style="w" strong="G4169">what</char> <char style="w" strong="G5485">credit</char> <char style="w" strong="G1510">is that</char> <char style="w" strong="G4771">to you</char>? <char style="w" strong="G2532">Even</char> <char style="w" strong="G268">sinners</char> <char style="w" strong="G25">love</char> <char style="w" strong="G3588">those who</char> <char style="w" strong="G25">love</char> <char style="w" strong="G846">them</char>. <verse style="v" number="33" /><char style="w" strong="G1437">If</char> <char style="w" strong="G15">you do good</char> <char style="w" strong="G3588">to those who</char> <char style="w" strong="G15">do good to</char> <char style="w" strong="G4771">you</char>, <char style="w" strong="G4169">what</char> <char style="w" strong="G5485">credit</char> <char style="w" strong="G1510">is that</char> <char style="w" strong="G4771">to you</char>? <char style="w" strong="G2532">Even</char> <char style="w" strong="G268">sinners</char> <char style="w" strong="G4160">do</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G846">same</char>. <verse style="v" number="34" /><char style="w" strong="G2532">And</char> <char style="w" strong="G1437">if</char> <char style="w" strong="G1155">you lend to those</char> <char style="w" strong="G3844">from</char> <char style="w" strong="G3739">whom</char> <char style="w" strong="G1679">you expect</char> <char style="w" strong="G2983">repayment</char>, <char style="w" strong="G4169">what</char> <char style="w" strong="G5485">credit</char> <char style="w" strong="G1510">is that</char> <char style="w" strong="G4771">to you</char>? <char style="w" strong="G2532">Even</char> <char style="w" strong="G268">sinners</cha