  <para style="p"> <verse style="v" number="23" /><char style="wj"><char style="w" strong="G5119">At that time</char>, <char style="w" strong="G1437">if</char> <char style="w" strong="G5100">anyone</char> <char style="w" strong="G2036">says</char> <char style="w" strong="G4771">to you</char>, ‘<char style="w" strong="G2400">Look</char>, <char style="w" strong="G5602">here is</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G5547">Christ</char>!’ <char style="w" strong="G2228">or</char> ‘<char style="w" strong="G5602">There He is</char>!’ <char style="w" strong="G3361">do not</char> <char style="w" strong="G4100">believe it</char>. <verse style="v" number="24" /><char style="w" strong="G1063">For</char> <char style="w" strong="G5580">false Christs</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G5578">false prophets</char> <char style="w" strong="G1453">will appear</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G1325">perform</char> <char style="w" strong="G3173">great</char> <char style="w" strong="G4592">signs</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G5059">wonders</char> <char style="w" strong="G5620">to</char> <char style="w" strong="G4105">deceive</char> <char style="w" strong="G2532">even</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G1588">elect</char>, <char style="w" strong="G1487">if</char> <char style="w" strong="G1415">that were possible</char>. <verse style="v" number="25" /><char style="w" strong="G2400">See</char>, <char style="w" strong="G4302">I have told you in advance</char>.</char></para>
