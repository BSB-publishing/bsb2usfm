  <para style="p"> <verse style="v" number="36" /><char style="wj"><char style="w" strong="G3762">No one</char> <char style="w" strong="G1492">knows</char> <char style="w" strong="G4012">about</char> <char style="w" strong="G1565">that</char> <char style="w" strong="G2250">day</char> <char style="w" strong="G2532">or</char> <char style="w" strong="G5610">hour</char>, <char style="w" strong="G3761">not even</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G32">angels</char> <char style="w" strong="G3772">in heaven</char>, <char style="w" strong="G3761">nor</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G5207">Son</char>,<note style="f" caller="+"><char style="fr">24:36 </char><char style="ft">BYZ and TR do not include </char><char style="fqa">nor the Son</char><char style="ft">.</char></note> <char style="w" strong="G1487">but</char> <char style="w" strong="G3441">only</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3962">Father</char>. <verse style="v" number="37" /><char style="w" strong="G5618">As it was</char> <char style="w" strong="G3588">in the</char> <char style="w" strong="G2250">days</char> <char style="w" strong="G3588">of</char> <char style="w" strong="G3575">Noah</char>, <char style="w" strong="G3779">so</char> <char style="w" strong="G1510">will it be</char> <char style="w" strong="G3588">at the</char> <char style="w" strong="G3952">coming</char> <char style="w" strong="G3588">of the</char> <char style="w" strong="G5207">Son</char> <char style="w" strong="G444">of Man</char>. <verse style="v" number="38" /><char style="w" strong="G1063">For</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2250">days</char> <char style="w" strong="G4253">before</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2627">flood</char>, <char style="w" strong="G1510">people were</char> <char style="w" strong="G5176