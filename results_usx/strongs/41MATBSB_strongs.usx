  <para style="p"> <verse style="v" number="23" /><char style="wj"><char style="w" strong="G1161">But</char> <char style="w" strong="G3588">the seed</char> <char style="w" strong="G4687">sown</char> <char style="w" strong="G1909">on</char> <char style="w" strong="G2570">good</char> <char style="w" strong="G1093">soil</char> <char style="w" strong="G1510">is</char> <char style="w" strong="G3588">the one who</char> <char style="w" strong="G191">hears</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3056">word</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G4920">understands it</char>. <char style="w" strong="G3739">He</char> <char style="w" strong="G1211">indeed</char> <char style="w" strong="G2592">bears fruit</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G4160">produces a crop</char> — <char style="w" strong="G1540">a hundredfold</char>, <char style="w" strong="G1835">sixtyfold</char>, <char style="w" strong="G1161">or</char> <char style="w" strong="G5144">thirtyfold</char>.”</char></para>
