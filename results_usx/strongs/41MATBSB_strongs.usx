  <para style="p"> <verse style="v" number="44" /><char style="wj"><char style="w" strong="G5119">And</char> <char style="w" strong="G846">they</char> <char style="w" strong="G2532">too</char> <char style="w" strong="G611">will reply</char>, ‘<char style="w" strong="G2962">Lord</char>, <char style="w" strong="G4219">when</char> <char style="w" strong="G3708">did we see</char> <char style="w" strong="G4771">You</char> <char style="w" strong="G3983">hungry</char> <char style="w" strong="G2228">or</char> <char style="w" strong="G1372">thirsty</char> <char style="w" strong="G2228">or</char> <char style="w" strong="G3581">a stranger</char> <char style="w" strong="G2228">or</char> <char style="w" strong="G1131">naked</char> <char style="w" strong="G2228">or</char> <char style="w" strong="G772">sick</char> <char style="w" strong="G2228">or</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G5438">prison</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G1247">did not minister</char> <char style="w" strong="G4771">to You</char>?’</char></para>
  <para style="p"> <verse style="v" number="45" /><char style="wj"><char style="w" strong="G5119">Then</char> <char style="w" strong="G611">the King will answer</char>, ‘<char style="w" strong="G281">Truly</char> <char style="w" strong="G3004">I tell</char> <char style="w" strong="G4771">you</char>, <char style="w" strong="G1909">whatever</char> <char style="w" strong="G4160">you did not do</char> <char style="w" strong="G1520">for one</char> <char style="w" strong="G3588">of the</char> <char style="w" strong="G1646">least</char> <char style="w" strong="G3778">of these</char>, <char style="w" strong="G4160">you did not do</char> <char style="w" strong="G1473">for Me</char>.’</char></para>
