  <para style="p"> <verse style="v" number="31" /><char style="w" strong="G3908">He put before</char> <char style="w" strong="G846">them</char> <char style="w" strong="G243">another</char> <char style="w" strong="G3850">parable</char>: <char style="wj">“<char style="w" strong="G3588">The</char> <char style="w" strong="G932">kingdom</char> <char style="w" strong="G3588">of</char> <char style="w" strong="G3772">heaven</char> <char style="w" strong="G1510">is</char> <char style="w" strong="G3664">like</char> <char style="w" strong="G4615">a mustard</char> <char style="w" strong="G2848">seed</char> <char style="w" strong="G3739">that</char> <char style="w" strong="G444">a man</char> <char style="w" strong="G2983">took</char> <char style="w" strong="G4687">and planted</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G846">his</char> <char style="w" strong="G68">field</char>. <verse style="v" number="32" /><char style="w" strong="G3303">Although</char> <char style="w" strong="G3739">it</char> <char style="w" strong="G1510">is</char> <char style="w" strong="G3398">the smallest</char> <char style="w" strong="G3956">of all</char> <char style="w" strong="G4690">seeds</char>, <char style="w" strong="G1161">yet</char> <char style="w" strong="G837">it grows into</char> <char style="w" strong="G3173">the largest</char> <char style="w" strong="G3588">of</char> <char style="w" strong="G3001">garden plants</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G1096">becomes</char> <char style="w" strong="G1186">a tree</char>, <char style="w" strong="G5620">so that</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4071">birds</char> <char style="w" strong="G3588">of the</char> <char style="w" strong="G3772">air</char> <char style="w" strong="G2064">come</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G2681">nest</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G846">its</