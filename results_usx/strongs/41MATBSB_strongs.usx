  <para style="p"> <verse style="v" number="27" /><char style="wj"><char style="w" strong="G3588">The</char> <char style="w" strong="G3617">owner’s</char> <char style="w" strong="G1401">servants</char> <char style="w" strong="G4334">came</char> <char style="w" strong="G846">to him</char> <char style="w" strong="G2036">and said</char>, ‘<char style="w" strong="G2962">Sir</char>, <char style="w" strong="G4687">didn’t you sow</char> <char style="w" strong="G2570">good</char> <char style="w" strong="G4690">seed</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G4674">your</char> <char style="w" strong="G68">field</char>? <char style="w" strong="G4159">Where</char> <char style="w" strong="G3767">then</char> <char style="w" strong="G2192">did</char> <char style="w" strong="G2215">the weeds come from</char>?’</char></para>
  <para style="p"> <verse style="v" number="28" /><char style="wj">‘<char style="w" strong="G2190">An enemy</char> <char style="w" strong="G4160">did</char> <char style="w" strong="G3778">this</char>,’ <char style="w" strong="G5346">he replied</char>.</char></para>
  <para style="p"><char style="wj"><char style="w" strong="G1161">So</char> <char style="w" strong="G1401">the servants</char> <char style="w" strong="G3004">asked</char> <char style="w" strong="G846">him</char>, ‘<char style="w" strong="G2309">Do you want</char> <char style="w" strong="G565">us to go and</char> <char style="w" strong="G4816">pull them up</char>?’</char></para>
