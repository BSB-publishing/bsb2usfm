  <para style="r">(<ref loc="MRK 9:42-48">Mark 9:42–48</ref>; <ref loc="LUK 17:1-4">Luke 17:1–4</ref>)</para>
  <para style="p"> <verse style="v" number="6" /><char style="wj"><char style="w" strong="G1161">But</char> <char style="w" strong="G302">if</char> <char style="w" strong="G3739">anyone</char> <char style="w" strong="G4624">causes</char> <char style="w" strong="G1520">one</char> <char style="w" strong="G3778">of these</char> <char style="w" strong="G3398">little ones</char> <char style="w" strong="G3588">who</char> <char style="w" strong="G4100">believe</char> <char style="w" strong="G1519">in</char> <char style="w" strong="G1473">Me to stumble</char>, <char style="w" strong="G4851">it would be better</char> <char style="w" strong="G846">for him</char> <char style="w" strong="G2443">to have</char> <char style="w" strong="G3684">a large</char> <char style="w" strong="G3458">millstone</char> <char style="w" strong="G2910">hung</char> <char style="w" strong="G4012">around</char> <char style="w" strong="G846">his</char> <char style="w" strong="G5137">neck</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G2670">to be drowned</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3989">depths</char> <char style="w" strong="G3588">of the</char> <char style="w" strong="G2281">sea</char>.</char></para>
  <para style="p"> <verse style="v" number="7" /><char style="wj"><char style="w" strong="G3759">Woe</char> <char style="w" strong="G3588">to the</char> <char style="w" strong="G2889">world</char> <char style="w" strong="G575">for</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4625">causes of sin</char>. <char style="w" strong="G3588">These</char> <char style="w" strong="G4625">stumbling blocks</char> <char style="w" strong="G318">must</char> <char style="w" strong="G2064">come</char>, <char style="w" strong="G4133">but</char> <char style="w" strong="G3759">woe</char> <char style="w" strong="G3588">to the</char> <char style="w" strong="G444">man</char> <char style="w" strong="G1223">through</char> <char style="w" strong="G3739">whom</char> <char style="w" strong="G4625">they</char> <char style="w" strong="G2064">come</char>!</char></para>
  <para style="p"> <verse style="v" number="8" /><char style="wj"><char style="w" strong="G1487">If</char> <char style="w" strong="G4771">your</char> <char style="w" strong="G5495">hand</char> <char style="w" strong="G2228">or</char> <char style="w" strong="G4771">your</char> <char style="w" strong="G4228">foot</char> <char style="w" strong="G4624">causes you to sin</char>, <char style="w" strong="G1581">cut it off</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G906">throw it away</char>. <char style="w" strong="G1510">It is</char> <char style="w" strong="G2570">better</char> <char style="w" strong="G4771">for you</char> <char style="w" strong="G1525">to enter</char> <char style="w" strong="G2222">life</char> <char style="w" strong="G2948">crippled</char> <char style="w" strong="G2228">or</char> <char style="w" strong="G5560">lame</char> <char style="w" strong="G2228">than</char> <char style="w" strong="G2192">to have</char> <char style="w" strong="G1417">two</char> <char style="w" strong="G5495">hands</char> <char style="w" strong="G2228">and</char> <char style="w" strong="G1417">two</char> <char style="w" strong="G4228">feet</char> <char style="w" strong="G906">and be thrown</char> <char style="w" strong="G1519">into</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G166">eternal</char> <char style="w" strong="G4442">fire</char>. <verse style="v" number="9" /><char style="w" strong="G2532">And</char> <char style="w" strong="G1487">if</char> <char style="w" strong="G4771">your</char> <char style="w" strong="G3788">eye</char> <char style="w" strong="G4624">causes you to sin</char>, <char style="w" strong="G1807">gouge it out</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G906">throw it away</char>. <char style="w" strong="G1510">It is</char> <char style="w" strong="G2570">better</char> <char style="w" strong="G4771">for you</char> <char style="w" strong="G1525">to enter</char> <char style="w"