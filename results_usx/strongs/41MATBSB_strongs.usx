  <para style="p"> <verse style="v" number="40" /><char style="wj"><char style="w" strong="G2532">And</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G935">King</char> <char style="w" strong="G2046">will reply</char>, ‘<char style="w" strong="G281">Truly</char> <char style="w" strong="G3004">I tell</char> <char style="w" strong="G4771">you</char>, <char style="w" strong="G1909">whatever</char> <char style="w" strong="G4160">you did</char> <char style="w" strong="G1520">for one</char> <char style="w" strong="G3588">of the</char> <char style="w" strong="G1646">least</char> <char style="w" strong="G3778">of these</char> <char style="w" strong="G80">brothers</char> <char style="w" strong="G1473">of Mine</char>, <char style="w" strong="G4160">you did</char> <char style="w" strong="G1473">for Me</char>.’</char></para>
