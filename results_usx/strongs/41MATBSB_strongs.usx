  <para style="p"> <verse style="v" number="37" /><char style="w" strong="G611">He replied</char>, <char style="wj">“<char style="w" strong="G3588">The One</char> <char style="w" strong="G4687">who sows</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2570">good</char> <char style="w" strong="G4690">seed</char> <char style="w" strong="G1510">is</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G5207">Son</char> <char style="w" strong="G444">of Man</char>. <verse style="v" number="38" /><char style="w" strong="G68">The field</char> <char style="w" strong="G1510">is</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2889">world</char>, <char style="w" strong="G1161">and</char> <char style="w" strong="G2570">the good</char> <char style="w" strong="G4690">seed</char> <char style="w" strong="G3778">represents</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G5207">sons</char> <char style="w" strong="G3588">of the</char> <char style="w" strong="G932">kingdom</char>. <char style="w" strong="G2215">The weeds</char> <char style="w" strong="G1510">are</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G5207">sons</char> <char style="w" strong="G3588">of the</char> <char style="w" strong="G4190">evil one</char>, <verse style="v" number="39" /><char style="w" strong="G1161">and</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2190">enemy</char> <char style="w" strong="G4687">who sows</char> <char style="w" strong="G846">them</char> <char style="w" strong="G1510">is</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G1228">devil</char>. <char style="w" strong="G3588">The</char> <char style="w" strong="G2326">harvest</char> <char style="w" strong="G1510">is</char> <char style="w" strong="G4930">the end</char> <char style="w" strong="G165">of the age</char>, <char style="w" strong="G1161">and</char> <char style="w" stro