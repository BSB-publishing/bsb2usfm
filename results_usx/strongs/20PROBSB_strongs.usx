  <para style="q2"><char style="w" strong="H3808">no one</char> <char style="w" strong="H5060">who touches</char> her <char style="w" strong="H5352">will go unpunished</char>.</para>
  <para style="b" />
  <para style="q1"> <verse style="v" number="30" /><char style="w" strong="H3808">Men do not</char> <char style="w" strong="H936">despise</char> <char style="w" strong="H1590">the thief</char></para>
