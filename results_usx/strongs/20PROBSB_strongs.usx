  <para style="q1"> <verse style="v" number="25" /><char style="w" strong="H408">Do not</char> <char style="w" strong="H2530">lust</char> <char style="w" strong="H3824">in your heart</char> <char style="w" strong="H3308">for her beauty</char></para>
  <para style="q2"><char style="w" strong="H3947">or let her captivate you</char> <char style="w" strong="H6079">with her eyes</char>.<note style="f" caller="+"><char style="fr">6:25 </char><char style="ft">Or </char><char style="fqa">eyelids </char><char style="ft">or </char><char style="fqa">eyelashes</char></note></para>
  <para style="q1"> <verse style="v" number="26" /><char style="w" strong="H3588">For</char> <char style="w" strong="H1157">the levy</char> <char style="w" strong="H2181">of the prostitute</char> <char style="w" strong="H3603">is poverty</char>,<note style="f" caller="+"><char style="fr">6:26 </char><char style="ft">Literally </char><char style="fqa">a crust of bread</char></note></para>
  <para style="q2"><char style="w" strong="H802">and the adulteress</char> <char style="w" strong="H6679">preys upon</char> <char style="w" strong="H3368">your very</char> <char style="w" strong="H5315">life</char>.</para>
  <para style="q1"> <verse style="v" number="27" /><char style="w" strong="H376">Can a man</char> <char style="w" strong="H2846">embrace</char> <char style="w" strong="H784">fire</char></para>
  <para style="q2"><char style="w" strong="H899">and his clothes</char> <char style="w" strong="H3808">not</char> <char style="w" strong="H8313">be burned</char>?</para>
