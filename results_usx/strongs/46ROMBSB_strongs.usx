  <para style="p"> <verse style="v" number="5" /><char style="w" strong="G3588">Those</char> <char style="w" strong="G1510">who live</char> <char style="w" strong="G2596">according to</char> <char style="w" strong="G4561">the flesh</char> <char style="w" strong="G5426">set their minds</char> <char style="w" strong="G3588">on the things</char> <char style="w" strong="G3588">of the</char> <char style="w" strong="G4561">flesh</char>; <char style="w" strong="G1161">but</char> <char style="w" strong="G3588">those who live</char> <char style="w" strong="G2596">according to</char> <char style="w" strong="G4151">the Spirit</char> <char style="w" strong="G3588">set their minds on the things</char> <char style="w" strong="G3588">of the</char> <char style="w" strong="G4151">Spirit</char>. <verse style="v" number="6" /><char style="w" strong="G3588">The</char> <char style="w" strong="G5427">mind</char> <char style="w" strong="G3588">of the</char> <char style="w" strong="G4561">flesh</char> <char style="w" strong="G2288">is death</char>, <char style="w" strong="G1161">but</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G5427">mind</char> <char style="w" strong="G3588">of the</char> <char style="w" strong="G4151">Spirit</char> <char style="w" strong="G2222">is life</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G1515">peace</char>, <verse style="v" number="7" /><char style="w" strong="G1360">because</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G5427">mind</char> <char style="w" strong="G3588">of the</char> <char style="w" strong="G4561">flesh</char> <char style="w" strong="G2189">is hostile</char> <char style="w" strong="G1519">to</char> <char style="w" strong="G2316">God</char>: <char style="w" strong="G5293">It does not submit</char> <char style="w" strong="G3588">to</char> <char style="w" strong="G2316">God’s</char> <char style="w" strong="G3551">law</char>, <char style="w" strong="G3761">nor</char>