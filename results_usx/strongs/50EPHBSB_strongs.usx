  <para style="p"> <verse style="v" number="17" /><char style="w" strong="G3767">So</char> <char style="w" strong="G3004">I tell you</char> <char style="w" strong="G3778">this</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G3143">insist on it</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G2962">the Lord</char>, <char style="w" strong="G4771">that you must</char> <char style="w" strong="G3371">no longer</char> <char style="w" strong="G4043">walk</char> <char style="w" strong="G2531">as</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G1484">Gentiles</char> <char style="w" strong="G4043">do</char>, <char style="w" strong="G1722">in</char> <char style="w" strong="G3153">the futility</char> <char style="w" strong="G3588">of</char> <char style="w" strong="G846">their</char> <char style="w" strong="G3563">thinking</char>. <verse style="v" number="18" /><char style="w" strong="G4656">They are darkened</char> <char style="w" strong="G3588">in their</char> <char style="w" strong="G1271">understanding</char> <char style="w" strong="G1510">and</char> <char style="w" strong="G526">alienated from</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2222">life</char> <char style="w" strong="G2316">of God</char> <char style="w" strong="G1223">because of</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G52">ignorance</char> <char style="w" strong="G1510">that is</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G846">them</char> <char style="w" strong="G1223">due to</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4457">hardness</char> <char style="w" strong="G3588">of</char> <char style="w" strong="G846">their</char> <char style="w" strong="G2588">hearts</char>. <verse style="v" number="19" /><char style="w" strong="G524">Having lost all sense of shame</char>, <char style="w" strong="G3748">they</char> <char style=