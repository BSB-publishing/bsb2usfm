  <para style="p"> <verse style="v" number="11" /><char style="w" strong="G1352">Therefore</char> <char style="w" strong="G3421">remember</char> <char style="w" strong="G3754">that</char> <char style="w" strong="G4218">formerly</char> <char style="w" strong="G4771">you</char> <char style="w" strong="G3588">who are</char> <char style="w" strong="G1484">Gentiles</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G4561">the flesh</char> <char style="w" strong="G3004">and called</char> <char style="w" strong="G203">uncircumcised</char> <char style="w" strong="G5259">by</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3004">so-called</char> <char style="w" strong="G4061">circumcision</char> <char style="w" strong="G1722">(that done in</char> <char style="w" strong="G4561">the body</char> <char style="w" strong="G5499">by human hands)</char> — <verse style="v" number="12" /><char style="w" strong="G3754">remember that</char> <char style="w" strong="G3588">at</char> <char style="w" strong="G1565">that</char> <char style="w" strong="G2540">time</char> <char style="w" strong="G1510">you were</char> <char style="w" strong="G5565">separate from</char> <char style="w" strong="G5547">Christ</char>, <char style="w" strong="G526">alienated from</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4174">commonwealth</char> <char style="w" strong="G2474">of Israel</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G3581">strangers</char> <char style="w" strong="G3588">to the</char> <char style="w" strong="G1242">covenants</char> <char style="w" strong="G3588">of the</char> <char style="w" strong="G1860">promise</char>, <char style="w" strong="G3361">without</char> <char style="w" strong="G1680">hope</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G112">without God</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G3588">the</char> <char style="w" s