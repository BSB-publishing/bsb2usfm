  <para style="p"> <verse style="v" number="4" /><char style="w" strong="G1161">But</char> <char style="w" strong="G1223">because of</char> <char style="w" strong="G846">His</char> <char style="w" strong="G4183">great</char> <char style="w" strong="G26">love</char> <char style="w" strong="G3739">for us</char>, <char style="w" strong="G2316">God</char>, <char style="w" strong="G1510">who is</char> <char style="w" strong="G4145">rich</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G1656">mercy</char>, <verse style="v" number="5" /><char style="w" strong="G4806">made us alive with</char> <char style="w" strong="G5547">Christ</char> <char style="w" strong="G2532">even when</char> <char style="w" strong="G1473">we</char> <char style="w" strong="G1510">were</char> <char style="w" strong="G3498">dead</char> <char style="w" strong="G3588">in our</char> <char style="w" strong="G3900">trespasses</char>. <char style="w" strong="G5485">It is by grace</char> <char style="w" strong="G1510">you have been</char> <char style="w" strong="G4982">saved</char>! <verse style="v" number="6" /><char style="w" strong="G2532">And</char> <char style="w" strong="G4891">God raised us up with Christ</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G4776">seated us with Him</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2032">heavenly realms</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G5547">Christ</char> <char style="w" strong="G2424">Jesus</char>, <verse style="v" number="7" /><char style="w" strong="G2443">in order that</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G1904">coming</char> <char style="w" strong="G165">ages</char> <char style="w" strong="G1731">He might display</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G5235">surpassing</char> <char style="w"