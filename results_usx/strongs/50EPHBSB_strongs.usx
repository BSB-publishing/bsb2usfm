  <para style="p"> <verse style="v" number="19" /><char style="w" strong="G686">Therefore</char> <char style="w" strong="G1510">you are</char> <char style="w" strong="G3765">no longer</char> <char style="w" strong="G3581">strangers</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3941">foreigners</char>, <char style="w" strong="G235">but</char> <char style="w" strong="G4847">fellow citizens</char> <char style="w" strong="G3588">with the</char> <char style="w" strong="G40">saints</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3609">members of God’s household</char>, <verse style="v" number="20" /><char style="w" strong="G2026">built</char> <char style="w" strong="G1909">on</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2310">foundation</char> <char style="w" strong="G3588">of the</char> <char style="w" strong="G652">apostles</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G4396">prophets</char>, <char style="w" strong="G5547">with Christ</char> <char style="w" strong="G2424">Jesus</char> <char style="w" strong="G846">Himself</char> <char style="w" strong="G1510">as</char> <char style="w" strong="G204">the cornerstone</char>. <verse style="v" number="21" /><char style="w" strong="G1722">In</char> <char style="w" strong="G3739">Him</char> <char style="w" strong="G3956">the whole</char> <char style="w" strong="G3619">building</char> <char style="w" strong="G4883">is fitted together</char> <char style="w" strong="G837">and grows</char> <char style="w" strong="G1519">into</char> <char style="w" strong="G40">a holy</char> <char style="w" strong="G3485">temple</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G2962">the Lord</char>. <verse style="v" number="22" /><char style="w" strong="G1722">And in</char> <char style="w" strong="G3739">Him</char> <char style="w" strong="G4771">you</char> <char style="w" strong="G2532">too are</char> <char style="w"