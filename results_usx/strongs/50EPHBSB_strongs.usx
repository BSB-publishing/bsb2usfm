  <para style="p"> <verse style="v" number="8" /><char style="w" strong="G1063">For it is</char> <char style="w" strong="G5485">by grace</char> <char style="w" strong="G1510">you have been</char> <char style="w" strong="G4982">saved</char> <char style="w" strong="G1223">through</char> <char style="w" strong="G4102">faith</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G3778">this</char> <char style="w" strong="G3756">not</char> <char style="w" strong="G1537">from</char> <char style="w" strong="G4771">yourselves</char>; <char style="w" strong="G3588">it is the</char> <char style="w" strong="G1435">gift</char> <char style="w" strong="G2316">of God</char>, <verse style="v" number="9" /><char style="w" strong="G3756">not</char> <char style="w" strong="G1537">by</char> <char style="w" strong="G2041">works</char>, <char style="w" strong="G2443">so that</char> <char style="w" strong="G3361">no</char> <char style="w" strong="G5100">one</char> <char style="w" strong="G2744">can boast</char>. <verse style="v" number="10" /><char style="w" strong="G1063">For</char> <char style="w" strong="G1510">we are</char> <char style="w" strong="G846">God’s</char> <char style="w" strong="G4161">workmanship</char>, <char style="w" strong="G2936">created</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G5547">Christ</char> <char style="w" strong="G2424">Jesus</char> <char style="w" strong="G1909">to do</char> <char style="w" strong="G18">good</char> <char style="w" strong="G2041">works</char>, <char style="w" strong="G3739">which</char> <char style="w" strong="G2316">God</char> <char style="w" strong="G4282">prepared in advance</char> <char style="w" strong="G2443">as</char> <char style="w" strong="G4043">our way of life</char>.<note style="f" caller="+"><char style="fr">2:10 </char><char style="ft">Literally </char><char style="fqa">which God prepared beforehand, that we should walk in them.</char></note></para>
