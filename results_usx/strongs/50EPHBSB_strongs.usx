  <para style="p"> <verse style="v" number="30" /><char style="w" strong="G2532">And</char> <char style="w" strong="G3361">do not</char> <char style="w" strong="G3076">grieve</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G40">Holy</char> <char style="w" strong="G4151">Spirit</char> <char style="w" strong="G2316">of God</char>, <char style="w" strong="G1722">in</char> <char style="w" strong="G3739">whom</char> <char style="w" strong="G4972">you were sealed</char> <char style="w" strong="G1519">for</char> <char style="w" strong="G2250">the day</char> <char style="w" strong="G629">of redemption</char>.</para>
