  <para style="q2"><char style="w" strong="G575">from</char> <char style="w" strong="G3398">[the] least</char> <char style="w" strong="G846">of them</char> <char style="w" strong="G2193">to</char> <char style="w" strong="G3173">[the] greatest</char>.</para>
  <para style="q1"> <verse style="v" number="12" /><char style="w" strong="G3754">For</char> <char style="w" strong="G1510">I will</char> <char style="w" strong="G3588">vvv</char> <char style="w" strong="G2436">forgive</char> <char style="w" strong="G846">their</char> <char style="w" strong="G93">iniquities</char></para>
