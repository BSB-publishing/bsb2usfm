  <para style="q2"><char style="w" strong="G3326">after</char> <char style="w" strong="G1565">those</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2250">days</char>, <char style="w" strong="G3004">declares</char> <char style="w" strong="G2962">[the] Lord</char>.</para>
  <para style="q1"><char style="w" strong="G1325">I will put</char> <char style="w" strong="G1473">My</char> <char style="w" strong="G3551">laws</char> <char style="w" strong="G1909">in</char> <char style="w" strong="G846">their</char> <char style="w" strong="G2588">hearts</char></para>
