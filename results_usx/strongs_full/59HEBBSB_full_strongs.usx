  <para style="p"> <verse style="v" number="11" /><char style="w" strong="G2532">-</char> <char style="w" strong="G3303">-</char> <char style="w" strong="G2596">vvv</char> <char style="w" strong="G2250">Day after day</char> <char style="w" strong="G3956">every</char> <char style="w" strong="G2409">priest</char> <char style="w" strong="G2476">stands</char> <char style="w" strong="G3008">to minister</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G4374">to offer</char> <char style="w" strong="G4178">again and again</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G846">same</char> <char style="w" strong="G2378">sacrifices</char>, <char style="w" strong="G3748">which</char> <char style="w" strong="G1410">can</char> <char style="w" strong="G3763">never</char> <char style="w" strong="G4014">take away</char> <char style="w" strong="G266">sins</char>. <verse style="v" number="12" /><char style="w" strong="G1161">But [when]</char> <char style="w" strong="G3778">this [Priest]</char> <char style="w" strong="G4374">had offered</char> <char style="w" strong="G1519">vvv</char> <char style="w" strong="G3588">vvv</char> <char style="w" strong="G1336">for all time</char> <char style="w" strong="G1520">one</char> <char style="w" strong="G2378">sacrifice</char> <char style="w" strong="G5228">for</char> <char style="w" strong="G266">sins</char>, <char style="w" strong="G2523">He sat down</char> <char style="w" strong="G1722">at</char> <char style="w" strong="G1188">[the] right hand</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2316">of God</char>. <verse style="v" number="13" /><char style="w" strong="G3588">vvv</char> <char style="w" strong="G3063">Since that time</char>, <char style="w" strong="G1551">He waits</char> <char style="w" strong="G2193">for</char> <char style="w" strong="G846">His</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2190">enemies</char> <char style="w" strong="G5