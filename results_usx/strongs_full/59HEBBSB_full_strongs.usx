  <para style="p"> <verse style="v" number="7" /><char style="w" strong="G1063">For</char> <char style="w" strong="G1093">land</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4095">that drinks in</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G5205">rain</char> <char style="w" strong="G4178">often</char> <char style="w" strong="G2064">falling</char> <char style="w" strong="G1909">on</char> <char style="w" strong="G846">it</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G5088">that produces</char> <char style="w" strong="G1008">a crop</char> <char style="w" strong="G2111">useful</char> <char style="w" strong="G1565">to those</char> <char style="w" strong="G1223">for</char> <char style="w" strong="G3739">whom</char> <char style="w" strong="G2532">-</char> <char style="w" strong="G1090">it is tended</char> <char style="w" strong="G3335">receives</char> <char style="w" strong="G2129">[the] blessing</char> <char style="w" strong="G575">of</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2316">God</char>. <verse style="v" number="8" /><char style="w" strong="G1161">But</char> <char style="w" strong="G1627">[land that] produces</char> <char style="w" strong="G173">thorns</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G5146">thistles</char> <char style="w" strong="G96">[is] worthless</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G2671">[its] curse</char> <char style="w" strong="G1451">is imminent</char>. <char style="w" strong="G3739">[In]</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G5056">end</char> <char style="w" strong="G1519">vvv</char> <char style="w" strong="G2740">it will be burned</char>.</para>
