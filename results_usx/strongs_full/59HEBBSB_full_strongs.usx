  <para style="s1">The Faith of Many</para>
  <para style="r">(<ref>Joshua–Malachi</ref>)</para>
  <para style="p"> <verse style="v" number="30" /><char style="w" strong="G4102">By faith</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G5038">walls</char> <char style="w" strong="G2410">of Jericho</char> <char style="w" strong="G4098">fell</char>, <char style="w" strong="G2944">after [the people] had marched around them</char> <char style="w" strong="G1909">for</char> <char style="w" strong="G2033">seven</char> <char style="w" strong="G2250">days</char>.</para>
  <para style="p"> <verse style="v" number="31" /><char style="w" strong="G4102">By faith</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4204">prostitute</char> <char style="w" strong="G4460">Rahab</char>, <char style="w" strong="G1209">because she welcomed</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2685">spies</char> <char style="w" strong="G3326">in</char> <char style="w" strong="G1515">peace</char>, <char style="w" strong="G3756">vvv</char> <char style="w" strong="G4881">did not perish with</char> <char style="w" strong="G3588">those who</char> <char style="w" strong="G544">were disobedient</char>.</para>
  <para style="p"> <verse style="v" number="32" /><char style="w" strong="G2532">And</char> <char style="w" strong="G5101">what</char> <char style="w" strong="G2089">more</char> <char style="w" strong="G3004">shall I say</char>? <char style="w" strong="G1063">-</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G5550">Time</char> <char style="w" strong="G1952">will not allow</char> <char style="w" strong="G1473">me</char> <char style="w" strong="G1334">to tell</char> <char style="w" strong="G4012">of</char> <char style="w" strong="G1066">Gideon</char>, <char style="w" strong="G913">Barak</char>, <char style="w" strong="G4546">Samson</char>, <char style="w" strong="G2422">Jephthah</char>, <char style="w" strong="G5037">-</char> <char style="w" strong="G1138">David</char>, <char style="w" strong="G2532">-</char> <char style="w" strong="G4545">Samuel</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4396">prophets</char>, <verse style="v" number="33" /><char style="w" strong="G3739">who</char> <char style="w" strong="G1223">through</char> <char style="w" strong="G4102">faith</char> <char style="w" strong="G2610">conquered</char> <char style="w" strong="G932">kingdoms</char>, <char style="w" strong="G2038">administered</char> <char style="w" strong="G1343">justice</char>, <char style="w" strong="G2013">[and] gained</char> <char style="w" strong="G1860">what was promised</char>; <char style="w" strong="G5420">[who] shut</char> <char style="w" strong="G4750">[the] mouths</char> <char style="w" strong="G3023">of lions</char>, <verse style="v" number="34" /><char style="w" strong="G4570">quenched</char> <char style="w" strong="G1411">[the] raging</char> <char style="w" strong="G4442">fire</char>, <char style="w" strong="G5343">[and] escaped</char> <char style="w" strong="G4750">[the] edge</char> <char style="w" strong="G3162">of [the] sword</char>; <char style="w" strong="G1412">[who] gai