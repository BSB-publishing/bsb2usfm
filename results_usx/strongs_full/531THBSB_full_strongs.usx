  <para style="p"> <verse style="v" number="1" /><char style="w" strong="G3972">Paul</char>, <char style="w" strong="G2532">-</char> <char style="w" strong="G4610">Silvanus</char>,<note style="f" caller="+"><char style="fr">1:1 </char><char style="ft">That is, Silas</char></note> <char style="w" strong="G2532">and</char> <char style="w" strong="G5095">Timothy</char>,</para>
  <para style="p"><char style="w" strong="G3588">To the</char> <char style="w" strong="G1577">church</char> <char style="w" strong="G2331">of the Thessalonians</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G2316">God</char> <char style="w" strong="G3962">[the] Father</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G2962">[the] Lord</char> <char style="w" strong="G2424">Jesus</char> <char style="w" strong="G5547">Christ</char>:</para>
  <para style="p"><char style="w" strong="G5485">Grace</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G1515">peace</char> <char style="w" strong="G4771">to you</char>.<note style="f" caller="+"><char style="fr">1:1 </char><char style="ft">BYZ and TR include </char><char style="fqa">from God our Father and the Lord Jesus Christ</char><char style="ft">.</char></note></para>
  <para style="p"> <verse style="v" number="2" /><char style="w" strong="G2168">We always thank</char> <char style="w" strong="G3842">. . .</char> <char style="w" strong="G3588">. . .</char> <char style="w" strong="G2316">God</char> <char style="w" strong="G4012">for</char> <char style="w" strong="G3956">all</char> <char style="w" strong="G4771">of you</char>, <char style="w" strong="G4160">remembering [you]</char> <char style="w" strong="G3417">. . .</char> <char style="w" strong="G1909">in</char> <char style="w" strong="G1473">our</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4335">prayers</char> <verse style="v" number="3" /><char style="w" strong="G89">[and] continually</char> <char style="w" strong="G3421">recalling</char> <char style="w" strong="G1715">before</char> <char style="w" strong="G1473">our</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2316">God</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3962">Father</char> <char style="w" strong="G4771">your</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2041">work</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4102">of faith</char>, <char style="w" strong="G2532">-</char> <char style="w" strong="G3588">[your]</char> <char style="w" strong="G2873">labor</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G26">of love</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G3588">[your]</char> <char style="w" strong="G5281">enduring</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G1680">hope</char> <char style="w" strong="G3588">in</char> <char style="w" strong="G1473">our</char> <char style="w" strong="G2962">Lord</char> <char style="w" strong="G2424">Jesus</char> <char style="w" strong="G5547">Christ</char>.</para>
  <para style="p"> <verse style="v" number="4" /><char style="w" strong="G80">Brothers</char> <char style="w" strong="G25">who are beloved</char> <char style="w" strong="G5259">by</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2316">God</char>, <char style="w" strong="G1492">we know</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G1589">[that] He has chosen</char> <char style="w" strong="G4771">you</char>, <verse style="v" number="5" /><char style="w" strong="G3754">because</char> <char style="w" strong="G1473">our</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2098">gospel</char> <char style="w" strong="G1096">came</char> <char style="w" strong="G1519">to</char> <char style="w" strong="G4771">you</char> <char style="w" strong="G3756">not</char> <char style="w" strong="G3440">only</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G3056">word</char>, <char style="w" strong="G235">but</char> <char style="w" strong="G2532">also</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G1411">power</char>, <char style="w" strong="G2532">-</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G40">[the] Holy</char> <char style="w" strong="G4151">Spirit</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G1722">with</char> <char style="w" strong="G4183">great</char> <char style="w" strong="G4136">conviction</char> — <char style="w" strong="G2531">just as</char> <char style="w" strong="G1492">you know</char> <char style="w" strong="G3634">-</char> <char style="w" strong="G1096">we lived</char> <char style="w" strong="G1722">among</char> <char style="w" strong="G4771">you</char> <char style="w" strong="G1223">for your sake</char> <char style="w" strong="G4771">. . .</char>. <verse style="v" number="6" /><char style="w" strong="G2532">And</char> <char style="w" strong="G4771">you</char> <char style="w" strong="G1096">became</cha