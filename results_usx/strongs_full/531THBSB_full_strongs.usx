  <para style="p"> <verse style="v" number="18" /><char style="w" strong="G5620">Therefore</char> <char style="w" strong="G3870">encourage</char> <char style="w" strong="G240">one another</char> <char style="w" strong="G1722">with</char> <char style="w" strong="G3778">these</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3056">words</char>.</para>
