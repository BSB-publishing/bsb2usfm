  <para style="p"> <verse style="v" number="7" /><char style="w" strong="G5620">As a result</char>, <char style="w" strong="G4771">you</char> <char style="w" strong="G1096">have become</char> <char style="w" strong="G5179">an example</char> <char style="w" strong="G3956">to all</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4100">believers</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3109">Macedonia</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G1722">-</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G882">Achaia</char>. <verse style="v" number="8" /><char style="w" strong="G1063">For</char> <char style="w" strong="G3756">not</char> <char style="w" strong="G3440">only</char> <char style="w" strong="G3588">{did} the</char> <char style="w" strong="G3056">message</char> <char style="w" strong="G3588">of the</char> <char style="w" strong="G2962">Lord</char> <char style="w" strong="G1837">ring out</char> <char style="w" strong="G575">from</char> <char style="w" strong="G4771">you</char> <char style="w" strong="G1722">to</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3109">Macedonia</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G1722">-</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G882">Achaia</char>, <char style="w" strong="G235">but</char> <char style="w" strong="G4771">your</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4102">faith</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4314">in</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2316">God</char> <char style="w" strong="G1831">has gone out</char> <char style="w" strong="G1722">to</char> <char style="w" strong="G3956">every</char> <char style="w" strong="G5117">place</char>, <char style="w" strong="G5620">so that</char> <char style="w" strong="G1473">we</char> <char style="w" strong="G2192">have</char> <char style="w" strong="G3361">no</char> <char style="w" strong="G5532">need</char> <char style="w" strong="G2980">to say</char> <char style="w" strong="G5100">anything [more]</char>. <verse style="v" number="9" /><char style="w" strong="G1063">For</char> <char style="w" strong="G846">they themselves</char> <char style="w" strong="G518">report</char> <char style="w" strong="G4012">-</char> <char style="w" strong="G1473">-</char> <char style="w" strong="G3697">what kind</char> <char style="w" strong="G1529">of welcome</char> <char style="w" strong="G2192">you gave us</char> <char style="w" strong="G4314">. . .</char> <char style="w" strong="G4771">. . .</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G4459">how</char> <char style="w" strong="G1994">you turned</char> <char style="w" strong="G4314">to</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2316">God</char> <char style="w" strong="G575">from</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G1497">idols</char> <char style="w" strong="G1398">to serve</char> <char style="w" strong="G2198">[the] living</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G228">true</char> <char style="w" strong="G2316">God</char> <verse style="v" number="10" /><char style="w" strong="G2532">and</char> <char style="w" strong="G362">to await</char> <char style="w" strong="G846">His</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G5207">Son</char> <char style="w" strong="G1537">from</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3772">heaven</char>, <char style="w" strong="G3739">whom</char> <char style="w" strong="G1453">He raised</char> <char style="w" strong="G1537">from</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3498">dead</char> — <char style="w" strong="G2424">Jesus</char> <char sty