  <para style="p"> <verse style="v" number="9" /><char style="w" strong="G1063">-</char> <char style="w" strong="G5101">How</char> <char style="w" strong="G1410">can we</char> <char style="w" strong="G467">vvv</char> <char style="w" strong="G2169">[adequately] thank</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2316">God</char> <char style="w" strong="G4012">for</char> <char style="w" strong="G4771">you</char> <char style="w" strong="G1909">in return for</char> <char style="w" strong="G3956">vvv</char> <char style="w" strong="G3588">vvv</char> <char style="w" strong="G5479">vvv</char> <char style="w" strong="G3739">vvv</char> <char style="w" strong="G5463">our great joy</char> <char style="w" strong="G1223">over</char> <char style="w" strong="G4771">you</char> <char style="w" strong="G1715">in [His] presence</char> <char style="w" strong="G1473">. . .</char> <char style="w" strong="G3588">. . .</char> <char style="w" strong="G2316">. . .</char>? <verse style="v" number="10" /><char style="w" strong="G3571">Night</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G2250">day</char> <char style="w" strong="G1189">we pray</char> <char style="w" strong="G5228">most earnestly</char> <char style="w" strong="G1519">that</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3708">we may see</char> <char style="w" strong="G4771">you</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4383">face to face</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G2675">supply</char> <char style="w" strong="G3588">what</char> <char style="w" strong="G5303">is lacking</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4771">in your</char> <char style="w" strong="G4102">faith</char>.</para>
