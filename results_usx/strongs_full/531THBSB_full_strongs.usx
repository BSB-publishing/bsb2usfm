  <para style="p"> <verse style="v" number="9" /><char style="w" strong="G1161">Now</char> <char style="w" strong="G4012">about</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G5360">brotherly love</char>, <char style="w" strong="G2192">you do</char> <char style="w" strong="G3756">not</char> <char style="w" strong="G5532">need [anyone]</char> <char style="w" strong="G1125">to write</char> <char style="w" strong="G4771">to you</char>, <char style="w" strong="G1063">because</char> <char style="w" strong="G4771">you</char> <char style="w" strong="G846">yourselves</char> <char style="w" strong="G1510">have been</char> <char style="w" strong="G2312">taught by God</char> <char style="w" strong="G1519">-</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G25">to love</char> <char style="w" strong="G240">one another</char>. <verse style="v" number="10" /><char style="w" strong="G2532">And</char> <char style="w" strong="G1063">you are indeed</char> <char style="w" strong="G4160">showing</char> <char style="w" strong="G846">this [love]</char> <char style="w" strong="G1519">to</char> <char style="w" strong="G3956">all</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G80">brothers</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G1722">throughout</char> <char style="w" strong="G3650">. . .</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3109">Macedonia</char>. <char style="w" strong="G1161">But</char> <char style="w" strong="G3870">we urge</char> <char style="w" strong="G4771">you</char>, <char style="w" strong="G80">brothers</char>, <char style="w" strong="G4052">to excel</char> <char style="w" strong="G3123">more and more</char> <verse style="v" number="11" /><char style="w" strong="G2532">and</char> <char style="w" strong="G5389">to aspire</char> <char style="w" strong="G2270">to live quietly</char>, <char style="w" strong="G2532">-</char> <char style="w" strong="