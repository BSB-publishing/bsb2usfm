  <chapter number="3" style="c" />
  <para style="s1">Timothy’s Visit</para>
  <para style="p"> <verse style="v" number="1" /><char style="w" strong="G1352">So</char> <char style="w" strong="G4722">[when] we could bear [it]</char> <char style="w" strong="G3371">no longer</char>, <char style="w" strong="G2106">we were willing</char> <char style="w" strong="G2641">to be left</char> <char style="w" strong="G3441">on our own</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G116">Athens</char>. <verse style="v" number="2" /><char style="w" strong="G2532">-</char> <char style="w" strong="G3992">We sent</char> <char style="w" strong="G5095">Timothy</char>, <char style="w" strong="G1473">our</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G80">brother</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G4904">fellow worker</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2316">for God</char><note style="f" caller="+"><char style="fr">3:2 </char><char style="ft">Or </char><char style="fqa">our brother and God’s fellow worker</char><char style="ft">; NE, WH, BYZ, and TR </char><char style="fqa">our brother and minister of God</char></note> <char style="w" strong="G1722">in</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2098">gospel</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G5547">of Christ</char>, <char style="w" strong="G1519">to</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4741">strengthen</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3870">encourage</char> <char style="w" strong="G4771">you</char> <char style="w" strong="G5228">in</char> <char style="w" strong="G4771">your</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4102">faith</char>, <verse style="v" number="3" /><char style="w" strong="G3588">so that</char> <char style="w" strong="G3367">none [of you]</char> <char style="w" strong="G4525">would be shaken</char> <char sty