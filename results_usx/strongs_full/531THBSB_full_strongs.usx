  <para style="p"> <verse style="v" number="6" /><char style="w" strong="G1161">But</char> <char style="w" strong="G737">just now</char>, <char style="w" strong="G5095">Timothy</char> <char style="w" strong="G2064">has returned</char> <char style="w" strong="G4314">. . .</char> <char style="w" strong="G1473">. . .</char> <char style="w" strong="G575">from</char> <char style="w" strong="G4771">[ his visit]</char> <char style="w" strong="G2532">-</char> <char style="w" strong="G2097">with the good news</char> <char style="w" strong="G1473">. . .</char> <char style="w" strong="G4771">about your</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4102">faith</char>, <char style="w" strong="G2532">-</char> <char style="w" strong="G3588">[your]</char> <char style="w" strong="G26">love</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G18">[the] fond</char> <char style="w" strong="G3417">memories</char> <char style="w" strong="G3754">-</char> <char style="w" strong="G3842">vvv</char> <char style="w" strong="G2192">you have preserved</char> <char style="w" strong="G1473">-</char>, <char style="w" strong="G1971">longing</char> <char style="w" strong="G3708">to see</char> <char style="w" strong="G1473">us</char> <char style="w" strong="G2509">just as</char> <char style="w" strong="G1473">we</char> <char style="w" strong="G2532">[long to see]</char> <char style="w" strong="G4771">you</char>. <verse style="v" number="7" /><char style="w" strong="G1223">For this reason</char> <char style="w" strong="G3778">. . .</char>, <char style="w" strong="G80">brothers</char>, <char style="w" strong="G1909">in</char> <char style="w" strong="G3956">all</char> <char style="w" strong="G1473">our</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G318">distress</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G2347">persecution</char>, <char style="w" strong="G3870">we have been reassured</char> <char style=