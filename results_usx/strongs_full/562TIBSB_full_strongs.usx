  <para style="p"> <verse style="v" number="14" /><char style="w" strong="G223">Alexander</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G5471">coppersmith</char> <char style="w" strong="G1731">did</char> <char style="w" strong="G4183">great</char> <char style="w" strong="G2556">harm</char> <char style="w" strong="G1473">to me</char>. <char style="w" strong="G3588">The</char> <char style="w" strong="G2962">Lord</char> <char style="w" strong="G591">will repay</char> <char style="w" strong="G846">him</char> <char style="w" strong="G2596">according to</char> <char style="w" strong="G846">his</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2041">deeds</char>. <verse style="v" number="15" /><char style="w" strong="G4771">You</char> <char style="w" strong="G2532">too</char> <char style="w" strong="G5442">should beware of</char> <char style="w" strong="G3739">[him]</char>, <char style="w" strong="G1063">for</char> <char style="w" strong="G3029">vvv</char> <char style="w" strong="G436">he has vigorously opposed</char> <char style="w" strong="G2251">our</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3056">message</char>.</para>
  <para style="s1">The Lord Remains Faithful</para>
  <para style="p"> <verse style="v" number="16" /><char style="w" strong="G1722">At</char> <char style="w" strong="G1473">my</char> <char style="w" strong="G4413">first</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G627">defense</char>, <char style="w" strong="G3762">no one</char> <char style="w" strong="G3854">stood with</char> <char style="w" strong="G1473">me</char>, <char style="w" strong="G235">but</char> <char style="w" strong="G3956">everyone</char> <char style="w" strong="G1459">deserted</char> <char style="w" strong="G1473">me</char>. <char style="w" strong="G3361">vvv</char> <char style="w" strong="G3049">May it not be charged</char> <char style="w" strong="G846">against them</char>. <verse style="v" number="17" /><char style="w" strong="G1161">But</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2962">Lord</char> <char style="w" strong="G3936">stood by</char> <char style="w" strong="G1473">me</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G1743">strengthened</char> <char style="w" strong="G1473">me</char>, <char style="w" strong="G2443">so that</char> <char style="w" strong="G1223">through</char> <char style="w" strong="G1473">me</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2782">message</char> <char style="w" strong="G4135">would be fully proclaimed</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G3956">all</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G1484">Gentiles</char> <char style="w" strong="G191">would hear [it]</char>. <char style="w" strong="G2532">[So]</char> <char style="w" strong="G4506">I was delivered</char> <char style="w" strong="G1537">from</char> <char style="w" strong="G4750">[the] mouth</char> <char style="w" strong="G3023">of the lion</char>. <verse style="v" number="18" /><char style="w" strong="G3588">[And] the</char> <char style="w" strong="G2962">Lord</char> <char style="w" strong="G4506">will rescue</char> <char style="w" strong="G1473">me</char> <char style="w" strong="G575">from</char> <char style="w" strong="G3956">every</char> <char style="w" strong="G4190">evil</char> <char style="w" strong="G2041">action</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G4982">bring [me] safely</char> <char style="w" strong="G1519">into</char> <char style="w" strong="G846">His</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2032">heavenly</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G932">kingdom</char>. <char style="w" strong="G3739">To Him [be]</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G1391">glory</char> <char style="w" strong="G1519">vvv</char> <char style="w" strong="G3588">vvv</char> <char style="w" strong="G165">forever</char> <char style="w" strong="G3588">[and]</char> <char style="w" strong="G165">ever</char>. <char style="w" strong="G281">Amen</char>.</para>
  <para style="s1">Final Greetings</para>
  <para style="r">(<ref loc="EPH 6:21-24">Ephesians 6:21–24</ref>; <ref loc="PHP 4:21-23">Philippians 4:21–23</ref>)</para>
  <para style="p"> <verse style="v" number="19" /><char style="w" strong="G782">Greet</char> <char style="w" strong="G4251">Prisca</char><note style="f" caller="+"><char style="fr">4:19 </char><char style="fqa">Prisca </char><char style="ft">is a variant of </char><char style="fqa">Priscilla</char><char style="ft">; see <ref loc="ACT 18:2">Acts 18:2</ref>.</char></note> <char style="w" strong="G2532">and</char> <char style="w" strong="G207">Aquila</char>, <char style="w" strong="G2532">as well as</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3624">household</char> <char style="w" strong="G3683">of Onesiphorus</char>.</para>
  <para style="p"> <verse style="v" number="20" /><char style="w" strong="G2037">Erastus</char> <char style="w" strong="G3306">has remained</char> <char style="w" strong="G1722">at</char> <char style="w" strong="G2882">Corinth</char>, <char style="w" strong="G1161">and</char> <char style="w" strong="G5161">Trophimus</char> <char style="w" strong="G620">I left</char> <char style="w" strong="G770">sick</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G3399">Miletus</char>.</para>
  <para style="p"> <verse style="v" number="21" /><char style="w" strong="G4704">Make every effort</char> <char style="w" strong="G2064">to come [ to me ]</char> <char style="w" strong="G4253">before</char> <char style="w" strong="G5494">winter</char>.</para>
  <para style="p"><char style="w" strong="G2103">Eubulus</char> <char style="w" strong="G782">sends you greetings</char> <char style="w" strong="G4771">. . .</char>, <char style="w" strong="G2532">as do</char> <char style="w" strong="G4227">Pudens</char>, <char style="w" strong="G2532">-</char> <char style="w" strong="G3044">Linus</char>, <char style="w" strong="G2532">-</char> <char style="w" strong="G2803">Claudia</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G3956">all</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G80">brothers</char>.</para>
  <para style="p"> <verse style="v" number="22" /><char style="w" strong="G3588">The</char> <char style="w" strong="G2962">Lord</char> <char style="w" strong="G3326">[be] with</char> <char style="w" strong="G4771">your</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4151">spirit</char>. <char style="w" strong="G3588">-</char> <char style="w" strong="G5485">Grace [be]</char> <char style="w" strong="G3326">with</char> <char style="w" strong="G4771">you all</char>.<note style="f" caller="+"><char style="fr">4:22 </char><char style="ft">BYZ and TR include </char><char style="fqa">Amen.</char></note></para></usx>
