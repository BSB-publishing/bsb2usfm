  <para style="p"> <verse style="v" number="8" /><char style="w" strong="G3421">Remember</char> <char style="w" strong="G2424">Jesus</char> <char style="w" strong="G5547">Christ</char>, <char style="w" strong="G1453">raised</char> <char style="w" strong="G1537">from</char> <char style="w" strong="G3498">[the] dead</char>, <char style="w" strong="G1537">vvv</char> <char style="w" strong="G4690">descended</char> <char style="w" strong="G1138">from David</char>, <char style="w" strong="G2596">as proclaimed by</char> <char style="w" strong="G1473">my</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2098">gospel</char>, <verse style="v" number="9" /><char style="w" strong="G1722">for</char> <char style="w" strong="G3739">which</char> <char style="w" strong="G2553">I suffer</char> <char style="w" strong="G3360">to the extent of</char> <char style="w" strong="G1199">being chained</char> <char style="w" strong="G5613">like</char> <char style="w" strong="G2557">a criminal</char>. <char style="w" strong="G235">But</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3056">word</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2316">of God</char> <char style="w" strong="G3756">vvv</char> <char style="w" strong="G1210">cannot be chained</char>! <verse style="v" number="10" /><char style="w" strong="G1223">For this reason</char> <char style="w" strong="G3778">. . .</char> <char style="w" strong="G5278">I endure</char> <char style="w" strong="G3956">all things</char> <char style="w" strong="G1223">for the sake of</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G1588">elect</char>, <char style="w" strong="G2443">so that</char> <char style="w" strong="G846">they</char> <char style="w" strong="G2532">too</char> <char style="w" strong="G5177">may obtain</char> <char style="w" strong="G4991">[the] salvation</char> <char style="w" strong="G3588">that [is]</char> <char style="w" strong="G1722">in<