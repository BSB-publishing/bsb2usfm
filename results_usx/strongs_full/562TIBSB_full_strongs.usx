  <para style="p"> <verse style="v" number="8" /><char style="w" strong="G3767">So</char> <char style="w" strong="G3361">vvv</char> <char style="w" strong="G1870">do not be ashamed of</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3142">testimony</char> <char style="w" strong="G3588">of</char> <char style="w" strong="G1473">our</char> <char style="w" strong="G2962">Lord</char>, <char style="w" strong="G3366">[or]</char> <char style="w" strong="G1473">of me</char>, <char style="w" strong="G846">His</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G1198">prisoner</char>. <char style="w" strong="G235">Instead</char>, <char style="w" strong="G4777">join me in suffering</char> <char style="w" strong="G3588">for the</char> <char style="w" strong="G2098">gospel</char> <char style="w" strong="G2596">by</char> <char style="w" strong="G1411">[the] power</char> <char style="w" strong="G2316">of God</char>. <verse style="v" number="9" /><char style="w" strong="G3588">[He]</char> <char style="w" strong="G4982">has saved</char> <char style="w" strong="G1473">us</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G2564">called [us]</char> <char style="w" strong="G40">to a holy</char> <char style="w" strong="G2821">calling</char>, <char style="w" strong="G3756">not</char> <char style="w" strong="G2596">because of</char> <char style="w" strong="G1473">our</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2041">works</char>, <char style="w" strong="G235">but</char> <char style="w" strong="G2596">by</char> <char style="w" strong="G2398">His own</char> <char style="w" strong="G4286">purpose</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G5485">[by the] grace</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G1325">He granted</char> <char style="w" strong="G1473">us</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G5547">Christ