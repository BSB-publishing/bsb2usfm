  <para style="q1"> <verse style="v" number="4" />‘<char style="w" strong="G2532">-</char> <char style="w" strong="G1813">He will wipe away</char> <char style="w" strong="G3956">every</char> <char style="w" strong="G1144">tear</char> <char style="w" strong="G1537">from</char> <char style="w" strong="G846">their</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3788">eyes</char>,’<note style="f" caller="+"><char style="fr">21:4 </char><char style="ft"><ref loc="ISA 25:8">Isaiah 25:8</ref>.</char></note></para>
  <para style="q2"><char style="w" strong="G2532">and</char> <char style="w" strong="G1510">there will be</char> <char style="w" strong="G3756">no</char> <char style="w" strong="G2089">more</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2288">death</char></para>
  <para style="q1"><char style="w" strong="G3777">[or]</char> <char style="w" strong="G3997">mourning</char> <char style="w" strong="G3777">[or]</char> <char style="w" strong="G2906">crying</char> <char style="w" strong="G3777">[or]</char> <char style="w" strong="G4192">pain</char> <char style="w" strong="G1510">-</char> <char style="w" strong="G3756">-</char> <char style="w" strong="G2089">-</char>,</para>
