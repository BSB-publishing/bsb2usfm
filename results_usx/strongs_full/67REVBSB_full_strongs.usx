  <para style="p"> <verse style="v" number="5" /><char style="w" strong="G2532">And</char> <char style="w" strong="G3588">the [One]</char> <char style="w" strong="G2521">seated</char> <char style="w" strong="G1909">on</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2362">throne</char> <char style="w" strong="G2036">said</char>, “<char style="w" strong="G2400">Behold</char>, <char style="w" strong="G4160">I make</char> <char style="w" strong="G3956">all things</char> <char style="w" strong="G2537">new</char>.” <char style="w" strong="G2532">Then</char> <char style="w" strong="G3004">He said</char>, “<char style="w" strong="G1125">Write this down</char>, <char style="w" strong="G3754">for</char> <char style="w" strong="G3778">these</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3056">words</char> <char style="w" strong="G1510">are</char> <char style="w" strong="G4103">faithful</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G228">true</char>.” <verse style="v" number="6" /><char style="w" strong="G2532">And</char> <char style="w" strong="G2036">He told</char> <char style="w" strong="G1473">me</char>, “<char style="w" strong="G1096">It is done</char>! <char style="w" strong="G1473">I</char> <char style="w" strong="G1510">am</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G1">Alpha</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G5598">Omega</char>, <char style="w" strong="G3588">the</char> <char style="w" strong="G746">Beginning</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G5056">End</char>. <char style="w" strong="G3588">To the</char> <char style="w" strong="G1372">thirsty</char> <char style="w" strong="G1473">I</char> <char style="w" strong="G1325">will give</char> <char style="w" strong="G1432">freely</char> <char style="w" strong="G1537">from</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4077">spring</char> <char style="w" strong="G3588">of the</char> <char style="w" strong="G5204">water</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2222">of life</char>. <verse style="v" number="7" /><char style="w" strong="G3588">The [one who]</char> <char style="w" strong="G3528">overcomes</char> <char style="w" strong="G2816">will inherit</char> <char style="w" strong="G3778">all things</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G1510">I will be</char> <char style="w" strong="G846">his</char> <char style="w" strong="G2316">God</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G846">he</char> <char style="w" strong="G1510">will be</char> <char style="w" strong="G1473">My</char> <char style="w" strong="G5207">son</char>.</para>
  <para style="p"> <verse style="v" number="8" /><char style="w" strong="G1161">But</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G1169">to [the] cowardly</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G571">unbelieving</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G948">abominable</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G5406">murderers</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G4205">sexually immoral</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G5333">sorcerers</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G1496">idolaters</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3956">all</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G5571">liars</char>, <char style="w" strong="G846">their</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3313">place</char> <char style="w" strong="G1722">[will be] in</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3041">lake</char> <char style="w" strong="G3588">that</char> <char style="w" strong="G2545">burns</char> <char style="w" strong="G4442">with fire</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G2303">sulfur</char>. <char style="w" strong="G3739">This</char> <char style="w" strong="G1510">is</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G1208">second</char> <char style="w" strong="G2288">death</char>.”</para>
  <para style="s1">The New Jerusalem</para>
  <para style="p"> <verse style="v" number="9" /><char style="w" strong="G2532">Then</char> <char style="w" strong="G1520">one</char> <char style="w" strong="G1537">of</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2033">seven</char> <char style="w" strong="G32">angels</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2192">with</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2033">seven</char> <char style="w" strong="G5357">bowls</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G1073">full</char> <char style="w" strong="G3588">of the</char> <char style="w" strong="G2033">seven</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2078">final</char> <char style="w" strong="G4127">plagues</char> <char style="w" strong="G2064">came</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G2980">said</char> <char style="w" strong="G3326">to</char> <char style="w" strong="G1473">me</char> <char style="w" strong="G3004">-</char>, “<char style="w" strong="G1204">Come</char>, <char style="w" strong="G1166">I will show</char> <char style="w" strong="G4771">you</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3565">bride</char>, <char style="w" strong="G3588">the</char> <char style="w" strong="G1135">wife</char> <char style="w" strong="G3588">of the</char> <char style="w" strong="G721">Lamb</char>.”</para>
