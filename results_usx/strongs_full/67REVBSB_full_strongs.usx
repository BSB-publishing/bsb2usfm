  <para style="q1">“<char style="w" strong="G3588">To Him who</char> <char style="w" strong="G2521">sits</char> <char style="w" strong="G1909">on</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2362">throne</char></para>
