  <para style="p"> <verse style="v" number="4" /><char style="w" strong="G3778">These [witnesses]</char> <char style="w" strong="G1510">are</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G1417">two</char> <char style="w" strong="G1636">olive trees</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G1417">two</char> <char style="w" strong="G3087">lampstands</char> <char style="w" strong="G2476">that stand</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G1799">before</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2962">Lord</char> <char style="w" strong="G3588">of the</char> <char style="w" strong="G1093">earth</char>.<note style="f" caller="+"><char style="fr">11:4 </char><char style="ft">See <ref loc="ZEC 4:14">Zechariah 4:14</ref>.</char></note> <verse style="v" number="5" /><char style="w" strong="G2532">-</char> <char style="w" strong="G1487">If</char> <char style="w" strong="G5100">anyone</char> <char style="w" strong="G2309">wants</char> <char style="w" strong="G91">to harm</char> <char style="w" strong="G846">them</char>, <char style="w" strong="G4442">fire</char> <char style="w" strong="G1607">proceeds</char> <char style="w" strong="G1537">from</char> <char style="w" strong="G846">their</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4750">mouths</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G2719">devours</char> <char style="w" strong="G846">their</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2190">enemies</char>. <char style="w" strong="G2532">-</char> <char style="w" strong="G3779">In this way</char> <char style="w" strong="G1487">-</char>, <char style="w" strong="G5100">anyone who</char> <char style="w" strong="G2309">wants</char> <char style="w" strong="G91">to harm</char> <char style="w" strong="G846">them</char> <char style="w" strong="G11