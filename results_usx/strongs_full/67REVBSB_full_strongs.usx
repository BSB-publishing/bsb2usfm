  <para style="p"> <verse style="v" number="9" /><char style="w" strong="G5602">This calls for</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3563">a mind</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2192">with</char> <char style="w" strong="G4678">wisdom</char>. <char style="w" strong="G3588">The</char> <char style="w" strong="G2033">seven</char> <char style="w" strong="G2776">heads</char> <char style="w" strong="G1510">are</char> <char style="w" strong="G2033">seven</char> <char style="w" strong="G3735">mountains</char> <char style="w" strong="G1909">on</char> <char style="w" strong="G846">-</char> <char style="w" strong="G3699">which</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G1135">woman</char> <char style="w" strong="G2521">sits</char>. <verse style="v" number="10" /><char style="w" strong="G1510">There are</char> <char style="w" strong="G2532">also</char> <char style="w" strong="G2033">seven</char> <char style="w" strong="G935">kings</char>. <char style="w" strong="G3588">-</char> <char style="w" strong="G4002">Five</char> <char style="w" strong="G4098">have fallen</char>, <char style="w" strong="G3588">-</char> <char style="w" strong="G1520">one</char> <char style="w" strong="G1510">is</char>, <char style="w" strong="G3588">[and] the</char> <char style="w" strong="G243">other</char> <char style="w" strong="G3768">{has} not yet</char> <char style="w" strong="G2064">come</char>. <char style="w" strong="G2532">[But]</char> <char style="w" strong="G3752">when</char> <char style="w" strong="G2064">he does come</char>, <char style="w" strong="G846">he</char> <char style="w" strong="G1163">must</char> <char style="w" strong="G3306">remain</char> <char style="w" strong="G3641">for only a little while</char>.</para>
