  <para style="p"> <verse style="v" number="11" /><char style="w" strong="G2532">Then</char> <char style="w" strong="G1538">each</char> <char style="w" strong="G846">of them</char> <char style="w" strong="G1325">was given</char> <char style="w" strong="G3022">a white</char> <char style="w" strong="G4749">robe</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G2046">told</char> <char style="w" strong="G846">-</char> <char style="w" strong="G2443">to</char> <char style="w" strong="G373">rest</char> <char style="w" strong="G3398">a little</char> <char style="w" strong="G5550">while</char> <char style="w" strong="G2089">longer</char> <char style="w" strong="G2193">until</char> <char style="w" strong="G4137">the full number</char> <char style="w" strong="G2532">. . .</char> <char style="w" strong="G846">of their</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4889">fellow servants</char>, <char style="w" strong="G2532">-</char> <char style="w" strong="G846">their</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G80">brothers</char>, <char style="w" strong="G3588">-</char> <char style="w" strong="G3195">were</char> <char style="w" strong="G615">killed</char>, <char style="w" strong="G5613">just as</char> <char style="w" strong="G846">they</char> <char style="w" strong="G2532">[had been killed]</char>.</para>
