  <para style="p"> <verse style="v" number="14" /><char style="w" strong="G2532">And</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G5064">four</char> <char style="w" strong="G2226">living creatures</char> <char style="w" strong="G2036">said</char>, “<char style="w" strong="G281">Amen</char>,” <char style="w" strong="G2532">and</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4245">elders</char> <char style="w" strong="G4098">fell down</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G4352">worshiped</char>.<note style="f" caller="+"><char style="fr">5:14 </char><char style="ft">TR includes </char><char style="fqa">Him who lives for ever and ever</char><char style="ft">.</char></note></para>
