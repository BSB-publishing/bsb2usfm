  <para style="q2"><char style="w" strong="G2532">and</char> <char style="w" strong="G5092">honor</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G1391">glory</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G2129">blessing</char>!”</para>
  <para style="p"> <verse style="v" number="13" /><char style="w" strong="G2532">And</char> <char style="w" strong="G191">I heard</char> <char style="w" strong="G3956">every</char> <char style="w" strong="G2938">creature</char> <char style="w" strong="G3739">-</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3772">heaven</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G1909">on</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G1093">earth</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G5270">under</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G1093">earth</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G1909">in</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2281">sea</char>, <char style="w" strong="G1510">-</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3956">all</char> <char style="w" strong="G3588">that [is]</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G846">them</char>, <char style="w" strong="G3004">saying</char>:</para>
