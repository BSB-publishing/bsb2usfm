  <para style="b" />
  <para style="q1">“<char style="w" strong="G514">Worthy</char> <char style="w" strong="G1510">is</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G721">Lamb</char> <char style="w" strong="G3588">who</char> <char style="w" strong="G4969">was slain</char>,</para>
