  <para style="p"> <verse style="v" number="1" /><char style="w" strong="G2532">Then</char> <char style="w" strong="G3708">I saw</char> <char style="w" strong="G2537">a new</char> <char style="w" strong="G3772">heaven</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G2537">a new</char> <char style="w" strong="G1093">earth</char>,<note style="f" caller="+"><char style="fr">21:1 </char><char style="ft">See <ref loc="ISA 65:17">Isaiah 65:17</ref> and Isaiah 66:22 (see also LXX).</char></note> <char style="w" strong="G1063">for</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4413">first</char> <char style="w" strong="G3772">heaven</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4413">-</char> <char style="w" strong="G1093">earth</char> <char style="w" strong="G565">had passed away</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2281">sea</char> <char style="w" strong="G1510">was</char> <char style="w" strong="G3756">no</char> <char style="w" strong="G2089">more</char>. <verse style="v" number="2" /><char style="w" strong="G2532">-</char> <char style="w" strong="G3708">I saw</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G40">holy</char> <char style="w" strong="G4172">city</char>, <char style="w" strong="G2537">[the] new</char> <char style="w" strong="G2419">Jerusalem</char>, <char style="w" strong="G2597">coming down</char> <char style="w" strong="G1537">out of</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3772">heaven</char> <char style="w" strong="G575">from</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2316">God</char>, <char style="w" strong="G2090">prepared</char> <char style="w" strong="G5613">as</char> <char style="w" strong="G3565">a bride</char> <char style="w" st