  <para style="p"> <verse style="v" number="3" /><char style="w" strong="G2532">And</char> <char style="w" strong="G191">I heard</char> <char style="w" strong="G3173">a loud</char> <char style="w" strong="G5456">voice</char> <char style="w" strong="G1537">from</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2362">throne</char> <char style="w" strong="G3004">saying</char>:</para>
  <para style="b" />
  <para style="q1">“<char style="w" strong="G2400">Behold</char>, <char style="w" strong="G3588">the</char> <char style="w" strong="G4633">dwelling place</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2316">of God</char> <char style="w" strong="G3326">[is] with</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G444">man</char>,</para>
  <para style="q2"><char style="w" strong="G2532">and</char> <char style="w" strong="G4637">He will dwell</char> <char style="w" strong="G3326">with</char> <char style="w" strong="G846">them</char>.</para>
