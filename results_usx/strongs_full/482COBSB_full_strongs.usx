  <para style="p"> <verse style="v" number="16" /><char style="w" strong="G1161">But</char> <char style="w" strong="G5485">thanks [be]</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2316">to God</char>, <char style="w" strong="G3588">who</char> <char style="w" strong="G1325">put</char> <char style="w" strong="G1722">into</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2588">heart</char> <char style="w" strong="G5103">of Titus</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G846">same</char> <char style="w" strong="G4710">devotion</char> <char style="w" strong="G5228">[I have] for</char> <char style="w" strong="G4771">you</char>. <verse style="v" number="17" /><char style="w" strong="G3754">For</char> <char style="w" strong="G3303">not only</char> <char style="w" strong="G1209">did he welcome</char> <char style="w" strong="G3588">[our]</char> <char style="w" strong="G3874">appeal</char>, <char style="w" strong="G1161">but</char> <char style="w" strong="G5225">he</char> <char style="w" strong="G4705">{is} eagerly</char> <char style="w" strong="G1831">coming</char> <char style="w" strong="G4314">to</char> <char style="w" strong="G4771">you</char> <char style="w" strong="G830">of his own volition</char>.</para>
