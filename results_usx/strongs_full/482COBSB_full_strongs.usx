  <para style="p"> <verse style="v" number="13" /><char style="w" strong="G1223">Because of</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G1382">proof</char> <char style="w" strong="G3778">this</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G1248">ministry {provides}</char>, <char style="w" strong="G1392">[the saints] will glorify</char> <char style="w" strong="G2316">God</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G1909">for</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4771">your</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G5292">obedient</char> <char style="w" strong="G3671">confession</char> <char style="w" strong="G1519">of</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2098">gospel</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G5547">of Christ</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G572">[for the] generosity</char> <char style="w" strong="G3588">of [your]</char> <char style="w" strong="G2842">contribution</char> <char style="w" strong="G1519">to</char> <char style="w" strong="G846">them</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G1519">to</char> <char style="w" strong="G3956">all [the others]</char>. <verse style="v" number="14" /><char style="w" strong="G2532">And</char> <char style="w" strong="G846">their</char> <char style="w" strong="G1162">prayers</char> <char style="w" strong="G5228">for</char> <char style="w" strong="G4771">you</char> <char style="w" strong="G1971">will express their affection</char> <char style="w" strong="G4771">for you</char>, <char style="w" strong="G1223">because of</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G5235">surpassing</char> <char style="w" strong="G5485">grace</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2316">God</char> <c