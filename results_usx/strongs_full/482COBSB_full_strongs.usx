  <para style="p"> <verse style="v" number="12" /><char style="w" strong="G1063">-</char> <char style="w" strong="G5111">We do not dare</char> <char style="w" strong="G3756">-</char> <char style="w" strong="G1469">to classify</char> <char style="w" strong="G2228">or</char> <char style="w" strong="G4793">compare</char> <char style="w" strong="G1438">ourselves [with]</char> <char style="w" strong="G5100">some</char> <char style="w" strong="G3588">who</char> <char style="w" strong="G4921">commend</char> <char style="w" strong="G1438">themselves</char>. <char style="w" strong="G235">-</char> <char style="w" strong="G846">[When] they</char> <char style="w" strong="G3354">measure</char> <char style="w" strong="G1438">themselves</char> <char style="w" strong="G1722">by</char> <char style="w" strong="G1438">themselves</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G4793">compare</char> <char style="w" strong="G1438">themselves</char> <char style="w" strong="G1438">with themselves</char>, <char style="w" strong="G3756">vvv</char> <char style="w" strong="G4920">they show their ignorance</char>. <verse style="v" number="13" /><char style="w" strong="G1473">We</char>, <char style="w" strong="G1161">however</char>, <char style="w" strong="G3756">vvv</char> <char style="w" strong="G2744">will not boast</char> <char style="w" strong="G1519">vvv</char> <char style="w" strong="G3588">vvv</char> <char style="w" strong="G280">beyond our limits</char>, <char style="w" strong="G235">but only</char> <char style="w" strong="G2596">within</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3358">field of influence</char> <char style="w" strong="G3588">. . .</char> <char style="w" strong="G2583">. . .</char> <char style="w" strong="G3739">that</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2316">God</char> <char style="w" strong="G3307">has assigned</char> <char style="w" strong="G1473">to us</char> — <char style="w" s