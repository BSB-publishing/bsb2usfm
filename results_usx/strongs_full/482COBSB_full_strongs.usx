  <para style="p"> <verse style="v" number="14" /><char style="w" strong="G2400">See</char> <char style="w" strong="G3778">-</char>, <char style="w" strong="G2192">I am</char> <char style="w" strong="G2093">ready</char> <char style="w" strong="G2064">to come</char> <char style="w" strong="G4314">to</char> <char style="w" strong="G4771">you</char> <char style="w" strong="G5154">a third time</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G3756">vvv</char> <char style="w" strong="G2655">I will not be a burden</char>, <char style="w" strong="G1063">because</char> <char style="w" strong="G3756">vvv</char> <char style="w" strong="G2212">I am not seeking</char> <char style="w" strong="G4771">your</char> <char style="w" strong="G3588">[possessions]</char>, <char style="w" strong="G235">but</char> <char style="w" strong="G4771">you</char>. <char style="w" strong="G1063">For</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G5043">children</char> <char style="w" strong="G3784">should not have</char> <char style="w" strong="G3756">. . .</char> <char style="w" strong="G2343">to save up</char> <char style="w" strong="G3588">for [their]</char> <char style="w" strong="G1118">parents</char>, <char style="w" strong="G235">but</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G1118">parents</char> <char style="w" strong="G3588">for [their]</char> <char style="w" strong="G5043">children</char>. <verse style="v" number="15" /><char style="w" strong="G1161">And</char> <char style="w" strong="G5228">for the sake of</char> <char style="w" strong="G4771">your</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G5590">souls</char>, <char style="w" strong="G1473">I</char> <char style="w" strong="G2236">{will} most gladly</char> <char style="w" strong="G1159">spend my money</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G1550">[myself]</char>. <char style="w" strong="G1487">If</ch