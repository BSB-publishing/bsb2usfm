  <para style="p"> <verse style="v" number="17" /><char style="w" strong="G1063">For</char> <char style="w" strong="G1510">we are</char> <char style="w" strong="G3756">not</char> <char style="w" strong="G5613">like</char> <char style="w" strong="G4183">so many others</char>, <char style="w" strong="G3588">who</char> <char style="w" strong="G2585">peddle</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3056">word</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2316">of God {for profit}</char>. <char style="w" strong="G235">On the contrary</char>, <char style="w" strong="G1722">in</char> <char style="w" strong="G5547">Christ</char> <char style="w" strong="G2980">we speak</char> <char style="w" strong="G2713">before</char> <char style="w" strong="G2316">God</char> <char style="w" strong="G5613">with</char> <char style="w" strong="G1537">. . .</char> <char style="w" strong="G1505">sincerity</char>, <char style="w" strong="G235">-</char> <char style="w" strong="G5613">as</char> <char style="w" strong="G1537">men sent from</char> <char style="w" strong="G2316">God</char>.</para>
