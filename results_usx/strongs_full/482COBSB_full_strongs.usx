  <para style="p"> <verse style="v" number="22" /><char style="w" strong="G1161">And</char> <char style="w" strong="G4842">we are sending along with</char> <char style="w" strong="G846">them</char> <char style="w" strong="G1473">our</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G80">brother</char> <char style="w" strong="G3739">who</char> <char style="w" strong="G1381">has proven</char> <char style="w" strong="G4705">his earnestness [to us]</char> <char style="w" strong="G1510">-</char> <char style="w" strong="G4178">many times</char> <char style="w" strong="G1722">[and] in</char> <char style="w" strong="G4183">many ways</char>, <char style="w" strong="G1161">and</char> <char style="w" strong="G3570">now</char> <char style="w" strong="G4183">even</char> <char style="w" strong="G4183">more</char> <char style="w" strong="G4705">[so]</char> <char style="w" strong="G4006">by [his] great confidence</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G1519">in</char> <char style="w" strong="G4771">you</char>. <verse style="v" number="23" /><char style="w" strong="G1535">As for</char> <char style="w" strong="G5228">. . .</char> <char style="w" strong="G5103">Titus</char>, <char style="w" strong="G1699">[he is] my</char> <char style="w" strong="G2844">partner</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G4904">fellow worker</char> <char style="w" strong="G1519">among</char> <char style="w" strong="G4771">you</char>. <char style="w" strong="G1535">[As for]</char> <char style="w" strong="G1473">our</char> <char style="w" strong="G80">brothers</char>, <char style="w" strong="G652">[they are] messengers</char><note style="f" caller="+"><char style="fr">8:23 </char><char style="ft">Or </char><char style="fqa">apostles</char></note> <char style="w" strong="G1577">of [the] churches</char>, <char style="w" strong="G1391">[the] glory</char> <char style="w" strong="G5547">of Christ</char>. <verse style="v" number