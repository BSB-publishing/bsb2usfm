  <para style="p"> <verse style="v" number="6" /><char style="w" strong="G3767">Therefore</char> <char style="w" strong="G3842">vvv</char> <char style="w" strong="G2292">we are always confident</char>, <char style="w" strong="G2532">although</char> <char style="w" strong="G1492">we know</char> <char style="w" strong="G3754">that</char> <char style="w" strong="G1736">while we are at home</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4983">body</char>, <char style="w" strong="G1553">we are away</char> <char style="w" strong="G575">from</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2962">Lord</char>. <verse style="v" number="7" /><char style="w" strong="G1063">For</char> <char style="w" strong="G4043">we walk</char> <char style="w" strong="G1223">by</char> <char style="w" strong="G4102">faith</char>, <char style="w" strong="G3756">not</char> <char style="w" strong="G1223">by</char> <char style="w" strong="G1491">sight</char>. <verse style="v" number="8" /><char style="w" strong="G2292">We are confident</char>, <char style="w" strong="G1161">then</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G2106">would prefer</char> <char style="w" strong="G3123">. . .</char> <char style="w" strong="G1553">to be away</char> <char style="w" strong="G1537">from</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4983">body</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G1736">at home</char> <char style="w" strong="G4314">with</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2962">Lord</char>. <verse style="v" number="9" /><char style="w" strong="G1352">So</char> <char style="w" strong="G2532">-</char> <char style="w" strong="G5389">we aspire</char> <char style="w" strong="G1510">to</char> <char style="w" strong="G2101">please</char> <char style="w" strong="G846">Him</char>, <char style="w" st