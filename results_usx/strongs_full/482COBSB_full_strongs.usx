  <para style="b" />
  <para style="q1">“<char style="w" strong="G4650">He has scattered abroad</char> <char style="w" strong="G1325">His gifts</char> <char style="w" strong="G3588">to the</char> <char style="w" strong="G3993">poor</char>;</para>
  <para style="q2"><char style="w" strong="G846">His</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G1343">righteousness</char> <char style="w" strong="G3306">endures</char> <char style="w" strong="G1519">forever</char> <char style="w" strong="G3588">. . .</char> <char style="w" strong="G165">. . .</char>.”<note style="f" caller="+"><char style="fr">9:9 </char><char style="ft"><ref loc="PSA 112:9">Psalm 112:9</ref></char></note></para>
  <para style="p"> <verse style="v" number="10" /><char style="w" strong="G1161">Now</char> <char style="w" strong="G3588">He who</char> <char style="w" strong="G2023">supplies</char> <char style="w" strong="G4703">seed</char> <char style="w" strong="G3588">to the</char> <char style="w" strong="G4687">sower</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G740">bread</char> <char style="w" strong="G1519">for</char> <char style="w" strong="G1035">food</char> <char style="w" strong="G5524">will supply</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G4129">multiply</char> <char style="w" strong="G4771">your</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4703">store of seed</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G837">will increase</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G1081">harvest</char> <char style="w" strong="G3588">of</char> <char style="w" strong="G4771">your</char> <char style="w" strong="G1343">righteousness</char>. <verse style="v" number="11" /><char style="w" strong="G4148">You will be enriched</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G3956">every way</char> <char style="w" strong="G1519">to</char> <char style="w" strong="G572">be generous</char> <char style="w" strong="G3956">on every [occasion]</char>, <char style="w" strong="G3748">[and]</char> <char style="w" strong="G1223">through</char> <char style="w" strong="G1473">us</char> <char style="w" strong="G2716">[your generosity] will produce</char> <char style="w" strong="G2169">thanksgiving</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2316">to God</char>. <verse style="v" number="12" /><char style="w" strong="G3754">For</char> <char style="w" strong="G3778">this</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G1248">ministry</char> <char style="w" strong="G3588">-</char> <char style="w