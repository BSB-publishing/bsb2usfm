  <para style="p"> <verse style="v" number="13" /><char style="w" strong="G2532">Then</char> <char style="w" strong="G305">[Jesus] went up</char> <char style="w" strong="G1519">on</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3735">mountain</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G4341">called for</char> <char style="w" strong="G3739">those</char> <char style="w" strong="G846">He</char> <char style="w" strong="G2309">wanted</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G565">they came</char> <char style="w" strong="G4314">to</char> <char style="w" strong="G846">Him</char>. <verse style="v" number="14" /><char style="w" strong="G2532">-</char> <char style="w" strong="G4160">He appointed</char> <char style="w" strong="G1427">twelve</char> <char style="w" strong="G3739">[of them]</char>, <char style="w" strong="G2532">[whom]</char> <char style="w" strong="G3687">He designated as</char> <char style="w" strong="G652">apostles</char>,<note style="f" caller="+"><char style="fr">3:14 </char><char style="ft">SBL and WH; ECM, SBL, NE, BYZ, and TR do not include </char><char style="fqa">whom He designated as apostles</char></note> <char style="w" strong="G2443">to</char> <char style="w" strong="G1510">accompany</char> <char style="w" strong="G3326">. . .</char> <char style="w" strong="G846">Him</char>, <char style="w" strong="G2532">-</char> <char style="w" strong="G2443">to</char> <char style="w" strong="G649">be sent out</char> <char style="w" strong="G846">-</char> <char style="w" strong="G2784">to preach</char>, <verse style="v" number="15" /><char style="w" strong="G2532">and</char> <char style="w" strong="G2192">to have</char> <char style="w" strong="G1849">authority</char><note style="f" caller="+"><char style="fr">3:15 </char><char style="ft">BYZ and TR include </char><char style="fqa">to heal sicknesses, and</char></note> <char style="w" strong="G1544">to drive out</char> <char st