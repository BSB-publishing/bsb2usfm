  <para style="p"> <verse style="v" number="35" /><char style="w" strong="G2532">When</char> <char style="w" strong="G1722">-</char> <char style="w" strong="G1565">that</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2250">vvv</char> <char style="w" strong="G1096">vvv</char> <char style="w" strong="G3798">evening came</char>, <char style="w" strong="G3004">He said</char> <char style="w" strong="G846">to [His disciples]</char>, <char style="wj">“<char style="w" strong="G1330">Let us cross</char> <char style="w" strong="G1519">to</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4008">other side</char>.”</char> <verse style="v" number="36" /><char style="w" strong="G2532">After</char> <char style="w" strong="G863">they had dismissed</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3793">crowd</char>, <char style="w" strong="G3880">they took [Jesus] with them</char> <char style="w" strong="G846">. . .</char>, <char style="w" strong="G5613">since</char> <char style="w" strong="G1510">He was already</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4143">boat</char>. <char style="w" strong="G2532">And</char> <char style="w" strong="G1510">there were</char> <char style="w" strong="G243">other</char> <char style="w" strong="G4143">boats</char> <char style="w" strong="G3326">with</char> <char style="w" strong="G846">Him</char>.</para>
  <para style="p"> <verse style="v" number="37" /><char style="w" strong="G2532">Soon</char> <char style="w" strong="G3173">a violent</char> <char style="w" strong="G2978">windstorm</char> <char style="w" strong="G417">. . .</char> <char style="w" strong="G1096">came up</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2949">waves</char> <char style="w" strong="G1911">were breaking</char> <char style="w" strong="G1519">over</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4143">boat</char>, <char style="w" strong="G5620">so that</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4143">[it]</char> <char style="w" strong="G2235">vvv</char> <char style="w" strong="G1072">was being swamped</char>. <verse style="v" number="38" /><char style="w" strong="G2532">But</char> <char style="w" strong="G846">[Jesus]</char> <char style="w" strong="G1510">was</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4403">stern</char>, <char style="w" strong="G2518">sleeping</char> <char style="w" strong="G1909">on</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4344">cushion</char>. <char style="w" strong="G2532">[So]</char> <char style="w" strong="G1453">they woke</char> <char style="w" strong="G846">Him</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3004">said</char> <char style="w" strong="G846">-</char>, “<char style="w" strong="G1320">Teacher</char>, <char style="w" strong="G3756">vvv</char> <char style="w" strong="G3199">don’t You care</char> <char style="w" strong="G4771">. . .</char> <char style="w" strong="G3754">that</char> <char style="w" strong="G622">we are perishing</char>?”</para>
  <para style="p"> <verse style="v" number="39" /><char style="w" strong="G2532">Then</char> <char style="w" strong="G1326">[Jesus] got up</char> <char style="w" strong="G2008">[and] rebuked</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G417">wind</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2281">sea</char>. <char style="wj">“<char style="w" strong="G4623">Silence</char>!”</char> <char style="w" strong="G2036">He commanded</char>. <char style="wj">“<char style="w" strong="G5392">Be still</char>!”</char> <char style="w" strong="G2532">And</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G417">wind</char> <char style="w" strong="G2869">died down</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G1096">it was</char> <char style="w" strong="G3173">perfectly</char> <char style="w" strong="G1055">calm</char>.</para>
  <para style="p"><char style="wj"> <verse style="v" number="40" />“<char style="w" strong="G5101">Why</char> <char style="w" strong="G1510">are you</char> <char style="w" strong="G1169">so afraid</char>?”</char> <char style="w" strong="G2532">-</char> <char style="w" strong="G2036">He asked</char> <char style="w" strong="G846">-</char>. <char style="wj">“<char style="w" strong="G2192">Do you still have no</char> <char style="w" strong="G3768">. . .</char> <char style="w" strong="G4102">faith</char>?”</char></para>
  <para style="p"> <verse style="v" number="41" /><char style="w" strong="G2532">-</char> <char style="w" strong="G5399">Overwhelmed with fear</char> <char style="w" strong="G3173">. . .</char> <char style="w" strong="G5401">. . .</char>, <char style="w" strong="G2532">-</char> <char style="w" strong="G2036">they asked</char> <char style="w" strong="G4314">. . .</char> <char style="w" strong="G240">one another</char>, “<char style="w" strong="G5101">Who</char> <char style="w" strong="G686">-</char> <char style="w" strong="G1510">is</char> <char style="w" strong="G3778">this</char>, <char style="w" strong="G3754">that</char> <char style="w" strong="G2532">even</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G417">wind</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2281">sea</char> <char style="w" strong="G5219">obey</char> <char style="w" strong="G846">Him</char>?”</para>
