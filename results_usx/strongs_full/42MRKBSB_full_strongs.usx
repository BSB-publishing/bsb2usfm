  <para style="p"> <verse style="v" number="48" /><char style="w" strong="G2532">-</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2424">Jesus</char> <char style="w" strong="G611">vvv</char> <char style="w" strong="G2036">asked</char> <char style="w" strong="G846">[the crowd]</char>, <char style="wj">“<char style="w" strong="G1831">Have you come out</char> <char style="w" strong="G3326">with</char> <char style="w" strong="G3162">swords</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3586">clubs</char> <char style="w" strong="G4815">to arrest</char> <char style="w" strong="G1473">Me</char> <char style="w" strong="G5613">as</char> <char style="w" strong="G1909">[you would]</char> <char style="w" strong="G3027">an outlaw</char>? <verse style="v" number="49" /><char style="w" strong="G2596">Every</char> <char style="w" strong="G2250">day</char> <char style="w" strong="G1510">I was</char> <char style="w" strong="G4314">with</char> <char style="w" strong="G4771">you</char>, <char style="w" strong="G1321">teaching</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2411">temple [courts]</char>,<note style="f" caller="+"><char style="fr">14:49 </char><char style="ft">Literally </char><char style="fqa">the temple</char></note> <char style="w" strong="G2532">and</char> <char style="w" strong="G3756">vvv</char> <char style="w" strong="G2902">you did not arrest</char> <char style="w" strong="G1473">Me</char>. <char style="w" strong="G235">But</char> <char style="w" strong="G2443">[this has happened] that</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G1124">Scriptures</char> <char style="w" strong="G4137">would be fulfilled</char>.”</char></para>
