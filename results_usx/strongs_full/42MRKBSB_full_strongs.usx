  <para style="p"> <verse style="v" number="30" /><char style="w" strong="G2532">Meanwhile</char>, <char style="w" strong="G3588">the</char> <char style="w" strong="G652">apostles</char> <char style="w" strong="G4863">gathered</char> <char style="w" strong="G4314">around</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2424">Jesus</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G518">brought Him news</char> <char style="w" strong="G846">. . .</char> <char style="w" strong="G3956">of all</char> <char style="w" strong="G3745">. . .</char> <char style="w" strong="G4160">they had done</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3745">-</char> <char style="w" strong="G1321">taught</char>. <verse style="v" number="31" /><char style="w" strong="G2532">And</char> <char style="w" strong="G3004">He said</char> <char style="w" strong="G846">to them</char>, <char style="wj">“<char style="w" strong="G1205">Come</char> <char style="w" strong="G2596">with Me</char> <char style="w" strong="G4771">vvv</char> <char style="w" strong="G846">privately</char> <char style="w" strong="G2398">. . .</char> <char style="w" strong="G1519">to</char> <char style="w" strong="G2048">[a] solitary</char> <char style="w" strong="G5117">place</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G373">let us rest</char> <char style="w" strong="G3641">for a while</char>.”</char> <char style="w" strong="G1063">For</char> <char style="w" strong="G4183">many [people]</char> <char style="w" strong="G1510">were</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2064">coming</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G5217">going</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G3761">vvv</char> <char style="w" strong="G2119">they did not even have time</char> <char style="w" strong="G5315">to eat<