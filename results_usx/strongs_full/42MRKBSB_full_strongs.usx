  <para style="p"> <verse style="v" number="22" /><char style="w" strong="G2532">-</char> <char style="w" strong="G846">vvv</char> <char style="w" strong="G2068">While they were eating</char>, <char style="w" strong="G2983">[Jesus] took</char> <char style="w" strong="G740">bread</char>, <char style="w" strong="G2127">spoke a blessing</char> <char style="w" strong="G2806">[and] broke it</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G1325">gave [it]</char> <char style="w" strong="G846">to [the disciples]</char>, <char style="w" strong="G2532">-</char> <char style="w" strong="G2036">saying</char>, <char style="wj">“<char style="w" strong="G2983">Take [it]</char>; <char style="w" strong="G3778">this</char> <char style="w" strong="G1510">is</char> <char style="w" strong="G1473">My</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4983">body</char>.”</char></para>
