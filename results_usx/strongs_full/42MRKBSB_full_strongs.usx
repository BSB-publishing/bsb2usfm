  <para style="p"> <verse style="v" number="16" /><char style="w" strong="G2532">-</char> <char style="w" strong="G3588">[These are] the</char> <char style="w" strong="G1427">twelve</char> <char style="w" strong="G4160">He appointed</char>:<note style="f" caller="+"><char style="fr">3:16 </char><char style="ft">SBL, NE, and WH; ECM, BYZ, and TR do not include </char><char style="fqa">These are the twelve He appointed</char></note> <char style="w" strong="G2532">-</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4613">Simon</char> <char style="w" strong="G2007">(whom He named</char> <char style="w" strong="G3686">-</char> <char style="w" strong="G4074">Peter)</char>, <verse style="v" number="17" /><char style="w" strong="G2532">-</char> <char style="w" strong="G2385">James</char> <char style="w" strong="G3588">[son]</char> <char style="w" strong="G3588">of</char> <char style="w" strong="G2199">Zebedee</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2385">his</char> <char style="w" strong="G80">brother</char> <char style="w" strong="G2491">John</char> <char style="w" strong="G2532">-</char> <char style="w" strong="G846">( [whom]</char> <char style="w" strong="G2007">vvv</char> <char style="w" strong="G3686">He named</char> <char style="w" strong="G993">Boanerges</char>, <char style="w" strong="G3739">-</char> <char style="w" strong="G1510">meaning</char> “<char style="w" strong="G5207">Sons</char> <char style="w" strong="G1027">of Thunder</char>”), <verse style="v" number="18" /><char style="w" strong="G2532">-</char> <char style="w" strong="G406">Andrew</char>, <char style="w" strong="G2532">-</char> <char style="w" strong="G5376">Philip</char>, <char style="w" strong="G2532">-</char> <char style="w" strong="G918">Bartholomew</char>, <char style="w" strong="G2532">-</char> <char style="w" strong="G3156">Matthew</char>, <char style="w" stron