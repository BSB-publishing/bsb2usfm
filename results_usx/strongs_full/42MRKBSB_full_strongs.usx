  <para style="p"> <verse style="v" number="19" /><char style="w" strong="G2532">-</char> <char style="w" strong="G5180">They kept striking</char> <char style="w" strong="G846">His</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2776">head</char> <char style="w" strong="G2563">with a staff</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G1716">spitting on</char> <char style="w" strong="G846">Him</char>. <char style="w" strong="G2532">And</char> <char style="w" strong="G5087">they knelt down</char> <char style="w" strong="G3588">. . .</char> <char style="w" strong="G1119">. . .</char> <char style="w" strong="G4352">[and] bowed</char> <char style="w" strong="G846">before Him</char>. <verse style="v" number="20" /><char style="w" strong="G2532">After</char> <char style="w" strong="G3753">. . .</char> <char style="w" strong="G1702">they had mocked</char> <char style="w" strong="G846">Him</char>, <char style="w" strong="G1562">they removed</char> <char style="w" strong="G846">-</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4209">purple [robe]</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G1746">put</char> <char style="w" strong="G846">His</char> <char style="w" strong="G2398">own</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2440">clothes [back]</char> <char style="w" strong="G846">on Him</char>. <char style="w" strong="G2532">Then</char> <char style="w" strong="G1806">they led Him out</char> <char style="w" strong="G846">. . .</char> <char style="w" strong="G2443">to</char> <char style="w" strong="G4717">crucify</char> <char style="w" strong="G846">Him</char>.</para>
