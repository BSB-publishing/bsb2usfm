  <para style="p"><char style="wj"> <verse style="v" number="16" />“<char style="w" strong="G5101">What</char> <char style="w" strong="G4802">are you disputing</char> <char style="w" strong="G4314">with</char> <char style="w" strong="G848">them</char>?”</char> <char style="w" strong="G2532">-</char> <char style="w" strong="G1905">He asked</char> <char style="w" strong="G846">-</char>.</para>
  <para style="p"> <verse style="v" number="17" /><char style="w" strong="G2532">-</char> <char style="w" strong="G1520">Someone</char> <char style="w" strong="G1537">in</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3793">crowd</char> <char style="w" strong="G611">replied</char> <char style="w" strong="G846">-</char>, “<char style="w" strong="G1320">Teacher</char>, <char style="w" strong="G5342">I brought</char> <char style="w" strong="G4314">. . .</char> <char style="w" strong="G4771">You</char> <char style="w" strong="G1473">my</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G5207">son</char>, <char style="w" strong="G2192">who has</char> <char style="w" strong="G4151">a spirit</char> <char style="w" strong="G216">[that makes him] mute</char>. <verse style="v" number="18" /><char style="w" strong="G2532">-</char> <char style="w" strong="G3699">Whenever</char> <char style="w" strong="G1437">. . .</char> <char style="w" strong="G2638">it seizes</char> <char style="w" strong="G846">him</char>, <char style="w" strong="G4486">it throws him to the ground</char> <char style="w" strong="G846">. . .</char>. <char style="w" strong="G2532">-</char> <char style="w" strong="G875">He foams at the mouth</char>, <char style="w" strong="G2532">-</char> <char style="w" strong="G5149">gnashes</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3599">his teeth</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G3583">becomes rigid</char>.<note style="f" caller="+"><char style="fr">9:18 </char><char style="ft">Or </char><char style="fqa">and is withering away</char></note> <char style="w" strong="G2532">-</char> <char style="w" strong="G2036">I asked</char> <char style="w" strong="G4771">Your</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3101">disciples</char> <char style="w" strong="G2443">to</char> <char style="w" strong="G1544">drive it out</char> <char style="w" strong="G846">. . .</char>, <char style="w" strong="G2532">but</char> <char style="w" strong="G3756">vvv</char> <char style="w" strong="G2480">they were unable</char>.”</para>
  <para style="p"><char style="wj"> <verse style="v" number="19" />“<char style="w" strong="G5599">O</char> <char style="w" strong="G571">unbelieving</char> <char style="w" strong="G1074">generation</char>!”</char> <char style="w" strong="G1161">-</char> <char style="w" strong="G846">-</char> <char style="w" strong="G3004">[Jesus]</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G611">replied</char>. <char style="wj">“<char style="w" strong="G2193">How long</char> <char style="w" strong="G4219">. . .</char> <char style="w" strong="G1510">must I remain</char> <char style="w" strong="G4314">with</char> <char style="w" strong="G4771">you</char>? <char style="w" strong="G2193">How long</char> <char style="w" strong="G4219">. . .</char> <char style="w" strong="G430">must I put up with</char> <char style="w" strong="G4771">you</char>? <char style="w" strong="G5342">Bring</char> <char style="w" strong="G846">[the boy]</char> <char style="w" strong="G4314">to</char> <char style="w" strong="G1473">Me</char>.”</char></para>
