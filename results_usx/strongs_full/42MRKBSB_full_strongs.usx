  <para style="p"> <verse style="v" number="46" /><char style="w" strong="G2532">Next</char>, <char style="w" strong="G2064">they came</char> <char style="w" strong="G1519">to</char> <char style="w" strong="G2410">Jericho</char>. <char style="w" strong="G2532">And</char> <char style="w" strong="G846">as [Jesus]</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G846">His</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3101">disciples</char> <char style="w" strong="G1607">were leaving</char> <char style="w" strong="G575">. . .</char> <char style="w" strong="G2410">Jericho</char> <char style="w" strong="G2532">with</char> <char style="w" strong="G2425">a large</char> <char style="w" strong="G3793">crowd</char>, <char style="w" strong="G5185">a blind</char> <char style="w" strong="G4319">beggar</char> <char style="w" strong="G924">[named] Bartimaeus</char>, <char style="w" strong="G3588">the</char> <char style="w" strong="G5207">son</char> <char style="w" strong="G5090">of Timaeus</char>, <char style="w" strong="G2521">was sitting</char> <char style="w" strong="G3844">beside</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3598">road</char>. <verse style="v" number="47" /><char style="w" strong="G2532">When</char> <char style="w" strong="G191">he heard</char> <char style="w" strong="G3754">that</char> <char style="w" strong="G1510">it was</char> <char style="w" strong="G2424">Jesus</char> <char style="w" strong="G3588">of</char> <char style="w" strong="G3479">Nazareth</char>, <char style="w" strong="G756">he began</char> <char style="w" strong="G2896">to cry out</char> <char style="w" strong="G2532">. . .</char> <char style="w" strong="G3004">. . .</char>, “<char style="w" strong="G2424">Jesus</char>, <char style="w" strong="G5207">Son</char> <char style="w" strong="G1138">of David</char>, <char style="w" strong="G1653">have mercy on</char> <char style="w" strong="G1473">me</char>!”</para>
