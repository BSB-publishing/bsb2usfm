  <para style="p"><char style="wj"> <verse style="v" number="51" />“<char style="w" strong="G5101">What</char> <char style="w" strong="G2309">do you want</char> <char style="w" strong="G4160">Me to do</char> <char style="w" strong="G4771">for you</char>?”</char> <char style="w" strong="G2532">-</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2424">Jesus</char> <char style="w" strong="G611">asked</char> <char style="w" strong="G846">-</char> <char style="w" strong="G2036">-</char>.</para>
