  <para style="p"> <verse style="v" number="53" /><char style="w" strong="G2532">When</char> <char style="w" strong="G1276">they had crossed over</char>, <char style="w" strong="G2064">they landed</char> <char style="w" strong="G1909">. . .</char> <char style="w" strong="G3588">. . .</char> <char style="w" strong="G1093">. . .</char> <char style="w" strong="G1519">at</char> <char style="w" strong="G1082">Gennesaret</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G4358">moored [the boat]</char>. <verse style="v" number="54" /><char style="w" strong="G2532">-</char> <char style="w" strong="G2112">As soon as</char> <char style="w" strong="G846">they</char> <char style="w" strong="G1831">got</char> <char style="w" strong="G1537">out of</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4143">boat</char>, <char style="w" strong="G1921">[the people] recognized</char> <char style="w" strong="G846">[Jesus]</char> <verse style="v" number="55" /><char style="w" strong="G4063">[and] ran through</char> <char style="w" strong="G1565">that</char> <char style="w" strong="G3650">whole</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G5561">region</char>, <char style="w" strong="G2532">-</char> <char style="w" strong="G756">vvv</char> <char style="w" strong="G4064">carrying</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2560">sick</char> <char style="w" strong="G2192">. . .</char> <char style="w" strong="G1909">on</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2895">mats</char> <char style="w" strong="G3699">to wherever</char> <char style="w" strong="G191">they heard</char> <char style="w" strong="G3754">-</char> <char style="w" strong="G1510">He was</char>. <verse style="v" number="56" /><char style="w" strong="G2532">And</char> <char style="w" strong="G3699">wherever</char> <char style="w" strong="G302">. . .</char> <char style="w" strong="G1531">He went</char>