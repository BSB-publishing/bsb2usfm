  <chapter number="4" style="c" />
  <para style="s1">The Parable of the Sower</para>
  <para style="r">(<ref loc="MAT 13:1-9">Matthew 13:1–9</ref>; <ref loc="LUK 8:4-8">Luke 8:4–8</ref>)</para>
  <para style="p"> <verse style="v" number="1" /><char style="w" strong="G2532">[Once]</char> <char style="w" strong="G3825">again</char> <char style="w" strong="G756">[Jesus] began</char> <char style="w" strong="G1321">to teach</char> <char style="w" strong="G3844">beside</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2281">sea</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G4118">[such] a large</char> <char style="w" strong="G3793">crowd</char> <char style="w" strong="G4863">gathered</char> <char style="w" strong="G4314">around</char> <char style="w" strong="G846">Him</char> <char style="w" strong="G5620">that</char> <char style="w" strong="G846">He</char> <char style="w" strong="G1684">got into</char> <char style="w" strong="G1519">. . .</char> <char style="w" strong="G4143">a boat</char> <char style="w" strong="G2521">[and] sat</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2281">[it]</char>, <char style="w" strong="G2532">while</char> <char style="w" strong="G3956">all</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3793">people</char> <char style="w" strong="G1510">crowded</char> <char style="w" strong="G4314">. . .</char> <char style="w" strong="G3588">. . .</char> <char style="w" strong="G2281">. . .</char> <char style="w" strong="G1909">along</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G1093">shore</char>.</para>
  <para style="p"> <verse style="v" number="2" /><char style="w" strong="G2532">And</char> <char style="w" strong="G1321">He taught</char> <char style="w" strong="G846">them</char> <char style="w" strong="G4183">many things</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G3850">parables</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G846">His</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G1322">teaching</char> <char style="w" strong="G2036">He said</char> <char style="w" strong="G846">-</char>, <char style="wj"> <verse style="v" number="3" />“<char style="w" strong="G191">Listen</char> <char style="w" strong="G2400">. . .</char>! <char style="w" strong="G3588">A</char> <char style="w" strong="G4687">farmer</char> <char style="w" strong="G1831">went out</char> <char style="w" strong="G4687">to sow his seed</char>. <verse style="v" number="4" /><char style="w" strong="G2532">And</char> <char style="w" strong="G1096">-</char> <char style="w" strong="G1722">as</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4687">he was sowing</char>, <char style="w" strong="G3303">-</char> <char style="w" strong="G3739">some [seed]</char> <char style="w" strong="G4098">fell</char> <char style="w" strong="G3844">along</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3598">path</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4071">birds</char> <char style="w" strong="G2064">came</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G2719">devoured</char> <char style="w" strong="G846">it</char>.</char></para>
