  <para style="p"> <verse style="v" number="23" /><char style="w" strong="G2532">vvv</char> <char style="w" strong="G1096">vvv</char> <char style="w" strong="G1722">One</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4521">Sabbath</char> <char style="w" strong="G846">[Jesus]</char> <char style="w" strong="G3899">was passing</char> <char style="w" strong="G1223">through</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4702">grainfields</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G846">His</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3101">disciples</char> <char style="w" strong="G756">began</char> <char style="w" strong="G5089">to pick</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4719">heads of grain</char> <char style="w" strong="G4160">[as] they walked along</char> <char style="w" strong="G3598">. . .</char>. <verse style="v" number="24" /><char style="w" strong="G2532">[So]</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G5330">Pharisees</char> <char style="w" strong="G2036">said</char> <char style="w" strong="G846">to Him</char>, “<char style="w" strong="G2400">Look</char>, <char style="w" strong="G5101">why</char> <char style="w" strong="G4160">are they doing</char> <char style="w" strong="G3739">what</char> <char style="w" strong="G3756">vvv</char> <char style="w" strong="G1832">is unlawful</char> <char style="w" strong="G3588">on the</char> <char style="w" strong="G4521">Sabbath</char>?”</para>
  <para style="p"> <verse style="v" number="25" /><char style="w" strong="G2532">. . .</char> <char style="w" strong="G3004">[Jesus] replied</char> <char style="w" strong="G846">. . .</char>, <char style="wj">“<char style="w" strong="G3763">vvv</char> <char style="w" strong="G314">Have you never read</char> <char style="w" strong="G5101">what</char> <char style="w" strong="G1138">David</char> <char style="w" strong="G4160">did</char> <char style="w" strong="G3753">when</char> <char style="w" strong="G846">he</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3588">his companions</char> <char style="w" strong="G3326">. . .</char> <char style="w" strong="G846">. . .</char> <char style="w" strong="G3983">were hungry</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G2192">-</char> <char style="w" strong="G5532">in need</char>? <verse style="v" number="26" /><char style="w" strong="G1909">During</char> <char style="w" strong="G749">the high priesthood</char> <char style="w" strong="G8">of Abiathar</char>, <char style="w" strong="G4459">-</char> <char style="w" strong="G1525">he entered</char> <char style="w" strong="G1519">. . .</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3624">house</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2316">of God</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G5315">ate</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G740">consecrated bread</char> <char style="w" strong="G3588">. . .</char> <char style="w" strong="G4286">. . .</char>,<note style="f" caller="+"><char style="fr">2:26 </char><char style="ft">Or </char><char style="fqa">the Bread of the Presence</char></note> <char style="w" strong="G3739">which</char> <char style="w" strong="G3756">vvv</char> <char style="w" strong="G1832">was lawful</char> <char style="w" strong="G5315">-</char> <char style="w" strong="G1487">only</char> <char