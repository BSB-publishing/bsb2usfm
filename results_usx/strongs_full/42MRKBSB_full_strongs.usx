  <para style="p"> <verse style="v" number="66" /><char style="w" strong="G2532">While</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4074">Peter</char> <char style="w" strong="G1510">was</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G833">courtyard</char> <char style="w" strong="G2736">below</char>, <char style="w" strong="G1520">one</char> <char style="w" strong="G3588">of the</char> <char style="w" strong="G3814">servant girls</char> <char style="w" strong="G3588">of the</char> <char style="w" strong="G749">high priest</char> <char style="w" strong="G2064">came down</char> <verse style="v" number="67" /><char style="w" strong="G2532">and</char> <char style="w" strong="G3708">saw</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4074">[him]</char> <char style="w" strong="G2328">warming himself [there]</char>. <char style="w" strong="G1689">She looked at</char> <char style="w" strong="G846">[Peter]</char> <char style="w" strong="G3004">[and] said</char>, “<char style="w" strong="G4771">You</char> <char style="w" strong="G2532">also</char> <char style="w" strong="G1510">were</char> <char style="w" strong="G3326">with</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2424">Jesus</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3479">Nazarene</char>.”</para>
