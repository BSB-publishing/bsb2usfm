  <para style="p"> <verse style="v" number="29" /><char style="w" strong="G2532">When</char> <char style="w" strong="G846">[John’s]</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3101">disciples</char> <char style="w" strong="G191">heard about [this]</char>, <char style="w" strong="G2064">they came</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G142">took</char> <char style="w" strong="G846">his</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4430">body</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G5087">placed</char> <char style="w" strong="G846">it</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G3419">[a] tomb</char>.</para>
