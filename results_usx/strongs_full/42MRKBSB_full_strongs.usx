  <para style="q1"><char style="wj">‘<char style="w" strong="G3778">These</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2992">people</char> <char style="w" strong="G5091">honor</char> <char style="w" strong="G1473">Me</char> <char style="w" strong="G3588">with [their]</char> <char style="w" strong="G5491">lips</char>,</char></para>
