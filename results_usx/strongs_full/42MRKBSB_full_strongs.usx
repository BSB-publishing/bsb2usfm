  <para style="p"><char style="wj"> <verse style="v" number="62" />“<char style="w" strong="G1473">I</char> <char style="w" strong="G1510">am</char>,”</char> <char style="w" strong="G1161">-</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2036">said</char> <char style="w" strong="G2424">Jesus</char>, <char style="wj">“<char style="w" strong="G2532">and</char> <char style="w" strong="G3708">you will see</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G5207">Son</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G444">of Man</char> <char style="w" strong="G2521">sitting</char> <char style="w" strong="G1537">at</char> <char style="w" strong="G1188">[the] right hand</char> <char style="w" strong="G3588">of</char> <char style="w" strong="G1411">Power</char><note style="f" caller="+"><char style="fr">14:62 </char><char style="ft">Or </char><char style="fqa">the right hand of the Mighty One</char></note> <char style="w" strong="G2532">and</char> <char style="w" strong="G2064">coming</char> <char style="w" strong="G3326">with</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3507">clouds</char> <char style="w" strong="G3588">of</char> <char style="w" strong="G3772">heaven</char>.”</char><note style="f" caller="+"><char style="fr">14:62 </char><char style="ft">See <ref loc="PSA 110:1">Psalm 110:1</ref> and Daniel 7:13.</char></note></para>
  <para style="p"> <verse style="v" number="63" /><char style="w" strong="G1161">At this</char>, <char style="w" strong="G3588">the</char> <char style="w" strong="G749">high priest</char> <char style="w" strong="G1284">tore</char> <char style="w" strong="G846">his</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G5509">clothes</char> <char style="w" strong="G3004">[and] declared</char>, “<char style="w" strong="G5101">Why</char> <char style="w" strong="G5532">do we need</char> <char style="w" strong="G2192">. . .</char> <char style="w" strong="G2089">any more</char> <char style="w" strong="G3144">witnesses</char>? <verse style="v" number="64" /><char style="w" strong="G191">You have heard</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G988">blasphemy</char>. <char style="w" strong="G5101">What</char> <char style="w" strong="G4771">is your</char> <char style="w" strong="G5316">verdict</char>?”</para>
  <para style="p"><char style="w" strong="G1161">And</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3956">they all</char> <char style="w" strong="G2632">condemned</char> <char style="w" strong="G846">Him</char> <char style="w" strong="G1510">as</char> <char style="w" strong="G1777">deserving</char> <char style="w" strong="G2288">of death</char>.</para>
  <para style="p"> <verse style="v" number="65" /><char style="w" strong="G2532">Then</char> <char style="w" strong="G5100">some [of them]</char> <char style="w" strong="G756">began</char> <char style="w" strong="G1716">to spit on</char> <char style="w" strong="G846">Him</char>. <char style="w" strong="G2532">-</char> <char style="w" strong="G4028">They blindfolded Him</char> <char style="w" strong="G846">. . .</char> <char style="w" strong="G3588">. . .</char> <char style="w" strong="G4383">. . .</char>, <char style="w" strong="G2532">-</char> <char style="w" strong="G2852">struck Him with their fists</char> <char style="w" strong="G846">. . .</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G3004">said</char> <char style="w" strong="G846">to Him</char>, “<char style="w" strong="G4395">Prophesy</char>!” <char style="w" strong="G2532">And</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G5257">officers</char> <char style="w" strong="G2983">received</char> <char style="w" strong="G846">Him</char> <char style="w" strong="G4475">with slaps in His face</char>.</para>
  <para style="s1">Peter Denies Jesus</para>
