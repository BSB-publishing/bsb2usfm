  <para style="p"> <verse style="v" number="41" /><char style="w" strong="G2532">-</char> <char style="w" strong="G2983">Taking</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4002">five</char> <char style="w" strong="G740">loaves</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G1417">two</char> <char style="w" strong="G2486">fish</char> <char style="w" strong="G308">[and] looking up</char> <char style="w" strong="G1519">to</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3772">heaven</char>, <char style="w" strong="G2127">[Jesus] spoke a blessing</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G2622">broke</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G740">loaves</char>. <char style="w" strong="G2532">Then</char> <char style="w" strong="G1325">He gave [them]</char> <char style="w" strong="G3588">to</char> <char style="w" strong="G846">His</char> <char style="w" strong="G3101">disciples</char> <char style="w" strong="G2443">to</char> <char style="w" strong="G3908">set before</char> <char style="w" strong="G846">[the people]</char>. <char style="w" strong="G2532">And</char> <char style="w" strong="G3307">He divided</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G1417">two</char> <char style="w" strong="G2486">fish</char> <char style="w" strong="G3956">among them all</char>.</para>
  <para style="p"> <verse style="v" number="42" /><char style="w" strong="G2532">-</char> <char style="w" strong="G3956">{They} all</char> <char style="w" strong="G5315">ate</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G5526">were satisfied</char>, <verse style="v" number="43" /><char style="w" strong="G2532">and</char> <char style="w" strong="G142">[the disciples] picked up</char> <char style="w" strong="G1427">twelve</char> <char style="w" strong="G2894">basketfuls</char> <char style="w" strong="G4138">. . .</char> <char style="w" strong="G2801">of broken pieces of bread</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G575">-</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2486">fish</char>. <verse style="v" number="44" /><char style="w" strong="G2532">And</char> <char style="w" strong="G1510">there were</char> <char style="w" strong="G4000">five thousand</char> <char style="w" strong="G435">men</char> <char style="w" strong="G3588">who</char> <char style="w" strong="G5315">had eaten</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G740">loaves</char>.</para>
