  <para style="p"> <verse style="v" number="32" /><char style="w" strong="G2532">So</char> <char style="w" strong="G565">they went away</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4143">a boat</char> <char style="w" strong="G2596">by</char> <char style="w" strong="G2398">themselves</char> <char style="w" strong="G1519">to</char> <char style="w" strong="G2048">a solitary</char> <char style="w" strong="G5117">place</char>. <verse style="v" number="33" /><char style="w" strong="G2532">But</char> <char style="w" strong="G4183">many [people]</char> <char style="w" strong="G3708">saw</char> <char style="w" strong="G846">them</char> <char style="w" strong="G5217">leaving</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G1921">recognized [them]</char>. <char style="w" strong="G2532">-</char> <char style="w" strong="G4936">They ran together</char> <char style="w" strong="G1563">-</char> <char style="w" strong="G3979">on foot</char> <char style="w" strong="G575">from</char> <char style="w" strong="G3956">all</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4172">towns</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G4281">arrived before</char> <char style="w" strong="G846">them</char>. <verse style="v" number="34" /><char style="w" strong="G2532">When</char> <char style="w" strong="G1831">[Jesus] stepped ashore</char> <char style="w" strong="G3708">[and] saw</char> <char style="w" strong="G4183">a large</char> <char style="w" strong="G3793">crowd</char>, <char style="w" strong="G2532">-</char> <char style="w" strong="G4697">He had compassion</char> <char style="w" strong="G1909">on</char> <char style="w" strong="G846">them</char>, <char style="w" strong="G3754">because</char> <char style="w" strong="G1510">they were</char> <char style="w" strong="G5613">like</char> <char style="w" strong="G4263">sheep</char> <char style="w" strong="G33