  <para style="r">(<ref loc="MAT 9:18-26">Matthew 9:18–26</ref>; <ref loc="LUK 8:40-56">Luke 8:40–56</ref>)</para>
  <para style="p"> <verse style="v" number="21" /><char style="w" strong="G2532">When</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2424">Jesus</char> <char style="w" strong="G1276">had again crossed</char> <char style="w" strong="G3825">. . .</char> <char style="w" strong="G1722">by</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4143">boat</char> <char style="w" strong="G1519">to</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4008">other side</char>, <char style="w" strong="G4183">a large</char> <char style="w" strong="G3793">crowd</char> <char style="w" strong="G4863">gathered</char> <char style="w" strong="G1909">around</char> <char style="w" strong="G846">Him</char> <char style="w" strong="G2532">-</char> <char style="w" strong="G1510">-</char> <char style="w" strong="G3844">beside</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2281">sea</char>. <verse style="v" number="22" /><char style="w" strong="G2532">-</char> <char style="w" strong="G1520">A</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G752">synagogue leader</char> <char style="w" strong="G3686">named</char> <char style="w" strong="G2383">Jairus</char> <char style="w" strong="G2064">arrived</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G3708">seeing</char> <char style="w" strong="G846">[Jesus]</char>, <char style="w" strong="G4098">he fell</char> <char style="w" strong="G4314">at</char> <char style="w" strong="G846">His</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4228">feet</char> <verse style="v" number="23" /><char style="w" strong="G2532">and</char> <char style="w" strong="G3870">pleaded with</char> <char style="w" strong="G846">Him</char> <char style="w" strong="G4183">urgently</char> <char style="w" strong="G3004">-</char> <char style="w" strong="G3754">-</char>, “<char style="w" strong="G1473">My</char> <char style="