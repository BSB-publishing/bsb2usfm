  <para style="p"> <verse style="v" number="6" /><char style="w" strong="G2532">When</char> <char style="w" strong="G3708">[the man] saw</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2424">Jesus</char> <char style="w" strong="G575">from</char> <char style="w" strong="G3113">a distance</char>, <char style="w" strong="G5143">he ran</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G4352">fell on his knees</char> <char style="w" strong="G846">before Him</char>. <verse style="v" number="7" /><char style="w" strong="G2532">And</char> <char style="w" strong="G2896">he shouted</char> <char style="w" strong="G3173">vvv</char> <char style="w" strong="G5456">in a loud voice</char> <char style="w" strong="G3004">-</char>, “<char style="w" strong="G5101">What</char> <char style="w" strong="G4771">do You [want]</char> <char style="w" strong="G2532">-</char> <char style="w" strong="G1473">with me</char>, <char style="w" strong="G2424">Jesus</char>, <char style="w" strong="G5207">Son</char> <char style="w" strong="G3588">of</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G5310">Most High</char> <char style="w" strong="G2316">God</char>? <char style="w" strong="G3726">I beg</char> <char style="w" strong="G4771">You</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2316">before God</char> <char style="w" strong="G3361">not</char> <char style="w" strong="G928">to torture</char> <char style="w" strong="G1473">me</char>!” <verse style="v" number="8" /><char style="w" strong="G1063">For</char> <char style="w" strong="G2036">[Jesus] had already declared</char> <char style="w" strong="G846">. . .</char>, <char style="wj">“<char style="w" strong="G1831">Come</char> <char style="w" strong="G1537">out of</char> <char style="w" strong="G3588">[this]</char> <char style="w" strong="G444">man</char> <char style="w" strong="G3588">-</char>, <char style="w" strong="G169">{you} unclean</char> <char style