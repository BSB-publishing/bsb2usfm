  <para style="p"> <verse style="v" number="27" /><char style="w" strong="G2532">Then</char> <char style="w" strong="G2036">[Jesus] declared</char> <char style="w" strong="G846">-</char>, <char style="wj">“<char style="w" strong="G3588">The</char> <char style="w" strong="G4521">Sabbath</char> <char style="w" strong="G1096">was made</char> <char style="w" strong="G1223">for</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G444">man</char>, <char style="w" strong="G2532">-</char> <char style="w" strong="G3756">not</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G444">man</char> <char style="w" strong="G1223">for</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4521">Sabbath</char>. <verse style="v" number="28" /><char style="w" strong="G5620">Therefore</char>, <char style="w" strong="G3588">the</char> <char style="w" strong="G5207">Son</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G444">of Man</char> <char style="w" strong="G1510">is</char> <char style="w" strong="G2962">Lord</char> <char style="w" strong="G2532">even</char> <char style="w" strong="G3588">of the</char> <char style="w" strong="G4521">Sabbath</char>.”</char></para>
  <chapter number="3" style="c" />
  <para style="s1">Jesus Heals on the Sabbath</para>
  <para style="r">(<ref loc="MAT 12:9-14">Matthew 12:9–14</ref>; <ref loc="LUK 6:6-11">Luke 6:6–11</ref>)</para>
  <para style="p"> <verse style="v" number="1" /><char style="w" strong="G2532">vvv</char> <char style="w" strong="G3825">Once again</char> <char style="w" strong="G1525">[Jesus] entered</char> <char style="w" strong="G1519">. . .</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G4864">synagogue</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G444">a man</char> <char style="w" strong="G2192">with</char> <char style="w" strong="G3588">a</char> <char style="w" strong="G3583">withered</char> <char style="w" strong="G5495">hand</char> <char style="w" strong="G1510">was</char> <char style="w" strong="G1563">there</char>. <verse style="v" number="2" /><char style="w" strong="G2532">-</char> <char style="w" strong="G2443">In order to</char> <char style="w" strong="G2723">accuse</char> <char style="w" strong="G846">[Jesus]</char>, <char style="w" strong="G3906">they were watching</char> <char style="w" strong="G846">-</char> <char style="w" strong="G1487">{to see} if</char> <char style="w" strong="G2323">He would heal</char> <char style="w" strong="G846">-</char> <char style="w" strong="G3588">on the</char> <char style="w" strong="G4521">Sabbath</char>.</para>
  <para style="p"> <verse style="v" number="3" /><char style="w" strong="G2532">Then</char> <char style="w" strong="G3004">[Jesus] said</char> <char style="w" strong="G3588">to the</char> <char style="w" strong="G444">man</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2192">with</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3584">withered</char> <char style="w" strong="G5495">hand</char>, <char style="wj">“<char style="w" strong="G1453">Stand up</char> <char style="w" strong="G1519">vvv</char> <char style="w" strong="G3588">vvv</char> <char style="w" strong="G3319">among [us]</char>.”</char> <verse style="v" number="4" /><char style="w" strong="G2532">And</char> <char style="w" strong="G3004">He asked</char> <char style="w" strong="G846">them</char>, <char style="wj">“<char style="w" strong="G1832">Which is lawful</char> <char style="w" strong="G3588">on the</char> <char style="w" strong="G4521">Sabbath</char>: <char style="w" strong="G15">to do good</char> <char style="w" strong="G2228">or</char> <char style="w" strong="G2554">to do evil</char>, <char style="w" strong="G4982">to save</char> <char style="w" strong="G5590">life</char> <char style="w" strong="G2228">or</char> <char style="w" strong="G615">to destroy [it]</char>?”</char></para>
  <para style="p"><char style="w" strong="G1161">But</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4623">they were silent</char>.</para>
  <para style="p"> <verse style="v" number="5" /><char style="w" strong="G2532">-</char> <char style="w" strong="G4017">[Jesus] looked around at</char> <char style="w" strong="G846">them</char> <char style="w" strong="G3326">with</char> <char style="w" strong="G3709">anger</char> <char style="w" strong="G4818">[and] sorrow</char> <char style="w" strong="G1909">at</char> <char style="w" strong="G3588">[their]</char> <char style="w" strong="G4457">hardness</char> <char style="w" strong="G3588">of</char> <char style="w" strong="G846">-</char> <char style="w" strong="G2588">heart</char>. <char style="w" strong="G2532">Then</char> <char style="w" strong="G3004">He said</char> <char style="w" strong="G3588">to the</char> <char style="w" strong="G444">man</char>, <char style="wj">“<char style="w" strong="G1614">Stretch out</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G4771">your</char> <char style="w" strong="G5495">hand</char>.”</char> <char style="w" strong="G1614">So he stretched [it] out</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G846">vvv</char> <char style="w" strong="G3588">vvv</char> <char style="w" strong="G5495">[it]</char> <char style="w" strong="G600">was restored</char>.</para>
  <para style="p"> <verse style="v" number="6" /><char style="w" strong="G2532">At this</char> <char style="w" strong="G2112">. . .</char>, <char style="w" strong="G3588">the</char> <char style="w" strong="G5330">Pharisees</char> <char style="w" strong="G1831">went out</char> <char style="w" strong="G1325">[and] began plotting</char> <char style="w" strong="G4824">. . .</char> <char style="w" strong="G3326">with</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G2265">Herodians</char> <char style="w" strong="G2596">-</char> <char style="w" strong="G846">-</char> <char style="w" strong="G3704">how</char> <char style="w" strong="G622">they might kill</char> <char style="w" strong="G846">[Jesus]</char>.</para>
