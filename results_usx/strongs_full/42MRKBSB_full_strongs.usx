  <para style="p"> <verse style="v" number="7" /><char style="w" strong="G2532">Then</char> <char style="w" strong="G3507">a cloud</char> <char style="w" strong="G1096">appeared</char> <char style="w" strong="G1982">[and] enveloped</char> <char style="w" strong="G846">them</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G5456">a voice</char> <char style="w" strong="G1096">came</char> <char style="w" strong="G1537">from</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3507">cloud</char>: “<char style="w" strong="G3778">This</char> <char style="w" strong="G1510">is</char> <char style="w" strong="G1473">My</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G27">beloved</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G5207">Son</char>. <char style="w" strong="G191">Listen</char> <char style="w" strong="G846">to Him</char>!” <verse style="v" number="8" /><char style="w" strong="G2532">-</char> <char style="w" strong="G1819">Suddenly</char>, <char style="w" strong="G4017">[when] they looked around</char>, <char style="w" strong="G3708">they saw</char> <char style="w" strong="G3765">no</char> <char style="w" strong="G3762">one</char> <char style="w" strong="G3326">with</char> <char style="w" strong="G1438">them</char> <char style="w" strong="G235">except</char> <char style="w" strong="G3440">. . .</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2424">Jesus</char>.</para>
  <para style="p"> <verse style="v" number="9" /><char style="w" strong="G2532">[As]</char> <char style="w" strong="G846">they</char> <char style="w" strong="G2597">were coming down</char> <char style="w" strong="G1537">. . .</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3735">mountain</char>, <char style="w" strong="G1291">[Jesus] admonished</char> <char style="w" strong="G846">them</char> <char style="w" strong="G2443">-</char> <char style="w" strong="G1334">not to tell anyone</char> <char style="w" strong="G3367">. . .</char> <char style="w" strong="G3739">what</char> <char style="w" strong="G3708">they had seen</char> <char style="w" strong="G1487">vvv</char> <char style="w" strong="G3361">vvv</char> <char style="w" strong="G3752">until</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G5207">Son</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G444">of Man</char> <char style="w" strong="G450">had risen</char> <char style="w" strong="G1537">from</char> <char style="w" strong="G3498">[the] dead</char>. <verse style="v" number="10" /><char style="w" strong="G2532">[So]</char> <char style="w" strong="G2902">they kept</char> <char style="w" strong="G3588">this</char> <char style="w" strong="G3056">matter</char> <char style="w" strong="G4314">to</char> <char style="w" strong="G1438">themselves</char>, <char style="w" strong="G4802">discussing</char> <char style="w" strong="G5101">what</char> <char style="w" strong="G1510">it meant</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G450">to rise</char> <char style="w" strong="G1537">from</char> <char style="w" strong="G3498">[the] dead</char>. <verse style="v" number="11" /><char style="w" strong="G2532">And</char> <char style="w" strong="G1905">they asked</char> <char style="w" strong="G846">[Jesus]</char> <char style="w" strong="G3004">-</char> <char style="w" strong="G3754">-</char>, “<char style="w" strong="G3588">{Why do}