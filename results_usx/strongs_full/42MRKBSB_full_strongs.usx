  <para style="p"> <verse style="v" number="55" /><char style="w" strong="G1161">Now</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G749">chief priests</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3650">whole</char> <char style="w" strong="G4892">Sanhedrin</char><note style="f" caller="+"><char style="fr">14:55 </char><char style="ft">Or </char><char style="fqa">the whole Council</char></note> <char style="w" strong="G2212">were seeking</char> <char style="w" strong="G3141">testimony</char> <char style="w" strong="G2596">against</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2424">Jesus</char> <char style="w" strong="G1519">to</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2289">put Him to death</char> <char style="w" strong="G846">. . .</char>, <char style="w" strong="G2532">but</char> <char style="w" strong="G3756">vvv</char> <char style="w" strong="G2147">they did not find [any]</char>. <verse style="v" number="56" /><char style="w" strong="G1063">For</char> <char style="w" strong="G4183">many</char> <char style="w" strong="G5576">bore false witness</char> <char style="w" strong="G2596">against</char> <char style="w" strong="G846">[Jesus]</char>, <char style="w" strong="G2532">but</char> <char style="w" strong="G3588">their</char> <char style="w" strong="G3141">testimony</char> <char style="w" strong="G1510">was</char> <char style="w" strong="G3756">vvv</char> <char style="w" strong="G2470">inconsistent</char>.</para>
  <para style="p"> <verse style="v" number="57" /><char style="w" strong="G2532">Then</char> <char style="w" strong="G5100">some [men]</char> <char style="w" strong="G450">stood up</char> <char style="w" strong="G5576">[and] testified falsely</char> <char style="w" strong="G2596">against</char> <char style="w" strong="G846">Him</char> <char style="w" strong="G3004">-</char>: <verse style="v" number="58" /><char style="w" strong="G3754">-</char> “<char style="w" strong="G1473">We</char> <char style="w" strong="G191">heard</char> <char style="w" strong="G846">Him</char> <char style="w" strong="G3004">say</char> <char style="w" strong="G3754">-</char>, ‘<char style="w" strong="G1473">I</char> <char style="w" strong="G2647">will destroy</char> <char style="w" strong="G3778">this</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G5499">man-made</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3485">temple</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G1223">in</char> <char style="w" strong="G5140">three</char> <char style="w" strong="G2250">days</char> <char style="w" strong="G3618">I will build</char> <char style="w" strong="G243">another [that is]</char> <char style="w" strong="G886">made without hands</char>.’” <verse style="v" number="59" /><char style="w" strong="G2532">But even</char> <char style="w" strong="G846">their</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3141">testimony</char> <char style="w" strong="G1510">was</char> <char style="w" strong="G3779">-</char> <char style="w" strong="G3761">vvv</char> <char style="w" strong="G2470">inconsistent</char>.</para>
  <para style="p"> <verse style="v" number="60" /><char style="w" strong="G2532">[So]</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G749">high priest</char> <char style="w" strong="G450">stood up</char> <char style="w" strong="G1519">vvv</char> <char style="w" strong="G3319">before them</char> <char style="w" strong="G1905">[and] questioned</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2424">Jesus</char> <char style="w" strong="G3004">-</char>, “<char style="w" strong="G3756">vvv</char> <char style="w" strong="G611">Have You no answer</char> <char style="w" strong="G3762">. . .</char>? <char style="w" strong="G5101">What</char> <char style="w" strong="G3778">{are} these [men]</char> <char style="w" strong="G2649">testifying against</char> <char style="w" strong="G4771">You</char>?”</para>
