  <para style="q2"><char style="wj"><char style="w" strong="G1321">they teach</char> <char style="w" strong="G1319">[as] doctrine</char> <char style="w" strong="G1778">[the] precepts</char> <char style="w" strong="G444">of men</char>.’<note style="f" caller="+"><char style="fr">7:7 </char><char style="ft"><ref loc="ISA 29:13">Isaiah 29:13</ref> (see also LXX)</char></note></char></para>
  <para style="p"> <verse style="v" number="8" /><char style="wj"><char style="w" strong="G863">You have disregarded</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G1785">commandment</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2316">of God</char> <char style="w" strong="G2902">to keep</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3862">tradition</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G444">of men</char>.<note style="f" caller="+"><char style="fr">7:8 </char><char style="ft">BYZ and TR include </char><char style="fqa">—washings of pots and cups and many such things like these.</char></note>”</char></para>
  <para style="p"> <verse style="v" number="9" /><char style="w" strong="G2532">vvv</char> <char style="w" strong="G2036">He went on to say</char> <char style="w" strong="G846">-</char>, <char style="wj">“<char style="w" strong="G2573">vvv</char> <char style="w" strong="G114">You neatly set aside</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G1785">command</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2316">of God</char> <char style="w" strong="G2443">to</char> <char style="w" strong="G5083">maintain</char><note style="f" caller="+"><char style="fr">7:9 </char><char style="ft">NA </char><char style="fqa">establish</char></note> <char style="w" strong="G4771">your</char> <char style="w" strong="G3588">[own]</char> <char style="w" strong="G3862">tradition</char>. <verse style="v" number="10" /><char style="w" strong="G1063">For</char> <char style="w" strong="G3475">Moses</char> <char style="w" strong="G2036">said</char>, ‘<char style="w" strong="G5091">Honor</char> <char style="w" strong="G4771">your</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3962">father</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G4771">your</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3384">mother</char>’<note style="f" caller="+"><char style="fr">7:10 </char><char style="ft"><ref loc="EXO 20:12">Exodus 20:12</ref>; Deuteronomy 5:16</char></note> <char style="w" strong="G2532">and</char> ‘<char style="w" strong="G3588">Anyone who</char> <char style="w" strong="G2551">curses</char> <char style="w" strong="G3962">[his] father</char> <char style="w" strong="G2228">or</char> <char style="w" strong="G3384">mother</char> <char style="w" strong="G2288">vvv</char> <char style="w" strong="G5053">must be put to death</char>.’<note style="f" caller="+"><char style="fr">7:10 </char><char style="ft"><ref loc="EXO 21:17">Exodus 21:17</ref>; Leviticus 20:9</char></note> <verse 