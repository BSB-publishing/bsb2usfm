  <para style="p"> <verse style="v" number="9" /><char style="w" strong="G991">Be careful</char>, <char style="w" strong="G1161">however</char>, <char style="w" strong="G3778">[that]</char> <char style="w" strong="G4771">your</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G1849">freedom</char> <char style="w" strong="G3361">vvv</char> <char style="w" strong="G4459">vvv</char> <char style="w" strong="G1096">does not become</char> <char style="w" strong="G4348">a stumbling block</char> <char style="w" strong="G3588">to the</char> <char style="w" strong="G772">weak</char>. <verse style="v" number="10" /><char style="w" strong="G1063">For</char> <char style="w" strong="G1437">if</char> <char style="w" strong="G5100">someone</char> <char style="w" strong="G846">[with]</char> <char style="w" strong="G772">a weak</char> <char style="w" strong="G4893">conscience</char> <char style="w" strong="G3708">sees</char> <char style="w" strong="G4771">you</char> <char style="w" strong="G3588">who</char> <char style="w" strong="G2192">vvv</char> <char style="w" strong="G1108">are well informed</char> <char style="w" strong="G2621">eating</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G1493">an idol’s temple</char>, <char style="w" strong="G3780">{will he} not</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G1510">be</char> <char style="w" strong="G3618">encouraged</char> <char style="w" strong="G1519">to</char> <char style="w" strong="G2068">eat</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3588">[food]</char> <char style="w" strong="G1494">sacrificed to idols</char>? <verse style="v" number="11" /><char style="w" strong="G1063">[So]</char> <char style="w" strong="G3588">[this]</char> <char style="w" strong="G770">weak</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G80">brother</char>, <char style="w" strong="G1223">for</char> <char style="w" strong="G3739">whom</c