  <para style="s1">The Man of Lawlessness</para>
  <para style="p"> <verse style="v" number="1" /><char style="w" strong="G1161">Now</char> <char style="w" strong="G5228">concerning</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3952">coming</char> <char style="w" strong="G1473">of our</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2962">Lord</char> <char style="w" strong="G2424">Jesus</char> <char style="w" strong="G5547">Christ</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G1473">our</char> <char style="w" strong="G1997">being gathered together</char> <char style="w" strong="G1909">to</char> <char style="w" strong="G846">Him</char>, <char style="w" strong="G2065">we ask</char> <char style="w" strong="G4771">you</char>, <char style="w" strong="G80">brothers</char>, <verse style="v" number="2" /><char style="w" strong="G1519">-</char> <char style="w" strong="G4771">-</char> <char style="w" strong="G3361">not</char> <char style="w" strong="G5030">vvv</char> <char style="w" strong="G3588">vvv</char> <char style="w" strong="G4531">to be easily disconcerted</char> <char style="w" strong="G575">. . .</char> <char style="w" strong="G3588">. . .</char> <char style="w" strong="G3563">. . .</char> <char style="w" strong="G3366">[or]</char> <char style="w" strong="G2360">alarmed</char> <char style="w" strong="G3383">-</char> <char style="w" strong="G1223">by</char> <char style="w" strong="G4151">[any] spirit</char> <char style="w" strong="G3383">[or]</char> <char style="w" strong="G1223">-</char> <char style="w" strong="G3056">message</char> <char style="w" strong="G3383">[or]</char> <char style="w" strong="G1223">-</char> <char style="w" strong="G1992">letter</char> <char style="w" strong="G5613">seeming</char> <char style="w" strong="G1223">[to be] from</char> <char style="w" strong="G1473">us</char>, <char style="w" strong="G5613">[alleging]</char> <char style="w" strong="G3754">that</char> <char style="w" strong="G3588">the</char> <char style