  <para style="s1">Jesus Our Advocate</para>
  <para style="p"> <verse style="v" number="1" /><char style="w" strong="G1473">My</char> <char style="w" strong="G5040">little children</char>, <char style="w" strong="G1125">I am writing</char> <char style="w" strong="G3778">these things</char> <char style="w" strong="G4771">to you</char> <char style="w" strong="G2443">so that</char> <char style="w" strong="G3361">vvv</char> <char style="w" strong="G264">you will not sin</char>. <char style="w" strong="G2532">[But]</char> <char style="w" strong="G1437">if</char> <char style="w" strong="G5100">anyone</char> <char style="w" strong="G264">does sin</char>, <char style="w" strong="G2192">we have</char> <char style="w" strong="G3875">an advocate</char> <char style="w" strong="G4314">before</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3962">Father</char> — <char style="w" strong="G2424">Jesus</char> <char style="w" strong="G5547">Christ</char>, <char style="w" strong="G1342">[the] Righteous [One]</char>. <verse style="v" number="2" /><char style="w" strong="G2532">-</char> <char style="w" strong="G846">He Himself</char> <char style="w" strong="G1510">is</char> <char style="w" strong="G2434">[the] atoning sacrifice</char><note style="f" caller="+"><char style="fr">2:2 </char><char style="ft">Or </char><char style="fqa">the propitiation</char></note> <char style="w" strong="G4012">for</char> <char style="w" strong="G1473">our</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G266">sins</char>, <char style="w" strong="G1161">and</char> <char style="w" strong="G3756">not</char> <char style="w" strong="G3440">only</char> <char style="w" strong="G4012">for</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2251">ours</char> <char style="w" strong="G235">but</char> <char style="w" strong="G2532">also</char> <char style="w" strong="G4012">for</char> <char style="w" strong="G3588">the [sins]</char> <char style="w" strong="G3650">of [the] whole</char> <char sty