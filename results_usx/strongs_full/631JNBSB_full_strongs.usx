  <para style="p"> <verse style="v" number="3" /><char style="w" strong="G2532">-</char> <char style="w" strong="G1722">By</char> <char style="w" strong="G3778">this</char> <char style="w" strong="G1097">we can be sure</char> <char style="w" strong="G3754">that</char> <char style="w" strong="G1097">we have come to know</char> <char style="w" strong="G846">Him</char>: <char style="w" strong="G1437">if</char> <char style="w" strong="G5083">we keep</char> <char style="w" strong="G846">His</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G1785">commandments</char>. <verse style="v" number="4" /><char style="w" strong="G3588">If anyone</char> <char style="w" strong="G3004">says</char>, <char style="w" strong="G3754">-</char> “<char style="w" strong="G1097">I know</char> <char style="w" strong="G846">Him</char>,” <char style="w" strong="G2532">[but]</char> <char style="w" strong="G3361">vvv</char> <char style="w" strong="G5083">does not keep</char> <char style="w" strong="G846">His</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G1785">commandments</char>, <char style="w" strong="G1510">he is</char> <char style="w" strong="G5583">a liar</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G225">truth</char> <char style="w" strong="G1510">is</char> <char style="w" strong="G3756">not</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G3778">him</char>. <verse style="v" number="5" /><char style="w" strong="G1161">But</char> <char style="w" strong="G3739">if anyone</char> <char style="w" strong="G302">. . .</char> <char style="w" strong="G5083">keeps</char> <char style="w" strong="G846">His</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3056">word</char>, <char style="w" strong="G3588">the</char> <char style="w" strong="G26">love</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2316">of God</char> <cha