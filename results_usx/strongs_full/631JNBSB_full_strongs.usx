  <para style="p"> <verse style="v" number="3" /><char style="w" strong="G518">We proclaim</char> <char style="w" strong="G4771">to you</char> <char style="w" strong="G2532">-</char> <char style="w" strong="G3739">what</char> <char style="w" strong="G3708">we have seen</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G191">heard</char>, <char style="w" strong="G2443">so that</char> <char style="w" strong="G4771">you</char> <char style="w" strong="G2532">also</char> <char style="w" strong="G2192">may have</char> <char style="w" strong="G2842">fellowship</char> <char style="w" strong="G3326">with</char> <char style="w" strong="G1473">us</char>. <char style="w" strong="G2532">And</char> <char style="w" strong="G1161">-</char> <char style="w" strong="G3588">[this]</char> <char style="w" strong="G2842">fellowship</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2251">of ours</char> <char style="w" strong="G3326">[is] with</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3962">Father</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3326">with</char> <char style="w" strong="G846">His</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G5207">Son</char>, <char style="w" strong="G2424">Jesus</char> <char style="w" strong="G5547">Christ</char>. <verse style="v" number="4" /><char style="w" strong="G2532">-</char> <char style="w" strong="G1473">We</char> <char style="w" strong="G1125">write</char> <char style="w" strong="G3778">these things</char> <char style="w" strong="G2443">so that</char> <char style="w" strong="G1473">our</char><note style="f" caller="+"><char style="fr">1:4 </char><char style="ft">BYZ and TR </char><char style="fqa">your</char></note> <char style="w" strong="G3588">-</char> <char style="w" strong="G5479">joy</char> <char style="w" strong="G1510">may be</char> <char style="w" strong="G4137">complete</char>.</para>
