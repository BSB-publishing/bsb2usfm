  <para style="p"> <verse style="v" number="28" /><char style="w" strong="G2532">And</char> <char style="w" strong="G3568">now</char>, <char style="w" strong="G5040">little children</char>, <char style="w" strong="G3306">remain</char> <char style="w" strong="G1722">in</char> <char style="w" strong="G846">[Christ]</char>,<note style="f" caller="+"><char style="fr">2:28 </char><char style="ft">Literally </char><char style="fqa">remain in Him</char></note> <char style="w" strong="G2443">so that</char> <char style="w" strong="G1437">when</char> <char style="w" strong="G5319">He appears</char>, <char style="w" strong="G2192">we may be</char> <char style="w" strong="G3954">confident</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3361">vvv</char> <char style="w" strong="G153">unashamed</char> <char style="w" strong="G575">before</char> <char style="w" strong="G846">Him</char> <char style="w" strong="G1722">at</char> <char style="w" strong="G846">His</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G3952">coming</char>.</para>
  <para style="p"> <verse style="v" number="29" /><char style="w" strong="G1437">If</char> <char style="w" strong="G1492">you know</char> <char style="w" strong="G3754">that</char> <char style="w" strong="G1510">He is</char> <char style="w" strong="G1342">righteous</char>, <char style="w" strong="G1097">you also know</char> <char style="w" strong="G2532">. . .</char> <char style="w" strong="G3754">that</char> <char style="w" strong="G3956">everyone</char> <char style="w" strong="G3588">who</char> <char style="w" strong="G4160">practices</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G1343">righteousness</char> <char style="w" strong="G1080">has been born</char> <char style="w" strong="G1537">of</char> <char style="w" strong="G846">Him</char>.</para>
  <chapter number="3" style="c" />
  <para style="s1">Children of God</para>
