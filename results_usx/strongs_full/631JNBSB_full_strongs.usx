  <para style="p"> <verse style="v" number="1" /><char style="w" strong="G3739">That which</char> <char style="w" strong="G1510">was</char> <char style="w" strong="G575">from</char> <char style="w" strong="G746">[the] beginning</char>, <char style="w" strong="G3739">which</char> <char style="w" strong="G191">we have heard</char>, <char style="w" strong="G3739">which</char> <char style="w" strong="G3708">we have seen</char> <char style="w" strong="G3588">with</char> <char style="w" strong="G1473">our own</char> <char style="w" strong="G3788">eyes</char>, <char style="w" strong="G3739">which</char> <char style="w" strong="G2300">we have gazed upon</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G5584">touched [with]</char> <char style="w" strong="G1473">our</char> <char style="w" strong="G3588">[own]</char> <char style="w" strong="G5495">hands</char> — <char style="w" strong="G4012">[this is ]</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G3056">Word</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2222">of life</char>. <verse style="v" number="2" /><char style="w" strong="G2532">And</char> <char style="w" strong="G3588">[this is] the</char> <char style="w" strong="G2222">life</char> <char style="w" strong="G5319">that was revealed</char>; <char style="w" strong="G2532">-</char> <char style="w" strong="G3708">we have seen [it]</char> <char style="w" strong="G2532">and</char> <char style="w" strong="G3140">testified [to it]</char>, <char style="w" strong="G2532">and</char> <char style="w" strong="G518">we proclaim</char> <char style="w" strong="G4771">to you</char> <char style="w" strong="G3588">the</char> <char style="w" strong="G166">eternal</char> <char style="w" strong="G3588">-</char> <char style="w" strong="G2222">life</char> <char style="w" strong="G3748">that</char> <char style="w" strong="G1510">was</char> <char style="w" strong="G4314">with</char> <char style="w" strong="G3588">the</ch