    },
    {
      "type": "para",
      "marker": "q1",
      "content": [
        {
          "type": "char",
          "marker": "rb",
          "gloss": "אַל־",
          "content": [
            "“Do not"
          ]
        },
        {
          "type": "char",
          "marker": "rb",
          "gloss": "תִּירָא֙",
          "content": [
            "be afraid,"
