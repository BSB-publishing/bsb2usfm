                    "</span>Woe to you, scribes and Pharisees, you hypocrites! You defraud widows of their houses, and for a show make lengthy prayers. Therefore you will receive greater condemnation."
                  ]
                },
                {
                  "type": "char",
                  "marker": "ft",
                  "content": [
                    "See ",
                    {
                      "type": "ref",
                      "loc": "MRK 12:40",
                      "content": [
                        "Mark 12:40"
                      ]
                    },
                    " and Luke 20:47."
                  ]
                }
              ]
            }
          ]
        }
      ]
