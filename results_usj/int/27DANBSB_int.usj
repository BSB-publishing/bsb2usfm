          "type": "char",
          "marker": "rb",
          "gloss": "לֵ֣ךְ",
          "content": [
            "go on your way"
          ]
        },
        {
          "type": "char",
          "marker": "rb",
          "gloss": "לַקֵּ֑ץ",
          "content": [
            "until the end."
          ]
        },
        {
          "type": "char",
          "marker": "rb",
          "gloss": "וְתָנ֛וּחַ",
          "content": [
            "You will rest,"
          ]
        },
        {
          "type": "char",
          "marker": "rb",
          "gloss": "וְתַעֲמֹ֥ד",
          "content": [
            "and then you will arise"
          ]
        },
        {
          "type": "char",
          "marker": "rb",
          "gloss": "לְגֹרָלְךָ֖",
          "content": [
            "to your inheritance"
          ]
        },
        {
          "type": "char",
          "marker": "rb",
          "gloss": "לְקֵ֥ץ",
          "content": [
            "at the end"
          ]
        },
        {
          "type": "char",
          "marker": "rb",
          "gloss": "הַיָּמִֽין׃",
          "content": [
            "of the days.”"
          ]
        }
      ]
    }
  ]
}