\c 21
\s1 Holiness Required of Priests
\p \v 1 \w Then the LORD|strong="H3068"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, “\w Speak|strong="H559"\w* \w to|strong="H413"\w* \w Aaron’s|strong="H175"\w* \w sons|strong="H1121"\w*, \w the priests|strong="H3548"\w*, \w and tell|strong="H559"\w* \w them that|strong="H413"\w* \w a priest is not|strong="H3808"\w* \w to defile himself|strong="H2930"\w* \w for a dead person|strong="H5315"\w* \w among his people|strong="H5971"\w*, \v 2 \w except|strong="H3588"\w* \w for his immediate|strong="H7138"\w* \w family|strong="H7607"\w* — \w his mother|strong="H517"\w*, \w father|strong="H1"\w*, \w son|strong="H1121"\w*, \w daughter|strong="H1323"\w*, \w or brother|strong="H251"\w*, \v 3 \w or his unmarried|strong="H1330"\w* \w sister|strong="H269"\w* \w who is near|strong="H7138"\w* \w to him|strong="H413"\w*, \w since|strong="H834"\w* \w she has|strong="H1961"\w* \w no|strong="H3808"\w* \w husband|strong="H376"\w*. \v 4 \w He is not|strong="H3808"\w* \w to defile himself|strong="H2930"\w* \w for those related to him by marriage|strong="H1167"\w*, \w and so profane himself|strong="H2490"\w*.
\p \v 5 \w Priests must not|strong="H3808"\w* \w make bald|strong="H7139"\w* \w spots on their heads|strong="H7218"\w*, \w shave off the edges|strong="H6285"\w* \w of their beards|strong="H2206"\w*, \w or make|strong="H8295"\w* \w cuts|strong="H8296"\w* \w in their bodies|strong="H1320"\w*. \v 6 \w They must be|strong="H1961"\w* \w holy|strong="H6918"\w* \w to their God|strong="H430"\w* \w and not|strong="H3808"\w* \w profane|strong="H2490"\w* \w the name|strong="H8034"\w* \w of their God|strong="H430"\w*. \w Because|strong="H3588"\w* \w they|strong="H1992"\w* \w present|strong="H7126"\w* \w to the LORD|strong="H3068"\w* \w the food offerings|strong="H801"\w*, \w the food|strong="H3899"\w* \w of their God|strong="H430"\w*, \w they must be|strong="H1961"\w* \w holy|strong="H6944"\w*.
\p \v 7 \w A priest must not|strong="H3808"\w* \w marry|strong="H3947"\w* \w a woman|strong="H802"\w* \w defiled|strong="H2491"\w* \w by prostitution|strong="H2181"\w* \w or|strong="H3808"\w* \w divorced|strong="H1644"\w* \w by her husband|strong="H376"\w*, \w for|strong="H3588"\w* \w the priest|strong="H1931"\w* \w is holy|strong="H6918"\w* \w to his God|strong="H430"\w*. \v 8 \w You are to regard him as holy|strong="H6942"\w*, \w since|strong="H3588"\w* \w he|strong="H1931"\w* \w presents|strong="H7126"\w* \w the food|strong="H3899"\w* \w of your God|strong="H430"\w*. \w He shall be|strong="H1961"\w* \w holy|strong="H6918"\w* to you, \w because|strong="H3588"\w* \w I|strong="H589"\w* \w the LORD|strong="H3068"\w* \w am holy|strong="H6918"\w* — \w I who set you apart|strong="H6942"\w*. \v 9 \w If|strong="H3588"\w* \w a priest’s|strong="H3548"\w* \w daughter|strong="H1323"\w* \w defiles herself|strong="H2490"\w* \w by prostituting herself|strong="H2181"\w*, \w she|strong="H1931"\w* \w profanes|strong="H2490"\w* \w her father|strong="H1"\w*; \w she must be burned|strong="H8313"\w* \w in the fire|strong="H784"\w*.
\p \v 10 \w The priest|strong="H3548"\w* \w who is highest|strong="H1419"\w* \w among his brothers|strong="H251"\w*, \w who|strong="H834"\w* \w has had the anointing|strong="H4888"\w* \w oil|strong="H8081"\w* \w poured|strong="H3332"\w* \w on|strong="H5921"\w* \w his head|strong="H7218"\w* \w and has been ordained|strong="H4390"\w* \w to wear|strong="H3847"\w* \w the priestly garments|strong="H899"\w*, \w must not let|strong="H3808"\w* \w his hair|strong="H7218"\w* \w hang loose|strong="H6544"\w*\f + \fr 21:10 \ft Or \fqa must not uncover his head\f* \w or tear|strong="H6533"\w* \w his garments|strong="H899"\w*. \v 11 \w He must not|strong="H3808"\w* \w go|strong="H935"\w* \w near any|strong="H3605"\w* \w dead|strong="H4191"\w* \w body|strong="H5315"\w*; \w he must not|strong="H3808"\w* \w defile himself|strong="H2930"\w*, \w even for his father|strong="H1"\w* \w or mother|strong="H517"\w*. \v 12 \w He must not|strong="H3808"\w* \w leave|strong="H3318"\w* \w or desecrate|strong="H2490"\w* \w the sanctuary|strong="H4720"\w* \w of his God|strong="H430"\w*, \w for|strong="H3588"\w* \w the consecration|strong="H5145"\w* \w of the anointing|strong="H4888"\w* \w oil|strong="H8081"\w* \w of his God|strong="H430"\w* \w is on him|strong="H5921"\w*. \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w*.
\p \v 13 \w The woman|strong="H802"\w* \w he|strong="H1931"\w* \w marries|strong="H3947"\w* \w must be a virgin|strong="H1331"\w*. \v 14 \w He is not|strong="H3808"\w* \w to marry|strong="H3947"\w* \w a widow|strong="H490"\w*, \w a divorced woman|strong="H1644"\w*, \w or one defiled|strong="H2491"\w* \w by prostitution|strong="H2181"\w*. \w He is to marry|strong="H3947"\w* \w a virgin|strong="H1330"\w* \w from his own people|strong="H5971"\w*, \v 15 \w so that he does not|strong="H3808"\w* \w defile|strong="H2490"\w* \w his offspring|strong="H2233"\w* \w among his people|strong="H5971"\w*, \w for|strong="H3588"\w* \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w* \w who sanctifies him|strong="H6942"\w*.”
\s1 Restrictions against Those with Blemishes
\p \v 16 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 17 “\w Say|strong="H1696"\w* \w to|strong="H413"\w* \w Aaron|strong="H175"\w*, ‘\w For the generations to come|strong="H1755"\w*, \w none|strong="H3808"\w* \w of your descendants|strong="H2233"\w* \w who|strong="H834"\w* \w has|strong="H1961"\w* \w a physical defect|strong="H3971"\w* \w may approach|strong="H7126"\w* \w to offer|strong="H7126"\w* \w the food|strong="H3899"\w* \w of his God|strong="H430"\w*.
\p \v 18 \w No|strong="H3605"\w* \w man|strong="H376"\w* \w who|strong="H834"\w* \w has any defect|strong="H3971"\w* \w may approach|strong="H7126"\w* — \w no man|strong="H376"\w* \w who is blind|strong="H5787"\w*, \w lame|strong="H6455"\w*, \w disfigured|strong="H2763"\w*, \w or|strong="H176"\w* \w deformed|strong="H8311"\w*; \v 19 \w no man|strong="H376"\w* \w who|strong="H834"\w* \w has|strong="H1961"\w* \w a broken|strong="H7667"\w* \w foot|strong="H7272"\w* \w or|strong="H176"\w* \w hand|strong="H3027"\w*, \v 20 \w or|strong="H176"\w* \w who is a hunchback|strong="H1384"\w* \w or|strong="H176"\w* \w dwarf|strong="H1851"\w*, \w or|strong="H176"\w* \w who has an eye|strong="H5869"\w* \w defect|strong="H8400"\w*, \w a festering rash|strong="H1618"\w*, \w scabs|strong="H3217"\w*, \w or|strong="H176"\w* \w a crushed|strong="H4790"\w* \w testicle|strong="H810"\w*.
\p \v 21 \w No|strong="H3605"\w* \w descendant|strong="H2233"\w* \w of Aaron|strong="H175"\w* \w the priest|strong="H3548"\w* \w who|strong="H834"\w* \w has a defect|strong="H3971"\w* \w shall approach|strong="H5066"\w* \w to present|strong="H7126"\w* \w the food offerings|strong="H801"\w* \w to the LORD|strong="H3068"\w*. \w Since he has a defect|strong="H3971"\w*, \w he is not|strong="H3808"\w* \w to come near|strong="H5066"\w* \w to offer|strong="H7126"\w* \w the food|strong="H3899"\w* \w of his God|strong="H430"\w*. \v 22 \w He may eat|strong="H398"\w* \w the most|strong="H6944"\w* \w holy|strong="H6944"\w* \w food|strong="H3899"\w* \w of his God|strong="H430"\w* \w as well as|strong="H4480"\w* \w the holy food|strong="H6944"\w*, \v 23 \w but|strong="H389"\w* \w because|strong="H3588"\w* \w he has a defect|strong="H3971"\w*, \w he must not|strong="H3808"\w* \w go|strong="H935"\w* \w near|strong="H413"\w* \w the veil|strong="H6532"\w* \w or approach|strong="H5066"\w* \w the altar|strong="H4196"\w*, \w so as not to desecrate|strong="H2490"\w* \w My sanctuaries|strong="H4720"\w*. \w For|strong="H3588"\w* \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w* \w who sanctifies them|strong="H6942"\w*.’”
\p \v 24 \w Moses|strong="H4872"\w* \w told|strong="H1696"\w* \w this to|strong="H413"\w* \w Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w* \w and to|strong="H413"\w* \w all|strong="H3605"\w* \w the Israelites|strong="H1121"\w*.
\c 22
\s1 Restrictions against the Unclean
\p \v 1 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 2 “\w Tell|strong="H1696"\w* \w Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w* \w to treat with respect|strong="H5144"\w* \w the sacred offerings|strong="H6944"\w* \w that the Israelites|strong="H1121"\w* \w have consecrated to Me|strong="H6942"\w*, \w so that they do not|strong="H3808"\w* \w profane|strong="H2490"\w* \w My holy|strong="H6944"\w* \w name|strong="H8034"\w*. \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w*.
\p \v 3 \w Tell|strong="H559"\w* \w them that|strong="H413"\w* \w for the generations to come|strong="H1755"\w*, \w if any|strong="H3605"\w* \w of their descendants|strong="H2233"\w* \w in a state of uncleanness|strong="H2932"\w* \w approaches|strong="H7126"\w* \w the sacred offerings|strong="H6944"\w* \w that|strong="H834"\w* \w the Israelites|strong="H1121"\w* \w consecrate|strong="H6942"\w* \w to the LORD|strong="H3068"\w*, \w that|strong="H1931"\w* \w person|strong="H5315"\w* \w must be cut off|strong="H3772"\w* \w from My presence|strong="H6440"\w*. \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w*.
\p \v 4 \w If a descendant|strong="H2233"\w* \w of Aaron|strong="H175"\w* \w has a skin disease|strong="H6879"\w*\f + \fr 22:4 \ft Forms of the Hebrew \fqa tzaraath\ft , traditionally translated as \fqa leprosy\ft , were used for various skin diseases; see Leviticus 13.\f* \w or|strong="H176"\w* \w a discharge|strong="H2100"\w*, \w he may not eat|strong="H398"\w* \w the sacred offerings|strong="H6944"\w* \w until|strong="H5704"\w* \w he is clean|strong="H2891"\w*. \w Whoever touches|strong="H5060"\w* \w anything|strong="H3605"\w* \w defiled|strong="H2931"\w* \w by a corpse|strong="H5315"\w* \w or|strong="H176"\w* \w by a man|strong="H376"\w* \w who|strong="H834"\w* \w has|strong="H3318"\w* \w an emission|strong="H7902"\w* \w of semen|strong="H2233"\w*, \v 5 \w or|strong="H176"\w* \w whoever|strong="H376"\w* \w touches|strong="H5060"\w* \w a|strong="H3605"\w* \w crawling creature|strong="H8318"\w* \w or|strong="H176"\w* \w a person|strong="H120"\w* \w that|strong="H834"\w* \w makes him unclean|strong="H2930"\w*, \w whatever|strong="H3605"\w* \w the uncleanness may be|strong="H2932"\w* — \v 6 \w the man|strong="H5315"\w* \w who|strong="H834"\w* \w touches|strong="H5060"\w* any of these \w will remain unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*. \w He must not|strong="H3808"\w* \w eat|strong="H398"\w* \w from|strong="H4480"\w* \w the sacred offerings|strong="H6944"\w* \w unless|strong="H3588"\w* \w he has bathed|strong="H7364"\w* \w himself|strong="H1320"\w* \w with water|strong="H4325"\w*.
\p \v 7 \w When the sun|strong="H8121"\w* \w has set|strong="H935"\w*, \w he will become clean|strong="H2891"\w*, \w and then|strong="H310"\w* \w he may eat|strong="H398"\w* \w from|strong="H4480"\w* \w the sacred offerings|strong="H6944"\w*, \w for|strong="H3588"\w* \w they|strong="H1931"\w* \w are his food|strong="H3899"\w*. \v 8 \w He must not|strong="H3808"\w* \w eat|strong="H398"\w* \w anything found dead|strong="H5038"\w* \w or torn by wild animals|strong="H2966"\w*, \w which would make him unclean|strong="H2930"\w*. \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w*. \v 9 \w The priests must keep|strong="H8104"\w* \w My charge|strong="H4931"\w*, \w lest|strong="H3808"\w* \w they bear|strong="H5375"\w* \w the guilt|strong="H2399"\w* \w and die|strong="H4191"\w* \w because|strong="H3588"\w* \w they profane it|strong="H2490"\w*. \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w* \w who sanctifies them|strong="H6942"\w*.
\p \v 10 \w No|strong="H3808"\w* \w one|strong="H3605"\w* \w outside a priest’s family|strong="H2114"\w* \w may eat|strong="H398"\w* \w the sacred offering|strong="H6944"\w*, \w nor|strong="H3808"\w* \w may the guest|strong="H8453"\w* \w of a priest|strong="H3548"\w* \w or his hired hand|strong="H7916"\w* \w eat|strong="H398"\w* \w it|strong="H6944"\w*. \v 11 \w But if|strong="H3588"\w* \w a priest|strong="H3548"\w* \w buys|strong="H7069"\w* \w a slave|strong="H5315"\w* \w with|strong="H7075"\w* \w his own money|strong="H3701"\w*, \w or if a slave|strong="H1992"\w* \w is born|strong="H3211"\w* \w in his household|strong="H1004"\w*, \w that slave|strong="H1931"\w* \w may eat|strong="H398"\w* \w his food|strong="H3899"\w*.
\p \v 12 \w If|strong="H3588"\w* \w the priest’s|strong="H3548"\w* \w daughter|strong="H1323"\w* \w is married|strong="H1961"\w* \w to a man|strong="H376"\w* \w other than a priest|strong="H2114"\w*, \w she|strong="H1931"\w* \w is not|strong="H3808"\w* \w to eat|strong="H398"\w* \w of the sacred|strong="H6944"\w* \w contributions|strong="H8641"\w*. \v 13 \w But if|strong="H3588"\w* \w a priest’s|strong="H3548"\w* \w daughter|strong="H1323"\w* \w with no|strong="H369"\w* \w children|strong="H2233"\w* \w becomes|strong="H1961"\w* \w widowed|strong="H490"\w* \w or divorced|strong="H1644"\w* \w and returns|strong="H7725"\w* \w to|strong="H413"\w* \w her father’s|strong="H1"\w* \w house|strong="H1004"\w*, \w she may share|strong="H398"\w* \w her father’s|strong="H1"\w* \w food|strong="H3899"\w* \w as in her youth|strong="H5271"\w*. \w But no|strong="H3605"\w* \w outsider|strong="H2114"\w* \w may share|strong="H398"\w* it.
\p \v 14 \w If|strong="H3588"\w* \w anyone|strong="H376"\w* \w eats|strong="H398"\w* \w a sacred offering|strong="H6944"\w* \w in error|strong="H7684"\w*, \w he must add|strong="H3254"\w* \w a fifth|strong="H2549"\w* \w to|strong="H5921"\w* \w its value and give|strong="H5414"\w* \w the sacred offering|strong="H6944"\w* \w to the priest|strong="H3548"\w*. \v 15 \w The priests must not|strong="H3808"\w* \w profane|strong="H2490"\w* \w the sacred offerings|strong="H6944"\w* \w that the Israelites|strong="H1121"\w* \w present|strong="H7311"\w* \w to the LORD|strong="H3068"\w* \v 16 \w by allowing the people to eat|strong="H398"\w* \w the sacred offerings|strong="H6944"\w* \w and thus to bear|strong="H5375"\w* \w the punishment|strong="H5771"\w* \w for guilt|strong="H819"\w*. \w For|strong="H3588"\w* \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w* \w who sanctifies them|strong="H6942"\w*.”
\s1 Worthy Offerings
\p \v 17 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 18 “\w Speak|strong="H1696"\w* \w to|strong="H413"\w* \w Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w* \w and all|strong="H3605"\w* \w the Israelites|strong="H1121"\w* \w and tell|strong="H559"\w* \w them|strong="H413"\w*, ‘\w Any man|strong="H376"\w* \w of|strong="H4480"\w* \w the house|strong="H1004"\w* \w of Israel|strong="H3478"\w* \w or any foreign resident|strong="H1616"\w* \w who|strong="H834"\w* \w presents|strong="H7126"\w* \w a gift|strong="H7133"\w* \w for a burnt offering|strong="H5930"\w* \w to the LORD|strong="H3068"\w*, \w whether to fulfill a vow|strong="H5088"\w* \w or as a|strong="H3605"\w* \w freewill offering|strong="H5071"\w*, \v 19 \w must offer an unblemished|strong="H8549"\w* \w male|strong="H2145"\w* \w from the cattle|strong="H1241"\w*, \w sheep|strong="H3775"\w*, \w or goats|strong="H5795"\w* \w in order for it to be accepted on your behalf|strong="H7522"\w*. \v 20 \w You must not|strong="H3808"\w* \w present|strong="H7126"\w* \w anything|strong="H3605"\w* \w with|strong="H834"\w* \w a defect|strong="H3971"\w*, \w because|strong="H3588"\w* \w it will not|strong="H3808"\w* \w be|strong="H1961"\w* \w accepted|strong="H7522"\w* on your behalf.
\p \v 21 \w When|strong="H3588"\w* \w a man|strong="H376"\w* \w presents|strong="H7126"\w* \w a peace offering|strong="H8002"\w* \w to the LORD|strong="H3068"\w* \w from the herd|strong="H1241"\w* \w or|strong="H176"\w* \w flock|strong="H6629"\w* \w to fulfill|strong="H6381"\w* \w a vow|strong="H5088"\w* \w or|strong="H176"\w* \w as a freewill offering|strong="H5071"\w*, \w it must be|strong="H1961"\w* \w without blemish|strong="H8549"\w* \w or defect|strong="H3971"\w* \w to be acceptable|strong="H7522"\w*. \v 22 \w You are not|strong="H3808"\w* \w to present|strong="H7126"\w* \w to the LORD|strong="H3068"\w* \w any animal|strong="H428"\w* \w that is blind|strong="H5788"\w*, \w injured|strong="H7667"\w*, \w or|strong="H176"\w* \w maimed|strong="H2742"\w*, \w or|strong="H176"\w* \w anything with a running sore|strong="H2990"\w*, \w a festering rash|strong="H1618"\w*, \w or a scab|strong="H3217"\w*; \w you must not|strong="H3808"\w* \w put|strong="H5414"\w* any of these \w on|strong="H5921"\w* \w the altar|strong="H4196"\w* \w as a food offering|strong="H801"\w* \w to the LORD|strong="H3068"\w*.
\p \v 23 \w You may present|strong="H6213"\w* \w as a freewill offering|strong="H5071"\w* \w an ox|strong="H7794"\w*\f + \fr 22:23 \ft Or \fqa a bull \ft or \fqa a cow\f* \w or sheep|strong="H7716"\w* \w that has a deformed|strong="H8311"\w* \w or stunted limb|strong="H7038"\w*, \w but it is not|strong="H3808"\w* \w acceptable|strong="H7521"\w* \w in fulfillment of a vow|strong="H5088"\w*. \v 24 \w You are not|strong="H3808"\w* \w to present|strong="H7126"\w* \w to the LORD|strong="H3068"\w* \w an animal whose testicles are bruised|strong="H4600"\w*, \w crushed|strong="H3807"\w*, \w torn|strong="H5423"\w*, \w or cut|strong="H3772"\w*; \w you are not to|strong="H3808"\w* \w sacrifice them|strong="H6213"\w* \w in your land|strong="H776"\w*. \v 25 \w Neither you nor|strong="H3808"\w* \w a foreigner|strong="H1121"\w* \w shall present|strong="H7126"\w* \w food|strong="H3899"\w* \w to your God|strong="H430"\w* \w from any|strong="H3605"\w* \w such animal|strong="H428"\w*. \w They will not|strong="H3808"\w* \w be accepted|strong="H7521"\w* on your behalf, \w because|strong="H3588"\w* \w they are deformed|strong="H4893"\w* \w and flawed|strong="H3971"\w*.’”
\p \v 26 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 27 “\w When|strong="H3588"\w* \w an ox|strong="H7794"\w*,\f + \fr 22:27 \ft Or \fqa a calf\f* \w a sheep|strong="H3775"\w*, \w or|strong="H176"\w* \w a goat|strong="H5795"\w* \w is born|strong="H3205"\w*, \w it must remain|strong="H1961"\w* \w with|strong="H8478"\w* \w its mother|strong="H517"\w* \w for seven|strong="H7651"\w* \w days|strong="H3117"\w*. \w From the eighth|strong="H8066"\w* \w day|strong="H3117"\w* \w on|strong="H1973"\w*, \w it will be acceptable as|strong="H7521"\w* \w a food offering|strong="H801"\w* \w presented|strong="H7133"\w* \w to the LORD|strong="H3068"\w*. \v 28 \w But you must not|strong="H3808"\w* \w slaughter|strong="H7819"\w* \w an ox|strong="H7794"\w*\f + \fr 22:28 \ft Or \fqa a cow\f* \w or|strong="H176"\w* \w a sheep|strong="H7716"\w* \w on the same|strong="H259"\w* \w day|strong="H3117"\w* \w as its young|strong="H1121"\w*.
\p \v 29 \w When|strong="H3588"\w* \w you sacrifice|strong="H2076"\w* \w a thank|strong="H8426"\w* \w offering|strong="H2077"\w* \w to the LORD|strong="H3068"\w*, \w offer it|strong="H2076"\w* \w so that it may be acceptable on your behalf|strong="H7522"\w*. \v 30 \w It must be eaten|strong="H398"\w* \w that same|strong="H1931"\w* \w day|strong="H3117"\w*. \w Do not|strong="H3808"\w* \w leave|strong="H3498"\w* \w any of it|strong="H4480"\w* \w until|strong="H5704"\w* \w morning|strong="H1242"\w*. \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w*.
\p \v 31 \w You are to keep|strong="H8104"\w* \w My commandments|strong="H4687"\w* \w and practice|strong="H6213"\w* \w them|strong="H853"\w*. \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w*. \v 32 \w You must not|strong="H3808"\w* \w profane|strong="H2490"\w* \w My holy|strong="H6944"\w* \w name|strong="H8034"\w*. \w I must be acknowledged as holy|strong="H6942"\w* \w among|strong="H8432"\w* \w the Israelites|strong="H1121"\w*. \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w* \w who sanctifies you|strong="H6942"\w*, \v 33 \w who brought you out|strong="H3318"\w* \w of the land|strong="H776"\w* \w of Egypt|strong="H4714"\w* \w to be|strong="H1961"\w* your \w God|strong="H430"\w*. \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w*.”
\c 23
\s1 Feasts and Sabbaths
\r (\ref Exodus 23:14–19|EXO 23:14-19\ref*)
\p \v 1 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 2 “\w Speak|strong="H1696"\w* \w to|strong="H413"\w* \w the Israelites|strong="H1121"\w* \w and say|strong="H559"\w* \w to them|strong="H413"\w*, ‘\w These|strong="H428"\w* \w are|strong="H1992"\w* \w My appointed feasts|strong="H4150"\w*, \w the feasts|strong="H4150"\w* \w of the LORD|strong="H3068"\w* \w that|strong="H834"\w* \w you are to proclaim|strong="H7121"\w* \w as sacred|strong="H6944"\w* \w assemblies|strong="H4744"\w*.
\p \v 3 \w For six|strong="H8337"\w* \w days|strong="H3117"\w* \w work|strong="H4399"\w* \w may be done|strong="H6213"\w*, \w but the seventh|strong="H7637"\w* \w day|strong="H3117"\w* \w is a Sabbath|strong="H7676"\w* \w of complete rest|strong="H7677"\w*, \w a day of sacred|strong="H6944"\w* \w assembly|strong="H4744"\w*. \w You must not|strong="H3808"\w* \w do|strong="H6213"\w* \w any|strong="H3605"\w* \w work|strong="H4399"\w*; \w wherever|strong="H3605"\w* \w you live|strong="H4186"\w*, \w it|strong="H1931"\w* \w is a Sabbath|strong="H7676"\w* \w to the LORD|strong="H3068"\w*.
\s1 Passover and the Feast of Unleavened Bread
\r (\ref Exodus 12:14–28|EXO 12:14-28\ref*; \ref Numbers 28:16–25|NUM 28:16-25\ref*; \ref Deuteronomy 16:1–8|DEU 16:1-8\ref*)
\p \v 4 \w These|strong="H428"\w* \w are the LORD’s|strong="H3068"\w* \w appointed feasts|strong="H4150"\w*, \w the sacred|strong="H6944"\w* \w assemblies|strong="H4744"\w* \w you are to proclaim|strong="H7121"\w* \w at their appointed times|strong="H4150"\w*. \v 5 \w The Passover|strong="H6453"\w* \w to the LORD|strong="H3068"\w* \w begins at|strong="H996"\w* \w twilight|strong="H6153"\w* \w on the fourteenth|strong="H702"\w*\f + \fr 23:5 \ft Hebrew \fqa begins between the two evenings of the fourteenth\f* \w day|strong="H2320"\w* \w of the first|strong="H7223"\w* \w month|strong="H2320"\w*. \v 6 \w On the fifteenth|strong="H2568"\w* \w day|strong="H3117"\w* \w of the same|strong="H2088"\w* \w month begins|strong="H2320"\w* \w the Feast|strong="H2282"\w* \w of Unleavened Bread|strong="H4682"\w*\f + \fr 23:6 \ft That is, the seven-day period after the Passover during which no leaven may be eaten; see \ref Exodus 12:14–20|EXO 12:14-20\ref*.\f* \w to the LORD|strong="H3068"\w*. \w For seven|strong="H7651"\w* \w days|strong="H3117"\w* \w you must eat|strong="H398"\w* \w unleavened bread|strong="H4682"\w*. \v 7 \w On the first|strong="H7223"\w* \w day|strong="H3117"\w* \w you are to hold|strong="H1961"\w* \w a sacred|strong="H6944"\w* \w assembly|strong="H4744"\w*; \w you are not|strong="H3808"\w* \w to do|strong="H6213"\w* \w any|strong="H3605"\w* \w regular|strong="H5656"\w* \w work|strong="H4399"\w*. \v 8 \w For seven|strong="H7651"\w* \w days|strong="H3117"\w* \w you are to present|strong="H7126"\w* \w a food offering|strong="H801"\w* \w to the LORD|strong="H3068"\w*. \w On the seventh|strong="H7637"\w* \w day|strong="H3117"\w* \w there shall be a sacred|strong="H6944"\w* \w assembly|strong="H4744"\w*; \w you must not|strong="H3808"\w* \w do|strong="H6213"\w* \w any|strong="H3605"\w* \w regular|strong="H5656"\w* \w work|strong="H4399"\w*.’”
\s1 The Feast of Firstfruits
\p \v 9 \w And the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 10 “\w Speak|strong="H1696"\w* \w to|strong="H413"\w* \w the Israelites|strong="H1121"\w* \w and say|strong="H559"\w*, ‘\w When|strong="H3588"\w* \w you enter|strong="H935"\w* \w the land|strong="H776"\w* \w that|strong="H834"\w* \w I|strong="H589"\w* \w am giving|strong="H5414"\w* you \w and you reap|strong="H7114"\w* \w its harvest|strong="H7105"\w*, \w you are to bring|strong="H935"\w* \w to|strong="H413"\w* \w the priest|strong="H3548"\w* \w a sheaf|strong="H6016"\w* \w of the firstfruits|strong="H7225"\w* \w of your harvest|strong="H7105"\w*. \v 11 \w And he shall wave|strong="H5130"\w* \w the sheaf|strong="H6016"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w so that it may be accepted on your behalf|strong="H7522"\w*; \w the priest|strong="H3548"\w* \w is to wave it|strong="H5130"\w* \w on the day after|strong="H4283"\w* \w the Sabbath|strong="H7676"\w*.
\p \v 12 \w On the day|strong="H3117"\w* \w you wave|strong="H5130"\w* \w the sheaf|strong="H6016"\w*, \w you shall offer|strong="H6213"\w* \w a year-old|strong="H1121"\w* \w lamb|strong="H3532"\w* \w without blemish|strong="H8549"\w* \w as a burnt offering|strong="H5930"\w* \w to the LORD|strong="H3068"\w*, \v 13 \w along with its grain offering|strong="H4503"\w* \w of two-tenths of an ephah|strong="H8147"\w* \w of fine flour|strong="H5560"\w*\f + \fr 23:13 \fqa Two-tenths of an ephah \ft is approximately 4 dry quarts or 4.4 liters (probably about 5.1 pounds or 2.3 kilograms of flour); also in verse 17.\f* \w mixed|strong="H1101"\w* \w with oil|strong="H8081"\w* — \w a food offering|strong="H801"\w* \w to the LORD|strong="H3068"\w*, \w a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w* — \w and its drink offering|strong="H5262"\w* \w of a quarter|strong="H7243"\w* \w hin|strong="H1969"\w* \w of wine|strong="H3196"\w*.\f + \fr 23:13 \fqa A quarter hin \ft is approximately 0.97 quarts or 0.92 liters of wine.\f*
\p \v 14 \w You must not|strong="H3808"\w* \w eat|strong="H398"\w* \w any bread|strong="H3899"\w* \w or roasted|strong="H7039"\w* \w or new grain|strong="H3759"\w* \w until|strong="H5704"\w* \w the|strong="H2088"\w* \w very|strong="H6106"\w* \w day|strong="H3117"\w* \w you have brought|strong="H935"\w* \w this|strong="H853"\w* \w offering|strong="H7133"\w* \w to your God|strong="H430"\w*. \w This is to be a permanent|strong="H5769"\w* \w statute|strong="H2708"\w* \w for the generations to come|strong="H1755"\w*, \w wherever|strong="H3605"\w* \w you live|strong="H4186"\w*.
\s1 The Feast of Weeks
\r (\ref Acts 2:1–13|ACT 2:1-13\ref*)
\p \v 15 \w From the day after|strong="H4283"\w* \w the Sabbath|strong="H7676"\w*, \w the day|strong="H3117"\w* \w you brought|strong="H935"\w* \w the sheaf|strong="H6016"\w* \w of the wave offering|strong="H8573"\w*, \w you are to count off|strong="H5608"\w* \w seven|strong="H7651"\w* \w full|strong="H8549"\w* \w weeks|strong="H7676"\w*. \v 16 \w You shall count off|strong="H5608"\w* \w fifty|strong="H2572"\w* \w days|strong="H3117"\w* \w until|strong="H5704"\w* \w the day after|strong="H4283"\w* \w the seventh|strong="H7637"\w* \w Sabbath|strong="H7676"\w*, \w and then present|strong="H7126"\w* \w an offering of new|strong="H2319"\w* \w grain|strong="H4503"\w* \w to the LORD|strong="H3068"\w*.
\p \v 17 \w Bring|strong="H935"\w* \w two|strong="H8147"\w* \w loaves of bread|strong="H3899"\w* \w from your dwellings|strong="H4186"\w* \w as a wave offering|strong="H8573"\w*, \w each made from two-tenths of an ephah|strong="H8147"\w* \w of fine flour|strong="H5560"\w*, \w baked|strong="H644"\w* \w with leaven|strong="H2557"\w*, \w as the firstfruits|strong="H1061"\w* \w to the LORD|strong="H3068"\w*.
\p \v 18 \w Along with|strong="H5921"\w* \w the bread|strong="H3899"\w* \w you are to present|strong="H7126"\w* \w seven|strong="H7651"\w* \w unblemished|strong="H8549"\w* \w male lambs|strong="H3532"\w* \w a year old|strong="H1121"\w*, \w one|strong="H259"\w* \w young bull|strong="H6499"\w*, \w and two|strong="H8147"\w* \w rams|strong="H352"\w*. \w They will be|strong="H1961"\w* \w a burnt offering|strong="H5930"\w* \w to the LORD|strong="H3068"\w*, \w together with their grain offerings|strong="H4503"\w* \w and drink offerings|strong="H5262"\w* — \w a food offering|strong="H801"\w*, \w a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w* \w to the LORD|strong="H3068"\w*.
\p \v 19 \w You shall also prepare|strong="H6213"\w* \w one|strong="H259"\w* \w male goat|strong="H8163"\w* \w as a sin offering|strong="H2403"\w* \w and two|strong="H8147"\w* \w male lambs|strong="H3532"\w* \w a year old|strong="H1121"\w* \w as a peace offering|strong="H8002"\w*. \v 20 \w The priest|strong="H3548"\w* \w is to wave|strong="H5130"\w* \w the lambs|strong="H853"\w* \w as a wave offering|strong="H8573"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*, \w together with|strong="H5921"\w* \w the bread|strong="H3899"\w* \w of the firstfruits|strong="H1061"\w*. \w The bread and the two|strong="H8147"\w* \w lambs|strong="H3532"\w* \w shall be|strong="H1961"\w* \w holy|strong="H6944"\w* \w to the LORD|strong="H3068"\w* \w for the priest|strong="H3548"\w*.
\p \v 21 \w On that|strong="H2088"\w* \w same|strong="H6106"\w* \w day|strong="H3117"\w* \w you are to proclaim|strong="H7121"\w* \w a sacred|strong="H6944"\w* \w assembly|strong="H4744"\w*, and \w you must not|strong="H3808"\w* \w do|strong="H6213"\w* \w any|strong="H3605"\w* \w regular work|strong="H4399"\w*. \w This is to be a permanent|strong="H5769"\w* \w statute|strong="H2708"\w* \w wherever|strong="H3605"\w* \w you live|strong="H4186"\w* \w for the generations to come|strong="H1755"\w*.
\p \v 22 \w When you reap|strong="H7114"\w* \w the harvest|strong="H7105"\w* \w of your land|strong="H776"\w*, \w do not|strong="H3808"\w* \w reap|strong="H7114"\w* \w all the way|strong="H3615"\w* \w to the edges|strong="H6285"\w* \w of your field|strong="H7704"\w* \w or gather|strong="H3950"\w* \w the gleanings|strong="H3951"\w* \w of your harvest|strong="H7105"\w*. \w Leave|strong="H5800"\w* \w them|strong="H853"\w* \w for the poor|strong="H6041"\w* \w and the foreign resident|strong="H1616"\w*. \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w* \w your God|strong="H430"\w*.’”
\s1 The Feast of Trumpets
\r (\ref Numbers 29:1–6|NUM 29:1-6\ref*)
\p \v 23 \w The LORD also|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 24 “\w Speak|strong="H1696"\w* \w to|strong="H413"\w* \w the Israelites|strong="H1121"\w* \w and say|strong="H559"\w*, ‘\w On the first|strong="H259"\w* \w day|strong="H2320"\w* \w of the seventh|strong="H7637"\w* \w month|strong="H2320"\w* \w you are to have|strong="H1961"\w* \w a day of rest|strong="H7677"\w*, \w a sacred|strong="H6944"\w* \w assembly|strong="H4744"\w* \w announced|strong="H2146"\w* \w by trumpet blasts|strong="H8643"\w*.\f + \fr 23:24 \ft Or \fqa a sacred assembly, a memorial of shouting\f* \v 25 \w You must not|strong="H3808"\w* \w do|strong="H6213"\w* \w any|strong="H3605"\w* \w regular work|strong="H4399"\w*, \w but you are to present|strong="H7126"\w* \w a food offering|strong="H801"\w* \w to the LORD|strong="H3068"\w*.’”
\s1 The Day of Atonement
\r (\ref Leviticus 16:1–34|LEV 16:1-34\ref*; \ref Numbers 29:7–11|NUM 29:7-11\ref*)
\p \v 26 \w Again the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 27 “\w The tenth|strong="H6218"\w* \w day of this|strong="H2088"\w* \w seventh|strong="H7637"\w* \w month|strong="H2320"\w* \w is the Day|strong="H3117"\w* \w of Atonement|strong="H3725"\w*. \w You shall hold|strong="H1961"\w* \w a sacred|strong="H6944"\w* \w assembly|strong="H4744"\w* \w and humble|strong="H6031"\w* \w yourselves|strong="H5315"\w*,\f + \fr 23:27 \ft Or \fqa afflict your souls \ft or \fqa deny yourselves\ft ; also in verse 32\f* \w and present|strong="H7126"\w* \w a food offering|strong="H801"\w* \w to the LORD|strong="H3068"\w*.
\p \v 28 \w On this|strong="H2088"\w* \w day|strong="H3117"\w* \w you are not|strong="H3808"\w* \w to do|strong="H6213"\w* \w any|strong="H3605"\w* \w work|strong="H4399"\w*, \w for|strong="H3588"\w* \w it|strong="H1931"\w* \w is the Day|strong="H3117"\w* \w of Atonement|strong="H3725"\w*, \w when atonement is made|strong="H3722"\w* \w for you|strong="H5921"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w your God|strong="H430"\w*. \v 29 \w If|strong="H3588"\w* \w anyone|strong="H3605"\w* \w does not|strong="H3808"\w* \w humble himself|strong="H6031"\w* \w on this|strong="H2088"\w* \w day|strong="H3117"\w*, \w he must be cut off|strong="H3772"\w* \w from his people|strong="H5971"\w*. \v 30 \w I will destroy|strong="H6"\w* \w from among|strong="H7130"\w* \w his people|strong="H5971"\w* \w anyone|strong="H3605"\w* \w who|strong="H834"\w* \w does|strong="H6213"\w* \w any|strong="H3605"\w* \w work|strong="H4399"\w* \w on this|strong="H2088"\w* \w day|strong="H3117"\w*.
\p \v 31 \w You are not|strong="H3808"\w* \w to do|strong="H6213"\w* \w any|strong="H3605"\w* \w work at all|strong="H4399"\w*. \w This is a permanent|strong="H5769"\w* \w statute|strong="H2708"\w* \w for the generations to come|strong="H1755"\w*, \w wherever|strong="H3605"\w* \w you live|strong="H4186"\w*. \v 32 \w It|strong="H1931"\w* \w will be a Sabbath|strong="H7676"\w* \w of complete rest|strong="H7677"\w* for you, \w and you shall humble|strong="H6031"\w* \w yourselves|strong="H5315"\w*. \w From the evening|strong="H6153"\w* \w of the ninth|strong="H8672"\w* \w day of the month|strong="H2320"\w* \w until|strong="H5704"\w* \w the following evening|strong="H6153"\w* \w you are to keep|strong="H7673"\w* \w your Sabbath|strong="H7676"\w*.”
\s1 The Feast of Tabernacles
\r (\ref Nehemiah 8:13–18|NEH 8:13-18\ref*; \ref Zechariah 14:16–21|ZEC 14:16-21\ref*)
\p \v 33 \w And the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 34 “\w Speak|strong="H1696"\w* \w to|strong="H413"\w* \w the Israelites|strong="H1121"\w* \w and say|strong="H559"\w*, ‘\w On the fifteenth|strong="H2568"\w* \w day|strong="H3117"\w* \w of the|strong="H2088"\w* \w seventh|strong="H7637"\w* \w month|strong="H2320"\w* \w the Feast|strong="H2282"\w* \w of Tabernacles|strong="H5521"\w*\f + \fr 23:34 \ft That is, Sukkot, the autumn feast of pilgrimage to Jerusalem; also translated as \fqa the Feast of Booths \ft or \fqa the Feast of Shelters \ft and originally called \fqa the Feast of Ingathering\ft (see \ref Exodus 23:16|EXO 23:16\ref* and Exodus 34:22).\f* \w to the LORD begins|strong="H3068"\w*, \w and it continues for seven|strong="H7651"\w* \w days|strong="H3117"\w*. \v 35 \w On the first|strong="H7223"\w* \w day|strong="H3117"\w* \w there shall be a sacred|strong="H6944"\w* \w assembly|strong="H4744"\w*. \w You must not|strong="H3808"\w* \w do|strong="H6213"\w* \w any|strong="H3605"\w* \w regular work|strong="H4399"\w*. \v 36 \w For seven|strong="H7651"\w* \w days|strong="H3117"\w* \w you are to present|strong="H7126"\w* \w a food offering|strong="H801"\w* \w to the LORD|strong="H3068"\w*. \w On the eighth|strong="H8066"\w* \w day|strong="H3117"\w* \w you are to hold|strong="H1961"\w* \w a sacred|strong="H6944"\w* \w assembly|strong="H4744"\w* \w and present|strong="H7126"\w* \w a food offering|strong="H801"\w* \w to the LORD|strong="H3068"\w*. \w It is|strong="H1931"\w* \w a solemn assembly|strong="H6116"\w*; \w you must not|strong="H3808"\w* \w do|strong="H6213"\w* \w any|strong="H3605"\w* \w regular work|strong="H4399"\w*.
\p \v 37 \w These|strong="H428"\w* \w are the LORD’s|strong="H3068"\w* \w appointed feasts|strong="H4150"\w*, \w which|strong="H834"\w* \w you are to proclaim|strong="H7121"\w* \w as sacred|strong="H6944"\w* \w assemblies|strong="H4744"\w* \w for presenting|strong="H7126"\w* \w food offerings|strong="H801"\w* \w to the LORD|strong="H3068"\w* — \w burnt offerings|strong="H5930"\w* \w and grain offerings|strong="H4503"\w*, \w sacrifices|strong="H2077"\w* \w and drink offerings|strong="H5262"\w*, \w each on|strong="H1697"\w* \w its designated|strong="H3117"\w* \w day|strong="H3117"\w*. \v 38 \w These offerings are in addition to|strong="H905"\w* \w the offerings for the LORD’s|strong="H3068"\w* \w Sabbaths|strong="H7676"\w*, \w and in addition to your gifts|strong="H4979"\w*, \w to all|strong="H3605"\w* \w your vow offerings|strong="H5088"\w*, \w and to all|strong="H3605"\w* \w the freewill offerings|strong="H5071"\w* \w you give|strong="H5414"\w* \w to the LORD|strong="H3068"\w*.
\p \v 39 \w On the fifteenth|strong="H2568"\w* \w day|strong="H3117"\w* \w of the seventh|strong="H7637"\w* \w month|strong="H2320"\w*, \w after you have gathered|strong="H622"\w* \w the produce|strong="H8393"\w* \w of the land|strong="H776"\w*, \w you are to celebrate|strong="H2287"\w* \w a feast|strong="H2282"\w* \w to the LORD|strong="H3068"\w* \w for seven|strong="H7651"\w* \w days|strong="H3117"\w*. \w There shall be complete rest|strong="H7677"\w* \w on the first|strong="H7223"\w* \w day|strong="H3117"\w* \w and also|strong="H7677"\w* \w on the eighth|strong="H8066"\w* \w day|strong="H3117"\w*.
\p \v 40 \w On the first|strong="H7223"\w* \w day|strong="H3117"\w* \w you are to gather|strong="H3947"\w* \w the fruit|strong="H6529"\w* \w of majestic|strong="H1926"\w* \w trees|strong="H6086"\w*, \w the branches|strong="H3709"\w* \w of palm trees|strong="H8558"\w*, \w and the boughs|strong="H6057"\w* \w of leafy|strong="H5687"\w* \w trees|strong="H6086"\w* \w and of willows|strong="H6155"\w*\f + \fr 23:40 \ft Or \fqa poplars\f* \w of the brook|strong="H5158"\w*. \w And you are to rejoice|strong="H8055"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w your God|strong="H430"\w* \w for seven|strong="H7651"\w* \w days|strong="H3117"\w*. \v 41 \w You are to celebrate|strong="H2287"\w* \w this|strong="H853"\w* \w as a feast|strong="H2282"\w* \w to the LORD|strong="H3068"\w* \w for seven|strong="H7651"\w* \w days|strong="H3117"\w* \w each year|strong="H8141"\w*. \w This is a permanent|strong="H5769"\w* \w statute|strong="H2708"\w* \w for the generations to come|strong="H1755"\w*; \w you are to celebrate|strong="H2287"\w* \w it|strong="H853"\w* \w in the seventh|strong="H7637"\w* \w month|strong="H2320"\w*.
\p \v 42 \w You are to dwell|strong="H3427"\w* \w in booths|strong="H5521"\w*\f + \fr 23:42 \ft Or \fqa tabernacles \ft or \fqa shelters\ft ; twice in this verse, and also in verse 43; see the footnote for verse 34.\f* \w for seven|strong="H7651"\w* \w days|strong="H3117"\w*. \w All|strong="H3605"\w* \w the native-born|strong="H249"\w* \w of Israel|strong="H3478"\w* \w must dwell|strong="H3427"\w* \w in booths|strong="H5521"\w*, \v 43 \w so that|strong="H4616"\w* \w your descendants|strong="H1755"\w* \w may know|strong="H3045"\w* \w that|strong="H3588"\w* \w I made the Israelites|strong="H1121"\w* \w dwell|strong="H3427"\w* \w in booths|strong="H5521"\w* \w when I brought them out|strong="H3318"\w* \w of the land|strong="H776"\w* \w of Egypt|strong="H4714"\w*. \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w* \w your God|strong="H430"\w*.’”
\p \v 44 \w So Moses|strong="H4872"\w* \w announced|strong="H1696"\w* \w to|strong="H413"\w* \w the Israelites|strong="H1121"\w* \w the appointed feasts|strong="H4150"\w* \w of the LORD|strong="H3068"\w*.
\c 24
\s1 The Oil for the Lamps
\r (\ref Exodus 27:20–21|EXO 27:20-21\ref*)
\p \v 1 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 2 “\w Command|strong="H6680"\w* \w the Israelites|strong="H1121"\w* \w to bring|strong="H3947"\w* \w you|strong="H413"\w* \w pure|strong="H2134"\w* \w oil|strong="H8081"\w* \w of pressed|strong="H3795"\w* \w olives|strong="H2132"\w* \w for the light|strong="H3974"\w*, \w to keep the lamps|strong="H5216"\w* \w burning|strong="H5927"\w* \w continually|strong="H8548"\w*.
\p \v 3 \w Outside|strong="H2351"\w* \w the veil|strong="H6532"\w* \w of the Testimony|strong="H5715"\w*\f + \fr 24:3 \fqa The Testimony \ft refers to the stone tablets in the ark of the covenant inscribed with the Ten Commandments.\f* \w in the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*, \w Aaron|strong="H175"\w* \w is to tend|strong="H6186"\w* \w the lamps|strong="H853"\w* \w continually|strong="H8548"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w from evening|strong="H6153"\w* \w until|strong="H5704"\w* \w morning|strong="H1242"\w*. \w This is to be a permanent|strong="H5769"\w* \w statute|strong="H2708"\w* \w for the generations to come|strong="H1755"\w*. \v 4 \w He shall tend|strong="H6186"\w* \w the lamps|strong="H5216"\w* \w on|strong="H5921"\w* \w the pure gold|strong="H2889"\w* \w lampstand|strong="H4501"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w continually|strong="H8548"\w*.
\s1 The Showbread
\r (\ref Exodus 25:23–30|EXO 25:23-30\ref*; \ref Exodus 37:10–16|EXO 37:10-16\ref*)
\p \v 5 \w You are also to take|strong="H3947"\w* \w fine flour|strong="H5560"\w* \w and bake|strong="H644"\w* \w twelve|strong="H8147"\w* \w loaves|strong="H2471"\w*, \w using|strong="H1961"\w* \w two-tenths of an ephah|strong="H8147"\w* \w for each|strong="H259"\w* \w loaf|strong="H2471"\w*,\f + \fr 24:5 \fqa Two-tenths of an ephah \ft is approximately 4 dry quarts or 4.4 liters (probably about 5.1 pounds or 2.3 kilograms of flour).\f* \v 6 \w and set|strong="H7760"\w* \w them|strong="H853"\w* \w in two|strong="H8147"\w* \w rows|strong="H4635"\w* — \w six|strong="H8337"\w* \w per row|strong="H4635"\w* — \w on|strong="H5921"\w* \w the table|strong="H7979"\w* \w of pure gold|strong="H2889"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*. \v 7 \w And you are to place|strong="H5414"\w* \w pure|strong="H2134"\w* \w frankincense|strong="H3828"\w* \w near|strong="H5921"\w* \w each row|strong="H4635"\w*, \w so that it may serve|strong="H1961"\w* \w as a memorial portion|strong="H234"\w* \w for the bread|strong="H3899"\w*, \w a food offering|strong="H801"\w* \w to the LORD|strong="H3068"\w*.
\p \v 8 \w Every Sabbath day|strong="H3117"\w* \w the bread is to be set out|strong="H6186"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w on behalf of the Israelites|strong="H3478"\w* \w as a permanent|strong="H5769"\w* \w covenant|strong="H1285"\w*. \v 9 \w It belongs to|strong="H1961"\w* \w Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w*, \w who are to eat|strong="H398"\w* \w it in a holy|strong="H6918"\w* \w place|strong="H4725"\w*; \w for|strong="H3588"\w* \w it is|strong="H1931"\w* to him \w a most|strong="H6944"\w* \w holy part|strong="H6944"\w* \w of the food offerings|strong="H801"\w* \w to the LORD|strong="H3068"\w* — \w his portion|strong="H2706"\w* \w forever|strong="H5769"\w*.”
\s1 Punishment for Blasphemy
\p \v 10 \w Now the son|strong="H1121"\w* \w of an Israelite|strong="H3481"\w* \w mother|strong="H802"\w* \w and an Egyptian|strong="H4713"\w* \w father|strong="H376"\w* \w went out|strong="H3318"\w* \w among|strong="H8432"\w* \w the Israelites|strong="H3478"\w*, \w and a fight broke out|strong="H5327"\w* \w in the camp|strong="H4264"\w* \w between him|strong="H1121"\w* \w and an Israelite|strong="H3481"\w*. \v 11 \w The son|strong="H1121"\w* \w of the Israelite|strong="H3481"\w* \w woman|strong="H802"\w* \w blasphemed|strong="H5344"\w* \w the Name|strong="H8034"\w* \w with a curse|strong="H7043"\w*. \w So they brought|strong="H935"\w* \w him|strong="H853"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*. \w (His mother’s|strong="H517"\w* \w name|strong="H8034"\w* \w was Shelomith|strong="H8019"\w* \w daughter|strong="H1323"\w* \w of Dibri|strong="H1704"\w*, \w of the tribe|strong="H4294"\w* \w of Dan|strong="H1835"\w*.)
