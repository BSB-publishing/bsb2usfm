\c 1
\s1 Laws for Burnt Offerings
\r (\ref Leviticus 6:8–13|LEV 6:8-13\ref*)
\p \v 1 \w Then the LORD|strong="H3068"\w* \w called to|strong="H7121"\w* \w Moses|strong="H4872"\w* \w and spoke|strong="H1696"\w* \w to him|strong="H413"\w* \w from the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*, \w saying|strong="H559"\w*, \v 2 “\w Speak|strong="H1696"\w* \w to|strong="H413"\w* \w the Israelites|strong="H1121"\w* \w and tell|strong="H559"\w* \w them|strong="H413"\w*: \w When|strong="H3588"\w* \w any|strong="H120"\w* of \w you brings|strong="H7126"\w* \w an offering|strong="H7133"\w* \w to the LORD|strong="H3068"\w*, \w you may bring|strong="H7126"\w* \w as your offering|strong="H7133"\w* \w an|strong="H4480"\w* \w animal|strong="H929"\w* \w from|strong="H4480"\w* \w the herd|strong="H1241"\w* \w or the flock|strong="H6629"\w*.
\p \v 3 \w If|strong="H518"\w* \w his offering|strong="H7133"\w* \w is a burnt offering|strong="H5930"\w* \w from|strong="H4480"\w* \w the herd|strong="H1241"\w*, \w he is to present|strong="H7126"\w* \w an unblemished|strong="H8549"\w* \w male|strong="H2145"\w*. \w He must bring|strong="H7126"\w* \w it|strong="H853"\w* \w to|strong="H413"\w* \w the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w* \w for its acceptance|strong="H7522"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*. \v 4 \w He is to lay|strong="H5564"\w* \w his hand|strong="H3027"\w* \w on|strong="H5921"\w* \w the head|strong="H7218"\w* \w of the burnt offering|strong="H5930"\w*, \w so it can be accepted|strong="H7521"\w* on his behalf \w to make atonement|strong="H3722"\w* \w for him|strong="H5921"\w*.
\p \v 5 \w And he shall slaughter|strong="H7819"\w* \w the young|strong="H1121"\w* \w bull|strong="H1241"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*, \w and Aaron’s|strong="H175"\w* \w sons|strong="H1121"\w* \w the priests|strong="H3548"\w* \w are to present|strong="H7126"\w* \w the blood|strong="H1818"\w* \w and splatter|strong="H2236"\w* \w it|strong="H1818"\w* \w on all sides|strong="H5439"\w* \w of|strong="H5921"\w* \w the altar|strong="H4196"\w* \w at the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \v 6 \w Next, he is to skin|strong="H6584"\w* \w the burnt offering|strong="H5930"\w* \w and cut|strong="H5408"\w* \w it into pieces|strong="H5409"\w*.
\p \v 7 \w The sons|strong="H1121"\w* \w of Aaron|strong="H175"\w* \w the priest|strong="H3548"\w* \w shall put|strong="H5414"\w* \w a fire|strong="H784"\w* \w on|strong="H5921"\w* \w the altar|strong="H4196"\w* \w and arrange|strong="H6186"\w* \w wood|strong="H6086"\w* \w on|strong="H5921"\w* \w the fire|strong="H784"\w*. \v 8 \w Then Aaron’s|strong="H175"\w* \w sons|strong="H1121"\w* \w the priests|strong="H3548"\w* \w are to arrange|strong="H6186"\w* \w the pieces|strong="H5409"\w*, \w including the head|strong="H7218"\w* \w and the fat|strong="H6309"\w*, \w atop|strong="H5921"\w* \w the burning|strong="H784"\w* \w wood|strong="H6086"\w* \w on|strong="H5921"\w* \w the altar|strong="H4196"\w*. \v 9 \w The entrails|strong="H7130"\w* \w and legs|strong="H3767"\w* \w must be washed|strong="H7364"\w* \w with water|strong="H4325"\w*, \w and the priest|strong="H3548"\w* \w shall burn|strong="H6999"\w* \w all of it|strong="H3605"\w* \w on the altar|strong="H4196"\w* \w as a burnt offering|strong="H5930"\w*, \w a food offering|strong="H801"\w*, \w a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w* \w to the LORD|strong="H3068"\w*.
\p \v 10 \w If, however|strong="H518"\w*, \w one’s offering|strong="H7133"\w* \w is a burnt offering|strong="H5930"\w* \w from|strong="H4480"\w* \w the flock|strong="H6629"\w* — \w from|strong="H4480"\w* \w the sheep|strong="H3775"\w* \w or|strong="H176"\w* \w goats|strong="H5795"\w* — \w he is to present|strong="H7126"\w* \w an unblemished|strong="H8549"\w* \w male|strong="H2145"\w*. \v 11 \w He shall slaughter|strong="H7819"\w* \w it on|strong="H5921"\w* \w the north|strong="H6828"\w* \w side|strong="H3409"\w* \w of the altar|strong="H4196"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*, \w and Aaron’s|strong="H175"\w* \w sons|strong="H1121"\w* \w the priests|strong="H3548"\w* \w are to splatter|strong="H2236"\w* \w its blood|strong="H1818"\w* \w against|strong="H5921"\w* \w the altar|strong="H4196"\w* \w on all sides|strong="H5439"\w*. \v 12 \w He is to cut|strong="H5408"\w* \w the animal|strong="H853"\w* \w into pieces|strong="H5409"\w*, \w and the priest|strong="H3548"\w* \w shall arrange|strong="H6186"\w* \w them|strong="H853"\w*, \w including|strong="H853"\w* \w the head|strong="H7218"\w* \w and fat|strong="H6309"\w*, \w atop|strong="H5921"\w* \w the burning|strong="H784"\w* \w wood|strong="H6086"\w* \w that|strong="H834"\w* \w is on|strong="H5921"\w* \w the altar|strong="H4196"\w*. \v 13 \w The entrails|strong="H7130"\w* \w and legs|strong="H3767"\w* \w must be washed|strong="H7364"\w* \w with water|strong="H4325"\w*, \w and the priest|strong="H3548"\w* \w shall present|strong="H7126"\w* \w all of it|strong="H3605"\w* \w and burn it|strong="H6999"\w* \w on the altar|strong="H4196"\w*; \w it|strong="H1931"\w* \w is a burnt offering|strong="H5930"\w*, \w a food offering|strong="H801"\w*, \w a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w* \w to the LORD|strong="H3068"\w*.
\p \v 14 \w If, instead|strong="H518"\w*, \w one’s offering|strong="H7133"\w* \w to the LORD|strong="H3068"\w* \w is a burnt offering|strong="H5930"\w* \w of|strong="H4480"\w* \w birds|strong="H5775"\w*, \w he is to present|strong="H7126"\w* \w a turtledove|strong="H8449"\w* \w or|strong="H176"\w* \w a young|strong="H1121"\w* \w pigeon|strong="H3123"\w*. \v 15 \w Then the priest|strong="H3548"\w* \w shall bring|strong="H7126"\w* \w it to|strong="H413"\w* \w the altar|strong="H4196"\w*, \w twist off|strong="H4454"\w* \w its head|strong="H7218"\w*, \w and burn|strong="H6999"\w* \w it on the altar|strong="H4196"\w*; \w its blood|strong="H1818"\w* \w should be drained out|strong="H4680"\w* \w on|strong="H5921"\w* \w the side|strong="H7023"\w* \w of the altar|strong="H4196"\w*. \v 16 \w And he is to remove|strong="H5493"\w* \w the crop|strong="H4760"\w* \w with its contents|strong="H5133"\w*\f + \fr 1:16 \ft Or \fqa the crop and feathers\f* \w and throw|strong="H7993"\w* \w it|strong="H853"\w* \w to the east|strong="H6924"\w* \w side|strong="H681"\w* \w of the altar|strong="H4196"\w*, \w in|strong="H413"\w* \w the place|strong="H4725"\w* \w for ashes|strong="H1880"\w*. \v 17 \w He shall tear it open|strong="H8156"\w* \w by its wings|strong="H3671"\w*, \w without|strong="H3808"\w* \w dividing the bird completely|strong="H914"\w*. \w And the priest|strong="H3548"\w* \w is to burn|strong="H6999"\w* \w it|strong="H853"\w* \w on the altar|strong="H4196"\w* \w atop|strong="H5921"\w* \w the burning|strong="H784"\w* \w wood|strong="H6086"\w*. \w It|strong="H1931"\w* \w is a burnt offering|strong="H5930"\w*, \w a food offering|strong="H801"\w*, \w a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w* \w to the LORD|strong="H3068"\w*.[’’]
\c 2
\s1 Laws for Grain Offerings
\r (\ref Leviticus 6:14–23|LEV 6:14-23\ref*)
\p \v 1 “\w When|strong="H3588"\w* \w anyone|strong="H5315"\w* \w brings|strong="H7126"\w* \w a grain offering|strong="H7133"\w* \w to the LORD|strong="H3068"\w*, \w his offering|strong="H7133"\w* \w must consist of fine flour|strong="H5560"\w*. \w He is to pour|strong="H3332"\w* \w olive oil|strong="H8081"\w* \w on it|strong="H5921"\w*, \w put|strong="H5414"\w* \w frankincense|strong="H3828"\w* \w on it|strong="H5921"\w*, \v 2 \w and bring|strong="H935"\w* \w it to|strong="H413"\w* \w Aaron’s|strong="H175"\w* \w sons|strong="H1121"\w* \w the priests|strong="H3548"\w*. \w The priest|strong="H3548"\w* \w shall take a handful|strong="H7061"\w* \w of the flour|strong="H5560"\w* \w and oil|strong="H8081"\w*, \w together with|strong="H5921"\w* \w all|strong="H3605"\w* \w the frankincense|strong="H3828"\w*, \w and burn this|strong="H6999"\w* \w as a memorial portion|strong="H234"\w* \w on the altar|strong="H4196"\w*, \w a food offering|strong="H801"\w*, \w a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w* \w to the LORD|strong="H3068"\w*. \v 3 \w The remainder|strong="H3498"\w* \w of|strong="H4480"\w* \w the grain offering|strong="H4503"\w* \w shall belong to Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w*; \w it is a most|strong="H6944"\w* \w holy part|strong="H6944"\w* \w of the food offerings|strong="H801"\w* \w to the LORD|strong="H3068"\w*.
\p \v 4 \w Now if|strong="H3588"\w* \w you bring|strong="H7126"\w* \w an offering of grain|strong="H7133"\w* \w baked|strong="H3989"\w* \w in an oven|strong="H8574"\w*, \w it must consist of fine flour|strong="H5560"\w*, \w either unleavened|strong="H4682"\w* \w cakes|strong="H2471"\w* \w mixed|strong="H1101"\w* \w with oil|strong="H8081"\w* \w or unleavened|strong="H4682"\w* \w wafers|strong="H7550"\w* \w coated|strong="H4886"\w* \w with oil|strong="H8081"\w*.
\p \v 5 \w If|strong="H518"\w* \w your offering|strong="H7133"\w* \w is a grain offering|strong="H4503"\w* \w prepared on|strong="H5921"\w* \w a griddle|strong="H4227"\w*,\f + \fr 2:5 \ft That is, a shallow pan for baking or frying\f* \w it must be|strong="H1961"\w* \w unleavened bread|strong="H4682"\w* \w made of fine flour|strong="H5560"\w* \w mixed|strong="H1101"\w* \w with oil|strong="H8081"\w*. \v 6 \w Crumble it|strong="H6626"\w* \w and pour|strong="H3332"\w* \w oil|strong="H8081"\w* \w on it|strong="H5921"\w*; \w it|strong="H1931"\w* \w is a grain offering|strong="H4503"\w*.
\p \v 7 \w If|strong="H518"\w* \w your offering|strong="H7133"\w* \w is a grain offering|strong="H4503"\w* \w cooked in a pan|strong="H4802"\w*,\f + \fr 2:7 \ft That is, a deep pan or stew pan\f* \w it must consist|strong="H6213"\w* \w of fine flour|strong="H5560"\w* \w with oil|strong="H8081"\w*.
\p \v 8 \w When you bring|strong="H935"\w* \w to the LORD|strong="H3068"\w* \w the grain offering|strong="H4503"\w* \w made|strong="H6213"\w* \w in any of these ways|strong="H428"\w*, \w it is to be presented|strong="H7126"\w* \w to|strong="H413"\w* \w the priest|strong="H3548"\w*, \w and he shall take|strong="H5066"\w* \w it to|strong="H413"\w* \w the altar|strong="H4196"\w*. \v 9 \w The priest|strong="H3548"\w* \w is to remove|strong="H7311"\w* \w the memorial portion|strong="H234"\w* \w from|strong="H4480"\w* \w the grain offering|strong="H4503"\w* \w and burn|strong="H6999"\w* \w it on the altar|strong="H4196"\w* \w as a food offering|strong="H801"\w*, \w a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w* \w to the LORD|strong="H3068"\w*. \v 10 \w But the remainder|strong="H3498"\w* \w of|strong="H4480"\w* \w the grain offering|strong="H4503"\w* \w shall belong to Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w*; \w it is a most|strong="H6944"\w* \w holy|strong="H6944"\w* \w part of the food offerings|strong="H801"\w* \w to the LORD|strong="H3068"\w*.
\p \v 11 \w No|strong="H3605"\w* \w grain offering|strong="H4503"\w* \w that|strong="H834"\w* \w you present|strong="H7126"\w* \w to the LORD|strong="H3068"\w* \w may be made|strong="H6213"\w* \w with leaven|strong="H2557"\w*, \w for|strong="H3588"\w* \w you are not|strong="H3808"\w* \w to burn|strong="H6999"\w* \w any|strong="H3605"\w* \w leaven|strong="H7603"\w* \w or honey|strong="H1706"\w* \w as a food offering|strong="H801"\w* \w to the LORD|strong="H3068"\w*. \v 12 \w You may bring|strong="H7126"\w* \w them|strong="H853"\w* \w to the LORD|strong="H3068"\w* \w as an offering|strong="H7133"\w* \w of firstfruits|strong="H7225"\w*, \w but they must not|strong="H3808"\w* \w go up|strong="H5927"\w* \w on|strong="H413"\w* \w the altar|strong="H4196"\w* \w as a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w*. \v 13 \w And you shall season|strong="H4414"\w* \w each|strong="H3605"\w* \w of your grain offerings|strong="H7133"\w* \w with salt|strong="H4417"\w*. \w You must not|strong="H3808"\w* \w leave|strong="H7673"\w* \w the salt|strong="H4417"\w* \w of the covenant|strong="H1285"\w* \w of your God|strong="H430"\w* \w out of|strong="H5921"\w* \w your grain offering|strong="H4503"\w*; \w you are to add|strong="H7126"\w* \w salt|strong="H4417"\w* \w to|strong="H5921"\w* \w each|strong="H3605"\w* \w of your offerings|strong="H7133"\w*.
\p \v 14 \w If|strong="H518"\w* \w you bring|strong="H7126"\w* \w a grain offering|strong="H4503"\w* \w of firstfruits|strong="H1061"\w* \w to the LORD|strong="H3068"\w*, \w you shall offer|strong="H7126"\w* \w crushed|strong="H1643"\w* \w heads of new grain|strong="H24"\w* \w roasted|strong="H7033"\w* \w on the fire|strong="H784"\w*. \v 15 \w And you are to put|strong="H5414"\w* \w oil|strong="H8081"\w* \w and frankincense|strong="H3828"\w* \w on it|strong="H5921"\w*; \w it|strong="H1931"\w* \w is a grain offering|strong="H4503"\w*. \v 16 \w The priest|strong="H3548"\w* \w shall then burn|strong="H6999"\w* \w the memorial portion|strong="H234"\w* \w of the crushed grain|strong="H1643"\w* \w and the oil|strong="H8081"\w*, \w together with|strong="H5921"\w* \w all|strong="H3605"\w* \w its frankincense|strong="H3828"\w*, \w as a food offering|strong="H801"\w* \w to the LORD|strong="H3068"\w*.[’’]
\c 3
\s1 Laws for Peace Offerings
\r (\ref Leviticus 7:11–21|LEV 7:11-21\ref*)
\p \v 1 “\w If|strong="H518"\w* \w one’s offering|strong="H7133"\w* \w is a peace offering|strong="H8002"\w* \w and he|strong="H1931"\w* \w offers|strong="H7126"\w* \w an animal from|strong="H4480"\w* \w the herd|strong="H1241"\w*, \w whether|strong="H518"\w* \w male|strong="H2145"\w* \w or|strong="H518"\w* \w female|strong="H5347"\w*, \w he must present|strong="H7126"\w* \w it without blemish|strong="H8549"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*. \v 2 \w He is to lay|strong="H5564"\w* \w his hand|strong="H3027"\w* \w on|strong="H5921"\w* \w the head|strong="H7218"\w* \w of the offering|strong="H7133"\w* \w and slaughter|strong="H7819"\w* \w it at the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \w Then Aaron’s|strong="H175"\w* \w sons|strong="H1121"\w* \w the priests|strong="H3548"\w* \w shall splatter|strong="H2236"\w* \w the blood|strong="H1818"\w* \w on all sides|strong="H5439"\w* \w of|strong="H5921"\w* \w the altar|strong="H4196"\w*.
\p \v 3 \w From the peace offering|strong="H8002"\w* \w he is to bring|strong="H7126"\w* \w a food offering|strong="H801"\w* \w to the LORD|strong="H3068"\w*: \w the fat|strong="H2459"\w* \w that covers|strong="H3680"\w* \w the entrails|strong="H7130"\w*, \w all|strong="H3605"\w* \w the fat|strong="H2459"\w* \w that|strong="H834"\w* \w is on|strong="H5921"\w* \w them|strong="H7130"\w*, \v 4 \w both|strong="H8147"\w* \w kidneys|strong="H3629"\w* \w with the fat|strong="H2459"\w* \w on them|strong="H5921"\w* \w near|strong="H5921"\w* \w the loins|strong="H3689"\w*, \w and|strong="H853"\w* \w the lobe|strong="H3508"\w* \w of|strong="H5921"\w* \w the liver|strong="H3516"\w*, \w which he is to remove|strong="H5493"\w* \w with|strong="H5921"\w* \w the kidneys|strong="H3629"\w*. \v 5 \w Then Aaron’s|strong="H175"\w* \w sons|strong="H1121"\w* \w are to burn|strong="H6999"\w* \w it|strong="H853"\w* \w on the altar|strong="H4196"\w* \w atop|strong="H5921"\w* \w the burnt offering|strong="H5930"\w* \w that|strong="H834"\w* \w is on|strong="H5921"\w* \w the burning|strong="H784"\w* \w wood|strong="H6086"\w*, \w as a food offering|strong="H801"\w*, \w a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w* \w to the LORD|strong="H3068"\w*.
\p \v 6 \w If, however|strong="H518"\w*, \w one’s peace offering|strong="H8002"\w* \w to the LORD|strong="H3068"\w* \w is from|strong="H4480"\w* \w the flock|strong="H6629"\w*, \w he must present|strong="H7126"\w* \w a male|strong="H2145"\w* \w or|strong="H176"\w* \w female|strong="H5347"\w* \w without blemish|strong="H8549"\w*.
\p \v 7 \w If|strong="H518"\w* \w he|strong="H1931"\w* \w is presenting|strong="H7126"\w* \w a lamb|strong="H3775"\w* \w for his offering|strong="H7133"\w*, \w he must present|strong="H7126"\w* \w it before|strong="H6440"\w* \w the LORD|strong="H3068"\w*. \v 8 \w He is to lay|strong="H5564"\w* \w his hand|strong="H3027"\w* \w on|strong="H5921"\w* \w the head|strong="H7218"\w* \w of his offering|strong="H7133"\w* \w and slaughter|strong="H7819"\w* \w it|strong="H853"\w* \w in front of|strong="H6440"\w* \w the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \w Then Aaron’s|strong="H175"\w* \w sons|strong="H1121"\w* \w shall splatter|strong="H2236"\w* \w its blood|strong="H1818"\w* \w on all sides|strong="H5439"\w* \w of|strong="H5921"\w* \w the altar|strong="H4196"\w*.
\p \v 9 \w And from the peace offering|strong="H8002"\w* \w he shall bring|strong="H7126"\w* \w a food offering|strong="H801"\w* \w to the LORD|strong="H3068"\w* \w consisting of its fat|strong="H2459"\w*: \w the entire|strong="H8549"\w* \w fat tail|strong="H451"\w* \w cut off|strong="H5493"\w* \w close to|strong="H5980"\w* \w the backbone|strong="H6096"\w*, \w the fat|strong="H2459"\w* \w that covers|strong="H3680"\w* \w the entrails|strong="H7130"\w*, \w all|strong="H3605"\w* \w the fat|strong="H2459"\w* \w that is|strong="H834"\w* \w on|strong="H5921"\w* \w them|strong="H7130"\w*, \v 10 \w both|strong="H8147"\w* \w kidneys|strong="H3629"\w* \w with the fat|strong="H2459"\w* \w on them|strong="H5921"\w* \w near|strong="H5921"\w* \w the loins|strong="H3689"\w*, \w and|strong="H853"\w* \w the lobe|strong="H3508"\w* \w of|strong="H5921"\w* \w the liver|strong="H3516"\w*, \w which he is to remove|strong="H5493"\w* \w with|strong="H5921"\w* \w the kidneys|strong="H3629"\w*. \v 11 \w Then the priest|strong="H3548"\w* \w is to burn them|strong="H6999"\w* \w on the altar|strong="H4196"\w* \w as food|strong="H3899"\w*, \w a food offering|strong="H801"\w* \w to the LORD|strong="H3068"\w*.
\p \v 12 \w If|strong="H518"\w* \w one’s offering|strong="H7133"\w* \w is a goat|strong="H5795"\w*, \w he is to present|strong="H7126"\w* \w it before|strong="H6440"\w* \w the LORD|strong="H3068"\w*. \v 13 \w He must lay|strong="H5564"\w* \w his hand|strong="H3027"\w* \w on|strong="H5921"\w* \w its head|strong="H7218"\w* \w and slaughter|strong="H7819"\w* \w it|strong="H853"\w* \w in front of|strong="H6440"\w* \w the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \w Then Aaron’s|strong="H175"\w* \w sons|strong="H1121"\w* \w shall splatter|strong="H2236"\w* \w its blood|strong="H1818"\w* \w on all sides|strong="H5439"\w* \w of|strong="H5921"\w* \w the altar|strong="H4196"\w*.
\p \v 14 \w And from|strong="H4480"\w* \w his offering|strong="H7133"\w* \w he shall present|strong="H7126"\w* \w a food offering|strong="H801"\w* \w to the LORD|strong="H3068"\w*: \w the fat|strong="H2459"\w* \w that covers|strong="H3680"\w* \w the entrails|strong="H7130"\w*, \w all|strong="H3605"\w* \w the fat|strong="H2459"\w* \w that|strong="H834"\w* \w is on|strong="H5921"\w* \w them|strong="H7130"\w*, \v 15 \w both|strong="H8147"\w* \w kidneys|strong="H3629"\w* \w with the fat|strong="H2459"\w* \w on them|strong="H5921"\w* \w near|strong="H5921"\w* \w the loins|strong="H3689"\w*, \w and|strong="H853"\w* \w the lobe|strong="H3508"\w* \w of|strong="H5921"\w* \w the liver|strong="H3516"\w*, \w which he is to remove|strong="H5493"\w* \w with|strong="H5921"\w* \w the kidneys|strong="H3629"\w*. \v 16 \w Then the priest|strong="H3548"\w* \w is to burn|strong="H6999"\w* \w the food|strong="H3899"\w* \w on the altar|strong="H4196"\w* \w as a food offering|strong="H801"\w*, \w a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w*. \w All|strong="H3605"\w* \w the fat|strong="H2459"\w* \w is the LORD’s|strong="H3068"\w*.
\p \v 17 \w This is a permanent|strong="H5769"\w* \w statute|strong="H2708"\w* \w for the generations to come|strong="H1755"\w*, \w wherever|strong="H3605"\w* \w you live|strong="H4186"\w*: \w You must not|strong="H3808"\w* \w eat|strong="H398"\w* \w any|strong="H3605"\w* \w fat|strong="H2459"\w* \w or any|strong="H3605"\w* \w blood|strong="H1818"\w*.”
\c 4
\s1 Laws for Sin Offerings
\r (\ref Leviticus 5:1–13|LEV 5:1-13\ref*; \ref Leviticus 6:24–30|LEV 6:24-30\ref*)
\p \v 1 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 2 “\w Tell|strong="H1696"\w* \w the Israelites|strong="H1121"\w* \w to|strong="H559"\w* \w do as follows|strong="H3588"\w* \w with one|strong="H5315"\w* \w who sins|strong="H2398"\w* \w unintentionally|strong="H7684"\w* \w against any|strong="H3605"\w* \w of the LORD’s|strong="H3068"\w* \w commandments|strong="H4687"\w* \w and does|strong="H6213"\w* \w what is|strong="H259"\w* \w forbidden|strong="H3808"\w* by them:
\p \v 3 \w If|strong="H518"\w* \w the anointed|strong="H4899"\w* \w priest|strong="H3548"\w* \w sins|strong="H2398"\w*, \w bringing guilt|strong="H819"\w* \w on the people|strong="H5971"\w*, \w he must bring|strong="H7126"\w* \w to the LORD|strong="H3068"\w* \w a young bull|strong="H6499"\w* \w without blemish|strong="H8549"\w* \w as|strong="H5921"\w* \w a sin offering|strong="H2403"\w*\f + \fr 4:3 \ft Or \fqa purification offering\ft ; here and throughout Leviticus\f* \w for the sin|strong="H2403"\w* \w he has committed|strong="H2398"\w*. \v 4 \w He must bring|strong="H935"\w* \w the bull|strong="H6499"\w* \w to|strong="H413"\w* \w the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*, \w lay|strong="H5564"\w* \w his hand|strong="H3027"\w* \w on|strong="H5921"\w* \w the bull’s|strong="H6499"\w* \w head|strong="H7218"\w*, \w and slaughter|strong="H7819"\w* \w it|strong="H6499"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*. \v 5 \w Then the anointed|strong="H4899"\w* \w priest|strong="H3548"\w* \w shall take|strong="H3947"\w* \w some of the bull’s|strong="H6499"\w* \w blood|strong="H1818"\w* \w and bring|strong="H935"\w* \w it|strong="H853"\w* \w into|strong="H413"\w* \w the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \v 6 \w The priest|strong="H3548"\w* \w is to dip|strong="H2881"\w* \w his finger|strong="H676"\w* \w in the blood|strong="H1818"\w* \w and sprinkle|strong="H5137"\w* \w some of|strong="H4480"\w* \w it|strong="H1818"\w* \w seven|strong="H7651"\w* \w times|strong="H6471"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*, \w in front of|strong="H6440"\w* \w the veil|strong="H6532"\w* \w of the sanctuary|strong="H6944"\w*. \v 7 \w The priest|strong="H3548"\w* \w must then put|strong="H5414"\w* \w some of|strong="H4480"\w* \w the blood|strong="H1818"\w* \w on|strong="H5921"\w* \w the horns|strong="H7161"\w* \w of the altar|strong="H4196"\w* \w of fragrant|strong="H5561"\w* \w incense|strong="H7004"\w* \w that is before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w in the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \w And|strong="H853"\w* \w he is to pour out|strong="H8210"\w* \w the rest|strong="H3605"\w* \w of the bull’s|strong="H6499"\w* \w blood|strong="H1818"\w* \w at|strong="H413"\w* \w the base|strong="H3247"\w* \w of the altar|strong="H4196"\w* \w of burnt offering|strong="H5930"\w* \w at the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \v 8 \w Then|strong="H853"\w* \w he shall remove|strong="H7311"\w* \w all|strong="H3605"\w* \w the fat|strong="H2459"\w* \w from|strong="H4480"\w* \w the bull|strong="H6499"\w* \w of the sin offering|strong="H2403"\w*— \w the fat|strong="H2459"\w* \w that covers|strong="H3680"\w* \w the entrails|strong="H7130"\w*, \w all|strong="H3605"\w* \w the fat|strong="H2459"\w* \w that|strong="H834"\w* \w is on|strong="H5921"\w* \w them|strong="H7130"\w*, \v 9 \w both|strong="H8147"\w* \w kidneys|strong="H3629"\w* \w with the fat|strong="H2459"\w* \w on them|strong="H5921"\w* \w near|strong="H5921"\w* \w the loins|strong="H3689"\w*, \w and|strong="H853"\w* \w the lobe|strong="H3508"\w* \w of|strong="H5921"\w* \w the liver|strong="H3516"\w*, \w which he is to remove|strong="H5493"\w* \w with|strong="H5921"\w* \w the kidneys|strong="H3629"\w*— \v 10 \w just as|strong="H834"\w* \w the fat is removed|strong="H7311"\w* \w from the ox|strong="H7794"\w* \w of the peace offering|strong="H8002"\w*. \w Then the priest|strong="H3548"\w* \w shall burn them|strong="H6999"\w* \w on|strong="H5921"\w* \w the altar|strong="H4196"\w* \w of burnt offering|strong="H5930"\w*. \v 11 \w But the hide|strong="H5785"\w* \w of the bull|strong="H6499"\w* \w and all|strong="H3605"\w* \w its flesh|strong="H1320"\w*, \w with|strong="H5921"\w* \w its head|strong="H7218"\w* \w and legs|strong="H3767"\w* \w and its entrails|strong="H7130"\w* \w and dung|strong="H6569"\w*— \v 12 \w all|strong="H3605"\w* \w the rest of the bull|strong="H6499"\w*— \w he must take|strong="H3318"\w* \w outside|strong="H2351"\w* \w the camp|strong="H4264"\w* \w to|strong="H413"\w* \w a ceremonially clean|strong="H2889"\w* \w place|strong="H4725"\w* \w where|strong="H413"\w* \w the ashes|strong="H1880"\w* \w are poured out|strong="H8211"\w*, \w and there he must burn|strong="H8313"\w* \w it on|strong="H5921"\w* \w a wood|strong="H6086"\w* \w fire|strong="H784"\w* \w on|strong="H5921"\w* \w the ash|strong="H1880"\w* \w heap|strong="H8211"\w*.
\p \v 13 \w Now if|strong="H518"\w* \w the whole|strong="H3605"\w* \w congregation|strong="H5712"\w* \w of Israel|strong="H3478"\w* \w strays unintentionally|strong="H7686"\w* \w and the matter|strong="H1697"\w* \w escapes|strong="H5956"\w* \w the notice|strong="H5869"\w* \w of the assembly|strong="H6951"\w* \w so that they violate|strong="H6213"\w* \w any|strong="H259"\w* \w of the LORD’s|strong="H3068"\w* \w commandments|strong="H4687"\w* \w and incur guilt|strong="H816"\w* \w by doing what|strong="H834"\w* \w is forbidden|strong="H3808"\w*, \v 14 \w when they become aware|strong="H3045"\w* \w of the sin|strong="H2403"\w* \w they have committed|strong="H2398"\w*, \w then the assembly|strong="H6951"\w* \w must bring|strong="H7126"\w* \w a young|strong="H1121"\w* \w bull|strong="H1241"\w* \w as a sin offering|strong="H2403"\w* \w and present|strong="H935"\w* \w it|strong="H853"\w* \w before|strong="H6440"\w* \w the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \v 15 \w The elders|strong="H2205"\w* \w of the congregation|strong="H5712"\w* \w are to lay|strong="H5564"\w* \w their hands|strong="H3027"\w* \w on|strong="H5921"\w* \w the bull’s|strong="H6499"\w* \w head|strong="H7218"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*, \w and it|strong="H6499"\w* \w shall be slaughtered|strong="H7819"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*. \v 16 \w Then the anointed|strong="H4899"\w* \w priest|strong="H3548"\w* \w is to bring|strong="H935"\w* \w some of the bull’s|strong="H6499"\w* \w blood|strong="H1818"\w* \w into|strong="H413"\w* \w the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*, \v 17 \w and he|strong="H3548"\w* \w is to dip|strong="H2881"\w* \w his finger|strong="H676"\w* \w in|strong="H4480"\w* \w the blood|strong="H1818"\w* \w and sprinkle|strong="H5137"\w* \w it seven|strong="H7651"\w* \w times|strong="H6471"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w in front|strong="H6440"\w* \w of the veil|strong="H6532"\w*. \v 18 \w He is also to put|strong="H5414"\w* \w some of|strong="H4480"\w* \w the blood|strong="H1818"\w* \w on|strong="H5921"\w* \w the horns|strong="H7161"\w* \w of the altar|strong="H4196"\w* \w that|strong="H834"\w* \w is before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w in the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*, \w and|strong="H853"\w* \w he must pour out|strong="H8210"\w* \w the rest|strong="H3605"\w* \w of the blood|strong="H1818"\w* \w at|strong="H413"\w* \w the base|strong="H3247"\w* \w of the altar|strong="H4196"\w* \w of burnt offering|strong="H5930"\w* \w at the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \v 19 \w And|strong="H853"\w* \w he is to remove|strong="H7311"\w* \w all|strong="H3605"\w* \w the fat|strong="H2459"\w* \w from it|strong="H4480"\w* \w and burn it|strong="H6999"\w* \w on the altar|strong="H4196"\w*. \v 20 \w He shall offer|strong="H6213"\w* \w this bull|strong="H6499"\w* \w just as|strong="H834"\w* \w he did|strong="H6213"\w* \w the bull|strong="H6499"\w* \w for the sin offering|strong="H2403"\w*; \w in this way|strong="H3651"\w* \w the priest|strong="H3548"\w* \w will make atonement|strong="H3722"\w* \w on their behalf|strong="H5921"\w*, \w and they will be forgiven|strong="H5545"\w*. \v 21 \w Then he is to take|strong="H3318"\w* \w the bull|strong="H6499"\w* \w outside|strong="H2351"\w* \w the camp|strong="H4264"\w* \w and burn|strong="H8313"\w* \w it|strong="H853"\w*, \w just as|strong="H834"\w* \w he burned|strong="H8313"\w* \w the first|strong="H7223"\w* \w bull|strong="H6499"\w*. \w It|strong="H1931"\w* \w is the sin offering|strong="H2403"\w* \w for the assembly|strong="H6951"\w*.
\p \v 22 \w When|strong="H834"\w* \w a leader|strong="H5387"\w* \w sins|strong="H2398"\w* \w unintentionally|strong="H7684"\w* \w and does|strong="H6213"\w* \w what|strong="H834"\w* \w is prohibited|strong="H3808"\w* \w by any|strong="H259"\w* \w of|strong="H3605"\w* \w the commandments|strong="H4687"\w* \w of the LORD|strong="H3068"\w* \w his God|strong="H430"\w*, \w he incurs guilt|strong="H816"\w*. \v 23 \w When he becomes aware|strong="H3045"\w* \w of the sin|strong="H2403"\w* \w he has committed|strong="H2398"\w*, \w he must bring|strong="H935"\w* \w an unblemished|strong="H8549"\w* \w male goat|strong="H8163"\w* \w as his offering|strong="H7133"\w*. \v 24 \w He is to lay|strong="H5564"\w* \w his hand|strong="H3027"\w* \w on|strong="H5921"\w* \w the head|strong="H7218"\w* \w of the goat|strong="H8163"\w* \w and slaughter|strong="H7819"\w* \w it at the place|strong="H4725"\w* \w where|strong="H834"\w* \w the burnt offering|strong="H5930"\w* \w is slaughtered|strong="H7819"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*. \w It|strong="H1931"\w* \w is a sin offering|strong="H2403"\w*. \v 25 \w Then the priest|strong="H3548"\w* \w is to take|strong="H3947"\w* \w some of the blood|strong="H1818"\w* \w of the sin offering|strong="H2403"\w* \w with his finger|strong="H676"\w*, \w put it|strong="H5414"\w* \w on|strong="H5921"\w* \w the horns|strong="H7161"\w* \w of the altar|strong="H4196"\w* \w of burnt offering|strong="H5930"\w*, \w and|strong="H853"\w* \w pour out|strong="H8210"\w* \w the rest of the blood|strong="H1818"\w* \w at|strong="H413"\w* \w the base|strong="H3247"\w* \w of the altar|strong="H4196"\w*. \v 26 \w He must burn|strong="H6999"\w* \w all|strong="H3605"\w* \w its fat|strong="H2459"\w* \w on the altar|strong="H4196"\w*, \w like the fat|strong="H2459"\w* \w of the peace offerings|strong="H8002"\w*; \w thus the priest|strong="H3548"\w* \w will make atonement|strong="H3722"\w* \w for|strong="H5921"\w* \w that man’s sin|strong="H2403"\w*, \w and he will be forgiven|strong="H5545"\w*.
\p \v 27 \w And if|strong="H518"\w* \w one|strong="H5315"\w* \w of the common|strong="H776"\w* \w people|strong="H5971"\w* \w sins|strong="H2398"\w* \w unintentionally|strong="H7684"\w* \w and does what|strong="H834"\w* \w is prohibited|strong="H3808"\w* \w by any|strong="H259"\w* \w of the LORD’s|strong="H3068"\w* \w commandments|strong="H4687"\w*, \w he incurs guilt|strong="H816"\w*. \v 28 \w When he becomes aware|strong="H3045"\w* \w of the sin|strong="H2403"\w* \w he has committed|strong="H2398"\w*, \w he must bring|strong="H935"\w* \w an unblemished|strong="H8549"\w* \w female|strong="H5347"\w* \w goat|strong="H8166"\w* \w as his offering|strong="H7133"\w* \w for|strong="H5921"\w* \w that sin|strong="H2403"\w*. \v 29 \w He is to lay|strong="H5564"\w* \w his hand|strong="H3027"\w* \w on|strong="H5921"\w* \w the head|strong="H7218"\w* \w of the sin offering|strong="H2403"\w* \w and slaughter|strong="H7819"\w* \w it|strong="H2403"\w* \w at the place|strong="H4725"\w* \w of the burnt offering|strong="H5930"\w*. \v 30 \w Then the priest|strong="H3548"\w* \w is to take|strong="H3947"\w* \w some of its blood|strong="H1818"\w* \w with his finger|strong="H676"\w*, \w put it|strong="H5414"\w* \w on|strong="H5921"\w* \w the horns|strong="H7161"\w* \w of the altar|strong="H4196"\w* \w of burnt offering|strong="H5930"\w*, \w and|strong="H853"\w* \w pour out|strong="H8210"\w* \w the rest|strong="H3605"\w* \w of the blood|strong="H1818"\w* \w at|strong="H413"\w* \w the base|strong="H3247"\w* \w of the altar|strong="H4196"\w*. \v 31 \w Then|strong="H853"\w* \w he is to remove|strong="H5493"\w* \w all|strong="H3605"\w* \w the fat|strong="H2459"\w*, \w just as|strong="H834"\w* \w it|strong="H2459"\w* \w is removed|strong="H5493"\w* \w from|strong="H5921"\w* \w the peace offering|strong="H8002"\w*, \w and the priest|strong="H3548"\w* \w is to burn|strong="H6999"\w* \w it on the altar|strong="H4196"\w* \w as a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w* \w to the LORD|strong="H3068"\w*. \w In this way the priest|strong="H3548"\w* \w will make atonement|strong="H3722"\w* \w for him|strong="H5921"\w*, \w and he will be forgiven|strong="H5545"\w*.
\p \v 32 \w If, however|strong="H518"\w*, \w he brings|strong="H935"\w* \w a lamb|strong="H3532"\w* \w as a sin offering|strong="H2403"\w*, \w he must bring|strong="H935"\w* \w an unblemished|strong="H8549"\w* \w female|strong="H5347"\w*. \v 33 \w And he is to lay|strong="H5564"\w* \w his hand|strong="H3027"\w* \w on|strong="H5921"\w* \w the head|strong="H7218"\w* \w of the sin offering|strong="H2403"\w* \w and slaughter|strong="H7819"\w* \w it|strong="H853"\w* \w as a sin offering|strong="H2403"\w* \w at the place|strong="H4725"\w* \w where|strong="H834"\w* \w the burnt offering|strong="H5930"\w* \w is slaughtered|strong="H7819"\w*. \v 34 \w Then the priest|strong="H3548"\w* \w is to take|strong="H3947"\w* \w some of the blood|strong="H1818"\w* \w of the sin offering|strong="H2403"\w* \w with his finger|strong="H676"\w*, \w put it|strong="H5414"\w* \w on|strong="H5921"\w* \w the horns|strong="H7161"\w* \w of the altar|strong="H4196"\w* \w of burnt offering|strong="H5930"\w*, \w and|strong="H853"\w* \w pour out|strong="H8210"\w* \w the rest|strong="H3605"\w* \w of its blood|strong="H1818"\w* \w at|strong="H413"\w* \w the base|strong="H3247"\w* \w of the altar|strong="H4196"\w*. \v 35 \w And|strong="H853"\w* \w he shall remove|strong="H5493"\w* \w all|strong="H3605"\w* \w the fat|strong="H2459"\w*, \w just as|strong="H834"\w* \w the fat|strong="H2459"\w* \w of the lamb|strong="H3775"\w* \w is removed|strong="H5493"\w* \w from the peace offerings|strong="H8002"\w*, \w and he|strong="H3548"\w* \w shall burn|strong="H6999"\w* \w it on the altar|strong="H4196"\w* \w along with|strong="H5921"\w* \w the food offerings|strong="H801"\w* \w to the LORD|strong="H3068"\w*. \w In this way the priest|strong="H3548"\w* \w will make atonement|strong="H3722"\w* \w for him|strong="H5921"\w* \w for|strong="H5921"\w* \w the sin|strong="H2403"\w* \w he has committed|strong="H2398"\w*, \w and he will be forgiven|strong="H5545"\w*.[’’]
\c 5
\s1 Sins Requiring a Sin Offering
\r (\ref Leviticus 4:1–35|LEV 4:1-35\ref*; \ref Leviticus 6:24–30|LEV 6:24-30\ref*)
\p \v 1 “\w If|strong="H3588"\w* \w someone|strong="H5315"\w* \w sins|strong="H2398"\w* \w by failing|strong="H3808"\w* \w to testify|strong="H5046"\w* \w when he hears|strong="H8085"\w* \w a public|strong="H6963"\w* \w charge|strong="H423"\w* \w about something he|strong="H1931"\w* \w has witnessed|strong="H5707"\w*, \w whether|strong="H176"\w* \w he has seen it|strong="H7200"\w* \w or|strong="H176"\w* \w learned of it|strong="H3045"\w*, \w he shall bear|strong="H5375"\w* \w the iniquity|strong="H5771"\w*.
\p \v 2 \w Or|strong="H176"\w* \w if a person|strong="H5315"\w* \w touches|strong="H5060"\w* \w anything|strong="H3605"\w* \w unclean|strong="H2931"\w*— \w whether the carcass|strong="H5038"\w* \w of any unclean|strong="H2931"\w* \w wild animal|strong="H2416"\w* \w or|strong="H176"\w* \w livestock|strong="H929"\w* \w or|strong="H176"\w* \w crawling creature|strong="H8318"\w*— \w even if he is unaware|strong="H5956"\w* \w of it|strong="H4480"\w*, \w he|strong="H1931"\w* \w is unclean|strong="H2931"\w* \w and guilty|strong="H816"\w*.
\p \v 3 \w Or|strong="H176"\w* \w if|strong="H3588"\w* \w he touches|strong="H5060"\w* \w human|strong="H120"\w* \w uncleanness|strong="H2932"\w*— \w anything|strong="H3605"\w* \w by which|strong="H834"\w* \w one becomes unclean|strong="H2930"\w*— \w even if he is unaware|strong="H5956"\w* \w of it|strong="H4480"\w*, \w when he|strong="H1931"\w* \w realizes it|strong="H3045"\w*, \w he is guilty|strong="H816"\w*.
\p \v 4 \w Or|strong="H176"\w* \w if|strong="H3588"\w* \w someone|strong="H5315"\w* \w swears|strong="H7650"\w* \w thoughtlessly|strong="H981"\w* \w with his lips|strong="H8193"\w* \w to do anything good|strong="H3190"\w* \w or|strong="H176"\w* \w evil|strong="H7489"\w*— \w in|strong="H3605"\w* \w whatever matter|strong="H834"\w* \w a man|strong="H120"\w* \w may rashly pronounce|strong="H981"\w* \w an oath|strong="H7621"\w*— \w even if he is unaware|strong="H5956"\w* \w of it|strong="H4480"\w*, \w when he|strong="H1931"\w* \w realizes it|strong="H3045"\w*, \w he is guilty|strong="H816"\w* \w in the matter|strong="H428"\w*.
\p \v 5 \w If|strong="H3588"\w* \w someone incurs guilt|strong="H816"\w* \w in one|strong="H259"\w* \w of these ways|strong="H428"\w*, \w he must confess|strong="H3034"\w* \w the sin he has committed|strong="H2398"\w*, \v 6 \w and he must bring|strong="H935"\w* \w his guilt offering|strong="H817"\w* \w to the LORD|strong="H3068"\w* \w for|strong="H5921"\w* \w the sin|strong="H2403"\w* \w he has committed|strong="H2398"\w*: \w a female|strong="H5347"\w* \w lamb|strong="H3776"\w* \w or|strong="H176"\w* \w goat|strong="H8166"\w* \w from|strong="H4480"\w* \w the flock|strong="H6629"\w* \w as a sin offering|strong="H2403"\w*. \w And the priest|strong="H3548"\w* \w will make atonement|strong="H3722"\w* \w for him|strong="H5921"\w* \w concerning his sin|strong="H2403"\w*.
\p \v 7 \w If, however|strong="H518"\w*, \w he cannot|strong="H3808"\w* \w afford|strong="H5060"\w* \w a lamb|strong="H7716"\w*, \w he may bring|strong="H935"\w* \w to the LORD|strong="H3068"\w* \w as restitution|strong="H817"\w* \w for his sin|strong="H2398"\w* \w two|strong="H8147"\w* \w turtledoves|strong="H8449"\w* \w or|strong="H176"\w* \w two|strong="H8147"\w* \w young|strong="H1121"\w* \w pigeons|strong="H3123"\w* — \w one|strong="H259"\w* \w as a sin offering|strong="H2403"\w* \w and the other|strong="H259"\w* \w as a burnt offering|strong="H5930"\w*. \v 8 \w He is to bring|strong="H935"\w* \w them|strong="H853"\w* \w to|strong="H413"\w* \w the priest|strong="H3548"\w*, \w who shall first|strong="H7223"\w* \w present|strong="H7126"\w* \w the one|strong="H834"\w* \w for the sin offering|strong="H2403"\w*. \w He is to twist|strong="H4454"\w* \w its head|strong="H7218"\w* \w at the front|strong="H4136"\w* \w of its neck|strong="H6203"\w* \w without|strong="H3808"\w* \w severing it|strong="H914"\w*; \v 9 \w then he is to sprinkle|strong="H5137"\w* \w some of the blood|strong="H1818"\w* \w of the sin offering|strong="H2403"\w* \w on|strong="H5921"\w* \w the side|strong="H7023"\w* \w of the altar|strong="H4196"\w*, \w while the rest|strong="H7604"\w* \w of the blood|strong="H1818"\w* \w is drained out|strong="H4680"\w* \w at|strong="H413"\w* \w the base|strong="H3247"\w* \w of the altar|strong="H4196"\w*. \w It is|strong="H1931"\w* \w a sin offering|strong="H2403"\w*. \v 10 \w And|strong="H853"\w* \w the priest must prepare|strong="H6213"\w* \w the second bird|strong="H8145"\w* \w as a burnt offering|strong="H5930"\w* \w according to the ordinance|strong="H4941"\w*. \w In this way the priest|strong="H3548"\w* \w will make atonement|strong="H3722"\w* \w for him|strong="H5921"\w* \w for the sin|strong="H2403"\w* \w he has committed|strong="H2398"\w*, \w and he will be forgiven|strong="H5545"\w*.
\p \v 11 \w But if|strong="H518"\w* \w he cannot|strong="H3808"\w* \w afford|strong="H5381"\w* \w two|strong="H8147"\w* \w turtledoves|strong="H8449"\w* \w or|strong="H176"\w* \w two|strong="H8147"\w* \w young|strong="H1121"\w* \w pigeons|strong="H3123"\w*, \w he may bring|strong="H935"\w* \w a tenth|strong="H6224"\w* \w of an ephah|strong="H374"\w* \w of fine flour|strong="H5560"\w*\f + \fr 5:11 \fqa A tenth of an ephah \ft is approximately 2 dry quarts or 2.2 liters (probably about 2.6 pounds or 1.2 kilograms of flour).\f* \w as a sin offering|strong="H2403"\w*. \w He must not|strong="H3808"\w* \w put|strong="H7760"\w* \w olive oil|strong="H8081"\w* \w or frankincense|strong="H3828"\w* \w on it|strong="H5921"\w*, \w because|strong="H3588"\w* \w it|strong="H1931"\w* \w is a sin offering|strong="H2403"\w*. \v 12 \w He is to bring|strong="H935"\w* \w it to|strong="H413"\w* \w the priest|strong="H3548"\w*, \w who shall take|strong="H7061"\w* \w a handful|strong="H4393"\w* \w from it|strong="H4480"\w* \w as a memorial portion|strong="H234"\w* \w and burn it|strong="H6999"\w* \w on the altar|strong="H4196"\w* \w atop|strong="H5921"\w* \w the food offerings|strong="H801"\w* \w to the LORD|strong="H3068"\w*; \w it|strong="H1931"\w* \w is a sin offering|strong="H2403"\w*. \v 13 \w In this way the priest|strong="H3548"\w* \w will make atonement|strong="H3722"\w* \w for him|strong="H5921"\w* \w for|strong="H5921"\w* \w any|strong="H259"\w* \w of these|strong="H428"\w* \w sins|strong="H2403"\w* \w he has committed|strong="H2398"\w*, \w and he will be forgiven|strong="H5545"\w*. \w The remainder will belong to|strong="H1961"\w* \w the priest|strong="H3548"\w*, \w like the grain offering|strong="H4503"\w*.”
\s1 Laws for Guilt Offerings
\r (\ref Leviticus 6:1–7|LEV 6:1-7\ref*; \ref Leviticus 7:1–10|LEV 7:1-10\ref*)
\p \v 14 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 15 “\w If|strong="H3588"\w* \w someone|strong="H5315"\w* \w acts|strong="H4603"\w* \w unfaithfully|strong="H4604"\w* \w and sins|strong="H2398"\w* \w unintentionally against|strong="H7684"\w* \w any of the LORD’s|strong="H3068"\w* \w holy things|strong="H6944"\w*, \w he must bring|strong="H935"\w* \w his guilt offering|strong="H817"\w* \w to the LORD|strong="H3068"\w*: \w an unblemished|strong="H8549"\w* \w ram|strong="H352"\w* \w from|strong="H4480"\w* \w the flock|strong="H6629"\w*, \w of proper value|strong="H6187"\w*\f + \fr 5:15 \ft Or \fqa flock or its equivalence\f* \w in silver|strong="H3701"\w* \w shekels|strong="H8255"\w* \w according to the sanctuary|strong="H6944"\w* \w shekel|strong="H8255"\w*;\f + \fr 5:15 \fqa A shekel \ft is approximately 0.4 ounces or 11.4 grams of silver.\f* \w it is a guilt offering|strong="H817"\w*. \v 16 \w Regarding any holy thing|strong="H6944"\w* \w he has harmed|strong="H2398"\w*, \w he must make restitution|strong="H7999"\w* \w by adding|strong="H3254"\w* \w a fifth|strong="H2549"\w* \w of its value to it|strong="H5921"\w* \w and giving|strong="H5414"\w* \w it to the priest|strong="H3548"\w*, \w who|strong="H3548"\w* \w will make atonement|strong="H3722"\w* \w on his behalf|strong="H5921"\w* \w with the ram|strong="H352"\w* \w as a guilt offering|strong="H817"\w*, \w and he will be forgiven|strong="H5545"\w*.
\p \v 17 \w If|strong="H518"\w* \w someone|strong="H5315"\w* \w sins|strong="H2398"\w* \w and violates|strong="H6213"\w* \w any|strong="H259"\w* \w of the LORD’s|strong="H3068"\w* \w commandments|strong="H4687"\w* \w even though he was|strong="H3808"\w* \w unaware|strong="H3045"\w*, \w he is guilty|strong="H816"\w* \w and shall bear|strong="H5375"\w* \w his punishment|strong="H5771"\w*. \v 18 \w He is to bring|strong="H935"\w* \w to|strong="H413"\w* \w the priest|strong="H3548"\w* \w an unblemished|strong="H8549"\w* \w ram|strong="H352"\w* \w of proper value|strong="H6187"\w* \w from|strong="H4480"\w* \w the flock|strong="H6629"\w* \w as a guilt offering|strong="H817"\w*. \w Then the priest|strong="H3548"\w* \w will make atonement|strong="H3722"\w* \w on his behalf|strong="H5921"\w* \w for|strong="H5921"\w* \w the wrong|strong="H7684"\w* \w he has committed|strong="H7683"\w* \w in ignorance|strong="H3808"\w*, \w and he will be forgiven|strong="H5545"\w*. \v 19 \w It|strong="H1931"\w* \w is a guilt offering|strong="H817"\w*; \w he was certainly guilty|strong="H816"\w*\f + \fr 5:19 \ft Or \fqa he has paid full compensation\f* \w before the LORD|strong="H3068"\w*.”
\c 6
\s1 Sins Requiring a Guilt Offering
\r (\ref Leviticus 5:14–19|LEV 5:14-19\ref*; \ref Leviticus 7:1–10|LEV 7:1-10\ref*)
\p \v 1 \w And the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 2 “\w If|strong="H3588"\w* \w someone|strong="H5315"\w* \w sins|strong="H2398"\w* \w and acts|strong="H4603"\w* \w unfaithfully|strong="H4604"\w* \w against the LORD|strong="H3068"\w* \w by deceiving|strong="H3584"\w* \w his neighbor|strong="H5997"\w* \w in regard to a deposit|strong="H6487"\w* \w or security|strong="H8667"\w* \w entrusted to him|strong="H3027"\w* \w or|strong="H176"\w* \w stolen|strong="H1498"\w*, \w or|strong="H176"\w* \w if he extorts|strong="H6231"\w* \w his neighbor|strong="H5997"\w* \v 3 \w or|strong="H176"\w* \w finds|strong="H4672"\w* \w lost property|strong="H9"\w* \w and lies|strong="H3584"\w* about it \w and swears|strong="H7650"\w* \w falsely|strong="H8267"\w*, \w or if he commits any such sin|strong="H2398"\w* \w that|strong="H834"\w* \w a man|strong="H120"\w* \w might commit|strong="H6213"\w*— \v 4 \w once|strong="H3588"\w* \w he has sinned|strong="H2398"\w* \w and becomes guilty|strong="H816"\w*, \w he must return|strong="H7725"\w* \w what|strong="H834"\w* \w he has stolen|strong="H1500"\w* \w or|strong="H176"\w* \w taken by extortion|strong="H6231"\w*, \w or|strong="H176"\w* \w the deposit|strong="H6487"\w* \w entrusted|strong="H6485"\w* \w to him|strong="H854"\w*, \w or|strong="H176"\w* \w the lost property|strong="H9"\w* \w he found|strong="H4672"\w*, \v 5 \w or|strong="H176"\w* \w anything else|strong="H3605"\w* \w about|strong="H5921"\w* \w which|strong="H834"\w* \w he has sworn|strong="H7650"\w* \w falsely|strong="H8267"\w*.
\p \w He must make|strong="H7218"\w* \w restitution in full|strong="H7999"\w*, \w add|strong="H3254"\w* \w a fifth|strong="H2549"\w* \w of the value|strong="H5921"\w*, \w and pay it|strong="H5414"\w* \w to the owner|strong="H834"\w* \w on the day|strong="H3117"\w* \w he acknowledges his guilt|strong="H819"\w*. \v 6 \w Then he must bring|strong="H935"\w* \w to|strong="H413"\w* \w the priest|strong="H3548"\w* \w his guilt offering|strong="H817"\w* \w to the LORD|strong="H3068"\w*: \w an unblemished|strong="H8549"\w* \w ram|strong="H352"\w* \w of proper value|strong="H6187"\w* \w from|strong="H4480"\w* \w the flock|strong="H6629"\w*. \v 7 \w In this way the priest|strong="H3548"\w* \w will make atonement|strong="H3722"\w* \w for him|strong="H5921"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*, \w and he will be forgiven|strong="H5545"\w* \w for|strong="H5921"\w* \w anything|strong="H259"\w* \w he may have done|strong="H6213"\w* \w to incur guilt|strong="H819"\w*.”
\s1 The Burnt Offering
\r (\ref Leviticus 1:1–17|LEV 1:1-17\ref*)
\p \v 8 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 9 “\w Command|strong="H6680"\w* \w Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w* \w that this|strong="H2063"\w* \w is the law|strong="H8451"\w* \w of the burnt offering|strong="H5930"\w*: \w The burnt offering|strong="H5930"\w* \w is to remain|strong="H5921"\w* \w on|strong="H5921"\w* \w the hearth|strong="H4169"\w* \w of the altar|strong="H4196"\w* \w all|strong="H3605"\w* \w night|strong="H3915"\w*, \w until|strong="H5704"\w* \w morning|strong="H1242"\w*, \w and the fire|strong="H784"\w* \w must be kept burning|strong="H3344"\w* \w on the altar|strong="H4196"\w*.
\p \v 10 \w And the priest|strong="H3548"\w* \w shall put on|strong="H3847"\w* \w his linen|strong="H906"\w* \w robe|strong="H4055"\w* \w and linen|strong="H906"\w* \w undergarments|strong="H4370"\w*, \w and he shall remove|strong="H7311"\w* \w from the altar|strong="H4196"\w* \w the ashes|strong="H1880"\w* \w of the burnt offering|strong="H5930"\w* \w that the fire|strong="H784"\w* \w has consumed|strong="H398"\w* \w and place them|strong="H7760"\w* \w beside|strong="H681"\w* \w it|strong="H4196"\w*. \v 11 \w Then he must take off|strong="H6584"\w* \w his garments|strong="H899"\w*, \w put on|strong="H3847"\w* \w other|strong="H312"\w* \w clothes|strong="H899"\w*, \w and carry|strong="H3318"\w* \w the ashes|strong="H1880"\w* \w outside|strong="H2351"\w* \w the camp|strong="H4264"\w* \w to|strong="H413"\w* \w a ceremonially clean|strong="H2889"\w* \w place|strong="H4725"\w*.
\p \v 12 \w The fire|strong="H784"\w* \w on|strong="H5921"\w* \w the altar|strong="H4196"\w* \w shall be kept burning|strong="H3344"\w*; \w it must not|strong="H3808"\w* \w be extinguished|strong="H3518"\w*. \w Every morning|strong="H1242"\w* \w the priest|strong="H3548"\w* \w is to add|strong="H1197"\w* \w wood|strong="H6086"\w* \w to the fire|strong="H5921"\w*, \w arrange|strong="H6186"\w* \w the burnt offering|strong="H5930"\w* \w on it|strong="H5921"\w*, \w and burn|strong="H6999"\w* \w the fat portions|strong="H2459"\w* \w of the peace offerings|strong="H8002"\w* \w on it|strong="H5921"\w*. \v 13 \w The fire|strong="H784"\w* \w shall be kept burning|strong="H3344"\w* \w on|strong="H5921"\w* \w the altar|strong="H4196"\w* \w continually|strong="H8548"\w*; \w it must not|strong="H3808"\w* \w be extinguished|strong="H3518"\w*.
\s1 The Grain Offering
\r (\ref Leviticus 2:1–16|LEV 2:1-16\ref*)
\p \v 14 \w Now this|strong="H2063"\w* \w is the law|strong="H8451"\w* \w of the grain offering|strong="H4503"\w*: \w Aaron’s|strong="H175"\w* \w sons|strong="H1121"\w* \w shall present|strong="H7126"\w* \w it|strong="H853"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w in|strong="H413"\w* \w front|strong="H6440"\w* \w of the altar|strong="H4196"\w*. \v 15 \w The priest is to remove|strong="H7311"\w* \w a handful|strong="H7062"\w* \w of|strong="H4480"\w* \w fine flour|strong="H5560"\w* \w and olive oil|strong="H8081"\w*, \w together with all|strong="H3605"\w* \w the frankincense|strong="H3828"\w* \w from the grain offering|strong="H4503"\w*, \w and burn|strong="H6999"\w* \w the memorial portion|strong="H234"\w* \w on the altar|strong="H4196"\w* \w as a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w* \w to the LORD|strong="H3068"\w*.
\p \v 16 \w Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w* \w are to eat|strong="H398"\w* \w the remainder|strong="H3498"\w*. \w It must be eaten|strong="H398"\w* \w without leaven|strong="H4682"\w* \w in a holy|strong="H6918"\w* \w place|strong="H4725"\w*; \w they are to eat it|strong="H398"\w* \w in the courtyard|strong="H2691"\w* \w of the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \v 17 \w It must not|strong="H3808"\w* \w be baked|strong="H644"\w* \w with leaven|strong="H2557"\w*; \w I have assigned|strong="H5414"\w* \w it as their portion|strong="H2506"\w* \w of My food offerings|strong="H801"\w*. \w It is|strong="H1931"\w* \w most|strong="H6944"\w* \w holy|strong="H6944"\w*, \w like the sin offering|strong="H2403"\w* \w and the guilt offering|strong="H817"\w*. \v 18 \w Any|strong="H3605"\w* \w male|strong="H2145"\w* \w among the sons|strong="H1121"\w* \w of Aaron|strong="H175"\w* \w may eat it|strong="H398"\w*. \w This is a permanent|strong="H5769"\w* \w portion|strong="H2706"\w* \w from the food offerings|strong="H801"\w* \w to the LORD|strong="H3068"\w* \w for the generations to come|strong="H1755"\w*. \w Anything|strong="H3605"\w* \w that|strong="H834"\w* \w touches|strong="H5060"\w* them \w will become holy|strong="H6942"\w*.”
\p \v 19 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 20 “\w This|strong="H2088"\w* \w is the offering|strong="H7133"\w* \w that Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w* \w must present|strong="H7126"\w* \w to the LORD|strong="H3068"\w* \w on the day|strong="H3117"\w* \w he is anointed|strong="H4886"\w*: \w a tenth|strong="H6224"\w* \w of an ephah|strong="H374"\w* \w of fine flour|strong="H5560"\w*\f + \fr 6:20 \fqa A tenth of an ephah \ft is approximately 2 dry quarts or 2.2 liters (probably about 2.6 pounds or 1.2 kilograms of flour).\f* \w as a regular|strong="H8548"\w* \w grain offering|strong="H4503"\w*, \w half|strong="H4276"\w* \w of it in the morning|strong="H1242"\w* \w and half|strong="H4276"\w* \w in the evening|strong="H6153"\w*. \v 21 \w It shall be prepared|strong="H6213"\w* \w with oil|strong="H8081"\w* \w on|strong="H5921"\w* \w a griddle|strong="H4227"\w*;\f + \fr 6:21 \ft That is, a shallow pan for baking or frying\f* \w you are to bring it|strong="H935"\w* \w well-kneaded|strong="H7246"\w* \w and present it|strong="H7126"\w* \w as a grain offering|strong="H4503"\w* \w broken|strong="H8601"\w*\f + \fr 6:21 \ft Or \fqa baked\f* \w in pieces|strong="H6595"\w*, \w a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w* \w to the LORD|strong="H3068"\w*. \v 22 \w The priest|strong="H3548"\w*, \w who is one of Aaron’s sons|strong="H1121"\w* \w and will be anointed|strong="H4899"\w* \w to take his place|strong="H8478"\w*, \w is to prepare it|strong="H6213"\w*. \w As a permanent|strong="H5769"\w* \w portion|strong="H2706"\w* \w for the LORD|strong="H3068"\w*, \w it must be burned|strong="H6999"\w* \w completely|strong="H3632"\w*. \v 23 \w Every|strong="H3605"\w* \w grain offering|strong="H4503"\w* \w for a priest|strong="H3548"\w* \w shall be burned|strong="H1961"\w* \w completely|strong="H3632"\w*; \w it is not|strong="H3808"\w* \w to be eaten|strong="H398"\w*.”
\s1 The Sin Offering
\r (\ref Leviticus 4:1–35|LEV 4:1-35\ref*; \ref Leviticus 5:1–13|LEV 5:1-13\ref*)
\p \v 24 \w And the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 25 “\w Tell|strong="H1696"\w* \w Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w* \w that this|strong="H2063"\w* \w is the law|strong="H8451"\w* \w of the sin offering|strong="H2403"\w*: \w In the place|strong="H4725"\w* \w where|strong="H834"\w* \w the burnt offering|strong="H5930"\w* \w is slaughtered|strong="H7819"\w*, \w the sin offering|strong="H2403"\w* \w shall be slaughtered|strong="H7819"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*; \w it is most|strong="H6944"\w* \w holy|strong="H6944"\w*. \v 26 \w The priest|strong="H3548"\w* \w who offers|strong="H2398"\w* \w it|strong="H853"\w* \w shall eat it|strong="H398"\w*; \w it must be eaten|strong="H398"\w* \w in a holy|strong="H6918"\w* \w place|strong="H4725"\w*, \w in the courtyard|strong="H2691"\w* \w of the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \v 27 \w Anything|strong="H3605"\w* \w that|strong="H834"\w* \w touches|strong="H5060"\w* \w its flesh|strong="H1320"\w* \w will become holy|strong="H6942"\w*, \w and if|strong="H834"\w* \w any of the blood|strong="H1818"\w* \w is spattered|strong="H5137"\w* \w on|strong="H5921"\w* \w a garment|strong="H899"\w*, \w you must wash|strong="H3526"\w* \w it|strong="H834"\w* \w in a holy|strong="H6918"\w* \w place|strong="H4725"\w*.
\p \v 28 \w The clay|strong="H2789"\w* \w pot|strong="H3627"\w* \w in which|strong="H834"\w* \w the sin offering is boiled|strong="H1310"\w* \w must be broken|strong="H7665"\w*; \w if|strong="H518"\w* \w it is boiled|strong="H1310"\w* \w in a bronze|strong="H5178"\w* \w pot|strong="H3627"\w*, \w the pot must be scoured|strong="H4838"\w* \w and rinsed|strong="H7857"\w* \w with water|strong="H4325"\w*. \v 29 \w Any|strong="H3605"\w* \w male|strong="H2145"\w* \w among the priests|strong="H3548"\w* \w may eat it|strong="H398"\w*; \w it is|strong="H1931"\w* \w most|strong="H6944"\w* \w holy|strong="H6944"\w*. \v 30 \w But no|strong="H3808"\w* \w sin offering|strong="H2403"\w* \w may be eaten|strong="H398"\w* \w if its blood|strong="H1818"\w* \w has been brought|strong="H935"\w* \w into|strong="H413"\w* \w the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w* \w to make atonement|strong="H3722"\w* \w in the Holy Place|strong="H6944"\w*; \w it must be burned|strong="H8313"\w*.[’’]
\c 7
\s1 The Guilt Offering
\r (\ref Leviticus 5:14–19|LEV 5:14-19\ref*; \ref Leviticus 6:1–7|LEV 6:1-7\ref*)
\p \v 1 “\w Now this|strong="H2063"\w* \w is the law|strong="H8451"\w* \w of the guilt offering|strong="H817"\w*, \w which is|strong="H1931"\w* \w most|strong="H6944"\w* \w holy|strong="H6944"\w*: \v 2 \w The guilt offering|strong="H817"\w* \w must be slaughtered|strong="H7819"\w* \w in the place|strong="H4725"\w* \w where|strong="H834"\w* \w the burnt offering|strong="H5930"\w* \w is slaughtered|strong="H7819"\w*, \w and the priest shall splatter|strong="H2236"\w* \w its blood|strong="H1818"\w* \w on all sides|strong="H5439"\w* \w of|strong="H5921"\w* \w the altar|strong="H4196"\w*. \v 3 \w And|strong="H853"\w* \w all|strong="H3605"\w* \w the fat|strong="H2459"\w* \w from|strong="H4480"\w* \w it|strong="H853"\w* \w shall be offered|strong="H7126"\w*: \w the fat tail|strong="H451"\w*, \w the fat|strong="H2459"\w* \w that covers|strong="H3680"\w* \w the entrails|strong="H7130"\w*, \v 4 \w both|strong="H8147"\w* \w kidneys|strong="H3629"\w* \w with the fat|strong="H2459"\w* \w on them|strong="H5921"\w* \w near|strong="H5921"\w* \w the loins|strong="H3689"\w*, \w and the lobe|strong="H3508"\w* \w of|strong="H5921"\w* \w the liver|strong="H3516"\w*, \w which is to be removed|strong="H5493"\w* \w with|strong="H5921"\w* \w the kidneys|strong="H3629"\w*. \v 5 \w The priest|strong="H3548"\w* \w shall burn|strong="H6999"\w* \w them|strong="H853"\w* \w on the altar|strong="H4196"\w* \w as a food offering|strong="H801"\w* \w to the LORD|strong="H3068"\w*; \w it|strong="H1931"\w* \w is a guilt offering|strong="H817"\w*. \v 6 \w Every|strong="H3605"\w* \w male|strong="H2145"\w* \w among the priests|strong="H3548"\w* \w may eat of it|strong="H398"\w*. \w It must be eaten|strong="H398"\w* \w in a holy|strong="H6918"\w* \w place|strong="H4725"\w*; \w it is|strong="H1931"\w* \w most|strong="H6944"\w* \w holy|strong="H6944"\w*.
\p \v 7 \w The guilt offering|strong="H817"\w* \w is like the sin offering|strong="H2403"\w*; \w the same|strong="H259"\w* \w law|strong="H8451"\w* applies to both. \w It belongs to|strong="H1961"\w* \w the priest|strong="H3548"\w* \w who|strong="H834"\w* \w makes atonement|strong="H3722"\w* with it. \v 8 \w As for the priest|strong="H3548"\w* \w who presents|strong="H7126"\w* \w a burnt offering|strong="H5930"\w* \w for anyone|strong="H376"\w*, \w the hide|strong="H5785"\w* \w of that offering|strong="H5930"\w* belongs to him. \v 9 \w Likewise , every|strong="H3605"\w* \w grain offering|strong="H4503"\w* \w that|strong="H834"\w* \w is baked|strong="H644"\w* \w in an oven|strong="H8574"\w* \w or cooked|strong="H6213"\w* \w in a pan|strong="H4802"\w*\f + \fr 7:9 \ft That is, a deep pan or stew pan\f* \w or on|strong="H5921"\w* \w a griddle|strong="H4227"\w*\f + \fr 7:9 \ft That is, a shallow pan for baking or frying\f* \w belongs|strong="H1961"\w* to \w the priest|strong="H3548"\w* \w who presents|strong="H7126"\w* \w it|strong="H853"\w*, \v 10 \w and every|strong="H3605"\w* \w grain offering|strong="H4503"\w*, \w whether dry|strong="H2720"\w* \w or mixed|strong="H1101"\w* \w with oil|strong="H8081"\w*, \w belongs equally|strong="H376"\w* \w to|strong="H1961"\w* \w all|strong="H3605"\w* \w the sons|strong="H1121"\w* \w of Aaron|strong="H175"\w*.
\s1 The Peace Offering
\r (\ref Leviticus 3:1–17|LEV 3:1-17\ref*)
\p \v 11 \w Now this|strong="H2063"\w* \w is the law|strong="H8451"\w* \w of the peace offering|strong="H8002"\w* \w that|strong="H834"\w* \w one may present|strong="H7126"\w* \w to the LORD|strong="H3068"\w*: \v 12 \w If|strong="H518"\w* \w he offers it|strong="H7126"\w* \w in|strong="H5921"\w* \w thanksgiving|strong="H8426"\w*, \w then along with|strong="H5921"\w* \w the sacrifice|strong="H2077"\w* \w of thanksgiving|strong="H8426"\w* \w he shall offer|strong="H7126"\w* \w unleavened|strong="H4682"\w* \w cakes|strong="H2471"\w* \w mixed|strong="H1101"\w* \w with olive oil|strong="H8081"\w*, \w unleavened|strong="H4682"\w* \w wafers|strong="H7550"\w* \w coated|strong="H4886"\w* \w with oil|strong="H8081"\w*, \w and well-kneaded|strong="H7246"\w* \w cakes|strong="H2471"\w* \w of fine flour|strong="H5560"\w* \w mixed|strong="H1101"\w* \w with oil|strong="H8081"\w*.
\p \v 13 \w Along|strong="H5921"\w* \w with|strong="H5921"\w* \w his peace offering|strong="H8002"\w* \w of thanksgiving|strong="H8426"\w* \w he is to present|strong="H7126"\w* \w an offering|strong="H7133"\w* \w with cakes|strong="H2471"\w* \w of leavened|strong="H2557"\w* \w bread|strong="H3899"\w*. \v 14 \w From|strong="H4480"\w* \w the cakes he must present|strong="H7126"\w* \w one|strong="H259"\w* \w portion of each|strong="H3605"\w* \w offering|strong="H7133"\w* \w as a contribution|strong="H8641"\w* \w to the LORD|strong="H3068"\w*. \w It belongs|strong="H1961"\w* to \w the priest|strong="H3548"\w* \w who sprinkles|strong="H2236"\w* \w the blood|strong="H1818"\w* \w of the peace offering|strong="H8002"\w*. \v 15 \w The meat|strong="H1320"\w* \w of the sacrifice|strong="H2077"\w* \w of his peace offering|strong="H8002"\w* \w of thanksgiving|strong="H8426"\w* \w must be eaten|strong="H398"\w* \w on the day|strong="H3117"\w* \w he offers it|strong="H7133"\w*; \w none|strong="H3808"\w* \w of it|strong="H4480"\w* \w may be left|strong="H5117"\w* \w until|strong="H5704"\w* \w morning|strong="H1242"\w*.
\p \v 16 \w If, however|strong="H518"\w*, \w the sacrifice|strong="H2077"\w* \w he offers|strong="H7133"\w* \w is a vow|strong="H5088"\w* \w or|strong="H176"\w* \w a freewill offering|strong="H5071"\w*, \w it shall be eaten|strong="H398"\w* \w on the day|strong="H3117"\w* \w he presents|strong="H7126"\w* \w his sacrifice|strong="H2077"\w*, \w but the remainder|strong="H3498"\w* \w may be eaten|strong="H398"\w* \w on|strong="H4480"\w* \w the next day|strong="H4283"\w*. \v 17 \w But any meat|strong="H1320"\w* \w of the sacrifice|strong="H2077"\w* \w remaining|strong="H3498"\w* \w until the third|strong="H7992"\w* \w day|strong="H3117"\w* \w must be burned up|strong="H8313"\w*. \v 18 \w If|strong="H518"\w* \w any of|strong="H398"\w* \w the meat|strong="H1320"\w* \w from his peace offering|strong="H8002"\w* \w is eaten|strong="H398"\w* \w on the third|strong="H7992"\w* \w day|strong="H3117"\w*, \w it will not|strong="H3808"\w* \w be accepted|strong="H7521"\w*. \w It will not|strong="H3808"\w* \w be credited|strong="H2803"\w* to \w the one who presented it|strong="H7126"\w*; \w it shall be|strong="H1961"\w* \w an abomination|strong="H6292"\w*, \w and the one|strong="H5315"\w* \w who eats|strong="H398"\w* \w of it|strong="H4480"\w* \w shall bear|strong="H5375"\w* \w his iniquity|strong="H5771"\w*.
\p \v 19 \w Meat|strong="H1320"\w* \w that|strong="H834"\w* \w touches|strong="H5060"\w* \w anything|strong="H3605"\w* \w unclean|strong="H2931"\w* \w must not|strong="H3808"\w* \w be eaten|strong="H398"\w*; \w it is to be burned up|strong="H8313"\w*. \w As for|strong="H1320"\w* \w any other meat|strong="H1320"\w*, \w anyone|strong="H3605"\w* \w who is ceremonially clean|strong="H2889"\w* \w may eat it|strong="H398"\w*. \v 20 \w But if anyone|strong="H5315"\w* \w who|strong="H834"\w* \w is unclean|strong="H2932"\w* \w eats|strong="H398"\w* \w meat|strong="H1320"\w* \w from the peace offering|strong="H8002"\w* \w that|strong="H834"\w* \w belongs to the LORD|strong="H3068"\w*, \w that|strong="H1931"\w* \w person|strong="H5315"\w* \w must be cut off|strong="H3772"\w* \w from his people|strong="H5971"\w*. \v 21 \w If|strong="H3588"\w* \w one|strong="H5315"\w* \w touches|strong="H5060"\w* \w anything|strong="H3605"\w* \w unclean|strong="H2931"\w*, \w whether|strong="H176"\w* \w human|strong="H120"\w* \w uncleanness|strong="H2932"\w*, \w an unclean|strong="H2931"\w* \w animal|strong="H929"\w*, \w or|strong="H176"\w* \w any|strong="H3605"\w* \w unclean|strong="H2931"\w*, \w detestable thing|strong="H8263"\w*, \w and then eats|strong="H398"\w* \w any of the meat|strong="H1320"\w* \w of the peace offering|strong="H8002"\w* \w that|strong="H834"\w* \w belongs to the LORD|strong="H3068"\w*, \w that|strong="H1931"\w* \w person|strong="H5315"\w* \w must be cut off|strong="H3772"\w* \w from his people|strong="H5971"\w*.”
\s1 Fat and Blood Forbidden
\p \v 22 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 23 “\w Speak|strong="H1696"\w* \w to|strong="H413"\w* \w the Israelites|strong="H1121"\w* \w and say|strong="H559"\w*, ‘\w You are not|strong="H3808"\w* \w to eat|strong="H398"\w* \w any|strong="H3605"\w* \w of the fat|strong="H2459"\w* \w of an ox|strong="H7794"\w*, \w a sheep|strong="H3775"\w*, \w or a goat|strong="H5795"\w*. \v 24 \w The fat|strong="H2459"\w* \w of an animal found dead|strong="H5038"\w* \w or mauled by wild beasts|strong="H2966"\w* \w may be used|strong="H6213"\w* \w for any other|strong="H3605"\w* \w purpose|strong="H4399"\w*, \w but you must not|strong="H3808"\w* \w eat|strong="H398"\w* \w it|strong="H398"\w*.
\p \v 25 \w If|strong="H3588"\w* \w anyone|strong="H3605"\w* \w eats|strong="H398"\w* \w the fat|strong="H2459"\w* \w of an animal|strong="H929"\w* \w from which|strong="H4480"\w* \w a food offering|strong="H801"\w* \w may be presented|strong="H7126"\w* \w to the LORD|strong="H3068"\w*, \w the one|strong="H5315"\w* \w who eats it|strong="H398"\w* \w must be cut off|strong="H3772"\w* \w from his people|strong="H5971"\w*. \v 26 \w You must not|strong="H3808"\w* \w eat|strong="H398"\w* \w the blood|strong="H1818"\w* \w of any bird|strong="H5775"\w* \w or animal|strong="H929"\w* \w in any|strong="H3605"\w* \w of your dwellings|strong="H4186"\w*. \v 27 \w If anyone|strong="H3605"\w* \w eats|strong="H398"\w* \w blood|strong="H1818"\w*, \w that|strong="H1931"\w* \w person|strong="H5315"\w* \w must be cut off|strong="H3772"\w* \w from his people|strong="H5971"\w*.’”
\s1 The Priests’ Portion
\p \v 28 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 29 “\w Speak|strong="H1696"\w* \w to|strong="H413"\w* \w the Israelites|strong="H1121"\w* \w and say|strong="H559"\w*, ‘\w Anyone who presents|strong="H7126"\w* \w a peace offering|strong="H8002"\w* \w to the LORD|strong="H3068"\w* \w must bring|strong="H935"\w* \w it|strong="H7133"\w* \w as his sacrifice|strong="H2077"\w* \w to the LORD|strong="H3068"\w*. \v 30 \w With his own hands|strong="H3027"\w* \w he is to bring|strong="H935"\w* \w the food offerings|strong="H801"\w* \w to the LORD|strong="H3068"\w*; \w he shall bring|strong="H935"\w* \w the fat|strong="H2459"\w*, \w together with|strong="H5921"\w* \w the breast|strong="H2373"\w*, \w and wave|strong="H5130"\w* \w the breast|strong="H2373"\w* \w as a wave offering|strong="H8573"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*.
\p \v 31 \w The priest|strong="H3548"\w* \w is to burn|strong="H6999"\w* \w the fat|strong="H2459"\w* \w on the altar|strong="H4196"\w*, \w but the breast|strong="H2373"\w* \w belongs to|strong="H1961"\w* \w Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w*. \v 32 \w And|strong="H853"\w* \w you are to give|strong="H5414"\w* \w the right|strong="H3225"\w* \w thigh|strong="H7785"\w* \w to the priest|strong="H3548"\w* \w as a contribution|strong="H8641"\w* \w from your peace offering|strong="H8002"\w*. \v 33 \w The son|strong="H1121"\w* \w of Aaron|strong="H175"\w* \w who presents|strong="H7126"\w* \w the blood|strong="H1818"\w* \w and|strong="H853"\w* \w fat|strong="H2459"\w* \w of the peace offering|strong="H8002"\w* \w shall have|strong="H1961"\w* \w the right|strong="H3225"\w* \w thigh|strong="H7785"\w* \w as a portion|strong="H4490"\w*.
\p \v 34 \w I have taken|strong="H3947"\w* \w from the sons|strong="H1121"\w* \w of Israel|strong="H3478"\w* \w the breast|strong="H2373"\w* \w of the wave offering|strong="H8573"\w* \w and the thigh|strong="H7785"\w* \w of the contribution|strong="H8641"\w* \w of their peace offerings|strong="H8002"\w*, \w and I have given|strong="H5414"\w* \w them|strong="H853"\w* \w to Aaron|strong="H175"\w* \w the priest|strong="H3548"\w* \w and his sons|strong="H1121"\w* \w as a permanent|strong="H5769"\w* \w portion|strong="H2706"\w* \w from the sons|strong="H1121"\w* \w of Israel|strong="H3478"\w*.’”
\p \v 35 \w This|strong="H2063"\w* \w is the portion|strong="H4888"\w* \w of the food offerings|strong="H801"\w* \w to the LORD|strong="H3068"\w* \w for Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w* \w since the day|strong="H3117"\w* \w they were presented|strong="H7126"\w* \w to serve the LORD|strong="H3068"\w* \w as priests|strong="H3547"\w*. \v 36 \w On the day|strong="H3117"\w* \w they were anointed|strong="H4886"\w*, \w the LORD|strong="H3068"\w* \w commanded that|strong="H6680"\w* \w this|strong="H834"\w* \w be given|strong="H5414"\w* \w them|strong="H853"\w* by \w the sons|strong="H1121"\w* \w of Israel|strong="H3478"\w*. \w It is a permanent|strong="H5769"\w* \w portion|strong="H2708"\w* \w for the generations to come|strong="H1755"\w*.
\p \v 37 \w This|strong="H2063"\w* \w is the law|strong="H8451"\w* \w of the burnt offering|strong="H5930"\w*, \w the grain offering|strong="H4503"\w*, \w the sin offering|strong="H2403"\w*, \w the guilt offering|strong="H817"\w*, \w the ordination offering|strong="H4394"\w*, \w and the peace offering|strong="H8002"\w*, \v 38 \w which|strong="H834"\w* \w the LORD|strong="H3068"\w* \w gave|strong="H6680"\w* \w Moses|strong="H4872"\w* \w on Mount|strong="H2022"\w* \w Sinai|strong="H5514"\w* \w on the day|strong="H3117"\w* \w He commanded|strong="H6680"\w* \w the Israelites|strong="H1121"\w* \w to present|strong="H7126"\w* \w their offerings|strong="H7133"\w* \w to the LORD|strong="H3068"\w* \w in the Wilderness|strong="H4057"\w* \w of Sinai|strong="H5514"\w*.
\c 8
\s1 Moses Consecrates Aaron and His Sons
\r (\ref Exodus 29:1–9|EXO 29:1-9\ref*)
\p \v 1 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 2 “\w Take|strong="H3947"\w* \w Aaron|strong="H175"\w* \w and|strong="H853"\w* \w his sons|strong="H1121"\w*, \w their garments|strong="H899"\w*, \w the anointing|strong="H4888"\w* \w oil|strong="H8081"\w*, \w the bull|strong="H6499"\w* \w of the sin offering|strong="H2403"\w*, \w the two|strong="H8147"\w* \w rams|strong="H352"\w*, \w and the basket|strong="H5536"\w* \w of unleavened bread|strong="H4682"\w*, \v 3 \w and assemble|strong="H6950"\w* \w the whole|strong="H3605"\w* \w congregation|strong="H5712"\w* \w at|strong="H413"\w* \w the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*.”
\p \v 4 \w So Moses|strong="H4872"\w* \w did|strong="H6213"\w* \w as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded him|strong="H6680"\w*, \w and the assembly|strong="H5712"\w* \w gathered|strong="H6950"\w* \w at|strong="H413"\w* \w the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \v 5 \w And Moses|strong="H4872"\w* \w said|strong="H559"\w* \w to them|strong="H413"\w*, “\w This|strong="H2088"\w* \w is what|strong="H834"\w* \w the LORD|strong="H3068"\w* \w has commanded|strong="H6680"\w* \w to be done|strong="H6213"\w*.”
\p \v 6 \w Then Moses|strong="H4872"\w* \w presented|strong="H7126"\w* \w Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w* \w and washed|strong="H7364"\w* \w them|strong="H853"\w* \w with water|strong="H4325"\w*. \v 7 \w He put|strong="H5414"\w* \w the tunic|strong="H3801"\w* \w on Aaron|strong="H5921"\w*, \w tied the sash|strong="H73"\w* \w around him|strong="H2296"\w*, \w clothed|strong="H3847"\w* \w him|strong="H853"\w* \w with the robe|strong="H4598"\w*, \w and put|strong="H5414"\w* \w the ephod|strong="H646"\w* \w on him|strong="H5921"\w*. \w He tied the woven band|strong="H2805"\w* \w of the ephod|strong="H646"\w* \w around|strong="H2296"\w* \w him|strong="H853"\w* \w and fastened it|strong="H640"\w* to him. \v 8 \w Then he put|strong="H7760"\w* \w the breastpiece|strong="H2833"\w* \w on|strong="H5921"\w* \w him|strong="H853"\w* \w and placed|strong="H5414"\w* \w the Urim|strong="H224"\w* \w and Thummim|strong="H8550"\w*\f + \fr 8:8 \ft Literally \fqa Lights and Perfections\f* \w in|strong="H413"\w* \w the breastpiece|strong="H2833"\w*. \v 9 \w Moses also put|strong="H7760"\w* \w the turban|strong="H4701"\w* \w on|strong="H5921"\w* \w Aaron’s head|strong="H7218"\w* \w and set|strong="H7760"\w* \w the gold|strong="H2091"\w* \w plate|strong="H6731"\w*, \w the holy|strong="H6944"\w* \w diadem|strong="H5145"\w*, \w on|strong="H413"\w* \w the front|strong="H4136"\w* \w of the turban|strong="H4701"\w*, \w as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w him|strong="H4872"\w*.
