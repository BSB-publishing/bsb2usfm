\p \v 13 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 14 “\w Take|strong="H3318"\w* \w the blasphemer|strong="H7043"\w*\f + \fr 24:14 \ft Literally \fqa the one who cursed\ft ; also in verse 23\f* \w outside|strong="H2351"\w* \w the camp|strong="H4264"\w*, \w and have all|strong="H3605"\w* \w who heard|strong="H8085"\w* \w him|strong="H853"\w* \w lay|strong="H5564"\w* \w their hands|strong="H3027"\w* \w on|strong="H5921"\w* \w his head|strong="H7218"\w*; \w then have the whole|strong="H3605"\w* \w assembly|strong="H5712"\w* \w stone|strong="H7275"\w* \w him|strong="H853"\w*.
\p \v 15 \w And you are to tell|strong="H1696"\w* \w the Israelites|strong="H1121"\w*, ‘\w If|strong="H3588"\w* \w anyone|strong="H376"\w* \w curses|strong="H7043"\w* \w his God|strong="H430"\w*, \w he shall bear the consequences|strong="H5375"\w* \w of his sin|strong="H2399"\w*. \v 16 \w Whoever blasphemes|strong="H5344"\w* \w the name|strong="H8034"\w* \w of the LORD|strong="H3068"\w* \w must surely be put to death|strong="H4191"\w*; \w the whole|strong="H3605"\w* \w assembly|strong="H5712"\w* \w must surely stone|strong="H7275"\w* him, \w whether he is a foreign resident|strong="H1616"\w* \w or native|strong="H249"\w*; \w if he blasphemes|strong="H5344"\w* \w the Name|strong="H8034"\w*, \w he must be put to death|strong="H4191"\w*.
\s1 An Eye for an Eye
\r (\ref Matthew 5:38–48|MAT 5:38-48\ref*)
\p \v 17 \w And if|strong="H3588"\w* \w a man|strong="H376"\w* \w takes the life|strong="H5221"\w* \w of anyone else|strong="H3605"\w*, \w he must surely be put to death|strong="H4191"\w*. \v 18 \w Whoever kills|strong="H5221"\w* \w an animal|strong="H929"\w* \w must make restitution|strong="H7999"\w* — \w life|strong="H5315"\w* \w for|strong="H8478"\w* \w life|strong="H5315"\w*. \v 19 \w If|strong="H3588"\w* \w anyone|strong="H376"\w* \w injures|strong="H5414"\w* \w his neighbor|strong="H5997"\w*, \w whatever|strong="H834"\w* \w he has done|strong="H6213"\w* \w must be done|strong="H6213"\w* to him: \v 20 \w fracture|strong="H7667"\w* \w for|strong="H8478"\w* \w fracture|strong="H7667"\w*, \w eye|strong="H5869"\w* \w for|strong="H8478"\w* \w eye|strong="H5869"\w*, \w tooth|strong="H8127"\w* \w for|strong="H8478"\w* \w tooth|strong="H8127"\w*.\f + \fr 24:20 \ft Cited in \ref Matthew 5:38|MAT 5:38\ref*\f* \w Just as|strong="H834"\w* \w he injured|strong="H5414"\w* \w the other person|strong="H120"\w*, \w the same|strong="H3651"\w* \w must be inflicted|strong="H5414"\w* on him.
\p \v 21 \w Whoever kills|strong="H5221"\w* \w an animal|strong="H929"\w* \w must make restitution|strong="H7999"\w*, \w but whoever kills|strong="H5221"\w* \w a man|strong="H120"\w* \w must be put to death|strong="H4191"\w*. \v 22 \w You are to have|strong="H1961"\w* \w the same|strong="H259"\w* \w standard of law|strong="H4941"\w* \w for the foreign resident|strong="H1616"\w* \w and the native|strong="H249"\w*; \w for|strong="H3588"\w* \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w* \w your God|strong="H430"\w*.’”
