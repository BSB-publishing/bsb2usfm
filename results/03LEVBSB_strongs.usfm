\p \v 13 \w In this|strong="H2063"\w* \w Year|strong="H8141"\w* \w of Jubilee|strong="H3104"\w*, \w each|strong="H376"\w* \w of you shall return|strong="H7725"\w* \w to|strong="H413"\w* \w his own property|strong="H272"\w*.
\p \v 14 \w If|strong="H3588"\w* \w you make a sale|strong="H4376"\w* \w to your neighbor|strong="H5997"\w* \w or|strong="H176"\w* \w a purchase|strong="H7069"\w* \w from|strong="H3027"\w* \w him|strong="H5997"\w*, \w you must not|strong="H408"\w* \w take advantage|strong="H3238"\w* \w of each|strong="H376"\w* \w other|strong="H251"\w*. \v 15 \w You are to buy|strong="H7069"\w* \w from|strong="H854"\w* \w your neighbor|strong="H5997"\w* \w according to the number|strong="H4557"\w* \w of years|strong="H8141"\w* \w since|strong="H310"\w* \w the last Jubilee|strong="H3104"\w*; \w he is to sell|strong="H4376"\w* to you \w according to the number|strong="H4557"\w* \w of harvest|strong="H8393"\w* \w years remaining|strong="H8141"\w*. \v 16 \w You shall increase|strong="H7235"\w* \w the price|strong="H4736"\w* \w in proportion|strong="H6310"\w* \w to a greater number|strong="H7230"\w* \w of years|strong="H8141"\w*, \w or decrease|strong="H4591"\w* \w it|strong="H4736"\w* \w in proportion to|strong="H6310"\w* \w a lesser|strong="H4591"\w* \w number of years|strong="H8141"\w*; \w for|strong="H3588"\w* \w he|strong="H1931"\w* \w is selling|strong="H4376"\w* you \w a given number of|strong="H4557"\w* \w harvests|strong="H8393"\w*.
\p \v 17 \w Do not|strong="H3808"\w* \w take advantage|strong="H3238"\w* \w of each|strong="H376"\w* \w other|strong="H5997"\w*, \w but fear|strong="H3372"\w* \w your God|strong="H430"\w*; \w for|strong="H3588"\w* \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w* \w your God|strong="H430"\w*.
\s1 The Blessing of Obedience
\r (\ref Deuteronomy 28:1–14|DEU 28:1-14\ref*)
\p \v 18 \w You are to keep|strong="H6213"\w* \w My statutes|strong="H2708"\w* \w and|strong="H853"\w* \w carefully|strong="H8104"\w* \w observe|strong="H6213"\w* \w My judgments|strong="H4941"\w*, \w so that you may dwell|strong="H3427"\w* \w securely|strong="H983"\w* \w in|strong="H5921"\w* \w the land|strong="H776"\w*. \v 19 \w Then the land|strong="H776"\w* \w will yield|strong="H5414"\w* \w its fruit|strong="H6529"\w*, \w so that you can eat|strong="H398"\w* \w your fill|strong="H7648"\w* \w and dwell|strong="H3427"\w* \w in safety|strong="H983"\w* \w in the land|strong="H5921"\w*.
\p \v 20 \w Now|strong="H3588"\w* \w you may wonder|strong="H559"\w*, ‘\w What|strong="H4100"\w* \w will we eat|strong="H398"\w* \w in the seventh|strong="H7637"\w* \w year|strong="H8141"\w* \w if|strong="H2005"\w* \w we do not|strong="H3808"\w* \w sow|strong="H2232"\w* \w or gather|strong="H622"\w* \w our produce|strong="H8393"\w*?’ \v 21 \w But I will send|strong="H6680"\w* \w My blessing|strong="H1293"\w* upon you \w in the sixth|strong="H8345"\w* \w year|strong="H8141"\w*, \w so that the land will yield|strong="H6213"\w* \w a crop|strong="H8393"\w* \w sufficient for three|strong="H7969"\w* \w years|strong="H8141"\w*. \v 22 \w While you are sowing|strong="H2232"\w* \w in the eighth|strong="H8066"\w* \w year|strong="H8141"\w*, \w you will be eating|strong="H398"\w* \w from|strong="H4480"\w* \w the previous|strong="H3465"\w* \w harvest|strong="H8393"\w*, \w until|strong="H5704"\w* \w the ninth|strong="H8671"\w* \w year’s|strong="H8141"\w* \w harvest|strong="H8393"\w* \w comes in|strong="H935"\w*.
\s1 The Law of Redemption
\p \v 23 \w The land|strong="H776"\w* \w must not|strong="H3808"\w* \w be sold|strong="H4376"\w* \w permanently|strong="H6783"\w*, \w because|strong="H3588"\w* \w it|strong="H776"\w* is Mine, \w and|strong="H3588"\w* \w you|strong="H859"\w* \w are but foreigners|strong="H1616"\w* \w and residents|strong="H8453"\w* \w with Me|strong="H5978"\w*. \v 24 \w Thus for every|strong="H3605"\w* \w piece of property|strong="H776"\w* \w you possess|strong="H272"\w*, \w you must provide for|strong="H5414"\w* \w the redemption|strong="H1353"\w* \w of the land|strong="H776"\w*.
\p \v 25 \w If|strong="H3588"\w* \w your brother|strong="H251"\w* \w becomes impoverished|strong="H4134"\w* \w and sells|strong="H4376"\w* \w some of his property|strong="H272"\w*, \w his nearest|strong="H7138"\w* \w of kin|strong="H1350"\w* \w may come|strong="H935"\w* \w and redeem|strong="H1350"\w* \w what his brother|strong="H251"\w* \w has sold|strong="H4465"\w*. \v 26 \w Or if|strong="H3588"\w* \w a man|strong="H376"\w* \w has|strong="H1961"\w* \w no one|strong="H3808"\w* \w to redeem it|strong="H1350"\w* for him, \w but he prospers|strong="H5381"\w* \w and acquires|strong="H4672"\w* \w enough|strong="H1767"\w* \w to redeem his land|strong="H1353"\w*, \v 27 \w he shall calculate|strong="H2803"\w* \w the years|strong="H8141"\w* \w since its sale|strong="H4465"\w*, \w repay|strong="H7725"\w* \w the balance|strong="H5736"\w* \w to the man|strong="H376"\w* to \w whom|strong="H834"\w* \w he sold it|strong="H4376"\w*, \w and return|strong="H7725"\w* \w to his property|strong="H272"\w*. \v 28 \w But if|strong="H518"\w* \w he cannot|strong="H3808"\w* \w obtain|strong="H4672"\w* \w enough|strong="H1767"\w* \w to repay|strong="H7725"\w* him, \w what he sold|strong="H4465"\w* \w will remain|strong="H1961"\w* \w in possession|strong="H3027"\w* \w of the buyer|strong="H7069"\w* \w until|strong="H5704"\w* \w the Year|strong="H8141"\w* \w of Jubilee|strong="H3104"\w*. \w In the Jubilee|strong="H3104"\w*, \w however, it is to be released|strong="H3318"\w*, \w so that he may return|strong="H7725"\w* \w to his property|strong="H272"\w*.
\p \v 29 \w If|strong="H3588"\w* \w a man|strong="H376"\w* \w sells|strong="H4376"\w* \w a house|strong="H1004"\w* \w in a walled|strong="H2346"\w* \w city|strong="H5892"\w*, \w he retains|strong="H1961"\w* \w his right of redemption|strong="H1353"\w* \w until|strong="H5704"\w* \w a full|strong="H8552"\w* \w year|strong="H8141"\w* \w after its sale|strong="H4465"\w*; \w during that year|strong="H3117"\w* \w it may be|strong="H1961"\w* \w redeemed|strong="H1353"\w*. \v 30 \w If|strong="H518"\w* \w it is not|strong="H3808"\w* \w redeemed|strong="H1350"\w* \w by the end|strong="H5704"\w* of \w a full|strong="H8549"\w* \w year|strong="H8141"\w*, \w then the house|strong="H1004"\w* \w in the walled|strong="H2346"\w* \w city|strong="H5892"\w* \w is permanently|strong="H6783"\w* \w transferred to its buyer|strong="H7069"\w* \w and his descendants|strong="H1755"\w*. \w It is not|strong="H3808"\w* \w to be released|strong="H3318"\w* \w in the Jubilee|strong="H3104"\w*. \v 31 \w But houses|strong="H1004"\w* \w in villages|strong="H2691"\w* \w with|strong="H834"\w* \w no|strong="H369"\w* \w walls|strong="H2346"\w* \w around them|strong="H5439"\w* \w are to be considered|strong="H2803"\w* \w as open fields|strong="H7704"\w*. \w They may be redeemed|strong="H1353"\w*, \w and they shall be|strong="H1961"\w* \w released|strong="H3318"\w* \w in the Jubilee|strong="H3104"\w*.
\p \v 32 \w As for the cities|strong="H5892"\w* \w of the Levites|strong="H3881"\w*, \w the Levites|strong="H3881"\w* \w always|strong="H5769"\w* \w have|strong="H1961"\w* \w the right to redeem|strong="H1353"\w* \w their houses|strong="H1004"\w* \w in the cities|strong="H5892"\w* \w they possess|strong="H272"\w*. \v 33 \w So whatever|strong="H834"\w* \w belongs to|strong="H4480"\w* \w the Levites|strong="H3881"\w* \w may be redeemed|strong="H1350"\w*— \w a house|strong="H1004"\w* \w sold|strong="H4465"\w* \w in a city|strong="H5892"\w* \w they possess|strong="H272"\w*— \w and must be released|strong="H3318"\w* \w in the Jubilee|strong="H3104"\w*, \w because|strong="H3588"\w* \w the houses|strong="H1004"\w* \w in the cities|strong="H5892"\w* \w of the Levites|strong="H3881"\w* \w are their possession|strong="H272"\w* \w among|strong="H8432"\w* \w the Israelites|strong="H1121"\w*. \v 34 \w But the open|strong="H7704"\w* \w pastureland|strong="H4054"\w* \w around their cities|strong="H5892"\w* \w may not|strong="H3808"\w* \w be sold|strong="H4376"\w*, \w for|strong="H3588"\w* \w this|strong="H1931"\w* is their \w permanent|strong="H5769"\w* \w possession|strong="H272"\w*.
\s1 Redemption of the Poor
\p \v 35 \w Now if|strong="H3588"\w* \w your countryman|strong="H251"\w* \w becomes destitute|strong="H4134"\w* \w and cannot support himself|strong="H4131"\w* \w among you|strong="H5973"\w*, \w then you are to help|strong="H2388"\w* him \w as you would a foreigner|strong="H1616"\w* \w or stranger|strong="H8453"\w*, \w so that he can continue to live|strong="H2421"\w* \w among you|strong="H5973"\w*. \v 36 \w Do not|strong="H408"\w* \w take|strong="H3947"\w* \w any interest|strong="H5392"\w* \w or profit|strong="H8636"\w* \w from him|strong="H854"\w*, \w but fear|strong="H3372"\w* \w your God|strong="H430"\w*, \w that your countryman|strong="H251"\w* \w may live|strong="H2421"\w* \w among you|strong="H5973"\w*. \v 37 \w You must not|strong="H3808"\w* \w lend|strong="H5414"\w* \w him|strong="H853"\w* \w your silver|strong="H3701"\w* \w at interest|strong="H5392"\w* \w or|strong="H3808"\w* \w sell him|strong="H5414"\w* \w your food|strong="H400"\w* \w for profit|strong="H4768"\w*. \v 38 \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w* \w your God|strong="H430"\w*, \w who|strong="H834"\w* \w brought you|strong="H3318"\w* \w out of the land|strong="H776"\w* \w of Egypt|strong="H4714"\w* \w to give|strong="H5414"\w* you \w the land|strong="H776"\w* \w of Canaan|strong="H3667"\w* \w and to be|strong="H1961"\w* your \w God|strong="H430"\w*.
\s1 Redemption of Bondmen
\p \v 39 \w If|strong="H3588"\w* \w a countryman|strong="H251"\w* \w among you|strong="H5973"\w* \w becomes destitute|strong="H4134"\w* \w and sells himself|strong="H4376"\w* to you, \w then you must not|strong="H3808"\w* \w force him|strong="H5647"\w* into \w slave|strong="H5650"\w* \w labor|strong="H5656"\w*. \v 40 \w Let him stay|strong="H1961"\w* \w with you|strong="H5973"\w* \w as a hired worker|strong="H7916"\w* \w or temporary resident|strong="H8453"\w*; \w he is to work|strong="H5647"\w* \w for|strong="H5973"\w* \w you until|strong="H5704"\w* \w the Year|strong="H8141"\w* \w of Jubilee|strong="H3104"\w*. \v 41 \w Then he|strong="H1931"\w* \w and his children|strong="H1121"\w* \w are to be released|strong="H3318"\w*, \w and he may return|strong="H7725"\w* \w to|strong="H413"\w* \w his clan|strong="H4940"\w* \w and to|strong="H413"\w* \w the property|strong="H272"\w* \w of his fathers|strong="H1"\w*.
\p \v 42 \w Because|strong="H3588"\w* \w the Israelites are|strong="H1992"\w* \w My servants|strong="H5650"\w*, \w whom|strong="H834"\w* \w I brought|strong="H3318"\w* \w out of the land|strong="H776"\w* \w of Egypt|strong="H4714"\w*, \w they are not|strong="H3808"\w* \w to be sold|strong="H4376"\w* \w as slaves|strong="H5650"\w*. \v 43 \w You are not|strong="H3808"\w* \w to rule|strong="H7287"\w* over them \w harshly|strong="H6531"\w*, \w but you shall fear|strong="H3372"\w* \w your God|strong="H430"\w*.
\p \v 44 \w Your menservants|strong="H5650"\w* \w and maidservants|strong="H519"\w* \w shall come|strong="H1961"\w* \w from|strong="H854"\w* \w the nations|strong="H1471"\w* \w around you|strong="H5439"\w*, from whom \w you may purchase|strong="H7069"\w* \w them|strong="H5650"\w*. \v 45 \w You may also|strong="H1571"\w* \w purchase them|strong="H7069"\w* \w from the|strong="H1121"\w* \w foreigners|strong="H8453"\w* \w residing|strong="H1481"\w* \w among you|strong="H5973"\w* \w or their clans|strong="H4940"\w* \w living among you|strong="H5973"\w* \w who|strong="H834"\w* \w are born|strong="H3205"\w* \w in your land|strong="H776"\w*. \w These may become|strong="H1961"\w* your \w property|strong="H272"\w*. \v 46 \w You may leave|strong="H5157"\w* \w them|strong="H853"\w* \w to your sons|strong="H1121"\w* \w after|strong="H310"\w* \w you to inherit|strong="H3423"\w* \w as property|strong="H272"\w*; \w you can make them slaves|strong="H5647"\w* \w for life|strong="H5769"\w*. \w But as for your brothers|strong="H251"\w*, \w the Israelites|strong="H1121"\w*, \w no|strong="H3808"\w* \w man|strong="H376"\w* \w may rule|strong="H7287"\w* \w harshly|strong="H6531"\w* \w over his brother|strong="H251"\w*.
\s1 Redemption of Servants
\p \v 47 \w If|strong="H3588"\w* \w a foreigner|strong="H1616"\w* \w residing|strong="H8453"\w* \w among you|strong="H5973"\w* \w prospers|strong="H5381"\w*, \w but your countryman|strong="H251"\w* \w dwelling near him|strong="H5973"\w* \w becomes destitute|strong="H4134"\w* \w and sells himself|strong="H4376"\w* \w to the foreigner|strong="H1616"\w* \w or|strong="H176"\w* \w to a member|strong="H6133"\w* \w of his|strong="H1616"\w* \w clan|strong="H4940"\w*, \v 48 \w he retains|strong="H1961"\w* \w the right of redemption|strong="H1353"\w* \w after|strong="H310"\w* \w he has sold himself|strong="H4376"\w*. \w One|strong="H259"\w* \w of his brothers|strong="H251"\w* \w may redeem him|strong="H1350"\w*: \v 49 \w either|strong="H176"\w* \w his uncle|strong="H1730"\w* \w or|strong="H176"\w* \w cousin|strong="H1121"\w* \w or|strong="H176"\w* \w any close relative|strong="H7607"\w* \w from his clan|strong="H4940"\w* \w may redeem him|strong="H1350"\w*. \w Or if|strong="H176"\w* \w he prospers|strong="H5381"\w*, \w he may redeem himself|strong="H1350"\w*.
\p \v 50 \w He and|strong="H5973"\w* \w his purchaser|strong="H7069"\w* \w will then count the time|strong="H2803"\w* \w from the year|strong="H8141"\w* \w he sold|strong="H4376"\w* himself \w up to|strong="H5704"\w* \w the Year|strong="H8141"\w* \w of Jubilee|strong="H3104"\w*. \w The price|strong="H3701"\w* \w of his sale|strong="H4465"\w* \w will be|strong="H1961"\w* \w determined by the number|strong="H4557"\w* \w of years|strong="H8141"\w*, \w based on|strong="H1961"\w* \w the daily|strong="H3117"\w* \w wages of a hired hand|strong="H7916"\w*. \v 51 \w If|strong="H518"\w* \w many|strong="H7227"\w* \w years|strong="H8141"\w* \w remain|strong="H5750"\w*, \w he must pay|strong="H7725"\w* \w for his redemption|strong="H1353"\w* \w in proportion to|strong="H6310"\w* \w his purchase|strong="H4736"\w* \w price|strong="H3701"\w*. \v 52 \w If|strong="H518"\w* \w only a few|strong="H4592"\w* \w years|strong="H8141"\w* \w remain|strong="H7604"\w* \w until|strong="H5704"\w* \w the Year|strong="H8141"\w* \w of Jubilee|strong="H3104"\w*, \w he is to calculate|strong="H2803"\w* \w and pay|strong="H7725"\w* \w his redemption|strong="H1353"\w* \w according to|strong="H6310"\w* \w his remaining years|strong="H8141"\w*. \v 53 \w He shall be treated|strong="H1961"\w* \w like a man hired|strong="H7916"\w* \w from year|strong="H8141"\w* \w to year|strong="H8141"\w*, \w but a foreign owner must not|strong="H3808"\w* \w rule over him|strong="H7287"\w* \w harshly|strong="H6531"\w* \w in your sight|strong="H5869"\w*.
\p \v 54 \w Even if|strong="H518"\w* \w he is not|strong="H3808"\w* \w redeemed|strong="H1350"\w* \w in any of these ways|strong="H428"\w*, \w he|strong="H1931"\w* \w and his children|strong="H1121"\w* \w shall be released|strong="H3318"\w* \w in the Year|strong="H8141"\w* \w of Jubilee|strong="H3104"\w*. \v 55 \w For|strong="H3588"\w* \w the Israelites|strong="H1121"\w* are My \w servants|strong="H5650"\w*. \w They|strong="H1992"\w* \w are My servants|strong="H5650"\w*, \w whom|strong="H834"\w* \w I brought|strong="H3318"\w* \w out of the land|strong="H776"\w* \w of Egypt|strong="H4714"\w*. \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w* \w your God|strong="H430"\w*.[’’]
\c 26
\s1 Additional Blessings of Obedience
\p \v 1 “\w You must not|strong="H3808"\w* \w make|strong="H6213"\w* \w idols|strong="H457"\w* for yourselves \w or set up|strong="H6965"\w* \w a carved image|strong="H6459"\w* \w or sacred pillar|strong="H4676"\w*; \w you must not|strong="H3808"\w* \w place|strong="H5414"\w* \w a sculpted|strong="H4906"\w* \w stone|strong="H68"\w* \w in your land|strong="H776"\w* \w to bow down|strong="H7812"\w* \w to it|strong="H5921"\w*. \w For|strong="H3588"\w* \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w* \w your God|strong="H430"\w*.
\p \v 2 \w You must keep|strong="H8104"\w* \w My Sabbaths|strong="H7676"\w* \w and have reverence for|strong="H3372"\w* \w My sanctuary|strong="H4720"\w*. \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w*.
\p \v 3 \w If|strong="H518"\w* \w you follow|strong="H1980"\w* \w My statutes|strong="H2708"\w* \w and carefully keep|strong="H8104"\w* \w My commandments|strong="H4687"\w*, \v 4 \w I will give|strong="H5414"\w* \w you rains|strong="H1653"\w* \w in their season|strong="H6256"\w*, \w and the land|strong="H776"\w* \w will yield|strong="H5414"\w* \w its produce|strong="H2981"\w*, \w and the trees|strong="H6086"\w* \w of the field|strong="H7704"\w* \w will bear|strong="H5414"\w* \w their fruit|strong="H6529"\w*. \v 5 Your \w threshing|strong="H1786"\w* \w will continue|strong="H5381"\w* \w until the grape harvest|strong="H1210"\w*, \w and the grape harvest|strong="H1210"\w* \w will continue|strong="H5381"\w* \w until sowing time|strong="H2233"\w*; \w you will have your fill of|strong="H7648"\w* \w food|strong="H3899"\w* \w to eat|strong="H398"\w* \w and will dwell|strong="H3427"\w* \w securely|strong="H983"\w* \w in your land|strong="H776"\w*.
\p \v 6 \w And I will give|strong="H5414"\w* \w peace|strong="H7965"\w* \w to the land|strong="H776"\w*, \w and you will lie down|strong="H7901"\w* \w with nothing|strong="H369"\w* \w to fear|strong="H2729"\w*. \w I will rid|strong="H7673"\w* \w the land|strong="H776"\w* \w of dangerous|strong="H7451"\w* \w animals|strong="H2416"\w*, \w and no|strong="H3808"\w* \w sword|strong="H2719"\w* \w will pass|strong="H5674"\w* \w through your land|strong="H776"\w*. \v 7 \w You will pursue|strong="H7291"\w* \w your enemies|strong="H341"\w*, \w and they will fall|strong="H5307"\w* \w by the sword|strong="H2719"\w* \w before you|strong="H6440"\w*. \v 8 \w Five|strong="H2568"\w* of you \w will pursue|strong="H7291"\w* \w a hundred|strong="H3967"\w*, \w and a hundred|strong="H3967"\w* of you \w will pursue|strong="H7291"\w* \w ten thousand|strong="H7233"\w*, \w and your enemies|strong="H341"\w* \w will fall|strong="H5307"\w* \w by the sword|strong="H2719"\w* \w before you|strong="H6440"\w*.
\p \v 9 \w I will turn|strong="H6437"\w* \w toward you|strong="H413"\w* \w and make you fruitful|strong="H6509"\w* \w and multiply|strong="H7235"\w* \w you|strong="H853"\w*, \w and I will establish|strong="H6965"\w* \w My covenant|strong="H1285"\w* \w with you|strong="H854"\w*. \v 10 \w You will still be eating|strong="H398"\w* \w the old|strong="H3465"\w* \w supply of grain|strong="H3462"\w* \w when you need to clear it out|strong="H3318"\w* \w to make room for|strong="H6440"\w* \w the new|strong="H2319"\w*.
\p \v 11 \w And I will make|strong="H5414"\w* \w My dwelling place|strong="H4908"\w*\f + \fr 26:11 \ft Or \fqa My tabernacle\f* \w among you|strong="H8432"\w*, \w and My soul|strong="H5315"\w* \w will not|strong="H3808"\w* \w despise|strong="H1602"\w*\f + \fr 26:11 \ft Or \fqa reject\ft ; also in verse 30\f* \w you|strong="H853"\w*. \v 12 \w I will walk|strong="H1980"\w* \w among you|strong="H8432"\w* \w and be|strong="H1961"\w* your \w God|strong="H430"\w*, \w and you|strong="H859"\w* \w will be|strong="H1961"\w* My \w people|strong="H5971"\w*.\f + \fr 26:12 \ft Cited in \ref 2 Corinthians 6:16|2CO 6:16\ref*\f* \v 13 \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w* \w your God|strong="H430"\w*, \w who|strong="H834"\w* \w brought|strong="H3318"\w* \w you|strong="H853"\w* \w out of the land|strong="H776"\w* \w of Egypt|strong="H4714"\w* \w so that you would no longer be|strong="H1961"\w* \w slaves|strong="H5650"\w* to the Egyptians. \w I broke|strong="H7665"\w* \w the bars|strong="H4133"\w* \w of your yoke|strong="H5923"\w* \w and enabled you to walk|strong="H1980"\w* \w in uprightness|strong="H6968"\w*.
\s1 Punishments for Disobedience
\r (\ref Leviticus 20:1–9|LEV 20:1-9\ref*; \ref Deuteronomy 28:15–68|DEU 28:15-68\ref*)
\p \v 14 \w If, however|strong="H518"\w*, \w you fail|strong="H3808"\w* \w to obey|strong="H8085"\w* Me \w and to carry out|strong="H6213"\w* \w all|strong="H3605"\w* \w these|strong="H428"\w* \w commandments|strong="H4687"\w*, \v 15 \w and if|strong="H518"\w* \w you reject|strong="H3988"\w* \w My statutes|strong="H2708"\w*, \w despise|strong="H1602"\w* \w My ordinances|strong="H4941"\w*, \w and neglect|strong="H1115"\w* \w to carry out|strong="H6213"\w* \w all|strong="H3605"\w* \w My commandments|strong="H4687"\w*, \w and so break|strong="H6565"\w* \w My covenant|strong="H1285"\w*, \v 16 \w then|strong="H637"\w* \w this is what|strong="H2063"\w* \w I|strong="H589"\w* \w will do|strong="H6213"\w* to you: \w I will bring|strong="H6485"\w* \w upon you|strong="H5921"\w* \w sudden terror|strong="H928"\w*, \w wasting disease|strong="H7829"\w*, \w and|strong="H853"\w* \w fever|strong="H6920"\w* \w that will destroy|strong="H3615"\w* \w your sight|strong="H5869"\w* \w and drain|strong="H1727"\w* \w your life|strong="H5315"\w*. \w You will sow|strong="H2232"\w* \w your seed|strong="H2233"\w* \w in vain|strong="H7385"\w*, \w because your enemies|strong="H341"\w* \w will eat it|strong="H398"\w*. \v 17 \w And I will set|strong="H5414"\w* \w My face|strong="H6440"\w* against you, \w so that you will be defeated|strong="H5062"\w* \w by|strong="H6440"\w* \w your enemies|strong="H341"\w*. \w Those who hate you|strong="H8130"\w* \w will rule|strong="H7287"\w* over you, \w and you will flee|strong="H5127"\w* \w when no one|strong="H369"\w* \w pursues|strong="H7291"\w* \w you|strong="H853"\w*.
\p \v 18 \w And if|strong="H518"\w* \w after|strong="H5704"\w* \w all this|strong="H428"\w* \w you will not|strong="H3808"\w* \w obey|strong="H8085"\w* Me, \w I will proceed|strong="H3254"\w* \w to punish|strong="H3256"\w* \w you|strong="H853"\w* \w sevenfold|strong="H7651"\w* \w for|strong="H5921"\w* \w your sins|strong="H2403"\w*. \v 19 \w I will break down|strong="H7665"\w* \w your stubborn|strong="H5797"\w* \w pride|strong="H1347"\w* \w and make|strong="H5414"\w* \w your sky|strong="H8064"\w* \w like iron|strong="H1270"\w* \w and your land|strong="H776"\w* \w like bronze|strong="H5154"\w*, \v 20 \w and your strength|strong="H3581"\w* \w will be spent|strong="H8552"\w* \w in vain|strong="H7385"\w*. \w For your land|strong="H776"\w* \w will not|strong="H3808"\w* \w yield|strong="H5414"\w* \w its|strong="H853"\w* \w produce|strong="H2981"\w*, \w and the trees|strong="H6086"\w* \w of the land|strong="H776"\w* \w will not|strong="H3808"\w* \w bear|strong="H5414"\w* \w their fruit|strong="H6529"\w*.
\p \v 21 \w If|strong="H518"\w* \w you walk|strong="H1980"\w* \w in hostility|strong="H7147"\w* \w toward Me|strong="H5973"\w* \w and refuse|strong="H3808"\w* \w to obey|strong="H8085"\w* Me, \w I will multiply|strong="H3254"\w* \w your plagues|strong="H4347"\w* \w seven times|strong="H7651"\w*, \w according to your sins|strong="H2403"\w*. \v 22 \w I will send|strong="H7971"\w* \w wild|strong="H7704"\w* \w animals|strong="H2416"\w* against you \w to rob you of your children|strong="H7921"\w*, \w destroy|strong="H3772"\w* \w your livestock|strong="H929"\w*, \w and reduce|strong="H4591"\w* \w your numbers|strong="H853"\w*, \w until your roads|strong="H1870"\w* \w lie desolate|strong="H8074"\w*.
\p \v 23 \w And if|strong="H518"\w* \w in spite of these|strong="H428"\w* \w things you do not|strong="H3808"\w* \w accept My discipline|strong="H3256"\w*, \w but continue to walk|strong="H1980"\w* \w in hostility|strong="H7147"\w* \w toward Me|strong="H5973"\w*, \v 24 \w then I|strong="H589"\w* \w will act|strong="H1980"\w* \w with hostility|strong="H7147"\w* \w toward you|strong="H5973"\w*, \w and|strong="H1571"\w* \w I|strong="H589"\w* \w will strike|strong="H5221"\w* \w you|strong="H853"\w* \w sevenfold|strong="H7651"\w* \w for|strong="H5921"\w* \w your sins|strong="H2403"\w*. \v 25 \w And I will bring|strong="H935"\w* \w a sword|strong="H2719"\w* \w against you|strong="H5921"\w* \w to execute|strong="H5358"\w* \w the vengeance|strong="H5359"\w* \w of the covenant|strong="H1285"\w*. \w Though you withdraw|strong="H622"\w* \w into|strong="H413"\w* \w your cities|strong="H5892"\w*, \w I will send|strong="H7971"\w* \w a plague|strong="H1698"\w* \w among you|strong="H8432"\w*, \w and you will be delivered|strong="H5414"\w* \w into the hand|strong="H3027"\w* \w of the enemy|strong="H341"\w*. \v 26 \w When I cut off|strong="H7665"\w* your \w supply|strong="H4294"\w*\f + \fr 26:26 \ft Hebrew \fqa staff\f* \w of bread|strong="H3899"\w*, \w ten|strong="H6235"\w* \w women|strong="H802"\w* \w will bake|strong="H644"\w* \w your bread|strong="H3899"\w* \w in a single|strong="H259"\w* \w oven|strong="H8574"\w* \w and dole out|strong="H7725"\w* \w your bread|strong="H3899"\w* \w by weight|strong="H4948"\w*, \w so that you will eat|strong="H398"\w* \w but not|strong="H3808"\w* \w be satisfied|strong="H7646"\w*.
\p \v 27 \w But if|strong="H518"\w* \w in spite of all this|strong="H2063"\w* \w you do not|strong="H3808"\w* \w obey|strong="H8085"\w* Me, \w but continue to walk|strong="H1980"\w* \w in hostility|strong="H7147"\w* \w toward Me|strong="H5973"\w*, \v 28 \w then I will walk|strong="H1980"\w* \w in fury|strong="H2534"\w* \w against|strong="H7147"\w* \w you|strong="H5973"\w*, \w and I|strong="H589"\w*, \w even I|strong="H637"\w*, \w will punish|strong="H3256"\w* \w you|strong="H853"\w* \w sevenfold|strong="H7651"\w* \w for|strong="H5921"\w* \w your sins|strong="H2403"\w*. \v 29 \w You will eat|strong="H398"\w* \w the flesh|strong="H1320"\w* \w of your own sons|strong="H1121"\w* \w and|strong="H1320"\w* \w daughters|strong="H1323"\w*. \v 30 \w I will destroy|strong="H8045"\w* \w your high places|strong="H1116"\w*, \w cut down|strong="H3772"\w* \w your incense altars|strong="H2553"\w*, \w and heap|strong="H5414"\w* \w your lifeless bodies|strong="H6297"\w* \w on|strong="H5921"\w* \w the lifeless remains|strong="H6297"\w* \w of your idols|strong="H1544"\w*; \w and My soul|strong="H5315"\w* \w will despise|strong="H1602"\w* \w you|strong="H853"\w*.
\p \v 31 \w I will reduce|strong="H5414"\w* \w your cities|strong="H5892"\w* \w to rubble|strong="H2723"\w* \w and lay waste|strong="H8074"\w* \w your sanctuaries|strong="H4720"\w*, \w and I will refuse|strong="H3808"\w* \w to smell|strong="H7306"\w* \w the pleasing|strong="H5207"\w* \w aroma of your sacrifices|strong="H7381"\w*. \v 32 \w And I|strong="H589"\w* \w will lay waste|strong="H8074"\w* \w the land|strong="H776"\w*, \w so that your enemies|strong="H341"\w* \w who dwell|strong="H3427"\w* in it \w will be appalled|strong="H8074"\w*. \v 33 \w But|strong="H853"\w* \w I will scatter|strong="H2219"\w* \w you among the nations|strong="H1471"\w* \w and will draw out|strong="H7324"\w* \w a sword|strong="H2719"\w* \w after you|strong="H310"\w* \w as your land|strong="H776"\w* \w becomes|strong="H1961"\w* \w desolate|strong="H8077"\w* \w and your cities|strong="H5892"\w* \w are laid|strong="H1961"\w* \w waste|strong="H2723"\w*.
\p \v 34 \w Then|strong="H227"\w* \w the land|strong="H776"\w* \w shall enjoy|strong="H7521"\w* \w its|strong="H853"\w* \w Sabbaths|strong="H7676"\w* \w all|strong="H3605"\w* \w the days|strong="H3117"\w* \w it lies desolate|strong="H8074"\w*, \w while you|strong="H859"\w* \w are in the land|strong="H776"\w* \w of your enemies|strong="H341"\w*. \w At that time|strong="H227"\w* \w the land|strong="H776"\w* \w will rest|strong="H7673"\w* \w and enjoy|strong="H7521"\w* \w its|strong="H853"\w* \w Sabbaths|strong="H7676"\w*. \v 35 \w As long as|strong="H3605"\w* \w it lies desolate|strong="H8074"\w*, \w the land will have the rest|strong="H7673"\w* \w it did not|strong="H3808"\w* \w receive|strong="H7673"\w* \w during the Sabbaths|strong="H7676"\w* \w when you lived|strong="H3427"\w* \w in it|strong="H5921"\w*.
\p \v 36 \w As for those of you who survive|strong="H7604"\w*, \w I will send|strong="H935"\w* \w a faintness|strong="H4816"\w* \w into their hearts|strong="H3824"\w* \w in the lands|strong="H776"\w* \w of their enemies|strong="H341"\w*, \w so that even the sound|strong="H6963"\w* \w of a windblown|strong="H5086"\w* \w leaf|strong="H5929"\w* \w will put them to flight|strong="H7291"\w*. \w And they will flee|strong="H5127"\w* \w as one flees|strong="H4499"\w* \w the sword|strong="H2719"\w*, \w and fall|strong="H5307"\w* \w when no one|strong="H369"\w* \w pursues them|strong="H7291"\w*. \v 37 \w They will stumble|strong="H3782"\w* \w over one|strong="H376"\w* \w another|strong="H251"\w* \w as before|strong="H6440"\w* \w the sword|strong="H2719"\w*, \w though no one|strong="H369"\w* \w is behind them|strong="H7291"\w*. \w So|strong="H3808"\w* you will not \w be|strong="H1961"\w* \w able to stand|strong="H8617"\w* \w against|strong="H6440"\w* \w your enemies|strong="H341"\w*.
\p \v 38 \w You will perish|strong="H6"\w* \w among the nations|strong="H1471"\w*, \w and the land|strong="H776"\w* \w of your enemies|strong="H341"\w* \w will consume|strong="H398"\w* \w you|strong="H853"\w*. \v 39 \w Those of you who survive|strong="H7604"\w* \w in the lands|strong="H776"\w* \w of your enemies|strong="H341"\w* \w will waste away|strong="H4743"\w* \w in their iniquity|strong="H5771"\w* \w and|strong="H637"\w* \w will decay|strong="H4743"\w* \w in the sins|strong="H5771"\w* \w of their fathers|strong="H1"\w*.
\s1 God Remembers Those Who Repent
\p \v 40 \w But if they will confess|strong="H3034"\w* \w their iniquity|strong="H5771"\w* \w and that|strong="H5771"\w* \w of their fathers|strong="H1"\w* \w in the unfaithfulness|strong="H4604"\w* \w that|strong="H834"\w* \w they practiced|strong="H4603"\w* against Me, \w by which|strong="H834"\w* \w they have also walked|strong="H1980"\w* \w in hostility|strong="H7147"\w* \w toward Me|strong="H5973"\w*— \v 41 \w and|strong="H637"\w* \w I|strong="H589"\w* \w acted|strong="H1980"\w* \w with hostility|strong="H7147"\w* \w toward them|strong="H5973"\w* \w and brought|strong="H935"\w* \w them|strong="H853"\w* \w into the land|strong="H776"\w* \w of their enemies|strong="H341"\w*— \w and|strong="H176"\w* \w if their uncircumcised|strong="H6189"\w* \w hearts|strong="H3824"\w* \w will be humbled|strong="H3665"\w* \w and they will make amends|strong="H7521"\w* \w for their iniquity|strong="H5771"\w*, \v 42 \w then I will remember|strong="H2142"\w* \w My covenant|strong="H1285"\w* \w with Jacob|strong="H3290"\w* \w and|strong="H637"\w* \w My covenant|strong="H1285"\w* \w with Isaac|strong="H3327"\w* \w and My covenant|strong="H1285"\w* \w with Abraham|strong="H85"\w*, \w and I will remember|strong="H2142"\w* \w the land|strong="H776"\w*.
\p \v 43 \w For the land|strong="H776"\w* \w will be abandoned|strong="H5800"\w* by them, \w and it will enjoy|strong="H7521"\w* \w its Sabbaths|strong="H7676"\w* \w by lying desolate|strong="H8074"\w* without them. \w And they|strong="H1992"\w* \w will pay the penalty|strong="H7521"\w* \w for their iniquity|strong="H5771"\w*, \w because|strong="H3282"\w* \w they rejected|strong="H3988"\w* \w My ordinances|strong="H4941"\w* \w and abhorred|strong="H1602"\w* \w My statutes|strong="H2708"\w*.
\p \v 44 \w Yet|strong="H637"\w* \w in spite of|strong="H1571"\w* \w this|strong="H2063"\w*, \w when they are|strong="H1961"\w* \w in the land|strong="H776"\w* \w of their enemies|strong="H341"\w*, \w I will not|strong="H3808"\w* \w reject|strong="H3988"\w* \w or|strong="H3808"\w* \w despise them|strong="H1602"\w* \w so as to destroy them|strong="H3615"\w* \w and break|strong="H6565"\w* \w My covenant|strong="H1285"\w* \w with them|strong="H854"\w*; \w for|strong="H3588"\w* \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w* \w their God|strong="H430"\w*. \v 45 But for their sake \w I will remember|strong="H2142"\w* \w the covenant|strong="H1285"\w* \w with their fathers|strong="H7223"\w*, \w whom|strong="H834"\w* \w I brought out|strong="H3318"\w* \w of the land|strong="H776"\w* \w of Egypt|strong="H4714"\w* \w in the sight|strong="H5869"\w* \w of the nations|strong="H1471"\w*, \w that I might be|strong="H1961"\w* their \w God|strong="H430"\w*. \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w*.”
\p \v 46 \w These|strong="H428"\w* \w are the statutes|strong="H2706"\w*, \w ordinances|strong="H4941"\w*, \w and laws|strong="H8451"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w established|strong="H5414"\w* \w between Himself|strong="H996"\w* \w and the Israelites|strong="H1121"\w* \w through|strong="H3027"\w* \w Moses|strong="H4872"\w* \w on Mount|strong="H2022"\w* \w Sinai|strong="H5514"\w*.
\c 27
\s1 Rules about Valuations
\p \v 1 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 2 “\w Speak|strong="H1696"\w* \w to|strong="H413"\w* \w the Israelites|strong="H1121"\w* \w and say|strong="H559"\w* \w to them|strong="H413"\w*, ‘\w When|strong="H3588"\w* \w someone|strong="H376"\w* \w makes a special|strong="H6381"\w* \w vow|strong="H5088"\w* \w to the LORD|strong="H3068"\w* \w involving the value|strong="H6187"\w* \w of persons|strong="H5315"\w*, \v 3 \w if the valuation|strong="H6187"\w* \w concerns|strong="H1961"\w* \w a male|strong="H2145"\w* \w from twenty|strong="H6242"\w* \w to|strong="H5704"\w* \w sixty|strong="H8346"\w* \w years of age|strong="H8141"\w*, \w then your valuation|strong="H6187"\w* \w shall be|strong="H1961"\w* \w fifty|strong="H2572"\w* \w shekels|strong="H8255"\w* \w of silver|strong="H3701"\w*,\f + \fr 27:3 \fqa 50 shekels \ft is approximately 1.26 pounds or 569.8 grams of silver; also in verse 16.\f* \w according to the sanctuary|strong="H6944"\w* \w shekel|strong="H8255"\w*.\f + \fr 27:3 \fqa A shekel \ft weighed approximately 0.4 ounces or 11.4 grams; also in verse 25.\f* \v 4 \w Or if|strong="H518"\w* \w it|strong="H1931"\w* \w is a female|strong="H5347"\w*, \w then your valuation|strong="H6187"\w* \w shall be|strong="H1961"\w* \w thirty|strong="H7970"\w* \w shekels|strong="H8255"\w*.\f + \fr 27:4 \fqa 30 shekels \ft is approximately 12 ounces or 342 grams of silver.\f* \v 5 \w And if the person is|strong="H518"\w* \w from five|strong="H2568"\w* \w to|strong="H5704"\w* \w twenty|strong="H6242"\w* \w years of age|strong="H1121"\w*, \w then your valuation|strong="H6187"\w* \w for the male|strong="H2145"\w* \w shall be|strong="H1961"\w* \w twenty|strong="H6242"\w* \w shekels|strong="H8255"\w*,\f + \fr 27:5 \fqa 20 shekels \ft is approximately 8 ounces or 228 grams of silver.\f* \w and for the female|strong="H5347"\w* \w ten|strong="H6235"\w* \w shekels|strong="H8255"\w*.\f + \fr 27:5 \fqa 10 shekels \ft is approximately 4 ounces or 114 grams of silver; also in verse 7.\f*
\p \v 6 \w Now if the person is|strong="H518"\w* \w from one month|strong="H2320"\w* \w to|strong="H5704"\w* \w five|strong="H2568"\w* \w years of age|strong="H8141"\w*, \w then your valuation|strong="H6187"\w* \w for the male|strong="H2145"\w* \w shall be|strong="H1961"\w* \w five|strong="H2568"\w* \w shekels|strong="H8255"\w* \w of silver|strong="H3701"\w*,\f + \fr 27:6 \fqa 5 shekels \ft is approximately 2 ounces or 57 grams of silver.\f* \w and for the female|strong="H5347"\w* \w three|strong="H7969"\w* \w shekels|strong="H8255"\w* \w of silver|strong="H3701"\w*.\f + \fr 27:6 \fqa 3 shekels \ft is approximately 1.2 ounces or 34.2 grams of silver.\f* \v 7 \w And if the person is|strong="H518"\w* \w sixty|strong="H8346"\w* \w years of age|strong="H8141"\w* \w or older|strong="H4605"\w*, \w then your valuation|strong="H6187"\w* \w shall be|strong="H1961"\w* \w fifteen|strong="H2568"\w* \w shekels|strong="H8255"\w*\f + \fr 27:7 \fqa 15 shekels \ft is approximately 6 ounces or 171 grams of silver.\f* \w for the male|strong="H2145"\w* \w and ten|strong="H6235"\w* \w shekels|strong="H8255"\w* \w for the female|strong="H5347"\w*. \v 8 \w But if|strong="H518"\w* \w the one making the vow|strong="H1931"\w* \w is too poor to pay|strong="H4134"\w* \w the valuation|strong="H6187"\w*, \w he is to present the person|strong="H5975"\w*\f + \fr 27:8 \ft Or \fqa present himself\f* \w before|strong="H6440"\w* \w the priest|strong="H3548"\w*, \w who|strong="H3548"\w* \w shall set the value|strong="H6186"\w* \w according to|strong="H5921"\w* \w what|strong="H834"\w* \w the one making the vow|strong="H5087"\w* \w can afford|strong="H5381"\w*.
\p \v 9 \w If he vows|strong="H518"\w* \w an|strong="H4480"\w* \w animal|strong="H929"\w* \w that|strong="H834"\w* \w may be brought|strong="H7126"\w* \w as an offering|strong="H7133"\w* \w to the LORD|strong="H3068"\w*, \w any|strong="H3605"\w* \w such animal|strong="H4480"\w* \w given|strong="H5414"\w* \w to the LORD|strong="H3068"\w* \w shall be|strong="H1961"\w* \w holy|strong="H6944"\w*. \v 10 \w He must not|strong="H3808"\w* \w replace it|strong="H2498"\w* \w or exchange it|strong="H4171"\w*, \w either good|strong="H2896"\w* \w for bad|strong="H7451"\w* \w or|strong="H176"\w* \w bad|strong="H7451"\w* \w for good|strong="H2896"\w*. \w But if|strong="H518"\w* \w he does substitute|strong="H4171"\w* \w one animal|strong="H929"\w* \w for another|strong="H929"\w*, \w both that animal|strong="H1931"\w* \w and its substitute|strong="H8545"\w* \w will be|strong="H1961"\w* \w holy|strong="H6944"\w*.
\p \v 11 \w But if|strong="H518"\w* \w the vow involves any|strong="H3605"\w* \w of the unclean|strong="H2931"\w* \w animals|strong="H929"\w* \w that|strong="H834"\w* \w may not|strong="H3808"\w* \w be brought|strong="H7126"\w* \w as an offering|strong="H7133"\w* \w to the LORD|strong="H3068"\w*, \w the animal|strong="H929"\w* \w must be presented|strong="H5975"\w* \w before|strong="H6440"\w* \w the priest|strong="H3548"\w*. \v 12 \w The priest|strong="H3548"\w* \w shall set its value|strong="H6186"\w*, \w whether high|strong="H2896"\w* \w or low|strong="H7451"\w*; \w as the priest|strong="H3548"\w* \w values it|strong="H6187"\w*, \w the price|strong="H3651"\w* \w will be set|strong="H1961"\w*. \v 13 \w If, however, the owner|strong="H518"\w* \w decides to redeem the animal|strong="H1350"\w*, \w he must add|strong="H3254"\w* \w a fifth|strong="H2549"\w* \w to|strong="H5921"\w* \w its value|strong="H6187"\w*.
\p \v 14 \w Now if|strong="H3588"\w* \w a man|strong="H376"\w* \w consecrates|strong="H6942"\w* \w his house|strong="H1004"\w* \w as holy|strong="H6944"\w* \w to the LORD|strong="H3068"\w*, \w then the priest|strong="H3548"\w* \w shall value it|strong="H6186"\w* \w either as|strong="H996"\w* \w good|strong="H2896"\w* \w or|strong="H996"\w* \w bad|strong="H7451"\w*. \w The price will stand|strong="H6965"\w* \w just as|strong="H834"\w* \w the priest|strong="H3548"\w* \w values|strong="H6186"\w* \w it|strong="H853"\w*. \v 15 \w But if|strong="H518"\w* \w he who consecrated|strong="H6942"\w* \w his house|strong="H1004"\w* \w redeems|strong="H1350"\w* \w it|strong="H853"\w*, \w he must add|strong="H3254"\w* \w a fifth|strong="H2549"\w* \w to|strong="H5921"\w* \w the assessed|strong="H6187"\w* \w value|strong="H3701"\w*, \w and it will belong|strong="H1961"\w* to him.
\p \v 16 \w If|strong="H518"\w* \w a man|strong="H376"\w* \w consecrates|strong="H6942"\w* \w to the LORD|strong="H3068"\w* \w a parcel|strong="H7704"\w* \w of his land|strong="H272"\w*, \w then your valuation|strong="H6187"\w* \w shall be|strong="H1961"\w* \w proportional|strong="H6310"\w* \w to the seed required for it|strong="H2233"\w* — \w fifty|strong="H2572"\w* \w shekels|strong="H8255"\w* \w of silver|strong="H3701"\w* \w for every homer|strong="H2563"\w* \w of barley|strong="H8184"\w* \w seed|strong="H2233"\w*.\f + \fr 27:16 \fqa A homer \ft is a dry measure of approximately 6.24 bushels or 220 liters (probably about 291 pounds or 132 kilograms of barley seed).\f* \v 17 \w If|strong="H518"\w* \w he consecrates|strong="H6942"\w* \w his field|strong="H7704"\w* \w during the Year|strong="H8141"\w* \w of Jubilee|strong="H3104"\w*, \w the price will stand|strong="H6965"\w* \w according to your valuation|strong="H6187"\w*.
\p \v 18 \w But if|strong="H518"\w* \w he consecrates|strong="H6942"\w* \w his field|strong="H7704"\w* \w after|strong="H310"\w* \w the Jubilee|strong="H3104"\w*, \w the priest|strong="H3548"\w* \w is to calculate|strong="H2803"\w* \w the price|strong="H3701"\w* \w in proportion to|strong="H5921"\w* \w the years|strong="H8141"\w* \w left|strong="H3498"\w* \w until|strong="H5704"\w* \w the next Year|strong="H8141"\w* \w of Jubilee|strong="H3104"\w*, \w so that your valuation|strong="H6187"\w* \w will be reduced|strong="H1639"\w*. \v 19 \w And if|strong="H518"\w* \w the one who consecrated|strong="H6942"\w* \w the field|strong="H7704"\w* \w decides to redeem it|strong="H1350"\w*, \w he must add|strong="H3254"\w* \w a fifth|strong="H2549"\w* \w to|strong="H5921"\w* \w the assessed|strong="H6187"\w* \w value|strong="H3701"\w*, \w and it shall belong|strong="H6965"\w* to him.
\p \v 20 \w If, however|strong="H518"\w*, \w he does not|strong="H3808"\w* \w redeem|strong="H1350"\w* \w the field|strong="H7704"\w*, \w or if|strong="H518"\w* \w he has sold|strong="H4376"\w* \w it|strong="H7704"\w* \w to another|strong="H312"\w* \w man|strong="H376"\w*, \w it may no|strong="H3808"\w* \w longer|strong="H5750"\w* \w be redeemed|strong="H1350"\w*. \v 21 \w When the field|strong="H7704"\w* \w is released|strong="H3318"\w* \w in the Jubilee|strong="H3104"\w*, \w it will become|strong="H1961"\w* \w holy|strong="H6944"\w*, \w like a field|strong="H7704"\w* \w devoted|strong="H2764"\w* \w to the LORD|strong="H3068"\w*; \w it becomes|strong="H1961"\w* \w the property|strong="H272"\w* \w of the priests|strong="H3548"\w*.
\p \v 22 \w Now if|strong="H518"\w* \w a man consecrates|strong="H6942"\w* \w to the LORD|strong="H3068"\w* \w a field|strong="H7704"\w* \w he has purchased|strong="H4736"\w*, \w which|strong="H834"\w* \w is not|strong="H3808"\w* \w a part|strong="H7704"\w* \w of his own property|strong="H272"\w*, \v 23 \w then the priest|strong="H3548"\w* \w shall calculate|strong="H2803"\w* \w for him the value|strong="H4373"\w* \w up to|strong="H5704"\w* \w the Year|strong="H8141"\w* \w of Jubilee|strong="H3104"\w*, \w and the man shall pay|strong="H5414"\w* \w the assessed value|strong="H6187"\w* \w on that|strong="H1931"\w* \w day|strong="H3117"\w* \w as a sacred offering|strong="H6944"\w* \w to the LORD|strong="H3068"\w*. \v 24 \w In the Year|strong="H8141"\w* \w of Jubilee|strong="H3104"\w* \w the field|strong="H7704"\w* \w shall return|strong="H7725"\w* \w to the one from whom|strong="H834"\w* \w it was bought|strong="H7069"\w* — \w the original owner|strong="H272"\w* \w of the land|strong="H776"\w*. \v 25 \w Every|strong="H3605"\w* \w valuation|strong="H6187"\w* \w will be|strong="H1961"\w* \w according to the sanctuary|strong="H6944"\w* \w shekel|strong="H8255"\w*, \w twenty|strong="H6242"\w* \w gerahs|strong="H1626"\w* \w to the shekel|strong="H8255"\w*.\f + \fr 27:25 \fqa 20 gerahs \ft is equivalent to one shekel (approximately 0.4 ounces or 11.4 grams).\f*
\p \v 26 \w But|strong="H389"\w* \w no|strong="H3808"\w* \w one|strong="H376"\w* \w may consecrate|strong="H6942"\w* \w a firstborn|strong="H1060"\w* \w of the livestock|strong="H929"\w*, \w because|strong="H834"\w* \w a firstborn|strong="H1069"\w* \w belongs to the LORD|strong="H3068"\w*. \w Whether it is|strong="H518"\w* \w an ox|strong="H7794"\w* \w or|strong="H518"\w* \w a sheep|strong="H7716"\w*, \w it is|strong="H1931"\w* \w the LORD’s|strong="H3068"\w*. \v 27 \w But if|strong="H518"\w* \w it is among the unclean|strong="H2931"\w* \w animals|strong="H929"\w*, \w then he may redeem|strong="H6299"\w* \w it according to your valuation|strong="H6187"\w* \w and add|strong="H3254"\w* \w a fifth|strong="H2549"\w* \w of its value|strong="H5921"\w*. \w If|strong="H518"\w* \w it is not|strong="H3808"\w* \w redeemed|strong="H1350"\w*, \w then it shall be sold|strong="H4376"\w* \w according to your valuation|strong="H6187"\w*.
\p \v 28 \w Nothing|strong="H3605"\w* \w that|strong="H834"\w* \w a man|strong="H376"\w* \w sets apart|strong="H2764"\w*\f + \fr 27:28 \ft Forms of the Hebrew \fqa cherem \ft refer to the giving over of things or persons to the LORD; similarly in verse 29.\f* \w to the LORD|strong="H3068"\w* \w from all he owns|strong="H3605"\w* — \w whether a man|strong="H120"\w*, \w an animal|strong="H929"\w*, \w or his inherited land|strong="H7704"\w* — \w can be sold|strong="H4376"\w* \w or redeemed|strong="H1350"\w*; \w everything|strong="H3605"\w* \w so devoted|strong="H2764"\w* \w is most|strong="H6944"\w* \w holy|strong="H6944"\w* \w to the LORD|strong="H3068"\w*.
\p \v 29 \w No|strong="H3605"\w* \w person|strong="H120"\w* \w set apart for destruction|strong="H2763"\w* \w may be ransomed|strong="H6299"\w*; \w he must surely be put to death|strong="H4191"\w*.
\s1 Instruction on Tithes
\r (\ref Deuteronomy 14:22–29|DEU 14:22-29\ref*; \ref Deuteronomy 26:1–15|DEU 26:1-15\ref*; \ref Nehemiah 13:10–14|NEH 13:10-14\ref*)
\p \v 30 \w Thus any|strong="H3605"\w* \w tithe|strong="H4643"\w* \w from the land|strong="H776"\w*, \w whether from the seed|strong="H2233"\w* \w of the land|strong="H776"\w* \w or the fruit|strong="H6529"\w* \w of the trees|strong="H6086"\w*, \w belongs to the LORD|strong="H3068"\w*; \w it|strong="H1931"\w* \w is holy|strong="H6944"\w* \w to the LORD|strong="H3068"\w*. \v 31 \w If|strong="H518"\w* \w a man|strong="H376"\w* \w wishes|strong="H1350"\w* \w to redeem|strong="H1350"\w* \w part of his tithe|strong="H4643"\w*, \w he must add|strong="H3254"\w* \w a fifth|strong="H2549"\w* \w to its value|strong="H5921"\w*.
\p \v 32 \w Every|strong="H3605"\w* \w tenth|strong="H4643"\w* \w animal from the herd|strong="H1241"\w* \w or flock|strong="H6629"\w* \w that|strong="H834"\w* \w passes|strong="H5674"\w* \w under|strong="H8478"\w* \w the shepherd’s rod|strong="H7626"\w* \w will be|strong="H1961"\w* \w holy|strong="H6944"\w* \w to the LORD|strong="H3068"\w*. \v 33 \w He must not|strong="H3808"\w* \w inspect|strong="H1239"\w* \w whether it is good|strong="H2896"\w* \w or|strong="H996"\w* \w bad|strong="H7451"\w*, \w and he shall not|strong="H3808"\w* \w make any substitution|strong="H4171"\w*. \w But if|strong="H518"\w* \w he does make a substitution|strong="H4171"\w*, \w both the animal|strong="H1931"\w* \w and its substitute|strong="H8545"\w* \w shall become|strong="H1961"\w* \w holy|strong="H6944"\w*; \w they cannot|strong="H3808"\w* \w be redeemed|strong="H1350"\w*.’”
\p \v 34 \w These|strong="H428"\w* \w are the commandments|strong="H4687"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w gave|strong="H6680"\w* \w to Moses|strong="H4872"\w* \w for|strong="H413"\w* \w the Israelites|strong="H1121"\w* \w on Mount|strong="H2022"\w* \w Sinai|strong="H5514"\w*.
