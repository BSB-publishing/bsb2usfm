\p \v 1 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w* \w on Mount|strong="H2022"\w* \w Sinai|strong="H5514"\w*, \v 2 “\w Speak|strong="H1696"\w* \w to|strong="H413"\w* \w the Israelites|strong="H1121"\w* \w and say to them|strong="H559"\w*: \w When|strong="H3588"\w* \w you enter|strong="H935"\w* \w the land|strong="H776"\w* \w that|strong="H834"\w* \w I|strong="H589"\w* \w am giving|strong="H5414"\w* you, \w the land itself|strong="H776"\w* \w must observe|strong="H7673"\w* \w a Sabbath|strong="H7676"\w* \w to the LORD|strong="H3068"\w*.
\p \v 3 \w For six|strong="H8337"\w* \w years|strong="H8141"\w* \w you may sow|strong="H2232"\w* \w your field|strong="H7704"\w* \w and prune|strong="H2168"\w* \w your vineyard|strong="H3754"\w* \w and gather|strong="H622"\w* \w its crops|strong="H8393"\w*. \v 4 \w But in the seventh|strong="H7637"\w* \w year|strong="H8141"\w* \w there shall be|strong="H1961"\w* \w a Sabbath|strong="H7676"\w* \w of complete rest|strong="H7677"\w* \w for the land|strong="H776"\w* — \w a Sabbath|strong="H7676"\w* \w to the LORD|strong="H3068"\w*.
\p \w You are not|strong="H3808"\w* \w to sow|strong="H2232"\w* \w your field|strong="H7704"\w* \w or prune|strong="H2168"\w* \w your vineyard|strong="H3754"\w*. \v 5 \w You are not|strong="H3808"\w* \w to reap|strong="H7114"\w* \w the aftergrowth|strong="H5599"\w* \w of your harvest|strong="H7105"\w* \w or gather|strong="H1219"\w* \w the grapes|strong="H6025"\w* \w of your untended vines|strong="H5139"\w*. \w The land|strong="H776"\w* \w must have|strong="H1961"\w* \w a year|strong="H8141"\w* \w of complete rest|strong="H7677"\w*. \v 6 \w Whatever the land|strong="H776"\w* yields \w during the Sabbath year|strong="H7676"\w* \w shall be|strong="H1961"\w* \w food for you|strong="H402"\w*— for yourself, \w your manservant|strong="H5650"\w* \w and maidservant|strong="H519"\w*, \w the hired hand|strong="H7916"\w* \w or foreigner|strong="H8453"\w* \w who stays|strong="H1481"\w* \w with you|strong="H5973"\w*, \v 7 \w and for your livestock|strong="H929"\w* \w and the wild animals|strong="H2416"\w* \w in your land|strong="H776"\w*. \w All|strong="H3605"\w* \w its growth|strong="H8393"\w* \w may serve|strong="H1961"\w* \w as food|strong="H398"\w*.
\s1 The Year of Jubilee
\p \v 8 And you \w shall count off|strong="H5608"\w* \w seven|strong="H7651"\w* \w Sabbaths|strong="H7676"\w* \w of years|strong="H8141"\w* — \w seven|strong="H7651"\w* \w times|strong="H6471"\w* \w seven|strong="H7651"\w* \w years|strong="H8141"\w* — \w so that the seven|strong="H7651"\w* \w Sabbaths|strong="H7676"\w* \w of years|strong="H8141"\w* \w amount to forty-nine|strong="H705"\w* \w years|strong="H8141"\w*. \v 9 \w Then you are to sound|strong="H5674"\w* \w the horn|strong="H7782"\w* \w far and wide|strong="H8643"\w* \w on the tenth day|strong="H6218"\w* \w of the seventh|strong="H7637"\w* \w month|strong="H2320"\w*, \w the Day|strong="H3117"\w* \w of Atonement|strong="H3725"\w*. \w You shall sound|strong="H5674"\w* \w it|strong="H7782"\w* \w throughout|strong="H3605"\w* \w your land|strong="H776"\w*.
\p \v 10 \w So you are to consecrate|strong="H6942"\w* \w the fiftieth|strong="H2572"\w* \w year|strong="H8141"\w* \w and proclaim|strong="H7121"\w* \w liberty|strong="H1865"\w* \w in the land|strong="H776"\w* \w for all|strong="H3605"\w* \w its inhabitants|strong="H3427"\w*. \w It|strong="H1931"\w* \w shall be|strong="H1961"\w* your \w Jubilee|strong="H3104"\w*, \w when each|strong="H376"\w* \w of you is to return|strong="H7725"\w* \w to|strong="H413"\w* \w his property|strong="H272"\w* \w and|strong="H376"\w* \w to|strong="H413"\w* \w his clan|strong="H4940"\w*.
\p \v 11 \w The fiftieth|strong="H2572"\w* \w year|strong="H8141"\w* \w will be|strong="H1961"\w* \w a Jubilee|strong="H3104"\w* for you; \w you are not|strong="H3808"\w* \w to sow the land|strong="H2232"\w* \w or|strong="H3808"\w* \w reap|strong="H7114"\w* \w its aftergrowth|strong="H5599"\w* \w or harvest|strong="H1219"\w* \w the untended vines|strong="H5139"\w*. \v 12 \w For|strong="H3588"\w* \w it is|strong="H1931"\w* \w a Jubilee|strong="H3104"\w*; \w it shall be|strong="H1961"\w* \w holy|strong="H6944"\w* to you. \w You may eat only|strong="H398"\w* \w the crops taken|strong="H8393"\w* \w directly from|strong="H4480"\w* \w the field|strong="H7704"\w*.
