\c 19
\s1 Commandments for Holiness
\p \v 1 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 2 “\w Speak|strong="H1696"\w* \w to|strong="H413"\w* \w the whole|strong="H3605"\w* \w congregation|strong="H5712"\w* \w of Israel|strong="H3478"\w* \w and tell|strong="H559"\w* \w them|strong="H413"\w*: \w Be|strong="H1961"\w* \w holy|strong="H6918"\w* \w because|strong="H3588"\w* \w I|strong="H589"\w*, \w the LORD|strong="H3068"\w* \w your God|strong="H430"\w*, \w am holy|strong="H6918"\w*.\f + \fr 19:2 \ft Cited in \ref 1 Peter 1:16|1PE 1:16\ref*\f*
\p \v 3 \w Each|strong="H376"\w* \w of you must respect|strong="H3372"\w* \w his mother|strong="H517"\w* \w and father|strong="H1"\w*, \w and you must keep|strong="H8104"\w* \w My Sabbaths|strong="H7676"\w*. \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w* \w your God|strong="H430"\w*.
