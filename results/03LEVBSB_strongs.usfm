\p \v 8 \w You must not eat|strong="H398"\w* \w their meat|strong="H1320"\w* \w or touch|strong="H5060"\w* \w their carcasses|strong="H5038"\w*; \w they|strong="H1992"\w* \w are unclean|strong="H2931"\w* for you.
\p \v 9 \w Of all the creatures|strong="H3605"\w* \w that live|strong="H834"\w* \w in the water|strong="H4325"\w*, \w whether in the seas|strong="H3220"\w* \w or in the streams|strong="H5158"\w*, \w you may eat|strong="H398"\w* \w anything|strong="H3605"\w* \w with fins|strong="H5579"\w* \w and scales|strong="H7193"\w*.
\p \v 10 \w But the following|strong="H1992"\w* \w among all|strong="H3605"\w* \w the teeming|strong="H8318"\w* \w life|strong="H2416"\w* \w and creatures|strong="H5315"\w* \w in the water|strong="H4325"\w* \w are detestable|strong="H8263"\w* to you: \w everything|strong="H3605"\w* \w in the seas|strong="H3220"\w* \w or streams|strong="H5158"\w* \w that|strong="H834"\w* \w does not|strong="H369"\w* \w have fins|strong="H5579"\w* \w and scales|strong="H7193"\w*. \v 11 \w They shall be|strong="H1961"\w* \w an abomination|strong="H8263"\w* to you; \w you must not|strong="H3808"\w* \w eat|strong="H398"\w* \w their meat|strong="H1320"\w*, \w and you must detest|strong="H8262"\w* \w their carcasses|strong="H5038"\w*. \v 12 \w Everything|strong="H3605"\w* \w in the water|strong="H4325"\w* \w that|strong="H834"\w* \w does not|strong="H369"\w* have \w fins|strong="H5579"\w* \w and scales|strong="H7193"\w* \w shall be detestable|strong="H8263"\w* to you.
\p \v 13 \w Additionally|strong="H853"\w*, \w you are to detest|strong="H8262"\w* \w the following|strong="H428"\w* \w birds|strong="H5775"\w*, \w and they must not|strong="H3808"\w* \w be eaten|strong="H398"\w* \w because they|strong="H1992"\w* \w are detestable|strong="H8263"\w*:
\b 
\li1 \w the eagle|strong="H5404"\w*, \w the bearded vulture|strong="H6538"\w*, \w the black vulture|strong="H5822"\w*,
\li1 \v 14 \w the kite|strong="H1676"\w*, \w any kind|strong="H4327"\w* \w of falcon|strong="H344"\w*,
\li1 \v 15 \w any|strong="H3605"\w* \w kind|strong="H4327"\w* \w of raven|strong="H6158"\w*,
\li1 \v 16 \w the ostrich|strong="H3284"\w*,\f + \fr 11:16 \ft Literally \fqa the daughter of the ostrich \ft or \fqa the daughter of the owl\f* \w the screech owl|strong="H8464"\w*, \w the gull|strong="H7828"\w*, \w any kind|strong="H4327"\w* \w of hawk|strong="H5322"\w*,
\li1 \v 17 \w the little owl|strong="H3563"\w*, \w the cormorant|strong="H7994"\w*, \w the great owl|strong="H3244"\w*,
\li1 \v 18 \w the white owl|strong="H8580"\w*, \w the desert owl|strong="H6893"\w*, \w the osprey|strong="H7360"\w*,
\li1 \v 19 \w the stork|strong="H2624"\w*, \w any kind|strong="H4327"\w* \w of heron|strong="H601"\w*,
\li1 \w the hoopoe|strong="H1744"\w*, \w and|strong="H853"\w* \w the bat|strong="H5847"\w*.
\p \v 20 \w All|strong="H3605"\w* \w flying|strong="H5775"\w* \w insects|strong="H8318"\w* \w that walk|strong="H1980"\w* \w on|strong="H5921"\w* \w all fours|strong="H702"\w* \w are detestable|strong="H8263"\w* to you. \v 21 \w However|strong="H389"\w*, \w you may eat|strong="H398"\w* \w the following|strong="H2088"\w* \w kinds of|strong="H3605"\w* \w flying|strong="H5775"\w* \w insects|strong="H8318"\w* \w that walk|strong="H1980"\w* \w on|strong="H5921"\w* \w all fours|strong="H702"\w*: \w those|strong="H834"\w* \w having jointed legs|strong="H3767"\w* \w above|strong="H4605"\w* \w their feet|strong="H7272"\w* \w for hopping|strong="H5425"\w* \w on|strong="H5921"\w* \w the ground|strong="H776"\w*. \v 22 \w Of these|strong="H428"\w* \w you may eat|strong="H398"\w* \w any kind|strong="H4327"\w* \w of locust|strong="H697"\w*, \w katydid|strong="H5556"\w*, \w cricket|strong="H2728"\w*, \w or grasshopper|strong="H2284"\w*. \v 23 \w All other|strong="H3605"\w* \w flying|strong="H5775"\w* \w insects|strong="H8318"\w* \w that|strong="H834"\w* have \w four|strong="H702"\w* \w legs|strong="H7272"\w* \w are detestable|strong="H8263"\w* to you.
\p \v 24 \w These creatures|strong="H428"\w* \w will make you unclean|strong="H2930"\w*. \w Whoever|strong="H3605"\w* \w touches|strong="H5060"\w* \w their carcasses|strong="H5038"\w* \w will be unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*, \v 25 \w and whoever|strong="H3605"\w* \w picks up|strong="H5375"\w* \w one of their carcasses|strong="H5038"\w* \w must wash|strong="H3526"\w* \w his clothes|strong="H899"\w*, \w and he will be unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*.
\p \v 26 \w Every|strong="H3605"\w* \w animal|strong="H929"\w* \w with|strong="H834"\w* \w hooves|strong="H6541"\w* \w not|strong="H369"\w* \w completely divided|strong="H6536"\w*\f + \fr 11:26 \ft Literally \fqa a split hoof not completely divided\f* \w or that does not|strong="H369"\w* \w chew|strong="H5927"\w* \w the cud|strong="H1625"\w* \w is unclean|strong="H2931"\w* for you. \w Whoever|strong="H3605"\w* \w touches|strong="H5060"\w* any of them \w will be unclean|strong="H2930"\w*.
\p \v 27 \w All|strong="H3605"\w* \w the four-footed|strong="H1980"\w* \w animals|strong="H2416"\w* \w that walk|strong="H1980"\w* \w on|strong="H5921"\w* \w their paws|strong="H3709"\w* \w are unclean|strong="H2931"\w* for you; \w whoever|strong="H3605"\w* \w touches|strong="H5060"\w* \w their carcasses|strong="H5038"\w* \w will be unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*, \v 28 \w and anyone who picks up|strong="H5375"\w* \w a carcass|strong="H5038"\w* \w must wash|strong="H3526"\w* \w his clothes|strong="H899"\w*, \w and he will be unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*. \w They|strong="H1992"\w* \w are unclean|strong="H2931"\w* for you.
\p \v 29 \w The following|strong="H2088"\w* \w creatures|strong="H8318"\w* \w that move|strong="H8317"\w* \w along|strong="H5921"\w* \w the ground|strong="H776"\w* \w are unclean|strong="H2931"\w* for you: \w the mole|strong="H2467"\w*, \w the mouse|strong="H5909"\w*, \w any kind|strong="H4327"\w* \w of great lizard|strong="H6632"\w*, \v 30 \w the gecko|strong="H604"\w*, \w the monitor lizard|strong="H3581"\w*, \w the common lizard|strong="H3911"\w*, \w the skink|strong="H2546"\w*, \w and the chameleon|strong="H8580"\w*.
\p \v 31 \w These animals|strong="H428"\w* \w are unclean|strong="H2931"\w* for you \w among all|strong="H3605"\w* \w the crawling creatures|strong="H8318"\w*. \w Whoever|strong="H3605"\w* \w touches|strong="H5060"\w* them \w when they are dead|strong="H4194"\w* \w shall be unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*. \v 32 \w When|strong="H3605"\w* \w one of them|strong="H834"\w* \w dies|strong="H4194"\w* \w and falls|strong="H5307"\w* \w on|strong="H5921"\w* something, \w that article becomes unclean|strong="H2930"\w*; \w any|strong="H3605"\w* \w article|strong="H3627"\w* \w of wood|strong="H6086"\w*, \w clothing|strong="H899"\w*, \w leather|strong="H5785"\w*, \w sackcloth|strong="H8242"\w*, \w or any|strong="H3605"\w* \w implement|strong="H3627"\w* \w used|strong="H6213"\w* \w for work|strong="H4399"\w* \w must be rinsed with water|strong="H4325"\w* \w and will remain unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*; \w then it will be clean|strong="H2891"\w*. \v 33 If any of them \w falls|strong="H5307"\w* \w into|strong="H413"\w* \w a|strong="H3605"\w* \w clay|strong="H2789"\w* \w pot|strong="H3627"\w*, \w everything|strong="H3605"\w* \w in|strong="H8432"\w* \w it will be unclean|strong="H2930"\w*; \w you must break the pot|strong="H7665"\w*. \v 34 \w Any|strong="H3605"\w* \w food|strong="H400"\w* \w coming|strong="H935"\w* \w into contact|strong="H5921"\w* \w with water from that pot|strong="H4325"\w* \w will be unclean|strong="H2930"\w*, \w and any|strong="H3605"\w* \w drink|strong="H8354"\w* \w in such a|strong="H3605"\w* \w container|strong="H3627"\w* \w will be unclean|strong="H2930"\w*.
\p \v 35 \w Anything|strong="H3605"\w* \w upon which|strong="H834"\w* \w one of their carcasses|strong="H5038"\w* \w falls|strong="H5307"\w* \w will be unclean|strong="H2930"\w*. \w If it is an oven|strong="H8574"\w* \w or cooking pot|strong="H3600"\w*, \w it must be smashed|strong="H5422"\w*; \w it|strong="H1992"\w* \w is unclean|strong="H2931"\w* \w and will remain|strong="H1961"\w* \w unclean|strong="H2931"\w* for you. \v 36 \w Nevertheless|strong="H389"\w*, \w a spring|strong="H4599"\w* \w or cistern|strong="H953"\w* \w containing|strong="H4723"\w* \w water|strong="H4325"\w* \w will remain|strong="H1961"\w* \w clean|strong="H2889"\w*, \w but one who touches|strong="H5060"\w* \w a carcass in it|strong="H5038"\w* \w will be unclean|strong="H2930"\w*. \v 37 \w If|strong="H3588"\w* \w a carcass|strong="H5038"\w* \w falls|strong="H5307"\w* \w on|strong="H5921"\w* \w any|strong="H3605"\w* \w seed|strong="H2233"\w* \w for sowing|strong="H2221"\w*, \w the seed|strong="H1931"\w* \w is clean|strong="H2889"\w*; \v 38 \w but if|strong="H3588"\w* \w water|strong="H4325"\w* \w has been put|strong="H5414"\w* \w on|strong="H5921"\w* \w the seed|strong="H2233"\w* \w and a carcass|strong="H5038"\w* \w falls|strong="H5307"\w* \w on it|strong="H5921"\w*, \w it|strong="H1931"\w* \w is unclean|strong="H2931"\w* for you.
\p \v 39 \w If|strong="H3588"\w* \w an|strong="H4480"\w* \w animal|strong="H929"\w* \w that|strong="H834"\w* you \w may eat|strong="H402"\w* \w dies|strong="H4191"\w*, \w anyone who touches|strong="H5060"\w* \w the carcass|strong="H5038"\w* \w will be unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*. \v 40 \w Whoever eats|strong="H398"\w* \w from the carcass|strong="H5038"\w* \w must wash|strong="H3526"\w* \w his clothes|strong="H899"\w* \w and will be unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*, \w and anyone who picks up|strong="H5375"\w* \w the carcass|strong="H5038"\w* \w must wash|strong="H3526"\w* \w his clothes|strong="H899"\w* \w and will be unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*.
\p \v 41 \w Every|strong="H3605"\w* \w creature|strong="H8318"\w* \w that moves|strong="H8317"\w* \w along|strong="H5921"\w* \w the ground|strong="H776"\w* \w is detestable|strong="H8263"\w*; \w it|strong="H1931"\w* \w must not|strong="H3808"\w* \w be eaten|strong="H398"\w*. \v 42 \w Do not|strong="H3808"\w* \w eat|strong="H398"\w* \w any creature|strong="H8318"\w* \w that moves|strong="H8317"\w* \w along|strong="H5921"\w* \w the ground|strong="H776"\w*, \w whether|strong="H3605"\w* \w it crawls|strong="H1980"\w* \w on|strong="H5921"\w* \w its belly|strong="H1512"\w* \w or|strong="H3605"\w* \w walks|strong="H1980"\w* \w on|strong="H5921"\w* \w four|strong="H702"\w* \w or|strong="H5704"\w* \w more|strong="H7235"\w* \w feet|strong="H7272"\w*; \w for|strong="H3588"\w* \w such creatures|strong="H1992"\w* \w are detestable|strong="H8263"\w*.
\p \v 43 \w Do not|strong="H408"\w* \w defile|strong="H8262"\w* \w yourselves|strong="H5315"\w* \w by any|strong="H3605"\w* \w crawling creature|strong="H8318"\w*; \w do not|strong="H3808"\w* \w become unclean|strong="H2930"\w* \w or defiled|strong="H2930"\w* by them. \v 44 \w For|strong="H3588"\w* \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w* \w your God|strong="H430"\w*; \w consecrate yourselves, therefore|strong="H6942"\w*, \w and be|strong="H1961"\w* \w holy|strong="H6918"\w*, \w because|strong="H3588"\w* \w I|strong="H589"\w* \w am holy|strong="H6918"\w*.\f + \fr 11:44 \ft Here and in verse 45; cited in \ref 1 Peter 1:16|1PE 1:16\ref*\f* \w You must not|strong="H3808"\w* \w defile|strong="H2930"\w* \w yourselves|strong="H5315"\w* \w by any|strong="H3605"\w* \w creature|strong="H8318"\w* \w that crawls|strong="H7430"\w* \w along|strong="H5921"\w* \w the ground|strong="H776"\w*. \v 45 \w For|strong="H3588"\w* \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w*, \w who brought you up|strong="H5927"\w* \w out of the land|strong="H776"\w* \w of Egypt|strong="H4714"\w* \w so that I would be|strong="H1961"\w* your \w God|strong="H430"\w*; \w therefore be|strong="H1961"\w* \w holy|strong="H6918"\w*, \w because|strong="H3588"\w* \w I|strong="H589"\w* \w am holy|strong="H6918"\w*.
\p \v 46 \w This|strong="H2063"\w* \w is the law|strong="H8451"\w* \w regarding animals|strong="H929"\w*, \w birds|strong="H5775"\w*, \w all|strong="H3605"\w* \w living|strong="H2416"\w* \w creatures|strong="H5315"\w* \w that move|strong="H7430"\w* \w in the water|strong="H4325"\w*, \w and all|strong="H3605"\w* \w creatures|strong="H5315"\w* \w that crawl|strong="H8317"\w* \w along|strong="H5921"\w* \w the ground|strong="H776"\w*. \v 47 \w You must distinguish|strong="H914"\w* \w between|strong="H996"\w* \w the unclean|strong="H2931"\w* \w and the clean|strong="H2889"\w*, \w between|strong="H996"\w* \w animals|strong="H2416"\w* \w that may be eaten|strong="H398"\w* \w and those|strong="H2416"\w* \w that|strong="H834"\w* \w may not|strong="H3808"\w*.’”
\c 12
\s1 Purification after Childbirth
\p \v 1 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 2 “\w Say|strong="H1696"\w* \w to|strong="H413"\w* \w the Israelites|strong="H1121"\w*, ‘\w A woman who|strong="H802"\w* \w becomes pregnant|strong="H2232"\w* \w and gives birth to|strong="H3205"\w* \w a son|strong="H2145"\w* \w will be unclean|strong="H2930"\w* \w for seven|strong="H7651"\w* \w days|strong="H3117"\w*, \w as she is during the days|strong="H3117"\w* \w of her menstruation|strong="H5079"\w*. \v 3 \w And on the eighth|strong="H8066"\w* \w day|strong="H3117"\w* \w the flesh|strong="H1320"\w* \w of the boy’s foreskin|strong="H6190"\w* \w is to be circumcised|strong="H4135"\w*.
\p \v 4 \w The woman shall continue|strong="H3427"\w* \w in purification|strong="H2893"\w* \w from her bleeding|strong="H1818"\w* \w for thirty-three|strong="H7970"\w* \w days|strong="H3117"\w*. \w She must not|strong="H3808"\w* \w touch|strong="H5060"\w* \w anything|strong="H3605"\w* \w sacred|strong="H6944"\w* \w or go|strong="H935"\w* \w into|strong="H413"\w* \w the sanctuary|strong="H4720"\w* \w until|strong="H5704"\w* \w the days|strong="H3117"\w* \w of her purification|strong="H2893"\w* \w are complete|strong="H4390"\w*.
\p \v 5 \w If, however|strong="H518"\w*, \w she gives birth to|strong="H3205"\w* \w a daughter|strong="H5347"\w*, \w the woman will be unclean|strong="H2930"\w* \w for two weeks|strong="H7620"\w* \w as she is during her menstruation|strong="H5079"\w*. \w Then she must continue|strong="H3427"\w* \w in|strong="H5921"\w* \w purification|strong="H2893"\w* \w from her bleeding|strong="H1818"\w* \w for sixty-six|strong="H8346"\w* \w days|strong="H3117"\w*.
\p \v 6 \w When the days|strong="H3117"\w* \w of her purification|strong="H2893"\w* \w are complete|strong="H4390"\w*, \w whether for a son|strong="H1121"\w* \w or|strong="H176"\w* \w for a daughter|strong="H1323"\w*, \w she is to bring|strong="H935"\w* \w to|strong="H413"\w* \w the priest|strong="H3548"\w* \w at|strong="H413"\w* \w the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w* \w a year-old|strong="H1121"\w* \w lamb|strong="H3532"\w* \w for a burnt offering|strong="H5930"\w* \w and a young|strong="H1121"\w* \w pigeon|strong="H3123"\w* \w or|strong="H176"\w* \w a turtledove|strong="H8449"\w* \w for a sin offering|strong="H2403"\w*. \v 7 \w And the priest will present them|strong="H7126"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w and make atonement|strong="H3722"\w* \w for her|strong="H5921"\w*; \w and she shall be ceremonially cleansed|strong="H2891"\w* \w from her flow|strong="H4726"\w* \w of blood|strong="H1818"\w*. \w This|strong="H2063"\w* \w is the law|strong="H8451"\w* \w for a woman giving birth|strong="H3205"\w*, \w whether to a male|strong="H2145"\w* \w or|strong="H176"\w* \w to a female|strong="H5347"\w*.
\p \v 8 \w But if|strong="H518"\w* \w she cannot|strong="H3808"\w* \w afford|strong="H4672"\w* \w a lamb|strong="H7716"\w*, \w she shall bring|strong="H3947"\w* \w two|strong="H8147"\w* \w turtledoves|strong="H8449"\w* \w or|strong="H176"\w* \w two|strong="H8147"\w* \w young|strong="H1121"\w* \w pigeons|strong="H3123"\w*,\f + \fr 12:8 \ft Cited in \ref Luke 2:24|LUK 2:24\ref*\f* \w one|strong="H259"\w* \w for a burnt offering|strong="H5930"\w* \w and the other|strong="H259"\w* \w for a sin offering|strong="H2403"\w*. \w Then the priest|strong="H3548"\w* \w will make atonement|strong="H3722"\w* \w for her|strong="H5921"\w*, \w and she will be clean|strong="H2891"\w*.’”
\c 13
\s1 Laws about Skin Diseases
\r (\ref Numbers 5:1–4|NUM 5:1-4\ref*)
\p \v 1 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w* \w and Aaron|strong="H175"\w*, \v 2 “\w When|strong="H3588"\w* \w someone|strong="H120"\w* \w has|strong="H1961"\w* \w a swelling|strong="H7613"\w* \w or|strong="H176"\w* \w rash|strong="H5597"\w* \w or|strong="H176"\w* \w bright spot|strong="H934"\w* \w on his skin|strong="H5785"\w* \w that may be|strong="H1961"\w* \w an infectious|strong="H6883"\w* \w skin|strong="H5785"\w* \w disease|strong="H5061"\w*,\f + \fr 13:2 \ft Forms of the Hebrew \fqa tzaraath\ft , traditionally translated as \fqa leprosy\ft , were used for various skin diseases; here and throughout verses 3–46.\f* \w he must be brought|strong="H935"\w* \w to|strong="H413"\w* \w Aaron|strong="H175"\w* \w the priest|strong="H3548"\w* \w or|strong="H176"\w* \w to|strong="H413"\w* \w one|strong="H259"\w* \w of his sons|strong="H1121"\w* \w who is a priest|strong="H3548"\w*.
\p \v 3 \w The priest|strong="H3548"\w* \w is to examine|strong="H7200"\w* \w the infection|strong="H5061"\w* \w on his skin|strong="H5785"\w*, \w and if the hair|strong="H8181"\w* \w in the infection|strong="H5061"\w* \w has turned|strong="H2015"\w* \w white|strong="H3836"\w* \w and the sore|strong="H5061"\w* \w appears|strong="H4758"\w* \w to be deeper|strong="H6013"\w* \w than the skin|strong="H5785"\w*, \w it|strong="H1931"\w* \w is a skin disease|strong="H6883"\w*. \w After the priest|strong="H3548"\w* \w examines him|strong="H7200"\w*, \w he must pronounce him unclean|strong="H2930"\w*.
\p \v 4 \w If, however|strong="H518"\w*, \w the spot|strong="H934"\w* \w on his skin|strong="H5785"\w* \w is white|strong="H3836"\w* \w and does not|strong="H369"\w* \w appear|strong="H4758"\w* \w to be deeper|strong="H6013"\w* \w than|strong="H4480"\w* \w the skin|strong="H5785"\w*, \w and the hair in it|strong="H8181"\w* \w has not|strong="H3808"\w* \w turned|strong="H2015"\w* \w white|strong="H3836"\w*, \w the priest|strong="H3548"\w* \w shall isolate|strong="H5462"\w* \w the infected person|strong="H5061"\w* \w for seven|strong="H7651"\w* \w days|strong="H3117"\w*. \v 5 \w On the seventh|strong="H7637"\w* \w day|strong="H3117"\w* \w the priest|strong="H3548"\w* \w is to reexamine him|strong="H7200"\w*, \w and if|strong="H2009"\w* \w he sees|strong="H5869"\w* \w that the infection|strong="H5061"\w* \w is unchanged|strong="H5975"\w* \w and has not|strong="H3808"\w* \w spread|strong="H6581"\w* \w on the skin|strong="H5785"\w*, \w the priest|strong="H3548"\w* \w must isolate him|strong="H5462"\w* \w for another|strong="H8145"\w* \w seven|strong="H7651"\w* \w days|strong="H3117"\w*. \v 6 \w The priest|strong="H3548"\w* \w will examine him|strong="H7200"\w* \w again|strong="H8145"\w* \w on the seventh|strong="H7637"\w* \w day|strong="H3117"\w*, \w and if|strong="H2009"\w* \w the sore|strong="H5061"\w* \w has faded|strong="H3543"\w* \w and has not|strong="H3808"\w* \w spread|strong="H6581"\w* \w on the skin|strong="H5785"\w*, \w the priest|strong="H3548"\w* \w shall pronounce him clean|strong="H2891"\w*; \w it|strong="H1931"\w* \w is a rash|strong="H4556"\w*. \w The person must wash|strong="H3526"\w* \w his clothes|strong="H899"\w* \w and be clean|strong="H2891"\w*.
\p \v 7 \w But if|strong="H518"\w* \w the rash|strong="H4556"\w* \w spreads further|strong="H6581"\w* \w on his skin|strong="H5785"\w* \w after|strong="H310"\w* \w he has shown himself|strong="H7200"\w* \w to|strong="H413"\w* \w the priest|strong="H3548"\w* \w for his cleansing|strong="H2893"\w*, \w he must present himself|strong="H7200"\w* \w again|strong="H8145"\w* \w to|strong="H413"\w* \w the priest|strong="H3548"\w*. \v 8 \w The priest|strong="H3548"\w* \w will reexamine him|strong="H7200"\w*, \w and if|strong="H2009"\w* \w the rash|strong="H4556"\w* \w has spread|strong="H6581"\w* \w on the skin|strong="H5785"\w*, \w the priest|strong="H3548"\w* \w must pronounce him unclean|strong="H2930"\w*; \w it|strong="H1931"\w* \w is a skin disease|strong="H6883"\w*.
\p \v 9 \w When|strong="H3588"\w* \w anyone|strong="H120"\w* \w develops|strong="H1961"\w* \w a skin disease|strong="H5061"\w*, \w he must be brought|strong="H935"\w* \w to|strong="H413"\w* \w the priest|strong="H3548"\w*. \v 10 \w The priest|strong="H3548"\w* \w will examine him|strong="H7200"\w*, \w and if|strong="H2009"\w* \w there is a white|strong="H3836"\w* \w swelling|strong="H7613"\w* \w on the skin|strong="H5785"\w* \w that|strong="H1931"\w* \w has turned|strong="H2015"\w* \w the hair|strong="H8181"\w* \w white|strong="H3836"\w*, \w and there is raw|strong="H2416"\w* \w flesh|strong="H1320"\w* \w in the swelling|strong="H7613"\w*, \v 11 \w it|strong="H1931"\w* \w is a chronic|strong="H3462"\w* \w skin disease|strong="H6883"\w* \w and the priest|strong="H3548"\w* \w must pronounce him unclean|strong="H2930"\w*. \w He need not|strong="H3808"\w* \w isolate him|strong="H5462"\w*, \w for|strong="H3588"\w* \w he|strong="H1931"\w* \w is unclean|strong="H2931"\w*.
\p \v 12 \w But if|strong="H518"\w* \w the skin disease|strong="H6883"\w* \w breaks out|strong="H6524"\w* \w all over his skin|strong="H5785"\w* \w so that it|strong="H6883"\w* \w covers|strong="H3680"\w* \w all|strong="H3605"\w* \w the skin|strong="H5785"\w* \w of the infected person|strong="H5061"\w* \w from head|strong="H7218"\w* \w to|strong="H5704"\w* \w foot|strong="H7272"\w*, \w as far as the priest|strong="H3548"\w* \w can see|strong="H4758"\w*, \v 13 \w the priest|strong="H3548"\w* \w shall examine him|strong="H7200"\w*, \w and if|strong="H2009"\w* \w the disease|strong="H6883"\w* \w has covered|strong="H3680"\w* \w his entire|strong="H3605"\w* \w body|strong="H1320"\w*, \w he is to pronounce the infected person|strong="H5061"\w* \w clean|strong="H2891"\w*. \w Since it has all turned|strong="H2015"\w* \w white|strong="H3836"\w*, \w he|strong="H1931"\w* \w is clean|strong="H2889"\w*.
\p \v 14 \w But whenever|strong="H3117"\w* \w raw|strong="H2416"\w* \w flesh|strong="H1320"\w* \w appears|strong="H7200"\w* on someone, \w he will be unclean|strong="H2930"\w*. \v 15 \w When the priest|strong="H3548"\w* \w sees|strong="H7200"\w* \w the raw|strong="H2416"\w* \w flesh|strong="H1320"\w*, \w he must pronounce him unclean|strong="H2930"\w*. \w The raw|strong="H2416"\w* \w flesh|strong="H1320"\w* \w is unclean|strong="H2931"\w*; \w it|strong="H1931"\w* \w is a skin disease|strong="H6883"\w*. \v 16 \w But|strong="H176"\w* \w if|strong="H3588"\w* \w the raw|strong="H2416"\w* \w flesh|strong="H1320"\w* \w changes|strong="H7725"\w* \w and turns|strong="H2015"\w* \w white|strong="H3836"\w*, \w he must go|strong="H935"\w* \w to|strong="H413"\w* \w the priest|strong="H3548"\w*. \v 17 \w The priest|strong="H3548"\w* \w will reexamine him|strong="H7200"\w*, \w and if|strong="H2009"\w* \w the infection|strong="H5061"\w* \w has turned|strong="H2015"\w* \w white|strong="H3836"\w*, \w the priest|strong="H3548"\w* \w is to pronounce the infected person|strong="H5061"\w* \w clean|strong="H2891"\w*; \w then he|strong="H1931"\w* \w is clean|strong="H2889"\w*.
\p \v 18 \w When|strong="H3588"\w* \w a boil|strong="H7822"\w* \w appears|strong="H1961"\w* \w on someone’s skin|strong="H5785"\w* \w and it heals|strong="H7495"\w*, \v 19 \w and a white|strong="H3836"\w* \w swelling|strong="H7613"\w* \w or|strong="H176"\w* \w a reddish-white|strong="H3836"\w* \w spot|strong="H934"\w* \w develops|strong="H1961"\w* \w where|strong="H4725"\w* \w the boil was|strong="H7822"\w*, \w he must present himself|strong="H7200"\w* \w to|strong="H413"\w* \w the priest|strong="H3548"\w*. \v 20 \w The priest|strong="H3548"\w* \w shall examine it|strong="H7200"\w*, \w and if|strong="H2009"\w* \w it appears|strong="H4758"\w* \w to be beneath|strong="H8217"\w* \w the skin|strong="H5785"\w* \w and the hair in it|strong="H8181"\w* \w has turned|strong="H2015"\w* \w white|strong="H3836"\w*, \w the priest|strong="H3548"\w* \w shall pronounce him unclean|strong="H2930"\w*; \w it|strong="H1931"\w* \w is a diseased infection|strong="H6883"\w* \w that has broken out|strong="H6524"\w* \w in the boil|strong="H7822"\w*.
\p \v 21 \w But when|strong="H518"\w* \w the priest|strong="H3548"\w* \w examines it|strong="H7200"\w*, \w if|strong="H2009"\w* \w there is no|strong="H369"\w* \w white|strong="H3836"\w* \w hair|strong="H8181"\w* in it, \w and it is not|strong="H369"\w* \w beneath|strong="H8217"\w* \w the skin|strong="H5785"\w* \w and has faded|strong="H3544"\w*, \w the priest|strong="H3548"\w* \w shall isolate him|strong="H5462"\w* \w for seven|strong="H7651"\w* \w days|strong="H3117"\w*. \v 22 \w If|strong="H518"\w* \w it spreads any further|strong="H6581"\w* \w on the skin|strong="H5785"\w*, \w the priest|strong="H3548"\w* \w must pronounce him unclean|strong="H2930"\w*; \w it|strong="H1931"\w* \w is an infection|strong="H5061"\w*. \v 23 \w But if|strong="H518"\w* \w the spot|strong="H934"\w* \w remains|strong="H5975"\w* \w unchanged|strong="H8478"\w* \w and does not|strong="H3808"\w* \w spread|strong="H6581"\w*, \w it|strong="H1931"\w* \w is only the scar|strong="H6867"\w* \w from the boil|strong="H7822"\w*, \w and the priest|strong="H3548"\w* \w shall pronounce him clean|strong="H2891"\w*.
\p \v 24 \w When|strong="H3588"\w* \w there is|strong="H1961"\w* \w a burn|strong="H4348"\w* \w on someone’s skin|strong="H5785"\w* \w and the raw|strong="H4241"\w* \w area of the burn|strong="H4348"\w* \w becomes|strong="H1961"\w* \w reddish-white|strong="H3836"\w* \w or|strong="H176"\w* \w white|strong="H3836"\w*, \v 25 \w the priest|strong="H3548"\w* \w must examine it|strong="H7200"\w*. \w If|strong="H2009"\w* \w the hair|strong="H8181"\w* \w in the spot|strong="H934"\w* \w has turned|strong="H2015"\w* \w white|strong="H3836"\w* \w and the spot appears|strong="H4758"\w* \w to be deeper|strong="H6013"\w* \w than|strong="H4480"\w* \w the skin|strong="H5785"\w*, \w it|strong="H1931"\w* \w is a disease|strong="H6883"\w* \w that has broken out|strong="H6524"\w* \w in the burn|strong="H4348"\w*. \w The priest|strong="H3548"\w* \w must pronounce him unclean|strong="H2930"\w*; \w it|strong="H1931"\w* \w is a diseased infection|strong="H6883"\w*.
\p \v 26 \w But if|strong="H518"\w* \w the priest|strong="H3548"\w* \w examines it|strong="H7200"\w* \w and there is|strong="H2009"\w* \w no|strong="H369"\w* \w white|strong="H3836"\w* \w hair|strong="H8181"\w* \w in the spot|strong="H934"\w*, \w and it is not|strong="H369"\w* \w beneath|strong="H8217"\w* \w the skin|strong="H5785"\w* \w but has faded|strong="H3544"\w*, \w the priest|strong="H3548"\w* \w shall isolate him|strong="H5462"\w* \w for seven|strong="H7651"\w* \w days|strong="H3117"\w*. \v 27 \w On the seventh|strong="H7637"\w* \w day|strong="H3117"\w* \w the priest|strong="H3548"\w* \w is to reexamine him|strong="H7200"\w*, \w and if|strong="H518"\w* \w it has spread further|strong="H6581"\w* \w on the skin|strong="H5785"\w*, \w the priest|strong="H3548"\w* \w must pronounce him unclean|strong="H2930"\w*; \w it|strong="H1931"\w* \w is a diseased infection|strong="H6883"\w*. \v 28 \w But if|strong="H518"\w* \w the spot|strong="H934"\w* \w is unchanged|strong="H5975"\w* \w and has not|strong="H3808"\w* \w spread|strong="H6581"\w* \w on the skin|strong="H5785"\w* \w but has faded|strong="H3544"\w*, \w it|strong="H1931"\w* \w is a swelling|strong="H7613"\w* \w from the burn|strong="H4348"\w*, \w and the priest|strong="H3548"\w* \w is to pronounce him clean|strong="H2891"\w*; \w for|strong="H3588"\w* \w it|strong="H1931"\w* \w is only the scar|strong="H6867"\w* \w from the burn|strong="H4348"\w*.
\p \v 29 \w If|strong="H3588"\w* \w a man|strong="H376"\w* \w or|strong="H176"\w* \w woman|strong="H802"\w* \w has|strong="H1961"\w* \w an infection|strong="H5061"\w* \w on the head|strong="H7218"\w* \w or|strong="H176"\w* \w chin|strong="H2206"\w*, \v 30 \w the priest|strong="H3548"\w* \w shall examine|strong="H7200"\w* \w the infection|strong="H5061"\w*, \w and if|strong="H2009"\w* \w it appears|strong="H4758"\w* \w to be deeper|strong="H6013"\w* \w than|strong="H4480"\w* \w the skin|strong="H5785"\w* and \w the hair in it|strong="H8181"\w* \w is yellow|strong="H6669"\w* \w and thin|strong="H1851"\w*, \w the priest|strong="H3548"\w* \w must pronounce him unclean|strong="H2930"\w*; \w it|strong="H1931"\w* \w is a scaly outbreak|strong="H5424"\w*, \w an infectious disease|strong="H6883"\w* \w of the head|strong="H7218"\w* \w or|strong="H176"\w* \w chin|strong="H2206"\w*.
\p \v 31 \w But if|strong="H3588"\w* \w the priest|strong="H3548"\w* \w examines|strong="H7200"\w* \w the scaly|strong="H5424"\w* \w infection|strong="H5061"\w* \w and|strong="H2009"\w* \w it does not|strong="H369"\w* \w appear|strong="H4758"\w* \w to be deeper|strong="H6013"\w* \w than|strong="H4480"\w* \w the skin|strong="H5785"\w*, \w and there is no|strong="H369"\w* \w black|strong="H7838"\w* \w hair|strong="H8181"\w* in it, \w the priest|strong="H3548"\w* \w shall isolate|strong="H5462"\w* \w the infected person|strong="H5424"\w* \w for seven|strong="H7651"\w* \w days|strong="H3117"\w*. \v 32 \w On the seventh|strong="H7637"\w* \w day|strong="H3117"\w* \w the priest|strong="H3548"\w* \w is to reexamine|strong="H7200"\w* \w the infection|strong="H5061"\w*, \w and if|strong="H2009"\w* \w the scaly outbreak|strong="H5424"\w* \w has not|strong="H3808"\w* \w spread|strong="H6581"\w* \w and there is|strong="H1961"\w* \w no|strong="H3808"\w* \w yellow|strong="H6669"\w* \w hair|strong="H8181"\w* in it, \w and it|strong="H5424"\w* \w does not|strong="H369"\w* \w appear|strong="H4758"\w* \w to be deeper|strong="H6013"\w* \w than|strong="H4480"\w* \w the skin|strong="H5785"\w*, \v 33 \w then the person must shave himself|strong="H1548"\w* \w except for|strong="H853"\w* \w the scaly area|strong="H5424"\w*. \w Then the priest|strong="H3548"\w* \w shall isolate|strong="H5462"\w* \w him|strong="H5424"\w* \w for another|strong="H8145"\w* \w seven|strong="H7651"\w* \w days|strong="H3117"\w*. \v 34 \w On the seventh|strong="H7637"\w* \w day|strong="H3117"\w* \w the priest|strong="H3548"\w* \w shall examine|strong="H7200"\w* \w the scaly outbreak|strong="H5424"\w*, \w and if|strong="H2009"\w* \w it|strong="H5424"\w* \w has not|strong="H3808"\w* \w spread|strong="H6581"\w* \w on the skin|strong="H5785"\w* \w and does not|strong="H369"\w* \w appear to be|strong="H4758"\w* \w deeper|strong="H6013"\w* \w than|strong="H4480"\w* \w the skin|strong="H5785"\w*, \w the priest|strong="H3548"\w* \w is to pronounce him clean|strong="H2891"\w*. \w He must wash|strong="H3526"\w* \w his clothes|strong="H899"\w*, \w and he will be clean|strong="H2891"\w*.
\p \v 35 \w If, however|strong="H518"\w*, \w the scaly outbreak|strong="H5424"\w* \w spreads further|strong="H6581"\w* \w on the skin|strong="H5785"\w* \w after|strong="H310"\w* \w his cleansing|strong="H2893"\w*, \v 36 \w the priest|strong="H3548"\w* \w is to examine him|strong="H7200"\w*, \w and if|strong="H2009"\w* \w the scaly outbreak|strong="H5424"\w* \w has spread|strong="H6581"\w* \w on the skin|strong="H5785"\w*, \w the priest|strong="H3548"\w* \w need not|strong="H3808"\w* \w look for|strong="H1239"\w* \w yellow|strong="H6669"\w* \w hair|strong="H8181"\w*; \w the person|strong="H1931"\w* \w is unclean|strong="H2931"\w*.
\p \v 37 \w If, however|strong="H518"\w*, \w in his sight|strong="H5869"\w* \w the scaly outbreak|strong="H5424"\w* \w is unchanged|strong="H5975"\w* \w and black|strong="H7838"\w* \w hair|strong="H8181"\w* \w has grown|strong="H6779"\w* in it, \w then it|strong="H5424"\w* \w has healed|strong="H7495"\w*. \w He|strong="H1931"\w* \w is clean|strong="H2889"\w*, \w and the priest|strong="H3548"\w* \w is to pronounce him clean|strong="H2891"\w*.
\p \v 38 \w When|strong="H3588"\w* \w a man|strong="H376"\w* \w or|strong="H176"\w* \w a woman|strong="H802"\w* \w has white|strong="H3836"\w* \w spots|strong="H934"\w* \w on the skin|strong="H5785"\w*, \v 39 \w the priest|strong="H3548"\w* \w shall examine them|strong="H7200"\w*, \w and if|strong="H2009"\w* \w the spots|strong="H934"\w* \w are dull|strong="H3544"\w* \w white|strong="H3836"\w*, \w it|strong="H1931"\w* \w is a harmless rash|strong="H933"\w* \w that has broken out|strong="H6524"\w* \w on the skin|strong="H5785"\w*; \w the person|strong="H1931"\w* \w is clean|strong="H2889"\w*.
\p \v 40 \w Now if|strong="H3588"\w* \w a man|strong="H376"\w* \w loses his hair|strong="H4803"\w* \w and is bald|strong="H7142"\w*, \w he is still|strong="H1931"\w* \w clean|strong="H2889"\w*. \v 41 \w Or if|strong="H518"\w* \w his hairline|strong="H6285"\w* \w recedes|strong="H4803"\w* \w and he|strong="H1931"\w* \w is bald on his forehead|strong="H1371"\w*, \w he is still|strong="H1931"\w* \w clean|strong="H2889"\w*. \v 42 \w But if|strong="H3588"\w* \w there is|strong="H1961"\w* \w a reddish-white|strong="H3836"\w* \w sore|strong="H5061"\w* \w on the bald head|strong="H7146"\w* \w or|strong="H176"\w* \w forehead|strong="H1372"\w*, \w it|strong="H1931"\w* \w is an infectious disease|strong="H6883"\w* \w breaking out|strong="H6524"\w* \w on it|strong="H7146"\w*. \v 43 \w The priest|strong="H3548"\w* \w is to examine him|strong="H7200"\w*, \w and if|strong="H2009"\w* \w the swelling|strong="H7613"\w* \w of the infection|strong="H5061"\w* \w on his bald head|strong="H7146"\w* \w or|strong="H176"\w* \w forehead|strong="H1372"\w* \w is reddish-white|strong="H3836"\w* \w like|strong="H4758"\w* \w a skin|strong="H5785"\w* \w disease|strong="H6883"\w*, \v 44 \w the man|strong="H376"\w* \w is diseased|strong="H6879"\w*; \w he|strong="H1931"\w* \w is unclean|strong="H2931"\w*. \w The priest|strong="H3548"\w* \w must pronounce him unclean|strong="H2930"\w* \w because of the infection|strong="H5061"\w* \w on his head|strong="H7218"\w*.
\p \v 45 \w A diseased person|strong="H5061"\w* \w must wear torn clothes|strong="H899"\w* \w and let his hair|strong="H7218"\w* \w hang loose|strong="H6544"\w*,\f + \fr 13:45 \ft Or \fqa uncover his head\f* \w and he must cover|strong="H5844"\w* \w his mouth|strong="H8222"\w* \w and cry out|strong="H7121"\w*, ‘\w Unclean|strong="H2931"\w*, \w unclean|strong="H2931"\w*!’ \v 46 \w As|strong="H3605"\w* \w long as|strong="H3117"\w* \w he has the infection|strong="H5061"\w*, \w he remains|strong="H2930"\w* \w unclean|strong="H2931"\w*. \w He must live alone|strong="H3427"\w* \w in a place|strong="H4186"\w* \w outside|strong="H2351"\w* \w the camp|strong="H4264"\w*.
\s1 Laws about Mildew
\p \v 47 \w If|strong="H3588"\w* \w any fabric|strong="H899"\w* \w is|strong="H1961"\w* \w contaminated|strong="H5061"\w* \w with mildew|strong="H6883"\w*\f + \fr 13:47 \ft Forms of the Hebrew \fqa tzaraath\ft , traditionally translated as \fqa leprosy \ft regarding skin diseases, are translated as \fqa mildew \ft regarding blemishes on garments, utensils, or buildings; here and throughout the remainder of this chapter.\f*— \w any wool|strong="H6785"\w* \w or|strong="H176"\w* \w linen|strong="H6593"\w* \w garment|strong="H899"\w*, \v 48 \w any weave|strong="H8359"\w* \w or|strong="H176"\w* \w knit|strong="H6154"\w* \w of linen|strong="H6593"\w* \w or wool|strong="H6785"\w*, \w or|strong="H176"\w* \w any article of leather|strong="H5785"\w*— \v 49 \w and if the mark|strong="H5061"\w* \w in the fabric|strong="H899"\w*, \w leather|strong="H5785"\w*, \w weave|strong="H8359"\w*, \w knit|strong="H6154"\w*, \w or|strong="H176"\w* \w leather|strong="H5785"\w* \w article|strong="H3627"\w* \w is|strong="H1961"\w* \w green|strong="H3422"\w* \w or|strong="H176"\w* \w red|strong="H125"\w*, \w then it is|strong="H1931"\w* \w contaminated|strong="H5061"\w* \w with mildew|strong="H6883"\w* \w and must be shown|strong="H7200"\w* \w to the priest|strong="H3548"\w*. \v 50 \w And the priest|strong="H3548"\w* \w is to examine|strong="H7200"\w* \w the mildew|strong="H5061"\w* \w and isolate|strong="H5462"\w* \w the contaminated fabric|strong="H5061"\w* \w for seven|strong="H7651"\w* \w days|strong="H3117"\w*.
\p \v 51 \w On the seventh|strong="H7637"\w* \w day|strong="H3117"\w* \w the priest shall reexamine|strong="H7200"\w* \w it|strong="H853"\w*, \w and if|strong="H3588"\w* \w the mildew|strong="H5061"\w* \w has spread|strong="H6581"\w* \w in the fabric|strong="H899"\w*, \w weave|strong="H8359"\w*, \w knit|strong="H6154"\w*, \w or|strong="H176"\w* \w leather|strong="H5785"\w*, \w then regardless of|strong="H3605"\w* \w how|strong="H834"\w* \w it|strong="H5785"\w* \w is used|strong="H6213"\w*, \w it|strong="H5061"\w* \w is a harmful|strong="H3992"\w* \w mildew|strong="H6883"\w*; \w the article|strong="H1931"\w* \w is unclean|strong="H2931"\w*. \v 52 \w He is to burn|strong="H8313"\w* \w the fabric|strong="H899"\w*, \w weave|strong="H8359"\w*, \w or|strong="H176"\w* \w knit|strong="H6154"\w*, \w whether|strong="H176"\w* \w the contaminated item is|strong="H5061"\w* \w wool|strong="H6785"\w* \w or linen|strong="H6593"\w* \w or|strong="H176"\w* \w leather|strong="H5785"\w*. \w Since|strong="H3588"\w* \w the mildew|strong="H6883"\w* \w is harmful|strong="H3992"\w*, \w the article|strong="H1931"\w* \w must be burned up|strong="H784"\w*.
\p \v 53 \w But when|strong="H518"\w* \w the priest|strong="H3548"\w* \w reexamines it|strong="H7200"\w*, \w if|strong="H2009"\w* \w the mildew|strong="H5061"\w* \w has not|strong="H3808"\w* \w spread|strong="H6581"\w* \w in the fabric|strong="H899"\w*, \w weave|strong="H8359"\w*, \w knit|strong="H6154"\w*, \w or|strong="H176"\w* \w leather|strong="H5785"\w* \w article|strong="H3627"\w*, \v 54 \w the priest|strong="H3548"\w* \w is to order|strong="H6680"\w* \w the|strong="H834"\w* \w contaminated article|strong="H5061"\w* \w to be washed|strong="H3526"\w* \w and isolated|strong="H5462"\w* \w for another|strong="H8145"\w* \w seven|strong="H7651"\w* \w days|strong="H3117"\w*. \v 55 \w After|strong="H310"\w* \w it has been washed|strong="H3526"\w*, \w the priest|strong="H3548"\w* \w is to reexamine it|strong="H7200"\w*, \w and if|strong="H2009"\w* \w the mildewed|strong="H5061"\w* \w article|strong="H5061"\w* \w has not|strong="H3808"\w* \w changed|strong="H2015"\w* \w in appearance|strong="H5869"\w*, \w it|strong="H1931"\w* \w is unclean|strong="H2931"\w*. \w Even though the mildew|strong="H5061"\w* \w has not|strong="H3808"\w* \w spread|strong="H6581"\w*, \w you must burn it|strong="H8313"\w*, \w whether|strong="H1931"\w* \w the rot is|strong="H6356"\w* \w on the front|strong="H1372"\w* \w or|strong="H176"\w* \w back|strong="H7146"\w*.
\p \v 56 \w If|strong="H518"\w* \w the priest|strong="H3548"\w* \w examines it|strong="H7200"\w* \w and the mildew|strong="H5061"\w* \w has faded|strong="H3543"\w* \w after|strong="H310"\w* \w it has been washed|strong="H3526"\w*, \w he must cut the contaminated section out|strong="H7167"\w* \w of|strong="H4480"\w* \w the fabric|strong="H899"\w*, \w leather|strong="H5785"\w*, \w weave|strong="H8359"\w*, \w or|strong="H176"\w* \w knit|strong="H6154"\w*. \v 57 \w But if|strong="H518"\w* \w it reappears|strong="H7200"\w* \w in the fabric|strong="H899"\w*, \w weave|strong="H8359"\w*, \w or|strong="H176"\w* \w knit|strong="H6154"\w*, \w or|strong="H176"\w* \w on any|strong="H3605"\w* \w leather|strong="H5785"\w* \w article|strong="H3627"\w*, \w it|strong="H1931"\w* \w is spreading|strong="H6524"\w*. \w You must burn|strong="H8313"\w* \w the contaminated|strong="H5061"\w* \w article|strong="H834"\w*.
\p \v 58 \w If the mildew|strong="H5061"\w* \w disappears|strong="H5493"\w* from \w the fabric|strong="H899"\w*, \w weave|strong="H8359"\w*, \w or|strong="H176"\w* \w knit|strong="H6154"\w*, \w or|strong="H176"\w* \w any|strong="H3605"\w* \w leather|strong="H5785"\w* \w article|strong="H3627"\w* \w after|strong="H834"\w* \w washing|strong="H3526"\w*, \w then it is to be washed|strong="H3526"\w* \w again|strong="H8145"\w*, \w and it will be clean|strong="H2891"\w*.
\p \v 59 \w This|strong="H2063"\w* \w is the law|strong="H8451"\w* \w concerning a mildew|strong="H6883"\w* \w contamination|strong="H5061"\w* \w in wool|strong="H6785"\w* \w or|strong="H176"\w* \w linen|strong="H6593"\w* \w fabric|strong="H899"\w*, \w weave|strong="H8359"\w*, \w or|strong="H176"\w* \w knit|strong="H6154"\w*, \w or|strong="H176"\w* \w any|strong="H3605"\w* \w leather|strong="H5785"\w* \w article|strong="H3627"\w*, \w for pronouncing it clean|strong="H2891"\w* \w or|strong="H176"\w* \w unclean|strong="H2930"\w*.”
\c 14
\s1 Cleansing from Skin Diseases
\r (\ref Matthew 8:1–4|MAT 8:1-4\ref*; \ref Mark 1:40–45|MRK 1:40-45\ref*; \ref Luke 5:12–16|LUK 5:12-16\ref*)
\p \v 1 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 2 “\w This|strong="H2063"\w* \w is|strong="H1961"\w* \w the law|strong="H8451"\w* \w for the one afflicted with a skin disease|strong="H6879"\w*\f + \fr 14:2 \ft Forms of the Hebrew \fqa tzaraath\ft , traditionally translated as \fqa leprosy\ft , were used for various skin diseases; also in verses 3, 7, 32, 54, and 57.\f* \w on the day|strong="H3117"\w* \w of his cleansing|strong="H2893"\w*, \w when he is brought|strong="H935"\w* \w to|strong="H413"\w* \w the priest|strong="H3548"\w*. \v 3 \w The priest|strong="H3548"\w* \w is to go|strong="H3318"\w* \w outside|strong="H2351"\w* \w the camp|strong="H4264"\w* \w to examine him|strong="H7200"\w*, \w and if|strong="H2009"\w* \w the skin disease|strong="H6883"\w* \w of|strong="H4480"\w* \w the afflicted person|strong="H6879"\w* \w has healed|strong="H7495"\w*, \v 4 \w the priest|strong="H3548"\w* \w shall order|strong="H6680"\w* \w that two|strong="H8147"\w* \w live|strong="H2416"\w* \w clean|strong="H2889"\w* \w birds|strong="H6833"\w*, \w cedar|strong="H730"\w* \w wood|strong="H6086"\w*, \w scarlet yarn|strong="H8144"\w*, \w and hyssop|strong="H231"\w* \w be brought|strong="H3947"\w* \w for the one to be cleansed|strong="H2891"\w*.
\p \v 5 \w Then the priest|strong="H3548"\w* \w shall command|strong="H6680"\w* \w that one|strong="H259"\w* \w of the birds|strong="H6833"\w* \w be slaughtered|strong="H7819"\w* \w over|strong="H5921"\w* \w fresh|strong="H2416"\w* \w water|strong="H4325"\w*\f + \fr 14:5 \ft Or \fqa flowing water \ft or \fqa living water\ft ; here and in verses 6, 50, 51, and 52\f* \w in|strong="H413"\w* \w a clay|strong="H2789"\w* \w pot|strong="H3627"\w*. \v 6 \w And he is to take|strong="H3947"\w* \w the live|strong="H2416"\w* \w bird|strong="H6833"\w* \w together with the cedar|strong="H730"\w* \w wood|strong="H6086"\w*, \w scarlet yarn|strong="H8144"\w*, \w and hyssop|strong="H231"\w*, \w and dip|strong="H2881"\w* \w them|strong="H853"\w* \w into the blood|strong="H1818"\w* \w of the bird|strong="H6833"\w* \w that was slaughtered|strong="H7819"\w* \w over|strong="H5921"\w* \w the fresh|strong="H2416"\w* \w water|strong="H4325"\w*. \v 7 \w Seven|strong="H7651"\w* \w times|strong="H6471"\w* \w he shall sprinkle|strong="H5137"\w* \w the one to be cleansed|strong="H2891"\w* \w of|strong="H4480"\w* \w the skin disease|strong="H6883"\w*. \w Then he shall pronounce him clean|strong="H2891"\w* \w and release|strong="H7971"\w* \w the live|strong="H2416"\w* \w bird|strong="H6833"\w* \w into|strong="H5921"\w* \w the open|strong="H6440"\w* \w field|strong="H7704"\w*.
\p \v 8 \w The one being cleansed|strong="H2891"\w* \w must wash|strong="H3526"\w* \w his clothes|strong="H899"\w*, \w shave off|strong="H1548"\w* \w all|strong="H3605"\w* \w his hair|strong="H8181"\w*, \w and bathe|strong="H7364"\w* \w with water|strong="H4325"\w*; \w then he will be ceremonially clean|strong="H2891"\w*. \w Afterward|strong="H310"\w*, \w he may enter|strong="H935"\w* \w the camp|strong="H4264"\w*, \w but he must remain|strong="H3427"\w* \w outside|strong="H2351"\w* \w his tent|strong="H168"\w* \w for seven|strong="H7651"\w* \w days|strong="H3117"\w*. \v 9 \w On the seventh|strong="H7637"\w* \w day|strong="H3117"\w* \w he must shave off|strong="H1548"\w* \w all|strong="H3605"\w* \w his hair|strong="H8181"\w* — \w his head|strong="H7218"\w*, \w his beard|strong="H2206"\w*, \w his eyebrows|strong="H1354"\w*, \w and the rest|strong="H3605"\w* \w of his hair|strong="H8181"\w*. \w He must wash|strong="H3526"\w* \w his clothes|strong="H899"\w* \w and bathe|strong="H7364"\w* \w himself|strong="H1320"\w* \w with water|strong="H4325"\w*, \w and he will be clean|strong="H2891"\w*.
\p \v 10 \w On the eighth|strong="H8066"\w* \w day|strong="H3117"\w* \w he is to bring|strong="H3947"\w* \w two|strong="H8147"\w* \w unblemished|strong="H8549"\w* \w male lambs|strong="H3532"\w*, \w an|strong="H259"\w* \w unblemished|strong="H8549"\w* \w ewe lamb|strong="H3535"\w* \w a year old|strong="H1323"\w*, \w a grain offering|strong="H4503"\w* \w of three-tenths of an ephah|strong="H7969"\w* \w of fine flour|strong="H5560"\w*\f + \fr 14:10 \fqa Three-tenths of an ephah \ft is approximately 6 dry quarts or 6.6 liters (probably about 7.6 pounds or 3.5 kilograms of flour).\f* \w mixed|strong="H1101"\w* \w with olive oil|strong="H8081"\w*, \w and one|strong="H259"\w* \w log|strong="H3849"\w* \w of olive oil|strong="H8081"\w*.\f + \fr 14:10 \ft Or \fqa one log of oil\ft ; that is, approximately 0.33 quarts or 0.31 liters; also in verses 12, 15, 21, and 24\f* \v 11 \w The priest|strong="H3548"\w* \w who performs the cleansing|strong="H2891"\w* \w shall present|strong="H5975"\w* \w the one|strong="H376"\w* \w to be cleansed|strong="H2891"\w*, \w together with these offerings|strong="H854"\w*, \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w at the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*.
\p \v 12 \w Then the priest|strong="H3548"\w* \w is to take|strong="H3947"\w* \w one|strong="H259"\w* \w of the male lambs|strong="H3532"\w* \w and present|strong="H7126"\w* \w it as a guilt offering|strong="H817"\w*, \w along with the log|strong="H3849"\w* \w of olive oil|strong="H8081"\w*; \w and he must wave|strong="H5130"\w* \w them|strong="H853"\w* \w as a wave offering|strong="H8573"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*. \v 13 \w Then he is to slaughter|strong="H7819"\w* \w the lamb|strong="H3532"\w* \w in the sanctuary|strong="H6944"\w* \w area|strong="H4725"\w* \w where|strong="H834"\w* \w the sin offering|strong="H2403"\w* \w and burnt offering|strong="H5930"\w* \w are slaughtered|strong="H7819"\w*. \w Like|strong="H3588"\w* \w the sin offering|strong="H2403"\w*, \w the guilt offering|strong="H817"\w* \w belongs to the priest|strong="H3548"\w*; \w it|strong="H1931"\w* \w is most|strong="H6944"\w* \w holy|strong="H6944"\w*.
\p \v 14 \w The priest|strong="H3548"\w* \w is to take|strong="H3947"\w* \w some of the blood|strong="H1818"\w* \w from the guilt offering|strong="H817"\w* \w and put it|strong="H5414"\w* \w on|strong="H5921"\w* \w the right|strong="H3233"\w* \w earlobe|strong="H241"\w* \w of the one to be cleansed|strong="H2891"\w*, \w on|strong="H5921"\w* \w the thumb|strong="H931"\w* \w of his right|strong="H3233"\w* \w hand|strong="H3027"\w*, \w and on|strong="H5921"\w* \w the big toe|strong="H931"\w* \w of his right|strong="H3233"\w* \w foot|strong="H7272"\w*. \v 15 \w Then the priest|strong="H3548"\w* \w shall take|strong="H3947"\w* \w some of the log|strong="H3849"\w* \w of olive oil|strong="H8081"\w*, \w pour|strong="H3332"\w* \w it into|strong="H5921"\w* \w his|strong="H3548"\w* \w left|strong="H8042"\w* \w palm|strong="H3709"\w*, \v 16 \w dip|strong="H2881"\w* \w his right|strong="H3233"\w* \w forefinger|strong="H676"\w* \w into|strong="H4480"\w* \w the oil|strong="H8081"\w* \w in|strong="H5921"\w* \w his left|strong="H8042"\w* \w palm|strong="H3709"\w*, \w and sprinkle|strong="H5137"\w* \w some of|strong="H4480"\w* \w the oil|strong="H8081"\w* \w with his finger|strong="H676"\w* \w seven|strong="H7651"\w* \w times|strong="H6471"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*. \v 17 \w And the priest|strong="H3548"\w* \w is to put|strong="H5414"\w* \w some|strong="H5921"\w* \w of the oil|strong="H8081"\w* \w remaining|strong="H3499"\w* \w in|strong="H5921"\w* \w his palm|strong="H3709"\w* \w on the right|strong="H3233"\w* \w earlobe|strong="H241"\w* \w of the one to be cleansed|strong="H2891"\w*, \w on|strong="H5921"\w* \w the thumb|strong="H931"\w* \w of his right|strong="H3233"\w* \w hand|strong="H3027"\w*, \w and on|strong="H5921"\w* \w the big toe|strong="H931"\w* \w of his right|strong="H3233"\w* \w foot|strong="H7272"\w*, \w on top of|strong="H5921"\w* \w the blood|strong="H1818"\w* \w of the guilt offering|strong="H817"\w*.
\p \v 18 \w The rest|strong="H3498"\w* \w of the oil|strong="H8081"\w* \w in his|strong="H5921"\w* \w palm|strong="H3709"\w*, \w the priest|strong="H3548"\w* \w is to put|strong="H5414"\w* \w on|strong="H5921"\w* \w the head|strong="H7218"\w* \w of the one to be cleansed|strong="H2891"\w*, \w to make atonement|strong="H3722"\w* \w for him|strong="H5921"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*. \v 19 \w Then the priest|strong="H3548"\w* \w is to sacrifice|strong="H6213"\w* \w the sin offering|strong="H2403"\w* \w and make atonement|strong="H3722"\w* \w for|strong="H5921"\w* \w the one to be cleansed|strong="H2891"\w* \w from his uncleanness|strong="H2932"\w*. \w After that|strong="H310"\w*, \w the priest shall slaughter|strong="H7819"\w* \w the burnt offering|strong="H5930"\w* \v 20 \w and offer|strong="H5927"\w* \w it|strong="H5930"\w* \w on the altar|strong="H4196"\w*, \w with|strong="H853"\w* \w the grain offering|strong="H4503"\w*, \w to make atonement|strong="H3722"\w* \w for him|strong="H5921"\w*, \w and he will be clean|strong="H2891"\w*.
\p \v 21 \w If, however|strong="H518"\w*, \w the person|strong="H1931"\w* \w is poor|strong="H1800"\w* \w and cannot|strong="H369"\w* \w afford these offerings|strong="H3027"\w*, \w he is to take|strong="H3947"\w* \w one|strong="H259"\w* \w male lamb|strong="H3532"\w* \w as a guilt offering|strong="H817"\w* \w to be waved|strong="H8573"\w* \w to make atonement|strong="H3722"\w* \w for him|strong="H5921"\w*, \w along with a tenth of an ephah|strong="H6241"\w* \w of fine flour|strong="H5560"\w*\f + \fr 14:21 \fqa A tenth of an ephah \ft is approximately 2 dry quarts or 2.2 liters (probably about 2.6 pounds or 1.2 kilograms of flour).\f* \w mixed|strong="H1101"\w* \w with olive oil|strong="H8081"\w* \w for a grain offering|strong="H4503"\w*, \w a log|strong="H3849"\w* \w of olive oil|strong="H8081"\w*, \v 22 \w and two|strong="H8147"\w* \w turtledoves|strong="H8449"\w* \w or|strong="H176"\w* \w two|strong="H8147"\w* \w young|strong="H1121"\w* \w pigeons|strong="H3123"\w*, \w whichever|strong="H834"\w* \w he can afford|strong="H5381"\w*, \w one|strong="H259"\w* \w to be|strong="H1961"\w* \w a sin offering|strong="H2403"\w* \w and the other|strong="H259"\w* \w a burnt offering|strong="H5930"\w*.
\p \v 23 \w On the eighth|strong="H8066"\w* \w day|strong="H3117"\w* \w he is to bring|strong="H935"\w* \w them|strong="H853"\w* \w for his cleansing|strong="H2893"\w* \w to|strong="H413"\w* \w the priest|strong="H3548"\w* \w at|strong="H413"\w* \w the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*. \v 24 \w The priest|strong="H3548"\w* \w shall take|strong="H3947"\w* \w the lamb|strong="H3532"\w* \w for the guilt offering|strong="H817"\w*, \w along with|strong="H853"\w* \w the log|strong="H3849"\w* \w of olive oil|strong="H8081"\w*, \w and wave|strong="H5130"\w* \w them|strong="H853"\w* \w as a wave offering|strong="H8573"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*.
\p \v 25 \w And after he slaughters|strong="H7819"\w* \w the lamb|strong="H3532"\w* \w for the guilt offering|strong="H817"\w*, \w the priest|strong="H3548"\w* \w is to take|strong="H3947"\w* \w some of the blood|strong="H1818"\w* \w of the guilt offering|strong="H817"\w* \w and put|strong="H5414"\w* \w it on|strong="H5921"\w* \w the right|strong="H3233"\w* \w earlobe|strong="H8571"\w* \w of the one to be cleansed|strong="H2891"\w*, \w on|strong="H5921"\w* \w the thumb|strong="H931"\w* \w of his right|strong="H3233"\w* \w hand|strong="H3027"\w*, \w and on|strong="H5921"\w* \w the big toe|strong="H931"\w* \w of his right|strong="H3233"\w* \w foot|strong="H7272"\w*. \v 26 \w Then the priest|strong="H3548"\w* \w is to pour|strong="H3332"\w* \w some of|strong="H4480"\w* \w the oil|strong="H8081"\w* \w into|strong="H5921"\w* \w his|strong="H3548"\w* \w left|strong="H8042"\w* \w palm|strong="H3709"\w* \v 27 \w and sprinkle|strong="H5137"\w* \w with his right|strong="H3233"\w* \w forefinger|strong="H676"\w* \w some of|strong="H4480"\w* \w the oil|strong="H8081"\w* \w in|strong="H5921"\w* \w his left|strong="H8042"\w* \w palm|strong="H3709"\w* \w seven|strong="H7651"\w* \w times|strong="H6471"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*. \v 28 \w The priest|strong="H3548"\w* \w shall also put|strong="H5414"\w* \w some of|strong="H4480"\w* \w the oil|strong="H8081"\w* \w in|strong="H5921"\w* \w his palm|strong="H3709"\w* \w on|strong="H5921"\w* \w the right|strong="H3233"\w* \w earlobe|strong="H8571"\w* \w of the one to be cleansed|strong="H2891"\w*, \w on|strong="H5921"\w* \w the thumb|strong="H931"\w* \w of his right|strong="H3233"\w* \w hand|strong="H3027"\w*, \w and on|strong="H5921"\w* \w the big toe|strong="H931"\w* \w of his right|strong="H3233"\w* \w foot|strong="H7272"\w* — \w on|strong="H5921"\w* \w the same places|strong="H4725"\w* \w as the blood|strong="H1818"\w* \w of the guilt offering|strong="H817"\w*.
\p \v 29 \w The rest|strong="H3498"\w* \w of|strong="H4480"\w* \w the oil|strong="H8081"\w* \w in his|strong="H5921"\w* \w palm|strong="H3709"\w*, \w the priest|strong="H3548"\w* \w is to put|strong="H5414"\w* \w on|strong="H5921"\w* \w the head|strong="H7218"\w* \w of the one to be cleansed|strong="H2891"\w*, \w to make atonement|strong="H3722"\w* \w for him|strong="H5921"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*. \v 30 \w Then he must sacrifice|strong="H6213"\w* \w the turtledoves|strong="H8449"\w* \w or|strong="H176"\w* \w young|strong="H1121"\w* \w pigeons|strong="H3123"\w*, \w whichever|strong="H834"\w* \w he can afford|strong="H5381"\w*, \v 31 \w one|strong="H259"\w* \w as a sin offering|strong="H2403"\w* \w and the other|strong="H259"\w* \w as a burnt offering|strong="H5930"\w*,\f + \fr 14:31 \ft LXX and Syriac; Hebrew includes \fqa as he is able to afford,\f* \w together with|strong="H5921"\w* \w the grain offering|strong="H4503"\w*. \w In this way the priest|strong="H3548"\w* \w will make atonement|strong="H3722"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w for|strong="H5921"\w* \w the one to be cleansed|strong="H2891"\w*.
\p \v 32 \w This|strong="H2063"\w* \w is the law|strong="H8451"\w* \w for someone who has|strong="H834"\w* \w a skin disease|strong="H6883"\w* \w and cannot|strong="H3808"\w* \w afford|strong="H5381"\w* \w the cost of his cleansing|strong="H2893"\w*.”
\s1 Signs of Home Contamination
\p \v 33 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w* \w and Aaron|strong="H175"\w*, \v 34 “\w When|strong="H3588"\w* \w you enter|strong="H935"\w* \w the land|strong="H776"\w* \w of Canaan|strong="H3667"\w*, \w which|strong="H834"\w* \w I|strong="H589"\w* \w am giving|strong="H5414"\w* you \w as your possession|strong="H272"\w*, \w and I put|strong="H5414"\w* \w a contamination|strong="H5061"\w* \w of mildew|strong="H6883"\w*\f + \fr 14:34 \ft Forms of the Hebrew \fqa tzaraath\ft , traditionally translated as \fqa leprosy \ft regarding skin diseases, are translated as \fqa mildew \ft regarding blemishes on garments, utensils, or buildings; here and throughout the remainder of this chapter.\f* \w into a house|strong="H1004"\w* \w in that land|strong="H776"\w*, \v 35 \w the owner|strong="H834"\w* \w of the house|strong="H1004"\w* \w shall come|strong="H935"\w* \w and tell|strong="H5046"\w* \w the priest|strong="H3548"\w*, ‘\w Something like mildew|strong="H5061"\w* \w has appeared|strong="H7200"\w* in my \w house|strong="H1004"\w*.’
\p \v 36 \w The priest|strong="H3548"\w* \w must order that|strong="H6680"\w* \w the house|strong="H1004"\w* \w be cleared|strong="H6437"\w* \w before|strong="H2962"\w* \w he|strong="H3548"\w* \w enters it|strong="H935"\w* \w to examine|strong="H7200"\w* \w the mildew|strong="H5061"\w*, \w so that nothing|strong="H3808"\w* \w in the house|strong="H1004"\w* \w will become unclean|strong="H2930"\w*. \w After|strong="H310"\w* \w this|strong="H3651"\w*, \w the priest|strong="H3548"\w* \w shall go in|strong="H935"\w* \w to inspect|strong="H7200"\w* \w the house|strong="H1004"\w*.
\p \v 37 \w He is to examine|strong="H7200"\w* \w the house|strong="H5061"\w*, \w and if|strong="H2009"\w* \w the mildew|strong="H5061"\w* \w on the walls|strong="H7023"\w* \w consists of green|strong="H3422"\w* \w or|strong="H176"\w* \w red|strong="H125"\w* \w depressions|strong="H8258"\w* \w that appear|strong="H4758"\w* \w to be beneath|strong="H8217"\w* \w the surface of the wall|strong="H7023"\w*, \v 38 \w the priest|strong="H3548"\w* \w shall go outside|strong="H3318"\w* \w the doorway|strong="H6607"\w* \w of the house|strong="H1004"\w* \w and close|strong="H5462"\w* \w it up|strong="H1004"\w* \w for seven|strong="H7651"\w* \w days|strong="H3117"\w*.
\p \v 39 \w On the seventh|strong="H7637"\w* \w day|strong="H3117"\w* \w the priest|strong="H3548"\w* \w is to return|strong="H7725"\w* \w and inspect the house|strong="H7200"\w*. \w If|strong="H2009"\w* \w the mildew|strong="H5061"\w* \w has spread|strong="H6581"\w* \w on the walls|strong="H7023"\w*, \v 40 \w he|strong="H3548"\w* \w must order|strong="H6680"\w* \w that|strong="H834"\w* \w the contaminated|strong="H5061"\w* \w stones|strong="H68"\w* \w be pulled out|strong="H2502"\w* \w and thrown|strong="H7993"\w* \w into|strong="H413"\w* \w an unclean|strong="H2931"\w* \w place|strong="H4725"\w* \w outside|strong="H2351"\w* \w the city|strong="H5892"\w*. \v 41 \w And|strong="H853"\w* \w he shall have the inside|strong="H1004"\w* \w of the house|strong="H1004"\w* \w scraped|strong="H7106"\w* \w completely|strong="H5439"\w* \w and the plaster|strong="H6083"\w* \w that|strong="H834"\w* \w is scraped off|strong="H7096"\w* \w dumped|strong="H8210"\w* \w into|strong="H413"\w* \w an unclean|strong="H2931"\w* \w place|strong="H4725"\w* \w outside|strong="H2351"\w* \w the city|strong="H5892"\w*.
\p \v 42 \w So different|strong="H312"\w* \w stones|strong="H68"\w* \w must be obtained|strong="H3947"\w* \w to replace|strong="H935"\w* \w the contaminated ones|strong="H68"\w*, \w as well as additional|strong="H312"\w* \w mortar|strong="H6083"\w* \w to replaster|strong="H2902"\w* \w the house|strong="H1004"\w*.
\p \v 43 \w If|strong="H518"\w* \w the mildew|strong="H5061"\w* \w reappears|strong="H7725"\w* \w in the house|strong="H1004"\w* \w after|strong="H310"\w* \w the stones|strong="H68"\w* \w have been torn out|strong="H2502"\w* \w and|strong="H310"\w* \w the house|strong="H1004"\w* \w has been scraped|strong="H7096"\w* \w and replastered|strong="H2902"\w*, \v 44 \w the priest|strong="H3548"\w* \w must come|strong="H935"\w* \w and inspect it|strong="H7200"\w*.
\p \w If|strong="H2009"\w* \w the mildew|strong="H5061"\w* \w has spread|strong="H6581"\w* \w in the house|strong="H1004"\w*, \w it is|strong="H1931"\w* \w a destructive|strong="H3992"\w* \w mildew|strong="H6883"\w*; \w the house|strong="H1004"\w* \w is unclean|strong="H2931"\w*. \v 45 \w It|strong="H1004"\w* \w must be torn down|strong="H5422"\w* \w with its stones|strong="H68"\w*, \w its timbers|strong="H6086"\w*, \w and all|strong="H3605"\w* \w its|strong="H1004"\w* \w plaster|strong="H6083"\w*, \w and taken|strong="H3318"\w* \w outside|strong="H2351"\w* \w the city|strong="H5892"\w* \w to|strong="H413"\w* \w an unclean|strong="H2931"\w* \w place|strong="H4725"\w*. \v 46 \w Anyone who enters|strong="H935"\w* \w the house|strong="H1004"\w* \w during any|strong="H3605"\w* \w of the days|strong="H3117"\w* \w that it is closed up|strong="H5462"\w* \w will be unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*. \v 47 \w And anyone who sleeps|strong="H7901"\w* \w in the house|strong="H1004"\w* \w or eats|strong="H398"\w* \w in it|strong="H1004"\w* \w must wash|strong="H3526"\w* \w his clothes|strong="H899"\w*.
\s1 Cleansing a Home
\p \v 48 \w If, however|strong="H518"\w*, \w the priest|strong="H3548"\w* \w comes|strong="H935"\w* \w and inspects it|strong="H7200"\w*, \w and|strong="H2009"\w* \w the mildew|strong="H5061"\w* \w has not|strong="H3808"\w* \w spread|strong="H6581"\w* \w after|strong="H310"\w* \w the house|strong="H1004"\w* \w has been replastered|strong="H2902"\w*, \w he|strong="H3548"\w* \w shall pronounce the house|strong="H1004"\w* \w clean|strong="H2891"\w*, \w because|strong="H3588"\w* \w the mildew|strong="H5061"\w* \w is gone|strong="H7495"\w*.
\p \v 49 \w He is to take|strong="H3947"\w* \w two|strong="H8147"\w* \w birds|strong="H6833"\w*, \w cedar|strong="H730"\w* \w wood|strong="H6086"\w*, \w scarlet yarn|strong="H8144"\w*, \w and hyssop|strong="H231"\w* \w to purify|strong="H2398"\w* \w the house|strong="H1004"\w*; \v 50 \w and he shall slaughter|strong="H7819"\w* \w one|strong="H259"\w* \w of the birds|strong="H6833"\w* \w over|strong="H413"\w* \w fresh|strong="H2416"\w* \w water|strong="H4325"\w* \w in a clay|strong="H2789"\w* \w pot|strong="H3627"\w*.
\p \v 51 \w Then he shall take|strong="H3947"\w* \w the cedar|strong="H730"\w* \w wood|strong="H6086"\w*, \w the hyssop|strong="H231"\w*, \w the scarlet yarn|strong="H8144"\w*, \w and the live|strong="H2416"\w* \w bird|strong="H6833"\w*, \w dip|strong="H2881"\w* \w them|strong="H853"\w* \w in the blood|strong="H1818"\w* \w of the slaughtered|strong="H7819"\w* \w bird|strong="H6833"\w* \w and the fresh|strong="H2416"\w* \w water|strong="H4325"\w*, \w and sprinkle|strong="H5137"\w* \w the house|strong="H1004"\w* \w seven|strong="H7651"\w* \w times|strong="H6471"\w*. \v 52 \w And he shall cleanse|strong="H2398"\w* \w the house|strong="H1004"\w* \w with the bird’s|strong="H6833"\w* \w blood|strong="H1818"\w*, \w the fresh|strong="H2416"\w* \w water|strong="H4325"\w*, \w the live|strong="H2416"\w* \w bird|strong="H6833"\w*, \w the cedar|strong="H730"\w* \w wood|strong="H6086"\w*, \w the hyssop|strong="H231"\w*, \w and the scarlet yarn|strong="H8144"\w*.
\p \v 53 \w Finally, he is to release|strong="H7971"\w* \w the live|strong="H2416"\w* \w bird|strong="H6833"\w* \w into|strong="H413"\w* \w the open|strong="H6440"\w* \w fields|strong="H7704"\w* \w outside|strong="H2351"\w* \w the city|strong="H5892"\w*. \w In this way he will make atonement|strong="H3722"\w* \w for|strong="H5921"\w* \w the house|strong="H1004"\w*, \w and it will be clean|strong="H2891"\w*.
\p \v 54 \w This|strong="H2063"\w* \w is the law|strong="H8451"\w* \w for any|strong="H3605"\w* \w infectious skin disease|strong="H6883"\w*, \w for a scaly outbreak|strong="H5424"\w*, \v 55 \w for mildew|strong="H6883"\w* \w in clothing|strong="H899"\w* \w or in a house|strong="H1004"\w*, \v 56 \w and for a swelling|strong="H7613"\w*, \w rash|strong="H5597"\w*, \w or spot|strong="H934"\w*, \v 57 \w to determine|strong="H3384"\w* \w when|strong="H3117"\w* \w something is clean|strong="H2889"\w* \w or unclean|strong="H2931"\w*. \w This|strong="H2063"\w* \w is the law|strong="H8451"\w* \w regarding skin diseases and mildew|strong="H6883"\w*.\f + \fr 14:57 \ft The Hebrew translated here as \fqa skin diseases and mildew \ft is one singular term; see the footnotes for verses 2 and 34.\f*”
\c 15
\s1 The Uncleanness of Men
\r (\ref Deuteronomy 23:9–14|DEU 23:9-14\ref*)
\p \v 1 \w And the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w* \w and Aaron|strong="H175"\w*, \v 2 “\w Say|strong="H1696"\w* \w to|strong="H413"\w* \w the Israelites|strong="H1121"\w*, ‘\w When|strong="H3588"\w* \w any|strong="H376"\w* \w man|strong="H376"\w* \w has|strong="H1961"\w* \w a bodily|strong="H1320"\w* \w discharge|strong="H2100"\w*, \w the discharge|strong="H2101"\w* \w is unclean|strong="H2931"\w*. \v 3 \w This|strong="H2063"\w* \w uncleanness|strong="H2932"\w* \w is|strong="H1961"\w* \w from his discharge|strong="H2101"\w*, \w whether his body|strong="H1320"\w* \w allows|strong="H7325"\w* \w the discharge to flow|strong="H2101"\w* \w or|strong="H176"\w* \w blocks it|strong="H2856"\w*. \w So his discharge|strong="H2101"\w* \w will bring about|strong="H1931"\w* \w uncleanness|strong="H2932"\w*.
\p \v 4 \w Any|strong="H3605"\w* \w bed|strong="H4904"\w* \w on|strong="H5921"\w* \w which|strong="H834"\w* \w the man with the discharge|strong="H2100"\w* \w lies|strong="H7901"\w* \w will be unclean|strong="H2930"\w*, \w and any|strong="H3605"\w* \w furniture|strong="H3627"\w* \w on|strong="H5921"\w* \w which|strong="H834"\w* \w he sits|strong="H3427"\w* \w will be unclean|strong="H2930"\w*. \v 5 \w Anyone|strong="H376"\w* \w who|strong="H834"\w* \w touches|strong="H5060"\w* \w his bed|strong="H4904"\w* \w must wash|strong="H3526"\w* \w his clothes|strong="H899"\w* \w and bathe|strong="H7364"\w* \w with water|strong="H4325"\w*, \w and he will be unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*. \v 6 \w Whoever sits|strong="H3427"\w* \w on|strong="H5921"\w* \w furniture|strong="H3627"\w* \w on|strong="H5921"\w* \w which|strong="H834"\w* \w the man with the discharge|strong="H2100"\w* \w was sitting|strong="H3427"\w* \w must wash|strong="H3526"\w* \w his clothes|strong="H899"\w* \w and bathe|strong="H7364"\w* \w with water|strong="H4325"\w*, \w and he will be unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*.
\p \v 7 \w Whoever touches|strong="H5060"\w* \w the body|strong="H1320"\w* \w of the man with a discharge|strong="H2100"\w* \w must wash|strong="H3526"\w* \w his clothes|strong="H899"\w* \w and bathe|strong="H7364"\w* \w with water|strong="H4325"\w*, \w and he will be unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*. \v 8 \w If|strong="H3588"\w* \w the man with the discharge|strong="H2100"\w* \w spits|strong="H7556"\w* \w on one who is clean|strong="H2889"\w*, \w that person must wash|strong="H3526"\w* \w his clothes|strong="H899"\w* \w and bathe|strong="H7364"\w* \w with water|strong="H4325"\w*, \w and he will be unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*.
\p \v 9 \w Any|strong="H3605"\w* \w saddle|strong="H4817"\w* \w on|strong="H5921"\w* \w which|strong="H834"\w* \w the man with the discharge|strong="H2100"\w* \w rides|strong="H7392"\w* \w will be unclean|strong="H2930"\w*. \v 10 \w Whoever|strong="H3605"\w* \w touches|strong="H5060"\w* \w anything|strong="H3605"\w* \w that|strong="H834"\w* \w was|strong="H1961"\w* \w under him|strong="H8478"\w* \w will be unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*, \w and whoever carries|strong="H5375"\w* \w such things|strong="H853"\w* \w must wash|strong="H3526"\w* \w his clothes|strong="H899"\w* \w and bathe|strong="H7364"\w* \w with water|strong="H4325"\w*, \w and he will be unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*.
\p \v 11 \w If the man with the discharge|strong="H2100"\w* \w touches|strong="H5060"\w* \w anyone|strong="H3605"\w* \w without|strong="H3808"\w* \w first rinsing|strong="H7857"\w* \w his hands|strong="H3027"\w* \w with water|strong="H4325"\w*, \w the one who was touched must wash|strong="H3526"\w* \w his clothes|strong="H899"\w* \w and bathe|strong="H7364"\w* \w with water|strong="H4325"\w*, \w and he will be unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*. \v 12 \w Any clay|strong="H2789"\w* \w pot|strong="H3627"\w* \w that|strong="H834"\w* \w the man with the discharge|strong="H2100"\w* \w touches|strong="H5060"\w* \w must be broken|strong="H7665"\w*, \w and any|strong="H3605"\w* \w wooden|strong="H6086"\w* \w utensil|strong="H3627"\w* \w must be rinsed|strong="H7857"\w* \w with water|strong="H4325"\w*.
\s1 The Cleansing of Men
\p \v 13 \w When|strong="H3588"\w* \w the man|strong="H2100"\w* \w has been cleansed|strong="H2891"\w* \w from his discharge|strong="H2101"\w*, \w he must count off|strong="H5608"\w* \w seven|strong="H7651"\w* \w days|strong="H3117"\w* for his \w cleansing|strong="H2893"\w*, \w wash|strong="H3526"\w* \w his clothes|strong="H899"\w*, \w and bathe|strong="H7364"\w* \w himself|strong="H1320"\w* \w in fresh|strong="H2416"\w* \w water|strong="H4325"\w*,\f + \fr 15:13 \ft Or \fqa flowing water \ft or \fqa living water\f* \w and he shall be clean|strong="H2891"\w*. \v 14 \w On the eighth|strong="H8066"\w* \w day|strong="H3117"\w* \w he is to take|strong="H3947"\w* \w two|strong="H8147"\w* \w turtledoves|strong="H8449"\w* \w or|strong="H176"\w* \w two|strong="H8147"\w* \w young|strong="H1121"\w* \w pigeons|strong="H3123"\w*, \w come|strong="H935"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w at|strong="H413"\w* \w the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*, \w and give them|strong="H5414"\w* \w to|strong="H413"\w* \w the priest|strong="H3548"\w*. \v 15 \w The priest|strong="H3548"\w* \w is to sacrifice|strong="H6213"\w* \w them|strong="H853"\w*, \w one|strong="H259"\w* \w as a sin offering|strong="H2403"\w* \w and the other|strong="H259"\w* \w as a burnt offering|strong="H5930"\w*. \w In this way the priest|strong="H3548"\w* \w will make atonement|strong="H3722"\w* \w for|strong="H5921"\w* \w the man before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w because of his discharge|strong="H2101"\w*.
\p \v 16 \w When|strong="H3588"\w* \w a man|strong="H376"\w* \w has an emission|strong="H7902"\w* \w of semen|strong="H2233"\w*, \w he must bathe|strong="H7364"\w* \w his whole|strong="H3605"\w* \w body|strong="H1320"\w* \w with water|strong="H4325"\w*, \w and he will be unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*. \v 17 \w Any|strong="H3605"\w* \w clothing|strong="H899"\w* \w or leather|strong="H5785"\w* \w on|strong="H5921"\w* \w which|strong="H834"\w* \w there is|strong="H1961"\w* \w an emission|strong="H7902"\w* \w of semen|strong="H2233"\w* \w must be washed|strong="H3526"\w* \w with water|strong="H4325"\w*, \w and it will remain unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*. \v 18 \w If a man|strong="H376"\w* \w lies with|strong="H7901"\w* \w a woman|strong="H802"\w* \w and there is an emission|strong="H7902"\w* \w of semen|strong="H2233"\w*, \w both must bathe|strong="H7364"\w* \w with water|strong="H4325"\w*, \w and they will remain unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*.
\s1 The Uncleanness of Women
\p \v 19 \w When|strong="H3588"\w* \w a woman|strong="H802"\w* \w has|strong="H1961"\w* \w a discharge|strong="H2100"\w* \w consisting|strong="H1961"\w* \w of blood|strong="H1818"\w* \w from her body|strong="H1320"\w*, \w she will be|strong="H1961"\w* \w unclean due to her menstruation|strong="H5079"\w* \w for seven|strong="H7651"\w* \w days|strong="H3117"\w*, \w and anyone|strong="H3605"\w* \w who touches|strong="H5060"\w* her \w will be unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*. \v 20 \w Anything|strong="H3605"\w* \w on|strong="H5921"\w* \w which|strong="H834"\w* \w she lies|strong="H7901"\w* \w or sits|strong="H3427"\w* \w during her menstruation|strong="H5079"\w* \w will be unclean|strong="H2930"\w*, \v 21 \w and anyone|strong="H3605"\w* \w who touches|strong="H5060"\w* \w her bed|strong="H4904"\w* \w must wash|strong="H3526"\w* \w his clothes|strong="H899"\w* \w and bathe|strong="H7364"\w* \w with water|strong="H4325"\w*, \w and he will be unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*.
\p \v 22 \w Whoever|strong="H3605"\w* \w touches|strong="H5060"\w* \w any|strong="H3605"\w* \w furniture|strong="H3627"\w* \w on|strong="H5921"\w* \w which|strong="H834"\w* \w she was sitting|strong="H3427"\w* \w must wash|strong="H3526"\w* \w his clothes|strong="H899"\w* \w and bathe|strong="H7364"\w* \w with water|strong="H4325"\w*, \w and he will be unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*. \v 23 \w And whether|strong="H518"\w* \w it is|strong="H1931"\w* \w a bed|strong="H4904"\w* \w or|strong="H176"\w* \w furniture|strong="H3627"\w* \w on|strong="H5921"\w* \w which|strong="H834"\w* \w she|strong="H1931"\w* \w was sitting|strong="H3427"\w*, \w whoever touches|strong="H5060"\w* it \w will be unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*.
\p \v 24 \w If|strong="H518"\w* \w a man|strong="H376"\w* \w lies with|strong="H7901"\w* \w her|strong="H7901"\w* \w and her menstrual flow|strong="H5079"\w* \w touches|strong="H1961"\w* \w him|strong="H5921"\w*, \w he will be unclean|strong="H2930"\w* \w for seven|strong="H7651"\w* \w days|strong="H3117"\w*, \w and any|strong="H3605"\w* \w bed|strong="H4904"\w* \w on|strong="H5921"\w* \w which|strong="H834"\w* \w he lies|strong="H7901"\w* \w will become unclean|strong="H2930"\w*.
\p \v 25 \w When|strong="H3588"\w* \w a woman|strong="H802"\w* \w has a discharge|strong="H2100"\w* \w of her blood|strong="H1818"\w* \w for many|strong="H7227"\w* \w days|strong="H3117"\w* \w at a time|strong="H6256"\w* \w other than|strong="H3808"\w* \w her menstrual period|strong="H5079"\w*, \w or|strong="H176"\w* \w if|strong="H3588"\w* \w it continues|strong="H2100"\w* \w beyond|strong="H5921"\w* \w her period|strong="H5079"\w*, \w she|strong="H1931"\w* \w will be|strong="H1961"\w* \w unclean|strong="H2931"\w* \w all|strong="H3605"\w* \w the days|strong="H3117"\w* \w of her unclean|strong="H2932"\w* \w discharge|strong="H2101"\w*, \w just as she is during the days|strong="H3117"\w* \w of her menstruation|strong="H5079"\w*. \v 26 \w Any|strong="H3605"\w* \w bed|strong="H4904"\w* \w on|strong="H5921"\w* \w which|strong="H834"\w* \w she lies|strong="H7901"\w* \w or any|strong="H3605"\w* \w furniture|strong="H3627"\w* \w on|strong="H5921"\w* \w which|strong="H834"\w* \w she sits|strong="H3427"\w* \w during the days|strong="H3117"\w* \w of her discharge|strong="H2101"\w* \w will be|strong="H1961"\w* \w unclean|strong="H2931"\w*, \w like her bed|strong="H4904"\w* \w during her menstrual period|strong="H2932"\w*. \v 27 \w Anyone|strong="H3605"\w* \w who touches|strong="H5060"\w* these things \w will be unclean|strong="H2930"\w*; \w he must wash|strong="H3526"\w* \w his clothes|strong="H899"\w* \w and bathe|strong="H7364"\w* \w with water|strong="H4325"\w*, \w and he will be unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*.
\s1 The Cleansing of Women
\p \v 28 \w When|strong="H518"\w* \w a woman is cleansed|strong="H2891"\w* \w of her discharge|strong="H2101"\w*, \w she must count off|strong="H5608"\w* \w seven|strong="H7651"\w* \w days|strong="H3117"\w*, \w and after that|strong="H310"\w* \w she will be ceremonially clean|strong="H2891"\w*. \v 29 \w On the eighth|strong="H8066"\w* \w day|strong="H3117"\w* \w she is to take|strong="H3947"\w* \w two|strong="H8147"\w* \w turtledoves|strong="H8449"\w* \w or|strong="H176"\w* \w two|strong="H8147"\w* \w young|strong="H1121"\w* \w pigeons|strong="H3123"\w* \w and bring|strong="H935"\w* \w them|strong="H853"\w* \w to|strong="H413"\w* \w the priest|strong="H3548"\w* \w at|strong="H413"\w* \w the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \v 30 \w The priest|strong="H3548"\w* \w is to sacrifice|strong="H6213"\w* \w one|strong="H259"\w* \w as a sin offering|strong="H2403"\w* \w and the other|strong="H259"\w* \w as a burnt offering|strong="H5930"\w*. \w In this way the priest|strong="H3548"\w* \w will make atonement|strong="H3722"\w* \w for her|strong="H5921"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w for her unclean|strong="H2932"\w* \w discharge|strong="H2101"\w*.
\p \v 31 \w You must keep|strong="H5144"\w* \w the children|strong="H1121"\w* \w of Israel separate|strong="H3478"\w* \w from their uncleanness|strong="H2932"\w*, \w so that they do not|strong="H3808"\w* \w die|strong="H4191"\w* \w by defiling|strong="H2930"\w* \w My tabernacle|strong="H4908"\w*, \w which|strong="H834"\w* \w is among them|strong="H8432"\w*.
\p \v 32 \w This|strong="H2063"\w* \w is the law|strong="H8451"\w* \w of him who has a discharge|strong="H2100"\w*, \w of the man who|strong="H834"\w* \w has|strong="H3318"\w* \w an emission|strong="H7902"\w* \w of semen|strong="H2233"\w* whereby \w he is unclean|strong="H2930"\w*, \v 33 \w of a woman|strong="H1739"\w* \w in her menstrual period|strong="H5079"\w*, \w of any male|strong="H2145"\w* \w or female|strong="H5347"\w* \w who has a discharge|strong="H2100"\w*, \w and of a man|strong="H376"\w* \w who|strong="H834"\w* \w lies|strong="H7901"\w* \w with|strong="H5973"\w* \w an unclean woman|strong="H2931"\w*.’”
\c 16
\s1 The Day of Atonement
\r (\ref Leviticus 23:26–32|LEV 23:26-32\ref*; \ref Numbers 29:7–11|NUM 29:7-11\ref*)
\p \v 1 \w Now the LORD|strong="H3068"\w* \w spoke|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w* \w after|strong="H310"\w* \w the death|strong="H4194"\w* \w of two|strong="H8147"\w* \w of Aaron’s|strong="H175"\w* \w sons|strong="H1121"\w* \w when they approached|strong="H7126"\w* \w the presence|strong="H6440"\w* \w of the LORD|strong="H3068"\w*. \v 2 \w And the LORD|strong="H3068"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*: “\w Tell|strong="H1696"\w* \w your brother|strong="H251"\w* \w Aaron|strong="H175"\w* \w not|strong="H408"\w* \w to enter|strong="H935"\w* \w freely|strong="H3605"\w* \w into|strong="H413"\w* \w the Most Holy Place|strong="H6944"\w*\f + \fr 16:2 \ft Or \fqa the Holy Place\ft ; also in verses 16, 17, 20, 23, and 27\f* \w behind|strong="H1004"\w* \w the veil|strong="H6532"\w* \w in|strong="H413"\w* \w front|strong="H6440"\w* \w of the mercy seat|strong="H3727"\w*\f + \fr 16:2 \ft Or \fqa atonement cover\ft ; here and throughout this chapter\f* \w on|strong="H5921"\w* \w the ark|strong="H727"\w*, \w or else|strong="H3808"\w* \w he will die|strong="H4191"\w*, \w because|strong="H3588"\w* \w I appear|strong="H7200"\w* \w in the cloud|strong="H6051"\w* \w above|strong="H5921"\w* \w the mercy seat|strong="H3727"\w*.
\p \v 3 \w This is how|strong="H2063"\w* \w Aaron|strong="H175"\w* \w is to enter|strong="H935"\w* \w the Holy Place|strong="H6944"\w*: \w with a young bull|strong="H6499"\w* \w for a sin offering|strong="H2403"\w* \w and a ram|strong="H352"\w* \w for a burnt offering|strong="H5930"\w*. \v 4 \w He is to wear|strong="H3847"\w* \w the sacred|strong="H6944"\w* \w linen|strong="H906"\w* \w tunic|strong="H3801"\w*, \w with linen|strong="H906"\w* \w undergarments|strong="H4370"\w*. \w He must tie|strong="H2296"\w* \w a linen|strong="H906"\w* \w sash|strong="H73"\w* \w around him|strong="H906"\w* \w and put on the linen|strong="H6801"\w* \w turban|strong="H4701"\w*. \w These|strong="H1992"\w* \w are holy|strong="H6944"\w* \w garments|strong="H899"\w*, \w and he must bathe|strong="H7364"\w* \w himself|strong="H1320"\w* \w with water|strong="H4325"\w* \w before he wears them|strong="H3847"\w*. \v 5 \w And|strong="H854"\w* \w he shall take|strong="H3947"\w* \w from the congregation|strong="H5712"\w* \w of Israel|strong="H3478"\w* \w two|strong="H8147"\w* \w male goats|strong="H8163"\w* \w for a sin offering|strong="H2403"\w* \w and one|strong="H259"\w* \w ram|strong="H352"\w* \w for a burnt offering|strong="H5930"\w*.
\p \v 6 \w Aaron|strong="H175"\w* \w is to present|strong="H7126"\w* \w the bull|strong="H6499"\w* \w for his sin offering|strong="H2403"\w* \w and make atonement|strong="H3722"\w* \w for|strong="H1157"\w* \w himself|strong="H1157"\w* \w and his household|strong="H1004"\w*. \v 7 \w Then he shall take|strong="H3947"\w* \w the two|strong="H8147"\w* \w goats|strong="H8163"\w* \w and present|strong="H5975"\w* \w them|strong="H853"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w at the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*.
\p \v 8 \w After Aaron|strong="H175"\w* \w casts|strong="H5414"\w* \w lots|strong="H1486"\w* \w for|strong="H5921"\w* \w the two|strong="H8147"\w* \w goats|strong="H8163"\w*, \w one|strong="H259"\w* \w for the LORD|strong="H3068"\w* \w and the other|strong="H259"\w* \w for the scapegoat|strong="H5799"\w*,\f + \fr 16:8 \ft Literally \fqa the other to Azazel\ft ; similarly twice in verse 10 and once in verse 26\f* \v 9 \w he|strong="H175"\w* \w shall present|strong="H7126"\w* \w the goat|strong="H8163"\w* \w chosen|strong="H5927"\w* \w by lot|strong="H1486"\w* \w for the LORD|strong="H3068"\w* \w and sacrifice|strong="H6213"\w* \w it as a sin offering|strong="H2403"\w*. \v 10 \w But the goat|strong="H8163"\w* \w chosen|strong="H5927"\w* \w by|strong="H5921"\w* \w lot|strong="H1486"\w* \w as the scapegoat|strong="H5799"\w* \w shall be presented|strong="H5975"\w* \w alive|strong="H2416"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w to make atonement|strong="H3722"\w* \w by sending|strong="H7971"\w* \w it into the wilderness|strong="H4057"\w* \w as the scapegoat|strong="H5799"\w*.
\p \v 11 \w When Aaron|strong="H175"\w* \w presents|strong="H7126"\w* \w the bull|strong="H6499"\w* \w for his sin offering|strong="H2403"\w* \w and makes atonement|strong="H3722"\w* \w for himself|strong="H1157"\w* \w and his household|strong="H1004"\w*, \w he is to slaughter|strong="H7819"\w* \w the bull|strong="H6499"\w* \w for his own sin offering|strong="H2403"\w*. \v 12 \w Then he must take|strong="H3947"\w* \w a censer|strong="H4289"\w* \w full|strong="H4393"\w* \w of burning|strong="H784"\w* \w coals|strong="H1513"\w* \w from|strong="H5921"\w* \w the altar|strong="H4196"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*, \w and two handfuls|strong="H4393"\w* \w of finely ground|strong="H1851"\w* \w fragrant|strong="H5561"\w* \w incense|strong="H7004"\w*, \w and take them|strong="H935"\w* \w inside|strong="H1004"\w* \w the veil|strong="H6532"\w*. \v 13 \w He is to put|strong="H5414"\w* \w the incense|strong="H7004"\w* \w on|strong="H5921"\w* \w the fire|strong="H784"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*, \w and the cloud|strong="H6051"\w* \w of incense|strong="H7004"\w* \w will cover|strong="H3680"\w* \w the mercy seat|strong="H3727"\w* \w above|strong="H5921"\w* \w the Testimony|strong="H5715"\w*,\f + \fr 16:13 \fqa The Testimony \ft refers to the stone tablets in the ark of the covenant inscribed with the Ten Commandments.\f* \w so that he will not|strong="H3808"\w* \w die|strong="H4191"\w*. \v 14 \w And he is to take|strong="H3947"\w* \w some of the bull’s|strong="H6499"\w* \w blood|strong="H1818"\w* \w and sprinkle|strong="H5137"\w* \w it with his finger|strong="H676"\w* \w on|strong="H5921"\w* \w the east|strong="H6924"\w* \w side|strong="H6440"\w* \w of the mercy seat|strong="H3727"\w*; \w then he shall sprinkle|strong="H5137"\w* \w some of|strong="H4480"\w* \w it|strong="H1818"\w* \w with his finger|strong="H676"\w* \w seven|strong="H7651"\w* \w times|strong="H6471"\w* \w before|strong="H6440"\w* \w the mercy seat|strong="H3727"\w*.
\p \v 15 \w Aaron shall then slaughter|strong="H7819"\w* \w the goat|strong="H8163"\w* \w for the sin offering|strong="H2403"\w* \w for the people|strong="H5971"\w* \w and bring|strong="H935"\w* \w its blood|strong="H1818"\w* \w behind|strong="H1004"\w* \w the veil|strong="H6532"\w*, \w and with its blood|strong="H1818"\w* \w he must do|strong="H6213"\w* \w as|strong="H834"\w* \w he did|strong="H6213"\w* \w with the bull’s|strong="H6499"\w* \w blood|strong="H1818"\w*: \w He is to sprinkle|strong="H5137"\w* \w it against|strong="H5921"\w* \w the mercy seat|strong="H3727"\w* \w and in front|strong="H6440"\w* \w of it|strong="H3727"\w*.
\p \v 16 \w So he shall make atonement|strong="H3722"\w* \w for|strong="H5921"\w* \w the Most Holy Place|strong="H6944"\w* \w because of the impurities|strong="H2932"\w* \w and rebellious acts|strong="H6588"\w* \w of the Israelites|strong="H3478"\w* \w in regard to all|strong="H3605"\w* \w their sins|strong="H2403"\w*. \w He is to do|strong="H6213"\w* \w the same|strong="H3651"\w* \w for the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w* \w which abides|strong="H7931"\w* \w among them|strong="H854"\w* \w in the midst|strong="H8432"\w* \w of their impurities|strong="H2932"\w*. \v 17 \w No|strong="H3605"\w* \w one|strong="H120"\w* \w may be|strong="H1961"\w* \w in the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w* \w from the time Aaron goes in|strong="H935"\w* \w to make atonement|strong="H3722"\w* \w in the Most Holy Place|strong="H6944"\w* \w until|strong="H5704"\w* \w he leaves|strong="H3318"\w*, \w after he has made atonement|strong="H3722"\w* \w for himself|strong="H1157"\w*, \w his household|strong="H1004"\w*, \w and the whole|strong="H3605"\w* \w assembly|strong="H6951"\w* \w of Israel|strong="H3478"\w*.
\p \v 18 \w Then he shall go out|strong="H3318"\w* \w to|strong="H413"\w* \w the altar|strong="H4196"\w* \w that|strong="H834"\w* \w is before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w and make atonement|strong="H3722"\w* \w for it|strong="H5921"\w*. \w He is to take|strong="H3947"\w* \w some of the bull’s|strong="H6499"\w* \w blood|strong="H1818"\w* \w and some of the goat’s|strong="H8163"\w* \w blood|strong="H1818"\w* \w and put it|strong="H5414"\w* \w on|strong="H5921"\w* \w all|strong="H5439"\w* \w the horns|strong="H7161"\w* \w of the altar|strong="H4196"\w*. \v 19 \w He is to sprinkle|strong="H5137"\w* \w some of|strong="H4480"\w* \w the blood|strong="H1818"\w* \w on it|strong="H5921"\w* \w with his finger|strong="H676"\w* \w seven|strong="H7651"\w* \w times|strong="H6471"\w* \w to cleanse it|strong="H2891"\w* \w and consecrate it|strong="H6942"\w* \w from the uncleanness|strong="H2932"\w* \w of the Israelites|strong="H3478"\w*.
