\p \v 4 \w And if|strong="H518"\w* \w the people|strong="H5971"\w* \w of the land|strong="H776"\w* \w ever hide|strong="H5956"\w* \w their eyes|strong="H5869"\w* \w and fail|strong="H1115"\w* \w to put to death|strong="H4191"\w* \w the man|strong="H376"\w* \w who|strong="H1931"\w* \w gives|strong="H5414"\w* \w one of his children|strong="H2233"\w* \w to Molech|strong="H4432"\w*, \v 5 \w then I|strong="H589"\w* \w will set|strong="H7760"\w* \w My face|strong="H6440"\w* \w against that|strong="H1931"\w* \w man|strong="H376"\w* \w and his family|strong="H4940"\w* \w and cut off|strong="H3772"\w* \w from among|strong="H7130"\w* \w their people|strong="H5971"\w* \w both him and all|strong="H3605"\w* \w who follow him|strong="H310"\w* \w in prostituting themselves|strong="H2181"\w* \w with|strong="H310"\w* \w Molech|strong="H4432"\w*.
