\s1 Keep My Statutes
\p \v 19 \w You are to keep|strong="H8104"\w* \w My statutes|strong="H2708"\w*. \w You shall not|strong="H3808"\w* \w crossbreed|strong="H7250"\w* \w two different kinds|strong="H3610"\w* \w of livestock|strong="H929"\w*; \w you shall not sow|strong="H2232"\w* \w your fields|strong="H7704"\w* \w with two kinds|strong="H3610"\w* \w of seed|strong="H5927"\w*; \w and you shall not wear|strong="H5921"\w* \w clothing|strong="H899"\w* \w made of two kinds|strong="H3610"\w* \w of material|strong="H8162"\w*.
\p \v 20 \w If|strong="H3588"\w* \w a man|strong="H376"\w* \w lies|strong="H7901"\w* \w carnally|strong="H2233"\w* \w with a slave girl|strong="H8198"\w* \w promised|strong="H2778"\w* \w to another man|strong="H376"\w* \w but who has not|strong="H3808"\w* \w been redeemed|strong="H6299"\w* \w or|strong="H176"\w* \w given|strong="H5414"\w* her \w freedom|strong="H2668"\w*, \w there must be|strong="H1961"\w* \w due punishment|strong="H1244"\w*. \w But they are not|strong="H3808"\w* \w to be put to death|strong="H4191"\w*, \w because|strong="H3588"\w* \w she had not|strong="H3808"\w* \w been freed|strong="H2666"\w*. \v 21 \w The man, however, must bring|strong="H935"\w* \w a ram|strong="H352"\w* \w to|strong="H413"\w* \w the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w* \w as his guilt offering|strong="H817"\w* \w to the LORD|strong="H3068"\w*. \v 22 \w The priest|strong="H3548"\w* \w shall make atonement|strong="H3722"\w* \w on his behalf|strong="H5921"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w with the ram|strong="H352"\w* \w of the guilt offering|strong="H817"\w* \w for|strong="H5921"\w* \w the sin|strong="H2403"\w* \w he has committed|strong="H2398"\w*, \w and he will be forgiven|strong="H5545"\w* \w the sin|strong="H2403"\w* \w he has committed|strong="H2398"\w*.
\p \v 23 \w When|strong="H3588"\w* \w you enter|strong="H935"\w* \w the land|strong="H776"\w* \w and plant|strong="H5193"\w* \w any|strong="H3605"\w* \w kind of tree|strong="H6086"\w* \w for food|strong="H3978"\w*, \w you shall regard|strong="H6188"\w* \w the fruit|strong="H6529"\w* \w as forbidden|strong="H6190"\w*.\f + \fr 19:23 \ft Hebrew \fqa as uncircumcised\ft ; twice in this verse\f* \w For three|strong="H7969"\w* \w years|strong="H8141"\w* \w it will be|strong="H1961"\w* \w forbidden|strong="H6189"\w* to you \w and must not|strong="H3808"\w* \w be eaten|strong="H398"\w*. \v 24 \w In the fourth|strong="H7243"\w* \w year|strong="H8141"\w* \w all|strong="H3605"\w* \w its fruit|strong="H6529"\w* \w must be|strong="H1961"\w* \w consecrated|strong="H6944"\w* \w as a praise offering|strong="H1974"\w* \w to the LORD|strong="H3068"\w*. \v 25 \w But in the fifth|strong="H2549"\w* \w year|strong="H8141"\w* \w you may eat|strong="H398"\w* \w its fruit|strong="H6529"\w*; thus your \w harvest|strong="H8393"\w* \w will be increased|strong="H3254"\w*. \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w* \w your God|strong="H430"\w*.
\p \v 26 \w You must not|strong="H3808"\w* \w eat|strong="H398"\w* \w anything with|strong="H5921"\w* \w blood still in it|strong="H1818"\w*.
