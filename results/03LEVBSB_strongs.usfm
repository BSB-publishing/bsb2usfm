\p \v 31 \w You must not|strong="H408"\w* \w turn|strong="H6437"\w* \w to|strong="H413"\w* \w mediums|strong="H178"\w* \w or|strong="H413"\w* \w spiritists|strong="H3049"\w*; \w do not seek them out|strong="H1245"\w*, \w or you will be defiled|strong="H2930"\w* by them. \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w* \w your God|strong="H430"\w*.
\p \v 32 \w You are to rise|strong="H6965"\w* \w in the presence|strong="H6440"\w* \w of the elderly|strong="H7872"\w*, \w honor|strong="H1921"\w* \w the aged|strong="H2205"\w*, \w and fear|strong="H3372"\w* \w your God|strong="H430"\w*. \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w*.
\p \v 33 \w When|strong="H3588"\w* \w a foreigner|strong="H1616"\w* \w resides|strong="H1481"\w* \w with you|strong="H854"\w* \w in your land|strong="H776"\w*, \w you must not|strong="H3808"\w* \w oppress|strong="H3238"\w* \w him|strong="H853"\w*. \v 34 \w You must treat|strong="H1961"\w* \w the foreigner|strong="H1616"\w* \w living|strong="H1481"\w* \w among you|strong="H854"\w* \w as native-born|strong="H249"\w* \w and love|strong="H157"\w* him \w as yourself|strong="H3644"\w*, \w for|strong="H3588"\w* \w you were|strong="H1961"\w* \w foreigners|strong="H1616"\w* \w in the land|strong="H776"\w* \w of Egypt|strong="H4714"\w*. \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w* \w your God|strong="H430"\w*.
\p \v 35 \w You must not|strong="H3808"\w* \w use|strong="H6213"\w* \w dishonest|strong="H5766"\w* \w measures|strong="H4941"\w* \w of length|strong="H4060"\w*, \w weight|strong="H4948"\w*, \w or volume|strong="H4884"\w*. \v 36 \w You shall maintain|strong="H1961"\w* \w honest|strong="H6664"\w* \w scales|strong="H3976"\w* \w and|strong="H6664"\w* \w weights|strong="H68"\w*, \w an honest|strong="H6664"\w* \w ephah|strong="H374"\w*,\f + \fr 19:36 \fqa An ephah \ft is a dry measure of approximately 20 dry quarts or 22 liters.\f* \w and an honest|strong="H6664"\w* \w hin|strong="H1969"\w*.\f + \fr 19:36 \fqa A hin \ft is a liquid measure of approximately 0.97 gallons or 3.67 liters.\f* \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w* \w your God|strong="H430"\w*, \w who|strong="H834"\w* \w brought|strong="H3318"\w* \w you|strong="H853"\w* \w out of the land|strong="H776"\w* \w of Egypt|strong="H4714"\w*.
\p \v 37 \w You must keep|strong="H8104"\w* \w all|strong="H3605"\w* \w My statutes|strong="H2708"\w* \w and all|strong="H3605"\w* \w My ordinances|strong="H4941"\w* \w and follow|strong="H6213"\w* \w them|strong="H853"\w*. \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w*.”
