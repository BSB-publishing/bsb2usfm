\p \v 1 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 2 “\w Speak|strong="H1696"\w* \w to|strong="H413"\w* \w Aaron|strong="H175"\w*, \w his sons|strong="H1121"\w*, \w and all|strong="H3605"\w* \w the Israelites|strong="H1121"\w* \w and tell|strong="H559"\w* \w them|strong="H413"\w* \w this|strong="H2088"\w* \w is what|strong="H834"\w* \w the LORD|strong="H3068"\w* \w has commanded|strong="H6680"\w*: \v 3 ‘\w Anyone|strong="H376"\w* \w from the house|strong="H1004"\w* \w of Israel|strong="H3478"\w* \w who|strong="H834"\w* \w slaughters|strong="H7819"\w* \w an ox|strong="H7794"\w*,\f + \fr 17:3 \ft Or \fqa a bull \ft or \fqa a cow\f* \w a lamb|strong="H3775"\w*, \w or|strong="H176"\w* \w a goat|strong="H5795"\w* \w in the camp|strong="H4264"\w* \w or outside|strong="H2351"\w* \w of it|strong="H4264"\w* \v 4 \w instead of|strong="H3808"\w* \w bringing|strong="H935"\w* \w it to|strong="H413"\w* \w the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w* \w to present|strong="H7126"\w* \w it as an offering|strong="H7133"\w* \w to the LORD|strong="H3068"\w* \w before|strong="H6440"\w* \w His|strong="H3068"\w* \w tabernacle|strong="H4908"\w*— \w that|strong="H1931"\w* \w man|strong="H376"\w* \w shall incur|strong="H2803"\w* \w bloodguilt|strong="H1818"\w*. \w He has shed|strong="H8210"\w* \w blood|strong="H1818"\w* \w and must be cut off|strong="H3772"\w* \w from among|strong="H7130"\w* \w his people|strong="H5971"\w*.
