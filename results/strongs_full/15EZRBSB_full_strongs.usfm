\pmo “\w O my God|strong="H430"\w*, \w I am ashamed|strong="H954"\w* \w and embarrassed|strong="H3637"\w* \w to lift up|strong="H7311"\w* \w my face|strong="H6440"\w* \w to You|strong="H413"\w*, \w my God|strong="H430"\w*, \w because|strong="H3588"\w* \w our iniquities|strong="H5771"\w* \w are higher than|strong="H7235"\w* \w . . .|strong="H4605"\w* \w our heads|strong="H7218"\w*, \w and our guilt|strong="H819"\w* \w has reached|strong="H1431"\w* \w . . .|strong="H5704"\w* \w the heavens|strong="H8064"\w*. \v 7 \w From the days|strong="H3117"\w* \w of our fathers|strong="H1"\w*\w . . .|strong="H587"\w* \w to|strong="H5704"\w* \w this|strong="H2088"\w* \w day|strong="H3117"\w*, \w our guilt|strong="H819"\w* \w has been great|strong="H1419"\w*. \w Because of our iniquities|strong="H5771"\w*, \w we|strong="H587"\w* \w and our kings|strong="H4428"\w* \w [and] priests|strong="H3548"\w* \w have been delivered|strong="H5414"\w* \w into the hands|strong="H3027"\w* \w of the kings|strong="H4428"\w* \w of the earth|strong="H776"\w* \w [and subjected] to the sword|strong="H2719"\w* \w and to captivity|strong="H7628"\w*, \w to pillage|strong="H961"\w* \w and humiliation|strong="H1322"\w* \w . . .|strong="H6440"\w*, \w as we are this|strong="H2088"\w* \w day|strong="H3117"\w*.
\pmo \v 8 \w But now|strong="H6258"\w*, \w for a brief|strong="H4592"\w* \w moment|strong="H7281"\w*, \w grace|strong="H8467"\w* \w has come|strong="H1961"\w* \w from|strong="H854"\w* \w the LORD|strong="H3068"\w* \w our God|strong="H430"\w* \w to preserve|strong="H7604"\w* for us \w a remnant|strong="H6413"\w* \w and to give|strong="H5414"\w* us \w a stake|strong="H3489"\w*\f + \fr 9:8 \ft Or \fqa nail \ft or \fqa foothold\f* \w in His holy|strong="H6944"\w* \w place|strong="H4725"\w*. \w Even in our bondage|strong="H5659"\w*, \w our God|strong="H430"\w* \w has given us|strong="H5414"\w* \w new life|strong="H4241"\w* \w . . .|strong="H4592"\w* \w and light|strong="H215"\w* \w to our eyes|strong="H5869"\w*. \v 9 \w Though|strong="H3588"\w* \w we|strong="H587"\w* \w are slaves|strong="H5650"\w*, \w our God|strong="H430"\w* \w has not|strong="H3808"\w* \w forsaken us|strong="H5800"\w* \w in our bondage|strong="H5659"\w*, \w but He has extended|strong="H5186"\w* \w to us|strong="H5921"\w* \w grace|strong="H2617"\w* \w in the sight|strong="H6440"\w* \w of the kings|strong="H4428"\w* \w of Persia|strong="H6539"\w*, \w giving|strong="H5414"\w* us \w new life|strong="H4241"\w* \w to rebuild|strong="H7311"\w* \w -|strong="H853"\w* \w the house|strong="H1004"\w* \w of our God|strong="H430"\w* \w and repair|strong="H5975"\w* \w -|strong="H853"\w* \w its ruins|strong="H2723"\w*, \w and giving|strong="H5414"\w* us \w a wall of protection|strong="H1447"\w* \w in Judah|strong="H3063"\w* \w and Jerusalem|strong="H3389"\w*.
\pmo \v 10 \w And now|strong="H6258"\w*, \w our God|strong="H430"\w*, \w what|strong="H4100"\w* \w can we say|strong="H559"\w* \w after|strong="H310"\w* \w this|strong="H2063"\w*? \w For|strong="H3588"\w* \w we have forsaken|strong="H5800"\w* \w the commandments|strong="H4687"\w* \v 11 \w that|strong="H834"\w* \w You gave|strong="H6680"\w* \w through|strong="H3027"\w* \w Your servants|strong="H5650"\w* \w the prophets|strong="H5030"\w*, \w saying|strong="H559"\w*: ‘\w The land|strong="H776"\w* \w that|strong="H834"\w* \w you|strong="H859"\w* \w are entering|strong="H935"\w* \w to possess|strong="H3423"\w* \w is|strong="H1931"\w* \w a land|strong="H776"\w* \w polluted|strong="H5079"\w* \w by the impurity|strong="H5079"\w* \w of its peoples|strong="H5971"\w* \w . . .|strong="H776"\w* \w and the abominations|strong="H8441"\w* \w with which|strong="H834"\w* \w they have filled it|strong="H4390"\w* \w from end|strong="H6310"\w* \w to|strong="H413"\w* \w end|strong="H6310"\w* \w -|strong="H2932"\w*. \v 12 \w Now, therefore|strong="H6258"\w*, \w do not|strong="H408"\w* \w give|strong="H5414"\w* \w your daughters {in marriage}|strong="H1323"\w* \w to their sons|strong="H1121"\w* \w or take|strong="H5375"\w* \w their daughters|strong="H1323"\w* \w . . .|strong="H408"\w* \w for your sons|strong="H1121"\w*. \w Never|strong="H3808"\w* \w . . .|strong="H5704"\w* \w . . .|strong="H5769"\w* \w seek|strong="H1875"\w* \w their peace|strong="H7965"\w* \w or prosperity|strong="H2896"\w*, \w so that|strong="H4616"\w* \w you may be strong|strong="H2388"\w* \w and may eat|strong="H398"\w* \w -|strong="H853"\w* \w the good things|strong="H2898"\w* \w of the land|strong="H776"\w*, \w leaving it as an inheritance|strong="H3423"\w* \w to your sons|strong="H1121"\w* \w forever|strong="H5704"\w* \w . . .|strong="H5769"\w*.’
\pmo \v 13 \w After|strong="H310"\w* \w all|strong="H3605"\w* \w that has come|strong="H935"\w* \w upon us|strong="H5921"\w* \w because of our evil|strong="H7451"\w* \w deeds|strong="H4639"\w* \w and our great|strong="H1419"\w* \w guilt|strong="H819"\w* (\w though|strong="H3588"\w* \w You|strong="H859"\w*, \w our God|strong="H430"\w*, \w have punished us|strong="H2820"\w* \w less|strong="H4295"\w* \w than our iniquities [deserve]|strong="H5771"\w* \w and have given|strong="H5414"\w* us \w [such] a remnant|strong="H6413"\w* \w as this|strong="H2063"\w*), \v 14 \w shall we again|strong="H7725"\w* \w break|strong="H6565"\w* \w Your commandments|strong="H4687"\w* \w and intermarry|strong="H2859"\w* \w with the peoples|strong="H5971"\w* \w who commit these|strong="H428"\w* \w abominations|strong="H8441"\w*? \w Would You not|strong="H3808"\w* \w become so angry|strong="H599"\w* with us \w as to|strong="H5704"\w* \w wipe us out|strong="H3615"\w*, \w leaving no|strong="H369"\w* \w remnant|strong="H7611"\w* \w or survivor|strong="H6413"\w*?
\pmo \v 15 \w O LORD|strong="H3068"\w*, \w God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w You|strong="H859"\w* \w are righteous|strong="H6662"\w*! \w For|strong="H3588"\w* \w we remain|strong="H7604"\w* \w this|strong="H2088"\w* \w day|strong="H3117"\w* \w as a remnant|strong="H6413"\w*. \w Here we [are]|strong="H2005"\w* \w before You|strong="H6440"\w* \w in our guilt|strong="H819"\w*, \w though|strong="H3588"\w* \w because|strong="H5921"\w* \w of it|strong="H2063"\w* \w no one|strong="H369"\w* \w can stand|strong="H5975"\w* \w before You|strong="H6440"\w*.”
\c 10
\s1 Shecaniah’s Encouragement
\p \v 1 \w While Ezra|strong="H5830"\w* \w prayed|strong="H6419"\w* \w and made this confession|strong="H3034"\w*, \w weeping|strong="H1058"\w* \w and falling facedown|strong="H5307"\w* \w before|strong="H6440"\w* \w the house|strong="H1004"\w* \w of God|strong="H430"\w*, \w a very|strong="H3966"\w* \w large|strong="H7227"\w* \w assembly|strong="H6951"\w* \w of Israelites|strong="H3478"\w* — \w men|strong="H582"\w*, \w women|strong="H802"\w*, \w and children|strong="H3206"\w* — \w gathered|strong="H6908"\w* \w around him|strong="H413"\w*, \w and the people|strong="H5971"\w* \w wept bitterly|strong="H1058"\w* \w . . .|strong="H7235"\w* \w . . .|strong="H1059"\w* \w as well|strong="H3588"\w*.
\p \v 2 \w Then|strong="H6030"\w* \w Shecaniah|strong="H7935"\w* \w son|strong="H1121"\w* \w of Jehiel|strong="H3171"\w*, \w an Elamite|strong="H1121"\w* \w . . .|strong="H5867"\w*, \w said|strong="H559"\w* \w to Ezra|strong="H5830"\w*: “\w We|strong="H587"\w* \w have been unfaithful|strong="H4603"\w* \w to our God|strong="H430"\w* \w by marrying|strong="H3427"\w* \w foreign|strong="H5237"\w* \w women|strong="H802"\w* \w from the people|strong="H5971"\w* \w of the land|strong="H776"\w*, \w yet|strong="H6258"\w* \w in spite of|strong="H5921"\w* \w this|strong="H2063"\w*, \w there is|strong="H3426"\w* \w hope|strong="H4723"\w* \w for Israel|strong="H3478"\w*. \v 3 \w So now|strong="H6258"\w* \w let us make|strong="H3772"\w* \w a covenant|strong="H1285"\w* \w before our God|strong="H430"\w* \w to send away|strong="H3318"\w* \w all|strong="H3605"\w* \w the foreign wives|strong="H802"\w* \w and their children|strong="H3205"\w*, . . . \w according to the counsel|strong="H6098"\w* \w of my lord|strong="H136"\w* \w and of those who tremble|strong="H2730"\w* \w at the command|strong="H4687"\w* \w of our God|strong="H430"\w*. \w Let it be done|strong="H6213"\w* \w according to the Law|strong="H8451"\w*. \v 4 \w Get up|strong="H6965"\w*, \w for|strong="H3588"\w* \w [this] matter [is]|strong="H1697"\w* \w your [responsibility]|strong="H5921"\w*, \w and we|strong="H587"\w* \w will support you|strong="H5973"\w*. \w Be strong|strong="H2388"\w* \w and take action|strong="H6213"\w*!”
\p \v 5 \w So Ezra|strong="H5830"\w* \w got up|strong="H6965"\w* \w and made the leading|strong="H8269"\w* \w priests|strong="H3548"\w*, \w Levites|strong="H3881"\w*, \w and all|strong="H3605"\w* \w Israel|strong="H3478"\w* \w take an oath|strong="H7650"\w* \w -|strong="H853"\w* \w to do what had been said|strong="H6213"\w* \w . . .|strong="H1697"\w* \w . . .|strong="H2088"\w*. \w And they took the oath|strong="H7650"\w*.
\s1 The People’s Confession of Sin
\p \v 6 \w Then Ezra|strong="H5830"\w* \w withdrew|strong="H6965"\w* \w from before|strong="H6440"\w* \w the house|strong="H1004"\w* \w of God|strong="H430"\w* \w and walked|strong="H1980"\w* \w to|strong="H413"\w* \w the chamber|strong="H3957"\w* \w of Jehohanan|strong="H3076"\w* \w son|strong="H1121"\w* \w of Eliashib|strong="H475"\w*. \w And while he stayed|strong="H1980"\w*\f + \fr 10:6 \ft Or \fqa went\f* \w there|strong="H8033"\w*, \w he ate|strong="H398"\w* \w no|strong="H3808"\w* \w food|strong="H3899"\w* \w and drank|strong="H8354"\w* \w no|strong="H3808"\w* \w water|strong="H4325"\w*, \w because|strong="H3588"\w* \w he was mourning|strong="H56"\w* \w over|strong="H5921"\w* \w the unfaithfulness|strong="H4604"\w* \w of the exiles|strong="H1473"\w*.
\p \v 7 \w And a proclamation|strong="H6963"\w* \w was issued|strong="H5674"\w* \w throughout Judah|strong="H3063"\w* \w and Jerusalem|strong="H3389"\w* \w that all|strong="H3605"\w* \w the exiles|strong="H1121"\w* \w . . .|strong="H1473"\w* \w should gather|strong="H6908"\w* \w at Jerusalem|strong="H3389"\w*. \v 8 \w Whoever|strong="H3605"\w* \w -|strong="H834"\w* \w failed|strong="H3808"\w* \w to appear|strong="H935"\w* \w within three|strong="H7969"\w* \w days|strong="H3117"\w* \w would forfeit|strong="H2763"\w* \w all|strong="H3605"\w* \w his property|strong="H7399"\w*, \w . . .|strong="H1931"\w* \w according to the counsel|strong="H6098"\w* \w of the leaders|strong="H8269"\w* \w and elders|strong="H2205"\w*, \w and would himself be expelled|strong="H914"\w* \w from the assembly|strong="H6951"\w* \w of the exiles|strong="H1473"\w*.
\p \v 9 \w So within the three|strong="H7969"\w* \w days|strong="H3117"\w*, \w all|strong="H3605"\w* \w the men|strong="H582"\w* \w of Judah|strong="H3063"\w* \w and Benjamin|strong="H1144"\w* \w assembled|strong="H6908"\w* \w in Jerusalem|strong="H3389"\w*, \w . . .|strong="H1931"\w* \w and on the twentieth day|strong="H6242"\w* \w . . .|strong="H2320"\w* \w of the ninth|strong="H8671"\w* \w month|strong="H2320"\w*, \w all|strong="H3605"\w* \w the people|strong="H5971"\w* \w sat|strong="H3427"\w* \w in the square|strong="H7339"\w* \w at the house|strong="H1004"\w* \w of God|strong="H430"\w*, \w trembling|strong="H7460"\w* \w regarding|strong="H5921"\w* \w this matter|strong="H1697"\w* \w and because of the heavy rain|strong="H1653"\w*.
\p \v 10 \w Then Ezra|strong="H5830"\w* \w the priest|strong="H3548"\w* \w stood up|strong="H6965"\w* \w and said|strong="H559"\w* \w to them|strong="H413"\w*, “\w You|strong="H859"\w* \w have been unfaithful|strong="H4603"\w* \w by marrying|strong="H3427"\w* \w foreign|strong="H5237"\w* \w women|strong="H802"\w*, \w adding|strong="H3254"\w* \w to|strong="H5921"\w* \w the guilt|strong="H819"\w* \w of Israel|strong="H3478"\w*. \v 11 \w Now, therefore|strong="H6258"\w*, \w make|strong="H5414"\w* \w a confession|strong="H8426"\w* \w to the LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of your fathers|strong="H1"\w*, \w and do|strong="H6213"\w* \w His will|strong="H7522"\w*. \w Separate|strong="H914"\w* \w yourselves|strong="H4480"\w* \w from the people|strong="H5971"\w* \w of the land|strong="H776"\w* \w and from your foreign|strong="H5237"\w* \w wives|strong="H802"\w*.”
\p \v 12 \w And the whole|strong="H3605"\w* \w assembly|strong="H6951"\w* \w . . .|strong="H559"\w* \w responded|strong="H6030"\w* \w in a loud|strong="H1419"\w* \w voice|strong="H6963"\w*: “\w Truly|strong="H3651"\w* \w we must do|strong="H6213"\w* \w as you say|strong="H1697"\w* \w . . .|strong="H5921"\w*! \v 13 \w But|strong="H61"\w* \w there are many|strong="H7227"\w* \w people here|strong="H5971"\w*, \w and it is the rainy|strong="H1653"\w* \w season|strong="H6256"\w*. \w We are not|strong="H369"\w* \w able|strong="H3581"\w* \w to stay|strong="H5975"\w* \w out in the open|strong="H2351"\w*. \w Nor [is this]|strong="H3808"\w* \w the work|strong="H4399"\w* \w of one|strong="H259"\w* \w or|strong="H3808"\w* \w two|strong="H8147"\w* \w days|strong="H3117"\w*, \w for|strong="H3588"\w* \w we have transgressed|strong="H6586"\w* \w greatly|strong="H7235"\w* \w in this|strong="H2088"\w* \w matter|strong="H1697"\w*. \v 14 \w Let our leaders|strong="H8269"\w* \w represent|strong="H5975"\w* \w . . .|strong="H4994"\w* \w the whole|strong="H3605"\w* \w assembly|strong="H6951"\w*. \w Then let everyone|strong="H3605"\w* \w -|strong="H834"\w* \w in our towns|strong="H5892"\w* \w who has married|strong="H3427"\w* \w a foreign|strong="H5237"\w* \w woman|strong="H802"\w* \w come|strong="H935"\w* \w at an appointed|strong="H2163"\w* \w time|strong="H6256"\w*, \w together with|strong="H5973"\w* \w the elders|strong="H2205"\w* \w and judges|strong="H8199"\w* \w . . .|strong="H5704"\w* \w of each town|strong="H5892"\w* \w . . .|strong="H5892"\w*, \w until the fierce anger|strong="H2740"\w* \w . . .|strong="H639"\w* \w of our God|strong="H430"\w* \w -|strong="H5704"\w* \w in this|strong="H2088"\w* \w matter|strong="H1697"\w* \w is turned away|strong="H7725"\w* \w from us|strong="H4480"\w*.”
\p \v 15 (\w Only|strong="H389"\w* \w Jonathan|strong="H3129"\w* \w son|strong="H1121"\w* \w of Asahel|strong="H6214"\w* \w and Jahzeiah|strong="H3167"\w* \w son|strong="H1121"\w* \w of Tikvah|strong="H8616"\w*, \w supported|strong="H5826"\w* \w by Meshullam|strong="H4918"\w* \w and Shabbethai|strong="H7678"\w* \w the Levite|strong="H3881"\w*, \w opposed|strong="H5975"\w* \w . . .|strong="H5921"\w* \w this [plan]|strong="H2063"\w*.)
\p \v 16 \w So the exiles|strong="H1121"\w* \w . . .|strong="H1473"\w* \w did|strong="H6213"\w* \w as proposed|strong="H3651"\w*. \w Ezra|strong="H5830"\w* \w the priest|strong="H3548"\w* \w selected|strong="H914"\w* \w men|strong="H582"\w* \w who were family|strong="H1"\w* \w heads|strong="H7218"\w*, \w each of them|strong="H3605"\w* \w identified by name|strong="H8034"\w*, \w . . .|strong="H3427"\w* \w to represent their families|strong="H1"\w* \w . . .|strong="H1004"\w*. \w On the first|strong="H259"\w* \w day|strong="H3117"\w* \w of the tenth|strong="H6224"\w* \w month|strong="H2320"\w* \w they launched|strong="H1875"\w* \w the investigation|strong="H1697"\w*, \v 17 \w and by|strong="H5704"\w* \w the first|strong="H259"\w* \w day|strong="H3117"\w* \w of the first|strong="H7223"\w* \w month|strong="H2320"\w* \w they had dealt|strong="H3615"\w* \w with all|strong="H3605"\w* \w the men|strong="H582"\w* \w who had married|strong="H3427"\w* \w foreign|strong="H5237"\w* \w women|strong="H802"\w*.
