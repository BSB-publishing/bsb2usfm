\c 1
\s1 The Proclamation of Cyrus
\r (\ref 2 Chronicles 36:22–23|2CH 36:22-23\ref*; \ref Isaiah 45:1–25|ISA 45:1-25\ref*)
\p \v 1 \w In the first|strong="H259"\w* \w year|strong="H8141"\w* \w of Cyrus|strong="H3566"\w* \w king|strong="H4428"\w* \w of Persia|strong="H6539"\w*, \w to fulfill|strong="H3615"\w* \w the word|strong="H1697"\w* \w of the LORD|strong="H3068"\w* \w spoken|strong="H6310"\w* \w through Jeremiah|strong="H3414"\w*, \w the LORD|strong="H3068"\w* \w stirred|strong="H5782"\w* \w -|strong="H853"\w* \w the spirit|strong="H7307"\w* \w of Cyrus|strong="H3566"\w* \w king|strong="H4428"\w* \w of Persia|strong="H6539"\w* \w to send|strong="H5674"\w* \w a proclamation|strong="H6963"\w* \w throughout|strong="H3605"\w* \w his kingdom|strong="H4438"\w* \w and|strong="H1571"\w* \w to put it in writing|strong="H4385"\w* \w as follows|strong="H559"\w*:
\pmo \v 2 “\w This is what|strong="H3541"\w* \w Cyrus|strong="H3566"\w* \w king|strong="H4428"\w* \w of Persia|strong="H6539"\w* \w says|strong="H559"\w*:
\pmo ‘\w The LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of heaven|strong="H8064"\w*, \w who|strong="H1931"\w* \w has given|strong="H5414"\w* me \w all|strong="H3605"\w* \w the kingdoms|strong="H4467"\w* \w of the earth|strong="H776"\w*, \w has appointed|strong="H6485"\w* \w me|strong="H5921"\w* \w to build|strong="H1129"\w* \w a house|strong="H1004"\w* for Him \w at Jerusalem|strong="H3389"\w* \w -|strong="H834"\w* \w in Judah|strong="H3063"\w*.
\pmo \v 3 \w Whoever|strong="H4310"\w* among you \w belongs to|strong="H3605"\w* \w His people|strong="H5971"\w*, \w may his God|strong="H430"\w* \w be|strong="H1961"\w* \w with him|strong="H5973"\w*, \w and may he go|strong="H5927"\w* \w to Jerusalem|strong="H3389"\w*\w . . .|strong="H834"\w* \w in Judah|strong="H3063"\w* \w and build|strong="H1129"\w* \w -|strong="H853"\w* \w the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*; \w He [is]|strong="H1931"\w* \w the God|strong="H430"\w* \w who|strong="H834"\w* \w is in Jerusalem|strong="H3389"\w*. \v 4 \w And let every|strong="H3605"\w* \w survivor|strong="H7604"\w*, \w wherever|strong="H3605"\w* \w . . .|strong="H4725"\w* \w -|strong="H834"\w* \w he|strong="H1931"\w* \w lives|strong="H1481"\w*, \w . . .|strong="H8033"\w* \w be assisted|strong="H5375"\w* \w by the men|strong="H582"\w* \w of that region|strong="H4725"\w* \w with silver|strong="H3701"\w*, \w gold|strong="H2091"\w*, \w goods|strong="H7399"\w*, \w and livestock|strong="H929"\w*, \w along with|strong="H5973"\w* \w a freewill offering|strong="H5071"\w* \w for the house|strong="H1004"\w* \w of God|strong="H430"\w* \w -|strong="H834"\w* \w in Jerusalem|strong="H3389"\w*.’”
\p \v 5 \w So the family|strong="H1"\w* \w heads|strong="H7218"\w* \w of Judah|strong="H3063"\w* \w and Benjamin|strong="H1144"\w*, \w along with the priests|strong="H3548"\w* \w and Levites|strong="H3881"\w*— \w everyone|strong="H3605"\w* \w whose spirit|strong="H7307"\w* \w God|strong="H430"\w* \w -|strong="H853"\w* \w had stirred|strong="H5782"\w*— \w prepared|strong="H6965"\w* \w to go up|strong="H5927"\w* \w and rebuild|strong="H1129"\w* \w -|strong="H853"\w* \w the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w* \w -|strong="H834"\w* \w in Jerusalem|strong="H3389"\w*.
\p \v 6 \w And all|strong="H3605"\w* \w their neighbors|strong="H5439"\w* \w supported|strong="H2388"\w* \w them|strong="H3027"\w* \w with articles|strong="H3627"\w* \w of silver|strong="H3701"\w* \w and gold|strong="H2091"\w*, \w with goods|strong="H7399"\w* \w and livestock|strong="H929"\w*, \w and with valuables|strong="H4030"\w*, \w in addition|strong="H905"\w* \w to|strong="H5921"\w* \w all|strong="H3605"\w* \w their freewill offerings|strong="H5068"\w*.
\s1 Cyrus Restores the Holy Vessels
\p \v 7 \w King|strong="H4428"\w* \w Cyrus|strong="H3566"\w* \w also brought out|strong="H3318"\w* \w -|strong="H853"\w* \w the articles|strong="H3627"\w* \w belonging to the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w* \w that|strong="H834"\w* \w Nebuchadnezzar|strong="H5019"\w* \w had carried away|strong="H3318"\w* \w from Jerusalem|strong="H3389"\w* \w and placed|strong="H5414"\w* \w in the temple|strong="H1004"\w* \w of his gods|strong="H430"\w*. \v 8 \w Cyrus|strong="H3566"\w* \w king|strong="H4428"\w* \w of Persia|strong="H6539"\w* \w had them brought out|strong="H3318"\w* \w by|strong="H5921"\w* \w the hand|strong="H3027"\w* \w of Mithredath|strong="H4990"\w* \w the treasurer|strong="H1489"\w*, \w who counted them out|strong="H5608"\w* \w to Sheshbazzar|strong="H8339"\w* \w the prince|strong="H5387"\w* \w of Judah|strong="H3063"\w*.\f + \fr 1:8 \ft That is, the leader of the exiles returning to Judah\f* \v 9 \w This|strong="H428"\w* \w was the inventory|strong="H4557"\w*:
