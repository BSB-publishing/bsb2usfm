\li1 \v 62 \w These [men]|strong="H428"\w* \w searched for|strong="H1245"\w* \w their family records|strong="H3791"\w* \w . . .|strong="H3187"\w*, \w but they could not|strong="H3808"\w* \w find them|strong="H4672"\w* \w and so were excluded|strong="H1351"\w* \w from|strong="H4480"\w* \w the priesthood {as unclean}|strong="H3550"\w*. \v 63 \w The governor|strong="H8660"\w* \w ordered|strong="H559"\w* them\w . . .|strong="H834"\w* \w not|strong="H3808"\w* \w to eat|strong="H398"\w* \w the most holy things|strong="H6944"\w* \w . . .|strong="H6944"\w* \w until|strong="H5704"\w* \w . . .|strong="H5975"\w* \w there was a priest|strong="H3548"\w* \w to consult the Urim|strong="H224"\w* \w and Thummim|strong="H8550"\w*.\f + \fr 2:63 \ft Literally \fqa Lights and Perfections\f*
\p \v 64 \w The whole|strong="H3605"\w* \w assembly|strong="H6951"\w* \w [numbered]|strong="H259"\w* \w 42,360 {}|strong="H702"\w* \w . . .|strong="H7239"\w* \w . . .|strong="H505"\w* \w . . .|strong="H7969"\w* \w . . .|strong="H3967"\w* \w . . .|strong="H8346"\w*, \v 65 \w in addition to|strong="H905"\w* \w . . .|strong="H428"\w* \w their 7,337|strong="H7651"\w* \w . . .|strong="H505"\w* \w . . .|strong="H7969"\w* \w . . .|strong="H3967"\w* \w . . .|strong="H7970"\w* \w . . .|strong="H7651"\w* \w menservants|strong="H5650"\w* \w and maidservants|strong="H519"\w*, \w as well as their 200|strong="H3967"\w* \w male|strong="H7891"\w* \w and female singers|strong="H7891"\w*. \v 66 \w They had 736|strong="H7651"\w* \w . . .|strong="H3967"\w* \w . . .|strong="H7970"\w* \w . . .|strong="H8337"\w* \w horses|strong="H5483"\w*, \w 245|strong="H3967"\w* \w . . .|strong="H705"\w* \w . . .|strong="H2568"\w* \w mules|strong="H6505"\w*, \v 67 \w 435|strong="H702"\w* \w . . .|strong="H3967"\w* \w . . .|strong="H7970"\w* \w . . .|strong="H2568"\w* \w camels|strong="H1581"\w*, \w and 6,720|strong="H8337"\w* \w . . .|strong="H505"\w* \w . . .|strong="H7651"\w* \w . . .|strong="H3967"\w* \w . . .|strong="H6242"\w* \w donkeys|strong="H2543"\w*.
\s1 Offerings by the Exiles
\r (\ref Exodus 38:21–31|EXO 38:21-31\ref*; \ref Nehemiah 7:70–73|NEH 7:70-73\ref*)
\p \v 68 \w When they arrived|strong="H935"\w* \w at the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w* \w -|strong="H834"\w* \w in Jerusalem|strong="H3389"\w*, \w [some] of the heads|strong="H7218"\w* \w of the families|strong="H1"\w* \w gave freewill offerings|strong="H5068"\w* \w to rebuild|strong="H5975"\w* \w the house|strong="H1004"\w* \w of God|strong="H430"\w* \w on|strong="H5921"\w* \w its original site|strong="H4349"\w*. \v 69 \w According to their ability|strong="H3581"\w*, \w they gave|strong="H5414"\w* \w to the treasury|strong="H214"\w* \w for this work|strong="H4399"\w* \w 61,000 {}|strong="H8337"\w* \w . . .|strong="H7239"\w* \w . . .|strong="H505"\w* \w darics|strong="H1871"\w* \w of gold|strong="H2091"\w*,\f + \fr 2:69 \ft Or \fqa 61,000 gold drachmas\ft ; that is, approximately 1,129.7 pounds or 512.4 kilograms of gold coins\f* \w 5,000 {}|strong="H2568"\w* \w . . .|strong="H505"\w* \w minas|strong="H4488"\w* \w of silver|strong="H3701"\w*,\f + \fr 2:69 \fqa 5,000 minas \ft is approximately 3.14 tons or 2.85 metric tons of silver.\f* \w and 100|strong="H3967"\w* \w priestly|strong="H3548"\w* \w garments|strong="H3801"\w*.
\p \v 70 \w So the priests|strong="H3548"\w*, \w the Levites|strong="H3881"\w*, \w the singers|strong="H7891"\w*, \w the gatekeepers|strong="H7778"\w*, \w and the temple servants|strong="H5411"\w*, \w along with some|strong="H4480"\w* \w of the people|strong="H5971"\w*, \w settled|strong="H3427"\w* \w in their own towns|strong="H5892"\w*; \w and the rest|strong="H3605"\w* \w of the Israelites|strong="H3478"\w*\f + \fr 2:70 \ft Or \fqa all Israel\f* \w settled [in their towns]|strong="H5892"\w*.
\c 3
\s1 Sacrifices Restored
\p \v 1 \w By the seventh|strong="H7637"\w* \w month|strong="H2320"\w*, \w the Israelites|strong="H1121"\w* \w . . .|strong="H3478"\w* \w had settled|strong="H5060"\w* \w in their towns|strong="H5892"\w*, \w and the people|strong="H5971"\w* \w assembled|strong="H622"\w* \w as one|strong="H259"\w* \w man|strong="H376"\w* \w in|strong="H413"\w* \w Jerusalem|strong="H3389"\w*.
\p \v 2 \w Then Jeshua|strong="H3442"\w* \w son|strong="H1121"\w* \w of Jozadak|strong="H3136"\w*\f + \fr 3:2 \fqa Jozadak \ft is a variant of \fqa Jehozadak\ft ; also in verse 8; see \ref 1 Chronicles 6:14|1CH 6:14\ref*.\f* \w and his fellow|strong="H251"\w* \w priests|strong="H3548"\w*, \w along with Zerubbabel|strong="H2216"\w* \w son|strong="H1121"\w* \w of Shealtiel|strong="H7597"\w* \w and his associates|strong="H251"\w*, \w began|strong="H6965"\w* \w to build|strong="H1129"\w* \w -|strong="H853"\w* \w the altar|strong="H4196"\w* \w of the God|strong="H430"\w* \w of Israel|strong="H3478"\w* \w to sacrifice|strong="H5927"\w* \w burnt offerings|strong="H5930"\w* \w on it|strong="H5921"\w*, \w as it is written|strong="H3789"\w* \w in the Law|strong="H8451"\w* \w of Moses|strong="H4872"\w* \w the man|strong="H376"\w* \w of God|strong="H430"\w*. \v 3 \w They set up|strong="H3559"\w* \w the altar|strong="H4196"\w* \w on|strong="H5921"\w* \w its foundation|strong="H4350"\w* \w and sacrificed|strong="H5927"\w* \w . . .|strong="H5921"\w* \w burnt offerings|strong="H5930"\w* \w on it|strong="H5921"\w* \w to the LORD|strong="H3068"\w* — \w [both] the morning|strong="H1242"\w* \w and evening|strong="H6153"\w* \w burnt offerings|strong="H5930"\w* — \w even though|strong="H3588"\w* \w they feared|strong="H367"\w* \w the people|strong="H5971"\w* \w of the land|strong="H776"\w*.
\p \v 4 \w They also celebrated|strong="H6213"\w* \w -|strong="H853"\w* \w the Feast|strong="H2282"\w* \w of Tabernacles|strong="H5521"\w*\f + \fr 3:4 \ft That is, Sukkot, the autumn feast of pilgrimage to Jerusalem; also translated as \fqa the Feast of Booths \ft or \fqa the Feast of Shelters \ft and originally called \fqa the Feast of Ingathering\ft (see \ref Exodus 23:16|EXO 23:16\ref* and Exodus 34:22).\f* \w in accordance with what is written|strong="H3789"\w*, \w and they offered burnt offerings|strong="H5930"\w* \w daily|strong="H3117"\w* \w . . .|strong="H3117"\w* \w based on the number|strong="H4557"\w* \w prescribed|strong="H4941"\w* \w . . .|strong="H1697"\w* \w for each day|strong="H3117"\w* \w . . .|strong="H3117"\w*.
\p \v 5 \w After that|strong="H310"\w*, \w they presented the regular|strong="H8548"\w* \w burnt offerings|strong="H5930"\w* \w and [those] for New Moons|strong="H2320"\w* \w and for all|strong="H3605"\w* \w the appointed|strong="H4150"\w* \w sacred feasts|strong="H6942"\w* \w of the LORD|strong="H3068"\w*, \w as well as all|strong="H3605"\w* \w the freewill offerings|strong="H5071"\w* \w brought|strong="H5068"\w* \w to the LORD|strong="H3068"\w*.
\p \v 6 \w On the first|strong="H259"\w* \w day|strong="H3117"\w* \w of the seventh|strong="H7637"\w* \w month|strong="H2320"\w*, \w [the Israelites] began|strong="H2490"\w* \w to offer|strong="H5927"\w* \w burnt offerings|strong="H5930"\w* \w to the LORD|strong="H3068"\w*, \w {although the foundation} of the temple|strong="H1964"\w* \w of the LORD|strong="H3068"\w* \w vvv|strong="H3808"\w* \w had not been laid|strong="H3245"\w*. \v 7 \w They gave|strong="H5414"\w* \w money|strong="H3701"\w* \w to the masons|strong="H2672"\w* \w and carpenters|strong="H2796"\w*, \w and food|strong="H3978"\w* \w and drink|strong="H4960"\w* \w and oil|strong="H8081"\w* \w to the people of Sidon|strong="H6722"\w* \w and Tyre|strong="H6876"\w* \w to bring|strong="H935"\w* \w cedar|strong="H730"\w* \w logs|strong="H6086"\w* \w from|strong="H4480"\w* \w Lebanon|strong="H3844"\w* \w to|strong="H413"\w* \w Joppa|strong="H3305"\w* \w by sea|strong="H3220"\w*, \w as authorized|strong="H7558"\w* \w . . .|strong="H5921"\w* \w by Cyrus|strong="H3566"\w* \w king|strong="H4428"\w* \w of Persia|strong="H6539"\w*.
\s1 Temple Restoration Begins
\p \v 8 \w In the second|strong="H8145"\w* \w month|strong="H2320"\w* \w of the second|strong="H8145"\w* \w year|strong="H8141"\w* \w after they had arrived|strong="H935"\w* \w at|strong="H413"\w* \w the house|strong="H1004"\w* \w of God|strong="H430"\w* \w in Jerusalem|strong="H3389"\w*, \w Zerubbabel|strong="H2216"\w* \w son|strong="H1121"\w* \w of Shealtiel|strong="H7597"\w*, \w Jeshua|strong="H3442"\w* \w son|strong="H1121"\w* \w of Jozadak|strong="H3136"\w*, \w and the rest|strong="H7605"\w* \w of their associates|strong="H251"\w* \w including the priests|strong="H3548"\w*, \w the Levites|strong="H3881"\w*, \w and all|strong="H3605"\w* \w who had returned|strong="H935"\w* \w to Jerusalem|strong="H3389"\w* \w from the captivity|strong="H7628"\w*, \w began [the work]|strong="H2490"\w*. \w They appointed|strong="H5975"\w* \w -|strong="H853"\w* \w Levites|strong="H3881"\w* \w twenty|strong="H6242"\w* \w years of age|strong="H1121"\w* \w . . .|strong="H8141"\w* \w or older|strong="H4605"\w* \w to supervise|strong="H5329"\w* \w . . .|strong="H5921"\w* \w the construction|strong="H4399"\w* \w of the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*. \v 9 \w So Jeshua|strong="H3442"\w* \w and his sons|strong="H1121"\w* \w and brothers|strong="H251"\w*, \w Kadmiel|strong="H6934"\w* \w and his sons|strong="H1121"\w* (\w descendants|strong="H1121"\w* \w of Yehudah|strong="H3063"\w*),\f + \fr 3:9 \ft Hebrew \fqa sons of Judah\ft ; that is, most likely, \fqa sons of Yehudah\ft , another name for \fqa Hodevah \ft or \fqa Hodaviah\ft ; see \ref Ezra 2:40|EZR 2:40\ref* and Nehemiah 7:43.\f* \w [and] the sons|strong="H1121"\w* \w of Henadad|strong="H2582"\w* \w and their sons|strong="H1121"\w* \w and brothers|strong="H251"\w* — \w all Levites|strong="H3881"\w* — \w joined|strong="H5975"\w* \w together|strong="H259"\w* \w to supervise|strong="H5329"\w* \w . . .|strong="H5921"\w* \w those working|strong="H6213"\w* \w . . .|strong="H4399"\w* \w on the house|strong="H1004"\w* \w of God|strong="H430"\w*.
\p \v 10 \w When the builders|strong="H1129"\w* \w -|strong="H853"\w* \w had laid the foundation|strong="H3245"\w* \w of the temple|strong="H1964"\w* \w of the LORD|strong="H3068"\w*, \w the priests|strong="H3548"\w* \w in their apparel|strong="H3847"\w* \w with trumpets|strong="H2689"\w*, \w and the Levites|strong="H3881"\w* (\w the sons|strong="H1121"\w* \w of Asaph|strong="H623"\w*) \w with cymbals|strong="H4700"\w*, \w took their positions|strong="H5975"\w* \w to praise|strong="H1984"\w* \w -|strong="H853"\w* \w the LORD|strong="H3068"\w*, \w as|strong="H5921"\w* \w David|strong="H1732"\w* \w king|strong="H4428"\w* \w of Israel|strong="H3478"\w* \w had prescribed|strong="H3027"\w*. \v 11 \w And they sang responsively|strong="H6030"\w* \w with praise|strong="H1984"\w* \w and thanksgiving|strong="H3034"\w* \w to the LORD|strong="H3068"\w*:
\q1 “\w For|strong="H3588"\w* \w He is good|strong="H2896"\w*;
\q2 \w for|strong="H3588"\w* \w His loving devotion|strong="H2617"\w*\f + \fr 3:11 \ft Forms of the Hebrew \fqa chesed \ft are translated here and in most cases throughout the Scriptures as \fqa loving devotion\ft ; the range of meaning includes \fqa love\ft , \fqa goodness\ft , \fqa kindness\ft , \fqa faithfulness\ft , and \fqa mercy\ft , as well as \fqa loyalty to a covenant\ft .\f* \w to|strong="H5921"\w* \w Israel|strong="H3478"\w* \w endures forever|strong="H5769"\w*.”
\p \w Then all|strong="H3605"\w* \w the people|strong="H5971"\w* \w gave a great|strong="H1419"\w* \w shout|strong="H7321"\w* \w . . .|strong="H8643"\w* \w of praise|strong="H1984"\w* \w to the LORD|strong="H3068"\w*, \w because {the foundation}|strong="H5921"\w* \w of the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w* \w had been laid|strong="H3245"\w*.
\p \v 12 \w But many|strong="H7227"\w* \w of the older|strong="H2205"\w* \w priests|strong="H3548"\w*, \w Levites|strong="H3881"\w*, \w and family|strong="H1"\w* \w heads|strong="H7218"\w* \w who|strong="H834"\w* \w had seen|strong="H7200"\w* \w -|strong="H853"\w* \w the first|strong="H7223"\w* \w temple|strong="H1004"\w* \w wept|strong="H1058"\w* \w loudly|strong="H6963"\w* \w . . .|strong="H1419"\w* \w when they saw|strong="H5869"\w* \w the foundation|strong="H3245"\w* \w of this|strong="H2088"\w* \w temple|strong="H1004"\w*. \w Still, many|strong="H7227"\w* \w others shouted|strong="H8643"\w* \w . . .|strong="H7311"\w* \w joyfully|strong="H6963"\w* \w . . .|strong="H8057"\w*. \v 13 \w The people|strong="H5971"\w* \w could not|strong="H369"\w* \w distinguish|strong="H5234"\w* \w vvv|strong="H6963"\w* \w the shouts|strong="H8643"\w* \w of joy|strong="H8057"\w* \w from the sound|strong="H6963"\w* \w of weeping|strong="H1065"\w*, \w because|strong="H3588"\w* \w . . .|strong="H5971"\w* \w the people|strong="H5971"\w* \w were making so much noise|strong="H7321"\w* \w . . .|strong="H8643"\w* \w . . .|strong="H1419"\w*. \w And the sound|strong="H6963"\w* \w was heard|strong="H8085"\w* \w from|strong="H5704"\w* \w afar|strong="H7350"\w*.
\c 4
\s1 Adversaries Hinder the Work
\p \v 1 \w When the enemies|strong="H6862"\w* \w of Judah|strong="H3063"\w* \w and Benjamin|strong="H1144"\w* \w heard|strong="H8085"\w* \w that|strong="H3588"\w* \w the exiles|strong="H1121"\w* \w . . .|strong="H1473"\w* \w were building|strong="H1129"\w* \w a temple|strong="H1964"\w* \w for the LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \v 2 \w they approached|strong="H5066"\w* \w . . .|strong="H413"\w* \w Zerubbabel|strong="H2216"\w* \w . . .|strong="H413"\w* \w and the heads|strong="H7218"\w* \w of the families|strong="H1"\w*, \w saying|strong="H559"\w* . . ., “\w Let us build|strong="H1129"\w* \w with you|strong="H5973"\w* \w because|strong="H3588"\w*, like you, \w we seek|strong="H1875"\w* \w your God|strong="H430"\w* \w . . .|strong="H587"\w* \w and have been sacrificing|strong="H2076"\w* \w to Him since|strong="H3808"\w* \w the time|strong="H3117"\w* \w of King|strong="H4428"\w*\w . . .|strong="H634"\w* \w Esar-haddon|strong="H634"\w* \w of Assyria|strong="H804"\w*, \w who brought|strong="H5927"\w* \w us|strong="H853"\w* \w here|strong="H6311"\w*.”
\p \v 3 \w But Zerubbabel|strong="H2216"\w*, \w Jeshua|strong="H3442"\w*, \w and the other|strong="H7605"\w* \w heads|strong="H7218"\w* \w of the families|strong="H1"\w* \w of Israel|strong="H3478"\w* \w replied|strong="H559"\w* -, “\w You have no|strong="H3808"\w* part with us \w in building|strong="H1129"\w* \w a house|strong="H1004"\w* \w for our God|strong="H430"\w*, \w since|strong="H3588"\w* \w we|strong="H587"\w* \w alone|strong="H3162"\w* \w must build|strong="H1129"\w* \w it for the LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w as|strong="H834"\w* \w -|strong="H4428"\w* \w Cyrus|strong="H3566"\w* \w king|strong="H4428"\w* \w of Persia|strong="H6539"\w* \w has commanded us|strong="H6680"\w*.”
\p \v 4 \w Then|strong="H1961"\w* \w the people|strong="H5971"\w* \w of the land|strong="H776"\w* \w set out to discourage|strong="H7503"\w* \w . . .|strong="H3027"\w* \w the people|strong="H5971"\w* \w of Judah|strong="H3063"\w* \w and make them afraid|strong="H1089"\w* \w -|strong="H853"\w* \w to build|strong="H1129"\w*. \v 5 \w They hired|strong="H7936"\w* \w counselors|strong="H3289"\w* \w against them|strong="H5921"\w* \w to frustrate|strong="H6565"\w* \w their plans|strong="H6098"\w* \w throughout|strong="H3605"\w* \w the reign|strong="H3117"\w* \w of Cyrus|strong="H3566"\w* \w king|strong="H4428"\w* \w of Persia|strong="H6539"\w* \w and down to|strong="H5704"\w* \w the reign|strong="H4438"\w* \w of Darius|strong="H1867"\w* \w king|strong="H4428"\w* \w of Persia|strong="H6539"\w*.
\s1 Opposition under Xerxes and Artaxerxes
\p \v 6 \w At the beginning|strong="H8462"\w* \w . . .|strong="H4438"\w* \w of the reign|strong="H4438"\w* \w of Xerxes|strong="H325"\w*,\f + \fr 4:6 \ft Hebrew \fqa Ahasuerus\f* \w an accusation|strong="H7855"\w* \w was lodged|strong="H3789"\w* \w against|strong="H5921"\w* \w the people|strong="H3427"\w* \w of Judah|strong="H3063"\w* \w and Jerusalem|strong="H3389"\w*.
\p \v 7 \w And in the days|strong="H3117"\w* \w of Artaxerxes [king]|strong="H783"\w* \w of Persia|strong="H6539"\w*, \w Bishlam|strong="H1312"\w*, \w Mithredath|strong="H4990"\w*, \w Tabeel|strong="H2870"\w*, \w and the rest of|strong="H7605"\w* \w his associates|strong="H3674"\w* \w wrote [a letter]|strong="H3789"\w* \w to|strong="H5921"\w* \w vvv|strong="H4428"\w* \w Artaxerxes|strong="H783"\w*. \w -|strong="H3791"\w* \w [It]|strong="H5406"\w* \w was written|strong="H3789"\w* \w in Aramaic|strong="H762"\w* \w and then translated|strong="H8638"\w* \w -|strong="H762"\w*.\f + \fr 4:7 \ft The original text of \ref Ezra 4:8|EZR 4:8\ref* through Ezra 6:18 is in Aramaic.\f*
\p \v 8 \w Rehum|strong="H7348"\w* \w the commander|strong="H1169"\w* \w . . .|strong="H2942"\w* \w and Shimshai|strong="H8124"\w* \w the scribe|strong="H5613"\w* \w wrote|strong="H3790"\w* \w [the]|strong="H2298"\w* \w letter|strong="H104"\w* \w against|strong="H5922"\w* \w Jerusalem|strong="H3390"\w* \w to King|strong="H4430"\w* \w Artaxerxes|strong="H783"\w* \w as follows|strong="H3660"\w*:
\pmo \v 9 \w -|strong="H116"\w* \w From Rehum|strong="H7348"\w* \w the commander|strong="H1169"\w* \w . . .|strong="H2942"\w*, \w Shimshai|strong="H8124"\w* \w the scribe|strong="H5613"\w*, \w and the rest|strong="H7606"\w* \w of their associates|strong="H3675"\w*— \w the judges|strong="H1784"\w* \w and officials|strong="H671"\w* \w over Tripolis|strong="H2967"\w*, \w Persia|strong="H670"\w*, \w Erech|strong="H756"\w* \w and Babylon|strong="H896"\w*, \w the Elamites|strong="H5962"\w* \w of Susa|strong="H7801"\w*\w . . .|strong="H1768"\w*, \v 10 \w and the rest|strong="H7606"\w* \w of the peoples|strong="H524"\w* \w whom|strong="H1768"\w* \w the great|strong="H7229"\w* \w and honorable|strong="H3358"\w* \w Ashurbanipal|strong="H620"\w*\f + \fr 4:10 \ft Aramaic \fqa Osnappar\ft , another name for \fqa Ashurbanipal\f* \w deported|strong="H1541"\w* \w and settled|strong="H3488"\w* \w . . .|strong="H1994"\w* \w in the cities|strong="H7149"\w* \w of|strong="H1768"\w* \w Samaria|strong="H8115"\w* \w and elsewhere|strong="H7606"\w* \w west|strong="H5675"\w* \w of the Euphrates|strong="H5103"\w* \w . . .|strong="H3706"\w*.\f + \fr 4:10 \ft Aramaic \fqa beyond the River\ft ; also in verses 11, 16, 17, and 20\f*
\pmo \v 11 (\w This|strong="H1836"\w* \w is the text|strong="H6573"\w* \w of the letter|strong="H104"\w* \w . . .|strong="H1768"\w* \w they sent|strong="H7972"\w* \w to him|strong="H5922"\w*.)
\pmo \w To|strong="H5922"\w* \w King|strong="H4430"\w* \w Artaxerxes|strong="H783"\w*,
\pmo \w From your servants|strong="H5649"\w*, \w the men|strong="H606"\w* \w west|strong="H5675"\w* \w of the Euphrates|strong="H5103"\w* \w . . .|strong="H3706"\w*:
\pmo \v 12 \w Let it be|strong="H1934"\w* \w known|strong="H3046"\w* \w to the king|strong="H4430"\w* \w that|strong="H1768"\w* \w the Jews|strong="H3062"\w* \w who|strong="H1768"\w* \w came|strong="H5559"\w* \w from|strong="H4481"\w* \w you|strong="H3890"\w* \w to us|strong="H5922"\w* \w have returned|strong="H858"\w* \w to Jerusalem|strong="H3390"\w* \w and are rebuilding|strong="H1124"\w* \w that rebellious|strong="H4779"\w* \w and wicked|strong="H873"\w* \w city|strong="H7149"\w*. \w They are restoring|strong="H3635"\w* \w [its] walls|strong="H7792"\w* \w and repairing|strong="H2338"\w* \w its foundations|strong="H787"\w*.
\pmo \v 13 \w Let it now|strong="H3705"\w* \w be|strong="H1934"\w* \w known|strong="H3046"\w* \w to the king|strong="H4430"\w* \w that|strong="H1768"\w* \w if|strong="H2006"\w* \w that|strong="H1791"\w* \w city|strong="H7149"\w* \w is rebuilt|strong="H1124"\w* \w and its walls|strong="H7792"\w* \w are restored|strong="H3635"\w*, \w they will not|strong="H3809"\w* \w pay|strong="H5415"\w* \w tribute|strong="H4061"\w*, \w duty|strong="H1093"\w*, \w or toll|strong="H1983"\w*, \w and the royal|strong="H4430"\w* \w treasury|strong="H674"\w* \w will suffer|strong="H5142"\w*.
\pmo \v 14 \w Now|strong="H3705"\w* \w because|strong="H3606"\w*\w . . .|strong="H6903"\w*\w . . .|strong="H1768"\w*\w . . .|strong="H4416"\w* \w we are in the service|strong="H4415"\w* \w of the palace|strong="H1965"\w*\f + \fr 4:14 \ft Literally \fqa because the salt of the palace is our salt\f* \w vvv|strong="H3809"\w* \w and it is not fitting|strong="H749"\w* for us \w to allow|strong="H2370"\w* \w . . .|strong="H5922"\w* \w . . .|strong="H1836"\w* \w the king|strong="H4430"\w* \w to be dishonored|strong="H6173"\w*, \w we have sent|strong="H7972"\w* \w to inform|strong="H3046"\w* \w the king|strong="H4430"\w* \v 15 \w that|strong="H1768"\w* \w a search should be made|strong="H1240"\w* \w of the record|strong="H1799"\w* \w books|strong="H5609"\w* \w of|strong="H1768"\w* \w your fathers|strong="H2"\w*. \w [In these]|strong="H1799"\w* \w books|strong="H5609"\w* \w you will discover|strong="H7912"\w* \w and verify|strong="H3046"\w* \w that|strong="H1768"\w* \w the city|strong="H7149"\w*\w . . .|strong="H1791"\w* \w is a rebellious|strong="H4779"\w* \w city|strong="H7149"\w*, \w harmful|strong="H5142"\w* \w to kings|strong="H4430"\w* \w and provinces|strong="H4083"\w*, \w inciting|strong="H5648"\w* \w sedition|strong="H849"\w* \w -|strong="H1459"\w* \w from|strong="H4481"\w* \w ancient|strong="H5957"\w* \w times|strong="H3118"\w*. \w That is why|strong="H5922"\w* \w this|strong="H1836"\w* \w city|strong="H7149"\w* \w . . .|strong="H1791"\w* \w was destroyed|strong="H2718"\w*.
\pmo \v 16 \w We|strong="H586"\w* \w advise|strong="H3046"\w* \w the king|strong="H4430"\w* \w that|strong="H1768"\w* \w if|strong="H2006"\w* \w this|strong="H1791"\w* \w city|strong="H7149"\w* \w is rebuilt|strong="H1124"\w* \w and its walls|strong="H7792"\w* \w are restored|strong="H3635"\w*, \w . . .|strong="H6903"\w* \w . . .|strong="H1836"\w* \w you will have|strong="H383"\w* \w no|strong="H3809"\w* - \w dominion|strong="H2508"\w* \w west|strong="H5675"\w* \w of the Euphrates|strong="H5103"\w*.
\s1 The Decree of Artaxerxes
\p \v 17 \w [Then] the king|strong="H4430"\w* \w sent|strong="H7972"\w* \w this reply|strong="H6600"\w*:
\pmo \w To|strong="H5922"\w* \w Rehum|strong="H7348"\w* \w the commander|strong="H1169"\w* \w . . .|strong="H2942"\w*, \w Shimshai|strong="H8124"\w* \w the scribe|strong="H5613"\w*, \w and the rest|strong="H7606"\w* \w of your associates|strong="H3675"\w* \w . . .|strong="H1768"\w* \w living|strong="H3488"\w* \w in Samaria|strong="H8115"\w* \w and elsewhere|strong="H7606"\w* \w in the region west|strong="H5675"\w* \w of the Euphrates|strong="H5103"\w*:
\pmo \w Greetings|strong="H8001"\w*. \w . . .|strong="H3706"\w*
\pmo \v 18 \w The letter|strong="H5407"\w* \w . . .|strong="H1768"\w* \w you sent|strong="H7972"\w* \w us|strong="H5922"\w* \w has been translated|strong="H6568"\w* \w and read|strong="H7123"\w* \w in my presence|strong="H6925"\w*. \v 19 \w vvv|strong="H4481"\w* \w I issued|strong="H7761"\w* \w a decree|strong="H2942"\w*, \w and a search was conducted|strong="H1240"\w*. \w It was discovered|strong="H7912"\w* \w that|strong="H1768"\w* \w this|strong="H1791"\w* \w . . .|strong="H4481"\w* \w city|strong="H7149"\w* \w has revolted|strong="H5376"\w* \w against|strong="H5922"\w* \w kings|strong="H4430"\w* \w from ancient|strong="H5957"\w* \w times|strong="H3118"\w*, \w engaging in rebellion|strong="H4776"\w* \w and sedition|strong="H849"\w* \w . . .|strong="H5648"\w*. \v 20 \w And mighty|strong="H8624"\w* \w . . .|strong="H1934"\w* \w kings|strong="H4430"\w* \w have ruled over|strong="H5922"\w* \w Jerusalem|strong="H3390"\w* \w and exercised authority|strong="H7990"\w* \w over the whole|strong="H3606"\w* \w region west|strong="H5675"\w* \w of the Euphrates|strong="H5103"\w*; \w and tribute|strong="H4061"\w*, \w duty|strong="H1093"\w*, \w and toll|strong="H1983"\w* \w were paid|strong="H3052"\w* to them.
\pmo \v 21 \w Now, therefore|strong="H3705"\w*, \w issue|strong="H7761"\w* \w an order|strong="H2942"\w* \w for these|strong="H479"\w* \w men|strong="H1400"\w* \w to stop|strong="H989"\w*, \w so that this|strong="H1791"\w* \w city|strong="H7149"\w* \w will not|strong="H3809"\w* \w be rebuilt|strong="H1124"\w* \w until|strong="H5705"\w* \w I|strong="H4481"\w* \w so order|strong="H2942"\w* \w . . .|strong="H7761"\w*. \v 22 \w See that you|strong="H2095"\w* \w . . .|strong="H1934"\w* \w do not neglect|strong="H7960"\w* \w . . .|strong="H5648"\w* \w . . .|strong="H5922"\w* \w this matter|strong="H1836"\w*. \w Why|strong="H4101"\w* \w allow this threat|strong="H2257"\w* \w to increase|strong="H7680"\w* \w and the royal|strong="H4430"\w* \w interests to suffer|strong="H5142"\w*?
\p \v 23 \w When|strong="H116"\w* \w . . .|strong="H4481"\w* \w . . .|strong="H1768"\w* \w the text|strong="H6573"\w* \w of the letter|strong="H5407"\w*\w . . .|strong="H1768"\w* \w from King|strong="H4430"\w* \w Artaxerxes|strong="H783"\w* \w was read|strong="H7123"\w* \w to|strong="H6925"\w* \w Rehum|strong="H7348"\w*, \w Shimshai|strong="H8124"\w* \w the scribe|strong="H5613"\w*, \w and their associates|strong="H3675"\w*, \w they went|strong="H236"\w* \w immediately|strong="H924"\w* \w to|strong="H5922"\w* \w the Jews|strong="H3062"\w* \w in Jerusalem|strong="H3390"\w* \w and forcibly|strong="H153"\w* \w . . .|strong="H2429"\w* \w stopped|strong="H989"\w* \w them|strong="H1994"\w*.
\p \v 24 \w Thus|strong="H116"\w* \w the construction|strong="H5673"\w* \w of the house|strong="H1005"\w* \w of God|strong="H426"\w* \w . . .|strong="H1768"\w* \w in Jerusalem|strong="H3390"\w* \w ceased|strong="H989"\w*, \w and it remained|strong="H1934"\w* \w at a standstill|strong="H989"\w* \w until|strong="H5705"\w* \w the second|strong="H8648"\w* \w year|strong="H8140"\w* \w of the reign|strong="H4437"\w* \w of Darius|strong="H1868"\w* \w king|strong="H4430"\w* \w of Persia|strong="H6540"\w*.
\c 5
\s1 Temple Rebuilding Resumes
\r (\ref Haggai 1:1–11|HAG 1:1-11\ref*)
\p \v 1 \w Later, the prophets|strong="H5029"\w* \w Haggai|strong="H2292"\w* \w and Zechariah|strong="H2148"\w* \w son|strong="H1247"\w* \w of Iddo|strong="H5714"\w* \w prophesied|strong="H5013"\w*\w . . .|strong="H5029"\w* \w to|strong="H5922"\w* \w the Jews|strong="H3062"\w* \w -|strong="H1768"\w* \w in Judah|strong="H3061"\w* \w and Jerusalem|strong="H3390"\w* \w in the name|strong="H8036"\w* \w of the God|strong="H426"\w* \w of Israel|strong="H3479"\w*, \w who was over them|strong="H5922"\w*. \v 2 \w Then|strong="H116"\w* \w Zerubbabel|strong="H2217"\w* \w son|strong="H1247"\w* \w of Shealtiel|strong="H7598"\w* \w and Jeshua|strong="H3443"\w* \w son|strong="H1247"\w* \w of Jozadak|strong="H3136"\w*\f + \fr 5:2 \fqa Jozadak \ft is a variant of \fqa Jehozadak\ft ; see \ref 1 Chronicles 6:14|1CH 6:14\ref*.\f* \w rose up|strong="H6966"\w* \w and began|strong="H8271"\w* \w to rebuild|strong="H1124"\w* \w the house|strong="H1005"\w* \w of God|strong="H426"\w* \w in Jerusalem|strong="H3390"\w*. \w And the prophets|strong="H5029"\w* \w . . .|strong="H1768"\w* \w of|strong="H1768"\w* \w God|strong="H426"\w* \w were with them|strong="H5974"\w*, \w helping|strong="H5583"\w* them.
\p \v 3 \w At that time|strong="H2166"\w* \w Tattenai|strong="H8674"\w* \w the governor|strong="H6347"\w* \w [of the region] west|strong="H5675"\w* \w of the Euphrates|strong="H5103"\w*,\f + \fr 5:3 \ft Aramaic \fqa the governor beyond the River\ft ; also in verse 6\f* \w vvv|strong="H8370"\w* \w Shethar-bozenai|strong="H8370"\w*, \w and their associates|strong="H3675"\w* \w . . .|strong="H3652"\w* \w went|strong="H858"\w* \w to [the Jews]|strong="H5922"\w* \w and asked|strong="H560"\w*, “\w Who|strong="H4479"\w* \w authorized you|strong="H7761"\w* \w -|strong="H2942"\w* \w to rebuild|strong="H1124"\w* \w this|strong="H1836"\w* \w temple|strong="H1005"\w* \w and restore|strong="H3635"\w* \w this|strong="H1836"\w* \w structure|strong="H846"\w*?”
\p \v 4 \w They also|strong="H116"\w* \w . . .|strong="H3660"\w* \w asked|strong="H560"\w*,\f + \fr 5:4 \ft LXX and Syriac; Aramaic \fqa Then we told them,\f* “\w What|strong="H4479"\w* \w are|strong="H581"\w* \w the names|strong="H8036"\w* \w of the men|strong="H1400"\w* \w who|strong="H1768"\w* \w are constructing|strong="H1124"\w* \w this|strong="H1836"\w* \w building|strong="H1147"\w*?”
\p \v 5 \w But the eye|strong="H5870"\w* \w of their God|strong="H426"\w* \w was|strong="H1934"\w* \w on|strong="H5922"\w* \w the elders|strong="H7868"\w* \w of the Jews|strong="H3062"\w*, \w so that they were not|strong="H3809"\w* \w stopped|strong="H989"\w* \w -|strong="H1994"\w* \w until|strong="H5705"\w* \w a report|strong="H2941"\w* \w was sent|strong="H1946"\w* \w to Darius|strong="H1868"\w* \w and|strong="H116"\w* \w written instructions|strong="H5407"\w* \w about|strong="H5922"\w* \w this matter|strong="H1836"\w* \w were returned|strong="H8421"\w*.
\s1 Tattenai’s Letter to Darius
\p \v 6 \w This is the text|strong="H6573"\w* \w of the letter|strong="H104"\w* \w that|strong="H1768"\w* \w Tattenai|strong="H8674"\w* \w the governor|strong="H6347"\w* \w of the region west|strong="H5675"\w* \w of the Euphrates|strong="H5103"\w*, \w vvv|strong="H8370"\w* \w Shethar-bozenai|strong="H8370"\w*, \w and their associates|strong="H3675"\w*, \w the officials|strong="H671"\w* \w . . .|strong="H1768"\w* \w in the region|strong="H5675"\w*, \w . . .|strong="H5103"\w* \w sent|strong="H7972"\w* \w to|strong="H5922"\w* \w King|strong="H4430"\w* \w Darius|strong="H1868"\w*. \v 7 \w The report|strong="H6600"\w* \w they sent|strong="H7972"\w* \w him|strong="H5922"\w* \w read as follows|strong="H3790"\w* \w . . .|strong="H1459"\w* \w . . .|strong="H1836"\w*:
\pmo \w To King|strong="H4430"\w* \w Darius|strong="H1868"\w*:
\pmo \w All|strong="H3606"\w* \w peace|strong="H8001"\w*.
\pmo \v 8 \w Let it be|strong="H1934"\w* \w known|strong="H3046"\w* \w to the king|strong="H4430"\w* \w that|strong="H1768"\w* \w we went|strong="H236"\w* \w into the province|strong="H4083"\w* \w of Judah|strong="H3061"\w*, \w to the house|strong="H1005"\w* \w of the great|strong="H7229"\w* \w God|strong="H426"\w*. \w [The people]|strong="H1932"\w* \w are rebuilding it|strong="H1124"\w* \w with large stones|strong="H69"\w* \w . . .|strong="H1560"\w* \w and placing|strong="H7761"\w* \w timbers|strong="H636"\w* \w in the walls|strong="H3797"\w*. \w This|strong="H1791"\w* \w work|strong="H5673"\w* \w is being carried out|strong="H5648"\w* \w diligently|strong="H629"\w* \w and is prospering|strong="H6744"\w* \w in their hands|strong="H3028"\w*.
\pmo \v 9 \w So|strong="H116"\w* \w we questioned|strong="H7593"\w* \w the|strong="H479"\w* \w . . .|strong="H3660"\w* \w elders|strong="H7868"\w* \w and asked|strong="H560"\w*, “\w Who|strong="H4479"\w* \w authorized|strong="H7761"\w* \w . . .|strong="H2942"\w* you \w to rebuild|strong="H1124"\w* \w this|strong="H1836"\w* \w temple|strong="H1005"\w* \w and restore|strong="H3635"\w* \w this|strong="H1836"\w* \w structure|strong="H846"\w*?”
\pmo \v 10 \w We also|strong="H638"\w* \w asked for|strong="H7593"\w* their \w names|strong="H8036"\w*, \w so that|strong="H1768"\w* \w we could write down|strong="H3790"\w* \w the names|strong="H8036"\w* \w of their leaders|strong="H1400"\w* \w . . .|strong="H1768"\w* \w . . .|strong="H7217"\w*\f + \fr 5:10 \ft Aramaic \fqa the names of the men at their heads\f* \w for your information|strong="H3046"\w*.
\pmo \v 11 \w And this|strong="H3660"\w* \w is the answer|strong="H6600"\w* \w they returned|strong="H8421"\w* \w . . .|strong="H560"\w*:
\pmo “\w We|strong="H586"\w* \w are|strong="H1994"\w* \w servants|strong="H5649"\w*\w . . .|strong="H1768"\w* \w of the God|strong="H426"\w* \w of heaven|strong="H8065"\w* \w and earth|strong="H772"\w*, \w and we are rebuilding|strong="H1124"\w* \w the temple|strong="H1005"\w* \w that|strong="H1768"\w* \w was|strong="H1934"\w* \w built|strong="H1124"\w* \w many|strong="H7690"\w* \w years|strong="H8140"\w* \w ago|strong="H6928"\w*, \w . . .|strong="H1836"\w* \w which a great|strong="H7229"\w* \w king|strong="H4430"\w* \w of Israel|strong="H3479"\w* \w built|strong="H1124"\w* \w and completed|strong="H3635"\w*. \v 12 \w But|strong="H3861"\w* \w since|strong="H4481"\w* \w . . .|strong="H1768"\w* \w our fathers|strong="H2"\w* \w angered|strong="H7265"\w* \w the God|strong="H426"\w* \w of heaven|strong="H8065"\w*, \w He delivered|strong="H3052"\w* \w them|strong="H1994"\w* \w into the hand|strong="H3028"\w* \w of Nebuchadnezzar|strong="H5020"\w* \w king|strong="H4430"\w* \w of Babylon|strong="H895"\w*, \w the Chaldean|strong="H3679"\w* \w who destroyed|strong="H5642"\w* \w this|strong="H1836"\w* \w temple|strong="H1005"\w* \w and carried away|strong="H1541"\w* \w the people|strong="H5972"\w* \w to Babylon|strong="H895"\w*.
\pmo \v 13 \w In the first|strong="H2298"\w* \w year [of his reign]|strong="H8140"\w*, \w however|strong="H1297"\w*, \w Cyrus|strong="H3567"\w* \w king|strong="H4430"\w* \w of|strong="H1768"\w* \w Babylon|strong="H895"\w* \w -|strong="H3567"\w* \w -|strong="H4430"\w* \w issued|strong="H7761"\w* \w a decree|strong="H2942"\w* \w to rebuild|strong="H1124"\w* \w this|strong="H1836"\w* \w house|strong="H1005"\w* \w of God|strong="H426"\w*. \v 14 \w He also|strong="H638"\w* \w removed|strong="H5312"\w* \w -|strong="H1994"\w* \w from|strong="H4481"\w* \w the temple|strong="H1965"\w*\f + \fr 5:14 \ft Or \fqa palace\f* \w of|strong="H1768"\w* \w Babylon|strong="H895"\w* \w the gold|strong="H1722"\w* \w and silver|strong="H3702"\w* \w articles|strong="H3984"\w* \w belonging to|strong="H1768"\w* \w the house|strong="H1005"\w* \w of God|strong="H426"\w*, \w which|strong="H1768"\w* \w -|strong="H1768"\w* \w Nebuchadnezzar|strong="H5020"\w* \w had taken|strong="H5312"\w* \w and carried|strong="H2987"\w* \w -|strong="H1994"\w* \w [there]|strong="H1965"\w* \w . . .|strong="H1768"\w* \w . . .|strong="H895"\w* \w from|strong="H4481"\w* \w the temple|strong="H1965"\w* \w -|strong="H1768"\w* \w in Jerusalem|strong="H3390"\w*. \w King|strong="H4430"\w* \w Cyrus|strong="H3567"\w* \w gave [these articles]|strong="H3052"\w* \w to a man named|strong="H8036"\w* \w . . .|strong="H1768"\w* \w Sheshbazzar|strong="H8340"\w*, \w whom he appointed|strong="H7761"\w* \w governor|strong="H6347"\w* \v 15 \w and instructed|strong="H560"\w*, ‘\w Take|strong="H5376"\w* \w . . .|strong="H236"\w* \w these|strong="H429"\w* \w articles|strong="H3984"\w*, \w put|strong="H5182"\w* \w them|strong="H1994"\w* \w in the temple|strong="H1965"\w* \w . . .|strong="H1768"\w* \w in Jerusalem|strong="H3390"\w*, \w and let the house|strong="H1005"\w* \w of God|strong="H426"\w* \w be rebuilt|strong="H1124"\w* \w on|strong="H5922"\w* \w its original site|strong="H870"\w*.’
\pmo \v 16 \w So|strong="H116"\w* \w this|strong="H1791"\w* \w Sheshbazzar|strong="H8340"\w* \w came|strong="H858"\w* \w and laid|strong="H3052"\w* \w the foundation|strong="H787"\w* \w of|strong="H1768"\w* \w the house|strong="H1005"\w* \w of God|strong="H426"\w*\w . . .|strong="H1768"\w* \w in Jerusalem|strong="H3390"\w*, \w and from|strong="H4481"\w* \w that time|strong="H116"\w* \w until|strong="H5705"\w* \w now|strong="H3705"\w* \w it has been under construction|strong="H1124"\w*, \w but it has not yet|strong="H3809"\w* \w been completed|strong="H8000"\w*.”
\pmo \v 17 \w Now, therefore,|strong="H3705"\w* \w if|strong="H2006"\w* \w -|strong="H5922"\w* \w it pleases|strong="H2869"\w* \w the king|strong="H4430"\w*, \w let a search be made|strong="H1240"\w* \w of the royal|strong="H1768"\w* \w . . .|strong="H4430"\w* \w . . .|strong="H8536"\w* \w archives|strong="H1005"\w* \w . . .|strong="H1596"\w*\w . . .|strong="H1768"\w* \w in Babylon|strong="H895"\w* \w to see if|strong="H2006"\w* \w . . .|strong="H383"\w* \w . . .|strong="H1768"\w* \w -|strong="H4481"\w* \w King|strong="H4430"\w* \w Cyrus|strong="H3567"\w* \w did indeed issue|strong="H7761"\w* \w a decree|strong="H2942"\w* \w to rebuild|strong="H1124"\w* \w the|strong="H1791"\w* \w house|strong="H1005"\w* \w of God|strong="H426"\w* \w in Jerusalem|strong="H3390"\w*. \w Then let the king|strong="H4430"\w* \w send|strong="H7972"\w* \w us|strong="H5922"\w* \w his decision|strong="H7470"\w* \w in|strong="H5922"\w* \w this [matter]|strong="H1836"\w*.
\c 6
\s1 The Decree of Darius
\p \v 1 \w Thus|strong="H116"\w* \w King|strong="H4430"\w* \w Darius|strong="H1868"\w* \w ordered|strong="H7761"\w* \w . . .|strong="H2942"\w* \w a search|strong="H1240"\w* \w of the archives|strong="H1005"\w* \w stored|strong="H5182"\w* \w . . .|strong="H5609"\w* \w . . .|strong="H1768"\w* \w in the treasury|strong="H1596"\w* \w of Babylon|strong="H895"\w* \w . . .|strong="H8536"\w*. \v 2 \w And a scroll|strong="H4040"\w*\w . . .|strong="H2298"\w* \w was found|strong="H7912"\w* \w in the fortress|strong="H1001"\w* \w . . .|strong="H1768"\w* \w of Ecbatana|strong="H307"\w*, \w in the province|strong="H4083"\w* \w of Media|strong="H4076"\w*, \w with the following|strong="H3652"\w* \w written|strong="H3790"\w* \w on it|strong="H1459"\w*:
\pmo \w Memorandum|strong="H1799"\w*:
\pmo \v 3 \w In the first|strong="H2298"\w* \w year|strong="H8140"\w* \w of King|strong="H4430"\w* \w Cyrus|strong="H3567"\w*, \w he|strong="H3567"\w* \w . . .|strong="H4430"\w* \w issued|strong="H7761"\w* \w a decree [concerning]|strong="H2942"\w* \w the house|strong="H1005"\w* \w of God|strong="H426"\w* \w in Jerusalem|strong="H3390"\w*:
\pmo \w Let the house|strong="H1005"\w* \w be rebuilt|strong="H1124"\w* \w as a place|strong="H870"\w* \w for|strong="H1768"\w* \w offering|strong="H1684"\w* \w sacrifices|strong="H1685"\w*, \w and let its foundations|strong="H787"\w* \w be firmly laid|strong="H5446"\w*. \w It is to be sixty|strong="H8361"\w* \w cubits|strong="H521"\w* \w high|strong="H7314"\w* \w [and] sixty|strong="H8361"\w* \w cubits|strong="H521"\w* \w wide|strong="H6613"\w*,\f + \fr 6:3 \ft The house was to be approximately 90 feet or 27.4 meters in height and width; Syriac (see also \ref 1 Kings 6:2|1KI 6:2\ref*) \fqa It is to be sixty cubits long, twenty cubits wide, and thirty cubits high\ft .\f* \v 4 \w with three|strong="H8532"\w* \w . . .|strong="H5073"\w* \w layers|strong="H5073"\w* \w of|strong="H1768"\w* \w cut stones|strong="H69"\w* \w . . .|strong="H1560"\w* \w and one|strong="H2323"\w* \w of|strong="H1768"\w* \w timbers|strong="H636"\w*. \w The costs|strong="H5313"\w* \w are to be paid|strong="H3052"\w* \w from|strong="H4481"\w* \w the royal|strong="H4430"\w* \w treasury|strong="H1005"\w*.
\pmo \v 5 \w Furthermore|strong="H638"\w*, \w the gold|strong="H1722"\w* \w and silver|strong="H3702"\w* \w . . .|strong="H1768"\w* \w articles|strong="H3984"\w* \w of the house|strong="H1005"\w* \w of God|strong="H426"\w*, \w which|strong="H1768"\w* \w Nebuchadnezzar|strong="H5020"\w* \w took|strong="H5312"\w* \w from|strong="H4481"\w* \w the temple|strong="H1965"\w* \w . . .|strong="H1768"\w* \w in Jerusalem|strong="H3390"\w* \w and carried|strong="H2987"\w* \w to Babylon|strong="H895"\w*, \w must also be returned|strong="H8421"\w* \w -|strong="H1946"\w* \w to the temple|strong="H1965"\w* \w . . .|strong="H1768"\w* \w in Jerusalem|strong="H3390"\w* \w . . .|strong="H870"\w* \w and deposited|strong="H5182"\w* \w in the house|strong="H1005"\w* \w of God|strong="H426"\w*.
\p \v 6 \w Therefore [Darius decreed]|strong="H3705"\w*:
\pmo \w To Tattenai|strong="H8674"\w* \w governor|strong="H6347"\w* \w of the region west|strong="H5675"\w* \w of the Euphrates|strong="H5103"\w*,\f + \fr 6:6 \ft Aramaic \fqa governor beyond the River\ft ; similarly in verses 8 and 13\f* \w vvv|strong="H8370"\w* \w Shethar-bozenai|strong="H8370"\w*, \w and your associates|strong="H3675"\w* \w and officials|strong="H671"\w* \w . . .|strong="H1768"\w* \w in the region|strong="H5675"\w* \w . . .|strong="H5103"\w*:
\pmo \w You must stay|strong="H1934"\w* \w away|strong="H7352"\w* \w from|strong="H4481"\w* \w that place|strong="H8536"\w*! \v 7 \w {Leave} this work|strong="H5673"\w* \w . . .|strong="H1791"\w* \w on the house|strong="H1005"\w* \w of God|strong="H426"\w* \w alone|strong="H7662"\w*. \w Let the governor|strong="H6347"\w* \w and elders|strong="H7868"\w* \w . . .|strong="H3062"\w* \w of the Jews|strong="H3062"\w* \w rebuild|strong="H1124"\w* \w this|strong="H1791"\w* \w house|strong="H1005"\w* \w of God|strong="H426"\w* \w on|strong="H5922"\w* \w its original site|strong="H870"\w*.
\pmo \v 8 \w I hereby|strong="H4481"\w* \w vvv|strong="H7761"\w* \w decree|strong="H2942"\w* \w what|strong="H3964"\w* \w . . .|strong="H1768"\w* \w you must do|strong="H5648"\w* \w for|strong="H5974"\w* \w these|strong="H479"\w* \w elders|strong="H7868"\w* \w of the Jews|strong="H3062"\w* \w who are rebuilding|strong="H1124"\w* \w this|strong="H1791"\w* \w house|strong="H1005"\w* \w of God|strong="H426"\w*:
\pmo \w The cost|strong="H5313"\w* \w is to be|strong="H1934"\w* \w paid|strong="H3052"\w* \w in full|strong="H629"\w* \w to these|strong="H479"\w* \w men|strong="H1400"\w* \w from the royal|strong="H4430"\w* \w treasury|strong="H5232"\w* \w out of|strong="H1768"\w* \w the taxes|strong="H4061"\w* \w of [the provinces] west|strong="H5675"\w* \w of the Euphrates|strong="H5103"\w*, \w so that|strong="H1768"\w* \w the work will not|strong="H3809"\w* \w be hindered|strong="H989"\w*. \v 9 \w Whatever|strong="H4101"\w* \w is needed|strong="H2818"\w*— \w young|strong="H1123"\w* \w bulls|strong="H8450"\w*, \w rams|strong="H1798"\w*, \w and lambs|strong="H563"\w* \w for burnt offerings|strong="H5928"\w* \w to the God|strong="H426"\w* \w of heaven|strong="H8065"\w*, \w as well as wheat|strong="H2591"\w*, \w salt|strong="H4416"\w*, \w wine|strong="H2562"\w*, \w and oil|strong="H4887"\w*, \w as requested|strong="H3983"\w* \w by the priests|strong="H3549"\w* \w . . .|strong="H1768"\w* \w in Jerusalem|strong="H3390"\w*— \w must be|strong="H1934"\w* \w given|strong="H3052"\w* to them \w daily|strong="H3118"\w* \w . . .|strong="H3118"\w* \w vvv|strong="H1768"\w* \w without|strong="H3809"\w* \w fail|strong="H7960"\w*. \v 10 \w Then|strong="H1768"\w* \w they will be able|strong="H1934"\w* \w to offer sacrifices|strong="H7127"\w* \w of a sweet aroma|strong="H5208"\w* \w to the God|strong="H426"\w* \w of heaven|strong="H8065"\w* \w and to pray|strong="H6739"\w* \w for the lives|strong="H2417"\w* \w of the king|strong="H4430"\w* \w and his sons|strong="H1123"\w*.
\pmo \v 11 \w I also|strong="H4481"\w* \w decree|strong="H7761"\w* \w . . .|strong="H2942"\w* \w that|strong="H1768"\w* \w if any|strong="H3606"\w* \w man|strong="H606"\w* \w -|strong="H1768"\w* \w interferes|strong="H8133"\w* \w with this|strong="H1836"\w* \w directive|strong="H6600"\w*, \w a beam|strong="H636"\w* \w is to be torn|strong="H5256"\w* \w from|strong="H4481"\w* \w his house|strong="H1005"\w* \w and raised up|strong="H2211"\w*, \w and he is to be impaled|strong="H4223"\w* \w on it|strong="H5922"\w*. \w And his own house|strong="H1005"\w* \w shall be made|strong="H5648"\w* \w a pile of rubble|strong="H5122"\w* \w for|strong="H5922"\w* \w this [offense]|strong="H1836"\w*.\f + \fr 6:11 \ft Literally \fqa shall be made a dunghill because of this\f* \v 12 \w May God|strong="H426"\w*, \w who|strong="H1768"\w* \w has caused His Name|strong="H8036"\w* \w to dwell|strong="H7932"\w* \w there|strong="H8536"\w*, \w overthrow|strong="H4049"\w* \w any|strong="H3606"\w* \w king|strong="H4430"\w* \w or people|strong="H5972"\w* \w who|strong="H1768"\w* \w lifts|strong="H7972"\w* \w a hand|strong="H3028"\w* \w to alter [this decree]|strong="H8133"\w* \w or to destroy|strong="H2255"\w* \w this|strong="H1791"\w* \w house|strong="H1005"\w* \w of God|strong="H426"\w* \w . . .|strong="H1768"\w* \w in Jerusalem|strong="H3390"\w*.
\pmo \w I|strong="H576"\w*, \w Darius|strong="H1868"\w*, \w have issued|strong="H7761"\w* \w the decree|strong="H2942"\w*. \w Let it be carried out|strong="H5648"\w* \w with diligence|strong="H629"\w*.
\s1 The Temple Completed
\p \v 13 \w In response|strong="H116"\w*, \w Tattenai|strong="H8674"\w* \w the governor|strong="H6347"\w* \w of the region west|strong="H5675"\w* \w of the Euphrates|strong="H5103"\w*, \w vvv|strong="H8370"\w* \w Shethar-bozenai|strong="H8370"\w*, \w and their associates|strong="H3675"\w* \w . . .|strong="H6903"\w* \w diligently|strong="H629"\w* \w carried out|strong="H5648"\w* \w what|strong="H1768"\w* \w King|strong="H4430"\w* \w . . .|strong="H3660"\w* \w Darius|strong="H1868"\w* \w had decreed|strong="H7972"\w*. \v 14 \w So the Jewish|strong="H3062"\w* \w elders|strong="H7868"\w* \w built|strong="H1124"\w* \w and prospered|strong="H6744"\w* \w through the prophesying|strong="H5017"\w* \w of Haggai|strong="H2292"\w* \w the prophet|strong="H5029"\w* \w and Zechariah|strong="H2148"\w* \w son|strong="H1247"\w* \w of Iddo|strong="H5714"\w*.
\p \w They finished|strong="H3635"\w* \w building|strong="H1124"\w* \w according to|strong="H4481"\w* \w the command|strong="H2942"\w* \w of the God|strong="H426"\w* \w of Israel|strong="H3479"\w* \w and the decrees|strong="H2942"\w* \w of Cyrus|strong="H3567"\w*, \w Darius|strong="H1868"\w*, \w and Artaxerxes|strong="H783"\w*, \w kings|strong="H4430"\w* \w of Persia|strong="H6540"\w*. \v 15 \w And this|strong="H1836"\w* \w temple|strong="H1005"\w* \w was completed|strong="H3319"\w* \w on|strong="H5705"\w* \w the third|strong="H8532"\w* \w day|strong="H3118"\w* \w of the month|strong="H3393"\w* \w of Adar|strong="H144"\w*,\f + \fr 6:15 \fqa Adar \ft is the twelfth month of the Hebrew lunar calendar, usually occurring within the months of February and March.\f* \w . . .|strong="H1768"\w* \w . . .|strong="H1932"\w* \w in the sixth|strong="H8353"\w* \w year|strong="H8140"\w* \w of the reign|strong="H4437"\w* \w of King|strong="H4430"\w* \w Darius|strong="H1868"\w*.
\s1 Dedication of the Temple
\p \v 16 \w Then the people|strong="H1123"\w* \w of Israel|strong="H3479"\w* — \w the priests|strong="H3549"\w*, \w the Levites|strong="H3879"\w*, \w and the rest|strong="H7606"\w* \w of the exiles|strong="H1123"\w* \w . . .|strong="H1547"\w* — \w celebrated|strong="H5648"\w* \w the dedication|strong="H2597"\w* \w of the|strong="H1836"\w* \w house|strong="H1005"\w* \w of God|strong="H426"\w* \w with joy|strong="H2305"\w*.
\p \v 17 \w For the|strong="H1836"\w* \w dedication|strong="H2597"\w* \w of the house|strong="H1005"\w* \w of God|strong="H426"\w* \w they offered|strong="H7127"\w* \w a hundred|strong="H3969"\w* \w bulls|strong="H8450"\w*, \w two hundred|strong="H3969"\w* \w rams|strong="H1798"\w*, \w four|strong="H703"\w* \w hundred|strong="H3969"\w* \w lambs|strong="H563"\w*, \w and a sin offering|strong="H2409"\w* \w for|strong="H5922"\w* \w all|strong="H3606"\w* \w Israel|strong="H3479"\w* \w of twelve|strong="H8648"\w* \w . . .|strong="H6236"\w* \w . . .|strong="H4510"\w* \w male goats|strong="H6841"\w* \w . . .|strong="H5796"\w*, \w one for each tribe|strong="H7625"\w* \w of Israel|strong="H3479"\w*.
\p \v 18 \w They also appointed|strong="H6966"\w* \w the priests|strong="H3549"\w* \w by their divisions|strong="H6392"\w* \w and the Levites|strong="H3879"\w* \w by their groups|strong="H4255"\w* \w to|strong="H5922"\w* \w the service|strong="H5673"\w* \w of God|strong="H426"\w* \w . . .|strong="H1768"\w* \w in Jerusalem|strong="H3390"\w*, \w according to what is written|strong="H3792"\w* \w in the Book|strong="H5609"\w* \w of Moses|strong="H4873"\w*.
\s1 The Returned Exiles Keep the Passover
\p \v 19 \w On the fourteenth day|strong="H702"\w* \w . . .|strong="H6240"\w* \w of the first|strong="H7223"\w* \w month|strong="H2320"\w*, \w the exiles|strong="H1121"\w* \w . . .|strong="H1473"\w* \w -|strong="H853"\w* \w kept|strong="H6213"\w* \w the Passover|strong="H6453"\w*. \v 20 \w All|strong="H3605"\w* \w the priests|strong="H3548"\w* \w and Levites|strong="H3881"\w* \w . . .|strong="H259"\w* \w -|strong="H3588"\w* \w had purified themselves|strong="H2891"\w* \w and were ceremonially clean|strong="H2889"\w*.
\p \w And [the Levites] slaughtered|strong="H7819"\w* \w the Passover lamb|strong="H6453"\w* \w for all|strong="H3605"\w* \w the exiles|strong="H1121"\w* \w . . .|strong="H1473"\w*, \w for their priestly|strong="H3548"\w* \w brothers|strong="H251"\w*, and for themselves. \v 21 \w The Israelites|strong="H1121"\w* \w . . .|strong="H3478"\w* \w who had returned|strong="H7725"\w* \w from exile|strong="H1473"\w* \w ate it|strong="H398"\w*, \w together with all|strong="H3605"\w* \w who had separated themselves|strong="H914"\w* \w from the uncleanness|strong="H2932"\w* \w of the peoples|strong="H1471"\w*\f + \fr 6:21 \ft Or \fqa nations\f* \w of the land|strong="H776"\w* \w vvv|strong="H413"\w* \w to seek|strong="H1875"\w* \w the LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*.
\p \v 22 \w For seven|strong="H7651"\w* \w days|strong="H3117"\w* \w they kept|strong="H6213"\w* \w the Feast|strong="H2282"\w* \w of Unleavened Bread|strong="H4682"\w*\f + \fr 6:22 \ft That is, the seven-day period after the Passover during which no leaven may be eaten; see \ref Exodus 12:14–20|EXO 12:14-20\ref*.\f* \w with joy|strong="H8057"\w*, \w because|strong="H3588"\w* \w the LORD|strong="H3068"\w* \w had made them joyful|strong="H8055"\w* \w and turned|strong="H5437"\w* \w the heart|strong="H3820"\w* \w of the king|strong="H4428"\w* \w of Assyria|strong="H804"\w* \w toward them|strong="H5921"\w* \w to strengthen|strong="H2388"\w* \w their hands|strong="H3027"\w* \w in the work|strong="H4399"\w* \w on the house|strong="H1004"\w* \w of the God|strong="H430"\w* \w . . .|strong="H430"\w* \w of Israel|strong="H3478"\w*.
\c 7
\s1 Ezra Arrives in Jerusalem
\p \v 1 \w Many years later|strong="H310"\w* \w . . .|strong="H428"\w* \w . . .|strong="H1697"\w*,\f + \fr 7:1 \ft Literally \fqa After these things\f* \w during the reign|strong="H4438"\w* \w of Artaxerxes|strong="H783"\w* \w king|strong="H4428"\w* \w of Persia|strong="H6539"\w*, \w Ezra|strong="H5830"\w* \w son|strong="H1121"\w* \w of Seraiah|strong="H8304"\w*, \w the son|strong="H1121"\w* \w of Azariah|strong="H5838"\w*, \w the son|strong="H1121"\w* \w of Hilkiah|strong="H2518"\w*, \v 2 \w the son|strong="H1121"\w* \w of Shallum|strong="H7967"\w*, \w the son|strong="H1121"\w* \w of Zadok|strong="H6659"\w*, \w the son|strong="H1121"\w* \w of Ahitub|strong="H285"\w*, \v 3 \w the son|strong="H1121"\w* \w of Amariah|strong="H568"\w*, \w the son|strong="H1121"\w* \w of Azariah|strong="H5838"\w*, \w the son|strong="H1121"\w* \w of Meraioth|strong="H4812"\w*, \v 4 \w the son|strong="H1121"\w* \w of Zerahiah|strong="H2228"\w*, \w the son|strong="H1121"\w* \w of Uzzi|strong="H5813"\w*, \w the son|strong="H1121"\w* \w of Bukki|strong="H1231"\w*, \v 5 \w the son|strong="H1121"\w* \w of Abishua|strong="H50"\w*, \w the son|strong="H1121"\w* \w of Phinehas|strong="H6372"\w*, \w the son|strong="H1121"\w* \w of Eleazar|strong="H499"\w*, \w the son|strong="H1121"\w* \w of Aaron|strong="H175"\w* \w the chief|strong="H7218"\w* \w priest|strong="H3548"\w*— \v 6 \w this|strong="H1931"\w* \w Ezra|strong="H5830"\w* \w came up|strong="H5927"\w* \w from Babylon|strong="H894"\w*. \w He [was]|strong="H1931"\w* \w a scribe|strong="H5608"\w* \w skilled|strong="H4106"\w* \w in the Law|strong="H8451"\w* \w of Moses|strong="H4872"\w*, \w which|strong="H834"\w* \w the LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w had given|strong="H5414"\w*.
\p \w The king|strong="H4428"\w* \w had granted|strong="H5414"\w* [Ezra] \w all|strong="H3605"\w* \w his requests|strong="H1246"\w*, \w for the hand|strong="H3027"\w* \w of the LORD|strong="H3068"\w* \w his God|strong="H430"\w* \w was upon him|strong="H5921"\w*. \v 7 \w So in the seventh|strong="H7651"\w* \w year|strong="H8141"\w* \w of King|strong="H4428"\w* \w Artaxerxes|strong="H783"\w*, \w he went up|strong="H5927"\w* \w to|strong="H413"\w* \w Jerusalem|strong="H3389"\w* \w with some of|strong="H4480"\w* \w the Israelites|strong="H1121"\w* \w . . .|strong="H3478"\w*, \w including priests|strong="H3548"\w*, \w Levites|strong="H3881"\w*, \w singers|strong="H7891"\w*, \w gatekeepers|strong="H7778"\w*, \w and temple servants|strong="H5411"\w*.\f + \fr 7:7 \ft Hebrew \fqa Nethinim\ft ; also in verse 24\f*
\p \v 8 \w Ezra arrived|strong="H935"\w* \w in Jerusalem|strong="H3389"\w* \w in the fifth|strong="H2549"\w* \w . . .|strong="H1931"\w* \w month|strong="H2320"\w* \w of the seventh|strong="H7637"\w* \w year|strong="H8141"\w* \w of the king|strong="H4428"\w*. \v 9 \w -|strong="H3588"\w* \w He|strong="H1931"\w* \w had begun|strong="H3246"\w* \w the journey|strong="H4609"\w* \w from Babylon|strong="H894"\w* \w on the first [day]|strong="H259"\w* \w of the first|strong="H7223"\w* \w month|strong="H2320"\w*, \w and he arrived|strong="H935"\w* \w in|strong="H413"\w* \w Jerusalem|strong="H3389"\w* \w on the first|strong="H259"\w* \w day of the fifth|strong="H2549"\w* \w month|strong="H2320"\w*, \w for the gracious|strong="H2896"\w* \w hand|strong="H3027"\w* \w of his God|strong="H430"\w* \w was upon him|strong="H5921"\w*. \v 10 \w For|strong="H3588"\w* \w Ezra|strong="H5830"\w* \w had set|strong="H3559"\w* \w his heart|strong="H3824"\w* \w to study|strong="H1875"\w* \w -|strong="H853"\w* \w the Law|strong="H8451"\w* \w of the LORD|strong="H3068"\w*, \w to practice it|strong="H6213"\w*, \w and to teach|strong="H3925"\w* \w its statutes|strong="H2706"\w* \w and ordinances|strong="H4941"\w* \w in Israel|strong="H3478"\w*.
\s1 Artaxerxes’ Letter for Ezra
\p \v 11 \w This|strong="H2088"\w* \w is the text|strong="H6572"\w* \w of the letter|strong="H5406"\w* \w -|strong="H834"\w* \w King|strong="H4428"\w* \w Artaxerxes|strong="H783"\w* \w had given|strong="H5414"\w* \w to Ezra|strong="H5830"\w* \w the priest|strong="H3548"\w* \w [and] scribe|strong="H5608"\w*, \w an expert|strong="H5608"\w* \w vvv|strong="H1697"\w* \w in the commandments|strong="H4687"\w* \w and statutes|strong="H2706"\w* \w of the LORD|strong="H3068"\w* \w to|strong="H5921"\w* \w Israel|strong="H3478"\w*:\f + \fr 7:11 \ft The original text of \ref Ezra 7:12–26|EZR 7:12-26\ref* is in Aramaic.\f*
\pmo \v 12 \w Artaxerxes|strong="H783"\w*, \w king|strong="H4430"\w* \w of kings|strong="H4430"\w*.
\pmo \w To Ezra|strong="H5831"\w* \w the priest|strong="H3549"\w*, \w the scribe|strong="H5613"\w* \w of the Law|strong="H1882"\w* \w of|strong="H1768"\w* \w the God|strong="H426"\w* \w of heaven|strong="H8065"\w*:
\pmo \w Greetings|strong="H1585"\w* \w . . .|strong="H3706"\w*.\f + \fr 7:12 \ft Aramaic \fqa Perfect now \ft (probably a greeting)\f*
\pmo \v 13 \w I|strong="H4481"\w* \w hereby|strong="H7761"\w* \w decree|strong="H2942"\w* \w that|strong="H1768"\w* \w any|strong="H3606"\w* \w volunteers|strong="H5069"\w* \w among the Israelites|strong="H5972"\w* \w . . .|strong="H3479"\w* \w in my kingdom|strong="H4437"\w*, \w . . .|strong="H4481"\w* \w including the priests|strong="H3549"\w* \w and Levites|strong="H3879"\w*, \w may go up|strong="H1946"\w* \w with you|strong="H5974"\w* \w -|strong="H1946"\w* \w to Jerusalem|strong="H3390"\w*. \v 14 \w -|strong="H3606"\w* \w -|strong="H6903"\w*\w . . .|strong="H1768"\w* \w You are sent|strong="H7972"\w* \w by|strong="H4481"\w* \w . . .|strong="H6925"\w* \w the king|strong="H4430"\w* \w and his seven|strong="H7655"\w* \w counselors|strong="H3272"\w* \w to evaluate|strong="H1240"\w* \w . . .|strong="H5922"\w* \w Judah|strong="H3061"\w* \w and Jerusalem|strong="H3390"\w* \w according to the Law|strong="H1882"\w* \w of your God|strong="H426"\w*, \w which|strong="H1768"\w* \w is in your hand|strong="H3028"\w*.
\pmo \v 15 \w Moreover, you are to take with you|strong="H2987"\w* \w the silver|strong="H3702"\w* \w and gold|strong="H1722"\w* \w that|strong="H1768"\w* \w the king|strong="H4430"\w* \w and his counselors|strong="H3272"\w* \w have freely offered|strong="H5069"\w* \w to the God|strong="H426"\w* \w of Israel|strong="H3479"\w*, \w whose|strong="H1768"\w* \w dwelling|strong="H4907"\w* \w is in Jerusalem|strong="H3390"\w*, \v 16 \w together with all|strong="H3606"\w* \w the silver|strong="H3702"\w* \w and gold|strong="H1722"\w* \w . . .|strong="H1768"\w* \w you may find|strong="H7912"\w* \w in all|strong="H3606"\w* \w the province|strong="H4083"\w* \w of Babylon|strong="H895"\w*, \w as well as|strong="H5974"\w* \w the freewill offerings|strong="H5069"\w* \w of the people|strong="H5972"\w* \w and priests|strong="H3549"\w* \w . . .|strong="H5069"\w* \w to the house|strong="H1005"\w* \w of their God|strong="H426"\w* \w . . .|strong="H1768"\w* \w in Jerusalem|strong="H3390"\w*. \v 17 \w With this|strong="H1836"\w* \w money|strong="H3702"\w*, \w . . .|strong="H3606"\w*\w . . .|strong="H6903"\w* \w therefore|strong="H1836"\w*, \w you are to buy|strong="H7066"\w* \w as many bulls|strong="H8450"\w*, \w rams|strong="H1798"\w*, \w and lambs|strong="H563"\w* \w as needed|strong="H629"\w*, \w together with their grain offerings|strong="H4504"\w* \w and drink offerings|strong="H5261"\w*, \w and offer|strong="H7127"\w* \w them|strong="H1994"\w* \w on|strong="H5922"\w* \w the altar|strong="H4056"\w* \w . . .|strong="H1768"\w* \w at the house|strong="H1005"\w* \w of your God|strong="H426"\w* \w . . .|strong="H1768"\w* \w in Jerusalem|strong="H3390"\w*. \v 18 \w You and your brothers|strong="H252"\w* \w may do|strong="H5648"\w* \w whatever|strong="H4101"\w* \w . . .|strong="H1768"\w* \w . . .|strong="H5922"\w* \w -|strong="H5922"\w* \w seems best|strong="H3191"\w* \w with the rest|strong="H7606"\w* \w of the silver|strong="H3702"\w* \w and gold|strong="H1722"\w*, \w according to the will|strong="H7470"\w* \w of your God|strong="H426"\w* \w . . .|strong="H5648"\w*.
\pmo \v 19 \w You must deliver|strong="H8000"\w* \w to|strong="H6925"\w* \w the God|strong="H426"\w* \w of Jerusalem|strong="H3390"\w* \w all the articles|strong="H3984"\w* \w . . .|strong="H1768"\w* \w given|strong="H3052"\w* to you \w for the service|strong="H6402"\w* \w of the house|strong="H1005"\w* \w of your God|strong="H426"\w*. \v 20 \w And if anything else|strong="H7606"\w* \w is needed|strong="H2819"\w* \w for the house|strong="H1005"\w* \w of your God|strong="H426"\w* \w that|strong="H1768"\w* you \w may have occasion|strong="H5308"\w* \w to supply|strong="H5415"\w*, \w you may pay [for it]|strong="H5415"\w* \w from|strong="H4481"\w* \w the royal|strong="H4430"\w* \w vvv|strong="H1005"\w* \w treasury|strong="H1596"\w*.
\pmo \v 21 \w -|strong="H4481"\w* \w I|strong="H576"\w*, \w King|strong="H4430"\w* \w Artaxerxes|strong="H783"\w*, \w vvv|strong="H7761"\w* \w decree|strong="H2942"\w* \w to all|strong="H3606"\w* \w the treasurers|strong="H1490"\w* \w -|strong="H1768"\w* \w west|strong="H5675"\w* \w of the Euphrates|strong="H5103"\w*:\f + \fr 7:21 \ft Aramaic \fqa beyond the River\ft ; also in verse 25\f*\w . . .|strong="H1768"\w* \w Whatever|strong="H3606"\w* \w . . .|strong="H1768"\w* \w Ezra|strong="H5831"\w* \w the priest|strong="H3549"\w*, \w the scribe|strong="H5613"\w* \w of the Law|strong="H1882"\w*\w . . .|strong="H1768"\w* \w of the God|strong="H426"\w* \w of heaven|strong="H8065"\w*, \w may require of you|strong="H7593"\w*, \w it must be provided|strong="H5648"\w* \w promptly|strong="H629"\w*, \v 22 \w up to|strong="H5705"\w* \w a hundred|strong="H3969"\w* \w talents|strong="H3604"\w* \w . . .|strong="H5705"\w* \w of silver|strong="H3702"\w*,\f + \fr 7:22 \fqa 100 talents \ft is approximately 3.77 tons or 3.42 metric tons of silver.\f* \w a hundred|strong="H3969"\w* \w cors|strong="H3734"\w* \w of wheat|strong="H2591"\w*,\f + \fr 7:22 \fqa 100 cors \ft is approximately 624 bushels or 22,000 liters (probably about 19.2 tons or 17.4 metric tons of wheat).\f* \w -|strong="H5705"\w* \w a hundred|strong="H3969"\w* \w baths|strong="H1325"\w* \w . . .|strong="H5705"\w* \w of wine|strong="H2562"\w*,\f + \fr 7:22 \fqa 100 baths \ft is approximately 580 gallons or 2,200 liters of wine.\f* \w a hundred|strong="H3969"\w* \w baths|strong="H1325"\w* \w of olive oil|strong="H4887"\w*,\f + \fr 7:22 \ft Or \fqa 100 baths of oil\ft ; that is, approximately 580 gallons or 2,200 liters\f* \w and salt|strong="H4416"\w* \w . . .|strong="H1768"\w* \w without|strong="H3809"\w* \w limit|strong="H3792"\w*. \v 23 \w Whatever|strong="H3606"\w* \w . . .|strong="H1768"\w* \w is commanded|strong="H2942"\w* \w by|strong="H4481"\w* \w the God|strong="H426"\w* \w of heaven|strong="H8065"\w* \w must be done|strong="H5648"\w* \w diligently|strong="H149"\w* \w for [His] house|strong="H1005"\w* \w . . .|strong="H426"\w* \w . . .|strong="H8065"\w*. \w For|strong="H1768"\w* \w why|strong="H4101"\w* \w should wrath|strong="H7109"\w* \w fall|strong="H1934"\w* \w on|strong="H5922"\w* \w the realm|strong="H4437"\w* \w of the king|strong="H4430"\w* \w and his sons|strong="H1123"\w*? \v 24 And \w be advised|strong="H3046"\w* \w that|strong="H1768"\w* \w you have no|strong="H3809"\w* \w authority|strong="H7990"\w* \w to impose|strong="H7412"\w* \w tribute|strong="H4061"\w*, \w duty|strong="H1093"\w*, \w or toll|strong="H1983"\w* \w on|strong="H5922"\w* \w any|strong="H3606"\w* \w of the priests|strong="H3549"\w*, \w Levites|strong="H3879"\w*, \w singers|strong="H2171"\w*, \w doorkeepers|strong="H8652"\w*, \w temple servants|strong="H5412"\w*, \w or other servants|strong="H6399"\w* \w of this|strong="H1836"\w* \w house|strong="H1005"\w* \w of God|strong="H426"\w*.
\pmo \v 25 \w And you|strong="H607"\w*, \w Ezra|strong="H5831"\w*, \w according to the wisdom|strong="H2452"\w* \w of your God|strong="H426"\w*, \w which you possess|strong="H1768"\w* \w . . .|strong="H3028"\w*, \w are to appoint|strong="H4483"\w* \w magistrates|strong="H8200"\w* \w and judges|strong="H1782"\w*\w . . .|strong="H1768"\w*\w . . .|strong="H1934"\w* \w to judge|strong="H1778"\w* \w all|strong="H3606"\w* \w the people|strong="H5972"\w* \w . . .|strong="H1768"\w* \w west|strong="H5675"\w* \w of the Euphrates|strong="H5103"\w* — \w all|strong="H3606"\w* \w who know|strong="H3046"\w* \w the laws|strong="H1882"\w* \w of your God|strong="H426"\w*. \w And you are to teach [these laws]|strong="H3046"\w* \w to anyone who|strong="H1768"\w* \w does not|strong="H3809"\w* \w know them|strong="H3046"\w*. \v 26 \w If anyone|strong="H3606"\w* \w . . .|strong="H1768"\w* \w does|strong="H1934"\w* \w not|strong="H3809"\w* \w keep|strong="H5648"\w* \w the law|strong="H1882"\w* \w of|strong="H1768"\w* \w your God|strong="H426"\w* \w and the law|strong="H1882"\w* \w of|strong="H1768"\w* \w the king|strong="H4430"\w*, \w let a strict|strong="H629"\w* \w judgment|strong="H1780"\w* \w be|strong="H1934"\w* \w executed|strong="H5648"\w* \w against him|strong="H4481"\w*, \w whether|strong="H2006"\w* \w death|strong="H4193"\w*, \w . . .|strong="H2006"\w* \w banishment|strong="H8332"\w*, \w . . .|strong="H2006"\w* \w confiscation|strong="H6065"\w* \w of property|strong="H5232"\w*, \w or imprisonment|strong="H613"\w*.
\s1 Ezra Blesses God
\p \v 27 \w Blessed [be]|strong="H1288"\w* \w the LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of our fathers|strong="H1"\w*, \w who|strong="H834"\w* \w has put|strong="H5414"\w* \w -|strong="H2063"\w* \w into the heart|strong="H3820"\w* \w of the king|strong="H4428"\w* \w to so honor|strong="H6286"\w* \w -|strong="H853"\w* \w the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w* \w -|strong="H834"\w* \w in Jerusalem|strong="H3389"\w*, \v 28 \w and who has shown|strong="H5186"\w* \w me|strong="H5921"\w* \w favor|strong="H2617"\w* \w before|strong="H6440"\w* \w the king|strong="H4428"\w*, \w his counselors|strong="H3289"\w*, \w and all|strong="H3605"\w* \w his|strong="H4428"\w* \w powerful|strong="H1368"\w* \w officials|strong="H8269"\w*.
\p \w And because the hand|strong="H3027"\w* \w of the LORD|strong="H3068"\w* \w my God|strong="H430"\w* \w [was] upon me|strong="H5921"\w*, \w I|strong="H589"\w* \w took courage|strong="H2388"\w* \w and gathered|strong="H6908"\w* \w the leaders|strong="H7218"\w* \w of Israel|strong="H3478"\w* \w to return|strong="H5927"\w* \w with me|strong="H5973"\w*.
\c 8
\s1 The Exiles Who Returned with Ezra
\p \v 1 \w These|strong="H428"\w* \w are the family|strong="H1"\w* \w heads|strong="H7218"\w* \w and genealogical records|strong="H3187"\w* \w of those who returned|strong="H5927"\w* \w with me|strong="H5973"\w* \w from Babylon|strong="H894"\w* \w during the reign|strong="H4438"\w* \w of King|strong="H4428"\w* \w Artaxerxes|strong="H783"\w*:
\li1 \v 2 \w from the descendants|strong="H1121"\w* \w of Phinehas|strong="H6372"\w*, \w Gershom|strong="H1647"\w*;
\li1 \w from the descendants|strong="H1121"\w* \w of Ithamar|strong="H385"\w*, \w Daniel|strong="H1841"\w*;
\li1 \w from the descendants of|strong="H1121"\w* \w David|strong="H1732"\w*, \w Hattush|strong="H2407"\w* \v 3 \w of the descendants|strong="H1121"\w* \w of Shecaniah|strong="H7935"\w*;
\li1 \w from the descendants|strong="H1121"\w* \w of Parosh|strong="H6551"\w*, \w Zechariah|strong="H2148"\w*, \w and with him|strong="H5973"\w* \w [were] registered|strong="H3187"\w* \w 150|strong="H3967"\w* \w . . .|strong="H2572"\w* \w men|strong="H2145"\w*;
\li1 \v 4 \w from the descendants|strong="H1121"\w* \w vvv|strong="H6355"\w* \w of Pahath-Moab|strong="H6355"\w*, \w Eliehoenai|strong="H454"\w* \w son|strong="H1121"\w* \w of Zerahiah|strong="H2228"\w*, \w and with him|strong="H5973"\w* \w 200|strong="H3967"\w* \w men|strong="H2145"\w*;
\li1 \v 5 \w from the descendants [of Zattu]|strong="H1121"\w*, \w Shecaniah|strong="H7935"\w* \w son|strong="H1121"\w* \w of Jahaziel|strong="H3166"\w*,\f + \fr 8:5 \ft Some LXX manuscripts (see also \ref 1 Esdras 8:32|8:32\ref*); Hebrew \fqa from the descendants of Shecaniah, the son of Jahaziel\f* \w and with him|strong="H5973"\w* \w 300|strong="H7969"\w* \w . . .|strong="H3967"\w* \w men|strong="H2145"\w*;
\li1 \v 6 \w from the descendants|strong="H1121"\w* \w of Adin|strong="H5720"\w*, \w Ebed|strong="H5651"\w* \w son|strong="H1121"\w* \w of Jonathan|strong="H3129"\w*, \w and with him|strong="H5973"\w* \w 50|strong="H2572"\w* \w men|strong="H2145"\w*;
\li1 \v 7 \w from the descendants|strong="H1121"\w* \w of Elam|strong="H5867"\w*, \w Jeshaiah|strong="H3470"\w* \w son|strong="H1121"\w* \w of Athaliah|strong="H6271"\w*, \w and with him|strong="H5973"\w* \w 70|strong="H7657"\w* \w men|strong="H2145"\w*;
\li1 \v 8 \w from the descendants|strong="H1121"\w* \w of Shephatiah|strong="H8203"\w*, \w Zebadiah|strong="H2069"\w* \w son|strong="H1121"\w* \w of Michael|strong="H4317"\w*, \w and with him|strong="H5973"\w* \w 80|strong="H8084"\w* \w men|strong="H2145"\w*;
\li1 \v 9 \w from the descendants|strong="H1121"\w* \w of Joab|strong="H3097"\w*, \w Obadiah|strong="H5662"\w* \w son|strong="H1121"\w* \w of Jehiel|strong="H3171"\w*, \w and with him|strong="H5973"\w* \w 218|strong="H3967"\w* \w . . .|strong="H8083"\w* \w . . .|strong="H6240"\w* \w men|strong="H2145"\w*;
\li1 \v 10 \w from the descendants [of Bani]|strong="H1121"\w*, \w Shelomith|strong="H8019"\w* \w son|strong="H1121"\w* \w of Josiphiah|strong="H3131"\w*,\f + \fr 8:10 \ft Some LXX manuscripts (see also \ref 1 Esdras 8:36|8:36\ref*); Hebrew \fqa from the descendants of Shelomith, the son of Josiphiah\f* \w and with him|strong="H5973"\w* \w 160|strong="H3967"\w* \w . . .|strong="H8346"\w* \w men|strong="H2145"\w*;
\li1 \v 11 \w from the descendants|strong="H1121"\w* \w of Bebai|strong="H893"\w*, \w Zechariah|strong="H2148"\w* \w son|strong="H1121"\w* \w of Bebai|strong="H893"\w*, \w and with him|strong="H5973"\w* \w 28|strong="H6242"\w* \w . . .|strong="H8083"\w* \w men|strong="H2145"\w*;
\li1 \v 12 \w from the descendants|strong="H1121"\w* \w of Azgad|strong="H5803"\w*, \w Johanan|strong="H3110"\w* \w son|strong="H1121"\w* \w of Hakkatan|strong="H6997"\w*, \w and with him|strong="H5973"\w* \w 110|strong="H3967"\w* \w . . .|strong="H6235"\w* \w men|strong="H2145"\w*;
\li1 \v 13 \w from the later|strong="H314"\w*\f + \fr 8:13 \ft Or \fqa the last\f* \w descendants|strong="H1121"\w* \w of Adonikam|strong="H140"\w*, \w these|strong="H428"\w* \w [were] their names|strong="H8034"\w*: \w Eliphelet|strong="H467"\w*, \w Jeiel|strong="H3273"\w*, \w and Shemaiah|strong="H8098"\w*, \w and with them|strong="H5973"\w* \w 60|strong="H8346"\w* \w men|strong="H2145"\w*;
\li1 \v 14 \w and from the descendants|strong="H1121"\w* \w of Bigvai|strong="H902"\w*, \w [both] Uthai|strong="H5793"\w* \w and Zaccur|strong="H2139"\w*,\f + \fr 8:14 \ft LXX, Syriac, and an alternate MT reading; the other alternate reads \fqa Zabbud\ft .\f* \w and with them|strong="H5973"\w* \w 70|strong="H7657"\w* \w men|strong="H2145"\w*.
