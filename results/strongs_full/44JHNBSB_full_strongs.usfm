\p \v 25 \w -|strong="G1161"\w* \w There are|strong="G1510"\w* \w many|strong="G4183"\w* \w more things|strong="G243"\w* \w . . .|strong="G2532"\w* \w that|strong="G3739"\w* \w -|strong="G3588"\w* \w Jesus|strong="G2424"\w* \w did|strong="G4160"\w*. \w -|strong="G3748"\w* \w If|strong="G1437"\w* \w all of them|strong="G2596"\w* \w . . .|strong="G1520"\w* \w were written down|strong="G1125"\w*, \w I suppose that|strong="G3633"\w* \w not even|strong="G3761"\w* \w the|strong="G3588"\w* \w world|strong="G2889"\w* \w itself|strong="G846"\w* \w would have space|strong="G5562"\w* \w for the|strong="G3588"\w* \w books|strong="G975"\w* \w that would be written|strong="G1125"\w*.
