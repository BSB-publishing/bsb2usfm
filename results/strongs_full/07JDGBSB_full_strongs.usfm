\p \v 45 \w Then the Benjamites turned|strong="H6437"\w* \w and fled|strong="H5127"\w* \w toward the wilderness|strong="H4057"\w* \w to|strong="H413"\w* \w the rock|strong="H5553"\w* \w of Rimmon|strong="H7417"\w*, \w and Israel cut down|strong="H5953"\w* \w 5,000 {}|strong="H2568"\w* \w . . .|strong="H505"\w* \w men|strong="H376"\w* \w on the roads|strong="H4546"\w*. \w And they overtook them|strong="H1692"\w* \w . . .|strong="H310"\w* \w at|strong="H5704"\w* \w Gidom|strong="H1440"\w* \w and struck down|strong="H5221"\w* \w . . .|strong="H4480"\w* \w 2,000 more|strong="H505"\w*. \w . . .|strong="H376"\w*
\p \v 46 \w That|strong="H1931"\w* \w -|strong="H853"\w* \w day|strong="H3117"\w* \w -|strong="H3605"\w* \w -|strong="H1961"\w* \w 25,000 {}|strong="H6242"\w* \w . . .|strong="H2568"\w* \w . . .|strong="H505"\w* \w Benjamite|strong="H1144"\w* \w vvv|strong="H8025"\w* \w swordsmen|strong="H2719"\w* \w . . .|strong="H376"\w* \w fell|strong="H5307"\w*, \w all|strong="H3605"\w* \w . . .|strong="H428"\w* \w men|strong="H582"\w* \w of valor|strong="H2428"\w*. \v 47 \w But 600|strong="H8337"\w* \w . . .|strong="H3967"\w* \w men|strong="H376"\w* \w turned|strong="H6437"\w* \w and fled|strong="H5127"\w* \w into the wilderness|strong="H4057"\w* \w to|strong="H413"\w* \w the rock|strong="H5553"\w* \w of Rimmon|strong="H7417"\w*, \w where they stayed|strong="H3427"\w* \w . . .|strong="H5553"\w* \w . . .|strong="H7417"\w* \w four|strong="H702"\w* \w months|strong="H2320"\w*. \v 48 \w And the men|strong="H376"\w* \w of Israel|strong="H3478"\w* \w turned back|strong="H7725"\w* \w against|strong="H413"\w* \w the other Benjamites|strong="H1121"\w* \w . . .|strong="H1144"\w* \w and put|strong="H5221"\w* \w vvv|strong="H6310"\w* \w to the sword|strong="H2719"\w* \w all|strong="H4974"\w* \w the cities|strong="H5892"\w*, \w including the animals|strong="H929"\w* \w . . .|strong="H5704"\w* \w and|strong="H5704"\w* \w everything else|strong="H3605"\w* \w they found|strong="H4672"\w*. \w And they|strong="H1571"\w* \w burned down|strong="H7971"\w* \w . . .|strong="H784"\w* \w all|strong="H3605"\w* \w the cities|strong="H5892"\w* \w in their path|strong="H4672"\w*.
\c 21
\s1 Wives for the Benjamites
\p \v 1 \w Now the men|strong="H376"\w* \w of Israel|strong="H3478"\w* \w had sworn an oath|strong="H7650"\w* \w at Mizpah|strong="H4709"\w*, \w saying|strong="H559"\w*, “\w Not one|strong="H376"\w* \w . . .|strong="H3808"\w* \w of us|strong="H4480"\w* \w will give his daughter|strong="H1323"\w* \w in marriage|strong="H5414"\w* \w to a Benjamite|strong="H1144"\w* \w . . .|strong="H802"\w*.”
\p \v 2 \w So the people|strong="H5971"\w* \w came|strong="H935"\w* \w vvv|strong="H1008"\w* \w to Bethel|strong="H1008"\w* \w and sat|strong="H3427"\w* \w there|strong="H8033"\w* \w before|strong="H6440"\w* \w God|strong="H430"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*, \w lifting up|strong="H5375"\w* \w their voices|strong="H6963"\w* \w and weeping|strong="H1058"\w* \w . . .|strong="H1065"\w* \w bitterly|strong="H1419"\w*. \v 3 “\w Why|strong="H4100"\w*, \w O LORD|strong="H3068"\w* \w God|strong="H430"\w* \w of Israel|strong="H3478"\w*,” \w they cried out|strong="H559"\w*, “\w has this|strong="H2063"\w* \w happened|strong="H1961"\w* \w in Israel|strong="H3478"\w*? \w Today|strong="H3117"\w* \w in Israel|strong="H3478"\w* \w one|strong="H259"\w* \w tribe|strong="H7626"\w* \w is missing|strong="H6485"\w*!”
\p \v 4 \w -|strong="H1961"\w* \w The next day|strong="H4283"\w* \w the people|strong="H5971"\w* \w got up early|strong="H7925"\w*, \w built|strong="H1129"\w* \w an altar|strong="H4196"\w* \w there|strong="H8033"\w*, \w and presented|strong="H5927"\w* \w burnt offerings|strong="H5930"\w* \w and peace offerings|strong="H8002"\w*. \v 5 \w The Israelites|strong="H1121"\w* \w . . .|strong="H3478"\w* \w asked|strong="H559"\w*, “\w Who|strong="H4310"\w* \w -|strong="H834"\w* \w among all|strong="H3605"\w* \w the tribes|strong="H7626"\w* \w of Israel|strong="H3478"\w* \w did not|strong="H3808"\w* \w come|strong="H5927"\w* \w to the assembly|strong="H6951"\w* \w before|strong="H413"\w* \w the LORD|strong="H3068"\w*?” \w For|strong="H3588"\w* \w they had taken|strong="H1961"\w* \w a solemn|strong="H1419"\w* \w oath|strong="H7621"\w* \w that anyone|strong="H834"\w* \w who failed|strong="H3808"\w* \w to come up|strong="H5927"\w* \w before|strong="H413"\w* \w the LORD|strong="H3068"\w* \w at Mizpah|strong="H4709"\w* \w . . .|strong="H559"\w* \w would surely be put to death|strong="H4191"\w* \w . . .|strong="H4191"\w*.
\p \v 6 \w And the Israelites|strong="H1121"\w* \w . . .|strong="H3478"\w* \w grieved|strong="H5162"\w* \w for|strong="H413"\w* \w their brothers|strong="H251"\w*, \w the Benjamites|strong="H1144"\w*, \w and said|strong="H559"\w*, “\w Today|strong="H3117"\w* \w a|strong="H259"\w* \w tribe|strong="H7626"\w* \w is cut off|strong="H1438"\w* \w from Israel|strong="H3478"\w*. \v 7 \w What|strong="H4100"\w* \w should we do|strong="H6213"\w* - \w about wives|strong="H802"\w* \w for the survivors|strong="H3498"\w*, \w since we|strong="H587"\w* \w have sworn|strong="H7650"\w* \w by the LORD|strong="H3068"\w* \w not|strong="H1115"\w* \w to give|strong="H5414"\w* them \w our daughters|strong="H1323"\w* \w in marriage|strong="H802"\w*?”
