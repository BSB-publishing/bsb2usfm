\s1 The Fall of Shechem
\p \v 30 \w When Zebul|strong="H2083"\w* \w the governor|strong="H8269"\w* \w of the city|strong="H5892"\w* \w -|strong="H853"\w* \w heard|strong="H8085"\w* \w the words|strong="H1697"\w* \w of Gaal|strong="H1603"\w* \w son|strong="H1121"\w* \w of Ebed|strong="H5651"\w*, \w he burned|strong="H2734"\w* \w with anger|strong="H639"\w*. \v 31 \w So he covertly sent|strong="H7971"\w* \w . . .|strong="H8649"\w* \w messengers|strong="H4397"\w* \w to|strong="H413"\w* \w Abimelech|strong="H40"\w*\f + \fr 9:31 \ft Or \fqa he sent messengers to Abimelech in Arumah\ft ; see verse 41.\f* \w to say|strong="H559"\w*, “\w Look|strong="H2009"\w*, \w Gaal|strong="H1603"\w* \w son|strong="H1121"\w* \w of Ebed|strong="H5651"\w* \w and his brothers|strong="H251"\w* \w have come|strong="H935"\w* \w to Shechem|strong="H7927"\w* \w . . .|strong="H2009"\w* \w and are stirring up|strong="H6696"\w*\f + \fr 9:31 \ft Or \fqa besieging \ft or \fqa closing up\f* \w -|strong="H853"\w* \w the city|strong="H5892"\w* \w against you|strong="H5921"\w*. \v 32 \w Now then|strong="H6258"\w*, \w tonight|strong="H3915"\w* \w you|strong="H859"\w* \w and the people|strong="H5971"\w* \w -|strong="H834"\w* \w with you|strong="H854"\w* \w are to come|strong="H6965"\w* \w and lie in wait|strong="H693"\w* \w in the fields|strong="H7704"\w*. \v 33 \w And|strong="H1961"\w* \w in the morning|strong="H1242"\w* \w at sunrise|strong="H2224"\w* \w . . .|strong="H8121"\w*, \w get up|strong="H7925"\w* \w and advance|strong="H6584"\w* \w against|strong="H5921"\w* \w the city|strong="H5892"\w*. \w . . .|strong="H2009"\w* \w When [Gaal]|strong="H1931"\w* \w and his men|strong="H5971"\w* \w -|strong="H834"\w* \w -|strong="H854"\w* \w come out|strong="H3318"\w* \w against you|strong="H413"\w*, \w do|strong="H6213"\w* to them \w whatever|strong="H834"\w* \w you are able|strong="H4672"\w* \w . . .|strong="H3027"\w*.”
\p \v 34 \w So Abimelech|strong="H40"\w* \w and all|strong="H3605"\w* \w his troops|strong="H5971"\w* \w -|strong="H834"\w* \w -|strong="H5973"\w* \w set out|strong="H6965"\w* \w by night|strong="H3915"\w* \w and lay in wait|strong="H693"\w* \w against|strong="H5921"\w* \w Shechem|strong="H7927"\w* \w in four|strong="H702"\w* \w companies|strong="H7218"\w*.
\p \v 35 \w Now Gaal|strong="H1603"\w* \w son|strong="H1121"\w* \w of Ebed|strong="H5651"\w* \w went out|strong="H3318"\w* \w and stood|strong="H5975"\w* \w at the entrance|strong="H6607"\w* \w of the city|strong="H5892"\w* \w gate|strong="H8179"\w* \w just as Abimelech|strong="H40"\w* \w and his men|strong="H5971"\w* \w -|strong="H834"\w* \w -|strong="H854"\w* \w came out|strong="H6965"\w* \w from|strong="H4480"\w* \w their hiding places|strong="H3993"\w*.
\p \v 36 \w When Gaal|strong="H1603"\w* \w -|strong="H853"\w* \w saw|strong="H7200"\w* \w the people|strong="H5971"\w*, \w he said|strong="H559"\w* \w to|strong="H413"\w* \w Zebul|strong="H2083"\w*, “\w Look|strong="H2009"\w*, \w people|strong="H5971"\w* \w are coming down|strong="H3381"\w* \w from the mountains|strong="H7218"\w* \w . . .|strong="H2022"\w*!”
\p \w But Zebul|strong="H2083"\w* \w -|strong="H853"\w* \w replied|strong="H559"\w* \w . . .|strong="H413"\w*, “\w The shadows|strong="H6738"\w* \w of the mountains|strong="H2022"\w* \w look|strong="H7200"\w* \w like men|strong="H582"\w* \w to you|strong="H859"\w*.”
\p \v 37 \w Then Gaal|strong="H1603"\w* \w spoke up|strong="H1696"\w* \w . . .|strong="H559"\w* \w again|strong="H3254"\w* \w . . .|strong="H5750"\w*, “\w Look|strong="H2009"\w*, \w people|strong="H5971"\w* \w are coming down|strong="H3381"\w* \w from|strong="H5973"\w* \w the center|strong="H2872"\w* \w of the land|strong="H776"\w*,\f + \fr 9:37 \ft Literally \fqa the navel of the earth\f* \w and one|strong="H259"\w* \w company|strong="H7218"\w* \w is coming|strong="H935"\w* \w by way of|strong="H1870"\w* \w the Diviners’|strong="H6049"\w* \w Oak|strong="H436"\w*.\f + \fr 9:37 \ft Or \fqa the Diviners’ Terebinth \ft or \fqa the diviners’ tree\f*”
\p \v 38 “\w Where|strong="H346"\w* \w is your gloating|strong="H6310"\w* \w -|strong="H834"\w* \w now|strong="H645"\w*?” \w Zebul|strong="H2083"\w* \w replied|strong="H559"\w* \w . . .|strong="H413"\w*. “\w You said|strong="H559"\w*, ‘\w Who|strong="H4310"\w* \w is Abimelech|strong="H40"\w* \w that|strong="H3588"\w* \w we should serve him|strong="H5647"\w*?’ \w Are these not|strong="H3808"\w* \w . . .|strong="H2088"\w* \w the people|strong="H5971"\w* \w -|strong="H834"\w* \w you ridiculed|strong="H3988"\w*? \w Go out|strong="H3318"\w* \w now|strong="H6258"\w* \w . . .|strong="H4994"\w* \w and fight|strong="H3898"\w* them!”
\p \v 39 \w So Gaal|strong="H1603"\w* \w went out|strong="H3318"\w* \w before|strong="H6440"\w* \w the leaders|strong="H1167"\w* \w of Shechem|strong="H7927"\w* \w and fought|strong="H3898"\w* \w against Abimelech|strong="H40"\w*, \v 40 \w but Abimelech|strong="H40"\w* \w pursued him|strong="H7291"\w*, \w and Gaal fled|strong="H5127"\w* \w before him|strong="H6440"\w*. \w And many [Shechemites]|strong="H7227"\w* \w fell|strong="H5307"\w* \w wounded|strong="H2491"\w* \w all the way|strong="H5704"\w* \w to the entrance|strong="H6607"\w* \w of the gate|strong="H8179"\w*. \v 41 \w Abimelech|strong="H40"\w* \w stayed|strong="H3427"\w* \w in Arumah|strong="H725"\w*, \w and Zebul|strong="H2083"\w* \w -|strong="H853"\w* \w drove|strong="H1644"\w* \w Gaal|strong="H1603"\w* \w -|strong="H853"\w* \w and his brothers|strong="H251"\w* \w out of|strong="H3427"\w* \w Shechem|strong="H7927"\w*.
\p \v 42 \w -|strong="H1961"\w* \w The next day|strong="H4283"\w* \w the people [of Shechem]|strong="H5971"\w* \w went out|strong="H3318"\w* \w into the fields|strong="H7704"\w*, \w and this was reported|strong="H5046"\w* \w to Abimelech|strong="H40"\w*. \v 43 \w So he took|strong="H3947"\w* \w -|strong="H853"\w* \w his men|strong="H5971"\w*, \w divided them|strong="H2673"\w* \w into three|strong="H7969"\w* \w companies|strong="H7218"\w*, \w and lay in wait|strong="H693"\w* \w in the fields|strong="H7704"\w*. \w When he saw|strong="H7200"\w* \w . . .|strong="H2009"\w* \w the people|strong="H5971"\w* \w coming out|strong="H3318"\w* \w of|strong="H4480"\w* \w the city|strong="H5892"\w*, \w he rose up|strong="H6965"\w* \w against them|strong="H5921"\w* \w and attacked them|strong="H5221"\w*.
\p \v 44 \w Then Abimelech|strong="H40"\w* \w and the companies|strong="H7218"\w* \w -|strong="H834"\w* \w with him|strong="H5973"\w* \w rushed forward|strong="H6584"\w* \w and took their stand|strong="H5975"\w* \w at the entrance|strong="H6607"\w* \w of the city|strong="H5892"\w* \w gate|strong="H8179"\w*. \w The other two|strong="H8147"\w* \w companies|strong="H7218"\w* \w rushed|strong="H6584"\w* \w against|strong="H5921"\w* \w all|strong="H3605"\w* \w who [were]|strong="H834"\w* \w in the fields|strong="H7704"\w* \w and struck them down|strong="H5221"\w*. \v 45 \w And all|strong="H3605"\w* \w that|strong="H1931"\w* \w day|strong="H3117"\w* \w Abimelech|strong="H40"\w* \w fought|strong="H3898"\w* \w against the city|strong="H5892"\w* \w until he had captured it|strong="H3920"\w* \w -|strong="H853"\w* \w -|strong="H5892"\w* \w -|strong="H853"\w* \w and killed|strong="H2026"\w* \w its people|strong="H5971"\w* \w -|strong="H834"\w* -. \w Then he demolished|strong="H5422"\w* \w -|strong="H853"\w* \w the city|strong="H5892"\w* \w and sowed|strong="H2232"\w* \w it with salt|strong="H4417"\w*.
\p \v 46 \w On hearing of this|strong="H8085"\w*, \w all|strong="H3605"\w* \w the leaders|strong="H1167"\w* \w in the tower|strong="H4026"\w* \w of Shechem|strong="H7927"\w* \w entered|strong="H935"\w* \w . . .|strong="H413"\w* \w the inner chamber|strong="H6877"\w* \w of the temple|strong="H1004"\w* \w vvv|strong="H410"\w* \w of El-berith|strong="H1286"\w*.\f + \fr 9:46 \fqa El-berith \ft was another name for \fqa Baal-berith\ft ; see verse 4.\f* \v 47 \w And when Abimelech|strong="H40"\w* \w was told|strong="H5046"\w* \w that|strong="H3588"\w* \w all|strong="H3605"\w* \w the leaders|strong="H1167"\w* \w in the tower|strong="H4026"\w* \w of Shechem|strong="H7927"\w* \w were gathered there|strong="H6908"\w*, \v 48 \w he|strong="H40"\w* \w and all|strong="H3605"\w* \w his men|strong="H5971"\w* \w -|strong="H834"\w* \w -|strong="H854"\w* \w went up|strong="H5927"\w* \w to Mount|strong="H2022"\w* \w Zalmon|strong="H6756"\w*. \w . . .|strong="H1931"\w* \w Abimelech|strong="H40"\w* \w -|strong="H853"\w* \w took|strong="H3947"\w* \w his axe|strong="H7134"\w* \w in his hand|strong="H3027"\w* \w and cut|strong="H3772"\w* \w a branch|strong="H7754"\w* \w from the trees|strong="H6086"\w*, \w which he lifted|strong="H5375"\w*\w . . .|strong="H7760"\w* \w to|strong="H5921"\w* \w his shoulder|strong="H7926"\w*, \w saying|strong="H559"\w* \w to|strong="H413"\w* \w his men|strong="H5971"\w* \w -|strong="H834"\w* \w -|strong="H5973"\w*, “\w Hurry|strong="H4116"\w* \w and do|strong="H6213"\w* \w what|strong="H4100"\w* \w you have seen me|strong="H7200"\w* \w do|strong="H6213"\w* \w . . .|strong="H3644"\w*.”
\p \v 49 \w So each|strong="H3605"\w* \w man|strong="H376"\w* \w -|strong="H5971"\w* \w also|strong="H1571"\w* \w cut|strong="H3772"\w* \w his own branch|strong="H7754"\w* \w and followed|strong="H1980"\w* \w . . .|strong="H310"\w* \w Abimelech|strong="H40"\w*. \w Then they piled [the branches]|strong="H7760"\w* \w against|strong="H5921"\w* \w the inner chamber|strong="H6877"\w* \w and set|strong="H3341"\w* \w -|strong="H853"\w* \w [it]|strong="H6877"\w* \w on fire|strong="H784"\w* \w above them|strong="H5921"\w*, \w killing|strong="H4191"\w* \w . . .|strong="H1571"\w* \w everyone|strong="H3605"\w* \w . . .|strong="H582"\w* \w in the tower|strong="H4026"\w* \w of Shechem|strong="H7927"\w*, \w about a thousand|strong="H505"\w* \w men|strong="H376"\w* \w and women|strong="H802"\w*.
\s1 Abimelech’s Punishment
\p \v 50 \w Then Abimelech|strong="H40"\w* \w went|strong="H1980"\w* \w to|strong="H413"\w* \w Thebez|strong="H8405"\w*, \w encamped|strong="H2583"\w* \w against it|strong="H8405"\w*, \w and captured it|strong="H3920"\w*. \v 51 \w But there was|strong="H1961"\w* \w a strong|strong="H5797"\w* \w tower|strong="H4026"\w* \w inside|strong="H8432"\w* \w the city|strong="H5892"\w*, \w and all|strong="H3605"\w* \w the men|strong="H582"\w*, \w women|strong="H802"\w*, \w . . .|strong="H3605"\w* \w and leaders|strong="H1167"\w* \w of the city|strong="H5892"\w* \w fled|strong="H5127"\w* \w there|strong="H8033"\w*. \w They locked themselves in|strong="H5462"\w* \w . . .|strong="H1157"\w* \w and went up|strong="H5927"\w* \w to|strong="H5921"\w* \w the roof|strong="H1406"\w* \w of the tower|strong="H4026"\w*.
\p \v 52 \w When Abimelech|strong="H40"\w* \w came|strong="H935"\w* \w to|strong="H5704"\w* \w attack|strong="H3898"\w* \w the tower|strong="H4026"\w*, \w he approached|strong="H5066"\w* \w . . .|strong="H5704"\w* \w its|strong="H4026"\w* \w entrance|strong="H6607"\w* \w to set it on fire|strong="H8313"\w* \w . . .|strong="H784"\w*. \v 53 \w But a|strong="H259"\w* \w woman|strong="H802"\w* \w dropped|strong="H7993"\w* \w an upper|strong="H6400"\w* \w millstone|strong="H7393"\w* \w on|strong="H5921"\w* \w Abimelech’s|strong="H40"\w* \w head|strong="H7218"\w*, \w crushing|strong="H7533"\w* \w -|strong="H853"\w* \w his skull|strong="H1538"\w*. \v 54 \w He quickly|strong="H4120"\w* \w . . .|strong="H413"\w* \w . . .|strong="H5288"\w* \w called|strong="H7121"\w* \w his armor-bearer|strong="H5375"\w* \w . . .|strong="H3627"\w*, \w saying|strong="H559"\w*, “\w Draw|strong="H8025"\w* \w your sword|strong="H2719"\w* \w and kill me|strong="H4191"\w*, \w lest|strong="H6435"\w* \w they say|strong="H559"\w* of me, ‘\w A woman|strong="H802"\w* \w killed him|strong="H2026"\w*.’”
\p \w So Abimelech’s armor-bearer ran [his sword] through him|strong="H1856"\w*, \w . . .|strong="H5288"\w* \w and he died|strong="H4191"\w*. \v 55 \w And when the Israelites|strong="H376"\w* \w . . .|strong="H3478"\w* \w saw|strong="H7200"\w* \w that|strong="H3588"\w* \w Abimelech|strong="H40"\w* \w was dead|strong="H4191"\w*, \w they all|strong="H376"\w* \w went|strong="H1980"\w* \w home|strong="H4725"\w*.
\p \v 56 \w In this way God|strong="H430"\w* \w -|strong="H853"\w* \w repaid|strong="H7725"\w* \w the wickedness|strong="H7451"\w* \w that|strong="H834"\w* \w Abimelech|strong="H40"\w* \w had done|strong="H6213"\w* \w to his father|strong="H1"\w* \w in murdering|strong="H2026"\w* \w -|strong="H853"\w* \w his seventy|strong="H7657"\w* \w brothers|strong="H251"\w*. \v 57 \w And|strong="H853"\w* \w God|strong="H430"\w* \w also brought|strong="H7725"\w* \w all|strong="H3605"\w* \w the wickedness|strong="H7451"\w* \w of the men|strong="H582"\w* \w of Shechem|strong="H7927"\w* \w {back} upon their own heads|strong="H7218"\w*. \w So the curse|strong="H7045"\w* \w of Jotham|strong="H3147"\w* \w son|strong="H1121"\w* \w of Jerubbaal|strong="H3378"\w* \w came|strong="H935"\w* \w upon them|strong="H413"\w*.
\c 10
\s1 Tola
\p \v 1 \w After the time|strong="H310"\w* \w of Abimelech|strong="H40"\w*, \w a man|strong="H376"\w* \w of Issachar|strong="H3485"\w*, \w Tola|strong="H8439"\w* \w son|strong="H1121"\w* \w of Puah|strong="H6312"\w*, \w the son|strong="H1121"\w* \w of Dodo|strong="H1734"\w*, \w rose up|strong="H6965"\w* \w to save|strong="H3467"\w* \w -|strong="H853"\w* \w Israel|strong="H3478"\w*\w . . .|strong="H1931"\w*. \w He lived|strong="H3427"\w* \w in Shamir|strong="H8069"\w*, \w in the hill country|strong="H2022"\w* \w of Ephraim|strong="H669"\w*.
\p \v 2 \w Tola judged|strong="H8199"\w*\f + \fr 10:2 \ft Or \fqa governed \ft or \fqa led\ft ; here and throughout the book of Judges\f* \w -|strong="H853"\w* \w Israel|strong="H3478"\w* \w twenty-three|strong="H6242"\w* \w . . .|strong="H7969"\w* \w years|strong="H8141"\w*, \w and when he died|strong="H4191"\w*, \w he was buried|strong="H6912"\w* \w in Shamir|strong="H8069"\w*.
\s1 Jair
\p \v 3 \w [Tola]|strong="H310"\w* \w was followed by|strong="H6965"\w* \w Jair|strong="H2971"\w* \w the Gileadite|strong="H1569"\w*, \w who judged|strong="H8199"\w* \w -|strong="H853"\w* \w Israel|strong="H3478"\w* \w twenty-two|strong="H6242"\w* \w . . .|strong="H8147"\w* \w years|strong="H8141"\w*. \v 4 \w He had|strong="H1961"\w* \w thirty|strong="H7970"\w* \w sons|strong="H1121"\w* \w who rode|strong="H7392"\w* \w on|strong="H5921"\w* \w thirty|strong="H7970"\w* \w donkeys|strong="H5895"\w*. And they had \w thirty|strong="H7970"\w* \w towns|strong="H5892"\w* - \w -|strong="H834"\w* \w in the land|strong="H776"\w* \w of Gilead|strong="H1568"\w*, \w which to|strong="H5704"\w* \w this|strong="H2088"\w* \w day|strong="H3117"\w* \w are called|strong="H7121"\w* \w vvv|strong="H2334"\w* \w Havvoth-jair|strong="H2334"\w*.\f + \fr 10:4 \ft Or \fqa the villages of Jair\f*
\p \v 5 \w When Jair|strong="H2971"\w* \w died|strong="H4191"\w*, \w he was buried|strong="H6912"\w* \w in Kamon|strong="H7056"\w*.
\s1 Oppression by the Philistines and Ammonites
\p \v 6 \w And again|strong="H3254"\w* \w the Israelites|strong="H1121"\w* \w . . .|strong="H3478"\w* \w did|strong="H6213"\w* \w evil|strong="H7451"\w* \w in the sight|strong="H5869"\w* \w of the LORD|strong="H3068"\w*. \w They served|strong="H5647"\w* \w -|strong="H853"\w* \w the Baals|strong="H1168"\w*, \w -|strong="H853"\w* \w the Ashtoreths|strong="H6252"\w*, \w -|strong="H853"\w* \w the gods|strong="H430"\w* \w of Aram|strong="H758"\w*,\w . . .|strong="H853"\w*\w . . .|strong="H430"\w* \w Sidon|strong="H6721"\w*, \w and|strong="H853"\w* \w . . .|strong="H430"\w* \w Moab|strong="H4124"\w*, \w and|strong="H853"\w* \w the gods|strong="H430"\w* \w of the Ammonites|strong="H1121"\w* \w . . .|strong="H5983"\w* \w -|strong="H853"\w* \w -|strong="H430"\w* \w and Philistines|strong="H6430"\w*. \w Thus they forsook|strong="H5800"\w* \w -|strong="H853"\w* \w the LORD|strong="H3068"\w* \w and did not|strong="H3808"\w* \w serve Him|strong="H5647"\w*.
\p \v 7 \w So the anger|strong="H639"\w* \w of the LORD|strong="H3068"\w* \w burned|strong="H2734"\w* \w against Israel|strong="H3478"\w*, \w and He sold them|strong="H4376"\w* \w into the hands|strong="H3027"\w* \w of the Philistines|strong="H6430"\w* \w . . .|strong="H3027"\w* \w and Ammonites|strong="H1121"\w* \w . . .|strong="H5983"\w*, \v 8 \w who that very|strong="H1931"\w* \w year|strong="H8141"\w* \w harassed|strong="H7492"\w* \w and oppressed|strong="H7533"\w* \w -|strong="H853"\w* \w the Israelites|strong="H1121"\w*, \w . . .|strong="H3478"\w* \w and they did so for eighteen|strong="H8083"\w* \w . . .|strong="H6240"\w* \w years|strong="H8141"\w* \w -|strong="H853"\w* \w to all|strong="H3605"\w* \w the Israelites|strong="H1121"\w* \w . . .|strong="H3478"\w* \w -|strong="H834"\w* \w on the other side|strong="H5676"\w* \w of the Jordan|strong="H3383"\w* \w -|strong="H834"\w* \w in Gilead|strong="H1568"\w*, \w the land|strong="H776"\w* \w of the Amorites|strong="H567"\w*.
