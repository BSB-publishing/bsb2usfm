\p \v 14 \w Jephthah|strong="H3316"\w* \w again|strong="H3254"\w* \w . . .|strong="H5750"\w* \w sent|strong="H7971"\w* \w messengers|strong="H4397"\w* \w to|strong="H413"\w* \w the king|strong="H4428"\w* \w of the Ammonites|strong="H1121"\w* \w . . .|strong="H5983"\w* \v 15 \w to tell|strong="H559"\w* him, “\w This is what|strong="H3541"\w* \w Jephthah|strong="H3316"\w* \w says|strong="H559"\w*: \w Israel|strong="H3478"\w* \w -|strong="H853"\w* \w did not|strong="H3808"\w* \w take away|strong="H3947"\w* \w the land|strong="H776"\w* \w of Moab|strong="H4124"\w* \w [or]|strong="H853"\w* \w -|strong="H776"\w* \w -|strong="H1121"\w* \w of the Ammonites|strong="H5983"\w*. \v 16 \w But|strong="H3588"\w* \w when [Israel] came up|strong="H5927"\w* \w out of Egypt|strong="H4714"\w*, \w [they]|strong="H3478"\w* \w traveled|strong="H1980"\w* \w through the wilderness|strong="H4057"\w* \w to|strong="H5704"\w* \w the Red|strong="H5488"\w* \w Sea|strong="H3220"\w*\f + \fr 11:16 \ft Or \fqa the Sea of Reeds\f* \w and came|strong="H935"\w* \w to Kadesh|strong="H6946"\w*. \v 17 \w Then Israel|strong="H3478"\w* \w sent|strong="H7971"\w* \w messengers|strong="H4397"\w* \w to|strong="H413"\w* \w the king|strong="H4428"\w* \w of Edom|strong="H123"\w*, \w saying|strong="H559"\w*, ‘\w Please|strong="H4994"\w* \w let us pass|strong="H5674"\w* \w through your land|strong="H776"\w*,’ \w but the king|strong="H4428"\w* \w of Edom|strong="H123"\w* \w would not|strong="H3808"\w* \w listen|strong="H8085"\w*. \w They also|strong="H1571"\w* \w sent|strong="H7971"\w* \w messengers to|strong="H413"\w* \w the king|strong="H4428"\w* \w of Moab|strong="H4124"\w*, \w but he would not|strong="H3808"\w* \w consent|strong="H14"\w*. \w So Israel|strong="H3478"\w* \w stayed|strong="H3427"\w* \w in Kadesh|strong="H6946"\w*.
