\p \v 1 \w Now|strong="H1961"\w* \w in those|strong="H1992"\w* \w days|strong="H3117"\w*, \w when there was no|strong="H369"\w* \w king|strong="H4428"\w* \w in Israel|strong="H3478"\w*, \w . . .|strong="H1961"\w* \w . . .|strong="H376"\w* \w a Levite|strong="H3881"\w* \w who lived|strong="H1481"\w* \w in the remote|strong="H3411"\w* \w hill country|strong="H2022"\w* \w of Ephraim|strong="H669"\w* \w took|strong="H3947"\w* for himself \w vvv|strong="H802"\w* \w a concubine|strong="H6370"\w* \w vvv|strong="H1035"\w* \w from Bethlehem|strong="H1035"\w* \w in Judah|strong="H3063"\w*. \v 2 \w But she|strong="H6370"\w* \w was unfaithful|strong="H2181"\w* \w to him|strong="H5921"\w*\f + \fr 19:2 \ft LXX \fqa became angry with him\f* \w and left|strong="H1980"\w* \w him|strong="H854"\w* \w to return to|strong="H413"\w* \w her father’s|strong="H1"\w* \w house|strong="H1004"\w* \w in|strong="H413"\w* \w vvv|strong="H1035"\w* \w Bethlehem|strong="H1035"\w* \w in Judah|strong="H3063"\w*.
\p \w After she had been|strong="H1961"\w* \w there|strong="H8033"\w* \w -|strong="H3117"\w* \w four|strong="H702"\w* \w months|strong="H2320"\w*, \v 3 \w her husband|strong="H376"\w* \w got up|strong="H6965"\w* \w and went|strong="H1980"\w* \w after her|strong="H310"\w* \w to speak|strong="H1696"\w* \w kindly|strong="H3820"\w* \w to her|strong="H5921"\w* \w and bring her back|strong="H7725"\w*, \w taking his servant|strong="H5288"\w* \w . . .|strong="H5973"\w* \w and a pair|strong="H6776"\w* \w of donkeys|strong="H2543"\w*. \w So [the girl] brought him|strong="H935"\w* \w into her father’s|strong="H1"\w* \w house|strong="H1004"\w*, \w and when [her]|strong="H5291"\w* \w father|strong="H1"\w* \w saw him|strong="H7200"\w*, \w he gladly|strong="H8055"\w* \w welcomed him|strong="H7122"\w*. \v 4 \w His father-in-law|strong="H2859"\w*, \w the girl’s|strong="H5291"\w* \w father|strong="H1"\w*, \w persuaded him to stay|strong="H2388"\w* . . ., \w so he remained|strong="H3427"\w* \w with him|strong="H854"\w* \w three|strong="H7969"\w* \w days|strong="H3117"\w*, \w eating|strong="H398"\w*, \w drinking|strong="H8354"\w*, \w and lodging|strong="H3885"\w* \w there|strong="H8033"\w*.
\p \v 5 \w -|strong="H1961"\w* \w On the fourth|strong="H7243"\w* \w day|strong="H3117"\w*, \w they got up early|strong="H7925"\w* \w in the morning|strong="H1242"\w* \w and prepared|strong="H6965"\w* \w to depart|strong="H1980"\w*, \w but the girl’s|strong="H5291"\w* \w father|strong="H1"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w his son-in-law|strong="H2860"\w*, “\w Refresh|strong="H5582"\w* \w your heart|strong="H3820"\w* \w with a morsel|strong="H6595"\w* \w of bread|strong="H3899"\w*, \w and then|strong="H310"\w* \w you can go|strong="H1980"\w*.” \v 6 \w So they sat down|strong="H3427"\w* \w and the two|strong="H8147"\w* \w of them ate|strong="H398"\w* \w and drank|strong="H8354"\w* \w together|strong="H3162"\w*. \w Then the girl’s|strong="H5291"\w* \w father|strong="H1"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w the man|strong="H376"\w*, “\w Please|strong="H4994"\w* \w agree|strong="H2974"\w* \w to stay overnight|strong="H3885"\w* \w and let your heart|strong="H3820"\w* \w be merry|strong="H3190"\w*.” \v 7 \w The man|strong="H376"\w* \w got up|strong="H6965"\w* \w to depart|strong="H1980"\w*, \w but his father-in-law|strong="H2859"\w* \w . . .|strong="H7725"\w* \w persuaded|strong="H6484"\w* him, \w so he stayed|strong="H3885"\w* \w there that night|strong="H8033"\w*.
\p \v 8 \w On the fifth|strong="H2549"\w* \w day|strong="H3117"\w*, \w he got up early|strong="H7925"\w* \w in the morning|strong="H1242"\w* \w to depart|strong="H1980"\w*, \w but the girl’s|strong="H5291"\w* \w father|strong="H1"\w* \w said|strong="H559"\w*, “\w Please|strong="H4994"\w* \w refresh|strong="H5582"\w* \w your heart|strong="H3824"\w*.” \w So they waited|strong="H4102"\w* \w until|strong="H5704"\w* \w late afternoon|strong="H5186"\w* \w . . .|strong="H3117"\w* \w and the two|strong="H8147"\w* \w of them ate|strong="H398"\w*. \v 9 \w When the man|strong="H376"\w* \w got up|strong="H6965"\w* \w to depart|strong="H1980"\w* \w . . .|strong="H1931"\w* \w with his concubine|strong="H6370"\w* \w and his servant|strong="H5288"\w*, \w his father-in-law|strong="H2859"\w*, \w the girl’s|strong="H5291"\w* \w father|strong="H1"\w*, \w said|strong="H559"\w* to him, “\w Look|strong="H2009"\w*, \w the day|strong="H3117"\w* \w is drawing|strong="H7503"\w* \w to a close|strong="H6150"\w*. \w Please|strong="H4994"\w* \w spend the night|strong="H3885"\w*. \w . . .|strong="H4994"\w* \w See|strong="H2009"\w*, \w the day|strong="H3117"\w* \w is almost over|strong="H2583"\w*. \w Spend the night|strong="H3885"\w* \w here|strong="H6311"\w*, \w that your heart|strong="H3824"\w* \w may be merry|strong="H3190"\w*. \w Then you can get up early|strong="H7925"\w* \w tomorrow|strong="H4279"\w* \w for your journey|strong="H1870"\w* \w . . .|strong="H1980"\w* \w home|strong="H168"\w*.”
\p \v 10 \w But the man|strong="H376"\w* \w was unwilling|strong="H3808"\w* \w . . .|strong="H14"\w* \w to spend the night|strong="H3885"\w*. \w He got up|strong="H6965"\w* \w and departed|strong="H1980"\w*, \w and arrived|strong="H935"\w* \w . . .|strong="H5704"\w* \w opposite|strong="H5227"\w* \w Jebus|strong="H2982"\w* \w (that is|strong="H1931"\w*, \w Jerusalem)|strong="H3389"\w*, \w with|strong="H5973"\w* \w his two|strong="H6776"\w* \w saddled|strong="H2280"\w* \w donkeys|strong="H2543"\w* \w and his concubine|strong="H6370"\w* \w -|strong="H5973"\w*. \v 11 \w When they|strong="H1992"\w* \w were near|strong="H5973"\w* \w Jebus|strong="H2982"\w* \w and the day|strong="H3117"\w* \w was almost|strong="H3966"\w* \w gone|strong="H3381"\w*, \w the servant|strong="H5288"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w his master|strong="H113"\w*, \w . . .|strong="H1980"\w* “\w Please|strong="H4994"\w*, \w let us stop|strong="H5493"\w* \w at|strong="H413"\w* \w this|strong="H2063"\w* \w Jebusite|strong="H2983"\w* \w city|strong="H5892"\w* \w and spend the night|strong="H3885"\w* here.”
\p \v 12 \w But his master|strong="H113"\w* \w replied|strong="H559"\w* \w -|strong="H413"\w*, “\w We will not|strong="H3808"\w* \w turn aside|strong="H5493"\w* \w to|strong="H413"\w* \w the city|strong="H5892"\w* \w of foreigners|strong="H5237"\w*, \w where|strong="H834"\w* \w there are no|strong="H3808"\w* \w Israelites|strong="H1121"\w* \w . . .|strong="H3478"\w*. \w . . .|strong="H2007"\w* \w We will go on|strong="H5674"\w* \w to|strong="H5704"\w* \w Gibeah|strong="H1390"\w*.” \v 13 \w He continued|strong="H559"\w* \w -|strong="H5288"\w*, “\w Come|strong="H1980"\w*, \w let us try to reach|strong="H7126"\w* \w one|strong="H259"\w* \w of these towns|strong="H4725"\w* \w to spend the night|strong="H3885"\w* \w in Gibeah|strong="H1390"\w* \w or|strong="H176"\w* \w Ramah|strong="H7414"\w*.”
\p \v 14 \w So they continued|strong="H1980"\w* \w on their journey|strong="H5674"\w*, \w and the sun|strong="H8121"\w* \w set|strong="H935"\w* \w as they neared|strong="H681"\w* \w Gibeah|strong="H1390"\w* \w -|strong="H834"\w* \w in Benjamin|strong="H1144"\w*. \v 15 \w They stopped|strong="H5493"\w* \w . . .|strong="H8033"\w* \w to go in|strong="H935"\w* \w and lodge|strong="H3885"\w* \w in Gibeah|strong="H1390"\w*. \w The Levite went in|strong="H935"\w* \w and sat down|strong="H3427"\w* \w in the city|strong="H5892"\w* \w square|strong="H7339"\w*, \w but no|strong="H369"\w* \w one|strong="H376"\w* \w would take|strong="H622"\w* \w them|strong="H853"\w* \w into his home|strong="H1004"\w* \w for the night|strong="H3885"\w*.
\p \v 16 \w -|strong="H2009"\w* \w That evening|strong="H6153"\w* \w an old|strong="H2205"\w* \w man|strong="H376"\w* \w -|strong="H376"\w* \w from the hill country|strong="H2022"\w* \w of Ephraim|strong="H669"\w*, \w . . .|strong="H1931"\w* \w who was residing|strong="H1481"\w* \w in Gibeah|strong="H1390"\w* (\w the men|strong="H582"\w* \w of that place|strong="H4725"\w* \w vvv|strong="H1145"\w* \w were Benjamites|strong="H1145"\w*), \w came in|strong="H935"\w* \w from|strong="H4480"\w* \w his work|strong="H4639"\w* \w in|strong="H4480"\w* \w the field|strong="H7704"\w*. \v 17 \w When he looked up|strong="H5375"\w* \w . . .|strong="H5869"\w* \w and saw|strong="H7200"\w* \w -|strong="H853"\w* \w vvv|strong="H376"\w* \w the traveler|strong="H732"\w* \w in the city|strong="H5892"\w* \w square|strong="H7339"\w*, \w the old|strong="H2205"\w* \w man|strong="H376"\w* \w asked|strong="H559"\w*, “\w Where|strong="H575"\w* \w are you going|strong="H1980"\w*, \w and where|strong="H370"\w* \w have you come from|strong="H935"\w*?”
\p \v 18 \w [The Levite] replied|strong="H559"\w*, \w . . .|strong="H413"\w* “\w We are|strong="H587"\w* \w traveling|strong="H5674"\w* \w vvv|strong="H1035"\w* \w from Bethlehem|strong="H1035"\w* \w in Judah|strong="H3063"\w* \w to|strong="H5704"\w* \w the remote|strong="H3411"\w* \w hill country|strong="H2022"\w* \w of Ephraim|strong="H669"\w*, \w where|strong="H8033"\w* \w I am from|strong="H595"\w*. \w I went|strong="H1980"\w* \w to|strong="H5704"\w* \w vvv|strong="H1035"\w* \w Bethlehem|strong="H1035"\w* \w in Judah|strong="H3063"\w*, \w -|strong="H853"\w* \w and now I am|strong="H589"\w* \w going|strong="H1980"\w* \w to the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*;\f + \fr 19:18 \ft LXX \fqa I am going to my home\ft ; see verse 29.\f* \w but no|strong="H369"\w* \w one|strong="H376"\w* \w has taken|strong="H622"\w* \w me|strong="H853"\w* \w into his home|strong="H1004"\w*, \v 19 \w even though there is|strong="H3426"\w* \w both|strong="H1571"\w* \w straw|strong="H8401"\w* \w and|strong="H1571"\w* \w feed|strong="H4554"\w* \w for our donkeys|strong="H2543"\w*, \w and|strong="H1571"\w* \w bread|strong="H3899"\w* \w and wine|strong="H3196"\w* \w . . .|strong="H3426"\w* for me \w and the maidservant|strong="H519"\w* \w and young man|strong="H5288"\w* \w with me|strong="H5973"\w*. \w There is nothing that|strong="H369"\w* \w we, your servants|strong="H5650"\w*, \w . . .|strong="H3605"\w* \w . . .|strong="H1697"\w* \w lack|strong="H4270"\w*.”
\p \v 20 “\w Peace|strong="H7965"\w* to you,” \w said|strong="H559"\w* \w the old|strong="H2205"\w* \w man|strong="H376"\w*. “\w Let me supply|strong="H5921"\w* \w . . .|strong="H7535"\w* \w everything|strong="H3605"\w* \w you need|strong="H4270"\w*. \w Only|strong="H7535"\w* \w do not|strong="H408"\w* \w spend the night|strong="H3885"\w* \w in the square|strong="H7339"\w*.” \v 21 \w So he brought him|strong="H935"\w* \w to his house|strong="H1004"\w* \w and fed|strong="H1101"\w* \w his donkeys|strong="H2543"\w*. \w And they washed|strong="H7364"\w* \w their feet|strong="H7272"\w* \w and ate|strong="H398"\w* \w and drank|strong="H8354"\w*.
\p \v 22 \w While they|strong="H1992"\w* \w were enjoying|strong="H3190"\w* \w -|strong="H853"\w* \w themselves|strong="H3820"\w*, \w suddenly|strong="H2009"\w* \w the wicked|strong="H1100"\w* \w men|strong="H582"\w* \w of the city|strong="H5892"\w* \w -|strong="H582"\w* \w -|strong="H1121"\w* \w surrounded|strong="H5437"\w* \w -|strong="H853"\w* \w the house|strong="H1004"\w*. \w Pounding|strong="H1849"\w* \w on|strong="H5921"\w* \w the door|strong="H1817"\w*, \w they said|strong="H559"\w* \w to|strong="H413"\w* \w the old|strong="H2205"\w* \w man|strong="H376"\w* \w who owned|strong="H1167"\w* \w the house|strong="H1004"\w* \w -|strong="H559"\w*, “\w Bring out|strong="H3318"\w* \w -|strong="H853"\w* \w the man|strong="H376"\w* \w who|strong="H834"\w* \w came|strong="H935"\w* \w to|strong="H413"\w* \w your house|strong="H1004"\w*, \w so we can have relations with him|strong="H3045"\w*!”
\p \v 23 \w vvv|strong="H376"\w* \w The owner|strong="H1167"\w* \w of the house|strong="H1004"\w* \w went out|strong="H3318"\w* \w -|strong="H413"\w* \w and said|strong="H559"\w* \w to them|strong="H413"\w*, “\w No|strong="H408"\w*, \w my brothers|strong="H251"\w*, \w do not|strong="H408"\w* \w do this wicked thing|strong="H7489"\w*! \w . . .|strong="H4994"\w* \w After all|strong="H310"\w* \w -|strong="H834"\w*, \w this|strong="H2088"\w* \w . . .|strong="H408"\w* \w man|strong="H376"\w* \w is a guest|strong="H935"\w* \w in my house|strong="H1004"\w*. \w Do not|strong="H408"\w* \w commit|strong="H6213"\w* \w -|strong="H853"\w* \w this|strong="H2063"\w* \w outrage|strong="H5039"\w*. \v 24 \w Look|strong="H2009"\w*, \w let me bring out|strong="H3318"\w* \w my virgin|strong="H1330"\w* \w daughter|strong="H1323"\w* \w and the man’s concubine|strong="H6370"\w* \w -|strong="H4994"\w*, \w -|strong="H853"\w* \w and you can use|strong="H6031"\w* \w them|strong="H853"\w* \w and do|strong="H6213"\w* with them \w as you wish|strong="H2896"\w* \w -|strong="H5869"\w*. \w But do not|strong="H3808"\w* \w do|strong="H6213"\w* \w such|strong="H2063"\w* \w a vile|strong="H5039"\w* \w thing|strong="H1697"\w* \w to this|strong="H2088"\w* \w man|strong="H376"\w*.”
\p \v 25 \w But the men|strong="H376"\w* \w would|strong="H14"\w* \w . . .|strong="H582"\w* \w not|strong="H3808"\w* \w listen to him|strong="H8085"\w*. So [the Levite] \w took|strong="H2388"\w* \w his concubine|strong="H6370"\w* \w and sent her|strong="H3318"\w* \w outside|strong="H2351"\w* \w to them|strong="H413"\w*, \w and they raped|strong="H3045"\w* \w her|strong="H853"\w* \w and abused|strong="H5953"\w* her \w throughout|strong="H3605"\w* \w the night|strong="H3915"\w* \w -|strong="H5704"\w* \w -|strong="H1242"\w*, \w and at dawn|strong="H5927"\w* \w . . .|strong="H7837"\w* \w they let her go|strong="H7971"\w*. \v 26 \w Early that morning|strong="H6437"\w* \w . . .|strong="H1242"\w*, \w the woman|strong="H802"\w* \w went back|strong="H935"\w* \w to the house|strong="H1004"\w* \w -|strong="H376"\w* \w where|strong="H834"\w* \w her master was staying|strong="H113"\w*, \w collapsed|strong="H5307"\w* \w at the doorway|strong="H6607"\w*, \w and lay there until|strong="H5704"\w* \w it was light|strong="H216"\w* \w . . .|strong="H8033"\w*.
\p \v 27 \w In the morning|strong="H1242"\w*, \w when her master|strong="H113"\w* \w got up|strong="H6965"\w* \w and opened|strong="H6605"\w* \w the doors|strong="H1817"\w* \w of the house|strong="H1004"\w* \w to go out|strong="H3318"\w* \w . . .|strong="H1980"\w* \w on his journey|strong="H1870"\w*, \w there was|strong="H2009"\w* \w vvv|strong="H802"\w* \w his concubine|strong="H6370"\w*, \w collapsed|strong="H5307"\w* \w in the doorway|strong="H6607"\w* \w of the house|strong="H1004"\w*, \w with her hands|strong="H3027"\w* \w on|strong="H5921"\w* \w the threshold|strong="H5592"\w*. \v 28 “\w Get up|strong="H6965"\w*,” \w he told her|strong="H559"\w*. \w . . .|strong="H413"\w* “\w Let us go|strong="H1980"\w*.” \w But there was no|strong="H369"\w* \w response|strong="H6030"\w*. \w So the man|strong="H376"\w* \w . . .|strong="H1980"\w* \w put her|strong="H3947"\w* \w on|strong="H5921"\w* \w his donkey|strong="H2543"\w* \w and set out|strong="H6965"\w* \w for home|strong="H4725"\w*.
\p \v 29 \w When he reached|strong="H935"\w* \w . . .|strong="H413"\w* \w his house|strong="H1004"\w*, \w he picked up|strong="H3947"\w* \w -|strong="H853"\w* \w a knife|strong="H3979"\w*, \w took hold|strong="H2388"\w* \w of his concubine|strong="H6370"\w*, \w cut her|strong="H5408"\w* \w limb by limb|strong="H6106"\w* \w into twelve|strong="H8147"\w* \w . . .|strong="H6240"\w* \w pieces|strong="H5409"\w*, \w and sent her|strong="H7971"\w* \w throughout|strong="H3605"\w* \w the territory|strong="H1366"\w* \w of Israel|strong="H3478"\w*. \v 30 \w And|strong="H1961"\w* \w everyone|strong="H3605"\w* \w who saw|strong="H7200"\w* \w it said|strong="H559"\w*, “\w Nothing|strong="H3808"\w* \w like this|strong="H2063"\w* \w has been seen|strong="H7200"\w* \w or done|strong="H1961"\w* \w -|strong="H3808"\w* \w from the day|strong="H3117"\w* \w the Israelites|strong="H1121"\w* \w . . .|strong="H3478"\w* \w came out|strong="H5927"\w* \w of the land|strong="H776"\w* \w of Egypt|strong="H4714"\w* \w until|strong="H5704"\w* \w this|strong="H2088"\w* \w day|strong="H3117"\w*. \w Think it over|strong="H7760"\w* . . . \w . . .|strong="H5921"\w*, \w take counsel|strong="H5779"\w*, \w and speak up|strong="H1696"\w*!”
\c 20
\s1 The Decree of the Assembly
\p \v 1 \w Then all|strong="H3605"\w* \w the Israelites|strong="H1121"\w* \w . . .|strong="H3478"\w* \w from Dan|strong="H1835"\w* \w to|strong="H5704"\w* \w vvv|strong="H884"\w* \w Beersheba|strong="H884"\w* \w and from the land|strong="H776"\w* \w of Gilead|strong="H1568"\w* \w came out|strong="H3318"\w*, \w and the congregation|strong="H5712"\w* \w assembled|strong="H6950"\w* \w as one|strong="H259"\w* \w man|strong="H376"\w* \w before|strong="H413"\w* \w the LORD|strong="H3068"\w* \w at Mizpah|strong="H4709"\w*. \v 2 \w The leaders|strong="H6438"\w* \w of all|strong="H3605"\w* \w the people|strong="H5971"\w* \w and all|strong="H3605"\w* \w the tribes|strong="H7626"\w* \w of Israel|strong="H3478"\w* \w presented themselves|strong="H3320"\w* \w in the assembly|strong="H6951"\w* \w of God’s|strong="H430"\w* \w people|strong="H5971"\w*: \w 400,000 {}|strong="H702"\w* \w . . .|strong="H3967"\w* \w . . .|strong="H505"\w* \w men|strong="H376"\w* \w on foot|strong="H7273"\w*, \w armed|strong="H8025"\w* \w with swords|strong="H2719"\w*. \v 3 (\w Meanwhile the Benjamites|strong="H1121"\w* \w . . .|strong="H1144"\w* \w heard|strong="H8085"\w* \w that|strong="H3588"\w* \w the Israelites|strong="H1121"\w* \w . . .|strong="H3478"\w* \w had gone up|strong="H5927"\w* \w to Mizpah|strong="H4709"\w*.) \w And the Israelites|strong="H1121"\w* \w . . .|strong="H3478"\w* \w asked|strong="H559"\w*, “\w Tell|strong="H1696"\w* \w us, how|strong="H349"\w* \w did this|strong="H2063"\w* \w wicked thing|strong="H7451"\w* \w happen|strong="H1961"\w*?”
