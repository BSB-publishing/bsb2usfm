\p \v 17 “\w Watch me|strong="H7200"\w* \w and do|strong="H6213"\w* \w . . .|strong="H2009"\w* \w as I do|strong="H3651"\w*,” \w [Gideon] said|strong="H559"\w*. \w . . .|strong="H413"\w* \w . . .|strong="H4480"\w* “\w When I|strong="H595"\w* \w come|strong="H935"\w* \w to the outskirts|strong="H7097"\w* \w of the camp|strong="H4264"\w*, \w . . .|strong="H1961"\w* \w do|strong="H6213"\w* \w . . .|strong="H3651"\w* \w exactly as|strong="H834"\w* \w I do|strong="H6213"\w*. \v 18 \w When I|strong="H595"\w* \w and all|strong="H3605"\w* \w who [are]|strong="H834"\w* \w with me|strong="H854"\w* \w blow|strong="H8628"\w* \w our horns|strong="H7782"\w*, \w then you|strong="H859"\w* \w are also|strong="H1571"\w* \w to blow|strong="H8628"\w* \w your horns|strong="H7782"\w* \w from all|strong="H3605"\w* \w around|strong="H5439"\w* \w the camp|strong="H4264"\w* \w and shout|strong="H559"\w*, ‘\w For the LORD|strong="H3068"\w* \w and for Gideon|strong="H1439"\w*!’”
\p \v 19 \w Gideon|strong="H1439"\w* \w and the hundred|strong="H3967"\w* \w men|strong="H376"\w* \w -|strong="H834"\w* \w with him|strong="H854"\w* \w reached|strong="H935"\w* \w the outskirts|strong="H7097"\w* \w of the camp|strong="H4264"\w* \w at the beginning|strong="H7218"\w* \w of the middle|strong="H8484"\w* \w watch|strong="H821"\w*, \w just after|strong="H389"\w* \w the changing|strong="H6965"\w* \w . . .|strong="H6965"\w* \w -|strong="H853"\w* \w of the guard|strong="H8104"\w*. \w They blew|strong="H8628"\w* \w their horns|strong="H7782"\w* \w and broke|strong="H5310"\w* \w the jars|strong="H3537"\w* \w that [were]|strong="H834"\w* \w in their hands|strong="H3027"\w*. \v 20 \w The three|strong="H7969"\w* \w companies|strong="H7218"\w* \w blew|strong="H8628"\w* \w their horns|strong="H7782"\w* \w and shattered|strong="H7665"\w* \w their jars|strong="H3537"\w*. \w Holding|strong="H2388"\w* \w the torches|strong="H3940"\w* \w in their left|strong="H8040"\w* \w hands|strong="H3027"\w* \w and the horns|strong="H7782"\w* \w . . .|strong="H8628"\w* \w in their right|strong="H3225"\w* \w hands|strong="H3027"\w*, \w they shouted|strong="H7121"\w*, “\w A sword|strong="H2719"\w* \w for the LORD|strong="H3068"\w* \w and for Gideon|strong="H1439"\w*!”
\p \v 21 \w Each [Israelite]|strong="H376"\w* \w took|strong="H5975"\w* \w his position|strong="H8478"\w* \w around|strong="H5439"\w* \w the camp|strong="H4264"\w*, \w and the entire|strong="H3605"\w* \w Midianite army|strong="H4264"\w* \w fled|strong="H7323"\w*, \w crying out|strong="H7321"\w* \w as they ran|strong="H5127"\w*. \v 22 \w And when the three|strong="H7969"\w* \w hundred|strong="H3967"\w* \w rams’ horns|strong="H7782"\w* \w sounded|strong="H8628"\w*, \w the LORD|strong="H3068"\w* \w -|strong="H853"\w* \w set|strong="H7760"\w* \w all the men|strong="H376"\w* \w in the camp|strong="H4264"\w* \w against one another|strong="H7453"\w* \w . . .|strong="H3605"\w* \w with their swords|strong="H2719"\w*. \w The army|strong="H4264"\w* \w fled|strong="H5127"\w* \w to|strong="H5704"\w* \w vvv|strong="H1029"\w* \w Beth-shittah|strong="H1029"\w* \w toward Zererah|strong="H6888"\w*\f + \fr 7:22 \ft Some Hebrew manuscripts \fqa Zeredah\f* \w as|strong="H5704"\w* \w far as the border|strong="H8193"\w* \w vvv|strong="H65"\w* \w of Abel-meholah|strong="H65"\w* \w near|strong="H5921"\w* \w Tabbath|strong="H2888"\w*. \v 23 \w Then the men|strong="H376"\w* \w of Israel|strong="H3478"\w* \w were called out|strong="H6817"\w* \w from|strong="H4480"\w* \w Naphtali|strong="H5321"\w*, \w Asher|strong="H836"\w*, \w and|strong="H4480"\w* \w all|strong="H3605"\w* \w Manasseh|strong="H4519"\w*, \w and they pursued|strong="H7291"\w* \w . . .|strong="H310"\w* \w the Midianites|strong="H4080"\w*.
\p \v 24 \w Gideon|strong="H1439"\w* \w sent|strong="H7971"\w* \w messengers|strong="H4397"\w* \w throughout|strong="H3605"\w* \w the hill country|strong="H2022"\w* \w of Ephraim|strong="H669"\w* \w to say|strong="H559"\w*, “\w Come down|strong="H3381"\w* \w against|strong="H7122"\w* \w the Midianites|strong="H4080"\w* \w and seize|strong="H3920"\w* \w -|strong="H853"\w* \w the waters|strong="H4325"\w* \w of the Jordan|strong="H3383"\w* ahead of them \w as far as|strong="H5704"\w* \w vvv|strong="H1012"\w* \w Beth-barah|strong="H1012"\w* \w -|strong="H853"\w*.” \w So all|strong="H3605"\w* \w the men|strong="H376"\w* \w of Ephraim|strong="H669"\w* \w were called out|strong="H6817"\w*, \w and they captured|strong="H3920"\w* \w -|strong="H853"\w* \w the waters|strong="H4325"\w* \w of the Jordan|strong="H3383"\w* \w as far as|strong="H5704"\w* \w vvv|strong="H1012"\w* \w Beth-barah|strong="H1012"\w* \w -|strong="H853"\w*. \v 25 \w They also captured|strong="H3920"\w* \w Oreb|strong="H6159"\w* \w -|strong="H853"\w* \w and Zeeb|strong="H2062"\w*, \w the two|strong="H8147"\w* \w princes|strong="H8269"\w* \w of Midian|strong="H4080"\w*; \w -|strong="H853"\w* \w and they killed|strong="H2026"\w* \w -|strong="H853"\w* \w Oreb|strong="H6159"\w* \w at the rock|strong="H6697"\w* \w of Oreb|strong="H6159"\w* \w -|strong="H853"\w* \w and Zeeb|strong="H2062"\w* \w . . .|strong="H2026"\w* \w at the winepress|strong="H3342"\w* \w of Zeeb|strong="H2062"\w*. \w So they pursued|strong="H7291"\w*\w . . .|strong="H413"\w* \w the Midianites|strong="H4080"\w* \w [and] brought|strong="H935"\w* \w the heads|strong="H7218"\w* \w of Oreb|strong="H6159"\w* \w and Zeeb|strong="H2062"\w* \w to|strong="H413"\w* \w Gideon|strong="H1439"\w* \w on the other side|strong="H5676"\w* \w of the Jordan|strong="H3383"\w*.
\c 8
\s1 Gideon Defeats Zebah and Zalmunna
\p \v 1 \w Then the men|strong="H376"\w* \w of Ephraim|strong="H669"\w* \w said|strong="H559"\w* \w to [Gideon]|strong="H413"\w*, “\w Why|strong="H4100"\w* \w . . .|strong="H1697"\w* \w have you done|strong="H6213"\w* \w this|strong="H2088"\w* to us? \w Why did you fail|strong="H1115"\w* \w to call|strong="H7121"\w* us \w when|strong="H3588"\w* \w you went|strong="H1980"\w* \w to fight|strong="H3898"\w* \w against Midian|strong="H4080"\w*?” \w And they contended|strong="H7378"\w* \w with him violently|strong="H854"\w* \w . . .|strong="H2394"\w*.
\p \v 2 \w But [Gideon] answered|strong="H559"\w* \w them|strong="H413"\w*, “\w Now|strong="H6258"\w* \w what|strong="H4100"\w* \w have I accomplished|strong="H6213"\w* compared to you? \w Are not|strong="H3808"\w* \w the gleanings|strong="H5955"\w* \w of Ephraim|strong="H669"\w* \w better|strong="H2896"\w* \w than the grape harvest|strong="H1210"\w* \w of Abiezer|strong="H44"\w*? \v 3 \w God|strong="H430"\w* \w -|strong="H853"\w* \w has delivered|strong="H5414"\w* \w Oreb|strong="H6159"\w* \w and|strong="H853"\w* \w Zeeb|strong="H2062"\w*, \w the two princes|strong="H8269"\w* \w of Midian|strong="H4080"\w*, \w into your hand|strong="H3027"\w*. \w -|strong="H853"\w* \w What|strong="H4100"\w* \w was I able|strong="H3201"\w* \w to do|strong="H6213"\w* compared to you?” \w . . .|strong="H227"\w* \w When he had said|strong="H1696"\w* \w . . .|strong="H1697"\w* \w this|strong="H2088"\w*, \w their anger|strong="H7307"\w*\f + \fr 8:3 \ft Or \fqa their spirit\f* \w against him|strong="H5921"\w* \w subsided|strong="H7503"\w*.
\p \v 4 \w Then Gideon|strong="H1439"\w* \w -|strong="H834"\w* \w and his|strong="H854"\w* \w three|strong="H7969"\w* \w hundred|strong="H3967"\w* \w men|strong="H376"\w* \w came|strong="H935"\w* \w to the Jordan|strong="H3383"\w* \w [and] crossed it|strong="H5674"\w* \w . . .|strong="H1931"\w*, \w exhausted|strong="H5889"\w* \w yet still in pursuit|strong="H7291"\w*. \v 5 \w So [Gideon] said|strong="H559"\w* \w to the men|strong="H582"\w* \w of Succoth|strong="H5523"\w*, “\w Please|strong="H4994"\w* \w give|strong="H5414"\w* \w my troops|strong="H5971"\w* \w -|strong="H834"\w* \w -|strong="H7272"\w* \w some|strong="H3603"\w* \w bread|strong="H3899"\w*, \w for|strong="H3588"\w* \w they|strong="H1992"\w* \w are exhausted|strong="H5889"\w*, \w and I|strong="H595"\w* \w am still pursuing|strong="H7291"\w* \w . . .|strong="H310"\w* \w Zebah|strong="H2078"\w* \w and Zalmunna|strong="H6759"\w*, \w the kings|strong="H4428"\w* \w of Midian|strong="H4080"\w*.”
\p \v 6 \w But the leaders|strong="H8269"\w* \w of Succoth|strong="H5523"\w* \w asked|strong="H559"\w*, “\w [Are] the hands|strong="H3709"\w* \w of Zebah|strong="H2078"\w* \w and Zalmunna|strong="H6759"\w* \w already|strong="H6258"\w* \w in your possession|strong="H3027"\w*, \w that|strong="H3588"\w* \w we should give|strong="H5414"\w* \w bread|strong="H3899"\w* \w to your army|strong="H6635"\w*?”
\p \v 7 “\w Very well|strong="H3651"\w*,” \w Gideon|strong="H1439"\w* \w replied|strong="H559"\w*, “\w when the LORD|strong="H3068"\w* \w -|strong="H853"\w* \w has delivered|strong="H5414"\w* \w Zebah|strong="H2078"\w* \w and|strong="H853"\w* \w Zalmunna|strong="H6759"\w* \w into my hand|strong="H3027"\w*, \w I will tear|strong="H1758"\w* \w -|strong="H853"\w* \w your flesh|strong="H1320"\w* \w with|strong="H854"\w* \w the thorns|strong="H6975"\w* \w and briers|strong="H1303"\w* \w of the wilderness|strong="H4057"\w* \w . . .|strong="H854"\w*!”
\p \v 8 \w From there|strong="H8033"\w* \w he went up|strong="H5927"\w* \w to Penuel|strong="H6439"\w*\f + \fr 8:8 \fqa Penuel \ft is a variant of \fqa Peniel\ft ; also in verses 9 and 17; see Genesis 32:30.\f* \w and asked|strong="H1696"\w* \w the same|strong="H2063"\w* \w from them|strong="H413"\w*, \w but the men|strong="H582"\w* \w of Penuel|strong="H6439"\w* \w gave the same response|strong="H6030"\w* \w -|strong="H853"\w* \w as|strong="H834"\w* \w -|strong="H6030"\w* \w the men|strong="H582"\w* \w of Succoth|strong="H5523"\w*. \v 9 \w So [Gideon]|strong="H1571"\w* \w told|strong="H559"\w* \w the men|strong="H582"\w* \w of Penuel|strong="H6439"\w*, \w . . .|strong="H559"\w* “\w When I return|strong="H7725"\w* \w in triumph|strong="H7965"\w*, \w I will tear down|strong="H5422"\w* \w -|strong="H853"\w* \w this|strong="H2088"\w* \w tower|strong="H4026"\w*!”
