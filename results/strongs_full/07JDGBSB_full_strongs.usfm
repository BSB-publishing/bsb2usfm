\p \v 20 \w So he said|strong="H559"\w* \w to Jether|strong="H3500"\w*, \w his firstborn|strong="H1060"\w*, “\w Get up|strong="H6965"\w* \w and kill them|strong="H2026"\w*.” \w -|strong="H853"\w* \w But the young man|strong="H5288"\w* \w did not|strong="H3808"\w* \w draw|strong="H8025"\w* \w his sword|strong="H2719"\w*; \w -|strong="H3588"\w* \w he was fearful|strong="H3372"\w* \w because|strong="H3588"\w* \w he was still|strong="H5750"\w* \w a youth|strong="H5288"\w*.
\p \v 21 \w Then Zebah|strong="H2078"\w* \w and Zalmunna|strong="H6759"\w* \w said|strong="H559"\w*, “\w Get up|strong="H6965"\w* \w and kill|strong="H6293"\w* us \w yourself|strong="H859"\w*, \w for|strong="H3588"\w* \w as the man is|strong="H376"\w*, \w so is his strength|strong="H1369"\w*.” \w So Gideon|strong="H1439"\w* \w got up|strong="H6965"\w* \w and killed|strong="H2026"\w* \w -|strong="H853"\w* \w Zebah|strong="H2078"\w* \w -|strong="H853"\w* \w and Zalmunna|strong="H6759"\w*, \w and he took|strong="H3947"\w* \w -|strong="H853"\w* \w the crescent ornaments|strong="H7720"\w* \w -|strong="H834"\w* \w from the necks|strong="H6677"\w* \w of their camels|strong="H1581"\w*.
\s1 Gideon’s Ephod
\p \v 22 \w Then the Israelites|strong="H376"\w* \w . . .|strong="H3478"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w Gideon|strong="H1439"\w*, “\w Rule|strong="H4910"\w* over us — \w you|strong="H859"\w* \w and|strong="H1571"\w* \w your son|strong="H1121"\w* \w . . .|strong="H1571"\w* \w and|strong="H1571"\w* \w grandson|strong="H1121"\w* \w . . .|strong="H1121"\w* — \w for|strong="H3588"\w* \w you have saved us|strong="H3467"\w* \w from the hand|strong="H3027"\w* \w of Midian|strong="H4080"\w*.”
\p \v 23 \w But Gideon|strong="H1439"\w* \w replied|strong="H559"\w* \w . . .|strong="H413"\w*, “\w I|strong="H589"\w* \w will not|strong="H3808"\w* \w rule|strong="H4910"\w* over you, \w nor|strong="H3808"\w* \w will|strong="H4910"\w* \w my son|strong="H1121"\w* -. \w The LORD|strong="H3068"\w* \w shall rule|strong="H4910"\w* over you.”
\p \v 24 \w Then he|strong="H1439"\w* \w added|strong="H559"\w* \w -|strong="H413"\w*, “\w Let me make a request|strong="H7592"\w* \w . . .|strong="H7596"\w* of you, \w that each of you|strong="H376"\w* \w give|strong="H5414"\w* me \w an earring|strong="H5141"\w* \w from his plunder|strong="H7998"\w*.” (\w For|strong="H3588"\w* \w [the enemies] had gold|strong="H2091"\w* \w earrings|strong="H5141"\w* \w because|strong="H3588"\w* \w they|strong="H1992"\w* \w were Ishmaelites|strong="H3459"\w*.)
\p \v 25 “\w We will give [them] gladly|strong="H5414"\w* \w . . .|strong="H5414"\w*,” \w they replied|strong="H559"\w*.
