\c 11
\s1 Jephthah Delivers Israel
\p \v 1 \w Now Jephthah|strong="H3316"\w* \w the Gileadite|strong="H1569"\w* \w was|strong="H1961"\w* \w a mighty man|strong="H1368"\w* \w of valor|strong="H2428"\w*; \w he|strong="H1931"\w* \w was the son|strong="H1121"\w* \w . . .|strong="H802"\w* \w of a prostitute|strong="H2181"\w*, \w and Gilead|strong="H1568"\w* \w -|strong="H853"\w* \w was his|strong="H3316"\w* \w father|strong="H3205"\w*. \v 2 \w And Gilead’s|strong="H1568"\w* . . . \w wife|strong="H802"\w* \w bore him|strong="H3205"\w* \w sons|strong="H1121"\w* \w who|strong="H1121"\w* \w . . .|strong="H802"\w* \w grew up|strong="H1431"\w*, \w drove Jephthah|strong="H3316"\w* \w out|strong="H1644"\w*, \w -|strong="H853"\w* \w and said|strong="H559"\w* to him, “\w You shall have no|strong="H3808"\w* \w inheritance|strong="H5157"\w* \w in our father’s|strong="H1"\w* \w house|strong="H1004"\w*, \w because|strong="H3588"\w* \w you|strong="H859"\w* \w are the son|strong="H1121"\w* \w of another|strong="H312"\w* \w woman|strong="H802"\w*.”
\p \v 3 \w So Jephthah|strong="H3316"\w* \w fled|strong="H1272"\w* \w from|strong="H6440"\w* \w his brothers|strong="H251"\w* \w and settled|strong="H3427"\w* \w in the land|strong="H776"\w* \w of Tob|strong="H2897"\w*, \w where worthless men|strong="H7386"\w* \w gathered around|strong="H3950"\w* \w . . .|strong="H413"\w* \w [him]|strong="H3316"\w* \w . . .|strong="H582"\w* \w and traveled|strong="H3318"\w* \w with him|strong="H5973"\w*.
