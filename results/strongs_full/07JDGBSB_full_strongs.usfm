\p \v 14 \w When|strong="H1931"\w* \w [Samson] arrived|strong="H935"\w* \w in|strong="H5704"\w* \w Lehi|strong="H3896"\w*, \w the Philistines|strong="H6430"\w* \w came out shouting|strong="H7321"\w* \w against him|strong="H7122"\w*. \w And the Spirit|strong="H7307"\w* \w of the LORD|strong="H3068"\w* \w came mightily|strong="H6743"\w* \w upon him|strong="H5921"\w*. \w The ropes|strong="H5688"\w* \w -|strong="H834"\w* \w on|strong="H5921"\w* \w his arms|strong="H2220"\w* \w became|strong="H1961"\w* \w like burnt|strong="H1197"\w* \w . . .|strong="H784"\w* \w flax|strong="H6593"\w*, \w -|strong="H834"\w* \w and the bonds|strong="H612"\w* \w broke loose|strong="H4549"\w* \w from|strong="H5921"\w* \w his hands|strong="H3027"\w*. \v 15 \w He found|strong="H4672"\w* \w the fresh|strong="H2961"\w* \w jawbone|strong="H3895"\w* \w of a donkey|strong="H2543"\w*, \w reached out|strong="H7971"\w* \w his hand|strong="H3027"\w* \w and took it|strong="H3947"\w*, \w and struck down|strong="H5221"\w* - \w a thousand|strong="H505"\w* \w men|strong="H376"\w*. \v 16 \w Then Samson|strong="H8123"\w* \w said|strong="H559"\w*:
