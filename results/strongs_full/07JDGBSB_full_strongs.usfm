\p \v 1 \w Again|strong="H3254"\w* \w the Israelites|strong="H1121"\w* \w . . .|strong="H3478"\w* \w did|strong="H6213"\w* \w evil|strong="H7451"\w* \w in the sight|strong="H5869"\w* \w of the LORD|strong="H3068"\w*, \w so [He]|strong="H3068"\w* \w delivered them|strong="H5414"\w* \w into the hand|strong="H3027"\w* \w of the Philistines|strong="H6430"\w* \w for forty|strong="H705"\w* \w years|strong="H8141"\w*.
