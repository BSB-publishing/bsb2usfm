\c 14
\s1 The Destroyers of Jerusalem Destroyed
\p \v 1 \w Behold|strong="H2009"\w*, \w a day|strong="H3117"\w* \w of the LORD|strong="H3068"\w* \w is coming|strong="H935"\w* \w when your plunder|strong="H7998"\w* \w will be divided|strong="H2505"\w* \w in your presence|strong="H7130"\w*. \v 2 \w For I will gather|strong="H622"\w* \w -|strong="H853"\w* \w all|strong="H3605"\w* \w the nations|strong="H1471"\w* \w for battle|strong="H4421"\w* \w against|strong="H413"\w* \w Jerusalem|strong="H3389"\w*, \w and the city|strong="H5892"\w* \w will be captured|strong="H3920"\w*, \w the houses|strong="H1004"\w* \w looted|strong="H8155"\w*, \w and the women|strong="H802"\w* \w ravished|strong="H7693"\w*. \w Half|strong="H2677"\w* \w of the city|strong="H5892"\w* \w will go|strong="H3318"\w* \w into exile|strong="H1473"\w*, \w but the rest|strong="H3499"\w* \w of the people|strong="H5971"\w* \w will not|strong="H3808"\w* \w be removed|strong="H3772"\w* \w from|strong="H4480"\w* \w the city|strong="H5892"\w*.
\p \v 3 \w Then the LORD|strong="H3068"\w* \w will go out|strong="H3318"\w* \w to fight|strong="H3898"\w* \w against those|strong="H1992"\w* \w nations|strong="H1471"\w*, \w as He fights|strong="H3898"\w* \w in the day|strong="H3117"\w* \w . . .|strong="H3117"\w* \w of battle|strong="H7128"\w*. \v 4 \w On that|strong="H1931"\w* \w day|strong="H3117"\w* \w His feet|strong="H7272"\w* \w will stand|strong="H5975"\w* \w on|strong="H5921"\w* \w the Mount|strong="H2022"\w* \w of Olives|strong="H2132"\w*, \w -|strong="H834"\w*\w . . .|strong="H5921"\w* \w -|strong="H6440"\w* \w east|strong="H6924"\w* \w of Jerusalem|strong="H3389"\w*, \w and the Mount|strong="H2022"\w* \w of Olives|strong="H2132"\w* \w will be split|strong="H1234"\w* \w in two|strong="H2677"\w* \w from east|strong="H4217"\w* \w to west|strong="H3220"\w*, \w forming a great|strong="H1419"\w* \w . . .|strong="H3966"\w* \w valley|strong="H1516"\w*, \w with half|strong="H2677"\w* \w the mountain|strong="H2022"\w* \w moving|strong="H4185"\w* \w to the north|strong="H6828"\w* \w and half|strong="H2677"\w* \w to the south|strong="H5045"\w*. \v 5 \w You will flee|strong="H5127"\w* \w by My mountain|strong="H2022"\w* \w valley|strong="H1516"\w*, \w for|strong="H3588"\w* \w [it]|strong="H1516"\w* \w . . .|strong="H2022"\w* \w will extend|strong="H5060"\w* \w to|strong="H413"\w* \w Azal|strong="H682"\w*. \w You will flee|strong="H5127"\w* \w as|strong="H834"\w* \w you fled|strong="H5127"\w* \w from|strong="H6440"\w* \w the earthquake|strong="H7494"\w* \w in the days|strong="H3117"\w* \w of Uzziah|strong="H5818"\w* \w king|strong="H4428"\w* \w of Judah|strong="H3063"\w*. \w Then the LORD|strong="H3068"\w* \w my God|strong="H430"\w* \w will come|strong="H935"\w*, \w and all|strong="H3605"\w* \w the holy ones|strong="H6918"\w* \w with Him|strong="H5973"\w*.\f + \fr 14:5 \ft LXX; Hebrew \fqa with You\f*
\p \v 6 \w -|strong="H1961"\w* \w On that|strong="H1931"\w* \w day|strong="H3117"\w* \w there will be|strong="H1961"\w* \w no|strong="H3808"\w* \w light|strong="H216"\w*, \w no cold|strong="H3368"\w* \w or frost|strong="H7087"\w*. \v 7 \w It will be|strong="H1961"\w* \w a unique day|strong="H3117"\w* \w known|strong="H3045"\w* \w only|strong="H259"\w* \w . . .|strong="H1931"\w* \w to the LORD|strong="H3068"\w*, \w without|strong="H3808"\w* \w day|strong="H3117"\w* \w . . .|strong="H3808"\w* \w or night|strong="H3915"\w*; \w but when evening|strong="H6153"\w* \w comes|strong="H1961"\w*, \w there will be|strong="H1961"\w* \w . . .|strong="H6256"\w* \w light|strong="H216"\w*.
\p \v 8 \w And|strong="H1961"\w* \w on that|strong="H1931"\w* \w day|strong="H3117"\w* \w living|strong="H2416"\w* \w water|strong="H4325"\w* \w will flow out|strong="H3318"\w* \w from Jerusalem|strong="H3389"\w*, \w half|strong="H2677"\w* \w of it toward|strong="H413"\w* \w the Eastern|strong="H6931"\w* \w Sea|strong="H3220"\w*\f + \fr 14:8 \ft That is, the Dead Sea\f* \w and the other half|strong="H2677"\w* \w toward|strong="H413"\w* \w the Western|strong="H314"\w* \w Sea|strong="H3220"\w*,\f + \fr 14:8 \ft That is, the Mediterranean Sea, also called the Great Sea\f* \w in summer|strong="H7019"\w* \w and winter alike|strong="H2779"\w* \w . . .|strong="H1961"\w*. \v 9 \w On that|strong="H1931"\w* \w . . .|strong="H1961"\w* \w day|strong="H3117"\w* \w the LORD|strong="H3068"\w* \w will become|strong="H1961"\w* \w King|strong="H4428"\w* \w over|strong="H5921"\w* \w all|strong="H3605"\w* \w the earth|strong="H776"\w*— \w the LORD|strong="H3068"\w* \w alone|strong="H259"\w*, \w and His name|strong="H8034"\w* \w alone|strong="H259"\w*.
\p \v 10 \w All|strong="H3605"\w* \w the land|strong="H776"\w* \w from Geba|strong="H1387"\w* \w to Rimmon|strong="H7417"\w* \w south|strong="H5045"\w* \w of Jerusalem|strong="H3389"\w* \w will be turned|strong="H5437"\w* \w into a plain|strong="H6160"\w*, \w but Jerusalem will be raised up|strong="H7213"\w* \w and will remain|strong="H3427"\w* \w in her place|strong="H8478"\w*, \w from the Benjamin|strong="H1144"\w* \w Gate|strong="H8179"\w* \w to|strong="H5704"\w* \w the site|strong="H4725"\w* \w of the First|strong="H7223"\w* \w Gate|strong="H8179"\w* \w to|strong="H5704"\w* \w the Corner|strong="H6434"\w* \w Gate|strong="H8179"\w*, \w and from the Tower|strong="H4026"\w* \w of Hananel|strong="H2606"\w* \w to|strong="H5704"\w* \w the royal|strong="H4428"\w* \w winepresses|strong="H3342"\w*. \v 11 \w People will live|strong="H3427"\w* there, \w and never|strong="H3808"\w* \w again|strong="H5750"\w* \w will there be|strong="H1961"\w* \w an [utter] destruction|strong="H2764"\w*. \w So Jerusalem|strong="H3389"\w* \w will dwell|strong="H3427"\w* \w securely|strong="H983"\w*.
\p \v 12 \w And this|strong="H2063"\w* \w will be|strong="H1961"\w* \w the plague|strong="H4046"\w* \w with which|strong="H834"\w* \w the LORD|strong="H3068"\w* \w -|strong="H853"\w* \w strikes|strong="H5062"\w* \w all|strong="H3605"\w* \w the peoples|strong="H5971"\w* \w who|strong="H834"\w* \w have warred|strong="H6633"\w* \w against|strong="H5921"\w* \w Jerusalem|strong="H3389"\w*: \w Their flesh|strong="H1320"\w* \w will rot|strong="H4743"\w* \w while they|strong="H1931"\w* \w stand|strong="H5975"\w* \w on|strong="H5921"\w* \w their feet|strong="H7272"\w*, \w their eyes|strong="H5869"\w* \w will rot|strong="H4743"\w* \w in their sockets|strong="H2356"\w*, \w and their tongues|strong="H3956"\w* \w will rot|strong="H4743"\w* \w in their mouths|strong="H6310"\w*.
\p \v 13 \w On that|strong="H1931"\w* \w . . .|strong="H1961"\w* \w day|strong="H3117"\w* \w a great|strong="H7227"\w* \w panic|strong="H4103"\w* \w from the LORD|strong="H3068"\w* \w will come|strong="H1961"\w* upon them, \w so that each|strong="H376"\w* \w will seize|strong="H2388"\w* \w the hand|strong="H3027"\w* \w of another|strong="H7453"\w*, \w and the hand|strong="H3027"\w* \w of one will rise|strong="H5927"\w* \w against|strong="H5921"\w* \w . . .|strong="H3027"\w* \w the other|strong="H7453"\w*. \v 14 \w Judah|strong="H3063"\w* \w will also|strong="H1571"\w* \w fight|strong="H3898"\w* \w at Jerusalem|strong="H3389"\w*, \w and the wealth|strong="H2428"\w* \w of all|strong="H3605"\w* \w the surrounding|strong="H5439"\w* \w nations|strong="H1471"\w* \w will be collected|strong="H622"\w* — \w gold|strong="H2091"\w*, \w silver|strong="H3701"\w*, \w and apparel|strong="H899"\w* \w in great abundance|strong="H7230"\w* \w . . .|strong="H3966"\w*. \v 15 \w And a similar|strong="H3651"\w* \w plague|strong="H4046"\w* \w will strike|strong="H1961"\w* \w the horses|strong="H5483"\w* \w and mules|strong="H6505"\w*, \w camels|strong="H1581"\w* \w and donkeys|strong="H2543"\w*, \w and all|strong="H3605"\w* \w the animals|strong="H929"\w* \w -|strong="H834"\w* \w -|strong="H1961"\w* \w in those|strong="H1992"\w* \w camps|strong="H4264"\w*. \w -|strong="H4046"\w* \w -|strong="H2063"\w*
\s1 All Nations Will Worship the King
