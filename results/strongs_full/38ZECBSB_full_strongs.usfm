\p \v 16 \w -|strong="H1961"\w* \w Then all|strong="H3605"\w* \w the survivors|strong="H3498"\w* \w from|strong="H3605"\w* \w the nations|strong="H1471"\w* \w that came|strong="H935"\w* \w against|strong="H5921"\w* \w Jerusalem|strong="H3389"\w* \w will go up|strong="H5927"\w* \w . . .|strong="H1767"\w* \w year|strong="H8141"\w* \w after year|strong="H8141"\w* \w to worship|strong="H7812"\w* \w the King|strong="H4428"\w*, \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*, \w and to celebrate|strong="H2287"\w* \w -|strong="H853"\w* \w the Feast|strong="H2282"\w* \w of Tabernacles|strong="H5521"\w*.\f + \fr 14:16 \ft That is, Sukkot, the autumn feast of pilgrimage to Jerusalem; also translated as \fqa the Feast of Booths \ft or \fqa the Feast of Shelters \ft and originally called \fqa the Feast of Ingathering\ft (see \ref Exodus 23:16|EXO 23:16\ref* and Exodus 34:22).\f* \v 17 \w And should|strong="H1961"\w* \w any|strong="H834"\w* \w of the families|strong="H4940"\w* \w of the earth|strong="H776"\w* \w not|strong="H3808"\w* \w go up|strong="H5927"\w* \w . . .|strong="H854"\w* \w to|strong="H413"\w* \w Jerusalem|strong="H3389"\w* \w to worship|strong="H7812"\w* \w the King|strong="H4428"\w*, \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*, \w then the rain|strong="H1653"\w* \w will not|strong="H3808"\w* \w fall|strong="H1961"\w* \w on them|strong="H5921"\w*. \v 18 \w And if|strong="H518"\w* \w the people|strong="H4940"\w* \w of Egypt|strong="H4714"\w* \w will not|strong="H3808"\w* \w go up|strong="H5927"\w* \w and|strong="H3808"\w* \w enter in|strong="H935"\w*, \w [then the rain] will not|strong="H3808"\w* \w fall on them|strong="H5921"\w*; \w this will be|strong="H1961"\w* \w the plague|strong="H4046"\w* \w with which|strong="H834"\w* \w the LORD|strong="H3068"\w* \w -|strong="H853"\w* \w strikes|strong="H5062"\w* \w the nations|strong="H1471"\w* \w who|strong="H834"\w* \w do not|strong="H3808"\w* \w go up|strong="H5927"\w* \w to celebrate|stron