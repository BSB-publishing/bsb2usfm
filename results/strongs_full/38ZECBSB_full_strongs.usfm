\p \w Then he said|strong="H559"\w* \w to [Joshua]|strong="H413"\w*, “\w See|strong="H7200"\w*, \w I have removed|strong="H5674"\w* \w your iniquity|strong="H5771"\w* \w -|strong="H5921"\w*, \w and I will clothe|strong="H3847"\w* \w you|strong="H853"\w* \w with splendid robes|strong="H4254"\w*.”
\p \v 5 \w Then I said|strong="H559"\w*, “\w Let them put|strong="H7760"\w* \w a clean|strong="H2889"\w* \w turban|strong="H6797"\w* \w on|strong="H5921"\w* \w his head|strong="H7218"\w*.” \w So a clean|strong="H2889"\w* \w turban|strong="H6797"\w* \w was placed|strong="H7760"\w* \w on|strong="H5921"\w* \w his head|strong="H7218"\w*, \w and they clothed him|strong="H3847"\w* \w . . .|strong="H899"\w*, \w as the angel|strong="H4397"\w* \w of the LORD|strong="H3068"\w* \w stood by|strong="H5975"\w*.
\p \v 6 \w Then the angel|strong="H4397"\w* \w of the LORD|strong="H3068"\w* \w gave this charge|strong="H5749"\w* \w to Joshua|strong="H3091"\w* \w . . .|strong="H559"\w*: \v 7 “\w This is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w* \w says|strong="H559"\w*: ‘\w If|strong="H518"\w* \w you walk|strong="H1980"\w* \w . . .|strong="H518"\w* \w -|strong="H853"\w* \w in My ways|strong="H1870"\w* \w and keep|strong="H8104"\w* \w My instructions|strong="H4931"\w*, \w then you|strong="H859"\w* \w -|strong="H1571"\w* \w will govern|strong="H1777"\w* \w -|strong="H853"\w* \w My house|strong="H1004"\w* \w and will also|strong="H1571"\w* \w have charge|strong="H8104"\w* \w of|strong="H853"\w* \w My courts|strong="H2691"\w*; \w and I will give|strong="H5414"\w* you \w a place|strong="H4109"\w* \w among|strong="H996"\w* \w these|strong="H428"\w* \w who are standing here|strong="H5975"\w*.
\p \v 8 \w Hear|strong="H8085"\w* \w now|strong="H4994"\w*, \w O high|strong="H1419"\w* \w priest|strong="H3548"\w* \w Joshua|strong="H3091"\w*, \w you|strong="H859"\w* \w and your companions|strong="H7453"\w* \w seated|strong="H3427"\w* \w before you|strong="H6440"\w*, \w who are indeed|strong="H3588"\w* \w . . .|strong="H582"\w* \w a sign|strong="H4159"\w*. \w . . .|strong="H1992"\w* \w For|strong="H3588"\w* \w behold|strong="H2005"\w*, \w I am going to bring|strong="H935"\w* \w -|strong="H853"\w* \w My servant|strong="H5650"\w*, \w the Branch|strong="H6780"\w*. \v 9 \w -|strong="H3588"\w* \w See|strong="H2009"\w* \w the stone|strong="H68"\w* \w -|strong="H834"\w* \w I have set|strong="H5414"\w* \w before|strong="H6440"\w* \w Joshua|strong="H3091"\w*; \w on|strong="H5921"\w* \w that one|strong="H259"\w* \w stone|strong="H68"\w* \w are seven|strong="H7651"\w* \w eyes|strong="H5869"\w*.\f + \fr 3:9 \ft Or \fqa facets\f* \w Behold|strong="H2005"\w*, \w I will engrave on it|strong="H6605"\w* \w an inscription|strong="H6603"\w*, \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*, \w and I will remove|strong="H4185"\w* \w -|strong="H853"\w* \w the iniquity|strong="H5771"\w* \w of this|strong="H1931"\w* \w land|strong="H776"\w* \w in a single|strong="H259"\w* \w day|strong="H3117"\w*. \v 10 \w On that|strong="H1931"\w* \w day|strong="H3117"\w*, \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*, \w you will each invite|strong="H7121"\w* \w . . .|strong="H376"\w* \w [your] neighbor|strong="H7453"\w* \w to|strong="H413"\w* \w sit under|strong="H8478"\w* \w [your own] vine|strong="H1612"\w* \w and|strong="H413"\w* \w -|strong="H8478"\w* \w fig tree|strong="H8384"\w*.’”
\c 4
\s1 The Vision of the Lampstand and Olive Trees
\p \v 1 \w Then the angel|strong="H4397"\w* \w who was speaking|strong="H1696"\w* with me \w returned|strong="H7725"\w* \w and woke me|strong="H5782"\w*, \w as a man|strong="H376"\w* \w -|strong="H834"\w* \w is awakened|strong="H5782"\w* \w from his sleep|strong="H8142"\w*.
\p \v 2 “\w What|strong="H4100"\w* \w do you|strong="H859"\w* \w see|strong="H7200"\w*?” \w he asked|strong="H559"\w* \w . . .|strong="H413"\w*.
\p “\w I see|strong="H7200"\w* \w a solid gold|strong="H2091"\w* \w . . .|strong="H3605"\w* \w lampstand|strong="H4501"\w*,” \w I replied|strong="H559"\w*, “\w with|strong="H2009"\w* \w a bowl|strong="H1543"\w* \w at|strong="H5921"\w* \w the top|strong="H7218"\w* \w and seven|strong="H7651"\w* \w lamps|strong="H5216"\w* \w on it|strong="H5921"\w* \w -|strong="H7651"\w*, \w with seven|strong="H7651"\w* \w spouts|strong="H4166"\w* \w to the lamps|strong="H5216"\w* \w -|strong="H834"\w*\w . . .|strong="H5921"\w* \w -|strong="H7218"\w*. \v 3 \w There are also two|strong="H8147"\w* \w olive trees|strong="H2132"\w* \w beside it|strong="H5921"\w*, \w one|strong="H259"\w* \w on the right [side]|strong="H3225"\w* \w of the bowl|strong="H1543"\w* \w and the other|strong="H259"\w* \w on|strong="H5921"\w* \w its left|strong="H8040"\w*.”
\p \v 4 “\w What|strong="H4100"\w* \w are these|strong="H428"\w*, \w my lord|strong="H113"\w*?” \w I asked|strong="H6030"\w* \w . . .|strong="H559"\w* \w . . .|strong="H413"\w* \w the angel|strong="H4397"\w* \w who was speaking|strong="H1696"\w* with me \w -|strong="H559"\w*.
\p \v 5 “\w Do you not|strong="H3808"\w* \w know|strong="H3045"\w* \w what|strong="H4100"\w* \w they are|strong="H1992"\w*?” \w replied|strong="H6030"\w* \w the angel|strong="H4397"\w* \w -|strong="H1696"\w*\w . . .|strong="H559"\w*\w . . .|strong="H413"\w*.
\p “\w No|strong="H3808"\w*, \w my lord|strong="H113"\w*,” \w I answered|strong="H428"\w* \w . . .|strong="H559"\w*.
\p \v 6 \w So he said to me|strong="H6030"\w*\w . . .|strong="H559"\w*, “\w This|strong="H2088"\w* \w is the word|strong="H1697"\w* \w of the LORD|strong="H3068"\w* \w . . .|strong="H413"\w* \w to|strong="H413"\w* \w . . .|strong="H559"\w* \w Zerubbabel|strong="H2216"\w*: \w . . .|strong="H559"\w* \w Not|strong="H3808"\w* \w by might|strong="H2428"\w* \w nor|strong="H3808"\w* \w by power|strong="H3581"\w*, \w but|strong="H3588"\w* \w . . .|strong="H518"\w* \w by My Spirit|strong="H7307"\w*, \w says|strong="H559"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*. \v 7 \w What|strong="H4310"\w* \w are you|strong="H859"\w*, \w O great|strong="H1419"\w* \w mountain|strong="H2022"\w*? \w Before|strong="H6440"\w* \w Zerubbabel|strong="H2216"\w* \w you will become a plain|strong="H4334"\w*. \w Then he will bring forth|strong="H3318"\w* \w -|strong="H853"\w* \w the capstone|strong="H68"\w* \w . . .|strong="H7222"\w* \w accompanied by shouts of|strong="H8663"\w* ‘\w Grace|strong="H2580"\w*, \w grace|strong="H2580"\w* to it!’”
\p \v 8 \w Then the word|strong="H1697"\w* \w of the LORD|strong="H3068"\w* \w came|strong="H1961"\w* \w to me|strong="H413"\w*, \w saying|strong="H559"\w*, \v 9 “\w The hands|strong="H3027"\w* \w of Zerubbabel|strong="H2216"\w* \w have laid the foundation|strong="H3245"\w* \w of this|strong="H2088"\w* \w house|strong="H1004"\w*, \w and his hands|strong="H3027"\w* \w will complete it|strong="H1214"\w*. \w Then you will know|strong="H3045"\w* \w that|strong="H3588"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w* \w has sent me|strong="H7971"\w* \w to you|strong="H413"\w*. \v 10 \w For|strong="H3588"\w* \w who|strong="H4310"\w* \w has despised|strong="H936"\w* \w the day|strong="H3117"\w* \w of small things|strong="H6996"\w*? \w But these|strong="H428"\w* \w seven|strong="H7651"\w* \w eyes|strong="H5869"\w*\f + \fr 4:10 \ft Or \fqa facets\f* \w of the LORD|strong="H3068"\w*, \w which|strong="H1992"\w* \w scan|strong="H7751"\w* \w the whole|strong="H3605"\w* \w earth|strong="H776"\w*, \w will rejoice|strong="H8055"\w* \w when they see|strong="H7200"\w* \w -|strong="H853"\w* \w the plumb line|strong="H68"\w*\f + \fr 4:10 \ft Or \fqa the chosen capstone\f* \w . . .|strong="H913"\w* \w in the hand|strong="H3027"\w* \w of Zerubbabel|strong="H2216"\w*.”
\p \v 11 \w Then I asked|strong="H6030"\w*\w . . .|strong="H559"\w* \w [the angel]|strong="H413"\w*, “\w What|strong="H4100"\w* \w are the|strong="H428"\w* \w two|strong="H8147"\w* \w olive trees|strong="H2132"\w* \w on|strong="H5921"\w* \w the right|strong="H3225"\w* \w and left|strong="H8040"\w* \w of the lampstand|strong="H4501"\w* \w . . .|strong="H5921"\w*?” \v 12 \w And I questioned him|strong="H6030"\w* \w further|strong="H8145"\w* \w . . .|strong="H559"\w* \w . . .|strong="H413"\w*, “\w What|strong="H4100"\w* \w are the two|strong="H8147"\w* \w olive|strong="H2132"\w* \w -|strong="H834"\w* \w branches|strong="H7641"\w* \w beside|strong="H3027"\w* \w the two|strong="H8147"\w* \w gold|strong="H2091"\w* \w pipes|strong="H6804"\w* \w from which|strong="H5921"\w* \w the golden [oil]|strong="H2091"\w*\f + \fr 4:12 \ft Hebrew \fqa from which the gold\f* \w pours|strong="H7324"\w*?”
\p \v 13 “\w Do you not|strong="H3808"\w* \w know|strong="H3045"\w* \w what|strong="H4100"\w* \w these are|strong="H428"\w*?” \w he inquired|strong="H559"\w*\w . . .|strong="H559"\w* \w -|strong="H413"\w*.
\p “\w No|strong="H3808"\w*, \w my lord|strong="H113"\w*,” \w I replied|strong="H559"\w*.
\p \v 14 \w So he said|strong="H559"\w*, “\w These|strong="H428"\w* \w are the two|strong="H8147"\w* \w anointed|strong="H3323"\w* \w ones|strong="H1121"\w*\f + \fr 4:14 \ft Hebrew \fqa the two sons of new oil\f* \w who are standing|strong="H5975"\w* \w beside|strong="H5921"\w* \w the Lord|strong="H113"\w* \w of all|strong="H3605"\w* \w the earth|strong="H776"\w*.”\f + \fr 4:14 \ft See \ref Revelation 11:4|REV 11:4\ref*.\f*
\c 5
\s1 The Vision of the Flying Scroll
\p \v 1 \w Again|strong="H7725"\w* \w I lifted up|strong="H5375"\w* \w my eyes|strong="H5869"\w* \w and saw|strong="H7200"\w* \w before me|strong="H2009"\w* \w a flying|strong="H5774"\w* \w scroll|strong="H4039"\w*.
\p \v 2 “\w What|strong="H4100"\w* \w do you|strong="H859"\w* \w see|strong="H7200"\w*?” \w asked [the angel]|strong="H559"\w* \w . . .|strong="H413"\w*.
\p “\w I|strong="H589"\w* \w see|strong="H7200"\w* \w a flying|strong="H5774"\w* \w scroll|strong="H4039"\w*,” \w I replied|strong="H559"\w*, “\w twenty|strong="H6242"\w* \w cubits|strong="H520"\w* \w long|strong="H753"\w* \w and ten|strong="H6235"\w* \w cubits|strong="H520"\w* \w wide|strong="H7341"\w*.\f + \fr 5:2 \ft The flying scroll was approximately 30 feet long and 15 feet wide (9.1 meters long and 4.6 meters wide).\f*”
\p \v 3 \w Then he told|strong="H559"\w* \w me|strong="H413"\w*, “\w This|strong="H2063"\w* \w is the curse|strong="H423"\w* \w that is going out|strong="H3318"\w* \w over|strong="H5921"\w* \w the face|strong="H6440"\w* \w of all|strong="H3605"\w* \w the land|strong="H776"\w*, \w for|strong="H3588"\w* \w according [to]|strong="H3644"\w* \w one [side] of [the scroll]|strong="H2088"\w*, \w every|strong="H3605"\w* \w thief|strong="H1589"\w* \w will be removed|strong="H5352"\w*; \w and according to|strong="H3644"\w* \w the other side|strong="H2088"\w*, \w every|strong="H3605"\w* \w perjurer|strong="H7650"\w* \w will be removed|strong="H5352"\w*. \v 4 \w I will send it out|strong="H3318"\w*, \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*, \w and it will enter|strong="H935"\w* \w . . .|strong="H413"\w* \w the house|strong="H1004"\w* \w of the thief|strong="H1590"\w* \w . . .|strong="H413"\w* \w and the house|strong="H1004"\w* \w of him who swears|strong="H7650"\w* \w falsely|strong="H8267"\w* \w by My name|strong="H8034"\w*. \w It will remain|strong="H3885"\w* \w inside|strong="H8432"\w* \w his house|strong="H1004"\w* \w and destroy it|strong="H3615"\w*, \w [down to]|strong="H853"\w* \w its timbers|strong="H6086"\w* \w -|strong="H853"\w* \w and stones|strong="H68"\w*.”
\s1 The Vision of the Woman in a Basket
\p \v 5 \w Then the angel|strong="H4397"\w* \w who was speaking|strong="H1696"\w* with me \w came forward|strong="H3318"\w* \w and told|strong="H559"\w* \w me|strong="H413"\w*, “\w Now|strong="H4994"\w* \w lift up|strong="H5375"\w* \w your eyes|strong="H5869"\w* \w and see|strong="H7200"\w* \w what|strong="H4100"\w* \w -|strong="H2063"\w* \w is approaching|strong="H3318"\w*.”
\p \v 6 “\w What|strong="H4100"\w* \w is it|strong="H1931"\w*?” \w I asked|strong="H559"\w*.
\p \w And he replied|strong="H559"\w*, “\w -|strong="H2063"\w* \w A measuring basket|strong="H374"\w*\f + \fr 5:6 \ft Or \fqa An ephah\f* \w is going forth|strong="H3318"\w*.” \w Then he continued|strong="H559"\w*, “\w This|strong="H2063"\w* \w is their iniquity|strong="H5869"\w*\f + \fr 5:6 \ft One Hebrew manuscript, LXX, and Syriac; most Hebrew manuscripts \fqa their appearance \ft or (literally) \fqa their eye\f* \w in all|strong="H3605"\w* \w the land|strong="H776"\w*.”
\p \v 7 \w And behold|strong="H2009"\w*, \w the cover|strong="H3603"\w* \w of lead|strong="H5777"\w* \w was raised|strong="H5375"\w*, \w . . .|strong="H2063"\w* \w and there was|strong="H259"\w* \w a woman|strong="H802"\w* \w sitting|strong="H3427"\w* \w inside|strong="H8432"\w* \w the basket|strong="H374"\w*.
\p \v 8 “\w This|strong="H2063"\w* \w is Wickedness|strong="H7564"\w*,” \w he said|strong="H559"\w*. \w And he shoved her down|strong="H7993"\w* \w -|strong="H853"\w* \w into|strong="H413"\w* \w . . .|strong="H8432"\w* \w the basket|strong="H374"\w*, \w pushing down|strong="H7993"\w* \w -|strong="H853"\w* \w the lead|strong="H5777"\w* \w cover|strong="H68"\w* \w over|strong="H413"\w* \w its opening|strong="H6310"\w*.
\p \v 9 \w Then I lifted|strong="H5375"\w* \w up my eyes|strong="H5869"\w* \w and saw|strong="H7200"\w* \w . . .|strong="H2009"\w* \w two|strong="H8147"\w* \w women|strong="H802"\w* \w approaching|strong="H3318"\w*, \w with the wind|strong="H7307"\w* \w in their wings|strong="H3671"\w*. Their \w wings|strong="H3671"\w* \w were like those|strong="H3671"\w* \w of a stork|strong="H2624"\w*, \w and they lifted up|strong="H5375"\w* \w -|strong="H853"\w* \w the basket|strong="H374"\w* \w between|strong="H996"\w* \w heaven|strong="H8064"\w* \w and|strong="H996"\w* \w earth|strong="H776"\w*.
\p \v 10 “\w Where|strong="H575"\w* \w are they|strong="H1992"\w* \w taking|strong="H1980"\w* \w -|strong="H853"\w* \w the basket|strong="H374"\w*?” \w I asked|strong="H559"\w* \w . . .|strong="H413"\w* \w the angel|strong="H4397"\w* \w who was speaking|strong="H1696"\w* with me.
\p \v 11 “\w To build|strong="H1129"\w* \w a house|strong="H1004"\w* for it \w in the land|strong="H776"\w* \w of Shinar|strong="H8152"\w*,\f + \fr 5:11 \ft That is, Babylonia\f*” \w he told|strong="H559"\w* \w me|strong="H413"\w*. “\w And when it is ready|strong="H3559"\w*, \w the basket will be set|strong="H5117"\w* \w there|strong="H8033"\w* \w on|strong="H5921"\w* \w its pedestal|strong="H4369"\w*.”
\c 6
\s1 The Vision of the Four Chariots
\p \v 1 \w And again|strong="H7725"\w* \w I lifted|strong="H5375"\w* \w up my eyes|strong="H5869"\w* \w and saw|strong="H7200"\w* \w . . .|strong="H2009"\w* \w four|strong="H702"\w* \w chariots|strong="H4818"\w* \w coming out|strong="H3318"\w* \w from between|strong="H996"\w* \w two|strong="H8147"\w* \w mountains|strong="H2022"\w* — \w mountains|strong="H2022"\w* \w . . .|strong="H2022"\w* \w of bronze|strong="H5178"\w*. \v 2 \w The first|strong="H7223"\w* \w chariot|strong="H4818"\w* \w had red|strong="H122"\w* \w horses|strong="H5483"\w*, \w the second|strong="H8145"\w* \w -|strong="H4818"\w* \w black|strong="H7838"\w* \w horses|strong="H5483"\w*, \v 3 \w the third|strong="H7992"\w* \w -|strong="H4818"\w* \w white|strong="H3836"\w* \w horses|strong="H5483"\w*, \w and the fourth|strong="H7243"\w* \w -|strong="H4818"\w* \w dappled|strong="H1261"\w* \w horses|strong="H5483"\w*— \w all of them strong|strong="H554"\w*.
\p \v 4 \w -|strong="H6030"\w* \w So I inquired|strong="H559"\w* \w of|strong="H413"\w* \w the angel|strong="H4397"\w* \w who was speaking|strong="H1696"\w* with me, “\w What|strong="H4100"\w* \w are these|strong="H428"\w*, \w my lord|strong="H113"\w*?”
\p \v 5 \w And|strong="H6030"\w* \w the angel|strong="H4397"\w* \w told|strong="H559"\w* \w me|strong="H413"\w*, “\w These|strong="H428"\w* \w are the four|strong="H702"\w* \w spirits|strong="H7307"\w*\f + \fr 6:5 \ft Or \fqa winds\f* \w of heaven|strong="H8064"\w*, \w going forth|strong="H3318"\w* \w from [their] station|strong="H3320"\w* \w before|strong="H5921"\w* \w the Lord|strong="H113"\w* \w of all|strong="H3605"\w* \w the earth|strong="H776"\w*. \v 6 \w The one|strong="H834"\w* with \w the black|strong="H7838"\w* \w horses|strong="H5483"\w* \w is going|strong="H3318"\w* \w toward|strong="H413"\w* \w the land|strong="H776"\w* \w of the north|strong="H6828"\w*, \w [the one with] the white [horses]|strong="H3836"\w* \w -|strong="H3318"\w* \w toward|strong="H413"\w* \w [the west]|strong="H310"\w*,\f + \fr 6:6 \ft Or \fqa the one with the white horses after them\f* \w and [the one with] the dappled [horses]|strong="H1261"\w* \w -|strong="H3318"\w* \w toward|strong="H413"\w* \w -|strong="H776"\w* \w the south|strong="H8486"\w*.”
\p \v 7 \w As the strong [horses]|strong="H554"\w* \w went out|strong="H3318"\w*, \w they were eager|strong="H1245"\w* \w to go|strong="H1980"\w* \w [and] patrol|strong="H1980"\w* \w the earth|strong="H776"\w*; \w and [the LORD] said|strong="H559"\w*, “\w Go|strong="H1980"\w* \w [and] patrol|strong="H1980"\w* \w the earth|strong="H776"\w*.” \w So they patrolled|strong="H1980"\w* \w the earth|strong="H776"\w*.
\p \v 8 \w Then [the LORD] summoned|strong="H2199"\w* \w me|strong="H854"\w* \w . . .|strong="H1696"\w* \w and said|strong="H559"\w*, “\w Behold|strong="H7200"\w*, \w those going|strong="H3318"\w* \w . . .|strong="H413"\w* \w to|strong="H413"\w* \w the land|strong="H776"\w* \w of the north|strong="H6828"\w* \w have given rest|strong="H5117"\w* \w -|strong="H853"\w* \w to My Spirit|strong="H7307"\w* \w in the land|strong="H776"\w* \w of the north|strong="H6828"\w*.”
\s1 The Crown and the Temple
\p \v 9 \w The word|strong="H1697"\w* \w of the LORD|strong="H3068"\w* \w also came|strong="H1961"\w* \w to me|strong="H413"\w*, \w saying|strong="H559"\w*, \v 10 “\w Take|strong="H3947"\w* \w an offering from|strong="H854"\w* \w the exiles|strong="H1473"\w* — \w from Heldai|strong="H2469"\w*, \w . . .|strong="H854"\w* \w Tobijah|strong="H2900"\w*, \w . . .|strong="H854"\w* \w and Jedaiah|strong="H3048"\w*, \w who|strong="H834"\w* \w have arrived|strong="H935"\w* \w from Babylon|strong="H894"\w* — \w and go|strong="H935"\w*\w . . .|strong="H859"\w*\w . . .|strong="H935"\w* \w that same|strong="H1931"\w* \w day|strong="H3117"\w* \w to the house|strong="H1004"\w* \w of Josiah|strong="H2977"\w* \w son|strong="H1121"\w* \w of Zephaniah|strong="H6846"\w*. \v 11 \w Take|strong="H3947"\w* \w silver|strong="H3701"\w* \w and gold|strong="H2091"\w*, \w make|strong="H6213"\w* \w an [ornate] crown|strong="H5850"\w*, \w and set|strong="H7760"\w* \w [it] on the head|strong="H7218"\w* \w of the high|strong="H1419"\w* \w priest|strong="H3548"\w*, \w Joshua|strong="H3091"\w* \w son|strong="H1121"\w* \w of Jehozadak|strong="H3087"\w*.\f + \fr 6:11 \fqa Jehozadak \ft is a variant of \fqa Jozadak\ft ; see \ref Ezra 3:2|EZR 3:2\ref*.\f*
\p \v 12 \w And you are to tell him|strong="H559"\w* \w . . .|strong="H413"\w*\w . . .|strong="H559"\w* \w that this is what|strong="H3541"\w* \w . . .|strong="H559"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w* \w says|strong="H559"\w*: ‘\w Here is|strong="H2009"\w* \w a man|strong="H376"\w* \w whose name [is]|strong="H8034"\w* \w the Branch|strong="H6780"\w*, \w and He will branch out|strong="H6779"\w* \w from His place|strong="H8478"\w* \w and build|strong="H1129"\w* \w -|strong="H853"\w* \w the temple|strong="H1964"\w* \w of the LORD|strong="H3068"\w*. \v 13 \w Yes, He|strong="H1931"\w* \w will build|strong="H1129"\w* \w -|strong="H853"\w* \w the temple|strong="H1964"\w* \w of the LORD|strong="H3068"\w*; \w He|strong="H1931"\w* \w will be clothed in|strong="H5375"\w* \w splendor|strong="H1935"\w* \w and will sit|strong="H3427"\w* \w on|strong="H5921"\w* \w His throne|strong="H3678"\w* \w and rule|strong="H4910"\w*. \w And He will be|strong="H1961"\w* \w a priest|strong="H3548"\w* \w on|strong="H5921"\w* \w His throne|strong="H3678"\w*,\f + \fr 6:13 \ft Or \fqa And there will be a priest on His throne\f* \w and there will be|strong="H1961"\w* \w peaceful|strong="H7965"\w* \w counsel|strong="H6098"\w* \w between|strong="H996"\w* \w the two|strong="H8147"\w*.’
\p \v 14 \w The crown|strong="H5850"\w* \w will reside|strong="H1961"\w* \w in the temple|strong="H1964"\w* \w of the LORD|strong="H3068"\w* \w as a memorial|strong="H2146"\w* \w to Helem|strong="H2494"\w*,\f + \fr 6:14 \ft Hebrew; Syriac \fqa Heldai\ft ; see verse 10.\f* \w Tobijah|strong="H2900"\w*, \w Jedaiah|strong="H3048"\w*, \w and the gracious|strong="H2581"\w*\f + \fr 6:14 \ft Or \fqa and Hen\ft ; Syriac \fqa and Josiah\ft ; see verse 10.\f* \w son|strong="H1121"\w* \w of Zephaniah|strong="H6846"\w*. \v 15 \w Even those far away|strong="H7350"\w* \w will come|strong="H935"\w* \w and build|strong="H1129"\w* \w the temple|strong="H1964"\w* \w of the LORD|strong="H3068"\w*, \w and you will know|strong="H3045"\w* \w that|strong="H3588"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w* \w has sent Me|strong="H7971"\w* \w to you|strong="H413"\w*. \w This will happen|strong="H1961"\w* \w if|strong="H518"\w* \w you diligently obey|strong="H8085"\w* \w . . .|strong="H8085"\w* \w the voice|strong="H6963"\w* \w of the LORD|strong="H3068"\w* \w your God|strong="H430"\w*.”
\c 7
\s1 A Call to Justice and Mercy
\p \v 1 \w In the fourth|strong="H702"\w* \w year|strong="H8141"\w* \w of King|strong="H4428"\w* \w . . .|strong="H1961"\w* \w Darius|strong="H1867"\w*, \w the word|strong="H1697"\w* \w of the LORD|strong="H3068"\w* \w came|strong="H1961"\w* \w to|strong="H413"\w* \w Zechariah|strong="H2148"\w* \w on the fourth|strong="H702"\w* \w day of the ninth|strong="H8671"\w* \w month|strong="H2320"\w*, \w the month of Chislev|strong="H3691"\w*.\f + \fr 7:1 \fqa Chislev \ft is the ninth month of the Hebrew lunar calendar, usually occurring within the months of November and December.\f* \v 2 \w vvv|strong="H1008"\w* \w Now the people of Bethel|strong="H1008"\w* \w had sent|strong="H7971"\w* \w vvv|strong="H8272"\w* \w Sharezer|strong="H8272"\w* \w vvv|strong="H7278"\w* \w and Regem-melech|strong="H7278"\w*, \w along with their men|strong="H582"\w*,\f + \fr 7:2 \ft Or \fqa Bethel-sharezer had sent Regem-melech, along with his men,\f* \w to plead|strong="H2470"\w* \w -|strong="H853"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \v 3 \w by asking|strong="H559"\w* \w . . .|strong="H413"\w* \w the priests|strong="H3548"\w* \w -|strong="H834"\w* \w of the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*, \w as well as|strong="H413"\w* \w the prophets|strong="H5030"\w* \w . . .|strong="H559"\w*, “\w Should I weep|strong="H1058"\w* \w and fast|strong="H5144"\w* \w in the fifth|strong="H2549"\w* \w month|strong="H2320"\w*, \w as|strong="H834"\w* \w I have done|strong="H6213"\w* \w these|strong="H2088"\w* \w many|strong="H4100"\w* \w years|strong="H8141"\w*?”
\p \v 4 \w Then the word|strong="H1697"\w* \w of the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w* \w came|strong="H1961"\w* \w to me|strong="H413"\w*, \w saying|strong="H559"\w*, \v 5 “\w Ask|strong="H559"\w* \w . . .|strong="H413"\w* \w all|strong="H3605"\w* \w the people|strong="H5971"\w* \w of the land|strong="H776"\w* \w . . .|strong="H413"\w* \w and the priests|strong="H3548"\w* \w . . .|strong="H559"\w*, ‘\w When|strong="H3588"\w* \w you fasted|strong="H6684"\w* \w and mourned|strong="H5594"\w* \w in the fifth|strong="H2549"\w* \w and seventh months|strong="H7637"\w* \w for these|strong="H2088"\w* \w seventy|strong="H7657"\w* \w years|strong="H8141"\w*, \w {was it really} for Me|strong="H589"\w* \w that you fasted|strong="H6684"\w* \w . . .|strong="H6684"\w*? \v 6 \w And when|strong="H3588"\w* \w you were eating|strong="H398"\w* \w . . .|strong="H3588"\w* \w and drinking|strong="H8354"\w*, \w were you not|strong="H3808"\w* \w [doing so]|strong="H859"\w* \w . . .|strong="H398"\w* \w . . .|strong="H859"\w* \w simply for yourselves|strong="H8354"\w*? \v 7 \w Are these not|strong="H3808"\w* \w -|strong="H853"\w* \w the words|strong="H1697"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w proclaimed|strong="H7121"\w* \w through|strong="H3027"\w* \w the earlier|strong="H7223"\w* \w prophets|strong="H5030"\w*, \w when Jerusalem|strong="H3389"\w* \w and its surrounding|strong="H5439"\w* \w towns|strong="H5892"\w* \w were|strong="H1961"\w* \w populous|strong="H3427"\w* \w and prosperous|strong="H7961"\w*, \w and the Negev|strong="H5045"\w* \w and the foothills|strong="H8219"\w*\f + \fr 7:7 \ft Hebrew \fqa Shephelah \ft or \fqa lowlands\ft ; that is, the western foothills of Judea\f* \w were inhabited|strong="H3427"\w*?’”
\p \v 8 \w Then the word|strong="H1697"\w* \w of the LORD|strong="H3068"\w* \w came|strong="H1961"\w* \w to|strong="H413"\w* \w Zechariah|strong="H2148"\w*, \w saying|strong="H559"\w*, \v 9 “\w This is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w* \w . . .|strong="H559"\w* \w says|strong="H559"\w*: ‘\w Administer|strong="H8199"\w* \w true|strong="H571"\w* \w justice|strong="H4941"\w*. \w Show|strong="H6213"\w* \w loving devotion|strong="H2617"\w*\f + \fr 7:9 \ft Forms of the Hebrew \fqa chesed \ft are translated here and in most cases throughout the Scriptures as \fqa loving devotion\ft ; the range of meaning includes \fqa love\ft , \fqa goodness\ft , \fqa kindness\ft , \fqa faithfulness\ft , and \fqa mercy\ft , as well as \fqa loyalty to a covenant\ft .\f* \w and compassion|strong="H7356"\w* \w to|strong="H854"\w* \w one|strong="H376"\w* \w another|strong="H251"\w*. \v 10 \w Do not|strong="H408"\w* \w oppress|strong="H6231"\w* \w the widow|strong="H490"\w* \w or the fatherless|strong="H3490"\w*, \w the foreigner|strong="H1616"\w* \w or the poor|strong="H6041"\w*. \w And do not|strong="H408"\w* \w plot|strong="H2803"\w* \w evil|strong="H7451"\w* \w in your hearts|strong="H3824"\w* \w against one|strong="H376"\w* \w another|strong="H251"\w*.’
\p \v 11 \w But they refused|strong="H3985"\w* \w to pay attention|strong="H7181"\w* \w and turned|strong="H5414"\w* \w a stubborn|strong="H5637"\w* \w shoulder|strong="H3802"\w*; \w they stopped up|strong="H3513"\w* \w their ears|strong="H241"\w* \w from hearing|strong="H8085"\w*.\f + \fr 7:11 \ft Hebrew \fqa they made their ears too heavy to hear\f* \v 12 \w They made|strong="H7760"\w* \w their hearts|strong="H3820"\w* \w [like] flint|strong="H8068"\w* \w and would not listen to|strong="H8085"\w* \w -|strong="H853"\w* \w the law|strong="H8451"\w* \w or|strong="H853"\w* \w to the words|strong="H1697"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w* \w had sent|strong="H7971"\w* \w by His Spirit|strong="H7307"\w* \w through|strong="H3027"\w* \w the earlier|strong="H7223"\w* \w prophets|strong="H5030"\w*. \w Therefore great|strong="H1419"\w* \w anger|strong="H7110"\w* \w came|strong="H1961"\w* \w from|strong="H854"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*.
\p \v 13 \w And|strong="H1961"\w* \w just as|strong="H834"\w* \w I had called|strong="H7121"\w* \w and they would not|strong="H3808"\w* \w listen|strong="H8085"\w*, \w so|strong="H3651"\w* \w when they called|strong="H7121"\w* \w I would not|strong="H3808"\w* \w listen|strong="H8085"\w*, \w says|strong="H559"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*. \v 14 \w But I scattered them with a whirlwind|strong="H5590"\w* \w among|strong="H5921"\w* \w all|strong="H3605"\w* \w the nations|strong="H1471"\w* \w that|strong="H834"\w* \w they had not|strong="H3808"\w* \w known|strong="H3045"\w*, \w and the land|strong="H776"\w* \w was left desolate|strong="H8074"\w* \w behind them|strong="H310"\w* \w so that no one could come|strong="H5674"\w* \w or go|strong="H7725"\w*. \w Thus they turned|strong="H7760"\w* \w the pleasant|strong="H2532"\w* \w land|strong="H776"\w* \w into a desolation|strong="H8047"\w*.”
\c 8
\s1 The Restoration of Jerusalem
\r (\ref Micah 4:6–13|MIC 4:6-13\ref*)
\p \v 1 \w Again the word|strong="H1697"\w* \w of the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w* \w came [to me]|strong="H1961"\w*, \w saying|strong="H559"\w*: \v 2 \w This is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w* \w says|strong="H559"\w*: “\w I am jealous|strong="H7065"\w* \w for Zion|strong="H6726"\w* \w with great|strong="H1419"\w* \w zeal|strong="H7068"\w*; \w I am jealous|strong="H7065"\w* for her \w with great|strong="H1419"\w* \w fervor|strong="H2534"\w*.”
\p \v 3 \w This is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w says|strong="H559"\w*: “\w I will return|strong="H7725"\w* \w to|strong="H413"\w* \w Zion|strong="H6726"\w* \w and dwell|strong="H7931"\w* \w in|strong="H8432"\w* \w Jerusalem|strong="H3389"\w*. \w Then Jerusalem|strong="H3389"\w* \w will be called|strong="H7121"\w* \w the City|strong="H5892"\w* \w of Truth|strong="H571"\w*, \w and the mountain|strong="H2022"\w* \w of the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w* \w [will be called] the Holy|strong="H6944"\w* \w Mountain|strong="H2022"\w*.”
\p \v 4 \w This is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w* \w says|strong="H559"\w*: “\w Old men|strong="H2205"\w* \w and old women|strong="H2205"\w* \w will again|strong="H5750"\w* \w sit|strong="H3427"\w* \w along the streets|strong="H7339"\w* \w of Jerusalem|strong="H3389"\w*, \w each|strong="H376"\w* \w with a staff|strong="H4938"\w* \w in hand|strong="H3027"\w* \w because of|strong="H7230"\w* \w great age|strong="H3117"\w*. \v 5 \w And the streets|strong="H7339"\w* \w of the city|strong="H5892"\w* \w will be filled|strong="H4390"\w* \w with boys|strong="H3206"\w* \w and girls|strong="H3207"\w* \w playing|strong="H7832"\w* \w there|strong="H7339"\w*.”
\p \v 6 \w This is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w* \w says|strong="H559"\w*: “\w If|strong="H3588"\w* \w [this] is impossible|strong="H6381"\w*\f + \fr 8:6 \ft Or \fqa marvelous\ft ; twice in this verse\f* \w in the eyes|strong="H5869"\w* \w of the remnant|strong="H7611"\w* \w of this|strong="H2088"\w* \w people|strong="H5971"\w* \w in these|strong="H1992"\w* \w days|strong="H3117"\w*, \w should it also|strong="H1571"\w* \w be impossible|strong="H6381"\w* \w in My eyes|strong="H5869"\w*?” \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*.
\p \v 7 \w This is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w* \w . . .|strong="H2005"\w* \w says|strong="H559"\w*: “\w I will save|strong="H3467"\w* \w -|strong="H853"\w* \w My people|strong="H5971"\w* \w from the land|strong="H776"\w* \w of the east|strong="H4217"\w* \w and from the land|strong="H776"\w* \w of|strong="H3996"\w* \w the west|strong="H8121"\w*. \v 8 \w I will bring them|strong="H935"\w* \w {back}|strong="H853"\w* \w to dwell|strong="H7931"\w* \w in|strong="H8432"\w* \w Jerusalem|strong="H3389"\w*, \w where they will be|strong="H1961"\w* My \w people|strong="H5971"\w*, \w and I|strong="H589"\w* \w will be|strong="H1961"\w* their \w faithful|strong="H571"\w* \w and righteous|strong="H6666"\w* \w God|strong="H430"\w*.”
\p \v 9 \w This is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w* \w says|strong="H559"\w*: “\w Let your hands|strong="H3027"\w* \w be strong|strong="H2388"\w*, \w you who now|strong="H3117"\w* \w . . .|strong="H428"\w* \w -|strong="H853"\w* \w hear|strong="H8085"\w* \w these|strong="H428"\w* \w words|strong="H1697"\w* \w spoken|strong="H834"\w* \w . . .|strong="H6310"\w* \w by the prophets|strong="H5030"\w* \w [who were present] when|strong="H3117"\w* \w the foundations were laid|strong="H3245"\w* \w to rebuild|strong="H1129"\w* \w the temple|strong="H1964"\w*, \w the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*. \v 10 \w For|strong="H3588"\w* \w before|strong="H6440"\w* \w those|strong="H1992"\w* \w days|strong="H3117"\w* \w neither|strong="H3808"\w* \w man|strong="H120"\w* \w nor|strong="H369"\w* \w beast|strong="H929"\w* \w received|strong="H1961"\w* \w . . .|strong="H7939"\w* \w wages|strong="H7939"\w*, \w nor was there|strong="H369"\w* \w safety|strong="H7965"\w* \w from|strong="H4480"\w* \w the enemy|strong="H6862"\w* \w for anyone who came|strong="H3318"\w* \w or went|strong="H935"\w*, \w for I had turned|strong="H7971"\w* \w -|strong="H853"\w* \w every|strong="H3605"\w* \w man|strong="H120"\w* \w . . .|strong="H376"\w* \w against his neighbor|strong="H7453"\w*. \v 11 \w But now|strong="H6258"\w* \w I|strong="H589"\w* \w will not treat|strong="H3808"\w* \w the remnant|strong="H7611"\w* \w of this|strong="H2088"\w* \w people|strong="H5971"\w* \w as I did in the past|strong="H7223"\w* \w . . .|strong="H3117"\w*,” \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*.
\p \v 12 “\w For|strong="H3588"\w* \w the seed|strong="H2233"\w* \w [will be] prosperous|strong="H7965"\w*, \w the vine|strong="H1612"\w* \w will yield|strong="H5414"\w* \w its fruit|strong="H6529"\w*, \w the ground|strong="H776"\w* \w will yield|strong="H5414"\w* \w -|strong="H853"\w* \w its produce|strong="H2981"\w*, \w and the skies|strong="H8064"\w* \w will give|strong="H5414"\w* \w their dew|strong="H2919"\w*. \w To the remnant|strong="H7611"\w* \w of this|strong="H2088"\w* \w -|strong="H853"\w* \w people|strong="H5971"\w* \w {I will give} all|strong="H3605"\w* \w these things|strong="H428"\w* \w as an inheritance|strong="H5157"\w*. \w -|strong="H853"\w* \v 13 \w As|strong="H834"\w* \w vvv|strong="H1961"\w* \w you have been|strong="H1961"\w* \w a curse|strong="H7045"\w* \w among the nations|strong="H1471"\w*, \w O house|strong="H1004"\w* \w of Judah|strong="H3063"\w* \w and house|strong="H1004"\w* \w of Israel|strong="H3478"\w*, \w so|strong="H3651"\w* \w I will save|strong="H3467"\w* \w you|strong="H853"\w*, \w and you will be|strong="H1961"\w* \w a blessing|strong="H1293"\w*. \w Do not|strong="H408"\w* \w be afraid|strong="H3372"\w*; \w let your hands|strong="H3027"\w* \w be strong|strong="H2388"\w*.”
\p \v 14 \w For|strong="H3588"\w* \w this is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w* \w says|strong="H559"\w*: “\w Just as|strong="H834"\w* \w I resolved|strong="H2161"\w* \w to bring disaster|strong="H7489"\w* upon you \w when your fathers|strong="H1"\w* \w provoked Me to anger|strong="H7107"\w* \w -|strong="H853"\w*, \w and I did not|strong="H3808"\w* \w relent|strong="H5162"\w*,” \w says|strong="H559"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*, \v 15 “\w so|strong="H3651"\w* \w now|strong="H428"\w* \w . . .|strong="H3117"\w* \w I have resolved|strong="H2161"\w* \w to do good|strong="H3190"\w* \w again|strong="H7725"\w*\w . . .|strong="H853"\w* \w to Jerusalem|strong="H3389"\w* \w and|strong="H853"\w* \w vvv|strong="H1004"\w* \w Judah|strong="H3063"\w*. \w Do not|strong="H408"\w* \w be afraid|strong="H3372"\w*. \v 16 \w These|strong="H428"\w* \w are the things|strong="H1697"\w* \w -|strong="H834"\w* \w you must do|strong="H6213"\w*: \w Speak|strong="H1696"\w* \w truth|strong="H571"\w* \w to one|strong="H376"\w* \w . . .|strong="H854"\w* \w another|strong="H7453"\w*, \w render true|strong="H571"\w* \w and sound|strong="H7965"\w* \w judgments|strong="H4941"\w* \w . . .|strong="H8199"\w* \w in your gates|strong="H8179"\w*, \v 17 \w -|strong="H376"\w* \w -|strong="H853"\w* \w do not|strong="H408"\w* \w plot|strong="H2803"\w* \w evil|strong="H7451"\w* \w in your hearts|strong="H3824"\w* \w against your neighbor|strong="H7453"\w*, \w and do not|strong="H408"\w* \w love|strong="H157"\w* \w to swear|strong="H7621"\w* \w falsely|strong="H8267"\w*, \w for|strong="H3588"\w* \w -|strong="H853"\w* \w I hate|strong="H8130"\w* \w all|strong="H3605"\w* \w these things|strong="H428"\w*,” \w -|strong="H834"\w* \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*.
