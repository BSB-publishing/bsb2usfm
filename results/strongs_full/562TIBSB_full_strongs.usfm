\p \v 14 \w Alexander|strong="G223"\w* \w the|strong="G3588"\w* \w coppersmith|strong="G5471"\w* \w did|strong="G1731"\w* \w great|strong="G4183"\w* \w harm|strong="G2556"\w* \w to me|strong="G1473"\w*. \w The|strong="G3588"\w* \w Lord|strong="G2962"\w* \w will repay|strong="G591"\w* \w him|strong="G846"\w* \w according to|strong="G2596"\w* \w his|strong="G846"\w* \w -|strong="G3588"\w* \w deeds|strong="G2041"\w*. \v 15 \w You|strong="G4771"\w* \w too|strong="G2532"\w* \w should beware of|strong="G5442"\w* \w [him]|strong="G3739"\w*, \w for|strong="G1063"\w* \w vvv|strong="G3029"\w* \w he has vigorously opposed|strong="G436"\w* \w our|strong="G2251"\w* \w -|strong="G3588"\w* \w message|strong="G3056"\w*.
\s1 The Lord Remains Faithful
\p \v 16 \w At|strong="G1722"\w* \w my|strong="G1473"\w* \w first|strong="G4413"\w* \w -|strong="G3588"\w* \w defense|strong="G627"\w*, \w no one|strong="G3762"\w* \w stood with|strong="G3854"\w* \w me|strong="G1473"\w*, \w but|strong="G235"\w* \w everyone|strong="G3956"\w* \w deserted|strong="G1459"\w* \w me|strong="G1473"\w*. \w vvv|strong="G3361"\w* \w May it not be charged|strong="G3049"\w* \w against them|strong="G846"\w*. \v 17 \w But|strong="G1161"\w* \w the|strong="G3588"\w* \w Lord|strong="G2962"\w* \w stood by|strong="G3936"\w* \w me|strong="G1473"\w* \w and|strong="G2532"\w* \w strengthened|strong="G1743"\w* \w me|strong="G1473"\w*, \w so that|strong="G2443"\w* \w through|strong="G1223"\w* \w me|strong="G1473"\w* \w the|strong="G3588"\w* \w message|strong="G2782"\w* \w would be fully proclaimed|strong="G4135"\w*, \w and|strong="G2532"\w* \w all|strong="G3956"\w* \w the|strong="G3588"\w* \w Gentiles|strong="G1484"\w* \w would hear [it]|strong="G191"\w*. \w [So]|strong="G2532"\w* \w I was delivered|strong="G4506"\w* \w from|strong="G1537"\w* \w [the] mouth|strong="G4750"\w* \w of the lion|strong="G3023"\w*. \v 18 \w [And] the|strong="G3588"\w* \w Lord|strong="G2962"\w* \w will rescue|strong="G4506"\w* \w me|strong="G1473"\w* \w from|strong="G575"\w* \w every|strong="G3956"\w* \w evil|strong="G4190"\w* \w action|strong="G2041"\w* \w and|strong="G2532"\w* \w bring [me] safely|strong="G4982"\w* \w into|strong="G1519"\w* \w His|strong="G846"\w* \w -|strong="G3588"\w* \w heavenly|strong="G2032"\w* \w -|strong="G3588"\w* \w kingdom|strong="G932"\w*. \w To Him [be]|strong="G3739"\w* \w the|strong="G3588"\w* \w glory|strong="G1391"\w* \w vvv|strong="G1519"\w* \w vvv|strong="G3588"\w* \w forever|strong="G165"\w* \w [and]|strong="G3588"\w* \w ever|strong="G165"\w*. \w Amen|strong="G281"\w*.
\s1 Final Greetings
