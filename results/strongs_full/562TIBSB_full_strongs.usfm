\p \v 22 \w The|strong="G3588"\w* \w Lord|strong="G2962"\w* \w [be] with|strong="G3326"\w* \w your|strong="G4771"\w* \w -|strong="G3588"\w* \w spirit|strong="G4151"\w*. \w -|strong="G3588"\w* \w Grace [be]|strong="G5485"\w* \w with|strong="G3326"\w* \w you all|strong="G4771"\w*.\f + \fr 4:22 \ft BYZ and TR include \fqa Amen.\f*
