\p \v 15 \w -|strong="H1961"\w* \w When|strong="H834"\w* \w our enemies|strong="H341"\w* \w heard|strong="H8085"\w* \w that|strong="H3588"\w* \w we were aware|strong="H3045"\w* \w of their scheme|strong="H6098"\w* \w and that God|strong="H430"\w* \w -|strong="H853"\w* \w had frustrated it|strong="H6565"\w*, \w each|strong="H3605"\w* \w of us returned|strong="H7725"\w* \w to|strong="H413"\w* \w his own|strong="H376"\w* \w work|strong="H4399"\w* \w on|strong="H413"\w* \w the wall|strong="H2346"\w*. \v 16 \w And|strong="H1961"\w* \w from|strong="H4480"\w* \w that|strong="H1931"\w* \w day on|strong="H3117"\w*, \w half|strong="H2677"\w* \w of my servants|strong="H5288"\w* \w did|strong="H6213"\w* \w the work|strong="H4399"\w* \w while the other half|strong="H2677"\w* \w held|strong="H2388"\w* \w spears|strong="H7420"\w*, \w shields|strong="H4043"\w*, \w bows|strong="H7198"\w*, \w and armor|strong="H8302"\w*.
\p \w The officers|strong="H8269"\w* \w [stationed themselves] behind|strong="H310"\w* \w all|strong="H3605"\w* \w the people|strong="H1004"\w* \w of Judah|strong="H3063"\w* \v 17 \w who were rebuilding|strong="H1129"\w* \w the wall|strong="H2346"\w*. \w The laborers who carried|strong="H5375"\w* \w materials|strong="H5447"\w* \w . . .|strong="H6006"\w* \w worked|strong="H6213"\w* \w . . .|strong="H4399"\w* \w with one|strong="H259"\w* \w hand|strong="H3027"\w* \w and held|strong="H2388"\w* \w a weapon|strong="H7973"\w* \w with the other|strong="H259"\w*. \v 18 \w And each|strong="H376"\w* \w of the builders|strong="H1129"\w* \w worked|strong="H1129"\w* \w with his sword|strong="H2719"\w* \w strapped|strong="H631"\w* \w at|strong="H5921"\w* \w his side|strong="H4975"\w*. \w But the trumpeter|strong="H8628"\w* \w . . .|strong="H7782"\w* \w stayed beside me|strong="H681"\w*.
\p \v 19 \w Then I said|strong="H559"\w* \w to|strong="H413"\w* \w the nobles|strong="H2715"\w*, \w . . .|strong="H413"\w* \w the officials|strong="H5461"\w*, \w . . .|strong="H413"\w* \w and the rest|strong="H3499"\w* \w of the people|strong="H5971"\w*: “\w The work [is]|strong="H4399"\w* \w great|strong="H7235"\w* \w and extensive|strong="H7342"\w*, \w and we|strong="H587"\w* \w are spread out|strong="H6504"\w* \w far|strong="H7350"\w* \w from one|strong="H376"\w* \w another|strong="H251"\w* \w along|strong="H5921"\w* \w the wall|strong="H2346"\w*. \v 20 \w Wherever|strong="H4725"\w* \w -|strong="H834"\w* \w you hear|strong="H8085"\w* \w -|strong="H853"\w* \w the sound|strong="H6963"\w* \w of the horn|strong="H7782"\w*, \w rally|strong="H6908"\w* \w to us|strong="H413"\w* \w there|strong="H8033"\w*. \w Our God|strong="H430"\w* \w will fight|strong="H3898"\w* for us!”
\p \v 21 \w So we|strong="H587"\w* \w continued|strong="H6213"\w* \w the work|strong="H4399"\w*, \w while half of [the men]|strong="H2677"\w* \w held|strong="H2388"\w* \w spears|strong="H7420"\w* \w from the break|strong="H5927"\w* \w of dawn|strong="H7837"\w* \w until|strong="H5704"\w* \w the stars|strong="H3556"\w* \w came out|strong="H3318"\w*. \v 22 \w At that|strong="H1931"\w* \w time|strong="H6256"\w* \w I also|strong="H1571"\w* \w said|strong="H559"\w* \w to the people|strong="H5971"\w*, “\w Let every man|strong="H376"\w* \w and his servant|strong="H5288"\w* \w spend the night|strong="H3885"\w* \w inside|strong="H8432"\w* \w Jerusalem|strong="H3389"\w*, \w so that they can stand|strong="H1961"\w* \w guard|strong="H4929"\w* \w by night|strong="H3915"\w* \w and work|strong="H4399"\w* \w by day|strong="H3117"\w*.”
\p \v 23 \w So neither I|strong="H589"\w* \w -|strong="H369"\w* \w nor my brothers|strong="H251"\w* \w nor my servants|strong="H5288"\w* \w . . .|strong="H376"\w* \w nor the guards|strong="H4929"\w* \w -|strong="H834"\w* \w with me|strong="H310"\w* \w . . .|strong="H369"\w* \w . . .|strong="H587"\w* \w changed out of|strong="H6584"\w* \w our clothes|strong="H899"\w*; \w each|strong="H376"\w* \w carried his weapon|strong="H7973"\w*, \w [even to go] for water|strong="H4325"\w*.\f + \fr 4:23 \ft Or \fqa each carried his weapon in his right hand\f*
\c 5
\s1 Nehemiah Defends the Oppressed
\p \v 1 \w About that time there was|strong="H1961"\w* \w a great|strong="H1419"\w* \w outcry|strong="H6818"\w* \w from the people|strong="H5971"\w* \w and their wives|strong="H802"\w* \w against|strong="H413"\w* \w their fellow|strong="H251"\w* \w Jews|strong="H3064"\w*.
\p \v 2 \w -|strong="H3426"\w* \w Some|strong="H834"\w* \w were saying|strong="H559"\w*, “\w We|strong="H587"\w* \w [and] our sons|strong="H1121"\w* \w and daughters|strong="H1323"\w* \w are numerous|strong="H7227"\w*. \w We must get|strong="H3947"\w* \w grain|strong="H1715"\w* \w in order to eat|strong="H398"\w* \w and stay alive|strong="H2421"\w*.”
\p \v 3 \w -|strong="H3426"\w* \w Others|strong="H834"\w* \w were saying|strong="H559"\w*, “\w We|strong="H587"\w* \w are mortgaging|strong="H6148"\w* \w our fields|strong="H7704"\w*, \w our vineyards|strong="H3754"\w*, \w and our homes|strong="H1004"\w* \w to get|strong="H3947"\w* \w grain|strong="H1715"\w* \w during the famine|strong="H7458"\w*.”
\p \v 4 \w -|strong="H3426"\w* \w Still others|strong="H834"\w* \w were saying|strong="H559"\w*, “\w We have borrowed|strong="H3867"\w* \w money [to pay]|strong="H3701"\w* \w the king’s|strong="H4428"\w* \w tax|strong="H4060"\w* \w [on] our fields|strong="H7704"\w* \w and vineyards|strong="H3754"\w*. \v 5 \w -|strong="H6258"\w* \w -|strong="H1320"\w* \w We and our children|strong="H1121"\w* \w are just like our countrymen|strong="H251"\w* \w . . .|strong="H1320"\w* \w and their children|strong="H1121"\w*, \w . . .|strong="H2009"\w* \w yet we|strong="H587"\w* \w are subjecting|strong="H3533"\w* \w -|strong="H853"\w* \w our sons|strong="H1121"\w* \w -|strong="H853"\w* \w and daughters|strong="H1323"\w* \w to slavery|strong="H5650"\w*. \w Some of|strong="H3426"\w* \w our daughters|strong="H1323"\w* \w are already enslaved|strong="H3533"\w*, \w but we are powerless [to redeem them]|strong="H369"\w* \w . . .|strong="H410"\w* \w . . .|strong="H3027"\w* \w because our fields|strong="H7704"\w* \w and vineyards|strong="H3754"\w* \w belong to others|strong="H312"\w*.”
\p \v 6 \w When|strong="H834"\w* \w I heard|strong="H8085"\w* \w -|strong="H853"\w* \w their outcry|strong="H2201"\w* \w -|strong="H853"\w* \w and these|strong="H428"\w* \w complaints|strong="H1697"\w*, \w I became extremely|strong="H3966"\w* \w angry|strong="H2734"\w*, \v 7 \w and after serious|strong="H3820"\w* \w thought|strong="H4427"\w*\w . . .|strong="H5921"\w* \w I rebuked|strong="H7378"\w* \w -|strong="H854"\w* \w the nobles|strong="H2715"\w* \w . . .|strong="H854"\w* \w and officials|strong="H5461"\w*, \w saying|strong="H559"\w*, “\w vvv|strong="H376"\w* \w You|strong="H859"\w* \w are exacting|strong="H5378"\w* \w usury|strong="H4855"\w* \w from your own brothers|strong="H251"\w*!”
\p \w So I called|strong="H5414"\w* \w a large|strong="H1419"\w* \w assembly|strong="H6952"\w* \w against them|strong="H5921"\w* \v 8 \w and said|strong="H559"\w*, “\w We|strong="H587"\w* \w have done our best|strong="H1767"\w* \w -|strong="H1571"\w* \w to buy back|strong="H7069"\w* \w -|strong="H853"\w* \w our Jewish|strong="H3064"\w* \w brothers|strong="H251"\w* \w who were sold|strong="H4376"\w* \w to foreigners|strong="H1471"\w*, \w but now you|strong="H859"\w* \w are selling|strong="H4376"\w* \w -|strong="H853"\w* \w your own brothers|strong="H251"\w*, \w that they may be sold back|strong="H4376"\w* to us!”
\p \w But they remained silent|strong="H2790"\w*, \w for they could find|strong="H4672"\w* \w nothing|strong="H3808"\w* \w to say|strong="H1697"\w*.
\p \v 9 \w So I continued|strong="H559"\w*, “\w What|strong="H834"\w* \w you|strong="H859"\w* \w are doing|strong="H6213"\w* \w is not|strong="H3808"\w* \w right|strong="H2896"\w*. \w . . .|strong="H1697"\w* \w Shouldn’t|strong="H3808"\w* \w you walk|strong="H1980"\w* \w in the fear|strong="H3374"\w* \w of our God|strong="H430"\w* \w to avoid the reproach|strong="H2781"\w* \w of our foreign|strong="H1471"\w* \w enemies|strong="H341"\w*? \v 10 \w I|strong="H589"\w*, \w as well as|strong="H1571"\w* \w my brothers|strong="H251"\w* \w and my servants|strong="H5288"\w*, \w have been lending|strong="H5383"\w* [the people] \w money|strong="H3701"\w* \w and grain|strong="H1715"\w*. \w Please|strong="H4994"\w*, \w -|strong="H853"\w* \w let us stop|strong="H5800"\w* \w this|strong="H2088"\w* \w usury|strong="H4855"\w*. \v 11 \w Please|strong="H4994"\w* \w restore|strong="H7725"\w* to them \w immediately|strong="H3117"\w* \w their fields|strong="H7704"\w*, \w vineyards|strong="H3754"\w*, \w olive groves|strong="H2132"\w*, \w and houses|strong="H1004"\w*, \w along with the percentage|strong="H3967"\w* \w of the money|strong="H3701"\w*, \w grain|strong="H1715"\w*, \w new wine|strong="H8492"\w*, \w and oil|strong="H3323"\w* \w that|strong="H834"\w* \w you|strong="H859"\w* \w have been assessing|strong="H5383"\w* them.”
\p \v 12 “\w We will restore [it]|strong="H7725"\w*,” \w they replied|strong="H559"\w*, “\w and will require|strong="H1245"\w* \w . . .|strong="H3651"\w* \w nothing|strong="H3808"\w* more from them. \w We will do|strong="H6213"\w* \w as|strong="H834"\w* \w you|strong="H859"\w* \w say|strong="H559"\w*.”
\p \w So I summoned|strong="H7121"\w* \w -|strong="H853"\w* \w the priests|strong="H3548"\w* \w and required [of the nobles and officials] an oath that they|strong="H7650"\w* \w would do|strong="H6213"\w* \w what they had promised|strong="H1697"\w* \w . . .|strong="H2088"\w*. \v 13 \w I also|strong="H1571"\w* \w shook out|strong="H5287"\w* \w the folds of my robe|strong="H2684"\w* \w and said|strong="H559"\w*, “\w May God|strong="H430"\w* \w -|strong="H853"\w* \w likewise|strong="H3602"\w* \w shake|strong="H5287"\w* \w out of his house|strong="H1004"\w* \w and possessions|strong="H3018"\w* \w . . .|strong="H3602"\w* \w every|strong="H3605"\w* \w man|strong="H376"\w* \w who|strong="H834"\w* \w does not|strong="H3808"\w* \w keep|strong="H6965"\w* \w -|strong="H853"\w* \w this|strong="H2088"\w* \w promise|strong="H1697"\w*. \w May [such a man] be|strong="H1961"\w* \w shaken out|strong="H5287"\w* \w and have nothing|strong="H7386"\w*!”
\p \w The whole|strong="H3605"\w* \w assembly|strong="H6951"\w* \w said|strong="H559"\w*, “\w Amen|strong="H543"\w*,” \w and they praised|strong="H1984"\w* \w -|strong="H853"\w* \w the LORD|strong="H3068"\w*. \w And the people|strong="H5971"\w* \w did|strong="H6213"\w* \w as they had promised|strong="H1697"\w*. \w . . .|strong="H2088"\w*
\s1 Nehemiah’s Generosity
\p \v 14 \w Furthermore|strong="H1571"\w*, \w from the day|strong="H3117"\w* \w -|strong="H834"\w* \w King|strong="H4428"\w* \w Artaxerxes|strong="H783"\w* \w appointed me|strong="H6680"\w* \w -|strong="H853"\w* \w to be|strong="H1961"\w* \w their governor|strong="H6346"\w* \w in the land|strong="H776"\w* \w of Judah|strong="H3063"\w*, \w from his twentieth|strong="H6242"\w* \w year|strong="H8141"\w* \w until|strong="H5704"\w* \w his thirty-second|strong="H7970"\w* \w . . .|strong="H8147"\w* \w year|strong="H8141"\w* (\w twelve|strong="H8147"\w* \w . . .|strong="H6240"\w* \w years total|strong="H8141"\w*), \w neither I|strong="H589"\w* \w nor my brothers|strong="H251"\w* \w . . .|strong="H3808"\w* \w ate|strong="H398"\w* \w the food|strong="H3899"\w* \w allotted to the governor|strong="H6346"\w*.
\p \v 15 \w The governors|strong="H6346"\w* \w . . .|strong="H7223"\w* \w -|strong="H834"\w* \w before me|strong="H6440"\w* \w had heavily burdened|strong="H3513"\w* \w . . .|strong="H5921"\w* \w the people|strong="H5971"\w*, \w taking|strong="H3947"\w* from them \w bread|strong="H3899"\w* \w and wine|strong="H3196"\w* \w plus|strong="H310"\w* \w forty|strong="H705"\w* \w shekels|strong="H8255"\w* \w of silver|strong="H3701"\w*.\f + \fr 5:15 \fqa 40 shekels \ft is approximately 1 pound or 453.6 grams of silver.\f* \w Their servants|strong="H5288"\w* \w also|strong="H1571"\w* \w oppressed|strong="H7980"\w* \w . . .|strong="H5921"\w* \w the people|strong="H5971"\w*. \w But I|strong="H589"\w* \w did not|strong="H3808"\w* \w do|strong="H6213"\w* \w this|strong="H3651"\w*, \w because|strong="H6440"\w* \w of my fear|strong="H3374"\w* \w of God|strong="H430"\w*. \v 16 \w Instead|strong="H1571"\w*, \w I devoted myself|strong="H2388"\w* \w to the construction|strong="H4399"\w* \w of the|strong="H2063"\w* \w wall|strong="H2346"\w*, \w and all|strong="H3605"\w* \w my servants|strong="H5288"\w* \w were gathered|strong="H6908"\w* \w there|strong="H8033"\w* \w for|strong="H5921"\w* \w the work|strong="H4399"\w*; \w we did not|strong="H3808"\w* \w acquire|strong="H7069"\w* \w any land|strong="H7704"\w*.
\p \v 17 \w There were 150|strong="H3967"\w* \w . . .|strong="H2572"\w* \w . . .|strong="H376"\w* \w Jews|strong="H3064"\w* \w and officials|strong="H5461"\w* \w -|strong="H834"\w* \w at|strong="H5921"\w* \w my table|strong="H7979"\w*, \w besides the guests|strong="H935"\w* \w . . .|strong="H413"\w* \w from|strong="H4480"\w* \w the surrounding|strong="H5439"\w* \w nations|strong="H1471"\w*. \v 18 \w -|strong="H834"\w* \w -|strong="H1961"\w*\w . . .|strong="H6213"\w* \w Each|strong="H259"\w* \w day|strong="H3117"\w* \w one|strong="H259"\w* \w ox|strong="H7794"\w*, \w six|strong="H8337"\w* \w choice|strong="H1305"\w* \w sheep|strong="H6629"\w*, \w and some fowl|strong="H6833"\w* \w were prepared|strong="H6213"\w* for me, \w and once every|strong="H996"\w* \w ten|strong="H6235"\w* \w days|strong="H3117"\w* \w an abundance|strong="H7235"\w* \w . . .|strong="H5973"\w*\w . . .|strong="H2088"\w* \w of all kinds|strong="H3605"\w* \w of wine [was provided]|strong="H3196"\w*. \w But I did not|strong="H3808"\w* \w demand|strong="H1245"\w* \w the food|strong="H3899"\w* \w allotted to the governor|strong="H6346"\w*, \w because|strong="H3588"\w* \w the burden|strong="H5656"\w* \w on|strong="H5921"\w* \w the people|strong="H5971"\w* \w . . .|strong="H2088"\w* \w was so heavy|strong="H3513"\w*.
\p \v 19 \w Remember|strong="H2142"\w* me \w favorably|strong="H2896"\w*, \w O my God|strong="H430"\w*, \w for all|strong="H3605"\w* \w that|strong="H834"\w* \w I have done|strong="H6213"\w* \w for|strong="H5921"\w* \w this|strong="H2088"\w* \w people|strong="H5971"\w*.
\c 6
\s1 Sanballat’s Conspiracy
\p \v 1 \w -|strong="H1961"\w* \w When|strong="H834"\w* \w Sanballat|strong="H5571"\w*, \w Tobiah|strong="H2900"\w*, \w Geshem|strong="H1654"\w* \w the Arab|strong="H6163"\w*, \w and the rest|strong="H3499"\w* \w of our enemies|strong="H341"\w* \w heard|strong="H8085"\w* \w that|strong="H3588"\w* \w I had rebuilt|strong="H1129"\w* \w -|strong="H853"\w* \w the wall|strong="H2346"\w* \w and not|strong="H3808"\w* \w a gap|strong="H6556"\w* \w was left|strong="H3498"\w*— \w though|strong="H1571"\w* \w to|strong="H5704"\w* \w that|strong="H1931"\w* \w time|strong="H6256"\w* \w I had not yet|strong="H3808"\w* \w installed|strong="H5975"\w* \w the doors|strong="H1817"\w* \w in the gates|strong="H8179"\w*— \v 2 \w Sanballat|strong="H5571"\w* \w and Geshem|strong="H1654"\w* \w . . .|strong="H413"\w* \w sent me|strong="H7971"\w* \w this message|strong="H559"\w*: “\w Come|strong="H1980"\w*, \w let us meet|strong="H3259"\w* \w together|strong="H3162"\w* \w in [one of] the villages|strong="H3715"\w*\f + \fr 6:2 \ft Or \fqa in Kephirim\f* \w on the plain|strong="H1237"\w*\f + \fr 6:2 \ft Or \fqa in the valley\f* \w of Ono|strong="H207"\w*.”
\p \w But they|strong="H1992"\w* \w were planning|strong="H2803"\w* \w to harm|strong="H6213"\w* \w . . .|strong="H7451"\w* me.
\p \v 3 \w So I sent|strong="H7971"\w* \w messengers|strong="H4397"\w* \w to them|strong="H5921"\w*, \w saying|strong="H559"\w*, “\w I|strong="H589"\w* \w am doing|strong="H6213"\w* \w a great|strong="H1419"\w* \w work|strong="H4399"\w* \w and cannot|strong="H3808"\w* \w . . .|strong="H3201"\w* \w come down|strong="H3381"\w*. \w Why|strong="H4100"\w* \w should the work|strong="H4399"\w* \w stop|strong="H7673"\w* \w while|strong="H834"\w* \w I leave it|strong="H7503"\w* \w to go down|strong="H3381"\w* \w to you|strong="H413"\w*?”
\p \v 4 \w Four|strong="H702"\w* \w times|strong="H6471"\w* \w they sent me|strong="H7971"\w* \w . . .|strong="H413"\w* \w the same|strong="H2088"\w* \w message|strong="H1697"\w*, \w and each time I gave|strong="H7725"\w* \w -|strong="H853"\w* \w the same|strong="H2088"\w* \w reply|strong="H1697"\w*.
\p \v 5 \w The fifth|strong="H2549"\w* \w -|strong="H853"\w* \w time|strong="H6471"\w*, \w Sanballat|strong="H5571"\w* \w sent me|strong="H7971"\w* \w . . .|strong="H413"\w* \w this|strong="H2088"\w* \w same message|strong="H1697"\w* \w by his young servant|strong="H5288"\w*, \w who had in his hand|strong="H3027"\w* \w an unsealed|strong="H6605"\w* \w letter|strong="H107"\w* \v 6 \w that read|strong="H3789"\w*:
\pmo “\w It is reported|strong="H8085"\w* \w among the nations|strong="H1471"\w*— \w and Geshem|strong="H1654"\w*\f + \fr 6:6 \ft Hebrew \fqa Gashmu\ft , a variant of \fqa Geshem\ft ; see verse 1.\f* \w agrees|strong="H559"\w*— \w that you|strong="H859"\w* \w and the Jews|strong="H3064"\w* \w are plotting|strong="H2803"\w* \w to revolt|strong="H4775"\w*, \w [and] this is why|strong="H5921"\w* \w . . .|strong="H3651"\w* \w you|strong="H859"\w* \w are building|strong="H1129"\w* \w the wall|strong="H2346"\w*. \w According to these|strong="H428"\w* \w reports|strong="H1697"\w*, \w you|strong="H859"\w* \w are to become|strong="H1933"\w* their \w king|strong="H4428"\w*, \v 7 \w and you have even|strong="H1571"\w* \w appointed|strong="H5975"\w* \w prophets|strong="H5030"\w* \w in Jerusalem|strong="H3389"\w* \w . . .|strong="H559"\w* \w to proclaim|strong="H7121"\w* \w on your behalf|strong="H5921"\w*: ‘\w There is a king|strong="H4428"\w* \w in Judah|strong="H3063"\w*.’ \w Soon|strong="H6258"\w* \w these|strong="H428"\w* \w rumors|strong="H1697"\w* \w will reach the ears|strong="H8085"\w* \w of the king|strong="H4428"\w*. \w So|strong="H6258"\w* \w come|strong="H1980"\w*, \w let us confer|strong="H3289"\w* \w together|strong="H3162"\w*.”
\p \v 8 \w Then I sent|strong="H7971"\w* \w him|strong="H413"\w* \w this reply|strong="H559"\w*: “\w There is|strong="H1961"\w* \w nothing|strong="H3808"\w* \w to these|strong="H428"\w* \w -|strong="H834"\w* \w rumors|strong="H1697"\w* \w you|strong="H859"\w* \w are spreading|strong="H559"\w*; \w . . .|strong="H3588"\w* \w you|strong="H859"\w* \w are inventing them|strong="H908"\w* \w in your own mind|strong="H3820"\w*.”
\p \v 9 \w For|strong="H3588"\w* \w they were all|strong="H3605"\w* \w [trying] to frighten|strong="H3372"\w* \w us|strong="H853"\w*, \w saying|strong="H559"\w*, “\w Their hands|strong="H3027"\w* \w will be weakened|strong="H7503"\w* \w in|strong="H4480"\w* \w the work|strong="H4399"\w*, \w and it will never|strong="H3808"\w* \w be finished|strong="H6213"\w*.”
\p \w But now, my God|strong="H6258"\w*,\f + \fr 6:9 \ft Hebrew \fqa But now\ft ; for clarity, \fqa my God \ft has been included.\f* \w strengthen|strong="H2388"\w* \w -|strong="H853"\w* \w my hands|strong="H3027"\w*.
\p \v 10 \w Later, I|strong="H589"\w* \w went|strong="H935"\w* \w to the house|strong="H1004"\w* \w of Shemaiah|strong="H8098"\w* \w son|strong="H1121"\w* \w of Delaiah|strong="H1806"\w*, \w the son|strong="H1121"\w* \w of Mehetabel|strong="H4105"\w*, \w who|strong="H1931"\w* \w was confined|strong="H6113"\w* \w to his house. He said|strong="H559"\w*:
\q1 “\w Let us meet|strong="H3259"\w* \w at|strong="H413"\w* \w the house|strong="H1004"\w* \w of God|strong="H430"\w*
\q2 \w inside|strong="H413"\w* \w . . .|strong="H8432"\w* \w the temple|strong="H1964"\w*.
\q1 \w Let us shut|strong="H5462"\w* \w the temple|strong="H1964"\w* \w doors|strong="H1817"\w*
\q2 \w because|strong="H3588"\w* \w they are coming|strong="H935"\w* \w to kill you|strong="H2026"\w* —
\q2 \w by night|strong="H3915"\w* \w they are coming|strong="H935"\w* \w to kill you|strong="H2026"\w*!”
\p \v 11 \w But I replied|strong="H559"\w*, “\w Should a man|strong="H376"\w* \w like me|strong="H3644"\w* \w run away|strong="H1272"\w*? \w Should|strong="H4310"\w* \w one like me|strong="H3644"\w* \w -|strong="H834"\w* \w go|strong="H935"\w* \w into|strong="H413"\w* \w the temple|strong="H1964"\w* \w to save his own life|strong="H2421"\w*? \w I will not|strong="H3808"\w* \w go|strong="H935"\w*!”
\p \v 12 \w I realized|strong="H5234"\w* \w . . .|strong="H2009"\w* \w that God|strong="H430"\w* \w had not|strong="H3808"\w* \w sent him|strong="H7971"\w*, \w but that he had uttered|strong="H1696"\w* \w [this] prophecy|strong="H5016"\w* \w against me|strong="H5921"\w* \w because|strong="H3588"\w* \w Tobiah|strong="H2900"\w* \w and Sanballat|strong="H5571"\w* \w had hired him|strong="H7936"\w*. \v 13 \w He|strong="H1931"\w* \w had been hired|strong="H7936"\w* \w to|strong="H4616"\w*\w . . .|strong="H4616"\w* \w intimidate me|strong="H3372"\w* \w so that I would sin|strong="H2398"\w* \w by doing|strong="H6213"\w* \w as he suggested|strong="H3651"\w*, \w so they could give me|strong="H1961"\w* . . . \w a bad|strong="H7451"\w* \w name|strong="H8034"\w* \w in order to|strong="H4616"\w* \w discredit me|strong="H2778"\w*.
\p \v 14 \w O my God|strong="H430"\w*, \w remember|strong="H2142"\w* \w Tobiah|strong="H2900"\w* \w and Sanballat|strong="H5571"\w* \w for what they have done|strong="H4639"\w*, \w . . .|strong="H428"\w* \w and also|strong="H1571"\w* \w Noadiah|strong="H5129"\w* \w the prophetess|strong="H5031"\w* \w and the other|strong="H3499"\w* \w prophets|strong="H5030"\w* \w who|strong="H834"\w* \w . . .|strong="H1961"\w* \w tried to intimidate me|strong="H3372"\w* \w -|strong="H853"\w*.
\s1 Completion of the Wall
\p \v 15 \w So the wall|strong="H2346"\w* \w was completed|strong="H7999"\w* \w in fifty-two|strong="H2572"\w* \w . . .|strong="H8147"\w* \w days|strong="H3117"\w*, \w on the twenty-fifth|strong="H6242"\w* \w . . .|strong="H2568"\w* \w of Elul|strong="H435"\w*.\f + \fr 6:15 \fqa Elul \ft is the sixth month of the Hebrew lunar calendar, usually occurring within the months of August and September.\f* \v 16 \w -|strong="H1961"\w* \w When|strong="H834"\w* \w all|strong="H3605"\w* \w our enemies|strong="H341"\w* \w . . .|strong="H3372"\w* \w heard about this|strong="H8085"\w*, \w all|strong="H3605"\w* \w the surrounding|strong="H5439"\w* \w nations|strong="H1471"\w* \w were afraid|strong="H834"\w* \w and disheartened|strong="H5307"\w* \w . . .|strong="H3966"\w*, \w vvv|strong="H5869"\w* \w for they realized|strong="H3045"\w* \w that|strong="H3588"\w* \w this|strong="H2063"\w* \w task|strong="H4399"\w* \w had been accomplished|strong="H6213"\w* \w by|strong="H854"\w* \w our God|strong="H430"\w*.
\p \v 17 \w Also|strong="H1571"\w* \w in those|strong="H1992"\w* \w days|strong="H3117"\w*, \w the nobles|strong="H2715"\w* \w of Judah|strong="H3063"\w* \w sent many|strong="H7235"\w* \w letters|strong="H107"\w* \w . . .|strong="H1980"\w* \w to|strong="H5921"\w* \w Tobiah|strong="H2900"\w*, \w and Tobiah’s|strong="H2900"\w* \w letters|strong="H834"\w* \w kept coming|strong="H935"\w* \w to them|strong="H413"\w*. \v 18 \w For|strong="H3588"\w* \w many|strong="H7227"\w* \w in Judah|strong="H3063"\w* \w were bound|strong="H1167"\w* \w by oath|strong="H7621"\w* to him, \w since|strong="H3588"\w* \w he|strong="H1931"\w* \w was a son-in-law|strong="H2860"\w* \w of Shecaniah|strong="H7935"\w* \w son|strong="H1121"\w* \w of Arah|strong="H733"\w*, \w and his son|strong="H1121"\w* \w Jehohanan|strong="H3076"\w* \w had married|strong="H3947"\w* \w -|strong="H853"\w* \w the daughter|strong="H1323"\w* \w of Meshullam|strong="H4918"\w* \w son|strong="H1121"\w* \w of Berechiah|strong="H1296"\w*.
\p \v 19 \w Moreover|strong="H1571"\w*, \w these nobles kept|strong="H1961"\w* \w reporting|strong="H559"\w* \w to me|strong="H6440"\w* \w Tobiah’s good deeds|strong="H2896"\w*, \w and they relayed|strong="H3318"\w* \w my words|strong="H1697"\w* to him. \w . . .|strong="H1961"\w* \w And Tobiah|strong="H2900"\w* \w sent|strong="H7971"\w* \w letters|strong="H107"\w* \w to intimidate me|strong="H3372"\w*.
\c 7
\s1 Securing the City
\p \v 1 \w -|strong="H1961"\w* \w When|strong="H834"\w* \w the wall|strong="H2346"\w* \w had been rebuilt|strong="H1129"\w* \w and I had set the doors|strong="H1817"\w* \w in place|strong="H5975"\w*, \w the gatekeepers|strong="H7778"\w*, \w singers|strong="H7891"\w*, \w and Levites|strong="H3881"\w* \w were appointed|strong="H6485"\w*.
\p \v 2 \w Then I put my brother|strong="H251"\w* \w -|strong="H853"\w* \w Hanani|strong="H2607"\w* \w in charge|strong="H6680"\w* \w -|strong="H853"\w* \w of|strong="H5921"\w* \w Jerusalem|strong="H3389"\w*, \w along with Hananiah|strong="H2608"\w* \w the commander|strong="H8269"\w* \w of the fortress|strong="H1002"\w*, \w because|strong="H3588"\w* \w he|strong="H1931"\w* \w was a faithful|strong="H571"\w* \w man|strong="H376"\w* \w who feared|strong="H3372"\w* \w -|strong="H853"\w* \w God|strong="H430"\w* \w more than most|strong="H7227"\w*. \v 3 \w And I told|strong="H559"\w* them, “\w Do not|strong="H3808"\w* \w open|strong="H6605"\w* \w the gates|strong="H8179"\w* \w of Jerusalem|strong="H3389"\w* \w until|strong="H5704"\w* \w the sun|strong="H8121"\w* \w is hot|strong="H2552"\w*. \w While|strong="H5704"\w* \w the guards|strong="H1992"\w* \w are on duty|strong="H5975"\w*, \w keep the doors|strong="H1817"\w* \w shut|strong="H1479"\w* \w and securely fastened|strong="H270"\w*. \w And appoint|strong="H5975"\w* \w the residents|strong="H3427"\w* \w of Jerusalem|strong="H3389"\w* \w as guards|strong="H4931"\w*, \w some|strong="H376"\w* \w at their posts|strong="H4929"\w* \w and some|strong="H376"\w* \w at|strong="H5048"\w* \w their own homes|strong="H1004"\w*.”
\s1 The List of Returning Exiles
\r (\ref Ezra 2:1–67|EZR 2:1-67\ref*)
\p \v 4 \w Now the city|strong="H5892"\w* \w was large|strong="H1419"\w* \w and spacious|strong="H7342"\w* \w . . .|strong="H3027"\w*, \w but there were few|strong="H4592"\w* \w people|strong="H5971"\w* \w in it|strong="H8432"\w*, \w and the houses|strong="H1004"\w* \w had not yet|strong="H369"\w* \w been rebuilt|strong="H1129"\w*. \v 5 \w Then my God|strong="H430"\w* \w put it|strong="H5414"\w* \w into|strong="H413"\w* \w my heart|strong="H3820"\w* \w to assemble|strong="H6908"\w* \w -|strong="H853"\w* \w the nobles|strong="H2715"\w*, \w -|strong="H853"\w* \w the officials|strong="H5461"\w*, \w -|strong="H853"\w* \w and the people|strong="H5971"\w* \w to be enrolled by genealogy|strong="H3187"\w*. \w I found|strong="H4672"\w* \w the genealogical|strong="H3188"\w* \w register|strong="H5612"\w* \w of those who had first returned|strong="H5927"\w* \w . . .|strong="H7223"\w*, \w and I found|strong="H4672"\w* \w the following written|strong="H3789"\w* in it:
\p \v 6 \w These|strong="H428"\w* \w are the people|strong="H1121"\w* \w of the province|strong="H4082"\w* \w who came up|strong="H5927"\w* \w from the captivity|strong="H7628"\w* \w of the exiles|strong="H1473"\w* \w -|strong="H834"\w* \w carried away|strong="H1540"\w* \w to Babylon|strong="H894"\w* \w by Nebuchadnezzar|strong="H5019"\w* \w [its] king|strong="H4428"\w*. \w They returned|strong="H7725"\w* \w to Jerusalem|strong="H3389"\w* \w and Judah|strong="H3063"\w*, \w each|strong="H376"\w* \w to his own town|strong="H5892"\w*, \v 7 \w accompanied|strong="H935"\w* \w by|strong="H5973"\w* \w Zerubbabel|strong="H2216"\w*, \w Jeshua|strong="H3442"\w*, \w Nehemiah|strong="H5166"\w*, \w Azariah|strong="H5838"\w*, \w Raamiah|strong="H7485"\w*, \w Nahamani|strong="H5167"\w*, \w Mordecai|strong="H4782"\w*, \w Bilshan|strong="H1114"\w*, \w Mispereth|strong="H4559"\w*, \w Bigvai|strong="H902"\w*, \w Nehum|strong="H5149"\w*, \w and Baanah|strong="H1196"\w*.\f + \fr 7:7 \ft Parallel text at \ref Ezra 2:2|EZR 2:2\ref* \fqa accompanied by Zerubbabel, Jeshua, Nehemiah, Seraiah, Reelaiah, Mordecai, Bilshan, Mispar, Bigvai, Rehum, and Baanah\f*
\p \w [This is] the count|strong="H4557"\w* \w of the men|strong="H582"\w* \w . . .|strong="H5971"\w* \w of Israel|strong="H3478"\w*:
\li1 \v 8 \w the descendants|strong="H1121"\w* \w of Parosh|strong="H6551"\w*, \w 2,172|strong="H505"\w* \w . . .|strong="H3967"\w* \w . . .|strong="H7657"\w* \w . . .|strong="H8147"\w*;
\li1 \v 9 \w the descendants|strong="H1121"\w* \w of Shephatiah|strong="H8203"\w*, \w 372|strong="H7969"\w* \w . . .|strong="H3967"\w* \w . . .|strong="H7657"\w* \w . . .|strong="H8147"\w*;
\li1 \v 10 \w the descendants|strong="H1121"\w* \w of Arah|strong="H733"\w*, \w 652|strong="H8337"\w* \w . . .|strong="H3967"\w* \w . . .|strong="H2572"\w* \w . . .|strong="H8147"\w*;
\li1 \v 11 \w the descendants|strong="H1121"\w* \w vvv|strong="H6355"\w* \w of Pahath-moab|strong="H6355"\w* (\w through the line|strong="H1121"\w* \w of Jeshua|strong="H3442"\w* \w and Joab|strong="H3097"\w*), \w 2,818|strong="H505"\w* \w . . .|strong="H8083"\w* \w . . .|strong="H3967"\w* \w . . .|strong="H8083"\w* \w . . .|strong="H6240"\w*;
\li1 \v 12 \w the descendants|strong="H1121"\w* \w of Elam|strong="H5867"\w*, \w 1,254|strong="H505"\w* \w . . .|strong="H3967"\w* \w . . .|strong="H2572"\w* \w . . .|strong="H702"\w*;
\li1 \v 13 \w the descendants|strong="H1121"\w* \w of Zattu|strong="H2240"\w*, \w 845|strong="H8083"\w* \w . . .|strong="H3967"\w* \w . . .|strong="H705"\w* \w . . .|strong="H2568"\w*;
\li1 \v 14 \w the descendants|strong="H1121"\w* \w of Zaccai|strong="H2140"\w*, \w 760|strong="H7651"\w* \w . . .|strong="H3967"\w* \w . . .|strong="H8346"\w*;
