\p \v 23 \w As for the descendants|strong="H1121"\w* \w of Levi|strong="H3878"\w*, \w the family|strong="H1"\w* \w heads|strong="H7218"\w* \w up to|strong="H5704"\w* \w the days|strong="H3117"\w* \w of Johanan|strong="H3110"\w* \w son|strong="H1121"\w* \w of Eliashib|strong="H475"\w* \w were recorded|strong="H3789"\w* \w in|strong="H5921"\w* \w the Book|strong="H5612"\w* \w of the Chronicles|strong="H1697"\w* \w . . .|strong="H3117"\w*.\f + \fr 12:23 \ft Or \fqa the Book of the Annals \ft or \fqa the Book of the Historical Events\f* \v 24 \w The leaders|strong="H7218"\w* \w of the Levites|strong="H3881"\w* \w [were] Hashabiah|strong="H2811"\w*, \w Sherebiah|strong="H8274"\w*, \w and Jeshua|strong="H3442"\w* \w son|strong="H1121"\w* \w of Kadmiel|strong="H6934"\w*,\f + \fr 12:24 \ft Or \fqa Sherebiah, Jeshua, Binnui, and Kadmiel\f* \w along with their associates|strong="H251"\w*, \w [who stood] across from them|strong="H5048"\w* \w to give praise|strong="H1984"\w* \w and thanksgiving|strong="H3034"\w* \w as one section|strong="H4929"\w* \w alternated with|strong="H5980"\w* \w the other|strong="H4929"\w*, \w as prescribed|strong="H4687"\w* \w by David|strong="H1732"\w* \w the man|strong="H376"\w* \w of God|strong="H430"\w*.
\p \v 25 \w Mattaniah|strong="H4983"\w*, \w Bakbukiah|strong="H1229"\w*, \w Obadiah|strong="H5662"\w*, \w Meshullam|strong="H4918"\w*, \w Talmon|strong="H2929"\w*, \w [and] Akkub|strong="H6126"\w* \w [were] gatekeepers|strong="H7778"\w* \w who guarded|strong="H8104"\w* \w . . .|strong="H4929"\w* \w the storerooms|strong="H624"\w* \w at the gates|strong="H8179"\w*. \v 26 \w They [served]|strong="H428"\w* \w in the days|strong="H3117"\w* \w of Joiakim|strong="H3113"\w* \w son|strong="H1121"\w* \w of Jeshua|strong="H3442"\w*, \w the son|strong="H1121"\w* \w of Jozadak|strong="H3136"\w*,\f + \fr 12:26 \fqa Jozadak \ft is a variant of \fqa Jehozadak\ft ; see \ref 1 Chronicles 6:14|1CH 6:14\ref*.\f* \w and in the days|strong="H3117"\w* \w of Nehemiah|strong="H5166"\w* \w the governor|strong="H6346"\w* \w and Ezra|strong="H5830"\w* \w the priest|strong="H3548"\w* \w and scribe|strong="H5608"\w*.
\s1 The Dedication of the Wall
\p \v 27 \w At the dedication|strong="H2598"\w* \w of the wall|strong="H2346"\w* \w of Jerusalem|strong="H3389"\w*, \w the Levites|strong="H3881"\w* \w were sought out|strong="H1245"\w* \w -|strong="H853"\w* \w from all|strong="H3605"\w* \w their homes|strong="H4725"\w* \w and brought|strong="H935"\w* \w to Jerusalem|strong="H3389"\w* \w to celebrate|strong="H6213"\w* \w the joyous|strong="H8057"\w* \w dedication|strong="H2598"\w* \w with thanksgiving|strong="H8426"\w* \w and singing|strong="H7892"\w*, \w accompanied by cymbals|strong="H4700"\w*, \w harps|strong="H5035"\w*, \w and lyres|strong="H3658"\w*. \v 28 \w vvv|strong="H1121"\w* \w The singers were also|strong="H7891"\w* \w assembled|strong="H622"\w* \w from|strong="H4480"\w* \w the region|strong="H3603"\w* \w around|strong="H5439"\w* \w Jerusalem|strong="H3389"\w*, \w from|strong="H4480"\w* \w the villages|strong="H2691"\w* \w of the Netophathites|strong="H5200"\w*, \v 29 \w from Beth-gilgal|strong="H1019"\w* \w . . .|strong="H1019"\w*, \w and from the fields|strong="H7704"\w* \w of Geba|strong="H1387"\w* \w and Azmaveth|strong="H5820"\w*, \w for|strong="H3588"\w* \w [they]|strong="H7891"\w* \w had built|strong="H1129"\w* \w villages|strong="H2691"\w* for themselves \w around|strong="H5439"\w* \w Jerusalem|strong="H3389"\w*. \v 30 \w After the priests|strong="H3548"\w* \w and Levites|strong="H3881"\w* \w had purified themselves|strong="H2891"\w*, \w they purified|strong="H2891"\w* \w -|strong="H853"\w* \w the people|strong="H5971"\w*, \w -|strong="H853"\w* \w the gates|strong="H8179"\w*, \w -|strong="H853"\w* \w and the wall|strong="H2346"\w*.
\p \v 31 \w Then I brought the leaders|strong="H8269"\w* \w of Judah|strong="H3063"\w* \w up|strong="H5927"\w* \w -|strong="H853"\w* \w on|strong="H5921"\w* \w the wall|strong="H2346"\w*, \w and I appointed|strong="H5975"\w* \w two|strong="H8147"\w* \w great|strong="H1419"\w* \w thanksgiving [choirs]|strong="H8426"\w*. \w One was to proceed|strong="H8418"\w* \w along the top|strong="H5921"\w* \w of the wall|strong="H2346"\w*\f + \fr 12:31 \ft Or \fqa alongside the wall\ft ; also in verse 38\f* \w to the right|strong="H3225"\w*, \w toward the Dung|strong="H830"\w* \w Gate|strong="H8179"\w*. \v 32 \w Hoshaiah|strong="H1955"\w* \w and half|strong="H2677"\w* \w the leaders|strong="H8269"\w* \w of Judah|strong="H3063"\w* \w followed|strong="H1980"\w* \w . . .|strong="H310"\w*, \v 33 \w along with Azariah|strong="H5838"\w*, \w Ezra|strong="H5830"\w*, \w Meshullam|strong="H4918"\w*, \v 34 \w Judah|strong="H3063"\w*, \w Benjamin|strong="H1144"\w*, \w Shemaiah|strong="H8098"\w*, \w Jeremiah|strong="H3414"\w*, \v 35 \w and some of the priests|strong="H3548"\w* \w . . .|strong="H1121"\w* \w with trumpets|strong="H2689"\w*, \w and also Zechariah|strong="H2148"\w* \w son|strong="H1121"\w* \w of Jonathan|strong="H3129"\w*, \w the son|strong="H1121"\w* \w of Shemaiah|strong="H8098"\w*, \w the son|strong="H1121"\w* \w of Mattaniah|strong="H4983"\w*, \w the son|strong="H1121"\w* \w of Micaiah|strong="H4320"\w*,\f + \fr 12:35 \fqa Micaiah \ft is a variant of \fqa Mica\ft ; see \ref Nehemiah 11:22|NEH 11:22\ref*.\f* \w the son|strong="H1121"\w* \w of Zaccur|strong="H2139"\w*, \w the son|strong="H1121"\w* \w of Asaph|strong="H623"\w*, \v 36 \w and his associates|strong="H251"\w*— \w Shemaiah|strong="H8098"\w*, \w Azarel|strong="H5832"\w*, \w Milalai|strong="H4450"\w*, \w Gilalai|strong="H1562"\w*, \w Maai|strong="H4597"\w*, \w Nethanel|strong="H5417"\w*, \w Judah|strong="H3063"\w*, \w and Hanani|strong="H2607"\w*— \w with the musical|strong="H7892"\w* \w instruments|strong="H3627"\w* \