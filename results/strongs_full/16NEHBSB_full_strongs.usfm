\p \v 5 \w Ezra|strong="H5830"\w* \w opened|strong="H6605"\w* \w the book|strong="H5612"\w* \w in full view|strong="H5869"\w* \w of all|strong="H3605"\w* \w the people|strong="H5971"\w*, \w since|strong="H3588"\w* \w he was|strong="H1961"\w* \w standing above them|strong="H5921"\w* \w all|strong="H3605"\w* \w . . .|strong="H5971"\w*, \w and as he opened it|strong="H6605"\w*, \w all|strong="H3605"\w* \w the people|strong="H5971"\w* \w stood up|strong="H5975"\w*. \v 6 \w Then Ezra|strong="H5830"\w*\w . . .|strong="H853"\w* \w blessed|strong="H1288"\w* \w the LORD|strong="H3068"\w*, \w the great|strong="H1419"\w* \w God|strong="H430"\w*, \w and with their hands|strong="H3027"\w* \w uplifted|strong="H4607"\w*, \w all|strong="H3605"\w* \w the people|strong="H5971"\w* \w said|strong="H6030"\w*, “\w Amen|strong="H543"\w*, \w Amen|strong="H543"\w*!” \w Then they bowed down|strong="H6915"\w* \w and worshiped|strong="H7812"\w* \w the LORD|strong="H3068"\w* \w with their faces|strong="H639"\w* \w to the ground|strong="H776"\w*.
