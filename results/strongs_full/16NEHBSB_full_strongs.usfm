\p \v 38 \w The second|strong="H8145"\w* \w thanksgiving [choir]|strong="H8426"\w* \w proceeded|strong="H1980"\w* \w to the left|strong="H4136"\w*, \w and I|strong="H589"\w* \w followed|strong="H310"\w* \w it with half|strong="H2677"\w* \w the people|strong="H5971"\w* \w along the top|strong="H5921"\w* \w of the wall|strong="H2346"\w*, \w past|strong="H5921"\w* \w the Tower|strong="H4026"\w* \w of the Ovens|strong="H8574"\w* \w to|strong="H5704"\w* \w the Broad|strong="H7342"\w* \w Wall|strong="H2346"\w*, \v 39 \w over|strong="H5921"\w* \w the Gate|strong="H8179"\w* \w of Ephraim|strong="H669"\w*, \w -|strong="H5921"\w* \w the Jeshanah|strong="H3466"\w* \w Gate|strong="H8179"\w*,\f + \fr 12:39 \ft Or \fqa the Old City Gate\f* \w . . .|strong="H5921"\w* \w the Fish|strong="H1709"\w* \w Gate|strong="H8179"\w*, \w the Tower|strong="H4026"\w* \w of Hananel|strong="H2606"\w*, \w and the Tower|strong="H4026"\w* \w of the Hundred|strong="H3968"\w*, \w as far|strong="H5704"\w* \w as the Sheep|strong="H6629"\w* \w Gate|strong="H8179"\w*. \w And they stopped|strong="H5975"\w* \w at the Gate|strong="H8179"\w* \w of the Guard|strong="H4307"\w*.
