\p \v 66 \w The whole|strong="H3605"\w* \w assembly|strong="H6951"\w* \w [numbered]|strong="H259"\w* \w 42,360 {}|strong="H702"\w* \w . . .|strong="H7239"\w* \w . . .|strong="H505"\w* \w . . .|strong="H7969"\w* \w . . .|strong="H3967"\w* \w . . .|strong="H8346"\w*, \v 67 \w in addition to|strong="H905"\w* their \w 7,337|strong="H7651"\w* \w . . .|strong="H505"\w* \w . . .|strong="H7969"\w* \w . . .|strong="H3967"\w* \w . . .|strong="H7970"\w* \w . . .|strong="H7651"\w* \w menservants|strong="H5650"\w* \w and maidservants|strong="H519"\w*, \w . . .|strong="H428"\w* \w as well as their 245|strong="H3967"\w* \w . . .|strong="H705"\w* \w . . .|strong="H2568"\w* \w male and female singers|strong="H7891"\w* \w . . .|strong="H7891"\w*. \v 68 [ They had 736 horses, 245 mules, ]\f + \fr 7:68 \ft Some Hebrew manuscripts (see also \ref Ezra 2:66|EZR 2:66\ref*); most Hebrew manuscripts do not include this verse.\f* \v 69 \w 435|strong="H702"\w* \w . . .|strong="H3967"\w* \w . . .|strong="H7970"\w* \w . . .|strong="H2568"\w* \w camels|strong="H1581"\w*, \w and 6,720|strong="H8337"\w* \w . . .|strong="H505"\w* \w . . .|strong="H7651"\w* \w . . .|strong="H3967"\w* \w . . .|strong="H6242"\w* \w donkeys|strong="H2543"\w*.
\s1 Offerings by the Exiles
\r (\ref Exodus 38:21–31|EXO 38:21-31\ref*; \ref Ezra 2:68–70|EZR 2:68-70\ref*)
\p \v 70 \w Some of|strong="H7117"\w* \w the heads|strong="H7218"\w* \w of the families|strong="H1"\w* \w contributed|strong="H5414"\w* \w to the project|strong="H4399"\w*. \w The governor|strong="H8660"\w* \w gave|strong="H5414"\w* \w to the treasury|strong="H214"\w* \w 1,000 {}|strong="H505"\w* \w darics|strong="H1871"\w* \w of gold|strong="H2091"\w*,\f + \fr 7:70 \ft Or \fqa 1,000 gold drachmas\ft ; that is, approximately 18.5 pounds or 8.4 kilograms of gold coins\f* \w 50|strong="H2572"\w* \w bowls|strong="H4219"\w*, \w and 530|strong="H7970"\w* \w . . .|strong="H2568"\w* \w . . .|strong="H3967"\w* \w priestly|strong="H3548"\w* \w garments|strong="H3801"\w*. \v 71 \w And some of the heads|strong="H7218"\w* \w of the families|strong="H1"\w* \w gave|strong="H5414"\w* \w to the treasury|strong="H214"\w* \w for the project|strong="H4399"\w* \w 20,000 {}|strong="H8147"\w* \w . . .|strong="H7239"\w* \w darics|strong="H1871"\w* \w of gold|strong="H2091"\w*\f + \fr 7:71 \ft Or \fqa 20,000 gold drachmas\ft ; that is, approximately 370.4 pounds or 168 kilograms of gold coins; also in verse 72 \f* \w and 2,200|strong="H505"\w* \w . . .|strong="H3967"\w* \w minas|strong="H4488"\w* \w of silver|strong="H3701"\w*.\f + \fr 7:71 \ft Or \fqa 2,200 silver minas\ft ; that is, approximately 1.38 tons or 1.25 metric tons of silver\f* \v 72 \w -|strong="H834"\w* \w The rest|strong="H7611"\w* \w of the people|strong="H5971"\w* \w gave [a total of]|strong="H5414"\w* \w 20,000 {}|strong="H8147"\w* \w . . .|strong="H7239"\w* \w darics|strong="H1871"\w* \w of gold|strong="H2091"\w*, \w 2,000 {}|strong="H505"\w* \w minas|strong="H4488"\w* \w of silver|strong="H3701"\w*,\f + \fr 7:72 \ft Or \fqa 2,000 silver minas\ft ; that is, approximately 1.26 tons or 1.14 metric tons of silver\f* \w and 67|strong="H8346"\w* \w . . .|strong="H7651"\w* \w priestly|strong="H3548"\w* \w garments|strong="H3801"\w*.
\p \v 73 \w So the priests|strong="H3548"\w*, \w Levites|strong="H3881"\w*, \w gatekeepers|strong="H7778"\w*, \w singers|strong="H7891"\w*, \w and temple servants|strong="H5411"\w*, \w along with some|strong="H4480"\w* \w of the people|strong="H5971"\w* \w and the rest of|strong="H3605"\w* \w the Israelites|strong="H3478"\w*, \w settled|strong="H3427"\w* \w in their own towns|strong="H5892"\w*. \w And by the seventh|strong="H7637"\w* \w month|strong="H2320"\w* \w -|strong="H5060"\w* \w the Israelites|strong="H1121"\w* \w . . .|strong="H3478"\w* \w had settled in their towns|strong="H5892"\w*.
