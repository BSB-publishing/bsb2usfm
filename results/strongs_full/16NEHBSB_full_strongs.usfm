\p \v 43 \w On that|strong="H1931"\w* \w day|strong="H3117"\w* \w they offered|strong="H2076"\w* \w great|strong="H1419"\w* \w sacrifices|strong="H2077"\w*, \w rejoicing|strong="H8055"\w* \w because|strong="H3588"\w* \w God|strong="H430"\w* \w had given them great|strong="H1419"\w* \w joy|strong="H8055"\w* \w . . .|strong="H8057"\w*. \w The women|strong="H802"\w* \w and children|strong="H3206"\w* \w also|strong="H1571"\w* \w rejoiced|strong="H8055"\w*, \w so that the joy|strong="H8057"\w* \w of Jerusalem|strong="H3389"\w* \w was heard|strong="H8085"\w* \w from afar|strong="H7350"\w*.
\s1 Provisions for Temple Worship
\p \v 44 \w And on that same|strong="H1931"\w* \w day|strong="H3117"\w* \w men|strong="H582"\w* \w were appointed|strong="H6485"\w* \w over|strong="H5921"\w* \w the rooms|strong="H5393"\w* \w that housed the supplies|strong="H214"\w*, \w contributions|strong="H8641"\w*, \w firstfruits|strong="H7225"\w*, \w and tithes|strong="H4643"\w*. \w The portions [specified] by|strong="H4521"\w* \w the Law|strong="H8451"\w* \w for the priests|strong="H3548"\w* \w and Levites|strong="H3881"\w* \w were gathered|strong="H3664"\w* into [these storerooms] \w from the fields|strong="H7704"\w* \w of the villages|strong="H5892"\w*, \w because|strong="H3588"\w* \w Judah|strong="H3063"\w* \w rejoiced|strong="H8057"\w* \w over|strong="H5921"\w* \w the priests|strong="H3548"\w* \w . . .|strong="H5921"\w* \w and Levites|strong="H3881"\w* \w who were serving|strong="H5975"\w*.
\p \v 45 \w They performed|strong="H8104"\w* \w the service|strong="H4931"\w* \w of their God|strong="H430"\w* \w and the service|strong="H4931"\w* \w of purification|strong="H2893"\w*, \w along with the singers|strong="H7891"\w* \w and gatekeepers|strong="H7778"\w*, \w as David|strong="H1732"\w* \w and his son|strong="H1121"\w* \w Solomon|strong="H8010"\w* \w had prescribed|strong="H4687"\w*. \v 46 \w For|strong="H3588"\w* \w long ago|strong="H6924"\w*, \w in the days|strong="H3117"\w* \w of David|strong="H1732"\w* \w and Asaph|strong="H623"\w*, \w there were directors|strong="H7218"\w* \w for the singers|strong="H7891"\w* \w and for the songs|strong="H7892"\w* \w of praise|strong="H8416"\w* \w and thanksgiving|strong="H3034"\w* \w to God|strong="H430"\w*.
