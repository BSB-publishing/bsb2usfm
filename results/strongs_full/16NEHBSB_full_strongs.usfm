\p \v 8 \w The Levites [were]|strong="H3881"\w* \w Jeshua|strong="H3442"\w*, \w Binnui|strong="H1131"\w*, \w Kadmiel|strong="H6934"\w*, \w Sherebiah|strong="H8274"\w*, \w Judah|strong="H3063"\w*, \w and Mattaniah|strong="H4983"\w*, \w who|strong="H1931"\w*, \w with his associates|strong="H251"\w*, \w led|strong="H5921"\w* \w the songs of thanksgiving|strong="H1960"\w*. \v 9 \w Bakbukiah|strong="H1229"\w* \w and Unni|strong="H6042"\w*, \w their associates|strong="H251"\w*, \w [stood] across from them|strong="H5048"\w* \w in the services|strong="H4931"\w*.
