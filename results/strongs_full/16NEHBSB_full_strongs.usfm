\p \v 1 \w At that time all|strong="H3605"\w* \w the people|strong="H5971"\w* \w gathered|strong="H622"\w* \w together|strong="H376"\w* \w . . .|strong="H259"\w* \w in|strong="H413"\w* \w the square|strong="H7339"\w* \w -|strong="H834"\w* \w before|strong="H6440"\w* \w the Water|strong="H4325"\w* \w Gate|strong="H8179"\w*, \w and they asked|strong="H559"\w* \w Ezra|strong="H5830"\w* \w the scribe|strong="H5608"\w* \w to bring out|strong="H935"\w* \w -|strong="H853"\w* \w the Book|strong="H5612"\w* \w of the Law|strong="H8451"\w* \w of Moses|strong="H4872"\w*, \w which|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w for|strong="H853"\w* \w Israel|strong="H3478"\w*.
