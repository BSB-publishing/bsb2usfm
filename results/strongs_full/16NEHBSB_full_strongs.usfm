\s1 The Vows of the Covenant
\p \v 28 “\w The rest|strong="H7605"\w* \w of the people|strong="H5971"\w*— \w the priests|strong="H3548"\w*, \w Levites|strong="H3881"\w*, \w gatekeepers|strong="H7778"\w*, \w singers|strong="H7891"\w*, \w temple servants|strong="H5411"\w*,\f + \fr 10:28 \ft Hebrew \fqa Nethinim\f* \w and all|strong="H3605"\w* \w who had separated themselves|strong="H914"\w* \w from the people|strong="H5971"\w* \w of the land|strong="H776"\w* \w to|strong="H413"\w* \w obey the Law|strong="H8451"\w* \w of God|strong="H430"\w*— \w along with their wives|strong="H802"\w* \w and all|strong="H3605"\w* \w their sons|strong="H1121"\w* \w and daughters|strong="H1323"\w* \w vvv|strong="H3045"\w* \w who are able to understand|strong="H995"\w*, \v 29 \w hereby join|strong="H2388"\w* \w with|strong="H5921"\w* \w their noble|strong="H117"\w* \w brothers|strong="H251"\w* \w and commit|strong="H935"\w* \w themselves with a sworn|strong="H7621"\w* \w oath|strong="H423"\w* \w to follow|strong="H1980"\w* \w the Law|strong="H8451"\w* \w of God|strong="H430"\w* \w -|strong="H834"\w* \w given|strong="H5414"\w* \w through|strong="H3027"\w* \w [His]|strong="H430"\w* \w servant|strong="H5650"\w* \w Moses|strong="H4872"\w* \w and to obey|strong="H6213"\w* \w carefully|strong="H8104"\w* \w -|strong="H853"\w* \w all|strong="H3605"\w* \w the commandments|strong="H4687"\w*, \w ordinances|strong="H4941"\w*, \w and statutes|strong="H2706"\w* \w of the LORD|strong="H3068"\w* \w our Lord|strong="H113"\w*.
\p \v 30 \w -|strong="H834"\w* \w We will not|strong="H3808"\w* \w give|strong="H5414"\w* \w our daughters {in marriage}|strong="H1323"\w* \w to the people|strong="H5971"\w* \w of the land|strong="H776"\w*, \w -|strong="H853"\w* \w and we will not|strong="H3808"\w* \w take|strong="H3947"\w* \w their daughters|strong="H1323"\w* \w for our sons|strong="H1121"\w*.
\p \v 31 \w When the people|strong="H5971"\w* \w of the land|strong="H776"\w* \w bring|strong="H935"\w* \w -|strong="H853"\w* \w merchandise|strong="H4728"\w* \w or any|strong="H3605"\w* \w kind of grain|strong="H7668"\w* \w to sell|strong="H4376"\w* \w on the Sabbath|strong="H7676"\w* \w day|strong="H3117"\w*, \w we will not|strong="H3808"\w* \w buy|strong="H3947"\w* from them \w on a Sabbath|strong="H7676"\w* \w or holy|strong="H6944"\w* \w day|strong="H3117"\w*. \w Every seventh|strong="H7637"\w* \w year|strong="H8141"\w* \w we will let the fields lie fallow|strong="H5203"\w* \w -|strong="H853"\w* \w and will cancel every|strong="H3605"\w* \w . . .|strong="H3027"\w* \w debt|strong="H4855"\w*.
\p \v 32 \w We also place|strong="H5975"\w* \w ourselves|strong="H5921"\w* \w under|strong="H5921"\w* \w the obligation|strong="H4687"\w* \w to contribute|strong="H5414"\w* \w a third|strong="H7992"\w* \w of a shekel|strong="H8255"\w*\f + \fr 10:32 \fqa A third of a shekel \ft is approximately 0.13 ounces or 3.8 grams, probably of silver.\f* \w yearly|strong="H8141"\w* \w for the service|strong="H5656"\w* \w of the house|strong="H1004"\w* \w of our God|strong="H430"\w*: \v 33 \w for the showbread|strong="H3899"\w* \w . . .|strong="H4635"\w*, \w for the regular|strong="H8548"\w* \w grain offerings|strong="H4503"\w* \w -|strong="H8548"\w* \w and burnt offerings|strong="H5930"\w*, \w for the Sabbath offerings|strong="H7676"\w*, \w for the New Moons|strong="H2320"\w* \w and appointed feasts|strong="H4150"\w*, \w for the holy offerings|strong="H6944"\w*, \w for the sin offerings|strong="H2403"\w* \w to make atonement|strong="H3722"\w* \w for|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w and for all|strong="H3605"\w* \w the duties|strong="H4399"\w* \w of the house|strong="H1004"\w* \w of our God|strong="H430"\w*.
\p \v 34 \w We have cast|strong="H5307"\w* \w lots|strong="H1486"\w* \w among the priests|strong="H3548"\w*, \w Levites|strong="H3881"\w*, \w and people|strong="H5971"\w* \w for|strong="H5921"\w* \w the donation|strong="H7133"\w* \w of wood|strong="H6086"\w* \w by our families|strong="H1004"\w* \w . . .|strong="H1"\w* \w at the appointed|strong="H2163"\w* \w times|strong="H6256"\w* \w each year|strong="H8141"\w* \w . . .|strong="H8141"\w*. \w They are to bring it|strong="H935"\w* \w to the house|strong="H1004"\w* \w of our God|strong="H430"\w* \w to burn|strong="H1197"\w* \w on|strong="H5921"\w* \w the altar|strong="H4196"\w* \w of the LORD|strong="H3068"\w* \w our God|strong="H430"\w*, \w as it is written|strong="H3789"\w* \w in the Law|strong="H8451"\w*.
\p \v 35 \w We will also bring|strong="H935"\w* \w -|strong="H853"\w* \w the firstfruits|strong="H1061"\w* \w of our land|strong="H127"\w* \w . . .|strong="H1061"\w* \w and of every|strong="H3605"\w* \w fruit|strong="H6529"\w* \w . . .|strong="H3605"\w* \w tree|strong="H6086"\w* \w to the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w* \w year|strong="H8141"\w* \w by year|strong="H8141"\w*. \v 36 \w And|strong="H853"\w* \w we will bring|strong="H935"\w* \w the firstborn|strong="H1060"\w* \w of our sons|strong="H1121"\w* \w and our livestock|strong="H929"\w*, \w as [it is] written|strong="H3789"\w* \w in the Law|strong="H8451"\w*, \w and|strong="H853"\w* \w [will bring] the firstborn|strong="H1060"\w* \w of our herds|strong="H1241"\w* \w and flocks|strong="H6629"\w* \w to the house|strong="H1004"\w* \w of our God|strong="H430"\w*, \w to the priests|strong="H3548"\w* \w who minister|strong="H8334"\w* \w in the house|strong="H1004"\w* \w of our God|strong="H430"\w*.
\p \v 37 \w Moreover|strong="H853"\w*, \w we will bring|strong="H935"\w* \w to the priests|strong="H3548"\w* \w at|strong="H413"\w* \w the storerooms|strong="H3957"\w* \w of the house|strong="H1004"\w* \w of our God|strong="H430"\w* \w the firstfruits|strong="H7225"\w* \w of our dough|strong="H6182"\w*, \w of our grain offerings|strong="H8641"\w*, \w of the fruit|strong="H6529"\w* \w of all our|strong="H3605"\w* \w trees|strong="H6086"\w*, \w and of our new wine|strong="H8492"\w* \w and oil|strong="H3323"\w*. \w A tenth|strong="H4643"\w* \w of our produce|strong="H127"\w* \w belongs to the Levites|strong="H3881"\w*, \w so that they|strong="H1992"\w* \w . . .|strong="H3881"\w* \w shall receive tithes|strong="H6237"\w* \w in all|strong="H3605"\w* \w the towns|strong="H5892"\w* \w where we labor|strong="H5656"\w*. \v 38 \w A priest|strong="H3548"\w* \w of Aaron’s|strong="H175"\w* \w line|strong="H1121"\w* \w is to accompany|strong="H1961"\w* \w . . .|strong="H5973"\w* \w the Levites|strong="H3881"\w* \w when they|strong="H3881"\w* \w collect the tenth|strong="H6237"\w*, \w and the Levites|strong="H3881"\w* \w are to bring|strong="H5927"\w* \w -|strong="H853"\w* \w a tenth|strong="H4643"\w* \w of these tithes|strong="H4643"\w* \w to|strong="H413"\w* \w the storerooms|strong="H3957"\w* \w of the treasury|strong="H1004"\w* \w . . .|strong="H214"\w* \w in the house|strong="H1004"\w* \w of our God|strong="H430"\w*. \v 39 \w For|strong="H3588"\w* \w the Israelites|strong="H1121"\w* \w . . .|strong="H3478"\w* \w and the Levites|strong="H1121"\w* \w . . .|strong="H3878"\w* \w -|strong="H853"\w* \w are to bring|strong="H935"\w* \w the contributions|strong="H8641"\w* \w of grain|strong="H1715"\w*, \w new wine|strong="H8492"\w*, \w and oil|strong="H3323"\w* \w to|strong="H413"\w* \w the storerooms|strong="H3957"\w* \w where|strong="H8033"\w* \w the articles|strong="H3627"\w* \w of the sanctuary [are kept]|strong="H4720"\w* \w and where the ministering|strong="H8334"\w* \w priests|strong="H3548"\w*, \w the gatekeepers|strong="H7778"\w*, \w and the singers [stay]|strong="H7891"\w*.
\p \w Thus we will not|strong="H3808"\w* \w neglect|strong="H5800"\w* \w -|strong="H853"\w* \w the house|strong="H1004"\w* \w of our God|strong="H430"\w*.”
\c 11
\s1 Jerusalem’s New Settlers
\p \v 1 \w Now the leaders|strong="H8269"\w* \w of the people|strong="H5971"\w* \w settled|strong="H3427"\w* \w in Jerusalem|strong="H3389"\w*, \w and the rest|strong="H7605"\w* \w of the people|strong="H5971"\w* \w cast|strong="H5307"\w* \w lots|strong="H1486"\w* \w to bring|strong="H935"\w* \w one|strong="H259"\w* \w out|strong="H4480"\w* \w of ten|strong="H6235"\w* \w to live|strong="H3427"\w* \w in the holy|strong="H6944"\w* \w city|strong="H5892"\w* \w of Jerusalem|strong="H3389"\w*, \w while|strong="H8672"\w* \w the remaining nine|strong="H3027"\w*\f + \fr 11:1 \ft Hebrew \fqa nine hands\f* \w [were to dwell] in [their own] towns|strong="H5892"\w*. \v 2 \w And the people|strong="H5971"\w* \w blessed|strong="H1288"\w* \w all|strong="H3605"\w* \w the men|strong="H582"\w* \w who volunteered|strong="H5068"\w* \w to live|strong="H3427"\w* \w in Jerusalem|strong="H3389"\w*.
\p \v 3 \w These|strong="H428"\w* \w are the heads|strong="H7218"\w* \w of the provinces|strong="H4082"\w* \w who|strong="H834"\w* \w settled|strong="H3427"\w* \w in Jerusalem|strong="H3389"\w*. \w (In the villages|strong="H5892"\w* \w of Judah, however|strong="H3063"\w*, \w each|strong="H376"\w* \w lived|strong="H3427"\w* \w on his own property|strong="H272"\w* \w in their towns|strong="H5892"\w*— \w the Israelites|strong="H3478"\w*, \w priests|strong="H3548"\w*, \w Levites|strong="H3881"\w*, \w temple servants|strong="H5411"\w*,\f + \fr 11:3 \ft Hebrew \fqa Nethinim\ft ; also in verse 21\f* \w and descendants|strong="H1121"\w* \w of Solomon’s|strong="H8010"\w* \w servants|strong="H5650"\w*— \v 4 \w while some of the descendants|strong="H1121"\w* \w of Judah|strong="H3063"\w* \w and Benjamin|strong="H1144"\w* \w settled|strong="H3427"\w* \w in Jerusalem|strong="H3389"\w*.)
\p \w From the descendants|strong="H1121"\w* \w . . .|strong="H1121"\w* \w of Judah|strong="H3063"\w*:
\pmo \w Athaiah|strong="H6265"\w* \w son|strong="H1121"\w* \w of Uzziah|strong="H5818"\w*, \w the son|strong="H1121"\w* \w of Zechariah|strong="H2148"\w*, \w the son|strong="H1121"\w* \w of Amariah|strong="H568"\w*, \w the son|strong="H1121"\w* \w of Shephatiah|strong="H8203"\w*, \w the son|strong="H1121"\w* \w of Mahalalel|strong="H4111"\w*, \w a descendant|strong="H1121"\w* \w of Perez|strong="H6557"\w*; \v 5 \w and Maaseiah|strong="H4641"\w* \w son|strong="H1121"\w* \w of Baruch|strong="H1263"\w*, \w the son|strong="H1121"\w* \w vvv|strong="H3626"\w* \w of Col-hozeh|strong="H3626"\w*, \w the son|strong="H1121"\w* \w of Hazaiah|strong="H2382"\w*, \w the son|strong="H1121"\w* \w of Adaiah|strong="H5718"\w*, \w the son|strong="H1121"\w* \w of Joiarib|strong="H3114"\w*, \w the son|strong="H1121"\w* \w of Zechariah|strong="H2148"\w*, \w a descendant|strong="H1121"\w* \w of Shelah|strong="H8023"\w*.\f + \fr 11:5 \ft Or \fqa of the Shilonite\f* \v 6 \w The descendants|strong="H1121"\w* \w of Perez|strong="H6557"\w* \w who settled|strong="H3427"\w* \w in Jerusalem|strong="H3389"\w* \w totaled|strong="H3605"\w* \w 468|strong="H702"\w* \w . . .|strong="H3967"\w* \w . . .|strong="H8346"\w* \w . . .|strong="H8083"\w* \w men|strong="H582"\w* \w of valor|strong="H2428"\w*.
\p \v 7 \w From|strong="H428"\w* \w the descendants|strong="H1121"\w* \w of Benjamin|strong="H1144"\w*:
\pmo \w Sallu|strong="H5543"\w* \w son|strong="H1121"\w* \w of Meshullam|strong="H4918"\w*, \w the son|strong="H1121"\w* \w of Joed|strong="H3133"\w*, \w the son|strong="H1121"\w* \w of Pedaiah|strong="H6305"\w*, \w the son|strong="H1121"\w* \w of Kolaiah|strong="H6964"\w*, \w the son|strong="H1121"\w* \w of Maaseiah|strong="H4641"\w*, \w the son|strong="H1121"\w* \w of Ithiel|strong="H384"\w*, \w the son|strong="H1121"\w* \w of Jeshaiah|strong="H3470"\w*; \v 8 \w and his followers|strong="H310"\w* \w Gabbai|strong="H1373"\w* \w and Sallai|strong="H5543"\w* — \w 928 men|strong="H8672"\w* \w . . .|strong="H3967"\w* \w . . .|strong="H6242"\w* \w . . .|strong="H8083"\w*. \v 9 \w Joel|strong="H3100"\w* \w son|strong="H1121"\w* \w of Zichri|strong="H2147"\w* \w was the officer|strong="H6496"\w* \w over them|strong="H5921"\w*, \w and Judah|strong="H3063"\w* \w son|strong="H1121"\w* \w of Hassenuah|strong="H5574"\w* \w [was] over|strong="H5921"\w* \w the Second District|strong="H4932"\w* \w of the city|strong="H5892"\w*.\f + \fr 11:9 \ft Or \fqa was over the Second Quarter of the city\ft , a newer section of Jerusalem; or \fqa was second in command of the city\f*
\p \v 10 \w From|strong="H4480"\w* \w the priests|strong="H3548"\w*:
\li1 \w Jedaiah|strong="H3048"\w* \w son|strong="H1121"\w* \w of Joiarib|strong="H3114"\w*;\f + \fr 11:10 \ft Or \fqa Jedaiah; the son of Joiarib;\f* \w Jachin|strong="H3199"\w*; \v 11 \w Seraiah|strong="H8304"\w* \w son|strong="H1121"\w* \w of Hilkiah|strong="H2518"\w*, \w the son|strong="H1121"\w* \w of Meshullam|strong="H4918"\w*, \w the son|strong="H1121"\w* \w of Zadok|strong="H6659"\w*, \w the son|strong="H1121"\w* \w of Meraioth|strong="H4812"\w*, \w the son|strong="H1121"\w* \w of Ahitub|strong="H285"\w*, \w the chief official|strong="H5057"\w* \w of the house|strong="H1004"\w* \w of God|strong="H430"\w*; \v 12 \w and their associates|strong="H251"\w* \w who did|strong="H6213"\w* \w the work|strong="H4399"\w* \w at the temple|strong="H1004"\w* — \w 822 men|strong="H8083"\w* \w . . .|strong="H3967"\w* \w . . .|strong="H6242"\w* \w . . .|strong="H8147"\w*;
\li1 \w Adaiah|strong="H5718"\w* \w son|strong="H1121"\w* \w of Jeroham|strong="H3395"\w*, \w the son|strong="H1121"\w* \w of Pelaliah|strong="H6421"\w*, \w the son|strong="H1121"\w* \w of Amzi|strong="H557"\w*, \w the son|strong="H1121"\w* \w of Zechariah|strong="H2148"\w*, \w the son|strong="H1121"\w* \w of Pashhur|strong="H6583"\w*, \w the son|strong="H1121"\w* \w of Malchijah|strong="H4441"\w*; \v 13 \w and his associates|strong="H251"\w*, \w the leaders|strong="H7218"\w* \w of families|strong="H1"\w* — \w 242 men|strong="H3967"\w* \w . . .|strong="H705"\w* \w . . .|strong="H8147"\w*;
\li1 \w Amashai|strong="H6023"\w* \w son|strong="H1121"\w* \w of Azarel|strong="H5832"\w*, \w the son|strong="H1121"\w* \w of Ahzai|strong="H273"\w*, \w the son|strong="H1121"\w* \w of Meshillemoth|strong="H4919"\w*, \w the son|strong="H1121"\w* \w of Immer|strong="H564"\w*; \v 14 \w and his associates|strong="H251"\w*\f + \fr 11:14 \ft Most LXX manuscripts; Hebrew \fqa their associates\f* — \w 128|strong="H3967"\w* \w . . .|strong="H6242"\w* \w . . .|strong="H8083"\w* \w mighty men|strong="H1368"\w* \w of valor|strong="H2428"\w*. \w Zabdiel|strong="H2068"\w* \w son of|strong="H1121"\w* \w Haggedolim|strong="H1419"\w* \w was their overseer|strong="H6496"\w* \w . . .|strong="H5921"\w*.
\p \v 15 \w From|strong="H4480"\w* \w the Levites|strong="H3881"\w*:
\pmo \w Shemaiah|strong="H8098"\w* \w son|strong="H1121"\w* \w of Hasshub|strong="H2815"\w*, \w the son|strong="H1121"\w* \w of Azrikam|strong="H5840"\w*, \w the son|strong="H1121"\w* \w of Hashabiah|strong="H2811"\w*, \w the son|strong="H1121"\w* \w of Bunni|strong="H1138"\w*; \v 16 \w Shabbethai|strong="H7678"\w* \w and Jozabad|strong="H3107"\w*, \w two leaders|strong="H7218"\w* \w of the Levites|strong="H3881"\w*, \w who supervised|strong="H5921"\w* \w the work|strong="H4399"\w* \w outside|strong="H2435"\w* \w the house|strong="H1004"\w* \w of God|strong="H430"\w*; \v 17 \w Mattaniah|strong="H4983"\w* \w son|strong="H1121"\w* \w of Mica|strong="H4318"\w*, \w the son|strong="H1121"\w* \w of Zabdi|strong="H2067"\w*, \w the son|strong="H1121"\w* \w of Asaph|strong="H623"\w*, \w who led|strong="H7218"\w* \w . . .|strong="H8462"\w* \w in thanksgiving|strong="H3034"\w* \w and prayer|strong="H8605"\w*; \w Bakbukiah|strong="H1229"\w*, \w second|strong="H4932"\w* \w among his associates|strong="H251"\w*; \w and Abda|strong="H5653"\w* \w son|strong="H1121"\w* \w of Shammua|strong="H8051"\w*, \w the son|strong="H1121"\w* \w of Galal|strong="H1559"\w*, \w the son|strong="H1121"\w* \w of Jeduthun|strong="H3038"\w*. \v 18 \w The Levites|strong="H3881"\w* \w in the holy|strong="H6944"\w* \w city|strong="H5892"\w* \w totaled|strong="H3605"\w* \w 284|strong="H3967"\w* \w . . .|strong="H8084"\w* \w . . .|strong="H702"\w*.
\p \v 19 \w And the gatekeepers|strong="H7778"\w*:
\pmo \w Akkub|strong="H6126"\w*, \w Talmon|strong="H2929"\w*, \w and their associates|strong="H251"\w*, \w who kept watch|strong="H8104"\w* \w at the gates|strong="H8179"\w* — \w 172 men|strong="H3967"\w* \w . . .|strong="H7657"\w* \w . . .|strong="H8147"\w*.
\s1 Residents Outside Jerusalem
\p \v 20 \w The rest|strong="H7605"\w* \w of the Israelites|strong="H3478"\w*, \w with the priests|strong="H3548"\w* \w and Levites|strong="H3881"\w*, \w [were] in all|strong="H3605"\w* \w the villages|strong="H5892"\w* \w of Judah|strong="H3063"\w*, \w each|strong="H376"\w* \w on his own inheritance|strong="H5159"\w*. \v 21 \w The temple servants|strong="H5411"\w* \w lived|strong="H3427"\w* \w on [the hill of] Ophel|strong="H6077"\w*, \w with Ziha|strong="H6727"\w* \w and Gishpa|strong="H1658"\w* \w over|strong="H5921"\w* \w [them]|strong="H5411"\w*.
\p \v 22 \w Now the overseer|strong="H6496"\w* \w of the Levites|strong="H3881"\w* \w in Jerusalem|strong="H3389"\w* \w was Uzzi|strong="H5813"\w* \w son|strong="H1121"\w* \w of Bani|strong="H1137"\w*, \w the son|strong="H1121"\w* \w of Hashabiah|strong="H2811"\w*, \w the son|strong="H1121"\w* \w of Mattaniah|strong="H4983"\w*, \w the son|strong="H1121"\w* \w of Mica|strong="H4316"\w*.\f + \fr 11:22 \fqa Mica \ft is a variant of \fqa Micaiah\ft ; see \ref Nehemiah 12:35|NEH 12:35\ref*.\f* \w [He was] one of Asaph’s|strong="H623"\w* \w descendants|strong="H1121"\w*, \w who were the singers|strong="H7891"\w* \w in charge|strong="H5048"\w* \w of the service|strong="H4399"\w* \w of the house|strong="H1004"\w* \w of God|strong="H430"\w*. \v 23 \w For|strong="H3588"\w* \w [there was] a command|strong="H4687"\w* \w from the king|strong="H4428"\w* \w concerning [the singers]|strong="H5921"\w*, \w an ordinance|strong="H548"\w* \w regulating|strong="H5921"\w* \w [their]|strong="H7891"\w* \w daily|strong="H3117"\w* \w . . .|strong="H3117"\w* \w activities|strong="H1697"\w*. \v 24 \w Pethahiah|strong="H6611"\w* \w son|strong="H1121"\w* \w of Meshezabel|strong="H4898"\w*, \w a descendant|strong="H1121"\w* \w of Zerah|strong="H2226"\w* \w son|strong="H1121"\w* \w of Judah|strong="H3063"\w*, \w was the king’s|strong="H4428"\w* \w agent|strong="H3027"\w*\f + \fr 11:24 \ft Hebrew \fqa hand\f* \w in every|strong="H3605"\w* \w matter|strong="H1697"\w* \w concerning the people|strong="H5971"\w*.
\p \v 25 \w As for|strong="H413"\w* \w the villages|strong="H2691"\w* \w with their fields|strong="H7704"\w*, \w some of the people|strong="H1121"\w* \w of Judah|strong="H3063"\w* \w lived|strong="H3427"\w* \w vvv|strong="H7153"\w* \w in Kiriath-arba|strong="H7153"\w* \w -|strong="H1323"\w*, \w Dibon|strong="H1769"\w* \w -|strong="H1323"\w*, \w Jekabzeel|strong="H3343"\w*, \w and their villages|strong="H2691"\w*; \v 26 \w in Jeshua|strong="H3442"\w*, \w Moladah|strong="H4137"\w*, \w vvv|strong="H1046"\w* \w and Beth-pelet|strong="H1046"\w*; \v 27 \w vvv|strong="H2705"\w* \w in Hazar-shual|strong="H2705"\w*; \w vvv|strong="H884"\w* \w in Beersheba|strong="H884"\w* \w and its villages|strong="H1323"\w*; \v 28 \w in Ziklag|strong="H6860"\w*; \w in Meconah|strong="H4368"\w* \w and its villages|strong="H1323"\w*; \v 29 \w vvv|strong="H5884"\w* \w in En-rimmon|strong="H5884"\w*, \w Zorah|strong="H6881"\w*, \w Jarmuth|strong="H3412"\w*, \v 30 \w Zanoah|strong="H2182"\w*, \w Adullam|strong="H5725"\w*, \w and their villages|strong="H2691"\w*; \w in Lachish|strong="H3923"\w* \w and its fields|strong="H7704"\w*; \w and in Azekah|strong="H5825"\w* \w and its villages|strong="H1323"\w*. \w So they settled|strong="H2583"\w* \w vvv|strong="H884"\w* \w from Beersheba|strong="H884"\w* \w all the way to|strong="H5704"\w* \w the Valley|strong="H1516"\w* \w of Hinnom|strong="H2011"\w*.
