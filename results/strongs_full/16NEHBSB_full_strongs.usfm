\s1 The Builders of the Walls
\p \v 1 \w At the Sheep|strong="H6629"\w* \w Gate|strong="H8179"\w*, \w Eliashib|strong="H475"\w* \w the high|strong="H1419"\w* \w priest|strong="H3548"\w* \w and his fellow|strong="H251"\w* \w priests|strong="H3548"\w* \w began|strong="H6965"\w* \w rebuilding|strong="H1129"\w*. \w -|strong="H853"\w* \w They|strong="H1992"\w* \w dedicated it|strong="H6942"\w* \w and installed|strong="H5975"\w* \w its doors|strong="H1817"\w*. \w After building as far as|strong="H5704"\w* \w the Tower|strong="H4026"\w* \w of the Hundred|strong="H3968"\w* \w and the Tower|strong="H4026"\w* \w of Hananel|strong="H2606"\w*, \w they dedicated [the wall]|strong="H6942"\w* \w . . .|strong="H5704"\w*. \v 2 \w The men of Jericho|strong="H3405"\w* \w built|strong="H1129"\w* \w . . .|strong="H582"\w* \w next to|strong="H5921"\w* \w Eliashib|strong="H3027"\w*, \w and Zaccur|strong="H2139"\w* \w son|strong="H1121"\w* \w of Imri|strong="H566"\w* \w built|strong="H1129"\w* \w next|strong="H5921"\w* \w to them|strong="H3027"\w*.
\p \v 3 \w -|strong="H853"\w* \w The Fish|strong="H1709"\w* \w Gate|strong="H8179"\w* \w was rebuilt|strong="H1129"\w* \w by the sons|strong="H1121"\w* \w of Hassenaah|strong="H5570"\w*. \w They|strong="H1992"\w* \w laid its beams|strong="H7136"\w* \w and installed|strong="H5975"\w* \w its doors|strong="H1817"\w*, \w bolts|strong="H4514"\w*, \w and bars|strong="H1280"\w*. \v 4 \w Next|strong="H5921"\w* \w to them|strong="H3027"\w*, \w Meremoth|strong="H4822"\w* \w son|strong="H1121"\w* \w of Uriah|strong="H223"\w*, \w the son|strong="H1121"\w* \w of Hakkoz|strong="H6976"\w*, \w made repairs|strong="H2388"\w*. \w Next|strong="H5921"\w* \w to him|strong="H3027"\w*, \w Meshullam|strong="H4918"\w* \w son|strong="H1121"\w* \w of Berechiah|strong="H1296"\w*, \w the son|strong="H1121"\w* \w of Meshezabel|strong="H4898"\w*, \w made repairs|strong="H2388"\w*; \w and next|strong="H5921"\w* \w to him|strong="H3027"\w*, \w Zadok|strong="H6659"\w* \w son|strong="H1121"\w* \w of Baana|strong="H1195"\w* \w made repairs as well|strong="H2388"\w*. \v 5 \w Next|strong="H5921"\w* \w to him|strong="H3027"\w*, \w the Tekoites|strong="H8621"\w* \w made repairs|strong="H2388"\w*, \w but their nobles|strong="H117"\w* \w did not|strong="H3808"\w* \w put|strong="H935"\w* \w their shoulders|strong="H6677"\w* \w to the work|strong="H5656"\w* \w under their supervisors|strong="H113"\w*.\f + \fr 3:5 \ft Or \fqa their Lord \ft or \fqa the governor\f*
\p \v 6 \w -|strong="H853"\w* \w The Jeshanah|strong="H3465"\w* \w Gate|strong="H8179"\w*\f + \fr 3:6 \ft Or \fqa The Old City Gate\f* \w was repaired|strong="H2388"\w* \w by Joiada|strong="H3111"\w* \w son|strong="H1121"\w* \w of Paseah|strong="H6454"\w* \w and Meshullam|strong="H4918"\w* \w son|strong="H1121"\w* \w of Besodeiah|strong="H1152"\w*. \w They|strong="H1992"\w* \w laid its beams|strong="H7136"\w* \w and installed|strong="H5975"\w* \w its doors|strong="H1817"\w*, \w bolts|strong="H4514"\w*, \w and bars|strong="H1280"\w*. \v 7 \w Next|strong="H5921"\w* \w to them|strong="H3027"\w*, \w repairs were made|strong="H2388"\w* \w by Melatiah|strong="H4424"\w* \w the Gibeonite|strong="H1393"\w*, \w Jadon|strong="H3036"\w* \w the Meronothite|strong="H4824"\w*, \w and the men|strong="H582"\w* \w of Gibeon|strong="H1391"\w* \w and Mizpah|strong="H4709"\w*, \w who were under the authority|strong="H3678"\w* \w of the governor|strong="H6346"\w* \w of the region west|strong="H5676"\w* \w of the Euphrates|strong="H5104"\w*.\f + \fr 3:7 \ft Hebrew \fqa the governor beyond the River\f* \v 8 \w Next|strong="H5921"\w* \w to them|strong="H3027"\w*, \w Uzziel|strong="H5816"\w* \w son|strong="H1121"\w* \w of Harhaiah|strong="H2736"\w*, \w one of the goldsmiths|strong="H6884"\w*, \w made repairs|strong="H2388"\w*. \w And next|strong="H5921"\w* \w to him|strong="H3027"\w*, \w Hananiah|strong="H2608"\w*, \w one|strong="H1121"\w* \w of the perfumers|strong="H7546"\w*, \w made repairs|strong="H2388"\w*. \w They fortified|strong="H5800"\w* \w Jerusalem|strong="H3389"\w* \w as|strong="H5704"\w* \w far as the Broad|strong="H7342"\w* \w Wall|strong="H2346"\w*.
\p \v 9 \w Next|strong="H5921"\w* \w to them|strong="H3027"\w*, \w Rephaiah|strong="H7509"\w* \w son|strong="H1121"\w* \w of Hur|strong="H2354"\w*, \w ruler|strong="H8269"\w* \w of a half-district|strong="H2677"\w* \w . . .|strong="H6418"\w* \w of Jerusalem|strong="H3389"\w*, \w made repairs|strong="H2388"\w*; \v 10 \w next|strong="H5921"\w* \w to him|strong="H3027"\w*, \w Jedaiah|strong="H3042"\w* \w son|strong="H1121"\w* \w of Harumaph|strong="H2739"\w* \w made repairs|strong="H2388"\w* \w across from|strong="H5048"\w* \w his house|strong="H1004"\w*; \w and next|strong="H5921"\w* \w to him|strong="H3027"\w*, \w Hattush|strong="H2407"\w* \w son|strong="H1121"\w* \w of Hashabneiah|strong="H2813"\w* \w made repairs|strong="H2388"\w*. \v 11 \w Malchijah|strong="H4441"\w* \w son|strong="H1121"\w* \w of Harim|strong="H2766"\w* \w and Hasshub|strong="H2815"\w* \w son|strong="H1121"\w* \w vvv|strong="H6355"\w* \w of Pahath-moab|strong="H6355"\w* \w -|strong="H853"\w* \w repaired|strong="H2388"\w* \w another|strong="H8145"\w* \w section|strong="H4060"\w*, \w as well as the Tower|strong="H4026"\w* \w of the Ovens|strong="H8574"\w*. \v 12 \w And next|strong="H5921"\w* \w to them|strong="H3027"\w*, \w Shallum|strong="H7967"\w* \w son|strong="H1121"\w* \w of Hallohesh|strong="H3873"\w*, \w ruler|strong="H8269"\w* \w of [the other] half-district|strong="H2677"\w* \w . . .|strong="H6418"\w* \w of Jerusalem|strong="H3389"\w*, \w made repairs|strong="H2388"\w*, \w with the help of|strong="H1931"\w* \w his daughters|strong="H1323"\w*.
\p \v 13 \w The Valley|strong="H1516"\w* \w Gate|strong="H8179"\w* \w -|strong="H853"\w* \w was repaired|strong="H2388"\w* \w by Hanun|strong="H2586"\w* \w and the residents|strong="H3427"\w* \w of Zanoah|strong="H2182"\w*. \w They|strong="H1992"\w* \w rebuilt it|strong="H1129"\w*, \w installed|strong="H5975"\w* \w its doors|strong="H1817"\w*, \w bolts|strong="H4514"\w*, \w and bars|strong="H1280"\w*, \w and [repaired] a thousand|strong="H505"\w* \w cubits|strong="H520"\w*\f + \fr 3:13 \fqa 1,000 cubits \ft is approximately 1,500 feet or 457.2 meters.\f* \w of the wall|strong="H2346"\w* \w as far as|strong="H5704"\w* \w the Dung|strong="H830"\w* \w Gate|strong="H8179"\w*.
\p \v 14 \w The Dung|strong="H830"\w* \w Gate|strong="H8179"\w* \w -|strong="H853"\w* \w was repaired|strong="H2388"\w* \w by Malchijah|strong="H4441"\w* \w son|strong="H1121"\w* \w of Rechab|strong="H7394"\w*, \w ruler|strong="H8269"\w* \w of the district|strong="H6418"\w* \w vvv|strong="H1021"\w* \w of Beth-haccherem|strong="H1021"\w*. \w He|strong="H1931"\w* \w rebuilt it|strong="H1129"\w* \w and installed|strong="H5975"\w* \w its doors|strong="H1817"\w*, \w bolts|strong="H4514"\w*, \w and bars|strong="H1280"\w*.
\p \v 15 \w The Fountain|strong="H5869"\w* \w Gate|strong="H8179"\w* \w -|strong="H853"\w* \w was repaired|strong="H2388"\w* \w by Shallun|strong="H7968"\w*\f + \fr 3:15 \ft Hebrew; Syriac \fqa Shallum\f* \w son|strong="H1121"\w* \w vvv|strong="H3626"\w* \w of Col-hozeh|strong="H3626"\w*, \w ruler|strong="H8269"\w* \w of the district|strong="H6418"\w* \w of Mizpah|strong="H4709"\w*. \w He|strong="H1931"\w* \w rebuilt it|strong="H1129"\w*, \w roofed it|strong="H2926"\w*, \w and installed|strong="H5975"\w* \w its doors|strong="H1817"\w*, \w bolts|strong="H4514"\w*, \w and bars|strong="H1280"\w*. \w -|strong="H853"\w* \w He also repaired the wall|strong="H2346"\w* \w of the Pool|strong="H1295"\w* \w of Shelah|strong="H7975"\w*\f + \fr 3:15 \fqa Pool of Shelah \ft is another name for the Pool of Siloam.\f* \w near the king’s|strong="H4428"\w* \w garden|strong="H1588"\w*, \w as|strong="H5704"\w* \w far as the stairs|strong="H4609"\w* \w that descend|strong="H3381"\w* \w from the City|strong="H5892"\w* \w of David|strong="H1732"\w*.
\p \v 16 \w Beyond him|strong="H310"\w*, \w Nehemiah|strong="H5166"\w* \w son|strong="H1121"\w* \w of Azbuk|strong="H5802"\w*, \w ruler|strong="H8269"\w* \w of a half-district|strong="H2677"\w* \w . . .|strong="H6418"\w* \w vvv|strong="H1049"\w* \w of Beth-zur|strong="H1049"\w*, \w made repairs|strong="H2388"\w* \w up to|strong="H5704"\w* \w a point opposite|strong="H5048"\w* \w the tombs|strong="H6913"\w* \w of David|strong="H1732"\w*, \w as|strong="H5704"\w* \w far as the artificial|strong="H6213"\w* \w . . .|strong="H5704"\w* \w pool|strong="H1295"\w* \w and the House|strong="H1004"\w* \w of the Mighty|strong="H1368"\w*.
\p \v 17 \w Next to him|strong="H310"\w*, \w the Levites|strong="H3881"\w* \w made repairs|strong="H2388"\w* \w under Rehum|strong="H7348"\w* \w son|strong="H1121"\w* \w of Bani|strong="H1137"\w*, \w and next|strong="H5921"\w* \w to him|strong="H3027"\w*, \w Hashabiah|strong="H2811"\w*, \w ruler|strong="H8269"\w* \w of a half-district|strong="H2677"\w* \w . . .|strong="H6418"\w* \w of Keilah|strong="H7084"\w*, \w made repairs|strong="H2388"\w* \w for his district|strong="H6418"\w*. \v 18 \w Next to him|strong="H310"\w*, \w their countrymen|strong="H251"\w* \w made repairs|strong="H2388"\w* \w under Binnui|strong="H942"\w*\f + \fr 3:18 \ft Two Hebrew manuscripts and Syriac (see also LXX and \ref Nehemiah 3:24|NEH 3:24\ref*); most Hebrew manuscripts \fqa Bavvai\f* \w son|strong="H1121"\w* \w of Henadad|strong="H2582"\w*, \w ruler|strong="H8269"\w* \w of the other half-district|strong="H2677"\w* \w . . .|strong="H6418"\w* \w of Keilah|strong="H7084"\w*. \v 19 \w And next to|strong="H5921"\w* \w him|strong="H3027"\w*, \w Ezer|strong="H5829"\w* \w son|strong="H1121"\w* \w of Jeshua|strong="H3442"\w*, \w ruler|strong="H8269"\w* \w of Mizpah|strong="H4709"\w*, \w repaired|strong="H2388"\w* \w another|strong="H8145"\w* \w section|strong="H4060"\w* \w opposite|strong="H5048"\w* \w the ascent|strong="H5927"\w* \w to the armory|strong="H5402"\w*, \w near the angle [in the wall]|strong="H4740"\w*.
\p \v 20 \w Next to him|strong="H310"\w*, \w Baruch|strong="H1263"\w* \w son|strong="H1121"\w* \w of Zabbai|strong="H2079"\w* \w diligently|strong="H2734"\w* \w repaired|strong="H2388"\w* \w another|strong="H8145"\w* \w section|strong="H4060"\w*, \w from|strong="H4480"\w* \w the angle|strong="H4740"\w* \w to|strong="H5704"\w* \w the doorway|strong="H6607"\w* \w of the house|strong="H1004"\w* \w of Eliashib|strong="H475"\w* \w the high|strong="H1419"\w* \w priest|strong="H3548"\w*. \v 21 \w Next to him|strong="H310"\w*, \w Meremoth|strong="H4822"\w* \w son|strong="H1121"\w* \w of Uriah|strong="H223"\w*, \w the son|strong="H1121"\w* \w of Hakkoz|strong="H6976"\w*, \w repaired|strong="H2388"\w* \w another|strong="H8145"\w* \w section|strong="H4060"\w*, \w from the doorway|strong="H6607"\w* \w of the house|strong="H1004"\w* \w of Eliashib|strong="H475"\w* \w to|strong="H5704"\w* \w the end|strong="H8503"\w* \w of the house|strong="H1004"\w* \w . . .|strong="H475"\w*. \v 22 \w And next to him|strong="H310"\w*, \w the priests|strong="H3548"\w* \w . . .|strong="H582"\w* \w from the surrounding area|strong="H3603"\w* \w made repairs|strong="H2388"\w*.
\p \v 23 \w Beyond them|strong="H310"\w*, \w Benjamin|strong="H1144"\w* \w and Hasshub|strong="H2815"\w* \w made repairs|strong="H2388"\w* \w in front|strong="H5048"\w* \w of their house|strong="H1004"\w*, \w and next to them|strong="H310"\w*, \w Azariah|strong="H5838"\w* \w son|strong="H1121"\w* \w of Maaseiah|strong="H4641"\w*, \w the son|strong="H1121"\w* \w of Ananiah|strong="H6055"\w*, \w made repairs|strong="H2388"\w* \w beside|strong="H681"\w* \w his house|strong="H1004"\w*. \v 24 \w After him|strong="H310"\w*, \w Binnui|strong="H1131"\w* \w son|strong="H1121"\w* \w of Henadad|strong="H2582"\w* \w repaired|strong="H2388"\w* \w another|strong="H8145"\w* \w section|strong="H4060"\w*, \w from the house|strong="H1004"\w* \w of Azariah|strong="H5838"\w* \w to|strong="H5704"\w* \w the angle|strong="H4740"\w* \w . . .|strong="H5704"\w* \w and the corner|strong="H6438"\w*, \v 25 \w and Palal|strong="H6420"\w* \w son|strong="H1121"\w* \w of Uzai|strong="H186"\w* \w [made repairs] opposite|strong="H5048"\w* \w the angle|strong="H4740"\w* \w and the tower|strong="H4026"\w* \w that juts out|strong="H3318"\w* \w from the upper|strong="H5945"\w* \w -|strong="H834"\w* \w palace|strong="H1004"\w* \w of the king|strong="H4428"\w* \w near the courtyard|strong="H2691"\w* \w of the guard|strong="H4307"\w*. \w Next to him|strong="H310"\w*, \w Pedaiah|strong="H6305"\w* \w son|strong="H1121"\w* \w of Parosh|strong="H6551"\w* \v 26 \w and the temple servants|strong="H5411"\w*\f + \fr 3:26 \ft Hebrew \fqa the Nethinim\ft ; also in verse 31\f* \w . . .|strong="H1961"\w* \w living|strong="H3427"\w* \w on [the hill of] Ophel|strong="H6077"\w* \w . . .|strong="H5704"\w* \w made repairs opposite|strong="H5048"\w* \w the Water|strong="H4325"\w* \w Gate|strong="H8179"\w* \w toward the east|strong="H4217"\w* \w and the tower|strong="H4026"\w* \w that juts out|strong="H3318"\w*. \v 27 \w And next to them|strong="H310"\w*, \w the Tekoites|strong="H8621"\w* \w repaired|strong="H2388"\w* \w another|strong="H8145"\w* \w section|strong="H4060"\w*, \w from a point opposite|strong="H5048"\w* \w the great|strong="H1419"\w* \w tower|strong="H4026"\w* \w that juts out|strong="H3318"\w* \w to|strong="H5704"\w* \w the wall|strong="H2346"\w* \w of Ophel|strong="H6077"\w*.
\p \v 28 \w Above|strong="H5921"\w* \w the Horse|strong="H5483"\w* \w Gate|strong="H8179"\w*, \w each|strong="H376"\w* \w of the priests|strong="H3548"\w* \w made repairs|strong="H2388"\w* \w in front|strong="H5048"\w* \w of his [own] house|strong="H1004"\w*. \v 29 \w Next to them|strong="H310"\w*, \w Zadok|strong="H6659"\w* \w son|strong="H1121"\w* \w of Immer|strong="H564"\w* \w made repairs|strong="H2388"\w* \w opposite|strong="H5048"\w* \w his house|strong="H1004"\w*, \w and next to him|strong="H310"\w*, \w Shemaiah|strong="H8098"\w* \w son|strong="H1121"\w* \w of Shecaniah|strong="H7935"\w*, \w the guard|strong="H8104"\w* \w of the East|strong="H4217"\w* \w Gate|strong="H8179"\w*, \w made repairs|strong="H2388"\w*.
\p \v 30 \w Next to him|strong="H310"\w*, \w Hananiah|strong="H2608"\w* \w son|strong="H1121"\w* \w of Shelemiah|strong="H8018"\w*, \w as well as Hanun|strong="H2586"\w* \w the sixth|strong="H8345"\w* \w son|strong="H1121"\w* \w of Zalaph|strong="H6764"\w*, \w repaired|strong="H2388"\w* \w another|strong="H8145"\w* \w section|strong="H4060"\w*. \w Next to them|strong="H310"\w*, \w Meshullam|strong="H4918"\w* \w son|strong="H1121"\w* \w of Berechiah|strong="H1296"\w* \w made repairs|strong="H2388"\w* \w opposite|strong="H5048"\w* \w his own quarters|strong="H5393"\w*. \v 31 \w Next to him|strong="H310"\w*, \w Malchijah|strong="H4441"\w*, \w one of the goldsmiths|strong="H1121"\w* \w . . .|strong="H6885"\w*, \w made repairs|strong="H2388"\w* \w as far as|strong="H5704"\w* \w the house|strong="H1004"\w* \w of the temple servants|strong="H5411"\w* \w and the merchants|strong="H7402"\w*, \w opposite|strong="H5048"\w* \w the Inspection|strong="H4662"\w* \w Gate|strong="H8179"\w*, \w and as|strong="H5704"\w* \w far as the upper room|strong="H5944"\w* \w above the corner|strong="H6438"\w*. \v 32 \w And between|strong="H996"\w* \w the upper room|strong="H5944"\w* \w above the corner|strong="H6438"\w* \w and the Sheep|strong="H6629"\w* \w Gate|strong="H8179"\w*, \w the goldsmiths|strong="H6884"\w* \w and merchants|strong="H7402"\w* \w made repairs|strong="H2388"\w*.
\c 4
\s1 The Work Ridiculed
\p \v 1 \w Now|strong="H1961"\w* \w when|strong="H834"\w* \w Sanballat|strong="H5571"\w* \w heard|strong="H8085"\w* \w that|strong="H3588"\w* \w we|strong="H587"\w* \w were rebuilding|strong="H1129"\w* \w -|strong="H853"\w* \w the wall|strong="H2346"\w*, \w he was furious|strong="H2734"\w* \w and filled with indignation|strong="H3707"\w* \w . . .|strong="H7235"\w*. \w He ridiculed|strong="H3932"\w* \w . . .|strong="H5921"\w* \w the Jews|strong="H3064"\w* \v 2 \w before|strong="H6440"\w* \w his associates|strong="H251"\w* \w and the army|strong="H2428"\w* \w of Samaria|strong="H8111"\w*, \w . . .|strong="H559"\w* \w saying|strong="H559"\w*, “\w What|strong="H4100"\w* \w are these feeble|strong="H537"\w* \w Jews|strong="H3064"\w* \w doing|strong="H6213"\w*? \w Can they restore [the wall]|strong="H5800"\w* by themselves?\f + \fr 4:2 \ft Or \fqa Will they commit themselves to God?\f* \w Will they offer sacrifices|strong="H2076"\w*? \w Will they complete it|strong="H3615"\w* \w in a day|strong="H3117"\w*? \w {Can they bring} these|strong="H1992"\w* \w burnt|strong="H8313"\w* \w stones|strong="H68"\w* \w back to life|strong="H2421"\w* \w -|strong="H853"\w* \w from the mounds|strong="H6194"\w* \w of rubble|strong="H6083"\w*?”
\p \v 3 \w Then Tobiah|strong="H2900"\w* \w the Ammonite|strong="H5984"\w*, \w who was beside him|strong="H681"\w*, \w said|strong="H559"\w*, “\w If|strong="H518"\w* \w even|strong="H1571"\w* \w a fox|strong="H7776"\w* \w were to climb up on|strong="H5927"\w* \w what|strong="H834"\w* \w they|strong="H1992"\w* \w are building|strong="H1129"\w*, \w it would break down|strong="H6555"\w* \w their wall|strong="H2346"\w* \w of stones|strong="H68"\w*!”
\p \v 4 \w Hear us|strong="H8085"\w*, \w O God|strong="H430"\w*, \w for|strong="H3588"\w* \w we are|strong="H1961"\w* \w despised|strong="H939"\w*. \w Turn|strong="H7725"\w* \w their scorn|strong="H2781"\w* \w back upon|strong="H413"\w* \w their own heads|strong="H7218"\w*, \w and let them be taken|strong="H5414"\w* \w as plunder|strong="H961"\w* \w to a land|strong="H776"\w* \w of captivity|strong="H7633"\w*. \v 5 \w Do not|strong="H408"\w* \w cover up|strong="H3680"\w* \w . . .|strong="H5921"\w* \w their iniquity|strong="H5771"\w* \w or let their sin|strong="H2403"\w* \w be blotted out|strong="H4229"\w* \w from Your sight|strong="H6440"\w*, \w . . .|strong="H408"\w* \w for|strong="H3588"\w* \w they have provoked|strong="H3707"\w* \w . . .|strong="H5048"\w* \w the builders|strong="H1129"\w*.\f + \fr 4:5 \ft Or \fqa have provoked You to anger before the builders\f*
\p \v 6 \w So we rebuilt|strong="H1129"\w* \w -|strong="H853"\w* \w the wall|strong="H2346"\w* \w until all|strong="H3605"\w* \w [of it]|strong="H2346"\w* \w was joined together|strong="H7194"\w* \w up to|strong="H5704"\w* \w half its [height]|strong="H2677"\w*, \w for the people|strong="H5971"\w* \w had|strong="H1961"\w* \w a mind|strong="H3820"\w* \w to work|strong="H6213"\w*.
\p \v 7 \w -|strong="H1961"\w* \w When|strong="H834"\w* \w Sanballat|strong="H5571"\w* \w and Tobiah|strong="H2900"\w*, \w together with the Arabs|strong="H6163"\w*, \w Ammonites|strong="H5984"\w*, \w and Ashdodites|strong="H796"\w*, \w heard|strong="H8085"\w* \w that|strong="H3588"\w* \w the repair|strong="H724"\w* \w to the walls|strong="H2346"\w* \w of Jerusalem|strong="H3389"\w* \w was progressing|strong="H5927"\w* \w and that|strong="H3588"\w* \w . . .|strong="H2490"\w* \w the gaps|strong="H6555"\w* \w were being closed|strong="H5640"\w*, \w they were furious|strong="H2734"\w* \w -|strong="H3966"\w*, \v 8 \w and all of them|strong="H3605"\w* \w conspired|strong="H7194"\w* \w . . .|strong="H3162"\w* \w to come|strong="H935"\w* \w and fight|strong="H3898"\w* \w against Jerusalem|strong="H3389"\w* \w and create|strong="H6213"\w* \w a hindrance|strong="H8442"\w*.
\s1 Discouragement Overcome
\p \v 9 \w So we prayed|strong="H6419"\w* \w to|strong="H413"\w* \w our God|strong="H430"\w* \w and posted|strong="H5975"\w* \w a guard|strong="H4929"\w* \w against them|strong="H5921"\w* \w . . .|strong="H6440"\w* \w day|strong="H3119"\w* \w and night|strong="H3915"\w*.
\p \v 10 \w Meanwhile, the people of Judah|strong="H3063"\w* \w said|strong="H559"\w*:\f + \fr 4:10 \ft Or \fqa Meanwhile, Judah said\f*
