\c 13
\s1 Foreigners Excluded
\p \v 1 \w At that|strong="H1931"\w* \w time|strong="H3117"\w* \w the Book|strong="H5612"\w* \w of Moses|strong="H4872"\w* \w was read aloud|strong="H7121"\w* \w in the hearing|strong="H241"\w* \w of the people|strong="H5971"\w*, and in it \w they found|strong="H4672"\w* \w the passage stating|strong="H3789"\w* \w that|strong="H834"\w* \w no|strong="H3808"\w* \w Ammonite|strong="H5984"\w* \w or Moabite|strong="H4125"\w* \w should ever|strong="H5704"\w* \w . . .|strong="H5769"\w* \w enter|strong="H935"\w* \w the assembly|strong="H6951"\w* \w of God|strong="H430"\w*,\f + \fr 13:1 \ft See \ref Deuteronomy 23:3–6|DEU 23:3-6\ref*.\f* \v 2 \w because|strong="H3588"\w* \w they had not|strong="H3808"\w* \w met|strong="H6923"\w* \w -|strong="H853"\w* \w the Israelites|strong="H1121"\w* \w . . .|strong="H3478"\w* \w with food|strong="H3899"\w* \w and water|strong="H4325"\w*, \w but had hired|strong="H7936"\w* \w Balaam|strong="H1109"\w* \w -|strong="H853"\w* \w to call down a curse|strong="H7043"\w* \w against them|strong="H5921"\w* (\w although our God|strong="H430"\w* \w had turned|strong="H2015"\w* \w the curse|strong="H7045"\w* \w into a blessing|strong="H1293"\w*).
