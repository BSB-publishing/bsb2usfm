\p \v 13 \w Be on the alert|strong="G1127"\w*. \w Stand firm|strong="G4739"\w* \w in|strong="G1722"\w* \w the|strong="G3588"\w* \w faith|strong="G4102"\w*. \w Be men of courage|strong="G407"\w*. \w Be strong|strong="G2901"\w*. \v 14 \w Do|strong="G1096"\w* \w everything|strong="G3956"\w* \w -|strong="G4771"\w* \w in|strong="G1722"\w* \w love|strong="G26"\w*.
\p \v 15 \w You know|strong="G1492"\w* \w that|strong="G3754"\w* \w Stephanas|strong="G4734"\w* \w [and his]|strong="G3588"\w* \w household|strong="G3614"\w* \w were|strong="G1510"\w* \w [the] first converts|strong="G536"\w* \w -|strong="G3588"\w* \w in Achaia|strong="G882"\w*, \w and|strong="G2532"\w* \w they have devoted|strong="G5021"\w* \w themselves|strong="G1438"\w* \w to the|strong="G1519"\w* \w service|strong="G1248"\w* \w of the|strong="G3588"\w* \w saints|strong="G40"\w*. \w Now|strong="G1161"\w* \w I urge|strong="G3870"\w* \w you|strong="G4771"\w*, \w brothers|strong="G80"\w*, \v 16 \w to|strong="G2443"\w* \w -|strong="G4771"\w* \w -|strong="G2532"\w* \w submit|strong="G5293"\w* \w -|strong="G3588"\w* \w to such as these|strong="G5108"\w*, \w and|strong="G2532"\w* \w to every|strong="G3956"\w* \w -|strong="G3588"\w* \w fellow worker|strong="G4903"\w* \w and|strong="G2532"\w* \w laborer|strong="G2872"\w*.
