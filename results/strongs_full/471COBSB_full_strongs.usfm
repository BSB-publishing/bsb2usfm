\p \v 1 \w Now|strong="G1161"\w* \w about|strong="G4012"\w* \w the|strong="G3588"\w* \w collection|strong="G3048"\w* \w -|strong="G3588"\w* \w for|strong="G1519"\w* \w the|strong="G3588"\w* \w saints|strong="G40"\w*, \w -|strong="G3779"\w* \w you|strong="G4771"\w* \w are to do|strong="G4160"\w* \w vvv|strong="G2532"\w* \w as|strong="G5618"\w* \w I directed|strong="G1299"\w* \w the|strong="G3588"\w* \w churches|strong="G1577"\w* \w -|strong="G3588"\w* \w of Galatia|strong="G1053"\w*: \v 2 \w On the first [day]|strong="G1520"\w* \w of every|strong="G2596"\w* \w week|strong="G4521"\w*, \w each|strong="G1538"\w* \w of you|strong="G4771"\w* \w should set|strong="G5087"\w* \w aside|strong="G3844"\w* \w . . .|strong="G1438"\w* \w a portion|strong="G1437"\w* \w of his income|strong="G2137"\w*, \w saving it up|strong="G2343"\w* \w . . .|strong="G3754"\w*, \w so that|strong="G2443"\w* \w when|strong="G3752"\w* \w I come|strong="G2064"\w* \w -|strong="G5119"\w* \w no|strong="G3361"\w* \w collections|strong="G3048"\w* \w will be needed|strong="G1096"\w*. \v 3 \w Then|strong="G1161"\w*, \w vvv|strong="G3752"\w* \w on my arrival|strong="G3854"\w*, \w I will send|strong="G3992"\w* \w letters|strong="G1992"\w* \w with|strong="G1223"\w* \w those|strong="G3778"\w* \w . . .|strong="G3739"\w* \w vvv|strong="G1437"\w* \w you recommend|strong="G1381"\w* \w to carry|strong="G667"\w* \w your|strong="G4771"\w* \w -|strong="G3588"\w* \w gift|strong="G5485"\w* \w to|strong="G1519"\w* \w Jerusalem|strong="G2419"\w*. \v 4 \w And|strong="G1161"\w* \w if|strong="G1437"\w* \w it is|strong="G1510"\w* \w advisable|strong="G514"\w* \w for|strong="G3588"\w* \w me|strong="G2504"\w* \w to go {also}|strong="G4198"\w*, \w they can travel|strong="G4198"\w* \w with|strong="G4862"\w* \w me|strong="G1473"\w*.
\s1 Paul’s Travel Plans
\r (\ref Romans 15:23–33|ROM 15:23-33\ref*)
\p \v 5 \w After|strong="G3752"\w* \w I go through|strong="G1330"\w* \w Macedonia|strong="G3109"\w*, \w however|strong="G1161"\w*, \w I will come|strong="G2064"\w* \w to|strong="G4314"\w* \w you|strong="G4771"\w*; \w for|strong="G1063"\w* \w I will be going through|strong="G1330"\w* \w Macedonia|strong="G3109"\w*. \v 6 \w vvv|strong="G1161"\w* \w Perhaps|strong="G5177"\w* \w I will stay|strong="G3887"\w* \w with|strong="G4314"\w* \w you {awhile}|strong="G4771"\w*, \w or|strong="G2228"\w* \w even|strong="G2532"\w* \w spend the winter|strong="G3914"\w*, \w so that|strong="G2443"\w* \w you|strong="G4771"\w* \w can help|strong="G4311"\w* \w me {on my journey}|strong="G1473"\w*, \w wherever|strong="G3757"\w* \w vvv|strong="G1437"\w* \w I go|strong="G4198"\w*. \v 7 \w For|strong="G1063"\w* \w vvv|strong="G3756"\w* \w I do not want|strong="G2309"\w* \w to see|strong="G3708"\w* \w you|strong="G4771"\w* \w now|strong="G737"\w* \w [only] in|strong="G1722"\w* \w passing|strong="G3938"\w*; \w -|strong="G1063"\w* \w I hope|strong="G1679"\w* \w to spend|strong="G1961"\w* \w some|strong="G5100"\w* \w time|strong="G5550"\w* \w with|strong="G4314"\w* \w you|strong="G4771"\w*, \w if|strong="G1437"\w* \w the|strong="G3588"\w* \w Lord|strong="G2962"\w* \w permits|strong="G2010"\w*. \v 8 \w But|strong="G1161"\w* \w I will stay|strong="G1961"\w* \w in|strong="G1722"\w* \w Ephesus|strong="G2181"\w* \w until|strong="G2193"\w* \w -|strong="G3588"\w* \w Pentecost|strong="G4005"\w*,\f + \fr 16:8 \ft That is, Shavuot, the late spring feast of pilgrimage to Jerusalem; it is also known as \fqa the Feast of Harvest\ft (see \ref Exodus 23:16|EXO 23:16\ref*) or \fqa the Feast of Weeks\ft (see \ref Exodus 34:22|EXO 34:22\ref*).\f* \v 9 \w because|strong="G1063"\w* \w a great|strong="G3173"\w* \w door|strong="G2374"\w* \w [for]|strong="G2532"\w* \w effective [work]|strong="G1756"\w* \w has opened|strong="G455"\w* \w to me|strong="G1473"\w*, \w even though|strong="G2532"\w* \w many|strong="G4183"\w* \w oppose [me]|strong="G480"\w*.
\s1 Timothy and Apollos
\r (\ref Philippians 2:19–30|PHP 2:19-30\ref*)
\p \v 10 \w -|strong="G1161"\w* \w If|strong="G1437"\w* \w Timothy|strong="G5095"\w* \w comes|strong="G2064"\w*, \w see to it|strong="G991"\w* \w that|strong="G2443"\w* \w he has|strong="G1096"\w* \w nothing to fear|strong="G870"\w* \w [while he is] with|strong="G4314"\w* \w you|strong="G4771"\w*, \w for|strong="G1063"\w* \w he is doing|strong="G2038"\w* \w the|strong="G3588"\w* \w work|strong="G2041"\w* \w of [the] Lord|strong="G2962"\w*, \w just as|strong="G5613"\w* \w I am|strong="G2504"\w*. \v 11 \w No|strong="G3361"\w* \w one|strong="G5100"\w*, \w then|strong="G3767"\w*, \w should treat him with contempt|strong="G1848"\w* \w . . .|strong="G846"\w*. \w -|strong="G1161"\w* \w Send|strong="G4311"\w* \w him {on his way}|strong="G846"\w* \w in|strong="G1722"\w* \w peace|strong="G1515"\w* \w so that|strong="G2443"\w* \w he can return|strong="G2064"\w* \w to|strong="G4314"\w* \w me|strong="G1473"\w*, \w for|strong="G1063"\w* \w I am expecting|strong="G1551"\w* \w him|strong="G846"\w* \w along with|strong="G3326"\w* \w the|strong="G3588"\w* \w brothers|strong="G80"\w*.
