\p \v 19 \w The|strong="G3588"\w* \w churches|strong="G1577"\w* \w -|strong="G3588"\w* \w in [the province of] Asia|strong="G773"\w*\f + \fr 16:19 \ft Literally \fqa in Asia\ft ; Asia was a Roman province in what is now western Turkey. \f* \w send you greetings|strong="G782"\w* \w . . .|strong="G4771"\w*.
\p \w Aquila|strong="G207"\w* \w and|strong="G2532"\w* \w Prisca|strong="G4251"\w*\f + \fr 16:19 \fqa Prisca \ft is a variant of \fqa Priscilla\ft ; see \ref Acts 18:2|ACT 18:2\ref*.\f* \w greet|strong="G782"\w* \w you|strong="G4771"\w* \w warmly|strong="G4183"\w* \w in|strong="G1722"\w* \w [the] Lord|strong="G2962"\w*, \w and so does|strong="G4862"\w* \w the|strong="G3588"\w* \w church|strong="G1577"\w* \w [that meets] at|strong="G2596"\w* \w their|strong="G846"\w* \w house|strong="G3624"\w*.
