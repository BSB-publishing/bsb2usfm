\p \v 12 \w So the LORD|strong="H3068"\w* \w blessed|strong="H1288"\w* \w -|strong="H853"\w* \w Job’s|strong="H347"\w* \w latter [days]|strong="H319"\w* \w more than his first|strong="H7225"\w*. \w He owned|strong="H1961"\w* \w 14,000 {}|strong="H702"\w* \w . . .|strong="H6240"\w* \w . . .|strong="H505"\w* \w sheep|strong="H6629"\w*, \w 6,000 {}|strong="H8337"\w* \w . . .|strong="H505"\w* \w camels|strong="H1581"\w*, \w 1,000 {}|strong="H505"\w* \w yoke|strong="H6776"\w* \w of oxen|strong="H1241"\w*, \w and 1,000|strong="H505"\w* \w female donkeys|strong="H860"\w*. \v 13 \w And he also had|strong="H1961"\w* \w seven|strong="H7658"\w* \w sons|strong="H1121"\w* \w and three|strong="H7969"\w* \w daughters|strong="H1323"\w*. \v 14 \w He named|strong="H7121"\w* \w . . .|strong="H8034"\w* \w his first|strong="H259"\w* \w daughter Jemimah|strong="H3224"\w*, \w . . .|strong="H8034"\w* \w his second|strong="H8145"\w* \w Keziah|strong="H7103"\w*, \w . . .|strong="H8034"\w* \w and his third|strong="H7992"\w* \w vvv|strong="H7163"\w* \w Keren-happuch|strong="H7163"\w*. \v 15 \w No|strong="H3808"\w* \w women|strong="H802"\w* \w as beautiful|strong="H3303"\w* \w as Job’s|strong="H347"\w* \w daughters|strong="H1323"\w* \w could be found|strong="H4672"\w* \w in all|strong="H3605"\w* \w the land|strong="H776"\w*, \w and their father|strong="H1"\w* \w granted|strong="H5414"\w* them \w an inheritance|strong="H5159"\w* \w among|strong="H8432"\w* \w their brothers|strong="H251"\w*.
