\q1 \v 22 \w Receive|strong="H3947"\w* \w . . .|strong="H4994"\w* \w instruction|strong="H8451"\w* \w from His mouth|strong="H6310"\w*,
\q2 \w and lay up|strong="H7760"\w* \w His words|strong="H561"\w* \w in your heart|strong="H3824"\w*.
\q1 \v 23 \w If|strong="H518"\w* \w you return|strong="H7725"\w* \w to|strong="H5704"\w* \w the Almighty|strong="H7706"\w*, \w you will be restored|strong="H1129"\w*.
\q2 \w If you remove|strong="H7368"\w* \w injustice|strong="H5766"\w* \w from your tents|strong="H168"\w*
\q1 \v 24 \w and consign|strong="H7896"\w* \w your gold|strong="H1220"\w* \w to|strong="H5921"\w* \w the dust|strong="H6083"\w*
\q2 \w and the gold of Ophir|strong="H211"\w* \w to the stones|strong="H6697"\w* \w of the ravines|strong="H5158"\w*,
\q1 \v 25 \w then the Almighty|strong="H7706"\w* \w will be|strong="H1961"\w* \w your gold|strong="H1220"\w*
\q2 \w and the finest|strong="H8443"\w* \w silver|strong="H3701"\w* for you.
\q1 \v 26 \w Surely|strong="H3588"\w* \w then|strong="H227"\w* \w you will delight|strong="H6026"\w* \w in|strong="H5921"\w* \w the Almighty|strong="H7706"\w*
\q2 \w and lift up|strong="H5375"\w* \w your face|strong="H6440"\w* \w to|strong="H413"\w* \w God|strong="H433"\w*.
\q1 \v 27 \w You will pray|strong="H6279"\w* \w to Him|strong="H413"\w*, \w and He will hear you|strong="H8085"\w*,
