\p \v 4 \w Now Elihu|strong="H453"\w* \w had waited|strong="H2442"\w* \w -|strong="H853"\w* \w to speak|strong="H1697"\w* \w to Job|strong="H347"\w* \w because|strong="H3588"\w* \w the others|strong="H1992"\w* \w were older|strong="H2205"\w* \w than he|strong="H4480"\w* \w -|strong="H3117"\w*. \v 5 \w But when he|strong="H453"\w* \w saw|strong="H7200"\w* \w that|strong="H3588"\w* \w the three|strong="H7969"\w* \w men|strong="H582"\w* \w had no|strong="H369"\w* \w further reply|strong="H4617"\w* \w . . .|strong="H6310"\w*, \w his anger|strong="H639"\w* \w was kindled|strong="H2734"\w*. \v 6 \w So Elihu|strong="H453"\w* \w son|strong="H1121"\w* \w of Barachel|strong="H1292"\w* \w the Buzite|strong="H940"\w* \w . . .|strong="H559"\w* \w declared|strong="H6030"\w*:
