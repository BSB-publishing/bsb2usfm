\p \v 7 \w -|strong="H1961"\w* \w After|strong="H310"\w* \w the LORD|strong="H3068"\w* \w -|strong="H853"\w* \w had spoken|strong="H1696"\w* \w these|strong="H428"\w* \w words|strong="H1697"\w* \w to|strong="H413"\w* \w Job|strong="H347"\w*, \w He|strong="H3068"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w Eliphaz|strong="H464"\w* \w the Temanite|strong="H8489"\w*, “\w My wrath|strong="H639"\w* \w is kindled|strong="H2734"\w* against you \w and your two|strong="H8147"\w* \w friends|strong="H7453"\w*. \w For|strong="H3588"\w* \w you have not|strong="H3808"\w* \w spoken|strong="H1696"\w* \w about Me|strong="H413"\w* \w accurately|strong="H3559"\w*, \w as My servant|strong="H5650"\w* \w Job has|strong="H347"\w*. \v 8 \w So now|strong="H6258"\w*, \w take|strong="H3947"\w* \w seven|strong="H7651"\w* \w bulls|strong="H6499"\w* \w and seven|strong="H7651"\w* \w rams|strong="H352"\w*, \w go|strong="H1980"\w* \w to|strong="H413"\w* \w My servant|strong="H5650"\w* \w Job|strong="H347"\w*, \w and sacrifice|strong="H5927"\w* \w a burnt offering|strong="H5930"\w* \w for yourselves|strong="H1157"\w*. \w Then My servant|strong="H5650"\w* \w Job|strong="H347"\w* \w will pray|strong="H6419"\w* \w for you|strong="H5921"\w*, \w for|strong="H3588"\w* \w . . .|strong="H518"\w* \w I will accept|strong="H5375"\w* \w his prayer|strong="H6440"\w* \w and not|strong="H1115"\w* \w deal|strong="H6213"\w* \w with you|strong="H5973"\w* \w [according to your] folly|strong="H5039"\w*. \w For|strong="H3588"\w* \w you have not|strong="H3808"\w* \w spoken|strong="H1696"\w* \w accurately|strong="H3559"\w* \w about Me|strong="H413"\w*, \w as My servant|strong="H5650"\w* \w Job has|strong="H347"\w*.”
