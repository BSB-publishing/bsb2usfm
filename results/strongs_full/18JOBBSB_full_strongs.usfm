\q1 \v 2 \w Surely|strong="H518"\w* \w . . .|strong="H3808"\w* \w mockers|strong="H2049"\w* \w surround me|strong="H5978"\w*,
\q2 \w and my eyes|strong="H5869"\w* \w must gaze|strong="H3885"\w* \w at their rebellion|strong="H4784"\w*.
\b 
\q1 \v 3 \w Give [me]|strong="H7760"\w*, \w I pray|strong="H4994"\w*, \w the pledge|strong="H6148"\w* \w You [demand]|strong="H5973"\w*.
\q2 \w Who else|strong="H4310"\w* \w . . .|strong="H1931"\w* \w will be my guarantor|strong="H3027"\w* \w . . .|strong="H8628"\w*?
\q1 \v 4 \w -|strong="H3588"\w* \w You have closed|strong="H6845"\w* \w their minds|strong="H3820"\w* \w to understanding|strong="H7922"\w*;
\q2 \w therefore|strong="H5921"\w* \w . . .|strong="H3651"\w* \w You will not|strong="H3808"\w* \w exalt them|strong="H7311"\w*.
\q1 \v 5 \w If a man denounces|strong="H5046"\w* \w his friends|strong="H7453"\w* \w for a price|strong="H2506"\w*,
\q2 \w the eyes|strong="H5869"\w* \w of his children|strong="H1121"\w* \w will fail|strong="H3615"\w*.
\b 
\q1 \v 6 \w He has made me|strong="H3322"\w* \w a byword|strong="H4911"\w* \w among the people|strong="H5971"\w*,
\q2 \w [a man]|strong="H1961"\w* \w in whose face|strong="H6440"\w* \w they spit|strong="H8611"\w*.
\q1 \v 7 \w My eyes|strong="H5869"\w* \w have grown dim|strong="H3543"\w* \w with grief|strong="H3708"\w*,
\q2 \w and my whole|strong="H3605"\w* \w body|strong="H3338"\w* \w is but a shadow|strong="H6738"\w*.
\q1 \v 8 \w The upright|strong="H3477"\w* \w are appalled|strong="H8074"\w* \w at|strong="H5921"\w* \w this|strong="H2063"\w*,
\q2 \w and the innocent|strong="H5355"\w* \w are stirred|strong="H5782"\w* \w against|strong="H5921"\w* \w the godless|strong="H2611"\w*.
\q1 \v 9 \w Yet a righteous one|strong="H6662"\w* \w holds|strong="H270"\w* \w to his way|strong="H1870"\w*,
\q2 \w and the one with clean hands|strong="H3027"\w* \w . . .|strong="H2889"\w* \w grows|strong="H3254"\w* \w stronger|strong="H555"\w*.
\q1 \v 10 \w But|strong="H199"\w* \w come back|strong="H935"\w* \w . . .|strong="H4994"\w* \w and try again|strong="H7725"\w*, \w all of you|strong="H3605"\w*.
\q2 \w For I will not|strong="H3808"\w* \w find|strong="H4672"\w* \w a wise man|strong="H2450"\w* among you.
\b 
\q1 \v 11 \w My days|strong="H3117"\w* \w have passed|strong="H5674"\w*; \w my plans|strong="H2154"\w* \w are broken off|strong="H5423"\w* —
\q2 \w even the desires|strong="H4180"\w* \w of my heart|strong="H3824"\w*.
\q1 \v 12 \w They have turned|strong="H7760"\w* \w night|strong="H3915"\w* \w into day|strong="H3117"\w*,
\q2 \w [making] light|strong="H216"\w* \w seem near|strong="H7138"\w* \w in the face|strong="H6440"\w* \w of darkness|strong="H2822"\w*.
\q1 \v 13 \w If|strong="H518"\w* \w I look|strong="H6960"\w* \w for Sheol|strong="H7585"\w* \w as my home|strong="H1004"\w*,
\q2 \w if I spread out|strong="H7502"\w* \w my bed|strong="H3326"\w* \w in darkness|strong="H2822"\w*,
\q1 \v 14 \w and say|strong="H7121"\w* \w to corruption|strong="H7845"\w*, ‘\w You [are]|strong="H859"\w* \w my father|strong="H1"\w*,’
\q2 \w and to the worm|strong="H7415"\w*, ‘\w My mother|strong="H517"\w*,’ \w or ‘My sister|strong="H269"\w*,’
\q1 \v 15 \w where|strong="H346"\w* \w then|strong="H645"\w* \w is my hope|strong="H8615"\w*?
\q2 \w Who|strong="H4310"\w* \w can see|strong="H7789"\w* \w any hope for me|strong="H8615"\w*?
\q1 \v 16 \w Will it go down|strong="H3381"\w* \w to the gates|strong="H905"\w* \w of Sheol|strong="H7585"\w*?
\q2 \w -|strong="H518"\w* \w Will we go down|strong="H5181"\w* \w together|strong="H3162"\w* \w into|strong="H5921"\w* \w the dust|strong="H6083"\w*?”
\c 18
\s1 Bildad: God Punishes the Wicked
\p \v 1 \w Then Bildad|strong="H1085"\w* \w the Shuhite|strong="H7747"\w* \w . . .|strong="H559"\w* \w replied|strong="H6030"\w*:
\q1 \v 2 “\w How long|strong="H575"\w* \w until|strong="H5704"\w* \w you end|strong="H7760"\w* \w . . .|strong="H7078"\w* \w these speeches|strong="H4405"\w*?
\q2 \w Show some sense|strong="H995"\w*, \w and then|strong="H310"\w* \w we can talk|strong="H1696"\w*.
\q1 \v 3 \w Why|strong="H4069"\w* \w are we regarded|strong="H2803"\w* \w as cattle|strong="H929"\w*,
\q2 \w as stupid|strong="H2933"\w* \w in your sight|strong="H5869"\w*?
\q1 \v 4 \w You who tear|strong="H2963"\w* \w yourself|strong="H5315"\w* \w in anger|strong="H639"\w*—
\q2 \w should the earth|strong="H776"\w* \w be forsaken|strong="H5800"\w* \w on your account|strong="H4616"\w*,
\q2 \w or the rocks|strong="H6697"\w* \w be moved|strong="H6275"\w* \w from their place|strong="H4725"\w*?
\b 
\q1 \v 5 \w Indeed|strong="H1571"\w*, \w the lamp|strong="H216"\w* \w of the wicked|strong="H7563"\w* \w is extinguished|strong="H1846"\w*;
\q2 \w the flame|strong="H7632"\w* \w of his fire|strong="H784"\w* \w does not|strong="H3808"\w* \w glow|strong="H5050"\w*.
\q1 \v 6 \w The light|strong="H216"\w* \w in his tent|strong="H168"\w* \w grows dark|strong="H2821"\w*,
\q2 \w and the lamp|strong="H5216"\w* \w beside him|strong="H5921"\w* \w goes out|strong="H1846"\w*.
\q1 \v 7 \w His vigorous|strong="H202"\w* \w stride|strong="H6806"\w* \w is shortened|strong="H3334"\w*,
\q2 \w and his own schemes|strong="H6098"\w* \w trip him up|strong="H7993"\w*.
\q1 \v 8 \w For|strong="H3588"\w* \w his own feet|strong="H7272"\w* \w lead him|strong="H7971"\w* \w into a net|strong="H7568"\w*,
\q2 \w and he wanders|strong="H1980"\w* \w into|strong="H5921"\w* \w its mesh|strong="H7639"\w*.
\q1 \v 9 \w A trap|strong="H6341"\w* \w seizes|strong="H270"\w* \w his heel|strong="H6119"\w*;
\q2 \w a snare|strong="H6782"\w* \w grips him|strong="H2388"\w* \w . . .|strong="H5921"\w*.
\q1 \v 10 \w A noose|strong="H2256"\w* \w is hidden|strong="H2934"\w* \w in the ground|strong="H776"\w*,
\q2 \w and a trap|strong="H4434"\w* \w lies in|strong="H5921"\w* \w his path|strong="H5410"\w*.
\q1 \v 11 \w Terrors|strong="H1091"\w* \w frighten him|strong="H1204"\w* \w on every side|strong="H5439"\w*
\q2 \w and harass|strong="H6327"\w* \w his every step|strong="H7272"\w*.
\q1 \v 12 \w His strength|strong="H202"\w* \w is|strong="H1961"\w* \w depleted|strong="H7457"\w*,
\q2 \w and calamity|strong="H343"\w* \w [is] ready|strong="H3559"\w* \w at his side|strong="H6761"\w*.
\q1 \v 13 \w It devours|strong="H398"\w* \w patches|strong="H905"\w* \w of his skin|strong="H5785"\w*;
\q2 \w the firstborn|strong="H1060"\w* \w of death|strong="H4194"\w* \w devours|strong="H398"\w* \w his limbs|strong="H905"\w*.
\b 
\q1 \v 14 \w He is torn|strong="H5423"\w* \w from the shelter|strong="H4009"\w* \w of his tent|strong="H168"\w*
\q2 \w and is marched off|strong="H6805"\w* \w to the king|strong="H4428"\w* \w of terrors|strong="H1091"\w*.
\q1 \v 15 \w Fire|strong="H1097"\w* \w resides|strong="H7931"\w* \w in his tent|strong="H168"\w*;
\q2 \w burning sulfur|strong="H1614"\w* \w rains down|strong="H2219"\w* \w on|strong="H5921"\w* \w his dwelling|strong="H5116"\w*.
\q1 \v 16 \w The roots|strong="H8328"\w* \w beneath him|strong="H8478"\w* \w dry up|strong="H3001"\w*,
\q2 \w and the branches|strong="H7105"\w* \w above him|strong="H4605"\w* \w wither away|strong="H5243"\w*.
\q1 \v 17 \w The memory of him|strong="H2143"\w* \w perishes|strong="H6"\w* \w from|strong="H4480"\w* \w the earth|strong="H776"\w*,
\q2 and he has \w no|strong="H3808"\w* \w name|strong="H8034"\w* \w in|strong="H5921"\w*\w . . .|strong="H6440"\w* \w the land|strong="H2351"\w*.
\q1 \v 18 \w He is driven|strong="H1920"\w* \w from light|strong="H216"\w* \w into|strong="H413"\w* \w darkness|strong="H2822"\w*
\q2 \w and is chased|strong="H5074"\w* \w from the inhabited world|strong="H8398"\w*.
\q1 \v 19 \w He has no|strong="H3808"\w* \w offspring|strong="H5209"\w* \w -|strong="H3808"\w* \w or posterity|strong="H5220"\w* \w among his people|strong="H5971"\w*,
\q2 \w no|strong="H369"\w* \w survivor|strong="H8300"\w* \w where he once lived|strong="H4033"\w*.
\b 
\q1 \v 20 \w Those in the west|strong="H314"\w* \w are appalled|strong="H8074"\w* \w at|strong="H5921"\w* \w his fate|strong="H3117"\w*,
\q2 \w while those in the east|strong="H6931"\w* \w . . .|strong="H270"\w* \w tremble in horror|strong="H8178"\w*.
\q1 \v 21 \w Surely|strong="H389"\w* \w such|strong="H428"\w* \w is the dwelling|strong="H4908"\w* \w of the wicked|strong="H5767"\w*
\q2 \w [and]|strong="H2088"\w* \w the place|strong="H4725"\w* \w of one who does not|strong="H3808"\w* \w know|strong="H3045"\w* \w God|strong="H410"\w*.”
\c 19
\s1 Job: My Redeemer Lives
\p \v 1 \w Then Job|strong="H347"\w* \w . . .|strong="H559"\w* \w answered|strong="H6030"\w*:
\q1 \v 2 “\w How long|strong="H5704"\w* \w . . .|strong="H575"\w* \w will you torment|strong="H3013"\w* \w me|strong="H5315"\w*
\q2 \w and crush me|strong="H1792"\w* \w with [your] words|strong="H4405"\w*?
\q1 \v 3 \w Ten|strong="H6235"\w* \w times|strong="H6471"\w* \w now|strong="H2088"\w* \w you have reproached me|strong="H3637"\w*;
\q2 \w vvv|strong="H3808"\w* \w you shamelessly|strong="H954"\w* \w mistreat|strong="H1970"\w* me.
\q1 \v 4 \w Even if|strong="H637"\w* \w vvv|strong="H551"\w* \w I have truly gone astray|strong="H7686"\w*,
\q2 \w my error|strong="H4879"\w* \w concerns me|strong="H3885"\w* \w alone|strong="H854"\w*.
\q1 \v 5 \w If|strong="H518"\w* \w indeed|strong="H551"\w* \w you would exalt [yourselves]|strong="H1431"\w* \w above me|strong="H5921"\w*
\q2 \w and use my disgrace|strong="H2781"\w* \w . . .|strong="H3198"\w* \w against me|strong="H5921"\w*,
\q1 \v 6 \w then|strong="H645"\w* \w understand|strong="H3045"\w* \w that|strong="H3588"\w* \w it is God|strong="H433"\w* \w who has wronged me|strong="H5791"\w*
\q2 \w and drawn His net|strong="H4685"\w* \w around|strong="H5362"\w* \w me|strong="H5921"\w*.
\b 
\q1 \v 7 \w Though|strong="H2005"\w* \w I cry out|strong="H6817"\w*, ‘\w Violence|strong="H2555"\w*!’ \w I get no|strong="H3808"\w* \w response|strong="H6030"\w*;
\q2 \w though I call for help|strong="H7768"\w*, \w there is no|strong="H369"\w* \w justice|strong="H4941"\w*.
\q1 \v 8 \w He has blocked|strong="H1443"\w* \w my way|strong="H734"\w* \w so I cannot|strong="H3808"\w* \w pass|strong="H5674"\w*;
\q2 \w He has veiled|strong="H5921"\w* \w . . .|strong="H7760"\w* \w my paths|strong="H5410"\w* \w with darkness|strong="H2822"\w*.
\q1 \v 9 \w He has stripped me|strong="H6584"\w* \w of my honor|strong="H3519"\w* \w . . .|strong="H5921"\w*
\q2 \w and removed|strong="H5493"\w* \w the crown|strong="H5850"\w* \w from my head|strong="H7218"\w*.
\q1 \v 10 \w He tears me down|strong="H5422"\w* \w on every side|strong="H5439"\w* \w until I am gone|strong="H1980"\w*;
\q2 \w He uproots|strong="H5265"\w* \w my hope|strong="H8615"\w* \w like a tree|strong="H6086"\w*.
\q1 \v 11 \w His anger|strong="H639"\w* \w burns|strong="H2734"\w* \w against me|strong="H5921"\w*,
\q2 \w and He counts me|strong="H2803"\w* \w among His enemies|strong="H6862"\w*.
\q1 \v 12 \w His troops|strong="H1416"\w* \w advance|strong="H935"\w* \w together|strong="H3162"\w*;
\q2 \w they construct|strong="H5549"\w* \w a ramp|strong="H1870"\w* \w against me|strong="H5921"\w*
\q2 \w and encamp|strong="H2583"\w* \w around|strong="H5439"\w* \w my tent|strong="H168"\w*.
\b 
\q1 \v 13 \w He has removed|strong="H7368"\w* \w my brothers|strong="H251"\w* \w from me|strong="H5921"\w*;
\q2 \w my acquaintances|strong="H3045"\w* \w . . .|strong="H389"\w* \w have abandoned|strong="H2114"\w* \w me|strong="H4480"\w*.
\q1 \v 14 \w My kinsmen|strong="H7138"\w* \w have failed me|strong="H2308"\w*,
\q2 \w and my friends|strong="H3045"\w* \w have forgotten me|strong="H7911"\w*.
\q1 \v 15 \w My guests|strong="H1004"\w*\w . . .|strong="H1481"\w* \w and maidservants|strong="H519"\w* \w count me|strong="H2803"\w* \w as a stranger|strong="H2114"\w*;
\q2 \w I am|strong="H1961"\w* \w a foreigner|strong="H5237"\w* \w in their sight|strong="H5869"\w*.
\q1 \v 16 \w I call|strong="H7121"\w* \w for my servant|strong="H5650"\w*, \w but he does not|strong="H3808"\w* \w answer|strong="H6030"\w*,
\q2 \w though I implore|strong="H2603"\w* him \w with|strong="H1119"\w* \w my own mouth|strong="H6310"\w*.
\q1 \v 17 \w My breath|strong="H7307"\w* \w is repulsive|strong="H2114"\w* \w to my wife|strong="H802"\w*,
\q2 \w and I am loathsome|strong="H2603"\w* \w to my own family|strong="H1121"\w* \w . . .|strong="H990"\w*.
\q1 \v 18 \w Even|strong="H1571"\w* \w little boys|strong="H5759"\w* \w scorn|strong="H3988"\w* me;
\q2 \w when I appear|strong="H6965"\w*, \w they deride|strong="H1696"\w* me.
\q1 \v 19 \w All|strong="H3605"\w* \w my best friends|strong="H4962"\w* \w . . .|strong="H5475"\w* \w despise me|strong="H8581"\w*,
\q2 \w and those|strong="H2088"\w* \w I love|strong="H157"\w* \w have turned|strong="H2015"\w* against me.
\q1 \v 20 \w My skin|strong="H5785"\w* \w and flesh|strong="H1320"\w* \w cling|strong="H1692"\w* \w to my bones|strong="H6106"\w*;
\q2 \w I have escaped|strong="H4422"\w* \w by the skin|strong="H5785"\w* \w of my teeth|strong="H8127"\w*.
\b 
\q1 \v 21 \w Have pity on me|strong="H2603"\w*, \w my friends|strong="H7453"\w*, \w have pity|strong="H2603"\w* \w . . .|strong="H859"\w*,
\q2 \w for|strong="H3588"\w* \w the hand|strong="H3027"\w* \w of God|strong="H433"\w* \w has struck|strong="H5060"\w* me.
\q1 \v 22 \w Why|strong="H4100"\w* \w do you persecute me|strong="H7291"\w* \w as|strong="H3644"\w* \w God does|strong="H410"\w*?
\q2 \w Will you never|strong="H3808"\w* \w get enough|strong="H7646"\w* \w of my flesh|strong="H1320"\w*?
\b 
\q1 \v 23 \w I wish|strong="H4310"\w* \w . . .|strong="H5414"\w* \w . . .|strong="H645"\w* \w that my words|strong="H4405"\w* \w . . .|strong="H4310"\w* \w . . .|strong="H5414"\w* \w were recorded|strong="H3789"\w*
\q2 \w and inscribed|strong="H2710"\w* \w in a book|strong="H5612"\w*,
\q1 \v 24 \w by an iron|strong="H1270"\w* \w stylus|strong="H5842"\w* \w on lead|strong="H5777"\w*,
\q2 \w or chiseled|strong="H2672"\w* \w in stone|strong="H6697"\w* \w forever|strong="H5703"\w*.
\q1 \v 25 \w But I|strong="H589"\w* \w know|strong="H3045"\w* \w that my Redeemer|strong="H1350"\w*\f + \fr 19:25 \ft Or \fqa Vindicator\f* \w lives|strong="H2416"\w*,
\q2 \w and in the end|strong="H314"\w* \w He will stand|strong="H6965"\w* \w upon|strong="H5921"\w* \w the earth|strong="H6083"\w*.\f + \fr 19:25 \ft Or \fqa on my grave\f*
\q1 \v 26 \w Even after|strong="H310"\w* \w my skin|strong="H5785"\w* \w has been destroyed|strong="H5362"\w*,
\q2 \w . . .|strong="H2063"\w* \w yet in my flesh|strong="H1320"\w*\f + \fr 19:26 \ft Or \fqa without my flesh\f* \w I will see|strong="H2372"\w* \w God|strong="H433"\w*.
\q1 \v 27 \w I|strong="H589"\w* \w will see|strong="H2372"\w* \w Him|strong="H834"\w* for myself;
\q2 \w my eyes|strong="H5869"\w* \w will behold Him|strong="H7200"\w*, \w and not|strong="H3808"\w* \w as a stranger|strong="H2114"\w*.
\q2 \w How my heart|strong="H3629"\w* \w yearns|strong="H3615"\w*\f + \fr 19:27 \ft Hebrew \fqa my kidneys yearn\f* \w within me|strong="H2436"\w*!
\b 
\q1 \v 28 \w If|strong="H3588"\w* \w you say|strong="H559"\w*, ‘\w [Let us]|strong="H4100"\w* \w persecute|strong="H7291"\w* him,
\q2 \w since the root|strong="H8328"\w* \w of the matter|strong="H1697"\w* \w lies|strong="H4672"\w* with him,\f + \fr 19:28 \ft Many Hebrew manuscripts, LXX, and Vulgate; most Hebrew manuscripts \fqa with me\f*’
\q1 \v 29 \w [then] you should fear|strong="H1481"\w* \w . . .|strong="H6440"\w* \w the sword|strong="H2719"\w* yourselves,
\q2 \w because|strong="H3588"\w* \w wrath|strong="H2534"\w* \w brings punishment|strong="H5771"\w* \w by the sword|strong="H2719"\w*,
\q2 \w so that|strong="H4616"\w* \w you may know|strong="H3045"\w* \w [there is] a judgment|strong="H1779"\w*.”
\c 20
\s1 Zophar: Destruction Awaits the Wicked
\p \v 1 \w Then Zophar|strong="H6691"\w* \w the Naamathite|strong="H5284"\w* \w . . .|strong="H559"\w* \w replied|strong="H6030"\w*:
\q1 \v 2 “\w So|strong="H3651"\w* \w my anxious thoughts|strong="H5587"\w* \w compel me to answer|strong="H7725"\w*,
\q2 \w because|strong="H5668"\w* \w of the turmoil|strong="H2363"\w* within me.
\q1 \v 3 \w I have heard|strong="H8085"\w* \w . . .|strong="H7307"\w* \w a rebuke|strong="H4148"\w* \w that insults me|strong="H3639"\w*,
\q2 \w and my understanding|strong="H998"\w* \w prompts a reply|strong="H6030"\w*.
\b 
\q1 \v 4 \w Do you not know|strong="H3045"\w* \w that|strong="H2063"\w* \w from|strong="H4480"\w* \w antiquity|strong="H5703"\w*,
\q2 \w since|strong="H4480"\w* \w man|strong="H120"\w* \w was placed|strong="H7760"\w* \w on|strong="H5921"\w* \w the earth|strong="H776"\w*,
\q1 \v 5 \w -|strong="H3588"\w* \w the triumph|strong="H7445"\w* \w of the wicked|strong="H7563"\w* \w has been brief|strong="H7138"\w*
\q2 \w and the joy|strong="H8057"\w* \w of the godless|strong="H2611"\w* \w vvv|strong="H5704"\w* \w momentary|strong="H7281"\w*?
\q1 \v 6 \w Though|strong="H518"\w* \w his arrogance|strong="H7863"\w* \w reaches|strong="H5927"\w* \w the heavens|strong="H8064"\w*,
\q2 \w and his head|strong="H7218"\w* \w touches|strong="H5060"\w* \w the clouds|strong="H5645"\w*,
\q1 \v 7 \w he will perish|strong="H6"\w* \w forever|strong="H5331"\w*, \w like his own dung|strong="H1561"\w*;
\q2 \w those who had seen him|strong="H7200"\w* \w will ask|strong="H559"\w*, ‘\w Where is he|strong="H335"\w*?’
\q1 \v 8 \w He will fly away|strong="H5774"\w* \w like a dream|strong="H2472"\w*, \w never|strong="H3808"\w* \w to be found|strong="H4672"\w*;
\q2 \w he will be chased away|strong="H5074"\w* \w like a vision|strong="H2384"\w* \w in the night|strong="H3915"\w*.
\q1 \v 9 \w The eye|strong="H5869"\w* \w [that] saw him|strong="H7805"\w* \w will see him no|strong="H3808"\w* \w more|strong="H3254"\w*,
\q2 \w and his place|strong="H4725"\w* \w will no|strong="H3808"\w* \w longer|strong="H5750"\w* \w behold him|strong="H7789"\w*.
\q1 \v 10 \w His sons|strong="H1121"\w* \w will seek the favor|strong="H7521"\w* \w of the poor|strong="H1800"\w*,
