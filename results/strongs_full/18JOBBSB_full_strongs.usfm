\q2 \w when|strong="H3588"\w* \w distress|strong="H6869"\w* \w comes|strong="H935"\w* \w upon him|strong="H5921"\w*?
\q1 \v 10 \w Will he delight|strong="H6026"\w* \w in|strong="H5921"\w* \w the Almighty|strong="H7706"\w*?
\q2 \w Will he call upon|strong="H7121"\w* \w God|strong="H433"\w* \w at all|strong="H3605"\w* \w times|strong="H6256"\w* \w . . .|strong="H518"\w*?
\q1 \v 11 \w I will instruct|strong="H3384"\w* \w you|strong="H853"\w* \w in the power|strong="H3027"\w* \w of God|strong="H410"\w*.
\q2 \w I will not|strong="H3808"\w* \w conceal|strong="H3582"\w* \w the ways of|strong="H834"\w* \w . . .|strong="H5973"\w* \w the Almighty|strong="H7706"\w*.
\q1 \v 12 \w Surely|strong="H2005"\w* \w all of you|strong="H3605"\w* \w have seen [it]|strong="H2372"\w* \w for yourselves|strong="H859"\w*.
\q2 \w Why then|strong="H4100"\w* \w do you keep up this|strong="H2088"\w* \w empty talk|strong="H1892"\w* \w . . .|strong="H1891"\w*?
\b 
\q1 \v 13 \w This [is]|strong="H2088"\w* \w the wicked|strong="H7563"\w* \w man’s|strong="H120"\w* \w portion|strong="H2506"\w* \w from|strong="H5973"\w* \w God|strong="H410"\w* —
\q2 \w the heritage|strong="H5159"\w* \w the ruthless|strong="H6184"\w* \w receive|strong="H3947"\w* \w from the Almighty|strong="H7706"\w*.
\q1 \v 14 \w Though|strong="H518"\w* \w his sons|strong="H1121"\w* \w are many|strong="H7235"\w*, \w they are destined for|strong="H3926"\w* \w the sword|strong="H2719"\w*;
\q2 \w and his offspring|strong="H6631"\w* \w will never|strong="H3808"\w* \w have enough|strong="H7646"\w* \w food|strong="H3899"\w*.
