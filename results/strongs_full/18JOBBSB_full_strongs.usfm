\q2 \w and their widows|strong="H490"\w* \w will not|strong="H3808"\w* \w weep for them|strong="H1058"\w*.
\q1 \v 16 \w Though|strong="H518"\w* \w he heaps up|strong="H6651"\w* \w silver|strong="H3701"\w* \w like dust|strong="H6083"\w*
\q2 \w and piles up|strong="H3559"\w* \w a wardrobe|strong="H4403"\w* \w like clay|strong="H2563"\w*,
\q1 \v 17 \w what he lays up|strong="H3559"\w*, \w the righteous|strong="H6662"\w* \w will wear|strong="H3847"\w*,
\q2 \w and his silver|strong="H3701"\w* \w will be divided|strong="H2505"\w* \w by the innocent|strong="H5355"\w*.
\q1 \v 18 \w The house|strong="H1004"\w* \w he built|strong="H1129"\w* \w is like a moth’s cocoon|strong="H6211"\w*,
\q2 \w like a hut|strong="H5521"\w* \w set up|strong="H6213"\w* \w by a watchman|strong="H5341"\w*.
\q1 \v 19 \w He lies down|strong="H7901"\w* \w wealthy|strong="H6223"\w*, \w but will do so no more|strong="H3808"\w* \w . . .|strong="H622"\w*;
\q2 \w when he opens|strong="H6491"\w* \w his eyes|strong="H5869"\w*, \w all is gone|strong="H369"\w*.
\q1 \v 20 \w Terrors|strong="H1091"\w* \w overtake him|strong="H5381"\w* \w like a flood|strong="H4325"\w*;
\q2 \w a tempest|strong="H5492"\w* \w sweeps him away|strong="H1589"\w* \w in the night|strong="H3915"\w*.
\q1 \v 21 \w The east wind|strong="H6921"\w* \w carries him away|strong="H5375"\w*, \w and he is gone|strong="H1980"\w*;
\q2 \w it sweeps him|strong="H8175"\w* \w out of his place|strong="H4725"\w*.
\q1 \v 22 \w It hurls itself|strong="H7993"\w* \w against him|strong="H5921"\w* \w without|strong="H3808"\w* \w mercy|strong="H2550"\w*
\q2 \w as he flees headlong|strong="H1272"\w* \w . . .|strong="H1272"\w* \w from its power|strong="H3027"\w*.
\q1 \v 23 \w It claps|strong="H5606"\w* \w its hands|strong="H3709"\w* \w at him|strong="H5921"\w*
\q2 \w and hisses|strong="H8319"\w* \w him|strong="H5921"\w* \w out of his place|strong="H4725"\w*.[’’]
\c 28
\s1 Where Can Wisdom Be Found?
\q1 \v 1 “\w Surely|strong="H3588"\w* \w there is|strong="H3426"\w* \w a mine|strong="H4161"\w* \w for silver|strong="H3701"\w*
\q2 \w and a place|strong="H4725"\w* \w where gold|strong="H2091"\w* \w is refined|strong="H2212"\w*.
