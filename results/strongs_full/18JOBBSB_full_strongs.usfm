\q2 \w and copper|strong="H5154"\w* \w is smelted|strong="H6694"\w* \w from ore|strong="H68"\w*.
\q1 \v 3 \w [Man] puts|strong="H7760"\w* \w an end|strong="H7093"\w* \w to the darkness|strong="H2822"\w*;
\q2 \w he|strong="H1931"\w* \w probes|strong="H2713"\w* \w the farthest recesses|strong="H3605"\w* \w . . .|strong="H8503"\w*
\q2 \w for ore|strong="H68"\w* \w in deepest darkness|strong="H652"\w* \w . . .|strong="H6757"\w*.
\q1 \v 4 \w Far from|strong="H4480"\w* \w . . .|strong="H5973"\w* \w human habitation|strong="H1481"\w* \w he cuts|strong="H6555"\w* \w a shaft|strong="H5158"\w*
\q2 \w in places forgotten|strong="H7911"\w* \w by the foot of man|strong="H7272"\w*.
\q2 \w Far from men|strong="H582"\w* \w he dangles|strong="H1809"\w* \w and sways|strong="H5128"\w*.
\q1 \v 5 \w Food|strong="H3899"\w* \w may come|strong="H3318"\w* \w from|strong="H4480"\w* \w the earth|strong="H776"\w*,
\q2 \w but from below|strong="H8478"\w* \w it is transformed|strong="H2015"\w* \w as|strong="H3644"\w* \w by fire|strong="H784"\w*.
\q1 \v 6 \w Its rocks|strong="H68"\w* \w are the source|strong="H4725"\w* \w of sapphires|strong="H5601"\w*,
\q2 \w containing flecks|strong="H6083"\w* \w of gold|strong="H2091"\w*.
\q1 \v 7 \w No|strong="H3808"\w* \w bird of prey|strong="H5861"\w* \w knows|strong="H3045"\w* \w that path|strong="H5410"\w*;
\q2 \w no|strong="H3808"\w* \w falcon’s|strong="H344"\w* \w eye|strong="H5869"\w* \w has seen it|strong="H7805"\w*.
\q1 \v 8 \w Proud beasts|strong="H1121"\w* \w . . .|strong="H7830"\w* \w have never|strong="H3808"\w* \w trodden it|strong="H1869"\w*;
\q2 \w no|strong="H3808"\w* \w lion|strong="H7826"\w* \w has ever prowled|strong="H5710"\w* \w over it|strong="H5921"\w*.
\q1 \v 9 \w The miner strikes|strong="H7971"\w* \w . . .|strong="H3027"\w* \w the flint|strong="H2496"\w*;
\q2 \w he overturns|strong="H2015"\w* \w mountains|strong="H2022"\w* \w at their base|strong="H8328"\w*.
\q1 \v 10 \w He hews out|strong="H1234"\w* \w channels|strong="H2975"\w* \w in the rocks|strong="H6697"\w*,
\q2 \w and his eyes|strong="H5869"\w* \w spot|strong="H7200"\w* \w every|strong="H3605"\w* \w treasure|strong="H3366"\w*.
\q1 \v 11 \w He stops up|strong="H2280"\w*\f + \fr 28:11 \ft Hebrew; LXX and Vulgate \fqa He searches\f* \w the sources|strong="H1065"\w* \w of the streams|strong="H5104"\w*
\q2 \w to bring|strong="H3318"\w* \w what is hidden|strong="H8587"\w* \w to light|strong="H216"\w*.
\b 
\q1 \v 12 \w But where|strong="H370"\w* \w can wisdom|strong="H2451"\w* \w be found|strong="H4672"\w*,
\q2 \w and where|strong="H335"\w* \w does understanding|strong="H998"\w* \w . . .|strong="H2088"\w* \w dwell|strong="H4725"\w*?
\q1 \v 13 \w No|strong="H3808"\w* \w man|strong="H582"\w* \w can know|strong="H3045"\w* \w its value|strong="H6187"\w*,
\q2 \w nor|strong="H3808"\w* \w is it found|strong="H4672"\w* \w in the land|strong="H776"\w* \w of the living|strong="H2416"\w*.
\q1 \v 14 \w The ocean depths|strong="H8415"\w* \w say|strong="H559"\w*, ‘\w It [is]|strong="H1931"\w* \w not|strong="H3808"\w* in me,’
\q2 \w while the sea|strong="H3220"\w* \w declares|strong="H559"\w*, ‘\w [It is] not|strong="H369"\w* \w with me|strong="H5978"\w*.’
\q1 \v 15 \w It cannot|strong="H3808"\w* \w be bought|strong="H5414"\w* \w with|strong="H8478"\w* \w gold|strong="H5458"\w*,
\q2 \w nor [can]|strong="H3808"\w* \w its price|strong="H4242"\w* \w be weighed out|strong="H8254"\w* \w in silver|strong="H3701"\w*.
\q1 \v 16 \w It cannot|strong="H3808"\w* \w be valued|strong="H5541"\w* \w in the gold|strong="H3800"\w* \w of Ophir|strong="H211"\w*,
\q2 \w in precious|strong="H3368"\w* \w onyx|strong="H7718"\w* \w or sapphire|strong="H5601"\w*.
\q1 \v 17 \w Neither|strong="H3808"\w* \w gold|strong="H2091"\w* \w nor crystal|strong="H2137"\w* \w can compare to it|strong="H6186"\w*,
\q2 \w nor jewels|strong="H3627"\w* \w of fine gold|strong="H6337"\w* \w be exchanged for it|strong="H8545"\w*.
\q1 \v 18 \w Coral|strong="H7215"\w* \w and quartz|strong="H1378"\w* \w are unworthy|strong="H3808"\w* \w of mention|strong="H2142"\w*;
\q2 \w the price|strong="H4901"\w* \w of wisdom [is]|strong="H2451"\w* \w beyond rubies|strong="H6443"\w*.
\q1 \v 19 \w Topaz|strong="H6357"\w* \w from Cush|strong="H3568"\w*\f + \fr 28:19 \ft That is, the upper Nile region\f* \w cannot|strong="H3808"\w* \w compare to it|strong="H6186"\w*,
\q2 \w nor can it|strong="H3808"\w* \w be valued|strong="H5541"\w* \w in pure|strong="H2889"\w* \w gold|strong="H3800"\w*.
\b 
\q1 \v 20 \w From where|strong="H370"\w*, \w then, does wisdom|strong="H2451"\w* \w come|strong="H935"\w*,
\q2 \w and where|strong="H335"\w* \w . . .|strong="H2088"\w* \w does understanding|strong="H998"\w* \w dwell|strong="H4725"\w*?
\q1 \v 21 \w It is hidden|strong="H5956"\w* \w from the eyes|strong="H5869"\w* \w of every|strong="H3605"\w* \w living thing|strong="H2416"\w*
\q2 \w and concealed|strong="H5641"\w* \w from the birds|strong="H5775"\w* \w of the air|strong="H8064"\w*.
\q1 \v 22 \w Abaddon|strong="H11"\w*\f + \fr 28:22 \fqa Abaddon \ft means \fqa Destruction\ft .\f* \w and Death|strong="H4194"\w* \w say|strong="H559"\w*,
\q2 ‘\w We have heard|strong="H8085"\w* \w a rumor about it|strong="H8088"\w* \w -|strong="H241"\w*.’
\q1 \v 23 \w But God|strong="H430"\w* \w understands|strong="H995"\w* \w its way|strong="H1870"\w*,
\q2 \w and He|strong="H1931"\w* \w knows|strong="H3045"\w* \w -|strong="H853"\w* \w its place|strong="H4725"\w*.
\q1 \v 24 \w For|strong="H3588"\w* \w He|strong="H1931"\w* \w looks|strong="H5027"\w* \w to the ends|strong="H7098"\w* \w of the earth|strong="H776"\w*
\q2 \w and sees|strong="H7200"\w* \w everything|strong="H3605"\w* \w under|strong="H8478"\w* \w the heavens|strong="H8064"\w*.
\q1 \v 25 \w When God fixed|strong="H6213"\w* \w the weight|strong="H4948"\w* \w of the wind|strong="H7307"\w*
\q2 \w vvv|strong="H8505"\w* \w and measured out|strong="H4060"\w* \w the waters|strong="H4325"\w*,
\q1 \v 26 \w when He set|strong="H6213"\w* \w a limit|strong="H2706"\w* \w for the rain|strong="H4306"\w*
\q2 \w and a path|strong="H1870"\w* \w for the thunderbolt|strong="H2385"\w* \w . . .|strong="H6963"\w*,
\q1 \v 27 \w then|strong="H227"\w* \w He looked at [wisdom]|strong="H7200"\w* \w and appraised it|strong="H5608"\w*;
\q2 \w He established it|strong="H3559"\w* \w . . .|strong="H1571"\w* \w and searched it out|strong="H2713"\w*.
\q1 \v 28 \w And He said|strong="H559"\w* \w to man|strong="H120"\w*, ‘\w Behold|strong="H2005"\w*,
\q2 \w the fear|strong="H3374"\w* \w of the Lord|strong="H136"\w*, \w that [is]|strong="H1931"\w* \w wisdom|strong="H2451"\w*,
\q2 \w and to turn away|strong="H5493"\w* \w from evil|strong="H7451"\w* \w [is] understanding|strong="H998"\w*.’”
\c 29
\s1 Job’s Former Blessings
\p \v 1 \w And Job|strong="H347"\w* \w . . .|strong="H5375"\w* \w continued|strong="H3254"\w* \w his discourse|strong="H4912"\w* \w . . .|strong="H559"\w*:
\q1 \v 2 “\w How I long|strong="H4310"\w* \w . . .|strong="H5414"\w* \w for the months|strong="H3391"\w* \w gone by|strong="H6924"\w*,
\q2 \w for the days|strong="H3117"\w* \w when God|strong="H433"\w* \w watched over me|strong="H8104"\w*,
\q1 \v 3 \w when His lamp|strong="H5216"\w* \w shone|strong="H1984"\w* \w above|strong="H5921"\w* \w my head|strong="H7218"\w*,
\q2 \w and by His light|strong="H216"\w* \w I walked|strong="H1980"\w* \w through the darkness|strong="H2822"\w*,
\q1 \v 4 \w when|strong="H834"\w* \w I was|strong="H1961"\w* \w vvv|strong="H3117"\w* \w in my prime|strong="H2779"\w*,\f + \fr 29:4 \ft Hebrew \fqa in the time of my harvest\f*
\q2 \w when the friendship|strong="H5475"\w* \w of God|strong="H433"\w* \w rested on|strong="H5921"\w* \w my tent|strong="H168"\w*,
\q1 \v 5 \w when the Almighty|strong="H7706"\w* \w was still|strong="H5750"\w* \w with me|strong="H5978"\w*
\q2 \w and my children|strong="H5288"\w* \w were around me|strong="H5439"\w*,
\q1 \v 6 \w when my steps|strong="H1978"\w* \w were bathed|strong="H7364"\w* \w in cream|strong="H2529"\w*
\q2 \w and the rock|strong="H6697"\w* \w poured out|strong="H6694"\w* \w for me|strong="H5978"\w* \w streams|strong="H6388"\w* \w of oil|strong="H8081"\w*!
\b 
\q1 \v 7 \w When I went out|strong="H3318"\w* \w to the city|strong="H7176"\w* \w gate|strong="H8179"\w* \w . . .|strong="H5921"\w*
\q2 \w and took|strong="H3559"\w* \w my seat|strong="H4186"\w* \w in the public square|strong="H7339"\w*,
\q1 \v 8 \w the young men|strong="H5288"\w* \w saw me|strong="H7200"\w* \w and withdrew|strong="H2244"\w*,
\q2 \w and the old men|strong="H3453"\w* \w rose|strong="H6965"\w* \w to their feet|strong="H5975"\w*.
\q1 \v 9 \w The princes|strong="H8269"\w* \w refrained|strong="H6113"\w* \w from speaking|strong="H4405"\w*
\q2 \w and covered|strong="H7760"\w* \w their mouths|strong="H6310"\w* \w with their hands|strong="H3709"\w*.
\q1 \v 10 \w The voices|strong="H6963"\w* \w of the nobles|strong="H5057"\w* \w were hushed|strong="H2244"\w*,
\q2 \w and their tongues|strong="H3956"\w* \w stuck|strong="H1692"\w* \w to the roofs of their mouths|strong="H2441"\w*.
\q1 \v 11 \w For|strong="H3588"\w* \w those|strong="H241"\w* \w who heard me|strong="H8085"\w* \w called me blessed|strong="H833"\w*,
\q2 \w and those who|strong="H5869"\w* \w saw me|strong="H7200"\w* \w commended me|strong="H5749"\w*,
\q1 \v 12 \w because|strong="H3588"\w* \w I rescued|strong="H4422"\w* \w the poor|strong="H6041"\w* \w who cried out|strong="H7768"\w*
\q2 \w and the fatherless|strong="H3490"\w* \w who had no|strong="H3808"\w* \w helper|strong="H5826"\w*.
\q1 \v 13 \w The dying man|strong="H6"\w* \w . . .|strong="H5921"\w* \w . . .|strong="H935"\w* \w blessed me|strong="H1293"\w*,
\q2 \w and I made the widow’s|strong="H490"\w* \w heart|strong="H3820"\w* \w sing for joy|strong="H7442"\w*.
\q1 \v 14 \w I put on|strong="H3847"\w* \w righteousness|strong="H6664"\w*, \w and it clothed me|strong="H3847"\w*;
\q2 \w justice|strong="H4941"\w* \w was my robe|strong="H4598"\w* \w and my turban|strong="H6797"\w*.
\q1 \v 15 \w I [served as]|strong="H1961"\w* \w eyes|strong="H5869"\w* \w to the blind|strong="H5787"\w*
\q2 \w [and]|strong="H589"\w* \w as feet|strong="H7272"\w* \w to the lame|strong="H6455"\w*.
\q1 \v 16 \w I|strong="H595"\w* \w was a father|strong="H1"\w* \w to the needy|strong="H34"\w*,
\q2 \w and I took up|strong="H2713"\w* \w the case|strong="H7379"\w* \w of the stranger|strong="H3808"\w* \w . . .|strong="H3045"\w*.
\q1 \v 17 \w I shattered|strong="H7665"\w* \w the fangs|strong="H4973"\w* \w of the unjust|strong="H5767"\w*
\q2 \w and snatched|strong="H7993"\w* \w the prey|strong="H2964"\w* \w from his teeth|strong="H8127"\w*.
\b 
\q1 \v 18 \w So I thought|strong="H559"\w*: ‘\w I will die|strong="H1478"\w* \w in|strong="H5973"\w* \w my nest|strong="H7064"\w*
\q2 \w and multiply|strong="H7235"\w* \w my days|strong="H3117"\w* \w as the sand|strong="H2344"\w*.
\q1 \v 19 \w My roots|strong="H8328"\w* \w [will] spread out|strong="H6605"\w* \w to|strong="H413"\w* \w the waters|strong="H4325"\w*,
\q2 \w and the dew|strong="H2919"\w* \w will rest nightly|strong="H3885"\w* \w on my branches|strong="H7105"\w*.
\q1 \v 20 \w My glory|strong="H3519"\w* \w is [ever] new|strong="H2319"\w* \w within me|strong="H5978"\w*,
\q2 \w and my bow|strong="H7198"\w* \w is renewed|strong="H2498"\w* \w in my hand|strong="H3027"\w*.’
\b 
\q1 \v 21 \w Men listened|strong="H8085"\w* to me \w with expectation|strong="H3176"\w*,
\q2 \w waiting silently|strong="H1826"\w* \w for|strong="H3926"\w* \w my counsel|strong="H6098"\w*.
\q1 \v 22 \w After|strong="H310"\w* \w my words|strong="H1697"\w*, \w they spoke|strong="H8138"\w* \w no more|strong="H3808"\w*;
\q2 \w my speech|strong="H4405"\w* \w settled|strong="H5197"\w* \w on them like dew|strong="H5921"\w*.
\q1 \v 23 \w They waited|strong="H3176"\w* \w for me as for rain|strong="H4306"\w*
