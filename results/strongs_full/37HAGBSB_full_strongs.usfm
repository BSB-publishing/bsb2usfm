\q1 \v 22 \w I will overturn|strong="H2015"\w* \w royal|strong="H4467"\w* \w thrones|strong="H3678"\w*
\q2 \w and destroy|strong="H8045"\w* \w the power|strong="H2392"\w*
\q2 \w of the kingdoms|strong="H4467"\w* \w of the nations|strong="H1471"\w*.
\q1 \w I will overturn|strong="H2015"\w* \w chariots|strong="H4818"\w* \w and their riders|strong="H7392"\w*;
\q2 \w horses|strong="H5483"\w* \w and their riders|strong="H7392"\w* \w will fall|strong="H3381"\w*,
\q2 \w each|strong="H376"\w* \w by the sword|strong="H2719"\w* \w of his brother|strong="H251"\w*.
\q1 \v 23 \w On that|strong="H1931"\w* \w day|strong="H3117"\w*,
\q2 \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*,
\q1 \w I will take you|strong="H3947"\w*, \w My servant|strong="H5650"\w*,
\q2 \w Zerubbabel|strong="H2216"\w* \w son|strong="H1121"\w* \w of Shealtiel|strong="H7597"\w*,
\q2 \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*,
\q1 \w and I will make you|strong="H7760"\w* \w like My signet ring|strong="H2368"\w*,
\q2 \w for|strong="H3588"\w* \w I have chosen|strong="H977"\w* you,
\q2 \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*.”
