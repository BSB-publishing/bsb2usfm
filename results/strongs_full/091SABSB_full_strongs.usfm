\c 17
\s1 Goliath’s Challenge
\p \v 1 \w Now the Philistines|strong="H6430"\w* \w -|strong="H853"\w* \w gathered|strong="H622"\w* \w their forces|strong="H4264"\w* \w for war|strong="H4421"\w* \w . . .|strong="H622"\w* \w at Socoh|strong="H7755"\w* \w -|strong="H834"\w* \w in Judah|strong="H3063"\w*, \w and they camped|strong="H2583"\w* \w between|strong="H996"\w* \w Socoh|strong="H7755"\w* \w . . .|strong="H996"\w* \w and Azekah|strong="H5825"\w* \w vvv|strong="H658"\w* \w in Ephes-dammim|strong="H658"\w*. \v 2 \w Saul|strong="H7586"\w* \w and the men|strong="H376"\w* \w of Israel|strong="H3478"\w* \w assembled|strong="H622"\w* \w and camped|strong="H2583"\w* \w in the Valley|strong="H6010"\w* \w of Elah|strong="H425"\w*, \w arraying themselves|strong="H6186"\w* \w for battle|strong="H4421"\w* \w against|strong="H7122"\w* \w the Philistines|strong="H6430"\w*.
