\p \v 10 “\w Good|strong="H2896"\w*,” \w . . .|strong="H1697"\w* \w said|strong="H559"\w* \w Saul|strong="H7586"\w* \w to his servant|strong="H5288"\w*. “\w Come|strong="H1980"\w*, \w let us go|strong="H1980"\w*.” \w So they set out|strong="H1980"\w* \w for|strong="H413"\w* \w the city|strong="H5892"\w* \w -|strong="H834"\w* \w where|strong="H8033"\w* \w the man|strong="H376"\w* \w of God was|strong="H430"\w*. \v 11 \w And as they|strong="H1992"\w* \w were climbing|strong="H5927"\w* \w the hill|strong="H4608"\w* \w to the city|strong="H5892"\w*, \w they|strong="H1992"\w* \w met|strong="H4672"\w* \w some young women|strong="H5291"\w* \w coming out|strong="H3318"\w* \w to draw|strong="H7579"\w* \w water|strong="H4325"\w* \w and asked|strong="H559"\w*, “\w Is|strong="H3426"\w* \w the seer here|strong="H7203"\w* \w . . .|strong="H2088"\w*?”
