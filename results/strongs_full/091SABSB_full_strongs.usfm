\p \v 14 \w The cart|strong="H5699"\w* \w came|strong="H935"\w* \w to|strong="H413"\w* \w the field|strong="H7704"\w* \w of Joshua|strong="H3091"\w* \w vvv|strong="H1030"\w* \w of Beth-shemesh|strong="H1030"\w* \w and stopped|strong="H5975"\w* \w there|strong="H8033"\w* \w . . .|strong="H8033"\w* \w near a large|strong="H1419"\w* \w rock|strong="H68"\w*. \w The people chopped up|strong="H1234"\w* \w -|strong="H853"\w* \w -|strong="H6086"\w* \w the cart|strong="H5699"\w* \w -|strong="H853"\w* \w and offered|strong="H5927"\w* \w the cows|strong="H6510"\w* \w as a burnt offering|strong="H5930"\w* \w to the LORD|strong="H3068"\w*. \v 15 \w And the Levites|strong="H3881"\w* \w took down|strong="H3381"\w* \w -|strong="H853"\w* \w the ark|strong="H727"\w* \w of the LORD|strong="H3068"\w* \w and|strong="H853"\w* \w the chest|strong="H712"\w* \w containing|strong="H834"\w* \w . . .|strong="H854"\w* \w -|strong="H834"\w* - \w the gold|strong="H2091"\w* \w objects|strong="H3627"\w*, \w and they placed them|strong="H7760"\w* \w on|strong="H413"\w* \w the large|strong="H1419"\w* \w rock|strong="H68"\w*. \w That|strong="H1931"\w* \w day|strong="H3117"\w* \w the men|strong="H582"\w* \w vvv|strong="H1053"\w* \w of Beth-shemesh|strong="H1053"\w* \w offered|strong="H5927"\w* \w burnt offerings|strong="H5930"\w* \w and made|strong="H2076"\w* \w sacrifices|strong="H2077"\w* \w to the LORD|strong="H3068"\w*.
