\p \v 4 \w But when they got up early|strong="H7925"\w* \w the next|strong="H4283"\w* \w morning|strong="H1242"\w*, \w there|strong="H2009"\w* \w was Dagon|strong="H1712"\w*, \w fallen|strong="H5307"\w* \w on his face|strong="H6440"\w* \w . . .|strong="H776"\w* \w before|strong="H6440"\w* \w the ark|strong="H727"\w* \w of the LORD|strong="H3068"\w*, \w with [his] head|strong="H7218"\w* \w . . .|strong="H1712"\w* \w -|strong="H8147"\w* \w [and]|strong="H3709"\w* \w his hands|strong="H3027"\w* \w broken off|strong="H3772"\w* \w and lying on|strong="H413"\w* \w the threshold|strong="H4670"\w*. \w Only|strong="H7535"\w* \w [the torso]|strong="H1712"\w* \w remained|strong="H7604"\w* \w . . .|strong="H5921"\w*. \v 5 \w That is why|strong="H5921"\w* \w . . .|strong="H3651"\w*, \w to|strong="H5704"\w* \w this|strong="H2088"\w* \w day|strong="H3117"\w*, \w the priests|strong="H3548"\w* \w of Dagon|strong="H1712"\w* \w and all|strong="H3605"\w* \w who enter|strong="H935"\w* \w the temple|strong="H1004"\w* \w of Dagon|strong="H1712"\w* \w in Ashdod|strong="H795"\w* \w do not|strong="H3808"\w* \w step|strong="H1869"\w* \w on|strong="H5921"\w* \w the threshold|strong="H4670"\w* \w . . .|strong="H1712"\w*.
