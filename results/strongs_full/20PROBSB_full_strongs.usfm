\c 25
\s1 More Proverbs of Solomon
\p \v 1 \w These [are]|strong="H428"\w* \w additional|strong="H1571"\w* \w proverbs|strong="H4912"\w* \w of Solomon|strong="H8010"\w*, \w which|strong="H834"\w* \w were copied by|strong="H6275"\w* \w the men|strong="H582"\w* \w of Hezekiah|strong="H2396"\w* \w king|strong="H4428"\w* \w of Judah|strong="H3063"\w*:
