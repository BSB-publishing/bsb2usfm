\c 31
\s1 The Sayings for King Lemuel
\p \v 1 \w [These are] the words|strong="H1697"\w* \w of King|strong="H4428"\w* \w Lemuel|strong="H3927"\w* — \w the burden|strong="H4853"\w* \w that|strong="H834"\w* \w his mother|strong="H517"\w* \w taught him|strong="H3256"\w*:
\q1 \v 2 \w What [shall I say]|strong="H4100"\w*,\f + \fr 31:2 \ft Or \fqa What \ft or \fqa What are you doing\f* \w O my son|strong="H1248"\w*?
\q2 \w What|strong="H4100"\w*, \w O son|strong="H1248"\w* \w of my womb|strong="H990"\w*?
\q2 \w What|strong="H4100"\w*, \w O son|strong="H1248"\w* \w of my vows|strong="H5088"\w*?
\q1 \v 3 \w Do not|strong="H408"\w* \w spend|strong="H5414"\w* \w your strength|strong="H2428"\w* \w on women|strong="H802"\w*
\q2 \w or your vigor|strong="H1870"\w* \w on those who ruin|strong="H4229"\w* \w kings|strong="H4428"\w*.
\q1 \v 4 \w It is not|strong="H408"\w* \w for kings|strong="H4428"\w*, \w O Lemuel|strong="H3927"\w*,
\q2 \w it is not|strong="H408"\w* \w for kings|strong="H4428"\w* \w to drink|strong="H8354"\w* \w wine|strong="H3196"\w*,
\q2 \w or for rulers|strong="H7336"\w* \w [to crave]|strong="H176"\w* \w strong drink|strong="H7941"\w*,
\q1 \v 5 \w lest|strong="H6435"\w* \w they drink|strong="H8354"\w* \w and forget|strong="H7911"\w* \w what is decreed|strong="H2710"\w*,
\q2 \w depriving|strong="H8138"\w* \w all|strong="H3605"\w* \w the oppressed|strong="H1121"\w* \w . . .|strong="H6040"\w* \w of justice|strong="H1779"\w*.
\b 
\q1 \v 6 \w Give|strong="H5414"\w* \w strong drink|strong="H7941"\w* \w to one who is perishing|strong="H6"\w*,
\q2 \w and wine|strong="H3196"\w* \w to the bitter|strong="H4751"\w* \w in soul|strong="H5315"\w*.
\q1 \v 7 \w Let him drink|strong="H8354"\w* \w and forget|strong="H7911"\w* \w his poverty|strong="H7389"\w*,
\q2 \w and remember|strong="H2142"\w* \w his misery|strong="H5999"\w* \w no|strong="H3808"\w* \w more|strong="H5750"\w*.
\b 
\q1 \v 8 \w Open|strong="H6605"\w* \w your mouth|strong="H6310"\w* \w for those with no voice|strong="H483"\w*,
\q2 \w for|strong="H413"\w* \w the cause|strong="H1779"\w* \w of all|strong="H3605"\w* \w the dispossessed|strong="H1121"\w* \w . . .|strong="H2475"\w*.
\q1 \v 9 \w Open|strong="H6605"\w* \w your mouth|strong="H6310"\w*, \w judge|strong="H8199"\w* \w righteously|strong="H6664"\w*,
\q2 \w and defend the cause|strong="H1777"\w* \w of the poor|strong="H6041"\w* \w and needy|strong="H34"\w*.
\s1 The Virtues of a Noble Woman
\q1 \v 10 \w A wife|strong="H802"\w*\f + \fr 31:10 \ft \ref Verses 10–31|10-31\ref* are an acrostic poem, each verse beginning with the successive letters of the Hebrew alphabet.\f* \w of noble character|strong="H2428"\w*, \w who|strong="H4310"\w* \w can find|strong="H4672"\w*?
\q2 \w She is far|strong="H7350"\w* \w more precious|strong="H4377"\w* \w than rubies|strong="H6443"\w*.
\b 
\q1 \v 11 \w The heart|strong="H3820"\w* \w of her husband|strong="H1167"\w* \w trusts|strong="H982"\w* in her,
\q2 \w and he lacks|strong="H2637"\w* \w nothing|strong="H3808"\w* \w of value|strong="H7998"\w*.
\q1 \v 12 \w She brings him|strong="H1580"\w* \w good|strong="H2896"\w* \w and not|strong="H3808"\w* \w harm|strong="H7451"\w*
\q2 \w all|strong="H3605"\w* \w the days|strong="H3117"\w* \w of her life|strong="H2416"\w*.
\q1 \v 13 \w She selects|strong="H1875"\w* \w wool|strong="H6785"\w* \w and flax|strong="H6593"\w*
\q2 \w and works|strong="H6213"\w* \w with eager|strong="H2656"\w* \w hands|strong="H3709"\w*.
\q1 \v 14 \w She is|strong="H1961"\w* \w like the merchant|strong="H5503"\w* \w ships|strong="H591"\w*,
\q2 \w bringing|strong="H935"\w* \w her food|strong="H3899"\w* \w from afar|strong="H4801"\w*.
\b 
\q1 \v 15 \w She rises|strong="H6965"\w* \w while it is still|strong="H5750"\w* \w night|strong="H3915"\w*
\q2 \w to provide|strong="H5414"\w* \w food|strong="H2964"\w* \w for her household|strong="H1004"\w*
\q2 \w and portions|strong="H2706"\w* \w for her maidservants|strong="H5291"\w*.
\q1 \v 16 \w She appraises|strong="H2161"\w* \w a field|strong="H7704"\w* \w and buys it|strong="H3947"\w*;
\q2 \w from her earnings|strong="H6529"\w* \w . . .|strong="H3709"\w* \w she plants|strong="H5193"\w* \w a vineyard|strong="H3754"\w*.
\q1 \v 17 \w She girds herself|strong="H2296"\w* \w . . .|strong="H4975"\w*\f + \fr 31:17 \ft Hebrew \fqa She girds her loins\f* \w with strength|strong="H5797"\w*
\q2 \w and shows that her arms|strong="H2220"\w* \w are strong|strong="H553"\w*.
\q1 \v 18 \w She sees|strong="H2938"\w* \w that|strong="H3588"\w* \w her gain|strong="H5504"\w* \w [is] good|strong="H2896"\w*,
\q2 \w and her lamp|strong="H5216"\w* \w is not|strong="H3808"\w* \w extinguished|strong="H3518"\w* \w at night|strong="H3915"\w*.
\q1 \v 19 \w She stretches|strong="H7971"\w* \w out her hands|strong="H3027"\w* \w to the distaff|strong="H3601"\w*
\q2 \w and grasps|strong="H8551"\w* \w the spindle|strong="H6418"\w* \w with her fingers|strong="H3709"\w*.
\b 
\q1 \v 20 \w She opens|strong="H6566"\w* \w her arms|strong="H3709"\w* \w to the poor|strong="H6041"\w*
\q2 \w and reaches out|strong="H7971"\w* \w her hands|strong="H3027"\w* \w to the needy|strong="H34"\w*.
\q1 \v 21 \w When it snows|strong="H7950"\w*, \w she has no|strong="H3808"\w* \w fear|strong="H3372"\w* \w for her household|strong="H1004"\w*,
\q2 \w for|strong="H3588"\w* \w [they are] all|strong="H3605"\w* \w . . .|strong="H1004"\w* \w clothed|strong="H3847"\w* \w in scarlet|strong="H8144"\w*.\f + \fr 31:21 \ft Or \fqa doubly clothed\f*
\q1 \v 22 \w She makes|strong="H6213"\w* \w coverings for her bed|strong="H4765"\w*;
\q2 \w her clothing|strong="H3830"\w* \w is fine linen|strong="H8336"\w* \w and purple|strong="H713"\w*.
\q1 \v 23 \w Her husband|strong="H1167"\w* \w is known|strong="H3045"\w* \w at the city gates|strong="H8179"\w*,
\q2 \w where he sits|strong="H3427"\w* \w among|strong="H5973"\w* \w the elders|strong="H2205"\w* \w of the land|strong="H776"\w*.
\q1 \v 24 \w She makes|strong="H6213"\w* \w linen garments|strong="H5466"\w* \w and sells [them]|strong="H4376"\w*;
\q2 \w she delivers|strong="H5414"\w* \w sashes|strong="H2290"\w* \w to the merchants|strong="H3669"\w*.
\b 
\q1 \v 25 \w Strength|strong="H5797"\w* \w and honor|strong="H1926"\w* \w are her clothing|strong="H3830"\w*,
\q2 \w and she can laugh|strong="H7832"\w* \w at the days|strong="H3117"\w* \w to come|strong="H314"\w*.
\q1 \v 26 \w She opens|strong="H6605"\w* \w her mouth|strong="H6310"\w* \w with wisdom|strong="H2451"\w*,
\q2 \w and faithful|strong="H2617"\w* \w instruction|strong="H8451"\w* \w is on|strong="H5921"\w* \w her tongue|strong="H3956"\w*.
\q1 \v 27 \w She watches over|strong="H6822"\w* \w the affairs|strong="H1979"\w* \w of her household|strong="H1004"\w*
\q2 \w and does not|strong="H3808"\w* \w eat|strong="H398"\w* \w the bread|strong="H3899"\w* \w of idleness|strong="H6104"\w*.
\q1 \v 28 \w Her children|strong="H1121"\w* \w rise up|strong="H6965"\w* \w and call her blessed|strong="H833"\w*;
\q2 \w her husband|strong="H1167"\w* \w praises her as well|strong="H1984"\w*:
\q1 \v 29 “\w Many|strong="H7227"\w* \w daughters|strong="H1323"\w* \w have done|strong="H6213"\w* \w noble things|strong="H2428"\w*,
\q2 \w but you|strong="H859"\w* \w surpass|strong="H5927"\w* \w them|strong="H5921"\w* \w all|strong="H3605"\w*!”
\b 
\q1 \v 30 \w Charm|strong="H2580"\w* \w is deceptive|strong="H8267"\w* \w and beauty|strong="H3308"\w* \w is fleeting|strong="H1892"\w*,
\q2 \w but a woman|strong="H802"\w* \w who fears|strong="H3373"\w* \w the LORD|strong="H3068"\w* \w -|strong="H1931"\w* \w is to be praised|strong="H1984"\w*.
\q1 \v 31 \w Give|strong="H5414"\w* her \w the fruit|strong="H6529"\w* \w of her hands|strong="H3027"\w*,
\q2 \w and let her works|strong="H4639"\w* \w praise her|strong="H1984"\w* \w at the gates|strong="H8179"\w*.
