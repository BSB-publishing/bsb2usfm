\li1 \v 27 \w Shimei|strong="H8096"\w* \w had sixteen|strong="H8337"\w* \w sons|strong="H1121"\w* \w and six|strong="H8337"\w* \w daughters|strong="H1323"\w*, \w but his brothers|strong="H251"\w* \w did not|strong="H369"\w* \w have many|strong="H7227"\w* \w children|strong="H1121"\w*, \w so their whole|strong="H3605"\w* \w clan|strong="H4940"\w* \w did not|strong="H3808"\w* \w become as numerous|strong="H7235"\w* \w as|strong="H5704"\w* \w the sons|strong="H1121"\w* \w of Judah|strong="H3063"\w*. \v 28 \w They lived|strong="H3427"\w* \w in Beersheba|strong="H884"\w*, \w Moladah|strong="H4137"\w*, \w Hazar-shual|strong="H2705"\w*, \v 29 \w Bilhah|strong="H1090"\w*, \w Ezem|strong="H6107"\w*, \w Tolad|strong="H8434"\w*, \v 30 \w Bethuel|strong="H1328"\w*, \w Hormah|strong="H2767"\w*, \w Ziklag|strong="H6860"\w*, \v 31 \w Beth-marcaboth|strong="H1024"\w*, \w Hazar-susim|strong="H2702"\w*, \w Beth-biri|strong="H1011"\w*, \w and Shaaraim|strong="H8189"\w*. \w These|strong="H428"\w* \w were their cities|strong="H5892"\w* \w until|strong="H5704"\w* \w the reign|strong="H4427"\w* \w of David|strong="H1732"\w*. \v 32 \w And their villages|strong="H2691"\w* \w were Etam|strong="H5862"\w*, \w Ain|strong="H5871"\w*, \w Rimmon|strong="H7417"\w*, \w Tochen|strong="H8507"\w*, \w and Ashan|strong="H6228"\w*— \w five|strong="H2568"\w* \w towns|strong="H5892"\w*— \v 33 \w and all|strong="H3605"\w* \w their surrounding|strong="H5439"\w* \w villages|strong="H2691"\w* \w as|strong="H5704"\w* \w far as Baal|strong="H1168"\w*.\f + \fr 4:33 \ft Hebrew; some LXX manuscripts (see also \ref Joshua 19:8|JOS 19:8\ref*) \fqa Baalath\f* \w These|strong="H2063"\w* \w were their settlements|strong="H4186"\w*, \w and they kept a genealogical record|strong="H3187"\w*:
\li2 \v 34 \w Meshobab|strong="H4877"\w*, \w Jamlech|strong="H3230"\w*, \w Joshah|strong="H3144"\w* \w son|strong="H1121"\w* \w of Amaziah|strong="H558"\w*, \v 35 \w Joel|strong="H3100"\w*, \w Jehu|strong="H3058"\w* \w son|strong="H1121"\w* \w of Joshibiah|strong="H3143"\w* (\w son|strong="H1121"\w* \w of Seraiah|strong="H8304"\w*, \w son|strong="H1121"\w* \w of Asiel|strong="H6221"\w*), \v 36 \w Elioenai|strong="H454"\w*, \w Jaakobah|strong="H3291"\w*, \w Jeshohaiah|strong="H3439"\w*, \w Asaiah|strong="H6222"\w*, \w Adiel|strong="H5717"\w*, \w Jesimiel|strong="H3450"\w*, \w Benaiah|strong="H1141"\w*, \v 37 \w and Ziza|strong="H2124"\w* \w son|strong="H1121"\w* \w of Shiphi|strong="H8230"\w* (\w son|strong="H1121"\w* \w of Allon|strong="H438"\w*, \w son|strong="H1121"\w* \w of Jedaiah|strong="H3042"\w*, \w son|strong="H1121"\w* \w of Shimri|strong="H8113"\w*, \w son|strong="H1121"\w* \w of Shemaiah|strong="H8098"\w*).
\b 
\li1 \v 38 \w These men|strong="H428"\w* \w listed|strong="H935"\w* \w by name|strong="H8034"\w* \w were the leaders|strong="H5387"\w* \w of their clans|strong="H4940"\w*. \w Their families|strong="H1"\w* \w increased|strong="H6555"\w* \w greatly|strong="H7230"\w*, \v 39 \w and they journeyed|strong="H1980"\w* \w to the entrance|strong="H3996"\w* \w of Gedor|strong="H1446"\w*, \w to the east side|strong="H4217"\w* \w of the valley|strong="H1516"\w*, \w in search of|strong="H1245"\w* \w pasture|strong="H4829"\w* \w for their flocks|strong="H6629"\w*. \v 40 \w There they found|strong="H4672"\w* \w rich|strong="H8082"\w*, \w good|strong="H2896"\w* \w pasture|strong="H4829"\w*, \w and the land|strong="H776"\w* \w was spacious|strong="H7342"\w*, \w peaceful|strong="H8252"\w*, \w and quiet|strong="H7961"\w*; \w for|strong="H3588"\w* \w some|strong="H4480"\w* \w Hamites|strong="H2526"\w* \w had lived|strong="H3427"\w* \w there|strong="H8033"\w* \w formerly|strong="H6440"\w*.
\b 
\li1 \v 41 \w These|strong="H428"\w* \w who were noted|strong="H3789"\w* \w by name|strong="H8034"\w* \w came|strong="H935"\w* \w in the days|strong="H3117"\w* \w of Hezekiah|strong="H2396"\w* \w king of|strong="H4428"\w* \w Judah|strong="H3063"\w*. \w They attacked the Hamites|strong="H5221"\w* \w in their dwellings|strong="H168"\w* \w as well as|strong="H853"\w* \w the Meunites|strong="H4586"\w* \w who|strong="H834"\w* \w were|strong="H4672"\w* \w there|strong="H8033"\w*, \w devoting them to destruction|strong="H2763"\w*\f + \fr 4:41 \ft Forms of the Hebrew \fqa cherem \ft refer to the giving over of things or persons to the LORD, either by destroying them or by giving them as an offering.\f* \w even to|strong="H5704"\w* \w this|strong="H2088"\w* \w day|strong="H3117"\w*. \w Then they settled|strong="H3427"\w* \w in their place|strong="H8478"\w*, \w because|strong="H3588"\w* \w there was pasture|strong="H4829"\w* \w for their flocks|strong="H6629"\w*. \v 42 And \w five|strong="H2568"\w* \w hundred|strong="H3967"\w* \w of these Simeonites|strong="H8095"\w* \w led by|strong="H7218"\w* \w Pelatiah|strong="H6410"\w*, \w Neariah|strong="H5294"\w*, \w Rephaiah|strong="H7509"\w*, \w and Uzziel|strong="H5816"\w*, \w the sons|strong="H1121"\w* \w of Ishi|strong="H3469"\w*, \w went|strong="H1980"\w* \w to Mount|strong="H2022"\w* \w Seir|strong="H8165"\w* \v 43 \w and struck down|strong="H5221"\w* \w the remnant|strong="H7611"\w* \w of the Amalekites|strong="H6002"\w* \w who had escaped|strong="H6413"\w*. \w And they have lived|strong="H3427"\w* \w there|strong="H8033"\w* \w to|strong="H5704"\w* \w this|strong="H2088"\w* \w day|strong="H3117"\w*.
\c 5
\s1 The Descendants of Reuben
\p \v 1 \w These were the sons|strong="H1121"\w* \w of Reuben|strong="H7205"\w* \w the firstborn|strong="H1060"\w* \w of Israel|strong="H3478"\w*. \w Though he|strong="H1931"\w* \w was the firstborn|strong="H1060"\w*, \w his birthright|strong="H1062"\w* \w was given|strong="H5414"\w* \w to the sons|strong="H1121"\w* \w of Joseph|strong="H3130"\w* \w son|strong="H1121"\w* \w of Israel|strong="H3478"\w*, \w because Reuben defiled|strong="H2490"\w* \w his father’s|strong="H1"\w* \w bed|strong="H3326"\w*. \w So he is not|strong="H3808"\w* \w reckoned|strong="H3187"\w* \w according to birthright|strong="H1062"\w*. \v 2 \w And though|strong="H3588"\w* \w Judah|strong="H3063"\w* \w prevailed|strong="H1396"\w* \w over his brothers|strong="H251"\w* \w and a ruler|strong="H5057"\w* \w came from him|strong="H4480"\w*, \w the birthright|strong="H1062"\w* \w belonged to Joseph|strong="H3130"\w*. \v 3 \w The sons|strong="H1121"\w* \w of Reuben|strong="H7205"\w*, \w the firstborn|strong="H1060"\w* \w of Israel|strong="H3478"\w*:
\b 
\q1 \w Hanoch|strong="H2585"\w*, \w Pallu|strong="H6396"\w*, \w Hezron|strong="H2696"\w*, \w and Carmi|strong="H3756"\w*.
\b 
\li1 \v 4 \w The descendants|strong="H1121"\w* \w of Joel|strong="H3100"\w*:
\li2 \w Shemaiah|strong="H8098"\w* \w his son|strong="H1121"\w*, \w Gog|strong="H1463"\w* \w his son|strong="H1121"\w*, \w Shimei|strong="H8096"\w* \w his son|strong="H1121"\w*, \v 5 \w Micah|strong="H4318"\w* \w his son|strong="H1121"\w*, \w Reaiah|strong="H7211"\w* \w his son|strong="H1121"\w*, \w Baal|strong="H1168"\w* \w his son|strong="H1121"\w*, \v 6 \w and Beerah|strong="H880"\w* \w his son|strong="H1121"\w*, \w whom|strong="H834"\w* \w Tiglath-pileser|strong="H8407"\w*\f + \fr 5:6 \ft Hebrew \fqa Tilgath-pilneser\ft , a variant spelling of \fqa Tiglath-pileser\ft ; also in verse 26\f* \w king|strong="H4428"\w* \w of Assyria|strong="H804"\w* \w carried into exile|strong="H1540"\w*.
\b 
\li1 \w Beerah|strong="H1931"\w* \w was a leader|strong="H5387"\w* \w of the Reubenites|strong="H7206"\w*. \v 7 \w His relatives|strong="H251"\w* \w by their clans|strong="H4940"\w* \w are recorded|strong="H3187"\w* \w in their genealogy|strong="H8435"\w*:
\li2 \w Jeiel|strong="H3273"\w* \w the chief|strong="H7218"\w*, \w Zechariah|strong="H2148"\w*, \v 8 \w and Bela|strong="H1106"\w* \w son|strong="H1121"\w* \w of Azaz|strong="H5811"\w*, \w the son|strong="H1121"\w* \w of Shema|strong="H8087"\w*, \w the son|strong="H1121"\w* \w of Joel|strong="H3100"\w*. \w They|strong="H1931"\w* \w settled|strong="H3427"\w* \w in Aroer|strong="H6177"\w* \w and as far as|strong="H5704"\w* \w Nebo|strong="H5015"\w* \w and Baal-meon|strong="H1186"\w*. \v 9 \w They also settled|strong="H3427"\w* \w in the east|strong="H4217"\w* \w as far as|strong="H5704"\w* \w the edge of the desert|strong="H4057"\w* \w that extends|strong="H4480"\w* \w to the Euphrates|strong="H6578"\w* \w River|strong="H5104"\w*, \w because|strong="H3588"\w* \w their livestock|strong="H4735"\w* \w had increased|strong="H7235"\w* \w in the land|strong="H776"\w* \w of Gilead|strong="H1568"\w*.
\li2 \v 10 \w During the days|strong="H3117"\w* \w of Saul|strong="H7586"\w* \w they waged|strong="H6213"\w* \w war|strong="H4421"\w* \w against|strong="H5973"\w* \w the Hagrites|strong="H1905"\w*, \w who were defeated|strong="H5307"\w* \w at their hands|strong="H3027"\w*, \w and they occupied|strong="H3427"\w* \w the dwellings of the Hagrites|strong="H168"\w* \w throughout|strong="H5921"\w* \w the region|strong="H6440"\w* \w east|strong="H4217"\w* \w of Gilead|strong="H1568"\w*.
\s1 The Descendants of Gad
\p \v 11 \w The descendants|strong="H1121"\w* \w of Gad|strong="H1410"\w* \w lived|strong="H3427"\w* \w next to the Reubenites|strong="H5048"\w* \w in the land|strong="H776"\w* \w of Bashan|strong="H1316"\w*, \w as|strong="H5704"\w* \w far as Salecah|strong="H5548"\w*:
\b 
\li1 \v 12 \w Joel was|strong="H3100"\w* \w the chief|strong="H7218"\w*, \w Shapham|strong="H8223"\w* \w the second|strong="H4932"\w*, \w then Jaanai|strong="H3285"\w* \w and Shaphat|strong="H8202"\w*, \w who lived in Bashan|strong="H1316"\w*.
\b 
\li1 \v 13 \w Their kinsmen|strong="H251"\w* \w by families were|strong="H1"\w* \w Michael|strong="H4317"\w*, \w Meshullam|strong="H4918"\w*, \w Sheba|strong="H7652"\w*, \w Jorai|strong="H3140"\w*, \w Jacan|strong="H3275"\w*, \w Zia|strong="H2127"\w*, \w and Eber|strong="H5677"\w*— \w seven in all|strong="H7651"\w*. \v 14 \w These|strong="H428"\w* \w were the sons|strong="H1121"\w* \w of Abihail|strong="H32"\w* \w son|strong="H1121"\w* \w of Huri|strong="H2359"\w*, \w the son|strong="H1121"\w* \w of Jaroah|strong="H3386"\w*, \w the son|strong="H1121"\w* \w of Gilead|strong="H1568"\w*, \w the son|strong="H1121"\w* \w of Michael|strong="H4317"\w*, \w the son|strong="H1121"\w* \w of Jeshishai|strong="H3454"\w*, \w the son|strong="H1121"\w* \w of Jahdo|strong="H3163"\w*, \w the son|strong="H1121"\w* \w of Buz|strong="H938"\w*. \v 15 \w Ahi|strong="H277"\w* \w son|strong="H1121"\w* \w of Abdiel|strong="H5661"\w*, \w the son|strong="H1121"\w* \w of Guni|strong="H1476"\w*, \w was head|strong="H7218"\w* \w of their family|strong="H1"\w*.
\b 
\li1 \v 16 \w They lived|strong="H3427"\w* \w in Gilead|strong="H1568"\w*, \w in Bashan|strong="H1316"\w* \w and its towns|strong="H1323"\w*, \w and throughout|strong="H3605"\w* \w the pasturelands|strong="H4054"\w* \w of Sharon|strong="H8289"\w*. \v 17 \w All of them|strong="H3605"\w* \w were recorded in the genealogies|strong="H3187"\w* \w during the reigns|strong="H3117"\w* \w of Jotham|strong="H3147"\w* \w king|strong="H4428"\w* \w of Judah|strong="H3063"\w* \w and|strong="H3117"\w* \w Jeroboam|strong="H3379"\w* \w king|strong="H4428"\w* \w of Israel|strong="H3478"\w*.
\b 
\li1 \v 18 \w The Reubenites|strong="H1121"\w*, \w the Gadites|strong="H1425"\w*, \w and the half-tribe|strong="H2677"\w* \w of Manasseh|strong="H4519"\w* \w had 44,760|strong="H705"\w* \w warriors|strong="H3318"\w*— \w valiant|strong="H2428"\w* \w men|strong="H582"\w* \w who carried|strong="H5375"\w* \w the shield|strong="H4043"\w* \w and sword|strong="H2719"\w*, \w drew|strong="H1869"\w* \w the bow|strong="H7198"\w*, \w and were trained|strong="H3925"\w* \w for battle|strong="H4421"\w*. \v 19 \w They waged|strong="H6213"\w* \w war|strong="H4421"\w* \w against|strong="H5973"\w* \w the Hagrites|strong="H1905"\w*, \w as well as Jetur|strong="H3195"\w*, \w Naphish|strong="H5305"\w*, \w and Nodab|strong="H5114"\w*.
\b 
\li1 \v 20 \w And because|strong="H3588"\w* \w they cried out|strong="H2199"\w* \w to God|strong="H430"\w* \w in battle|strong="H4421"\w*, \w they were helped|strong="H5826"\w* \w against their enemies|strong="H5921"\w*, \w and the Hagrites|strong="H1905"\w* \w and all|strong="H3605"\w* \w their allies|strong="H5973"\w* \w were delivered|strong="H5414"\w* \w into their hands|strong="H3027"\w*. \w Because|strong="H3588"\w* \w they put their trust|strong="H982"\w* in God, \w He answered their prayers|strong="H6279"\w*. \v 21 \w They seized|strong="H7617"\w* \w the livestock of the Hagrites|strong="H4735"\w*— \w 50,000|strong="H2572"\w* \w camels|strong="H1581"\w*, \w 250,000|strong="H3967"\w* \w sheep|strong="H6629"\w*, \w and 2,000|strong="H505"\w* \w donkeys|strong="H2543"\w*. \w They also took 100,000|strong="H3967"\w* \w captives|strong="H120"\w*, \v 22 \w and|strong="H3588"\w* \w many others|strong="H7227"\w* \w fell|strong="H5307"\w* \w slain|strong="H2491"\w*, \w because|strong="H3588"\w* \w the battle|strong="H4421"\w* \w belonged to God|strong="H430"\w*. \w And they occupied|strong="H3427"\w* \w the land|strong="H8478"\w* \w until|strong="H5704"\w* \w the exile|strong="H1473"\w*.
\s1 The Half-Tribe of Manasseh
\p \v 23 \w Now the people|strong="H1121"\w* \w of the half-tribe|strong="H2677"\w* \w of Manasseh|strong="H4519"\w* \w were numerous|strong="H7235"\w*. \w They settled|strong="H3427"\w* \w in the land|strong="H776"\w* \w from Bashan|strong="H1316"\w* \w to|strong="H5704"\w* \w Baal-hermon (that is|strong="H1179"\w*, \w Senir|strong="H8149"\w*, \w also known as Mount|strong="H2022"\w* \w Hermon|strong="H2768"\w*).\f + \fr 5:23 \ft Literally \fqa from Bashan to Baal-hermon and Senir and Mount Hermon.\f* \v 24 \w These|strong="H428"\w* \w were the heads|strong="H7218"\w* \w of their families|strong="H1"\w*:
\b 
\li1 \w Epher|strong="H6081"\w*, \w Ishi|strong="H3469"\w*, \w Eliel|strong="H447"\w*, \w Azriel|strong="H5837"\w*, \w Jeremiah|strong="H3414"\w*, \w Hodaviah|strong="H1938"\w*, \w and Jahdiel|strong="H3164"\w*.
\b 
\li1 \w They were mighty|strong="H1368"\w* \w men|strong="H582"\w* \w of valor|strong="H2428"\w*, \w famous|strong="H8034"\w* \w men|strong="H582"\w*, \w and heads|strong="H7218"\w* \w of their families|strong="H1"\w*. \v 25 \w But they were unfaithful|strong="H4603"\w* \w to the God|strong="H430"\w* \w of their fathers|strong="H1"\w*, \w and they prostituted|strong="H2181"\w* \w themselves with|strong="H310"\w* \w the gods|strong="H430"\w* \w of the peoples|strong="H5971"\w* \w of the land|strong="H776"\w*, \w whom|strong="H834"\w* \w God|strong="H430"\w* \w had destroyed|strong="H8045"\w* \w before them|strong="H6440"\w*.
\b 
\li1 \v 26 \w So the God|strong="H430"\w* \w of Israel|strong="H3478"\w* \w stirred up|strong="H5782"\w* \w the spirit|strong="H7307"\w* \w of Pul|strong="H6322"\w* \w king|strong="H4428"\w* \w of Assyria|strong="H804"\w* (\w that is|strong="H853"\w*, \w Tiglath-pileser|strong="H8407"\w* \w king|strong="H4428"\w* \w of Assyria|strong="H804"\w*) \w to take the Reubenites|strong="H7206"\w*, \w the Gadites|strong="H1425"\w*, \w and the half-tribe|strong="H2677"\w* \w of Manasseh|strong="H4519"\w* \w into exile|strong="H1540"\w*. \w And he brought them|strong="H935"\w* \w to Halah|strong="H2477"\w*, \w Habor|strong="H2249"\w*, \w Hara|strong="H2024"\w*, \w and the river|strong="H5104"\w* \w of Gozan|strong="H1470"\w*, \w where they remain to|strong="H5704"\w* \w this|strong="H2088"\w* \w day|strong="H3117"\w*.
\c 6
\s1 The Descendants of Levi
\p \v 1 \w The sons|strong="H1121"\w* \w of Levi|strong="H3878"\w*:
\b 
\li1 \w Gershon|strong="H1648"\w*, \w Kohath|strong="H6955"\w*, \w and Merari|strong="H4847"\w*.
\b 
\li1 \v 2 \w The sons|strong="H1121"\w* \w of Kohath|strong="H6955"\w*:
\li2 \w Amram|strong="H6019"\w*, \w Izhar|strong="H3324"\w*, \w Hebron|strong="H2275"\w*, \w and Uzziel|strong="H5816"\w*.
\b 
\li1 \v 3 \w The children|strong="H1121"\w* \w of Amram|strong="H6019"\w*:
\li2 \w Aaron|strong="H175"\w*, \w Moses|strong="H4872"\w*, \w and Miriam|strong="H4813"\w*.
\b 
\li1 \w The sons|strong="H1121"\w* \w of Aaron|strong="H175"\w*:
\li2 \w Nadab|strong="H5070"\w*, \w Abihu|strong="H30"\w*, \w Eleazar|strong="H499"\w*, \w and Ithamar|strong="H385"\w*.
\li2 \v 4 \w Eleazar|strong="H499"\w* \w was the father of|strong="H3205"\w* \w Phinehas|strong="H6372"\w*,
\li2 \w Phinehas|strong="H6372"\w* \w was the father of|strong="H3205"\w* \w Abishua|strong="H50"\w*,
\li2 \v 5 \w Abishua|strong="H50"\w* \w was the father of|strong="H3205"\w* \w Bukki|strong="H1231"\w*,
\li2 \w Bukki|strong="H1231"\w* \w was the father of|strong="H3205"\w* \w Uzzi|strong="H5813"\w*,
\li2 \v 6 \w Uzzi|strong="H5813"\w* \w was the father of|strong="H3205"\w* \w Zerahiah|strong="H2228"\w*,
\li2 \w Zerahiah|strong="H2228"\w* \w was the father of|strong="H3205"\w* \w Meraioth|strong="H4812"\w*,
\li2 \v 7 \w Meraioth|strong="H4812"\w* \w was the father of|strong="H3205"\w* \w Amariah|strong="H568"\w*,
\li2 \w Amariah|strong="H568"\w* \w was the father of|strong="H3205"\w* \w Ahitub|strong="H285"\w*,
\li2 \v 8 \w Ahitub|strong="H285"\w* \w was the father of|strong="H3205"\w* \w Zadok|strong="H6659"\w*,
\li2 \w Zadok|strong="H6659"\w* \w was the father of|strong="H3205"\w* \w Ahimaaz|strong="H290"\w*,
\li2 \v 9 \w Ahimaaz|strong="H290"\w* \w was the father of|strong="H3205"\w* \w Azariah|strong="H5838"\w*,
\li2 \w Azariah|strong="H5838"\w* \w was the father of|strong="H3205"\w* \w Johanan|strong="H3110"\w*,
\li2 \v 10 \w Johanan|strong="H3110"\w* \w was the father of|strong="H3205"\w* \w Azariah|strong="H5838"\w*, \w who|strong="H834"\w* \w served as priest|strong="H3547"\w* \w in the temple|strong="H1004"\w* \w that|strong="H834"\w* \w Solomon|strong="H8010"\w* \w built|strong="H1129"\w* \w in Jerusalem|strong="H3389"\w*,
\li2 \v 11 \w Azariah|strong="H5838"\w* \w was the father of|strong="H3205"\w* \w Amariah|strong="H568"\w*,
\li2 \w Amariah|strong="H568"\w* \w was the father of|strong="H3205"\w* \w Ahitub|strong="H285"\w*,
\li2 \v 12 \w Ahitub|strong="H285"\w* \w was the father of|strong="H3205"\w* \w Zadok|strong="H6659"\w*,
\li2 \w Zadok|strong="H6659"\w* \w was the father of|strong="H3205"\w* \w Shallum|strong="H7967"\w*,
\li2 \v 13 \w Shallum|strong="H7967"\w* \w was the father of|strong="H3205"\w* \w Hilkiah|strong="H2518"\w*,
\li2 \w Hilkiah|strong="H2518"\w* \w was the father of|strong="H3205"\w* \w Azariah|strong="H5838"\w*,
\li2 \v 14 \w Azariah|strong="H5838"\w* \w was the father of|strong="H3205"\w* \w Seraiah|strong="H8304"\w*,
\li2 \w and Seraiah|strong="H8304"\w* \w was the father of|strong="H3205"\w* \w Jehozadak|strong="H3087"\w*.\f + \fr 6:14 \fqa Jehozadak \ft is a variant of \fqa Jozadak\ft ; also in verse 15; see \ref Ezra 3:2|EZR 3:2\ref*.\f*
\b 
\li1 \v 15 \w Jehozadak|strong="H3087"\w* \w went into captivity|strong="H1980"\w* \w when the LORD|strong="H3068"\w* \w sent Judah|strong="H3063"\w* \w and Jerusalem|strong="H3389"\w* \w into exile|strong="H1540"\w* \w by the hand|strong="H3027"\w* \w of Nebuchadnezzar|strong="H5019"\w*.
\p \v 16 \w The sons of|strong="H1121"\w* \w Levi|strong="H3878"\w*:
\b 
\li1 \w Gershom|strong="H1647"\w*,\f + \fr 6:16 \fqa Gershom \ft is a variant of \fqa Gershon\ft ; similarly in verses 17, 20, 43, 62, and 71; see verse 1.\f* \w Kohath|strong="H6955"\w*, \w and Merari|strong="H4847"\w*.
\b 
\li1 \v 17 \w These are|strong="H428"\w* \w the names of|strong="H8034"\w* \w the sons|strong="H1121"\w* \w of Gershom|strong="H1647"\w*:
\li2 \w Libni|strong="H3845"\w* \w and Shimei|strong="H8096"\w*.
\b 
\li1 \v 18 \w The sons|strong="H1121"\w* \w of Kohath|strong="H6955"\w*:
\li2 \w Amram|strong="H6019"\w*, \w Izhar|strong="H3324"\w*, \w Hebron|strong="H2275"\w*, \w and Uzziel|strong="H5816"\w*.
\b 
\li1 \v 19 \w The sons|strong="H1121"\w* \w of Merari|strong="H4847"\w*:
\li2 \w Mahli|strong="H4249"\w* \w and Mushi|strong="H4187"\w*.
\p \w These are|strong="H428"\w* \w the clans|strong="H4940"\w* \w of the Levites|strong="H3881"\w* \w listed according to their fathers|strong="H1"\w*:
\b 
\li1 \v 20 \w Of Gershom|strong="H1647"\w*:
\li2 \w Libni|strong="H3845"\w* \w his son|strong="H1121"\w*, \w Jahath|strong="H3189"\w* \w his son|strong="H1121"\w*, \w Zimmah|strong="H2155"\w* \w his son|strong="H1121"\w*, \v 21 \w Joah|strong="H3098"\w* \w his son|strong="H1121"\w*, \w Iddo|strong="H5714"\w* \w his son|strong="H1121"\w*, \w Zerah|strong="H2226"\w* \w his son|strong="H1121"\w*, \w and Jeatherai|strong="H2979"\w* \w his son|strong="H1121"\w*.
\b 
\li1 \v 22 \w The descendants|strong="H1121"\w* \w of Kohath|strong="H6955"\w*:
\li2 \w Amminadab|strong="H5992"\w* \w his son|strong="H1121"\w*, \w Korah|strong="H7141"\w* \w his son|strong="H1121"\w*, \w Assir|strong="H617"\w* \w his son|strong="H1121"\w*, \v 23 \w Elkanah|strong="H511"\w* \w his son|strong="H1121"\w*, \w Ebiasaph|strong="H43"\w*\f + \fr 6:23 \fqa Ebiasaph \ft is a variant of \fqa Abiasaph\ft ; also in verse 37; see \ref Exodus 6:24|EXO 6:24\ref*.\f* \w his son|strong="H1121"\w*, \w Assir|strong="H617"\w* \w his son|strong="H1121"\w*, \v 24 \w Tahath|strong="H8480"\w* \w his son|strong="H1121"\w*, \w Uriel|strong="H222"\w* \w his son|strong="H1121"\w*, \w Uzziah|strong="H5818"\w* \w his son|strong="H1121"\w*, \w and Shaul|strong="H7586"\w* \w his son|strong="H1121"\w*.
\b 
\li1 \v 25 \w The descendants|strong="H1121"\w* \w of Elkanah|strong="H511"\w*:
\li2 \w Amasai|strong="H6022"\w*, \w Ahimoth|strong="H287"\w*, \v 26 \w Elkanah|strong="H511"\w* \w his son|strong="H1121"\w*,\f + \fr 6:26 \ft Some Hebrew manuscripts, LXX, and Syriac; most Hebrew manuscripts \fqa Elkanah. The sons of Elkanah:\f* \w Zophai|strong="H6689"\w* \w his son|strong="H1121"\w*, \w Nahath|strong="H5184"\w* \w his son|strong="H1121"\w*, \v 27 \w Eliab|strong="H446"\w*\f + \fr 6:27 \fqa Eliab \ft is also called \fqa Eliel\ft ; see verse 34. Both of these are other names for Elihu\fqa ; see \ref 1 Samuel 1:1|1SA 1:1\ref*.\f* \w his son|strong="H1121"\w*, \w Jeroham|strong="H3395"\w* \w his son|strong="H1121"\w*, \w and Elkanah|strong="H511"\w* \w his son|strong="H1121"\w*.\f + \fr 6:27 \ft Hebrew; some LXX manuscripts include \fqa and Samuel his son\ft ; see verses 33–34 and \ref 1 Samuel 1:19–20|1SA 1:19-20\ref*.\f*
\b 
\li1 \v 28 \w The sons|strong="H1121"\w* \w of Samuel|strong="H8050"\w*:
\li2 \w Joel his firstborn|strong="H1060"\w* \w and Abijah|strong="H29"\w* \w his second son|strong="H2059"\w*.\f + \fr 6:28 \ft See Syriac and some LXX manuscripts (also verse 33 and \ref 1 Samuel 8:2|1SA 8:2\ref*); Hebrew \fqa The sons of Samuel: the firstborn Vashni, then Abiah\ft .\f*
\b 
\li1 \v 29 \w The descendants|strong="H1121"\w* \w of Merari|strong="H4847"\w*:
\li2 \w Mahli|strong="H4249"\w*, \w Libni|strong="H3845"\w* \w his son|strong="H1121"\w*, \w Shimei|strong="H8096"\w* \w his son|strong="H1121"\w*, \w Uzzah|strong="H5798"\w* \w his son|strong="H1121"\w*, \v 30 \w Shimea|strong="H8092"\w* \w his son|strong="H1121"\w*, \w Haggiah|strong="H2293"\w* \w his son|strong="H1121"\w*, \w and Asaiah|strong="H6222"\w* \w his son|strong="H1121"\w*.
\s1 The Temple Musicians
\p \v 31 \w These|strong="H428"\w* \w are the men|strong="H834"\w* \w David|strong="H1732"\w* \w put|strong="H5975"\w* \w in|strong="H5921"\w* \w charge|strong="H3027"\w* \w of the music|strong="H7892"\w* \w in the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w* \w after the ark|strong="H727"\w* \w rested there|strong="H4494"\w*. \v 32 \w They ministered|strong="H8334"\w* \w with song|strong="H7892"\w* \w before|strong="H6440"\w* \w the tabernacle|strong="H4908"\w*, \w the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*, \w until|strong="H5704"\w* \w Solomon|strong="H8010"\w* \w built|strong="H1129"\w* \w the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w* \w in Jerusalem|strong="H3389"\w*. \w And they performed|strong="H5975"\w* \w their duties|strong="H5656"\w* \w according to the regulations given them|strong="H4941"\w*. \v 33 \w These|strong="H428"\w* \w are the men who served|strong="H5975"\w*, \w together with their sons|strong="H1121"\w*.
\b 
\li1 \w From the Kohathites|strong="H1121"\w*:
\li2 \w Heman|strong="H1968"\w* \w the singer|strong="H7891"\w*, \w the son|strong="H1121"\w* \w of Joel|strong="H3100"\w*, \w the son|strong="H1121"\w* \w of Samuel|strong="H8050"\w*, \v 34 \w the son|strong="H1121"\w* \w of Elkanah|strong="H511"\w*, \w the son|strong="H1121"\w* \w of Jeroham|strong="H3395"\w*, \w the son|strong="H1121"\w* \w of Eliel|strong="H447"\w*,\f + \fr 6:34 \fqa Eliel \ft is also called \fqa Eliab\ft ; see verse 27. Both of these are other names for Elihu\fqa ; see \ref 1 Samuel 1:1|1SA 1:1\ref*.\f* \w the son|strong="H1121"\w* \w of Toah|strong="H8430"\w*, \v 35 \w the son|strong="H1121"\w* \w of Zuph|strong="H6689"\w*, \w the son|strong="H1121"\w* \w of Elkanah|strong="H511"\w*, \w the son|strong="H1121"\w* \w of Mahath|strong="H4287"\w*, \w the son|strong="H1121"\w* \w of Amasai|strong="H6022"\w*, \v 36 \w the son|strong="H1121"\w* \w of Elkanah|strong="H511"\w*, \w the son|strong="H1121"\w* \w of Joel|strong="H3100"\w*, \w the son|strong="H1121"\w* \w of Azariah|strong="H5838"\w*, \w the son|strong="H1121"\w* \w of Zephaniah|strong="H6846"\w*, \v 37 \w the son|strong="H1121"\w* \w of Tahath|strong="H8480"\w*, \w the son|strong="H1121"\w* \w of Assir|strong="H617"\w*, \w the son|strong="H1121"\w* \w of Ebiasaph|strong="H43"\w*, \w the son|strong="H1121"\w* \w of Korah|strong="H7141"\w*, \v 38 \w the son|strong="H1121"\w* \w of Izhar|strong="H3324"\w*, \w the son|strong="H1121"\w* \w of Kohath|strong="H6955"\w*, \w the son|strong="H1121"\w* \w of Levi|strong="H3878"\w*, \w the son|strong="H1121"\w* \w of Israel|strong="H3478"\w*.
\b 
\li1 \v 39 \w Heman’s kinsman|strong="H251"\w* \w was Asaph|strong="H623"\w*, \w who served|strong="H5975"\w* \w at|strong="H5921"\w* \w his right hand|strong="H3225"\w*:
\li2 \w Asaph|strong="H623"\w* \w the son|strong="H1121"\w* \w of Berechiah|strong="H1296"\w*, \w the son|strong="H1121"\w* \w of Shimea|strong="H8092"\w*, \v 40 \w the son|strong="H1121"\w* \w of Michael|strong="H4317"\w*, \w the son|strong="H1121"\w* \w of Baaseiah|strong="H1202"\w*,\f + \fr 6:40 \ft Most Hebrew manuscripts; some Hebrew manuscripts, one LXX manuscript, and Syriac \fqa Maaseiah\f* \w the son|strong="H1121"\w* \w of Malchijah|strong="H4441"\w*, \v 41 \w the son|strong="H1121"\w* \w of Ethni|strong="H867"\w*, \w the son|strong="H1121"\w* \w of Zerah|strong="H2226"\w*, \w the son|strong="H1121"\w* \w of Adaiah|strong="H5718"\w*, \v 42 \w the son|strong="H1121"\w* \w of Ethan|strong="H387"\w*, \w the son|strong="H1121"\w* \w of Zimmah|strong="H2155"\w*, \w the son|strong="H1121"\w* \w of Shimei|strong="H8096"\w*, \v 43 \w the son|strong="H1121"\w* \w of Jahath|strong="H3189"\w*, \w the son|strong="H1121"\w* \w of Gershom|strong="H1647"\w*, \w the son|strong="H1121"\w* \w of Levi|strong="H3878"\w*.
\b 
\li1 \v 44 \w On|strong="H5921"\w* \w the left|strong="H8040"\w* \w were their kinsmen|strong="H251"\w*, \w the sons|strong="H1121"\w* \w of Merari|strong="H4847"\w*:
\li2 \w Ethan|strong="H387"\w* \w the son|strong="H1121"\w* \w of Kishi|strong="H7029"\w*, \w the son|strong="H1121"\w* \w of Abdi|strong="H5660"\w*, \w the son|strong="H1121"\w* \w of Malluch|strong="H4409"\w*, \v 45 \w the son|strong="H1121"\w* \w of Hashabiah|strong="H2811"\w*, \w the son|strong="H1121"\w* \w of Amaziah|strong="H558"\w*, \w the son|strong="H1121"\w* \w of Hilkiah|strong="H2518"\w*, \v 46 \w the son|strong="H1121"\w* \w of Amzi|strong="H557"\w*, \w the son|strong="H1121"\w* \w of Bani|strong="H1137"\w*, \w the son|strong="H1121"\w* \w of Shemer|strong="H8106"\w*, \v 47 \w the son|strong="H1121"\w* \w of Mahli|strong="H4249"\w*, \w the son|strong="H1121"\w* \w of Mushi|strong="H4187"\w*, \w the son|strong="H1121"\w* \w of Merari|strong="H4847"\w*, \w the son|strong="H1121"\w* \w of Levi|strong="H3878"\w*.
\s1 The Descendants of Aaron
\p \v 48 \w Their fellow|strong="H251"\w* \w Levites|strong="H3881"\w* \w were assigned|strong="H5414"\w* \w to every kind|strong="H3605"\w* \w of service|strong="H5656"\w* \w of the tabernacle|strong="H4908"\w*, \w the house|strong="H1004"\w* \w of God|strong="H430"\w*. \v 49 \w But Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w* \w did all|strong="H3605"\w* \w the work|strong="H4399"\w* \w of the Most Holy Place|strong="H6944"\w*.\f + \fr 6:49 \ft Or \fqa the Holy of Holies\f* \w They presented the offerings|strong="H6999"\w* \w on|strong="H5921"\w* \w the altar|strong="H4196"\w* \w of burnt offering|strong="H5930"\w* \w and on|strong="H5921"\w* \w the altar|strong="H4196"\w* \w of incense|strong="H7004"\w* \w to make atonement|strong="H3722"\w* \w for|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w according to all|strong="H3605"\w* \w that|strong="H834"\w* \w Moses|strong="H4872"\w* \w the servant|strong="H5650"\w* \w of God|strong="H430"\w* \w had commanded|strong="H6680"\w*.
\b 
\li1 \v 50 \w These|strong="H428"\w* \w were the descendants|strong="H1121"\w* \w of Aaron|strong="H175"\w*:
\li2 \w Eleazar|strong="H499"\w* \w his son|strong="H1121"\w*, \w Phinehas|strong="H6372"\w* \w his son|strong="H1121"\w*, \w Abishua|strong="H50"\w* \w his son|strong="H1121"\w*, \v 51 \w Bukki|strong="H1231"\w* \w his son|strong="H1121"\w*, \w Uzzi|strong="H5813"\w* \w his son|strong="H1121"\w*, \w Zerahiah|strong="H2228"\w* \w his son|strong="H1121"\w*, \v 52 \w Meraioth|strong="H4812"\w* \w his son|strong="H1121"\w*, \w Amariah|strong="H568"\w* \w his son|strong="H1121"\w*, \w Ahitub|strong="H285"\w* \w his son|strong="H1121"\w*, \v 53 \w Zadok|strong="H6659"\w* \w his son|strong="H1121"\w*, \w and Ahimaaz|strong="H290"\w* \w his son|strong="H1121"\w*.
\s1 Territories for the Levites
\r (\ref Numbers 35:1–8|NUM 35:1-8\ref*; \ref Joshua 21:1–45|JOS 21:1-45\ref*)
\p \v 54 \w Now these were|strong="H428"\w* \w the territories|strong="H1366"\w* \w assigned to the descendants|strong="H1121"\w* \w of Aaron|strong="H175"\w* \w from the Kohathite|strong="H6956"\w* \w clan|strong="H4940"\w* \w for their settlements|strong="H4186"\w*, \w because|strong="H3588"\w* \w the first lot|strong="H1486"\w* \w fell|strong="H1961"\w* to them:
\b 
\li1 \v 55 \w They were given|strong="H5414"\w* \w Hebron|strong="H2275"\w* \w in the land|strong="H776"\w* \w of Judah|strong="H3063"\w* \w and its surrounding|strong="H5439"\w* \w pasturelands|strong="H4054"\w*. \v 56 \w But the fields|strong="H7704"\w* \w and villages|strong="H2691"\w* \w around the city|strong="H5892"\w* \w were given|strong="H5414"\w* \w to Caleb|strong="H3612"\w* \w son|strong="H1121"\w* \w of Jephunneh|strong="H3312"\w*. \v 57 \w So the descendants|strong="H1121"\w* \w of Aaron|strong="H175"\w* \w were given|strong="H5414"\w* \w Hebron|strong="H2275"\w* \w (a city|strong="H5892"\w* \w of refuge|strong="H4733"\w*), \w Libnah|strong="H3841"\w*,\f + \fr 6:57 \ft As in the parallel text at \ref Joshua 21:13|JOS 21:13\ref*; Hebrew \fqa were given the cities of refuge: Hebron, Libnah\f* \w Jattir|strong="H3492"\w*, \w Eshtemoa|strong="H851"\w*, \v 58 \w Hilen|strong="H2432"\w*,\f + \fr 6:58 \ft Some Hebrew manuscripts; MT \fqa Hilez\ft ; parallel text at \ref Joshua 21:15|JOS 21:15\ref* \fqa Holon\f* \w Debir|strong="H1688"\w*, \v 59 \w Ashan|strong="H6228"\w*,\f + \fr 6:59 \fqa Ashan \ft is a variant of \fqa Ain\ft ; see \ref Joshua 21:16|JOS 21:16\ref*.\f* \w Juttah,|strong="H4054"\w*\f + \fr 6:59 \ft Syriac and the parallel text at \ref Joshua 21:16|JOS 21:16\ref*; MT does not include \fqa Juttah,\f* \w and Beth-shemesh|strong="H1053"\w*, \w together with|strong="H853"\w* \w their pasturelands|strong="H4054"\w*.
\b 
\li1 \v 60 \w And from the tribe|strong="H4294"\w* \w of Benjamin|strong="H1144"\w* \w they were given Gibeon,|strong="H853"\w*\f + \fr 6:60 \ft LXX, Syriac, and parallel text at \ref Joshua 21:17|JOS 21:17\ref*; MT does not include \fqa Gibeon,\f* \w Geba|strong="H1387"\w*, \w Alemeth|strong="H5964"\w*, \w and Anathoth|strong="H6068"\w*, \w together with|strong="H853"\w* \w their pasturelands|strong="H4054"\w*. \w So they had thirteen|strong="H7969"\w* \w cities|strong="H5892"\w* \w in all|strong="H3605"\w* \w among their families|strong="H4940"\w*.
\b 
\li1 \v 61 \w To the rest|strong="H3498"\w* \w of the Kohathites|strong="H1121"\w*, \w ten|strong="H6235"\w* \w cities|strong="H5892"\w* \w were allotted|strong="H1486"\w* \w from the half-tribe|strong="H4276"\w* \w of Manasseh|strong="H4519"\w*.
\p \v 62 \w The Gershomites|strong="H1121"\w*\f + \fr 6:62 \fqa Gershomites \ft is a variant of \fqa Gershonites\ft ; also in verse 71; see \ref 1 Chronicles 23:7|1CH 23:7\ref*.\f*, \w according to their clans|strong="H4940"\w*, \w were allotted thirteen|strong="H7969"\w* \w cities|strong="H5892"\w* \w from the tribes|strong="H4294"\w* \w of Issachar|strong="H3485"\w*, \w Asher|strong="H836"\w*, \w Naphtali|strong="H5321"\w*, \w and Manasseh|strong="H4519"\w* \w in Bashan|strong="H1316"\w*.
\p \v 63 \w The Merarites|strong="H1121"\w*, \w according to their clans|strong="H4940"\w*, \w were allotted|strong="H1486"\w* \w twelve|strong="H8147"\w* \w cities|strong="H5892"\w* \w from the tribes|strong="H4294"\w* \w of Reuben|strong="H7205"\w*, \w Gad|strong="H1410"\w*, \w and Zebulun|strong="H2074"\w*.
\p \v 64 \w So the Israelites|strong="H1121"\w* \w gave|strong="H5414"\w* \w to the Levites|strong="H3881"\w* \w these cities|strong="H5892"\w* \w and their pasturelands|strong="H4054"\w*. \v 65 \w They assigned|strong="H5414"\w* \w by lot|strong="H1486"\w* \w the cities|strong="H5892"\w* \w named|strong="H7121"\w* \w above|strong="H8034"\w* \w from the tribes|strong="H4294"\w* \w of Judah|strong="H1121"\w*, \w Simeon|strong="H1121"\w*, \w and Benjamin|strong="H1121"\w*.
\p \v 66 \w And some of the clans|strong="H4940"\w* \w of the Kohathites|strong="H1121"\w* \w were given cities|strong="H5892"\w* \w from the tribe|strong="H4294"\w* \w of Ephraim|strong="H669"\w* \w for their territory|strong="H1366"\w*:
\b 
\li1 \v 67 \w They were given|strong="H5414"\w* \w Shechem|strong="H7927"\w* \w (a city|strong="H5892"\w* \w of refuge|strong="H4733"\w*)\f + \fr 6:67 \ft As in the parallel text at \ref Joshua 21:21|JOS 21:21\ref*; Hebrew \fqa They were given the cities of refuge: Shechem\f* \w with its pasturelands|strong="H4054"\w* \w in the hill country|strong="H2022"\w* \w of Ephraim|strong="H669"\w*, \w and|strong="H853"\w* \w Gezer|strong="H1507"\w*, \v 68 \w Jokmeam|strong="H3361"\w*, \w Beth-horon|strong="H1032"\w*, \v 69 \w Aijalon|strong="H357"\w*, \w and Gath-rimmon|strong="H1667"\w*, \w together with|strong="H853"\w* \w their pasturelands|strong="H4054"\w*.
\b 
\li1 \v 70 \w And from|strong="H4276"\w* \w the half-tribe|strong="H4294"\w* \w of Manasseh|strong="H4519"\w* \w the rest of the|strong="H3498"\w* \w clans|strong="H4940"\w* \w of the Kohathites|strong="H1121"\w* \w were given Aner|strong="H6063"\w* \w and Bileam|strong="H1109"\w*, \w together with|strong="H853"\w* \w their pasturelands|strong="H4054"\w*.
\p \v 71 \w The Gershomites received the following|strong="H1121"\w*:
\b 
\li1 \w From the clan|strong="H4940"\w* \w of|strong="H2677"\w* \w the half-tribe|strong="H4294"\w* \w of Manasseh|strong="H4519"\w* \w they were given|strong="H853"\w* \w Golan|strong="H1474"\w* \w in Bashan|strong="H1316"\w* \w and also|strong="H853"\w* \w Ashtaroth|strong="H6252"\w*, \w together with|strong="H853"\w* \w their pasturelands|strong="H4054"\w*.
\b 
\li1 \v 72 \w From the tribe|strong="H4294"\w* \w of Issachar|strong="H3485"\w* \w they were given|strong="H853"\w* \w Kedesh|strong="H6943"\w*, \w Daberath|strong="H1705"\w*, \v 73 \w Ramoth|strong="H7216"\w*, \w and Anem|strong="H6046"\w*, \w together with|strong="H853"\w* \w their pasturelands|strong="H4054"\w*.
\b 
\li1 \v 74 \w From the tribe|strong="H4294"\w* \w of Asher|strong="H836"\w* \w they were given|strong="H853"\w* \w Mashal|strong="H4913"\w*, \w Abdon|strong="H5658"\w*, \v 75 \w Hukok|strong="H2712"\w*, \w and Rehob|strong="H7340"\w*, \w together with|strong="H853"\w* \w their pasturelands|strong="H4054"\w*.
\b 
\li1 \v 76 \w And from the tribe|strong="H4294"\w* \w of Naphtali|strong="H5321"\w* \w they were given|strong="H853"\w* \w Kedesh|strong="H6943"\w* \w in Galilee|strong="H1551"\w*, \w Hammon|strong="H2540"\w*, \w and Kiriathaim|strong="H7156"\w*, \w together with|strong="H853"\w* \w their pasturelands|strong="H4054"\w*.
\p \v 77 \w The Merarites|strong="H1121"\w* (\w the rest of the Levites) received the following|strong="H3498"\w*:
\b 
\li1 \w From the tribe|strong="H4294"\w* \w of Zebulun|strong="H2074"\w* \w they were given|strong="H853"\w* \w Rimmono|strong="H7417"\w* \w and Tabor|strong="H8396"\w*,\f + \fr 6:77 \ft LXX \fqa (they were given) Jokneam, Kartah, Rimmono, and Tabor\ft ; see \ref Joshua 21:34|JOS 21:34\ref*.\f* \w together with|strong="H853"\w* \w their pasturelands|strong="H4054"\w*.
\b 
\li1 \v 78 \w From the tribe|strong="H4294"\w* \w of Reuben|strong="H7205"\w* \w east|strong="H4217"\w* \w of the Jordan|strong="H3383"\w* \w opposite Jericho|strong="H3405"\w* \w they were given Bezer|strong="H1221"\w* \w in the wilderness|strong="H4057"\w*, \w Jahzah|strong="H3096"\w*,\f + \fr 6:78 \fqa Jahzah \ft is a variant of \fqa Jahaz\ft ; see \ref Numbers 21:23|NUM 21:23\ref*.\f* \v 79 \w Kedemoth|strong="H6932"\w*, \w and Mephaath|strong="H4158"\w*, \w together with|strong="H853"\w* \w their pasturelands|strong="H4054"\w*.
\b 
\li1 \v 80 \w And from the tribe|strong="H4294"\w* \w of Gad|strong="H1410"\w* \w they were given|strong="H853"\w* \w Ramoth|strong="H7216"\w* \w in Gilead|strong="H1568"\w*, \w Mahanaim|strong="H4266"\w*, \v 81 \w Heshbon|strong="H2809"\w*, \w and Jazer|strong="H3270"\w*, \w together with|strong="H853"\w* \w their pasturelands|strong="H4054"\w*.
\c 7
\s1 The Descendants of Issachar
\p \v 1 \w The sons|strong="H1121"\w* \w of Issachar|strong="H3485"\w*:
\b 
\li1 \w Tola|strong="H8439"\w*, \w Puah|strong="H6312"\w*,\f + \fr 7:1 \fqa Puah \ft is a variant of \fqa Puvah\ft ; see \ref Genesis 46:13|GEN 46:13\ref* and Numbers 26:23.\f* \w Jashub|strong="H3437"\w*, \w and Shimron|strong="H8110"\w*— \w four in all|strong="H702"\w*.
\b 
\li1 \v 2 \w The sons|strong="H1121"\w* \w of Tola|strong="H8439"\w*:
\li2 \w Uzzi|strong="H5813"\w*, \w Rephaiah|strong="H7509"\w*, \w Jeriel|strong="H3400"\w*, \w Jahmai|strong="H3181"\w*, \w Ibsam|strong="H3005"\w*, \w and Shemuel|strong="H8050"\w*, \w the heads|strong="H7218"\w* \w of their families|strong="H1"\w*. \w In the days|strong="H3117"\w* \w of David|strong="H1732"\w*, \w 22,600|strong="H6242"\w* \w descendants of Tola|strong="H8439"\w* \w were numbered|strong="H4557"\w* \w in their genealogies|strong="H8435"\w* \w as mighty men|strong="H1368"\w* \w of valor|strong="H2428"\w*.
\b 
\li1 \v 3 \w The son|strong="H1121"\w*\f + \fr 7:3 \ft Hebrew \fqa sons\ft ; also in verses 10 and 17\f* \w of Uzzi|strong="H5813"\w*:
\li2 \w Izrahiah|strong="H3156"\w*.
\b 
\li1 \w The sons|strong="H1121"\w* \w of Izrahiah|strong="H3156"\w*:
\li2 \w Michael|strong="H4317"\w*, \w Obadiah|strong="H5662"\w*, \w Joel|strong="H3100"\w*, \w and Isshiah|strong="H3449"\w*. \w All|strong="H3605"\w* \w five|strong="H2568"\w* \w of them were chiefs|strong="H7218"\w*. \v 4 \w In addition to them|strong="H5921"\w*, \w according to their genealogy|strong="H8435"\w*, \w they had 36,000|strong="H7970"\w* \w troops|strong="H6635"\w* \w for battle|strong="H4421"\w*, \w for|strong="H3588"\w* \w they had many|strong="H7235"\w* \w wives|strong="H802"\w* \w and children|strong="H1121"\w*.
\b 
\li1 \v 5 \w Their kinsmen|strong="H251"\w* \w belonging to all|strong="H3605"\w* \w the families|strong="H4940"\w* \w of Issachar|strong="H3485"\w* \w who were mighty men|strong="H2428"\w* \w of valor|strong="H1368"\w* \w totaled|strong="H3605"\w* \w 87,000|strong="H8084"\w*, \w as listed in their genealogies|strong="H3187"\w*.
\s1 The Descendants of Benjamin
\p \v 6 \w The three|strong="H7969"\w* \w sons of Benjamin|strong="H1144"\w*:
\b 
\li1 \w Bela|strong="H1106"\w*, \w Becher|strong="H1071"\w*, \w and Jediael|strong="H3043"\w*.
\b 
\li1 \v 7 \w The sons|strong="H1121"\w* \w of Bela|strong="H1106"\w*:
\li2 \w Ezbon|strong="H675"\w*, \w Uzzi|strong="H5813"\w*, \w Uzziel|strong="H5816"\w*, \w Jerimoth|strong="H3406"\w*, \w and Iri|strong="H5901"\w*, \w heads|strong="H7218"\w* \w of their families|strong="H1"\w*— \w five in all|strong="H2568"\w*. \w There were 22,034|strong="H6242"\w* \w mighty men|strong="H1368"\w* \w of valor|strong="H2428"\w* \w listed in their genealogies|strong="H3187"\w*.
\b 
\li1 \v 8 \w The sons|strong="H1121"\w* \w of Becher|strong="H1071"\w*:
\li2 \w Zemirah|strong="H2160"\w*, \w Joash|strong="H3135"\w*, \w Eliezer|strong="H461"\w*, \w Elioenai|strong="H454"\w*, \w Omri|strong="H6018"\w*, \w Jeremoth|strong="H3406"\w*, \w Abijah|strong="H29"\w*, \w Anathoth|strong="H6068"\w*, \w and Alemeth|strong="H5964"\w*; \w all|strong="H3605"\w* \w these|strong="H428"\w* \w were Becher’s|strong="H1071"\w* \w sons|strong="H1121"\w*. \v 9 \w Their genealogies|strong="H8435"\w* \w were recorded|strong="H3187"\w* \w according to the heads|strong="H7218"\w* \w of their families|strong="H1"\w*— \w 20,200|strong="H6242"\w* \w mighty men|strong="H1368"\w* \w of valor|strong="H2428"\w*.
\b 
\li1 \v 10 \w The son|strong="H1121"\w* \w of Jediael|strong="H3043"\w*:
\li2 \w Bilhan|strong="H1092"\w*.
\b 
\li1 \w The sons|strong="H1121"\w* \w of Bilhan|strong="H1092"\w*:
\li2 \w Jeush|strong="H3266"\w*, \w Benjamin|strong="H1144"\w*, \w Ehud|strong="H164"\w*, \w Chenaanah|strong="H3668"\w*, \w Zethan|strong="H2133"\w*, \w Tarshish|strong="H8659"\w*, \w and Ahishahar|strong="H300"\w*. \v 11 \w All|strong="H3605"\w* \w these|strong="H428"\w* \w sons|strong="H1121"\w* \w of Jediael|strong="H3043"\w* \w were heads|strong="H7218"\w* \w of their families|strong="H1"\w*, \w mighty men|strong="H1368"\w* \w of valor|strong="H2428"\w*; \w there were 17,200|strong="H7651"\w* \w fit|strong="H3318"\w* \w for battle|strong="H6635"\w*. \v 12 \w The Shuppites|strong="H8206"\w* \w and Huppites|strong="H2650"\w* \w were descendants|strong="H1121"\w* \w of Ir|strong="H5893"\w*, \w and the Hushites|strong="H2366"\w* \w were descendants|strong="H1121"\w* \w of Aher|strong="H313"\w*.
\s1 The Descendants of Naphtali
\p \v 13 \w The sons|strong="H1121"\w* \w of Naphtali|strong="H5321"\w*:
\b 
\li1 \w Jahziel|strong="H3185"\w*,\f + \fr 7:13 \fqa Jahziel \ft is a variant of \fqa Jahzeel\ft ; see \ref Genesis 46:24|GEN 46:24\ref*.\f* \w Guni|strong="H1476"\w*, \w Jezer|strong="H3337"\w*, \w and Shallum|strong="H7967"\w*\f + \fr 7:13 \ft Most Hebrew manuscripts; some Hebrew and LXX manuscripts \fqa Shillem\ft ; see \ref Genesis 46:24|GEN 46:24\ref* and Numbers 26:49.\f*— \w the descendants|strong="H1121"\w* \w of Bilhah|strong="H1090"\w*.
\s1 The Descendants of Manasseh
\p \v 14 \w The descendants|strong="H1121"\w* \w of Manasseh|strong="H4519"\w*: \w Asriel|strong="H844"\w*
\b 
\li1 \w through his Aramean|strong="H761"\w* \w concubine|strong="H6370"\w*. \w She also|strong="H834"\w* \w gave birth|strong="H3205"\w* \w to Machir|strong="H4353"\w* \w the father|strong="H1"\w* \w of Gilead|strong="H1568"\w*.
\b 
\li1 \v 15 \w Machir|strong="H4353"\w* \w took|strong="H3947"\w* \w a wife|strong="H802"\w* \w from among the Huppites|strong="H2650"\w* \w and Shuppites|strong="H8206"\w*. \w The name|strong="H8034"\w* \w of his sister|strong="H269"\w* \w was Maacah|strong="H4601"\w*.
\b 
\li1 \w Another|strong="H8145"\w* \w descendant was named|strong="H8034"\w* \w Zelophehad|strong="H6765"\w*, \w who had|strong="H1961"\w* \w only daughters|strong="H1323"\w*.
\b 
\li1 \v 16 \w Machir’s|strong="H4353"\w* \w wife|strong="H802"\w* \w Maacah|strong="H4601"\w* \w gave birth to|strong="H3205"\w* \w a son|strong="H1121"\w*, \w and she named him|strong="H7121"\w* \w Peresh|strong="H6570"\w*. \w His brother|strong="H251"\w* \w was named|strong="H8034"\w* \w Sheresh|strong="H8329"\w*, \w and his sons|strong="H1121"\w* \w were Ulam|strong="H198"\w* \w and Rekem|strong="H7552"\w*.
\b 
\li1 \v 17 \w The son|strong="H1121"\w* \w of Ulam|strong="H198"\w*:
\li2 \w Bedan|strong="H917"\w*.
\b 
\li1 \w These|strong="H428"\w* \w were the sons|strong="H1121"\w* \w of Gilead|strong="H1568"\w* \w son|strong="H1121"\w* \w of Machir|strong="H4353"\w*, \w the son|strong="H1121"\w* \w of Manasseh|strong="H4519"\w*. \v 18 \w His sister|strong="H269"\w* \w Hammolecheth|strong="H4447"\w* \w gave birth to|strong="H3205"\w* \w Ishhod|strong="H379"\w*, \w Abiezer|strong="H44"\w*, \w and Mahlah|strong="H4244"\w*.
\b 
\li1 \v 19 \w And these were|strong="H1961"\w* \w the sons|strong="H1121"\w* \w of Shemida|strong="H8061"\w*:
\li2 \w Ahian|strong="H291"\w*, \w Shechem|strong="H7928"\w*, \w Likhi|strong="H3949"\w*, \w and Aniam|strong="H593"\w*.
\s1 The Descendants of Ephraim
\p \v 20 \w The descendants|strong="H1121"\w* \w of Ephraim|strong="H669"\w*:
\b 
\li1 \w Shuthelah|strong="H7803"\w*, \w Bered|strong="H1260"\w* \w his son|strong="H1121"\w*, \w Tahath|strong="H8480"\w* \w his son|strong="H1121"\w*, \w Eleadah|strong="H497"\w* \w his son|strong="H1121"\w*, \w Tahath|strong="H8480"\w* \w his son|strong="H1121"\w*, \v 21 \w Zabad|strong="H2066"\w* \w his son|strong="H1121"\w*, \w and Shuthelah|strong="H7803"\w* \w his son|strong="H1121"\w*.
\b 
\li1 \w Ezer|strong="H5829"\w* \w and Elead|strong="H496"\w* \w were killed|strong="H2026"\w* \w by the natives|strong="H582"\w* \w of Gath|strong="H1661"\w*, \w because|strong="H3588"\w* \w they went down|strong="H3381"\w* \w to steal|strong="H3947"\w* \w their livestock|strong="H4735"\w*.
\b 
\li1 \v 22 \w Their father|strong="H1"\w* \w Ephraim|strong="H669"\w* \w mourned|strong="H56"\w* \w for many|strong="H7227"\w* \w days|strong="H3117"\w*, \w and his relatives|strong="H251"\w* \w came|strong="H935"\w* \w to comfort him|strong="H5162"\w*. \v 23 \w And again he slept with|strong="H935"\w* \w his wife|strong="H802"\w*, \w and she conceived|strong="H2029"\w* \w and gave birth to|strong="H3205"\w* \w a son|strong="H1121"\w*. \w So he named|strong="H7121"\w* \w him|strong="H8034"\w* \w Beriah|strong="H1283"\w*,\f + \fr 7:23 \fqa Beriah \ft sounds like the Hebrew for \fqa tragedy \ft or \fqa disaster\ft .\f* \w because|strong="H3588"\w* \w tragedy|strong="H7451"\w* \w had come|strong="H1961"\w* \w upon his house|strong="H1004"\w*. \v 24 \w His daughter|strong="H1323"\w* \w was Sheerah|strong="H7609"\w*, \w who built|strong="H1129"\w* \w Lower|strong="H8481"\w* \w and Upper|strong="H5945"\w* \w Beth-horon|strong="H1032"\w*, \w as well as|strong="H853"\w* \w Uzzen-sheerah|strong="H242"\w*.
\b 
\li1 \v 25 \w Additionally, Rephah|strong="H7506"\w* \w was his son|strong="H1121"\w*, \w Resheph his son|strong="H7566"\w*,\f + \fr 7:25 \ft Some LXX manuscripts; Hebrew does not include \fqa his son\ft .\f* \w Telah|strong="H8520"\w* \w his son|strong="H1121"\w*, \w Tahan|strong="H8465"\w* \w his son|strong="H1121"\w*, \v 26 \w Ladan|strong="H3936"\w* \w his son|strong="H1121"\w*, \w Ammihud|strong="H5989"\w* \w his son|strong="H1121"\w*, \w Elishama|strong="H476"\w* \w his son|strong="H1121"\w*, \v 27 \w Nun|strong="H5126"\w*\f + \fr 7:27 \ft Or \fqa Non\f* \w his son|strong="H1121"\w*, \w and Joshua|strong="H3091"\w* \w his son|strong="H1121"\w*.
\b 
\li1 \v 28 \w Their holdings|strong="H272"\w* \w and settlements|strong="H4186"\w* \w included|strong="H1008"\w* \w Bethel|strong="H1008"\w* \w and its villages|strong="H1323"\w*, \w Naaran|strong="H5295"\w* \w to the east|strong="H4217"\w*, \w Gezer|strong="H1507"\w* \w and its villages|strong="H1323"\w* \w to the west|strong="H4628"\w*, \w and Shechem|strong="H7927"\w* \w and its villages|strong="H1323"\w* \w as far as|strong="H5704"\w* \w Ayyah|strong="H5804"\w*\f + \fr 7:28 \fqa Ayyah \ft is another name for \fqa Gaza\ft ; see also LXX.\f* \w and its villages|strong="H1323"\w*. \v 29 \w And along|strong="H5921"\w* \w the borders|strong="H3027"\w* \w of Manasseh|strong="H4519"\w* \w were Beth-shean|strong="H1052"\w*,\f + \fr 7:29 \fqa Beth-shean \ft is a variant of \fqa Beth-shan\ft ; see \ref 1 Samuel 31:10|1SA 31:10\ref* and 2 Samuel 21:12.\f* \w Taanach|strong="H8590"\w*, \w Megiddo|strong="H4023"\w*, \w and Dor|strong="H1756"\w*, \w together with their villages|strong="H1323"\w*. \w The descendants|strong="H1121"\w* \w of Joseph|strong="H3130"\w* \w son|strong="H1121"\w* \w of Israel|strong="H3478"\w* \w lived|strong="H3427"\w* \w in these towns|strong="H428"\w*.
\s1 The Descendants of Asher
\p \v 30 \w The children|strong="H1121"\w* \w of Asher|strong="H836"\w*:
\b 
\li1 \w Imnah|strong="H3232"\w*, \w Ishvah|strong="H3438"\w*, \w Ishvi|strong="H3440"\w*, \w Beriah|strong="H1283"\w*, \w and their sister|strong="H269"\w* \w Serah|strong="H8294"\w*.
\b 
\li1 \v 31 \w The sons|strong="H1121"\w* \w of Beriah|strong="H1283"\w*:
\li2 \w Heber|strong="H2268"\w*, \w as well as Malchiel|strong="H4439"\w*, \w who|strong="H1931"\w* \w was the father of|strong="H1"\w* \w Birzaith|strong="H1269"\w*.
\b 
\li1 \v 32 \w Heber|strong="H2268"\w* \w was the father of|strong="H3205"\w* \w Japhlet|strong="H3310"\w*, \w Shomer|strong="H7763"\w*, \w and Hotham|strong="H2369"\w*, \w and|strong="H853"\w* \w of their sister|strong="H269"\w* \w Shua|strong="H7774"\w*.
\b 
\li1 \v 33 \w The sons|strong="H1121"\w* \w of Japhlet|strong="H3310"\w*:
\li2 \w Pasach|strong="H6457"\w*, \w Bimhal|strong="H1118"\w*, \w and Ashvath|strong="H6220"\w*. \w These|strong="H428"\w* \w were Japhlet’s|strong="H3310"\w* \w sons|strong="H1121"\w*.
\b 
\li1 \v 34 \w The sons|strong="H1121"\w* \w of Shemer|strong="H8106"\w*:
\li2 \w Ahi|strong="H277"\w*, \w Rohgah|strong="H7303"\w*,\f + \fr 7:34 \ft Or \fqa The sons of his brother Shemer: Rohgah\ft ; note that \fqa Shemer \ft is a variant of \fqa Shomer\ft ; see verse 32.\f* \w Hubbah|strong="H3160"\w*, \w and Aram|strong="H758"\w*.
\b 
\li1 \v 35 \w The sons|strong="H1121"\w* \w of his brother|strong="H251"\w* \w Helem|strong="H1987"\w*:\f + \fr 7:35 \fqa Helem \ft is possibly another name for \fqa Hotham\ft ; see verse 32.\f*
\li2 \w Zophah|strong="H6690"\w*, \w Imna|strong="H3234"\w*, \w Shelesh|strong="H8028"\w*, \w and Amal|strong="H6000"\w*.
\b 
\li1 \v 36 \w The sons|strong="H1121"\w* \w of Zophah|strong="H6690"\w*:
\li2 \w Suah|strong="H5477"\w*, \w Harnepher|strong="H2774"\w*, \w Shual|strong="H7777"\w*, \w Beri|strong="H1275"\w*, \w Imrah|strong="H3236"\w*, \v 37 \w Bezer|strong="H1221"\w*, \w Hod|strong="H1936"\w*, \w Shamma|strong="H8037"\w*, \w Shilshah|strong="H8030"\w*, \w Ithran|strong="H3506"\w*,\f + \fr 7:37 \fqa Ithran \ft is possibly a variant of \fqa Jether\ft ; see verse 38.\f* \w and Beera|strong="H878"\w*.
\b 
\li1 \v 38 \w The sons|strong="H1121"\w* \w of Jether|strong="H3500"\w*:
\li2 \w Jephunneh|strong="H3312"\w*, \w Pispa|strong="H6462"\w*, \w and Ara|strong="H690"\w*.
\b 
\li1 \v 39 \w The sons|strong="H1121"\w* \w of Ulla|strong="H5925"\w*:
\li2 \w Arah|strong="H733"\w*, \w Hanniel|strong="H2592"\w*, \w and Rizia|strong="H7525"\w*.
\b 
\li1 \v 40 \w All|strong="H3605"\w* \w these|strong="H428"\w* \w were the descendants|strong="H1121"\w* \w of Asher|strong="H836"\w* — \w heads|strong="H7218"\w* \w of their families|strong="H1"\w*, \w choice|strong="H1305"\w* \w and mighty men|strong="H1368"\w* \w of valor|strong="H2428"\w*, \w and chiefs|strong="H7218"\w* \w among the leaders|strong="H5387"\w*. \w The number|strong="H4557"\w* \w of men|strong="H582"\w* \w fit for battle|strong="H4421"\w*, \w recorded in their genealogies|strong="H3187"\w*, \w was 26,000|strong="H6242"\w*.
\c 8
\s1 Genealogy from Benjamin to Saul
\p \v 1 \w Benjamin|strong="H1144"\w* \w was the father of|strong="H3205"\w* \w Bela|strong="H1106"\w* \w his firstborn|strong="H1060"\w*, \w Ashbel|strong="H788"\w* \w the second|strong="H8145"\w*, \w Aharah|strong="H315"\w* \w the third|strong="H7992"\w*, \v 2 \w Nohah|strong="H5119"\w* \w the fourth|strong="H7243"\w*, \w and Rapha|strong="H7498"\w* \w the fifth|strong="H2549"\w*.
\b 
\li1 \v 3 \w The sons|strong="H1121"\w* \w of Bela|strong="H1106"\w*:
\li2 \w Addar|strong="H146"\w*, \w Gera|strong="H1617"\w*, \w Abihud|strong="H31"\w*,\f + \fr 8:3 \ft Possibly \fqa Gera the father of Ehud\ft ; see verse 7.\f* \v 4 \w Abishua|strong="H50"\w*, \w Naaman|strong="H5283"\w*, \w Ahoah|strong="H265"\w*, \v 5 \w Gera|strong="H1617"\w*, \w Shephuphan|strong="H8197"\w*, \w and Huram|strong="H2361"\w*.
\b 
\li1 \v 6 \w These were|strong="H428"\w* \w the descendants|strong="H1121"\w* \w of Ehud|strong="H261"\w* \w who|strong="H1992"\w* \w were the heads|strong="H7218"\w* \w of the families|strong="H1"\w* \w living|strong="H3427"\w* \w in Geba|strong="H1387"\w* \w and were exiled|strong="H1540"\w* \w to|strong="H413"\w* \w Manahath|strong="H4506"\w*:
\li2 \v 7 \w Naaman|strong="H5283"\w*, \w Ahijah|strong="H281"\w*, \w and Gera|strong="H1617"\w*, \w who|strong="H1931"\w* \w carried them into exile|strong="H1540"\w* \w and who was the father|strong="H3205"\w* \w of Uzza|strong="H5798"\w* \w and Ahihud|strong="H284"\w*.\f + \fr 8:7 \ft Or \fqa and Gera, that is Heglam, who was the father of Uzza and Ahihud.\f*
\b 
\li1 \v 8 \w Shaharaim|strong="H7842"\w* \w had sons|strong="H3205"\w* \w in the country|strong="H7704"\w* \w of Moab|strong="H4124"\w* \w after|strong="H4480"\w* \w he had divorced|strong="H7971"\w* \w his wives|strong="H802"\w* \w Hushim|strong="H2366"\w* \w and Baara|strong="H1199"\w*. \v 9 \w His sons by|strong="H4480"\w* \w his wife|strong="H802"\w* \w Hodesh|strong="H2321"\w*:
\li2 \w Jobab|strong="H3103"\w*, \w Zibia|strong="H6644"\w*, \w Mesha|strong="H4331"\w*, \w Malcam|strong="H4445"\w*, \v 10 \w Jeuz|strong="H3263"\w*, \w Sachia|strong="H7634"\w*, \w and Mirmah|strong="H4821"\w*. \w These|strong="H428"\w* \w were his sons|strong="H1121"\w*, \w heads|strong="H7218"\w* \w of families|strong="H1"\w*.
\b 
\li1 \v 11 \w He also had sons|strong="H3205"\w* \w by Hushim|strong="H2366"\w*:
\li2 \w Abitub|strong="H36"\w* \w and Elpaal|strong="H508"\w*.
\b 
\li1 \v 12 \w The sons|strong="H1121"\w* \w of Elpaal|strong="H508"\w*:
\li2 \w Eber|strong="H5677"\w*, \w Misham|strong="H4936"\w*, \w Shemed|strong="H8106"\w* (\w who|strong="H1931"\w* \w built|strong="H1129"\w* \w Ono|strong="H207"\w* \w and Lod|strong="H3850"\w* \w with its villages|strong="H1323"\w*), \v 13 \w and Beriah|strong="H1283"\w* \w and Shema|strong="H8087"\w* (\w who|strong="H1992"\w* \w were the heads|strong="H7218"\w* \w of families|strong="H1"\w* \w living in|strong="H3427"\w* \w Aijalon|strong="H357"\w* \w and who|strong="H1992"\w* \w drove out|strong="H1272"\w* \w the inhabitants|strong="H3427"\w* \w of Gath|strong="H1661"\w*).
\b 
\li1 \v 14 \w Ahio|strong="H283"\w*, \w Shashak|strong="H8349"\w*, \w Jeremoth|strong="H3406"\w*, \v 15 \w Zebadiah|strong="H2069"\w*, \w Arad|strong="H6166"\w*, \w Eder|strong="H5738"\w*, \v 16 \w Michael|strong="H4317"\w*, \w Ishpah|strong="H3472"\w*, \w and Joha|strong="H3109"\w* \w were the sons|strong="H1121"\w* \w of Beriah|strong="H1283"\w*.
\b 
\li1 \v 17 \w Zebadiah|strong="H2069"\w*, \w Meshullam|strong="H4918"\w*, \w Hizki|strong="H2395"\w*, \w Heber|strong="H2268"\w*, \v 18 \w Ishmerai|strong="H3461"\w*, \w Izliah|strong="H3152"\w*, \w and Jobab|strong="H3103"\w* \w were the sons|strong="H1121"\w* \w of Elpaal|strong="H508"\w*.
\b 
\li1 \v 19 \w Jakim|strong="H3356"\w*, \w Zichri|strong="H2147"\w*, \w Zabdi|strong="H2067"\w*, \v 20 \w Elienai|strong="H462"\w*, \w Zillethai|strong="H6769"\w*, \w Eliel|strong="H447"\w*, \v 21 \w Adaiah|strong="H5718"\w*, \w Beraiah|strong="H1256"\w*, \w and Shimrath|strong="H8119"\w* \w were the sons|strong="H1121"\w* \w of Shimei|strong="H8096"\w*.
\b 
\li1 \v 22 \w Ishpan|strong="H3473"\w*, \w Eber|strong="H5677"\w*, \w Eliel|strong="H447"\w*, \v 23 \w Abdon|strong="H5658"\w*, \w Zichri|strong="H2147"\w*, \w Hanan|strong="H2605"\w*, \v 24 \w Hananiah|strong="H2608"\w*, \w Elam|strong="H5867"\w*, \w Anthothijah|strong="H6070"\w*, \v 25 \w Iphdeiah|strong="H3301"\w*, \w and Penuel|strong="H6439"\w* \w were the sons|strong="H1121"\w* \w of Shashak|strong="H8349"\w*.
\b 
\li1 \v 26 \w Shamsherai|strong="H8125"\w*, \w Shehariah|strong="H7841"\w*, \w Athaliah|strong="H6271"\w*, \v 27 \w Jaareshiah|strong="H3298"\w*, \w Elijah|strong="H452"\w*, \w and Zichri|strong="H2147"\w* \w were the sons|strong="H1121"\w* \w of Jeroham|strong="H3395"\w*.
\b 
\li1 \v 28 \w All these|strong="H428"\w* \w were heads|strong="H7218"\w* \w of families|strong="H1"\w*, \w the chiefs|strong="H7218"\w* \w according to their genealogies|strong="H8435"\w*, \w and they lived|strong="H3427"\w* \w in Jerusalem|strong="H3389"\w*.
\b 
\li1 \v 29 \w Jeiel the father|strong="H1"\w* \w of Gibeon|strong="H1391"\w* \w lived|strong="H3427"\w*\f + \fr 8:29 \ft Some LXX manuscripts (see also \ref 1 Chronicles 9:35|1CH 9:35\ref*); Hebrew \fqa The father of Gibeon lived\f* \w in Gibeon|strong="H1391"\w*. \w His wife’s|strong="H802"\w* \w name|strong="H8034"\w* \w was Maacah|strong="H4601"\w*, \v 30 \w and Abdon|strong="H5658"\w* \w was his firstborn|strong="H1060"\w* \w son|strong="H1121"\w*, \w then Zur|strong="H6698"\w*, \w Kish|strong="H7027"\w*, \w Baal|strong="H1168"\w*,\f + \fr 8:30 \ft Some LXX manuscripts include \fqa Ner\ft ; see \ref 1 Chronicles 9:36|1CH 9:36\ref*.\f* \w Nadab|strong="H5070"\w*, \v 31 \w Gedor|strong="H1446"\w*, \w Ahio|strong="H283"\w*, \w Zecher|strong="H2144"\w*,\f + \fr 8:31 \fqa Zecher \ft is likely a variant of \fqa Zechariah\ft ; see \ref 1 Chronicles 9:37|1CH 9:37\ref*.\f* \v 32 \w and Mikloth|strong="H4732"\w*, \w who was the father of|strong="H3205"\w* \w Shimeah|strong="H8039"\w*.\f + \fr 8:32 \fqa Shimeah \ft is a variant of \fqa Shimeam\ft ; see \ref 1 Chronicles 9:38|1CH 9:38\ref*.\f* \w They|strong="H1992"\w* \w too|strong="H637"\w* \w lived|strong="H3427"\w* \w alongside|strong="H5048"\w* \w their relatives|strong="H251"\w* \w in Jerusalem|strong="H3389"\w*.
\s1 The Family of Saul
\p \v 33 \w Ner|strong="H5369"\w* \w was the father of|strong="H3205"\w* \w Kish|strong="H7027"\w*, \w Kish|strong="H7027"\w* \w was the father of|strong="H3205"\w* \w Saul|strong="H7586"\w*, \w and Saul|strong="H7586"\w* \w was the father of|strong="H3205"\w* \w Jonathan|strong="H3083"\w*, \w Malchishua|strong="H4444"\w*, \w Abinadab|strong="H41"\w*, \w and Esh-baal|strong="H792"\w*.\f + \fr 8:33 \fqa Esh-baal \ft is also called \fqa Ish-bosheth\ft ; see \ref 2 Samuel 2:8|2SA 2:8\ref*.\f*
\b 
\li1 \v 34 \w The son|strong="H1121"\w* \w of Jonathan|strong="H3083"\w*:
\li2 \w Merib-baal|strong="H4807"\w*,\f + \fr 8:34 \fqa Merib-baal \ft is also called \fqa Mephibosheth\ft ; see \ref 2 Samuel 4:4|2SA 4:4\ref*.\f* \w and Merib-baal|strong="H4807"\w* \w was the father of|strong="H3205"\w* \w Micah|strong="H4318"\w*.\f + \fr 8:34 \fqa Micah \ft is a variant of \fqa Mica\ft ; see \ref 2 Samuel 9:12|2SA 9:12\ref*.\f*
\b 
\li1 \v 35 \w The sons|strong="H1121"\w* \w of Micah|strong="H4318"\w*:
\li2 \w Pithon|strong="H6377"\w*, \w Melech|strong="H4429"\w*, \w Tarea|strong="H8390"\w*,\f + \fr 8:35 \fqa Tarea \ft is a variant of \fqa Tahrea\ft ; see \ref 1 Chronicles 9:41|1CH 9:41\ref*.\f* \w and Ahaz|strong="H271"\w*.
\b 
