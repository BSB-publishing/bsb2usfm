\b 
\li1 \v 5 \w Ashhur|strong="H806"\w* \w the father of|strong="H1"\w* \w Tekoa|strong="H8620"\w* \w had|strong="H1961"\w* \w two|strong="H8147"\w* \w wives|strong="H802"\w*, \w Helah|strong="H2458"\w* \w and Naarah|strong="H5292"\w*.
\li2 \v 6 \w Naarah|strong="H5292"\w* \w bore|strong="H3205"\w* to him \w Ahuzzam|strong="H275"\w*, \w Hepher|strong="H2660"\w*, \w Temeni|strong="H8488"\w*, \w and|strong="H853"\w* \w Haahashtari|strong="H326"\w*. \w These|strong="H428"\w* \w were the descendants|strong="H1121"\w* \w of Naarah|strong="H5292"\w*.
\li2 \v 7 \w The sons|strong="H1121"\w* \w of Helah|strong="H2458"\w* \w were Zereth|strong="H6889"\w*, \w Zohar|strong="H3328"\w*,\f + \fr 4:7 \ft Alternate MT reading; the other alternate (see also Vulgate) reads \fqa Izhar\ft .\f* \w Ethnan|strong="H869"\w*, \v 8 \w and Koz|strong="H6976"\w*, \w who was the father of|strong="H3205"\w* \w Anub|strong="H6036"\w* \w and|strong="H853"\w* \w Zobebah|strong="H6637"\w* \w and of the clans|strong="H4940"\w* \w of Aharhel|strong="H316"\w* \w son|strong="H1121"\w* \w of Harum|strong="H2037"\w*.
\s1 The Prayer of Jabez
\li1 \v 9 \w Now Jabez|strong="H3258"\w* \w was|strong="H1961"\w* \w more honorable|strong="H3513"\w* \w than his brothers|strong="H251"\w*. \w His mother|strong="H517"\w* \w had named him|strong="H7121"\w* \w Jabez|strong="H3258"\w*,\f + \fr 4:9 \fqa Jabez \ft sounds like the Hebrew for \fqa pain \ft or \fqa distress\ft .\f* \w saying|strong="H559"\w*, “\w Because|strong="H3588"\w* \w I bore him|strong="H3205"\w* \w in pain|strong="H6090"\w*.”
\b 
\li1 \v 10 \w And Jabez|strong="H3258"\w* \w called out|strong="H7121"\w* \w to the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, “\w If only|strong="H518"\w* \w You would bless me|strong="H1288"\w* \w and enlarge|strong="H7235"\w* \w my territory|strong="H1366"\w*! \w May Your hand|strong="H3027"\w* \w be|strong="H1961"\w* \w with me|strong="H5973"\w* \w and keep me|strong="H6213"\w* \w from harm|strong="H7451"\w*, \w so that I will be free|strong="H1115"\w* \w from pain|strong="H6087"\w*.”
\b 
\li1 \w And God|strong="H430"\w* \w granted|strong="H935"\w* \w the request|strong="H7592"\w* \w of Jabez|strong="H853"\w*.
