\li1 \v 7 \w The Gershonites|strong="H1649"\w*: \w Ladan|strong="H3936"\w*\f + \fr 23:7 \fqa Ladan \ft is a variant of \fqa Libni\ft ; also in verses 8 and 9; see \ref 1 Chronicles 6:17|1CH 6:17\ref*.\f* \w and Shimei|strong="H8096"\w*.
\li1 \v 8 \w The sons|strong="H1121"\w* \w of Ladan|strong="H3936"\w*: \w Jehiel|strong="H3171"\w*\f + \fr 23:8 \fqa Jehiel \ft is a variant of \fqa Jehieli\ft ; see \ref 1 Chronicles 26:21|1CH 26:21\ref*.\f* \w the first|strong="H7218"\w*, \w Zetham|strong="H2241"\w*, \w and Joel|strong="H3100"\w*— \w three in all|strong="H7969"\w*.
\li1 \v 9 \w The sons|strong="H1121"\w* \w of Shimei|strong="H8096"\w*: \w Shelomoth|strong="H8013"\w*, \w Haziel|strong="H2381"\w*, \w and Haran|strong="H2039"\w*— \w three in all|strong="H7969"\w*. \w These were|strong="H428"\w* \w the heads|strong="H7218"\w* \w of the families|strong="H1"\w* \w of Ladan|strong="H3936"\w*.
\li1 \v 10 \w And the sons|strong="H1121"\w* \w of Shimei|strong="H8096"\w*:\f + \fr 23:10 \fqa Shimei \ft was possibly a son or grandson of the \fqa Shimei \ft listed in verse 9.\f* \w Jahath|strong="H3189"\w*, \w Zina|strong="H2126"\w*,\f + \fr 23:10 \ft Most Hebrew manuscripts; one Hebrew manuscript, LXX, and Vulgate (see also verse 11) \fqa Zizah\f* \w Jeush|strong="H3266"\w*, \w and Beriah|strong="H1283"\w*. \w These|strong="H428"\w* \w were the sons|strong="H1121"\w* \w of Shimei|strong="H8096"\w*— \w four in all|strong="H702"\w*. \v 11 \w Jahath|strong="H3189"\w* \w was|strong="H1961"\w* \w the first|strong="H7218"\w* \w and Zizah|strong="H2125"\w* \w was the second|strong="H8145"\w*; \w but Jeush|strong="H3266"\w* \w and Beriah|strong="H1283"\w* \w did not|strong="H3808"\w* \w have many|strong="H7235"\w* \w sons|strong="H1121"\w*, \w so they were counted as|strong="H1961"\w* \w one family|strong="H1"\w* \w and received a single|strong="H259"\w* \w assignment|strong="H6486"\w*.
\s1 The Kohathites
\r (\ref Numbers 3:27–32|NUM 3:27-32\ref*; \ref Numbers 4:1–20|NUM 4:1-20\ref*)
\li1 \v 12 \w The sons|strong="H1121"\w* \w of Kohath|strong="H6955"\w*: \w Amram|strong="H6019"\w*, \w Izhar|strong="H3324"\w*, \w Hebron|strong="H2275"\w*, \w and Uzziel|strong="H5816"\w*— \w four in all|strong="H702"\w*.
\li1 \v 13 \w The sons|strong="H1121"\w* \w of Amram|strong="H6019"\w*: \w Aaron|strong="H175"\w* \w and Moses|strong="H4872"\w*. \w Aaron|strong="H175"\w* \w and his descendants|strong="H1121"\w* \w were set apart|strong="H914"\w* \w forever|strong="H5704"\w* \w to consecrate|strong="H6942"\w* \w the most holy things|strong="H6944"\w*, \w to burn incense|strong="H6999"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*, \w to minister before Him|strong="H8334"\w*, \w and to pronounce blessings|strong="H1288"\w* \w in His name|strong="H8034"\w* \w forever|strong="H5704"\w*. \v 14 \w As for Moses|strong="H4872"\w* \w the man|strong="H376"\w* \w of God|strong="H430"\w*, \w his sons|strong="H1121"\w* \w were named|strong="H7121"\w* \w among|strong="H5921"\w* \w the tribe|strong="H7626"\w* \w of Levi|strong="H3878"\w*.
\li1 \v 15 \w The sons|strong="H1121"\w* \w of Moses|strong="H4872"\w*: \w Gershom|strong="H1647"\w* \w and Eliezer|strong="H461"\w*.
