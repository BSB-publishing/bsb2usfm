\p \v 11 \w Now|strong="H6258"\w*, \w my son|strong="H1121"\w*, \w may the LORD|strong="H3068"\w* \w be|strong="H1961"\w* \w with you|strong="H5973"\w*, \w and may you succeed|strong="H6743"\w* \w in building|strong="H1129"\w* \w the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w* \w your God|strong="H430"\w*, \w as|strong="H834"\w* \w He said|strong="H1696"\w* \w you would|strong="H5921"\w*. \v 12 \w Above all|strong="H389"\w*, \w may the LORD|strong="H3068"\w* \w give|strong="H5414"\w* you \w insight|strong="H7922"\w* \w and understanding|strong="H998"\w* \w when He puts you in command|strong="H6680"\w* \w over|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w so that you may keep|strong="H8104"\w* \w the Law|strong="H8451"\w* \w of the LORD|strong="H3068"\w* \w your God|strong="H430"\w*. \v 13 \w Then|strong="H227"\w* \w you will succeed|strong="H6743"\w*, \w if|strong="H518"\w* \w you carefully|strong="H8104"\w* \w follow|strong="H6213"\w* \w the statutes|strong="H2706"\w* \w and ordinances|strong="H4941"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w commanded|strong="H6680"\w* \w Moses|strong="H4872"\w* \w for|strong="H5921"\w* \w Israel|strong="H3478"\w*. \w Be strong|strong="H2388"\w* \w and courageous|strong="H553"\w*. \w Do not|strong="H408"\w* \w be afraid|strong="H3372"\w* \w or discouraged|strong="H2865"\w*.
\p \v 14 \w Now behold|strong="H2009"\w*, \w I have taken great pains|strong="H6040"\w* \w to provide|strong="H3559"\w* \w for the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*— \w 100,000|strong="H3967"\w* \w talents|strong="H3603"\w* \w of gold|strong="H2091"\w*,\f + \fr 22:14 \fqa 100,000 talents \ft is approximately 3,770 tons or 3,420 metric tons of gold.\f* \w 1,000,000|strong="H505"\w* \w talents|strong="H3603"\w* \w of silver|strong="H3701"\w*,\f + \fr 22:14 \fqa 1,000,000 talents \ft is approximately 37,700 tons or 34,200 metric tons of silver.\f* \w and bronze|strong="H5178"\w* \w and iron|strong="H1270"\w* \w too great|strong="H3588"\w* \w to be weighed|strong="H4948"\w*. \w I have also provided|strong="H3559"\w* \w timber|strong="H6086"\w* \w and stone|strong="H68"\w*, \w and you may add|strong="H3254"\w* \w to them|strong="H5921"\w*.
\p \v 15 \w You also have|strong="H5973"\w* \w many|strong="H7230"\w* \w workers|strong="H6213"\w*: \w stonecutters|strong="H2672"\w*, \w masons|strong="H2796"\w*, \w carpenters|strong="H6086"\w*, \w and men skilled|strong="H2450"\w* \w in every kind|strong="H3605"\w* \w of work|strong="H4399"\w* — \v 16 \w in gold|strong="H2091"\w* \w and silver|strong="H3701"\w*, \w bronze|strong="H5178"\w* \w and iron|strong="H1270"\w*— \w craftsmen beyond|strong="H369"\w* \w number|strong="H4557"\w*. \w Now begin|strong="H6965"\w* \w the work|strong="H6213"\w*, \w and may the LORD|strong="H3068"\w* \w be|strong="H1961"\w* \w with you|strong="H5973"\w*.”
\p \v 17 \w Then David|strong="H1732"\w* \w ordered|strong="H6680"\w* \w all|strong="H3605"\w* \w the leaders|strong="H8269"\w* \w of Israel|strong="H3478"\w* \w to help|strong="H5826"\w* \w his son|strong="H1121"\w* \w Solomon|strong="H8010"\w*: \v 18 “\w Is not|strong="H3808"\w* \w the LORD|strong="H3068"\w* \w your God|strong="H430"\w* \w with you|strong="H5973"\w*, \w and has He not granted you rest|strong="H5117"\w* \w on every side|strong="H5439"\w*? \w For|strong="H3588"\w* \w He has given|strong="H5414"\w* \w the inhabitants|strong="H3427"\w* \w of the land|strong="H776"\w* \w into my hand|strong="H3027"\w*, \w and the land|strong="H776"\w* \w has been subdued|strong="H3533"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w and His people|strong="H5971"\w*. \v 19 \w Now|strong="H6258"\w* \w set|strong="H5414"\w* \w your heart|strong="H3824"\w* \w and soul|strong="H5315"\w* \w to seek|strong="H1875"\w* \w the LORD|strong="H3068"\w* \w your God|strong="H430"\w*. \w Begin|strong="H6965"\w* \w building|strong="H1129"\w* \w the sanctuary|strong="H4720"\w* \w of the LORD|strong="H3068"\w* \w God|strong="H430"\w*, \w so that you may bring|strong="H935"\w* \w the ark|strong="H727"\w* \w of the covenant|strong="H1285"\w* \w of the LORD|strong="H3068"\w* \w and the holy|strong="H6944"\w* \w articles|strong="H3627"\w* \w of God|strong="H430"\w* \w into the temple|strong="H1004"\w* \w that will be built|strong="H1129"\w* \w for the Name|strong="H8034"\w* \w of the LORD|strong="H3068"\w*.”
\c 23
\s1 The Divisions of the Levites
\p \v 1 \w When David|strong="H1732"\w* \w was old|strong="H2204"\w* \w and full of|strong="H7646"\w* \w years|strong="H3117"\w*, \w he installed his son|strong="H1121"\w* \w Solomon|strong="H8010"\w* \w as king|strong="H4427"\w* \w over|strong="H5921"\w* \w Israel|strong="H3478"\w*. \v 2 \w Then he gathered|strong="H622"\w* \w all|strong="H3605"\w* \w the leaders|strong="H8269"\w* \w of Israel|strong="H3478"\w*, \w as well as the priests|strong="H3548"\w* \w and Levites|strong="H3881"\w*.
\p \v 3 \w The Levites|strong="H3881"\w* \w thirty|strong="H7970"\w* \w years of age|strong="H1121"\w* \w or older|strong="H4605"\w* \w were counted|strong="H5608"\w*, \w and the total number|strong="H4557"\w* \w of men|strong="H1397"\w* \w was|strong="H1961"\w* \w 38,000|strong="H7970"\w*. \v 4 “\w Of these,” said David,|strong="H428"\w*\f + \fr 23:4 \ft Hebrew does not include \fqa said David,\f* \w “24,000|strong="H6242"\w* \w are to oversee|strong="H5329"\w* \w the work|strong="H4399"\w* \w of the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*, \w 6,000|strong="H8337"\w* \w are to be officers|strong="H7860"\w* \w and judges|strong="H8199"\w*, \v 5 \w 4,000|strong="H702"\w* \w are to be gatekeepers|strong="H7778"\w*, \w and 4,000|strong="H702"\w* \w are to praise|strong="H1984"\w* \w the LORD|strong="H3068"\w* \w with the instruments|strong="H3627"\w* \w I have made|strong="H6213"\w* \w for giving praise|strong="H1984"\w*.”
\p \v 6 \w Then David|strong="H1732"\w* \w divided the Levites|strong="H2505"\w* \w into divisions|strong="H4256"\w* \w according to the sons|strong="H1121"\w* \w of Levi|strong="H3878"\w*:
\b 
\li1 \w Gershon|strong="H1648"\w*, \w Kohath|strong="H6955"\w*, \w and Merari|strong="H4847"\w*.
