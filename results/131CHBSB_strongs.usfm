\c 10
\s1 Saul’s Overthrow and Death
\r (\ref 1 Samuel 31:1–6|1SA 31:1-6\ref*; \ref 2 Samuel 1:1–16|2SA 1:1-16\ref*)
\p \v 1 \w Now the Philistines|strong="H6430"\w* \w fought|strong="H3898"\w* \w against Israel|strong="H3478"\w*, \w and the men|strong="H376"\w* \w of Israel|strong="H3478"\w* \w fled|strong="H5127"\w* \w before|strong="H6440"\w* \w them|strong="H6430"\w*, \w and many fell|strong="H5307"\w* \w slain|strong="H2491"\w* \w on Mount|strong="H2022"\w* \w Gilboa|strong="H1533"\w*.
\p \v 2 \w The Philistines|strong="H6430"\w* \w followed hard after|strong="H1692"\w* \w Saul|strong="H7586"\w* \w and his sons|strong="H1121"\w*, \w and they killed|strong="H5221"\w* \w Saul’s|strong="H7586"\w* \w sons|strong="H1121"\w* \w Jonathan|strong="H3129"\w*, \w Abinadab|strong="H41"\w*, \w and Malchishua|strong="H4444"\w*. \v 3 \w When the battle|strong="H4421"\w* \w intensified|strong="H3513"\w* \w against|strong="H5921"\w* \w Saul|strong="H7586"\w*, \w the archers|strong="H3384"\w* \w overtook him|strong="H4672"\w* \w and wounded him|strong="H2342"\w*.
