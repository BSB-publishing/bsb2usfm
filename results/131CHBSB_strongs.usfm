\p \w These were|strong="H428"\w* \w the leaders|strong="H8269"\w* \w of the tribes|strong="H7626"\w* \w of Israel|strong="H3478"\w*.
\p \v 23 \w David|strong="H1732"\w* \w did not|strong="H3808"\w* \w count|strong="H5375"\w* \w the men|strong="H1121"\w* \w aged|strong="H8141"\w* \w twenty|strong="H6242"\w* \w or under|strong="H4295"\w*, \w because|strong="H3588"\w* \w the LORD|strong="H3068"\w* \w had said that|strong="H559"\w* \w He would make Israel|strong="H3478"\w* \w as numerous|strong="H7235"\w* \w as the stars|strong="H3556"\w* \w of the sky|strong="H8064"\w*. \v 24 \w Joab|strong="H3097"\w* \w son|strong="H1121"\w* \w of Zeruiah|strong="H6870"\w* \w began|strong="H2490"\w* \w to count the men|strong="H4487"\w* \w but did not|strong="H3808"\w* \w finish|strong="H3615"\w*. \w For because of this census|strong="H2063"\w* \w wrath|strong="H7110"\w* \w came|strong="H1961"\w* \w upon|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w and the number|strong="H4557"\w* \w was not|strong="H3808"\w* \w entered|strong="H5927"\w* \w in the Book|strong="H1697"\w* \w of the Chronicles|strong="H3117"\w* \w of King|strong="H4428"\w* \w David|strong="H1732"\w*.
