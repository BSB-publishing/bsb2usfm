\c 12
\s1 The Mighty Men Join David at Ziklag
\p \v 1 \w Now these were the men|strong="H428"\w* \w who came|strong="H935"\w* \w to|strong="H413"\w* \w David|strong="H1732"\w* \w at Ziklag|strong="H6860"\w*, \w while|strong="H5750"\w* \w he was still banished|strong="H6113"\w* \w from the presence|strong="H6440"\w* \w of Saul|strong="H7586"\w* \w son|strong="H1121"\w* \w of Kish|strong="H7027"\w* (\w they|strong="H1992"\w* \w were among the mighty men|strong="H1368"\w* \w who helped him|strong="H5826"\w* \w in battle|strong="H4421"\w*; \v 2 \w they were archers|strong="H5401"\w* \w using both the right|strong="H3231"\w* \w and left hands|strong="H8041"\w* \w to sling stones|strong="H68"\w* \w and shoot arrows|strong="H2671"\w*; \w and they were Saul’s|strong="H7586"\w* \w kinsmen|strong="H251"\w* \w from Benjamin|strong="H1144"\w*):
\b 
\li1 \v 3 \w Ahiezer|strong="H295"\w* \w their chief|strong="H7218"\w* \w and Joash|strong="H3101"\w*, \w who were the sons|strong="H1121"\w* \w of Shemaah|strong="H8094"\w* \w the Gibeathite|strong="H1395"\w*;
\li1 \w Jeziel|strong="H3149"\w* \w and Pelet|strong="H6404"\w*, \w the sons|strong="H1121"\w* \w of Azmaveth|strong="H5820"\w*;
\li1 \w Beracah|strong="H1294"\w*;
\li1 \w Jehu|strong="H3058"\w* \w the Anathothite|strong="H6069"\w*;
\li1 \v 4 \w Ishmaiah|strong="H3460"\w* \w the Gibeonite|strong="H1393"\w*, \w a mighty man|strong="H1368"\w* \w among the Thirty|strong="H7970"\w* \w and a leader over|strong="H5921"\w* \w the Thirty|strong="H7970"\w*;
\li1 \w Jeremiah|strong="H3414"\w*, \w Jahaziel|strong="H3166"\w*, \w Johanan|strong="H3076"\w*, \w and Jozabad|strong="H3107"\w* \w the Gederathite|strong="H1452"\w*;
\li1 \v 5 \w Eluzai|strong="H498"\w*, \w Jerimoth|strong="H3406"\w*, \w Bealiah|strong="H1183"\w*, \w Shemariah|strong="H8114"\w*, \w and Shephatiah|strong="H8203"\w* \w the Haruphite|strong="H2741"\w*;
\li1 \v 6 \w Elkanah|strong="H511"\w*, \w Isshiah|strong="H3449"\w*, \w Azarel|strong="H5832"\w*, \w Joezer|strong="H3134"\w*, \w and Jashobeam|strong="H3434"\w*, \w who were Korahites|strong="H7145"\w*;
\li1 \v 7 \w and Joelah|strong="H3132"\w* \w and Zebadiah|strong="H2069"\w*, \w the sons|strong="H1121"\w* \w of Jeroham|strong="H3395"\w* \w from|strong="H4480"\w* \w Gedor|strong="H1446"\w*.
\p \v 8 \w Some|strong="H4480"\w* \w Gadites|strong="H1425"\w* \w defected|strong="H914"\w* \w to|strong="H413"\w* \w David|strong="H1732"\w* \w at his stronghold|strong="H4679"\w* \w in the wilderness|strong="H4057"\w*. \w They were mighty|strong="H1368"\w* \w men|strong="H376"\w* \w of valor|strong="H2428"\w*, \w trained|strong="H6635"\w* \w for battle|strong="H4421"\w*, \w experts|strong="H6186"\w* \w with the shield|strong="H6793"\w* \w and spear|strong="H7420"\w*, \w whose faces were like|strong="H6440"\w* \w the faces|strong="H6440"\w* \w of lions|strong="H738"\w* \w and who were as swift|strong="H4116"\w* \w as gazelles|strong="H6643"\w* \w on|strong="H5921"\w* \w the mountains|strong="H2022"\w*:
\li1 \v 9 \w Ezer|strong="H5829"\w* \w the chief|strong="H7218"\w*, \w Obadiah|strong="H5662"\w* \w the second in command|strong="H8145"\w*, \w Eliab|strong="H446"\w* \w the third|strong="H7992"\w*, \v 10 \w Mishmannah|strong="H4925"\w* \w the fourth|strong="H7243"\w*, \w Jeremiah|strong="H3414"\w* \w the fifth|strong="H2549"\w*, \v 11 \w Attai|strong="H6262"\w* \w the sixth|strong="H8345"\w*, \w Eliel|strong="H447"\w* \w the seventh|strong="H7637"\w*, \v 12 \w Johanan|strong="H3076"\w* \w the eighth|strong="H8066"\w*, \w Elzabad|strong="H443"\w* \w the ninth|strong="H8671"\w*, \v 13 \w Jeremiah|strong="H3414"\w* \w the tenth|strong="H6224"\w*, \w and Machbanai|strong="H4344"\w* \w the eleventh|strong="H6249"\w*.
\p \v 14 \w These|strong="H428"\w* \w Gadites|strong="H1121"\w* \w were army|strong="H6635"\w* \w commanders|strong="H7218"\w*, \w the least of whom|strong="H6996"\w* \w was a match for a hundred|strong="H3967"\w*, \w and the greatest|strong="H1419"\w* \w for a thousand|strong="H505"\w*.
\p \v 15 \w These|strong="H428"\w* \w are|strong="H1992"\w* \w the ones who|strong="H834"\w* \w crossed|strong="H5674"\w* \w the Jordan|strong="H3383"\w* \w in the first|strong="H7223"\w* \w month|strong="H2320"\w* \w when it was overflowing|strong="H4390"\w* \w all|strong="H3605"\w* \w its banks|strong="H1428"\w*, \w and they put to flight|strong="H1272"\w* \w all those|strong="H3605"\w* \w in the valleys|strong="H6010"\w*, \w both to the east|strong="H4217"\w* \w and to the west|strong="H4628"\w*.
\p \v 16 \w Other Benjamites|strong="H1121"\w* \w and some men from Judah|strong="H3063"\w* \w also came|strong="H935"\w* \w to David|strong="H1732"\w* \w in his stronghold|strong="H4679"\w*. \v 17 \w And David|strong="H3318"\w* \w went out|strong="H1732"\w* \w to meet them|strong="H6440"\w*, \w saying|strong="H559"\w*, “\w If|strong="H518"\w* \w you have come|strong="H935"\w* \w to me|strong="H413"\w* \w in peace|strong="H7965"\w* \w to help me|strong="H5826"\w*, my \w heart|strong="H3824"\w* \w will be|strong="H1961"\w* \w united|strong="H3162"\w* \w with you|strong="H5921"\w*; \w but if|strong="H518"\w* \w you have come to betray me|strong="H7411"\w* \w to my enemies|strong="H6862"\w* \w when my hands|strong="H3709"\w* \w are free|strong="H3808"\w* \w of violence|strong="H2555"\w*, \w may the God|strong="H430"\w* \w of our fathers|strong="H1"\w* \w see it|strong="H7200"\w* \w and judge you|strong="H3198"\w*.”
\p \v 18 \w Then the Spirit|strong="H7307"\w* \w came upon|strong="H3847"\w* \w Amasai|strong="H6022"\w*, \w the chief|strong="H7218"\w* \w of the Thirty, and he said|strong="H7970"\w*:
\b 
\q1 “We are yours, \w O David|strong="H1732"\w*!
\q2 \w We are with you|strong="H5973"\w*, \w O son|strong="H1121"\w* \w of Jesse|strong="H3448"\w*!
\q1 \w Peace|strong="H7965"\w*, \w peace|strong="H7965"\w* to you,
\q2 \w and peace|strong="H7965"\w* \w to your helpers|strong="H5826"\w*,
\q2 \w for|strong="H3588"\w* \w your God|strong="H430"\w* \w helps you|strong="H5826"\w*.”
\p \w So David|strong="H1732"\w* \w received them|strong="H6901"\w* \w and made them|strong="H5414"\w* \w leaders|strong="H7218"\w* \w of his troops|strong="H1416"\w*.
\p \v 19 \w Some from|strong="H5307"\w* \w Manasseh|strong="H4519"\w* \w defected|strong="H5921"\w* \w to David|strong="H1732"\w* \w when he went|strong="H935"\w* \w with|strong="H5973"\w* \w the Philistines|strong="H6430"\w* \w to fight|strong="H5921"\w* \w against|strong="H7586"\w* \w Saul|strong="H4421"\w*. (\w They did not|strong="H3808"\w* \w help the Philistines|strong="H5826"\w* \w because|strong="H3588"\w* \w the Philistine|strong="H6430"\w* \w rulers|strong="H5633"\w* \w consulted|strong="H6098"\w* \w and sent David away|strong="H7971"\w*, \w saying|strong="H559"\w*, “\w It will cost us our heads|strong="H7218"\w* \w if he defects|strong="H5307"\w* \w to|strong="H413"\w* \w his master|strong="H113"\w* \w Saul|strong="H7586"\w*.”) \v 20 \w When David went|strong="H1980"\w* \w to|strong="H413"\w* \w Ziklag|strong="H6860"\w*, \w these men of Manasseh|strong="H4519"\w* \w defected|strong="H5307"\w* \w to him|strong="H5921"\w*:
\li1 \w Adnah|strong="H5734"\w*, \w Jozabad|strong="H3107"\w*, \w Jediael|strong="H3043"\w*, \w Michael|strong="H4317"\w*, \w Jozabad|strong="H3107"\w*, \w Elihu|strong="H453"\w*, \w and Zillethai|strong="H6769"\w*, \w chiefs|strong="H7218"\w* \w of thousands|strong="H505"\w* \w in Manasseh|strong="H4519"\w*.
\p \v 21 \w They|strong="H1992"\w* \w helped|strong="H5826"\w* \w David|strong="H1732"\w* \w against|strong="H5921"\w* \w the raiders|strong="H1416"\w*, \w for|strong="H3588"\w* \w they were|strong="H1961"\w* \w all|strong="H3605"\w* \w mighty men|strong="H1368"\w* \w of valor|strong="H2428"\w* \w and commanders|strong="H8269"\w* \w in the army|strong="H6635"\w*.
\p \v 22 \w For|strong="H3588"\w* \w at that time|strong="H6256"\w* \w men came|strong="H935"\w* \w to|strong="H5921"\w* \w David|strong="H1732"\w* \w day|strong="H3117"\w* \w after day|strong="H3117"\w* \w to help him|strong="H5826"\w*, \w until|strong="H5704"\w* \w he had a great|strong="H1419"\w* \w army|strong="H4264"\w*, \w like the army|strong="H4264"\w* \w of God|strong="H430"\w*.
\s1 David’s Army Grows at Hebron
\p \v 23 \w Now these are|strong="H428"\w* \w the numbers|strong="H4557"\w* \w of men|strong="H7218"\w* \w armed|strong="H2502"\w* \w for battle|strong="H6635"\w* \w who came|strong="H935"\w* \w to|strong="H5921"\w* \w David|strong="H1732"\w* \w at Hebron|strong="H2275"\w* \w to turn Saul’s|strong="H7586"\w* \w kingdom|strong="H4438"\w* \w over|strong="H5437"\w* \w to him|strong="H413"\w*, \w in accordance with the word of|strong="H6310"\w* \w the LORD|strong="H3068"\w*:
\pmo \v 24 \w From Judah|strong="H1121"\w*: \w 6,800|strong="H8337"\w* \w armed|strong="H2502"\w* \w troops|strong="H6635"\w* \w bearing|strong="H5375"\w* \w shields|strong="H6793"\w* \w and spears|strong="H7420"\w*.
\pmo \v 25 \w From|strong="H4480"\w* \w Simeon|strong="H1121"\w*: \w 7,100|strong="H7651"\w* \w mighty men|strong="H1368"\w* \w of valor|strong="H2428"\w*, \w ready for battle|strong="H6635"\w*.
\pmo \v 26 \w From|strong="H4480"\w* \w Levi|strong="H1121"\w*: \w 4,600|strong="H702"\w*, \v 27 \w including Jehoiada|strong="H3077"\w*, \w leader|strong="H5057"\w* \w of the house of Aaron|strong="H175"\w*, \w with|strong="H5973"\w* \w 3,700|strong="H7969"\w* \w men|strong="H3967"\w*, \v 28 \w and Zadok|strong="H6659"\w*, \w a mighty|strong="H1368"\w* \w young man|strong="H5288"\w* \w of valor|strong="H2428"\w*, \w with 22|strong="H6242"\w* \w commanders|strong="H8269"\w* \w from his own family|strong="H1"\w*.
\pmo \v 29 \w From|strong="H4480"\w* \w Benjamin|strong="H1121"\w*, \w the kinsmen|strong="H251"\w* \w of Saul|strong="H7586"\w*: \w 3,000|strong="H7969"\w*, \w most of whom|strong="H4768"\w* \w had remained|strong="H8104"\w* \w loyal to|strong="H4931"\w* \w the house|strong="H1004"\w* \w of Saul|strong="H7586"\w* \w up to|strong="H5704"\w* \w that time|strong="H2008"\w*.
\pmo \v 30 \w From|strong="H4480"\w* \w Ephraim|strong="H1121"\w*: \w 20,800|strong="H6242"\w* \w mighty men|strong="H1368"\w* \w of valor|strong="H2428"\w*, \w famous|strong="H8034"\w* \w among their own clans|strong="H1004"\w*.
\pmo \v 31 \w From the half-tribe|strong="H2677"\w* \w of Manasseh|strong="H4519"\w*:\f + \fr 12:31 \ft That is, the half-tribe of Manasseh west of the Jordan\f* \w 18,000|strong="H8083"\w* \w designated|strong="H5344"\w* \w by name|strong="H8034"\w* \w to come|strong="H935"\w* \w and make David|strong="H1732"\w* \w king|strong="H4427"\w*.
\pmo \v 32 \w From Issachar|strong="H1121"\w*, \w men who understood|strong="H3045"\w* \w the times|strong="H6256"\w* \w and knew|strong="H3045"\w* \w what|strong="H4100"\w* \w Israel|strong="H3478"\w* \w should do|strong="H6213"\w*: \w 200|strong="H3967"\w* \w chiefs|strong="H7218"\w* \w with all|strong="H3605"\w* \w their kinsmen|strong="H251"\w* \w at|strong="H5921"\w* \w their command|strong="H6310"\w*.
\pmo \v 33 \w From Zebulun|strong="H2074"\w*: \w 50,000|strong="H2572"\w* \w fit for service|strong="H3318"\w*, \w trained|strong="H6186"\w* \w for battle|strong="H4421"\w* \w with all kinds|strong="H3605"\w* \w of weapons|strong="H3627"\w* \w of war|strong="H4421"\w*, \w who with one purpose|strong="H3820"\w* \w were devoted to David|strong="H5737"\w*.\f + \fr 12:33 \ft LXX; Hebrew does not include \fqa to David\ft .\f*
\pmo \v 34 \w From Naphtali|strong="H5321"\w*: \w 1,000|strong="H8269"\w* \w commanders|strong="H505"\w*, \w accompanied|strong="H5973"\w* \w by 37,000|strong="H7970"\w* \w men with shield|strong="H6793"\w* \w and spear|strong="H2595"\w*.
\pmo \v 35 \w From|strong="H4480"\w* \w Dan|strong="H1839"\w*: \w 28,600|strong="H6242"\w* \w prepared|strong="H6186"\w* \w for battle|strong="H4421"\w*.
\pmo \v 36 \w From Asher|strong="H836"\w*: \w 40,000|strong="H705"\w* \w fit for service|strong="H3318"\w*, \w prepared|strong="H6186"\w* \w for battle|strong="H4421"\w*.
\pmo \v 37 \w And from east|strong="H5676"\w* \w of the Jordan|strong="H3383"\w*, \w from|strong="H4480"\w* \w Reuben|strong="H7206"\w*, \w Gad|strong="H1425"\w*, \w and|strong="H2677"\w* \w the half-tribe|strong="H7626"\w* \w of Manasseh there|strong="H4519"\w*: \w 120,000|strong="H3967"\w* \w armed with every kind|strong="H3605"\w* \w of weapon|strong="H3627"\w* \w of war|strong="H4421"\w*.
\p \v 38 \w All|strong="H3605"\w* \w these|strong="H428"\w* \w men|strong="H376"\w* \w of war|strong="H4421"\w*, \w arrayed|strong="H5737"\w* \w for battle|strong="H4634"\w*, \w came|strong="H935"\w* \w to Hebron|strong="H2275"\w* \w fully|strong="H8003"\w* \w determined|strong="H3824"\w* \w to make David|strong="H1732"\w* \w king|strong="H4427"\w* \w over|strong="H5921"\w* \w all|strong="H3605"\w* \w Israel|strong="H3478"\w*. \w And|strong="H1571"\w* \w all|strong="H3605"\w* \w the rest|strong="H7611"\w* \w of the Israelites|strong="H3478"\w* \w were of one|strong="H259"\w* \w mind|strong="H3820"\w* \w to make David|strong="H1732"\w* \w king|strong="H4427"\w*.
\p \v 39 \w They spent|strong="H1961"\w* \w three|strong="H7969"\w* \w days|strong="H3117"\w* \w there|strong="H8033"\w* \w eating|strong="H398"\w* \w and drinking|strong="H8354"\w* \w with|strong="H5973"\w* \w David|strong="H1732"\w*, \w for their|strong="H3588"\w* relatives \w had provided for them|strong="H3559"\w*. \v 40 \w And their neighbors|strong="H1571"\w* \w from as far away as|strong="H413"\w* \w Issachar|strong="H3485"\w*, \w Zebulun|strong="H2074"\w*, \w and Naphtali|strong="H5321"\w* \w came bringing|strong="H935"\w* \w food|strong="H3899"\w* \w on donkeys|strong="H2543"\w*, \w camels|strong="H1581"\w*, \w mules|strong="H6505"\w*, \w and oxen|strong="H1241"\w*— \w abundant supplies|strong="H3978"\w* \w of flour|strong="H7058"\w*, \w fig cakes|strong="H1690"\w* \w and|strong="H6778"\w* \w raisin cakes|strong="H3196"\w*, \w wine|strong="H8081"\w* \w and oil|strong="H1241"\w*, \w oxen|strong="H6629"\w* \w and sheep|strong="H7230"\w*. \w Indeed|strong="H3588"\w*, \w there was joy|strong="H8057"\w* \w in Israel|strong="H3478"\w*.
\c 13
\s1 David Fetches the Ark
\r (\ref 2 Samuel 6:1–4|2SA 6:1-4\ref*)
\p \v 1 \w Then David|strong="H1732"\w* \w conferred|strong="H3289"\w* \w with|strong="H5973"\w* \w all|strong="H3605"\w* \w his leaders|strong="H5057"\w*, \w the commanders|strong="H8269"\w* \w of thousands|strong="H505"\w* \w and of hundreds|strong="H3967"\w*. \v 2 \w And he|strong="H1732"\w* \w said|strong="H559"\w* \w to the whole|strong="H3605"\w* \w assembly|strong="H6951"\w* \w of Israel|strong="H3478"\w*, “\w If|strong="H518"\w* \w it seems good|strong="H2896"\w* \w to you|strong="H5921"\w*, \w and if this is|strong="H4480"\w* \w of the LORD|strong="H3068"\w* \w our God|strong="H430"\w*, \w let us send word|strong="H7971"\w* \w far and wide|strong="H6555"\w* \w to|strong="H5921"\w* \w the rest|strong="H7604"\w* \w of our brothers|strong="H251"\w* \w in all|strong="H3605"\w* \w the land|strong="H776"\w* \w of Israel|strong="H3478"\w*, \w and also|strong="H5973"\w* \w to the priests|strong="H3548"\w* \w and Levites|strong="H3881"\w* \w in their cities|strong="H5892"\w* \w and pasturelands|strong="H4054"\w*, \w so that they may join|strong="H6908"\w* \w us|strong="H413"\w*. \v 3 \w Then let us bring back|strong="H5437"\w* \w the ark|strong="H727"\w* \w of our God|strong="H430"\w*, \w for|strong="H3588"\w* \w we did not|strong="H3808"\w* \w inquire of Him|strong="H1875"\w*\f + \fr 13:3 \ft Or \fqa of it\f* \w in the days|strong="H3117"\w* \w of Saul|strong="H7586"\w*.”
\p \v 4 \w And|strong="H559"\w* \w because|strong="H3588"\w* \w this proposal|strong="H1697"\w* \w seemed|strong="H5869"\w* \w right|strong="H3474"\w* \w to all|strong="H3605"\w* \w the people|strong="H5971"\w*, \w the whole|strong="H3605"\w* \w assembly|strong="H6951"\w* \w agreed to it|strong="H6213"\w*. \v 5 \w So David|strong="H1732"\w* \w assembled|strong="H6950"\w* \w all|strong="H3605"\w* \w Israel|strong="H3478"\w*, \w from|strong="H4480"\w* \w the River Shihor|strong="H7883"\w*\f + \fr 13:5 \ft Hebrew \fqa from the Shihor\f* \w in Egypt|strong="H4714"\w* \w to Lebo-hamath|strong="H5704"\w*, \w to bring|strong="H935"\w* \w the ark|strong="H727"\w* \w of God|strong="H430"\w* \w from Kiriath-jearim|strong="H7157"\w*.
\p \v 6 \w David|strong="H1732"\w* \w and all|strong="H3605"\w* \w Israel|strong="H3478"\w* \w went up|strong="H5927"\w* \w to Baalah|strong="H1173"\w* \w of|strong="H834"\w* \w Judah|strong="H3063"\w* (\w that is, Kiriath-jearim|strong="H7157"\w*) \w to bring up|strong="H5927"\w* \w from there|strong="H8033"\w* \w the ark|strong="H727"\w* \w of God|strong="H430"\w* \w the LORD|strong="H3068"\w*, \w who is enthroned|strong="H3427"\w* \w between the cherubim|strong="H3742"\w* — \w the ark that|strong="H834"\w* \w is called|strong="H7121"\w* \w by the Name|strong="H8034"\w*.\f + \fr 13:6 \ft Or \fqa the ark of God, which is called by the Name of the LORD who is enthroned between the cherubim\ft ; or \fqa the ark of God, the LORD, who is enthroned between the cherubim, where His Name is called\f* \v 7 \w So they carried|strong="H7392"\w* \w the ark|strong="H727"\w* \w of God|strong="H430"\w* \w from the house|strong="H1004"\w* \w of Abinadab|strong="H41"\w* \w on|strong="H5921"\w* \w a new|strong="H2319"\w* \w cart|strong="H5699"\w*, \w with Uzzah|strong="H5798"\w* \w and Ahio|strong="H283"\w* \w guiding|strong="H5090"\w* \w the cart|strong="H5699"\w*.
\s1 Uzzah Touches the Ark
\r (\ref 2 Samuel 6:5–11|2SA 6:5-11\ref*)
\p \v 8 \w David|strong="H1732"\w* \w and all|strong="H3605"\w* \w the Israelites|strong="H3478"\w* \w were celebrating|strong="H7832"\w* \w before|strong="H6440"\w* \w God|strong="H430"\w* \w with all|strong="H3605"\w* \w their might|strong="H5797"\w*, \w with songs|strong="H7892"\w* \w and on harps|strong="H3658"\w* \w and lyres|strong="H5035"\w*, \w with tambourines|strong="H8596"\w*, \w cymbals|strong="H4700"\w*, \w and trumpets|strong="H2689"\w*.
\p \v 9 \w When they came|strong="H935"\w* \w to|strong="H5704"\w* \w the threshing floor|strong="H1637"\w* \w of Chidon|strong="H3592"\w*,\f + \fr 13:9 \fqa Chidon \ft is a variant of \fqa Nacon\ft ; see \ref 2 Samuel 6:6|2SA 6:6\ref*.\f* \w Uzzah|strong="H5798"\w* \w reached out|strong="H7971"\w* \w and took hold|strong="H270"\w* \w of|strong="H853"\w* \w the ark|strong="H727"\w*, \w because|strong="H3588"\w* \w the oxen|strong="H1241"\w* \w had stumbled|strong="H8058"\w*. \v 10 \w And the anger|strong="H639"\w* \w of the LORD|strong="H3068"\w* \w burned|strong="H2734"\w* \w against Uzzah|strong="H5798"\w*, \w and He struck him|strong="H5221"\w* \w down|strong="H5921"\w* \w because|strong="H834"\w* \w he had put|strong="H7971"\w* \w his hand|strong="H3027"\w* \w on|strong="H5921"\w* \w the ark|strong="H727"\w*. \w So he died|strong="H4191"\w* \w there|strong="H8033"\w* \w before|strong="H6440"\w* \w God|strong="H430"\w*.
\p \v 11 \w Then David|strong="H1732"\w* \w became angry|strong="H2734"\w* \w because|strong="H3588"\w* \w the LORD|strong="H3068"\w* \w had burst forth|strong="H6555"\w* \w against Uzzah|strong="H5798"\w*. \w So he named|strong="H7121"\w* \w that|strong="H1931"\w* \w place|strong="H4725"\w* \w Perez-uzzah|strong="H6560"\w*,\f + \fr 13:11 \fqa Perez-uzzah \ft means \fqa outbreak against Uzzah\ft .\f* \w as it is called to|strong="H5704"\w* \w this|strong="H2088"\w* \w day|strong="H3117"\w*.
\p \v 12 \w That|strong="H1931"\w* \w day|strong="H3117"\w* \w David|strong="H1732"\w* \w feared|strong="H3372"\w* \w God|strong="H430"\w* \w and asked|strong="H559"\w*, “\w How|strong="H1963"\w* \w can I ever bring|strong="H935"\w* \w the ark|strong="H727"\w* \w of God|strong="H430"\w* \w to me|strong="H413"\w*?” \v 13 \w So he|strong="H1732"\w* \w did not|strong="H3808"\w* \w move|strong="H5493"\w* \w the ark|strong="H727"\w* \w with him|strong="H413"\w* \w to the City|strong="H5892"\w* \w of David|strong="H1732"\w*; \w instead, he took|strong="H5186"\w* \w it aside|strong="H413"\w* \w to|strong="H413"\w* \w the house|strong="H1004"\w* \w of Obed-edom|strong="H5654"\w* \w the Gittite|strong="H1663"\w*. \v 14 \w Thus the ark|strong="H727"\w* \w of God|strong="H430"\w* \w remained|strong="H3427"\w* \w with|strong="H5973"\w* \w the family|strong="H1004"\w* \w of Obed-edom|strong="H5654"\w* \w in his house|strong="H1004"\w* \w for three|strong="H7969"\w* \w months|strong="H2320"\w*, \w and the LORD|strong="H3068"\w* \w blessed|strong="H1288"\w* \w his|strong="H5654"\w* \w household|strong="H1004"\w* \w and everything|strong="H3605"\w* he owned.
\c 14
\s1 David’s Family Grows
\r (\ref 2 Samuel 5:12–16|2SA 5:12-16\ref*)
\p \v 1 \w Now Hiram|strong="H2438"\w* \w king|strong="H4428"\w* \w of Tyre|strong="H6865"\w* \w sent|strong="H7971"\w* \w envoys|strong="H4397"\w* \w to|strong="H413"\w* \w David|strong="H1732"\w*, \w along with cedar|strong="H730"\w* \w logs|strong="H6086"\w*, \w stonemasons|strong="H2796"\w*, \w and carpenters|strong="H2796"\w*, \w to build|strong="H1129"\w* \w a palace|strong="H1004"\w* for him. \v 2 \w And David|strong="H1732"\w* \w realized|strong="H3045"\w* \w that|strong="H3588"\w* \w the LORD|strong="H3068"\w* \w had established him|strong="H3559"\w* \w as king|strong="H4428"\w* \w over|strong="H5921"\w* \w Israel|strong="H3478"\w* \w and|strong="H3588"\w* \w had highly|strong="H4605"\w* \w exalted|strong="H5375"\w* \w his kingdom|strong="H4438"\w* \w for the sake|strong="H5668"\w* \w of His people|strong="H5971"\w* \w Israel|strong="H3478"\w*.
\p \v 3 \w And David|strong="H1732"\w* \w took|strong="H3947"\w* \w more|strong="H5750"\w* \w wives|strong="H802"\w* \w in Jerusalem|strong="H3389"\w* \w and|strong="H1732"\w* \w became the father|strong="H3205"\w* \w of more|strong="H5750"\w* \w sons|strong="H1121"\w* \w and daughters|strong="H1323"\w*. \v 4 \w These|strong="H428"\w* \w are the names|strong="H8034"\w* \w of the children born|strong="H3205"\w* to him \w in Jerusalem|strong="H3389"\w*: \w Shammua|strong="H8051"\w*,\f + \fr 14:4 \fqa Shammua \ft is a variant of \fqa Shimea\ft ; see \ref 1 Chronicles 3:5|1CH 3:5\ref*.\f* \w Shobab|strong="H7727"\w*, \w Nathan|strong="H5416"\w*, \w Solomon|strong="H8010"\w*, \v 5 \w Ibhar|strong="H2984"\w*, \w Elishua|strong="H474"\w*, \w Elpelet|strong="H467"\w*, \v 6 \w Nogah|strong="H5052"\w*, \w Nepheg|strong="H5298"\w*, \w Japhia|strong="H3309"\w*, \v 7 \w Elishama|strong="H476"\w*, \w Beeliada|strong="H1182"\w*,\f + \fr 14:7 \fqa Beeliada \ft is a variant of \fqa Eliada\ft ; see \ref 2 Samuel 5:16|2SA 5:16\ref*.\f* \w and Eliphelet|strong="H467"\w*.
\s1 Two Victories over the Philistines
\r (\ref 2 Samuel 5:17–25|2SA 5:17-25\ref*)
\p \v 8 \w When the Philistines|strong="H6430"\w* \w heard|strong="H8085"\w* \w that|strong="H3588"\w* \w David|strong="H1732"\w* \w had been anointed|strong="H4886"\w* \w king|strong="H4428"\w* \w over|strong="H5921"\w* \w all|strong="H3605"\w* \w Israel|strong="H3478"\w*, \w they|strong="H6430"\w* \w all|strong="H3605"\w* \w went|strong="H5927"\w* \w in search|strong="H1245"\w* \w of him|strong="H1732"\w*; \w but David|strong="H1732"\w* \w learned of this|strong="H8085"\w* \w and went out|strong="H3318"\w* \w to face them|strong="H6440"\w*.
\p \v 9 \w Now the Philistines|strong="H6430"\w* \w had come|strong="H935"\w* \w and raided|strong="H6584"\w* \w the Valley|strong="H6010"\w* \w of Rephaim|strong="H7497"\w*. \v 10 \w So David|strong="H1732"\w* \w inquired|strong="H7592"\w* \w of God|strong="H430"\w*, “\w Should I go up|strong="H5927"\w* \w against|strong="H5921"\w* \w the Philistines|strong="H6430"\w*? \w Will You deliver them|strong="H5414"\w* \w into my hand|strong="H3027"\w*?”
\p “\w Go|strong="H5927"\w*,” \w replied|strong="H559"\w* \w the LORD|strong="H3068"\w*, “\w for I will deliver them|strong="H5414"\w* \w into your hand|strong="H3027"\w*.”
\p \v 11 \w So David and his men went up|strong="H5927"\w* \w to Baal-perazim|strong="H1188"\w*, \w where he|strong="H1732"\w* \w defeated|strong="H5221"\w* \w the Philistines|strong="H8033"\w* \w and|strong="H1732"\w* \w said|strong="H559"\w*, “\w Like a bursting|strong="H6556"\w* \w flood|strong="H4325"\w*, \w God|strong="H430"\w* \w has burst out|strong="H6555"\w* \w against my enemies|strong="H341"\w* \w by my hand|strong="H3027"\w*.” \w So|strong="H5921"\w* \w they called|strong="H7121"\w* \w that|strong="H1931"\w* \w place|strong="H4725"\w* \w Baal-perazim|strong="H1188"\w*.\f + \fr 14:11 \fqa Baal-perazim \ft means \fqa The Lord Bursts Out\ft .\f* \v 12 \w There|strong="H8033"\w* \w the Philistines abandoned|strong="H5800"\w* \w their gods|strong="H430"\w*, \w and David|strong="H1732"\w* \w ordered|strong="H559"\w* \w that they be burned|strong="H8313"\w* \w in the fire|strong="H784"\w*.
\p \v 13 \w Once again|strong="H3254"\w* \w the Philistines|strong="H6430"\w* \w raided|strong="H6584"\w* \w the valley|strong="H6010"\w*. \v 14 \w So David|strong="H1732"\w* \w again|strong="H5750"\w* \w inquired|strong="H7592"\w* \w of God|strong="H430"\w*, \w who|strong="H430"\w* \w answered|strong="H559"\w* him, “\w Do not|strong="H3808"\w* \w march up|strong="H5927"\w* \w after them|strong="H310"\w*, \w but circle around|strong="H5437"\w* \w them|strong="H5921"\w* \w and attack|strong="H935"\w* them \w in front of|strong="H4136"\w* \w the balsam trees|strong="H1057"\w*.\f + \fr 14:14 \ft Or \fqa aspen trees \ft or \fqa poplar trees\ft ; also in verse 15\f* \v 15 \w As soon as|strong="H1961"\w* \w you hear|strong="H8085"\w* \w the sound|strong="H6963"\w* \w of marching|strong="H6807"\w* \w in the tops|strong="H7218"\w* \w of the balsam trees|strong="H1057"\w*, \w move out|strong="H3318"\w* \w to battle|strong="H4421"\w*, \w because this will mean that|strong="H3588"\w* \w God|strong="H430"\w* \w has gone out|strong="H3318"\w* \w before you|strong="H6440"\w* \w to strike|strong="H5221"\w* \w the camp|strong="H4264"\w* \w of the Philistines|strong="H6430"\w*.”
\p \v 16 \w So David|strong="H1732"\w* \w did|strong="H6213"\w* \w as|strong="H834"\w* \w God|strong="H430"\w* \w had commanded him|strong="H6680"\w*, \w and they struck down|strong="H5221"\w* \w the army of|strong="H4264"\w* \w the Philistines|strong="H6430"\w* \w all the way|strong="H5704"\w* \w from Gibeon|strong="H1391"\w* \w to Gezer|strong="H1507"\w*. \v 17 \w And David’s|strong="H1732"\w* \w fame|strong="H8034"\w* \w went out|strong="H3318"\w* \w into every|strong="H3605"\w* \w land|strong="H776"\w*, \w and the LORD|strong="H3068"\w* \w caused|strong="H5414"\w* \w all|strong="H3605"\w* \w nations|strong="H1471"\w* \w to fear him|strong="H6343"\w*.
\c 15
\s1 Preparing to Move the Ark
\r (\ref 2 Samuel 6:12–15|2SA 6:12-15\ref*)
\p \v 1 \w David constructed|strong="H6213"\w* \w buildings|strong="H1004"\w* for himself \w in the City|strong="H5892"\w* \w of David|strong="H1732"\w*, \w and he prepared|strong="H3559"\w* \w a place|strong="H4725"\w* \w for the ark|strong="H727"\w* \w of God|strong="H430"\w* \w and pitched|strong="H5186"\w* \w a tent|strong="H168"\w* for it. \v 2 \w Then|strong="H227"\w* \w David|strong="H1732"\w* \w said|strong="H559"\w*, “\w No|strong="H3808"\w* \w one but|strong="H3588"\w* \w the Levites|strong="H3881"\w* \w may carry|strong="H5375"\w* \w the ark|strong="H727"\w* \w of God|strong="H430"\w*, \w because|strong="H3588"\w* \w the LORD|strong="H3068"\w* \w has chosen them|strong="H977"\w* \w to carry|strong="H5375"\w* \w the ark|strong="H727"\w* \w of the LORD|strong="H3068"\w* \w and to minister|strong="H8334"\w* \w before Him|strong="H5704"\w* \w forever|strong="H5769"\w*.”
\p \v 3 \w And David|strong="H1732"\w* \w assembled|strong="H6950"\w* \w all|strong="H3605"\w* \w Israel|strong="H3478"\w* \w in|strong="H413"\w* \w Jerusalem|strong="H3389"\w* \w to bring up|strong="H5927"\w* \w the ark|strong="H727"\w* \w of the LORD|strong="H3068"\w* \w to|strong="H413"\w* \w the place|strong="H4725"\w* \w he had prepared|strong="H3559"\w* for it. \v 4 \w Then he|strong="H1732"\w* \w gathered together|strong="H622"\w* \w the descendants|strong="H1121"\w* \w of Aaron|strong="H175"\w* \w and the Levites|strong="H3881"\w*:
\b 
\li1 \v 5 \w From the Kohathites|strong="H1121"\w*, \w Uriel|strong="H222"\w* \w the chief|strong="H8269"\w* \w and 120|strong="H3967"\w* \w of his relatives|strong="H251"\w*;
\li1 \v 6 \w from the Merarites|strong="H1121"\w*, \w Asaiah|strong="H6222"\w* \w the chief|strong="H8269"\w* \w and 220|strong="H3967"\w* \w of his relatives|strong="H251"\w*;
\li1 \v 7 \w from the Gershomites|strong="H1121"\w*,\f + \fr 15:7 \fqa Gershomites \ft is a variant of \fqa Gershonites\ft ; see \ref 1 Chronicles 23:7|1CH 23:7\ref*.\f* \w Joel|strong="H3100"\w* \w the chief|strong="H8269"\w* \w and 130|strong="H3967"\w* \w of his relatives|strong="H251"\w*;
