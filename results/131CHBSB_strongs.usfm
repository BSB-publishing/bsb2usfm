\p \v 29 \w As the ark|strong="H727"\w* \w of the covenant|strong="H1285"\w* \w of the LORD|strong="H3068"\w* \w was|strong="H1961"\w* \w entering|strong="H935"\w* \w the City|strong="H5892"\w* \w of David|strong="H1732"\w*, \w Saul’s|strong="H7586"\w* \w daughter|strong="H1323"\w* \w Michal|strong="H4324"\w* \w looked down|strong="H8259"\w* \w from|strong="H1157"\w* \w a window|strong="H2474"\w* \w and saw|strong="H7200"\w* \w King|strong="H4428"\w* \w David|strong="H1732"\w* \w dancing|strong="H7540"\w* \w and celebrating|strong="H7832"\w*, \w and she despised|strong="H959"\w* him \w in her heart|strong="H3820"\w*.
\c 16
\s1 A Tent for the Ark
\r (\ref 2 Samuel 6:17–19|2SA 6:17-19\ref*)
\p \v 1 \w So they brought|strong="H935"\w* \w the ark|strong="H727"\w* \w of God|strong="H430"\w* \w and placed|strong="H3322"\w* \w it inside|strong="H8432"\w* \w the tent|strong="H168"\w* \w that|strong="H834"\w* \w David|strong="H1732"\w* \w had pitched|strong="H5186"\w* for it. \w And they presented|strong="H7126"\w* \w burnt offerings|strong="H5930"\w* \w and peace offerings|strong="H8002"\w* \w before|strong="H6440"\w* \w God|strong="H430"\w*. \v 2 \w When David|strong="H1732"\w* \w had finished|strong="H3615"\w* \w sacrificing|strong="H5927"\w* \w the burnt offerings|strong="H5930"\w* \w and peace offerings|strong="H8002"\w*, \w he blessed|strong="H1288"\w* \w the people|strong="H5971"\w* \w in the name|strong="H8034"\w* \w of the LORD|strong="H3068"\w*. \v 3 \w Then he distributed|strong="H2505"\w* \w to every|strong="H3605"\w* \w man|strong="H376"\w* \w and|strong="H5704"\w* \w woman|strong="H802"\w* \w of Israel|strong="H3478"\w* \w a loaf|strong="H3603"\w* \w of bread|strong="H3899"\w*, \w a date cake|strong="H829"\w*,\f + \fr 16:3 \ft Or \fqa a portion of meat\f* \w and a raisin cake|strong="H809"\w*.
