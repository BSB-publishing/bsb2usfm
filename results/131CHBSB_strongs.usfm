\c 28
\s1 David Commissions Solomon
\p \v 1 \w Now David|strong="H1732"\w* \w summoned|strong="H6950"\w* \w all|strong="H3605"\w* \w the leaders|strong="H8269"\w* \w of Israel|strong="H3478"\w* \w to|strong="H413"\w* \w Jerusalem|strong="H3389"\w*: \w the leaders|strong="H8269"\w* \w of the tribes|strong="H7626"\w*, \w the leaders|strong="H8269"\w* \w of the divisions|strong="H4256"\w* \w in the king’s|strong="H4428"\w* \w service|strong="H8334"\w*, \w the commanders|strong="H8269"\w* \w of thousands|strong="H505"\w* \w and|strong="H8269"\w* \w of hundreds|strong="H3967"\w*, \w and the officials|strong="H8269"\w* \w in charge of all|strong="H3605"\w* \w the property|strong="H7399"\w* \w and cattle|strong="H4735"\w* \w of the king|strong="H4428"\w* \w and his sons|strong="H1121"\w*, \w along with|strong="H5973"\w* \w the court officials|strong="H5631"\w* \w and mighty men|strong="H1368"\w*— \w every|strong="H3605"\w* \w mighty man|strong="H1368"\w* \w of valor|strong="H2428"\w*.
\p \v 2 \w Then King|strong="H4428"\w* \w David|strong="H1732"\w* \w rose|strong="H6965"\w* \w to|strong="H5921"\w* \w his feet|strong="H7272"\w* \w and said|strong="H559"\w*, “\w Listen to me|strong="H8085"\w*, \w my brothers|strong="H251"\w* \w and my people|strong="H5971"\w*. \w It was in|strong="H5973"\w* \w my heart|strong="H3824"\w* \w to build|strong="H1129"\w* \w a house|strong="H1004"\w* \w as a resting place|strong="H4496"\w* \w for the ark|strong="H727"\w* \w of the covenant|strong="H1285"\w* \w of the LORD|strong="H3068"\w* \w and as a footstool|strong="H1916"\w* \w for our God|strong="H430"\w*. \w I had made preparations|strong="H3559"\w* \w to build it|strong="H1129"\w*, \v 3 \w but God|strong="H430"\w* \w said|strong="H559"\w* to me, ‘\w You are not|strong="H3808"\w* \w to build|strong="H1129"\w* \w a house|strong="H1004"\w* \w for My Name|strong="H8034"\w*, \w because|strong="H3588"\w* \w you|strong="H859"\w* \w are a man|strong="H376"\w* \w of war|strong="H4421"\w* \w who has shed|strong="H8210"\w* \w blood|strong="H1818"\w*.’
\p \v 4 \w Yet the LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w chose|strong="H977"\w* me \w out of all|strong="H3605"\w* \w my father’s|strong="H1"\w* \w house|strong="H1004"\w* \w to be|strong="H1961"\w* \w king|strong="H4428"\w* \w over|strong="H5921"\w* \w Israel|strong="H3478"\w* \w forever|strong="H5769"\w*. \w For|strong="H3588"\w* \w He chose|strong="H977"\w* \w Judah|strong="H3063"\w* \w as leader|strong="H5057"\w*, \w and from the house|strong="H1004"\w* \w of Judah|strong="H3063"\w* \w He chose my father’s|strong="H1"\w* \w household|strong="H1004"\w*, \w and from my father’s|strong="H1"\w* \w sons|strong="H1121"\w* \w He was pleased|strong="H7521"\w* \w to make me king|strong="H4427"\w* \w over|strong="H5921"\w* \w all|strong="H3605"\w* \w Israel|strong="H3478"\w*. \v 5 \w And of all|strong="H3605"\w* \w my sons|strong="H1121"\w*— \w for|strong="H3588"\w* \w the LORD|strong="H3068"\w* \w has given|strong="H5414"\w* me \w many|strong="H7227"\w* \w sons|strong="H1121"\w*— \w He has chosen|strong="H977"\w* \w Solomon|strong="H8010"\w* \w my son|strong="H1121"\w* \w to sit|strong="H3427"\w* \w on|strong="H5921"\w* \w the throne|strong="H3678"\w* \w of the kingdom|strong="H4438"\w* \w of the LORD|strong="H3068"\w* \w over|strong="H5921"\w* \w Israel|strong="H3478"\w*. \v 6 \w And He said|strong="H559"\w* to me, ‘\w Solomon|strong="H8010"\w* \w your son|strong="H1121"\w* \w is the one|strong="H1931"\w* \w who will build|strong="H1129"\w* \w My house|strong="H1004"\w* \w and My courts|strong="H2691"\w*, \w for|strong="H3588"\w* \w I have chosen him|strong="H977"\w* as My \w son|strong="H1121"\w*, \w and I|strong="H589"\w* \w will be|strong="H1961"\w* his \w Father|strong="H1"\w*. \v 7 \w I will establish|strong="H3559"\w* \w his kingdom|strong="H4438"\w* \w forever|strong="H5704"\w*, \w if|strong="H518"\w* \w he resolutely|strong="H2388"\w* \w carries out|strong="H6213"\w* \w My commandments|strong="H4687"\w* \w and ordinances|strong="H4941"\w*, \w as is being done|strong="H3117"\w* \w this day|strong="H2088"\w*.’
\p \v 8 \w So now|strong="H6258"\w* \w in the sight|strong="H5869"\w* \w of all|strong="H3605"\w* \w Israel|strong="H3478"\w*, \w the assembly|strong="H6951"\w* \w of the LORD|strong="H3068"\w*, \w and in the hearing|strong="H241"\w* \w of our God|strong="H430"\w*, \w keep|strong="H8104"\w* \w and seek out|strong="H1875"\w* \w all|strong="H3605"\w* \w the commandments|strong="H4687"\w* \w of the LORD|strong="H3068"\w* \w your God|strong="H430"\w*, \w so that|strong="H4616"\w* \w you may possess|strong="H3423"\w* \w this good|strong="H2896"\w* \w land|strong="H776"\w* \w and leave it as an inheritance|strong="H5157"\w* \w to your descendants|strong="H1121"\w* \w forever|strong="H5704"\w*. \v 9 \w As for you|strong="H859"\w*, \w Solomon|strong="H8010"\w* \w my son|strong="H1121"\w*, \w know|strong="H3045"\w* \w the God|strong="H430"\w* \w of your father|strong="H1"\w* \w and serve Him|strong="H5647"\w* \w wholeheartedly|strong="H3820"\w* \w and with a willing|strong="H2655"\w* \w mind|strong="H5315"\w*, \w for|strong="H3588"\w* \w the LORD|strong="H3068"\w* \w searches|strong="H1875"\w* \w every|strong="H3605"\w* \w heart|strong="H3824"\w* \w and understands|strong="H995"\w* \w the intent|strong="H3336"\w* \w of every|strong="H3605"\w* \w thought|strong="H4284"\w*. \w If|strong="H518"\w* \w you seek Him|strong="H1875"\w*, \w He will be found|strong="H4672"\w* by you; \w but if|strong="H518"\w* \w you forsake Him|strong="H5800"\w*, \w He will reject you|strong="H2186"\w* \w forever|strong="H5703"\w*. \v 10 \w Consider|strong="H7200"\w* \w now|strong="H6258"\w* \w that|strong="H3588"\w* \w the LORD|strong="H3068"\w* \w has chosen|strong="H977"\w* you \w to build|strong="H1129"\w* \w a house|strong="H1004"\w* \w for the sanctuary|strong="H4720"\w*. \w Be strong|strong="H2388"\w* \w and do it|strong="H6213"\w*.”
\s1 The Plans for the Temple
\p \v 11 \w Then David|strong="H1732"\w* \w gave|strong="H5414"\w* \w his son|strong="H1121"\w* \w Solomon|strong="H8010"\w* \w the plans|strong="H8403"\w* \w for the portico of the temple|strong="H197"\w*,\f + \fr 28:11 \ft LXX; Hebrew does not include \fqa of the temple\ft .\f* \w its buildings|strong="H1004"\w*, \w storehouses|strong="H1597"\w*, \w upper rooms|strong="H5944"\w*, \w inner|strong="H6442"\w* \w rooms|strong="H2315"\w*, \w and the room|strong="H1004"\w* \w for the mercy seat|strong="H3727"\w*.\f + \fr 28:11 \ft Or \fqa atonement cover\f* \v 12 \w The plans|strong="H8403"\w* \w contained everything|strong="H3605"\w* \w David had|strong="H1961"\w* \w in|strong="H5973"\w* \w mind|strong="H7307"\w*\f + \fr 28:12 \ft Or \fqa had with him by the Spirit\f* \w for the courts|strong="H2691"\w* \w of the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*, \w for all|strong="H3605"\w* \w the surrounding|strong="H5439"\w* \w rooms|strong="H3957"\w*, \w for the treasuries|strong="H214"\w* \w of the house|strong="H1004"\w* \w of God|strong="H430"\w* \w and|strong="H214"\w* \w of the dedicated things|strong="H6944"\w*, \v 13 \w for the divisions|strong="H4256"\w* \w of the priests|strong="H3548"\w* \w and Levites|strong="H3881"\w*, \w for all|strong="H3605"\w* \w the work|strong="H4399"\w* \w of service|strong="H5656"\w* \w in the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*, \w and for all|strong="H3605"\w* \w the articles|strong="H3627"\w* \w of service|strong="H5656"\w* \w in the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*:
\b 
\li1 \v 14 \w the weight|strong="H4948"\w* \w of all|strong="H3605"\w* \w the gold|strong="H2091"\w* \w articles|strong="H3627"\w* \w for every kind of service|strong="H5656"\w*;
\li1 \w the weight|strong="H4948"\w* \w of all|strong="H3605"\w* \w the silver|strong="H3701"\w* \w articles|strong="H3627"\w* \w for every kind|strong="H3605"\w* \w of service|strong="H5656"\w*;
\li1 \v 15 \w the weight|strong="H4948"\w* \w of the gold|strong="H2091"\w* \w lampstands|strong="H4501"\w* \w and their|strong="H2091"\w* \w lamps|strong="H5216"\w*, \w including the weight|strong="H4948"\w* \w of each lampstand|strong="H4501"\w* \w and its lamps|strong="H5216"\w*;
\li1 \w the weight|strong="H4948"\w* \w of each silver|strong="H3701"\w* \w lampstand|strong="H4501"\w* \w and its lamps|strong="H5216"\w*, \w according to the use|strong="H5656"\w* \w of each lampstand|strong="H4501"\w*;
\li1 \v 16 \w the weight|strong="H4948"\w* \w of gold|strong="H2091"\w* \w for each table|strong="H7979"\w* \w of showbread|strong="H4635"\w*, \w and of silver|strong="H3701"\w* \w for the silver|strong="H3701"\w* \w tables|strong="H7979"\w*;
\li1 \v 17 \w the weight of the pure|strong="H2889"\w* \w gold|strong="H2091"\w* \w for the forks|strong="H4207"\w*, \w sprinkling bowls|strong="H4219"\w*, \w and pitchers|strong="H7184"\w*;
\li1 \w the weight|strong="H4948"\w* \w of each gold|strong="H2091"\w* \w dish|strong="H3713"\w*;
\li1 \w the weight|strong="H4948"\w* \w of each silver|strong="H3701"\w* \w bowl|strong="H3713"\w*;
\li1 \v 18 \w the weight|strong="H4948"\w* \w of the refined|strong="H2212"\w* \w gold|strong="H2091"\w* \w for the altar|strong="H4196"\w* \w of incense|strong="H7004"\w*;
\li1 \w and the plans|strong="H8403"\w* \w for the chariot|strong="H4818"\w* \w of the gold|strong="H2091"\w* \w cherubim|strong="H3742"\w* \w that spread their wings|strong="H6566"\w* \w and overshadowed|strong="H5526"\w* \w the ark|strong="H727"\w* \w of the covenant|strong="H1285"\w* \w of the LORD|strong="H3068"\w*.
\p \v 19 “\w All this,” said David|strong="H3605"\w*, “\w all|strong="H3605"\w* \w the details|strong="H4399"\w* \w of this plan|strong="H8403"\w*, \w the LORD|strong="H3068"\w* \w has made clear to me|strong="H7919"\w* \w in writing|strong="H3791"\w* \w by His hand|strong="H3027"\w* \w upon me|strong="H5921"\w*.”
\p \v 20 \w David also|strong="H1732"\w* \w said|strong="H559"\w* \w to Solomon|strong="H8010"\w* \w his son|strong="H1121"\w*, “\w Be strong|strong="H2388"\w* \w and courageous|strong="H553"\w*, \w and do it|strong="H6213"\w*. \w Do not|strong="H408"\w* \w be afraid|strong="H3372"\w* \w or discouraged|strong="H2865"\w*, \w for|strong="H3588"\w* \w the LORD|strong="H3068"\w* \w God|strong="H430"\w*, \w my God|strong="H430"\w*, \w is with you|strong="H5973"\w*. \w He will neither|strong="H3808"\w* \w fail you|strong="H7503"\w* \w nor forsake you|strong="H5800"\w* \w before|strong="H5704"\w* \w all|strong="H3605"\w* \w the work|strong="H4399"\w* \w for the service|strong="H5656"\w* \w of the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w* \w is finished|strong="H3615"\w*. \v 21 \w The divisions|strong="H4256"\w* \w of the priests|strong="H3548"\w* \w and Levites|strong="H3881"\w* \w are ready|strong="H2009"\w* \w for all|strong="H3605"\w* \w the service|strong="H5656"\w* \w of the house|strong="H1004"\w* \w of God|strong="H430"\w*, \w and|strong="H5973"\w* \w every|strong="H3605"\w* \w willing man|strong="H5081"\w* \w of every|strong="H3605"\w* \w skill|strong="H2451"\w* \w will be at your disposal for the work|strong="H4399"\w*. \w The officials|strong="H8269"\w* \w and all|strong="H3605"\w* \w the people|strong="H5971"\w* \w are fully at your|strong="H3605"\w* \w command|strong="H1697"\w*.”
\c 29
\s1 Offerings for the Temple
\p \v 1 \w Then King|strong="H4428"\w* \w David|strong="H1732"\w* \w said|strong="H559"\w* \w to the whole|strong="H3605"\w* \w assembly|strong="H6951"\w*, “\w My son|strong="H1121"\w* \w Solomon|strong="H8010"\w*, \w the one|strong="H259"\w* whom \w God|strong="H430"\w* \w has chosen|strong="H977"\w*, \w is young|strong="H5288"\w* \w and inexperienced|strong="H7390"\w*. \w The task|strong="H4399"\w* \w is great|strong="H1419"\w* \w because|strong="H3588"\w* \w this palace|strong="H1002"\w* \w is not|strong="H3808"\w* \w for man|strong="H120"\w*, \w but|strong="H3588"\w* \w for the LORD|strong="H3068"\w* \w God|strong="H430"\w*. \v 2 \w Now with all|strong="H3605"\w* \w my ability|strong="H3581"\w* \w I have made provision|strong="H3559"\w* \w for the house|strong="H1004"\w* \w of my God|strong="H430"\w* — \w gold|strong="H2091"\w* \w for the gold articles|strong="H2091"\w*, \w silver|strong="H3701"\w* \w for the silver|strong="H3701"\w*, \w bronze|strong="H5178"\w* \w for the bronze|strong="H5178"\w*, \w iron|strong="H1270"\w* \w for the iron|strong="H1270"\w*, \w and wood|strong="H6086"\w* \w for the wood|strong="H6086"\w*, \w as well as onyx|strong="H68"\w* \w for the settings|strong="H4394"\w*, \w turquoise|strong="H68"\w*, \w stones of various colors|strong="H7553"\w*, \w all kinds|strong="H3605"\w* \w of precious|strong="H3368"\w* \w stones|strong="H68"\w*, \w and slabs|strong="H68"\w* \w of marble|strong="H7893"\w* — \w all in abundance|strong="H7230"\w*.
\p \v 3 \w Moreover|strong="H5750"\w*, \w because of my delight|strong="H7521"\w* \w in the house|strong="H1004"\w* \w of my God|strong="H430"\w*, \w I now give|strong="H5414"\w* \w for it|strong="H1004"\w* \w my personal treasures|strong="H5459"\w* \w of gold|strong="H2091"\w* \w and silver|strong="H3701"\w*, \w over and above|strong="H4605"\w* \w all|strong="H3605"\w* \w that I have provided|strong="H3559"\w* \w for this holy|strong="H6944"\w* \w temple|strong="H1004"\w*: \v 4 \w three|strong="H7969"\w* \w thousand|strong="H505"\w* \w talents|strong="H3603"\w* \w of gold|strong="H2091"\w*\f + \fr 29:4 \fqa 3,000 talents \ft is approximately 113 tons or 103 metric tons of gold.\f* (\w the gold|strong="H2091"\w* \w of Ophir|strong="H211"\w*) \w and seven|strong="H7651"\w* \w thousand|strong="H505"\w* \w talents|strong="H3603"\w* \w of refined|strong="H2212"\w* \w silver|strong="H3701"\w*,\f + \fr 29:4 \fqa 7,000 talents \ft is approximately 264 tons or 239.5 metric tons of silver.\f* \w to overlay|strong="H2902"\w* \w the walls|strong="H7023"\w* \w of the buildings|strong="H1004"\w*, \v 5 \w for the gold work|strong="H2091"\w* \w and the silver work|strong="H3701"\w*, \w and for all|strong="H3605"\w* \w the work|strong="H4399"\w* \w to be done by|strong="H3027"\w* \w the craftsmen|strong="H2796"\w*. \w Now who|strong="H4310"\w* \w is willing|strong="H5068"\w* \w to consecrate|strong="H4390"\w* \w himself|strong="H3027"\w* \w to the LORD|strong="H3068"\w* \w today|strong="H3117"\w*?”
\p \v 6 \w Then the leaders|strong="H8269"\w* \w of the families|strong="H1"\w*, \w the officers|strong="H8269"\w* \w of the tribes|strong="H7626"\w* \w of Israel|strong="H3478"\w*, \w the commanders|strong="H8269"\w* \w of thousands|strong="H505"\w* \w and of hundreds|strong="H3967"\w*, \w and the officials|strong="H8269"\w* \w in charge of the king’s|strong="H4428"\w* \w work|strong="H4399"\w* \w gave willingly|strong="H5068"\w*. \v 7 \w Toward the service|strong="H5656"\w* \w of God’s|strong="H430"\w* \w house|strong="H1004"\w* \w they gave|strong="H5414"\w* \w 5,000|strong="H2568"\w* \w talents|strong="H3603"\w*\f + \fr 29:7 \fqa 5,000 talents \ft is approximately 188.5 tons or 171 metric tons of gold.\f* \w and 10,000|strong="H7239"\w* \w darics|strong="H150"\w* \w of gold|strong="H2091"\w*,\f + \fr 29:7 \ft Or \fqa 10,000 gold drachmas\ft ; that is, approximately 185.2 pounds or 84 kilograms of gold coins\f* \w 10,000|strong="H6235"\w* \w talents|strong="H3603"\w* \w of silver|strong="H3701"\w*,\f + \fr 29:7 \fqa 10,000 talents \ft is approximately 377 tons or 342 metric tons of silver.\f* \w 18,000|strong="H7239"\w* \w talents|strong="H3603"\w* \w of bronze|strong="H5178"\w*,\f + \fr 29:7 \fqa 18,000 talents \ft is approximately 678.6 tons or 615.6 metric tons of bronze.\f* \w and 100,000|strong="H3967"\w* \w talents|strong="H3603"\w* \w of iron|strong="H1270"\w*.\f + \fr 29:7 \fqa 100,000 talents \ft is approximately 3,770 tons or 3,420 metric tons of iron.\f* \v 8 \w Whoever had|strong="H4672"\w* \w precious stones|strong="H68"\w* \w gave them|strong="H5414"\w* \w to the treasury|strong="H214"\w* \w of the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*, \w under|strong="H5921"\w* \w the care|strong="H3027"\w* \w of Jehiel|strong="H3171"\w*\f + \fr 29:8 \fqa Jehiel \ft is a variant of \fqa Jehieli\ft ; see \ref 1 Chronicles 26:21|1CH 26:21\ref*.\f* \w the Gershonite|strong="H1649"\w*. \v 9 \w And the people|strong="H5971"\w* \w rejoiced|strong="H8055"\w* \w at|strong="H5921"\w* \w the willing response of their leaders|strong="H5068"\w*, \w for|strong="H3588"\w* \w they had given|strong="H5068"\w* \w to the LORD freely|strong="H3068"\w* \w and wholeheartedly|strong="H8003"\w*. \w And King|strong="H4428"\w* \w David|strong="H1732"\w* \w also|strong="H1571"\w* \w rejoiced|strong="H8055"\w* \w greatly|strong="H1419"\w*.
\s1 David’s Prayer of Blessing
\p \v 10 \w Then David|strong="H1732"\w* \w blessed|strong="H1288"\w* \w the LORD|strong="H3068"\w* \w in the sight|strong="H5869"\w* \w of all|strong="H3605"\w* \w the assembly|strong="H6951"\w* \w and|strong="H1732"\w* \w said|strong="H559"\w*:
\pmo “\w May You|strong="H859"\w* \w be blessed|strong="H1288"\w*, \w O LORD|strong="H3068"\w*, \w God|strong="H430"\w* \w of our father|strong="H1"\w* \w Israel|strong="H3478"\w*, \w from everlasting|strong="H5769"\w* \w to|strong="H5704"\w* \w everlasting|strong="H5769"\w*.
\pmo \v 11 Yours, \w O LORD|strong="H3068"\w*, \w is the greatness|strong="H1420"\w* \w and the power|strong="H1369"\w* \w and the glory|strong="H8597"\w* \w and the splendor|strong="H1935"\w* \w and the majesty|strong="H5331"\w*, \w for|strong="H3588"\w* \w everything|strong="H3605"\w* \w in heaven|strong="H8064"\w* \w and on earth belongs to You|strong="H776"\w*.
\pmo Yours, \w O LORD|strong="H3068"\w*, \w is the kingdom|strong="H4467"\w*, \w and You are exalted|strong="H5375"\w* \w as head|strong="H7218"\w* \w over all|strong="H3605"\w*. \v 12 \w Both riches|strong="H6239"\w* \w and honor|strong="H3519"\w* \w come from You|strong="H6440"\w*, \w and You|strong="H859"\w* \w are the ruler|strong="H4910"\w* \w over all|strong="H3605"\w*. \w In Your hands|strong="H3027"\w* \w are power|strong="H3581"\w* \w and might|strong="H1369"\w* \w to exalt|strong="H1431"\w* \w and give strength|strong="H2388"\w* \w to all|strong="H3605"\w*.
\pmo \v 13 \w Now therefore|strong="H6258"\w*, \w our God|strong="H430"\w*, \w we|strong="H587"\w* \w give You thanks|strong="H3034"\w*, \w and we praise|strong="H1984"\w* \w Your glorious|strong="H8597"\w* \w name|strong="H8034"\w*. \v 14 \w But|strong="H3588"\w* \w who am|strong="H4310"\w* \w I|strong="H589"\w*, \w and who|strong="H4310"\w* \w are my people|strong="H5971"\w*, \w that|strong="H3588"\w* \w we should be able|strong="H6113"\w* \w to give as generously|strong="H5068"\w* \w as this|strong="H2063"\w*? \w For|strong="H3588"\w* \w everything|strong="H3605"\w* \w comes from You|strong="H4480"\w*, \w and from Your own hand|strong="H3027"\w* \w we have given|strong="H5414"\w* to You. \v 15 \w For|strong="H3588"\w* \w we|strong="H587"\w* \w are foreigners|strong="H1616"\w* \w and strangers|strong="H8453"\w* \w in Your presence|strong="H6440"\w*, \w as were all|strong="H3605"\w* \w our forefathers|strong="H1"\w*. \w Our days|strong="H3117"\w* \w on|strong="H5921"\w* \w earth|strong="H776"\w* \w are like a shadow|strong="H6738"\w*, \w without|strong="H369"\w* \w hope|strong="H4723"\w*.
\pmo \v 16 \w O LORD|strong="H3068"\w* \w our God|strong="H430"\w*, \w from Your hand|strong="H3027"\w* \w comes|strong="H1931"\w* \w all|strong="H3605"\w* \w this|strong="H2088"\w* \w abundance|strong="H1995"\w* \w that|strong="H834"\w* \w we have provided|strong="H3559"\w* \w to build|strong="H1129"\w* You \w a house|strong="H1004"\w* \w for Your holy|strong="H6944"\w* \w Name|strong="H8034"\w*, \w and all of it|strong="H3605"\w* belongs to You. \v 17 \w I know|strong="H3045"\w*, \w my God|strong="H430"\w*, \w that|strong="H3588"\w* \w You|strong="H859"\w* \w test|strong="H974"\w* \w the heart|strong="H3824"\w* \w and delight|strong="H7521"\w* \w in uprightness|strong="H4339"\w*. \w All|strong="H3605"\w* \w these things|strong="H428"\w* \w I|strong="H589"\w* \w have given willingly|strong="H5068"\w* \w and with an upright|strong="H3476"\w* \w heart|strong="H3824"\w*, \w and now|strong="H6258"\w* \w I have seen|strong="H7200"\w* \w Your people|strong="H5971"\w* \w who are present|strong="H4672"\w* \w here|strong="H6311"\w* \w giving joyfully|strong="H8057"\w* \w and willingly|strong="H5068"\w* to You.
\pmo \v 18 \w O LORD|strong="H3068"\w*, \w God|strong="H430"\w* \w of our fathers|strong="H1"\w* \w Abraham|strong="H85"\w*, \w Isaac|strong="H3327"\w*, \w and Israel|strong="H3478"\w*, \w keep|strong="H8104"\w* \w this|strong="H2063"\w* \w desire|strong="H3336"\w* \w forever|strong="H5769"\w* \w in the intentions|strong="H4284"\w* \w of the hearts|strong="H3824"\w* \w of Your people|strong="H5971"\w*, \w and direct|strong="H3559"\w* \w their hearts|strong="H3824"\w* \w toward You|strong="H413"\w*. \v 19 \w And give|strong="H5414"\w* \w my son|strong="H1121"\w* \w Solomon|strong="H8010"\w* \w a whole|strong="H8003"\w* \w heart|strong="H3824"\w* \w to keep|strong="H8104"\w* \w and carry out|strong="H6213"\w* \w all|strong="H3605"\w* \w Your commandments|strong="H4687"\w*, \w decrees|strong="H5715"\w*, \w and statutes|strong="H2706"\w*, \w and to build|strong="H1129"\w* \w Your palace|strong="H1002"\w* \w for which|strong="H834"\w* \w I have made provision|strong="H3559"\w*.”
\p \v 20 \w Then David|strong="H1732"\w* \w said|strong="H559"\w* \w to the whole|strong="H3605"\w* \w assembly|strong="H6951"\w*, “\w Bless|strong="H1288"\w* \w the LORD|strong="H3068"\w* \w your God|strong="H430"\w*.”
\p \w So the whole|strong="H3605"\w* \w assembly|strong="H6951"\w* \w blessed|strong="H1288"\w* \w the LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of their fathers|strong="H1"\w*. \w They bowed down|strong="H6915"\w* \w and paid homage|strong="H7812"\w* \w to the LORD|strong="H3068"\w* \w and to the king|strong="H4428"\w*.
\s1 Solomon Anointed King
\r (\ref 1 Kings 1:32–40|1KI 1:32-40\ref*)
\p \v 21 \w The next day|strong="H4283"\w* \w they offered|strong="H2076"\w* \w sacrifices|strong="H2077"\w* \w and presented burnt offerings|strong="H5930"\w* \w to the LORD|strong="H3068"\w*: \w a thousand|strong="H505"\w* \w bulls|strong="H6499"\w*, \w a thousand|strong="H505"\w* \w rams|strong="H352"\w*, \w and a thousand|strong="H505"\w* \w lambs|strong="H3532"\w*, \w along with their drink offerings|strong="H5262"\w*, \w and other sacrifices|strong="H2077"\w* \w in abundance|strong="H7230"\w* \w for all|strong="H3605"\w* \w Israel|strong="H3478"\w*. \v 22 \w That|strong="H1931"\w* \w day|strong="H3117"\w* \w they ate|strong="H398"\w* \w and drank|strong="H8354"\w* \w with great|strong="H1419"\w* \w joy|strong="H8057"\w* \w in the presence|strong="H6440"\w* \w of the LORD|strong="H3068"\w*.
\p \w Then, for a second|strong="H8145"\w* \w time, they designated David’s|strong="H1732"\w* \w son|strong="H1121"\w* \w Solomon|strong="H8010"\w* \w as king|strong="H4427"\w*, \w anointing him|strong="H4886"\w* \w before the LORD|strong="H3068"\w* \w as ruler|strong="H5057"\w*, \w and Zadok|strong="H6659"\w* \w as the priest|strong="H3548"\w*.
\p \v 23 \w So Solomon|strong="H8010"\w* \w sat|strong="H3427"\w* \w on|strong="H5921"\w* \w the throne|strong="H3678"\w* \w of the LORD|strong="H3068"\w* \w as king|strong="H4428"\w* \w in place of|strong="H8478"\w* \w his father|strong="H1"\w* \w David|strong="H1732"\w*. \w He prospered|strong="H6743"\w*, \w and all|strong="H3605"\w* \w Israel|strong="H3478"\w* \w obeyed him|strong="H8085"\w*. \v 24 \w All|strong="H3605"\w* \w the officials|strong="H8269"\w* \w and mighty men|strong="H1368"\w*, \w as well as|strong="H1571"\w* \w all|strong="H3605"\w* \w of King|strong="H4428"\w* \w David’s|strong="H1732"\w* \w sons|strong="H1121"\w*, \w pledged|strong="H5414"\w* \w their allegiance|strong="H3027"\w* \w to|strong="H8478"\w* \w King|strong="H4428"\w* \w Solomon|strong="H8010"\w*.
\p \v 25 \w The LORD|strong="H3068"\w* \w highly|strong="H4605"\w* \w exalted|strong="H1431"\w* \w Solomon|strong="H8010"\w* \w in the sight|strong="H5869"\w* \w of all|strong="H3605"\w* \w Israel|strong="H3478"\w* \w and bestowed|strong="H5414"\w* \w on him|strong="H5921"\w* \w royal|strong="H4438"\w* \w majesty|strong="H1935"\w* \w such as|strong="H834"\w* \w had not|strong="H3808"\w* \w been|strong="H1961"\w* \w bestowed on|strong="H5921"\w* \w any|strong="H3605"\w* \w king|strong="H4428"\w* \w in|strong="H5921"\w* \w Israel|strong="H3478"\w* \w before him|strong="H6440"\w*.
\s1 David’s Reign and Death
\r (\ref 1 Kings 2:10–12|1KI 2:10-12\ref*)
\p \v 26 \w David|strong="H1732"\w* \w son|strong="H1121"\w* \w of Jesse|strong="H3448"\w* \w was king|strong="H4427"\w* \w over|strong="H5921"\w* \w all|strong="H3605"\w* \w Israel|strong="H3478"\w*. \v 27 \w The length|strong="H3117"\w* \w of David’s|strong="H834"\w* \w reign|strong="H4427"\w* \w over|strong="H5921"\w* \w Israel|strong="H3478"\w* \w was forty|strong="H705"\w* \w years|strong="H8141"\w* — \w seven|strong="H7651"\w* \w years|strong="H8141"\w* \w in Hebron|strong="H2275"\w* \w and thirty-three years|strong="H7970"\w* \w in Jerusalem|strong="H3389"\w*. \v 28 \w He died|strong="H4191"\w* \w at a ripe|strong="H2896"\w* \w old age|strong="H7872"\w*, \w full|strong="H7649"\w* \w of years|strong="H3117"\w*, \w riches|strong="H6239"\w*, \w and honor|strong="H3519"\w*, \w and his son|strong="H1121"\w* \w Solomon|strong="H8010"\w* \w reigned|strong="H4427"\w* \w in his place|strong="H8478"\w*.
\p \v 29 \w Now the acts|strong="H1697"\w* \w of King|strong="H4428"\w* \w David|strong="H1732"\w*, \w from first|strong="H7223"\w* \w to last|strong="H314"\w*, \w are indeed|strong="H2009"\w* \w written|strong="H3789"\w* \w in|strong="H5921"\w* \w the Chronicles|strong="H1697"\w* \w of Samuel|strong="H8050"\w* \w the Seer|strong="H7203"\w*, \w the Chronicles|strong="H1697"\w* \w of Nathan|strong="H5416"\w* \w the Prophet|strong="H5030"\w*, \w and|strong="H5921"\w* \w the Chronicles|strong="H1697"\w* \w of Gad|strong="H1410"\w* \w the Seer|strong="H2374"\w*, \v 30 \w together with|strong="H5973"\w* \w all the details|strong="H3605"\w* \w of his reign|strong="H4438"\w*, \w his might|strong="H1369"\w*, \w and the circumstances|strong="H6256"\w* \w that|strong="H834"\w* \w came|strong="H5674"\w* \w upon him|strong="H5921"\w* \w and|strong="H5921"\w* \w Israel|strong="H3478"\w* \w and|strong="H5921"\w* \w all|strong="H3605"\w* \w the kingdoms|strong="H4467"\w* \w of the lands|strong="H776"\w*.
