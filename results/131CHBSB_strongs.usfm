\c 3
\s1 The Descendants of David
\r (\ref 2 Samuel 3:1–5|2SA 3:1-5\ref*)
\p \v 1 \w These|strong="H428"\w* \w were|strong="H1961"\w* \w the sons|strong="H1121"\w* \w of David|strong="H1732"\w* \w who|strong="H834"\w* \w were born|strong="H3205"\w* to him \w in Hebron|strong="H2275"\w*:
\b 
\li1 \w The firstborn|strong="H1060"\w* \w was Amnon|strong="H550"\w* \w by Ahinoam|strong="H293"\w* \w of Jezreel|strong="H3158"\w*;
\b 
\li1 \w the second|strong="H8145"\w* \w was Daniel|strong="H1841"\w* \w by Abigail|strong="H26"\w* \w of Carmel|strong="H3761"\w*;
\b 
\li1 \v 2 \w the third|strong="H7992"\w* \w was Absalom|strong="H53"\w* \w the son|strong="H1121"\w* \w of Maacah|strong="H4601"\w* \w daughter|strong="H1323"\w* \w of King|strong="H4428"\w* \w Talmai|strong="H8526"\w* \w of Geshur|strong="H1650"\w*;
\b 
\li1 \w the fourth|strong="H7243"\w* \w was Adonijah|strong="H138"\w* \w the son|strong="H1121"\w* \w of Haggith|strong="H2294"\w*;
\b 
\li1 \v 3 \w the fifth|strong="H2549"\w* \w was Shephatiah|strong="H8203"\w* \w by Abital|strong="H37"\w*;
\b 
\li1 \w and the sixth|strong="H8345"\w* \w was Ithream|strong="H3507"\w* \w by his wife|strong="H802"\w* \w Eglah|strong="H5698"\w*.
\b 
\li1 \v 4 \w These six|strong="H8337"\w* \w sons were born|strong="H3205"\w* to David \w in Hebron|strong="H2275"\w*, \w where|strong="H8033"\w* \w he reigned|strong="H4427"\w* \w seven|strong="H7651"\w* \w years|strong="H8141"\w* \w and six|strong="H8337"\w* \w months|strong="H2320"\w*.
\p \w And David reigned|strong="H4427"\w* \w in Jerusalem|strong="H3389"\w* \w thirty-three|strong="H7970"\w* \w years|strong="H8141"\w*, \v 5 \w and these sons|strong="H428"\w* \w were born|strong="H3205"\w* to him \w in Jerusalem|strong="H3389"\w*:
\b 
\li1 \w Shimea|strong="H8092"\w*,\f + \fr 3:5 \fqa Shimea \ft is a variant of \fqa Shammua\ft ; see \ref 2 Samuel 5:14|2SA 5:14\ref* and 1 Chronicles 14:4.\f* \w Shobab|strong="H7727"\w*, \w Nathan|strong="H5416"\w*, \w and Solomon|strong="H8010"\w*. \w These four were born to him|strong="H702"\w* \w by Bathsheba|strong="H1340"\w*\f + \fr 3:5 \ft One Hebrew manuscript and Vulgate (see also LXX and \ref 2 Samuel 11:3|2SA 11:3\ref*); most Hebrew manuscripts \fqa Bath-shua\f* \w daughter|strong="H1323"\w* \w of Ammiel|strong="H5988"\w*.\f + \fr 3:5 \fqa Ammiel \ft is a variant of \fqa Eliam\ft ; see \ref 2 Samuel 11:3|2SA 11:3\ref*.\f*
\b 
\li1 \v 6 \w David’s other sons were Ibhar|strong="H2984"\w*,\f + \fr 3:6 \ft Hebrew does not include \fqa David’s other sons were\ft .\f* \w Elishua|strong="H476"\w*,\f + \fr 3:6 \ft Two Hebrew manuscripts (see also \ref 2 Samuel 5:15|2SA 5:15\ref* and 1 Chronicles 14:5); most Hebrew manuscripts \fqa Elishama\f* \w Eliphelet|strong="H467"\w*, \v 7 \w Nogah|strong="H5052"\w*, \w Nepheg|strong="H5298"\w*, \w Japhia|strong="H3309"\w*, \v 8 \w Elishama|strong="H476"\w*, \w Eliada|strong="H450"\w*, \w and Eliphelet|strong="H467"\w*— \w nine in all|strong="H8672"\w*.
\b 
\li1 \v 9 \w These were all|strong="H3605"\w* \w the sons|strong="H1121"\w* \w of David|strong="H1732"\w*, \w besides|strong="H905"\w* \w the sons|strong="H1121"\w* \w by his concubines|strong="H6370"\w*. \w And Tamar|strong="H8559"\w* \w was their sister|strong="H269"\w*.
\s1 The Descendants of Solomon
\li1 \v 10 \w Solomon’s|strong="H8010"\w* \w son|strong="H1121"\w* \w was Rehoboam|strong="H7346"\w*:
\li2 \w Abijah was|strong="H29"\w* \w his son|strong="H1121"\w*, \w Asa|strong="H609"\w* \w his son|strong="H1121"\w*, \w Jehoshaphat|strong="H3092"\w* \w his son|strong="H1121"\w*, \v 11 \w Joram|strong="H3141"\w*\f + \fr 3:11 \fqa Joram \ft is a variant spelling of \fqa Jehoram\ft .\f* \w his son|strong="H1121"\w*, \w Ahaziah|strong="H274"\w* \w his son|strong="H1121"\w*, \w Joash|strong="H3101"\w* \w his son|strong="H1121"\w*, \v 12 \w Amaziah|strong="H558"\w* \w his son|strong="H1121"\w*, \w Azariah|strong="H5838"\w*\f + \fr 3:12 \fqa Azariah \ft is also called \fqa Uzziah\ft ; see \ref 2 Chronicles 26:1|2CH 26:1\ref*.\f* \w his son|strong="H1121"\w*, \w Jotham|strong="H3147"\w* \w his son|strong="H1121"\w*, \v 13 \w Ahaz|strong="H271"\w* \w his son|strong="H1121"\w*, \w Hezekiah|strong="H2396"\w* \w his son|strong="H1121"\w*, \w Manasseh|strong="H4519"\w* \w his son|strong="H1121"\w*, \v 14 \w Amon|strong="H526"\w* \w his son|strong="H1121"\w*, \w and Josiah|strong="H2977"\w* \w his son|strong="H1121"\w*.
\b 
\li1 \v 15 \w The sons|strong="H1121"\w* \w of Josiah|strong="H2977"\w*:
