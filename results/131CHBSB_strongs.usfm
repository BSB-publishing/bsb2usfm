\li1 \v 20 \w The sons|strong="H1121"\w* \w of Uzziel|strong="H5816"\w*: \w Micah|strong="H4318"\w* \w was the first|strong="H7218"\w* \w and Isshiah|strong="H3449"\w* \w the second|strong="H8145"\w*.
\s1 The Merarites
\r (\ref Numbers 3:33–37|NUM 3:33-37\ref*; \ref Numbers 4:29–33|NUM 4:29-33\ref*)
\li1 \v 21 \w The sons|strong="H1121"\w* \w of Merari|strong="H4847"\w*: \w Mahli|strong="H4249"\w* \w and Mushi|strong="H4187"\w*.
\li1 \w The sons|strong="H1121"\w* \w of Mahli|strong="H4249"\w*: \w Eleazar|strong="H499"\w* \w and Kish|strong="H7027"\w*. \v 22 \w Eleazar|strong="H499"\w* \w died|strong="H4191"\w* \w without|strong="H3808"\w* \w having any|strong="H1961"\w* \w sons|strong="H1121"\w*; \w he had only|strong="H3588"\w* \w daughters|strong="H1323"\w*. \w Their cousins|strong="H251"\w*, \w the sons|strong="H1121"\w* \w of Kish|strong="H7027"\w*, \w married them|strong="H5375"\w*.
\li1 \v 23 \w The sons|strong="H1121"\w* \w of Mushi|strong="H4187"\w*: \w Mahli|strong="H4249"\w*, \w Eder|strong="H5740"\w*, \w and Jeremoth|strong="H3406"\w*\f + \fr 23:23 \fqa Jeremoth \ft is a variant of \fqa Jerimoth\ft ; see \ref 1 Chronicles 24:30|1CH 24:30\ref*.\f*— \w three in all|strong="H7969"\w*.
\s1 Levite Duties Revised
\p \v 24 \w These|strong="H428"\w* \w were the descendants|strong="H1121"\w* \w of Levi|strong="H3878"\w* \w by their families|strong="H1"\w*— \w the heads|strong="H7218"\w* \w of families|strong="H1"\w*, \w registered|strong="H6485"\w* \w individually|strong="H1538"\w* \w by name|strong="H8034"\w*— \w those twenty|strong="H6242"\w* \w years of age|strong="H1121"\w* \w or older|strong="H4605"\w* \w who worked|strong="H6213"\w* \w in the service|strong="H5656"\w* \w of the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*.
\p \v 25 \w For|strong="H3588"\w* \w David|strong="H1732"\w* \w had said|strong="H559"\w*, “\w The LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w has given rest|strong="H5117"\w* \w to His people|strong="H5971"\w* \w and has come to dwell|strong="H7931"\w* \w in Jerusalem|strong="H3389"\w* \w forever|strong="H5704"\w*. \v 26 \w So now|strong="H1571"\w* \w the Levites|strong="H3881"\w* \w no|strong="H369"\w* \w longer need to carry|strong="H5375"\w* \w the tabernacle|strong="H4908"\w* \w or any|strong="H3605"\w* \w of the articles|strong="H3627"\w* \w for its service|strong="H5656"\w*.”
\p \v 27 \w For|strong="H3588"\w* \w according to the final|strong="H314"\w* \w instructions|strong="H1697"\w* \w of David|strong="H1732"\w*, \w the Levites|strong="H1121"\w* \w twenty|strong="H6242"\w* \w years of age|strong="H1121"\w* \w or older|strong="H4605"\w* \w were counted|strong="H4557"\w*, \v 28 \w but|strong="H3588"\w* \w their duty|strong="H4612"\w* \w was to assist|strong="H3027"\w* \w the descendants|strong="H1121"\w* \w of Aaron|strong="H175"\w* \w with the service|strong="H5656"\w* \w of the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*, \w being responsible for|strong="H5921"\w* \w the courts|strong="H2691"\w* \w and chambers|strong="H3957"\w*, \w the purification|strong="H2893"\w* \w of all|strong="H3605"\w* \w the holy things|strong="H6944"\w*, \w and the work|strong="H4639"\w* \w of the service|strong="H5656"\w* \w of the house|strong="H1004"\w* \w of God|strong="H430"\w*, \v 29 \w as well as for the rows|strong="H4635"\w* \w of the showbread|strong="H3899"\w*, \w the fine flour|strong="H5560"\w* \w for the grain offering|strong="H4503"\w*, \w the wafers|strong="H7550"\w* \w of unleavened bread|strong="H4682"\w*, \w the baking|strong="H4227"\w*, \w the mixing|strong="H7246"\w*, \w and all|strong="H3605"\w* \w measurements of quantity|strong="H4884"\w* \w and size|strong="H4060"\w*.
\p \v 30 \w They were also to stand|strong="H5975"\w* \w every morning|strong="H1242"\w* \w to give thanks|strong="H3034"\w* \w and praise|strong="H1984"\w* \w to the LORD|strong="H3068"\w*, \w and likewise|strong="H3651"\w* \w in the evening|strong="H6153"\w*. \v 31 \w Whenever|strong="H3605"\w* \w burnt offerings|strong="H5930"\w* \w were presented|strong="H5927"\w* \w to the LORD|strong="H3068"\w* \w on the Sabbaths|strong="H7676"\w*, \w New Moons|strong="H2320"\w*, \w and appointed feasts|strong="H4150"\w*, \w they were to serve regularly|strong="H8548"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w in the numbers|strong="H4557"\w* \w prescribed|strong="H4941"\w* \w for them|strong="H5921"\w*. \v 32 \w So the Levites were to carry out|strong="H8104"\w* \w the responsibilities|strong="H4931"\w* \w for the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w* \w and|strong="H853"\w* \w the Holy Place|strong="H6944"\w*, \w and, under|strong="H4931"\w* \w their brothers|strong="H251"\w* \w the descendants|strong="H1121"\w* \w of Aaron|strong="H175"\w*, \w the service|strong="H5656"\w* \w of the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*.
\c 24
\s1 Twenty-Four Divisions of Priests
\p \v 1 \w These were the divisions|strong="H4256"\w* \w of the descendants|strong="H1121"\w* \w of Aaron|strong="H175"\w*. \w The sons|strong="H1121"\w* \w of Aaron|strong="H175"\w* \w were Nadab|strong="H5070"\w*, \w Abihu|strong="H30"\w*, \w Eleazar|strong="H499"\w*, \w and Ithamar|strong="H385"\w*. \v 2 \w But Nadab|strong="H5070"\w* \w and Abihu|strong="H30"\w* \w died|strong="H4191"\w* \w before|strong="H6440"\w* \w their father did|strong="H1"\w*, \w and they had|strong="H1961"\w* \w no|strong="H3808"\w* \w sons|strong="H1121"\w*; \w so Eleazar|strong="H499"\w* \w and Ithamar|strong="H385"\w* \w served as priests|strong="H3547"\w*.
\p \v 3 \w With the help of Eleazar’s|strong="H499"\w* \w descendant|strong="H1121"\w* \w Zadok|strong="H6659"\w* \w and Ithamar’s|strong="H385"\w* \w descendant|strong="H1121"\w* \w Ahimelech|strong="H288"\w*, \w David|strong="H1732"\w* \w divided them|strong="H2505"\w* \w according to the offices|strong="H6486"\w* \w of their service|strong="H5656"\w*. \v 4 \w Since more|strong="H7227"\w* \w leaders|strong="H7218"\w* \w were found|strong="H4672"\w* \w among Eleazar’s|strong="H499"\w* \w descendants|strong="H1121"\w* \w than|strong="H4480"\w* \w those|strong="H1121"\w* \w of Ithamar|strong="H385"\w*, \w they were divided accordingly|strong="H2505"\w*. \w There were sixteen|strong="H8337"\w* \w heads|strong="H7218"\w* \w of families|strong="H1"\w* \w from the descendants|strong="H1121"\w* \w of Eleazar|strong="H499"\w* \w and eight|strong="H8083"\w* \w from the descendants|strong="H1121"\w* \w of Ithamar|strong="H385"\w*.
\p \v 5 \w Thus they were divided|strong="H2505"\w* \w by lot|strong="H1486"\w*, \w for|strong="H3588"\w* \w there were|strong="H1961"\w* \w officers|strong="H8269"\w* \w of the sanctuary|strong="H6944"\w* \w and officers|strong="H8269"\w* \w of God|strong="H430"\w* \w among both Eleazar’s|strong="H499"\w* \w and Ithamar’s|strong="H385"\w* \w descendants|strong="H1121"\w*.
\p \v 6 \w The scribe|strong="H5608"\w*, \w Shemaiah|strong="H8098"\w* \w son|strong="H1121"\w* \w of Nethanel|strong="H5417"\w*, \w a Levite|strong="H3881"\w*, \w recorded their names|strong="H3789"\w* \w in the presence|strong="H6440"\w* \w of the king|strong="H4428"\w* \w and of the officers|strong="H8269"\w*: \w Zadok|strong="H6659"\w* \w the priest|strong="H3548"\w*, \w Ahimelech|strong="H288"\w* \w son|strong="H1121"\w* \w of Abiathar|strong="H54"\w*, \w and the heads|strong="H7218"\w* \w of families|strong="H1"\w* \w of the priests|strong="H3548"\w* \w and the Levites|strong="H3881"\w* — \w one|strong="H259"\w* \w family|strong="H1"\w* \w being taken|strong="H270"\w* \w from Eleazar|strong="H499"\w*, \w and then one|strong="H270"\w* \w from Ithamar|strong="H385"\w*.
\b 
\li1 \v 7 \w The first|strong="H7223"\w* \w lot|strong="H1486"\w* \w fell|strong="H3318"\w* \w to Jehoiarib|strong="H3080"\w*,
\li1 \w the second|strong="H8145"\w* \w to Jedaiah|strong="H3048"\w*,
\li1 \v 8 \w the third|strong="H7992"\w* \w to Harim|strong="H2766"\w*,
\li1 \w the fourth|strong="H7243"\w* \w to Seorim|strong="H8188"\w*,
\li1 \v 9 \w the fifth|strong="H2549"\w* \w to Malchijah|strong="H4441"\w*,
\li1 \w the sixth|strong="H8345"\w* \w to Mijamin|strong="H4326"\w*,
\li1 \v 10 \w the seventh|strong="H7637"\w* \w to Hakkoz|strong="H6976"\w*,
\li1 \w the eighth|strong="H8066"\w* \w to Abijah|strong="H29"\w*,
\li1 \v 11 \w the ninth|strong="H8671"\w* \w to Jeshua|strong="H3442"\w*,
\li1 \w the tenth|strong="H6224"\w* \w to Shecaniah|strong="H7935"\w*,
\li1 \v 12 \w the eleventh|strong="H6249"\w* \w to Eliashib|strong="H475"\w*,
\li1 \w the twelfth|strong="H8147"\w* \w to Jakim|strong="H3356"\w*,
\li1 \v 13 \w the thirteenth|strong="H7969"\w* \w to Huppah|strong="H2647"\w*,
\li1 \w the fourteenth|strong="H702"\w* \w to Jeshebeab|strong="H3428"\w*,
\li1 \v 14 \w the fifteenth|strong="H2568"\w* \w to Bilgah|strong="H1083"\w*,
\li1 \w the sixteenth|strong="H8337"\w* \w to Immer|strong="H564"\w*,
\li1 \v 15 \w the seventeenth|strong="H7651"\w* \w to Hezir|strong="H2387"\w*,
\li1 \w the eighteenth|strong="H8083"\w* \w to Happizzez|strong="H6240"\w*,
\li1 \v 16 \w the nineteenth|strong="H8672"\w* \w to Pethahiah|strong="H6611"\w*,
\li1 \w the twentieth|strong="H6242"\w* \w to Jehezkel|strong="H3168"\w*,
\li1 \v 17 \w the twenty-first|strong="H259"\w* \w to Jachin|strong="H3199"\w*,
\li1 \w the twenty-second|strong="H8147"\w* \w to Gamul|strong="H1577"\w*,
\li1 \v 18 \w the twenty-third|strong="H7969"\w* \w to Delaiah|strong="H1806"\w*,
\li1 \w and the twenty-fourth|strong="H702"\w* \w to Maaziah|strong="H4590"\w*.
\p \v 19 \w This was|strong="H428"\w* \w their appointed order|strong="H6486"\w* \w for service|strong="H5656"\w* \w when they entered|strong="H935"\w* \w the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*, \w according to the regulations|strong="H4941"\w* \w prescribed for them|strong="H3027"\w* \w by their forefather|strong="H1"\w* \w Aaron|strong="H175"\w*, \w as|strong="H834"\w* \w the LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w had commanded him|strong="H6680"\w*.
\s1 The Rest of the Levites
\p \v 20 \w Now these were the rest of the|strong="H3498"\w* \w descendants|strong="H1121"\w* \w of Levi|strong="H3878"\w*:
\b 
\li1 \w From the sons|strong="H1121"\w* \w of Amram|strong="H6019"\w*: \w Shubael|strong="H7619"\w*;\f + \fr 24:20 \fqa Shubael \ft (twice in this verse) is a variant of \fqa Shebuel\ft ; see \ref 1 Chronicles 23:16|1CH 23:16\ref* and 1 Chronicles 26:24.\f*
\li1 \w from the sons|strong="H1121"\w* \w of Shubael|strong="H7619"\w*: \w Jehdeiah|strong="H3165"\w*.
\li1 \v 21 \w As for Rehabiah|strong="H7345"\w*, \w from his sons|strong="H1121"\w*: \w The first|strong="H7218"\w* \w was Isshiah|strong="H3449"\w*.\f + \fr 24:21 \fqa Isshiah \ft is a variant of \fqa Jeshaiah\ft ; see \ref 1 Chronicles 26:25|1CH 26:25\ref*.\f*
\li1 \v 22 \w From the Izharites|strong="H3325"\w*: \w Shelomoth|strong="H8013"\w*;\f + \fr 24:22 \fqa Shelomoth \ft (twice in this verse) is a variant of \fqa Shelomith\ft ; see \ref 1 Chronicles 23:18|1CH 23:18\ref*.\f*
\li1 \w from the sons|strong="H1121"\w* \w of Shelomoth|strong="H8013"\w*: \w Jahath|strong="H3189"\w*.
\li1 \v 23 \w From the sons of Hebron|strong="H1121"\w*: \w Jeriah was the first|strong="H3404"\w*,\f + \fr 24:23 \ft Hebrew \fqa From the sons: Jeriah\ft ; see \ref 1 Chronicles 23:19|1CH 23:19\ref*.\f* \w Amariah|strong="H568"\w* \w the second|strong="H8145"\w*, \w Jahaziel|strong="H3166"\w* \w the third|strong="H7992"\w*, \w and Jekameam|strong="H3360"\w* \w the fourth|strong="H7243"\w*.
\li1 \v 24 \w From the sons|strong="H1121"\w* \w of Uzziel|strong="H5816"\w*: \w Micah|strong="H4318"\w*;
\li1 \w from the sons of|strong="H1121"\w* \w Micah|strong="H4318"\w*: \w Shamir|strong="H8053"\w*.
\li1 \v 25 \w The brother|strong="H251"\w* \w of Micah|strong="H4318"\w*: \w Isshiah|strong="H3449"\w*;
\li1 \w from the sons|strong="H1121"\w* \w of Isshiah|strong="H3449"\w*: \w Zechariah|strong="H2148"\w*.
\li1 \v 26 \w The sons|strong="H1121"\w* \w of Merari|strong="H4847"\w*: \w Mahli|strong="H4249"\w* \w and Mushi|strong="H4187"\w*.
\li1 \w The son|strong="H1121"\w* \w of Jaaziah|strong="H3269"\w*: \w Beno|strong="H1121"\w*.
\li1 \v 27 \w The descendants|strong="H1121"\w* \w of Merari|strong="H4847"\w* \w from Jaaziah|strong="H3269"\w*: \w Beno|strong="H1121"\w*, \w Shoham|strong="H7719"\w*, \w Zaccur|strong="H2139"\w*, \w and Ibri|strong="H5681"\w*.
\li1 \v 28 \w From Mahli|strong="H4249"\w*: \w Eleazar|strong="H499"\w*, \w who had|strong="H1961"\w* \w no|strong="H3808"\w* \w sons|strong="H1121"\w*.
\li1 \v 29 \w From Kish|strong="H7027"\w*: \w Jerahmeel|strong="H3396"\w* \w the son|strong="H1121"\w* \w of Kish|strong="H7027"\w*.
\li1 \v 30 \w And the sons|strong="H1121"\w* \w of Mushi|strong="H4187"\w*: \w Mahli|strong="H4249"\w*, \w Eder|strong="H5740"\w*, \w and Jerimoth|strong="H3406"\w*.\f + \fr 24:30 \fqa Jerimoth \ft is a variant of \fqa Jeremoth\ft ; see \ref 1 Chronicles 23:23|1CH 23:23\ref*.\f*
\p \w These|strong="H428"\w* \w were the sons|strong="H1121"\w* \w of the Levites|strong="H3881"\w*, \w according to their families|strong="H1"\w*. \v 31 \w As|strong="H5980"\w* \w their brothers|strong="H251"\w* \w the descendants|strong="H1121"\w* \w of Aaron did|strong="H175"\w*, \w they|strong="H1992"\w* \w also|strong="H1571"\w* \w cast|strong="H5307"\w* \w lots|strong="H1486"\w* \w in the presence|strong="H6440"\w* \w of King|strong="H4428"\w* \w David|strong="H1732"\w* \w and of Zadok|strong="H6659"\w*, \w Ahimelech|strong="H288"\w*, \w and the heads|strong="H7218"\w* \w of the families|strong="H1"\w* \w of the priests|strong="H3548"\w* \w and Levites|strong="H3881"\w*— \w the family|strong="H1"\w* \w heads|strong="H7218"\w* \w and their younger|strong="H6996"\w* \w brothers|strong="H251"\w* \w alike|strong="H5980"\w*.
\c 25
\s1 Twenty-Four Divisions of Musicians
\p \v 1 \w Additionally, David|strong="H1732"\w* \w and the commanders|strong="H8269"\w* \w of the army|strong="H6635"\w* \w set apart|strong="H914"\w* \w some of the sons|strong="H1121"\w* \w of Asaph|strong="H623"\w*, \w Heman|strong="H1968"\w*, \w and Jeduthun|strong="H3038"\w* \w to prophesy|strong="H5030"\w* \w with the accompaniment of lyres|strong="H3658"\w*, \w harps|strong="H5035"\w*, \w and cymbals|strong="H4700"\w*. \w The following|strong="H1961"\w* \w is the list|strong="H4557"\w* \w of the men|strong="H582"\w* \w who performed|strong="H4399"\w* \w this service|strong="H5656"\w*:
\b 
\li1 \v 2 \w From the sons|strong="H1121"\w* \w of Asaph|strong="H623"\w*: \w Zaccur|strong="H2139"\w*, \w Joseph|strong="H3130"\w*, \w Nethaniah|strong="H5418"\w*, \w and Asarelah|strong="H841"\w*. \w These sons|strong="H1121"\w* \w of Asaph|strong="H623"\w* \w were under|strong="H5921"\w* \w the direction|strong="H3027"\w* \w of Asaph|strong="H623"\w*, \w who prophesied|strong="H5012"\w* \w under|strong="H5921"\w* \w the direction|strong="H3027"\w* \w of the king|strong="H4428"\w*.
\li1 \v 3 \w From the sons|strong="H1121"\w* \w of Jeduthun|strong="H3038"\w*: \w Gedaliah|strong="H1436"\w*, \w Zeri|strong="H6874"\w*, \w Jeshaiah , Shimei|strong="H3470"\w*,\f + \fr 25:3 \ft One Hebrew manuscript and some LXX manuscripts (see also verse 17); most Hebrew manuscripts do not include \fqa Shimei\ft .\f* \w Hashabiah|strong="H2811"\w*, \w and Mattithiah|strong="H4993"\w* — \w six in all|strong="H8337"\w* — \w under|strong="H5921"\w* \w the direction|strong="H3027"\w* \w of their father|strong="H1"\w* \w Jeduthun|strong="H3038"\w*, \w who prophesied|strong="H5012"\w* \w with the harp|strong="H3658"\w*, \w giving thanks|strong="H3034"\w* \w and praise|strong="H1984"\w* \w to the LORD|strong="H3068"\w*.
\li1 \v 4 \w From the sons|strong="H1121"\w* \w of Heman|strong="H1968"\w*: \w Bukkiah|strong="H1232"\w*, \w Mattaniah|strong="H4983"\w*, \w Uzziel|strong="H5816"\w*, \w Shebuel|strong="H7619"\w*,\f + \fr 25:4 \fqa Shebuel \ft is a variant of \fqa Shubael\ft ; see verse 20.\f* \w Jerimoth|strong="H3406"\w*,\f + \fr 25:4 \fqa Jerimoth \ft is a variant of \fqa Jeremoth\ft ; see verse 22.\f* \w Hananiah|strong="H2608"\w*, \w Hanani|strong="H2607"\w*, \w Eliathah|strong="H448"\w*, \w Giddalti|strong="H1437"\w*, \w Romamti-ezer|strong="H7320"\w*, \w Joshbekashah|strong="H3436"\w*, \w Mallothi|strong="H4413"\w*, \w Hothir|strong="H1956"\w*, \w and Mahazioth|strong="H4238"\w*. \v 5 \w All|strong="H3605"\w* \w these|strong="H428"\w* \w sons|strong="H1121"\w* \w of Heman|strong="H1968"\w* \w the king’s|strong="H4428"\w* \w seer|strong="H2374"\w* \w were given him through the promises|strong="H1697"\w* \w of God|strong="H430"\w* \w to exalt|strong="H7311"\w* \w him|strong="H7161"\w*, \w for God|strong="H430"\w* \w had given|strong="H5414"\w* \w Heman|strong="H1968"\w* \w fourteen|strong="H702"\w* \w sons|strong="H1121"\w* \w and three|strong="H7969"\w* \w daughters|strong="H1323"\w*.
\p \v 6 \w All|strong="H3605"\w* \w these were|strong="H428"\w* \w under|strong="H5921"\w* \w the direction|strong="H3027"\w* \w of their fathers|strong="H1"\w* \w for the music|strong="H7892"\w* \w of the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w* \w with cymbals|strong="H4700"\w*, \w harps|strong="H5035"\w*, \w and lyres|strong="H3658"\w*, \w for the service|strong="H5656"\w* \w of the house|strong="H1004"\w* \w of God|strong="H430"\w*.
\p \w Asaph|strong="H623"\w*, \w Jeduthun|strong="H3038"\w*, \w and Heman|strong="H1968"\w* \w were under|strong="H5921"\w* \w the direction|strong="H3027"\w* \w of the king|strong="H4428"\w*. \v 7 \w Together with|strong="H5973"\w* \w their relatives|strong="H251"\w*, \w who were all|strong="H3605"\w* \w trained|strong="H3925"\w* \w and skillful|strong="H995"\w* \w in the songs|strong="H7892"\w* \w of the LORD|strong="H3068"\w*, \w they numbered|strong="H4557"\w* \w 288|strong="H3967"\w*. \v 8 \w They cast|strong="H5307"\w* \w lots|strong="H1486"\w* \w for their duties|strong="H4931"\w*, \w young|strong="H6996"\w* \w and old alike|strong="H1419"\w*, \w teacher|strong="H995"\w* \w as|strong="H5973"\w* \w well as pupil|strong="H8527"\w*.
\b 
\li1 \v 9 \w The first|strong="H7223"\w* \w lot|strong="H1486"\w*, \w which was for Asaph|strong="H623"\w*, \w fell|strong="H3318"\w* \w to Joseph, his sons, and his brothers—12 in all|strong="H3130"\w*;\f + \fr 25:9 \ft See LXX and the total in verse 7; Hebrew does not include \fqa his sons, and his brothers—12 in all;\f*
\li1 \w the second|strong="H8145"\w* \w to Gedaliah|strong="H1436"\w*, \w his sons|strong="H1121"\w*, \w and his brothers|strong="H251"\w*— \w 12 in all|strong="H8147"\w*;
\li1 \v 10 \w the third|strong="H7992"\w* \w to Zaccur|strong="H2139"\w*, \w his sons|strong="H1121"\w*, \w and his brothers|strong="H251"\w*— \w 12 in all|strong="H8147"\w*;
\li1 \v 11 \w the fourth|strong="H7243"\w* \w to Izri|strong="H3339"\w*,\f + \fr 25:11 \fqa Izri \ft is a variant of \fqa Zeri\ft ; see verse 3.\f* \w his sons|strong="H1121"\w*, \w and his brothers|strong="H251"\w*— \w 12 in all|strong="H8147"\w*;
\li1 \v 12 \w the fifth|strong="H2549"\w* \w to Nethaniah|strong="H5418"\w*, \w his sons|strong="H1121"\w*, \w and his brothers|strong="H251"\w*— \w 12 in all|strong="H8147"\w*;
\li1 \v 13 \w the sixth|strong="H8345"\w* \w to Bukkiah|strong="H1232"\w*, \w his sons|strong="H1121"\w*, \w and his brothers|strong="H251"\w*— \w 12 in all|strong="H8147"\w*;
\li1 \v 14 \w the seventh|strong="H7637"\w* \w to Jesarelah|strong="H3480"\w*,\f + \fr 25:14 \fqa Jesarelah \ft is a variant of \fqa Asarelah\ft ; see verse 2.\f* \w his sons|strong="H1121"\w*, \w and his brothers|strong="H251"\w*— \w 12 in all|strong="H8147"\w*;
\li1 \v 15 \w the eighth|strong="H8066"\w* \w to Jeshaiah|strong="H3470"\w*, \w his sons|strong="H1121"\w*, \w and his brothers|strong="H251"\w*— \w 12 in all|strong="H8147"\w*;
\li1 \v 16 \w the ninth|strong="H8671"\w* \w to Mattaniah|strong="H4983"\w*, \w his sons|strong="H1121"\w*, \w and his brothers|strong="H251"\w*— \w 12 in all|strong="H8147"\w*;
\li1 \v 17 \w the tenth|strong="H6224"\w* \w to Shimei|strong="H8096"\w*, \w his sons|strong="H1121"\w*, \w and his brothers|strong="H251"\w*— \w 12 in all|strong="H8147"\w*;
\li1 \v 18 \w the eleventh|strong="H6249"\w* \w to Azarel|strong="H5832"\w*,\f + \fr 25:18 \fqa Azarel \ft is a variant of \fqa Uzziel\ft ; see verse 4.\f* \w his sons|strong="H1121"\w*, \w and his brothers|strong="H251"\w*— \w 12 in all|strong="H8147"\w*;
\li1 \v 19 \w the twelfth|strong="H8147"\w* \w to Hashabiah|strong="H2811"\w*, \w his sons|strong="H1121"\w*, \w and his brothers|strong="H251"\w*— \w 12 in all|strong="H8147"\w*;
\li1 \v 20 \w the thirteenth|strong="H7969"\w* \w to Shubael|strong="H7619"\w*, \w his sons|strong="H1121"\w*, \w and his brothers|strong="H251"\w*— \w 12 in all|strong="H8147"\w*;
\li1 \v 21 \w the fourteenth|strong="H702"\w* \w to Mattithiah|strong="H4993"\w*, \w his sons|strong="H1121"\w*, \w and his brothers|strong="H251"\w*— \w 12 in all|strong="H8147"\w*;
\li1 \v 22 \w the fifteenth|strong="H2568"\w* \w to Jeremoth|strong="H3406"\w*,\f + \fr 25:22 \fqa Jeremoth \ft is a variant of \fqa Jerimoth\ft ; see verse 4.\f* \w his sons|strong="H1121"\w*, \w and his brothers|strong="H251"\w*— \w 12 in all|strong="H8147"\w*;
\li1 \v 23 \w the sixteenth|strong="H8337"\w* \w to Hananiah|strong="H2608"\w*, \w his sons|strong="H1121"\w*, \w and his brothers|strong="H251"\w*— \w 12 in all|strong="H8147"\w*;
\li1 \v 24 \w the seventeenth|strong="H7651"\w* \w to Joshbekashah|strong="H3436"\w*, \w his sons|strong="H1121"\w*, \w and his brothers|strong="H251"\w*— \w 12 in all|strong="H8147"\w*;
\li1 \v 25 \w the eighteenth|strong="H8083"\w* \w to Hanani|strong="H2607"\w*, \w his sons|strong="H1121"\w*, \w and his brothers|strong="H251"\w*— \w 12 in all|strong="H8147"\w*;
\li1 \v 26 \w the nineteenth|strong="H8672"\w* \w to Mallothi|strong="H4413"\w*, \w his sons|strong="H1121"\w*, \w and his brothers|strong="H251"\w*— \w 12 in all|strong="H8147"\w*;
\li1 \v 27 \w the twentieth|strong="H6242"\w* \w to Eliathah|strong="H448"\w*, \w his sons|strong="H1121"\w*, \w and his brothers|strong="H251"\w*— \w 12 in all|strong="H8147"\w*;
\li1 \v 28 \w the twenty-first|strong="H259"\w* \w to Hothir|strong="H1956"\w*, \w his sons|strong="H1121"\w*, \w and his brothers|strong="H251"\w*— \w 12 in all|strong="H8147"\w*;
\li1 \v 29 \w the twenty-second|strong="H8147"\w* \w to Giddalti|strong="H1437"\w*, \w his sons|strong="H1121"\w*, \w and his brothers|strong="H251"\w*— \w 12 in all|strong="H8147"\w*;
\li1 \v 30 \w the twenty-third|strong="H7969"\w* \w to Mahazioth|strong="H4238"\w*, \w his sons|strong="H1121"\w*, \w and his brothers|strong="H251"\w*— \w 12 in all|strong="H8147"\w*;
\li1 \v 31 \w and the twenty-fourth|strong="H702"\w* \w to Romamti-ezer|strong="H7320"\w*, \w his sons|strong="H1121"\w*, \w and his brothers|strong="H251"\w*— \w 12 in all|strong="H8147"\w*.
\c 26
\s1 The Divisions of the Gatekeepers
\p \v 1 \w These were the divisions|strong="H4256"\w* \w of the gatekeepers|strong="H7778"\w*:
\b 
\li1 \w From the Korahites|strong="H7145"\w*: \w Meshelemiah|strong="H4920"\w* \w son|strong="H1121"\w* \w of Kore|strong="H6981"\w*, \w one of|strong="H4480"\w* \w the sons|strong="H1121"\w* \w of Asaph|strong="H623"\w*.
\li1 \v 2 \w Meshelemiah|strong="H4920"\w* \w had sons|strong="H1121"\w*: \w Zechariah|strong="H2148"\w* \w the firstborn|strong="H1060"\w*, \w Jediael|strong="H3043"\w* \w the second|strong="H8145"\w*, \w Zebadiah|strong="H2069"\w* \w the third|strong="H7992"\w*, \w Jathniel|strong="H3496"\w* \w the fourth|strong="H7243"\w*, \v 3 \w Elam|strong="H5867"\w* \w the fifth|strong="H2549"\w*, \w Jehohanan|strong="H3076"\w* \w the sixth|strong="H8345"\w*, \w and Eliehoenai|strong="H454"\w* \w the seventh|strong="H7637"\w*.
\li1 \v 4 \w And Obed-edom|strong="H5654"\w* \w also had sons|strong="H1121"\w*: \w Shemaiah|strong="H8098"\w* \w the firstborn|strong="H1060"\w*, \w Jehozabad|strong="H3075"\w* \w the second|strong="H8145"\w*, \w Joah|strong="H3098"\w* \w the third|strong="H7992"\w*, \w Sachar|strong="H7940"\w* \w the fourth|strong="H7243"\w*, \w Nethanel|strong="H5417"\w* \w the fifth|strong="H2549"\w*, \v 5 \w Ammiel|strong="H5988"\w* \w the sixth|strong="H8345"\w*, \w Issachar|strong="H3485"\w* \w the seventh|strong="H7637"\w*, \w and Peullethai|strong="H6469"\w* \w the eighth|strong="H8066"\w*. \w For|strong="H3588"\w* \w God|strong="H430"\w* \w had blessed Obed-edom|strong="H1288"\w*.
\li1 \v 6 \w Also to his son|strong="H1121"\w* \w Shemaiah|strong="H8098"\w* \w were born|strong="H3205"\w* \w sons|strong="H1121"\w* \w who ruled|strong="H4474"\w* \w over their families|strong="H1"\w* \w because|strong="H3588"\w* \w they|strong="H1992"\w* \w were strong|strong="H1368"\w*, \w capable men|strong="H2428"\w*. \v 7 \w Shemaiah’s|strong="H8098"\w* \w sons were|strong="H1121"\w* \w Othni|strong="H6273"\w*, \w Rephael|strong="H7501"\w*, \w Obed|strong="H5744"\w*, \w and Elzabad|strong="H443"\w*; \w his brothers were|strong="H251"\w* \w Elihu|strong="H453"\w* \w and Semachiah|strong="H5565"\w*, \w also capable|strong="H2428"\w* \w men|strong="H1121"\w*. \v 8 \w All|strong="H3605"\w* \w these were|strong="H428"\w* \w descendants|strong="H1121"\w* \w of Obed-edom|strong="H5654"\w*; \w they|strong="H1992"\w* \w and their sons|strong="H1121"\w* \w and brothers|strong="H251"\w* \w were capable|strong="H2428"\w* \w men|strong="H376"\w* \w with strength|strong="H3581"\w* \w to do the work|strong="H5656"\w*— \w 62|strong="H8346"\w* \w in all|strong="H5654"\w* \w from Obed-edom|strong="H5654"\w*.
\li1 \v 9 \w Meshelemiah|strong="H4920"\w* \w also had sons|strong="H1121"\w* \w and brothers|strong="H251"\w* \w who were capable|strong="H2428"\w* \w men|strong="H1121"\w*— \w 18 in all|strong="H8083"\w*.
\li1 \v 10 \w Hosah|strong="H2621"\w* \w the Merarite|strong="H1121"\w* \w also had sons|strong="H1121"\w*: \w Shimri|strong="H8113"\w* \w the first|strong="H7218"\w* (\w although|strong="H3588"\w* \w he was|strong="H1961"\w* \w not|strong="H3808"\w* \w the firstborn|strong="H1060"\w*, \w his father|strong="H1"\w* \w had appointed him|strong="H7760"\w* \w as the first|strong="H7218"\w*), \v 11 \w Hilkiah|strong="H2518"\w* \w the second|strong="H8145"\w*, \w Tebaliah|strong="H2882"\w* \w the third|strong="H7992"\w*, \w and Zechariah|strong="H2148"\w* \w the fourth|strong="H7243"\w*. \w The sons|strong="H1121"\w* \w and brothers|strong="H251"\w* \w of Hosah|strong="H2621"\w* \w numbered 13|strong="H7969"\w* \w in all|strong="H3605"\w*.
\p \v 12 \w These|strong="H428"\w* \w divisions|strong="H4256"\w* \w of the gatekeepers|strong="H7778"\w*, \w through their chief|strong="H7218"\w* \w men|strong="H1397"\w*, \w had duties|strong="H4931"\w* \w for ministering|strong="H8334"\w* \w in the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*, \w just as|strong="H5980"\w* \w their relatives did|strong="H251"\w*. \v 13 \w They cast|strong="H5307"\w* \w lots|strong="H1486"\w* \w for each gate|strong="H8179"\w*, \w according to their families|strong="H1"\w*, \w young|strong="H6996"\w* \w and old alike|strong="H1419"\w*.
\b 
\li1 \v 14 \w The lot|strong="H1486"\w* \w for the East Gate|strong="H4217"\w* \w fell|strong="H5307"\w* \w to Shelemiah|strong="H8018"\w*.\f + \fr 26:14 \fqa Shelemiah \ft is a variant of \fqa Meshelemiah\ft ; see verse 2.\f*
\li1 \w Then lots|strong="H1486"\w* \w were cast|strong="H5307"\w* \w for his son|strong="H1121"\w* \w Zechariah|strong="H2148"\w*, \w a wise|strong="H7922"\w* \w counselor|strong="H3289"\w*, \w and the lot|strong="H1486"\w* \w for the North Gate|strong="H6828"\w* \w fell to him|strong="H3318"\w*.
\li1 \v 15 \w The lot for the South Gate|strong="H5045"\w* \w fell to|strong="H5654"\w* \w Obed-edom|strong="H5654"\w*, \w and the lot for the storehouses|strong="H1004"\w* \w to his sons|strong="H1121"\w*.
\li1 \v 16 \w The lots for the West Gate|strong="H4628"\w* \w and|strong="H5973"\w* \w the Shallecheth|strong="H7996"\w* \w Gate|strong="H8179"\w* \w on the ascending|strong="H5927"\w* \w highway|strong="H4546"\w*\f + \fr 26:16 \ft Or \fqa on the upper road\f* \w fell to Shuppim|strong="H8206"\w* \w and Hosah|strong="H2621"\w*.
\p \w There were guards|strong="H4929"\w* \w stationed|strong="H5980"\w* \w at every watch|strong="H4929"\w*. \v 17 \w Each day|strong="H3117"\w* \w there were six|strong="H8337"\w* \w Levites|strong="H3881"\w* \w on the east|strong="H4217"\w*, \w four|strong="H702"\w* \w on the north|strong="H6828"\w*, \w four|strong="H702"\w* \w on the south|strong="H5045"\w*, \w and two pairs|strong="H8147"\w* \w at the storehouse|strong="H624"\w*. \v 18 \w As for the court|strong="H6503"\w*\f + \fr 26:18 \ft Hebrew \fqa parbar\ft ; twice in this verse\f* \w on the west|strong="H4628"\w*, \w there were four|strong="H702"\w* \w at the highway|strong="H4546"\w* \w and two|strong="H8147"\w* \w at the court|strong="H6503"\w*.
\p \v 19 \w These were|strong="H428"\w* \w the divisions|strong="H4256"\w* \w of the gatekeepers|strong="H7778"\w* \w who were descendants|strong="H1121"\w* \w of Korah|strong="H7145"\w* \w and|strong="H1121"\w* \w Merari|strong="H4847"\w*.
\s1 The Treasurers, Officers, and Judges
\p \v 20 \w Now their fellow Levites were|strong="H3881"\w*\f + \fr 26:20 \ft LXX; Hebrew \fqa As for the Levites, Ahijah was\f* \w in charge of|strong="H5921"\w* \w the treasuries|strong="H214"\w* \w of the house|strong="H1004"\w* \w of God|strong="H430"\w* \w and the treasuries|strong="H214"\w* \w of the dedicated things|strong="H6944"\w*. \v 21 \w From the descendants|strong="H1121"\w* \w of Ladan|strong="H3936"\w*, \w who were|strong="H1121"\w* \w Gershonites|strong="H1649"\w* \w through Ladan|strong="H3936"\w*\f + \fr 26:21 \fqa Ladan \ft is a variant of \fqa Libni\ft ; see \ref 1 Chronicles 6:17|1CH 6:17\ref*.\f* \w and heads|strong="H7218"\w* \w of the families|strong="H1"\w* \w of Ladan|strong="H3936"\w* \w the Gershonite|strong="H1649"\w*, \w were Jehieli|strong="H3172"\w*,\f + \fr 26:21 \fqa Jehieli \ft is a variant of \fqa Jehiel\ft ; also in verse 22; see \ref 1 Chronicles 23:8|1CH 23:8\ref*.\f* \v 22 \w the sons|strong="H1121"\w* \w of Jehieli|strong="H3172"\w*, \w Zetham|strong="H2241"\w*, \w and his brother|strong="H251"\w* \w Joel|strong="H3100"\w*. \w They were in charge of|strong="H5921"\w* \w the treasuries|strong="H214"\w* \w of the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*.
\p \v 23 \w From the Amramites|strong="H6020"\w*, \w the Izharites|strong="H3325"\w*, \w the Hebronites|strong="H2276"\w*, \w and the Uzzielites|strong="H5817"\w*:
\b 
\li1 \v 24 \w Shebuel|strong="H7619"\w*, \w a descendant|strong="H1121"\w* \w of Gershom|strong="H1647"\w* \w son of|strong="H1121"\w* \w Moses|strong="H4872"\w*, \w was the officer|strong="H5057"\w* \w in charge of|strong="H5921"\w* \w the treasuries|strong="H214"\w*. \v 25 \w His relatives|strong="H251"\w* \w through Eliezer included|strong="H461"\w* \w Rehabiah|strong="H7345"\w* \w his son|strong="H1121"\w*, \w Jeshaiah|strong="H3470"\w*\f + \fr 26:25 \fqa Jeshaiah \ft is a variant of \fqa Isshiah\ft ; see \ref 1 Chronicles 24:21|1CH 24:21\ref*.\f* \w his son|strong="H1121"\w*, \w Joram|strong="H3141"\w* \w his son|strong="H1121"\w*, \w Zichri|strong="H2147"\w* \w his son|strong="H1121"\w*, \w and Shelomith|strong="H8013"\w* \w his son|strong="H1121"\w*. \v 26 \w This|strong="H1931"\w* \w Shelomith|strong="H8013"\w* \w and his brothers|strong="H251"\w* \w were in charge of|strong="H5921"\w* \w all|strong="H3605"\w* \w the treasuries|strong="H214"\w* \w for the things|strong="H834"\w* \w dedicated|strong="H6942"\w* \w by King|strong="H4428"\w* \w David|strong="H1732"\w*, \w by the heads|strong="H7218"\w* \w of families|strong="H1"\w* \w who were the commanders|strong="H8269"\w* \w of thousands|strong="H505"\w* \w and of hundreds|strong="H3967"\w*, \w and by the army|strong="H6635"\w* \w commanders|strong="H8269"\w*. \v 27 \w They had dedicated|strong="H6942"\w* \w some of|strong="H4480"\w* \w the plunder|strong="H7998"\w* \w from|strong="H4480"\w* \w their battles|strong="H4421"\w* \w to the repair|strong="H2388"\w* \w of the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*. \v 28 \w Everything|strong="H3605"\w* \w that had been dedicated|strong="H6942"\w* \w by Samuel|strong="H8050"\w* \w the seer|strong="H7203"\w*, \w Saul|strong="H7586"\w* \w son|strong="H1121"\w* \w of Kish|strong="H7027"\w*, \w Abner|strong="H74"\w* \w son|strong="H1121"\w* \w of Ner|strong="H5369"\w*, \w and Joab|strong="H3097"\w* \w son|strong="H1121"\w* \w of Zeruiah|strong="H6870"\w*, \w along with everything else|strong="H3605"\w* \w that was dedicated|strong="H6942"\w*, \w was under|strong="H5921"\w* \w the care|strong="H3027"\w* \w of Shelomith|strong="H8019"\w* \w and his brothers|strong="H251"\w*.
\b 
\li1 \v 29 \w From the Izharites|strong="H3325"\w*, \w Chenaniah|strong="H3663"\w* \w and his sons|strong="H1121"\w* \w had the outside|strong="H2435"\w* \w duties|strong="H4399"\w*\f + \fr 26:29 \ft Or \fqa the duties outside (the temple) \ft or \fqa the duties outside (Jerusalem)\f* \w as officers|strong="H7860"\w* \w and judges|strong="H8199"\w* \w over|strong="H5921"\w* \w Israel|strong="H3478"\w*.
\li1 \v 30 \w From the Hebronites|strong="H2276"\w*, \w Hashabiah|strong="H2811"\w* \w and his relatives|strong="H251"\w*, \w 1,700|strong="H505"\w* \w capable|strong="H2428"\w* \w men|strong="H1121"\w*, \w had charge of the affairs|strong="H6486"\w* \w of Israel|strong="H3478"\w* \w west|strong="H4628"\w* \w of the Jordan|strong="H3383"\w* \w for all|strong="H3605"\w* \w the work|strong="H4399"\w* \w of the LORD|strong="H3068"\w* \w and for the service|strong="H5656"\w* \w of the king|strong="H4428"\w*. \v 31 \w As for the Hebronites|strong="H2276"\w*, \w Jerijah|strong="H3404"\w*\f + \fr 26:31 \fqa Jerijah \ft is a variant of \fqa Jeriah\ft ; see \ref 1 Chronicles 23:19|1CH 23:19\ref*.\f* \w was the chief|strong="H7218"\w* \w of the Hebronites|strong="H2276"\w*, \w according to the genealogies|strong="H8435"\w* \w of his ancestors|strong="H1"\w*. \w In the fortieth|strong="H705"\w* \w year|strong="H8141"\w* \w of David’s|strong="H1732"\w* \w reign|strong="H4438"\w* \w the records were searched|strong="H1875"\w*, \w and strong|strong="H1368"\w*, \w capable men|strong="H2428"\w* \w were found|strong="H4672"\w* among the Hebronites \w at Jazer|strong="H3270"\w* \w in Gilead|strong="H1568"\w*. \v 32 \w Among Jerijah’s relatives|strong="H251"\w* \w there were 2,700|strong="H505"\w* \w capable|strong="H2428"\w* \w men|strong="H1121"\w* \w who were heads|strong="H7218"\w* \w of families|strong="H1"\w*. \w King|strong="H4428"\w* \w David|strong="H1732"\w* \w appointed them|strong="H6485"\w* \w over|strong="H5921"\w* \w the Reubenites|strong="H7206"\w*, \w the Gadites|strong="H1425"\w*, \w and the half-tribe|strong="H2677"\w* \w of Manasseh|strong="H4520"\w* \w for every|strong="H3605"\w* \w matter pertaining to|strong="H1697"\w* \w God|strong="H430"\w* \w and for the affairs|strong="H1697"\w* \w of the king|strong="H4428"\w*.
\c 27
\s1 Twelve Captains for Twelve Months
\p \v 1 \w This is the list|strong="H4557"\w* \w of the Israelites|strong="H3478"\w*— \w the heads|strong="H7218"\w* \w of families|strong="H1"\w*, \w the commanders|strong="H8269"\w* \w of thousands|strong="H505"\w* \w and of hundreds|strong="H3967"\w*, \w and their officers|strong="H7860"\w* \w who served|strong="H8334"\w* \w the king|strong="H4428"\w* \w in every|strong="H3605"\w* \w matter|strong="H1697"\w* \w concerning the divisions|strong="H4256"\w* \w on rotating military duty|strong="H935"\w* \w each month|strong="H2320"\w* \w throughout|strong="H3605"\w* \w the year|strong="H8141"\w*. \w There were 24,000 men|strong="H6242"\w* \w in each|strong="H259"\w* \w division|strong="H4256"\w*:
\b 
\li1 \v 2 \w Jashobeam|strong="H3434"\w* \w son|strong="H1121"\w* \w of Zabdiel|strong="H2068"\w* \w was in charge of|strong="H5921"\w* \w the first|strong="H7223"\w* \w division|strong="H4256"\w*, \w which was assigned the first|strong="H7223"\w* \w month|strong="H2320"\w*. \w There were 24,000|strong="H6242"\w* \w men in|strong="H5921"\w* \w his division|strong="H4256"\w*. \v 3 \w He was a descendant|strong="H1121"\w* \w of Perez|strong="H6557"\w* \w and chief|strong="H7218"\w* \w of all|strong="H3605"\w* \w the army|strong="H6635"\w* \w commanders|strong="H8269"\w* \w for the first|strong="H7223"\w* \w month|strong="H2320"\w*.
\li1 \v 4 \w Dodai|strong="H1737"\w*\f + \fr 27:4 \fqa Dodai \ft is a variant of \fqa Dodo\ft ; see \ref 2 Samuel 23:9|2SA 23:9\ref*.\f* \w the Ahohite|strong="H266"\w* \w was in charge of|strong="H5921"\w* \w the division|strong="H4256"\w* \w for the second|strong="H8145"\w* \w month|strong="H2320"\w*, \w and Mikloth|strong="H4732"\w* \w was the leader|strong="H5057"\w*. \w There were 24,000|strong="H6242"\w* \w men in|strong="H5921"\w* \w his division|strong="H4256"\w*.
\li1 \v 5 \w The third|strong="H7992"\w* \w army|strong="H6635"\w* \w commander|strong="H8269"\w*, \w as chief|strong="H7218"\w* \w for the third|strong="H7992"\w* \w month|strong="H2320"\w*, \w was Benaiah|strong="H1141"\w* \w son|strong="H1121"\w* \w of Jehoiada|strong="H3077"\w* \w the priest|strong="H3548"\w*. \w There were 24,000|strong="H6242"\w* \w men in|strong="H5921"\w* \w his division|strong="H4256"\w*. \v 6 \w This|strong="H1931"\w* \w Benaiah|strong="H1141"\w* \w was mighty|strong="H1368"\w* \w among the Thirty|strong="H7970"\w* \w and was over|strong="H5921"\w* \w the Thirty|strong="H7970"\w*, \w and his son|strong="H1121"\w* \w Ammizabad|strong="H5990"\w* \w was in charge of his division|strong="H4256"\w*.
\li1 \v 7 \w The fourth|strong="H7243"\w*, \w for the fourth|strong="H7243"\w* \w month|strong="H2320"\w*, \w was Joab’s|strong="H3097"\w* \w brother|strong="H251"\w* \w Asahel|strong="H6214"\w*, \w and his son|strong="H1121"\w* \w Zebadiah|strong="H2069"\w* \w was commander after him|strong="H310"\w*. \w There were 24,000|strong="H6242"\w* \w men in|strong="H5921"\w* \w his division|strong="H4256"\w*.
\li1 \v 8 \w The fifth|strong="H2549"\w*, \w for the fifth|strong="H2549"\w* \w month|strong="H2320"\w*, \w was the commander|strong="H8269"\w* \w Shamhuth|strong="H8049"\w*\f + \fr 27:8 \fqa Shamhuth \ft is a variant of \fqa Shammoth \ft or \fqa Shammah\ft ; see \ref 1 Chronicles 11:27|1CH 11:27\ref* and 2 Samuel 23:25.\f* \w the Izrahite|strong="H3155"\w*. \w There were 24,000|strong="H6242"\w* \w men in|strong="H5921"\w* \w his division|strong="H4256"\w*.
\li1 \v 9 \w The sixth|strong="H8345"\w*, \w for the sixth|strong="H8345"\w* \w month|strong="H2320"\w*, \w was Ira|strong="H5896"\w* \w son|strong="H1121"\w* \w of Ikkesh|strong="H6142"\w* \w the Tekoite|strong="H8621"\w*. \w There were 24,000|strong="H6242"\w* \w men in|strong="H5921"\w* \w his division|strong="H4256"\w*.
\li1 \v 10 \w The seventh|strong="H7637"\w*, \w for the seventh|strong="H7637"\w* \w month|strong="H2320"\w*, \w was Helez|strong="H2503"\w* \w the Pelonite|strong="H6397"\w*, \w an Ephraimite|strong="H669"\w*. \w There were 24,000|strong="H6242"\w* \w men in|strong="H5921"\w* \w his division|strong="H4256"\w*.
\li1 \v 11 \w The eighth|strong="H8066"\w*, \w for the eighth|strong="H8066"\w* \w month|strong="H2320"\w*, \w was Sibbecai|strong="H5444"\w* \w the Hushathite|strong="H2843"\w*, \w a Zerahite|strong="H2227"\w*. \w There were 24,000|strong="H6242"\w* \w men in|strong="H5921"\w* \w his division|strong="H4256"\w*.
\li1 \v 12 \w The ninth|strong="H8671"\w*, \w for the ninth|strong="H8671"\w* \w month|strong="H2320"\w*, \w was Abiezer|strong="H44"\w* \w the Anathothite|strong="H6069"\w*, \w a Benjamite|strong="H1145"\w*. \w There were 24,000|strong="H6242"\w* \w men in|strong="H5921"\w* \w his division|strong="H4256"\w*.
\li1 \v 13 \w The tenth|strong="H6224"\w*, \w for the tenth|strong="H6224"\w* \w month|strong="H2320"\w*, \w was Maharai|strong="H4121"\w* \w the Netophathite|strong="H5200"\w*, \w a Zerahite|strong="H2227"\w*. \w There were 24,000|strong="H6242"\w* \w men in|strong="H5921"\w* \w his division|strong="H4256"\w*.
\li1 \v 14 \w The eleventh|strong="H6249"\w*, \w for the eleventh|strong="H6249"\w* \w month|strong="H2320"\w*, \w was Benaiah|strong="H1141"\w* \w the Pirathonite|strong="H6553"\w*, \w an Ephraimite|strong="H669"\w*. \w There were 24,000|strong="H6242"\w* \w men in|strong="H5921"\w* \w his division|strong="H4256"\w*.
\li1 \v 15 \w The twelfth|strong="H8147"\w*, \w for the twelfth|strong="H8147"\w* \w month|strong="H2320"\w*, \w was Heldai|strong="H2469"\w*\f + \fr 27:15 \fqa Heldai \ft is a variant of \fqa Heled\ft ; see \ref 1 Chronicles 11:30|1CH 11:30\ref* and 2 Samuel 23:29.\f* \w the Netophathite|strong="H5200"\w*, \w from the family of Othniel|strong="H6274"\w*. \w There were 24,000|strong="H6242"\w* \w men in|strong="H5921"\w* \w his division|strong="H4256"\w*.
\s1 The Leaders of the Twelve Tribes
\p \v 16 \w These officers were in charge of|strong="H5921"\w* \w the tribes|strong="H7626"\w* \w of Israel|strong="H3478"\w*:
\b 
\li1 \w Over the Reubenites|strong="H7206"\w* \w was Eliezer|strong="H461"\w* \w son|strong="H1121"\w* \w of Zichri|strong="H2147"\w*;
\li1 \w over the Simeonites|strong="H8099"\w* \w was Shephatiah|strong="H8203"\w* \w son|strong="H1121"\w* \w of Maacah|strong="H4601"\w*;
\li1 \v 17 \w over Levi|strong="H3878"\w* \w was Hashabiah|strong="H2811"\w* \w son|strong="H1121"\w* \w of Kemuel|strong="H7055"\w*;
\li1 \w over Aaron|strong="H175"\w* \w was Zadok|strong="H6659"\w*;
\li1 \v 18 \w over Judah|strong="H3063"\w* \w was Elihu|strong="H453"\w*, \w one of David’s|strong="H1732"\w* \w brothers|strong="H251"\w*;
\li1 \w over Issachar|strong="H3485"\w* \w was Omri|strong="H6018"\w* \w son|strong="H1121"\w* \w of Michael|strong="H4317"\w*;
\li1 \v 19 \w over Zebulun|strong="H2074"\w* \w was Ishmaiah|strong="H3460"\w* \w son|strong="H1121"\w* \w of Obadiah|strong="H5662"\w*;
\li1 \w over Naphtali|strong="H5321"\w* \w was Jerimoth|strong="H3406"\w* \w son|strong="H1121"\w* \w of Azriel|strong="H5837"\w*;
\li1 \v 20 \w over the Ephraimites|strong="H1121"\w* \w was Hoshea|strong="H1954"\w* \w son|strong="H1121"\w* \w of Azaziah|strong="H5812"\w*;
