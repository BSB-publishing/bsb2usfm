\li2 \w The sons|strong="H1121"\w* \w of Dishon|strong="H1787"\w*: \w Hemdan|strong="H2566"\w*,\f + \fr 1:41 \ft LXX (see also \ref Genesis 36:26|GEN 36:26\ref*); Hebrew \fqa Hamran\f* \w Eshban|strong="H790"\w*, \w Ithran|strong="H3506"\w*, \w and Cheran|strong="H3763"\w*.
\li2 \v 42 \w The sons|strong="H1121"\w* \w of Ezer|strong="H687"\w*: \w Bilhan|strong="H1092"\w*, \w Zaavan|strong="H2190"\w*, \w and Akan|strong="H3292"\w*.\f + \fr 1:42 \ft LXX (see also \ref Genesis 36:27|GEN 36:27\ref*); Hebrew \fqa Jaakan\f*
\li2 \w The sons|strong="H1121"\w* \w of Dishan|strong="H1787"\w*: \w Uz|strong="H5780"\w* \w and Aran|strong="H765"\w*.
\s1 The Kings of Edom
\r (\ref Genesis 36:31–43|GEN 36:31-43\ref*)
\p \v 43 \w These are|strong="H428"\w* \w the kings|strong="H4428"\w* \w who|strong="H834"\w* \w reigned|strong="H4427"\w* \w in the land|strong="H776"\w* \w of Edom|strong="H123"\w* \w before|strong="H6440"\w* \w any king|strong="H4428"\w* \w reigned|strong="H4427"\w* \w over the Israelites|strong="H1121"\w*:\f + \fr 1:43 \ft Or \fqa before an Israelite king ruled over them\f*
\b 
\li1 \w Bela|strong="H1106"\w* \w son|strong="H1121"\w* \w of Beor|strong="H1160"\w*. \w His city|strong="H5892"\w* \w was named|strong="H8034"\w* \w Dinhabah|strong="H1838"\w*.
\b 
\li1 \v 44 \w When Bela|strong="H1106"\w* \w died|strong="H4191"\w*, \w Jobab|strong="H3103"\w* \w son|strong="H1121"\w* \w of Zerah|strong="H2226"\w* \w from Bozrah|strong="H1224"\w* \w reigned|strong="H4427"\w* \w in his place|strong="H8478"\w*.
\b 
\li1 \v 45 \w When Jobab|strong="H3103"\w* \w died|strong="H4191"\w*, \w Husham|strong="H2367"\w* \w from the land|strong="H776"\w* \w of the Temanites|strong="H8489"\w* \w reigned|strong="H4427"\w* \w in his place|strong="H8478"\w*.
\b 
\li1 \v 46 \w When Husham|strong="H2367"\w* \w died|strong="H4191"\w*, \w Hadad|strong="H1908"\w* \w son|strong="H1121"\w* \w of Bedad|strong="H911"\w*, \w who defeated|strong="H5221"\w* \w Midian|strong="H4080"\w* \w in the country|strong="H7704"\w* \w of Moab|strong="H4124"\w*, \w reigned|strong="H4427"\w* \w in his place|strong="H8478"\w*. \w And the name|strong="H8034"\w* \w of his city|strong="H5892"\w* \w was Avith|strong="H5762"\w*.
\b 
\li1 \v 47 \w When Hadad|strong="H1908"\w* \w died|strong="H4191"\w*, \w Samlah|strong="H8072"\w* \w from Masrekah|strong="H4957"\w* \w reigned|strong="H4427"\w* \w in his place|strong="H8478"\w*.
\b 
\li1 \v 48 \w When Samlah|strong="H8072"\w* \w died|strong="H4191"\w*, \w Shaul|strong="H7586"\w* \w from Rehoboth|strong="H7344"\w* \w on the Euphrates|strong="H5104"\w*\f + \fr 1:48 \ft Hebrew \fqa the River\f* \w reigned|strong="H4427"\w* \w in his place|strong="H8478"\w*.
\b 
\li1 \v 49 \w When Shaul|strong="H7586"\w* \w died|strong="H4191"\w*, \w Baal-hanan|strong="H1177"\w* \w son|strong="H1121"\w* \w of Achbor|strong="H5907"\w* \w reigned|strong="H4427"\w* \w in his place|strong="H8478"\w*.
\b 
\li1 \v 50 \w When Baal-hanan|strong="H1177"\w* \w died|strong="H4191"\w*, \w Hadad|strong="H1908"\w* \w reigned|strong="H4427"\w* \w in his place|strong="H8478"\w*. \w His city|strong="H5892"\w* \w was named|strong="H8034"\w* \w Pau|strong="H6464"\w*,\f + \fr 1:50 \ft Many MT manuscripts, some LXX manuscripts, Vulgate, and Syriac (see also \ref Genesis 36:39|GEN 36:39\ref*); most MT manuscripts \fqa Pai\f* \w and his wife’s|strong="H802"\w* \w name|strong="H8034"\w* \w was Mehetabel|strong="H4105"\w* \w daughter|strong="H1323"\w* \w of Matred|strong="H4308"\w*, \w the daughter|strong="H1323"\w* \w of Me-zahab|strong="H4314"\w*.
\b 
\li1 \v 51 \w Then Hadad|strong="H1908"\w* \w died|strong="H4191"\w*.
\p \w Now the chiefs|strong="H441"\w* \w of Edom were|strong="H123"\w* \w Timna|strong="H8555"\w*, \w Alvah|strong="H5933"\w*, \w Jetheth|strong="H3509"\w*, \v 52 \w Oholibamah|strong="H173"\w*, \w Elah|strong="H425"\w*, \w Pinon|strong="H6373"\w*, \v 53 \w Kenaz|strong="H7073"\w*, \w Teman|strong="H8487"\w*, \w Mibzar|strong="H4014"\w*, \v 54 \w Magdiel|strong="H4025"\w*, \w and Iram|strong="H5902"\w*. \w These|strong="H428"\w* \w were the chiefs|strong="H441"\w* \w of Edom|strong="H123"\w*.
\c 2
\s1 The Sons of Israel
\r (\ref Genesis 35:21–26|GEN 35:21-26\ref*; \ref Genesis 38:1–30|GEN 38:1-30\ref*)
\p \v 1 \w These were|strong="H428"\w* \w the sons|strong="H1121"\w* \w of Israel|strong="H3478"\w*:
\b 
\li1 \w Reuben|strong="H7205"\w*, \w Simeon|strong="H8095"\w*, \w Levi|strong="H3878"\w*, \w Judah|strong="H3063"\w*, \w Issachar|strong="H3485"\w*, \w Zebulun|strong="H2074"\w*, \v 2 \w Dan|strong="H1835"\w*, \w Joseph|strong="H3130"\w*, \w Benjamin|strong="H1144"\w*, \w Naphtali|strong="H5321"\w*, \w Gad|strong="H1410"\w*, \w and Asher|strong="H836"\w*.
\b 
\li1 \v 3 \w The sons|strong="H1121"\w* \w of Judah|strong="H3063"\w*:
\li2 \w Er|strong="H6147"\w*, \w Onan|strong="H209"\w*, \w and Shelah|strong="H7956"\w*. \w These three|strong="H7969"\w* \w were born|strong="H3205"\w* to him by \w Bath-shua|strong="H7774"\w* \w the Canaanite|strong="H3669"\w*. \w Er|strong="H6147"\w*, \w Judah’s|strong="H3063"\w* \w firstborn|strong="H1060"\w*, \w was|strong="H1961"\w* \w wicked|strong="H7451"\w* \w in the sight|strong="H5869"\w* \w of the LORD|strong="H3068"\w*. \w So the LORD put him to death|strong="H4191"\w*.
\li2 \v 4 \w Tamar|strong="H8559"\w*, \w Judah’s daughter-in-law|strong="H3618"\w*, \w bore|strong="H3205"\w* to him \w Perez|strong="H6557"\w* \w and Zerah|strong="H2226"\w*. \w Judah|strong="H3063"\w* \w had five|strong="H2568"\w* \w sons|strong="H1121"\w* \w in all|strong="H3605"\w*.
\b 
\li1 \v 5 \w The sons|strong="H1121"\w* \w of Perez|strong="H6557"\w*:
\li2 \w Hezron|strong="H2696"\w* \w and Hamul|strong="H2538"\w*.
\b 
\li1 \v 6 \w The sons|strong="H1121"\w* \w of Zerah|strong="H2226"\w*:
\li2 \w Zimri|strong="H2174"\w*,\f + \fr 2:6 \fqa Zimri \ft is a variant of \fqa Zabdi\ft ; see \ref Joshua 7:1|JOS 7:1\ref*.\f* \w Ethan|strong="H387"\w*, \w Heman|strong="H1968"\w*, \w Calcol|strong="H3633"\w*, \w and Dara|strong="H1873"\w*\f + \fr 2:6 \ft Most Hebrew manuscripts; many Hebrew manuscripts, some LXX manuscripts, and Syriac (see also \ref 1 Kings 4:31|1KI 4:31\ref*) \fqa Darda\f*— \w five|strong="H2568"\w* \w in all|strong="H3605"\w*.
\b 
\li1 \v 7 \w The son|strong="H1121"\w*\f + \fr 2:7 \ft Hebrew \fqa sons\f* \w of Carmi|strong="H3756"\w*:
\li2 \w Achar|strong="H5917"\w*,\f + \fr 2:7 \fqa Achar \ft means \fqa troubler\ft ; also called \fqa Achan \ft in Joshua 7 and Joshua 22.\f* \w who brought trouble|strong="H5916"\w* \w upon Israel|strong="H3478"\w* \w by violating|strong="H4603"\w* \w the ban on devoted things|strong="H2764"\w*.
\b 
\li1 \v 8 \w The son|strong="H1121"\w* \w of Ethan|strong="H387"\w*:
\li2 \w Azariah|strong="H5838"\w*.
\b 
\li1 \v 9 \w The sons|strong="H1121"\w* \w who|strong="H834"\w* \w were born|strong="H3205"\w* \w to Hezron|strong="H2696"\w*:
\li2 \w Jerahmeel|strong="H3396"\w*, \w Ram|strong="H7410"\w*, \w and Caleb|strong="H3621"\w*.\f + \fr 2:9 \ft Hebrew \fqa Chelubai\ft , a variant of \fqa Caleb\ft ; see verse 18.\f*
\b 
\li1 \v 10 \w Ram|strong="H7410"\w* \w was the father of|strong="H3205"\w* \w Amminadab|strong="H5992"\w*, \w and Amminadab|strong="H5992"\w* \w was the father of|strong="H3205"\w* \w Nahshon|strong="H5177"\w*, \w a leader|strong="H5387"\w* \w of the descendants|strong="H1121"\w* \w of Judah|strong="H3063"\w*.
\b 
