\p \v 5 \w And David|strong="H1732"\w* \w said|strong="H559"\w*, “\w My son|strong="H1121"\w* \w Solomon|strong="H8010"\w* \w is young|strong="H5288"\w* \w and inexperienced|strong="H7390"\w*, \w and the house|strong="H1004"\w* \w to be built|strong="H1129"\w* \w for the LORD|strong="H3068"\w* \w must be exceedingly|strong="H4605"\w* \w magnificent|strong="H1431"\w* — \w famous|strong="H8034"\w* \w and glorious|strong="H8597"\w* \w throughout all|strong="H3605"\w* \w lands|strong="H776"\w*. \w Therefore|strong="H4994"\w* \w I must make preparations|strong="H3559"\w* for it.” \w So David|strong="H1732"\w* \w made lavish|strong="H7230"\w* \w preparations|strong="H3559"\w* \w before|strong="H6440"\w* \w his death|strong="H4194"\w*.
\s1 Solomon Anointed to Build the Temple
\p \v 6 \w Then David called for|strong="H7121"\w* \w his son|strong="H1121"\w* \w Solomon|strong="H8010"\w* \w and instructed him|strong="H6680"\w* \w to build|strong="H1129"\w* \w a house|strong="H1004"\w* \w for the LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*.
\p \v 7 “\w My son|strong="H1121"\w*,” \w said|strong="H559"\w* \w David|strong="H1732"\w* \w to Solomon|strong="H8010"\w*, “\w it was|strong="H1961"\w* \w in|strong="H5973"\w* \w my heart|strong="H3824"\w* \w to build|strong="H1129"\w* \w a house|strong="H1004"\w* \w for the Name|strong="H8034"\w* \w of the LORD|strong="H3068"\w* \w my God|strong="H430"\w*, \v 8 \w but this word|strong="H1697"\w* \w of the LORD|strong="H3068"\w* \w came|strong="H1961"\w* \w to me|strong="H5921"\w*: ‘\w You have shed|strong="H8210"\w* \w much|strong="H7230"\w* \w blood|strong="H1818"\w* \w and waged|strong="H6213"\w* \w great|strong="H1419"\w* \w wars|strong="H4421"\w*. \w You are not|strong="H3808"\w* \w to build|strong="H1129"\w* \w a house|strong="H1004"\w* \w for My Name|strong="H8034"\w* \w because|strong="H3588"\w* \w you have shed|strong="H8210"\w* \w so much|strong="H7227"\w* \w blood|strong="H1818"\w* \w on the ground|strong="H776"\w* \w before Me|strong="H6440"\w*. \v 9 \w But|strong="H2009"\w* \w a son|strong="H1121"\w* \w will be born|strong="H3205"\w* to you \w who|strong="H1931"\w* \w will be|strong="H1961"\w* \w a man|strong="H376"\w* \w of rest|strong="H4496"\w*. \w I will give him rest|strong="H5117"\w* \w from all|strong="H3605"\w* \w his enemies|strong="H341"\w* \w on every side|strong="H5439"\w*; \w for|strong="H3588"\w* \w his name|strong="H8034"\w* \w will be|strong="H1961"\w* \w Solomon|strong="H8010"\w*,\f + \fr 22:9 \fqa Solomon \ft sounds like and is probably derived from the Hebrew word for \fqa peace\ft .\f* \w and I will grant|strong="H5414"\w* \w to|strong="H5921"\w* \w Israel|strong="H3478"\w* \w peace|strong="H7965"\w* \w and quiet|strong="H8253"\w* \w during his reign|strong="H3117"\w*. \v 10 \w He|strong="H1931"\w* \w is the one who will build|strong="H1129"\w* \w a house|strong="H1004"\w* \w for My Name|strong="H8034"\w*. \w He|strong="H1931"\w* \w will be|strong="H1961"\w* My \w son|strong="H1121"\w*, \w and I will be|strong="H589"\w* his \w Fathe