\li2 \w Shallum|strong="H7967"\w* \w was their chief|strong="H7218"\w*; \v 18 \w he was previously stationed at the King’s|strong="H4428"\w* \w Gate|strong="H8179"\w* \w on the east side|strong="H4217"\w*. \w These|strong="H1992"\w* \w were the gatekeepers|strong="H7778"\w* \w from the camp|strong="H4264"\w* \w of the Levites|strong="H1121"\w*. \v 19 \w Shallum|strong="H7967"\w* \w son|strong="H1121"\w* \w of Kore|strong="H6981"\w*, \w the son|strong="H1121"\w* \w of Ebiasaph|strong="H43"\w*,\f + \fr 9:19 \fqa Ebiasaph \ft is a variant of \fqa Abiasaph\ft ; see \ref Exodus 6:24|EXO 6:24\ref*.\f* \w the son|strong="H1121"\w* \w of Korah|strong="H7141"\w*, \w and his relatives|strong="H251"\w* \w from the Korahites|strong="H7145"\w* \w were assigned to guard|strong="H8104"\w* \w the thresholds|strong="H5592"\w* \w of the Tent|strong="H168"\w*, \w just as their fathers|strong="H1"\w* \w had been assigned to|strong="H5921"\w* \w guard|strong="H8104"\w* \w the entrance|strong="H3996"\w* \w to the dwelling|strong="H4264"\w* \w of the LORD|strong="H3068"\w*.
\li2 \v 20 \w In earlier times|strong="H6440"\w* \w Phinehas|strong="H6372"\w* \w son|strong="H1121"\w* \w of Eleazar|strong="H499"\w* \w had been|strong="H1961"\w* \w in charge|strong="H5057"\w* \w of the gatekeepers|strong="H5921"\w*, \w and the LORD|strong="H3068"\w* \w was with him|strong="H5973"\w*.
\li2 \v 21 \w Zechariah|strong="H2148"\w* \w son|strong="H1121"\w* \w of Meshelemiah|strong="H4920"\w* \w was the gatekeeper|strong="H7778"\w* \w at the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*.
\li2 \v 22 \w The number|strong="H3605"\w* \w of those chosen|strong="H1305"\w* \w to be gatekeepers|strong="H7778"\w* \w at the thresholds|strong="H5592"\w* \w was 212|strong="H3967"\w*. \w They|strong="H1992"\w* \w were registered by genealogy|strong="H3187"\w* \w in their villages|strong="H2691"\w*. \w David|strong="H1732"\w* \w and Samuel|strong="H8050"\w* \w the seer|strong="H7203"\w* \w had appointed|strong="H3245"\w* \w them|strong="H1992"\w* \w to their positions of trust|strong="H530"\w*.
\p \v 23 \w So they|strong="H1992"\w* \w and their descendants|strong="H1121"\w* \w were assigned to|strong="H5921"\w* \w guard|strong="H4931"\w* \w the gates|strong="H8179"\w* \w of the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w* — \w the house|strong="H1004"\w* \w called the Tent|strong="H168"\w*. \v 24 \w The gatekeepers|strong="H7778"\w* \w were stationed|strong="H1961"\w* \w on the four|strong="H702"\w* \w sides|strong="H7307"\w*: \w east|strong="H4217"\w*, \w west|strong="H3220"\w*, \w north|strong="H6828"\w*, \w and south|strong="H5045"\w*. \v 25 \w Their relatives|strong="H251"\w* \w came|strong="H935"\w* \w from their villages|strong="H2691"\w* \w at fixed times|strong="H6256"\w* \w to serve with|strong="H5973"\w* \w them|strong="H428"\w* \w for seven-day periods|strong="H7651"\w*. \v 26 \w But|strong="H3588"\w* \w the four|strong="H702"\w* \w chief|strong="H1368"\w* \w gatekeepers|strong="H7778"\w*, \w who|strong="H1992"\w* \w were Levites|strong="H3881"\w*, \w were|strong="H1961"\w* \w entrusted with|strong="H5921"\w* \w the rooms|strong="H3957"\w* \w and the treasuries|strong="H214"\w* \w of the house|strong="H1004"\w* \w of God|strong="H430"\w*. \v 27 \w They would spend the night|strong="H3885"\w* \w stationed around|strong="H5439"\w* \w the house|strong="H1004"\w* \w of God|strong="H430"\w*, \w because|strong="H3588"\w* \w they|strong="H5921"\w* \w were responsible for guarding it|strong="H4931"\w* \w and opening it|strong="H4668"\w* \w every morning|strong="H1242"\w*.
\p \v 28 Some of them \w were in charge of|strong="H5921"\w* \w the articles|strong="H3627"\w* \w used in worship|strong="H5656"\w*, \w to|strong="H3588"\w* \w count them|strong="H4557"\w* \w whenever they were brought in|strong="H935"\w* \w or taken out|strong="H3318"\w*. \v 29 \w Others were put|strong="H4487"\w* \w in charge of|strong="H5921"\w* \w the furnishings|strong="H3627"\w* \w and other|strong="H3605"\w* \w articles|strong="H3627"\w* \w of the sanctuary|strong="H6944"\w*, \w as well as the fine flour|strong="H5560"\w*, \w wine|strong="H3196"\w*, \w oil|strong="H8081"\w*, \w frankincense|strong="H3828"\w*, \w and spices|strong="H1314"\w*. \v 30 \w And some|strong="H4480"\w* \w of the sons|strong="H1121"\w* \w of the priests|strong="H3548"\w* \w mixed|strong="H7543"\w* \w the spices|strong="H1314"\w*.
\p \v 31 \w A Levite|strong="H3881"\w* \w named Mattithiah|strong="H4993"\w*, \w the firstborn son|strong="H1060"\w* \w of Shallum|strong="H7967"\w* \w the Korahite|strong="H7145"\w*, \w was entrusted|strong="H530"\w* \w with|strong="H5921"\w* \w baking|strong="H4639"\w* \w the bread|strong="H2281"\w*. \v 32 \w Some of|strong="H4480"\w* \w their Kohathite|strong="H1121"\w* \w relatives|strong="H251"\w* \w were responsible for|strong="H5921"\w* \w preparing|strong="H3559"\w* \w the rows|strong="H4635"\w* \w of the showbread|strong="H3899"\w* \w every Sabbath|strong="H7676"\w*.
\p \v 33 \w Those who were|strong="H428"\w* \w musicians|strong="H7891"\w*, \w the heads|strong="H7218"\w* \w of Levite|strong="H3881"\w* \w families|strong="H1"\w*, \w stayed in the temple chambers|strong="H3957"\w* \w and were exempt|strong="H6359"\w* \w from other duties|strong="H3588"\w* \w because they were|strong="H5921"\w* \w on duty|strong="H4399"\w* \w day|strong="H3119"\w* \w and night|strong="H3915"\w*. \v 34 \w All these|strong="H428"\w* \w were heads|strong="H7218"\w* \w of Levite|strong="H3881"\w* \w families|strong="H1"\w*, \w chiefs|strong="H7218"\w* \w according to their genealogies|strong="H8435"\w*, \w and they lived|strong="H3427"\w* \w in Jerusalem|strong="H3389"\w*.
