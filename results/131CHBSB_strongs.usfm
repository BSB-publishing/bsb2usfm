\s1 From Adam to Abraham
\r (\ref Genesis 5:1–32|GEN 5:1-32\ref*; \ref Genesis 10:1–32|GEN 10:1-32\ref*; \ref Genesis 11:10–26|GEN 11:10-26\ref*)
\p \v 1 \w Adam|strong="H121"\w*, \w Seth|strong="H8352"\w*, \w Enosh|strong="H583"\w*,
\p \v 2 \w Kenan|strong="H7018"\w*, \w Mahalalel|strong="H4111"\w*, \w Jared|strong="H3382"\w*,
\p \v 3 \w Enoch|strong="H2585"\w*, \w Methuselah|strong="H4968"\w*, \w Lamech, Noah|strong="H3929"\w*.
\p \v 4 \w The sons of Noah|strong="H5146"\w*:\f + \fr 1:4 \ft LXX; Hebrew does not include \fqa The sons of Noah:\ft ; see \ref Genesis 5:32|GEN 5:32\ref*.\f*
\b 
\li1 \w Shem|strong="H8035"\w*, \w Ham|strong="H2526"\w*, \w and Japheth|strong="H3315"\w*.
\b 
\li1 \v 5 \w The sons|strong="H1121"\w* \w of Japheth|strong="H3315"\w*:
\li2 \w Gomer|strong="H1586"\w*, \w Magog|strong="H4031"\w*, \w Madai|strong="H4074"\w*, \w Javan|strong="H3120"\w*, \w Tubal|strong="H8422"\w*, \w Meshech|strong="H4902"\w*, \w and Tiras|strong="H8494"\w*.
\li2 \v 6 \w The sons|strong="H1121"\w* \w of Gomer|strong="H1586"\w*: \w Ashkenaz|strong="H813"\w*, \w Riphath|strong="H7384"\w*,\f + \fr 1:6 \ft Many Hebrew manuscripts and Vulgate (see also LXX and \ref Genesis 10:3|GEN 10:3\ref*); most Hebrew manuscripts \fqa Diphath\f* \w and Togarmah|strong="H8425"\w*.
\li2 \v 7 \w And the sons|strong="H1121"\w* \w of Javan|strong="H3120"\w*: \w Elishah|strong="H473"\w*, \w Tarshish|strong="H8659"\w*, \w the Kittites|strong="H3794"\w*, \w and the Rodanites|strong="H1721"\w*.
\b 
\li1 \v 8 \w The sons|strong="H1121"\w* \w of Ham|strong="H2526"\w*:
\li2 \w Cush|strong="H3568"\w*, \w Mizraim|strong="H4714"\w*, \w Put|strong="H6316"\w*, \w and Canaan|strong="H3667"\w*.
\li2 \v 9 \w The sons|strong="H1121"\w* \w of Cush|strong="H3568"\w*: \w Seba|strong="H5434"\w*, \w Havilah|strong="H2341"\w*, \w Sabta|strong="H5454"\w*,\f + \fr 1:9 \fqa Sabta \ft is a variant of \fqa Sabtah\ft ; see \ref Genesis 10:7|GEN 10:7\ref*.\f* \w Raamah|strong="H7484"\w*, \w and Sabteca|strong="H5455"\w*.
\li2 \w The sons|strong="H1121"\w* \w of Raamah|strong="H7484"\w*: \w Sheba|strong="H7614"\w* \w and Dedan|strong="H1719"\w*.
\li2 \v 10 \w Cush|strong="H3568"\w* \w was the father of|strong="H3205"\w* \w Nimrod|strong="H5248"\w*, \w who|strong="H1931"\w* \w began|strong="H2490"\w* \w to be|strong="H1961"\w* \w a mighty one|strong="H1368"\w*\f + \fr 1:10 \ft Or \fqa who established himself as a mighty warrior\f* \w on the earth|strong="H776"\w*.
\li2 \v 11 \w Mizraim|strong="H4714"\w* \w was the father of|strong="H3205"\w* \w the Ludites|strong="H3866"\w*, \w the Anamites|strong="H6047"\w*, \w the Lehabites|strong="H3853"\w*, \w the Naphtuhites|strong="H5320"\w*, \v 12 \w the Pathrusites|strong="H6625"\w*, \w the Casluhites|strong="H3695"\w* (\w from whom|strong="H834"\w* \w the Philistines|strong="H6430"\w* \w came|strong="H3318"\w*), \w and the Caphtorites|strong="H3732"\w*.\f + \fr 1:12 \ft Some translators adjust the Hebrew word order to \fqa the Casluhites, and the Caphtorites (from whom the Philistines came)\ft ; see also \ref Jeremiah 47:4|JER 47:4\ref* and Amos 9:7.\f*
\li2 \v 13 \w And Canaan|strong="H3667"\w* \w was the father of|strong="H3205"\w* \w Sidon|strong="H6721"\w* \w his firstborn|strong="H1060"\w*,\f + \fr 1:13 \ft Or \fqa of the Sidonians, the foremost\f* \w and|strong="H853"\w* \w of the Hittites|strong="H2845"\w*,\f + \fr 1:13 \ft Hebrew \fqa and of Heth\f* \v 14 \w the Jebusites|strong="H2983"\w*, \w the Amorites|strong="H567"\w*, \w the Girgashites|strong="H1622"\w*, \v 15 \w the Hivites|strong="H2340"\w*, \w the Arkites|strong="H6208"\w*, \w the Sinites|strong="H5513"\w*, \v 16 \w the Arvadites|strong="H721"\w*, \w the Zemarites|strong="H6786"\w*, \w and the Hamathites|strong="H2577"\w*.
\b 
\li1 \v 17 \w The sons|strong="H1121"\w* \w of Shem|strong="H8035"\w*:
\li2 \w Elam|strong="H5867"\w*, \w Asshur|strong="H804"\w*, \w Arphaxad|strong="H775"\w*, \w Lud|strong="H3865"\w*, \w and Aram.|strong="H758"\w*
\li2 \w The sons of Aram:|strong="H758"\w*\f + \fr 1:17 \ft One Hebrew manuscript and some LXX manuscripts (see also \ref Genesis 10:23|GEN 10:23\ref*); most Hebrew manuscripts do not include \fqa The sons of Aram\ft .\f* \w Uz|strong="H5780"\w*, \w Hul|strong="H2343"\w*, \w Gether|strong="H1666"\w*, \w and Meshech|strong="H4902"\w*.\f + \fr 1:17 \fqa Meshech \ft is a variant of \fqa Mash\ft ; see \ref Genesis 10:23|GEN 10:23\ref*.\f*
\li2 \v 18 \w Arphaxad|strong="H775"\w* \w was the father of|strong="H3205"\w* \w Shelah|strong="H7974"\w*, \w and Shelah|strong="H7974"\w* \w was the father of|strong="H3205"\w* \w Eber|strong="H5677"\w*.
\li2 \v 19 \w Two|strong="H8147"\w* \w sons|strong="H1121"\w* \w were born|strong="H3205"\w* \w to Eber|strong="H5677"\w*: \w One|strong="H259"\w* \w was named|strong="H8034"\w* \w Peleg|strong="H6389"\w*,\f + \fr 1:19 \fqa Peleg \ft means \fqa division\ft .\f* \w because|strong="H3588"\w* \w in his days|strong="H3117"\w* \w the earth|strong="H776"\w* \w was divided|strong="H6385"\w*, \w and his brother|strong="H251"\w* \w was named|strong="H8034"\w* \w Joktan|strong="H3355"\w*.
\li2 \v 20 \w And Joktan|strong="H3355"\w* \w was the father of|strong="H3205"\w* \w Almodad|strong="H486"\w*, \w Sheleph|strong="H8026"\w*, \w Hazarmaveth|strong="H2700"\w*, \w Jerah|strong="H3392"\w*, \v 21 \w Hadoram|strong="H1913"\w*, \w Uzal|strong="H187"\w*, \w Diklah|strong="H1853"\w*, \v 22 \w Obal|strong="H5858"\w*,\f + \fr 1:22 \ft LXX and Syriac (see also \ref Genesis 10:28|GEN 10:28\ref*); Hebrew \fqa Ebal\f* \w Abimael|strong="H39"\w*, \w Sheba|strong="H7614"\w*, \v 23 \w Ophir|strong="H211"\w*, \w Havilah|strong="H2341"\w*, \w and Jobab|strong="H3103"\w*. \w All|strong="H3605"\w* \w these|strong="H428"\w* \w were sons|strong="H1121"\w* \w of Joktan|strong="H3355"\w*.
\li2 \v 24 \w So from Shem came|strong="H8035"\w* \w Arphaxad|strong="H775"\w*, \w Shelah|strong="H7974"\w*,\f + \fr 1:24 \ft Literally \fqa Shem, Arphaxad, Shelah\ft ; some LXX manuscripts \fqa Shem, Arphaxad, Cainan, Shelah\ft ; see also \ref Genesis 10:24|GEN 10:24\ref* LXX and Luke 3:35–36.\f* \v 25 \w Eber|strong="H5677"\w*, \w Peleg|strong="H6389"\w*, \w Reu|strong="H7466"\w*, \v 26 \w Serug|strong="H8286"\w*, \w Nahor|strong="H5152"\w*, \w Terah|strong="H8646"\w*, \v 27 \w and Abram|strong="H87"\w* \w (that is|strong="H1931"\w*, \w Abraham|strong="H85"\w*).
\s1 The Descendants of Abraham
\r (\ref Genesis 25:12–18|GEN 25:12-18\ref*)
\p \v 28 \w The sons|strong="H1121"\w* \w of Abraham|strong="H85"\w* \w were Isaac|strong="H3327"\w* \w and Ishmael|strong="H3458"\w*. \v 29 \w These are|strong="H428"\w* \w their genealogies|strong="H8435"\w*:
\b 
\li1 \w Nebaioth|strong="H5032"\w* \w the firstborn|strong="H1060"\w* \w of Ishmael|strong="H3458"\w*, \w then Kedar|strong="H6938"\w*, \w Adbeel|strong="H110"\w*, \w Mibsam|strong="H4017"\w*, \v 30 \w Mishma|strong="H4927"\w*, \w Dumah|strong="H1746"\w*, \w Massa|strong="H4854"\w*, \w Hadad|strong="H2301"\w*, \w Tema|strong="H8485"\w*, \v 31 \w Jetur|strong="H3195"\w*, \w Naphish|strong="H5305"\w*, \w and Kedemah|strong="H6929"\w*. \w These|strong="H428"\w* \w were|strong="H1992"\w* \w the sons|strong="H1121"\w* \w of Ishmael|strong="H3458"\w*.
\b 
\li1 \v 32 \w The sons|strong="H1121"\w* \w born|strong="H3205"\w* \w to Keturah|strong="H6989"\w*, \w Abraham’s|strong="H85"\w* \w concubine|strong="H6370"\w*:
\li2 \w Zimran|strong="H2175"\w*, \w Jokshan|strong="H3370"\w*, \w Medan|strong="H4091"\w*, \w Midian|strong="H4080"\w*, \w Ishbak|strong="H3435"\w*, \w and Shuah|strong="H7744"\w*.
\b 
\li1 \w The sons|strong="H1121"\w* \w of Jokshan|strong="H3370"\w*:
\li2 \w Sheba|strong="H7614"\w* \w and Dedan|strong="H1719"\w*.
\b 
\li1 \v 33 \w The sons|strong="H1121"\w* \w of Midian|strong="H4080"\w*:
\li2 \w Ephah|strong="H5891"\w*, \w Epher|strong="H6081"\w*, \w Hanoch|strong="H2585"\w*, \w Abida|strong="H28"\w*, \w and Eldaah|strong="H420"\w*.
\li2 \w All|strong="H3605"\w* \w of these|strong="H428"\w* \w were Keturah’s|strong="H6989"\w* \w sons|strong="H1121"\w*.
\b 
\li1 \v 34 \w Abraham|strong="H85"\w* \w was the father of|strong="H3205"\w* \w Isaac|strong="H3327"\w*. \w The sons|strong="H1121"\w* \w of Isaac|strong="H3327"\w*:
\li2 \w Esau|strong="H6215"\w* \w and Israel|strong="H3478"\w*.
\s1 The Descendants of Esau
\r (\ref Genesis 36:1–19|GEN 36:1-19\ref*)
\li1 \v 35 \w The sons|strong="H1121"\w* \w of Esau|strong="H6215"\w*:
\li2 \w Eliphaz|strong="H464"\w*, \w Reuel|strong="H7467"\w*, \w Jeush|strong="H3266"\w*, \w Jalam|strong="H3281"\w*, \w and Korah|strong="H7141"\w*.
\li2 \v 36 \w The sons|strong="H1121"\w* \w of Eliphaz|strong="H464"\w*: \w Teman|strong="H8487"\w*, \w Omar|strong="H201"\w*, \w Zepho|strong="H6825"\w*,\f + \fr 1:36 \ft Many Hebrew manuscripts, some LXX manuscripts, and Syriac (see also \ref Genesis 36:11|GEN 36:11\ref*); most Hebrew manuscripts \fqa Zephi\f* \w Gatam|strong="H1609"\w*, \w and Kenaz|strong="H7073"\w*; \w and by Timna|strong="H8555"\w*, \w Amalek|strong="H6002"\w*.
\li2 \v 37 \w The sons|strong="H1121"\w* \w of Reuel|strong="H7467"\w*: \w Nahath|strong="H5184"\w*, \w Zerah|strong="H2226"\w*, \w Shammah|strong="H8048"\w*, \w and Mizzah|strong="H4199"\w*.
\s1 The Descendants of Seir
\r (\ref Genesis 36:20–30|GEN 36:20-30\ref*)
\li1 \v 38 \w The sons|strong="H1121"\w* \w of Seir|strong="H8165"\w*:
\li2 \w Lotan|strong="H3877"\w*, \w Shobal|strong="H7732"\w*, \w Zibeon|strong="H6649"\w*, \w Anah|strong="H6034"\w*, \w Dishon|strong="H1787"\w*, \w Ezer|strong="H687"\w*, \w and Dishan|strong="H1789"\w*.
\li2 \v 39 \w The sons|strong="H1121"\w* \w of Lotan|strong="H3877"\w*: \w Hori|strong="H2753"\w* \w and Homam|strong="H1950"\w*.\f + \fr 1:39 \fqa Homam \ft is a variant of \fqa Hemam\ft ; see \ref Genesis 36:22|GEN 36:22\ref*.\f* \w Timna|strong="H8555"\w* \w was Lotan’s|strong="H3877"\w* \w sister|strong="H269"\w*.
\li2 \v 40 \w The sons|strong="H1121"\w* \w of Shobal|strong="H7732"\w*: \w Alvan|strong="H5935"\w*,\f + \fr 1:40 \ft LXX (see also \ref Genesis 36:23|GEN 36:23\ref*); Hebrew \fqa Alian \f* \w Manahath|strong="H4506"\w*, \w Ebal|strong="H5858"\w*, \w Shepho|strong="H8195"\w*,\f + \fr 1:40 \ft LXX (see also \ref Genesis 36:23|GEN 36:23\ref*); Hebrew \fqa Shephi\f* \w and Onam|strong="H208"\w*.
\li2 \w The sons|strong="H1121"\w* \w of Zibeon|strong="H6649"\w*: \w Aiah|strong="H345"\w* \w and Anah|strong="H6034"\w*.
