\p \v 24 \w Then David|strong="H1732"\w* \w went|strong="H935"\w* \w to Mahanaim|strong="H4266"\w*, \w and Absalom|strong="H53"\w* \w crossed|strong="H5674"\w* \w the Jordan|strong="H3383"\w* \w with|strong="H5973"\w* \w all|strong="H3605"\w* \w the men|strong="H376"\w* \w of Israel|strong="H3478"\w*. \v 25 \w Absalom|strong="H53"\w* \w had appointed|strong="H7760"\w* \w Amasa|strong="H6021"\w* \w over|strong="H5921"\w* \w the army|strong="H6635"\w* \w in place|strong="H8478"\w* \w of Joab|strong="H3097"\w*. \w Amasa|strong="H6021"\w* \w was the son|strong="H1121"\w* \w of a man|strong="H376"\w* \w named|strong="H8034"\w* \w Ithra|strong="H3501"\w*,\f + \fr 17:25 \fqa Ithra \ft is a variant of \fqa Jether\ft ; see \ref 1 Kings 2:5|1KI 2:5\ref*.\f* \w the Ishmaelite|strong="H3481"\w*\f + \fr 17:25 \ft Some LXX manuscripts (see also \ref 1 Chronicles 2:17|1CH 2:17\ref*); MT and other LXX manuscripts \fqa Israelite\f* \w who|strong="H834"\w* \w had married|strong="H935"\w* \w Abigail|strong="H26"\w*,\f + \fr 17:25 \ft Or \fqa Abigal\ft , a variant of \fqa Abigail\f* \w the daughter|strong="H1323"\w* \w of Nahash|strong="H5176"\w*\f + \fr 17:25 \ft Or \fqa of Jesse\ft ; see DSS and \ref 1 Chronicles 2:13–16|1CH 2:13-16\ref*\f* \w and sister|strong="H269"\w* \w of Zeruiah|strong="H6870"\w* \w the mother|strong="H517"\w* \w of Joab|strong="H3097"\w*. \v 26 \w So the Israelites|strong="H3478"\w* \w and Absalom|strong="H53"\w* \w camped|strong="H2583"\w* \w in the land|strong="H776"\w* \w of Gilead|strong="H1568"\w*.
\p \v 27 \w When David|strong="H1732"\w* \w came|strong="H935"\w* \w to Mahanaim|strong="H4266"\w*, \w he was met by Shobi|strong="H7629"\w* \w son|strong="H1121"\w* \w of Nahash|strong="H5176"\w* \w from Rabbah|strong="H7237"\w* \w of the Ammonites|strong="H1121"\w*, \w Machir|strong="H4353"\w* \w son|strong="H1121"\w* \w of Ammiel|strong="H5988"\w* \w from Lo-debar|strong="H3810"\w*, \w and Barzillai|strong="H1271"\w* \w the Gileadite|strong="H1569"\w* \w from Rogelim|strong="H7274"\w*. \v 28 \w They brought beds|strong="H4904"\w*, \w basins|strong="H5592"\w*, \w and earthen|strong="H3335"\w* \w vessels|strong="H3627"\w*, \w as well as wheat|strong="H2406"\w*, \w barley|strong="H8184"\w*, \w flour|strong="H7058"\w*, \w roasted grain|strong="H7039"\w*, \w beans|strong="H6321"\w*, \w lentils|strong="H5742"\w*,\f + \fr 17:28 \ft Most LXX manuscripts and Syriac; Hebrew includes \fqa roasted seeds\ft .\f* \v 29 \w honey|strong="H1706"\w*, \w curds|strong="H2529"\w*, \w sheep|strong="H6629"\w*, \w and cheese|strong="H8194"\w* \w from the herd|strong="H1241"\w* \w for David|strong="H1732"\w* \w and his people|strong="H5971"\w* \w to eat|strong="H398"\w*. \w For|strong="H3588"\w* \w they said|strong="H559"\w*, “\w The people|strong="H5971"\w* \w have become hungry|strong="H7457"\w*, \w exhausted|strong="H5889"\w*, \w and thirsty|strong="H6771"\w* \w in the wilderness|strong="H4057"\w*.”
\c 18
\s1 Absalom Killed
\p \v 1 \w Then David|strong="H1732"\w* \w reviewed|strong="H6485"\w* \w his troops|strong="H5971"\w* \w and appointed|strong="H7760"\w* \w over them|strong="H5921"\w* \w commanders|strong="H8269"\w* \w of thousands|strong="H505"\w* \w and of hundreds|strong="H3967"\w*. \v 2 \w He|strong="H1732"\w* \w sent out|strong="H7971"\w* \w the troops|strong="H5971"\w*, \w a third|strong="H7992"\w* \w under Joab|strong="H3097"\w*, \w a third|strong="H7992"\w* \w under Joab’s|strong="H3097"\w* \w brother|strong="H251"\w* \w Abishai|strong="H52"\w* \w son|strong="H1121"\w* \w of Zeruiah|strong="H6870"\w*, \w and a third|strong="H7992"\w* \w under Ittai|strong="H863"\w* \w the Gittite|strong="H1663"\w*. \w And the king|strong="H4428"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w the troops|strong="H5971"\w*, “\w I|strong="H589"\w* \w will surely march out|strong="H3318"\w* \w with you|strong="H5973"\w* \w as well|strong="H1571"\w*.”
\p \v 3 \w But the people|strong="H5971"\w* \w pleaded|strong="H559"\w*, “\w You must not|strong="H3808"\w* \w go out|strong="H3318"\w*! \w For|strong="H3588"\w* \w if|strong="H518"\w* \w we have to flee|strong="H5127"\w*, \w they will not care|strong="H7760"\w* \w about us|strong="H413"\w*. \w Even if|strong="H518"\w* \w half of us|strong="H2677"\w* \w die|strong="H4191"\w*, \w they will not|strong="H3808"\w* \w care|strong="H7760"\w*. \w But|strong="H3588"\w* \w you are worth|strong="H3644"\w* \w ten|strong="H6235"\w* \w thousand of us|strong="H505"\w*.\f + \fr 18:3 \ft Two Hebrew manuscripts, some LXX manuscripts, and Vulgate; most Hebrew manuscripts \fqa care; for now there are ten thousand like us\f* \w It is better|strong="H2896"\w* \w now|strong="H6258"\w* \w if|strong="H3588"\w* \w you|strong="H1961"\w* \w support|strong="H5826"\w* us \w from the city|strong="H5892"\w*.”
\p \v 4 “\w I will do|strong="H6213"\w* \w whatever|strong="H834"\w* \w seems best|strong="H3190"\w* \w to you|strong="H5869"\w*,” \w the king|strong="H4428"\w* \w replied|strong="H559"\w*. \w So he|strong="H4428"\w* \w stood|strong="H5975"\w* \w beside|strong="H413"\w* \w the gate|strong="H8179"\w*, \w while all|strong="H3605"\w* \w the troops|strong="H5971"\w* \w marched out|strong="H3318"\w* \w by hundreds|strong="H3967"\w* \w and by thousands|strong="H505"\w*.
\p \v 5 \w Now the king|strong="H4428"\w* \w had commanded|strong="H6680"\w* \w Joab|strong="H3097"\w*, \w Abishai|strong="H52"\w*, \w and Ittai|strong="H863"\w*, “\w Treat the young man|strong="H5288"\w* \w Absalom|strong="H53"\w* \w gently|strong="H328"\w* for my sake.” \w And all|strong="H3605"\w* \w the people|strong="H5971"\w* \w heard|strong="H8085"\w* \w the king’s|strong="H4428"\w* \w orders|strong="H6680"\w* \w to each|strong="H3605"\w* \w of the commanders|strong="H8269"\w* \w regarding|strong="H5921"\w* \w Absalom|strong="H53"\w*.
\p \v 6 \w So David’s army|strong="H5971"\w* \w marched|strong="H3318"\w* \w into the field|strong="H7704"\w* \w to engage|strong="H7122"\w* \w Israel|strong="H3478"\w*, \w and the battle|strong="H4421"\w* \w took place|strong="H1961"\w* \w in the forest|strong="H3293"\w* \w of Ephraim|strong="H669"\w*. \v 7 \w There|strong="H8033"\w* \w the people|strong="H5971"\w* \w of Israel|strong="H3478"\w* \w were defeated|strong="H5062"\w* \w by|strong="H6440"\w* \w David’s|strong="H1732"\w* \w servants|strong="H5650"\w*, \w and the slaughter|strong="H4046"\w* \w was|strong="H1961"\w* \w great|strong="H1419"\w* \w that|strong="H1931"\w* \w day|strong="H3117"\w*— \w twenty|strong="H6242"\w* \w thousand men|strong="H505"\w*. \v 8 \w The battle|strong="H4421"\w* \w spread|strong="H6327"\w* \w over|strong="H5921"\w* \w the whole|strong="H3605"\w* \w countryside|strong="H776"\w*, \w and that|strong="H1931"\w* \w day|strong="H3117"\w* \w the forest|strong="H3293"\w* \w devoured|strong="H398"\w* \w more|strong="H7235"\w* \w people|strong="H5971"\w* \w than|strong="H834"\w* \w the sword|strong="H2719"\w*.
\p \v 9 \w Now Absalom|strong="H53"\w* \w was riding|strong="H7392"\w* \w on|strong="H5921"\w* \w his mule|strong="H6505"\w* \w when he|strong="H53"\w* \w met|strong="H7122"\w* \w the servants|strong="H5650"\w* \w of David|strong="H1732"\w*, \w and as the mule|strong="H6505"\w* \w went|strong="H935"\w* \w under|strong="H8478"\w* \w the thick branches|strong="H7730"\w* \w of a large|strong="H1419"\w* \w oak|strong="H424"\w*,\f + \fr 18:9 \ft Or \fqa large terebinth \ft or \fqa very great tree\ft ; similarly in verses 10 and 14\f* \w Absalom’s head|strong="H7218"\w* \w was caught fast|strong="H2388"\w* \w in the tree|strong="H424"\w*. \w The mule|strong="H6505"\w* \w under him|strong="H8478"\w* \w kept going|strong="H5674"\w*, \w so that he was suspended|strong="H5414"\w* \w in midair|strong="H996"\w*. \v 10 \w When one|strong="H259"\w* \w of the men|strong="H376"\w* \w saw this|strong="H7200"\w*, \w he told|strong="H5046"\w* \w Joab|strong="H3097"\w*, “\w I just|strong="H2009"\w* \w saw|strong="H7200"\w* \w Absalom|strong="H53"\w* \w hanging|strong="H8518"\w* \w in an oak tree|strong="H424"\w*!”
\p \v 11 “\w You just|strong="H2009"\w* \w saw him|strong="H7200"\w*!” \w Joab|strong="H3097"\w* \w exclaimed|strong="H559"\w*. “\w Why|strong="H4069"\w* \w did you not|strong="H3808"\w* \w strike him|strong="H5221"\w* \w to the ground|strong="H776"\w* \w right there|strong="H8033"\w*? \w I would have given|strong="H5414"\w* you \w ten shekels|strong="H6235"\w* \w of silver|strong="H3701"\w*\f + \fr 18:11 \fqa 10 shekels \ft is approximately 4 ounces or 114 grams of silver.\f* \w and a|strong="H259"\w* \w warrior’s belt|strong="H2290"\w*!”
\p \v 12 \w The man|strong="H376"\w* \w replied|strong="H559"\w*, “\w Even if|strong="H3863"\w* \w a thousand shekels|strong="H505"\w* \w of silver|strong="H3701"\w*\f + \fr 18:12 \fqa 1,000 shekels \ft is approximately 25.1 pounds or 11.4 kilograms of silver.\f* \w were weighed out|strong="H8254"\w* \w into|strong="H5921"\w* \w my hands|strong="H3709"\w*, \w I would not|strong="H3808"\w* \w raise|strong="H7971"\w* \w my hand|strong="H3027"\w* \w against|strong="H413"\w* \w the son|strong="H1121"\w* \w of the king|strong="H4428"\w*. \w For|strong="H3588"\w* \w we heard|strong="H241"\w* \w the king|strong="H4428"\w* \w command you|strong="H6680"\w* \w and Abishai|strong="H52"\w* \w and Ittai|strong="H863"\w*, ‘\w Protect|strong="H8104"\w* \w the young man|strong="H5288"\w* \w Absalom|strong="H53"\w* \w for my sake|strong="H4310"\w*.\f + \fr 18:12 \ft A few Hebrew manuscripts, LXX, Vulgate, and Syriac; most Hebrew manuscripts \fqa Whoever you may be, protect the young man Absalom. \ft or \fqa Let no one touch the young man Absalom.\f*’ \v 13 \w If|strong="H176"\w* \w I had jeopardized|strong="H6213"\w* \w my own life|strong="H5315"\w*\f + \fr 18:13 \ft Or \fqa If I had dealt treacherously against his life\f*— \w and nothing|strong="H3808"\w* \w is hidden|strong="H3582"\w* \w from|strong="H4480"\w* \w the king|strong="H4428"\w*— \w you|strong="H859"\w* \w would have abandoned|strong="H3320"\w* \w me|strong="H5048"\w*.”
\p \v 14 \w But Joab|strong="H3097"\w* \w declared|strong="H559"\w*, “\w I am not|strong="H3808"\w* \w going to wait|strong="H3176"\w* \w like this|strong="H3651"\w* \w with you|strong="H6440"\w*!” \w And he took|strong="H3947"\w* \w three|strong="H7969"\w* \w spears|strong="H7626"\w* \w in his hand|strong="H3709"\w* \w and thrust them|strong="H8628"\w* \w through the heart|strong="H3820"\w* \w of Absalom|strong="H53"\w* \w while he was still|strong="H5750"\w* \w alive|strong="H2416"\w* \w in the oak tree|strong="H424"\w*. \v 15 \w And ten|strong="H6235"\w* \w young men|strong="H5288"\w* \w who carried|strong="H5375"\w* \w Joab’s|strong="H3097"\w* \w armor|strong="H3627"\w* \w surrounded|strong="H5437"\w* \w Absalom|strong="H53"\w*, \w struck|strong="H5221"\w* \w him|strong="H853"\w*, \w and killed him|strong="H4191"\w*.
