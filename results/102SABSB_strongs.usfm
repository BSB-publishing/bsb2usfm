\p \v 22 \w And David|strong="H1732"\w* \w replied|strong="H559"\w*, “\w Sons|strong="H1121"\w* \w of Zeruiah|strong="H6870"\w*, \w what|strong="H4100"\w* have I to do with you, \w that|strong="H3588"\w* \w you should be|strong="H1961"\w* my \w adversaries|strong="H7854"\w* \w today|strong="H3117"\w*? \w Should any man|strong="H376"\w* \w be put to death|strong="H4191"\w* \w in Israel|strong="H3478"\w* \w today|strong="H3117"\w*? \w Am I not|strong="H3808"\w* \w indeed|strong="H3588"\w* \w aware|strong="H3045"\w* \w that|strong="H3588"\w* \w today|strong="H3117"\w* \w I am|strong="H589"\w* \w king|strong="H4428"\w* \w over|strong="H5921"\w* \w Israel|strong="H3478"\w*?”
