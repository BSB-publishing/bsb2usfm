\p \w So Uriah|strong="H223"\w* \w left|strong="H3318"\w* \w the palace|strong="H1004"\w*, \w and a gift|strong="H4864"\w* \w from the king|strong="H4428"\w* \w followed|strong="H3318"\w* \w him|strong="H310"\w*. \v 9 \w But Uriah|strong="H223"\w* \w slept|strong="H7901"\w* \w at the door|strong="H6607"\w* \w of the palace|strong="H1004"\w* \w with|strong="H854"\w* \w all|strong="H3605"\w* \w his master’s|strong="H113"\w* \w servants|strong="H5650"\w*; \w he did not|strong="H3808"\w* \w go down|strong="H3381"\w* \w to|strong="H413"\w* \w his house|strong="H1004"\w*.
