\p \v 11 \w Instead|strong="H3588"\w*, \w I advise|strong="H3289"\w* \w that all|strong="H3605"\w* \w Israel|strong="H3478"\w* \w from Dan|strong="H1835"\w* \w to|strong="H5704"\w* \w Beersheba|strong="H884"\w*— \w a multitude|strong="H7230"\w* \w like the sand|strong="H2344"\w* \w on|strong="H5921"\w* \w the seashore|strong="H3220"\w*— \w be gathered|strong="H622"\w* \w to you|strong="H5921"\w*, \w and that you yourself|strong="H6440"\w* \w lead them|strong="H1980"\w* \w into battle|strong="H7128"\w*. \v 12 \w Then we will attack|strong="H935"\w* \w David|strong="H413"\w* \w wherever|strong="H4725"\w* \w we find him|strong="H4672"\w*, \w and we|strong="H5168"\w* \w will descend|strong="H5307"\w* \w on him|strong="H5921"\w* \w like|strong="H834"\w* \w dew|strong="H2919"\w* \w on|strong="H5921"\w* \w the ground|strong="H127"\w*. \w And of all|strong="H3605"\w* \w the men|strong="H582"\w* \w with him|strong="H854"\w*, \w not|strong="H3808"\w* \w even|strong="H1571"\w* \w one|strong="H259"\w* \w will remain|strong="H3498"\w*.
\p \v 13 \w If|strong="H518"\w* \w he retreats|strong="H622"\w* \w to|strong="H413"\w* \w a city|strong="H5892"\w*, \w all|strong="H3605"\w* \w Israel|strong="H3478"\w* \w will bring|strong="H5375"\w* \w ropes|strong="H2256"\w* \w to|strong="H413"\w* \w that|strong="H1931"\w* \w city|strong="H5892"\w*, \w and we will drag|strong="H5498"\w* \w it|strong="H853"\w* \w down to|strong="H5704"\w* \w the valley|strong="H5158"\w* \w until|strong="H5704"\w* \w not|strong="H3808"\w* \w even|strong="H1571"\w* \w a pebble|strong="H6872"\w* \w can be found|strong="H4672"\w* \w there|strong="H8033"\w*.”
