\p \v 14 \w So he swayed|strong="H5186"\w* \w the hearts|strong="H3824"\w* \w of all|strong="H3605"\w* \w the men|strong="H376"\w* \w of Judah|strong="H3063"\w* \w as though they were one|strong="H259"\w* \w man|strong="H376"\w*, \w and they sent|strong="H7971"\w* \w word to|strong="H413"\w* \w the king|strong="H4428"\w*: “\w Return|strong="H7725"\w*, \w you|strong="H859"\w* \w and all|strong="H3605"\w* \w your servants|strong="H5650"\w*.”
\p \v 15 \w So the king|strong="H4428"\w* \w returned|strong="H7725"\w*, \w and when he arrived|strong="H935"\w* \w at|strong="H5704"\w* \w the Jordan|strong="H3383"\w*, \w the men of Judah|strong="H3063"\w* \w came|strong="H935"\w* \w to Gilgal|strong="H1537"\w* \w to|strong="H1980"\w* \w meet|strong="H7122"\w* \w him|strong="H4428"\w* \w and escort him|strong="H4428"\w* \w across|strong="H5674"\w* \w the Jordan|strong="H3383"\w*.
