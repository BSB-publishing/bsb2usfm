\p \v 28 \w Now Absalom|strong="H53"\w* \w had ordered|strong="H6680"\w* \w his young men|strong="H5288"\w*, “\w Watch|strong="H7200"\w* \w Amnon|strong="H550"\w* \w until|strong="H4994"\w* \w his heart|strong="H3820"\w* \w is merry|strong="H2895"\w* \w with wine|strong="H3196"\w*, \w and when I order|strong="H559"\w* \w you|strong="H413"\w* \w to strike|strong="H5221"\w* \w Amnon down|strong="H550"\w*, \w you are to kill him|strong="H4191"\w*. \w Do not|strong="H408"\w* \w be afraid|strong="H3372"\w*. \w Have|strong="H3588"\w* \w I|strong="H595"\w* \w not|strong="H3808"\w* \w commanded|strong="H6680"\w* \w you|strong="H853"\w*? \w Be courageous|strong="H2388"\w* \w and|strong="H1961"\w* \w valiant|strong="H2428"\w*!”
\p \v 29 \w So Absalom’s|strong="H53"\w* \w young men|strong="H5288"\w* \w did|strong="H6213"\w* \w to Amnon|strong="H550"\w* \w just as|strong="H834"\w* \w Absalom|strong="H53"\w* \w had ordered|strong="H6680"\w*. \w Then all the other|strong="H3605"\w* \w sons|strong="H1121"\w* \w of the king|strong="H4428"\w* \w got up|strong="H6965"\w*, \w and each one|strong="H376"\w* \w fled|strong="H5127"\w* \w on|strong="H5921"\w* \w his mule|strong="H6505"\w*.
