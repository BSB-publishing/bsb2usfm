\p \v 28 \w Then Ahimaaz|strong="H290"\w* \w called out|strong="H7121"\w* \w to|strong="H413"\w* \w the king|strong="H4428"\w*, “\w All is well|strong="H7965"\w*!” \w And he bowed|strong="H7812"\w* \w facedown|strong="H639"\w* \w before the king|strong="H4428"\w*.
\p \w He continued|strong="H559"\w*, “\w Blessed be|strong="H1288"\w* \w the LORD|strong="H3068"\w* \w your God|strong="H430"\w*! \w He has delivered up|strong="H5462"\w* \w the men|strong="H582"\w* \w who|strong="H834"\w* \w raised|strong="H5375"\w* \w their hands|strong="H3027"\w* \w against my lord|strong="H113"\w* \w the king|strong="H4428"\w*.”
