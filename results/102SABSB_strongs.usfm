\p \w As the first runner drew|strong="H1980"\w* \w near|strong="H7131"\w*, \v 26 \w the watchman|strong="H6822"\w* \w saw|strong="H7200"\w* \w another|strong="H312"\w* \w man|strong="H376"\w* \w running|strong="H7323"\w*, \w and he called out|strong="H7121"\w* \w to|strong="H413"\w* \w the gatekeeper|strong="H7778"\w*, “\w Look|strong="H2009"\w*! \w Another man|strong="H376"\w* \w is running alone|strong="H7323"\w*!”
