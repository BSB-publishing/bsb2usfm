\c 14
\s1 Absalom’s Return to Jerusalem
\p \v 1 \w Now Joab|strong="H3097"\w* \w son|strong="H1121"\w* \w of Zeruiah|strong="H6870"\w* \w perceived|strong="H3045"\w* \w that|strong="H3588"\w* \w the king’s|strong="H4428"\w* \w heart|strong="H3820"\w* \w longed for|strong="H5921"\w* \w Absalom|strong="H53"\w*. \v 2 \w So Joab|strong="H3097"\w* \w sent|strong="H7971"\w* \w to Tekoa|strong="H8620"\w* \w to bring|strong="H3947"\w* \w a wise|strong="H2450"\w* \w woman|strong="H802"\w* \w from there|strong="H8033"\w*. \w He told her|strong="H559"\w*, “\w Please|strong="H4994"\w* \w pretend to be a mourner|strong="H56"\w*; \w put on|strong="H3847"\w* \w clothes|strong="H899"\w* \w for mourning|strong="H60"\w* \w and do not|strong="H408"\w* \w anoint yourself|strong="H5480"\w* \w with oil|strong="H8081"\w*. \w Act|strong="H1961"\w* \w like a woman|strong="H802"\w* \w who has mourned|strong="H56"\w* \w for|strong="H5921"\w* \w the dead|strong="H4191"\w* \w a long|strong="H7227"\w* \w time|strong="H3117"\w*. \v 3 \w Then go|strong="H935"\w* \w to|strong="H413"\w* \w the king|strong="H4428"\w* \w and speak|strong="H1696"\w* \w these|strong="H2088"\w* \w words|strong="H1697"\w* \w to him|strong="H413"\w*.” \w And Joab|strong="H3097"\w* \w put|strong="H7760"\w* \w the words|strong="H1697"\w* \w in her mouth|strong="H6310"\w*.
