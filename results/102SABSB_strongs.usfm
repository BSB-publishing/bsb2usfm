\p \v 16 \w Then Shimei|strong="H8096"\w* \w son|strong="H1121"\w* \w of Gera|strong="H1617"\w*, \w a Benjamite|strong="H1145"\w* \w from Bahurim|strong="H980"\w*, \w hurried|strong="H4116"\w* \w down with|strong="H5973"\w* \w the men|strong="H376"\w* \w of Judah|strong="H3063"\w* \w to meet|strong="H7122"\w* \w King|strong="H4428"\w* \w David|strong="H1732"\w*, \v 17 \w along with a thousand|strong="H505"\w* \w men|strong="H376"\w* \w of Benjamin|strong="H1144"\w*, \w as well as Ziba|strong="H6717"\w* \w the steward|strong="H5288"\w* \w of the house|strong="H1004"\w* \w of Saul|strong="H7586"\w* \w and his fifteen|strong="H2568"\w* \w sons|strong="H1121"\w* \w and twenty|strong="H6242"\w* \w servants|strong="H5650"\w*.
