\p \v 12 “\w No|strong="H408"\w*, \w my brother|strong="H251"\w*!” \w she cried|strong="H559"\w*. “\w Do not|strong="H408"\w* \w violate me|strong="H6031"\w*, \w for|strong="H3588"\w* \w such|strong="H3651"\w* \w a thing should never|strong="H3808"\w* \w be done|strong="H6213"\w* \w in Israel|strong="H3478"\w*. \w Do not|strong="H408"\w* \w do|strong="H6213"\w* \w this|strong="H2063"\w* \w disgraceful thing|strong="H5039"\w*! \v 13 \w Where|strong="H575"\w* \w could I|strong="H589"\w* \w ever take|strong="H1980"\w* \w my shame|strong="H2781"\w*? \w And you|strong="H859"\w* \w would be|strong="H1961"\w* \w like one|strong="H259"\w* \w of the fools|strong="H5036"\w* \w in Israel|strong="H3478"\w*! \w Please|strong="H4994"\w* \w speak|strong="H1696"\w* \w to|strong="H413"\w* \w the king|strong="H4428"\w*, \w for|strong="H3588"\w* \w he will not|strong="H3808"\w* \w withhold me|strong="H4513"\w* \w from you|strong="H4480"\w*.”
