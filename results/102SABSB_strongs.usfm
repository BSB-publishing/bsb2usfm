\s1 Joab Murders Abner
\p \v 22 \w Just then|strong="H2009"\w* \w David’s|strong="H1732"\w* \w soldiers|strong="H5650"\w* \w and Joab|strong="H3097"\w* \w returned|strong="H935"\w* \w from a raid|strong="H1416"\w*, \w bringing|strong="H935"\w* \w with them|strong="H5973"\w* \w a great|strong="H7227"\w* \w plunder|strong="H7998"\w*. \w But Abner was|strong="H74"\w* \w not|strong="H369"\w* \w with|strong="H5973"\w* \w David|strong="H1732"\w* \w in Hebron|strong="H2275"\w*, \w because|strong="H3588"\w* \w David had sent him|strong="H7971"\w* \w on his way|strong="H1980"\w* \w in peace|strong="H7965"\w*. \v 23 \w When Joab|strong="H3097"\w* \w and all|strong="H3605"\w* \w his troops|strong="H6635"\w* \w arrived|strong="H935"\w*, \w he|strong="H3097"\w* \w was informed|strong="H5046"\w*, “\w Abner|strong="H74"\w* \w son|strong="H1121"\w* \w of Ner|strong="H5369"\w* \w came|strong="H935"\w* \w to|strong="H413"\w* \w see the king|strong="H4428"\w*, \w who sent him|strong="H7971"\w* \w on his way|strong="H1980"\w* \w in peace|strong="H7965"\w*.”
