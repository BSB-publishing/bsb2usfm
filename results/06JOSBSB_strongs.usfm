\li1 \v 22 \w the king|strong="H4428"\w* \w of Kedesh|strong="H6943"\w*, \w one|strong="H259"\w*;
\li1 \w the king|strong="H4428"\w* \w of Jokneam|strong="H3362"\w* \w in Carmel|strong="H3760"\w*, \w one|strong="H259"\w*;
\li1 \v 23 \w the king|strong="H4428"\w* \w of Dor|strong="H1756"\w* \w in Naphath-dor|strong="H1756"\w*,\f + \fr 12:23 \ft Or \fqa in the heights of Dor\ft ; \fqa Naphath-dor \ft is a variant of \fqa Naphoth-dor\ft ; see \ref Joshua 11:2|JOS 11:2\ref*.\f* \w one|strong="H259"\w*;
\li1 \w the king|strong="H4428"\w* \w of Goiim|strong="H1471"\w* \w in Gilgal|strong="H1537"\w*,\f + \fr 12:23 \ft Hebrew; LXX \fqa Goyim in Galilee\f* \w one|strong="H259"\w*;
