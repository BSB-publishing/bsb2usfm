\li1 \w the king|strong="H4428"\w* \w of Bethel|strong="H1008"\w*, \w one|strong="H259"\w*;
\li1 \v 17 \w the king|strong="H4428"\w* \w of Tappuah|strong="H8599"\w*, \w one|strong="H259"\w*;
\li1 \w the king|strong="H4428"\w* \w of Hepher|strong="H2660"\w*, \w one|strong="H259"\w*;
\li1 \v 18 \w the king|strong="H4428"\w* \w of Aphek|strong="H663"\w*, \w one|strong="H259"\w*;
\li1 \w the king|strong="H4428"\w* \w of Lasharon|strong="H8289"\w*, \w one|strong="H259"\w*;
\li1 \v 19 \w the king|strong="H4428"\w* \w of Madon|strong="H4068"\w*, \w one|strong="H259"\w*;
\li1 \w the king|strong="H4428"\w* \w of Hazor|strong="H2674"\w*, \w one|strong="H259"\w*;
\li1 \v 20 \w the king|strong="H4428"\w* \w of Shimron-meron|strong="H8112"\w*, \w one|strong="H259"\w*;
