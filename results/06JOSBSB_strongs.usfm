head\ft ; similarly in verse 20\f*”
\p \v 6 \w So Joshua|strong="H3091"\w* \w son|strong="H1121"\w* \w of Nun|strong="H5126"\w* \w summoned|strong="H7121"\w* \w the priests|strong="H3548"\w* \w and said|strong="H559"\w*, “\w Take up|strong="H5375"\w* \w the ark|strong="H727"\w* \w of the covenant|strong="H1285"\w* \w and have seven|strong="H7651"\w* \w priests|strong="H3548"\w* \w carry|strong="H5375"\w* \w seven|strong="H7651"\w* \w rams’ horns|strong="H3104"\w* \w in front|strong="H6440"\w* \w of the ark|strong="H727"\w* \w of the LORD|strong="H3068"\w*.”
