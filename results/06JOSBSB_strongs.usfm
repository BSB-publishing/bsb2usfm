\c 23
\s1 Joshua’s Charge to Leaders
\p \v 1 \w A long|strong="H7227"\w* \w time|strong="H3117"\w* \w after|strong="H310"\w* \w the LORD|strong="H3068"\w* \w had given Israel|strong="H3478"\w* \w rest|strong="H5117"\w* \w from all|strong="H3605"\w* \w the enemies|strong="H341"\w* \w around them|strong="H5439"\w*, \w when Joshua|strong="H3091"\w* \w was old|strong="H2204"\w* \w and well along|strong="H935"\w* \w in years|strong="H3117"\w*, \v 2 \w he|strong="H3091"\w* \w summoned|strong="H7121"\w* \w all|strong="H3605"\w* \w Israel|strong="H3478"\w*, \w including its elders|strong="H2205"\w*, \w leaders|strong="H7218"\w*, \w judges|strong="H8199"\w*, \w and officers|strong="H7860"\w*. “\w I|strong="H589"\w* \w am old|strong="H2204"\w* \w and well along|strong="H935"\w* \w in years|strong="H3117"\w*,” \w he said|strong="H559"\w*, \v 3 “\w and you|strong="H859"\w* \w have seen|strong="H7200"\w* \w everything|strong="H3605"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w your God|strong="H430"\w* \w has done|strong="H6213"\w* \w to all|strong="H3605"\w* \w these|strong="H428"\w* \w nations|strong="H1471"\w* \w for your sake|strong="H6440"\w*, \w because|strong="H3588"\w* \w it|strong="H1931"\w* \w was the LORD|strong="H3068"\w* \w your God|strong="H430"\w* \w who fought|strong="H3898"\w* for you.
\p \v 4 \w See|strong="H7200"\w*, \w I have allotted|strong="H5307"\w* \w as an inheritance|strong="H5159"\w* \w to your tribes|strong="H7626"\w* \w these|strong="H428"\w* \w remaining|strong="H7604"\w* \w nations|strong="H1471"\w*, \w including all|strong="H3605"\w* \w the nations|strong="H1471"\w* \w I have already cut off|strong="H3772"\w*, \w from|strong="H4480"\w* \w the Jordan|strong="H3383"\w* \w westward|strong="H3996"\w* \w to the Great Sea|strong="H3220"\w*.\f + \fr 23:4 \ft That is, the Mediterranean Sea\f* \v 5 \w The LORD|strong="H3068"\w* \w your God|strong="H430"\w* \w will push them|strong="H1920"\w* \w out of your way|strong="H6440"\w* \w and drive them out|strong="H3423"\w* \w before you|strong="H853"\w*, \w so that you can take possession of|strong="H3423"\w* \w their land|strong="H776"\w*, \w as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w your God|strong="H430"\w* \w promised|strong="H1696"\w* you.
\p \v 6 \w Be very|strong="H3966"\w* \w strong, then|strong="H2388"\w*, \w so that you can keep|strong="H8104"\w* \w and obey|strong="H6213"\w* \w all|strong="H3605"\w* \w that is written|strong="H3789"\w* \w in the Book|strong="H5612"\w* \w of the Law|strong="H8451"\w* \w of Moses|strong="H4872"\w*, \w not|strong="H1115"\w* \w turning aside|strong="H5493"\w* \w from it|strong="H4480"\w* \w to the right|strong="H3225"\w* \w or to the left|strong="H8040"\w*. \v 7 \w So you are not|strong="H1115"\w* \w to associate|strong="H935"\w* \w with these|strong="H428"\w* \w nations|strong="H1471"\w* \w that remain|strong="H7604"\w* \w among you|strong="H854"\w*. \w You must not|strong="H3808"\w* \w call on|strong="H2142"\w* \w the names|strong="H8034"\w* \w of their gods|strong="H430"\w* \w or|strong="H3808"\w* \w swear by them|strong="H7650"\w*, \w and you must not|strong="H3808"\w* \w serve them|strong="H5647"\w* \w or|strong="H3808"\w* \w bow down|strong="H7812"\w* to them. \v 8 \w Instead|strong="H3588"\w*, \w you shall hold fast|strong="H1692"\w* \w to the LORD|strong="H3068"\w* \w your God|strong="H430"\w*, \w as|strong="H834"\w* \w you have done|strong="H6213"\w* \w to|strong="H5704"\w* \w this|strong="H2088"\w* \w day|strong="H3117"\w*.
\p \v 9 \w The LORD|strong="H3068"\w* \w has driven out|strong="H3423"\w* \w great|strong="H1419"\w* \w and powerful|strong="H6099"\w* \w nations|strong="H1471"\w* \w before you|strong="H6440"\w*, \w and to|strong="H5704"\w* \w this|strong="H2088"\w* \w day|strong="H3117"\w* \w no|strong="H3808"\w* \w one|strong="H376"\w* \w can stand|strong="H5975"\w* \w against you|strong="H6440"\w*. \v 10 \w One|strong="H259"\w* of you \w can put|strong="H7291"\w* \w a thousand to flight|strong="H505"\w*, \w because|strong="H3588"\w* \w the LORD|strong="H3068"\w* \w your God|strong="H430"\w* \w fights|strong="H3898"\w* for you, \w just as|strong="H834"\w* \w He promised|strong="H1696"\w*. \v 11 \w Therefore watch|strong="H8104"\w* \w yourselves|strong="H5315"\w* \w carefully|strong="H3966"\w*, \w that you love|strong="H157"\w* \w the LORD|strong="H3068"\w* \w your God|strong="H430"\w*. \v 12 \w For|strong="H3588"\w* \w if|strong="H518"\w* \w you turn away|strong="H7725"\w* \w and cling|strong="H1692"\w* \w to the rest|strong="H3499"\w* \w of these|strong="H428"\w* \w nations|strong="H1471"\w* \w that remain|strong="H7604"\w* \w among you|strong="H854"\w*, \w and if you intermarry|strong="H2859"\w* \w and associate|strong="H935"\w* \w with them|strong="H1992"\w*, \v 13 \w know for sure|strong="H3045"\w* \w that|strong="H3588"\w* \w the LORD|strong="H3068"\w* \w your God|strong="H430"\w* \w will no|strong="H3808"\w* \w longer|strong="H3254"\w* \w drive out|strong="H3423"\w* \w these|strong="H428"\w* \w nations|strong="H1471"\w* \w before you|strong="H6440"\w*. \w Instead, they will become|strong="H1961"\w* for you \w a snare|strong="H6341"\w* \w and a trap|strong="H4170"\w*, \w a scourge|strong="H7850"\w* \w in your sides|strong="H6654"\w* \w and thorns|strong="H6796"\w* \w in your eyes|strong="H5869"\w*, \w until|strong="H5704"\w* \w you perish|strong="H6"\w* \w from|strong="H5921"\w* \w this|strong="H2063"\w* \w good|strong="H2896"\w* \w land|strong="H127"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w your God|strong="H430"\w* \w has given|strong="H5414"\w* you.
\p \v 14 \w Now behold|strong="H2009"\w*, \w today|strong="H3117"\w* \w I|strong="H595"\w* \w am going|strong="H1980"\w* \w the way|strong="H1870"\w* \w of all|strong="H3605"\w* \w the earth|strong="H776"\w*, \w and you know|strong="H3045"\w* \w with all|strong="H3605"\w* \w your heart|strong="H3824"\w* \w and|strong="H3605"\w* \w soul|strong="H5315"\w* \w that|strong="H3588"\w* \w not|strong="H3808"\w* \w one|strong="H259"\w* \w of the good|strong="H2896"\w* \w promises|strong="H1697"\w* \w the LORD|strong="H3068"\w* \w your God|strong="H430"\w* \w made|strong="H1696"\w* \w to you|strong="H5921"\w* \w has failed|strong="H5307"\w*. \w Everything|strong="H3605"\w* \w was fulfilled|strong="H935"\w* for you; \w not|strong="H3808"\w* \w one|strong="H259"\w* \w promise|strong="H1697"\w* \w has failed|strong="H5307"\w*. \v 15 \w But just as|strong="H834"\w* \w every|strong="H3605"\w* \w good|strong="H2896"\w* \w thing|strong="H1697"\w* \w the LORD|strong="H3068"\w* \w your God|strong="H430"\w* \w promised|strong="H1696"\w* \w you|strong="H413"\w* \w has come to pass|strong="H935"\w*, \w likewise|strong="H3651"\w* \w the LORD|strong="H3068"\w* \w will bring|strong="H935"\w* \w upon you|strong="H5921"\w* \w the calamity He has threatened|strong="H7451"\w*, \w until|strong="H5704"\w* \w He has destroyed|strong="H8045"\w* \w you|strong="H853"\w* \w from|strong="H5921"\w* \w this|strong="H2063"\w* \w good|strong="H2896"\w* \w land|strong="H127"\w* \w He|strong="H3068"\w* \w has given|strong="H5414"\w* you. \v 16 \w If you transgress|strong="H5674"\w* \w the covenant|strong="H1285"\w* \w of the LORD|strong="H3068"\w* \w your God|strong="H430"\w*, \w which|strong="H834"\w* \w He commanded you|strong="H6680"\w*, \w and go|strong="H1980"\w* \w and serve|strong="H5647"\w* \w other|strong="H312"\w* \w gods|strong="H430"\w* \w and bow down|strong="H7812"\w* to them, \w then the anger|strong="H639"\w* \w of the LORD|strong="H3068"\w* \w will burn|strong="H2734"\w* against you, \w and you will quickly|strong="H4120"\w* \w perish|strong="H6"\w* \w from|strong="H5921"\w* \w this good|strong="H2896"\w* \w land|strong="H776"\w* \w He has given|strong="H5414"\w* you.”
\c 24
\s1 Joshua Reviews Israel’s History
\p \v 1 \w Then Joshua|strong="H3091"\w* \w assembled|strong="H622"\w* \w all|strong="H3605"\w* \w the tribes|strong="H7626"\w* \w of Israel|strong="H3478"\w* \w at Shechem|strong="H7927"\w*. \w He summoned|strong="H7121"\w* \w the elders|strong="H2205"\w*, \w leaders|strong="H7218"\w*, \w judges|strong="H8199"\w*, \w and officers|strong="H7860"\w* \w of Israel|strong="H3478"\w*, \w and they presented|strong="H3320"\w* \w themselves before|strong="H6440"\w* \w God|strong="H430"\w*.
\p \v 2 \w And Joshua|strong="H3091"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w all|strong="H3605"\w* \w the people|strong="H5971"\w*, “\w This is what|strong="H3541"\w* \w the LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w says|strong="H559"\w*: ‘\w Long ago|strong="H5769"\w* \w your fathers|strong="H1"\w*, \w including Terah|strong="H8646"\w* \w the father|strong="H1"\w* \w of Abraham|strong="H85"\w* \w and Nahor|strong="H5152"\w*, \w lived|strong="H3427"\w* \w beyond|strong="H5676"\w* \w the Euphrates|strong="H5104"\w*\f + \fr 24:2 \ft Hebrew \fqa the River\ft ; also in verses 3, 14, and 15\f* \w and worshiped|strong="H5647"\w* \w other|strong="H312"\w* \w gods|strong="H430"\w*. \v 3 \w But I took|strong="H3947"\w* \w your father|strong="H1"\w* \w Abraham|strong="H85"\w* \w from beyond|strong="H5676"\w* \w the Euphrates|strong="H5104"\w* \w and led|strong="H1980"\w* \w him|strong="H853"\w* \w through all|strong="H3605"\w* \w the land|strong="H776"\w* \w of Canaan|strong="H3667"\w*, \w and I multiplied|strong="H7235"\w* \w his descendants|strong="H2233"\w*. \w I gave|strong="H5414"\w* him \w Isaac|strong="H3327"\w*, \v 4 \w and to Isaac|strong="H3327"\w* \w I gave|strong="H5414"\w* \w Jacob|strong="H3290"\w* \w and Esau|strong="H6215"\w*. \w I gave|strong="H5414"\w* \w Esau|strong="H6215"\w* \w Mount|strong="H2022"\w* \w Seir|strong="H8165"\w* \w to possess|strong="H3423"\w*, \w but Jacob|strong="H3290"\w* \w and his sons|strong="H1121"\w* \w went down|strong="H3381"\w* \w to Egypt|strong="H4714"\w*.
\p \v 5 \w Then I sent|strong="H7971"\w* \w Moses|strong="H4872"\w* \w and Aaron|strong="H175"\w*, \w and I afflicted|strong="H5062"\w* \w the Egyptians|strong="H4714"\w* \w by what|strong="H834"\w* \w I did|strong="H6213"\w* \w there|strong="H7130"\w*, \w and afterward|strong="H310"\w* \w I brought you out|strong="H3318"\w*. \v 6 \w When I brought|strong="H3318"\w* \w your fathers|strong="H1"\w* \w out of Egypt|strong="H4714"\w* \w and you reached|strong="H935"\w* \w the Red Sea|strong="H3220"\w*,\f + \fr 24:6 \ft Or \fqa the Sea of Reeds\f* \w the Egyptians|strong="H4713"\w* \w pursued|strong="H7291"\w* \w them|strong="H1"\w* \w with chariots|strong="H7393"\w* \w and horsemen|strong="H6571"\w* \w as far as the Red Sea|strong="H3220"\w*. \v 7 \w So your fathers cried out|strong="H6817"\w* \w to|strong="H413"\w* \w the LORD|strong="H3068"\w*, \w and He put|strong="H7760"\w* \w darkness|strong="H3990"\w* \w between|strong="H996"\w* \w you and the Egyptians|strong="H4713"\w*, \w over whom|strong="H5921"\w* \w He brought|strong="H935"\w* \w the sea|strong="H3220"\w* \w and engulfed them|strong="H3680"\w*. \w Your very eyes|strong="H5869"\w* \w saw|strong="H7200"\w* \w what|strong="H834"\w* \w I did|strong="H6213"\w* \w to the Egyptians|strong="H4714"\w*. \w Then you lived|strong="H3427"\w* \w in the wilderness|strong="H4057"\w* \w for a long|strong="H7227"\w* \w time|strong="H3117"\w*.
\p \v 8 \w Later, I brought|strong="H935"\w* \w you to|strong="H413"\w* \w the land|strong="H776"\w* \w of the Amorites|strong="H567"\w* \w who lived|strong="H3427"\w* \w beyond|strong="H5676"\w* \w the Jordan|strong="H3383"\w*. \w They fought|strong="H3898"\w* \w against you|strong="H854"\w*, \w but I delivered|strong="H5414"\w* \w them|strong="H853"\w* \w into your hand|strong="H3027"\w*, \w that you should possess|strong="H3423"\w* \w their land|strong="H776"\w* \w when I destroyed them|strong="H8045"\w* \w before you|strong="H6440"\w*. \v 9 \w Then Balak|strong="H1111"\w* \w son|strong="H1121"\w* \w of Zippor|strong="H6834"\w*, \w the king|strong="H4428"\w* \w of Moab|strong="H4124"\w*, \w set out|strong="H6965"\w* \w to fight|strong="H3898"\w* \w against Israel|strong="H3478"\w*. \w He sent|strong="H7971"\w* \w for Balaam|strong="H1109"\w* \w son|strong="H1121"\w* \w of Beor|strong="H1160"\w* \w to curse you|strong="H7043"\w*, \v 10 \w but I would|strong="H14"\w* \w not|strong="H3808"\w* \w listen|strong="H8085"\w* \w to Balaam|strong="H1109"\w*. \w So he blessed you again and again|strong="H1288"\w*, \w and I delivered|strong="H5337"\w* \w you|strong="H853"\w* \w from his hand|strong="H3027"\w*.
\p \v 11 \w After this, you crossed|strong="H5674"\w* \w the Jordan|strong="H3383"\w* \w and came|strong="H935"\w* \w to|strong="H413"\w* \w Jericho|strong="H3405"\w*. \w The people|strong="H1167"\w* \w of Jericho|strong="H3405"\w* \w fought|strong="H3898"\w* against you, \w as did the Amorites|strong="H567"\w*, \w Perizzites|strong="H6522"\w*, \w Canaanites|strong="H3669"\w*, \w Hittites|strong="H2850"\w*, \w Girgashites|strong="H1622"\w*, \w Hivites|strong="H2340"\w*, \w and Jebusites|strong="H2983"\w*, \w and I delivered|strong="H5414"\w* \w them|strong="H853"\w* \w into your hand|strong="H3027"\w*. \v 12 \w I sent|strong="H7971"\w* \w the hornet|strong="H6880"\w* \w ahead of you|strong="H6440"\w*, \w and it drove out|strong="H1644"\w* \w the two|strong="H8147"\w* \w Amorite|strong="H567"\w* \w kings|strong="H4428"\w* \w before you|strong="H6440"\w*, \w but not|strong="H3808"\w* \w by your own sword|strong="H2719"\w* \w or bow|strong="H7198"\w*. \v 13 \w So I gave|strong="H5414"\w* you \w a land|strong="H776"\w* \w on which|strong="H834"\w* \w you did not|strong="H3808"\w* \w toil|strong="H3021"\w* \w and cities|strong="H5892"\w* \w that|strong="H834"\w* \w you did not|strong="H3808"\w* \w build|strong="H1129"\w*, \w and now you live|strong="H3427"\w* in them \w and eat|strong="H398"\w* \w from vineyards|strong="H3754"\w* \w and olive groves|strong="H2132"\w* \w that|strong="H834"\w* \w you did not|strong="H3808"\w* \w plant|strong="H5193"\w*.’
\s1 Choose Whom You Will Serve
\r (\ref Deuteronomy 10:12–22|DEU 10:12-22\ref*)
\p \v 14 \w Now, therefore|strong="H6258"\w*, \w fear|strong="H3372"\w* \w the LORD|strong="H3068"\w* \w and serve|strong="H5647"\w* \w Him|strong="H853"\w* \w in sincerity|strong="H8549"\w* \w and truth|strong="H571"\w*; \w cast aside|strong="H5493"\w* \w the gods|strong="H430"\w* \w your fathers|strong="H1"\w* \w served|strong="H5647"\w* \w beyond|strong="H5676"\w* \w the Euphrates|strong="H5104"\w* \w and in Egypt|strong="H4714"\w*, \w and serve|strong="H5647"\w* \w the LORD|strong="H3068"\w*. \v 15 \w But if|strong="H518"\w* \w it is unpleasing|strong="H7451"\w* \w in your sight|strong="H5869"\w* \w to serve|strong="H5647"\w* \w the LORD|strong="H3068"\w*, \w then choose|strong="H977"\w* for yourselves \w this day|strong="H3117"\w* \w whom|strong="H4310"\w* \w you will serve|strong="H5647"\w*, \w whether the|strong="H518"\w* \w gods|strong="H430"\w* \w your fathers|strong="H1"\w* \w served|strong="H5647"\w* \w beyond|strong="H5676"\w* \w the Euphrates|strong="H5104"\w*, \w or|strong="H518"\w* \w the gods|strong="H430"\w* \w of the Amorites|strong="H567"\w* \w in whose|strong="H834"\w* \w land|strong="H776"\w* \w you|strong="H859"\w* \w are living|strong="H3427"\w*. \w As for me|strong="H595"\w* \w and my house|strong="H1004"\w*, \w we will serve|strong="H5647"\w* \w the LORD|strong="H3068"\w*!”
\p \v 16 \w The people|strong="H5971"\w* \w replied|strong="H6030"\w*, “\w Far be it|strong="H2486"\w* from us \w to forsake|strong="H5800"\w* \w the LORD|strong="H3068"\w* \w to serve|strong="H5647"\w* \w other|strong="H312"\w* \w gods|strong="H430"\w*! \v 17 \w For|strong="H3588"\w* \w the LORD|strong="H3068"\w* \w our God|strong="H430"\w* \w brought|strong="H5927"\w* \w us|strong="H853"\w* \w and|strong="H853"\w* \w our fathers|strong="H1"\w* \w out of the land|strong="H776"\w* \w of Egypt|strong="H4714"\w*, \w out of the house|strong="H1004"\w* \w of slavery|strong="H5650"\w*, \w and|strong="H834"\w* \w performed|strong="H6213"\w* \w these|strong="H428"\w* \w great|strong="H1419"\w* \w signs|strong="H226"\w* \w before our eyes|strong="H5869"\w*. \w He also protected us|strong="H8104"\w* \w throughout|strong="H3605"\w* \w our journey|strong="H1870"\w* \w and among all|strong="H3605"\w* \w the nations|strong="H5971"\w* \w through which|strong="H834"\w* \w we traveled|strong="H5674"\w*. \v 18 \w And the LORD|strong="H3068"\w* \w drove out|strong="H1644"\w* \w before us|strong="H6440"\w* \w all|strong="H3605"\w* \w the nations|strong="H5971"\w*, \w including the Amorites|strong="H567"\w* \w who lived|strong="H3427"\w* \w in the land|strong="H776"\w*. \w We|strong="H587"\w* \w too|strong="H1571"\w* \w will serve|strong="H5647"\w* \w the LORD|strong="H3068"\w*, \w because|strong="H3588"\w* \w He|strong="H1931"\w* \w is our God|strong="H430"\w*!”
\p \v 19 \w But Joshua|strong="H3091"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w the people|strong="H5971"\w*, “\w You are not|strong="H3808"\w* \w able|strong="H3201"\w* \w to serve|strong="H5647"\w* \w the LORD|strong="H3068"\w*, \w for|strong="H3588"\w* \w He|strong="H1931"\w* \w is a holy|strong="H6918"\w* \w God|strong="H430"\w*; \w He|strong="H1931"\w* \w is a jealous|strong="H7072"\w* \w God|strong="H410"\w*; \w He will not|strong="H3808"\w* \w forgive|strong="H5375"\w* \w your rebellion|strong="H6588"\w* \w or your sins|strong="H2403"\w*. \v 20 \w If|strong="H3588"\w* \w you forsake|strong="H5800"\w* \w the LORD|strong="H3068"\w* \w and serve|strong="H5647"\w* \w foreign|strong="H5236"\w* \w gods|strong="H430"\w*, \w He will turn|strong="H7725"\w* \w and bring disaster|strong="H7489"\w* on you \w and consume|strong="H3615"\w* \w you|strong="H853"\w*, \w even after|strong="H310"\w* \w He has been good|strong="H3190"\w* to you.”
\p \v 21 “\w No|strong="H3808"\w*!” \w replied|strong="H559"\w* \w the people|strong="H5971"\w*. “\w We will serve|strong="H5647"\w* \w the LORD|strong="H3068"\w*!”
\p \v 22 \w Then Joshua|strong="H3091"\w* \w told|strong="H559"\w* \w them|strong="H5971"\w*, “\w You|strong="H859"\w* \w are witnesses|strong="H5707"\w* against yourselves \w that|strong="H3588"\w* \w you|strong="H859"\w* \w have chosen|strong="H977"\w* \w to serve|strong="H5647"\w* \w the LORD|strong="H3068"\w*.”
\p “\w We are witnesses|strong="H5707"\w*!” \w they said|strong="H559"\w*.
\p \v 23 “\w Now, therefore,” he said,|strong="H6258"\w* “\w get rid of|strong="H5493"\w* \w the foreign|strong="H5236"\w* \w gods|strong="H430"\w* \w among you|strong="H7130"\w* \w and incline|strong="H5186"\w* \w your hearts|strong="H3824"\w* \w to|strong="H413"\w* \w the LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*.”
\p \v 24 \w So the people|strong="H5971"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w Joshua|strong="H3091"\w*, “\w We will serve|strong="H5647"\w* \w the LORD|strong="H3068"\w* \w our God|strong="H430"\w* \w and obey|strong="H8085"\w* \w His voice|strong="H6963"\w*.”
\p \v 25 \w On that|strong="H1931"\w* \w day|strong="H3117"\w* \w Joshua|strong="H3091"\w* \w made|strong="H3772"\w* \w a covenant|strong="H1285"\w* \w for the people|strong="H5971"\w*, \w and there at Shechem|strong="H7927"\w* \w he established|strong="H7760"\w* for them \w a statute|strong="H2706"\w* \w and ordinance|strong="H4941"\w*. \v 26 \w Joshua|strong="H3091"\w* \w recorded|strong="H3789"\w* \w these|strong="H428"\w* \w things|strong="H1697"\w* \w in the Book|strong="H5612"\w* \w of the Law|strong="H8451"\w* \w of God|strong="H430"\w*. \w Then he took|strong="H3947"\w* \w a large|strong="H1419"\w* \w stone|strong="H68"\w* \w and set it up|strong="H6965"\w* \w there|strong="H8033"\w* \w under|strong="H8478"\w* \w the oak|strong="H427"\w*\f + \fr 24:26 \ft Or \fqa terebinth\f* \w that was|strong="H834"\w* \w near the sanctuary|strong="H4720"\w* \w of the LORD|strong="H3068"\w*. \v 27 \w And Joshua|strong="H3091"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w all|strong="H3605"\w* \w the people|strong="H5971"\w*, “\w You see|strong="H2009"\w* \w this|strong="H2063"\w* \w stone|strong="H68"\w*. \w It will be|strong="H1961"\w* \w a witness|strong="H5713"\w* against us, \w for|strong="H3588"\w* \w it|strong="H1931"\w* \w has heard|strong="H8085"\w* \w all|strong="H3605"\w* \w the words|strong="H561"\w* \w the LORD|strong="H3068"\w* \w has spoken|strong="H1696"\w* \w to us|strong="H5973"\w*, \w and it will be|strong="H1961"\w* \w a witness|strong="H5713"\w* against you \w if you ever|strong="H6435"\w* \w deny|strong="H3584"\w* \w your God|strong="H430"\w*.”
\p \v 28 \w Then Joshua|strong="H3091"\w* \w sent the people|strong="H5971"\w* \w away|strong="H7971"\w*, \w each|strong="H376"\w* \w to his own inheritance|strong="H5159"\w*.
\s1 Joshua’s Death and Burial
\r (\ref Judges 2:6–9|JDG 2:6-9\ref*)
\p \v 29 \w Some time later|strong="H310"\w*, \w Joshua|strong="H3091"\w* \w son|strong="H1121"\w* \w of Nun|strong="H5126"\w*, \w the servant|strong="H5650"\w* \w of the LORD|strong="H3068"\w*, \w died|strong="H4191"\w* \w at the age|strong="H1121"\w* \w of 110|strong="H3967"\w*. \v 30 \w And they buried|strong="H6912"\w* \w him|strong="H853"\w* \w in the land|strong="H1366"\w* \w of his inheritance|strong="H5159"\w*, \w at Timnath-serah|strong="H8556"\w*\f + \fr 24:30 \fqa Timnath-serah \ft is also known as \fqa Timnath-heres\ft ; see \ref Judges 2:9|JDG 2:9\ref*.\f* \w in the hill country|strong="H2022"\w* \w of Ephraim|strong="H669"\w*, \w north|strong="H6828"\w* \w of Mount|strong="H2022"\w* \w Gaash|strong="H1608"\w*. \v 31 \w Israel|strong="H3478"\w* \w had served|strong="H5647"\w* \w the LORD|strong="H3068"\w* \w throughout|strong="H3605"\w* \w the days|strong="H3117"\w* \w of Joshua|strong="H3091"\w* \w and|strong="H3605"\w* \w of the elders|strong="H2205"\w* \w who|strong="H834"\w* \w outlived|strong="H748"\w* \w him|strong="H3091"\w* \w and|strong="H834"\w* \w who had experienced|strong="H3045"\w* \w all|strong="H3605"\w* \w the works|strong="H4639"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had done|strong="H6213"\w* \w for Israel|strong="H3478"\w*.
\p \v 32 \w And|strong="H853"\w* \w the bones|strong="H6106"\w* \w of Joseph|strong="H3130"\w*, \w which|strong="H834"\w* \w the Israelites|strong="H1121"\w* \w had brought up|strong="H5927"\w* \w out of Egypt|strong="H4714"\w*, \w were buried|strong="H6912"\w* \w at Shechem|strong="H7927"\w* \w in the plot|strong="H2513"\w* \w of land|strong="H7704"\w* \w that|strong="H834"\w* \w Jacob|strong="H3290"\w* \w had purchased|strong="H7069"\w* \w from the sons|strong="H1121"\w* \w of Hamor|strong="H2544"\w*, \w Shechem’s|strong="H7927"\w* \w father|strong="H1"\w*, \w for a hundred|strong="H3967"\w* \w pieces of silver|strong="H7192"\w*.\f + \fr 24:32 \ft Hebrew \fqa a hundred kesitahs\ft ; the value or weight of the kesitah is no longer known.\f* \w So it became|strong="H1961"\w* \w an inheritance|strong="H5159"\w* \w for Joseph’s|strong="H3130"\w* \w descendants|strong="H1121"\w*.
\p \v 33 \w Eleazar|strong="H499"\w* \w son|strong="H1121"\w* \w of Aaron|strong="H175"\w* \w also died|strong="H4191"\w*, \w and they buried|strong="H6912"\w* \w him|strong="H853"\w* \w at Gibeah|strong="H1389"\w*, \w which|strong="H834"\w* \w had been given|strong="H5414"\w* to his \w son|strong="H1121"\w* \w Phinehas|strong="H6372"\w* \w in the hill country|strong="H2022"\w* \w of Ephraim|strong="H669"\w*.
