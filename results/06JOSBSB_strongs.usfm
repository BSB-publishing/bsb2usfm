\p \v 33 \w To the tribe|strong="H7626"\w* \w of Levi|strong="H3878"\w*, \w however|strong="H4872"\w*, \w Moses had given|strong="H5414"\w* \w no|strong="H3808"\w* \w inheritance|strong="H5159"\w*. \w The LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w is their inheritance|strong="H5159"\w*, \w just as|strong="H834"\w* \w He had promised|strong="H1696"\w* them.
\c 14
\s1 Land Division West of the Jordan
\p \v 1 \w Now these are the portions|strong="H428"\w* \w that|strong="H834"\w* \w the Israelites|strong="H1121"\w* \w inherited|strong="H5157"\w* \w in the land|strong="H776"\w* \w of Canaan|strong="H3667"\w*, \w as distributed|strong="H5157"\w* \w by Eleazar|strong="H499"\w* \w the priest|strong="H3548"\w*, \w Joshua|strong="H3091"\w* \w son|strong="H1121"\w* \w of Nun|strong="H5126"\w*, \w and the heads|strong="H7218"\w* \w of the families|strong="H1"\w* \w of the tribes|strong="H4294"\w* \w of Israel|strong="H3478"\w*. \v 2 \w Their inheritance|strong="H5159"\w* \w was assigned by lot|strong="H1486"\w* \w for the nine|strong="H8672"\w* \w and a half|strong="H2677"\w* \w tribes|strong="H4294"\w*, \w as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w through|strong="H3027"\w* \w Moses|strong="H4872"\w*. \v 3 \w For|strong="H3588"\w* \w Moses|strong="H4872"\w* \w had given|strong="H5414"\w* \w the inheritance|strong="H5159"\w* \w east of|strong="H5676"\w* \w the Jordan|strong="H3383"\w* \w to the other two|strong="H8147"\w* \w and a half|strong="H2677"\w* \w tribes|strong="H4294"\w*. \w But he granted|strong="H5414"\w* \w no|strong="H3808"\w* \w inheritance|strong="H5159"\w* \w among them|strong="H8432"\w* \w to the Levites|strong="H3881"\w*.
