\s1 God Instructs Joshua
\r (\ref Deuteronomy 11:8–17|DEU 11:8-17\ref*)
\p \v 1 \w Now|strong="H1961"\w* \w after|strong="H310"\w* \w the death|strong="H4194"\w* \w of His|strong="H3068"\w* \w servant|strong="H5650"\w* \w Moses|strong="H4872"\w*, \w the LORD|strong="H3068"\w* \w spoke|strong="H559"\w* \w to|strong="H413"\w* \w Joshua|strong="H3091"\w* \w son|strong="H1121"\w* \w of Nun|strong="H5126"\w*, \w Moses’|strong="H4872"\w* \w assistant|strong="H8334"\w*, \w saying|strong="H559"\w*, \v 2 “\w Moses|strong="H4872"\w* \w My servant|strong="H5650"\w* \w is dead|strong="H4191"\w*. \w Now therefore|strong="H6258"\w* \w arise|strong="H6965"\w*, \w you|strong="H859"\w* \w and all|strong="H3605"\w* \w these people|strong="H5971"\w*, \w and cross over|strong="H5674"\w* \w the Jordan|strong="H3383"\w* \w into|strong="H413"\w* \w the land|strong="H776"\w* \w that|strong="H834"\w* \w I|strong="H595"\w* \w am giving|strong="H5414"\w* to \w the children|strong="H1121"\w* \w of Israel|strong="H3478"\w*.
\p \v 3 \w I have given you|strong="H5414"\w* \w every|strong="H3605"\w* \w place|strong="H4725"\w* \w where|strong="H834"\w* \w the sole|strong="H3709"\w* \w of your foot|strong="H7272"\w* \w will tread|strong="H1869"\w*, \w just as|strong="H834"\w* \w I promised|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*. \v 4 \w Your territory|strong="H1366"\w* \w shall extend|strong="H1961"\w* \w from the wilderness|strong="H4057"\w* \w and Lebanon|strong="H3844"\w* \w to|strong="H5704"\w* \w the great|strong="H1419"\w* \w River|strong="H5104"\w* \w Euphrates|strong="H6578"\w*— \w all|strong="H3605"\w* \w the land|strong="H776"\w* \w of the Hittites|strong="H2850"\w*— \w and west|strong="H3996"\w* \w as far as|strong="H5704"\w* \w the Great|strong="H1419"\w* \w Sea|strong="H3220"\w*.\f + \fr 1:4 \ft That is, the Mediterranean Sea\f*
\p \v 5 \w No|strong="H3808"\w* \w one|strong="H376"\w* \w shall stand|strong="H3320"\w* \w against you|strong="H6440"\w* \w all|strong="H3605"\w* \w the days|strong="H3117"\w* \w of your life|strong="H2416"\w*. \w As|strong="H834"\w* \w I was|strong="H1961"\w* \w with|strong="H5973"\w* \w Moses|strong="H4872"\w*, \w so will I be|strong="H1961"\w* \w with you|strong="H5973"\w*; \w I will never|strong="H3808"\w* \w leave you|strong="H7503"\w* \w nor|strong="H3808"\w* \w forsake you|strong="H5800"\w*.\f + \fr 1:5 \ft Cited in \ref Hebrews 13:5|HEB 13:5\ref*\f*
\p \v 6 \w Be strong|strong="H2388"\w* \w and courageous|strong="H553"\w*, \w for|strong="H3588"\w* \w you|strong="H859"\w* \w shall give these people the inheritance|strong="H5157"\w* \w of the land|strong="H776"\w* \w that|strong="H834"\w* \w I swore|strong="H7650"\w* \w to their fathers|strong="H1"\w* \w I would give|strong="H5414"\w* them.
\p \v 7 \w Above all|strong="H7535"\w*, \w be strong|strong="H2388"\w* \w and very|strong="H3966"\w* \w courageous|strong="H553"\w*. \w Be careful|strong="H8104"\w* \w to observe|strong="H6213"\w* \w all|strong="H3605"\w* \w the law|strong="H8451"\w* \w that|strong="H834"\w* \w My servant|strong="H5650"\w* \w Moses|strong="H4872"\w* \w commanded you|strong="H6680"\w*. \w Do not|strong="H408"\w* \w turn|strong="H5493"\w* \w from|strong="H4480"\w* \w it to the right|strong="H3225"\w* \w or to the left|strong="H8040"\w*, \w so that|strong="H4616"\w* \w you may prosper|strong="H7919"\w* \w wherever|strong="H3605"\w* \w you go|strong="H1980"\w*. \v 8 \w This|strong="H2088"\w* \w Book|strong="H5612"\w* \w of the Law|strong="H8451"\w* \w must not|strong="H3808"\w* \w depart|strong="H4185"\w* \w from your mouth|strong="H6310"\w*; \w meditate|strong="H1897"\w* on it \w day|strong="H3119"\w* \w and night|strong="H3915"\w*, \w so that|strong="H4616"\w* \w you may be careful|strong="H8104"\w* \w to do|strong="H6213"\w* \w everything|strong="H3605"\w* \w written|strong="H3789"\w* in it. \w For|strong="H3588"\w* \w then|strong="H227"\w* \w you will prosper|strong="H6743"\w* \w and succeed|strong="H7919"\w* \w in all you do|strong="H1870"\w*.
\p \v 9 \w Have I not|strong="H3808"\w* \w commanded you|strong="H6680"\w* \w to be strong|strong="H2388"\w* \w and courageous|strong="H553"\w*? \w Do not|strong="H408"\w* \w be afraid|strong="H6206"\w*; \w do not be discouraged|strong="H2865"\w*, \w for|strong="H3588"\w* \w the LORD|strong="H3068"\w* \w your God|strong="H430"\w* \w is with|strong="H5973"\w* \w you wherever|strong="H3605"\w* \w you go|strong="H1980"\w*.”
\s1 Joshua Takes Charge
\p \v 10 \w Then Joshua|strong="H3091"\w* \w commanded|strong="H6680"\w* \w the officers|strong="H7860"\w* \w of the people|strong="H5971"\w*: \v 11 “\w Go|strong="H5674"\w* \w through|strong="H7130"\w* \w the camp|strong="H4264"\w* \w and tell|strong="H6680"\w* \w the people|strong="H5971"\w*, ‘\w Prepare|strong="H3559"\w* your \w provisions|strong="H6720"\w*, \w for|strong="H3588"\w* \w within|strong="H5750"\w* \w three|strong="H7969"\w* \w days|strong="H3117"\w* \w you|strong="H859"\w* \w will cross|strong="H5674"\w* \w the|strong="H2088"\w* \w Jordan|strong="H3383"\w* \w to go in|strong="H935"\w* \w and take possession of|strong="H3423"\w* \w the land|strong="H776"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w your God|strong="H430"\w* \w is giving|strong="H5414"\w* you \w to possess|strong="H3423"\w*.’”
\p \v 12 \w But to the Reubenites|strong="H7206"\w*, \w the Gadites|strong="H1425"\w*, \w and the half-tribe|strong="H2677"\w* \w of Manasseh|strong="H4519"\w*, \w Joshua|strong="H3091"\w* \w said|strong="H559"\w*, \v 13 “\w Remember|strong="H2142"\w* \w what|strong="H834"\w* \w Moses|strong="H4872"\w* \w the servant|strong="H5650"\w* \w of the LORD|strong="H3068"\w* \w commanded|strong="H6680"\w* \w you|strong="H853"\w* \w when he said|strong="H559"\w*, ‘\w The LORD|strong="H3068"\w* \w your God|strong="H430"\w* \w will give you rest|strong="H5117"\w*, \w and He will give|strong="H5414"\w* you \w this|strong="H2063"\w* \w land|strong="H776"\w*.’ \v 14 \w Your wives|strong="H802"\w*, \w your young children|strong="H2945"\w*, \w and your livestock|strong="H4735"\w* \w may remain|strong="H3427"\w* \w in the land|strong="H776"\w* \w that|strong="H834"\w* \w Moses|strong="H4872"\w* \w gave|strong="H5414"\w* you \w on this side|strong="H5676"\w* \w of the Jordan|strong="H3383"\w*. \w But all|strong="H3605"\w* \w your mighty men|strong="H1368"\w* \w of valor|strong="H2428"\w* \w must be armed for battle|strong="H2571"\w* \w to cross over|strong="H5674"\w* \w ahead of|strong="H6440"\w* \w your brothers|strong="H251"\w* \w and help them|strong="H5826"\w*, \v 15 \w until|strong="H5704"\w* \w the LORD|strong="H3068"\w* \w gives them rest|strong="H5117"\w* as He has done for you, \w and your brothers|strong="H1992"\w* \w also|strong="H1571"\w* \w possess|strong="H3423"\w* \w the land|strong="H776"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w your God|strong="H430"\w* \w is giving|strong="H5414"\w* them. \w Then you may return|strong="H7725"\w* \w to the land|strong="H776"\w* \w of your inheritance|strong="H3425"\w* \w and take possession of|strong="H3423"\w* \w that which|strong="H834"\w* \w Moses|strong="H4872"\w* \w the servant|strong="H5650"\w* \w of the LORD|strong="H3068"\w* \w gave|strong="H5414"\w* you \w on the east|strong="H4217"\w* \w side|strong="H5676"\w* \w of the Jordan|strong="H3383"\w*.”
\p \v 16 \w So they answered|strong="H6030"\w* \w Joshua|strong="H3091"\w*, “\w Everything|strong="H3605"\w* \w you have commanded us|strong="H6680"\w* \w we will do|strong="H6213"\w*, \w and everywhere|strong="H413"\w* \w you send us|strong="H7971"\w* \w we will go|strong="H1980"\w*. \v 17 \w Just as|strong="H834"\w* \w we obeyed|strong="H8085"\w* \w Moses|strong="H4872"\w* \w in all things|strong="H3605"\w*, \w so we will obey you|strong="H8085"\w*. \w And may the LORD|strong="H3068"\w* \w your God|strong="H430"\w* \w be|strong="H1961"\w* \w with you|strong="H5973"\w*, \w as|strong="H834"\w* \w He was|strong="H1961"\w* \w with|strong="H5973"\w* \w Moses|strong="H4872"\w*. \v 18 \w Anyone|strong="H3605"\w* \w who|strong="H834"\w* \w rebels|strong="H4784"\w* \w against your order|strong="H6310"\w* \w and does not|strong="H3808"\w* \w obey|strong="H8085"\w* \w your words|strong="H1697"\w*, \w all|strong="H3605"\w* \w that|strong="H834"\w* \w you command him|strong="H6680"\w*, \w will be put to death|strong="H4191"\w*. \w Above all|strong="H7535"\w*, \w be strong|strong="H2388"\w* \w and courageous|strong="H553"\w*!”
