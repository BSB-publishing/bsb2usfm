\c 13
\s1 Lands Yet Unconquered
\r (\ref Judges 1:1–7|JDG 1:1-7\ref*)
\p \v 1 \w Now Joshua|strong="H3091"\w* \w was old|strong="H2204"\w* \w and well along|strong="H935"\w* \w in years|strong="H3117"\w*, \w and the LORD|strong="H3068"\w* \w said|strong="H559"\w* \w to him|strong="H413"\w*, “\w You|strong="H859"\w* \w are old|strong="H2204"\w* \w and well along|strong="H935"\w* \w in years|strong="H3117"\w*, \w but very|strong="H3966"\w* \w much|strong="H7235"\w* \w of the land|strong="H776"\w* \w remains|strong="H7604"\w* \w to be possessed|strong="H3423"\w*. \v 2 \w This|strong="H2063"\w* \w is the land|strong="H776"\w* \w that remains|strong="H7604"\w*:
\b 
\li1 \w All|strong="H3605"\w* \w the territory|strong="H1552"\w* \w of the Philistines|strong="H6430"\w* \w and the Geshurites|strong="H1651"\w*, \v 3 \w from|strong="H4480"\w* \w the Shihor|strong="H7883"\w* \w east|strong="H5921"\w* \w of Egypt|strong="H4714"\w* \w to|strong="H5704"\w* \w the territory|strong="H1366"\w* \w of Ekron|strong="H6138"\w* \w on the north|strong="H6828"\w* \w (considered|strong="H2803"\w* \w to be Canaanite territory)|strong="H3669"\w*— \w that of the five|strong="H2568"\w* \w Philistine|strong="H6430"\w* \w rulers|strong="H5633"\w* \w of Gaza|strong="H5841"\w*, \w Ashdod|strong="H796"\w*, \w Ashkelon|strong="H832"\w*, \w Gath|strong="H1663"\w*, \w and Ekron|strong="H6139"\w*, \w as well as that of the Avvites|strong="H5761"\w*;
\li1 \v 4 \w to the south|strong="H8486"\w*, \w all|strong="H3605"\w* \w the land|strong="H776"\w* \w of the Canaanites|strong="H3669"\w*, \w from Mearah|strong="H4632"\w*\f + \fr 13:4 \ft Or \fqa Arah\f* \w of|strong="H834"\w* \w the Sidonians|strong="H6722"\w* \w to|strong="H5704"\w* \w Aphek|strong="H663"\w*, \w as far as|strong="H5704"\w* \w the border|strong="H1366"\w* \w of the Amorites|strong="H567"\w*;
\li1 \v 5 \w the land|strong="H776"\w* \w of the Gebalites|strong="H1382"\w*;\f + \fr 13:5 \ft Or \fqa the area of Byblos\f*
\li1 \w and all|strong="H3605"\w* \w Lebanon|strong="H3844"\w* \w to the east|strong="H4217"\w*, \w from Baal-gad|strong="H1171"\w* \w below|strong="H8478"\w* \w Mount|strong="H2022"\w* \w Hermon|strong="H2768"\w* \w to|strong="H5704"\w* \w Lebo-hamath|strong="H2574"\w*.
\p \v 6 \w All|strong="H3605"\w* \w the inhabitants|strong="H3427"\w* \w of the hill country|strong="H2022"\w* \w from|strong="H4480"\w* \w Lebanon|strong="H3844"\w* \w to|strong="H5704"\w* \w Misrephoth-maim|strong="H4956"\w* — \w all|strong="H3605"\w* \w the Sidonians|strong="H6722"\w* — \w I Myself|strong="H595"\w* \w will drive out|strong="H3423"\w* \w before|strong="H6440"\w* \w the Israelites|strong="H1121"\w*. \w Be sure to|strong="H7535"\w* \w divide it by lot|strong="H5307"\w* \w as an inheritance|strong="H5159"\w* \w to Israel|strong="H3478"\w*, \w as|strong="H834"\w* \w I have commanded you|strong="H6680"\w*. \v 7 \w Now therefore|strong="H6258"\w* \w divide|strong="H2505"\w* \w this|strong="H2063"\w* \w land|strong="H776"\w* \w as an inheritance|strong="H5159"\w* \w to the nine|strong="H8672"\w* \w tribes|strong="H7626"\w* \w and the half-tribe|strong="H2677"\w* \w of Manasseh|strong="H4519"\w*.”
\s1 The Inheritance East of the Jordan
\r (\ref Numbers 32:1–42|NUM 32:1-42\ref*; \ref Deuteronomy 3:12–22|DEU 3:12-22\ref*)
\p \v 8 \w The other half of Manasseh|strong="H5973"\w*, \w along with the Reubenites|strong="H7206"\w* \w and Gadites|strong="H1425"\w*, \w had received|strong="H3947"\w* \w the inheritance|strong="H5159"\w* \w Moses|strong="H4872"\w* \w had given|strong="H5414"\w* them \w beyond|strong="H5676"\w* \w the Jordan|strong="H3383"\w* \w to the east|strong="H4217"\w*, \w just as|strong="H834"\w* \w Moses|strong="H4872"\w* \w the servant|strong="H5650"\w* \w of the LORD|strong="H3068"\w* \w had assigned|strong="H5414"\w* to them:
\b 
