\p \v 5 \w So|strong="H3651"\w* \w the Israelites|strong="H1121"\w* \w did|strong="H6213"\w* \w as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w Moses|strong="H4872"\w*, \w and they divided|strong="H2505"\w* \w the land|strong="H776"\w*.
\s1 Caleb Requests Hebron
\p \v 6 \w Then the sons|strong="H1121"\w* \w of Judah|strong="H3063"\w* \w approached|strong="H5066"\w* \w Joshua|strong="H3091"\w* \w at Gilgal|strong="H1537"\w*, \w and Caleb|strong="H3612"\w* \w son|strong="H1121"\w* \w of Jephunneh|strong="H3312"\w* \w the Kenizzite|strong="H7074"\w* \w said|strong="H559"\w* \w to him|strong="H413"\w*, “\w You|strong="H859"\w* \w know|strong="H3045"\w* \w what|strong="H834"\w* \w the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w* \w the man|strong="H376"\w* \w of God|strong="H430"\w* \w at Kadesh-barnea|strong="H6947"\w* \w about|strong="H5921"\w* \w you|strong="H182"\w* \w and|strong="H5921"\w* \w me|strong="H182"\w*. \v 7 \w I was|strong="H595"\w* \w forty|strong="H705"\w* \w years old|strong="H1121"\w* \w when Moses|strong="H4872"\w* \w the servant|strong="H5650"\w* \w of the LORD|strong="H3068"\w* \w sent|strong="H7971"\w* \w me|strong="H853"\w* \w from|strong="H6947"\w* \w Kadesh-barnea|strong="H6947"\w* \w to spy out|strong="H7270"\w* \w the land|strong="H776"\w*, \w and I brought back|strong="H7725"\w* \w to him|strong="H853"\w* \w an honest|strong="H834"\w* \w report|strong="H1697"\w*.
\p \v 8 \w Although my brothers|strong="H251"\w* \w who|strong="H834"\w* \w went|strong="H5927"\w* \w with me|strong="H5973"\w* \w made the hearts|strong="H3820"\w* \w of the people|strong="H5971"\w* \w melt with fear|strong="H4529"\w*, \w I|strong="H595"\w* \w remained loyal|strong="H4390"\w* \w to|strong="H310"\w* \w the LORD|strong="H3068"\w* \w my God|strong="H430"\w*. \v 9 \w On that|strong="H1931"\w* \w day|strong="H3117"\w* \w Moses|strong="H4872"\w* \w swore to me|strong="H7650"\w*, \w saying|strong="H559"\w*, ‘\w Surely|strong="H518"\w* \w the land|strong="H776"\w* \w on which|strong="H834"\w* \w you have set foot|strong="H1869"\w* \w will be|strong="H1961"\w* \w an inheritance|strong="H5159"\w* to you \w and your children|strong="H1121"\w* \w forever|strong="H5704"\w*, \w because|strong="H3588"\w* \w you have wholly|strong="H4390"\w* \w followed|strong="H310"\w* \w the LORD|strong="H3068"\w* \w my God|strong="H430"\w*.’
\p \v 10 \w Now|strong="H6258"\w* \w behold|strong="H2009"\w*, \w as|strong="H834"\w* \w the LORD promised|strong="H1696"\w*, \w He|strong="H3068"\w* \w has kept me alive|strong="H2421"\w* \w these|strong="H2088"\w* \w forty-five|strong="H705"\w* \w years|strong="H8141"\w* \w since|strong="H227"\w* \w He|strong="H3068"\w* \w spoke|strong="H1696"\w* \w this|strong="H2088"\w* \w word|strong="H1697"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \w while|strong="H834"\w* \w Israel|strong="H3478"\w* \w wandered|strong="H1980"\w* \w in the wilderness|strong="H4057"\w*. \w So|strong="H6258"\w* \w here|strong="H2009"\w* \w I am today|strong="H595"\w*, \w eighty-five|strong="H2568"\w* \w years old|strong="H1121"\w*, \v 11 \w still|strong="H5750"\w* \w as strong|strong="H2389"\w* \w today|strong="H3117"\w* \w as|strong="H834"\w* \w I was the day|strong="H3117"\w* \w Moses|strong="H4872"\w* \w sent me out|strong="H7971"\w*. \w As my strength|strong="H3581"\w* \w was then|strong="H227"\w*, \w so it|strong="H3581"\w* \w is now|strong="H6258"\w* \w for war|strong="H4421"\w*, \w for going out|strong="H3318"\w*, \w and for coming in|strong="H935"\w*.
\p \v 12 \w Now therefore|strong="H6258"\w* \w give|strong="H5414"\w* me \w this|strong="H2088"\w* \w hill country|strong="H2022"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w promised me|strong="H1696"\w* \w on that|strong="H1931"\w* \w day|strong="H3117"\w*, \w for|strong="H3588"\w* \w you yourself|strong="H859"\w* \w heard|strong="H8085"\w* \w then|strong="H3117"\w* \w that|strong="H3588"\w* \w the Anakim|strong="H6062"\w* \w were there|strong="H8033"\w*, \w with great|strong="H1419"\w* \w and fortified|strong="H1219"\w* \w cities|strong="H5892"\w*. \w Perhaps|strong="H194"\w* \w with the LORD’s|strong="H3068"\w* \w help|strong="H854"\w* \w I will drive them out|strong="H3423"\w*, \w as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w has spoken|strong="H1696"\w*.”
\p \v 13 \w Then Joshua|strong="H3091"\w* \w blessed|strong="H1288"\w* \w Caleb|strong="H3612"\w* \w son|strong="H1121"\w* \w of Jephunneh|strong="H3312"\w* \w and gave|strong="H5414"\w* \w him|strong="H853"\w* \w Hebron|strong="H2275"\w* \w as his inheritance|strong="H5159"\w*. \v 14 \w Therefore|strong="H5921"\w* \w Hebron|strong="H2275"\w* \w belongs to|strong="H1961"\w* \w Caleb|strong="H3612"\w* \w son|strong="H1121"\w* \w of Jephunneh|strong="H3312"\w* \w the Kenizzite|strong="H7074"\w* \w as an inheritance|strong="H5159"\w* \w to|strong="H5704"\w* \w this|strong="H2088"\w* \w day|strong="H3117"\w*, \w because|strong="H3282"\w* \w he wholly|strong="H4390"\w* \w followed|strong="H310"\w* \w the LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*. \v 15 (\w Hebron|strong="H2275"\w* \w used to be|strong="H6440"\w* \w called|strong="H8034"\w* \w Kiriath-arba|strong="H7153"\w*, \w after Arba|strong="H1931"\w*, \w the greatest|strong="H1419"\w* \w man|strong="H120"\w* \w among the Anakim|strong="H6062"\w*.)
\p \w Then the land|strong="H776"\w* \w had rest|strong="H8252"\w* \w from war|strong="H4421"\w*.
\c 15
\s1 Judah’s Inheritance
\p \v 1 \w Now the allotment|strong="H1486"\w* \w for the clans|strong="H4940"\w* \w of the tribe|strong="H4294"\w* \w of Judah|strong="H3063"\w* \w extended|strong="H1961"\w* \w to|strong="H413"\w* \w the border|strong="H1366"\w* \w of Edom|strong="H123"\w*, \w to the Wilderness|strong="H4057"\w* \w of Zin|strong="H6790"\w* \w at the extreme|strong="H7097"\w* \w southern boundary|strong="H8486"\w*:
\b 
\li1 \v 2 Their \w southern|strong="H5045"\w* \w border|strong="H1366"\w* \w started|strong="H1961"\w* \w at the bay|strong="H3956"\w* \w on|strong="H4480"\w* \w the southern|strong="H5045"\w* \w tip|strong="H7097"\w* \w of the Salt Sea|strong="H3220"\w*,\f + \fr 15:2 \ft That is, the Dead Sea; also in verse 5\f* \v 3 \w proceeded|strong="H3318"\w* \w south|strong="H5045"\w* \w of the Ascent|strong="H4610"\w* \w of Akrabbim|strong="H4610"\w*,\f + \fr 15:3 \ft Or \fqa the Ascent of Scorpions \ft or \fqa Scorpion Pass\f* \w continued on|strong="H5674"\w* \w to Zin|strong="H6790"\w*, \w went over|strong="H5927"\w* \w to the south|strong="H5045"\w* \w of Kadesh-barnea|strong="H6947"\w*, \w ran past|strong="H5674"\w* \w Hezron|strong="H2696"\w* \w up to|strong="H5927"\w* \w Addar|strong="H146"\w*, \w and curved|strong="H5437"\w* \w toward Karka|strong="H7173"\w*. \v 4 \w It proceeded|strong="H5674"\w* \w to Azmon|strong="H6111"\w*, \w joined the Brook|strong="H5158"\w* \w of Egypt|strong="H4714"\w*, \w and ended|strong="H8444"\w* \w at the Sea|strong="H3220"\w*.\f + \fr 15:4 \ft That is, the Mediterranean Sea, also called the Great Sea; also in verses 11, 12, and 47\f* \w This|strong="H2088"\w* \w was|strong="H1961"\w* their\f + \fr 15:4 \ft LXX; Hebrew \fqa your\f* \w southern|strong="H5045"\w* \w border|strong="H1366"\w*.
\li1 \v 5 \w The eastern|strong="H6924"\w* \w border|strong="H1366"\w* \w was the Salt Sea|strong="H3220"\w* \w as far as|strong="H5704"\w* \w the mouth|strong="H7097"\w* \w of the Jordan|strong="H3383"\w*.
\li1 \w The northern|strong="H6828"\w* \w border started|strong="H1366"\w* \w from|strong="H6285"\w* \w the bay|strong="H3956"\w* \w of the sea|strong="H3220"\w* \w at the mouth|strong="H7097"\w* \w of the Jordan|strong="H3383"\w*, \v 6 \w went up|strong="H5927"\w* \w to Beth-hoglah|strong="H1031"\w*, \w proceeded|strong="H5674"\w* \w north|strong="H6828"\w* \w of Beth-arabah|strong="H1026"\w*, \w and went up|strong="H5927"\w* \w to the Stone|strong="H68"\w* \w of Bohan|strong="H932"\w* \w son|strong="H1121"\w* \w of Reuben|strong="H7205"\w*. \v 7 \w Then the border|strong="H1366"\w* \w went up|strong="H5927"\w* \w to Debir|strong="H1688"\w* \w from the Valley|strong="H6010"\w* \w of Achor|strong="H5911"\w*, \w turning|strong="H6437"\w* \w north|strong="H6828"\w* \w to|strong="H413"\w* \w Gilgal|strong="H1537"\w*, \w which|strong="H834"\w* \w faces|strong="H5227"\w* \w the Ascent|strong="H4608"\w* \w of Adummim|strong="H131"\w* \w south|strong="H5045"\w* \w of the ravine|strong="H5158"\w*. \w It|strong="H1366"\w* \w continued|strong="H5674"\w* \w along|strong="H413"\w* \w the waters|strong="H4325"\w* \w of En-shemesh|strong="H5885"\w* \w and came out|strong="H1961"\w* \w at|strong="H413"\w* \w En-rogel|strong="H5883"\w*. \v 8 \w From there the border|strong="H1366"\w* \w went up|strong="H5927"\w* \w the Valley of Ben-hinnom|strong="H1516"\w* \w along|strong="H413"\w* \w the southern|strong="H5045"\w* \w slope|strong="H3802"\w* \w of the Jebusites|strong="H2983"\w* \w (that is|strong="H1931"\w*, \w Jerusalem|strong="H3389"\w*) \w and ascended|strong="H5927"\w* \w to|strong="H413"\w* \w the top|strong="H7218"\w* \w of the hill|strong="H2022"\w* \w that|strong="H834"\w* \w faces|strong="H5921"\w* \w the Valley of Hinnom|strong="H1516"\w* \w on the west|strong="H3220"\w*, \w at the northern|strong="H6828"\w* \w end|strong="H7097"\w* \w of the Valley|strong="H6010"\w* \w of Rephaim|strong="H7497"\w*. \v 9 \w From the hilltop|strong="H7218"\w* \w the border|strong="H1366"\w* \w curved|strong="H8388"\w* \w to|strong="H413"\w* \w the spring|strong="H4599"\w* \w of the Waters|strong="H4325"\w* \w of Nephtoah|strong="H5318"\w*, \w proceeded|strong="H3318"\w* \w to|strong="H413"\w* \w the cities|strong="H5892"\w* \w of Mount|strong="H2022"\w* \w Ephron|strong="H6085"\w*, \w and then bent around|strong="H8388"\w* \w toward Baalah|strong="H1173"\w* \w (that is|strong="H1931"\w*, \w Kiriath-jearim)|strong="H7157"\w*. \v 10 \w The border|strong="H1366"\w* \w curled|strong="H5437"\w* \w westward|strong="H3220"\w* \w from Baalah|strong="H1173"\w* \w to|strong="H413"\w* \w Mount|strong="H2022"\w* \w Seir|strong="H8165"\w*, \w ran|strong="H5674"\w* \w along|strong="H413"\w* \w the northern|strong="H6828"\w* \w slope|strong="H3802"\w* \w of Mount|strong="H2022"\w* \w Jearim|strong="H3297"\w* \w (that is|strong="H1931"\w*, \w Chesalon|strong="H3693"\w*), \w went down|strong="H3381"\w* \w to Beth-shemesh|strong="H1053"\w*, \w and crossed|strong="H5674"\w* \w to Timnah|strong="H8553"\w*. \v 11 \w Then it|strong="H1366"\w* \w went out|strong="H3318"\w* \w to|strong="H413"\w* \w the northern|strong="H6828"\w* \w slope|strong="H3802"\w* \w of Ekron|strong="H6138"\w*, \w curved|strong="H8388"\w* \w toward Shikkeron|strong="H7942"\w*, \w proceeded|strong="H5674"\w* \w to Mount|strong="H2022"\w* \w Baalah|strong="H1173"\w*, \w went on|strong="H3318"\w* \w to Jabneel|strong="H2995"\w*, \w and ended|strong="H1961"\w* \w at the Sea|strong="H3220"\w*.
\li1 \v 12 \w And the western|strong="H3220"\w* \w border|strong="H1366"\w* \w was the coastline|strong="H1366"\w* \w of the Great|strong="H1419"\w* \w Sea|strong="H3220"\w*.
\p \w These|strong="H2088"\w* \w are the boundaries|strong="H1366"\w* \w around|strong="H5439"\w* \w the clans|strong="H4940"\w* \w of the descendants|strong="H1121"\w* \w of Judah|strong="H3063"\w*.
\s1 Caleb’s Portion and Conquest
\r (\ref Judges 1:8–26|JDG 1:8-26\ref*)
\p \v 13 \w According|strong="H413"\w* \w to the LORD’s|strong="H3068"\w* \w command|strong="H6310"\w* \w to him|strong="H3091"\w*, \w Joshua gave|strong="H5414"\w* \w Caleb|strong="H3612"\w* \w son|strong="H1121"\w* \w of Jephunneh|strong="H3312"\w* \w a portion|strong="H2506"\w* \w among|strong="H8432"\w* \w the sons|strong="H1121"\w* \w of Judah|strong="H3063"\w* — \w Kiriath-arba|strong="H7153"\w*, \w that is|strong="H1931"\w*, \w Hebron|strong="H2275"\w*. (\w Arba was the forefather|strong="H1"\w* \w of Anak|strong="H6061"\w*.) \v 14 \w And Caleb|strong="H3612"\w* \w drove out|strong="H3423"\w* \w from there|strong="H8033"\w* \w the three|strong="H7969"\w* \w sons|strong="H1121"\w* \w of Anak|strong="H6061"\w* — \w the descendants of|strong="H853"\w* \w Sheshai|strong="H8344"\w*, \w Ahiman|strong="H289"\w*, \w and Talmai|strong="H8526"\w*, \w the children|strong="H3211"\w* \w of Anak|strong="H6061"\w*.
\p \v 15 \w From there|strong="H8033"\w* \w he marched|strong="H5927"\w* \w against|strong="H413"\w* \w the inhabitants|strong="H3427"\w* \w of Debir|strong="H1688"\w* (\w formerly|strong="H6440"\w* \w known as|strong="H8034"\w* \w Kiriath-sepher|strong="H7158"\w*). \v 16 \w And Caleb|strong="H3612"\w* \w said|strong="H559"\w*, “\w To the man who|strong="H834"\w* \w strikes down|strong="H5221"\w* \w Kiriath-sepher|strong="H7158"\w* \w and captures it|strong="H3920"\w*, \w I will give|strong="H5414"\w* \w my daughter|strong="H1323"\w* \w Acsah|strong="H5915"\w* \w in marriage|strong="H802"\w*.” \v 17 \w So Othniel|strong="H6274"\w* \w son|strong="H1121"\w* \w of Caleb’s|strong="H3612"\w* \w brother|strong="H251"\w* \w Kenaz|strong="H7073"\w* \w captured the city|strong="H3920"\w*, \w and Caleb gave|strong="H5414"\w* \w his daughter|strong="H1323"\w* \w Acsah|strong="H5915"\w* to him \w in marriage|strong="H802"\w*.
\p \v 18 \w One day|strong="H1961"\w* \w Acsah came to Othniel|strong="H935"\w* \w and urged him|strong="H5496"\w*\f + \fr 15:18 \ft Hebrew and some LXX manuscripts; other LXX manuscripts \fqa and he urged her\ft ; see \ref Judges 1:14|JDG 1:14\ref*.\f* \w to ask|strong="H7592"\w* \w her father|strong="H1"\w* \w for|strong="H854"\w* \w a field|strong="H7704"\w*. \w When she got off|strong="H6795"\w* \w her donkey|strong="H2543"\w*, \w Caleb|strong="H3612"\w* \w asked|strong="H559"\w* her, “\w What|strong="H4100"\w* do you desire?”
\p \v 19 “\w Give|strong="H5414"\w* me \w a blessing|strong="H1293"\w*,” \w she answered|strong="H559"\w*. “\w Since|strong="H3588"\w* \w you have given me|strong="H5414"\w* \w land|strong="H776"\w* \w in the Negev|strong="H5045"\w*, \w give me|strong="H5414"\w* \w springs|strong="H1543"\w* \w of water|strong="H4325"\w* as well.”
\p \w So Caleb gave|strong="H5414"\w* her \w both the upper|strong="H5942"\w* \w and lower|strong="H8482"\w* \w springs|strong="H1543"\w*.
\s1 The Cities of Judah
\p \v 20 \w This|strong="H2063"\w* \w is the inheritance|strong="H5159"\w* \w of the clans|strong="H4940"\w* \w of the tribe|strong="H4294"\w* \w of Judah|strong="H3063"\w*. \v 21 \w These were|strong="H1961"\w* \w the southernmost|strong="H7097"\w* \w cities|strong="H5892"\w* \w of the tribe|strong="H4294"\w* \w of Judah|strong="H3063"\w* \w in the Negev|strong="H5045"\w* \w toward|strong="H413"\w* \w the border|strong="H1366"\w* \w of Edom|strong="H123"\w*:
\b 
\li1 \w Kabzeel|strong="H6909"\w*, \w Eder|strong="H5740"\w*, \w Jagur|strong="H3017"\w*, \v 22 \w Kinah|strong="H7016"\w*, \w Dimonah|strong="H1776"\w*, \w Adadah|strong="H5735"\w*, \v 23 \w Kedesh|strong="H6943"\w*, \w Hazor|strong="H2674"\w*, \w Ithnan|strong="H3497"\w*, \v 24 \w Ziph|strong="H2128"\w*, \w Telem|strong="H2928"\w*, \w Bealoth|strong="H1175"\w*, \v 25 \w Hazor-hadattah|strong="H2675"\w*, \w Kerioth-hezron|strong="H7152"\w* \w (that is|strong="H1931"\w*, \w Hazor|strong="H2674"\w*), \v 26 \w Amam|strong="H538"\w*, \w Shema|strong="H8090"\w*, \w Moladah|strong="H4137"\w*, \v 27 \w Hazar-gaddah|strong="H2693"\w*, \w Heshmon|strong="H2829"\w*, \w Beth-pelet|strong="H1046"\w*, \v 28 \w Hazar-shual|strong="H2705"\w*, \w Beersheba|strong="H884"\w*, \w Biziothiah|strong="H964"\w*, \v 29 \w Baalah|strong="H1173"\w*, \w Iim|strong="H5864"\w*, \w Ezem|strong="H6107"\w*, \v 30 \w Eltolad|strong="H513"\w*, \w Chesil|strong="H3686"\w*, \w Hormah|strong="H2767"\w*, \v 31 \w Ziklag|strong="H6860"\w*, \w Madmannah|strong="H4089"\w*, \w Sansannah|strong="H5578"\w*, \v 32 \w Lebaoth|strong="H3822"\w*, \w Shilhim|strong="H7978"\w*, \w Ain|strong="H5871"\w*, \w and Rimmon|strong="H7417"\w*— \w twenty-nine|strong="H6242"\w* \w cities|strong="H5892"\w* \w in all|strong="H3605"\w*, \w along with their villages|strong="H2691"\w*.
\p \v 33 \w These were in the foothills|strong="H8219"\w*:\f + \fr 15:33 \ft Hebrew \fqa Shephelah \ft or \fqa lowlands\ft ; that is, the western foothills of Judea\f*
\b 
\li1 \w Eshtaol|strong="H847"\w*, \w Zorah|strong="H6881"\w*, \w Ashnah|strong="H823"\w*, \v 34 \w Zanoah|strong="H2182"\w*, \w En-gannim|strong="H5873"\w*, \w Tappuah|strong="H8599"\w*, \w Enam|strong="H5879"\w*, \v 35 \w Jarmuth|strong="H3412"\w*, \w Adullam|strong="H5725"\w*, \w Socoh|strong="H7755"\w*, \w Azekah|strong="H5825"\w*, \v 36 \w Shaaraim|strong="H8189"\w*, \w Adithaim|strong="H5723"\w*, \w and Gederah|strong="H1449"\w* \w (or Gederothaim)|strong="H1453"\w*— \w fourteen|strong="H702"\w* \w cities|strong="H5892"\w*, \w along with their villages|strong="H2691"\w*.
\li1 \v 37 \w Zenan|strong="H6799"\w*, \w Hadashah|strong="H2322"\w*, \w Migdal-gad|strong="H4028"\w*, \v 38 \w Dilan|strong="H1810"\w*, \w Mizpeh|strong="H4708"\w*, \w Joktheel|strong="H3371"\w*, \v 39 \w Lachish|strong="H3923"\w*, \w Bozkath|strong="H1218"\w*, \w Eglon|strong="H5700"\w*, \v 40 \w Cabbon|strong="H3522"\w*, \w Lahmas|strong="H3903"\w*, \w Chitlish|strong="H3798"\w*, \v 41 \w Gederoth|strong="H1450"\w*, \w Beth-dagon|strong="H1016"\w*, \w Naamah|strong="H5279"\w*, \w and Makkedah|strong="H4719"\w*— \w sixteen|strong="H8337"\w* \w cities|strong="H5892"\w*, \w along with their villages|strong="H2691"\w*.
\li1 \v 42 \w Libnah|strong="H3841"\w*, \w Ether|strong="H6281"\w*, \w Ashan|strong="H6228"\w*, \v 43 \w Iphtah|strong="H3316"\w*, \w Ashnah|strong="H823"\w*, \w Nezib|strong="H5334"\w*, \v 44 \w Keilah|strong="H7084"\w*, \w Achzib|strong="H392"\w*, \w and Mareshah|strong="H4762"\w*— \w nine|strong="H8672"\w* \w cities|strong="H5892"\w*, \w along with their villages|strong="H2691"\w*.
\li1 \v 45 \w Ekron|strong="H6138"\w*, \w with its towns|strong="H1323"\w* \w and villages|strong="H2691"\w*; \v 46 \w from Ekron|strong="H6138"\w* \w to the sea|strong="H3220"\w*, \w all|strong="H3605"\w* \w the cities|strong="H834"\w* \w near|strong="H5921"\w* \w Ashdod|strong="H795"\w*, \w along with their villages|strong="H2691"\w*; \v 47 \w Ashdod|strong="H795"\w*, \w with its towns|strong="H1323"\w* \w and villages|strong="H2691"\w*; \w Gaza|strong="H5804"\w*, \w with its towns|strong="H1323"\w* \w and villages|strong="H2691"\w*, \w as far as|strong="H5704"\w* \w the Brook|strong="H5158"\w* \w of Egypt|strong="H4714"\w* \w and the coastline|strong="H1366"\w* \w of the Great|strong="H1366"\w* \w Sea|strong="H3220"\w*.
\p \v 48 \w These were in the hill country|strong="H2022"\w*:
\b 
\li1 \w Shamir|strong="H8069"\w*, \w Jattir|strong="H3492"\w*, \w Socoh|strong="H7755"\w*, \v 49 \w Dannah|strong="H1837"\w*, \w Kiriath-sannah|strong="H7158"\w* \w (that is|strong="H1931"\w*, \w Debir|strong="H1688"\w*), \v 50 \w Anab|strong="H6024"\w*, \w Eshtemoh|strong="H851"\w*, \w Anim|strong="H6044"\w*, \v 51 \w Goshen|strong="H1657"\w*, \w Holon|strong="H2473"\w*, \w and Giloh|strong="H1542"\w*— \w eleven|strong="H259"\w* \w cities|strong="H5892"\w*, \w along with their villages|strong="H2691"\w*.
\li1 \v 52 \w Arab|strong="H694"\w*, \w Dumah|strong="H7316"\w*, \w Eshan|strong="H824"\w*, \v 53 \w Janim|strong="H3241"\w*, \w Beth-tappuah|strong="H1054"\w*, \w Aphekah|strong="H664"\w*, \v 54 \w Humtah|strong="H2547"\w*, \w Kiriath-arba|strong="H7153"\w* \w (that is|strong="H1931"\w*, \w Hebron|strong="H2275"\w*), \w and Zior|strong="H6730"\w*— \w nine|strong="H8672"\w* \w cities|strong="H5892"\w*, \w along with their villages|strong="H2691"\w*.
\li1 \v 55 \w Maon|strong="H4584"\w*, \w Carmel|strong="H3760"\w*, \w Ziph|strong="H2128"\w*, \w Juttah|strong="H3194"\w*, \v 56 \w Jezreel|strong="H3157"\w*, \w Jokdeam|strong="H3347"\w*, \w Zanoah|strong="H2182"\w*, \v 57 \w Kain|strong="H7014"\w*, \w Gibeah|strong="H1390"\w*, \w and Timnah|strong="H8553"\w*— \w ten|strong="H6235"\w* \w cities|strong="H5892"\w*, \w along with their villages|strong="H2691"\w*.
\li1 \v 58 \w Halhul|strong="H2478"\w*, \w Beth-zur|strong="H1049"\w*, \w Gedor|strong="H1446"\w*, \v 59 \w Maarath|strong="H4638"\w*, \w Beth-anoth|strong="H1042"\w*, \w and Eltekon|strong="H515"\w*— \w six|strong="H8337"\w* \w cities|strong="H5892"\w*, \w along with their villages|strong="H2691"\w*.
\li1 \v 60 \w Kiriath-baal|strong="H7154"\w* \w (that is|strong="H1931"\w*, \w Kiriath-jearim|strong="H7157"\w*), \w and Rabbah|strong="H7237"\w*— \w two|strong="H8147"\w* \w cities|strong="H5892"\w*, \w along with their villages|strong="H2691"\w*.
\p \v 61 \w These were in the wilderness|strong="H4057"\w*:
\b 
\li1 \w Beth-arabah|strong="H1026"\w*, \w Middin|strong="H4081"\w*, \w Secacah|strong="H5527"\w*, \v 62 \w Nibshan|strong="H5044"\w*, \w the City of Salt|strong="H5898"\w*, \w and En-gedi|strong="H5872"\w*— \w six|strong="H8337"\w* \w cities|strong="H5892"\w*, \w along with their villages|strong="H2691"\w*.
\p \v 63 \w But the descendants|strong="H1121"\w* \w of Judah|strong="H3063"\w* \w could|strong="H3201"\w* \w not|strong="H3808"\w* \w drive out|strong="H3423"\w* \w the Jebusites|strong="H2983"\w* \w living|strong="H3427"\w* \w in Jerusalem|strong="H3389"\w*. \w So to|strong="H5704"\w* \w this|strong="H2088"\w* \w day|strong="H3117"\w* \w the Jebusites|strong="H2983"\w* \w live|strong="H3427"\w* \w there|strong="H3389"\w* \w among the descendants|strong="H1121"\w* \w of Judah|strong="H3063"\w*.
\c 16
\s1 Ephraim’s Inheritance
\p \v 1 \w The allotment|strong="H1486"\w* \w for the descendants|strong="H1121"\w* \w of Joseph|strong="H3130"\w* \w extended|strong="H3318"\w* \w from the Jordan|strong="H3383"\w* \w at Jericho|strong="H3405"\w* \w to the waters|strong="H4325"\w* \w of Jericho|strong="H3405"\w* \w on the east|strong="H4217"\w*, \w through the wilderness|strong="H4057"\w* \w that goes up|strong="H5927"\w* \w from Jericho|strong="H3405"\w* \w into the hill country|strong="H2022"\w* \w of Bethel|strong="H1008"\w*. \v 2 \w It went on|strong="H3318"\w* \w from|strong="H1008"\w* \w Bethel|strong="H1008"\w* \w (that is, Luz|strong="H3870"\w*)\f + \fr 16:2 \ft LXX (See also \ref Joshua 18:13|JOS 18:13\ref*); Hebrew \fqa from Bethel to Luz\f* \w and proceeded|strong="H5674"\w* \w to|strong="H413"\w* \w the border|strong="H1366"\w* \w of the Archites|strong="H757"\w* \w in Ataroth|strong="H5852"\w*. \v 3 \w Then it descended|strong="H3381"\w* \w westward|strong="H3220"\w* \w to|strong="H413"\w* \w the border|strong="H1366"\w* \w of the Japhletites|strong="H3311"\w* \w as|strong="H5704"\w* \w far as the border|strong="H1366"\w* \w of|strong="H1032"\w* \w Lower|strong="H8481"\w* \w Beth-horon|strong="H1032"\w* \w and on to|strong="H5704"\w* \w Gezer|strong="H1507"\w*, \w and it ended|strong="H1961"\w* \w at the Sea|strong="H3220"\w*.\f + \fr 16:3 \ft That is, the Mediterranean Sea, also called the Great Sea; also in verses 6 and 8\f*
\p \v 4 \w So Ephraim|strong="H669"\w* \w and Manasseh|strong="H4519"\w*, \w the sons|strong="H1121"\w* \w of Joseph|strong="H3130"\w*, \w received their inheritance|strong="H5157"\w*. \v 5 \w This was|strong="H1961"\w* \w the territory|strong="H1366"\w* \w of the descendants|strong="H1121"\w* \w of Ephraim|strong="H669"\w* \w by their clans|strong="H4940"\w*:
\pmo \w The border|strong="H1366"\w* \w of their inheritance|strong="H5159"\w* \w went from Ataroth-addar|strong="H5853"\w* \w in the east|strong="H4217"\w* \w to Upper|strong="H5945"\w* \w Beth-horon|strong="H1032"\w* \v 6 \w and out toward|strong="H3318"\w* \w the Sea|strong="H3220"\w*. \w From Michmethath|strong="H4366"\w* \w on the north|strong="H6828"\w* \w it|strong="H1366"\w* \w turned|strong="H5437"\w* \w eastward|strong="H4217"\w* \w toward Taanath-shiloh|strong="H8387"\w* \w and passed by|strong="H5674"\w* \w it|strong="H853"\w* \w to Janoah|strong="H3239"\w* \w on the east|strong="H4217"\w*. \v 7 \w From Janoah|strong="H3239"\w* \w it went down|strong="H3381"\w* \w to Ataroth|strong="H5852"\w* \w and Naarah|strong="H5292"\w*, \w and then reached|strong="H6293"\w* \w Jericho|strong="H3405"\w* \w and came out|strong="H3318"\w* \w at the Jordan|strong="H3383"\w*. \v 8 \w From Tappuah|strong="H8599"\w* \w the border|strong="H1366"\w* \w went|strong="H1980"\w* \w westward|strong="H3220"\w* \w to the Brook|strong="H5158"\w* \w of Kanah|strong="H7071"\w* \w and ended|strong="H1961"\w* \w at the Sea|strong="H3220"\w*.
\p \w This|strong="H2063"\w* \w was the inheritance|strong="H5159"\w* \w of the clans|strong="H4940"\w* \w of the tribe|strong="H4294"\w* \w of Ephraim|strong="H669"\w*, \v 9 \w along with all|strong="H3605"\w* \w the cities|strong="H5892"\w* \w and villages|strong="H2691"\w* \w set apart|strong="H3995"\w* \w for the descendants|strong="H1121"\w* \w of Ephraim|strong="H669"\w* \w within|strong="H8432"\w* \w the inheritance|strong="H5159"\w* \w of Manasseh|strong="H4519"\w*. \v 10 \w But they did not|strong="H3808"\w* \w drive out|strong="H3423"\w* \w the Canaanites|strong="H3669"\w* \w who lived|strong="H3427"\w* \w in Gezer|strong="H1507"\w*. \w So the Canaanites|strong="H3669"\w* \w dwell|strong="H3427"\w* \w among|strong="H7130"\w* \w the Ephraimites|strong="H669"\w* \w to|strong="H5704"\w* \w this|strong="H2088"\w* \w day|strong="H3117"\w*, \w but they are|strong="H1961"\w* \w forced|strong="H4522"\w* \w laborers|strong="H5647"\w*.
\c 17
\s1 Manasseh’s Western Inheritance
\p \v 1 \w Now this was|strong="H1961"\w* \w the allotment|strong="H1486"\w* \w for the tribe|strong="H4294"\w* \w of Manasseh|strong="H4519"\w* \w as Joseph’s|strong="H3130"\w* \w firstborn son|strong="H1060"\w*, \w namely for Machir|strong="H4353"\w* \w the firstborn|strong="H1060"\w* \w of Manasseh|strong="H4519"\w* \w and father|strong="H1"\w* \w of the Gileadites|strong="H1568"\w*, \w who had received|strong="H1961"\w* \w Gilead|strong="H1568"\w* \w and Bashan|strong="H1316"\w* \w because|strong="H3588"\w* \w Machir|strong="H1931"\w* \w was|strong="H1961"\w* \w a man|strong="H376"\w* \w of war|strong="H4421"\w*. \v 2 \w So this allotment was|strong="H1961"\w* \w for the rest|strong="H3498"\w* \w of the descendants|strong="H1121"\w* \w of Manasseh|strong="H4519"\w* — \w the clans|strong="H1121"\w* \w of Abiezer|strong="H44"\w*,\f + \fr 17:2 \fqa Abiezer \ft is a variant of \fqa Iezer\ft ; see \ref Numbers 26:30|NUM 26:30\ref*.\f* \w Helek|strong="H2507"\w*, \w Asriel|strong="H844"\w*, \w Shechem|strong="H7928"\w*, \w Hepher|strong="H2660"\w*, \w and Shemida|strong="H8061"\w*. \w These|strong="H428"\w* \w are the other male|strong="H2145"\w* \w descendants|strong="H1121"\w* \w of the clans|strong="H4940"\w* \w of Manasseh|strong="H4519"\w* \w son|strong="H1121"\w* \w of Joseph|strong="H3130"\w*.
\p \v 3 \w But Zelophehad|strong="H6765"\w* \w son|strong="H1121"\w* \w of Hepher|strong="H2660"\w* (\w the son|strong="H1121"\w* \w of Gilead|strong="H1568"\w*, \w the son|strong="H1121"\w* \w of Machir|strong="H4353"\w*, \w the son|strong="H1121"\w* \w of Manasseh|strong="H4519"\w*) \w had|strong="H1961"\w* \w no|strong="H3808"\w* \w sons|strong="H1121"\w* \w but|strong="H3588"\w* \w only|strong="H518"\w* \w daughters|strong="H1323"\w*. \w These|strong="H428"\w* \w are the names|strong="H8034"\w* \w of his daughters|strong="H1323"\w*: \w Mahlah|strong="H4244"\w*, \w Noah|strong="H5270"\w*, \w Hoglah|strong="H2295"\w*, \w Milcah|strong="H4435"\w*, \w and Tirzah|strong="H8656"\w*. \v 4 \w They approached|strong="H7126"\w* \w Eleazar|strong="H499"\w* \w the priest|strong="H3548"\w*, \w Joshua|strong="H3091"\w* \w son|strong="H1121"\w* \w of Nun|strong="H5126"\w*, \w and the leaders|strong="H5387"\w*, \w and said|strong="H559"\w*, “\w The LORD|strong="H3068"\w* \w commanded|strong="H6680"\w* \w Moses|strong="H4872"\w* \w to give|strong="H5414"\w* us \w an inheritance|strong="H5159"\w* \w among|strong="H8432"\w* \w our brothers|strong="H251"\w*.”
\p \w So Joshua gave|strong="H5414"\w* them \w an inheritance|strong="H5159"\w* \w among|strong="H8432"\w* \w their father’s|strong="H1"\w* \w brothers|strong="H251"\w*, \w in keeping with|strong="H413"\w* \w the command of|strong="H6310"\w* \w the LORD|strong="H3068"\w*. \v 5 \w Thus ten|strong="H6235"\w* \w shares|strong="H2256"\w* \w fell|strong="H5307"\w* \w to Manasseh|strong="H4519"\w*, \w in addition to|strong="H905"\w* \w the land|strong="H776"\w* \w of Gilead|strong="H1568"\w* \w and Bashan|strong="H1316"\w* \w beyond|strong="H5676"\w* \w the Jordan|strong="H3383"\w*, \v 6 \w because|strong="H3588"\w* \w the daughters|strong="H1323"\w* \w of Manasseh|strong="H4519"\w* \w received|strong="H5157"\w* \w an inheritance|strong="H5159"\w* \w among|strong="H8432"\w* \w his sons|strong="H1121"\w*. \w And the land|strong="H776"\w* \w of Gilead|strong="H1568"\w* \w belonged to|strong="H1961"\w* \w the rest|strong="H3498"\w* \w of the sons|strong="H1121"\w* \w of Manasseh|strong="H4519"\w*.
\b 
\li1 \v 7 \w Now the border|strong="H1366"\w* \w of Manasseh|strong="H4519"\w* \w went|strong="H1961"\w* \w from Asher|strong="H836"\w* \w to Michmethath|strong="H4366"\w* \w near|strong="H5921"\w* \w Shechem|strong="H7927"\w*, \w then|strong="H1980"\w* \w southward|strong="H413"\w* \w to include|strong="H413"\w* \w the inhabitants|strong="H3427"\w* \w of En-tappuah|strong="H5887"\w*. \v 8 \w The region|strong="H776"\w* \w of Tappuah|strong="H8599"\w* \w belonged to|strong="H1961"\w* \w Manasseh|strong="H4519"\w*, \w but Tappuah itself|strong="H8599"\w*, \w on|strong="H413"\w* \w the border|strong="H1366"\w* \w of Manasseh|strong="H4519"\w*, \w belonged to|strong="H1121"\w* \w Ephraim|strong="H669"\w*. \v 9 \w From there the border|strong="H1366"\w* \w continued|strong="H3381"\w* \w southward|strong="H5045"\w* \w to the Brook|strong="H5158"\w* \w of Kanah|strong="H7071"\w*. \w There were cities|strong="H5892"\w* \w belonging to Ephraim|strong="H669"\w* \w among|strong="H8432"\w* \w the cities|strong="H5892"\w* \w of Manasseh|strong="H4519"\w*, \w but the border|strong="H1366"\w* \w of Manasseh|strong="H4519"\w* \w was on the north side|strong="H6828"\w* \w of the brook|strong="H5158"\w* \w and ended|strong="H1961"\w* \w at the Sea|strong="H3220"\w*.\f + \fr 17:9 \ft That is, the Mediterranean Sea, also called the Great Sea; also in verse 10\f* \v 10 \w Ephraim’s territory|strong="H669"\w* \w was to the south|strong="H5045"\w*, \w and Manasseh’s|strong="H4519"\w* \w was|strong="H1961"\w* \w to the north|strong="H6828"\w*, \w having the Sea|strong="H3220"\w* \w as its border|strong="H1366"\w* \w and adjoining|strong="H6293"\w* \w Asher|strong="H836"\w* \w on the north|strong="H6828"\w* \w and Issachar|strong="H3485"\w* \w on the east|strong="H4217"\w*.
\li1 \v 11 \w Within Issachar|strong="H3485"\w* \w and Asher|strong="H836"\w*, \w Manasseh|strong="H4519"\w* \w was assigned|strong="H1961"\w* \w Beth-shean|strong="H1052"\w*, \w Ibleam|strong="H2991"\w*, \w Dor|strong="H1756"\w* \w (that is,|strong="H7969"\w* \w Naphath|strong="H5316"\w*), \w Endor|strong="H5874"\w*, \w Taanach|strong="H8590"\w*, \w and|strong="H3427"\w* \w Megiddo|strong="H4023"\w*, \w each with their surrounding settlements|strong="H1323"\w*.
\p \v 12 \w But the descendants|strong="H1121"\w* \w of Manasseh|strong="H4519"\w* \w were unable|strong="H3201"\w* \w to occupy|strong="H3423"\w* \w these|strong="H428"\w* \w cities|strong="H5892"\w*, \w because the Canaanites|strong="H3669"\w* \w were determined|strong="H2974"\w* \w to stay|strong="H3427"\w* \w in this|strong="H2063"\w* \w land|strong="H776"\w*. \v 13 \w However|strong="H1961"\w*, \w when|strong="H3588"\w* \w the Israelites|strong="H1121"\w* \w grew stronger|strong="H2388"\w*, \w they put|strong="H5414"\w* \w the Canaanites|strong="H3669"\w* \w to forced labor|strong="H4522"\w*; \w but they failed|strong="H3808"\w* \w to drive them out|strong="H3423"\w* \w completely|strong="H3423"\w*.
\p \v 14 \w Then the sons|strong="H1121"\w* \w of Joseph|strong="H3130"\w* \w said|strong="H1696"\w* \w to|strong="H854"\w* \w Joshua|strong="H3091"\w*, “\w Why|strong="H4069"\w* \w have you given|strong="H5414"\w* us \w only|strong="H259"\w* \w one|strong="H259"\w* \w portion|strong="H1486"\w* \w as an inheritance|strong="H5159"\w*? \w We|strong="H589"\w* \w have many|strong="H7227"\w* \w people|strong="H5971"\w*, \w because|strong="H5704"\w* \w the LORD|strong="H3068"\w* \w has blessed us abundantly|strong="H1288"\w*.”
\p \v 15 \w Joshua|strong="H3091"\w* \w answered|strong="H559"\w* \w them|strong="H413"\w*, “\w If|strong="H518"\w* \w you|strong="H859"\w* \w have so many|strong="H7227"\w* \w people|strong="H5971"\w* \w that|strong="H3588"\w* \w the hill country|strong="H2022"\w* \w of Ephraim|strong="H669"\w* \w is too small|strong="H213"\w* for you, \w go|strong="H5927"\w* to \w the forest|strong="H3293"\w* \w and clear|strong="H1254"\w* for yourself \w an area|strong="H8033"\w* \w in the land|strong="H776"\w* \w of the Perizzites|strong="H6522"\w* \w and the Rephaim|strong="H7497"\w*.”
\p \v 16 “\w The hill country|strong="H2022"\w* \w is not|strong="H3808"\w* \w enough|strong="H4672"\w* for us,” \w they|strong="H1121"\w* \w replied|strong="H559"\w*, “\w and all|strong="H3605"\w* \w the Canaanites|strong="H3669"\w* \w who live|strong="H3427"\w* \w in the valley|strong="H6010"\w* \w have iron|strong="H1270"\w* \w chariots|strong="H7393"\w*, \w both in Beth-shean|strong="H1052"\w* \w with its towns|strong="H1323"\w* \w and in the Valley|strong="H6010"\w* \w of Jezreel|strong="H3157"\w*.”
\p \v 17 \w So Joshua|strong="H3091"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w the house|strong="H1004"\w* \w of Joseph|strong="H3130"\w* — \w to Ephraim|strong="H669"\w* \w and Manasseh|strong="H4519"\w* — \w “You have many|strong="H7227"\w* \w people|strong="H5971"\w* \w and great|strong="H1419"\w* \w strength|strong="H3581"\w*. \w You shall not|strong="H3808"\w* \w have|strong="H1961"\w* \w just one|strong="H259"\w* \w allotment|strong="H1486"\w*, \v 18 \w because|strong="H3588"\w* \w the hill country|strong="H2022"\w* \w will be|strong="H1961"\w* yours as well. \w It|strong="H1931"\w* \w is a forest|strong="H3293"\w*; \w clear it|strong="H1254"\w*, \w and its farthest limits|strong="H8444"\w* \w will be|strong="H1961"\w* yours. \w Although|strong="H3588"\w* \w the Canaanites have iron|strong="H1270"\w* \w chariots|strong="H7393"\w* \w and although|strong="H3588"\w* \w they are strong|strong="H2389"\w*, \w you can|strong="H1931"\w* \w drive them out|strong="H3423"\w*.”
\c 18
\s1 The Remainder Divided
\p \v 1 \w Then the whole|strong="H3605"\w* \w congregation|strong="H5712"\w* \w of Israel|strong="H3478"\w* \w assembled|strong="H6950"\w* \w at Shiloh|strong="H7887"\w* \w and set up|strong="H7931"\w* \w the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w* \w there|strong="H8033"\w*. \w And though the land|strong="H776"\w* \w was subdued|strong="H3533"\w* \w before them|strong="H6440"\w*, \v 2 \w there were still|strong="H3498"\w* \w seven|strong="H7651"\w* \w tribes|strong="H7626"\w* \w of Israel|strong="H3478"\w* \w who|strong="H834"\w* \w had not|strong="H3808"\w* \w yet received|strong="H2505"\w* \w their inheritance|strong="H5159"\w*.
\p \v 3 \w So Joshua|strong="H3091"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w the Israelites|strong="H1121"\w*, “\w How long|strong="H5704"\w* \w will you|strong="H859"\w* \w put off|strong="H7503"\w* \w entering|strong="H935"\w* \w and possessing|strong="H3423"\w* \w the land|strong="H776"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of your fathers|strong="H1"\w*, \w has given|strong="H5414"\w* you? \v 4 \w Appoint|strong="H3051"\w* \w three|strong="H7969"\w* \w men|strong="H582"\w* \w from each tribe|strong="H7626"\w*, \w and I will send them out|strong="H7971"\w* \w to survey|strong="H1980"\w* \w the land|strong="H776"\w* \w and map it out|strong="H3789"\w*, \w according to|strong="H6310"\w* \w the inheritance of each|strong="H5159"\w*. \w Then they will return|strong="H935"\w* \w to me|strong="H413"\w* \v 5 \w and divide|strong="H2505"\w* \w the land|strong="H853"\w* \w into seven|strong="H7651"\w* \w portions|strong="H2506"\w*. \w Judah|strong="H3063"\w* \w shall remain|strong="H5975"\w* \w in|strong="H5921"\w* \w their territory|strong="H1366"\w* \w in the south|strong="H5045"\w*, \w and the house|strong="H1004"\w* \w of Joseph|strong="H3130"\w* \w shall remain|strong="H5975"\w* \w in|strong="H5921"\w* \w their territory|strong="H1366"\w* \w in the north|strong="H6828"\w*. \v 6 \w When you|strong="H859"\w* \w have mapped out|strong="H3789"\w* \w the seven|strong="H7651"\w* \w portions|strong="H2506"\w* \w of land|strong="H776"\w* \w and brought|strong="H935"\w* \w it to me|strong="H413"\w*, \w I will cast|strong="H3384"\w* \w lots|strong="H1486"\w* for you \w here|strong="H6311"\w* \w in the presence|strong="H6440"\w* \w of the LORD|strong="H3068"\w* \w our God|strong="H430"\w*.
\p \v 7 \w The Levites|strong="H3881"\w*, \w however|strong="H3588"\w*, \w have no|strong="H369"\w* \w portion|strong="H2506"\w* \w among you|strong="H7130"\w*, \w because|strong="H3588"\w* \w their inheritance|strong="H5159"\w* \w is the priesthood|strong="H3550"\w* \w of the LORD|strong="H3068"\w*. \w And Gad|strong="H1410"\w*, \w Reuben|strong="H7205"\w*, \w and half|strong="H2677"\w* \w the tribe|strong="H7626"\w* \w of Manasseh|strong="H4519"\w* \w have already received|strong="H3947"\w* \w the inheritance|strong="H5159"\w* \w that|strong="H834"\w* \w Moses|strong="H4872"\w* \w the servant|strong="H5650"\w* \w of the LORD|strong="H3068"\w* \w gave|strong="H5414"\w* them \w beyond|strong="H5676"\w* \w the Jordan|strong="H3383"\w* \w to the east|strong="H4217"\w*.”
\p \v 8 \w As the men|strong="H582"\w* \w got up|strong="H6965"\w* \w to go out|strong="H1980"\w*, \w Joshua|strong="H3091"\w* \w commanded|strong="H6680"\w* \w them|strong="H1980"\w* \w to map out|strong="H3789"\w* \w the land|strong="H776"\w*, \w saying|strong="H559"\w*, “\w Go|strong="H1980"\w* \w and survey|strong="H1980"\w* \w the land|strong="H776"\w*, \w map it out|strong="H3789"\w*, \w and return|strong="H7725"\w* \w to me|strong="H413"\w*. \w Then I will cast|strong="H7993"\w* \w lots|strong="H1486"\w* for you \w here|strong="H6311"\w* \w in Shiloh|strong="H7887"\w* \w in the presence|strong="H6440"\w* \w of the LORD|strong="H3068"\w*.”
\p \v 9 \w So the men|strong="H582"\w* \w departed|strong="H1980"\w* \w and went throughout|strong="H5674"\w* \w the land|strong="H776"\w*, \w mapping it|strong="H3789"\w* \w city by city|strong="H5892"\w* \w into seven|strong="H7651"\w* \w portions|strong="H2506"\w*. \w Then they returned|strong="H935"\w* \w with the document|strong="H5612"\w* \w to|strong="H413"\w* \w Joshua|strong="H3091"\w* \w at|strong="H413"\w* \w the camp|strong="H4264"\w* \w in Shiloh|strong="H7887"\w*.
\p \v 10 \w And Joshua|strong="H3091"\w* \w cast|strong="H7993"\w* \w lots|strong="H1486"\w* for them \w in the presence|strong="H6440"\w* \w of the LORD|strong="H3068"\w* \w at Shiloh|strong="H7887"\w*, \w where|strong="H8033"\w* \w he|strong="H3091"\w* \w distributed|strong="H2505"\w* \w the land|strong="H776"\w* \w to the Israelites|strong="H1121"\w* \w according to their divisions|strong="H4256"\w*.
\s1 Benjamin’s Inheritance
\p \v 11 \w The first lot|strong="H1486"\w* \w came up|strong="H5927"\w* \w for the clans|strong="H4940"\w* \w of the tribe|strong="H4294"\w* \w of Benjamin|strong="H1144"\w*. \w Their allotted|strong="H1486"\w* \w territory|strong="H1366"\w* \w lay|strong="H3318"\w* \w between|strong="H996"\w* \w the tribes|strong="H1121"\w* \w of Judah|strong="H3063"\w* \w and|strong="H996"\w* \w Joseph|strong="H3130"\w*:
\b 
\li1 \v 12 \w On the north|strong="H6828"\w* \w side|strong="H6285"\w* \w their border|strong="H1366"\w* \w began|strong="H1961"\w* \w at|strong="H4480"\w* \w the Jordan|strong="H3383"\w*, \w went up|strong="H5927"\w* \w past|strong="H413"\w* \w the northern|strong="H6828"\w* \w slope|strong="H3802"\w* \w of Jericho|strong="H3405"\w*, \w headed|strong="H5927"\w* \w west|strong="H3220"\w* \w through the hill country|strong="H2022"\w*, \w and came out|strong="H1961"\w* \w at the wilderness|strong="H4057"\w* \w of Beth-aven|strong="H1007"\w*. \v 13 \w From there|strong="H8033"\w* \w the border|strong="H1366"\w* \w crossed over|strong="H5674"\w* \w to|strong="H413"\w* \w the southern|strong="H5045"\w* \w slope|strong="H3802"\w* \w of Luz|strong="H3870"\w* \w (that is|strong="H1931"\w*, \w Bethel|strong="H1008"\w*) \w and went down|strong="H3381"\w* \w to Ataroth-addar|strong="H5853"\w* \w on|strong="H5921"\w* \w the hill|strong="H2022"\w* \w south|strong="H5045"\w* \w of|strong="H1032"\w* \w Lower|strong="H8481"\w* \w Beth-horon|strong="H1032"\w*.
\li1 \v 14 \w On the west|strong="H3220"\w* \w side|strong="H6285"\w* \w the border|strong="H1366"\w* \w curved|strong="H8388"\w* \w southward|strong="H5045"\w* \w from|strong="H4480"\w* \w the hill|strong="H2022"\w* \w facing|strong="H5921"\w* \w Beth-horon|strong="H1032"\w* \w on the south|strong="H5045"\w* \w and came out|strong="H1961"\w* \w at|strong="H413"\w* \w Kiriath-baal|strong="H7154"\w* \w (that is|strong="H1931"\w*, \w Kiriath-jearim|strong="H7157"\w*), \w a city|strong="H5892"\w* \w of the sons|strong="H1121"\w* \w of Judah|strong="H3063"\w*. \w This|strong="H2063"\w* \w was the western|strong="H3220"\w* \w side|strong="H6285"\w*.
\li1 \v 15 \w On the south|strong="H5045"\w* \w side|strong="H6285"\w* \w the border|strong="H1366"\w* \w began at the outskirts|strong="H7097"\w* \w of Kiriath-jearim|strong="H7157"\w* \w and extended|strong="H3318"\w* \w westward|strong="H3220"\w* \w to|strong="H413"\w* \w the spring|strong="H4599"\w* \w at the Waters|strong="H4325"\w* \w of Nephtoah|strong="H5318"\w*. \v 16 \w Then it|strong="H1366"\w* \w went down|strong="H3381"\w* \w to|strong="H413"\w* \w the foot|strong="H7097"\w* \w of the hill|strong="H2022"\w* \w that|strong="H834"\w* \w faces|strong="H5921"\w* \w the Valley of Ben-hinnom|strong="H1516"\w* \w at the northern|strong="H6828"\w* \w end of the Valley|strong="H6010"\w* \w of Rephaim|strong="H7497"\w* \w and ran down|strong="H3381"\w* \w the Valley of Hinnom|strong="H1516"\w* \w toward|strong="H413"\w* \w the southern|strong="H5045"\w* \w slope|strong="H3802"\w* \w of the Jebusites|strong="H2983"\w* \w and downward|strong="H3381"\w* \w to En-rogel|strong="H5883"\w*. \v 17 \w From there it curved|strong="H8388"\w* \w northward|strong="H6828"\w* \w and proceeded|strong="H3318"\w* \w to En-shemesh|strong="H5885"\w* \w and on to|strong="H413"\w* \w Geliloth|strong="H1553"\w* \w facing|strong="H5227"\w* \w the Ascent|strong="H4608"\w* \w of Adummim|strong="H131"\w*, \w and continued down|strong="H3381"\w* \w to the Stone|strong="H68"\w* \w of Bohan|strong="H932"\w* \w son|strong="H1121"\w* \w of Reuben|strong="H7205"\w*. \v 18 \w Then it went on|strong="H5674"\w* \w to|strong="H413"\w* \w the northern|strong="H6828"\w* \w slope|strong="H3802"\w* \w of|strong="H4136"\w* \w Beth-arabah|strong="H6160"\w*\f + \fr 18:18 \ft LXX; Hebrew \fqa slope facing the Arabah\f* \w and went down|strong="H3381"\w* \w into the valley|strong="H6160"\w*. \v 19 \w The border|strong="H1366"\w* \w continued|strong="H5674"\w* \w to|strong="H413"\w* \w the northern|strong="H6828"\w* \w slope|strong="H3802"\w* \w of Beth-hoglah|strong="H1031"\w* \w and came out|strong="H1961"\w* \w at|strong="H413"\w* \w the northern|strong="H6828"\w* \w bay|strong="H3956"\w* \w of the Salt Sea|strong="H3220"\w*,\f + \fr 18:19 \ft That is, the Dead Sea\f* \w at|strong="H413"\w* \w the mouth|strong="H5045"\w* \w of the Jordan|strong="H3383"\w*. \w This|strong="H2088"\w* \w was the southern|strong="H5045"\w* \w border|strong="H1366"\w*.
\li1 \v 20 \w On the east|strong="H6924"\w* \w side|strong="H6285"\w* \w the border|strong="H1379"\w* \w was the Jordan|strong="H3383"\w*.
\p \w These|strong="H2063"\w* \w were the borders|strong="H1367"\w* \w around|strong="H5439"\w* \w the inheritance|strong="H5159"\w* \w of the clans|strong="H4940"\w* \w of the tribe|strong="H1121"\w* \w of Benjamin|strong="H1144"\w*.
\p \v 21 \w These were|strong="H1961"\w* \w the cities|strong="H5892"\w* \w of the clans|strong="H4940"\w* \w of the tribe|strong="H4294"\w* \w of Benjamin|strong="H1144"\w*:
\b 
\li1 \w Jericho|strong="H3405"\w*, \w Beth-hoglah|strong="H1031"\w*, \w Emek-keziz|strong="H7104"\w*, \v 22 \w Beth-arabah|strong="H1026"\w*, \w Zemaraim|strong="H6787"\w*, \w Bethel|strong="H1008"\w*, \v 23 \w Avvim|strong="H5761"\w*, \w Parah|strong="H6511"\w*, \w Ophrah|strong="H6084"\w*, \v 24 \w Chephar-ammoni|strong="H3726"\w*, \w Ophni|strong="H6078"\w*, \w and Geba|strong="H1387"\w*— \w twelve|strong="H8147"\w* \w cities|strong="H5892"\w*, \w along with their villages|strong="H2691"\w*.
\li1 \v 25 \w Gibeon|strong="H1391"\w*, \w Ramah|strong="H7414"\w*, \w Beeroth|strong="H881"\w*, \v 26 \w Mizpeh|strong="H4708"\w*, \w Chephirah|strong="H3716"\w*, \w Mozah|strong="H4681"\w*, \v 27 \w Rekem|strong="H7552"\w*, \w Irpeel|strong="H3416"\w*, \w Taralah|strong="H8634"\w*, \v 28 \w Zelah|strong="H6762"\w*, \w Haeleph|strong="H507"\w*, \w Jebus|strong="H2983"\w*\f + \fr 18:28 \ft LXX, Syriac, and Vulgate; Hebrew \fqa the Jebusite\f* \w (that is|strong="H1931"\w*, \w Jerusalem|strong="H3389"\w*), \w Gibeah|strong="H1394"\w*,\f + \fr 18:28 \ft Hebrew \fqa Gibeath \f* \w and Kiriath-jearim|strong="H7157"\w*\f + \fr 18:28 \ft LXX; Hebrew \fqa Kiriath\f*— \w fourteen|strong="H702"\w* \w cities|strong="H5892"\w*, \w along with their villages|strong="H2691"\w*.
\p \w This|strong="H2063"\w* \w was the inheritance|strong="H5159"\w* \w of the clans|strong="H4940"\w* \w of the tribe|strong="H1121"\w* \w of Benjamin|strong="H1144"\w*.
\c 19
\s1 Simeon’s Inheritance
\p \v 1 \w The second|strong="H8145"\w* \w lot|strong="H1486"\w* \w came out|strong="H3318"\w* \w for the clans|strong="H4940"\w* \w of the tribe|strong="H4294"\w* \w of Simeon|strong="H8095"\w*:
\b 
\li1 \w Their inheritance|strong="H5159"\w* \w lay|strong="H1961"\w* \w within|strong="H8432"\w* \w the territory|strong="H5159"\w* \w of Judah|strong="H3063"\w* \v 2 \w and included|strong="H5159"\w* \w Beersheba|strong="H884"\w* \w (or Sheba)|strong="H7652"\w*, \w Moladah|strong="H4137"\w*, \v 3 \w Hazar-shual|strong="H2705"\w*, \w Balah|strong="H1088"\w*, \w Ezem|strong="H6107"\w*, \v 4 \w Eltolad|strong="H513"\w*, \w Bethul|strong="H1329"\w*, \w Hormah|strong="H2767"\w*, \v 5 \w Ziklag|strong="H6860"\w*, \w Beth-marcaboth|strong="H1024"\w*, \w Hazar-susah|strong="H2701"\w*, \v 6 \w Beth-lebaoth|strong="H1034"\w*, \w and Sharuhen|strong="H8287"\w*— \w thirteen|strong="H7969"\w* \w cities|strong="H5892"\w*, \w along with their villages|strong="H2691"\w*.
\li1 \v 7 \w Ain|strong="H5871"\w*, \w Rimmon|strong="H7417"\w*, \w Ether|strong="H6281"\w*, \w and Ashan|strong="H6228"\w*— \w four|strong="H702"\w* \w cities|strong="H5892"\w*, \w along with their villages|strong="H2691"\w*, \v 8 \w and all|strong="H3605"\w* \w the villages|strong="H2691"\w* \w surrounding|strong="H5439"\w* \w these|strong="H428"\w* \w cities|strong="H5892"\w* \w as|strong="H5704"\w* \w far as Baalath-beer|strong="H1192"\w* (\w Ramah|strong="H7414"\w* \w of the Negev|strong="H5045"\w*).
\p \w This|strong="H2063"\w* \w was the inheritance|strong="H5159"\w* \w of the clans|strong="H4940"\w* \w of the tribe|strong="H4294"\w* \w of Simeon|strong="H8095"\w*. \v 9 \w The inheritance|strong="H5159"\w* \w of the Simeonites|strong="H8095"\w* \w was taken from the territory|strong="H2256"\w* \w of Judah|strong="H3063"\w*, \w because|strong="H3588"\w* \w the share|strong="H2506"\w* \w for Judah’s|strong="H3063"\w* \w descendants|strong="H1121"\w* \w was|strong="H1961"\w* \w too large|strong="H7227"\w* for them. \w So the Simeonites|strong="H8095"\w* \w received an inheritance|strong="H5159"\w* \w within|strong="H8432"\w* \w Judah’s portion|strong="H5157"\w*.
\s1 Zebulun’s Inheritance
\p \v 10 \w The third|strong="H7992"\w* \w lot|strong="H1486"\w* \w came up|strong="H5927"\w* \w for the clans|strong="H4940"\w* \w of the tribe|strong="H1121"\w* \w of Zebulun|strong="H2074"\w*:
\b 
\li1 \w The border|strong="H1366"\w* \w of their inheritance|strong="H5159"\w* \w stretched|strong="H1961"\w* \w as far as|strong="H5704"\w* \w Sarid|strong="H8301"\w*. \v 11 \w It|strong="H1366"\w* \w went up|strong="H5927"\w* \w westward|strong="H3220"\w* \w to Maralah|strong="H4831"\w*, \w reached|strong="H6293"\w* \w Dabbesheth|strong="H1708"\w*, \w and met|strong="H6293"\w* \w the brook|strong="H5158"\w* \w east|strong="H5921"\w* \w of Jokneam|strong="H3362"\w*. \v 12 \w From Sarid|strong="H8301"\w* \w it turned|strong="H7725"\w* \w eastward|strong="H6924"\w* \w along|strong="H5921"\w* \w the border|strong="H1366"\w* \w of Chisloth-tabor|strong="H3696"\w* \w and went|strong="H3318"\w* \w on to|strong="H413"\w* \w Daberath|strong="H1705"\w* \w and up|strong="H5927"\w* \w to Japhia|strong="H3309"\w*. \v 13 \w From there|strong="H8033"\w* \w it crossed|strong="H5674"\w* \w eastward|strong="H6924"\w* \w to Gath-hepher|strong="H1662"\w* \w and to Eth-kazin|strong="H6278"\w*; \w it extended|strong="H3318"\w* \w to Rimmon|strong="H7417"\w* \w and curved|strong="H8388"\w* \w around toward Neah|strong="H5269"\w*. \v 14 \w Then the border|strong="H1366"\w* \w circled around|strong="H5437"\w* \w the north side|strong="H6828"\w* \w of Neah|strong="H853"\w* \w to Hannathon|strong="H2615"\w* \w and ended|strong="H1961"\w* \w at the Valley|strong="H1516"\w* \w of Iphtah-el|strong="H3317"\w*. \v 15 \w It also included Kattath|strong="H7005"\w*, \w Nahalal|strong="H5096"\w*, \w Shimron|strong="H8110"\w*, \w Idalah|strong="H3030"\w*, \w and Bethlehem|strong="H1035"\w*. \w There were twelve|strong="H8147"\w* \w cities|strong="H5892"\w*, \w along with their villages|strong="H2691"\w*.
\p \v 16 \w This|strong="H2063"\w* \w was the inheritance|strong="H5159"\w* \w of the clans|strong="H4940"\w* \w of the tribe|strong="H1121"\w* \w of Zebulun|strong="H2074"\w*, \w including these|strong="H428"\w* \w cities|strong="H5892"\w* \w and their villages|strong="H2691"\w*.
\s1 Issachar’s Inheritance
\p \v 17 \w The fourth|strong="H7243"\w* \w lot|strong="H1486"\w* \w came out|strong="H3318"\w* \w for the clans|strong="H4940"\w* \w of the tribe|strong="H1121"\w* \w of Issachar|strong="H3485"\w*:
\b 
\li1 \v 18 \w Their territory|strong="H1366"\w* \w included|strong="H1961"\w* \w Jezreel|strong="H3157"\w*, \w Chesulloth|strong="H3694"\w*, \w Shunem|strong="H7766"\w*, \v 19 \w Hapharaim|strong="H2663"\w*, \w Shion|strong="H7866"\w*, \w Anaharath|strong="H588"\w*, \v 20 \w Rabbith|strong="H7245"\w*, \w Kishion|strong="H7191"\w*, \w Ebez|strong="H77"\w*, \v 21 \w Remeth|strong="H7432"\w*, \w En-gannim|strong="H5873"\w*, \w En-haddah|strong="H5876"\w*, \w and Beth-pazzez|strong="H1048"\w*. \v 22 \w The border|strong="H1366"\w* \w reached|strong="H6293"\w* \w Tabor|strong="H8396"\w*, \w Shahazumah|strong="H7831"\w*, \w and Beth-shemesh|strong="H1053"\w*, \w and ended|strong="H1961"\w* \w at the Jordan|strong="H3383"\w*. \w There were sixteen|strong="H8337"\w* \w cities|strong="H5892"\w*, \w along with their villages|strong="H2691"\w*.
\p \v 23 \w This|strong="H2063"\w* \w was the inheritance|strong="H5159"\w* \w of the clans|strong="H4940"\w* \w of the tribe|strong="H4294"\w* \w of Issachar|strong="H3485"\w*, \w including these cities|strong="H5892"\w* \w and their villages|strong="H2691"\w*.
\s1 Asher’s Inheritance
\p \v 24 \w The fifth|strong="H2549"\w* \w lot|strong="H1486"\w* \w came out|strong="H3318"\w* \w for the clans|strong="H4940"\w* \w of the tribe|strong="H4294"\w* \w of Asher|strong="H836"\w*:
\b 
\li1 \v 25 \w Their territory|strong="H1366"\w* \w included|strong="H1961"\w* \w Helkath|strong="H2520"\w*, \w Hali|strong="H2482"\w*, \w Beten|strong="H991"\w*, \w Achshaph|strong="H407"\w*, \v 26 \w Allammelech|strong="H487"\w*, \w Amad|strong="H6008"\w*, \w and Mishal|strong="H4861"\w*. \w On the west|strong="H3220"\w* \w the border touched|strong="H6293"\w* \w Carmel|strong="H3760"\w* \w and Shihor-libnath|strong="H7884"\w*, \v 27 \w then turned|strong="H7725"\w* \w eastward|strong="H4217"\w* \w toward|strong="H1016"\w* \w Beth-dagon|strong="H1016"\w*, \w touched|strong="H6293"\w* \w Zebulun|strong="H2074"\w* \w and the Valley|strong="H1516"\w* \w of Iphtah-el|strong="H3317"\w*, \w and went north|strong="H6828"\w* \w to Beth-emek|strong="H1025"\w* \w and Neiel|strong="H5272"\w*, \w passing|strong="H3318"\w* \w Cabul|strong="H3521"\w* \w on the left|strong="H8040"\w*. \v 28 \w It went on to Ebron|strong="H5683"\w*,\f + \fr 19:28 \ft Some Hebrew manuscripts \fqa Abdon\ft ; see \ref Joshua 21:30|JOS 21:30\ref*.\f* \w Rehob|strong="H7340"\w*, \w Hammon|strong="H2540"\w*, \w and Kanah|strong="H7071"\w*, \w as|strong="H5704"\w* \w far as Greater|strong="H7227"\w* \w Sidon|strong="H6721"\w*. \v 29 \w The border|strong="H1366"\w* \w then turned back|strong="H7725"\w* \w toward Ramah|strong="H7414"\w* \w as far as|strong="H5704"\w* \w the fortified|strong="H4013"\w* \w city|strong="H5892"\w* \w of Tyre|strong="H6865"\w*, \w turned|strong="H7725"\w* \w toward Hosah|strong="H2621"\w*, \w and came out|strong="H1961"\w* \w at the Sea|strong="H3220"\w*\f + \fr 19:29 \ft That is, the Mediterranean Sea, also called the Great Sea\f* \w in the region|strong="H2256"\w* \w of Achzib|strong="H392"\w*, \v 30 \w Ummah|strong="H5981"\w*, \w Aphek|strong="H663"\w*, \w and Rehob|strong="H7340"\w*. \w There were twenty-two|strong="H6242"\w* \w cities|strong="H5892"\w*, \w along with their villages|strong="H2691"\w*.
\p \v 31 \w This|strong="H2063"\w* \w was the inheritance|strong="H5159"\w* \w of the clans|strong="H4940"\w* \w of the tribe|strong="H4294"\w* \w of Asher|strong="H836"\w*, \w including these|strong="H428"\w* \w cities|strong="H5892"\w* \w and their villages|strong="H2691"\w*.
\s1 Naphtali’s Inheritance
\p \v 32 \w The sixth|strong="H8345"\w* \w lot|strong="H1486"\w* \w came out|strong="H3318"\w* \w for the clans|strong="H4940"\w* \w of the tribe|strong="H1121"\w* \w of Naphtali|strong="H5321"\w*:
\b 
\li1 \v 33 \w Their border|strong="H1366"\w* \w started|strong="H1961"\w* \w at Heleph|strong="H2501"\w* \w and the great tree|strong="H438"\w* \w of Zaanannim|strong="H6815"\w*, \w passing Adami-nekeb|strong="H129"\w* \w and Jabneel|strong="H2995"\w* \w as far as|strong="H5704"\w* \w Lakkum|strong="H3946"\w* \w and ending|strong="H1961"\w* \w at the Jordan|strong="H3383"\w*. \v 34 \w Then the border|strong="H1366"\w* \w turned|strong="H7725"\w* \w westward|strong="H3220"\w* \w to Aznoth-tabor|strong="H243"\w* \w and ran|strong="H3318"\w* \w from there|strong="H8033"\w* \w to Hukkok|strong="H2712"\w*, \w touching|strong="H6293"\w* \w Zebulun|strong="H2074"\w* \w on the south side|strong="H5045"\w*, \w Asher|strong="H836"\w* \w on the west|strong="H3220"\w*, \w and Judah|strong="H3063"\w* \w at the Jordan|strong="H3383"\w*\f + \fr 19:34 \ft Hebrew; LXX \fqa west, and the Jordan\f* \w on the east|strong="H4217"\w*. \v 35 \w The fortified|strong="H4013"\w* \w cities|strong="H5892"\w* \w were Ziddim|strong="H6661"\w*, \w Zer|strong="H6863"\w*, \w Hammath|strong="H2575"\w*, \w Rakkath|strong="H7557"\w*, \w Chinnereth|strong="H3672"\w*, \v 36 \w Adamah|strong="H128"\w*, \w Ramah|strong="H7414"\w*, \w Hazor|strong="H2674"\w*, \v 37 \w Kedesh|strong="H6943"\w*, \w Edrei|strong="H154"\w*, \w En-hazor|strong="H5877"\w*, \v 38 \w Iron|strong="H3375"\w*, \w Migdal-el|strong="H4027"\w*, \w Horem|strong="H2765"\w*, \w Beth-anath|strong="H1043"\w*, \w and Beth-shemesh|strong="H1053"\w*. \w There were nineteen|strong="H8672"\w* \w cities|strong="H5892"\w*, \w along with their villages|strong="H2691"\w*.
\p \v 39 \w This|strong="H2063"\w* \w was the inheritance|strong="H5159"\w* \w of the clans|strong="H4940"\w* \w of the tribe|strong="H4294"\w* \w of Naphtali|strong="H5321"\w*, \w including these cities|strong="H5892"\w* \w and their villages|strong="H2691"\w*.
\s1 Dan’s Inheritance
\p \v 40 \w The seventh|strong="H7637"\w* \w lot|strong="H1486"\w* \w came out|strong="H3318"\w* \w for the clans|strong="H4940"\w* \w of the tribe|strong="H4294"\w* \w of Dan|strong="H1835"\w*:
\b 
\li1 \v 41 \w The territory|strong="H1366"\w* \w of their inheritance|strong="H5159"\w* \w included Zorah|strong="H6881"\w*, \w Eshtaol|strong="H847"\w*, \w Ir-shemesh|strong="H5905"\w*, \v 42 \w Shaalabbin|strong="H8169"\w*, \w Aijalon|strong="H357"\w*, \w Ithlah|strong="H3494"\w*, \v 43 \w Elon|strong="H356"\w*, \w Timnah|strong="H8553"\w*, \w Ekron|strong="H6138"\w*, \v 44 \w Eltekeh|strong="H514"\w*, \w Gibbethon|strong="H1405"\w*, \w Baalath|strong="H1191"\w*, \v 45 \w Jehud|strong="H3055"\w*, \w Bene-berak|strong="H1139"\w*, \w Gath-rimmon|strong="H1667"\w*, \v 46 \w Me-jarkon|strong="H4313"\w*, \w and Rakkon|strong="H7542"\w*, \w including|strong="H5973"\w* \w the territory|strong="H1366"\w* \w across from|strong="H4136"\w* \w Joppa|strong="H3305"\w*.
\p \v 47 (\w Later, when the territory|strong="H1366"\w* \w of the Danites|strong="H1121"\w* \w was lost|strong="H3318"\w* \w to them|strong="H1121"\w*, \w they went up|strong="H5927"\w* \w and fought|strong="H3898"\w* \w against|strong="H5973"\w* \w Leshem|strong="H3959"\w*, \w captured it|strong="H3920"\w*, \w and put it|strong="H5221"\w* \w to the sword|strong="H2719"\w*. \w So they took possession|strong="H3423"\w* \w of Leshem|strong="H853"\w*, \w settled|strong="H3427"\w* there, \w and renamed|strong="H7121"\w* \w it|strong="H3959"\w* \w after|strong="H8034"\w* \w their father|strong="H1"\w* \w Dan|strong="H1835"\w*.)
\p \v 48 \w This|strong="H2063"\w* \w was the inheritance|strong="H5159"\w* \w of the clans|strong="H4940"\w* \w of the tribe|strong="H4294"\w* \w of Dan|strong="H1835"\w*, \w including these|strong="H428"\w* \w cities|strong="H5892"\w* \w and their villages|strong="H2691"\w*.
\s1 Joshua’s Inheritance
\p \v 49 \w When they had finished|strong="H3615"\w* \w distributing|strong="H5157"\w* \w the land|strong="H776"\w* \w into its territories|strong="H1367"\w*, \w the Israelites|strong="H1121"\w* \w gave|strong="H5414"\w* \w Joshua|strong="H3091"\w* \w son|strong="H1121"\w* \w of Nun|strong="H5126"\w* \w an inheritance|strong="H5159"\w* \w among them|strong="H8432"\w*, \v 50 \w as|strong="H5921"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6310"\w*. \w They gave|strong="H5414"\w* him \w the city|strong="H5892"\w* \w of Timnath-serah|strong="H8556"\w*\f + \fr 19:50 \fqa Timnath-serah \ft is also known as \fqa Timnath-heres\ft ; see \ref Judges 2:9|JDG 2:9\ref*.\f* \w in the hill country|strong="H2022"\w* \w of Ephraim|strong="H669"\w*, \w as|strong="H834"\w* \w he requested|strong="H7592"\w*. \w He rebuilt|strong="H1129"\w* \w the city|strong="H5892"\w* \w and settled|strong="H3427"\w* in it.
\p \v 51 \w These are|strong="H428"\w* \w the inheritances|strong="H5159"\w* \w that|strong="H834"\w* \w Eleazar|strong="H499"\w* \w the priest|strong="H3548"\w*, \w Joshua|strong="H3091"\w* \w son|strong="H1121"\w* \w of Nun|strong="H5126"\w*, \w and the heads|strong="H7218"\w* \w of the families|strong="H1"\w* \w distributed|strong="H5157"\w* \w by lot|strong="H1486"\w* \w to the tribes|strong="H4294"\w* \w of Israel|strong="H3478"\w* \w at Shiloh|strong="H7887"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w at the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \w So they finished|strong="H3615"\w* \w dividing up|strong="H2505"\w* \w the land|strong="H776"\w*.
\c 20
\s1 Six Cities of Refuge
\r (\ref Numbers 35:9–34|NUM 35:9-34\ref*; \ref Deuteronomy 4:41–43|DEU 4:41-43\ref*; \ref Deuteronomy 19:1–14|DEU 19:1-14\ref*)
\p \v 1 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Joshua|strong="H3091"\w*, \v 2 “\w Tell|strong="H1696"\w* \w the Israelites|strong="H1121"\w* \w to designate|strong="H5414"\w* \w the cities|strong="H5892"\w* \w of refuge|strong="H4733"\w*, \w as|strong="H834"\w* \w I instructed|strong="H1696"\w* \w you through|strong="H3027"\w* \w Moses|strong="H4872"\w*, \v 3 \w so that anyone|strong="H7523"\w* \w who kills|strong="H5221"\w* \w another|strong="H5315"\w* \w unintentionally|strong="H7684"\w* \w or accidentally|strong="H1097"\w* \w may flee|strong="H5127"\w* \w there|strong="H8033"\w*. \w These will be|strong="H1961"\w* your \w refuge|strong="H4733"\w* \w from the avenger|strong="H1350"\w* \w of blood|strong="H1818"\w*. \v 4 \w When someone flees|strong="H5127"\w* \w to|strong="H413"\w* \w one|strong="H259"\w* \w of these|strong="H428"\w* \w cities|strong="H5892"\w*, \w stands|strong="H5975"\w* \w at the entrance|strong="H6607"\w* \w of the city|strong="H5892"\w* \w gate|strong="H8179"\w*, \w and states|strong="H1696"\w* \w his case|strong="H1697"\w* \w before its elders|strong="H2205"\w*, \w they are to bring|strong="H622"\w* \w him|strong="H853"\w* \w into the city|strong="H5892"\w* \w and give|strong="H5414"\w* him \w a place|strong="H4725"\w* \w to live|strong="H3427"\w* \w among them|strong="H5973"\w*.
\p \v 5 \w Now if|strong="H3588"\w* \w the avenger|strong="H1350"\w* \w of blood|strong="H1818"\w* \w pursues him|strong="H7291"\w*, \w they must not|strong="H3808"\w* \w surrender|strong="H5462"\w* \w the manslayer|strong="H7523"\w* \w into his hand|strong="H3027"\w*, \w because|strong="H3588"\w* \w that man killed|strong="H5221"\w* \w his neighbor|strong="H7453"\w* \w accidentally|strong="H1097"\w* \w without|strong="H3808"\w* \w prior|strong="H8032"\w* \w malice|strong="H8130"\w*. \v 6 \w He is to stay|strong="H3427"\w* \w in that|strong="H1931"\w* \w city|strong="H5892"\w* \w until|strong="H5704"\w* \w he stands|strong="H5975"\w* \w trial|strong="H4941"\w* \w before|strong="H6440"\w* \w the assembly|strong="H5712"\w* \w and until|strong="H5704"\w* \w the death|strong="H4194"\w* \w of the high|strong="H1419"\w* \w priest|strong="H3548"\w* \w serving|strong="H1961"\w* \w at that|strong="H1992"\w* \w time|strong="H3117"\w*. \w Then|strong="H227"\w* \w the manslayer|strong="H7523"\w* \w may return|strong="H7725"\w* \w to his own home|strong="H1004"\w* \w in|strong="H413"\w* \w the city|strong="H5892"\w* \w from which|strong="H834"\w* \w he fled|strong="H5127"\w*.”
\p \v 7 \w So they set apart|strong="H6942"\w* \w Kedesh|strong="H6943"\w* \w in Galilee|strong="H1551"\w* \w in the hill country|strong="H2022"\w* \w of Naphtali|strong="H5321"\w*, \w Shechem|strong="H7927"\w* \w in the hill country|strong="H2022"\w* \w of Ephraim|strong="H669"\w*, \w and Kiriath-arba|strong="H7153"\w* \w (that is|strong="H1931"\w*, \w Hebron|strong="H2275"\w*) \w in the hill country|strong="H2022"\w* \w of Judah|strong="H3063"\w*.
\p \v 8 \w And beyond|strong="H5676"\w* \w the Jordan|strong="H3383"\w*, \w east|strong="H4217"\w* \w of Jericho|strong="H3405"\w*, \w they designated|strong="H5414"\w* \w Bezer|strong="H1221"\w* \w on the wilderness|strong="H4057"\w* \w plateau|strong="H4334"\w* \w from the tribe|strong="H4294"\w* \w of Reuben|strong="H7205"\w*, \w Ramoth|strong="H7216"\w* \w in Gilead|strong="H1568"\w* \w from the tribe|strong="H4294"\w* \w of Gad|strong="H1410"\w*, \w and|strong="H853"\w* \w Golan|strong="H1474"\w* \w in Bashan|strong="H1316"\w* \w from the tribe|strong="H4294"\w* \w of Manasseh|strong="H4519"\w*.
\p \v 9 \w These|strong="H428"\w* \w are|strong="H1961"\w* \w the cities|strong="H5892"\w* \w appointed|strong="H4152"\w* \w for all|strong="H3605"\w* \w the Israelites|strong="H1121"\w* \w and foreigners|strong="H1616"\w* \w among them|strong="H8432"\w*, \w so that anyone|strong="H3605"\w* \w who kills|strong="H5221"\w* \w a person|strong="H5315"\w* \w unintentionally|strong="H7684"\w* \w may flee|strong="H5127"\w* \w there|strong="H8033"\w* \w and not|strong="H3808"\w* \w die|strong="H4191"\w* \w by the hand|strong="H3027"\w* \w of the avenger|strong="H1350"\w* \w of blood|strong="H1818"\w* \w prior|strong="H5704"\w* \w to standing trial|strong="H5975"\w* \w before|strong="H6440"\w* \w the assembly|strong="H5712"\w*.
\c 21
\s1 Forty-Eight Cities for the Levites
\r (\ref Numbers 35:1–8|NUM 35:1-8\ref*; \ref 1 Chronicles 6:54–81|1CH 6:54-81\ref*)
\p \v 1 \w Now the family|strong="H1"\w* \w heads|strong="H7218"\w* \w of the Levites|strong="H3881"\w* \w approached|strong="H5066"\w* \w Eleazar|strong="H499"\w* \w the priest|strong="H3548"\w*, \w Joshua|strong="H3091"\w* \w son|strong="H1121"\w* \w of Nun|strong="H5126"\w*, \w and|strong="H413"\w* \w the heads|strong="H7218"\w* \w of the other tribes|strong="H4294"\w* \w of Israel|strong="H3478"\w* \v 2 \w at Shiloh|strong="H7887"\w* \w in the land|strong="H776"\w* \w of Canaan|strong="H3667"\w* \w and said|strong="H1696"\w* \w to them|strong="H413"\w*, “\w The LORD|strong="H3068"\w* \w commanded|strong="H6680"\w* \w through|strong="H3027"\w* \w Moses|strong="H4872"\w* \w that we be given|strong="H5414"\w* \w cities|strong="H5892"\w* \w in which to live|strong="H3427"\w*, \w together with pasturelands|strong="H4054"\w* \w for our livestock|strong="H929"\w*.”
\p \v 3 \w So by|strong="H413"\w* \w the command|strong="H6310"\w* \w of the LORD|strong="H3068"\w*, \w the Israelites|strong="H1121"\w* \w gave|strong="H5414"\w* \w the Levites|strong="H3881"\w* \w these|strong="H428"\w* \w cities|strong="H5892"\w* \w and|strong="H853"\w* \w their pasturelands|strong="H4054"\w* \w out of their own inheritance|strong="H5159"\w*:
\b 
\li1 \v 4 \w The first lot|strong="H1486"\w* \w came out|strong="H3318"\w* \w for the Kohathite|strong="H6956"\w* \w clans|strong="H4940"\w*. \w The Levites|strong="H3881"\w* \w who were descendants|strong="H1121"\w* \w of Aaron|strong="H175"\w* \w the priest|strong="H3548"\w* \w received|strong="H1961"\w* \w thirteen|strong="H7969"\w* \w cities|strong="H5892"\w* \w by lot|strong="H1486"\w* \w from the tribes|strong="H4294"\w* \w of Judah|strong="H3063"\w*, \w Simeon|strong="H8099"\w*, \w and Benjamin|strong="H1144"\w*.
\li1 \v 5 \w The remaining|strong="H3498"\w* \w descendants|strong="H1121"\w* \w of Kohath|strong="H6955"\w* \w received ten|strong="H6235"\w* \w cities|strong="H5892"\w* \w by lot|strong="H1486"\w* \w from the tribes|strong="H4294"\w* \w of Ephraim|strong="H669"\w*, \w Dan|strong="H1835"\w*, \w and|strong="H2677"\w* \w the half-tribe|strong="H4294"\w* \w of Manasseh|strong="H4519"\w*.
\li1 \v 6 \w The descendants|strong="H1121"\w* \w of Gershon|strong="H1648"\w* \w received thirteen|strong="H7969"\w* \w cities|strong="H5892"\w* \w by lot|strong="H1486"\w* \w from the tribes|strong="H4294"\w* \w of Issachar|strong="H3485"\w*, \w Asher|strong="H836"\w*, \w Naphtali|strong="H5321"\w*, \w and the half-tribe|strong="H2677"\w* \w of Manasseh|strong="H4519"\w* \w in Bashan|strong="H1316"\w*.
\li1 \v 7 \w And the descendants|strong="H1121"\w* \w of Merari|strong="H4847"\w* \w received twelve|strong="H8147"\w* \w cities|strong="H5892"\w* \w from the tribes|strong="H4294"\w* \w of Reuben|strong="H7205"\w*, \w Gad|strong="H1410"\w*, \w and Zebulun|strong="H2074"\w*.
\p \v 8 \w So the Israelites|strong="H1121"\w* \w allotted|strong="H5414"\w* \w to the Levites|strong="H3881"\w* \w these|strong="H428"\w* \w cities|strong="H5892"\w*, \w together with their pasturelands|strong="H4054"\w*, \w as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w through|strong="H3027"\w* \w Moses|strong="H4872"\w*.
\p \v 9 \w From the tribes|strong="H4294"\w* \w of Judah|strong="H3063"\w* \w and Simeon|strong="H8095"\w*, \w they designated|strong="H5414"\w* \w these|strong="H428"\w* \w cities|strong="H5892"\w* \w by name|strong="H8034"\w* \v 10 \w to the descendants|strong="H1121"\w* \w of Aaron|strong="H175"\w* \w from the Kohathite|strong="H6956"\w* \w clans|strong="H4940"\w* \w of the Levites|strong="H1121"\w*, \w because|strong="H3588"\w* \w the first|strong="H7223"\w* \w lot|strong="H1486"\w* \w fell|strong="H1961"\w* to them:
\b 
\li1 \v 11 \w They gave|strong="H5414"\w* them \w Kiriath-arba|strong="H7153"\w* \w (that is|strong="H1931"\w*, \w Hebron|strong="H2275"\w*), \w with its surrounding|strong="H5439"\w* \w pasturelands|strong="H4054"\w*, \w in the hill country|strong="H2022"\w* \w of Judah|strong="H3063"\w*. (\w Arba was the father|strong="H1"\w* \w of Anak|strong="H6061"\w*.) \v 12 \w But they had given|strong="H5414"\w* \w the fields|strong="H7704"\w* \w and villages|strong="H2691"\w* \w around the city|strong="H5892"\w* \w to Caleb|strong="H3612"\w* \w son|strong="H1121"\w* \w of Jephunneh|strong="H3312"\w* \w as his possession|strong="H272"\w*.
\li1 \v 13 \w So to the descendants|strong="H1121"\w* \w of Aaron|strong="H175"\w* \w the priest|strong="H3548"\w* \w they gave|strong="H5414"\w* \w these cities|strong="H853"\w*, \w together with|strong="H853"\w* \w their pasturelands|strong="H4054"\w*: \w Hebron|strong="H2275"\w*, \w a city|strong="H5892"\w* \w of refuge|strong="H4733"\w* \w for the manslayer|strong="H7523"\w*, \w Libnah|strong="H3841"\w*, \v 14 \w Jattir|strong="H3492"\w*, \w Eshtemoa|strong="H851"\w*, \v 15 \w Holon|strong="H2473"\w*, \w Debir|strong="H1688"\w*, \v 16 \w Ain|strong="H5871"\w*, \w Juttah|strong="H3194"\w*, \w and Beth-shemesh|strong="H1053"\w*— \w nine|strong="H8672"\w* \w cities|strong="H5892"\w* \w from|strong="H854"\w* \w these|strong="H428"\w* \w two|strong="H8147"\w* \w tribes|strong="H7626"\w*, \w together with|strong="H853"\w* \w their pasturelands|strong="H4054"\w*.
\pmo \v 17 \w And from the tribe|strong="H4294"\w* \w of Benjamin they gave|strong="H1144"\w* \w them|strong="H853"\w* \w Gibeon|strong="H1391"\w*, \w Geba|strong="H1387"\w*, \v 18 \w Anathoth|strong="H6068"\w*, \w and Almon|strong="H5960"\w*— \w four|strong="H702"\w* \w cities|strong="H5892"\w*, \w together with|strong="H853"\w* \w their pasturelands|strong="H4054"\w*.
\pmo \v 19 \w In all|strong="H3605"\w*, \w thirteen|strong="H7969"\w* \w cities|strong="H5892"\w*, \w together with their pasturelands|strong="H4054"\w*, \w were given to the priests|strong="H3548"\w*, \w the descendants|strong="H1121"\w* \w of Aaron|strong="H175"\w*.
\p \v 20 \w The remaining|strong="H3498"\w* \w Kohathite|strong="H6955"\w* \w clans|strong="H4940"\w* \w of the Levites|strong="H3881"\w* \w were allotted|strong="H1486"\w* \w these cities|strong="H5892"\w*:
\b 
\li1 \w From the tribe|strong="H4294"\w* \w of Ephraim|strong="H669"\w* \v 21 \w they were given|strong="H5414"\w* \w Shechem|strong="H7927"\w* \w in the hill country|strong="H2022"\w* \w of Ephraim|strong="H669"\w* (\w a city|strong="H5892"\w* \w of refuge|strong="H4733"\w* \w for the manslayer|strong="H7523"\w*), \w Gezer|strong="H1507"\w*, \v 22 \w Kibzaim|strong="H6911"\w*, \w and Beth-horon|strong="H1032"\w*— \w four|strong="H702"\w* \w cities|strong="H5892"\w*, \w together with|strong="H853"\w* \w their pasturelands|strong="H4054"\w*.
\li1 \v 23 \w From the tribe|strong="H4294"\w* \w of Dan they were given|strong="H1835"\w* \w Elteke|strong="H514"\w*, \w Gibbethon|strong="H1405"\w*, \v 24 \w Aijalon|strong="H357"\w*, \w and Gath-rimmon|strong="H1667"\w*— \w four|strong="H702"\w* \w cities|strong="H5892"\w*, \w together with|strong="H853"\w* \w their pasturelands|strong="H4054"\w*.
\li1 \v 25 \w And from the half-tribe|strong="H4276"\w* \w of Manasseh they were given|strong="H4519"\w* \w Taanach|strong="H8590"\w* \w and|strong="H853"\w* \w Gath-rimmon|strong="H1667"\w*— \w two|strong="H8147"\w* \w cities|strong="H5892"\w*, \w together with|strong="H853"\w* \w their pasturelands|strong="H4054"\w*.
\li1 \v 26 \w In all|strong="H3605"\w*, \w ten|strong="H6235"\w* \w cities|strong="H5892"\w*, \w together with their pasturelands|strong="H4054"\w*, \w were given to the rest|strong="H3498"\w* \w of the Kohathite|strong="H6955"\w* \w clans|strong="H4940"\w*.
\p \v 27 \w This is what the Levite|strong="H3881"\w* \w clans|strong="H4940"\w* \w of the Gershonites were given|strong="H1648"\w*:
\b 
\li1 \w From the half-tribe|strong="H2677"\w* \w of Manasseh|strong="H4519"\w* \w they were given|strong="H853"\w* \w Golan|strong="H1474"\w* \w in Bashan|strong="H1316"\w*, \w a city|strong="H5892"\w* \w of refuge|strong="H4733"\w* \w for the manslayer|strong="H7523"\w*, \w and Beeshterah|strong="H1203"\w*— \w two|strong="H8147"\w* \w cities|strong="H5892"\w*, \w together with|strong="H853"\w* \w their pasturelands|strong="H4054"\w*.
\li1 \v 28 \w From the tribe|strong="H4294"\w* \w of Issachar they were given|strong="H3485"\w* \w Kishion|strong="H7191"\w*, \w Daberath|strong="H1705"\w*, \v 29 \w Jarmuth|strong="H3412"\w*, \w and En-gannim|strong="H5873"\w*— \w four|strong="H702"\w* \w cities|strong="H5892"\w*, \w together with|strong="H853"\w* \w their pasturelands|strong="H4054"\w*.
\li1 \v 30 \w From the tribe|strong="H4294"\w* \w of Asher they were given|strong="H836"\w* \w Mishal|strong="H4861"\w*, \w Abdon|strong="H5658"\w*, \v 31 \w Helkath|strong="H2520"\w*, \w and Rehob|strong="H7340"\w*— \w four|strong="H702"\w* \w cities|strong="H5892"\w*, \w together with|strong="H853"\w* \w their pasturelands|strong="H4054"\w*.
\li1 \v 32 \w And from the tribe|strong="H4294"\w* \w of Naphtali they were given|strong="H5321"\w* \w Kedesh|strong="H6943"\w* \w in Galilee|strong="H1551"\w* (\w a city|strong="H5892"\w* \w of refuge|strong="H4733"\w* \w for the manslayer|strong="H7523"\w*), \w Hammoth-dor|strong="H2576"\w*, \w and Kartan|strong="H7178"\w*— \w three|strong="H7969"\w* \w cities|strong="H5892"\w*, \w together with|strong="H853"\w* \w their pasturelands|strong="H4054"\w*.
\li1 \v 33 \w In all|strong="H3605"\w*, \w thirteen|strong="H7969"\w* \w cities|strong="H5892"\w*, \w together with|strong="H5892"\w* \w their pasturelands|strong="H4054"\w*, \w were given to the Gershonite|strong="H1649"\w* \w clans|strong="H4940"\w*.
\p \v 34 \w This is what the Merarite|strong="H4847"\w* \w clan|strong="H4940"\w* (\w the rest of|strong="H3498"\w* \w the Levites) were given|strong="H3881"\w*:
\b 
\li1 \w From the tribe|strong="H4294"\w* \w of Zebulun they were given|strong="H2074"\w* \w Jokneam|strong="H3362"\w*, \w Kartah|strong="H7177"\w*, \v 35 \w Dimnah|strong="H1829"\w*, \w and Nahalal|strong="H5096"\w*— \w four|strong="H702"\w* \w cities|strong="H5892"\w*, \w together with|strong="H853"\w* \w their pasturelands|strong="H4054"\w*.
\li1 \v 36 \w From the tribe|strong="H4294"\w* \w of Reuben they were given|strong="H7205"\w* \w Bezer|strong="H1221"\w*, \w Jahaz|strong="H3096"\w*, \v 37 \w Kedemoth|strong="H6932"\w*, \w and Mephaath|strong="H4158"\w*— \w four|strong="H702"\w* \w cities|strong="H5892"\w*, \w together with|strong="H853"\w* \w their pasturelands|strong="H4054"\w*.
\li1 \v 38 \w And from the tribe|strong="H4294"\w* \w of Gad they were given|strong="H1410"\w* \w Ramoth|strong="H7433"\w* \w in Gilead|strong="H1568"\w*, \w a city|strong="H5892"\w* \w of refuge|strong="H4733"\w* \w for the manslayer|strong="H7523"\w*, \w Mahanaim|strong="H4266"\w*, \v 39 \w Heshbon|strong="H2809"\w*, \w and Jazer|strong="H3270"\w*— \w four|strong="H702"\w* \w cities|strong="H5892"\w* \w in all|strong="H3605"\w*, \w together with|strong="H853"\w* \w their pasturelands|strong="H4054"\w*.
\li1 \v 40 \w In all|strong="H3605"\w*, \w twelve|strong="H8147"\w* \w cities|strong="H5892"\w* \w were|strong="H1961"\w* \w allotted|strong="H1486"\w* \w to the clans|strong="H4940"\w* \w of Merari|strong="H4847"\w*, \w the remaining|strong="H3498"\w* \w Levite|strong="H3881"\w* \w clans|strong="H4940"\w*.
\p \v 41 \w For the Levites, then|strong="H3881"\w*, \w there were forty-eight|strong="H705"\w* \w cities|strong="H5892"\w* \w in all|strong="H3605"\w*, \w together with their pasturelands|strong="H4054"\w*, \w within|strong="H8432"\w* \w the territory|strong="H272"\w* \w of the Israelites|strong="H3478"\w*. \v 42 \w Each|strong="H5892"\w* \w of these|strong="H428"\w* \w cities|strong="H5892"\w* \w had|strong="H1961"\w* \w its own surrounding|strong="H5439"\w* \w pasturelands|strong="H4054"\w*; \w this was true|strong="H3651"\w* \w for all|strong="H3605"\w* \w the|strong="H428"\w* \w cities|strong="H5892"\w*.
\p \v 43 \w Thus the LORD|strong="H3068"\w* \w gave|strong="H5414"\w* \w Israel|strong="H3478"\w* \w all|strong="H3605"\w* \w the land|strong="H776"\w* \w He had sworn|strong="H7650"\w* \w to give|strong="H5414"\w* \w their fathers|strong="H1"\w*, \w and they took possession of it|strong="H3423"\w* \w and settled|strong="H3427"\w* in it.
\p \v 44 \w And the LORD|strong="H3068"\w* \w gave them rest|strong="H5117"\w* \w on every side|strong="H5439"\w*, \w just as|strong="H3605"\w* \w He had sworn|strong="H7650"\w* \w to their fathers|strong="H1"\w*. \w None|strong="H3808"\w* \w of their enemies|strong="H341"\w* \w could stand|strong="H5975"\w* \w against them|strong="H6440"\w*, \w for the LORD|strong="H3068"\w* \w delivered|strong="H5414"\w* \w all|strong="H3605"\w* \w their enemies|strong="H341"\w* \w into their hand|strong="H3027"\w*.
