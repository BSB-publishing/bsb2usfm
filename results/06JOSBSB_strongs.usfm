\p \v 14 \w The Israelites|strong="H1121"\w* \w took for themselves|strong="H962"\w* \w all|strong="H3605"\w* \w the plunder|strong="H7998"\w* \w and livestock|strong="H929"\w* \w of these|strong="H428"\w* \w cities|strong="H5892"\w*, \w but|strong="H7535"\w* \w they put|strong="H5221"\w* \w all|strong="H3605"\w* \w the people|strong="H120"\w* \w to the sword|strong="H2719"\w* \w until|strong="H5704"\w* \w they had completely destroyed them|strong="H8045"\w*, \w not sparing anyone|strong="H7604"\w* \w who breathed|strong="H5397"\w*. \v 15 \w As|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w His servant|strong="H5650"\w* \w Moses|strong="H4872"\w*, \w so|strong="H3651"\w* \w Moses|strong="H4872"\w* \w commanded|strong="H6680"\w* \w Joshua|strong="H3091"\w*. \w That is what|strong="H3651"\w* \w Joshua|strong="H3091"\w* \w did|strong="H6213"\w*, \w leaving nothing|strong="H3808"\w* \w undone|strong="H5493"\w* \w of all|strong="H3605"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w Moses|strong="H4872"\w*.
\s1 Joshua Takes the Whole Land
\p \v 16 \w So Joshua|strong="H3091"\w* \w took|strong="H3947"\w* \w this|strong="H2063"\w* \w entire|strong="H3605"\w* \w region|strong="H776"\w*: \w the hill country|strong="H2022"\w*, \w all|strong="H3605"\w* \w the Negev|strong="H5045"\w*, \w all|strong="H3605"\w* \w the land|strong="H776"\w* \w of Goshen|strong="H1657"\w*, \w the western foothills|strong="H8219"\w*, \w the Arabah|strong="H6160"\w*, \w and the mountains|strong="H2022"\w* \w of Israel|strong="H3478"\w* \w and their foothills|strong="H8219"\w*, \v 17 \w from|strong="H4480"\w* \w Mount|strong="H2022"\w* \w Halak|strong="H2510"\w*, \w which rises|strong="H5927"\w* \w toward Seir|strong="H8165"\w*, \w as far as|strong="H5704"\w* \w Baal-gad|strong="H1171"\w* \w in the Valley|strong="H1237"\w* \w of Lebanon|strong="H3844"\w* \w at the foot of|strong="H8478"\w* \w Mount|strong="H2022"\w* \w Hermon|strong="H2768"\w*. \w He captured|strong="H3920"\w* \w all|strong="H3605"\w* \w their kings|strong="H4428"\w* \w and struck them down|strong="H5221"\w*, \w putting them to death|strong="H4191"\w*.
\p \v 18 \w Joshua|strong="H3091"\w* \w waged|strong="H6213"\w* \w war|strong="H4421"\w* \w against all|strong="H3605"\w* \w these|strong="H428"\w* \w kings|strong="H4428"\w* \w for a long period|strong="H7227"\w* \w of time|strong="H3117"\w*. \v 19 \w No|strong="H3808"\w* \w city|strong="H5892"\w* \w made peace|strong="H7999"\w* \w with|strong="H413"\w* \w the Israelites|strong="H1121"\w* \w except|strong="H1115"\w* \w the Hivites|strong="H2340"\w* \w living|strong="H3427"\w* \w in Gibeon|strong="H1391"\w*; \w all|strong="H3605"\w* \w others were taken|strong="H3947"\w* \w in battle|strong="H4421"\w*. \v 20 \w For|strong="H3588"\w* \w it was|strong="H1961"\w* \w of|strong="H854"\w* \w the LORD|strong="H3068"\w* \w to harden|strong="H2388"\w*\f + \fr 11:20 \ft Or \fqa stiffen \ft or \fqa strengthen\f* \w their hearts|strong="H3820"\w* \w to engage|strong="H7122"\w* \w Israel|strong="H3478"\w* \w in battle|strong="H4421"\w*, \w so that they would be set apart for destruction|strong="H2763"\w* \w and would receive|strong="H1961"\w* \w no|strong="H1115"\w* \w mercy|strong="H8467"\w*, \w being annihilated|strong="H8045"\w* \w as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w Moses|strong="H4872"\w*.
\p \v 21 \w At that|strong="H1931"\w* \w time|strong="H6256"\w* \w Joshua|strong="H3091"\w* \w proceeded|strong="H935"\w* \w to eliminate|strong="H3772"\w* \w the Anakim|strong="H6062"\w* \w from|strong="H4480"\w* \w the hill country|strong="H2022"\w* \w of Hebron|strong="H2275"\w*, \w Debir|strong="H1688"\w*, \w and Anab|strong="H6024"\w*, \w and from all|strong="H3605"\w* \w the hill country|strong="H2022"\w* \w of Judah|strong="H3063"\w* \w and of Israel|strong="H3478"\w*. \w Joshua|strong="H3091"\w* \w devoted them to destruction|strong="H2763"\w*, \w along with|strong="H5973"\w* \w their cities|strong="H5892"\w*. \v 22 \w No|strong="H3808"\w* \w Anakim|strong="H6062"\w* \w were left|strong="H3498"\w* \w in the land|strong="H776"\w* \w of the Israelites|strong="H3478"\w*; \w only|strong="H7535"\w* \w in Gaza|strong="H5804"\w*, \w Gath|strong="H1661"\w*, \w and Ashdod|strong="H795"\w* \w did any survive|strong="H7604"\w*.
\p \v 23 \w So Joshua|strong="H3091"\w* \w took|strong="H3947"\w* \w the entire|strong="H3605"\w* \w land|strong="H776"\w*, \w in keeping with all|strong="H3605"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had spoken|strong="H1696"\w* \w to Moses|strong="H4872"\w*. \w And Joshua|strong="H3091"\w* \w gave|strong="H5414"\w* \w it as an inheritance|strong="H5159"\w* \w to Israel|strong="H3478"\w* \w according to the allotments|strong="H4256"\w* \w to their tribes|strong="H7626"\w*. \w Then the land|strong="H776"\w* \w had rest|strong="H8252"\w* \w from war|strong="H4421"\w*.
\c 12
\s1 The Kings Defeated East of the Jordan
\p \v 1 \w Now these are|strong="H428"\w* \w the kings|strong="H4428"\w* \w of the land|strong="H776"\w* \w whom the Israelites|strong="H1121"\w* \w struck down|strong="H5221"\w* \w and whose|strong="H834"\w* \w lands|strong="H776"\w* \w they took|strong="H3423"\w* \w beyond|strong="H5676"\w* \w the Jordan|strong="H3383"\w* \w to the east|strong="H4217"\w*, \w from the Arnon|strong="H769"\w* \w Valley|strong="H5158"\w* \w to|strong="H5704"\w* \w Mount|strong="H2022"\w* \w Hermon|strong="H2768"\w*, \w including all|strong="H3605"\w* \w the Arabah|strong="H6160"\w* \w eastward|strong="H4217"\w*:
\b 
\li1 \v 2 \w Sihon|strong="H5511"\w* \w king|strong="H4428"\w* \w of the Amorites|strong="H567"\w*, \w who lived|strong="H3427"\w* \w in Heshbon|strong="H2809"\w*. \w He ruled|strong="H4910"\w* \w from Aroer|strong="H6177"\w* \w on|strong="H5921"\w* \w the rim|strong="H8193"\w* \w of the Arnon|strong="H769"\w* \w Valley|strong="H5158"\w*, \w along the middle|strong="H8432"\w* \w of the valley|strong="H5158"\w*, \w up to|strong="H5704"\w* \w the Jabbok|strong="H2999"\w* \w River|strong="H5158"\w* (\w the border|strong="H1366"\w* \w of the|strong="H1121"\w* \w Ammonites|strong="H5983"\w*), \w that is, half|strong="H2677"\w* \w of Gilead|strong="H1568"\w*, \v 3 \w as well as the Arabah|strong="H6160"\w* \w east|strong="H4217"\w* \w of the Sea|strong="H3220"\w* \w of Chinnereth|strong="H3672"\w*\f + \fr 12:3 \ft That is, the Sea of Galilee\f* \w to|strong="H5704"\w* \w the Sea|strong="H3220"\w* \w of the Arabah|strong="H6160"\w* \w (the Salt Sea|strong="H3220"\w*\f + \fr 12:3 \ft That is, the Dead Sea\f*), \w eastward|strong="H4217"\w* \w through|strong="H1870"\w* \w Beth-jeshimoth|strong="H1020"\w*, \w and southward|strong="H8486"\w* \w below|strong="H8478"\w* \w the slopes|strong="H794"\w* \w of Pisgah|strong="H6449"\w*.
\li1 \v 4 \w And|strong="H1366"\w* \w Og|strong="H5747"\w* \w king|strong="H4428"\w* \w of Bashan|strong="H1316"\w*,\f + \fr 12:4 \ft LXX; Hebrew \fqa And the territory of Og king of Bashan\f* \w one of the remnant|strong="H3499"\w* \w of the Rephaim|strong="H7497"\w*, \w who lived|strong="H3427"\w* \w in Ashtaroth|strong="H6252"\w* \w and Edrei|strong="H154"\w*. \v 5 \w He ruled|strong="H4910"\w* \w over Mount|strong="H2022"\w* \w Hermon|strong="H2768"\w*, \w Salecah|strong="H5548"\w*, \w all|strong="H3605"\w* \w of Bashan|strong="H1316"\w* \w up to|strong="H5704"\w* \w the border|strong="H1366"\w* \w of the Geshurites|strong="H1651"\w* \w and Maacathites|strong="H4602"\w*, \w and half|strong="H2677"\w* \w of Gilead|strong="H1568"\w* \w to the border|strong="H1366"\w* \w of Sihon|strong="H5511"\w* \w king|strong="H4428"\w* \w of Heshbon|strong="H2809"\w*.
\p \v 6 \w Moses|strong="H4872"\w*, \w the servant|strong="H5650"\w* \w of the LORD|strong="H3068"\w*, \w and the Israelites|strong="H1121"\w* \w had struck them down|strong="H5221"\w* \w and|strong="H4872"\w* \w given|strong="H5414"\w* \w their land as an inheritance|strong="H3425"\w* \w to the Reubenites|strong="H7206"\w*, \w the Gadites|strong="H1425"\w*, \w and the half-tribe|strong="H2677"\w* \w of Manasseh|strong="H4519"\w*.
\s1 The Kings Defeated West of the Jordan
\p \v 7 \w And these are|strong="H428"\w* \w the kings|strong="H4428"\w* \w of the land|strong="H776"\w* \w that|strong="H834"\w* \w Joshua|strong="H3091"\w* \w and the Israelites|strong="H1121"\w* \w conquered|strong="H5221"\w* \w beyond|strong="H5676"\w* \w the Jordan|strong="H3383"\w* \w to the west|strong="H3220"\w*, \w from Baal-gad|strong="H1171"\w* \w in the Valley|strong="H1237"\w* \w of Lebanon|strong="H3844"\w* \w to|strong="H5704"\w* \w Mount|strong="H2022"\w* \w Halak|strong="H2510"\w*, \w which rises|strong="H5927"\w* \w toward Seir|strong="H8165"\w* (\w according to the allotments|strong="H4256"\w* \w to the tribes|strong="H7626"\w* \w of Israel|strong="H3478"\w*, \w Joshua|strong="H3091"\w* \w gave them|strong="H5414"\w* \w as an inheritance|strong="H3425"\w* \v 8 \w the hill country|strong="H2022"\w*, \w the foothills|strong="H8219"\w*,\f + \fr 12:8 \ft Hebrew \fqa Shephelah \ft or \fqa lowlands\ft ; that is, the western foothills of Judea\f* \w the Arabah|strong="H6160"\w*, \w the slopes|strong="H794"\w*, \w the wilderness|strong="H4057"\w*, \w and the Negev|strong="H5045"\w* — \w the lands of the Hittites|strong="H2850"\w*, \w Amorites|strong="H567"\w*, \w Canaanites|strong="H3669"\w*, \w Perizzites|strong="H6522"\w*, \w Hivites|strong="H2340"\w*, \w and Jebusites|strong="H2983"\w*):
\b 
