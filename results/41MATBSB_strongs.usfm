\s1 The Parable of the Workers
\p \v 1 \wj “\w For|strong="G1063"\w* \w the|strong="G3588"\w* \w kingdom|strong="G932"\w* \w of|strong="G3588"\w* \w heaven|strong="G3772"\w* \w is|strong="G1510"\w* \w like|strong="G3664"\w* \w a landowner|strong="G3617"\w* \w who|strong="G3748"\w* \w went out|strong="G1831"\w* \w early in|strong="G260"\w* \w the morning|strong="G4404"\w* \w to hire|strong="G3409"\w* \w workers|strong="G2040"\w* \w for|strong="G1519"\w* \w his|strong="G846"\w* \w vineyard|strong="G290"\w*.\wj* \v 2 \wj \w He agreed|strong="G4856"\w* \w to pay|strong="G3326"\w* \w them|strong="G2040"\w* \w a denarius|strong="G1220"\w*\f + \fr 20:2 \ft A denarius was customarily a day’s wage for a laborer; similarly in verses 9, 10, and 13.\f* \w for|strong="G1537"\w* \w the|strong="G3588"\w* \w day|strong="G2250"\w* \w and sent|strong="G649"\w* \w them|strong="G846"\w* \w into|strong="G1519"\w* \w his|strong="G846"\w* \w vineyard|strong="G290"\w*.\wj*
