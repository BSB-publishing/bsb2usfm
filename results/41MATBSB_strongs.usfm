\p \v 7 \wj \w Then|strong="G5119"\w* \w all|strong="G3956"\w* \w the|strong="G3588"\w* \w virgins|strong="G3933"\w* \w woke up|strong="G1453"\w* \w and|strong="G2532"\w* \w trimmed|strong="G2885"\w* \w their|strong="G1438"\w* \w lamps|strong="G2985"\w*.\wj* \v 8 \wj \w The|strong="G3588"\w* \w foolish ones|strong="G3474"\w* \w said|strong="G2036"\w* \w to the|strong="G3588"\w* \w wise|strong="G5429"\w*, ‘\w Give|strong="G1325"\w* \w us|strong="G1473"\w* \w some of|strong="G1537"\w* \w your|strong="G4771"\w* \w oil|strong="G1637"\w*; \w our|strong="G1473"\w* \w lamps|strong="G2985"\w* \w are going out|strong="G4570"\w*.’\wj*
\p \v 9 \wj ‘\w No|strong="G3756"\w*,’ \w said|strong="G611"\w* \w the|strong="G3588"\w* \w wise ones|strong="G5429"\w*, ‘\w or|strong="G3379"\w* \w there may not be enough|strong="G714"\w* \w for both us|strong="G1473"\w* \w and|strong="G2532"\w* \w you|strong="G4771"\w*. \w Instead|strong="G3123"\w*, \w go|strong="G4198"\w* \w to|strong="G4314"\w* \w those who|strong="G3588"\w* \w sell oil|strong="G4453"\w* \w and|strong="G2532"\w* \w buy some|strong="G59"\w* \w for yourselves|strong="G1438"\w*.’\wj*
\p \v 10 \wj \w But|strong="G1161"\w* \w while they|strong="G846"\w* \w were on their way|strong="G565"\w* \w to buy it|strong="G59"\w*, \w the|strong="G3588"\w* \w bridegroom|strong="G3566"\w* \w arrived|strong="G2064"\w*. \w Those who|strong="G3588"\w* \w were ready|strong="G2092"\w* \w went in|strong="G1525"\w* \w with|strong="G3326"\w* \w him|strong="G846"\w* \w to|strong="G1519"\w* \w the|strong="G3588"\w* \w wedding banquet|strong="G1062"\w*, \w and|strong="G2532"\w* \w the|strong="G3588"\w* \w door|strong="G2374"\w* \w was shut|strong="G2808"\w*.\wj*
\p \v 11 \wj \w Later|strong="G5305"\w* \w the|strong="G3588"\w* \w other|strong="G3062"\w* \w virgins|strong="G3933"\w* \w arrived|strong="G2064"\w* \w and|strong="G2532"\w* \w said|strong="G3004"\w*, ‘\w Lord|strong="G2962"\w*, \w lord|strong="G2962"\w*, \w open the door|strong="G455"\w* \w for us|strong="G1473"\w*!’\wj*
