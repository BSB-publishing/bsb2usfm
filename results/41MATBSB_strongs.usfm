\p \v 1 \wj “\w At that time|strong="G5119"\w* \w the|strong="G3588"\w* \w kingdom|strong="G932"\w* \w of|strong="G3588"\w* \w heaven|strong="G3772"\w* \w will be like|strong="G3666"\w* \w ten|strong="G1176"\w* \w virgins|strong="G3933"\w* \w who|strong="G3748"\w* \w took|strong="G2983"\w* \w their|strong="G1438"\w* \w lamps|strong="G2985"\w* \w and went out|strong="G1831"\w* \w to|strong="G1519"\w* \w meet|strong="G5222"\w* \w the|strong="G3588"\w* \w bridegroom|strong="G3566"\w*.\wj* \v 2 \wj \w Five|strong="G4002"\w* \w of|strong="G1537"\w* \w them|strong="G846"\w* \w were|strong="G1510"\w* \w foolish|strong="G3474"\w*, \w and|strong="G2532"\w* \w five were|strong="G4002"\w* \w wise|strong="G5429"\w*.\wj* \v 3 \wj \w The|strong="G3588"\w* \w foolish ones|strong="G3474"\w* \w took|strong="G2983"\w* \w their|strong="G846"\w* \w lamps|strong="G2985"\w* \w but did not take along|strong="G2983"\w* \w any extra|strong="G3756"\w* \w oil|strong="G1637"\w*.\wj* \v 4 \wj \w But|strong="G1161"\w* \w the|strong="G3588"\w* \w wise ones|strong="G5429"\w* \w took|strong="G2983"\w* \w oil|strong="G1637"\w* \w in|strong="G1722"\w* \w flasks|strong="G30"\w* \w along with|strong="G3326"\w* \w their|strong="G1438"\w* \w lamps|strong="G2985"\w*.\wj* \v 5 \wj \w When|strong="G1161"\w* \w the|strong="G3588"\w* \w bridegroom|strong="G3566"\w* \w was delayed|strong="G5549"\w*, \w they all became drowsy|strong="G3573"\w* \w and|strong="G2532"\w* \w fell asleep|strong="G2518"\w*.\wj*
