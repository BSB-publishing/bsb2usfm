\p \v 9 \wj \w The workers who were hired|strong="G3588"\w* \w about|strong="G4012"\w* \w the|strong="G3588"\w* \w eleventh|strong="G1734"\w* \w hour|strong="G5610"\w* \w came and|strong="G2064"\w* \w each|strong="G303"\w* \w received|strong="G2983"\w* \w a denarius|strong="G1220"\w*.\wj* \v 10 \wj \w So when|strong="G2532"\w* \w the|strong="G3588"\w* \w original workers|strong="G4413"\w* \w came|strong="G2064"\w*, \w they assumed|strong="G3543"\w* \w they would receive|strong="G2983"\w* \w more|strong="G4119"\w*. \w But|strong="G2532"\w* \w each|strong="G303"\w* \w of them|strong="G846"\w* \w also|strong="G2532"\w* \w received|strong="G2983"\w* \w a denarius|strong="G1220"\w*.\wj*
