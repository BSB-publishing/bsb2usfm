\q1 \v 7 \w for|strong="H3588"\w* \w they have devoured|strong="H398"\w* \w Jacob|strong="H3290"\w*
\q2 \w and devastated|strong="H8074"\w* \w his homeland|strong="H5116"\w*.
\b 
\q1 \v 8 \w Do not hold|strong="H2142"\w* \w past|strong="H7223"\w* \w sins|strong="H5771"\w* against us;
