\b 
\q1 \v 11 \w May the groans|strong="H603"\w* \w of the captives|strong="H616"\w* \w reach You|strong="H935"\w*;
\q2 \w by the strength|strong="H1433"\w* \w of Your arm|strong="H2220"\w* \w preserve|strong="H3498"\w* \w those condemned|strong="H1121"\w* \w to death|strong="H8546"\w*.
\q1 \v 12 \w Pay back|strong="H7725"\w* \w into|strong="H413"\w* \w the laps|strong="H2436"\w* \w of our neighbors|strong="H7934"\w*
\q2 \w sevenfold|strong="H7659"\w* \w the reproach|strong="H2781"\w* \w they hurled at You|strong="H2778"\w*, \w O Lord|strong="H136"\w*.
\q1 \v 13 \w Then we|strong="H587"\w* \w Your people|strong="H5971"\w*, \w the sheep|strong="H6629"\w* \w of Your pasture|strong="H4830"\w*,
\q2 \w will thank|strong="H3034"\w* You \w forever|strong="H5769"\w*;
