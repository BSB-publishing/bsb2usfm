\b 
\q1 \w O God|strong="H430"\w*, \w be not|strong="H408"\w* \w silent|strong="H1824"\w*; \w be not|strong="H408"\w* \w speechless|strong="H2790"\w*;\f + \fr 83:1 \ft Or \fqa deaf\f*
