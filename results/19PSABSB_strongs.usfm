\q1 \w Bless|strong="H1288"\w* \w the LORD|strong="H3068"\w*, \w O my soul|strong="H5315"\w*!
\c 104
\s1 How Many Are Your Works, O LORD!
\q1 \v 1 \w Bless|strong="H1288"\w* \w the LORD|strong="H3068"\w*, \w O my soul|strong="H5315"\w*!
\b 
