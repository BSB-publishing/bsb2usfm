\q1 \w The nations|strong="H1471"\w*, \w O God|strong="H430"\w*, \w have invaded|strong="H935"\w* \w Your inheritance|strong="H5159"\w*;
\q2 \w they have defiled|strong="H2930"\w* \w Your holy|strong="H6944"\w* \w temple|strong="H1964"\w*
\q2 \w and reduced|strong="H7760"\w* \w Jerusalem|strong="H3389"\w* \w to rubble|strong="H5856"\w*.
\q1 \v 2 \w They have given|strong="H5414"\w* \w the corpses|strong="H5038"\w* \w of Your servants|strong="H5650"\w*
\q2 \w as food|strong="H3978"\w* \w to the birds|strong="H5775"\w* \w of the air|strong="H8064"\w*,
\q2 \w the flesh|strong="H1320"\w* \w of Your saints|strong="H2623"\w* \w to the beasts|strong="H2416"\w* \w of the earth|strong="H776"\w*.
\q1 \v 3 \w They have poured out|strong="H8210"\w* \w their blood|strong="H1818"\w* \w like water|strong="H4325"\w*
\q2 \w all around|strong="H5439"\w* \w Jerusalem|strong="H3389"\w*,
\q2 \w and there is no one|strong="H369"\w* \w to bury the dead|strong="H6912"\w*.
\q1 \v 4 \w We have become|strong="H1961"\w* \w a reproach|strong="H2781"\w* \w to our neighbors|strong="H7934"\w*,
\q2 \w a scorn|strong="H3933"\w* \w and derision|strong="H7047"\w* \w to those around us|strong="H5439"\w*.
\b 
\q1 \v 5 \w How long|strong="H5704"\w*, \w O LORD|strong="H3068"\w*?
\q2 \w Will You be angry|strong="H599"\w* \w forever|strong="H5331"\w*?
\q2 \w Will Your jealousy|strong="H7068"\w* \w burn|strong="H1197"\w* \w like|strong="H3644"\w* \w fire|strong="H784"\w*?
\q1 \v 6 \w Pour out|strong="H8210"\w* \w Your wrath|strong="H2534"\w* \w on|strong="H413"\w* \w the nations|strong="H1471"\w*
