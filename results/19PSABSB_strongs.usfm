\d \v 1 \w A Psalm|strong="H4210"\w* \w of Asaph|strong="H623"\w*.
\b 
\q1 \w God|strong="H430"\w* \w presides|strong="H5324"\w* \w in the divine|strong="H410"\w* \w assembly|strong="H5712"\w*;
\q2 \w He renders judgment|strong="H8199"\w* \w among|strong="H7130"\w* \w the gods|strong="H430"\w*:
