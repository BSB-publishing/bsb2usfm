\s1 The Whole Duty of Man
\p \v 9 \w Not only|strong="H3148"\w* \w was|strong="H1961"\w* \w the Teacher|strong="H6953"\w* \w wise|strong="H2450"\w*, \w but he also|strong="H5750"\w* \w taught|strong="H3925"\w* \w the people|strong="H5971"\w* \w knowledge|strong="H1847"\w*; \w he pondered|strong="H239"\w*, \w searched out|strong="H2713"\w*, \w and arranged|strong="H8626"\w* \w many|strong="H7235"\w* \w proverbs|strong="H4912"\w*. \v 10 \w The Teacher|strong="H6953"\w* \w searched|strong="H1245"\w* \w to find|strong="H4672"\w* \w delightful|strong="H2656"\w* \w sayings|strong="H1697"\w* \w and to record|strong="H3789"\w* \w accurate|strong="H3476"\w* \w words|strong="H1697"\w* \w of truth|strong="H571"\w*.\f + \fr 12:10 \ft Or \fqa and sought to write what was upright and true\f*
\p \v 11 \w The words|strong="H1697"\w* \w of the wise|strong="H2450"\w* \w are like goads|strong="H1861"\w*, \w and the anthologies|strong="H627"\w* \w of the masters|strong="H1167"\w* \w are like firmly embedded|strong="H5193"\w* \w nails|strong="H4930"\w* \w driven|strong="H5414"\w* \w by a single|strong="H259"\w* \w Shepherd|strong="H7462"\w*.\f + \fr 12:11 \ft Or \fqa shepherd\f* \v 12 And by these, \w my son|strong="H1121"\w*, \w be further|strong="H3148"\w* \w warned|strong="H2094"\w*: \w There is no|strong="H369"\w* \w end|strong="H7093"\w* \w to the making|strong="H6213"\w* \w of many|strong="H7235"\w* \w books|strong="H5612"\w*, \w and much|strong="H7235"\w* \w study|strong="H3854"\w* \w wearies|strong="H3024"\w* \w the body|strong="H1320"\w*.
\p \v 13 \w When all|strong="H3605"\w* \w has been heard|strong="H8085"\w*, \w the conclusion|strong="H5490"\w* \w of the matter is this|strong="H1697"\w*: \w Fear|strong="H3372"\w* \w God|strong="H430"\w* \w and|strong="H853"\w* \w keep|strong="H8104"\w* \w His commandments|strong="H4687"\w*, \w because|strong="H3588"\w* \w this is|strong="H2088"\w* \w the whole duty|strong="H3605"\w* \w of man|strong="H120"\w*. \v 14 \w For|strong="H3588"\w* \w God|strong="H430"\w* \w will bring|strong="H935"\w* \w every|strong="H3605"\w* \w deed|strong="H4639"\w* \w into judgment|strong="H4941"\w*, \w along with|strong="H5921"\w* \w every hidden|strong="H5956"\w* \w thing|strong="H3605"\w*, \w whether|strong="H518"\w* \w good|strong="H2896"\w* \w or|strong="H518"\w* \w evil|strong="H7451"\w*.
