\q2 \w anything|strong="H3972"\w* \w that will come after him|strong="H310"\w*.
\s1 The Limits of Human Wisdom
\p \v 15 \w In my futile|strong="H1892"\w* \w life|strong="H3117"\w* \w I have seen|strong="H7200"\w* \w both of these|strong="H3605"\w*:
\b 
\li1 \w A righteous man|strong="H6662"\w* \w perishing|strong="H6"\w* \w in his righteousness|strong="H6664"\w*,
\li1 \w and|strong="H3426"\w* \w a wicked man|strong="H7563"\w* \w living long|strong="H748"\w* \w in his wickedness|strong="H7451"\w*.
\p \v 16 \w Do not|strong="H408"\w* \w be|strong="H1961"\w* \w overly|strong="H7235"\w* \w righteous|strong="H6662"\w*, \w and do not|strong="H408"\w* \w make yourself too|strong="H3148"\w* \w wise|strong="H2449"\w*. \w Why|strong="H4100"\w* \w should you destroy yourself?|strong="H8074"\w* \v 17 \w Do not|strong="H408"\w* \w be excessively|strong="H7235"\w* \w wicked|strong="H7561"\w*, \w and do not|strong="H408"\w* \w be|strong="H1961"\w* \w a fool|strong="H5530"\w*. \w Why|strong="H4100"\w* \w should you die|strong="H4191"\w* \w before|strong="H3808"\w* \w your time|strong="H6256"\w*? \v 18 \w It is good|strong="H2896"\w* \w to grasp|strong="H270"\w* \w the one|strong="H2088"\w* \w and|strong="H1571"\w* \w not|strong="H408"\w* \w let the other slip|strong="H5117"\w* \w from|strong="H2088"\w* \w your hand|strong="H3027"\w*. \w For|strong="H3588"\w* \w he who fears|strong="H3373"\w* \w God|strong="H430"\w* \w will follow|strong="H3318"\w* \w both warnings|strong="H3605"\w*.\f + \fr 7:18 \ft Or \fqa will avoid all extremes\f*
\b 
\q1 \v 19 \w Wisdom|strong="H2451"\w* \w makes the wise man|strong="H2450"\w*
\q2 \w stronger than|strong="H5810"\w* \w ten|strong="H6235"\w* \w rulers|strong="H7989"\w* \w in a city|strong="H5892"\w*.
\q1 \v 20 \w Surely|strong="H3588"\w* \w there is no|strong="H369"\w* \w righteous|strong="H6662"\w* \w man|strong="H120"\w* \w on earth|strong="H776"\w*
\q2 \w who|strong="H834"\w* \w does|strong="H6213"\w* \w good|strong="H2896"\w* \w and never|strong="H3808"\w* \w sins|strong="H2398"\w*.
\p \v 21 \w Do not|strong="H408"\w* \w pay|strong="H5414"\w* \w attention|strong="H3820"\w* \w to every|strong="H3605"\w* \w word|strong="H1697"\w* \w that|strong="H834"\w* \w is spoken|strong="H1696"\w*, \w or|strong="H3808"\w* \w you may hear|strong="H8085"\w* \w your servant|strong="H5650"\w* \w cursing you|strong="H7043"\w*. \v 22 \w For|strong="H3588"\w* \w you know|strong="H3045"\w* \w in your heart|strong="H3820"\w* \w that|strong="H834"\w* \w many|strong="H7227"\w* \w times|strong="H6471"\w* \w you yourself|strong="H859"\w* \w have cursed|strong="H7043"\w* \w others|strong="H312"\w*.
\p \v 23 \w All|strong="H3605"\w* \w this|strong="H2090"\w* \w I tested|strong="H5254"\w* \w by wisdom, saying|strong="H2451"\w*, “\w I resolve|strong="H559"\w* \w to be wise|strong="H2449"\w*.” \w But it|strong="H1931"\w* \w was beyond|strong="H7350"\w* \w me|strong="H4480"\w*. \v 24 \w What|strong="H4100"\w* \w exists|strong="H1961"\w* \w is out of reach|strong="H7350"\w* \w and very deep|strong="H6013"\w*. \w Who|strong="H4310"\w* \w can fathom it|strong="H4672"\w*?
\p \v 25 \w I|strong="H589"\w* \w directed|strong="H5437"\w* \w my mind|strong="H3820"\w* \w to understand|strong="H3045"\w*, \w to explore|strong="H8446"\w*, \w to search out|strong="H1245"\w* \w wisdom|strong="H2451"\w* \w and explanations|strong="H2808"\w*, \w and to understand|strong="H3045"\w* \w the stupidity|strong="H3689"\w* \w of wickedness|strong="H7562"\w* \w and the folly|strong="H5531"\w* \w of madness|strong="H1947"\w*. \v 26 \w And I|strong="H589"\w* \w find|strong="H4672"\w* \w more bitter|strong="H4751"\w* \w than death|strong="H4194"\w* \w the woman|strong="H802"\w* \w who|strong="H834"\w* \w is a snare|strong="H4685"\w*, \w whose heart|strong="H3820"\w* \w is a net|strong="H2764"\w*, \w and whose hands|strong="H3027"\w* \w are chains|strong="H612"\w*. \w The man who pleases|strong="H2896"\w* \w God|strong="H430"\w* \w escapes|strong="H4422"\w* \w her|strong="H4480"\w*, \w but the sinner|strong="H2398"\w* \w is ensnared|strong="H3920"\w*.
\p \v 27 “\w Behold|strong="H7200"\w*,” \w says|strong="H559"\w* \w the Teacher|strong="H6953"\w*, “\w I have discovered|strong="H4672"\w* \w this|strong="H2088"\w* \w by adding one|strong="H259"\w* \w thing to another|strong="H259"\w* \w to find|strong="H4672"\w* \w an explanation|strong="H2808"\w*. \v 28 \w While|strong="H834"\w* \w my soul|strong="H5315"\w* \w was still|strong="H5750"\w* \w searching|strong="H1245"\w* \w but not|strong="H3808"\w* \w finding|strong="H4672"\w*, \w among a thousand|strong="H505"\w* \w I have found|strong="H4672"\w* \w one|strong="H259"\w* \w upright man|strong="H120"\w*, \w but among all|strong="H3605"\w* \w these|strong="H428"\w* \w I have not|strong="H3808"\w* \w found|strong="H4672"\w* \w one such woman|strong="H802"\w*. \v 29 \w Only|strong="H905"\w* \w this|strong="H2088"\w* \w have I found|strong="H7200"\w*: \w I have discovered|strong="H4672"\w* \w that|strong="H834"\w* \w God|strong="H430"\w* \w made|strong="H6213"\w* \w mankind|strong="H120"\w* \w upright|strong="H3477"\w*, \w but they|strong="H1992"\w* \w have sought out|strong="H1245"\w* \w many|strong="H7227"\w* \w schemes|strong="H2810"\w*.”
\c 8
\s1 Obey the King
\p \v 1 \w Who|strong="H4310"\w* \w is like the wise man|strong="H2450"\w*? \w Who|strong="H4310"\w* \w knows|strong="H3045"\w* \w the interpretation|strong="H6592"\w* \w of a matter|strong="H1697"\w*? \w A man’s|strong="H120"\w* \w wisdom|strong="H2451"\w* \w brightens|strong="H215"\w* \w his face|strong="H6440"\w*, \w and the sternness|strong="H5797"\w* \w of his face|strong="H6440"\w* \w is changed|strong="H8132"\w*.
\p \v 2 \w Keep|strong="H8104"\w* \w the king’s|strong="H4428"\w* \w command|strong="H6310"\w*, \w I say|strong="H589"\w*, \w because of|strong="H5921"\w* \w your oath|strong="H7621"\w* \w before God|strong="H430"\w*. \v 3 \w Do not|strong="H408"\w* \w hasten|strong="H926"\w* \w to leave|strong="H1980"\w* \w his presence|strong="H6440"\w*, \w and do not|strong="H408"\w* \w persist|strong="H5975"\w* \w in a bad|strong="H7451"\w* \w cause|strong="H1697"\w*, \w for|strong="H3588"\w* \w he will do|strong="H6213"\w* \w whatever|strong="H3605"\w* \w he pleases|strong="H2654"\w*. \v 4 \w For|strong="H834"\w* \w the king’s|strong="H4428"\w* \w word|strong="H1697"\w* \w is supreme|strong="H7983"\w*, \w and who|strong="H4310"\w* \w can say|strong="H559"\w* to him, “\w What|strong="H4100"\w* \w are you doing|strong="H6213"\w*?”
\p \v 5 \w Whoever keeps|strong="H8104"\w* \w his command|strong="H4687"\w* \w will come to|strong="H3045"\w* \w no|strong="H3808"\w* \w harm|strong="H7451"\w*, \w and a wise|strong="H2450"\w* \w heart|strong="H3820"\w* \w knows|strong="H3045"\w* \w the right time|strong="H6256"\w* \w and procedure|strong="H4941"\w*. \v 6 \w For|strong="H3588"\w* \w there is|strong="H3426"\w* \w a right time|strong="H6256"\w* \w and procedure|strong="H4941"\w* \w to every|strong="H3605"\w* \w purpose|strong="H2656"\w*, \w though|strong="H3588"\w* \w a man’s|strong="H120"\w* \w misery|strong="H7451"\w* \w weighs heavily|strong="H7227"\w* \w upon him|strong="H5921"\w*. \v 7 \w Since|strong="H3588"\w* \w no one|strong="H369"\w* \w knows|strong="H3045"\w* \w what|strong="H4100"\w* \w will happen|strong="H1961"\w*, \w who|strong="H4310"\w* \w can tell|strong="H5046"\w* him \w what|strong="H834"\w* \w is to come|strong="H1961"\w*?
\p \v 8 \w As no|strong="H369"\w* \w man|strong="H120"\w* \w has power|strong="H7989"\w* \w over the wind|strong="H7307"\w* \w to contain|strong="H3607"\w* \w it|strong="H7307"\w*, \w so no one|strong="H369"\w* \w has authority|strong="H7983"\w* \w over his day|strong="H3117"\w* \w of death|strong="H4194"\w*. \w As no one|strong="H369"\w* \w can be discharged|strong="H4917"\w* \w in wartime|strong="H4421"\w*, \w so wickedness|strong="H7562"\w* \w will not|strong="H3808"\w* \w release|strong="H4422"\w* \w those who practice it|strong="H1167"\w*. \v 9 \w All|strong="H3605"\w* \w this|strong="H2088"\w* \w I have seen|strong="H7200"\w*, \w applying|strong="H5414"\w* \w my mind|strong="H3820"\w* \w to every|strong="H3605"\w* \w deed|strong="H4639"\w* \w that|strong="H834"\w* \w is done|strong="H6213"\w* \w under|strong="H8478"\w* \w the sun|strong="H8121"\w*; \w there is a time|strong="H6256"\w* \w when|strong="H834"\w* \w one man|strong="H120"\w* \w lords it|strong="H7980"\w* \w over another|strong="H120"\w* \w to his own detriment|strong="H7451"\w*.
\s1 Fear God
\r (\ref Isaiah 8:11–15|ISA 8:11-15\ref*)
\p \v 10 \w Then too|strong="H3651"\w*, \w I saw|strong="H7200"\w* \w the burial|strong="H6912"\w* \w of the wicked|strong="H7563"\w* \w who used to go in|strong="H935"\w* \w and out|strong="H1980"\w* \w of the holy|strong="H6918"\w* \w place|strong="H4725"\w*, \w and they were praised|strong="H7911"\w*\f + \fr 8:10 \ft Some Hebrew manuscripts, LXX, and Vulgate; most Hebrew manuscripts \fqa were soon forgotten\f* \w in the city|strong="H5892"\w* \w where|strong="H834"\w* \w they had done|strong="H6213"\w* \w so|strong="H3651"\w*. \w This|strong="H2088"\w* \w too|strong="H1571"\w* \w is futile|strong="H1892"\w*. \v 11 \w When|strong="H834"\w* \w the sentence|strong="H6599"\w* \w for a crime|strong="H7451"\w* \w is not|strong="H369"\w* \w speedily|strong="H4120"\w* \w executed|strong="H6213"\w*, \w the hearts|strong="H3820"\w* \w of men|strong="H120"\w* \w become fully set|strong="H4390"\w* \w on doing|strong="H6213"\w* \w evil|strong="H7451"\w*.
\p \v 12 \w Although|strong="H834"\w* \w a sinner|strong="H2398"\w* \w does|strong="H6213"\w* \w evil|strong="H7451"\w* \w a hundred times|strong="H3967"\w* \w and still lives long|strong="H748"\w*, \w yet|strong="H3588"\w* \w I|strong="H589"\w* \w also|strong="H1571"\w* \w know|strong="H3045"\w* \w that|strong="H834"\w* \w it will go|strong="H1961"\w* \w well|strong="H2896"\w* \w with those who|strong="H834"\w* \w fear|strong="H3372"\w* \w God|strong="H430"\w*, \w who are reverent|strong="H3373"\w* \w in His presence|strong="H6440"\w*. \v 13 \w Yet because|strong="H834"\w* \w the wicked do not|strong="H369"\w* \w fear|strong="H3373"\w* \w God|strong="H430"\w*, \w it will not|strong="H3808"\w* \w go|strong="H1961"\w* \w well|strong="H2896"\w* \w with them|strong="H7563"\w*, \w and their days|strong="H3117"\w* \w will not|strong="H3808"\w* \w lengthen|strong="H748"\w* \w like a shadow|strong="H6738"\w*.
\s1 God’s Ways Are Mysterious
\p \v 14 \w There is|strong="H3426"\w* \w a futility|strong="H1892"\w* \w that|strong="H834"\w* \w is done|strong="H6213"\w* \w on|strong="H5921"\w* \w the earth|strong="H776"\w*: \w There are|strong="H3426"\w* \w righteous men|strong="H6662"\w* \w who|strong="H834"\w* \w get|strong="H5060"\w* \w what the actions|strong="H4639"\w* \w of the wicked deserve|strong="H7563"\w*, \w and there are|strong="H3426"\w* \w wicked men|strong="H7563"\w* \w who|strong="H413"\w* \w get|strong="H5060"\w* \w what the actions|strong="H4639"\w* \w of the righteous deserve|strong="H6662"\w*. \w I say|strong="H559"\w* \w that this|strong="H2088"\w* \w too|strong="H1571"\w* \w is futile|strong="H1892"\w*.
\p \v 15 \w So I|strong="H589"\w* \w commended|strong="H7623"\w* \w the enjoyment of life|strong="H8057"\w*, \w because|strong="H834"\w* \w there is nothing|strong="H369"\w* \w better|strong="H2896"\w* \w for a man|strong="H120"\w* \w under|strong="H8478"\w* \w the sun|strong="H8121"\w* \w than|strong="H3588"\w* \w to eat|strong="H398"\w* \w and drink|strong="H8354"\w* \w and be merry|strong="H8055"\w*. \w For this joy|strong="H1931"\w* \w will accompany him|strong="H3867"\w* \w in his labor|strong="H5999"\w* \w during the days|strong="H3117"\w* \w of his life|strong="H2416"\w* \w that|strong="H834"\w* \w God|strong="H430"\w* \w gives|strong="H5414"\w* him \w under|strong="H8478"\w* \w the sun|strong="H8121"\w*.
\p \v 16 \w When|strong="H834"\w* \w I applied|strong="H5414"\w* \w my mind|strong="H3820"\w* \w to know|strong="H3045"\w* \w wisdom|strong="H2451"\w* \w and to observe|strong="H7200"\w* \w the task|strong="H6045"\w* \w that|strong="H834"\w* \w one performs|strong="H6213"\w* \w on|strong="H5921"\w* \w the earth|strong="H776"\w* — \w though|strong="H3588"\w* \w his eyes|strong="H5869"\w* \w do not|strong="H369"\w* \w see|strong="H7200"\w* \w sleep|strong="H8142"\w* \w in the day|strong="H3117"\w* \w or even in the night|strong="H3915"\w* — \v 17 \w I saw|strong="H7200"\w* \w every|strong="H3605"\w* \w work|strong="H4639"\w* \w of God|strong="H430"\w*, \w and that|strong="H3588"\w* \w a man|strong="H120"\w* \w is unable|strong="H3808"\w* \w to comprehend|strong="H4672"\w* \w the work|strong="H4639"\w* \w that|strong="H834"\w* \w is done|strong="H6213"\w* \w under|strong="H8478"\w* \w the sun|strong="H8121"\w*. Despite \w his|strong="H120"\w* \w efforts|strong="H5998"\w* \w to search it out|strong="H1245"\w*, \w he cannot|strong="H3808"\w* \w find its meaning|strong="H4672"\w*; \w even|strong="H1571"\w* \w if|strong="H518"\w* \w the wise|strong="H2450"\w* \w man claims|strong="H559"\w* \w to know|strong="H3045"\w*, \w he is unable|strong="H3808"\w* \w to comprehend|strong="H4672"\w*.
\c 9
\s1 Death Comes to Good and Bad
\p \v 1 \w So|strong="H3588"\w* \w I took|strong="H5414"\w* \w all|strong="H3605"\w* \w this|strong="H2088"\w* \w to|strong="H413"\w* \w heart|strong="H3820"\w* \w and concluded|strong="H952"\w* \w that|strong="H834"\w* \w the righteous|strong="H6662"\w* \w and the wise|strong="H2450"\w*, \w as well as their deeds|strong="H5652"\w*, \w are in God’s|strong="H430"\w* \w hands|strong="H3027"\w*. \w Man|strong="H120"\w* \w does not|strong="H369"\w* \w know|strong="H3045"\w* \w what|strong="H3605"\w* \w lies ahead|strong="H6440"\w*, \w whether|strong="H1571"\w* \w love|strong="H160"\w* \w or|strong="H1571"\w* \w hate|strong="H8135"\w*.
\p \v 2 \w It is the same|strong="H834"\w* \w for all|strong="H3605"\w*: \w There is a common|strong="H259"\w* \w fate|strong="H4745"\w* \w for the righteous|strong="H6662"\w* \w and the wicked|strong="H7563"\w*, \w for the good and the bad|strong="H2896"\w*,\f + \fr 9:2 \ft LXX, Syriac, and Vulgate; Hebrew does not include \fqa and the bad\ft .\f* \w for the clean|strong="H2889"\w* \w and the unclean|strong="H2931"\w*, \w for the one who sacrifices|strong="H2076"\w* \w and the one|strong="H834"\w* \w who does not|strong="H369"\w*. \w As it is for the good|strong="H2896"\w*, \w so it is for the sinner|strong="H2398"\w*; \w as it is for the one who makes a vow|strong="H7650"\w*, \w so it is|strong="H834"\w* \w for the one who refuses|strong="H3373"\w* \w to take a vow|strong="H7621"\w*.
\p \v 3 \w This|strong="H2088"\w* \w is an evil|strong="H7451"\w* \w in everything|strong="H3605"\w* \w that|strong="H834"\w* \w is done|strong="H6213"\w* \w under|strong="H8478"\w* \w the sun|strong="H8121"\w*: \w There is one|strong="H259"\w* \w fate|strong="H4745"\w* \w for everyone|strong="H3605"\w*. \w Furthermore|strong="H1571"\w*, \w the hearts|strong="H3820"\w* \w of men|strong="H1121"\w* \w are full of|strong="H4392"\w* \w evil|strong="H7451"\w* \w and madness|strong="H1947"\w* \w while they are alive|strong="H2416"\w*, \w and afterward|strong="H310"\w* \w they join|strong="H413"\w* \w the dead|strong="H4191"\w*.
\p \v 4 \w There is|strong="H3426"\w* \w hope|strong="H986"\w*, \w however|strong="H3588"\w*, \w for anyone who|strong="H4310"\w* \w is among|strong="H977"\w* \w the living|strong="H2416"\w*; \w for even|strong="H3588"\w* \w a live|strong="H2416"\w* \w dog|strong="H3611"\w* \w is better|strong="H2896"\w* \w than|strong="H4480"\w* \w a dead|strong="H4191"\w* \w lion|strong="H738"\w*. \v 5 \w For|strong="H3588"\w* \w the living|strong="H2416"\w* \w know|strong="H3045"\w* \w that they will die|strong="H4191"\w*, \w but the dead|strong="H4191"\w* \w know|strong="H3045"\w* \w nothing|strong="H3972"\w*. \w They have no|strong="H369"\w* \w further|strong="H5750"\w* \w reward|strong="H7939"\w*, \w because|strong="H3588"\w* \w the memory|strong="H2143"\w* \w of them is forgotten|strong="H7911"\w*. \v 6 \w Their love|strong="H160"\w*, \w their hate|strong="H8135"\w*, \w and|strong="H1571"\w* \w their envy|strong="H7068"\w* \w have already|strong="H3528"\w* \w vanished|strong="H6"\w*, \w and they will never again have|strong="H369"\w* \w a share|strong="H2506"\w* \w in all|strong="H3605"\w* \w that|strong="H834"\w* \w is done|strong="H6213"\w* \w under|strong="H8478"\w* \w the sun|strong="H8121"\w*.
\s1 Enjoy Your Portion in This Life
\p \v 7 \w Go|strong="H1980"\w*, \w eat|strong="H398"\w* \w your bread|strong="H3899"\w* \w with joy|strong="H8057"\w*, \w and drink|strong="H8354"\w* \w your wine|strong="H3196"\w* \w with a cheerful|strong="H2896"\w* \w heart|strong="H3820"\w*, \w for|strong="H3588"\w* \w God|strong="H430"\w* \w has already|strong="H3528"\w* \w approved|strong="H7521"\w* \w your works|strong="H4639"\w*:
\q1 \v 8 \w Let your garments|strong="H899"\w* \w always|strong="H3605"\w* \w be|strong="H1961"\w* \w white|strong="H3836"\w*,
\q2 \w and never|strong="H408"\w* \w spare|strong="H2637"\w* \w the oil|strong="H8081"\w* \w for|strong="H5921"\w* \w your head|strong="H7218"\w*.
\p \v 9 \w Enjoy|strong="H7200"\w* \w life|strong="H2416"\w* \w with|strong="H5973"\w* \w your beloved|strong="H157"\w* \w wife|strong="H802"\w* \w all|strong="H3605"\w* \w the days|strong="H3117"\w* \w of the fleeting|strong="H1892"\w*\f + \fr 9:9 \ft Or \fqa futile\ft ; twice in this verse\f* \w life|strong="H2416"\w* \w that|strong="H834"\w* \w God has given|strong="H5414"\w* you \w under|strong="H8478"\w* \w the sun|strong="H8121"\w* — \w all|strong="H3605"\w* \w your fleeting|strong="H1892"\w* \w days|strong="H3117"\w*. \w For|strong="H3588"\w* \w this|strong="H1931"\w* \w is your portion|strong="H2506"\w* \w in life|strong="H2416"\w* \w and in your labor|strong="H5999"\w* \w under|strong="H8478"\w* \w the sun|strong="H8121"\w*. \v 10 \w Whatever|strong="H3605"\w* \w you find|strong="H4672"\w* \w to do|strong="H6213"\w* \w with your hands|strong="H3027"\w*, \w do it|strong="H6213"\w* \w with all your might|strong="H3581"\w*, \w for|strong="H3588"\w* \w in Sheol|strong="H7585"\w*, \w where|strong="H834"\w* \w you|strong="H859"\w* \w are going|strong="H1980"\w*, \w there is|strong="H8033"\w* \w no|strong="H369"\w* \w work|strong="H4639"\w* \w or planning|strong="H2808"\w* \w or knowledge|strong="H1847"\w* \w or wisdom|strong="H2451"\w*.
\p \v 11 \w I saw|strong="H7200"\w* \w something else|strong="H7725"\w* \w under|strong="H8478"\w* \w the sun|strong="H8121"\w*: \w The race|strong="H4793"\w* \w is not|strong="H3808"\w* \w to the swift|strong="H7031"\w*, \w nor the battle|strong="H4421"\w* \w to the strong|strong="H1368"\w*; \w neither is|strong="H3808"\w* \w the bread|strong="H3899"\w* \w to the wise|strong="H2450"\w*, \w nor|strong="H1571"\w* \w the wealth|strong="H6239"\w* \w to the intelligent|strong="H995"\w*, \w nor|strong="H1571"\w* \w the favor|strong="H2580"\w* \w to the skillful|strong="H3045"\w*. \w For|strong="H3588"\w* \w time|strong="H6256"\w* \w and chance|strong="H6294"\w* \w happen|strong="H7136"\w* \w to all|strong="H3605"\w*. \v 12 \w For|strong="H3588"\w* \w surely|strong="H1571"\w* \w no|strong="H3808"\w* \w man|strong="H120"\w* \w knows|strong="H3045"\w* \w his time|strong="H6256"\w*: \w Like fish|strong="H1709"\w* \w caught|strong="H270"\w* \w in a cruel|strong="H7451"\w* \w net|strong="H4685"\w* \w or birds|strong="H6833"\w* \w trapped|strong="H270"\w* \w in a snare|strong="H6341"\w*, \w so men|strong="H1121"\w* \w are ensnared|strong="H3369"\w* \w in an evil|strong="H7451"\w* \w time|strong="H6256"\w* \w that suddenly|strong="H6597"\w* \w falls|strong="H5307"\w* \w upon them|strong="H5921"\w*.
\s1 Wisdom Is Better than Strength
\p \v 13 \w I have also seen|strong="H7200"\w* \w this|strong="H2090"\w* \w wisdom|strong="H2451"\w* \w under|strong="H8478"\w* \w the sun|strong="H8121"\w*, \w and it|strong="H1931"\w* \w was great|strong="H1419"\w* \w to me|strong="H413"\w*: \v 14 \w There was a small|strong="H6996"\w* \w city|strong="H5892"\w* \w with few|strong="H4592"\w* \w men|strong="H582"\w*. \w A mighty|strong="H1419"\w* \w king|strong="H4428"\w* \w came|strong="H935"\w* \w against it|strong="H413"\w*, \w surrounded it|strong="H5437"\w*, \w and built|strong="H1129"\w* \w large|strong="H1419"\w* \w siege ramps|strong="H4685"\w* \w against it|strong="H5921"\w*.
\p \v 15 \w Now a poor|strong="H4542"\w* \w wise|strong="H2450"\w* \w man|strong="H376"\w* \w was found|strong="H4672"\w* in the city, \w and he|strong="H1931"\w* \w saved|strong="H4422"\w* \w the city|strong="H5892"\w* \w by his wisdom|strong="H2451"\w*. \w Yet no|strong="H3808"\w* \w one|strong="H120"\w* \w remembered|strong="H2142"\w* \w that|strong="H1931"\w* \w poor|strong="H4542"\w* \w man|strong="H376"\w*. \v 16 \w And I|strong="H589"\w* \w said|strong="H559"\w*, “\w Wisdom|strong="H2451"\w* \w is better|strong="H2896"\w* \w than strength|strong="H1369"\w*, \w but the wisdom|strong="H2451"\w* \w of the poor|strong="H4542"\w* \w man is despised|strong="H959"\w*, \w and his words|strong="H1697"\w* \w are not|strong="H369"\w* \w heeded|strong="H8085"\w*.”
\b 
\q1 \v 17 \w The calm|strong="H5183"\w* \w words|strong="H1697"\w* \w of the wise|strong="H2450"\w* \w are heeded|strong="H8085"\w*
\q2 \w over the shouts|strong="H2201"\w* \w of a ruler|strong="H4910"\w* \w among fools|strong="H3684"\w*.
