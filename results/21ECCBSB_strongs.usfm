\p \v 18 \w I|strong="H589"\w* \w said|strong="H559"\w* \w to myself|strong="H3820"\w*, “\w As for|strong="H5921"\w* \w the sons|strong="H1121"\w* \w of men|strong="H120"\w*, \w God|strong="H430"\w* \w tests them|strong="H1305"\w* \w so that they may see|strong="H7200"\w* \w for themselves|strong="H1992"\w* \w that they|strong="H1992"\w* \w are but beasts|strong="H929"\w*.” \v 19 \w For|strong="H3588"\w* \w the fates|strong="H4745"\w* \w of both men|strong="H120"\w* \w and|strong="H4745"\w* \w beasts|strong="H929"\w* \w are the same|strong="H259"\w*: \w As one|strong="H2088"\w* \w dies|strong="H4194"\w*, \w so|strong="H3651"\w* \w dies|strong="H4194"\w* \w the other|strong="H2088"\w* — \w they all|strong="H3605"\w* \w have the same|strong="H259"\w* \w breath|strong="H7307"\w*.\f + \fr 3:19 \ft Or \fqa spirit\f* \w Man|strong="H120"\w* \w has no|strong="H369"\w* \w advantage|strong="H4195"\w* \w over|strong="H4480"\w* \w the animals|strong="H929"\w*, \w since|strong="H3588"\w* \w everything|strong="H3605"\w* \w is futile|strong="H1892"\w*. \v 20 \w All|strong="H3605"\w* \w go|strong="H1980"\w* \w to|strong="H413"\w* \w one|strong="H259"\w* \w place|strong="H4725"\w*; \w all|strong="H3605"\w* \w come|strong="H1961"\w* \w from|strong="H4480"\w* \w dust|strong="H6083"\w*, \w and all|strong="H3605"\w* \w return|strong="H7725"\w* \w to|strong="H413"\w* \w dust|strong="H6083"\w*.
