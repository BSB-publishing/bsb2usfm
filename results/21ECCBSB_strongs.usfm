\p \v 12 \w The sleep|strong="H8142"\w* \w of the worker|strong="H5647"\w* \w is sweet|strong="H4966"\w*, \w whether|strong="H518"\w* \w he eats|strong="H398"\w* \w little|strong="H4592"\w* \w or|strong="H518"\w* \w much|strong="H7235"\w*, \w but the abundance|strong="H7647"\w* \w of the rich man|strong="H6223"\w* \w permits|strong="H5117"\w* him \w no|strong="H369"\w* \w sleep|strong="H3462"\w*.
\p \v 13 \w There is|strong="H3426"\w* \w a grievous|strong="H2470"\w* \w evil|strong="H7451"\w* \w I have seen|strong="H7200"\w* \w under|strong="H8478"\w* \w the sun|strong="H8121"\w*: \w wealth|strong="H6239"\w* \w hoarded|strong="H8104"\w* \w to the harm|strong="H7451"\w* \w of its owner|strong="H1167"\w*, \v 14 \w or|strong="H1931"\w* \w wealth|strong="H6239"\w* \w lost|strong="H6"\w* \w in a failed|strong="H7451"\w* \w venture|strong="H6045"\w*, \w so when that man has|strong="H3205"\w* \w a son|strong="H1121"\w* \w there is nothing|strong="H369"\w* \w to pass on|strong="H3027"\w*.
\p \v 15 \w As|strong="H834"\w* \w a man came|strong="H3318"\w* \w from his mother’s|strong="H517"\w* \w womb|strong="H990"\w*, \w so he will depart|strong="H1980"\w* \w again|strong="H7725"\w*, \w naked|strong="H6174"\w* \w as he arrived|strong="H935"\w*. \w He takes|strong="H5375"\w* \w nothing|strong="H3972"\w* \w for his labor|strong="H5999"\w* \w to carry|strong="H1980"\w* \w in his hands|strong="H3027"\w*. \v 16 \w This|strong="H2090"\w* \w too|strong="H1571"\w* \w is a grievous|strong="H2470"\w* \w affliction|strong="H7451"\w*: \w Exactly as|strong="H3605"\w* \w a man is born|strong="H935"\w*, \w so|strong="H3651"\w* \w he will depart|strong="H1980"\w*. \w What|strong="H4100"\w* \w does he gain|strong="H3504"\w* \w as he toils|strong="H5998"\w* \w for the wind|strong="H7307"\w*? \v 17 \w Moreover|strong="H1571"\w*, \w all|strong="H3605"\w* \w his days|strong="H3117"\w* \w he eats|strong="H398"\w* \w in darkness|strong="H2822"\w*, \w with much|strong="H7235"\w* \w sorrow|strong="H3708"\w*, \w sickness|strong="H2483"\w*, \w and anger|strong="H7110"\w*.
\p \v 18 \w Here|strong="H2009"\w* \w is what|strong="H834"\w* \w I|strong="H589"\w* \w have seen|strong="H7200"\w* \w to be good|strong="H2896"\w* \w and fitting|strong="H3303"\w*: \w to eat|strong="H398"\w* \w and drink|strong="H8354"\w*, \w and to find|strong="H7200"\w* \w satisfaction|strong="H2896"\w* \w in all|strong="H3605"\w* \w the labor|strong="H5999"\w* \w one does|strong="H5998"\w* \w under|strong="H8478"\w* \w the sun|strong="H8121"\w* \w during the few|strong="H4557"\w* \w days|strong="H3117"\w* \w of life|strong="H2416"\w* \w that|strong="H834"\w* \w God|strong="H430"\w* \w has given|strong="H5414"\w* him — \w for|strong="H3588"\w* \w this|strong="H1931"\w* \w is his lot|strong="H2506"\w*.
\p \v 19 \w Furthermore|strong="H1571"\w*, \w God|strong="H430"\w* \w has given|strong="H5414"\w* \w riches|strong="H6239"\w* \w and wealth|strong="H5233"\w* to \w every|strong="H3605"\w* \w man|strong="H120"\w*, \w and He has enabled him|strong="H7980"\w* \w to enjoy them|strong="H398"\w*, \w to accept|strong="H5375"\w* \w his lot|strong="H2506"\w*, \w and to rejoice|strong="H8055"\w* \w in his labor|strong="H5999"\w*. \w This|strong="H2090"\w* \w is a gift|strong="H4991"\w* \w from God|strong="H430"\w*. \v 20 \w For|strong="H3588"\w* \w a man seldom|strong="H3808"\w* \w considers|strong="H2142"\w* \w the days|strong="H3117"\w* \w of his life|strong="H2416"\w*, \w because|strong="H3588"\w* \w God|strong="H430"\w* \w keeps him occupied|strong="H6031"\w* \w with the joy|strong="H8057"\w* \w of his heart|strong="H3820"\w*.
\c 6
\s1 The Futility of Life
\p \v 1 \w There is|strong="H3426"\w* \w another evil|strong="H7451"\w* \w I have seen|strong="H7200"\w* \w under|strong="H8478"\w* \w the sun|strong="H8121"\w*, \w and it|strong="H1931"\w* \w weighs heavily|strong="H7227"\w* \w upon|strong="H5921"\w* \w mankind|strong="H120"\w*: \v 2 \w God|strong="H430"\w* \w gives|strong="H5414"\w* \w a man|strong="H376"\w* \w riches|strong="H6239"\w*, \w wealth|strong="H5233"\w*, \w and honor|strong="H3519"\w*, \w so that he lacks|strong="H2638"\w* \w nothing|strong="H369"\w* \w his heart|strong="H5315"\w* \w desires|strong="H183"\w*; \w but God|strong="H430"\w* \w does not|strong="H3808"\w* \w allow him|strong="H7980"\w* \w to enjoy them|strong="H398"\w*. \w Instead|strong="H3588"\w*, \w a stranger|strong="H376"\w* \w will enjoy them|strong="H398"\w*. \w This|strong="H2088"\w* \w is futile|strong="H1892"\w* \w and a grievous|strong="H2483"\w* \w affliction|strong="H7451"\w*.
\p \v 3 \w A man|strong="H376"\w* \w may father|strong="H3205"\w* \w a hundred children|strong="H3967"\w* \w and live|strong="H2421"\w* \w for many|strong="H7227"\w* \w years|strong="H8141"\w*; \w yet no matter how long|strong="H7227"\w* \w he lives|strong="H3117"\w*, \w if he|strong="H5315"\w* \w is unsatisfied|strong="H7646"\w* \w with|strong="H4480"\w* \w his prosperity|strong="H2896"\w* \w and does not|strong="H3808"\w* \w even|strong="H1571"\w* \w receive a proper burial|strong="H6900"\w*, \w I say|strong="H559"\w* \w that a stillborn child|strong="H5309"\w* \w is better off|strong="H2896"\w* \w than he|strong="H4480"\w*. \v 4 \w For|strong="H3588"\w* \w a stillborn child enters|strong="H935"\w* \w in futility|strong="H1892"\w* \w and departs|strong="H1980"\w* \w in darkness|strong="H2822"\w*, \w and his name|strong="H8034"\w* \w is shrouded|strong="H3680"\w* \w in obscurity|strong="H2822"\w*. \v 5 \w The child|strong="H2088"\w*, \w though|strong="H1571"\w* \w neither|strong="H3808"\w* \w seeing|strong="H7200"\w* \w the sun|strong="H8121"\w* \w nor|strong="H3808"\w* \w knowing anything|strong="H3045"\w*, \w has more rest|strong="H5183"\w* \w than that man|strong="H2088"\w*, \v 6 \w even if|strong="H432"\w* \w he lives|strong="H2421"\w* \w a thousand|strong="H505"\w* \w years|strong="H8141"\w* \w twice over|strong="H6471"\w* \w but fails to|strong="H3808"\w* \w enjoy|strong="H7200"\w* \w his prosperity|strong="H2896"\w*. \w Do not|strong="H3808"\w* \w all|strong="H3605"\w* \w go|strong="H1980"\w* \w to|strong="H413"\w* \w the same|strong="H259"\w* \w place|strong="H4725"\w*?
\b 
\q1 \v 7 \w All|strong="H3605"\w* \w a man’s|strong="H120"\w* \w labor|strong="H5999"\w* \w is for his mouth|strong="H6310"\w*,
\q2 \w yet|strong="H1571"\w* \w his appetite|strong="H5315"\w* \w is never|strong="H3808"\w* \w satisfied|strong="H4390"\w*.\f + \fr 6:7 \ft Hebrew \fqa filled\f*
\p \v 8 \w What|strong="H4100"\w* \w advantage|strong="H3148"\w*, \w then|strong="H3588"\w*, \w has the wise man|strong="H2450"\w* \w over|strong="H4480"\w* \w the fool|strong="H3684"\w*? \w What gain comes|strong="H4100"\w* \w to the poor man|strong="H6041"\w* \w who knows|strong="H3045"\w* \w how to conduct himself|strong="H1980"\w* \w before|strong="H5048"\w* \w others|strong="H2416"\w*? \v 9 \w Better|strong="H2896"\w* \w what the eye|strong="H5869"\w* \w can see|strong="H4758"\w* \w than the wandering|strong="H1980"\w* \w of desire|strong="H5315"\w*. \w This|strong="H2088"\w* \w too|strong="H1571"\w* \w is futile|strong="H1892"\w* \w and a pursuit|strong="H7469"\w* \w of the wind|strong="H7307"\w*.
\p \v 10 \w Whatever|strong="H4100"\w* \w exists|strong="H1961"\w* \w was named|strong="H7121"\w* \w long ago|strong="H3528"\w*, \w and it is known|strong="H3045"\w* \w what|strong="H834"\w* \w man is|strong="H120"\w*; \w but he|strong="H1931"\w* \w cannot|strong="H3808"\w* \w contend|strong="H1777"\w* \w with|strong="H5973"\w* \w one stronger|strong="H8630"\w* \w than he|strong="H4480"\w*. \v 11 \w For|strong="H3588"\w* \w the more|strong="H7235"\w* \w words|strong="H1697"\w*, \w the more|strong="H7235"\w* \w futility|strong="H1892"\w* — \w and how|strong="H4100"\w* \w does that profit|strong="H3148"\w* \w anyone|strong="H120"\w*? \v 12 \w For|strong="H3588"\w* \w who|strong="H4310"\w* \w knows|strong="H3045"\w* \w what|strong="H4100"\w* \w is good|strong="H2896"\w* \w for a man|strong="H120"\w* \w during the few|strong="H4557"\w* \w days in which|strong="H3117"\w* \w he passes through|strong="H6213"\w* \w his fleeting|strong="H1892"\w* \w life|strong="H2416"\w* \w like a shadow|strong="H6738"\w*? \w Who|strong="H4310"\w* \w can tell|strong="H5046"\w* \w a man|strong="H120"\w* \w what|strong="H4100"\w* \w will come|strong="H1961"\w* \w after him|strong="H310"\w* \w under|strong="H8478"\w* \w the sun|strong="H8121"\w*?
\c 7
\s1 The Value of Wisdom
\q1 \v 1 \w A good name|strong="H8034"\w* \w is better|strong="H2896"\w* \w than fine|strong="H2896"\w* \w perfume|strong="H8081"\w*,
\q2 \w and one’s day|strong="H3117"\w* \w of death|strong="H4194"\w* \w is better than his day|strong="H3117"\w* \w of birth|strong="H3205"\w*.
\q1 \v 2 \w It is better|strong="H2896"\w* \w to enter|strong="H1980"\w* \w a house|strong="H1004"\w* \w of mourning|strong="H60"\w*
\q2 \w than|strong="H1980"\w* \w a house|strong="H1004"\w* \w of feasting|strong="H4960"\w*,
\q1 \w since|strong="H834"\w* \w death|strong="H1931"\w* \w is the end|strong="H5490"\w* \w of every|strong="H3605"\w* \w man|strong="H120"\w*,
\q2 \w and the living|strong="H2416"\w* \w should take this|strong="H5414"\w* \w to|strong="H413"\w* \w heart|strong="H3820"\w*.
