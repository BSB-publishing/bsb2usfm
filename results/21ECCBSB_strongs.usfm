\q2 \w than|strong="H376"\w* \w to listen|strong="H8085"\w* \w to the song|strong="H7892"\w* \w of fools|strong="H3684"\w*.
\q1 \v 6 \w For|strong="H3588"\w* \w like the crackling|strong="H6963"\w* \w of thorns|strong="H5518"\w* \w under|strong="H8478"\w* \w the pot|strong="H5518"\w*,
\q2 \w so|strong="H3651"\w* \w is the laughter|strong="H7814"\w* \w of the fool|strong="H3684"\w*. \w This|strong="H2088"\w* \w too|strong="H1571"\w* \w is futile|strong="H1892"\w*.
\b 
\q1 \v 7 \w Surely|strong="H3588"\w* \w extortion|strong="H6233"\w* \w turns a wise man|strong="H2450"\w* \w into a fool|strong="H1984"\w*,
\q2 \w and a bribe|strong="H4979"\w* \w corrupts|strong="H6"\w* \w the heart|strong="H3820"\w*.
\q1 \v 8 \w The end|strong="H319"\w* \w of a matter|strong="H1697"\w* \w is better|strong="H2896"\w* \w than the beginning|strong="H7225"\w*,
\q2 \w and a patient|strong="H750"\w* \w spirit|strong="H7307"\w* \w is better|strong="H2896"\w* \w than a proud|strong="H1364"\w* \w one|strong="H7307"\w*.
\b 
\q1 \v 9 \w Do not|strong="H408"\w* \w be quickly|strong="H926"\w* \w provoked|strong="H3707"\w* \w in your spirit|strong="H7307"\w*,
\q2 \w for|strong="H3588"\w* \w anger|strong="H3708"\w* \w settles|strong="H5117"\w* \w in the lap|strong="H2436"\w* \w of a fool|strong="H3684"\w*.\f + \fr 7:9 \ft Hebrew \fqa in the bosom of fools\f*
\q1 \v 10 \w Do not|strong="H408"\w* \w say|strong="H559"\w*, “\w Why|strong="H4100"\w* \w were|strong="H1961"\w* \w the old|strong="H7223"\w* \w days|strong="H3117"\w* \w better|strong="H2896"\w* \w than these|strong="H428"\w*?”
\q2 \w For|strong="H3588"\w* \w it is unwise|strong="H2451"\w* \w of you to ask|strong="H7592"\w* \w about|strong="H5921"\w* \w this|strong="H2088"\w*.
\b 
\q1 \v 11 \w Wisdom|strong="H2451"\w*, \w like|strong="H5973"\w* \w an inheritance|strong="H5159"\w*, \w is good|strong="H2896"\w*,
\q2 \w and it benefits|strong="H3148"\w* \w those who see|strong="H7200"\w* \w the sun|strong="H8121"\w*.
