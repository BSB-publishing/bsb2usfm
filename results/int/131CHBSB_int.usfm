\li2 \v 11 \rb Azariah|וַעֲזַרְיָ֨ה\rb* \rb son|בֶן־\rb* \rb of Hilkiah|חִלְקִיָּ֜ה\rb*, \rb the son|בֶּן־\rb* \rb of Meshullam|מְשֻׁלָּ֣ם\rb*, \rb the son|בֶּן־\rb* \rb of Zadok|צָד֗וֹק\rb*, \rb the son|בֶּן־\rb* \rb of Meraioth|מְרָיוֹת֙\rb*, \rb the son|בֶּן־\rb* \rb of Ahitub|אֲחִיט֔וּב\rb*, \rb the chief official|נְגִ֖יד\rb* \rb of God’s|הָאֱלֹהִֽים׃ס\rb* \rb temple|בֵּ֥ית\rb*;
\li2 \v 12 \rb Adaiah|וַעֲדָיָה֙\rb* \rb son|בֶּן־\rb* \rb of Jeroham|יְרֹחָ֔ם\rb*, \rb the son|בֶּן־\rb* \rb of Pashhur|פַּשְׁח֖וּר\rb*, \rb the son|בֶּן־\rb* \rb of Malchijah|מַלְכִּיָּ֑ה\rb*;
\li2 \rb Maasai|וּמַעְשַׂ֨י\rb* \rb son|בֶּן־\rb* \rb of Adiel|עֲדִיאֵ֧ל\rb*, \rb the son|בֶּן־\rb* \rb of Jahzerah|יַחְזֵ֛רָה\rb*, \rb the son|בֶּן־\rb* \rb of Meshullam|מְשֻׁלָּ֥ם\rb*, \rb the son|בֶּן־\rb* \rb of Meshillemith|מְשִׁלֵּמִ֖ית\rb*,\f + \fr 9:12 \fqa Meshillemith \ft is a variant of \fqa Meshillemoth\ft ; see \ref Nehemiah 11:13|NEH 11:13\ref*.\f* \rb the son|בֶּן־\rb* \rb of Immer|אִמֵּֽר׃\rb*;
\li2 \v 13 \rb and 1,760|אֶ֕לֶף\rb*\rb |וּשְׁבַ֥ע\rb*\rb |מֵא֖וֹת\rb*\rb |וְשִׁשִּׁ֑ים\rb* \rb of their relatives|וַאֲחֵיהֶ֗ם\rb*, \rb the heads|רָאשִׁים֙\rb* \rb of their families|לְבֵ֣ית\rb*\rb |אֲבוֹתָ֔ם\rb*, \rb able|חֵ֔יל\rb* \rb men|גִּבּ֣וֹרֵי\rb* \rb for the work|מְלֶ֖אכֶת\rb* \rb of the service|עֲבוֹדַ֥ת\rb* \rb of the house|בֵּית־\rb* \rb of God|הָאֱלֹהִֽים׃\rb*.
\b 
\li1 \v 14 \rb From|וּמִֽן־\rb* \rb the Levites|הַלְוִיִּ֑ם\rb*:
\li2 \rb Shemaiah|שְׁמַֽעְיָ֧ה\rb* \rb son|בֶן־\rb* \rb of Hasshub|חַשּׁ֛וּב\rb*, \rb the son|בֶּן־\rb* \rb of Azrikam|עַזְרִיקָ֥ם\rb*, \rb the son|בֶּן־\rb* \rb of Hashabiah|חֲשַׁבְיָ֖ה\rb*,\rb |מִן־\rb* \rb a descendant|בְּנֵ֥י\rb* \rb of Merari|מְרָרִֽי׃\rb*;
