\c 1
\s1 From Adam to Abraham
\r (\ref Genesis 5:1–32|GEN 5:1-32\ref*; \ref Genesis 10:1–32|GEN 10:1-32\ref*; \ref Genesis 11:10–26|GEN 11:10-26\ref*)
\p \v 1 \rb Adam|אָדָ֥ם\rb*, \rb Seth|שֵׁ֖ת\rb*, \rb Enosh|אֱנֽוֹשׁ׃\rb*,
\p \v 2 \rb Kenan|קֵינָ֥ן\rb*, \rb Mahalalel|מַהֲלַלְאֵ֖ל\rb*, \rb Jared|יָֽרֶד׃\rb*,
\p \v 3 \rb Enoch|חֲנ֥וֹךְ\rb*, \rb Methuselah|מְתוּשֶׁ֖לַח\rb*, \rb Lamech, Noah|לָֽמֶךְ׃\rb*.
\p \v 4 \rb The sons of Noah|נֹ֥חַ\rb*:\f + \fr 1:4 \ft LXX; Hebrew does not include \fqa The sons of Noah:\ft ; see \ref Genesis 5:32|GEN 5:32\ref*.\f*
\b 
\li1 \rb Shem|שֵׁ֖ם\rb*, \rb Ham|חָ֥ם\rb*, \rb and Japheth|וָיָֽפֶת׃ס\rb*.
\b 
\li1 \v 5 \rb The sons|בְּנֵ֣י\rb* \rb of Japheth|יֶ֔פֶת\rb*:
\li2 \rb Gomer|גֹּ֣מֶר\rb*, \rb Magog|וּמָג֔וֹג\rb*, \rb Madai|וּמָדַ֖י\rb*, \rb Javan|וְיָוָ֣ן\rb*, \rb Tubal|וְתֻבָ֑ל\rb*, \rb Meshech|וּמֶ֖שֶׁךְ\rb*, \rb and Tiras|וְתִירָֽס׃ס\rb*.
\li2 \v 6 \rb The sons|וּבְנֵ֖י\rb* \rb of Gomer|גֹּ֑מֶר\rb*: \rb Ashkenaz|אַשְׁכֲּנַ֥ז\rb*, \rb Riphath|וְדִיפַ֖ת\rb*,\f + \fr 1:6 \ft Many Hebrew manuscripts and Vulgate (see also LXX and \ref Genesis 10:3|GEN 10:3\ref*); most Hebrew manuscripts \fqa Diphath\f* \rb and Togarmah|וְתוֹגַרְמָֽה׃\rb*.
\li2 \v 7 \rb And the sons|וּבְנֵ֥י\rb* \rb of Javan|יָוָ֖ן\rb*: \rb Elishah|אֱלִישָׁ֣ה\rb*, \rb Tarshish|וְתַרְשִׁ֑ישָׁה\rb*, \rb the Kittites|כִּתִּ֖ים\rb*, \rb and the Rodanites|וְרוֹדָנִֽים׃ס\rb*.
\b 
\li1 \v 8 \rb The sons|בְּנֵ֖י\rb* \rb of Ham|חָ֑ם\rb*:
\li2 \rb Cush|כּ֥וּשׁ\rb*, \rb Mizraim|וּמִצְרַ֖יִם\rb*, \rb Put|פּ֥וּט\rb*, \rb and Canaan|וּכְנָֽעַן׃\rb*.
\li2 \v 9 \rb The sons|וּבְנֵ֣י\rb* \rb of Cush|כ֔וּשׁ\rb*: \rb Seba|סְבָא֙\rb*, \rb Havilah|וַחֲוִילָ֔ה\rb*, \rb Sabta|וְסַבְתָּ֥א\rb*,\f + \fr 1:9 \fqa Sabta \ft is a variant of \fqa Sabtah\ft ; see \ref Genesis 10:7|GEN 10:7\ref*.\f* \rb Raamah|וְרַעְמָ֖א\rb*, \rb and Sabteca|וְסַבְתְּכָ֑א\rb*.
\li2 \rb The sons|וּבְנֵ֥י\rb* \rb of Raamah|רַעְמָ֖א\rb*: \rb Sheba|שְׁבָ֥א\rb* \rb and Dedan|וּדְדָֽן׃ס\rb*.
\li2 \v 10 \rb Cush|וְכ֖וּשׁ\rb* \rb was the father of|יָלַ֣ד\rb*\rb |אֶת־\rb* \rb Nimrod|נִמְר֑וֹד\rb*, \rb who|ה֣וּא\rb* \rb began|הֵחֵ֔ל\rb* \rb to be|לִהְי֥וֹת\rb* \rb a mighty one|גִּבּ֖וֹר\rb*\f + \fr 1:10 \ft Or \fqa who established himself as a mighty warrior\f* \rb on the earth|בָּאָֽרֶץ׃ס\rb*.
\li2 \v 11 \rb Mizraim|וּמִצְרַ֡יִם\rb* \rb was the father of|יָלַ֞ד\rb*\rb |אֶת־\rb* \rb the Ludites|לוּדִיִּים\rb*,\rb |וְאֶת־\rb* \rb the Anamites|עֲנָמִ֛ים\rb*,\rb |וְאֶת־\rb* \rb the Lehabites|לְהָבִ֖ים\rb*,\rb |וְאֶת־\rb* \rb the Naphtuhites|נַפְתֻּחִֽים׃\rb*, \v 12 \rb |וְֽאֶת־\rb* \rb the Pathrusites|פַּתְרֻסִ֞ים\rb*,\rb |וְאֶת־\rb* \rb the Casluhites|כַּסְלֻחִ֗ים\rb* (\rb from whom|אֲשֶׁ֨ר\rb* \rb the Philistines|פְּלִשְׁתִּ֖ים\rb*\rb |וְאֶת־\rb* \rb came|יָצְא֥וּ\rb*\rb |מִשָּׁ֛ם\rb*), \rb and the Caphtorites|כַּפְתֹּרִֽים׃ס\rb*.\f + \fr 1:12 \ft Some translators adjust the Hebrew word order to \fqa the Casluhites, and the Caphtorites (from whom the Philistines came)\ft ; see also \ref Jeremiah 47:4|JER 47:4\ref* and Amos 9:7.\f*
\li2 \v 13 \rb And Canaan|וּכְנַ֗עַן\rb* \rb was the father of|יָלַ֛ד\rb*\rb |אֶת־\rb* \rb Sidon|צִיד֥וֹן\rb* \rb his firstborn|בְּכֹר֖וֹ\rb*,\f + \fr 1:13 \ft Or \fqa of the Sidonians, the foremost\f* \rb and|וְאֶת־\rb* \rb of the Hittites|חֵֽת׃\rb*,\f + \fr 1:13 \ft Hebrew \fqa and of Heth\f* \v 14 \rb |וְאֶת־\rb* \rb the Jebusites|הַיְבוּסִי֙\rb*,\rb |וְאֶת־\rb* \rb the Amorites|הָ֣אֱמֹרִ֔י\rb*,\rb |וְאֵ֖ת\rb* \rb the Girgashites|הַגִּרְגָּשִֽׁי׃\rb*, \v 15 \rb |וְאֶת־\rb* \rb the Hivites|הַחִוִּ֥י\rb*,\rb |וְאֶת־\rb* \rb the Arkites|הַֽעַרְקִ֖י\rb*,\rb |וְאֶת־\rb* \rb the Sinites|הַסִּינִֽי׃\rb*, \v 16 \rb |וְאֶת־\rb* \rb the Arvadites|הָאַרְוָדִ֥י\rb*,\rb |וְאֶת־\rb* \rb the Zemarites|הַצְּמָרִ֖י\rb*,\rb |וְאֶת־\rb* \rb and the Hamathites|הַֽחֲמָתִֽי׃ס\rb*.
\b 
\li1 \v 17 \rb The sons|בְּנֵ֣י\rb* \rb of Shem|שֵׁ֔ם\rb*:
\li2 \rb Elam|עֵילָ֣ם\rb*, \rb Asshur|וְאַשּׁ֔וּר\rb*, \rb Arphaxad|וְאַרְפַּכְשַׁ֖ד\rb*, \rb Lud|וְל֣וּד\rb*, \rb and Aram.|וַאֲרָ֑ם\rb*
\li2 \rb The sons of Aram:|וַאֲרָ֑ם\rb*\f + \fr 1:17 \ft One Hebrew manuscript and some LXX manuscripts (see also \ref Genesis 10:23|GEN 10:23\ref*); most Hebrew manuscripts do not include \fqa The sons of Aram\ft .\f* \rb Uz|וְע֥וּץ\rb*, \rb Hul|וְח֖וּל\rb*, \rb Gether|וְגֶ֥תֶר\rb*, \rb and Meshech|וָמֶֽשֶׁךְ׃ס\rb*.\f + \fr 1:17 \fqa Meshech \ft is a variant of \fqa Mash\ft ; see \ref Genesis 10:23|GEN 10:23\ref*.\f*
\li2 \v 18 \rb Arphaxad|וְאַרְפַּכְשַׁ֖ד\rb* \rb was the father of|יָלַ֣ד\rb*\rb |אֶת־\rb* \rb Shelah|שָׁ֑לַח\rb*, \rb and Shelah|וְשֶׁ֖לַח\rb* \rb was the father of|יָלַ֥ד\rb*\rb |אֶת־\rb* \rb Eber|עֵֽבֶר׃\rb*.
\li2 \v 19 \rb Two|שְׁנֵ֣י\rb* \rb sons|בָנִ֑ים\rb* \rb were born|יֻלַּ֖ד\rb* \rb to Eber|וּלְעֵ֥בֶר\rb*: \rb One|הָאֶחָ֞ד\rb* \rb was named|שֵׁ֣ם\rb* \rb Peleg|פֶּ֗לֶג\rb*,\f + \fr 1:19 \fqa Peleg \ft means \fqa division\ft .\f* \rb because|כִּ֤י\rb* \rb in his days|בְיָמָיו֙\rb* \rb the earth|הָאָ֔רֶץ\rb* \rb was divided|נִפְלְגָ֣ה\rb*, \rb and his brother|אָחִ֖יו\rb* \rb was named|וְשֵׁ֥ם\rb* \rb Joktan|יָקְטָֽן׃\rb*.
\li2 \v 20 \rb And Joktan|וְיָקְטָ֣ן\rb* \rb was the father of|יָלַ֔ד\rb*\rb |אֶת־\rb* \rb Almodad|אַלְמוֹדָ֖ד\rb*,\rb |וְאֶת־\rb* \rb Sheleph|שָׁ֑לֶף\rb*,\rb |וְאֶת־\rb* \rb Hazarmaveth|חֲצַרְמָ֖וֶת\rb*,\rb |וְאֶת־\rb* \rb Jerah|יָֽרַח׃\rb*, \v 21 \rb |וְאֶת־\rb* \rb Hadoram|הֲדוֹרָ֥ם\rb*,\rb |וְאֶת־\rb* \rb Uzal|אוּזָ֖ל\rb*,\rb |וְאֶת־\rb* \rb Diklah|דִּקְלָֽה׃\rb*, \v 22 \rb |וְאֶת־\rb* \rb Obal|עֵיבָ֥ל\rb*,\f + \fr 1:22 \ft LXX and Syriac (see also \ref Genesis 10:28|GEN 10:28\ref*); Hebrew \fqa Ebal\f*\rb |וְאֶת־\rb* \rb Abimael|אֲבִימָאֵ֖ל\rb*,\rb |וְאֶת־\rb* \rb Sheba|שְׁבָֽא׃\rb*, \v 23 \rb |וְאֶת־\rb* \rb Ophir|אוֹפִ֥יר\rb*,\rb |וְאֶת־\rb* \rb Havilah|חֲוִילָ֖ה\rb*,\rb |וְאֶת־\rb* \rb and Jobab|יוֹבָ֑ב\rb*. \rb All|כָּל־\rb* \rb these|אֵ֖לֶּה\rb* \rb were sons|בְּנֵ֥י\rb* \rb of Joktan|יָקְטָֽן׃ס\rb*.
\li2 \v 24 \rb So from Shem came|שֵׁ֥ם׀\rb* \rb Arphaxad|אַרְפַּכְשַׁ֖ד\rb*, \rb Shelah|שָֽׁלַח׃\rb*,\f + \fr 1:24 \ft Literally \fqa Shem, Arphaxad, Shelah\ft ; some LXX manuscripts \fqa Shem, Arphaxad, Cainan, Shelah\ft ; see also \ref Genesis 10:24|GEN 10:24\ref* LXX and Luke 3:35–36.\f* \v 25 \rb Eber|עֵ֥בֶר\rb*, \rb Peleg|פֶּ֖לֶג\rb*, \rb Reu|רְעֽוּ׃\rb*, \v 26 \rb Serug|שְׂר֥וּג\rb*, \rb Nahor|נָח֖וֹר\rb*, \rb Terah|תָּֽרַח׃\rb*, \v 27 \rb and Abram|אַבְרָ֖ם\rb* \rb (that is|ה֥וּא\rb*, \rb Abraham|אַבְרָהָֽם׃ס\rb*).
\s1 The Descendants of Abraham
\r (\ref Genesis 25:12–18|GEN 25:12-18\ref*)
\p \v 28 \rb The sons|בְּנֵי֙\rb* \rb of Abraham|אַבְרָהָ֔ם\rb* \rb were Isaac|יִצְחָ֖ק\rb* \rb and Ishmael|וְיִשְׁמָעֵֽאל׃ס\rb*. \v 29 \rb These are|אֵ֖לֶּה\rb* \rb their genealogies|תֹּלְדוֹתָ֑ם\rb*:
\b 
\li1 \rb Nebaioth|נְבָי֔וֹת\rb* \rb the firstborn|בְּכ֤וֹר\rb* \rb of Ishmael|יִשְׁמָעֵאל֙\rb*, \rb then Kedar|וְקֵדָ֥ר\rb*, \rb Adbeel|וְאַדְבְּאֵ֖ל\rb*, \rb Mibsam|וּמִבְשָֽׂם׃\rb*, \v 30 \rb Mishma|מִשְׁמָ֣ע\rb*, \rb Dumah|וְדוּמָ֔ה\rb*, \rb Massa|מַשָּׂ֖א\rb*, \rb Hadad|חֲדַ֥ד\rb*, \rb Tema|וְתֵימָֽא׃\rb*, \v 31 \rb Jetur|יְט֥וּר\rb*, \rb Naphish|נָפִ֖ישׁ\rb*, \rb and Kedemah|וָקֵ֑דְמָה\rb*. \rb These|אֵ֥לֶּה\rb* \rb were|הֵ֖ם\rb* \rb the sons|בְּנֵ֥י\rb* \rb of Ishmael|יִשְׁמָעֵֽאל׃ס\rb*.
\b 
\li1 \v 32 \rb The sons|וּבְנֵ֨י\rb* \rb born|יָלְדָ֞ה\rb*\rb |אֶת־\rb* \rb to Keturah|קְטוּרָ֜ה\rb*, \rb Abraham’s|אַבְרָהָ֗ם\rb* \rb concubine|פִּילֶ֣גֶשׁ\rb*:
\li2 \rb Zimran|זִמְרָ֧ן\rb*, \rb Jokshan|וְיָקְשָׁ֛ן\rb*, \rb Medan|וּמְדָ֥ן\rb*, \rb Midian|וּמִדְיָ֖ן\rb*, \rb Ishbak|וְיִשְׁבָּ֣ק\rb*, \rb and Shuah|וְשׁ֑וּחַ\rb*.
\b 
\li1 \rb The sons|וּבְנֵ֥י\rb* \rb of Jokshan|יָקְשָׁ֖ן\rb*:
\li2 \rb Sheba|שְׁבָ֥א\rb* \rb and Dedan|וּדְדָֽן׃ס\rb*.
\b 
\li1 \v 33 \rb The sons|וּבְנֵ֣י\rb* \rb of Midian|מִדְיָ֗ן\rb*:
\li2 \rb Ephah|עֵיפָ֤ה\rb*, \rb Epher|וָעֵ֙פֶר֙\rb*, \rb Hanoch|וַחֲנ֔וֹךְ\rb*, \rb Abida|וַאֲבִידָ֖ע\rb*, \rb and Eldaah|וְאֶלְדָּעָ֑ה\rb*.
\li2 \rb All|כָּל־\rb* \rb of these|אֵ֖לֶּה\rb* \rb were Keturah’s|קְטוּרָֽה׃ס\rb* \rb sons|בְּנֵ֥י\rb*.
\b 
\li1 \v 34 \rb Abraham|אַבְרָהָ֖ם\rb*\rb |אֶת־\rb* \rb was the father of|וַיּ֥וֹלֶד\rb* \rb Isaac|יִצְחָ֑קס\rb*. \rb The sons|בְּנֵ֣י\rb* \rb of Isaac|יִצְחָ֔ק\rb*:
\li2 \rb Esau|עֵשָׂ֖ו\rb* \rb and Israel|וְיִשְׂרָאֵֽל׃ס\rb*.
\s1 The Descendants of Esau
\r (\ref Genesis 36:1–19|GEN 36:1-19\ref*)
\li1 \v 35 \rb The sons|בְּנֵ֖י\rb* \rb of Esau|עֵשָׂ֑ו\rb*:
\li2 \rb Eliphaz|אֱלִיפַ֛ז\rb*, \rb Reuel|רְעוּאֵ֥ל\rb*, \rb Jeush|וִיע֖וּשׁ\rb*, \rb Jalam|וְיַעְלָ֥ם\rb*, \rb and Korah|וְקֹֽרַח׃ס\rb*.
\li2 \v 36 \rb The sons|בְּנֵ֖י\rb* \rb of Eliphaz|אֱלִיפָ֑ז\rb*: \rb Teman|תֵּימָ֤ן\rb*, \rb Omar|וְאוֹמָר֙\rb*, \rb Zepho|צְפִ֣י\rb*,\f + \fr 1:36 \ft Many Hebrew manuscripts, some LXX manuscripts, and Syriac (see also \ref Genesis 36:11|GEN 36:11\ref*); most Hebrew manuscripts \fqa Zephi\f* \rb Gatam|וְגַעְתָּ֔ם\rb*, \rb and Kenaz|קְנַ֖ז\rb*; \rb and by Timna|וְתִמְנָ֥ע\rb*, \rb Amalek|וַעֲמָלֵֽק׃ס\rb*.
\li2 \v 37 \rb The sons|בְּנֵ֖י\rb* \rb of Reuel|רְעוּאֵ֑ל\rb*: \rb Nahath|נַ֥חַת\rb*, \rb Zerah|זֶ֖רַח\rb*, \rb Shammah|שַׁמָּ֥ה\rb*, \rb and Mizzah|וּמִזָּֽה׃ס\rb*.
\s1 The Descendants of Seir
\r (\ref Genesis 36:20–30|GEN 36:20-30\ref*)
\li1 \v 38 \rb The sons|וּבְנֵ֣י\rb* \rb of Seir|שֵׂעִ֔יר\rb*:
\li2 \rb Lotan|לוֹטָ֥ן\rb*, \rb Shobal|וְשׁוֹבָ֖ל\rb*, \rb Zibeon|וְצִבְע֣וֹן\rb*, \rb Anah|וַֽעֲנָ֑ה\rb*, \rb Dishon|וְדִישֹׁ֥ן\rb*, \rb Ezer|וְאֵ֖צֶר\rb*, \rb and Dishan|וְדִישָֽׁן׃\rb*.
\li2 \v 39 \rb The sons|וּבְנֵ֥י\rb* \rb of Lotan|לוֹטָ֖ן\rb*: \rb Hori|חֹרִ֣י\rb* \rb and Homam|וְהוֹמָ֑ם\rb*.\f + \fr 1:39 \fqa Homam \ft is a variant of \fqa Hemam\ft ; see \ref Genesis 36:22|GEN 36:22\ref*.\f* \rb Timna|תִּמְנָֽע׃ס\rb* \rb was Lotan’s|לוֹטָ֖ן\rb* \rb sister|וַאֲח֥וֹת\rb*.
\li2 \v 40 \rb The sons|בְּנֵ֣י\rb* \rb of Shobal|שׁוֹבָ֔ל\rb*: \rb Alvan|עַלְיָ֧ן\rb*,\f + \fr 1:40 \ft LXX (see also \ref Genesis 36:23|GEN 36:23\ref*); Hebrew \fqa Alian \ft \f* \rb Manahath|וּמָנַ֛חַת\rb*, \rb Ebal|וְעֵיבָ֖ל\rb*, \rb Shepho|שְׁפִ֣י\rb*,\f + \fr 1:40 \ft LXX (see also \ref Genesis 36:23|GEN 36:23\ref*); Hebrew \fqa Shephi\f* \rb and Onam|וְאוֹנָ֑םס\rb*.
\li2 \rb The sons|וּבְנֵ֥י\rb* \rb of Zibeon|צִבְע֖וֹן\rb*: \rb Aiah|אַיָּ֥ה\rb* \rb and Anah|וַעֲנָֽה׃\rb*.
\li2 \v 41 \rb The son|בְּנֵ֥י\rb*\f + \fr 1:41 \ft Hebrew \fqa sons \ft \f* \rb of Anah|עֲנָ֖ה\rb*: \rb Dishon|דִּישׁ֑וֹןס\rb*.
\li2 \rb The sons|וּבְנֵ֣י\rb* \rb of Dishon|דִישׁ֔וֹן\rb*: \rb Hemdan|חַמְרָ֥ן\rb*,\f + \fr 1:41 \ft LXX (see also \ref Genesis 36:26|GEN 36:26\ref*); Hebrew \fqa Hamran\f* \rb Eshban|וְאֶשְׁבָּ֖ן\rb*, \rb Ithran|וְיִתְרָ֥ן\rb*, \rb and Cheran|וּכְרָֽן׃ס\rb*.
\li2 \v 42 \rb The sons|בְּֽנֵי־\rb* \rb of Ezer|אֵ֔צֶר\rb*: \rb Bilhan|בִּלְהָ֥ן\rb*, \rb Zaavan|וְזַעֲוָ֖ן\rb*, \rb and Akan|יַעֲקָ֑ן\rb*.\f + \fr 1:42 \ft LXX (see also \ref Genesis 36:27|GEN 36:27\ref*); Hebrew \fqa Jaakan\f*
\li2 \rb The sons|בְּנֵ֥י\rb* \rb of Dishan|דִישׁ֖וֹן\rb*: \rb Uz|ע֥וּץ\rb* \rb and Aran|וַאֲרָֽן׃פ\rb*.
\s1 The Kings of Edom
\r (\ref Genesis 36:31–43|GEN 36:31-43\ref*)
\p \v 43 \rb These are|וְאֵ֣לֶּה\rb* \rb the kings|הַמְּלָכִ֗ים\rb* \rb who|אֲשֶׁ֤ר\rb* \rb reigned|מָלְכוּ֙\rb* \rb in the land|בְּאֶ֣רֶץ\rb* \rb of Edom|אֱד֔וֹם\rb* \rb before|לִפְנֵ֥י\rb* \rb any king|מֶ֖לֶךְ\rb* \rb reigned|מְלָךְ־\rb* \rb over the Israelites|לִבְנֵ֣י\rb*\rb |יִשְׂרָאֵ֑ל\rb*:\f + \fr 1:43 \ft Or \fqa before an Israelite king ruled over them\f*
\b 
\li1 \rb Bela|בֶּ֚לַע\rb* \rb son|בֶּן־\rb* \rb of Beor|בְּע֔וֹר\rb*. \rb His city|עִיר֖וֹ\rb* \rb was named|וְשֵׁ֥ם\rb* \rb Dinhabah|דִּנְהָֽבָה׃\rb*.
\b 
\li1 \v 44 \rb When Bela|בָּ֑לַע\rb* \rb died|וַיָּ֖מָת\rb*, \rb Jobab|יוֹבָ֥ב\rb* \rb son|בֶּן־\rb* \rb of Zerah|זֶ֖רַח\rb* \rb from Bozrah|מִבָּצְרָֽה׃\rb* \rb reigned|וַיִּמְלֹ֣ךְ\rb* \rb in his place|תַּחְתָּ֔יו\rb*.
\b 
\li1 \v 45 \rb When Jobab|יוֹבָ֑ב\rb* \rb died|וַיָּ֖מָת\rb*, \rb Husham|חוּשָׁ֖ם\rb* \rb from the land|מֵאֶ֥רֶץ\rb* \rb of the Temanites|הַתֵּימָנִֽי׃\rb* \rb reigned|וַיִּמְלֹ֣ךְ\rb* \rb in his place|תַּחְתָּ֔יו\rb*.
\b 
\li1 \v 46 \rb When Husham|חוּשָׁ֑ם\rb* \rb died|וַיָּ֖מָת\rb*, \rb Hadad|הֲדַ֣ד\rb* \rb son|בֶּן־\rb* \rb of Bedad|בְּדַ֗ד\rb*, \rb who defeated|הַמַּכֶּ֤ה\rb*\rb |אֶת־\rb* \rb Midian|מִדְיָן֙\rb* \rb in the country|בִּשְׂדֵ֣ה\rb* \rb of Moab|מוֹאָ֔ב\rb*, \rb reigned|וַיִּמְלֹ֨ךְ\rb* \rb in his place|תַּחְתָּ֜יו\rb*. \rb And the name|וְשֵׁ֥ם\rb* \rb of his city|עִיר֖וֹ׃\rb* \rb was Avith|עֲיוֹת׃\rb*.
\b 
\li1 \v 47 \rb When Hadad|הֲדָ֑ד\rb* \rb died|וַיָּ֖מָת\rb*, \rb Samlah|שַׂמְלָ֖ה\rb* \rb from Masrekah|מִמַּשְׂרֵקָֽה׃\rb* \rb reigned|וַיִּמְלֹ֣ךְ\rb* \rb in his place|תַּחְתָּ֔יו\rb*.
\b 
\li1 \v 48 \rb When Samlah|שַׂמְלָ֑ה\rb* \rb died|וַיָּ֖מָת\rb*, \rb Shaul|שָׁא֖וּל\rb* \rb from Rehoboth|מֵרְחֹב֥וֹת\rb* \rb on the Euphrates|הַנָּהָֽר׃\rb*\f + \fr 1:48 \ft Hebrew \fqa the River\f* \rb reigned|וַיִּמְלֹ֣ךְ\rb* \rb in his place|תַּחְתָּ֔יו\rb*.
\b 
\li1 \v 49 \rb When Shaul|שָׁא֑וּל\rb* \rb died|וַיָּ֖מָת\rb*,\rb |בַּ֥עַל\rb* \rb Baal-hanan|חָנָ֖ן\rb* \rb son|בֶּן־\rb* \rb of Achbor|עַכְבּֽוֹר׃\rb* \rb reigned|וַיִּמְלֹ֣ךְ\rb* \rb in his place|תַּחְתָּ֔יו\rb*.
\b 
\li1 \v 50 \rb |בַּ֣עַל\rb* \rb When Baal-hanan|חָנָ֔ן\rb* \rb died|וַיָּ֙מָת֙\rb*, \rb Hadad|הֲדַ֔ד\rb* \rb reigned|וַיִּמְלֹ֤ךְ\rb* \rb in his place|תַּחְתָּיו֙\rb*. \rb His city|עִיר֖וֹ\rb* \rb was named|וְשֵׁ֥ם\rb* \rb Pau|פָּ֑עִי\rb*,\f + \fr 1:50 \ft Many MT manuscripts, some LXX manuscripts, Vulgate, and Syriac (see also \ref Genesis 36:39|GEN 36:39\ref*); most MT manuscripts \fqa Pai\f* \rb and his wife’s|אִשְׁתּ֤וֹ\rb* \rb name|וְשֵׁ֨ם\rb* \rb was Mehetabel|מְהֵיטַבְאֵל֙\rb* \rb daughter|בַּת־\rb* \rb of Matred|מַטְרֵ֔ד\rb*, \rb the daughter|בַּ֖ת\rb*\rb |מֵ֥י\rb* \rb of Me-zahab|זָהָֽב׃\rb*.
\b 
\li1 \v 51 \rb Then Hadad|הֲדָ֑דס\rb*\rb |וַיִּהְיוּ֙\rb* \rb died|וַיָּ֖מָת\rb*.
\p \rb Now the chiefs|אַלּוּפֵ֣י\rb* \rb of Edom were|אֱד֔וֹם\rb*\rb |אַלּ֥וּף\rb* \rb Timna|תִּמְנָ֛ע\rb*,\rb |אַלּ֥וּף\rb* \rb Alvah|עַלְיָה\rb*,\rb |אַלּ֥וּף\rb* \rb Jetheth|יְתֵֽת׃\rb*, \v 52 \rb |אַלּ֧וּף\rb* \rb Oholibamah|אָהֳלִיבָמָ֛ה\rb*,\rb |אַלּ֥וּף\rb* \rb Elah|אֵלָ֖ה\rb*,\rb |אַלּ֥וּף\rb* \rb Pinon|פִּינֹֽן׃\rb*, \v 53 \rb |אַלּ֥וּף\rb* \rb Kenaz|קְנַ֛ז\rb*,\rb |אַלּ֥וּף\rb* \rb Teman|תֵּימָ֖ן\rb*,\rb |אַלּ֣וּף\rb* \rb Mibzar|מִבְצָֽר׃\rb*, \v 54 \rb |אַלּ֥וּף\rb* \rb Magdiel|מַגְדִּיאֵ֖ל\rb*,\rb |אַלּ֣וּף\rb* \rb and Iram|עִירָ֑ם\rb*. \rb These|אֵ֖לֶּה\rb* \rb were the chiefs|אַלּוּפֵ֥י\rb* \rb of Edom|אֱדֽוֹם׃פ\rb*.
\c 2
\s1 The Sons of Israel
\r (\ref Genesis 35:21–26|GEN 35:21-26\ref*; \ref Genesis 38:1–30|GEN 38:1-30\ref*)
\p \v 1 \rb These were|אֵ֖לֶּה\rb* \rb the sons|בְּנֵ֣י\rb* \rb of Israel|יִשְׂרָאֵ֑ל\rb*:
\b 
\li1 \rb Reuben|רְאוּבֵ֤ן\rb*, \rb Simeon|שִׁמְעוֹן֙\rb*, \rb Levi|לֵוִ֣י\rb*, \rb Judah|וִיהוּדָ֔ה\rb*, \rb Issachar|יִשָׂשכָ֖ר\rb*, \rb Zebulun|וּזְבֻלֽוּן׃\rb*, \v 2 \rb Dan|דָּ֚ן\rb*, \rb Joseph|יוֹסֵ֣ף\rb*, \rb Benjamin|וּבִנְיָמִ֔ן\rb*, \rb Naphtali|נַפְתָּלִ֖י\rb*, \rb Gad|גָּ֥ד\rb*, \rb and Asher|וְאָשֵֽׁר׃ס\rb*.
\b 
\li1 \v 3 \rb The sons|בְּנֵ֣י\rb* \rb of Judah|יְהוּדָ֗ה\rb*:
\li2 \rb Er|עֵ֤ר\rb*, \rb Onan|וְאוֹנָן֙\rb*, \rb and Shelah|וְשֵׁלָ֔ה\rb*. \rb These three|שְׁלוֹשָׁה֙\rb* \rb were born|נ֣וֹלַד\rb* \rb to him by|ל֔וֹ\rb*\rb |מִבַּת־\rb* \rb Bath-shua|שׁ֖וּעַ\rb* \rb the Canaanite|הַֽכְּנַעֲנִ֑ית\rb*. \rb Er|עֵ֣ר׀\rb*, \rb Judah’s|יְהוּדָ֗ה\rb* \rb firstborn|בְּכ֣וֹר\rb*, \rb was|וַיְהִ֞י\rb* \rb wicked|רַ֛ע\rb* \rb in the sight|בְּעֵינֵ֥י\rb* \rb of the LORD|יְהוָ֖ה\rb*. \rb So the LORD put him to death|וַיְמִיתֵֽהוּ׃ס\rb*.
\li2 \v 4 \rb Tamar|וְתָמָר֙\rb*, \rb Judah’s daughter-in-law|כַּלָּת֔וֹ\rb*, \rb bore|יָ֥לְדָה\rb* \rb to him|לּ֖וֹ\rb*\rb |אֶת־\rb* \rb Perez|פֶּ֣רֶץ\rb*\rb |וְאֶת־\rb* \rb and Zerah|זָ֑רַח\rb*. \rb Judah|יְהוּדָ֖ה\rb* \rb had five|חֲמִשָּֽׁה׃ס\rb* \rb sons|בְּנֵ֥י\rb* \rb in all|כָּל־\rb*.
\b 
\li1 \v 5 \rb The sons|בְּנֵי־\rb* \rb of Perez|פֶ֖רֶץ\rb*:
\li2 \rb Hezron|חֶצְר֥וֹן\rb* \rb and Hamul|וְחָמֽוּל׃ס\rb*.
\b 
\li1 \v 6 \rb The sons|וּבְנֵ֣י\rb* \rb of Zerah|זֶ֗רַח\rb*:
\li2 \rb Zimri|זִ֠מְרִי\rb*,\f + \fr 2:6 \fqa Zimri \ft is a variant of \fqa Zabdi\ft ; see \ref Joshua 7:1|JOS 7:1\ref*.\f* \rb Ethan|וְאֵיתָ֧ן\rb*, \rb Heman|וְהֵימָ֛ן\rb*, \rb Calcol|וְכַלְכֹּ֥ל\rb*, \rb and Dara|וָדָ֖רַע\rb*\f + \fr 2:6 \ft Most Hebrew manuscripts; many Hebrew manuscripts, some LXX manuscripts, and Syriac (see also \ref 1 Kings 4:31|1KI 4:31\ref*) \fqa Darda\f*— \rb five|חֲמִשָּֽׁה׃ס\rb* \rb in all|כֻּלָּ֥ם\rb*.
\b 
\li1 \v 7 \rb The son|וּבְנֵ֖י\rb*\f + \fr 2:7 \ft Hebrew \fqa sons\f* \rb of Carmi|כַּרְמִ֑י\rb*:
\li2 \rb Achar|עָכָר֙\rb*,\f + \fr 2:7 \fqa Achar \ft means \fqa troubler\ft ; also called \fqa Achan \ft in Joshua 7 and Joshua 22.\f* \rb who brought trouble|עוֹכֵ֣ר\rb* \rb upon Israel|יִשְׂרָאֵ֔ל\rb*\rb |אֲשֶׁ֥ר\rb* \rb by violating|מָעַ֖ל\rb* \rb the ban on devoted things|בַּחֵֽרֶם׃ס\rb*.
\b 
\li1 \v 8 \rb The son|וּבְנֵ֥י\rb* \rb of Ethan|אֵיתָ֖ן\rb*:
\li2 \rb Azariah|עֲזַרְיָֽה׃\rb*.
\b 
\li1 \v 9 \rb The sons|וּבְנֵ֥י\rb* \rb who|אֲשֶׁ֣ר\rb* \rb were born|נוֹלַד־\rb* \rb to Hezron|חֶצְר֖וֹן\rb*:\rb |אֶת־\rb*
\li2 \rb Jerahmeel|יְרַחְמְאֵ֥ל\rb*,\rb |וְאֶת־\rb* \rb Ram|רָ֖ם\rb*,\rb |וְאֶת־\rb* \rb and Caleb|כְּלוּבָֽי׃\rb*.\f + \fr 2:9 \ft Hebrew \fqa Chelubai\ft , a variant of \fqa Caleb\ft ; see verse 18.\f*
\b 
\li1 \v 10 \rb Ram|וְרָ֖ם\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Amminadab|עַמִּינָדָ֑ב\rb*, \rb and Amminadab|וְעַמִּינָדָב֙\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Nahshon|נַחְשׁ֔וֹן\rb*, \rb a leader|נְשִׂ֖יא\rb* \rb of the descendants|בְּנֵ֥י\rb* \rb of Judah|יְהוּדָֽה׃\rb*.
\b 
\li1 \v 11 \rb Nahshon|וְנַחְשׁוֹן֙\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Salmon|שַׂלְמָ֔א\rb*,\f + \fr 2:11 \ft LXX (see also \ref Ruth 4:20–21|RUT 4:20-21\ref*); Hebrew \fqa Salma\ft ; twice in this verse\f* \rb and Salmon|וְשַׂלְמָ֖א\rb* \rb was the father of|הוֹלִ֥יד\rb*\rb |אֶת־\rb* \rb Boaz|בֹּֽעַז׃\rb*.
\b 
\li1 \v 12 \rb Boaz|וּבֹ֙עַז֙\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Obed|עוֹבֵ֔ד\rb*, \rb and Obed|וְעוֹבֵ֖ד\rb* \rb was the father of|הוֹלִ֥יד\rb*\rb |אֶת־\rb* \rb Jesse|יִשָֽׁי׃\rb*.
\b 
\li1 \v 13 \rb Jesse|וְאִישַׁ֛י\rb* \rb was the father of|הוֹלִ֥יד\rb*\rb |אֶת־\rb* \rb Eliab|אֱלִיאָ֑ב\rb* \rb his firstborn|בְּכֹר֖וֹ\rb*;\rb |אֶת־\rb* \rb Abinadab|וַאֲבִינָדָב֙\rb* \rb was born second|הַשֵּׁנִ֔י\rb*, \rb Shimea|וְשִׁמְעָ֖א\rb*\f + \fr 2:13 \fqa Shimea \ft is a variant of \fqa Shammah\ft , \fqa Shimeah\ft , and \fqa Shimei\ft ; see \ref 1 Samuel 16:9|1SA 16:9\ref*, 2 Samuel 13:3, and 2 Samuel 21:21.\f* \rb third|הַשְּׁלִישִֽׁי׃\rb*, \v 14 \rb Nethanel|נְתַנְאֵל֙\rb* \rb fourth|הָֽרְבִיעִ֔י\rb*, \rb Raddai|רַדַּ֖י\rb* \rb fifth|הַחֲמִישִֽׁי׃\rb*, \v 15 \rb Ozem|אֹ֚צֶם\rb* \rb sixth|הַשִּׁשִּׁ֔י\rb*, \rb and David|דָּוִ֖יד\rb* \rb seventh|הַשְּׁבִעִֽי׃\rb*. \v 16 \rb Their sisters|וְאַחְיֹתֵיהֶם\rb* \rb were Zeruiah|צְרוּיָ֣ה\rb* \rb and Abigail|וַאֲבִיגָ֑יִל\rb*. \rb And the three|שְׁלֹשָֽׁה׃\rb* \rb sons|וּבְנֵ֣י\rb* \rb of Zeruiah were|צְרוּיָ֗ה\rb* \rb Abishai|אַבְשַׁ֛י\rb*, \rb Joab|וְיוֹאָ֥ב\rb*,\rb |וַעֲשָׂה־\rb* \rb and Asahel|אֵ֖ל\rb*. \v 17 \rb Abigail|וַאֲבִיגַ֕יִל\rb* \rb was the mother|יָלְדָ֖ה\rb*\rb |אֶת־\rb* \rb of Amasa|עֲמָשָׂ֑א\rb*, \rb whose|עֲמָשָׂ֔א\rb* \rb father|וַאֲבִ֣י\rb* \rb was Jether|יֶ֖תֶר\rb*\f + \fr 2:17 \fqa Jether \ft is a variant of \fqa Ithra\ft ; see \ref 2 Samuel 17:25|2SA 17:25\ref*.\f* \rb the Ishmaelite|הַיִּשְׁמְעֵאלִֽי׃\rb*.
\b 
\li1 \v 18 \rb Caleb|וְכָלֵ֣ב\rb* \rb son|בֶּן־\rb* \rb of Hezron|חֶצְר֗וֹן\rb* \rb had children|הוֹלִ֛יד\rb*\rb |אֶת־\rb* \rb by his wife|אִשָּׁ֖ה\rb*\rb |וְאֶת־\rb* \rb Azubah|עֲזוּבָ֥ה\rb* \rb and by Jerioth|יְרִיע֑וֹת\rb*. \rb These were|וְאֵ֣לֶּה\rb* \rb the sons of Azubah|בָנֶ֔יהָ\rb*: \rb Jesher|יֵ֥שֶׁר\rb*, \rb Shobab|וְשׁוֹבָ֖ב\rb*, \rb and Ardon|וְאַרְדּֽוֹן׃\rb*. \v 19 \rb When Azubah|עֲזוּבָ֑ה\rb* \rb died|וַתָּ֖מָת\rb*, \rb Caleb|כָלֵב֙\rb*\rb |אֶת־\rb* \rb married|וַיִּֽקַּֽח־\rb*\rb |ל֤וֹ\rb* \rb Ephrath|אֶפְרָ֔ת\rb*,\f + \fr 2:19 \fqa Ephrath \ft is a variant of \fqa Ephrathah\ft ; see verse 50.\f* \rb who bore|וַתֵּ֥לֶד\rb* \rb to him|ל֖וֹ\rb*\rb |אֶת־\rb* \rb Hur|חֽוּר׃\rb*. \v 20 \rb Hur|וְחוּר֙\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Uri|אוּרִ֔י\rb*, \rb and Uri|וְאוּרִ֖י\rb* \rb was the father of|הוֹלִ֥יד\rb*\rb |אֶת־\rb* \rb Bezalel|בְּצַלְאֵֽל׃ס\rb*.
\b 
\li1 \v 21 \rb Later|וְאַחַ֗ר\rb*, \rb Hezron|חֶצְרוֹן֙\rb* \rb slept with|בָּ֤א\rb*\rb |אֶל־\rb* \rb the daughter|בַּת־\rb* \rb of Machir|מָכִיר֙\rb* \rb the father|אֲבִ֣י\rb* \rb of Gilead|גִלְעָ֔ד\rb*. \rb He|וְה֣וּא\rb* \rb had married her|לְקָחָ֔הּ\rb* \rb when he|וְה֖וּא\rb* \rb was sixty|שִׁשִּׁ֣ים\rb* \rb years old|בֶּן־\rb*\rb |שָׁנָ֑ה\rb*, \rb and she bore|וַתֵּ֥לֶד\rb* \rb to him|ל֖וֹ\rb*\rb |אֶת־\rb* \rb Segub|שְׂגֽוּב׃\rb*. \v 22 \rb Segub|וּשְׂג֖וּב\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Jair|יָאִ֑יר\rb*, \rb who had|וַֽיְהִי־\rb* \rb twenty-three|עֶשְׂרִ֤ים\rb*\rb |וְשָׁלוֹשׁ֙\rb* \rb cities|עָרִ֔ים\rb* \rb in the land|בְּאֶ֖רֶץ\rb* \rb of Gilead|הַגִּלְעָֽד׃\rb*. \v 23 \rb But Geshur|גְּשֽׁוּר־\rb* \rb and Aram|וַ֠אֲרָם\rb*\rb |אֶת־\rb* \rb captured|וַיִּקַּ֣ח\rb*\rb |חַוֺּ֨ת\rb* \rb Havvoth-jair|יָאִ֧יר\rb*\rb |מֵאִתָּ֛ם\rb*,\f + \fr 2:23 \ft Or \fqa the villages of Jair\f* \rb along with|אֶת־\rb* \rb Kenath|קְנָ֥ת\rb*\rb |וְאֶת־\rb* \rb and its sixty|שִׁשִּׁ֣ים\rb* \rb surrounding|בְּנֹתֶ֖יהָ\rb* \rb villages|עִ֑יר\rb*. \rb All|כָּל־\rb* \rb these were|אֵ֕לֶּה\rb* \rb descendants|בְּנֵ֖י\rb* \rb of Machir|מָכִ֥יר\rb* \rb the father|אֲבִי־\rb* \rb of Gilead|גִלְעָֽד׃\rb*.
\b 
\li1 \v 24 \rb After|וְאַחַ֥ר\rb* \rb Hezron|חֶצְר֖וֹן\rb*\rb |בְּכָלֵ֣ב\rb* \rb died|מוֹת־\rb* \rb in Caleb-ephrathah|אֶפְרָ֑תָה\rb*, \rb his|חֶצְרוֹן֙\rb* \rb wife|וְאֵ֤שֶׁת\rb* \rb Abijah|אֲבִיָּ֔ה\rb* \rb bore|וַתֵּ֣לֶד\rb*\f + \fr 2:24 \ft Or \fqa After Hezron died, Caleb had relations with Ephrathah, the wife of Hezron his father, and she bore\ft ; see also LXX.\f* \rb to him|ל֔וֹ\rb*\rb |אֶת־\rb* \rb Ashhur|אַשְׁח֖וּר\rb* \rb the father|אֲבִ֥י\rb*\f + \fr 2:24 \ft Or \fqa the founder\ft ; also in verses 42, 45, 49, and possibly elsewhere\f* \rb of Tekoa|תְקֽוֹעַ׃\rb*.
\b 
\li1 \v 25 \rb |וַיִּהְי֧וּ\rb* \rb The sons|בְנֵי־\rb* \rb of Jerahmeel|יְרַחְמְאֵ֛ל\rb* \rb the firstborn|בְּכ֥וֹר\rb* \rb of Hezron|חֶצְר֖וֹן\rb*:
\li2 \rb Ram|רָ֑ם\rb* \rb his firstborn|הַבְּכ֣וֹר׀\rb*, \rb Bunah|וּבוּנָ֥ה\rb*, \rb Oren|וָאֹ֛רֶן\rb*, \rb Ozem|וָאֹ֖צֶם\rb*, \rb and Ahijah|אֲחִיָּֽה׃\rb*. \v 26 \rb Jerahmeel|לִֽירַחְמְאֵ֖ל\rb* \rb had|וַתְּהִ֨י\rb* \rb another|אַחֶ֛רֶת\rb* \rb wife|אִשָּׁ֥ה\rb* \rb named|וּשְׁמָ֣הּ\rb* \rb Atarah|עֲטָרָ֑ה\rb*, \rb who|הִ֖יא\rb* \rb was the mother|אֵ֥ם\rb* \rb of Onam|אוֹנָֽם׃ס\rb*.
\b 
\li1 \v 27 \rb |וַיִּהְי֥וּ\rb* \rb The sons|בְנֵי־\rb* \rb of Ram|רָ֖ם\rb* \rb the firstborn|בְּכ֣וֹר\rb* \rb of Jerahmeel|יְרַחְמְאֵ֑ל\rb*:
\li2 \rb Maaz|מַ֥עַץ\rb*, \rb Jamin|וְיָמִ֖ין\rb*, \rb and Eker|וָעֵֽקֶר׃\rb*.
\b 
\li1 \v 28 \rb |וַיִּהְי֥וּ\rb* \rb The sons|בְנֵי־\rb* \rb of Onam|אוֹנָ֖ם\rb*:
\li2 \rb Shammai|שַׁמַּ֣י\rb* \rb and Jada|וְיָדָ֑ע\rb*.
\b 
\li1 \rb The sons|וּבְנֵ֣י\rb* \rb of Shammai|שַׁמַּ֔י\rb*:
\li2 \rb Nadab|נָדָ֖ב\rb* \rb and Abishur|וַאֲבִישֽׁוּר׃\rb*. \v 29 \rb Abishur’s|אֲבִישׁ֖וּר\rb* \rb wife|אֵ֥שֶׁת\rb* \rb was named|וְשֵׁ֛ם\rb* \rb Abihail|אֲבִיהָ֑יִל\rb*, \rb and she bore|וַתֵּ֣לֶד\rb* \rb to him|ל֔וֹ\rb*\rb |אֶת־\rb* \rb Ahban|אַחְבָּ֖ן\rb* \rb and|וְאֶת־\rb* \rb Molid|מוֹלִֽיד׃\rb*.
\b 
\li1 \v 30 \rb The sons|וּבְנֵ֥י\rb* \rb of Nadab|נָדָ֖ב\rb*:
\li2 \rb Seled|סֶ֣לֶד\rb* \rb and Appaim|וְאַפָּ֑יִם\rb*. \rb Seled|סֶ֖לֶד\rb* \rb died|וַיָּ֥מָת\rb* \rb without|לֹ֥א\rb* \rb children|בָנִֽים׃ס\rb*.
\b 
\li1 \v 31 \rb The son|וּבְנֵ֥י\rb*\f + \fr 2:31 \ft Hebrew \fqa sons\ft ; three times in this verse\f* \rb of Appaim|אַפַּ֖יִם\rb*:
\li2 \rb Ishi|יִשְׁעִ֑י\rb*.
\b 
\li1 \rb The son|וּבְנֵ֤י\rb* \rb of Ishi|יִשְׁעִי֙\rb*:
\li2 \rb Sheshan|שֵׁשָׁ֔ן\rb*.
\b 
\li1 \rb The son|וּבְנֵ֥י\rb* \rb of Sheshan|שֵׁשָׁ֖ן\rb*:
\li2 \rb Ahlai|אַחְלָֽי׃\rb*.
\b 
\li1 \v 32 \rb The sons|וּבְנֵ֤י\rb* \rb of Jada|יָדָע֙\rb* \rb the brother|אֲחִ֣י\rb* \rb of Shammai|שַׁמַּ֔י\rb*:
\li2 \rb Jether|יֶ֖תֶר\rb* \rb and Jonathan|וְיוֹנָתָ֑ן\rb*. \rb Jether|יֶ֖תֶר\rb* \rb died|וַיָּ֥מָת\rb* \rb without|לֹ֥א\rb* \rb children|בָנִֽים׃ס\rb*.
\b 
\li1 \v 33 \rb The sons|וּבְנֵ֥י\rb* \rb of Jonathan|יוֹנָתָ֖ן\rb*:
\li2 \rb Peleth|פֶּ֣לֶת\rb* \rb and Zaza|וְזָזָ֑א\rb*.
\b 
\li1 \rb These|אֵ֥לֶּה\rb* \rb were|הָי֖וּ\rb* \rb the descendants|בְּנֵ֥י\rb* \rb of Jerahmeel|יְרַחְמְאֵֽל׃\rb*.
\b 
\li1 \v 34 \rb Sheshan|לְשֵׁשָׁ֛ן\rb* \rb had|הָיָ֧ה\rb* \rb no|וְלֹֽא־\rb* \rb sons|בָּנִ֖ים\rb*, \rb but only|כִּ֣י\rb*\rb |אִם־\rb* \rb daughters|בָּנ֑וֹת\rb*. \rb He also had|וּלְשֵׁשָׁ֛ן\rb* \rb an Egyptian|מִצְרִ֖י\rb* \rb servant|עֶ֥בֶד\rb* \rb named|וּשְׁמ֥וֹ\rb* \rb Jarha|יַרְחָֽע׃\rb*. \v 35 \rb Sheshan|שֵׁשָׁ֧ן\rb*\rb |אֶת־\rb* \rb gave his daughter|בִּתּ֛וֹ\rb* \rb in marriage|וַיִּתֵּ֨ן\rb*\rb |לְאִשָּׁ֑ה\rb* \rb to his servant|עַבְדּ֖וֹ\rb* \rb Jarha|לְיַרְחָ֥ע\rb*, \rb and she bore|וַתֵּ֥לֶד\rb* \rb to him|ל֖וֹ\rb*\rb |אֶת־\rb* \rb Attai|עַתָּֽי׃\rb*.
\b 
\li1 \v 36 \rb Attai|וְעַתַּי֙\rb* \rb was the father of|הֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Nathan|נָתָ֔ן\rb*, \rb Nathan|וְנָתָ֖ן\rb* \rb was the father of|הוֹלִ֥יד\rb*\rb |אֶת־\rb* \rb Zabad|זָבָֽד׃\rb*, \v 37 \rb Zabad|וְזָבָד֙\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Ephlal|אֶפְלָ֔ל\rb*, \rb Ephlal|וְאֶפְלָ֖ל\rb* \rb was the father of|הוֹלִ֥יד\rb*\rb |אֶת־\rb* \rb Obed|עוֹבֵֽד׃\rb*, \v 38 \rb Obed|וְעוֹבֵד֙\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Jehu|יֵה֔וּא\rb*, \rb Jehu|וְיֵה֖וּא\rb* \rb was the father of|הוֹלִ֥יד\rb*\rb |אֶת־\rb* \rb Azariah|עֲזַרְיָֽה׃\rb*, \v 39 \rb Azariah|וַעֲזַרְיָה֙\rb* \rb was the father of|הֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Helez|חָ֔לֶץ\rb*, \rb Helez|וְחֶ֖לֶץ\rb* \rb was the father of|הֹלִ֥יד\rb*\rb |אֶת־\rb* \rb Elasah|אֶלְעָשָֽׂה׃\rb*, \v 40 \rb Elasah|וְאֶלְעָשָׂה֙\rb* \rb was the father of|הֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Sismai|סִֽסְמָ֔י\rb*, \rb Sismai|וְסִסְמַ֖י\rb* \rb was the father of|הֹלִ֥יד\rb*\rb |אֶת־\rb* \rb Shallum|שַׁלּֽוּם׃\rb*, \v 41 \rb Shallum|וְשַׁלּוּם֙\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Jekamiah|יְקַמְיָ֔ה\rb*, \rb and Jekamiah|וִֽיקַמְיָ֖ה\rb* \rb was the father of|הֹלִ֥יד\rb*\rb |אֶת־\rb* \rb Elishama|אֱלִישָׁמָֽע׃\rb*.
\b 
\li1 \v 42 \rb The sons|וּבְנֵ֤י\rb* \rb of Caleb|כָלֵב֙\rb* \rb the brother|אֲחִ֣י\rb* \rb of Jerahmeel|יְרַחְמְאֵ֔ל\rb*:
\li2 \rb Mesha|מֵישָׁ֥ע\rb*\f + \fr 2:42 \ft Hebrew; LXX \fqa Mareshah\f* \rb his firstborn|בְּכֹר֖וֹ\rb*, \rb who|ה֣וּא\rb* \rb was the father of|אֲבִי־\rb* \rb Ziph|זִ֑יף\rb*, \rb and Mareshah|מָרֵשָׁ֖ה\rb* \rb his second son|וּבְנֵ֥י\rb*, \rb who was the father of|אֲבִ֥י\rb* \rb Hebron|חֶבְרֽוֹן׃\rb*.
\b 
\li1 \v 43 \rb The sons|וּבְנֵ֖י\rb* \rb of Hebron|חֶבְר֑וֹן\rb*:
\li2 \rb Korah|קֹ֥רַח\rb*, \rb Tappuah|וְתַפֻּ֖חַ\rb*, \rb Rekem|וְרֶ֥קֶם\rb*, \rb and Shema|וָשָֽׁמַע׃\rb*. \v 44 \rb Shema|וְשֶׁ֣מַע\rb* \rb was the father of|הוֹלִ֔יד\rb*\rb |אֶת־\rb* \rb Raham|רַ֖חַם\rb* \rb the father|אֲבִ֣י\rb* \rb of Jorkeam|יָרְקֳעָ֑ם\rb*, \rb and Rekem|וְרֶ֖קֶם\rb* \rb was the father of|הוֹלִ֥יד\rb*\rb |אֶת־\rb* \rb Shammai|שַׁמָּֽי׃\rb*. \v 45 \rb The son|וּבֶן־\rb* \rb of Shammai|שַׁמַּ֖י\rb* \rb was Maon|מָע֑וֹן\rb*, \rb and Maon|וּמָע֖וֹן\rb* \rb was the father of|אֲבִ֥י\rb*\rb |בֵֽית־\rb* \rb Beth-zur|צֽוּר׃\rb*.
\b 
\li1 \v 46 \rb Caleb’s|כָּלֵ֔ב\rb* \rb concubine|פִּילֶ֣גֶשׁ\rb* \rb Ephah|וְעֵיפָה֙\rb* \rb was the mother|יָֽלְדָ֛ה\rb*\rb |אֶת־\rb* \rb of Haran|חָרָ֥ן\rb*,\rb |וְאֶת־\rb* \rb Moza|מוֹצָ֖א\rb*,\rb |וְאֶת־\rb* \rb and Gazez|גָּזֵ֑ז\rb*. \rb Haran|וְחָרָ֖ן\rb* \rb was the father of|הֹלִ֥יד\rb*\rb |אֶת־\rb* \rb Gazez|גָּזֵֽז׃ס\rb*.
\b 
\li1 \v 47 \rb The sons|וּבְנֵ֖י\rb* \rb of Jahdai|יָהְדָּ֑י\rb*:
\li2 \rb Regem|רֶ֧גֶם\rb*, \rb Jotham|וְיוֹתָ֛ם\rb*, \rb Geshan|וְגֵישָׁ֥ן\rb*, \rb Pelet|וָפֶ֖לֶט\rb*, \rb Ephah|וְעֵיפָ֥ה\rb*, \rb and Shaaph|וָשָֽׁעַף׃\rb*.
\b 
\li1 \v 48 \rb Caleb’s|כָּלֵב֙\rb* \rb concubine|פִּלֶ֤גֶשׁ\rb* \rb Maacah|מַעֲכָ֔ה\rb* \rb was the mother|יָ֥לַד\rb* \rb of Sheber|שֶׁ֖בֶר\rb*\rb |וְאֶֽת־\rb* \rb and Tirhanah|תִּרְחֲנָֽה׃\rb*. \v 49 \rb She was also the mother|וַתֵּ֗לֶד\rb* \rb of Shaaph|שַׁ֚עַף\rb* \rb father|אֲבִ֣י\rb* \rb of Madmannah|מַדְמַנָּ֔ה\rb*,\rb |אֶת־\rb* \rb and of Sheva|שְׁוָ֛א\rb* \rb father|אֲבִ֥י\rb* \rb of Machbenah|מַכְבֵּנָ֖ה\rb*\rb |וַאֲבִ֣י\rb* \rb and Gibea|גִבְעָ֑א\rb*. \rb Caleb’s|כָּלֵ֖ב\rb* \rb daughter|וּבַת־\rb* \rb was Acsah|עַכְסָֽה׃ס\rb*. \v 50 \rb These|אֵ֤לֶּה\rb* \rb were|הָיוּ֙\rb* \rb the descendants|בְּנֵ֣י\rb* \rb of Caleb|כָלֵ֔ב\rb*.
\b 
\li1 \rb The sons|בֶּן־\rb*\f + \fr 2:50 \ft LXX and Vulgate; Hebrew \fqa son\f* \rb of Hur|ח֖וּר\rb* \rb the firstborn|בְּכ֣וֹר\rb* \rb of Ephrathah|אֶפְרָ֑תָה\rb*:\f + \fr 2:50 \fqa Ephrathah \ft is a variant of \fqa Ephrath\ft ; see verse 19.\f*
\li2 \rb Shobal|שׁוֹבָ֕ל\rb* \rb the father|אֲבִ֖י\rb*\rb |קִרְיַ֥ת\rb* \rb of Kiriath-jearim|יְעָרִֽים׃\rb*, \v 51 \rb Salma|שַׂלְמָא֙\rb* \rb the father of|אֲבִ֣י\rb*\rb |בֵֽית־\rb* \rb Bethlehem|לָ֔חֶם\rb*, \rb and Hareph|חָרֵ֖ף\rb* \rb the father|אֲבִ֥י\rb*\rb |בֵית־\rb* \rb of Beth-gader|גָּדֵֽר׃\rb*.
\b 
\li1 \v 52 \rb These were|וַיִּהְי֤וּ\rb* \rb the descendants|בָנִים֙\rb* \rb of Shobal|לְשׁוֹבָ֔ל\rb* \rb the father|אֲבִ֖י\rb*\rb |קִרְיַ֣ת\rb* \rb of Kiriath-jearim|יְעָרִ֑ים\rb*:
\li2 \rb Haroeh|הָרֹאֶ֖ה\rb*, \rb half|חֲצִ֥י\rb* \rb the Manahathites|הַמְּנֻחֽוֹת׃\rb*, \v 53 \rb and the clans|וּמִשְׁפְּחוֹת֙\rb*\rb |קִרְיַ֣ת\rb* \rb of Kiriath-jearim|יְעָרִ֔ים\rb*— \rb the Ithrites|הַיִּתְרִי֙\rb*, \rb Puthites|וְהַפּוּתִ֔י\rb*, \rb Shumathites|וְהַשֻּׁמָתִ֖י\rb*, \rb and Mishraites|וְהַמִּשְׁרָעִ֑י\rb*. \rb From these|מֵאֵ֗לֶּה\rb* \rb descended|יָצְאוּ֙\rb* \rb the Zorathites|הַצָּ֣רְעָתִ֔י\rb* \rb and Eshtaolites|וְהָאֶשְׁתָּ֖אֻֽלִֽי׃ס\rb*.
\b 
\li1 \v 54 \rb The descendants|בְּנֵ֣י\rb* \rb of Salma|שַׂלְמָ֗א\rb*:
\li2 \rb |בֵּ֥ית\rb* \rb Bethlehem|לֶ֙חֶם֙\rb*, \rb the Netophathites|וּנְט֣וֹפָתִ֔י\rb*,\rb |עַטְר֖וֹת\rb*\rb |בֵּ֣ית\rb* \rb Atroth-beth-joab|יוֹאָ֑ב\rb*, \rb half|וַחֲצִ֥י\rb* \rb the Manahathites|הַמָּנַחְתִּ֖י\rb*, \rb the Zorites|הַצָּרְעִֽי׃\rb*, \v 55 \rb and the clans|וּמִשְׁפְּח֤וֹת\rb* \rb of the scribes|סֹפְרִים֙\rb*\f + \fr 2:55 \ft Or \fqa of the Sopherites \ft \f* \rb who lived|יֹשְׁבוּ\rb* \rb at Jabez|יַעְבֵּ֔ץ\rb*— \rb the Tirathites|תִּרְעָתִ֥ים\rb*, \rb Shimeathites|שִׁמְעָתִ֖ים\rb*, \rb and Sucathites|שׂוּכָתִ֑ים\rb*. \rb These|הֵ֚מָּה\rb* \rb are the Kenites|הַקִּינִ֣ים\rb* \rb who came|הַבָּאִ֔ים\rb* \rb from Hammath|מֵחַמַּ֖ת\rb*, \rb the father|אֲבִ֥י\rb* \rb of the house|בֵית־\rb* \rb of Rechab|רֵכָֽב׃ס\rb*.\f + \fr 2:55 \ft Or \fqa the father of Beth-rekab \ft or \fqa the founder of the house of Rechab\f*
\c 3
\s1 The Descendants of David
\r (\ref 2 Samuel 3:1–5|2SA 3:1-5\ref*)
\p \v 1 \rb These|וְאֵ֤לֶּה\rb* \rb were|הָיוּ֙\rb* \rb the sons|בְּנֵ֣י\rb* \rb of David|דָויִ֔ד\rb* \rb who|אֲשֶׁ֥ר\rb* \rb were born|נֽוֹלַד־\rb* \rb to him|ל֖וֹ\rb* \rb in Hebron|בְּחֶבְר֑וֹן\rb*:
\b 
\li1 \rb The firstborn|הַבְּכ֣וֹר׀\rb* \rb was Amnon|אַמְנֹ֗ן\rb* \rb by Ahinoam|לַאֲחִינֹ֙עַם֙\rb* \rb of Jezreel|הַיִּזְרְעֵאלִ֔ית\rb*;
\b 
\li1 \rb the second|שֵׁנִי֙\rb* \rb was Daniel|דָּנִיֵּ֔אל\rb* \rb by Abigail|לַאֲבִיגַ֖יִל\rb* \rb of Carmel|הַֽכַּרְמְלִֽית׃\rb*;
\b 
\li1 \v 2 \rb the third|הַשְּׁלִשִׁי֙\rb* \rb was Absalom|לְאַבְשָׁל֣וֹם\rb* \rb the son|בֶּֽן־\rb* \rb of Maacah|מַעֲכָ֔ה\rb* \rb daughter|בַּת־\rb* \rb of King|מֶ֣לֶךְ\rb* \rb Talmai|תַּלְמַ֖י\rb* \rb of Geshur|גְּשׁ֑וּר\rb*;
\b 
\li1 \rb the fourth|הָרְבִיעִ֖י\rb* \rb was Adonijah|אֲדֹנִיָּ֥ה\rb* \rb the son|בֶן־\rb* \rb of Haggith|חַגִּֽית׃\rb*;
\b 
\li1 \v 3 \rb the fifth|הַחֲמִישִׁ֥י\rb* \rb was Shephatiah|שְׁפַטְיָ֖ה\rb* \rb by Abital|לַאֲבִיטָ֑ל\rb*;
\b 
\li1 \rb and the sixth|הַשִּׁשִּׁ֥י\rb* \rb was Ithream|יִתְרְעָ֖ם\rb* \rb by his wife|אִשְׁתּֽוֹ׃\rb* \rb Eglah|לְעֶגְלָ֥ה\rb*.
\b 
\li1 \v 4 \rb These six|שִׁשָּׁה֙\rb* \rb sons were born|נֽוֹלַד־\rb* \rb to David|ל֣וֹ\rb* \rb in Hebron|בְחֶבְר֔וֹן\rb*, \rb where|שָׁ֔ם\rb* \rb he reigned|וַיִּ֨מְלָךְ־\rb* \rb seven|שֶׁ֥בַע\rb* \rb years|שָׁנִ֖ים\rb* \rb and six|וְשִׁשָּׁ֣ה\rb* \rb months|חֳדָשִׁ֑ים\rb*.
\p \rb And David reigned|מָלַ֖ךְ\rb* \rb in Jerusalem|בִּירוּשָׁלִָֽם׃ס\rb* \rb thirty-three|וּשְׁלֹשִׁ֤ים\rb*\rb |וְשָׁלוֹשׁ֙\rb* \rb years|שָׁנָ֔ה\rb*, \v 5 \rb and these sons|וְאֵ֥לֶּה\rb* \rb were born|נוּלְּדוּ־\rb* \rb to him|ל֖וֹ\rb* \rb in Jerusalem|בִּירוּשָׁלָ֑יִם\rb*:
\b 
\li1 \rb Shimea|שִׁ֠מְעָא\rb*,\f + \fr 3:5 \fqa Shimea \ft is a variant of \fqa Shammua\ft ; see \ref 2 Samuel 5:14|2SA 5:14\ref* and 1 Chronicles 14:4.\f* \rb Shobab|וְשׁוֹבָ֞ב\rb*, \rb Nathan|וְנָתָ֤ן\rb*, \rb and Solomon|וּשְׁלֹמֹה֙\rb*. \rb These four were born to him|אַרְבָּעָ֔ה\rb*\rb |לְבַת־\rb* \rb by Bathsheba|שׁ֖וּעַ\rb*\f + \fr 3:5 \ft One Hebrew manuscript and Vulgate (see also LXX and \ref 2 Samuel 11:3|2SA 11:3\ref*); most Hebrew manuscripts \fqa Bath-shua\f* \rb daughter|בַּת־\rb* \rb of Ammiel|עַמִּיאֵֽל׃\rb*.\f + \fr 3:5 \fqa Ammiel \ft is a variant of \fqa Eliam\ft ; see \ref 2 Samuel 11:3|2SA 11:3\ref*.\f*
\b 
\li1 \v 6 \rb David’s other sons were Ibhar|וְיִבְחָ֥ר\rb*,\f + \fr 3:6 \ft Hebrew does not include \fqa David’s other sons were\ft .\f* \rb Elishua|וֶאֱלִישָׁמָ֖ע\rb*,\f + \fr 3:6 \ft Two Hebrew manuscripts (see also \ref 2 Samuel 5:15|2SA 5:15\ref* and 1 Chronicles 14:5); most Hebrew manuscripts \fqa Elishama\f* \rb Eliphelet|וֶאֱלִיפָֽלֶט׃\rb*, \v 7 \rb Nogah|וְנֹ֥גַהּ\rb*, \rb Nepheg|וְנֶ֖פֶג\rb*, \rb Japhia|וְיָפִֽיעַ׃\rb*, \v 8 \rb Elishama|וֶאֱלִישָׁמָ֧ע\rb*, \rb Eliada|וְאֶלְיָדָ֛ע\rb*, \rb and Eliphelet|וֶאֱלִיפֶ֖לֶט\rb*— \rb nine in all|תִּשְׁעָֽה׃\rb*.
\b 
\li1 \v 9 \rb These were all|כֹּ֖ל\rb* \rb the sons|בְּנֵ֣י\rb* \rb of David|דָוִ֑יד\rb*, \rb besides|מִלְּבַ֥ד\rb* \rb the sons|בְּֽנֵי־\rb* \rb by his concubines|פִֽילַגְשִׁ֖ים\rb*. \rb And Tamar|וְתָמָ֥ר\rb* \rb was their sister|אֲחוֹתָֽם׃פ\rb*.
\s1 The Descendants of Solomon
\li1 \v 10 \rb Solomon’s|שְׁלֹמֹ֖ה\rb* \rb son|וּבֶן־\rb* \rb was Rehoboam|רְחַבְעָ֑ם\rb*:
\li2 \rb Abijah was|אֲבִיָּ֥ה\rb* \rb his son|בְנ֛וֹ\rb*, \rb Asa|אָסָ֥א\rb* \rb his son|בְנ֖וֹ\rb*, \rb Jehoshaphat|יְהוֹשָׁפָ֥ט\rb* \rb his son|בְּנֽוֹ׃\rb*, \v 11 \rb Joram|יוֹרָ֥ם\rb*\f + \fr 3:11 \fqa Joram \ft is a variant spelling of \fqa Jehoram\ft .\f* \rb his son|בְּנ֛וֹ\rb*, \rb Ahaziah|אֲחַזְיָ֥הוּ\rb* \rb his son|בְנ֖וֹ\rb*, \rb Joash|יוֹאָ֥שׁ\rb* \rb his son|בְּנֽוֹ׃\rb*, \v 12 \rb Amaziah|אֲמַצְיָ֧הוּ\rb* \rb his son|בְנ֛וֹ\rb*, \rb Azariah|עֲזַרְיָ֥ה\rb*\f + \fr 3:12 \fqa Azariah \ft is also called \fqa Uzziah\ft ; see \ref 2 Chronicles 26:1|2CH 26:1\ref*.\f* \rb his son|בְנ֖וֹ\rb*, \rb Jotham|יוֹתָ֥ם\rb* \rb his son|בְּנֽוֹ׃\rb*, \v 13 \rb Ahaz|אָחָ֥ז\rb* \rb his son|בְּנ֛וֹ\rb*, \rb Hezekiah|חִזְקִיָּ֥הוּ\rb* \rb his son|בְנ֖וֹ\rb*, \rb Manasseh|מְנַשֶּׁ֥ה\rb* \rb his son|בְנֽוֹ׃\rb*, \v 14 \rb Amon|אָמ֥וֹן\rb* \rb his son|בְּנ֖וֹ\rb*, \rb and Josiah|יֹאשִׁיָּ֥הוּ\rb* \rb his son|בְנֽוֹ׃\rb*.
\b 
\li1 \v 15 \rb The sons|וּבְנֵי֙\rb* \rb of Josiah|יֹאשִׁיָּ֔הוּ\rb*:
\li2 \rb Johanan|יוֹחָנָ֔ן\rb* \rb was the firstborn|הַבְּכוֹר֙\rb*, \rb Jehoiakim|יְהוֹיָקִ֑ים\rb* \rb the second|הַשֵּׁנִ֖י\rb*, \rb Zedekiah|צִדְקִיָּ֔הוּ\rb* \rb the third|הַשְּׁלִשִׁי֙\rb*, \rb and Shallum|שַׁלּֽוּם׃\rb*\f + \fr 3:15 \fqa Shallum \ft is another name for \fqa Jehoahaz\ft .\f* \rb the fourth|הָרְבִיעִ֖י\rb*.
\b 
\li1 \v 16 \rb The successors|וּבְנֵ֖י\rb* \rb of Jehoiakim|יְהוֹיָקִ֑ים\rb*:
\li2 \rb Jeconiah|יְכָנְיָ֥ה\rb*\f + \fr 3:16 \fqa Jeconiah \ft is a variant of \fqa Jehoiachin\ft ; also in verse 17; see \ref 2 Kings 24:6|2KI 24:6\ref*.\f* \rb his son|בְנ֖וֹ\rb*, \rb and Zedekiah|צִדְקִיָּ֥ה\rb*\rb |בְנֽוֹ׃\rb*.
\s1 The Royal Line After the Exile
\li1 \v 17 \rb The descendants|וּבְנֵי֙\rb* \rb of Jeconiah|יְכָנְיָ֣ה\rb* \rb the captive|אַסִּ֔ר\rb*:
\li2 \rb Shealtiel|שְׁאַלְתִּיאֵ֖ל\rb* \rb his son|בְּנֽוֹ׃\rb*, \v 18 \rb Malchiram|וּמַלְכִּירָ֥ם\rb*, \rb Pedaiah|וּפְדָיָ֖ה\rb*, \rb Shenazzar|וְשֶׁנְאַצַּ֑ר\rb*, \rb Jekamiah|יְקַמְיָ֥ה\rb*, \rb Hoshama|הוֹשָׁמָ֖ע\rb*, \rb and Nedabiah|וּנְדַבְיָֽה׃\rb*.
\b 
\li1 \v 19 \rb The sons|וּבְנֵ֣י\rb* \rb of Pedaiah|פְדָיָ֔ה\rb*:
\li2 \rb Zerubbabel|זְרֻבָּבֶ֖ל\rb* \rb and Shimei|וְשִׁמְעִ֑י\rb*.
\b 
\li1 \rb The children|וּבֶן־\rb* \rb of Zerubbabel|זְרֻבָּבֶל֙\rb*:
\li2 \rb Meshullam|מְשֻׁלָּ֣ם\rb* \rb and Hananiah|וַחֲנַנְיָ֔ה\rb*, \rb their sister|אֲחוֹתָֽם׃\rb* \rb Shelomith|וּשְׁלֹמִ֖ית\rb*, \v 20 \rb and five others|חָמֵֽשׁ׃\rb*: \rb Hashubah|וַחֲשֻׁבָ֡ה\rb*, \rb Ohel|וָ֠אֹהֶל\rb*, \rb Berechiah|וּבֶרֶכְיָ֧ה\rb*, \rb Hasadiah|וַֽחֲסַדְיָ֛ה\rb*,\rb |י֥וּשַׁב\rb* \rb and Jushab-hesed|חֶ֖סֶד\rb*.
\b 
\li1 \v 21 \rb The descendants|וּבֶן־\rb* \rb of Hananiah|חֲנַנְיָ֖ה\rb*:
\li2 \rb Pelatiah|פְּלַטְיָ֣ה\rb*, \rb Jeshaiah|וִישַֽׁעְיָ֑ה\rb*, \rb and the sons|בְּנֵ֤י\rb* \rb of Rephaiah|רְפָיָה֙\rb*,\rb |בְּנֵ֣י\rb* \rb of Arnan|אַרְנָ֔ן\rb*,\rb |בְּנֵ֥י\rb* \rb of Obadiah|עֹבַדְיָ֖ה\rb*, \rb and|בְּנֵ֥י\rb* \rb of Shecaniah|שְׁכַנְיָֽה׃ס\rb*.
\b 
\li1 \v 22 \rb The six|שִׁשָּֽׁה׃\rb* \rb descendants|וּבְנֵ֥י\rb* \rb of Shecaniah|שְׁכַנְיָ֖ה\rb* \rb were Shemaiah|שְׁמַעְיָ֑ה\rb* \rb and his|שְׁמַעְיָ֗ה\rb* \rb sons|וּבְנֵ֣י\rb*:
\li2 \rb Hattush|חַטּ֡וּשׁ\rb*, \rb Igal|וְ֠יִגְאָל\rb*, \rb Bariah|וּבָרִ֧יחַ\rb*, \rb Neariah|וּנְעַרְיָ֛ה\rb*, \rb and Shaphat|וְשָׁפָ֖ט\rb*.
\b 
\li1 \v 23 \rb The sons|וּבֶן־\rb* \rb of Neariah|נְעַרְיָ֗ה\rb*:
\li2 \rb Elioenai|אֶלְיוֹעֵינַ֧י\rb*, \rb Hizkiah|וְחִזְקִיָּ֛ה\rb*, \rb and Azrikam|וְעַזְרִיקָ֖ם\rb*— \rb three in all|שְׁלֹשָֽׁה׃\rb*.
\b 
\li1 \v 24 \rb The sons|וּבְנֵ֣י\rb* \rb of Elioenai|אֶלְיוֹעֵינַ֗י\rb*:
\li2 \rb Hodaviah|הֹדַיְוָהוּ\rb*, \rb Eliashib|וְאֶלְיָשִׁ֡יב\rb*, \rb Pelaiah|וּפְלָיָ֡ה\rb*, \rb Akkub|וְ֠עַקּוּב\rb*, \rb Johanan|וְיוֹחָנָ֧ן\rb*, \rb Delaiah|וּדְלָיָ֛ה\rb*, \rb and Anani|וַעֲנָ֖נִי\rb*— \rb seven in all|שִׁבְעָֽה׃ס\rb*.
\c 4
\s1 The Descendants of Judah
\p \v 1 \rb The descendants|בְּנֵ֖י\rb* \rb of Judah|יְהוּדָ֑ה\rb*:
\b 
\li1 \rb Perez|פֶּ֧רֶץ\rb*, \rb Hezron|חֶצְר֛וֹן\rb*, \rb Carmi|וְכַרְמִ֖י\rb*, \rb Hur|וְח֥וּר\rb*, \rb and Shobal|וְשׁוֹבָֽל׃\rb*.
\b 
\li1 \v 2 \rb Reaiah|וּרְאָיָ֤ה\rb* \rb son|בֶן־\rb* \rb of Shobal|שׁוֹבָל֙\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Jahath|יַ֔חַת\rb*, \rb and Jahath|וְיַ֣חַת\rb* \rb was the father of|הֹלִ֔יד\rb*\rb |אֶת־\rb* \rb Ahumai|אֲחוּמַ֖י\rb*\rb |וְאֶת־\rb* \rb and Lahad|לָ֑הַד\rb*. \rb These|אֵ֖לֶּה\rb* \rb were the clans|מִשְׁפְּח֥וֹת\rb* \rb of the Zorathites|הַצָּֽרְעָתִֽי׃ס\rb*.
\b 
\li1 \v 3 \rb These|וְאֵ֙לֶּה֙\rb* \rb were the sons|אֲבִ֣י\rb*\f + \fr 4:3 \ft LXX (see also Vulgate); Hebrew \fqa These were of the father\f* \rb of Etam|עֵיטָ֔ם\rb*: \rb Jezreel|יִזְרְעֶ֥אל\rb*, \rb Ishma|וְיִשְׁמָ֖א\rb*, \rb and Idbash|וְיִדְבָּ֑שׁ\rb*. \rb And their sister|אֲחוֹתָ֖ם\rb* \rb was named|וְשֵׁ֥ם\rb* \rb Hazzelelponi|הַצְלֶלְפּֽוֹנִי׃\rb*. \v 4 \rb Penuel|וּפְנוּאֵל֙\rb* \rb was the father|אֲבִ֣י\rb*\f + \fr 4:4 \ft Or \fqa the founder\ft ; also in verses 5, 12, 14, 17, 18, and possibly elsewhere\f* \rb of Gedor|גְדֹ֔ר\rb*, \rb and Ezer|וְעֵ֖זֶר\rb* \rb was the father of|אֲבִ֣י\rb* \rb Hushah|חוּשָׁ֑ה\rb*.
\b 
\li1 \rb These|אֵ֤לֶּה\rb* \rb were the descendants|בְנֵי־\rb* \rb of Hur|חוּר֙\rb*, \rb the firstborn|בְּכ֣וֹר\rb* \rb of Ephrathah|אֶפְרָ֔תָה\rb* \rb and the father|אֲבִ֖י\rb*\rb |בֵּ֥ית\rb* \rb of Bethlehem|לָֽחֶם׃\rb*.
\b 
\li1 \v 5 \rb Ashhur|וּלְאַשְׁחוּר֙\rb* \rb the father of|אֲבִ֣י\rb* \rb Tekoa|תְק֔וֹעַ\rb* \rb had|הָי֖וּ\rb* \rb two|שְׁתֵּ֣י\rb* \rb wives|נָשִׁ֑ים\rb*, \rb Helah|חֶלְאָ֖ה\rb* \rb and Naarah|וְנַעֲרָֽה׃\rb*.
\li2 \v 6 \rb Naarah|נַעֲרָה֙\rb*\rb |אֶת־\rb* \rb bore|וַתֵּ֨לֶד\rb* \rb to him|ל֤וֹ\rb* \rb Ahuzzam|אֲחֻזָּ֣ם\rb*,\rb |וְאֶת־\rb* \rb Hepher|חֵ֔פֶר\rb*,\rb |וְאֶת־\rb* \rb Temeni|תֵּימְנִ֖י\rb*, \rb and|וְאֶת־\rb* \rb Haahashtari|הָאֲחַשְׁתָּרִ֑י\rb*. \rb These|אֵ֖לֶּה\rb* \rb were the descendants|בְּנֵ֥י\rb* \rb of Naarah|נַעֲרָֽה׃\rb*.
\li2 \v 7 \rb The sons|וּבְנֵ֖י\rb* \rb of Helah|חֶלְאָ֑ה\rb* \rb were Zereth|צֶ֥רֶת\rb*, \rb Zohar|יִצְחָר\rb*,\f + \fr 4:7 \ft Alternate MT reading; the other alternate (see also Vulgate) reads \fqa Izhar\ft .\f* \rb Ethnan|וְאֶתְנָֽן׃\rb*, \v 8 \rb and Koz|וְק֣וֹץ\rb*, \rb who was the father of|הוֹלִ֔יד\rb*\rb |אֶת־\rb* \rb Anub|עָנ֖וּב\rb* \rb and|וְאֶת־\rb* \rb Zobebah|הַצֹּבֵבָ֑ה\rb* \rb and of the clans|וּמִשְׁפְּח֥וֹת\rb* \rb of Aharhel|אֲחַרְחֵ֖ל\rb* \rb son|בֶּן־\rb* \rb of Harum|הָרֽוּם׃\rb*.
\s1 The Prayer of Jabez
\li1 \v 9 \rb Now Jabez|יַעְבֵּ֔ץ\rb* \rb was|וַיְהִ֣י\rb* \rb more honorable|נִכְבָּ֖ד\rb* \rb than his brothers|מֵאֶחָ֑יו\rb*. \rb His mother|וְאִמּ֗וֹ\rb* \rb had named him|קָרְאָ֨ה\rb*\rb |שְׁמ֤וֹ\rb* \rb Jabez|יַעְבֵּץ֙\rb*,\f + \fr 4:9 \fqa Jabez \ft sounds like the Hebrew for \fqa pain \ft or \fqa distress\ft .\f* \rb saying|לֵאמֹ֔ר\rb*, “\rb Because|כִּ֥י\rb* \rb I bore him|יָלַ֖דְתִּי\rb* \rb in pain|בְּעֹֽצֶב׃\rb*.”
\b 
\li1 \v 10 \rb And Jabez|יַ֠עְבֵּץ\rb* \rb called out|וַיִּקְרָ֣א\rb* \rb to the God|לֵאלֹהֵ֨י\rb* \rb of Israel|יִשְׂרָאֵ֜ל\rb*\rb |לֵאמֹ֗ר\rb*, “\rb If only|אִם־\rb* \rb You would bless me|בָּרֵ֨ךְ\rb*\rb |תְּבָרֲכֵ֜נִי\rb* \rb and enlarge|וְהִרְבִּ֤יתָ\rb*\rb |אֶת־\rb* \rb my territory|גְּבוּלִי֙\rb*! \rb May Your hand|יָדְךָ֙\rb* \rb be|וְהָיְתָ֤ה\rb* \rb with me|עִמִּ֔י\rb* \rb and keep me|וְעָשִׂ֥יתָ\rb* \rb from harm|מֵּרָעָ֖ה\rb*, \rb so that I will be free|לְבִלְתִּ֣י\rb* \rb from pain|עָצְבִּ֑י\rb*.”
\b 
\li1 \rb And God|אֱלֹהִ֖ים\rb*\rb |אֲשֶׁר־\rb* \rb granted|וַיָּבֵ֥א\rb* \rb the request|שָׁאָֽל׃\rb* \rb of Jabez|אֵ֥ת\rb*.
\s1 More Descendants of Judah
\li1 \v 11 \rb Chelub|וּכְל֥וּב\rb* \rb the brother|אֲחִֽי־\rb* \rb of Shuhah|שׁוּחָ֖ה\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Mehir|מְחִ֑יר\rb*, \rb who|ה֖וּא\rb* \rb was the father|אֲבִ֥י\rb* \rb of Eshton|אֶשְׁתּֽוֹן׃\rb*. \v 12 \rb Eshton|וְאֶשְׁתּ֗וֹן\rb* \rb was the father of|הוֹלִ֞יד\rb*\rb |אֶת־\rb*\rb |בֵּ֤ית\rb* \rb Beth-rapha|רָפָא֙\rb*,\rb |וְאֶת־\rb* \rb of Paseah|פָּסֵ֔חַ\rb*,\rb |וְאֶת־\rb* \rb and of Tehinnah|תְּחִנָּ֖ה\rb* \rb the father|אֲבִ֣י\rb*\rb |עִ֣יר\rb* \rb of Ir-nahash|נָחָ֑שׁ\rb*. \rb These|אֵ֖לֶּה\rb* \rb were the men|אַנְשֵׁ֥י\rb* \rb of Recah|רֵכָֽה׃ס\rb*.
\b 
\li1 \v 13 \rb The sons|וּבְנֵ֣י\rb* \rb of Kenaz|קְנַ֔ז\rb*:
\li2 \rb Othniel|עָתְנִיאֵ֖ל\rb* \rb and Seraiah|וּשְׂרָיָ֑ה\rb*.
\b 
\li1 \rb The sons|וּבְנֵ֥י\rb* \rb of Othniel|עָתְנִיאֵ֖ל\rb*:
\li2 \rb Hathath and Meonothai|חֲתַֽת׃\rb*.\f + \fr 4:13 \ft Vulgate and some LXX; Hebrew does not include \fqa and Meonothai\ft .\f*
\li1 \v 14 \rb Meonothai|וּמְעוֹנֹתַ֖י\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Ophrah|עָפְרָ֑ה\rb*, \rb and Seraiah|וּשְׂרָיָ֗ה\rb* \rb was the father of|הוֹלִ֤יד\rb*\rb |אֶת־\rb* \rb Joab|יוֹאָב֙\rb*, \rb the father|אֲבִי֙\rb* \rb of those living in|גֵּ֣יא\rb* \rb Ge-harashim|חֲרָשִׁ֔ים\rb*, \rb which was given this name because|כִּ֥י\rb* \rb its people were|הָיֽוּ׃פ\rb* \rb craftsmen|חֲרָשִׁ֖ים\rb*.\f + \fr 4:14 \ft Literally \fqa Ge-harashim, for they were craftsmen\ft . The Hebrew \fqa Ge-harashim \ft means \fqa valley of craftsmen\ft .\f*
\b 
\li1 \v 15 \rb The sons|וּבְנֵי֙\rb* \rb of Caleb|כָּלֵ֣ב\rb* \rb son|בֶּן־\rb* \rb of Jephunneh|יְפֻנֶּ֔ה\rb*:
\li2 \rb Iru|עִ֥ירוּ\rb*, \rb Elah|אֵלָ֖ה\rb*, \rb and Naam|וָנָ֑עַם\rb*.
\b 
\li1 \rb The son|וּבְנֵ֥י\rb*\f + \fr 4:15 \ft Hebrew \fqa sons \ft \f* \rb of Elah|אֵלָ֖ה\rb*:
\li2 \rb Kenaz|וּקְנַֽז׃\rb*.
\b 
\li1 \v 16 \rb The sons|וּבְנֵ֖י\rb* \rb of Jehallelel|יְהַלֶּלְאֵ֑ל\rb*:
\li2 \rb Ziph|זִ֣יף\rb*, \rb Ziphah|וְזִיפָ֔ה\rb*, \rb Tiria|תִּירְיָ֖א\rb*, \rb and Asarel|וַאֲשַׂרְאֵֽל׃\rb*.
\b 
\li1 \v 17 \rb The sons|וּבֶן־\rb* \rb of Ezrah|עֶזְרָ֔ה\rb*:
\li2 \rb Jether|יֶ֥תֶר\rb*, \rb Mered|וּמֶ֖רֶד\rb*, \rb Epher|וְעֵ֣פֶר\rb*, \rb and Jalon|וְיָל֑וֹן\rb*.
\li2 \rb And Mered’s wife Bithiah gave birth|וַתַּ֙הַר֙\rb*\f + \fr 4:17 \ft Literally \fqa she gave birth\f*\rb |אֶת־\rb* \rb to Miriam|מִרְיָ֣ם\rb*,\rb |וְאֶת־\rb* \rb Shammai|שַׁמַּ֔י\rb*,\rb |וְאֶת־\rb* \rb and Ishbah|יִשְׁבָּ֖ח\rb* \rb the father|אֲבִ֥י\rb* \rb of Eshtemoa|אֶשְׁתְּמֹֽעַ׃\rb*. \v 18 \rb These|וְאֵ֗לֶּה\rb* \rb were the children|בְּנֵי֙\rb* \rb of Pharaoh’s|פַּרְעֹ֔ה\rb* \rb daughter|בַת־\rb* \rb Bithiah|בִּתְיָ֣ה\rb*.\f + \fr 4:18 \ft This statement is at the end of verse 18 in the Hebrew.\f*
\li2 \rb Mered also|מָֽרֶד׃ס\rb* \rb took|לָקַ֖ח\rb*\rb |אֲשֶׁ֥ר\rb* \rb a Judean|הַיְהֻדִיָּ֗ה\rb*\f + \fr 4:18 \ft Or \fqa Judahite\f* \rb wife|וְאִשְׁתּ֣וֹ\rb*, \rb who gave birth to|יָלְדָ֞ה\rb*\rb |אֶת־\rb* \rb Jered|יֶ֨רֶד\rb* \rb the father|אֲבִ֤י\rb* \rb of Gedor|גְדוֹר֙\rb*,\rb |וְאֶת־\rb* \rb Heber|חֶ֙בֶר֙\rb* \rb the father|אֲבִ֣י\rb* \rb of Soco|שׂוֹכ֔וֹ\rb*,\rb |וְאֶת־\rb* \rb and Jekuthiel|יְקֽוּתִיאֵ֖ל\rb* \rb the father|אֲבִ֣י\rb* \rb of Zanoah|זָנ֑וֹחַ\rb*.
\b 
\li1 \v 19 \rb The sons|וּבְנֵי֙\rb* \rb of Hodiah’s|הֽוֹדִיָּ֔ה\rb* \rb wife|אֵ֣שֶׁת\rb*, \rb the sister|אֲח֣וֹת\rb* \rb of Naham|נַ֔חַם\rb*, \rb were the fathers|אֲבִ֥י\rb* \rb of Keilah|קְעִילָ֖ה\rb* \rb the Garmite|הַגַּרְמִ֑י\rb* \rb and of Eshtemoa|וְאֶשְׁתְּמֹ֖עַ\rb* \rb the Maacathite|הַמַּעֲכָתִֽי׃\rb*.\f + \fr 4:19 \ft Or \fqa were the father of Keilah the Garmite, and Eshtemoa the Maacathite\f*
\b 
\li1 \v 20 \rb The sons|וּבְנֵ֣י\rb* \rb of Shimon|שִׁימ֔וֹן\rb*:
\li2 \rb Amnon|אַמְנ֣וֹן\rb*, \rb Rinnah|וְרִנָּ֔ה\rb*,\rb |בֶּן־\rb* \rb Ben-hanan|חָנָ֖ן\rb*, \rb and Tilon|וְתוֹלוֹן\rb*.
\b 
\li1 \rb The descendants|וּבְנֵ֣י\rb* \rb of Ishi|יִשְׁעִ֔י\rb*:
\li2 \rb Zoheth|זוֹחֵ֖ת\rb*\rb |וּבֶן־\rb* \rb and Ben-zoheth|זוֹחֵֽת׃\rb*.
\b 
\li1 \v 21 \rb The sons|בְּנֵי֙\rb* \rb of Shelah|שֵׁלָ֣ה\rb* \rb son|בֶן־\rb* \rb of Judah|יְהוּדָ֔ה\rb*:
\li2 \rb Er|עֵ֚ר\rb* \rb the father|אֲבִ֣י\rb* \rb of Lecah|לֵכָ֔ה\rb*, \rb Laadah|וְלַעְדָּ֖ה\rb* \rb the father|אֲבִ֣י\rb* \rb of Mareshah|מָרֵשָׁ֑ה\rb* \rb and the clans|וּמִשְׁפְּח֛וֹת\rb* \rb of the linen|הַבֻּ֖ץ\rb*\rb |לְבֵ֥ית\rb* \rb workers|עֲבֹדַ֥ת\rb* \rb at Beth-ashbea|בֵּית־\rb*\rb |אַשְׁבֵּֽעַ׃\rb*, \v 22 \rb Jokim|וְיוֹקִ֞ים\rb*, \rb the men|וְאַנְשֵׁ֣י\rb* \rb of Cozeba|כֹזֵבָ֗א\rb*, \rb and Joash|וְיוֹאָ֧שׁ\rb* \rb and Saraph|וְשָׂרָ֛ף\rb*, \rb who|אֲשֶׁר־\rb* \rb ruled|בָּעֲל֥וּ\rb* \rb in Moab|לְמוֹאָ֖ב\rb*\rb |וְיָשֻׁ֣בִי\rb* \rb and Jashubi-lehem|לָ֑חֶם\rb*. (\rb These names are from ancient|עַתִּיקִֽים׃\rb* \rb records|וְהַדְּבָרִ֖ים\rb*.) \v 23 \rb These were|הֵ֚מָּה\rb* \rb the potters|הַיּ֣וֹצְרִ֔ים\rb* \rb who lived|וְיֹשְׁבֵ֥י\rb* \rb at Netaim|נְטָעִ֖ים\rb* \rb and Gederah|וּגְדֵרָ֑ה\rb*.\rb |עִם־\rb* \rb They lived|יָ֥שְׁבוּ\rb* \rb there|שָֽׁם׃ס\rb* \rb in the service|בִּמְלַאכְתּ֖וֹ\rb* \rb of the king|הַמֶּ֥לֶךְ\rb*.
\s1 The Descendants of Simeon
\p \v 24 \rb The descendants|בְּנֵ֖י\rb* \rb of Simeon|שִׁמְע֑וֹן\rb*:
\b 
\li1 \rb Nemuel|נְמוּאֵ֣ל\rb*, \rb Jamin|וְיָמִ֔ין\rb*, \rb Jarib|יָרִ֖יב\rb*, \rb Zerah|זֶ֥רַח\rb*,\f + \fr 4:24 \fqa Zerah \ft is a variant of \fqa Zohar\ft ; see \ref Genesis 46:10|GEN 46:10\ref* and Exodus 6:15.\f* \rb and Shaul|שָׁאֽוּל׃\rb*.
\b 
\li1 \v 25 \rb The sons of Shaul|בְּנ֛וֹ\rb*:
\li2 \rb Shallum|שַׁלֻּ֥ם\rb*, \rb Mibsam|מִבְשָׂ֥ם\rb*,\rb |בְּנ֖וֹ\rb* \rb and Mishma|מִשְׁמָ֥ע\rb*\rb |בְּנֽוֹ׃\rb*.
\b 
\li1 \v 26 \rb The sons|וּבְנֵ֖י\rb* \rb of Mishma|מִשְׁמָ֑ע\rb*:
\li2 \rb Hammuel|חַמּוּאֵ֥ל\rb*,\rb |בְּנ֛וֹ\rb* \rb Zaccur|זַכּ֥וּר\rb*,\rb |בְּנ֖וֹ\rb* \rb and Shimei|שִׁמְעִ֥י\rb*\rb |בְנֽוֹ׃\rb*.
\b 
\li1 \v 27 \rb Shimei|וּלְשִׁמְעִ֞י\rb* \rb had sixteen|שִׁשָּׁ֤ה\rb*\rb |עָשָׂר֙\rb* \rb sons|בָּנִ֨ים\rb* \rb and six|שֵׁ֔שׁ\rb* \rb daughters|וּבָנ֣וֹת\rb*, \rb but his brothers|וּלְאֶחָ֕יו\rb* \rb did not|אֵ֖ין\rb* \rb have many|רַבִּ֑ים\rb* \rb children|בָּנִ֣ים\rb*, \rb so their whole|וְכֹל֙\rb* \rb clan|מִשְׁפַּחְתָּ֔ם\rb* \rb did not|לֹ֥א\rb* \rb become as numerous|הִרְבּ֖וּ\rb* \rb as|עַד־\rb* \rb the sons|בְּנֵ֥י\rb* \rb of Judah|יְהוּדָֽה׃ס\rb*. \v 28 \rb They lived|וַיֵּֽשְׁב֛וּ\rb*\rb |בִּבְאֵֽר־\rb* \rb in Beersheba|שֶׁ֥בַע\rb*, \rb Moladah|וּמוֹלָדָ֖ה\rb*,\rb |וַחֲצַ֥ר\rb* \rb Hazar-shual|שׁוּעָֽל׃\rb*, \v 29 \rb Bilhah|וּבְבִלְהָ֥ה\rb*, \rb Ezem|וּבְעֶ֖צֶם\rb*, \rb Tolad|וּבְתוֹלָֽד׃\rb*, \v 30 \rb Bethuel|וּבִבְתוּאֵ֥ל\rb*, \rb Hormah|וּבְחָרְמָ֖ה\rb*, \rb Ziklag|וּבְצִֽיקְלָֽג׃\rb*, \v 31 \rb |וּבְבֵ֤ית\rb* \rb Beth-marcaboth|מַרְכָּבוֹת֙\rb*,\rb |וּבַחֲצַ֣ר\rb* \rb Hazar-susim|סוּסִ֔ים\rb*,\rb |וּבְבֵ֥ית\rb* \rb Beth-biri|בִּרְאִ֖י\rb*, \rb and Shaaraim|וּֽבְשַׁעֲרָ֑יִם\rb*. \rb These|אֵ֥לֶּה\rb* \rb were their cities|עָרֵיהֶ֖ם\rb* \rb until|עַד־\rb* \rb the reign|מְלֹ֥ךְ\rb* \rb of David|דָּוִֽיד׃\rb*. \v 32 \rb And their villages|וְחַצְרֵיהֶם֙\rb* \rb were Etam|עֵיטָ֣ם\rb*, \rb Ain|וָעַ֔יִן\rb*, \rb Rimmon|רִמּ֥וֹן\rb*, \rb Tochen|וְתֹ֖כֶן\rb*, \rb and Ashan|וְעָשָׁ֑ן\rb*— \rb five|חָמֵֽשׁ׃\rb* \rb towns|עָרִ֖ים\rb*— \v 33 \rb and all|וְכָל־\rb* \rb their surrounding|סְבִיב֛וֹת\rb*\rb |הֶעָרִ֥ים\rb*\rb |הָאֵ֖לֶּה\rb* \rb villages|חַצְרֵיהֶ֗ם\rb*\rb |אֲשֶׁ֧ר\rb* \rb as|עַד־\rb* \rb far as Baal|בָּ֑עַל\rb*.\f + \fr 4:33 \ft Hebrew; some LXX manuscripts (see also \ref Joshua 19:8|JOS 19:8\ref*) \fqa Baalath\f* \rb These|זֹ֚את\rb* \rb were their settlements|מוֹשְׁבֹתָ֔ם\rb*, \rb and they kept a genealogical record|וְהִתְיַחְשָׂ֖ם\rb*\rb |לָהֶֽם׃\rb*:
\li2 \v 34 \rb Meshobab|וּמְשׁוֹבָ֣ב\rb*, \rb Jamlech|וְיַמְלֵ֔ךְ\rb*, \rb Joshah|וְיוֹשָׁ֖ה\rb* \rb son|בֶּן־\rb* \rb of Amaziah|אֲמַצְיָֽה׃\rb*, \v 35 \rb Joel|וְיוֹאֵ֑ל\rb*, \rb Jehu|וְיֵהוּא֙\rb* \rb son|בֶּן־\rb* \rb of Joshibiah|י֣וֹשִׁבְיָ֔ה\rb* (\rb son|בֶּן־\rb* \rb of Seraiah|שְׂרָיָ֖ה\rb*, \rb son|בֶּן־\rb* \rb of Asiel|עֲשִׂיאֵֽל׃\rb*), \v 36 \rb Elioenai|וְאֶלְיוֹעֵינַ֡י\rb*, \rb Jaakobah|וְֽיַעֲקֹ֡בָה\rb*, \rb Jeshohaiah|וִ֠ישׁוֹחָיָה\rb*, \rb Asaiah|וַעֲשָׂיָ֧ה\rb*, \rb Adiel|וַעֲדִיאֵ֛ל\rb*, \rb Jesimiel|וִישִׂימִאֵ֖ל\rb*, \rb Benaiah|וּבְנָיָֽה׃\rb*, \v 37 \rb and Ziza|וְזִיזָ֨א\rb* \rb son|בֶן־\rb* \rb of Shiphi|שִׁפְעִ֧י\rb* (\rb son|בֶן־\rb* \rb of Allon|אַלּ֛וֹן\rb*, \rb son|בֶּן־\rb* \rb of Jedaiah|יְדָיָ֥ה\rb*, \rb son|בֶן־\rb* \rb of Shimri|שִׁמְרִ֖י\rb*, \rb son|בֶּן־\rb* \rb of Shemaiah|שְׁמַֽעְיָֽה׃\rb*).
\b 
\li1 \v 38 \rb These men|אֵ֚לֶּה\rb* \rb listed|הַבָּאִ֣ים\rb* \rb by name|בְּשֵׁמ֔וֹת\rb* \rb were the leaders|נְשִׂיאִ֖ים\rb* \rb of their clans|בְּמִשְׁפְּחוֹתָ֑ם\rb*. \rb Their families|אֲב֣וֹתֵיהֶ֔ם\rb*\rb |וּבֵית֙\rb* \rb increased|פָּרְצ֖וּ\rb* \rb greatly|לָרֽוֹב׃\rb*, \v 39 \rb and they journeyed|וַיֵּלְכוּ֙\rb* \rb to the entrance|לִמְב֣וֹא\rb* \rb of Gedor|גְדֹ֔ר\rb*,\rb |עַ֖ד\rb* \rb to the east side|לְמִזְרַ֣ח\rb* \rb of the valley|הַגָּ֑יְא\rb*, \rb in search of|לְבַקֵּ֥שׁ\rb* \rb pasture|מִרְעֶ֖ה\rb* \rb for their flocks|לְצֹאנָֽם׃\rb*. \v 40 \rb There they found|וַֽיִּמְצְא֤וּ\rb* \rb rich|שָׁמֵ֣ן\rb*, \rb good|וָט֔וֹב\rb* \rb pasture|מִרְעֶה֙\rb*, \rb and the land|וְהָאָ֙רֶץ֙\rb* \rb was spacious|רַחֲבַ֣ת\rb*\rb |יָדַ֔יִם\rb*, \rb peaceful|וְשֹׁקֶ֖טֶת\rb*, \rb and quiet|וּשְׁלֵוָ֑ה\rb*; \rb for|כִּ֣י\rb* \rb some|מִן־\rb* \rb Hamites|חָ֔ם\rb* \rb had lived|הַיֹּשְׁבִ֥ים\rb* \rb there|שָׁ֖ם\rb* \rb formerly|לְפָנִֽים׃\rb*.
\b 
\li1 \v 41 \rb These|אֵלֶּה֩\rb* \rb who were noted|הַכְּתוּבִ֨ים\rb* \rb by name|בְּשֵׁמ֜וֹת\rb* \rb came|וַיָּבֹ֡אוּ\rb* \rb in the days|בִּימֵ֣י׀\rb* \rb of Hezekiah|יְחִזְקִיָּ֣הוּ\rb* \rb king of|מֶֽלֶךְ־\rb* \rb Judah|יְהוּדָ֗ה\rb*. \rb They attacked the Hamites|וַיַּכּ֨וּ\rb*\rb |אֶת־\rb* \rb in their dwellings|אָהֳלֵיהֶ֜ם\rb* \rb as well as|וְאֶת־\rb* \rb the Meunites|הַמְּעִינִים\rb* \rb who|אֲשֶׁ֤ר\rb* \rb were|נִמְצְאוּ־\rb* \rb there|שָׁ֙מָּה֙\rb*, \rb devoting them to destruction|וַיַּחֲרִימֻם֙\rb*\f + \fr 4:41 \ft Forms of the Hebrew \fqa cherem \ft refer to the giving over of things or persons to the LORD, either by destroying them or by giving them as an offering.\f* \rb even to|עַד־\rb* \rb this|הַזֶּ֔ה\rb* \rb day|הַיּ֣וֹם\rb*. \rb Then they settled|וַיֵּשְׁב֖וּ\rb* \rb in their place|תַּחְתֵּיהֶ֑ם\rb*, \rb because|כִּֽי־\rb* \rb there was pasture|מִרְעֶ֥ה\rb*\rb |שָֽׁם׃\rb* \rb for their flocks|לְצֹאנָ֖ם\rb*. \v 42 \rb And|וּמֵהֶ֣ם׀\rb* \rb five|חֲמֵ֣שׁ\rb* \rb hundred|מֵא֑וֹת\rb*\rb |אֲנָשִׁ֖ים\rb*\rb |מִן־\rb*\rb |בְּנֵ֣י\rb* \rb of these Simeonites|שִׁמְע֗וֹן\rb* \rb led by|בְּרֹאשָֽׁם׃\rb* \rb Pelatiah|וּפְלַטְיָ֡ה\rb*, \rb Neariah|וּ֠נְעַרְיָה\rb*, \rb Rephaiah|וּרְפָיָ֧ה\rb*, \rb and Uzziel|וְעֻזִּיאֵ֛ל\rb*, \rb the sons|בְּנֵ֥י\rb* \rb of Ishi|יִשְׁעִ֖י\rb*, \rb went|הָלְכוּ֙\rb* \rb to Mount|לְהַ֣ר\rb* \rb Seir|שֵׂעִ֔יר\rb* \v 43 \rb and struck down|וַיַּכּ֕וּ\rb*\rb |אֶת־\rb* \rb the remnant|שְׁאֵרִ֥ית\rb* \rb of the Amalekites|לַעֲמָלֵ֑ק\rb* \rb who had escaped|הַפְּלֵטָ֖ה\rb*. \rb And they have lived|וַיֵּ֣שְׁבוּ\rb* \rb there|שָׁ֔ם\rb* \rb to|עַ֖ד\rb* \rb this|הַזֶּֽה׃\rb* \rb day|הַיּ֥וֹם\rb*.
\c 5
\s1 The Descendants of Reuben
\p \v 1 \rb These were the sons|וּבְנֵ֨י\rb* \rb of Reuben|רְאוּבֵ֥ן\rb* \rb the firstborn|בְּכֽוֹר־\rb* \rb of Israel|יִשְׂרָאֵל֮\rb*.\rb |כִּ֣י\rb* \rb Though he|ה֣וּא\rb* \rb was the firstborn|הַבְּכוֹר֒\rb*, \rb his birthright|בְּכֹ֣רָת֔וֹ\rb* \rb was given|נִתְּנָה֙\rb* \rb to the sons|לִבְנֵ֥י\rb* \rb of Joseph|יוֹסֵ֖ף\rb* \rb son|בֶּן־\rb* \rb of Israel|יִשְׂרָאֵ֑ל\rb*, \rb because Reuben defiled|וּֽבְחַלְּלוֹ֙\rb* \rb his father’s|אָבִ֔יו\rb* \rb bed|יְצוּעֵ֣י\rb*. \rb So he is not|וְלֹ֥א\rb* \rb reckoned|לְהִתְיַחֵ֖שׂ\rb* \rb according to birthright|לַבְּכֹרָֽה׃\rb*. \v 2 \rb And though|כִּ֤י\rb* \rb Judah|יְהוּדָה֙\rb* \rb prevailed|גָּבַ֣ר\rb* \rb over his brothers|בְּאֶחָ֔יו\rb* \rb and a ruler|וּלְנָגִ֖יד\rb* \rb came from him|מִמֶּ֑נּוּ\rb*, \rb the birthright|וְהַבְּכֹרָ֖ה\rb* \rb belonged to Joseph|לְיוֹסֵֽף׃ס\rb*. \v 3 \rb The sons|בְּנֵ֥י\rb* \rb of Reuben|רְאוּבֵ֖ן\rb*, \rb the firstborn|בְּכ֣וֹר\rb* \rb of Israel|יִשְׂרָאֵ֑ל\rb*:
\b 
\q1 \rb Hanoch|חֲנ֥וֹךְ\rb*, \rb Pallu|וּפַלּ֖וּא\rb*, \rb Hezron|חֶצְר֥וֹן\rb*, \rb and Carmi|וְכַרְמִֽי׃\rb*.
\b 
\li1 \v 4 \rb The descendants|בְּנֵ֖י\rb* \rb of Joel|יוֹאֵ֑ל\rb*:
\li2 \rb Shemaiah|שְׁמַֽעְיָ֥ה\rb* \rb his son|בְנ֛וֹ\rb*, \rb Gog|גּ֥וֹג\rb* \rb his son|בְּנ֖וֹ\rb*, \rb Shimei|שִׁמְעִ֥י\rb* \rb his son|בְנֽוֹ׃\rb*, \v 5 \rb Micah|מִיכָ֥ה\rb* \rb his son|בְנ֛וֹ\rb*, \rb Reaiah|רְאָיָ֥ה\rb* \rb his son|בְנ֖וֹ\rb*, \rb Baal|בַּ֥עַל\rb* \rb his son|בְּנֽוֹ׃\rb*, \v 6 \rb and Beerah|בְּאֵרָ֣ה\rb* \rb his son|בְנ֔וֹ\rb*, \rb whom|אֲשֶׁ֣ר\rb*\rb |תִּלְּגַ֥ת\rb* \rb Tiglath-pileser|פִּלְנְאֶ֖סֶר\rb*\f + \fr 5:6 \ft Hebrew \fqa Tilgath-pilneser\ft , a variant spelling of \fqa Tiglath-pileser\ft ; also in verse 26\f* \rb king|מֶ֣לֶךְ\rb* \rb of Assyria|אַשֻּׁ֑ר\rb* \rb carried into exile|הֶגְלָ֔ה\rb*.
\b 
\li1 \rb Beerah|ה֥וּא\rb* \rb was a leader|נָשִׂ֖יא\rb* \rb of the Reubenites|לָרֽאוּבֵנִֽי׃\rb*. \v 7 \rb His relatives|וְאֶחָיו֙\rb* \rb by their clans|לְמִשְׁפְּחֹתָ֔יו\rb* \rb are recorded|בְּהִתְיַחֵ֖שׂ\rb* \rb in their genealogy|לְתֹלְדוֹתָ֑ם\rb*:
\li2 \rb Jeiel|יְעִיאֵ֖ל\rb* \rb the chief|הָרֹ֥אשׁ\rb*, \rb Zechariah|וּזְכַרְיָֽהוּ׃\rb*, \v 8 \rb and Bela|וּבֶ֙לַע֙\rb* \rb son|בֶּן־\rb* \rb of Azaz|עָזָ֔ז\rb*, \rb the son|בֶּן־\rb* \rb of Shema|שֶׁ֖מַע\rb*, \rb the son|בֶּן־\rb* \rb of Joel|יוֹאֵ֑ל\rb*. \rb They|ה֚וּא\rb* \rb settled|יוֹשֵׁ֣ב\rb* \rb in Aroer|בַּעֲרֹעֵ֔ר\rb* \rb and as far as|וְעַד־\rb* \rb Nebo|נְב֖וֹ\rb*\rb |וּבַ֥עַל\rb* \rb and Baal-meon|מְעֽוֹן׃\rb*. \v 9 \rb They also settled|יָשַׁב֙\rb* \rb in the east|וְלַמִּזְרָ֗ח\rb* \rb as far as|עַד־\rb*\rb |לְב֣וֹא\rb* \rb the edge of the desert|מִדְבָּ֔רָה\rb* \rb that extends|לְמִן־\rb* \rb to the Euphrates|פְּרָ֑ת\rb* \rb River|הַנָּהָ֖ר\rb*, \rb because|כִּ֧י\rb* \rb their livestock|מִקְנֵיהֶ֛ם\rb* \rb had increased|רָב֖וּ\rb* \rb in the land|בְּאֶ֥רֶץ\rb* \rb of Gilead|גִּלְעָֽד׃\rb*.
\li2 \v 10 \rb During the days|וּבִימֵ֣י\rb* \rb of Saul|שָׁא֗וּל\rb* \rb they waged|עָשׂ֤וּ\rb* \rb war|מִלְחָמָה֙\rb* \rb against|עִם־\rb* \rb the Hagrites|הַֽהַגְרִאִ֔ים\rb*, \rb who were defeated|וַֽיִּפְּל֖וּ\rb* \rb at their hands|בְּיָדָ֑ם\rb*, \rb and they occupied|וַיֵּשְׁבוּ֙\rb* \rb the dwellings of the Hagrites|בְּאָ֣הֳלֵיהֶ֔ם\rb* \rb throughout|עַֽל־\rb*\rb |כָּל־\rb* \rb the region|פְּנֵ֖י\rb* \rb east|מִזְרָ֥ח\rb* \rb of Gilead|לַגִּלְעָֽד׃פ\rb*.
\s1 The Descendants of Gad
\p \v 11 \rb The descendants|וּבְנֵי־\rb* \rb of Gad|גָ֣ד\rb* \rb lived|יָֽשְׁב֛וּ\rb* \rb next to the Reubenites|לְנֶגְדָּ֗ם\rb* \rb in the land|בְּאֶ֥רֶץ\rb* \rb of Bashan|הַבָּשָׁ֖ן\rb*, \rb as|עַד־\rb* \rb far as Salecah|סַלְכָֽה׃\rb*:
\b 
\li1 \v 12 \rb Joel was|יוֹאֵ֣ל\rb* \rb the chief|הָרֹ֔אשׁ\rb*, \rb Shapham|וְשָׁפָ֖ם\rb* \rb the second|הַמִּשְׁנֶ֑ה\rb*, \rb then Jaanai|וְיַעְנַ֥י\rb* \rb and Shaphat|וְשָׁפָ֖ט\rb*, \rb who lived in Bashan|בַּבָּשָֽׁן׃\rb*.
\b 
\li1 \v 13 \rb Their kinsmen|וַאֲחֵיהֶ֞ם\rb* \rb by families were|אֲבוֹתֵיהֶ֗ם\rb*\rb |לְבֵ֣ית\rb* \rb Michael|מִֽיכָאֵ֡ל\rb*, \rb Meshullam|וּמְשֻׁלָּ֡ם\rb*, \rb Sheba|וְ֠שֶׁבַע\rb*, \rb Jorai|וְיוֹרַ֧י\rb*, \rb Jacan|וְיַעְכָּ֛ן\rb*, \rb Zia|וְזִ֥יעַ\rb*, \rb and Eber|וָעֵ֖בֶר\rb*— \rb seven in all|שִׁבְעָֽה׃ס\rb*. \v 14 \rb These|אֵ֣לֶּה׀\rb* \rb were the sons|בְּנֵ֣י\rb* \rb of Abihail|אֲבִיחַ֗יִל\rb* \rb son|בֶּן־\rb* \rb of Huri|חוּרִ֡י\rb*, \rb the son|בֶּן־\rb* \rb of Jaroah|יָ֠רוֹחַ\rb*, \rb the son|בֶּן־\rb* \rb of Gilead|גִּלְעָ֧ד\rb*, \rb the son|בֶּן־\rb* \rb of Michael|מִיכָאֵ֛ל\rb*, \rb the son|בֶּן־\rb* \rb of Jeshishai|יְשִׁישַׁ֥י\rb*, \rb the son|בֶּן־\rb* \rb of Jahdo|יַחְדּ֖וֹ\rb*, \rb the son|בֶּן־\rb* \rb of Buz|בּֽוּז׃\rb*. \v 15 \rb Ahi|אֲחִי֙\rb* \rb son|בֶּן־\rb* \rb of Abdiel|עַבְדִּיאֵ֣ל\rb*, \rb the son|בֶּן־\rb* \rb of Guni|גּוּנִ֔י\rb*, \rb was head|רֹ֖אשׁ\rb* \rb of their family|אֲבוֹתָֽם׃\rb*\rb |לְבֵ֥ית\rb*.
\b 
\li1 \v 16 \rb They lived|וַיֵּֽשְׁב֛וּ\rb* \rb in Gilead|בַּגִּלְעָ֥ד\rb*, \rb in Bashan|בַּבָּשָׁ֖ן\rb* \rb and its towns|וּבִבְנֹתֶ֑יהָ\rb*, \rb and throughout|וּבְכָֽל־\rb* \rb the pasturelands|מִגְרְשֵׁ֥י\rb* \rb of Sharon|שָׁר֖וֹן\rb*.\rb |עַל־\rb*\rb |תּוֹצְאוֹתָֽם׃\rb* \v 17 \rb All of them|כֻּלָּם֙\rb* \rb were recorded in the genealogies|הִתְיַחְשׂ֔וּ\rb* \rb during the reigns|בִּימֵ֖י\rb* \rb of Jotham|יוֹתָ֣ם\rb* \rb king|מֶֽלֶךְ־\rb* \rb of Judah|יְהוּדָ֑ה\rb* \rb and|וּבִימֵ֖י\rb* \rb Jeroboam|יָרָבְעָ֥ם\rb* \rb king|מֶֽלֶךְ־\rb* \rb of Israel|יִשְׂרָאֵֽל׃פ\rb*.
\b 
\li1 \v 18 \rb The Reubenites|בְּנֵֽי־\rb*\rb |רְאוּבֵ֨ן\rb*, \rb the Gadites|וְגָדִ֜י\rb*, \rb and the half-tribe|וַחֲצִ֥י\rb*\rb |שֵֽׁבֶט־\rb* \rb of Manasseh|מְנַשֶּׁה֮\rb*\rb |מִן־\rb* \rb had 44,760|אַרְבָּעִ֨ים\rb*\rb |וְאַרְבָּעָ֥ה\rb*\rb |אֶ֛לֶף\rb*\rb |וּשְׁבַע־\rb*\rb |מֵא֥וֹת\rb*\rb |וְשִׁשִּׁ֖ים\rb* \rb warriors|יֹצְאֵ֥י\rb*\rb |צָבָֽא׃\rb*—\rb |בְּנֵי־\rb* \rb valiant|חַיִל֒\rb* \rb men|אֲ֠נָשִׁים\rb* \rb who carried|נֹשְׂאֵ֨י\rb* \rb the shield|מָגֵ֤ן\rb* \rb and sword|וְחֶ֙רֶב֙\rb*, \rb drew|וְדֹ֣רְכֵי\rb* \rb the bow|קֶ֔שֶׁת\rb*, \rb and were trained|וּלְמוּדֵ֖י\rb* \rb for battle|מִלְחָמָ֑ה\rb*. \v 19 \rb They waged|וַיַּעֲשׂ֥וּ\rb* \rb war|מִלְחָמָ֖ה\rb* \rb against|עִם־\rb* \rb the Hagrites|הַֽהַגְרִיאִ֑ים\rb*, \rb as well as Jetur|וִיט֥וּר\rb*, \rb Naphish|וְנָפִ֖ישׁ\rb*, \rb and Nodab|וְנוֹדָֽב׃\rb*.
\b 
\li1 \v 20 \rb And because|כִּ֠י\rb* \rb they cried out|זָעֲקוּ֙\rb* \rb to God|לֵאלֹהִ֤ים\rb* \rb in battle|בַּמִּלְחָמָ֔ה\rb*, \rb they were helped|וַיֵּעָזְר֣וּ\rb* \rb against their enemies|עֲלֵיהֶ֔ם\rb*, \rb and the Hagrites|הַֽהַגְרִיאִ֔ים\rb* \rb and all|וְכֹ֖ל\rb* \rb their allies|שֶׁ֣עִמָּהֶ֑ם\rb* \rb were delivered|וַיִּנָּתְנ֤וּ\rb* \rb into their hands|בְיָדָם֙\rb*. \rb Because|כִּי־\rb* \rb they put their trust|בָ֥טְחוּ\rb* \rb in God|בֽוֹ׃\rb*, \rb He answered their prayers|וְנַעְתּ֥וֹר\rb*. \v 21 \rb They seized|וַיִּשְׁבּ֣וּ\rb* \rb the livestock of the Hagrites|מִקְנֵיהֶ֗ם\rb*— \rb 50,000|חֲמִשִּׁ֥ים\rb*\rb |אֶ֙לֶף֙\rb* \rb camels|גְּֽמַלֵּיהֶ֞ם\rb*, \rb 250,000|מָאתַ֤יִם\rb*\rb |וַחֲמִשִּׁים֙\rb*\rb |אֶ֔לֶף\rb* \rb sheep|וְצֹ֗אן\rb*, \rb and 2,000|אַלְפָּ֑יִם\rb*\rb |וְנֶ֥פֶשׁ\rb* \rb donkeys|וַחֲמוֹרִ֖ים\rb*. \rb They also took 100,000|מֵ֥אָה\rb*\rb |אָֽלֶף׃\rb* \rb captives|אָדָ֖ם\rb*, \v 22 \rb and|כִּֽי־\rb* \rb many others|רַבִּים֙\rb* \rb fell|נָפָ֔לוּ\rb* \rb slain|חֲלָלִ֤ים\rb*, \rb because|כִּ֥י\rb* \rb the battle|הַמִּלְחָמָ֑ה\rb* \rb belonged to God|מֵהָאֱלֹהִ֖ים\rb*. \rb And they occupied|וַיֵּשְׁב֥וּ\rb* \rb the land|תַחְתֵּיהֶ֖ם\rb* \rb until|עַד־\rb* \rb the exile|הַגֹּלָֽה׃פ\rb*.
\s1 The Half-Tribe of Manasseh
\p \v 23 \rb Now the people|וּבְנֵ֗י\rb* \rb of the half-tribe|חֲצִי֙\rb*\rb |שֵׁ֣בֶט\rb* \rb of Manasseh|מְנַשֶּׁ֔ה\rb*\rb |הֵ֥מָּה\rb* \rb were numerous|רָבֽוּ׃\rb*. \rb They settled|יָשְׁב֖וּ\rb* \rb in the land|בָּאָ֑רֶץ\rb* \rb from Bashan|מִבָּשָׁ֞ן\rb* \rb to|עַד־\rb*\rb |בַּ֧עַל\rb* \rb Baal-hermon (that is|חֶרְמ֛וֹן\rb*, \rb Senir|וּשְׂנִ֥יר\rb*, \rb also known as Mount|וְהַר־\rb* \rb Hermon|חֶרְמ֖וֹן\rb*).\f + \fr 5:23 \ft Literally \fqa from Bashan to Baal-hermon and Senir and Mount Hermon.\f* \v 24 \rb These|וְאֵ֖לֶּה\rb* \rb were the heads|רָאשֵׁ֣י\rb* \rb of their families|אֲבוֹתָ֑ם\rb*\rb |בֵית־\rb*:
\b 
\li1 \rb Epher|וְעֵ֡פֶר\rb*, \rb Ishi|וְיִשְׁעִ֡י\rb*, \rb Eliel|וֶאֱלִיאֵ֡ל\rb*, \rb Azriel|וְ֠עַזְרִיאֵל\rb*, \rb Jeremiah|וְיִרְמְיָ֨ה\rb*, \rb Hodaviah|וְהוֹדַוְיָ֜ה\rb*, \rb and Jahdiel|וְיַחְדִּיאֵ֗ל\rb*.
\b 
\li1 \rb They were mighty|גִּבּ֣וֹרֵי\rb* \rb men|אַנְשֵׁ֣י\rb* \rb of valor|חַ֔יִל\rb*, \rb famous|שֵׁמ֔וֹת\rb* \rb men|אֲנָשִׁים֙\rb*, \rb and heads|רָאשִׁ֖ים\rb* \rb of their families|אֲבוֹתָֽם׃\rb*\rb |לְבֵ֥ית\rb*. \v 25 \rb But they were unfaithful|וַיִּֽמְעֲל֔וּ\rb* \rb to the God|בֵּאלֹהֵ֖י\rb* \rb of their fathers|אֲבוֹתֵיהֶ֑ם\rb*, \rb and they prostituted|וַיִּזְנ֗וּ\rb* \rb themselves with|אַחֲרֵי֙\rb* \rb the gods|אֱלֹהֵ֣י\rb* \rb of the peoples|עַמֵּי־\rb* \rb of the land|הָאָ֔רֶץ\rb*, \rb whom|אֲשֶׁר־\rb* \rb God|אֱלֹהִ֖ים\rb* \rb had destroyed|הִשְׁמִ֥יד\rb* \rb before them|מִפְּנֵיהֶֽם׃\rb*.
\b 
\li1 \v 26 \rb So the God|אֱלֹהֵ֨י\rb* \rb of Israel|יִשְׂרָאֵ֜ל\rb* \rb stirred up|וַיָּעַר֩\rb*\rb |אֶת־\rb* \rb the spirit|ר֣וּחַ׀\rb* \rb of Pul|פּ֣וּל\rb* \rb king|מֶֽלֶךְ־\rb* \rb of Assyria|אַשּׁ֗וּר\rb* (\rb that is|וְאֶת־\rb*,\rb |ר֙וּחַ֙\rb*\rb |תִּלְּגַ֤ת\rb* \rb Tiglath-pileser|פִּלְנֶ֙סֶר֙\rb* \rb king|מֶ֣לֶךְ\rb* \rb of Assyria|אַשּׁ֔וּר\rb*) \rb to take the Reubenites|לָראוּבֵנִ֣י\rb*, \rb the Gadites|וְלַגָּדִ֔י\rb*, \rb and the half-tribe|וְלַחֲצִ֖י\rb*\rb |שֵׁ֣בֶט\rb* \rb of Manasseh|מְנַשֶּׁ֑ה\rb* \rb into exile|וַיַּגְלֵם֙\rb*. \rb And he brought them|וַ֠יְבִיאֵם\rb* \rb to Halah|לַחְלַ֨ח\rb*, \rb Habor|וְחָב֤וֹר\rb*, \rb Hara|וְהָרָא֙\rb*, \rb and the river|וּנְהַ֣ר\rb* \rb of Gozan|גּוֹזָ֔ן\rb*, \rb where they remain to|עַ֖ד\rb* \rb this|הַזֶּֽה׃פ\rb* \rb day|הַיּ֥וֹם\rb*.
\c 6
\s1 The Descendants of Levi
\p \v 1 \rb The sons|בְּנֵ֖י\rb* \rb of Levi|לֵוִ֑י\rb*:
\b 
\li1 \rb Gershon|גֵּרְשׁ֕וֹן\rb*, \rb Kohath|קְהָ֖ת\rb*, \rb and Merari|וּמְרָרִֽי׃\rb*.
\b 
\li1 \v 2 \rb The sons|וּבְנֵ֖י\rb* \rb of Kohath|קְהָ֑ת\rb*:
\li2 \rb Amram|עַמְרָ֣ם\rb*, \rb Izhar|יִצְהָ֔ר\rb*, \rb Hebron|וְחֶבְר֖וֹן\rb*, \rb and Uzziel|וְעֻזִּיאֵֽל׃ס\rb*.
\b 
\li1 \v 3 \rb The children|וּבְנֵ֣י\rb* \rb of Amram|עַמְרָ֔ם\rb*:
\li2 \rb Aaron|אַהֲרֹ֥ן\rb*, \rb Moses|וּמֹשֶׁ֖ה\rb*, \rb and Miriam|וּמִרְיָ֑םס\rb*.
\b 
\li1 \rb The sons|וּבְנֵ֣י\rb* \rb of Aaron|אַהֲרֹ֔ן\rb*:
\li2 \rb Nadab|נָדָב֙\rb*, \rb Abihu|וַאֲבִיה֔וּא\rb*, \rb Eleazar|אֶלְעָזָ֖ר\rb*, \rb and Ithamar|וְאִיתָמָֽר׃ס\rb*.
\li2 \v 4 \rb Eleazar|אֶלְעָזָר֙\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Phinehas|פִּֽינְחָ֔ס\rb*,
\li2 \rb Phinehas|פִּֽינְחָ֖ס\rb* \rb was the father of|הֹלִ֥יד\rb*\rb |אֶת־\rb* \rb Abishua|אֲבִישֽׁוּעַ׃\rb*,
\li2 \v 5 \rb Abishua|וַאֲבִישׁ֙וּעַ֙\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Bukki|בֻּקִּ֔י\rb*,
\li2 \rb Bukki|וּבֻקִּ֖י\rb* \rb was the father of|הוֹלִ֥יד\rb*\rb |אֶת־\rb* \rb Uzzi|עֻזִּֽי׃\rb*,
\li2 \v 6 \rb Uzzi|וְעֻזִּי֙\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Zerahiah|זְרַֽחְיָ֔ה\rb*,
\li2 \rb Zerahiah|וּֽזְרַֽחְיָ֖ה\rb* \rb was the father of|הוֹלִ֥יד\rb*\rb |אֶת־\rb* \rb Meraioth|מְרָיֽוֹת׃\rb*,
\li2 \v 7 \rb Meraioth|מְרָיוֹת֙\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Amariah|אֲמַרְיָ֔ה\rb*,
\li2 \rb Amariah|וַאֲמַרְיָ֖ה\rb* \rb was the father of|הוֹלִ֥יד\rb*\rb |אֶת־\rb* \rb Ahitub|אֲחִיטֽוּב׃\rb*,
\li2 \v 8 \rb Ahitub|וַאֲחִיטוּב֙\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Zadok|צָד֔וֹק\rb*,
\li2 \rb Zadok|וְצָד֖וֹק\rb* \rb was the father of|הוֹלִ֥יד\rb*\rb |אֶת־\rb* \rb Ahimaaz|אֲחִימָֽעַץ׃\rb*,
\li2 \v 9 \rb Ahimaaz|וַאֲחִימַ֙עַץ֙\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Azariah|עֲזַרְיָ֔ה\rb*,
\li2 \rb Azariah|וַעֲזַרְיָ֖ה\rb* \rb was the father of|הוֹלִ֥יד\rb*\rb |אֶת־\rb* \rb Johanan|יוֹחָנָֽן׃\rb*,
\li2 \v 10 \rb Johanan|וְיוֹחָנָ֖ן\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Azariah|עֲזַרְיָ֑ה\rb*,\rb |ה֚וּא\rb* \rb who|אֲשֶׁ֣ר\rb* \rb served as priest|כִּהֵ֔ן\rb* \rb in the temple|בַּבַּ֕יִת\rb* \rb that|אֲשֶׁר־\rb* \rb Solomon|שְׁלֹמֹ֖ה\rb* \rb built|בָּנָ֥ה\rb* \rb in Jerusalem|בִּירוּשָׁלִָֽם׃\rb*,
\li2 \v 11 \rb Azariah|עֲזַרְיָ֖ה\rb*\rb |אֶת־\rb* \rb was the father of|וַיּ֥וֹלֶד\rb* \rb Amariah|אֲמַרְיָ֑ה\rb*,
\li2 \rb Amariah|וַאֲמַרְיָ֖ה\rb* \rb was the father of|הוֹלִ֥יד\rb*\rb |אֶת־\rb* \rb Ahitub|אֲחִיטֽוּב׃\rb*,
\li2 \v 12 \rb Ahitub|וַאֲחִיטוּב֙\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Zadok|צָד֔וֹק\rb*,
\li2 \rb Zadok|וְצָד֖וֹק\rb* \rb was the father of|הוֹלִ֥יד\rb*\rb |אֶת־\rb* \rb Shallum|שַׁלּֽוּם׃\rb*,
\li2 \v 13 \rb Shallum|וְשַׁלּוּם֙\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Hilkiah|חִלְקִיָּ֔ה\rb*,
\li2 \rb Hilkiah|וְחִלְקִיָּ֖ה\rb* \rb was the father of|הוֹלִ֥יד\rb*\rb |אֶת־\rb* \rb Azariah|עֲזַרְיָֽה׃\rb*,
\li2 \v 14 \rb Azariah|וַעֲזַרְיָה֙\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Seraiah|שְׂרָיָ֔ה\rb*,
\li2 \rb and Seraiah|וּשְׂרָיָ֖ה\rb* \rb was the father of|הוֹלִ֥יד\rb*\rb |אֶת־\rb* \rb Jehozadak|יְהוֹצָדָֽק׃\rb*.\f + \fr 6:14 \fqa Jehozadak \ft is a variant of \fqa Jozadak\ft ; also in verse 15; see \ref Ezra 3:2|EZR 3:2\ref*.\f*
\b 
\li1 \v 15 \rb Jehozadak|וִיהוֹצָדָ֣ק\rb* \rb went into captivity|הָלַ֔ךְ\rb* \rb when the LORD|יְהוָ֔ה\rb*\rb |אֶת־\rb* \rb sent Judah|יְהוּדָ֖ה\rb* \rb and Jerusalem|וִירוּשָׁלִָ֑ם\rb* \rb into exile|בְּהַגְל֣וֹת\rb* \rb by the hand|בְּיַ֖ד\rb* \rb of Nebuchadnezzar|נְבֻכַדְנֶאצַּֽר׃ס\rb*.
\p \v 16 \rb The sons of|בְּנֵ֖י\rb* \rb Levi|לֵוִ֑י\rb*:
\b 
\li1 \rb Gershom|גֵּרְשֹׁ֕ם\rb*,\f + \fr 6:16 \fqa Gershom \ft is a variant of \fqa Gershon\ft ; similarly in verses 17, 20, 43, 62, and 71; see verse 1.\f* \rb Kohath|קְהָ֖ת\rb*, \rb and Merari|וּמְרָרִֽי׃\rb*.
\b 
\li1 \v 17 \rb These are|וְאֵ֛לֶּה\rb* \rb the names of|שְׁמ֥וֹת\rb* \rb the sons|בְּֽנֵי־\rb* \rb of Gershom|גֵרְשׁ֖וֹם\rb*:
\li2 \rb Libni|לִבְנִ֥י\rb* \rb and Shimei|וְשִׁמְעִֽי׃\rb*.
\b 
\li1 \v 18 \rb The sons|וּבְנֵ֖י\rb* \rb of Kohath|קְהָ֑ת\rb*:
\li2 \rb Amram|עַמְרָ֣ם\rb*, \rb Izhar|וְיִצְהָ֔ר\rb*, \rb Hebron|וְחֶבְר֖וֹן\rb*, \rb and Uzziel|וְעֻזִּיאֵֽל׃\rb*.
\b 
\li1 \v 19 \rb The sons|בְּנֵ֥י\rb* \rb of Merari|מְרָרִ֖י\rb*:
\li2 \rb Mahli|מַחְלִ֣י\rb* \rb and Mushi|וּמֻשִׁ֑י\rb*.
\p \rb These are|וְאֵ֛לֶּה\rb* \rb the clans|מִשְׁפְּח֥וֹת\rb* \rb of the Levites|הַלֵּוִ֖י\rb* \rb listed according to their fathers|לַאֲבוֹתֵיהֶֽם׃\rb*:
\b 
\li1 \v 20 \rb Of Gershom|לְֽגֵרְשׁ֑וֹם\rb*:
\li2 \rb Libni|לִבְנִ֥י\rb* \rb his son|בְנ֛וֹ\rb*, \rb Jahath|יַ֥חַת\rb* \rb his son|בְּנ֖וֹ\rb*, \rb Zimmah|זִמָּ֥ה\rb* \rb his son|בְנֽוֹ׃\rb*, \v 21 \rb Joah|יוֹאָ֤ח\rb* \rb his son|בְּנוֹ֙\rb*, \rb Iddo|עִדּ֣וֹ\rb* \rb his son|בְנ֔וֹ\rb*, \rb Zerah|זֶ֥רַח\rb* \rb his son|בְּנ֖וֹ\rb*, \rb and Jeatherai|יְאָתְרַ֥י\rb* \rb his son|בְּנֽוֹ׃\rb*.
\b 
\li1 \v 22 \rb The descendants|בְּנֵ֖י\rb* \rb of Kohath|קְהָ֑ת\rb*:
\li2 \rb Amminadab|עַמִּינָדָ֣ב\rb* \rb his son|בְּנ֔וֹ\rb*, \rb Korah|קֹ֥רַח\rb* \rb his son|בְּנ֖וֹ\rb*, \rb Assir|אַסִּ֥יר\rb* \rb his son|בְּנֽוֹ׃\rb*, \v 23 \rb Elkanah|אֶלְקָנָ֥ה\rb* \rb his son|בְנ֛וֹ\rb*, \rb Ebiasaph|וְאֶבְיָסָ֥ף\rb*\f + \fr 6:23 \fqa Ebiasaph \ft is a variant of \fqa Abiasaph\ft ; also in verse 37; see \ref Exodus 6:24|EXO 6:24\ref*.\f* \rb his son|בְּנ֖וֹ\rb*, \rb Assir|וְאַסִּ֥יר\rb* \rb his son|בְּנֽוֹ׃\rb*, \v 24 \rb Tahath|תַּ֤חַת\rb* \rb his son|בְּנוֹ֙\rb*, \rb Uriel|אוּרִיאֵ֣ל\rb* \rb his son|בְּנ֔וֹ\rb*, \rb Uzziah|עֻזִּיָּ֥ה\rb* \rb his son|בְנ֖וֹ\rb*, \rb and Shaul|וְשָׁא֥וּל\rb* \rb his son|בְּנֽוֹ׃\rb*.
\b 
\li1 \v 25 \rb The descendants|וּבְנֵי֙\rb* \rb of Elkanah|אֶלְקָנָ֔ה\rb*:
\li2 \rb Amasai|עֲמָשַׂ֖י\rb*, \rb Ahimoth|וַאֲחִימֽוֹת׃\rb*, \v 26 \rb Elkanah|אֶלְקָנָ֑ה\rb* \rb his son|בְּנוֹ\rb*\rb |אֶלְקָנָ֔ה\rb*,\f + \fr 6:26 \ft Some Hebrew manuscripts, LXX, and Syriac; most Hebrew manuscripts \fqa Elkanah. The sons of Elkanah:\f* \rb Zophai|צוֹפַ֥י\rb* \rb his son|בְּנ֖וֹ\rb*, \rb Nahath|וְנַ֥חַת\rb* \rb his son|בְּנֽוֹ׃\rb*, \v 27 \rb Eliab|אֱלִיאָ֥ב\rb*\f + \fr 6:27 \fqa Eliab \ft is also called \fqa Eliel\ft ; see verse 34. Both of these are other names for Elihu\fqa ; see \ref 1 Samuel 1:1|1SA 1:1\ref*.\f* \rb his son|בְּנ֛וֹ\rb*, \rb Jeroham|יְרֹחָ֥ם\rb* \rb his son|בְּנ֖וֹ\rb*, \rb and Elkanah|אֶלְקָנָ֥ה\rb* \rb his son|בְנֽוֹ׃\rb*.\f + \fr 6:27 \ft Hebrew; some LXX manuscripts include \fqa and Samuel his son\ft ; see verses 33–34 and \ref 1 Samuel 1:19–20|1SA 1:19-20\ref*.\f*
\b 
\li1 \v 28 \rb The sons|וּבְנֵ֧י\rb* \rb of Samuel|שְׁמוּאֵ֛ל\rb*:
\li2 \rb Joel his firstborn|הַבְּכֹ֥ר\rb* \rb and Abijah|וַאֲבִיָּֽה׃ס\rb* \rb his second son|וַשְׁנִ֖י\rb*.\f + \fr 6:28 \ft See Syriac and some LXX manuscripts (also verse 33 and \ref 1 Samuel 8:2|1SA 8:2\ref*); Hebrew \fqa The sons of Samuel: the firstborn Vashni, then Abiah\ft .\f*
\b 
\li1 \v 29 \rb The descendants|בְּנֵ֥י\rb* \rb of Merari|מְרָרִ֖י\rb*:
\li2 \rb Mahli|מַחְלִ֑י\rb*, \rb Libni|לִבְנִ֥י\rb* \rb his son|בְנ֛וֹ\rb*, \rb Shimei|שִׁמְעִ֥י\rb* \rb his son|בְנ֖וֹ\rb*, \rb Uzzah|עֻזָּ֥ה\rb* \rb his son|בְנֽוֹ׃\rb*, \v 30 \rb Shimea|שִׁמְעָ֥א\rb* \rb his son|בְנ֛וֹ\rb*, \rb Haggiah|חַגִּיָּ֥ה\rb* \rb his son|בְנ֖וֹ\rb*, \rb and Asaiah|עֲשָׂיָ֥ה\rb* \rb his son|בְנֽוֹ׃פ\rb*.
\s1 The Temple Musicians
\p \v 31 \rb These|וְאֵ֗לֶּה\rb* \rb are the men|אֲשֶׁ֨ר\rb* \rb David|דָּוִ֛יד\rb* \rb put|הֶעֱמִ֥יד\rb* \rb in|עַל־\rb* \rb charge|יְדֵי־\rb* \rb of the music|שִׁ֖יר\rb* \rb in the house|בֵּ֣ית\rb* \rb of the LORD|יְהוָ֑ה\rb* \rb after the ark|הָאָרֽוֹן׃\rb* \rb rested there|מִמְּנ֖וֹחַ\rb*. \v 32 \rb |וַיִּהְי֨וּ\rb* \rb They ministered|מְשָׁרְתִ֜ים\rb* \rb with song|בַּשִּׁ֔יר\rb* \rb before|לִפְנֵ֨י\rb* \rb the tabernacle|מִשְׁכַּ֤ן\rb*, \rb the Tent|אֹֽהֶל־\rb* \rb of Meeting|מוֹעֵד֙\rb*, \rb until|עַד־\rb* \rb Solomon|שְׁלֹמֹ֛ה\rb*\rb |אֶת־\rb* \rb built|בְּנ֧וֹת\rb* \rb the house|בֵּ֥ית\rb* \rb of the LORD|יְהוָ֖ה\rb* \rb in Jerusalem|בִּירוּשָׁלִָ֑ם\rb*. \rb And they performed|וַיַּעַמְד֥וּ\rb* \rb their duties|עֲבוֹדָתָֽם׃\rb* \rb according to the regulations given them|כְמִשְׁפָּטָ֖ם\rb*\rb |עַל־\rb*. \v 33 \rb These|וְאֵ֥לֶּה\rb* \rb are the men who served|הָעֹמְדִ֖ים\rb*, \rb together with their sons|וּבְנֵיהֶ֑ם\rb*.
\b 
\li1 \rb From the Kohathites|מִבְּנֵי֙\rb*\rb |הַקְּהָתִ֔י\rb*:
\li2 \rb Heman|הֵימָן֙\rb* \rb the singer|הַמְשׁוֹרֵ֔ר\rb*, \rb the son|בֶּן־\rb* \rb of Joel|יוֹאֵ֖ל\rb*, \rb the son|בֶּן־\rb* \rb of Samuel|שְׁמוּאֵֽל׃\rb*, \v 34 \rb the son|בֶּן־\rb* \rb of Elkanah|אֶלְקָנָה֙\rb*, \rb the son|בֶּן־\rb* \rb of Jeroham|יְרֹחָ֔ם\rb*, \rb the son|בֶּן־\rb* \rb of Eliel|אֱלִיאֵ֖ל\rb*,\f + \fr 6:34 \fqa Eliel \ft is also called \fqa Eliab\ft ; see verse 27. Both of these are other names for Elihu\fqa ; see \ref 1 Samuel 1:1|1SA 1:1\ref*.\f* \rb the son|בֶּן־\rb* \rb of Toah|תּֽוֹחַ׃\rb*, \v 35 \rb the son|בֶּן־\rb* \rb of Zuph|צִיף\rb*, \rb the son|בֶּן־\rb* \rb of Elkanah|אֶלְקָנָ֔ה\rb*, \rb the son|בֶּן־\rb* \rb of Mahath|מַ֖חַת\rb*, \rb the son|בֶּן־\rb* \rb of Amasai|עֲמָשָֽׂי׃\rb*, \v 36 \rb the son|בֶּן־\rb* \rb of Elkanah|אֶלְקָנָה֙\rb*, \rb the son|בֶּן־\rb* \rb of Joel|יוֹאֵ֔ל\rb*, \rb the son|בֶּן־\rb* \rb of Azariah|עֲזַרְיָ֖ה\rb*, \rb the son|בֶּן־\rb* \rb of Zephaniah|צְפַנְיָֽה׃\rb*, \v 37 \rb the son|בֶּן־\rb* \rb of Tahath|תַּ֙חַת֙\rb*, \rb the son|בֶּן־\rb* \rb of Assir|אַסִּ֔יר\rb*, \rb the son|בֶּן־\rb* \rb of Ebiasaph|אֶבְיָסָ֖ף\rb*, \rb the son|בֶּן־\rb* \rb of Korah|קֹֽרַח׃\rb*, \v 38 \rb the son|בֶּן־\rb* \rb of Izhar|יִצְהָ֣ר\rb*, \rb the son|בֶּן־\rb* \rb of Kohath|קְהָ֔ת\rb*, \rb the son|בֶּן־\rb* \rb of Levi|לֵוִ֖י\rb*, \rb the son|בֶּן־\rb* \rb of Israel|יִשְׂרָאֵֽל׃\rb*.
\b 
\li1 \v 39 \rb Heman’s kinsman|וְאָחִ֣יו\rb* \rb was Asaph|אָסָ֔ף\rb*, \rb who served|הָעֹמֵ֖ד\rb* \rb at|עַל־\rb* \rb his right hand|יְמִינ֑וֹ\rb*:
\li2 \rb Asaph|אָסָ֥ף\rb* \rb the son|בֶּן־\rb* \rb of Berechiah|בֶּרֶכְיָ֖הוּ\rb*, \rb the son|בֶּן־\rb* \rb of Shimea|שִׁמְעָֽא׃\rb*, \v 40 \rb the son|בֶּן־\rb* \rb of Michael|מִיכָאֵ֥ל\rb*, \rb the son|בֶּן־\rb* \rb of Baaseiah|בַּעֲשֵׂיָ֖ה\rb*,\f + \fr 6:40 \ft Most Hebrew manuscripts; some Hebrew manuscripts, one LXX manuscript, and Syriac \fqa Maaseiah\f* \rb the son|בֶּן־\rb* \rb of Malchijah|מַלְכִּיָּֽה׃\rb*, \v 41 \rb the son|בֶּן־\rb* \rb of Ethni|אֶתְנִ֥י\rb*, \rb the son|בֶן־\rb* \rb of Zerah|זֶ֖רַח\rb*, \rb the son|בֶּן־\rb* \rb of Adaiah|עֲדָיָֽה׃\rb*, \v 42 \rb the son|בֶּן־\rb* \rb of Ethan|אֵיתָ֥ן\rb*, \rb the son|בֶּן־\rb* \rb of Zimmah|זִמָּ֖ה\rb*, \rb the son|בֶּן־\rb* \rb of Shimei|שִׁמְעִֽי׃\rb*, \v 43 \rb the son|בֶּן־\rb* \rb of Jahath|יַ֥חַת\rb*, \rb the son|בֶּן־\rb* \rb of Gershom|גֵּרְשֹׁ֖ם\rb*, \rb the son|בֶּן־\rb* \rb of Levi|לֵוִֽי׃ס\rb*.
\b 
\li1 \v 44 \rb On|עַֽל־\rb* \rb the left|הַשְּׂמֹ֑אול\rb* \rb were their kinsmen|אֲחֵיהֶ֖ם\rb*, \rb the sons|וּבְנֵ֧י\rb* \rb of Merari|מְרָרִ֛י\rb*:
\li2 \rb Ethan|אֵיתָן֙\rb* \rb the son|בֶּן־\rb* \rb of Kishi|קִישִׁ֔י\rb*, \rb the son|בֶּן־\rb* \rb of Abdi|עַבְדִּ֖י\rb*, \rb the son|בֶּן־\rb* \rb of Malluch|מַלּֽוּךְ׃\rb*, \v 45 \rb the son|בֶּן־\rb* \rb of Hashabiah|חֲשַׁבְיָ֥ה\rb*, \rb the son|בֶן־\rb* \rb of Amaziah|אֲמַצְיָ֖ה\rb*, \rb the son|בֶּן־\rb* \rb of Hilkiah|חִלְקִיָּֽה׃\rb*, \v 46 \rb the son|בֶּן־\rb* \rb of Amzi|אַמְצִ֥י\rb*, \rb the son|בֶן־\rb* \rb of Bani|בָּנִ֖י\rb*, \rb the son|בֶּן־\rb* \rb of Shemer|שָֽׁמֶר׃\rb*, \v 47 \rb the son|בֶּן־\rb* \rb of Mahli|מַחְלִי֙\rb*, \rb the son|בֶּן־\rb* \rb of Mushi|מוּשִׁ֔י\rb*, \rb the son|בֶּן־\rb* \rb of Merari|מְרָרִ֖י\rb*, \rb the son|בֶּן־\rb* \rb of Levi|לֵוִֽי׃ס\rb*.
\s1 The Descendants of Aaron
\p \v 48 \rb Their fellow|וַאֲחֵיהֶ֖ם\rb* \rb Levites|הַלְוִיִּ֑ם\rb* \rb were assigned|נְתוּנִ֕ים\rb* \rb to every kind|לְכָ֨ל־\rb* \rb of service|עֲבוֹדַ֔ת\rb* \rb of the tabernacle|מִשְׁכַּ֖ן\rb*, \rb the house|בֵּ֥ית\rb* \rb of God|הָאֱלֹהִֽים׃\rb*. \v 49 \rb But Aaron|וְֽאַהֲרֹ֨ן\rb* \rb and his sons|וּבָנָ֜יו\rb* \rb did all|לְכֹ֕ל\rb* \rb the work|מְלֶ֖אכֶת\rb* \rb of the Most Holy Place|קֹ֣דֶשׁ\rb*\rb |הַקֳּדָשִׁ֑ים\rb*.\f + \fr 6:49 \ft Or \fqa the Holy of Holies\f* \rb They presented the offerings|מַקְטִירִ֨ים\rb* \rb on|עַל־\rb* \rb the altar|מִזְבַּ֤ח\rb* \rb of burnt offering|הָֽעוֹלָה֙\rb* \rb and on|וְעַל־\rb* \rb the altar|מִזְבַּ֣ח\rb* \rb of incense|הַקְּטֹ֔רֶת\rb* \rb to make atonement|וּלְכַפֵּר֙\rb* \rb for|עַל־\rb* \rb Israel|יִשְׂרָאֵ֔ל\rb*, \rb according to all|כְּכֹל֙\rb* \rb that|אֲשֶׁ֣ר\rb* \rb Moses|מֹשֶׁ֖ה\rb* \rb the servant|עֶ֥בֶד\rb* \rb of God|הָאֱלֹהִֽים׃פ\rb* \rb had commanded|צִוָּ֔ה\rb*.
\b 
\li1 \v 50 \rb These|וְאֵ֖לֶּה\rb* \rb were the descendants|בְּנֵ֣י\rb* \rb of Aaron|אַהֲרֹ֑ן\rb*:
\li2 \rb Eleazar|אֶלְעָזָ֥ר\rb* \rb his son|בְּנ֛וֹ\rb*, \rb Phinehas|פִּֽינְחָ֥ס\rb* \rb his son|בְּנ֖וֹ\rb*, \rb Abishua|אֲבִישׁ֥וּעַ\rb* \rb his son|בְּנֽוֹ׃\rb*, \v 51 \rb Bukki|בֻּקִּ֥י\rb* \rb his son|בְנ֛וֹ\rb*, \rb Uzzi|עֻזִּ֥י\rb* \rb his son|בְנ֖וֹ\rb*, \rb Zerahiah|זְרַֽחְיָ֥ה\rb* \rb his son|בְנֽוֹ׃\rb*, \v 52 \rb Meraioth|מְרָי֥וֹת\rb* \rb his son|בְּנ֛וֹ\rb*, \rb Amariah|אֲמַרְיָ֥ה\rb* \rb his son|בְנ֖וֹ\rb*, \rb Ahitub|אֲחִיט֥וּב\rb* \rb his son|בְּנֽוֹ׃\rb*, \v 53 \rb Zadok|צָד֥וֹק\rb* \rb his son|בְּנ֖וֹ\rb*, \rb and Ahimaaz|אֲחִימַ֥עַץ\rb* \rb his son|בְּנֽוֹ׃ס\rb*.
\s1 Territories for the Levites
\r (\ref Numbers 35:1–8|NUM 35:1-8\ref*; \ref Joshua 21:1–45|JOS 21:1-45\ref*)
\p \v 54 \rb Now these were|וְאֵ֙לֶּה֙\rb* \rb the territories|בִּגְבוּלָ֑ם\rb* \rb assigned to the descendants|לִבְנֵ֤י\rb* \rb of Aaron|אַהֲרֹן֙\rb* \rb from the Kohathite|הַקְּהָתִ֔י\rb* \rb clan|לְמִשְׁפַּחַ֣ת\rb* \rb for their settlements|מוֹשְׁבוֹתָ֔ם\rb*\rb |לְטִירוֹתָ֖ם\rb*, \rb because|כִּ֥י\rb* \rb the first lot|הַגּוֹרָֽל׃\rb* \rb fell|הָיָ֥ה\rb* \rb to them|לָהֶ֖ם\rb*:
\b 
\li1 \v 55 \rb They were given|וַֽיִּתְּנ֥וּ\rb*\rb |לָהֶ֛ם\rb*\rb |אֶת־\rb* \rb Hebron|חֶבְר֖וֹן\rb* \rb in the land|בְּאֶ֣רֶץ\rb* \rb of Judah|יְהוּדָ֑ה\rb*\rb |וְאֶת־\rb* \rb and its surrounding|סְבִיבֹתֶֽיהָ׃\rb* \rb pasturelands|מִגְרָשֶׁ֖יהָ\rb*. \v 56 \rb |וְאֶת־\rb* \rb But the fields|שְׂדֵ֥ה\rb* \rb and villages|חֲצֵרֶ֑יהָ\rb* \rb around the city|הָעִ֖יר\rb*\rb |וְאֶת־\rb* \rb were given|נָתְנ֖וּ\rb* \rb to Caleb|לְכָלֵ֥ב\rb* \rb son|בֶּן־\rb* \rb of Jephunneh|יְפֻנֶּֽה׃ס\rb*. \v 57 \rb So the descendants|וְלִבְנֵ֣י\rb* \rb of Aaron|אַהֲרֹ֗ן\rb* \rb were given|נָתְנוּ֙\rb*\rb |אֶת־\rb* \rb Hebron|חֶבְר֥וֹן\rb*\rb |וְאֶת־\rb* \rb (a city|עָרֵ֣י\rb* \rb of refuge|הַמִּקְלָ֔ט\rb*),\rb |אֶת־\rb* \rb Libnah|לִבְנָ֖ה\rb*\rb |וְאֶת־\rb*\rb |מִגְרָשֶׁ֑יהָ\rb*,\f + \fr 6:57 \ft As in the parallel text at \ref Joshua 21:13|JOS 21:13\ref*; Hebrew \fqa were given the cities of refuge: Hebron, Libnah\f*\rb |וְאֶת־\rb* \rb Jattir|יַתִּ֥ר\rb*,\rb |וְאֶֽת־\rb* \rb Eshtemoa|אֶשְׁתְּמֹ֖עַ\rb*\rb |וְאֶת־\rb*\rb |מִגְרָשֶֽׁיהָ׃\rb*, \v 58 \rb |וְאֶת־\rb* \rb Hilen|חִילֵז֙\rb*\rb |וְאֶת־\rb*\rb |מִגְרָשֶׁ֔יהָ\rb*,\f + \fr 6:58 \ft Some Hebrew manuscripts; MT \fqa Hilez\ft ; parallel text at \ref Joshua 21:15|JOS 21:15\ref* \fqa Holon\f*\rb |אֶת־\rb* \rb Debir|דְּבִ֖יר\rb*\rb |וְאֶת־\rb*\rb |מִגְרָשֶֽׁיהָ׃\rb*, \v 59 \rb |וְאֶת־\rb* \rb Ashan|עָשָׁן֙\rb*,\f + \fr 6:59 \fqa Ashan \ft is a variant of \fqa Ain\ft ; see \ref Joshua 21:16|JOS 21:16\ref*.\f*\rb |וְאֶת־\rb* \rb Juttah,|מִגְרָשֶׁ֔יהָ\rb*\f + \fr 6:59 \ft Syriac and the parallel text at \ref Joshua 21:16|JOS 21:16\ref*; MT does not include \fqa Juttah,\f*\rb |וְאֶת־\rb*\rb |בֵּ֥ית\rb* \rb and Beth-shemesh|שֶׁ֖מֶשׁ\rb*, \rb together with|וְאֶת־\rb* \rb their pasturelands|מִגְרָשֶֽׁיהָ׃ס\rb*.
\b 
\li1 \v 60 \rb And from the tribe|וּמִמַּטֵּ֣ה\rb* \rb of Benjamin|בִנְיָמִ֗ן\rb* \rb they were given Gibeon,|אֶת־\rb*\f + \fr 6:60 \ft LXX, Syriac, and parallel text at \ref Joshua 21:17|JOS 21:17\ref*; MT does not include \fqa Gibeon,\f* \rb Geba|גֶּ֤בַע\rb*,\rb |וְאֶת־\rb*\rb |מִגְרָשֶׁ֙יהָ֙\rb*\rb |וְאֶת־\rb* \rb Alemeth|עָלֶ֣מֶת\rb*,\rb |וְאֶת־\rb*\rb |מִגְרָשֶׁ֔יהָ\rb*\rb |וְאֶת־\rb* \rb and Anathoth|עֲנָת֖וֹת\rb*, \rb together with|וְאֶת־\rb* \rb their pasturelands|מִגְרָשֶׁ֑יהָ\rb*. \rb So they had thirteen|שְׁלֹשׁ־\rb*\rb |עֶשְׂרֵ֥ה\rb*\rb |עִ֖יר\rb* \rb cities|עָרֵיהֶ֛ם\rb* \rb in all|כָּל־\rb* \rb among their families|בְּמִשְׁפְּחוֹתֵיהֶֽם׃ס\rb*.
\b 
\li1 \v 61 \rb To the rest|הַנּוֹתָרִ֗ים\rb*\rb |מִמִּשְׁפַּ֣חַת\rb* \rb of the Kohathites|וְלִבְנֵ֨י\rb*\rb |קְהָ֜ת\rb*, \rb ten|עָֽשֶׂר׃ס\rb* \rb cities|עָרִ֥ים\rb* \rb were allotted|בַּגּוֹרָ֖ל\rb* \rb from the half-tribe|מִֽ֠מַּחֲצִית\rb*\rb |מַטֵּ֨ה\rb*\rb |חֲצִ֧י\rb*\rb |הַמַּטֶּ֡ה\rb* \rb of Manasseh|מְנַשֶּׁ֛ה\rb*.
\p \v 62 \rb The Gershomites|וְלִבְנֵ֨י\rb*\f + \fr 6:62 \fqa Gershomites \ft is a variant of \fqa Gershonites\ft ; also in verse 71; see \ref 1 Chronicles 23:7|1CH 23:7\ref*.\f*\rb |גֵרְשׁ֜וֹם\rb*, \rb according to their clans|לְמִשְׁפְּחוֹתָ֗ם\rb*, \rb were allotted thirteen|שְׁלֹ֥שׁ\rb*\rb |עֶשְׂרֵֽה׃ס\rb* \rb cities|עָרִ֖ים\rb* \rb from the tribes|מִמַּטֵּ֣ה\rb* \rb of Issachar|יִ֠שָׂשכָר\rb*,\rb |וּמִמַּטֵּ֨ה\rb* \rb Asher|אָשֵׁ֜ר\rb*,\rb |וּמִמַּטֵּ֣ה\rb* \rb Naphtali|נַפְתָּלִ֗י\rb*,\rb |וּמִמַּטֵּ֤ה\rb* \rb and Manasseh|מְנַשֶּׁה֙\rb* \rb in Bashan|בַּבָּשָׁ֔ן\rb*.
\p \v 63 \rb The Merarites|לִבְנֵ֨י\rb*\rb |מְרָרִ֜י\rb*, \rb according to their clans|לְמִשְׁפְּחוֹתָ֗ם\rb*, \rb were allotted|בַּגּוֹרָ֔ל\rb* \rb twelve|שְׁתֵּ֥ים\rb*\rb |עֶשְׂרֵֽה׃\rb* \rb cities|עָרִ֖ים\rb* \rb from the tribes|מִמַּטֵּ֣ה\rb* \rb of Reuben|רְ֠אוּבֵן\rb*,\rb |וּֽמִמַּטֵּה־\rb* \rb Gad|גָ֞ד\rb*,\rb |וּמִמַּטֵּ֤ה\rb* \rb and Zebulun|זְבוּלֻן֙\rb*.
\p \v 64 \rb So the Israelites|בְנֵי־\rb*\rb |יִשְׂרָאֵ֖ל\rb* \rb gave|וַיִּתְּנ֥וּ\rb* \rb to the Levites|לַלְוִיִּ֑ם\rb*\rb |אֶת־\rb* \rb these cities|הֶעָרִ֖ים\rb*\rb |וְאֶת־\rb* \rb and their pasturelands|מִגְרְשֵׁיהֶֽם׃\rb*. \v 65 \rb They assigned|וַיִּתְּנ֣וּ\rb* \rb by lot|בַגּוֹרָ֗ל\rb* \rb the cities|הֶעָרִ֣ים\rb*\rb |הָאֵ֔לֶּה\rb*\rb |אֲשֶׁר־\rb* \rb named|יִקְרְא֥וּ\rb*\rb |אֶתְהֶ֖ם\rb* \rb above|בְּשֵׁמֽוֹת׃ס\rb* \rb from the tribes|מִמַּטֵּ֤ה\rb* \rb of Judah|בְנֵי־\rb*\rb |יְהוּדָה֙\rb*,\rb |וּמִמַּטֵּ֣ה\rb* \rb Simeon|בְנֵי־\rb*\rb |שִׁמְע֔וֹן\rb*,\rb |וּמִמַּטֵּ֖ה\rb* \rb and Benjamin|בְּנֵ֣י\rb*\rb |בִנְיָמִ֑ן\rb*.\rb |אֵ֚ת\rb*
\p \v 66 \rb And some of the clans|וּמִֽמִּשְׁפְּח֖וֹת\rb* \rb of the Kohathites|בְּנֵ֣י\rb*\rb |קְהָ֑ת\rb*\rb |וַיְהִי֙\rb* \rb were given cities|עָרֵ֣י\rb* \rb from the tribe|מִמַּטֵּ֖ה\rb* \rb of Ephraim|אֶפְרָֽיִם׃\rb* \rb for their territory|גְבוּלָ֔ם\rb*:
\b 
\li1 \v 67 \rb They were given|וַיִּתְּנ֨וּ\rb*\rb |אֶת־\rb* \rb Shechem|שְׁכֶ֥ם\rb*\rb |וְאֶת־\rb* \rb (a city|עָרֵ֧י\rb* \rb of refuge|הַמִּקְלָ֛ט\rb*)\f + \fr 6:67 \ft As in the parallel text at \ref Joshua 21:21|JOS 21:21\ref*; Hebrew \fqa They were given the cities of refuge: Shechem\f*\rb |אֶת־\rb* \rb with its pasturelands|מִגְרָשֶׁ֖יהָ\rb* \rb in the hill country|בְּהַ֣ר\rb* \rb of Ephraim|אֶפְרָ֑יִם\rb*, \rb and|וְאֶת־\rb* \rb Gezer|גֶּ֖זֶר\rb*\rb |וְאֶת־\rb*\rb |מִגְרָשֶֽׁיהָ׃\rb*, \v 68 \rb |וְאֶֽת־\rb* \rb Jokmeam|יָקְמְעָם֙\rb*\rb |וְאֶת־\rb*\rb |מִגְרָשֶׁ֔יהָ\rb*,\rb |וְאֶת־\rb*\rb |בֵּ֥ית\rb* \rb Beth-horon|חוֹר֖וֹן\rb*\rb |וְאֶת־\rb*\rb |מִגְרָשֶֽׁיהָ׃\rb*, \v 69 \rb |וְאֶת־\rb* \rb Aijalon|אַיָּלוֹן֙\rb*\rb |וְאֶת־\rb*\rb |מִגְרָשֶׁ֔יהָ\rb*,\rb |וְאֶת־\rb*\rb |גַּת־\rb* \rb and Gath-rimmon|רִמּ֖וֹן\rb*, \rb together with|וְאֶת־\rb* \rb their pasturelands|מִגְרָשֶֽׁיהָ׃פ\rb*.
\b 
\li1 \v 70 \rb And from|וּמִֽמַּחֲצִית֙\rb* \rb the half-tribe|מַטֵּ֣ה\rb* \rb of Manasseh|מְנַשֶּׁ֔ה\rb* \rb the rest of the|הַנּוֹתָרִֽים׃פ\rb* \rb clans|לְמִשְׁפַּ֥חַת\rb* \rb of the Kohathites|לִבְנֵי־\rb*\rb |קְהָ֖ת\rb* \rb were given Aner|עָנֵר֙\rb*\rb |וְאֶת־\rb*\rb |מִגְרָשֶׁ֔יהָ\rb*\rb |וְאֶת־\rb* \rb and Bileam|בִּלְעָ֖ם\rb*, \rb together with|וְאֶת־\rb* \rb their pasturelands|מִגְרָשֶׁ֑יהָ\rb*.
\p \v 71 \rb The Gershomites received the following|לִבְנֵי֮\rb*\rb |גֵּרְשׁוֹם֒\rb*:
\b 
\li1 \rb From the clan|מִמִּשְׁפַּ֗חַת\rb* \rb of|חֲצִי֙\rb* \rb the half-tribe|מַטֵּ֣ה\rb* \rb of Manasseh|מְנַשֶּׁ֔ה\rb* \rb they were given|אֶת־\rb* \rb Golan|גּוֹלָ֥ן\rb* \rb in Bashan|בַּבָּשָׁ֖ן\rb*\rb |וְאֶת־\rb*\rb |מִגְרָשֶׁ֑יהָ\rb* \rb and also|וְאֶת־\rb* \rb Ashtaroth|עַשְׁתָּר֖וֹת\rb*, \rb together with|וְאֶת־\rb* \rb their pasturelands|מִגְרָשֶֽׁיהָ׃ס\rb*.
\b 
\li1 \v 72 \rb From the tribe|וּמִמַּטֵּ֣ה\rb* \rb of Issachar|יִשָׂשכָ֔ר\rb* \rb they were given|אֶת־\rb* \rb Kedesh|קֶ֖דֶשׁ\rb*\rb |וְאֶת־\rb*\rb |מִגְרָשֶׁ֑יהָ\rb*,\rb |אֶת־\rb* \rb Daberath|דָּבְרַ֖ת\rb*, \v 73 \rb |וְאֶת־\rb* \rb Ramoth|רָאמוֹת֙\rb*\rb |וְאֶת־\rb*,\rb |וְאֶת־\rb* \rb and Anem|עָנֵ֖ם\rb*, \rb together with|וְאֶת־\rb* \rb their pasturelands|מִגְרָשֶֽׁיהָ׃ס\rb*.
\b 
\li1 \v 74 \rb From the tribe|וּמִמַּטֵּ֣ה\rb* \rb of Asher|אָשֵׁ֔ר\rb* \rb they were given|אֶת־\rb* \rb Mashal|מָשָׁ֖ל\rb*\rb |וְאֶת־\rb*\rb |מִגְרָשֶׁ֑יהָ\rb*,\rb |וְאֶת־\rb* \rb Abdon|עַבְדּ֖וֹן\rb*\rb |וְאֶת־\rb*\rb |מִגְרָשֶֽׁיהָ׃\rb*, \v 75 \rb |וְאֶת־\rb* \rb Hukok|חוּקֹק֙\rb*\rb |וְאֶת־\rb*\rb |מִגְרָשֶׁ֔יהָ\rb*,\rb |וְאֶת־\rb* \rb and Rehob|רְחֹ֖ב\rb*, \rb together with|וְאֶת־\rb* \rb their pasturelands|מִגְרָשֶֽׁיהָ׃\rb*.
\b 
\li1 \v 76 \rb And from the tribe|וּמִמַּטֵּ֣ה\rb* \rb of Naphtali|נַפְתָּלִ֗י\rb* \rb they were given|אֶת־\rb* \rb Kedesh|קֶ֤דֶשׁ\rb* \rb in Galilee|בַּגָּלִיל֙\rb*\rb |וְאֶת־\rb*\rb |מִגְרָשֶׁ֔יהָ\rb*,\rb |וְאֶת־\rb* \rb Hammon|חַמּ֖וֹן\rb*\rb |וְאֶת־\rb*\rb |מִגְרָשֶׁ֑יהָ\rb*,\rb |וְאֶת־\rb* \rb and Kiriathaim|קִרְיָתַ֖יִם\rb*, \rb together with|וְאֶת־\rb* \rb their pasturelands|מִגְרָשֶֽׁיהָ׃ס\rb*.
\p \v 77 \rb The Merarites|לִבְנֵ֣י\rb*\rb |מְרָרִי֮\rb* (\rb the rest of the Levites) received the following|הַנּוֹתָרִים֒\rb*:
\b 
\li1 \rb From the tribe|מִמַּטֵּ֣ה\rb* \rb of Zebulun|זְבוּלֻ֔ן\rb* \rb they were given|אֶת־\rb* \rb Rimmono|רִמּוֹנ֖וֹ\rb*\rb |וְאֶת־\rb*\rb |מִגְרָשֶׁ֑יהָ\rb*\rb |אֶת־\rb* \rb and Tabor|תָּב֖וֹר\rb*,\f + \fr 6:77 \ft LXX \fqa (they were given) Jokneam, Kartah, Rimmono, and Tabor\ft ; see \ref Joshua 21:34|JOS 21:34\ref*.\f* \rb together with|וְאֶת־\rb* \rb their pasturelands|מִגְרָשֶֽׁיהָ׃\rb*.
\b 
\li1 \v 78 \rb From the tribe|מִמַּטֵּ֣ה\rb* \rb of Reuben|רְאוּבֵ֔ן\rb*\rb |אֶת־\rb*\rb |וּמֵעֵ֜בֶר\rb* \rb east|לְמִזְרַ֣ח\rb* \rb of the Jordan|לְיַרְדֵּ֣ן\rb* \rb opposite Jericho|יְרֵחוֹ֮\rb*\rb |הַיַּרְדֵּן֒\rb* \rb they were given Bezer|בֶּ֥צֶר\rb* \rb in the wilderness|בַּמִּדְבָּ֖ר\rb*\rb |וְאֶת־\rb*\rb |מִגְרָשֶׁ֑יהָ\rb*,\rb |וְאֶת־\rb* \rb Jahzah|יַ֖הְצָה\rb*\rb |וְאֶת־\rb*\rb |מִגְרָשֶֽׁיהָ׃\rb*,\f + \fr 6:78 \fqa Jahzah \ft is a variant of \fqa Jahaz\ft ; see \ref Numbers 21:23|NUM 21:23\ref*.\f* \v 79 \rb |וְאֶת־\rb* \rb Kedemoth|קְדֵמוֹת֙\rb*\rb |וְאֶת־\rb*\rb |מִגְרָשֶׁ֔יהָ\rb*,\rb |וְאֶת־\rb* \rb and Mephaath|מֵיפַ֖עַת\rb*, \rb together with|וְאֶת־\rb* \rb their pasturelands|מִגְרָשֶֽׁיהָ׃\rb*.
\b 
\li1 \v 80 \rb And from the tribe|וּמִ֨מַּטֵּה־\rb* \rb of Gad|גָ֔ד\rb* \rb they were given|אֶת־\rb* \rb Ramoth|רָאמ֥וֹת\rb* \rb in Gilead|בַּגִּלְעָ֖ד\rb*\rb |וְאֶת־\rb*\rb |מִגְרָשֶׁ֑יהָ\rb*,\rb |וְאֶֽת־\rb* \rb Mahanaim|מַחֲנַ֖יִם\rb*\rb |וְאֶת־\rb*\rb |מִגְרָשֶֽׁיהָ׃\rb*, \v 81 \rb |וְאֶת־\rb* \rb Heshbon|חֶשְׁבּוֹן֙\rb*\rb |וְאֶת־\rb*\rb |מִגְרָשֶׁ֔יהָ\rb*,\rb |וְאֶת־\rb* \rb and Jazer|יַעְזֵ֖יר\rb*, \rb together with|וְאֶת־\rb* \rb their pasturelands|מִגְרָשֶֽׁיהָ׃ס\rb*.
\c 7
\s1 The Descendants of Issachar
\p \v 1 \rb The sons|וְלִבְנֵ֣י\rb* \rb of Issachar|יִשָׂשכָ֗ר\rb*:
\b 
\li1 \rb Tola|תּוֹלָ֧ע\rb*, \rb Puah|וּפוּאָ֛ה\rb*,\f + \fr 7:1 \fqa Puah \ft is a variant of \fqa Puvah\ft ; see \ref Genesis 46:13|GEN 46:13\ref* and Numbers 26:23.\f* \rb Jashub|יָשִׁיב\rb*, \rb and Shimron|וְשִׁמְר֖וֹן\rb*— \rb four in all|אַרְבָּעָֽה׃ס\rb*.
\b 
\li1 \v 2 \rb The sons|וּבְנֵ֣י\rb* \rb of Tola|תוֹלָ֗ע\rb*:
\li2 \rb Uzzi|עֻזִּ֡י\rb*, \rb Rephaiah|וּרְפָיָ֡ה\rb*, \rb Jeriel|וִֽ֠ירִיאֵל\rb*, \rb Jahmai|וְיַחְמַ֨י\rb*, \rb Ibsam|וְיִבְשָׂ֜ם\rb*, \rb and Shemuel|וּשְׁמוּאֵ֗ל\rb*, \rb the heads|רָאשִׁ֤ים\rb* \rb of their families|אֲבוֹתָם֙\rb*\rb |לְבֵית־\rb*. \rb In the days|בִּימֵ֣י\rb* \rb of David|דָוִ֔יד\rb*, \rb 22,600|עֶשְׂרִֽים־\rb*\rb |וּשְׁנַ֥יִם\rb*\rb |אֶ֖לֶף\rb*\rb |וְשֵׁ֥שׁ\rb*\rb |מֵאֽוֹת׃ס\rb* \rb descendants of Tola|לְתוֹלָ֔ע\rb* \rb were numbered|מִסְפָּרָם֙\rb* \rb in their genealogies|לְתֹלְדוֹתָ֑ם\rb* \rb as mighty men|גִּבּ֥וֹרֵי\rb* \rb of valor|חַ֖יִל\rb*.
\b 
\li1 \v 3 \rb The son|וּבְנֵ֥י\rb*\f + \fr 7:3 \ft Hebrew \fqa sons\ft ; also in verses 10 and 17\f* \rb of Uzzi|עֻזִּ֖י\rb*:
\li2 \rb Izrahiah|יִֽזְרַֽחְיָ֑ה\rb*.
\b 
\li1 \rb The sons|וּבְנֵ֣י\rb* \rb of Izrahiah|יִֽזְרַֽחְיָ֗ה\rb*:
\li2 \rb Michael|מִֽיכָאֵ֡ל\rb*, \rb Obadiah|וְ֠עֹבַדְיָה\rb*, \rb Joel|וְיוֹאֵ֧ל\rb*, \rb and Isshiah|יִשִּׁיָּ֛ה\rb*. \rb All|כֻּלָּֽם׃\rb* \rb five|חֲמִשָּׁ֖ה\rb* \rb of them were chiefs|רָאשִׁ֥ים\rb*. \v 4 \rb In addition to them|וַעֲלֵיהֶ֨ם\rb*, \rb according to their genealogy|לְתֹלְדוֹתָ֜ם\rb*\rb |אֲבוֹתָ֗ם\rb*\rb |גְּדוּדֵי֙\rb*\rb |לְבֵ֣ית\rb*, \rb they had 36,000|שְׁלֹשִׁ֥ים\rb*\rb |וְשִׁשָּׁ֖ה\rb*\rb |אָ֑לֶף\rb* \rb troops|צְבָ֣א\rb* \rb for battle|מִלְחָמָ֔ה\rb*, \rb for|כִּֽי־\rb* \rb they had many|הִרְבּ֥וּ\rb* \rb wives|נָשִׁ֖ים\rb* \rb and children|וּבָנִֽים׃\rb*.
\b 
\li1 \v 5 \rb Their kinsmen|וַאֲחֵיהֶ֗ם\rb* \rb belonging to all|לְכֹל֙\rb* \rb the families|מִשְׁפְּח֣וֹת\rb* \rb of Issachar|יִשָׂשכָ֔ר\rb* \rb who were mighty men|חֲיָלִ֑ים\rb* \rb of valor|גִּבּוֹרֵ֖י\rb* \rb totaled|לַכֹּֽל׃פ\rb* \rb 87,000|שְׁמוֹנִ֤ים\rb*\rb |וְשִׁבְעָה֙\rb*\rb |אֶ֔לֶף\rb*, \rb as listed in their genealogies|הִתְיַחְשָׂ֖ם\rb*.
\s1 The Descendants of Benjamin
\p \v 6 \rb The three|שְׁלֹשָֽׁה׃\rb* \rb sons of Benjamin|בִּנְיָמִ֗ן\rb*:
\b 
\li1 \rb Bela|בֶּ֧לַע\rb*, \rb Becher|וָבֶ֛כֶר\rb*, \rb and Jediael|וִידִֽיעֲאֵ֖ל\rb*.
\b 
\li1 \v 7 \rb The sons|וּבְנֵ֣י\rb* \rb of Bela|בֶ֗לַע\rb*:
\li2 \rb Ezbon|אֶצְבּ֡וֹן\rb*, \rb Uzzi|וְעֻזִּ֡י\rb*, \rb Uzziel|וְ֠עֻזִּיאֵל\rb*, \rb Jerimoth|וִירִימ֨וֹת\rb*, \rb and Iri|וְעִירִ֜י\rb*, \rb heads|רָאשֵׁי֙\rb* \rb of their families|אָב֔וֹת\rb*\rb |בֵּ֣ית\rb*— \rb five in all|חֲמִשָּׁ֗ה\rb*. \rb There were 22,034|עֶשְׂרִ֤ים\rb*\rb |וּשְׁנַ֙יִם֙\rb*\rb |אֶ֔לֶף\rb*\rb |וּשְׁלֹשִׁ֖ים\rb*\rb |וְאַרְבָּעָֽה׃ס\rb* \rb mighty men|גִּבּוֹרֵ֖י\rb* \rb of valor|חֲיָלִ֑ים\rb* \rb listed in their genealogies|וְהִתְיַחְשָׂ֗ם\rb*.
\b 
\li1 \v 8 \rb The sons|וּבְנֵ֣י\rb* \rb of Becher|בֶ֗כֶר\rb*:
\li2 \rb Zemirah|זְמִירָ֡ה\rb*, \rb Joash|וְיוֹעָ֡שׁ\rb*, \rb Eliezer|וֶ֠אֱלִיעֶזֶר\rb*, \rb Elioenai|וְאֶלְיוֹעֵינַ֤י\rb*, \rb Omri|וְעָמְרִי֙\rb*, \rb Jeremoth|וִירֵמ֣וֹת\rb*, \rb Abijah|וַאֲבִיָּ֔ה\rb*, \rb Anathoth|וַעֲנָת֖וֹת\rb*, \rb and Alemeth|וְעָלָ֑מֶת\rb*; \rb all|כָּל־\rb* \rb these|אֵ֖לֶּה\rb* \rb were Becher’s|בָֽכֶר׃\rb* \rb sons|בְּנֵי־\rb*. \v 9 \rb Their genealogies|לְתֹלְדוֹתָ֗ם\rb* \rb were recorded|וְהִתְיַחְשָׂ֣ם\rb* \rb according to the heads|רָאשֵׁי֙\rb* \rb of their families|אֲבוֹתָ֔ם\rb*\rb |בֵּ֣ית\rb*— \rb 20,200|עֶשְׂרִ֥ים\rb*\rb |אֶ֖לֶף\rb*\rb |וּמָאתָֽיִם׃ס\rb* \rb mighty men|גִּבּוֹרֵ֖י\rb* \rb of valor|חָ֑יִל\rb*.
\b 
\li1 \v 10 \rb The son|וּבְנֵ֥י\rb* \rb of Jediael|יְדִיעֲאֵ֖ל\rb*:
\li2 \rb Bilhan|בִּלְהָ֑ן\rb*.
\b 
\li1 \rb The sons|וּבְנֵ֣י\rb* \rb of Bilhan|בִלְהָ֗ן\rb*:
\li2 \rb Jeush|יְעִישׁ\rb*, \rb Benjamin|וּ֠בִנְיָמִן\rb*, \rb Ehud|וְאֵה֤וּד\rb*, \rb Chenaanah|וּֽכְנַעֲנָה֙\rb*, \rb Zethan|וְזֵיתָ֔ן\rb*, \rb Tarshish|וְתַרְשִׁ֖ישׁ\rb*, \rb and Ahishahar|וַאֲחִישָֽׁחַר׃\rb*. \v 11 \rb All|כָּל־\rb* \rb these|אֵ֜לֶּה\rb* \rb sons|בְּנֵ֤י\rb* \rb of Jediael|יְדִֽיעֲאֵל֙\rb* \rb were heads|לְרָאשֵׁ֣י\rb* \rb of their families|הָאָב֔וֹת\rb*, \rb mighty men|גִּבּוֹרֵ֖י\rb* \rb of valor|חֲיָלִ֑ים\rb*; \rb there were 17,200|שִׁבְעָֽה־\rb*\rb |עָשָׂ֥ר\rb*\rb |אֶ֙לֶף֙\rb*\rb |וּמָאתַ֔יִם\rb* \rb fit|יֹצְאֵ֥י\rb* \rb for battle|צָבָ֖א\rb*\rb |לַמִּלְחָמָֽה׃\rb*. \v 12 \rb The Shuppites|וְשֻׁפִּ֤ם\rb* \rb and Huppites|וְחֻפִּם֙\rb* \rb were descendants|בְּנֵ֣י\rb* \rb of Ir|עִ֔יר\rb*, \rb and the Hushites|חֻשִׁ֖ם\rb* \rb were descendants|בְּנֵ֥י\rb* \rb of Aher|אַחֵֽר׃\rb*.
\s1 The Descendants of Naphtali
\p \v 13 \rb The sons|בְּנֵ֣י\rb* \rb of Naphtali|נַפְתָּלִ֗י\rb*:
\b 
\li1 \rb Jahziel|יַחֲצִיאֵ֧ל\rb*,\f + \fr 7:13 \fqa Jahziel \ft is a variant of \fqa Jahzeel\ft ; see \ref Genesis 46:24|GEN 46:24\ref*.\f* \rb Guni|וְגוּנִ֛י\rb*, \rb Jezer|וְיֵ֥צֶר\rb*, \rb and Shallum|וְשַׁלּ֖וּם\rb*\f + \fr 7:13 \ft Most Hebrew manuscripts; some Hebrew and LXX manuscripts \fqa Shillem\ft ; see \ref Genesis 46:24|GEN 46:24\ref* and Numbers 26:49.\f*— \rb the descendants|בְּנֵ֥י\rb* \rb of Bilhah|בִלְהָֽה׃פ\rb*.
\s1 The Descendants of Manasseh
\p \v 14 \rb The descendants|בְּנֵ֣י\rb* \rb of Manasseh|מְנַשֶּׁ֔ה\rb*: \rb Asriel|אַשְׂרִיאֵ֖ל\rb*
\b 
\li1 \rb through his Aramean|הָֽאֲרַמִּיָּ֔ה\rb*\rb |יָלְדָ֕ה\rb*\rb |אֶת־\rb* \rb concubine|פִּֽילַגְשׁוֹ֙\rb*. \rb She also|אֲשֶׁ֣ר\rb* \rb gave birth|יָלָ֑דָה\rb* \rb to Machir|מָכִ֖יר\rb* \rb the father|אֲבִ֥י\rb* \rb of Gilead|גִלְעָֽד׃\rb*.
\b 
\li1 \v 15 \rb Machir|וּמָכִ֞יר\rb* \rb took|לָקַ֤ח\rb* \rb a wife|אִשָּׁה֙\rb* \rb from among the Huppites|לְחֻפִּ֣ים\rb* \rb and Shuppites|וּלְשֻׁפִּ֔ים\rb*. \rb The name|וְשֵׁ֤ם\rb* \rb of his sister|אֲחֹתוֹ֙\rb* \rb was Maacah|מַעֲכָ֔ה\rb*.
\b 
\li1 \rb Another|הַשֵּׁנִ֖י\rb* \rb descendant was named|וְשֵׁ֥ם\rb* \rb Zelophehad|צְלָפְחָ֑ד\rb*, \rb who had|וַתִּהְיֶ֥נָה\rb*\rb |לִצְלָפְחָ֖ד\rb* \rb only daughters|בָּנֽוֹת׃\rb*.
\b 
\li1 \v 16 \rb Machir’s|מָכִיר֙\rb* \rb wife|אֵֽשֶׁת־\rb* \rb Maacah|מַעֲכָ֤ה\rb* \rb gave birth to|וַתֵּ֨לֶד\rb* \rb a son|בֵּ֔ן\rb*, \rb and she named him|וַתִּקְרָ֤א\rb*\rb |שְׁמוֹ֙\rb* \rb Peresh|פֶּ֔רֶשׁ\rb*. \rb His brother|אָחִ֖יו\rb* \rb was named|וְשֵׁ֥ם\rb* \rb Sheresh|שָׁ֑רֶשׁ\rb*, \rb and his sons|וּבָנָ֖יו\rb* \rb were Ulam|אוּלָ֥ם\rb* \rb and Rekem|וָרָֽקֶם׃\rb*.
\b 
\li1 \v 17 \rb The son|וּבְנֵ֥י\rb* \rb of Ulam|אוּלָ֖ם\rb*:
\li2 \rb Bedan|בְּדָ֑ן\rb*.
\b 
\li1 \rb These|אֵ֚לֶּה\rb* \rb were the sons|בְּנֵ֣י\rb* \rb of Gilead|גִלְעָ֔ד\rb* \rb son|בֶּן־\rb* \rb of Machir|מָכִ֖יר\rb*, \rb the son|בֶּן־\rb* \rb of Manasseh|מְנַשֶּֽׁה׃\rb*. \v 18 \rb His sister|וַאֲחֹת֖וֹ\rb* \rb Hammolecheth|הַמֹּלֶ֑כֶת\rb* \rb gave birth to|יָלְדָה֙\rb*\rb |אֶת־\rb* \rb Ishhod|אִישְׁה֔וֹד\rb*,\rb |וְאֶת־\rb* \rb Abiezer|אֲבִיעֶ֖זֶר\rb*,\rb |וְאֶת־\rb* \rb and Mahlah|מַחְלָֽה׃\rb*.
\b 
\li1 \v 19 \rb And these were|וַיִּהְי֖וּ\rb* \rb the sons|בְּנֵ֣י\rb* \rb of Shemida|שְׁמִידָ֑ע\rb*:
\li2 \rb Ahian|אַחְיָ֣ן\rb*, \rb Shechem|וָשֶׁ֔כֶם\rb*, \rb Likhi|וְלִקְחִ֖י\rb*, \rb and Aniam|וַאֲנִיעָֽם׃פ\rb*.
\s1 The Descendants of Ephraim
\p \v 20 \rb The descendants|וּבְנֵ֥י\rb* \rb of Ephraim|אֶפְרַ֖יִם\rb*:
\b 
\li1 \rb Shuthelah|שׁוּתָ֑לַח\rb*, \rb Bered|וּבֶ֤רֶד\rb* \rb his son|בְּנוֹ֙\rb*, \rb Tahath|וְתַ֣חַת\rb* \rb his son|בְּנ֔וֹ\rb*, \rb Eleadah|וְאֶלְעָדָ֥ה\rb* \rb his son|בְנ֖וֹ\rb*, \rb Tahath|וְתַ֥חַת\rb* \rb his son|בְּנֽוֹ׃\rb*, \v 21 \rb Zabad|וְזָבָ֥ד\rb* \rb his son|בְּנ֛וֹ\rb*, \rb and Shuthelah|וְשׁוּתֶ֥לַח\rb* \rb his son|בְּנ֖וֹ\rb*.
\b 
\li1 \rb Ezer|וְעֵ֣זֶר\rb* \rb and Elead|וְאֶלְעָ֑ד\rb* \rb were killed|וַהֲרָג֗וּם\rb* \rb by the natives|אַנְשֵׁי־\rb*\rb |הַנּוֹלָדִ֣ים\rb*\rb |בָּאָ֔רֶץ\rb* \rb of Gath|גַת֙\rb*, \rb because|כִּ֣י\rb* \rb they went down|יָרְד֔וּ\rb* \rb to steal|לָקַ֖חַת\rb* \rb their livestock|מִקְנֵיהֶֽם׃\rb*.
\b 
\li1 \v 22 \rb Their father|אֲבִיהֶ֖ם\rb* \rb Ephraim|אֶפְרַ֥יִם\rb* \rb mourned|וַיִּתְאַבֵּ֛ל\rb* \rb for many|רַבִּ֑ים\rb* \rb days|יָמִ֣ים\rb*, \rb and his relatives|אֶחָ֖יו\rb* \rb came|וַיָּבֹ֥אוּ\rb* \rb to comfort him|לְנַחֲמֽוֹ׃\rb*. \v 23 \rb And again he slept with|וַיָּבֹא֙\rb*\rb |אֶל־\rb* \rb his wife|אִשְׁתּ֔וֹ\rb*, \rb and she conceived|וַתַּ֖הַר\rb* \rb and gave birth to|וַתֵּ֣לֶד\rb* \rb a son|בֵּ֑ן\rb*. \rb So he named|וַיִּקְרָ֤א\rb*\rb |אֶת־\rb* \rb him|שְׁמוֹ֙\rb* \rb Beriah|בְּרִיעָ֔ה\rb*,\f + \fr 7:23 \fqa Beriah \ft sounds like the Hebrew for \fqa tragedy \ft or \fqa disaster\ft .\f* \rb because|כִּ֥י\rb* \rb tragedy|בְרָעָ֖ה\rb* \rb had come|הָיְתָ֥ה\rb* \rb upon his house|בְּבֵיתֽוֹ׃\rb*. \v 24 \rb His daughter|וּבִתּ֣וֹ\rb* \rb was Sheerah|שֶׁאֱרָ֔ה\rb*, \rb who built|וַתִּ֧בֶן\rb*\rb |אֶת־\rb* \rb Lower|הַתַּחְתּ֖וֹן\rb*\rb |וְאֶת־\rb* \rb and Upper|הָעֶלְי֑וֹן\rb*\rb |בֵּית־\rb* \rb Beth-horon|חוֹר֛וֹן\rb*, \rb as well as|וְאֵ֖ת\rb*\rb |אֻזֵּ֥ן\rb* \rb Uzzen-sheerah|שֶׁאֱרָֽה׃\rb*.
\b 
\li1 \v 25 \rb Additionally, Rephah|וְרֶ֣פַח\rb* \rb was his son|בְּנ֗וֹ\rb*, \rb Resheph his son|וְרֶ֧שֶׁף\rb*,\f + \fr 7:25 \ft Some LXX manuscripts; Hebrew does not include \fqa his son\ft .\f* \rb Telah|וְתֶ֛לַח\rb* \rb his son|בְּנ֖וֹ\rb*, \rb Tahan|וְתַ֥חַן\rb* \rb his son|בְּנֽוֹ׃\rb*, \v 26 \rb Ladan|לַעְדָּ֥ן\rb* \rb his son|בְּנ֛וֹ\rb*, \rb Ammihud|עַמִּיה֥וּד\rb* \rb his son|בְּנ֖וֹ\rb*, \rb Elishama|אֱלִישָׁמָ֥ע\rb* \rb his son|בְּנֽוֹ׃\rb*, \v 27 \rb Nun|נ֥וֹן\rb*\f + \fr 7:27 \ft Or \fqa Non\f* \rb his son|בְּנ֖וֹ\rb*, \rb and Joshua|יְהוֹשֻׁ֥עַ\rb* \rb his son|בְּנֽוֹ׃\rb*.
\b 
\li1 \v 28 \rb Their holdings|וַאֲחֻזָּתָם֙\rb* \rb and settlements|וּמֹ֣שְׁבוֹתָ֔ם\rb* \rb included|בֵּֽית־\rb* \rb Bethel|אֵ֖ל\rb* \rb and its villages|וּבְנֹתֶ֑יהָ\rb*, \rb Naaran|נַעֲרָ֔ן\rb* \rb to the east|וְלַמִּזְרָ֣ח\rb*, \rb Gezer|גֶּ֤זֶר\rb* \rb and its villages|וּבְנֹתֶ֙יהָ֙\rb* \rb to the west|וְלַֽמַּעֲרָ֗ב\rb*, \rb and Shechem|וּשְׁכֶ֣ם\rb* \rb and its villages|וּבְנֹתֶ֔יהָ\rb* \rb as far as|עַד־\rb* \rb Ayyah|עַיָּ֖ה\rb*\f + \fr 7:28 \fqa Ayyah \ft is another name for \fqa Gaza\ft ; see also LXX.\f* \rb and its villages|וּבְנֹתֶֽיהָ׃\rb*. \v 29 \rb And along|וְעַל־\rb* \rb the borders|יְדֵ֣י\rb*\rb |בְנֵי־\rb* \rb of Manasseh|מְנַשֶּׁ֗ה\rb*\rb |בֵּית־\rb* \rb were Beth-shean|שְׁאָ֤ן\rb*\rb |וּבְנֹתֶ֙יהָ֙\rb*,\f + \fr 7:29 \fqa Beth-shean \ft is a variant of \fqa Beth-shan\ft ; see \ref 1 Samuel 31:10|1SA 31:10\ref* and 2 Samuel 21:12.\f* \rb Taanach|תַּעְנַ֣ךְ\rb*\rb |וּבְנֹתֶ֔יהָ\rb*, \rb Megiddo|מְגִדּ֥וֹ\rb*\rb |וּבְנוֹתֶ֖יהָ\rb*, \rb and Dor|דּ֣וֹר\rb*, \rb together with their villages|וּבְנוֹתֶ֑יהָ\rb*. \rb The descendants|בְּנֵ֥י\rb* \rb of Joseph|יוֹסֵ֖ף\rb* \rb son|בֶּן־\rb* \rb of Israel|יִשְׂרָאֵֽל׃פ\rb* \rb lived|יָשְׁב֔וּ\rb* \rb in these towns|בְּאֵ֙לֶּה֙\rb*.
\s1 The Descendants of Asher
\p \v 30 \rb The children|בְּנֵ֣י\rb* \rb of Asher|אָשֵׁ֗ר\rb*:
\b 
\li1 \rb Imnah|יִמְנָ֧ה\rb*, \rb Ishvah|וְיִשְׁוָ֛ה\rb*, \rb Ishvi|וְיִשְׁוִ֥י\rb*, \rb Beriah|וּבְרִיעָ֖ה\rb*, \rb and their sister|אֲחוֹתָֽם׃\rb* \rb Serah|וְשֶׂ֥רַח\rb*.
\b 
\li1 \v 31 \rb The sons|וּבְנֵ֣י\rb* \rb of Beriah|בְרִיעָ֔ה\rb*:
\li2 \rb Heber|חֶ֖בֶר\rb*, \rb as well as Malchiel|וּמַלְכִּיאֵ֑ל\rb*, \rb who|ה֖וּא\rb* \rb was the father of|אֲבִ֥י\rb* \rb Birzaith|בִרְזוֹת׃\rb*.
\b 
\li1 \v 32 \rb Heber|וְחֶ֙בֶר֙\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Japhlet|יַפְלֵ֔ט\rb*,\rb |וְאֶת־\rb* \rb Shomer|שׁוֹמֵ֖ר\rb*,\rb |וְאֶת־\rb* \rb and Hotham|חוֹתָ֑ם\rb*, \rb and|וְאֵ֖ת\rb* \rb of their sister|אֲחוֹתָֽם׃\rb* \rb Shua|שׁוּעָ֥א\rb*.
\b 
\li1 \v 33 \rb The sons|וּבְנֵ֣י\rb* \rb of Japhlet|יַפְלֵ֔ט\rb*:
\li2 \rb Pasach|פָּסַ֥ךְ\rb*, \rb Bimhal|וּבִמְהָ֖ל\rb*, \rb and Ashvath|וְעַשְׁוָ֑ת\rb*. \rb These|אֵ֖לֶּה\rb* \rb were Japhlet’s|יַפְלֵֽט׃\rb* \rb sons|בְּנֵ֥י\rb*.
\b 
\li1 \v 34 \rb The sons|וּבְנֵ֖י\rb* \rb of Shemer|שָׁ֑מֶר\rb*:
\li2 \rb Ahi|אֲחִ֥י\rb*, \rb Rohgah|וְרוֹהֲגָה\rb*,\f + \fr 7:34 \ft Or \fqa The sons of his brother Shemer: Rohgah\ft ; note that \fqa Shemer \ft is a variant of \fqa Shomer\ft ; see verse 32.\f* \rb Hubbah|יַחְבָּה\rb*, \rb and Aram|וַאֲרָֽם׃\rb*.
\b 
\li1 \v 35 \rb The sons|וּבֶן־\rb* \rb of his brother|אָחִ֑יו\rb* \rb Helem|הֵ֖לֶם\rb*:\f + \fr 7:35 \fqa Helem \ft is possibly another name for \fqa Hotham\ft ; see verse 32.\f*
\li2 \rb Zophah|צוֹפַ֥ח\rb*, \rb Imna|וְיִמְנָ֖ע\rb*, \rb Shelesh|וְשֵׁ֥לֶשׁ\rb*, \rb and Amal|וְעָמָֽל׃\rb*.
\b 
\li1 \v 36 \rb The sons|בְּנֵ֖י\rb* \rb of Zophah|צוֹפָ֑ח\rb*:
\li2 \rb Suah|ס֧וּחַ\rb*, \rb Harnepher|וְחַרְנֶ֛פֶר\rb*, \rb Shual|וְשׁוּעָ֖ל\rb*, \rb Beri|וּבֵרִ֥י\rb*, \rb Imrah|וְיִמְרָֽה׃\rb*, \v 37 \rb Bezer|בֶּ֣צֶר\rb*, \rb Hod|וָה֗וֹד\rb*, \rb Shamma|וְשַׁמָּ֧א\rb*, \rb Shilshah|וְשִׁלְשָׁ֛ה\rb*, \rb Ithran|וְיִתְרָ֖ן\rb*,\f + \fr 7:37 \fqa Ithran \ft is possibly a variant of \fqa Jether\ft ; see verse 38.\f* \rb and Beera|וּבְאֵרָֽא׃\rb*.
\b 
\li1 \v 38 \rb The sons|וּבְנֵ֖י\rb* \rb of Jether|יֶ֑תֶר\rb*:
\li2 \rb Jephunneh|יְפֻנֶּ֥ה\rb*, \rb Pispa|וּפִסְפָּ֖ה\rb*, \rb and Ara|וַאְרָֽא׃\rb*.
\b 
\li1 \v 39 \rb The sons|וּבְנֵ֖י\rb* \rb of Ulla|עֻלָּ֑א\rb*:
\li2 \rb Arah|אָרַ֥ח\rb*, \rb Hanniel|וְחַנִּיאֵ֖ל\rb*, \rb and Rizia|וְרִצְיָֽא׃\rb*.
\b 
\li1 \v 40 \rb All|כָּל־\rb* \rb these|אֵ֣לֶּה\rb* \rb were the descendants|בְנֵי־\rb* \rb of Asher|אָ֠שֵׁר\rb* — \rb heads|רָאשֵׁ֨י\rb* \rb of their families|הָאָב֤וֹת\rb*\rb |בֵית־\rb*, \rb choice|בְּרוּרִים֙\rb* \rb and mighty men|גִּבּוֹרֵ֣י\rb* \rb of valor|חֲיָלִ֔ים\rb*, \rb and chiefs|רָאשֵׁ֖י\rb* \rb among the leaders|הַנְּשִׂיאִ֑ים\rb*. \rb The number|מִסְפָּרָ֣ם\rb* \rb of men|אֲנָשִׁ֔ים\rb* \rb fit for battle|בַּמִּלְחָמָ֔ה\rb*\rb |בַּצָּבָא֙\rb*, \rb recorded in their genealogies|וְהִתְיַחְשָׂ֤ם\rb*, \rb was 26,000|עֶשְׂרִ֥ים\rb*\rb |וְשִׁשָּׁ֖ה\rb*\rb |אָֽלֶף׃ס\rb*.
\c 8
\s1 Genealogy from Benjamin to Saul
\p \v 1 \rb Benjamin|וּבִ֨נְיָמִ֔ן\rb* \rb was the father of|הוֹלִ֖יד\rb*\rb |אֶת־\rb* \rb Bela|בֶּ֣לַע\rb* \rb his firstborn|בְּכֹר֑וֹ\rb*, \rb Ashbel|אַשְׁבֵּל֙\rb* \rb the second|הַשֵּׁנִ֔י\rb*, \rb Aharah|וְאַחְרַ֖ח\rb* \rb the third|הַשְּׁלִישִֽׁי׃\rb*, \v 2 \rb Nohah|נוֹחָה֙\rb* \rb the fourth|הָֽרְבִיעִ֔י\rb*, \rb and Rapha|וְרָפָ֖א\rb* \rb the fifth|הַחֲמִישִֽׁי׃ס\rb*.
\b 
\li1 \v 3 \rb |וַיִּהְי֥וּ\rb* \rb The sons|בָנִ֖ים\rb* \rb of Bela|לְבָ֑לַע\rb*:
\li2 \rb Addar|אַדָּ֥ר\rb*, \rb Gera|וְגֵרָ֖א\rb*, \rb Abihud|וַאֲבִיהֽוּד׃\rb*,\f + \fr 8:3 \ft Possibly \fqa Gera the father of Ehud\ft ; see verse 7.\f* \v 4 \rb Abishua|וַאֲבִישׁ֥וּעַ\rb*, \rb Naaman|וְנַעֲמָ֖ן\rb*, \rb Ahoah|וַאֲחֽוֹחַ׃\rb*, \v 5 \rb Gera|וְגֵרָ֥א\rb*, \rb Shephuphan|וּשְׁפוּפָ֖ן\rb*, \rb and Huram|וְחוּרָֽם׃\rb*.
\b 
\li1 \v 6 \rb These were|וְאֵ֖לֶּה\rb* \rb the descendants|בְּנֵ֣י\rb* \rb of Ehud|אֵח֑וּד\rb*\rb |אֵ֣לֶּה\rb* \rb who|הֵ֞ם\rb* \rb were the heads|רָאשֵׁ֤י\rb* \rb of the families|אָבוֹת֙\rb* \rb living|לְי֣וֹשְׁבֵי\rb* \rb in Geba|גֶ֔בַע\rb* \rb and were exiled|וַיַּגְל֖וּם\rb* \rb to|אֶל־\rb* \rb Manahath|מָנָֽחַת׃\rb*:
\li2 \v 7 \rb Naaman|וְנַעֲמָ֧ן\rb*, \rb Ahijah|וַאֲחִיָּ֛ה\rb*, \rb and Gera|וְגֵרָ֖א\rb*, \rb who|ה֣וּא\rb* \rb carried them into exile|הֶגְלָ֑ם\rb* \rb and who was the father|וְהוֹלִ֥יד\rb*\rb |אֶת־\rb* \rb of Uzza|עֻזָּ֖א\rb*\rb |וְאֶת־\rb* \rb and Ahihud|אֲחִיחֻֽד׃\rb*.\f + \fr 8:7 \ft Or \fqa and Gera, that is Heglam, who was the father of Uzza and Ahihud.\f*
\b 
\li1 \v 8 \rb Shaharaim|וְשַׁחֲרַ֗יִם\rb* \rb had sons|הוֹלִיד֙\rb* \rb in the country|בִּשְׂדֵ֣ה\rb* \rb of Moab|מוֹאָ֔ב\rb* \rb after|מִן־\rb* \rb he had divorced|שִׁלְח֖וֹ\rb*\rb |אֹתָ֑ם\rb* \rb his wives|נָשָֽׁיו׃\rb* \rb Hushim|חוּשִׁ֥ים\rb*\rb |וְאֶֽת־\rb* \rb and Baara|בַּעֲרָ֖א\rb*. \v 9 \rb |וַיּ֖וֹלֶד\rb* \rb His sons by|מִן־\rb* \rb his wife|אִשְׁתּ֑וֹ\rb*\rb |אֶת־\rb* \rb Hodesh|חֹ֣דֶשׁ\rb*:
\li2 \rb Jobab|יוֹבָב֙\rb*,\rb |וְאֶת־\rb* \rb Zibia|צִבְיָ֔א\rb*,\rb |וְאֶת־\rb* \rb Mesha|מֵישָׁ֖א\rb*,\rb |וְאֶת־\rb* \rb Malcam|מַלְכָּֽם׃\rb*, \v 10 \rb |וְאֶת־\rb* \rb Jeuz|יְע֥וּץ\rb*,\rb |וְאֶת־\rb* \rb Sachia|שָֽׂכְיָ֖ה\rb*,\rb |וְאֶת־\rb* \rb and Mirmah|מִרְמָ֑ה\rb*. \rb These|אֵ֥לֶּה\rb* \rb were his sons|בָנָ֖יו\rb*, \rb heads|רָאשֵׁ֥י\rb* \rb of families|אָבֽוֹת׃\rb*.
\b 
\li1 \v 11 \rb He also had sons|הוֹלִ֥יד\rb*\rb |אֶת־\rb* \rb by Hushim|וּמֵחֻשִׁ֛ים\rb*:
\li2 \rb Abitub|אֲבִיט֖וּב\rb*\rb |וְאֶת־\rb* \rb and Elpaal|אֶלְפָּֽעַל׃\rb*.
\b 
\li1 \v 12 \rb The sons|וּבְנֵ֣י\rb* \rb of Elpaal|אֶלְפַּ֔עַל\rb*:
\li2 \rb Eber|עֵ֥בֶר\rb*, \rb Misham|וּמִשְׁעָ֖ם\rb*, \rb Shemed|וָשָׁ֑מֶד\rb* (\rb who|ה֚וּא\rb* \rb built|בָּנָ֣ה\rb*\rb |אֶת־\rb* \rb Ono|אוֹנ֔וֹ\rb*\rb |וְאֶת־\rb* \rb and Lod|לֹ֖ד\rb* \rb with its villages|וּבְנֹתֶֽיהָ׃\rb*), \v 13 \rb and Beriah|וּבְרִעָ֣ה\rb* \rb and Shema|וָשֶׁ֔מַע\rb* (\rb who|הֵ֚מָּה\rb* \rb were the heads|רָאשֵׁ֣י\rb* \rb of families|הָאָב֔וֹת\rb* \rb living in|לְיוֹשְׁבֵ֖י\rb* \rb Aijalon|אַיָּל֑וֹן\rb* \rb and who|הֵ֥מָּה\rb* \rb drove out|הִבְרִ֖יחוּ\rb*\rb |אֶת־\rb* \rb the inhabitants|י֥וֹשְׁבֵי\rb* \rb of Gath|גַֽת׃\rb*).
\b 
\li1 \v 14 \rb Ahio|וְאַחְי֥וֹ\rb*, \rb Shashak|שָׁשָׁ֖ק\rb*, \rb Jeremoth|וִירֵמֽוֹת׃\rb*, \v 15 \rb Zebadiah|וּזְבַדְיָ֥ה\rb*, \rb Arad|וַעֲרָ֖ד\rb*, \rb Eder|וָעָֽדֶר׃\rb*, \v 16 \rb Michael|וּמִיכָאֵ֧ל\rb*, \rb Ishpah|וְיִשְׁפָּ֛ה\rb*, \rb and Joha|וְיוֹחָ֖א\rb* \rb were the sons|בְּנֵ֥י\rb* \rb of Beriah|בְרִיעָֽה׃\rb*.
\b 
\li1 \v 17 \rb Zebadiah|וּזְבַדְיָ֥ה\rb*, \rb Meshullam|וּמְשֻׁלָּ֖ם\rb*, \rb Hizki|וְחִזְקִ֥י\rb*, \rb Heber|וָחָֽבֶר׃\rb*, \v 18 \rb Ishmerai|וְיִשְׁמְרַ֧י\rb*, \rb Izliah|וְיִזְלִיאָ֛ה\rb*, \rb and Jobab|וְיוֹבָ֖ב\rb* \rb were the sons|בְּנֵ֥י\rb* \rb of Elpaal|אֶלְפָּֽעַל׃\rb*.
\b 
\li1 \v 19 \rb Jakim|וְיָקִ֥ים\rb*, \rb Zichri|וְזִכְרִ֖י\rb*, \rb Zabdi|וְזַבְדִּֽי׃\rb*, \v 20 \rb Elienai|וֶאֱלִיעֵנַ֥י\rb*, \rb Zillethai|וְצִלְּתַ֖י\rb*, \rb Eliel|וֶאֱלִיאֵֽל׃\rb*, \v 21 \rb Adaiah|וַעֲדָיָ֧ה\rb*, \rb Beraiah|וּבְרָאיָ֛ה\rb*, \rb and Shimrath|וְשִׁמְרָ֖ת\rb* \rb were the sons|בְּנֵ֥י\rb* \rb of Shimei|שִׁמְעִֽי׃\rb*.
\b 
\li1 \v 22 \rb Ishpan|וְיִשְׁפָּ֥ן\rb*, \rb Eber|וָעֵ֖בֶר\rb*, \rb Eliel|וֶאֱלִיאֵֽל׃\rb*, \v 23 \rb Abdon|וְעַבְדּ֥וֹן\rb*, \rb Zichri|וְזִכְרִ֖י\rb*, \rb Hanan|וְחָנָֽן׃\rb*, \v 24 \rb Hananiah|וַחֲנַנְיָ֥ה\rb*, \rb Elam|וְעֵילָ֖ם\rb*, \rb Anthothijah|וְעַנְתֹתִיָּֽה׃\rb*, \v 25 \rb Iphdeiah|וְיִפְדְיָ֥ה\rb*, \rb and Penuel|וּפְנִיאֵל\rb* \rb were the sons|בְּנֵ֥י\rb* \rb of Shashak|שָׁשָֽׁק׃\rb*.
\b 
\li1 \v 26 \rb Shamsherai|וְשַׁמְשְׁרַ֥י\rb*, \rb Shehariah|וּשְׁחַרְיָ֖ה\rb*, \rb Athaliah|וַעֲתַלְיָֽה׃\rb*, \v 27 \rb Jaareshiah|וְיַעֲרֶשְׁיָ֧ה\rb*, \rb Elijah|וְאֵלִיָּ֛ה\rb*, \rb and Zichri|וְזִכְרִ֖י\rb* \rb were the sons|בְּנֵ֥י\rb* \rb of Jeroham|יְרֹחָֽם׃\rb*.
\b 
\li1 \v 28 \rb All these|אֵ֣לֶּה\rb* \rb were heads|רָאשֵׁ֥י\rb* \rb of families|אָב֛וֹת\rb*, \rb the chiefs|רָאשִׁ֑ים\rb*\rb |אֵ֖לֶּה\rb* \rb according to their genealogies|לְתֹלְדוֹתָ֖ם\rb*, \rb and they lived|יָשְׁב֥וּ\rb* \rb in Jerusalem|בִירוּשָׁלִָֽם׃ס\rb*.
\b 
\li1 \v 29 \rb Jeiel the father|אֲבִ֣י\rb* \rb of Gibeon|וּבְגִבְע֥וֹן\rb* \rb lived|יָשְׁב֖וּ\rb*\f + \fr 8:29 \ft Some LXX manuscripts (see also \ref 1 Chronicles 9:35|1CH 9:35\ref*); Hebrew \fqa The father of Gibeon lived\f* \rb in Gibeon|גִבְע֑וֹן\rb*. \rb His wife’s|אִשְׁתּ֖וֹ\rb* \rb name|וְשֵׁ֥ם\rb* \rb was Maacah|מַעֲכָֽה׃\rb*, \v 30 \rb and Abdon|עַבְדּ֑וֹן\rb* \rb was his firstborn|הַבְּכ֖וֹר\rb* \rb son|וּבְנ֥וֹ\rb*, \rb then Zur|וְצ֥וּר\rb*, \rb Kish|וְקִ֖ישׁ\rb*, \rb Baal|וּבַ֥עַל\rb*,\f + \fr 8:30 \ft Some LXX manuscripts include \fqa Ner\ft ; see \ref 1 Chronicles 9:36|1CH 9:36\ref*.\f* \rb Nadab|וְנָדָֽב׃\rb*, \v 31 \rb Gedor|וּגְד֥וֹר\rb*, \rb Ahio|וְאַחְי֖וֹ\rb*, \rb Zecher|וָזָֽכֶר׃\rb*,\f + \fr 8:31 \fqa Zecher \ft is likely a variant of \fqa Zechariah\ft ; see \ref 1 Chronicles 9:37|1CH 9:37\ref*.\f* \v 32 \rb and Mikloth|וּמִקְל֖וֹת\rb*, \rb who was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Shimeah|שִׁמְאָ֑ה\rb*.\f + \fr 8:32 \fqa Shimeah \ft is a variant of \fqa Shimeam\ft ; see \ref 1 Chronicles 9:38|1CH 9:38\ref*.\f* \rb They|הֵ֗מָּה\rb* \rb too|וְאַף־\rb* \rb lived|יָשְׁב֥וּ\rb* \rb alongside|נֶ֧גֶד\rb* \rb their relatives|אֲחֵיהֶ֛ם\rb* \rb in Jerusalem|בִירוּשָׁלִַ֖ם\rb*\rb |עִם־\rb*\rb |אֲחֵיהֶֽם׃ס\rb*.
\s1 The Family of Saul
\p \v 33 \rb Ner|וְנֵר֙\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Kish|קִ֔ישׁ\rb*, \rb Kish|וְקִ֖ישׁ\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Saul|שָׁא֑וּל\rb*, \rb and Saul|וְשָׁא֗וּל\rb* \rb was the father of|הוֹלִ֤יד\rb*\rb |אֶת־\rb* \rb Jonathan|יְהֽוֹנָתָן֙\rb*,\rb |וְאֶת־\rb*\rb |מַלְכִּי־\rb* \rb Malchishua|שׁ֔וּעַ\rb*,\rb |וְאֶת־\rb* \rb Abinadab|אֲבִֽינָדָ֖ב\rb*,\rb |וְאֶת־\rb* \rb and Esh-baal|אֶשְׁבָּֽעַל׃\rb*.\f + \fr 8:33 \fqa Esh-baal \ft is also called \fqa Ish-bosheth\ft ; see \ref 2 Samuel 2:8|2SA 2:8\ref*.\f*
\b 
\li1 \v 34 \rb The son|וּבֶן־\rb* \rb of Jonathan|יְהוֹנָתָ֖ן\rb*\rb |מְרִ֣יב\rb*:
\li2 \rb Merib-baal|בָּ֑עַל\rb*,\f + \fr 8:34 \fqa Merib-baal \ft is also called \fqa Mephibosheth\ft ; see \ref 2 Samuel 4:4|2SA 4:4\ref*.\f*\rb |וּמְרִ֥יב\rb* \rb and Merib-baal|בַּ֖עַל\rb* \rb was the father of|הוֹלִ֥יד\rb*\rb |אֶת־\rb* \rb Micah|מִיכָֽה׃ס\rb*.\f + \fr 8:34 \fqa Micah \ft is a variant of \fqa Mica\ft ; see \ref 2 Samuel 9:12|2SA 9:12\ref*.\f*
\b 
\li1 \v 35 \rb The sons|וּבְנֵ֖י\rb* \rb of Micah|מִיכָ֑ה\rb*:
\li2 \rb Pithon|פִּית֥וֹן\rb*, \rb Melech|וָמֶ֖לֶךְ\rb*, \rb Tarea|וְתַאְרֵ֥עַ\rb*,\f + \fr 8:35 \fqa Tarea \ft is a variant of \fqa Tahrea\ft ; see \ref 1 Chronicles 9:41|1CH 9:41\ref*.\f* \rb and Ahaz|וְאָחָֽז׃\rb*.
\b 
\li1 \v 36 \rb Ahaz|וְאָחָז֙\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Jehoaddah|יְהוֹעַדָּ֔ה\rb*, \rb Jehoaddah|וִיהֽוֹעַדָּ֗ה\rb*\f + \fr 8:36 \fqa Jehoaddah \ft is a variant of \fqa Jarah \ft or \fqa Jadah\ft ; see \ref 1 Chronicles 9:42|1CH 9:42\ref*.\f* \rb was the father of|הוֹלִ֛יד\rb*\rb |אֶת־\rb* \rb Alemeth|עָלֶ֥מֶת\rb*,\rb |וְאֶת־\rb* \rb Azmaveth|עַזְמָ֖וֶת\rb*,\rb |וְאֶת־\rb* \rb and Zimri|זִמְרִ֑י\rb*, \rb and Zimri|וְזִמְרִ֖י\rb* \rb was the father of|הוֹלִ֥יד\rb*\rb |אֶת־\rb* \rb Moza|מוֹצָֽא׃\rb*.
\b 
\li1 \v 37 \rb Moza|וּמוֹצָ֖א\rb* \rb was the father of|הוֹלִ֣יד\rb*\rb |אֶת־\rb* \rb Binea|בִּנְעָ֑א\rb*. \rb Raphah|רָפָ֥ה\rb*\f + \fr 8:37 \fqa Raphah \ft is a variant of \fqa Rephaiah\ft ; see \ref 1 Chronicles 9:43|1CH 9:43\ref*.\f* \rb was his son|בְנ֛וֹ\rb*, \rb Eleasah|אֶלְעָשָׂ֥ה\rb* \rb his son|בְנ֖וֹ\rb*, \rb and Azel|אָצֵ֥ל\rb* \rb his son|בְּנֽוֹ׃\rb*.
\b 
\li1 \v 38 \rb Azel|וּלְאָצֵל֮\rb* \rb had six|שִׁשָּׁ֣ה\rb* \rb sons|בָנִים֒\rb*, \rb and these|וְאֵ֣לֶּה\rb* \rb were their names|שְׁמוֹתָ֗ם\rb*:
\li2 \rb Azrikam|עַזְרִיקָ֥ם׀\rb*, \rb Bocheru|בֹּ֙כְרוּ֙\rb*, \rb Ishmael|וְיִשְׁמָעֵ֣אל\rb*, \rb Sheariah|וּשְׁעַרְיָ֔ה\rb*, \rb Obadiah|וְעֹבַדְיָ֖ה\rb*, \rb and Hanan|וְחָנָ֑ן\rb*. \rb All|כָּל־\rb* \rb these|אֵ֖לֶּה\rb* \rb were the sons|בְּנֵ֥י\rb* \rb of Azel|אָצַֽל׃\rb*.
\b 
\li1 \v 39 \rb The sons|וּבְנֵ֖י\rb* \rb of his brother|אָחִ֑יו\rb* \rb Eshek|עֵ֣שֶׁק\rb*:
\li2 \rb Ulam|אוּלָ֣ם\rb* \rb was his firstborn|בְּכֹר֔וֹ\rb*, \rb Jeush|יְעוּשׁ֙\rb* \rb second|הַשֵּׁנִ֔י\rb*, \rb and Eliphelet|וֶֽאֱלִיפֶ֖לֶט\rb* \rb third|הַשְּׁלִשִֽׁי׃\rb*. \v 40 \rb The sons|בְנֵי־\rb* \rb of Ulam|א֠וּלָם\rb* \rb were|וַֽיִּהְי֣וּ\rb* \rb mighty|גִּבֹּרֵי־\rb* \rb men|אֲנָשִׁ֨ים\rb* \rb of valor|חַ֜יִל\rb*, \rb archers|דֹּ֣רְכֵי\rb*\rb |קֶ֗שֶׁת\rb*, \rb and they had many|וּמַרְבִּ֤ים\rb* \rb sons|בָּנִים֙\rb* \rb and grandsons|וּבְנֵ֣י\rb*\rb |בָנִ֔ים\rb*— \rb 150 in all|מֵאָ֖ה\rb*\rb |וַחֲמִשִּׁ֑ים\rb*.
\p \rb All|כָּל־\rb* \rb these|אֵ֖לֶּה\rb* \rb were the descendants|מִבְּנֵ֥י\rb* \rb of Benjamin|בִנְיָמִֽן׃פ\rb*.
\c 9
\s1 The People of Jerusalem
\p \v 1 \rb So all|וְכָל־\rb* \rb Israel|יִשְׂרָאֵל֙\rb* \rb was recorded in the genealogies|הִתְיַחְשׂ֔וּ\rb*\rb |וְהִנָּ֣ם\rb* \rb written|כְּתוּבִ֔ים\rb* \rb in|עַל־\rb* \rb the Book|סֵ֖פֶר\rb* \rb of the Kings|מַלְכֵ֣י\rb* \rb of Israel|יִשְׂרָאֵ֑ל\rb*. \rb But Judah|וִיהוּדָ֛ה\rb* \rb was exiled|הָגְל֥וּ\rb* \rb to Babylon|לְבָבֶ֖ל\rb* \rb because of their unfaithfulness|בְּמַעֲלָֽם׃ס\rb*.
\p \v 2 \rb Now the first|הָרִ֣אשֹׁנִ֔ים\rb*\rb |אֲשֶׁ֥ר\rb* \rb to resettle|וְהַיּוֹשְׁבִים֙\rb* \rb their own property|בַּאֲחֻזָּתָ֖ם\rb* \rb in their cities|בְּעָרֵיהֶ֑ם\rb* \rb were Israelites|יִשְׂרָאֵל֙\rb*, \rb priests|הַכֹּ֣הֲנִ֔ים\rb*, \rb Levites|הַלְוִיִּ֖ם\rb*, \rb and temple servants|וְהַנְּתִינִֽים׃\rb*.\f + \fr 9:2 \ft Hebrew \fqa Nethinim\f*
\p \v 3 \rb Some of|מִן־\rb* \rb the descendants|בְּנֵ֥י\rb* \rb of Judah|יְהוּדָ֖ה\rb*,\rb |וּמִן־\rb*\rb |בְּנֵ֣י\rb* \rb Benjamin|בִנְיָמִ֑ן\rb*,\rb |וּמִן־\rb*\rb |בְּנֵ֥י\rb* \rb Ephraim|אֶפְרַ֖יִם\rb*, \rb and Manasseh|וּמְנַשֶּֽׁה׃\rb* \rb lived|יָשְׁב֔וּ\rb* \rb in Jerusalem|וּבִירוּשָׁלִַ֙ם֙\rb*:
\b 
\li1 \v 4 \rb Uthai|עוּתַ֨י\rb* \rb son|בֶּן־\rb* \rb of Ammihud|עַמִּיה֤וּד\rb*, \rb the son|בֶּן־\rb* \rb of Omri|עָמְרִי֙\rb*, \rb the son|בֶּן־\rb* \rb of Imri|אִמְרִ֣י\rb*, \rb the son|בֶן־\rb* \rb of Bani|בְּנֵי־\rb*, \rb a descendant|בֶּן־\rb* \rb of Perez|פֶ֖רֶץ\rb* \rb son of Judah|יְהוּדָֽה׃\rb*.
\b 
\li1 \v 5 \rb From|וּמִן־\rb* \rb the Shilonites|הַשִּׁ֣ילוֹנִ֔י\rb*:
\li2 \rb Asaiah|עֲשָׂיָ֥ה\rb* \rb the firstborn|הַבְּכ֖וֹר\rb* \rb and his sons|וּבָנָֽיו׃\rb*.
\b 
