\c 103
\s1 Bless the LORD, O My Soul
\d \v 1 \rb Of David.|לְדָוִ֨ד׀\rb*
\q1 \rb Bless|בָּרֲכִ֣י\rb* \rb the LORD,|יְהוָ֑ה\rb* \rb O my soul;|נַ֭פְשִׁי\rb*\rb |אֶת־\rb*
\q2 \rb all|וְכָל־\rb* \rb that is within me,|קְ֝רָבַ֗י\rb*\rb |אֶת־\rb* \rb bless His holy|קָדְשֽׁוֹ׃\rb* \rb name.|שֵׁ֥ם\rb*
\q1 \v 2 \rb Bless|בָּרֲכִ֣י\rb* \rb the LORD,|יְהוָ֑ה\rb* \rb O my soul,|נַ֭פְשִׁי\rb*\rb |אֶת־\rb*
