\q1 \v 3 \rb Let them praise|יְהַֽלְל֣וּ\rb* \rb His name|שְׁמ֣וֹ\rb* \rb with dancing,|בְמָח֑וֹל\rb*
\q2 \rb and make music|יְזַמְּרוּ־\rb* \rb to Him|לֽוֹ׃\rb* \rb with tambourine|בְּתֹ֥ף\rb* \rb and harp.|וְ֝כִנּ֗וֹר\rb*
\q1 \v 4 \rb For|כִּֽי־\rb* \rb the LORD|יְהוָ֣ה\rb* \rb takes pleasure|רוֹצֶ֣ה\rb* \rb in His people;|בְּעַמּ֑וֹ\rb*
\q2 \rb He adorns|יְפָאֵ֥ר\rb* \rb the afflicted|עֲ֝נָוִ֗ים\rb* \rb with salvation.|בִּישׁוּעָֽה׃\rb*
\q1 \v 5 \rb Let the saints|חֲסִידִ֣ים\rb* \rb exult|יַעְלְז֣וּ\rb* \rb in glory;|בְּכָב֑וֹד\rb*
\q2 \rb let them shout for joy|יְ֝רַנְּנ֗וּ\rb* \rb upon|עַל־\rb* \rb their beds.|מִשְׁכְּבוֹתָֽם׃\rb*
\b 
\q1 \v 6 \rb May the high praises|רוֹמְמ֣וֹת\rb* \rb of God|אֵ֭ל\rb* \rb be in their mouths,|בִּגְרוֹנָ֑ם\rb*
\q2 \rb and a double-edged|פִּֽיפִיּ֣וֹת\rb* \rb sword|וְחֶ֖רֶב\rb* \rb in their hands,|בְּיָדָֽם׃\rb*
\q1 \v 7 \rb to inflict|לַעֲשׂ֣וֹת\rb* \rb vengeance|נְ֭קָמָה\rb* \rb on the nations|בַּגּוֹיִ֑ם\rb*
\q2 \rb and punishment|תּֽ֝וֹכֵחֹ֗ת\rb* \rb on|בַּל־\rb* \rb the peoples,|אֻמִּֽים׃\rb*
\q1 \v 8 \rb to bind|לֶאְסֹ֣ר\rb* \rb their kings|מַלְכֵיהֶ֣ם\rb* \rb with chains|בְּזִקִּ֑ים\rb*
\q2 \rb and their nobles|וְ֝נִכְבְּדֵיהֶ֗ם\rb* \rb with shackles|בְּכַבְלֵ֥י\rb* \rb of iron,|בַרְזֶֽל׃\rb*
\q1 \v 9 \rb to execute|לַעֲשׂ֤וֹת\rb*\rb |בָּהֶ֨ם׀\rb* \rb the judgment|מִשְׁפָּ֬ט\rb* \rb written against them.|כָּת֗וּב\rb*
\q2 \rb This|ה֭וּא\rb* \rb honor|הָדָ֣ר\rb* \rb is for all|לְכָל־\rb* \rb His saints.|חֲסִידָ֗יו\rb*
\b 
\q1 \rb Hallelujah!|הַֽלְלוּ־\rb*\rb |יָֽהּ׃\rb*
\c 150
\s1 Let Everything That Has Breath Praise the LORD
\q1 \v 1 \rb Hallelujah!|הַ֥לְלוּ\rb*\f + \fr 150:1 \ft Or \fqa Hallelu YAH\ft , meaning \fqa Praise the LORD\ft ; also in verse 6\f*\rb |יָ֨הּ׀\rb*
\b 
\q1 \rb Praise|הַֽלְלוּ־\rb* \rb God|אֵ֥ל\rb* \rb in His sanctuary.|בְּקָדְשׁ֑וֹ\rb*
\q2 \rb Praise Him|הַֽ֝לְל֗וּהוּ\rb* \rb in His mighty|עֻזּֽוֹ׃\rb* \rb heavens.|בִּרְקִ֥יעַ\rb*\f + \fr 150:1 \ft Or \fqa in the expanse of His might \ft or \fqa in the firmament of His might\ft ; see also \ref Genesis 1:6–8|GEN 1:6-8\ref*.\f*
\q1 \v 2 \rb Praise Him|הַֽלְל֥וּהוּ\rb* \rb for His mighty acts;|בִגְבוּרֹתָ֑יו\rb*
\q2 \rb praise Him|הַֽ֝לְל֗וּהוּ\rb* \rb for His excellent|כְּרֹ֣ב\rb* \rb greatness.|גֻּדְלֽוֹ׃\rb*
\b 
\q1 \v 3 \rb Praise Him|הַֽ֭לְלוּהוּ\rb* \rb with the sound|בְּתֵ֣קַע\rb* \rb of the horn;|שׁוֹפָ֑ר\rb*
\q2 \rb praise Him|הַֽ֝לְל֗וּהוּ\rb* \rb with the harp|בְּנֵ֣בֶל\rb* \rb and lyre.|וְכִנּֽוֹר׃\rb*
\q1 \v 4 \rb Praise Him|הַֽ֭לְלוּהוּ\rb* \rb with tambourine|בְתֹ֣ף\rb* \rb and dancing;|וּמָח֑וֹל\rb*
\q2 \rb praise Him|הַֽ֝לְל֗וּהוּ\rb* \rb with strings|בְּמִנִּ֥ים\rb* \rb and flute.|וְעוּגָֽב׃\rb*
\q1 \v 5 \rb Praise Him|הַֽלְל֥וּהוּ\rb* \rb with clashing|שָׁ֑מַע\rb* \rb cymbals;|בְצִלְצְלֵי־\rb*
\q2 \rb praise Him|הַֽ֝לְל֗וּהוּ\rb* \rb with resounding|תְרוּעָֽה׃\rb* \rb cymbals.|בְּֽצִלְצְלֵ֥י\rb*
\b 
\q1 \v 6 \rb Let everything|כֹּ֣ל\rb* \rb that has breath|הַ֭נְּשָׁמָה\rb* \rb praise|תְּהַלֵּ֥ל\rb* \rb the LORD!|יָ֗הּ\rb*
\b 
\q1 \rb Hallelujah!|הַֽלְלוּ־\rb*\rb |יָֽהּ׃\rb*
