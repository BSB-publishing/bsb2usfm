\q2 \rb I flee to You|אֵלֶ֥יךָ\rb* \rb for refuge.|כִסִּֽתִי׃\rb*\f + \fr 143:9 \ft LXX and one Hebrew manuscript; most Hebrew manuscripts \fqa in You I take cover\f*
\q1 \v 10 \rb Teach me|לַמְּדֵ֤נִי׀\rb* \rb to do|לַֽעֲשׂ֣וֹת\rb* \rb Your will,|רְצוֹנֶךָ֮\rb*
\q2 \rb for|כִּֽי־\rb* \rb You|אַתָּ֪ה\rb* \rb are my God.|אֱל֫וֹהָ֥י\rb*
\q1 \rb May Your good|טוֹבָ֑ה\rb* \rb Spirit|רוּחֲךָ֥\rb* \rb lead me|תַּ֝נְחֵ֗נִי\rb*
\q2 \rb on level|מִישֽׁוֹר׃\rb* \rb ground.|בְּאֶ֣רֶץ\rb*
\b 
\q1 \v 11 \rb For the sake|לְמַֽעַן־\rb* \rb of Your name,|שִׁמְךָ֣\rb* \rb O LORD,|יְהוָ֣ה\rb*
\q2 \rb revive me.|תְּחַיֵּ֑נִי\rb*
\q1 \rb In Your righteousness,|בְּצִדְקָתְךָ֓׀\rb*
\q2 \rb bring|תוֹצִ֖יא\rb* \rb my soul|נַפְשִֽׁי׃\rb* \rb out of trouble.|מִצָּרָ֣ה\rb*
\q1 \v 12 \rb And in Your loving devotion,|וּֽבְחַסְדְּךָ֮\rb*
\q2 \rb cut off|תַּצְמִ֪ית\rb* \rb my enemies.|אֹ֫יְבָ֥י\rb*
\q1 \rb Destroy|וְֽ֭הַאֲבַדְתָּ\rb* \rb all|כָּל־\rb* \rb who afflict|צֹרֲרֵ֣י\rb* \rb me,|נַפְשִׁ֑י\rb*
\q2 \rb for|כִּ֝֗י\rb* \rb I|אֲנִ֣י\rb* \rb am Your servant.|עַבְדֶּֽךָ׃\rb*
\c 144
\s1 Blessed Be the LORD, My Rock
\d \v 1 \rb Of David.|לְדָוִ֨ד׀\rb*
\q1 \rb Blessed|בָּ֘ר֤וּךְ\rb* \rb be the LORD,|יְהוָ֨ה׀\rb* \rb my Rock,|צוּרִ֗י\rb*
\q2 \rb who trains|הַֽמְלַמֵּ֣ד\rb* \rb my hands|יָדַ֣י\rb* \rb for war,|לַקְרָ֑ב\rb*
\q2 \rb my fingers|אֶ֝צְבְּעוֹתַ֗י\rb* \rb for battle.|לַמִּלְחָמָֽה׃\rb*
\q1 \v 2 \rb He is my steadfast love|חַסְדִּ֥י\rb* \rb and my fortress,|וּמְצוּדָתִי֮\rb*
\q2 \rb my stronghold|מִשְׂגַּבִּ֪י\rb* \rb and my deliverer.|וּֽמְפַלְטִ֫י\rb*
\q1 \rb He is my shield,|מָ֭גִנִּי\rb* \rb in whom I take refuge,|חָסִ֑יתִי\rb*
\q2 \rb who subdues|הָרוֹדֵ֖ד\rb* \rb peoples|עַמִּ֣י\rb*\f + \fr 144:2 \ft Many Hebrew manuscripts, DSS, Syriac; most Hebrew manuscripts \fqa subdues my people\f* \rb under me.|תַחְתָּֽי׃\rb*
\b 
\q1 \v 3 \rb O LORD,|יְֽהוָ֗ה\rb* \rb what|מָה־\rb* \rb is man,|אָ֭דָם\rb* \rb that You regard him,|וַתֵּדָעֵ֑הוּ\rb*
\q2 \rb the son of man|בֶּן־\rb* \rb that|אֱ֝נ֗וֹשׁ\rb* \rb You think of him?|וַֽתְּחַשְּׁבֵֽהוּ׃\rb*
\q1 \v 4 \rb Man|אָ֭דָם\rb* \rb is like|דָּמָ֑ה\rb* \rb a breath;|לַהֶ֣בֶל\rb*
\q2 \rb his days|יָ֝מָ֗יו\rb* \rb are like a passing|עוֹבֵֽר׃\rb* \rb shadow.|כְּצֵ֣ל\rb*
\b 
\q1 \v 5 \rb Part|הַט־\rb* \rb Your heavens,|שָׁמֶ֣יךָ\rb* \rb O LORD,|יְ֭הוָה\rb* \rb and come down;|וְתֵרֵ֑ד\rb*
\q2 \rb touch|גַּ֖ע\rb* \rb the mountains,|בֶּהָרִ֣ים\rb* \rb that they may smoke.|וְֽיֶעֱשָֽׁנוּ׃\rb*
\q1 \v 6 \rb Flash forth|בְּר֣וֹק\rb* \rb Your lightning|בָּ֭רָק\rb* \rb and scatter them;|וּתְפִיצֵ֑ם\rb*
\q2 \rb shoot|שְׁלַ֥ח\rb* \rb Your arrows|חִ֝צֶּ֗יךָ\rb* \rb and rout them.|וּתְהֻמֵּֽם׃\rb*
\q1 \v 7 \rb Reach down|שְׁלַ֥ח\rb* \rb from on high;|מִמָּ֫ר֥וֹם\rb*
\q2 \rb set me free|פְּצֵ֣נִי\rb* \rb and rescue me|וְ֭הַצִּילֵנִי\rb*
\q1 \rb from the deep|רַבִּ֑ים\rb*\rb |מִ֝יַּ֗ד\rb* \rb waters,|מִמַּ֣יִם\rb*
\q2 \rb from the grasp|יָדֶ֗יךָ\rb*\rb |בְּנֵ֣י\rb* \rb of foreigners,|נֵכָֽר׃\rb*
\q1 \v 8 \rb whose|אֲשֶׁ֣ר\rb* \rb mouths|פִּ֭יהֶם\rb* \rb speak|דִּבֶּר־\rb* \rb falsehood,|שָׁ֑וְא\rb*
\q2 \rb whose right hands|וִֽ֝ימִינָ֗ם\rb*\rb |יְמִ֣ין\rb* \rb are deceitful.|שָֽׁקֶר׃\rb*
\b 
\q1 \v 9 \rb I will sing|שִׁ֣יר\rb* \rb to You|לָּ֑ךְ\rb* \rb a new|חָ֭דָשׁ\rb* \rb song,|אָשִׁ֣ירָה\rb* \rb O God;|אֱ‍ֽלֹהִ֗ים\rb*
\q2 \rb on a harp|בְּנֵ֥בֶל\rb* \rb of ten strings|עָ֝שׂ֗וֹר\rb* \rb I will make music|אֲזַמְּרָה־\rb* \rb to You—|לָּֽךְ׃\rb*
\q1 \v 10 \rb to Him who gives|הַנּוֹתֵ֥ן\rb* \rb victory|תְּשׁוּעָ֗ה\rb* \rb to kings,|לַמְּלָ֫כִ֥ים\rb*
\q2 \rb who frees|הַ֭פּוֹצֶה\rb*\rb |אֶת־\rb* \rb His servant|עַבְדּ֗וֹ\rb* \rb David|דָּוִ֥ד\rb* \rb from the deadly|רָעָֽה׃\rb* \rb sword.|מֵחֶ֥רֶב\rb*
\q1 \v 11 \rb Set me free|פְּצֵ֥נִי\rb* \rb and rescue me|וְהַצִּילֵנִי֮\rb*
\q2 \rb from the grasp|מִיַּ֪ד\rb* \rb of foreigners,|בְּֽנֵי־\rb*\rb |נֵ֫כָ֥ר\rb*
\q1 \rb whose|אֲשֶׁ֣ר\rb* \rb mouths|פִּ֭יהֶם\rb* \rb speak|דִּבֶּר־\rb* \rb falsehood,|שָׁ֑וְא\rb*
\q2 \rb whose right hands|וִֽ֝ימִינָ֗ם\rb*\rb |יְמִ֣ין\rb* \rb are deceitful.|שָֽׁקֶר׃\rb*
\b 
\q1 \v 12 \rb Then|אֲשֶׁ֤ר\rb* \rb our sons|בָּנֵ֨ינוּ׀\rb* \rb will be like plants|כִּנְטִעִים֮\rb*
\q2 \rb nurtured|מְגֻדָּלִ֪ים\rb* \rb in their youth,|בִּֽנְעוּרֵ֫יהֶ֥ם\rb*
\q1 \rb our daughters|בְּנוֹתֵ֥ינוּ\rb* \rb like corner pillars|כְזָוִיֹּ֑ת\rb*
\q2 \rb carved|מְ֝חֻטָּב֗וֹת\rb* \rb to adorn|תַּבְנִ֥ית\rb* \rb a palace.|הֵיכָֽל׃\rb*
\q1 \v 13 \rb Our storehouses|מְזָוֵ֣ינוּ\rb* \rb will be full,|מְלֵאִים֮\rb*
\q2 \rb supplying|מְפִיקִ֥ים\rb* \rb all manner of|מִזַּ֗ן\rb*\rb |אֶ֫ל־\rb* \rb produce;|זַ֥ן\rb*
\q1 \rb our flocks|צֹאונֵ֣נוּ\rb* \rb will bring forth thousands,|מַ֭אֲלִיפוֹת\rb*
\q2 \rb tens of thousands|מְרֻבָּב֗וֹת\rb* \rb in our fields.|בְּחוּצוֹתֵֽינוּ׃\rb*
\q1 \v 14 \rb Our oxen|אַלּוּפֵ֗ינוּ\rb* \rb will bear great loads.|מְֽסֻבָּ֫לִ֥ים\rb*\f + \fr 144:14 \ft Or \fqa Our chieftains will be firmly established\f*
\q2 \rb There will be no|אֵֽין־\rb* \rb breach in the walls,|פֶּ֭רֶץ\rb*
\q1 \rb no|וְאֵ֣ין\rb* \rb going into captivity,|יוֹצֵ֑את\rb*
\q2 \rb and no|וְאֵ֥ין\rb* \rb cry of lament|צְ֝וָחָ֗ה\rb* \rb in our streets.|בִּרְחֹבֹתֵֽינוּ׃\rb*
\b 
