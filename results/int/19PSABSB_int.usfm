\q2 \rb hurry|חֽוּשָׁ֫ה־\rb* \rb to me,|לִּ֥י\rb* \rb O God.|אֱלֹהִ֪ים\rb*
\q1 \rb You|אַ֑תָּה\rb* \rb are my help|עֶזְרִ֣י\rb* \rb and my deliverer;|וּמְפַלְטִ֣י\rb*
\q2 \rb O LORD,|יְ֝הוָ֗ה\rb* \rb do not|אַל־\rb* \rb delay.|תְּאַחַֽר׃\rb*
\c 71
\s1 Be My Rock of Refuge
\q1 \v 1 \rb In You,|בְּךָֽ־\rb* \rb O LORD,|יְהוָ֥ה\rb* \rb I have taken refuge;|חָסִ֑יתִי\rb*
