\q1 \v 5 \rb Be exalted,|ר֣וּמָה\rb* \rb O God,|אֱלֹהִ֑ים\rb* \rb above|עַל־\rb* \rb the heavens;|הַשָּׁמַ֣יִם\rb*
\q2 \rb may Your glory|כְּבוֹדֶֽךָ׃\rb* \rb cover|עַ֖ל\rb* \rb all|כָּל־\rb* \rb the earth.|הָאָ֣רֶץ\rb*
\b 
\q1 \v 6 \rb They spread|הֵכִ֣ינוּ\rb* \rb a net|רֶ֤שֶׁת׀\rb* \rb for my feet;|לִפְעָמַי֮\rb*
\q2 \rb my soul|נַ֫פְשִׁ֥י\rb* \rb was despondent.|כָּפַ֪ף\rb*
\q1 \rb They dug|כָּר֣וּ\rb* \rb a pit|שִׁיחָ֑ה\rb* \rb before me,|לְפָנַ֣י\rb*
\q2 \rb but they themselves have fallen|נָפְל֖וּ\rb* \rb into it!|בְתוֹכָ֣הּ\rb*
\qr \rb Selah|סֶֽלָה׃\rb*
\q1 \v 7 \rb My heart|לִבִּ֣י\rb* \rb is steadfast,|נָ֘כ֤וֹן\rb* \rb O God,|אֱ֭לֹהִים\rb* \rb my heart|לִבִּ֑י\rb* \rb is steadfast.|נָכ֣וֹן\rb*
\q2 \rb I will sing|אָ֝שִׁ֗ירָה\rb* \rb and make music.|וַאֲזַמֵּֽרָה׃\rb*
\q1 \v 8 \rb Awake,|ע֤וּרָה\rb* \rb my glory!|כְבוֹדִ֗י\rb*\f + \fr 57:8 \ft Or \fqa Awake, my soul!\f*
\q2 \rb Awake,|ע֭וּרָֽה\rb* \rb O harp|הַנֵּ֥בֶל\rb* \rb and lyre!|וְכִנּ֗וֹר\rb*
\q2 \rb I will awaken|אָעִ֥ירָה\rb* \rb the dawn.|שָּֽׁחַר׃\rb*
\b 
\q1 \v 9 \rb I will praise You,|אוֹדְךָ֖\rb* \rb O Lord,|אֲדֹנָ֑י\rb* \rb among the nations;|בָעַמִּ֥ים׀\rb*
\q2 \rb I will sing Your praises|אֲ֝זַמֶּרְךָ֗\rb*\rb |בַּל־\rb* \rb among the peoples.|אֻמִּֽים׃\rb*
\q1 \v 10 \rb For|כִּֽי־\rb* \rb Your loving devotion|חַסְדֶּ֑ךָ\rb* \rb reaches|גָדֹ֣ל\rb* \rb to|עַד־\rb* \rb the heavens,|שָׁמַ֣יִם\rb*
\q2 \rb and|וְֽעַד־\rb* \rb Your faithfulness|אֲמִתֶּֽךָ׃\rb* \rb to the clouds.|שְׁחָקִ֥ים\rb*
\q1 \v 11 \rb Be exalted,|ר֣וּמָה\rb* \rb O God,|אֱלֹהִ֑ים\rb* \rb above|עַל־\rb* \rb the heavens;|שָׁמַ֣יִם\rb*
