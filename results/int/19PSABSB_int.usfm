\q2 \rb those who boast|הַמִּֽתְהַלְלִ֥ים\rb* \rb in idols.|בָּאֱלִילִ֑ים\rb*
\q2 \rb Worship|הִשְׁתַּחֲווּ־\rb* \rb Him,|ל֝וֹ\rb* \rb all|כָּל־\rb* \rb you gods!|אֱלֹהִֽים׃\rb*
\q1 \v 8 \rb Zion|צִיּ֗וֹן\rb* \rb hears|שָׁמְעָ֬ה\rb* \rb and rejoices,|וַתִּשְׂמַ֨ח׀\rb*
\q2 \rb and the towns|בְּנ֣וֹת\rb* \rb of Judah|יְהוּדָ֑ה\rb* \rb exult|וַ֭תָּגֵלְנָה\rb*
\q2 \rb because of|לְמַ֖עַן\rb* \rb Your judgments,|מִשְׁפָּטֶ֣יךָ\rb* \rb O LORD.|יְהוָֽה׃\rb*
\q1 \v 9 \rb For|כִּֽי־\rb* \rb You,|אַתָּ֤ה\rb* \rb O LORD,|יְהוָ֗ה\rb* \rb are Most High|עֶלְי֥וֹן\rb* \rb over|עַל־\rb* \rb all|כָּל־\rb* \rb the earth;|הָאָ֑רֶץ\rb*
\q2 \rb You are exalted|נַ֝עֲלֵ֗יתָ\rb* \rb far|מְאֹ֥ד\rb* \rb above|עַל־\rb* \rb all|כָּל־\rb* \rb gods.|אֱלֹהִֽים׃\rb*
\b 
\q1 \v 10 \rb Hate|שִׂנְא֫וּ\rb* \rb evil,|רָ֥ע\rb* \rb O you who love|אֹהֲבֵ֥י\rb* \rb the LORD!|יְהוָ֗ה\rb*
\q2 \rb He preserves|שֹׁ֭מֵר\rb* \rb the souls|נַפְשׁ֣וֹת\rb* \rb of His saints;|חֲסִידָ֑יו\rb*
\q2 \rb He delivers them|יַצִּילֵֽם׃\rb* \rb from the hand|מִיַּ֥ד\rb* \rb of the wicked.|רְ֝שָׁעִ֗ים\rb*
\q1 \v 11 \rb Light|א֭וֹר\rb* \rb shines|זָרֻ֣עַ\rb*\f + \fr 97:11 \ft One Hebrew manuscript, LXX, Syriac, and Vulgate; most Hebrew manuscripts \fqa Light is sown\f* \rb on the righteous,|לַצַּדִּ֑יק\rb*
\q2 \rb gladness|שִׂמְחָֽה׃\rb* \rb on the upright|וּֽלְיִשְׁרֵי־\rb* \rb in heart.|לֵ֥ב\rb*
\q1 \v 12 \rb Rejoice|שִׂמְח֣וּ\rb* \rb in the LORD,|בַּֽיהוָ֑ה\rb* \rb you righteous ones,|צַ֭דִּיקִים\rb*
\q2 \rb and praise|וְ֝הוֹד֗וּ\rb* \rb His holy|קָדְשֽׁוֹ׃\rb* \rb name.|לְזֵ֣כֶר\rb*
\c 98
\s1 Sing to the LORD a New Song
\r \ref Psalm 149:1–9|PSA 149:1-9\ref*; \ref Isaiah 42:10–17|ISA 42:10-17\ref*)
\d \v 1 \rb A Psalm.|מִזְמ֡וֹר\rb*
\q1 \rb Sing|שִׁ֤ירוּ\rb* \rb to the LORD|לַֽיהוָ֨ה׀\rb* \rb a new|חָ֭דָשׁ\rb* \rb song,|שִׁ֣יר\rb*
\q2 \rb for|כִּֽי־\rb* \rb He has done|עָשָׂ֑ה\rb* \rb wonders;|נִפְלָא֣וֹת\rb*
\q1 \rb His right hand|יְ֝מִינ֗וֹ\rb* \rb and holy|קָדְשֽׁוֹ׃\rb* \rb arm|וּזְר֥וֹעַ\rb*
