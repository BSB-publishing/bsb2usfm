\li1 \rb of Shebaniah,|לִשְׁבַנְיָ֖ה\rb*\f + \fr 12:14 \fqa Shebaniah \ft is a variant of \fqa Shecaniah\ft ; see verse 3; see also Syriac and some Hebrew and LXX manuscripts.\f* \rb Joseph;|יוֹסֵֽף׃\rb*
\li1 \v 15 \rb of Harim,|לְחָרִ֣ם\rb* \rb Adna;|עַדְנָ֔א\rb*
\li1 \rb of Meraioth,|לִמְרָי֖וֹת\rb*\f + \fr 12:15 \fqa Meraioth \ft is a variant of \fqa Meremoth\ft ; see verse 3 and also some LXX manuscripts.\f* \rb Helkai;|חֶלְקָֽי׃\rb*
\li1 \v 16 \rb of Iddo,|לַעֲדָיָא\rb* \rb Zechariah;|זְכַרְיָ֖ה\rb*
\li1 \rb of Ginnethon,|לְגִנְּת֥וֹן\rb* \rb Meshullam;|מְשֻׁלָּֽם׃\rb*
\li1 \v 17 \rb of Abijah,|לַאֲבִיָּ֖ה\rb* \rb Zichri;|זִכְרִ֑י\rb*
\li1 \rb of Miniamin|לְמִ֨נְיָמִ֔ין\rb* \rb and of Moadiah,|לְמוֹעַדְיָ֖ה\rb*\f + \fr 12:17 \fqa Moadiah \ft is a variant of \fqa Maadiah\ft ; see verse 5.\f* \rb Piltai;|פִּלְטָֽי׃\rb*
\li1 \v 18 \rb of Bilgah,|לְבִלְגָּ֣ה\rb* \rb Shammua;|שַׁמּ֔וּעַ\rb*
\li1 \rb of Shemaiah,|לִֽשְׁמַעְיָ֖ה\rb* \rb Jonathan;|יְהוֹנָתָֽן׃\rb*
