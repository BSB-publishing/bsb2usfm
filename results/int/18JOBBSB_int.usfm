\q1 \v 10 \rb Their bulls|שׁוֹר֣וֹ\rb* \rb breed|עִ֭בַּר\rb* \rb without|וְלֹ֣א\rb* \rb fail|יַגְעִ֑ל\rb*;
\q2 \rb their cows|פָּ֝רָת֗וֹ\rb* \rb bear calves|תְּפַלֵּ֥ט\rb* \rb and do not|וְלֹ֣א\rb* \rb miscarry|תְשַׁכֵּֽל׃\rb*.
\q1 \v 11 \rb They send forth|יְשַׁלְּח֣וּ\rb* \rb their little ones|עֲוִילֵיהֶ֑ם\rb* \rb like a flock|כַ֭צֹּאן\rb*;
\q2 \rb their children|וְ֝יַלְדֵיהֶ֗ם\rb* \rb skip about|יְרַקֵּדֽוּן׃\rb*,
