\s1 Haman’s Plot against the Jews
\p \v 1 \w After|strong="H310"\w* \w these|strong="H428"\w* \w events|strong="H1697"\w*, \w King|strong="H4428"\w* \w Xerxes|strong="H325"\w* \w honored|strong="H1431"\w* \w Haman|strong="H2001"\w* \w son|strong="H1121"\w* \w of Hammedatha|strong="H4099"\w*, \w the Agagite|strong="H91"\w*, \w elevating him|strong="H5375"\w* \w to a position|strong="H3678"\w* \w above|strong="H5921"\w* \w all|strong="H3605"\w* \w the princes|strong="H8269"\w* \w who|strong="H834"\w* \w were with him|strong="H854"\w*. \v 2 \w All|strong="H3605"\w* \w the royal|strong="H4428"\w* \w servants|strong="H5650"\w* \w at the king’s|strong="H4428"\w* \w gate|strong="H8179"\w* \w bowed down|strong="H3766"\w* \w and paid homage|strong="H7812"\w* \w to Haman|strong="H2001"\w*, \w because|strong="H3588"\w* \w the king|strong="H4428"\w* \w had commanded|strong="H6680"\w* \w that this be done|strong="H3651"\w* for him. \w But Mordecai|strong="H4782"\w* \w would not|strong="H3808"\w* \w bow down|strong="H3766"\w* \w or pay homage|strong="H7812"\w*.
