\p \v 10 “\w Hurry|strong="H4116"\w*,” \w said|strong="H559"\w* \w the king|strong="H4428"\w* \w to Haman|strong="H2001"\w*, “\w and do|strong="H6213"\w* \w just as|strong="H834"\w* \w you proposed|strong="H1696"\w*. \w Take|strong="H3947"\w* \w the robe|strong="H3830"\w* \w and|strong="H853"\w* \w the horse|strong="H5483"\w* \w to Mordecai|strong="H4782"\w* \w the Jew|strong="H3064"\w*, \w who is sitting|strong="H3427"\w* \w at the king’s|strong="H4428"\w* \w gate|strong="H8179"\w*. \w Do not|strong="H408"\w* \w neglect|strong="H5307"\w* \w anything|strong="H1697"\w* \w that|strong="H834"\w* \w you have suggested|strong="H1696"\w*.”
\p \v 11 \w So Haman|strong="H2001"\w* \w took|strong="H3947"\w* \w the robe|strong="H3830"\w* \w and the horse|strong="H5483"\w*, \w arrayed|strong="H3847"\w* \w Mordecai|strong="H4782"\w*, \w and paraded him|strong="H7392"\w* \w through the city|strong="H5892"\w* \w square|strong="H7339"\w*, \w crying out|strong="H7121"\w* \w before him|strong="H6440"\w*, “\w This is what|strong="H3602"\w* \w is done|strong="H6213"\w* \w for the man|strong="H376"\w* \w whom|strong="H834"\w* \w the king|strong="H4428"\w* \w is delighted|strong="H2654"\w* \w to honor|strong="H3366"\w*!”
\p \v 12 \w Then Mordecai|strong="H4782"\w* \w returned|strong="H7725"\w* \w to|strong="H413"\w* \w the king’s|strong="H4428"\w* \w gate|strong="H8179"\w*. \w But Haman|strong="H2001"\w* \w rushed|strong="H1765"\w* \w home|strong="H1004"\w*, \w with his head|strong="H7218"\w* \w covered|strong="H2645"\w* \w in grief|strong="H57"\w*.
\p \v 13 \w Haman|strong="H2001"\w* \w told|strong="H5608"\w* \w his wife|strong="H802"\w* \w Zeresh|strong="H2238"\w* \w and all|strong="H3605"\w* \w his friends|strong="H157"\w* \w everything|strong="H3605"\w* \w that|strong="H834"\w* \w had happened|strong="H7136"\w*. \w His advisers|strong="H2450"\w* \w and his wife|strong="H802"\w* \w Zeresh|strong="H2238"\w* \w said|strong="H559"\w* to him, “\w Since|strong="H518"\w* \w Mordecai|strong="H4782"\w*, \w before|strong="H6440"\w* \w whom|strong="H834"\w* \w your downfall|strong="H5307"\w* \w has begun|strong="H2490"\w*, \w is Jewish|strong="H3064"\w*, \w you will not prevail|strong="H3201"\w* against him — \w for|strong="H3588"\w* \w surely you will fall|strong="H5307"\w* \w before him|strong="H6440"\w*.”
\p \v 14 \w While they were still|strong="H5750"\w* \w speaking|strong="H1696"\w* \w with Haman|strong="H5973"\w*, \w the king’s|strong="H4428"\w* \w eunuchs|strong="H5631"\w* \w arrived|strong="H5060"\w* \w and rushed|strong="H926"\w* \w him|strong="H2001"\w* \w to|strong="H413"\w* \w the banquet|strong="H4960"\w* \w that|strong="H834"\w* \w Esther|strong="H635"\w* \w had prepared|strong="H6213"\w*.
\c 7
\s1 Esther Pleads for Her People
\p \v 1 \w So the king|strong="H4428"\w* \w and Haman|strong="H2001"\w* \w went|strong="H935"\w* \w to dine|strong="H8354"\w* \w with|strong="H5973"\w* \w Esther|strong="H635"\w* \w the queen|strong="H4436"\w*, \v 2 \w and as they drank|strong="H4960"\w* \w their wine|strong="H3196"\w* \w on that second|strong="H8145"\w* \w day|strong="H3117"\w*, \w the king|strong="H4428"\w* \w asked|strong="H559"\w* \w once more|strong="H1571"\w*, “\w Queen|strong="H4436"\w* \w Esther|strong="H635"\w*, \w what is|strong="H4100"\w* \w your petition|strong="H7596"\w*? \w It will be given|strong="H5414"\w* to you. \w What is|strong="H4100"\w* \w your request|strong="H1246"\w*? \w Even up to|strong="H5704"\w* \w half|strong="H2677"\w* \w the kingdom|strong="H4438"\w*, \w it will be fulfilled|strong="H6213"\w*.”
\p \v 3 \w Queen|strong="H4436"\w* \w Esther|strong="H635"\w* \w replied|strong="H6030"\w*, “\w If|strong="H518"\w* \w I have found|strong="H4672"\w* \w favor|strong="H2580"\w* \w in your sight|strong="H5869"\w*, \w O king|strong="H4428"\w*, \w and if|strong="H518"\w* \w it pleases|strong="H2896"\w* \w the king|strong="H4428"\w*, \w grant|strong="H5414"\w* me \w my life|strong="H5315"\w* \w as my petition|strong="H7596"\w*, \w and the lives of my people|strong="H5971"\w* \w as my request|strong="H1246"\w*. \v 4 \w For|strong="H3588"\w* \w my people|strong="H5971"\w* \w and I|strong="H589"\w* \w have been sold out|strong="H4376"\w* \w to destruction|strong="H8045"\w*, \w death|strong="H2026"\w*, \w and annihilation|strong="H6"\w*. \w If|strong="H432"\w* \w we had merely been sold|strong="H4376"\w* \w as menservants|strong="H5650"\w* \w and maidservants|strong="H8198"\w*, \w I would have remained silent|strong="H2790"\w*, \w because|strong="H3588"\w* \w no|strong="H369"\w* \w such distress|strong="H6862"\w* \w would justify|strong="H7737"\w* \w burdening|strong="H5143"\w* \w the king|strong="H4428"\w*.”
\p \v 5 \w Then King|strong="H4428"\w* \w Xerxes|strong="H325"\w* \w spoke up|strong="H559"\w* \w and asked|strong="H559"\w* \w Queen|strong="H4436"\w* \w Esther|strong="H635"\w*, “\w Who|strong="H4310"\w* \w is this|strong="H2088"\w*, \w and where|strong="H335"\w* \w is the one|strong="H1931"\w* \w who|strong="H834"\w* \w would|strong="H4390"\w* \w devise|strong="H6213"\w*\f + \fr 7:5 \ft Hebrew \fqa whose heart has filled him to do\f* \w such a scheme?|strong="H3651"\w*”
\p \v 6 \w Esther|strong="H635"\w* \w replied|strong="H559"\w*, “\w The adversary|strong="H6862"\w* \w and enemy|strong="H341"\w* \w is this|strong="H2088"\w* \w wicked man|strong="H7451"\w* — \w Haman|strong="H2001"\w*!”
\p \w And Haman|strong="H2001"\w* \w stood in terror|strong="H1204"\w* \w before|strong="H6440"\w* \w the king|strong="H4428"\w* \w and queen|strong="H4436"\w*.
\s1 The Hanging of Haman
\p \v 7 \w In his fury|strong="H2534"\w*, \w the king|strong="H4428"\w* \w arose|strong="H6965"\w* \w from drinking|strong="H4960"\w* \w his wine|strong="H3196"\w* \w and went to|strong="H413"\w* \w the palace|strong="H1055"\w* \w garden|strong="H1594"\w*, \w while Haman|strong="H2001"\w* \w stayed behind|strong="H5975"\w* \w to beg|strong="H1245"\w* \w Queen|strong="H4436"\w* \w Esther|strong="H635"\w* \w for|strong="H5921"\w* \w his life|strong="H5315"\w*, \w for|strong="H3588"\w* \w he realized|strong="H7200"\w* \w that|strong="H3588"\w* \w the king|strong="H4428"\w* \w was planning|strong="H3615"\w* \w a terrible fate|strong="H7451"\w* \w for him|strong="H413"\w*.
\p \v 8 \w Just as the king|strong="H4428"\w* \w returned|strong="H7725"\w* \w from the palace|strong="H1055"\w* \w garden|strong="H1594"\w* \w to|strong="H413"\w* \w the banquet hall|strong="H1004"\w*, \w Haman|strong="H2001"\w* \w was falling|strong="H5307"\w* \w on|strong="H5921"\w* \w the couch|strong="H4296"\w* \w where|strong="H834"\w* \w Esther|strong="H635"\w* \w was reclining|strong="H5921"\w*. \w The king|strong="H4428"\w* \w exclaimed|strong="H559"\w*, “\w Would he actually|strong="H1571"\w* \w assault|strong="H3533"\w* \w the queen|strong="H4436"\w* \w while|strong="H5973"\w* \w I am in the palace|strong="H1004"\w*?”
\p \w As soon as the words|strong="H1697"\w* \w had left|strong="H3318"\w* \w the king’s|strong="H4428"\w* \w mouth|strong="H6310"\w*, \w they covered|strong="H2645"\w* \w Haman’s|strong="H2001"\w* \w face|strong="H6440"\w*.
\p \v 9 \w Then Harbonah|strong="H2726"\w*, \w one|strong="H259"\w* \w of|strong="H4480"\w* \w the eunuchs|strong="H5631"\w* \w attending|strong="H6440"\w* \w the king|strong="H4428"\w*, \w said|strong="H559"\w*: “\w There|strong="H2009"\w* \w is a gallows|strong="H6086"\w* \w fifty|strong="H2572"\w* \w cubits|strong="H520"\w* \w high|strong="H1364"\w*\f + \fr 7:9 \fqa 50 cubits \ft is approximately 75 feet or 22.9 meters high.\f* \w at Haman’s|strong="H2001"\w* \w house|strong="H1004"\w*. \w He|strong="H2001"\w* \w had it built|strong="H6213"\w* \w for Mordecai|strong="H4782"\w*, \w who|strong="H834"\w* \w gave the report|strong="H1696"\w* \w that saved|strong="H2896"\w* \w the king|strong="H4428"\w*.”
\p “\w Hang him|strong="H8518"\w* \w on it|strong="H5921"\w*!” \w declared|strong="H559"\w* \w the king|strong="H4428"\w*.
\p \v 10 \w So they hanged|strong="H8518"\w* \w Haman|strong="H2001"\w* \w on|strong="H5921"\w* \w the gallows|strong="H6086"\w* \w he had prepared|strong="H3559"\w* \w for Mordecai|strong="H4782"\w*. \w Then the fury|strong="H2534"\w* \w of the king|strong="H4428"\w* \w subsided|strong="H7918"\w*.
\c 8
\s1 Esther Appeals for the Jews
\p \v 1 \w That same|strong="H1931"\w* \w day|strong="H3117"\w* \w King|strong="H4428"\w* \w Xerxes|strong="H325"\w* \w awarded|strong="H5414"\w* \w Queen|strong="H4436"\w* \w Esther|strong="H635"\w* \w the estate|strong="H1004"\w* \w of Haman|strong="H2001"\w*, \w the enemy|strong="H6887"\w* \w of the Jews|strong="H3064"\w*. \w And Mordecai|strong="H4782"\w* \w entered|strong="H935"\w* \w the king’s|strong="H4428"\w* \w presence|strong="H6440"\w* \w because|strong="H3588"\w* \w Esther|strong="H635"\w* \w had revealed|strong="H5046"\w* \w his relation|strong="H1931"\w* to her. \v 2 \w The king|strong="H4428"\w* \w removed|strong="H5493"\w* \w the signet ring|strong="H2885"\w* \w he had recovered|strong="H5674"\w* \w from Haman|strong="H2001"\w* \w and presented it|strong="H5414"\w* \w to Mordecai|strong="H4782"\w*. \w And Esther|strong="H635"\w* \w appointed|strong="H7760"\w* \w Mordecai|strong="H4782"\w* \w over|strong="H5921"\w* \w the estate|strong="H1004"\w* \w of Haman|strong="H2001"\w*.
\p \v 3 \w And once again|strong="H3254"\w*, \w Esther|strong="H635"\w* \w addressed|strong="H1696"\w* \w the king|strong="H4428"\w*. \w She fell|strong="H5307"\w* \w at|strong="H6440"\w* \w his feet|strong="H7272"\w* \w weeping|strong="H1058"\w* \w and begged|strong="H2603"\w* him \w to revoke|strong="H5674"\w* \w the evil|strong="H7451"\w* \w scheme|strong="H4284"\w* \w of Haman|strong="H2001"\w* \w the Agagite|strong="H91"\w*, \w which|strong="H834"\w* \w he had devised|strong="H2803"\w* \w against|strong="H5921"\w* \w the Jews|strong="H3064"\w*.
\p \v 4 \w The king|strong="H4428"\w* \w extended|strong="H3447"\w* \w the gold|strong="H2091"\w* \w scepter|strong="H8275"\w* \w toward Esther|strong="H635"\w*, \w and she|strong="H635"\w* \w arose|strong="H6965"\w* \w and stood|strong="H5975"\w* \w before|strong="H6440"\w* \w the king|strong="H4428"\w*.
\p \v 5 “\w If|strong="H518"\w* \w it pleases|strong="H5921"\w* \w the king|strong="H4428"\w*,” \w she said|strong="H559"\w*, “\w and if I have found|strong="H4672"\w* \w favor|strong="H2580"\w* \w in his sight|strong="H6440"\w*, \w and the matter|strong="H1697"\w* \w seems proper|strong="H3787"\w* \w to|strong="H6440"\w* \w the king|strong="H4428"\w*, \w and I|strong="H589"\w* \w am pleasing|strong="H2896"\w* \w in his sight|strong="H5869"\w*, \w may an order be written|strong="H3789"\w* \w to revoke|strong="H7725"\w* \w the letters|strong="H5612"\w* \w that the scheming|strong="H4284"\w* \w Haman|strong="H2001"\w* \w son|strong="H1121"\w* \w of Hammedatha|strong="H4099"\w*, \w the Agagite|strong="H91"\w*, \w wrote|strong="H3789"\w* \w to destroy|strong="H6"\w* \w the Jews|strong="H3064"\w* \w in all|strong="H3605"\w* \w the king’s|strong="H4428"\w* \w provinces|strong="H4082"\w*. \v 6 \w For|strong="H3588"\w* \w how|strong="H349"\w* \w could I bear|strong="H3201"\w* \w to see|strong="H7200"\w* \w the disaster|strong="H7451"\w* \w that|strong="H834"\w* \w would befall|strong="H4672"\w* \w my people|strong="H5971"\w*? \w How|strong="H349"\w* \w could I bear|strong="H3201"\w* \w to see|strong="H7200"\w* \w the destruction|strong="H13"\w* \w of my kindred|strong="H4138"\w*?”
\s1 The Decree of Xerxes
\p \v 7 \w So King|strong="H4428"\w* \w Xerxes|strong="H325"\w* \w said|strong="H559"\w* \w to Esther|strong="H635"\w* \w the Queen|strong="H4436"\w* \w and Mordecai|strong="H4782"\w* \w the Jew|strong="H3064"\w*, “\w Behold|strong="H2009"\w*, \w I have given|strong="H5414"\w* \w Haman’s|strong="H2001"\w* \w estate|strong="H1004"\w* \w to Esther|strong="H635"\w*, \w and he was hanged|strong="H8518"\w* \w on|strong="H5921"\w* \w the gallows|strong="H6086"\w* \w because|strong="H5921"\w* \w he attacked|strong="H7971"\w* \w the Jews|strong="H3064"\w*. \v 8 \w Now you|strong="H859"\w* \w may write|strong="H3789"\w* \w in the king’s|strong="H4428"\w* \w name|strong="H8034"\w* \w as|strong="H2896"\w* \w you please|strong="H5869"\w* \w regarding|strong="H5921"\w* \w the Jews|strong="H3064"\w*, \w and seal it|strong="H2856"\w* \w with the royal|strong="H4428"\w* \w signet ring|strong="H2885"\w*. \w For a decree|strong="H3791"\w* \w that|strong="H834"\w* \w is written|strong="H3789"\w* \w in the name|strong="H8034"\w* \w of the king|strong="H4428"\w* \w and sealed|strong="H2856"\w* \w with the royal|strong="H4428"\w* \w signet ring|strong="H2885"\w* \w cannot|strong="H369"\w* \w be revoked|strong="H7725"\w*.”
\p \v 9 \w At once|strong="H6256"\w* \w the royal|strong="H4428"\w* \w scribes|strong="H5613"\w* \w were summoned|strong="H7121"\w*, \w and on the twenty-third day|strong="H7969"\w* \w of the third|strong="H7992"\w* \w month|strong="H2320"\w* (\w the month|strong="H2320"\w* \w of Sivan|strong="H5510"\w*\f + \fr 8:9 \fqa Sivan \ft is the third month of the Hebrew lunar calendar, usually occurring within the months of May and June.\f*), \w they recorded|strong="H3789"\w* \w all of|strong="H3605"\w* \w Mordecai’s|strong="H4782"\w* \w orders|strong="H6680"\w* \w to|strong="H413"\w* \w the Jews|strong="H3064"\w* \w and to|strong="H413"\w* \w the satraps|strong="H323"\w*, \w governors|strong="H6346"\w*, \w and princes|strong="H8269"\w* \w of the 127|strong="H7651"\w* \w provinces|strong="H4082"\w* \w from India|strong="H1912"\w* \w to|strong="H5704"\w* \w Cush|strong="H3568"\w*\f + \fr 8:9 \ft That is, to the upper Nile region\f* — \w writing to each province|strong="H4082"\w* \w in its own script|strong="H4082"\w*, \w to every people|strong="H5971"\w* \w in their own language|strong="H3956"\w*, \w and to|strong="H413"\w* \w the Jews|strong="H3064"\w* \w in their own script|strong="H3791"\w* \w and language|strong="H3956"\w*.
\p \v 10 \w Mordecai wrote|strong="H3789"\w* \w in the name|strong="H8034"\w* \w of King|strong="H4428"\w* \w Xerxes|strong="H325"\w* \w and sealed it|strong="H2856"\w* \w with the royal|strong="H4428"\w* \w signet ring|strong="H2885"\w*. \w He sent|strong="H7971"\w* \w the documents|strong="H5612"\w* \w by|strong="H3027"\w* \w mounted|strong="H5483"\w* \w couriers|strong="H7323"\w* \w riding on|strong="H7392"\w* \w swift horses|strong="H7409"\w* \w bred|strong="H1121"\w* \w from the royal|strong="H327"\w* \w mares|strong="H7424"\w*.
\p \v 11 \w By these letters|strong="H834"\w* \w the king|strong="H4428"\w* \w permitted|strong="H5414"\w* \w the Jews|strong="H3064"\w* \w in each|strong="H3605"\w* \w and every city|strong="H5892"\w* \w the right to assemble|strong="H6950"\w* \w and defend|strong="H5921"\w* \w themselves|strong="H5315"\w*, \w to destroy|strong="H8045"\w*, \w kill|strong="H2026"\w*, \w and annihilate|strong="H6"\w* \w all|strong="H3605"\w* \w the forces|strong="H2428"\w* \w of any people|strong="H5971"\w* \w or province|strong="H4082"\w* \w hostile to them|strong="H6696"\w*, \w including women|strong="H802"\w* \w and children|strong="H2945"\w*, \w and to plunder|strong="H7998"\w* \w their possessions|strong="H962"\w*. \v 12 \w The single|strong="H259"\w* \w day appointed|strong="H3117"\w* \w throughout all|strong="H3605"\w* \w the provinces|strong="H4082"\w* \w of King|strong="H4428"\w* \w Xerxes|strong="H325"\w* \w was the thirteenth|strong="H7969"\w* \w day of the twelfth|strong="H8147"\w* \w month|strong="H2320"\w*, \w the month|strong="H2320"\w* \w of Adar|strong="H143"\w*.\f + \fr 8:12 \fqa Adar \ft is the twelfth month of the Hebrew lunar calendar, usually occurring within the months of February and March.\f*
\p \v 13 \w A copy|strong="H6572"\w* \w of the text|strong="H3791"\w* \w of the edict|strong="H1881"\w* \w was to be issued|strong="H5414"\w* \w in every|strong="H3605"\w* \w province|strong="H4082"\w* \w and published|strong="H1540"\w* \w to all|strong="H3605"\w* \w the people|strong="H5971"\w*, \w so that the Jews|strong="H3064"\w* \w would be|strong="H1961"\w* \w ready|strong="H6259"\w* \w on that|strong="H2088"\w* \w day|strong="H3117"\w* \w to avenge themselves|strong="H5358"\w* \w on their enemies|strong="H341"\w*. \v 14 \w The couriers|strong="H7323"\w* \w rode|strong="H7392"\w* \w out|strong="H3318"\w* \w in haste|strong="H926"\w* \w on their royal|strong="H327"\w* \w horses|strong="H7409"\w*, \w pressed on|strong="H1765"\w* \w by the command|strong="H1697"\w* \w of the king|strong="H4428"\w*. \w And the edict|strong="H1881"\w* \w was also issued|strong="H5414"\w* \w in the citadel|strong="H1002"\w* \w of Susa|strong="H7800"\w*.
\p \v 15 \w Mordecai|strong="H4782"\w* \w went out|strong="H3318"\w* \w from the presence|strong="H6440"\w* \w of the king|strong="H4428"\w* \w in royal garments|strong="H3830"\w* \w of blue|strong="H8504"\w* \w and white|strong="H2353"\w*, \w with a large|strong="H1419"\w* \w gold|strong="H2091"\w* \w crown|strong="H5850"\w* \w and a purple|strong="H713"\w* \w robe|strong="H8509"\w* \w of fine linen|strong="H948"\w*. \w And the city|strong="H5892"\w* \w of Susa|strong="H7800"\w* \w shouted|strong="H6670"\w* \w and rejoiced|strong="H8055"\w*.
\p \v 16 \w For the Jews|strong="H3064"\w* \w it was a time of|strong="H1961"\w* \w light|strong="H219"\w* \w and gladness|strong="H8057"\w*, \w of joy|strong="H8342"\w* \w and honor|strong="H3366"\w*. \v 17 \w In every|strong="H3605"\w* \w province|strong="H4082"\w* \w and every|strong="H3605"\w* \w city|strong="H5892"\w*, \w wherever|strong="H4725"\w* \w the king’s|strong="H4428"\w* \w edict|strong="H1697"\w* \w and decree|strong="H1881"\w* \w reached|strong="H5060"\w*, \w there was joy|strong="H8057"\w* \w and gladness|strong="H8342"\w* \w among the Jews|strong="H3064"\w*, \w with feasting|strong="H4960"\w* \w and celebrating|strong="H3117"\w*. \w And many|strong="H7227"\w* \w of the people|strong="H5971"\w* \w of the land|strong="H776"\w* \w themselves became Jews|strong="H3054"\w*, \w because|strong="H3588"\w* \w the fear|strong="H6343"\w* \w of the Jews|strong="H3064"\w* \w had fallen|strong="H5307"\w* \w upon them|strong="H5921"\w*.
\c 9
\s1 The Jews Destroy Their Enemies
\p \v 1 \w On the thirteenth|strong="H7969"\w* \w day|strong="H3117"\w* \w of the twelfth|strong="H8147"\w* \w month|strong="H2320"\w*, \w the month|strong="H2320"\w* \w of Adar|strong="H143"\w*,\f + \fr 9:1 \fqa Adar \ft is the twelfth month of the Hebrew lunar calendar, usually occurring within the months of February and March; also in verses 15, 17, 19, and 21.\f* \w the king’s|strong="H4428"\w* \w command|strong="H1697"\w* \w and edict|strong="H1881"\w* \w were to be executed|strong="H6213"\w*. \w On this day|strong="H3117"\w* \w the enemies|strong="H341"\w* \w of the Jews|strong="H3064"\w* \w had hoped|strong="H7663"\w* \w to overpower|strong="H7980"\w* them, \w but their plan was overturned|strong="H2015"\w* \w and the Jews|strong="H3064"\w* \w overpowered|strong="H7980"\w* \w those|strong="H1992"\w* \w who hated them|strong="H8130"\w*. \v 2 \w In each|strong="H3605"\w* \w of the provinces|strong="H4082"\w* \w of King|strong="H4428"\w* \w Xerxes|strong="H325"\w*, \w the Jews|strong="H3064"\w* \w assembled|strong="H6950"\w* \w in their cities|strong="H5892"\w* \w to attack|strong="H7971"\w* \w those who sought|strong="H1245"\w* \w to harm them|strong="H7451"\w*. \w No|strong="H3808"\w* \w man|strong="H376"\w* \w could withstand|strong="H5975"\w* \w them|strong="H6440"\w*, \w because|strong="H3588"\w* \w the fear of them|strong="H6343"\w* \w had fallen|strong="H5307"\w* \w upon|strong="H5921"\w* \w all|strong="H3605"\w* \w peoples|strong="H5971"\w*.
\p \v 3 \w And all|strong="H3605"\w* \w the officials|strong="H8269"\w* \w of the provinces|strong="H4082"\w*, \w the satraps|strong="H323"\w*, \w the governors|strong="H6346"\w*, \w and the king’s|strong="H4428"\w* \w administrators|strong="H6213"\w* \w helped|strong="H5375"\w* \w the Jews|strong="H3064"\w*, \w because|strong="H3588"\w* \w the fear|strong="H6343"\w* \w of Mordecai|strong="H4782"\w* \w had fallen|strong="H5307"\w* \w upon them|strong="H5921"\w*. \v 4 \w For|strong="H3588"\w* \w Mordecai|strong="H4782"\w* \w exercised great|strong="H1419"\w* \w power in the palace|strong="H1004"\w*, \w and his fame|strong="H8089"\w* \w spread|strong="H1980"\w* \w throughout|strong="H3605"\w* \w the provinces|strong="H4082"\w* \w as|strong="H3588"\w* \w he|strong="H4782"\w* \w became|strong="H1980"\w* \w more and more powerful|strong="H1431"\w*.
\p \v 5 \w The Jews|strong="H3064"\w* \w put|strong="H5221"\w* \w all|strong="H3605"\w* \w their enemies|strong="H341"\w* \w to the sword|strong="H2719"\w*, \w killing|strong="H2027"\w* \w and destroying them|strong="H12"\w*, \w and they did|strong="H6213"\w* \w as they pleased|strong="H7522"\w* \w to those who hated them|strong="H8130"\w*. \v 6 \w In the citadel|strong="H1002"\w* \w of Susa|strong="H7800"\w*, \w the Jews|strong="H3064"\w* \w killed|strong="H2026"\w* \w and destroyed|strong="H6"\w* \w five|strong="H2568"\w* \w hundred|strong="H3967"\w* \w men|strong="H376"\w*, \v 7 \w including Parshandatha|strong="H6577"\w*, \w Dalphon|strong="H1813"\w*, \w Aspatha|strong="H630"\w*, \v 8 \w Poratha|strong="H6334"\w*, \w Adalia|strong="H118"\w*, \w Aridatha|strong="H743"\w*, \v 9 \w Parmashta|strong="H6534"\w*, \w Arisai|strong="H747"\w*, \w Aridai|strong="H742"\w*, \w and Vaizatha|strong="H2055"\w*. \v 10 \w They killed|strong="H2026"\w* \w these ten|strong="H6235"\w* \w sons|strong="H1121"\w* \w of Haman|strong="H2001"\w* \w son|strong="H1121"\w* \w of Hammedatha|strong="H4099"\w*, \w the enemy|strong="H6887"\w* \w of the Jews|strong="H3064"\w*, \w but they did not|strong="H3808"\w* \w lay|strong="H7971"\w* \w a hand|strong="H3027"\w* \w on the plunder|strong="H961"\w*.
\s1 Haman’s Sons Hanged
\p \v 11 \w On that|strong="H1931"\w* \w day|strong="H3117"\w* \w the number|strong="H4557"\w* \w of those killed|strong="H2026"\w* \w in the citadel|strong="H1002"\w* \w of Susa|strong="H7800"\w* \w was reported to|strong="H6440"\w* \w the king|strong="H4428"\w*, \v 12 \w who|strong="H4428"\w* \w said|strong="H559"\w* \w to Queen|strong="H4436"\w* \w Esther|strong="H635"\w*, “\w In the citadel|strong="H1002"\w* \w of Susa|strong="H7800"\w* \w the Jews|strong="H3064"\w* \w have killed|strong="H2026"\w* \w and destroyed|strong="H6"\w* \w five|strong="H2568"\w* \w hundred|strong="H3967"\w* \w men|strong="H376"\w*, \w including Haman’s|strong="H2001"\w* \w ten|strong="H6235"\w* \w sons|strong="H1121"\w*. \w What|strong="H4100"\w* \w have they done|strong="H6213"\w* \w in the rest|strong="H7605"\w* \w of the royal|strong="H4428"\w* \w provinces|strong="H4082"\w*? \w Now what is|strong="H4100"\w* \w your petition|strong="H7596"\w*? \w It will be given|strong="H5414"\w* to you. \w And what|strong="H4100"\w* \w further|strong="H5750"\w* \w do you request|strong="H1246"\w*? \w It will be fulfilled|strong="H6213"\w*.”
\p \v 13 \w Esther|strong="H635"\w* \w replied|strong="H559"\w*, “\w If|strong="H518"\w* \w it pleases|strong="H5921"\w* \w the king|strong="H4428"\w*, \w may the Jews|strong="H3064"\w* \w in Susa|strong="H7800"\w* \w also|strong="H1571"\w* \w have tomorrow|strong="H4279"\w* \w to carry out|strong="H6213"\w* \w today’s|strong="H3117"\w* \w edict|strong="H1881"\w*, \w and may the bodies of Haman’s|strong="H2001"\w* \w ten|strong="H6235"\w* \w sons|strong="H1121"\w* \w be hanged|strong="H8518"\w* \w on|strong="H5921"\w* \w the gallows|strong="H6086"\w*.”
\p \v 14 \w So the king|strong="H4428"\w* \w commanded|strong="H559"\w* \w that this|strong="H3651"\w* \w be done|strong="H6213"\w*. \w An edict|strong="H1881"\w* \w was issued|strong="H5414"\w* \w in Susa|strong="H7800"\w*, \w and they hanged|strong="H8518"\w* \w the ten|strong="H6235"\w* \w sons|strong="H1121"\w* \w of Haman|strong="H2001"\w*. \v 15 \w On the fourteenth|strong="H702"\w* \w day|strong="H3117"\w* \w of the month|strong="H2320"\w* \w of Adar|strong="H143"\w*, \w the Jews|strong="H3064"\w* \w in Susa|strong="H7800"\w* \w came together|strong="H6950"\w* \w again|strong="H1571"\w* \w and put to death|strong="H2026"\w* \w three|strong="H7969"\w* \w hundred|strong="H3967"\w* \w men|strong="H376"\w* \w there|strong="H7800"\w*, \w but they did not|strong="H3808"\w* \w lay|strong="H7971"\w* \w a hand|strong="H3027"\w* \w on the plunder|strong="H961"\w*.
\p \v 16 \w The rest|strong="H7605"\w* \w of the Jews|strong="H3064"\w* \w in the royal|strong="H4428"\w* \w provinces|strong="H4082"\w* \w also assembled|strong="H6950"\w* \w to defend|strong="H5975"\w* \w themselves|strong="H5315"\w* \w and rid themselves|strong="H5118"\w* \w of their enemies|strong="H341"\w*. \w They killed|strong="H2026"\w* \w 75,000|strong="H2568"\w* \w who hated them|strong="H8130"\w*, \w but they did not|strong="H3808"\w* \w lay|strong="H7971"\w* \w a hand|strong="H3027"\w* \w on the plunder|strong="H961"\w*. \v 17 \w This was done on the thirteenth|strong="H7969"\w* \w day|strong="H3117"\w* \w of the month|strong="H2320"\w* \w of Adar|strong="H143"\w*, \w and on the fourteenth day|strong="H702"\w* \w they rested|strong="H5117"\w*, \w making it|strong="H6213"\w* \w a day|strong="H3117"\w* \w of feasting|strong="H4960"\w* \w and joy|strong="H8057"\w*.
\s1 The Feast of Purim Instituted
\p \v 18 \w The Jews|strong="H3064"\w* \w in Susa, however|strong="H7800"\w*, \w had assembled|strong="H6950"\w* \w on the thirteenth|strong="H7969"\w* \w and the fourteenth|strong="H702"\w* \w days of the month|strong="H6240"\w*. \w So they rested|strong="H5117"\w* \w on the fifteenth|strong="H2568"\w* \w day|strong="H6240"\w*, \w making|strong="H6213"\w* \w it|strong="H853"\w* \w a day|strong="H3117"\w* \w of feasting|strong="H4960"\w* \w and joy|strong="H8057"\w*. \v 19 \w This is why|strong="H5921"\w* \w the rural|strong="H6521"\w* \w Jews|strong="H3064"\w*, \w who live|strong="H3427"\w* \w in the villages|strong="H5892"\w*, \w observe|strong="H6213"\w* \w the fourteenth day|strong="H702"\w* \w of the month|strong="H2320"\w* \w of Adar|strong="H143"\w* \w as a day|strong="H3117"\w* \w of joy|strong="H8057"\w* \w and feasting|strong="H4960"\w*. \w It is a holiday|strong="H3117"\w* \w for sending|strong="H4916"\w* \w gifts|strong="H4490"\w* \w to one|strong="H376"\w* \w another|strong="H7453"\w*.
\p \v 20 \w Mordecai|strong="H4782"\w* \w recorded|strong="H3789"\w* \w these|strong="H428"\w* \w events|strong="H1697"\w* \w and sent|strong="H7971"\w* \w letters|strong="H5612"\w* \w to|strong="H413"\w* \w all|strong="H3605"\w* \w the Jews|strong="H3064"\w* \w in all|strong="H3605"\w* \w the provinces|strong="H4082"\w* \w of King|strong="H4428"\w* \w Xerxes|strong="H325"\w*, \w both near|strong="H7138"\w* \w and far|strong="H7350"\w*, \v 21 \w to establish|strong="H6965"\w* \w among them|strong="H5921"\w* \w an annual|strong="H3605"\w* \w celebration|strong="H6213"\w* \w on the fourteenth|strong="H702"\w* \w and fifteenth|strong="H2568"\w* \w days|strong="H3117"\w* \w of the month|strong="H2320"\w* \w of Adar|strong="H143"\w* \v 22 \w as the days|strong="H3117"\w* \w on which|strong="H834"\w* \w the Jews|strong="H3064"\w* \w gained rest|strong="H5117"\w* \w from their enemies|strong="H341"\w* \w and the month|strong="H2320"\w* \w in which|strong="H834"\w* \w their sorrow|strong="H3015"\w* \w turned|strong="H2015"\w* \w to joy|strong="H8057"\w* \w and their mourning|strong="H60"\w* \w into a holiday|strong="H3117"\w*. \w He wrote that these were to be|strong="H6213"\w* \w days|strong="H3117"\w* \w of feasting|strong="H4960"\w* \w and joy|strong="H8057"\w*, \w of sending|strong="H4916"\w* \w gifts|strong="H4490"\w* \w to one|strong="H376"\w* \w another|strong="H7453"\w* \w and|strong="H4979"\w* \w to the poor|strong="H34"\w*.
\p \v 23 \w So the Jews|strong="H3064"\w* \w agreed to continue|strong="H6901"\w* \w the custom|strong="H6213"\w* \w they had started|strong="H2490"\w*, \w as|strong="H834"\w* \w Mordecai|strong="H4782"\w* \w had written|strong="H3789"\w* \w to them|strong="H413"\w*. \v 24 \w For|strong="H3588"\w* \w Haman|strong="H2001"\w* \w son|strong="H1121"\w* \w of Hammedatha|strong="H4099"\w*, \w the Agagite|strong="H91"\w*, \w the enemy|strong="H6887"\w* \w of all|strong="H3605"\w* \w the Jews|strong="H3064"\w*, \w had plotted|strong="H2803"\w* \w against|strong="H5921"\w* \w the Jews|strong="H3064"\w* \w to destroy them|strong="H6"\w* \w and had cast|strong="H5307"\w* \w the Pur|strong="H6332"\w* \w (that is|strong="H1931"\w*, \w the lot|strong="H1486"\w*) \w to crush|strong="H2000"\w* \w and destroy them|strong="H6"\w*. \v 25 \w But when it came|strong="H935"\w* \w before|strong="H6440"\w* \w the king|strong="H4428"\w*, \w he commanded|strong="H559"\w* \w by|strong="H5973"\w* \w letter|strong="H5612"\w* \w that the wicked|strong="H7451"\w* \w scheme|strong="H4284"\w* \w which|strong="H834"\w* \w Haman had devised|strong="H2803"\w* \w against|strong="H5921"\w* \w the Jews|strong="H3064"\w* \w should come back|strong="H7725"\w* \w upon|strong="H5921"\w* \w his own head|strong="H7218"\w*, \w and that he|strong="H853"\w* \w and|strong="H853"\w* \w his sons|strong="H1121"\w* \w should be hanged|strong="H8518"\w* \w on|strong="H5921"\w* \w the gallows|strong="H6086"\w*.
\p \v 26 \w Therefore|strong="H5921"\w* \w these|strong="H428"\w* \w days|strong="H3117"\w* \w are called|strong="H7121"\w* \w Purim|strong="H6332"\w*, \w from|strong="H5921"\w* \w the word|strong="H8034"\w* \w Pur|strong="H6332"\w*.
\p \w Because of|strong="H5921"\w* \w all|strong="H3605"\w* \w the instructions|strong="H1697"\w* \w in this|strong="H2063"\w* \w letter|strong="H107"\w*, \w and because of all|strong="H4100"\w* \w they had seen|strong="H7200"\w* \w and experienced|strong="H4100"\w*, \v 27 \w the Jews|strong="H3064"\w* \w bound themselves|strong="H6901"\w* \w to establish the custom|strong="H6965"\w* \w that they|strong="H5921"\w* \w and their descendants|strong="H2233"\w* \w and all|strong="H3605"\w* \w who join|strong="H3867"\w* \w them|strong="H5921"\w* \w should not|strong="H3808"\w* \w fail|strong="H5674"\w* \w to celebrate|strong="H6213"\w* \w these|strong="H428"\w* \w two|strong="H8147"\w* \w days|strong="H3117"\w* \w at the appointed time|strong="H2165"\w* \w each|strong="H3605"\w* \w and every year|strong="H8141"\w*, \w according to their regulation|strong="H3791"\w*. \v 28 \w These|strong="H428"\w* \w days|strong="H3117"\w* \w should be remembered|strong="H2142"\w* \w and celebrated|strong="H6213"\w* \w by every|strong="H3605"\w* \w generation|strong="H1755"\w*, \w family|strong="H4940"\w*, \w province|strong="H4082"\w*, \w and city|strong="H5892"\w*, \w so that these|strong="H428"\w* \w days|strong="H3117"\w* \w of Purim|strong="H6332"\w* \w should not|strong="H3808"\w* \w fail to be observed|strong="H5674"\w* \w among|strong="H8432"\w* \w the Jews|strong="H3064"\w*, \w nor should the memory of them|strong="H2143"\w* \w fade|strong="H5486"\w* \w from their descendants|strong="H2233"\w*.
\p \v 29 \w So Queen|strong="H4436"\w* \w Esther|strong="H635"\w* \w daughter|strong="H1323"\w* \w of Abihail|strong="H32"\w*, \w along with Mordecai|strong="H4782"\w* \w the Jew|strong="H3064"\w*, \w wrote|strong="H3789"\w* \w with full|strong="H3605"\w* \w authority|strong="H8633"\w* \w to confirm|strong="H6965"\w* \w this|strong="H2063"\w* \w second|strong="H8145"\w* \w letter|strong="H107"\w* \w concerning Purim|strong="H6332"\w*. \v 30 \w And Mordecai sent|strong="H7971"\w* \w letters|strong="H5612"\w* \w with words|strong="H1697"\w* \w of peace|strong="H7965"\w* \w and truth|strong="H571"\w* \w to|strong="H413"\w* \w all|strong="H3605"\w* \w the Jews|strong="H3064"\w* \w in|strong="H413"\w* \w the 127|strong="H7651"\w* \w provinces|strong="H4082"\w* \w of the kingdom|strong="H4438"\w* \w of Xerxes|strong="H325"\w*, \v 31 \w in order to confirm|strong="H6965"\w* \w these|strong="H428"\w* \w days|strong="H3117"\w* \w of Purim|strong="H6332"\w* \w at their appointed time|strong="H2165"\w*, \w just as|strong="H834"\w* \w Mordecai|strong="H4782"\w* \w the Jew|strong="H3064"\w* \w and Queen|strong="H4436"\w* \w Esther|strong="H635"\w* \w had established them|strong="H6965"\w* \w and|strong="H834"\w* \w had committed|strong="H6965"\w* \w themselves|strong="H5315"\w* \w and their descendants|strong="H2233"\w* \w to the times|strong="H1697"\w* \w of fasting|strong="H6685"\w* \w and lamentation|strong="H2201"\w*.
\p \v 32 \w So Esther’s|strong="H635"\w* \w decree|strong="H3982"\w* \w confirmed|strong="H6965"\w* \w these|strong="H428"\w* \w regulations|strong="H1697"\w* \w about Purim|strong="H6332"\w*, \w which were written|strong="H3789"\w* \w into the record|strong="H5612"\w*.
\c 10
\s1 Tribute to Xerxes and Mordecai
\p \v 1 \w Now King|strong="H4428"\w* \w Xerxes|strong="H325"\w* \w imposed|strong="H7760"\w* \w tribute|strong="H4522"\w* \w throughout|strong="H5921"\w* \w the land|strong="H776"\w*, \w even to its farthest shores|strong="H339"\w*.
\p \v 2 \w And all|strong="H3605"\w* \w of Mordecai’s|strong="H4782"\w* \w powerful|strong="H8633"\w* \w and magnificent|strong="H1369"\w* \w accomplishments|strong="H4639"\w*, \w together with the full account|strong="H6575"\w* \w of the greatness|strong="H1420"\w* \w to which|strong="H834"\w* \w the king|strong="H4428"\w* \w had raised him|strong="H1431"\w*, \w are they|strong="H1992"\w* \w not|strong="H3808"\w* \w written|strong="H3789"\w* \w in|strong="H5921"\w* \w the Book|strong="H5612"\w* \w of the Chronicles|strong="H1697"\w* \w of the Kings|strong="H4428"\w* \w of Media|strong="H4074"\w* \w and Persia|strong="H6539"\w*? \v 3 \w For|strong="H3588"\w* \w Mordecai|strong="H4782"\w* \w the Jew|strong="H3064"\w* \w was second|strong="H4932"\w* \w only to King|strong="H4428"\w* \w Xerxes|strong="H325"\w*, \w preeminent|strong="H1419"\w* \w among the Jews|strong="H3064"\w* \w and highly favored|strong="H7521"\w* \w by his many|strong="H7230"\w* \w kinsmen|strong="H251"\w*, \w seeking|strong="H1875"\w* \w the good|strong="H2896"\w* \w of his people|strong="H5971"\w* \w and speaking|strong="H1696"\w* \w peace|strong="H7965"\w* \w to all|strong="H3605"\w* \w his countrymen|strong="H2233"\w*.
