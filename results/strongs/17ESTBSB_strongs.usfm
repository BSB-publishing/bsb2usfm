\p \v 13 \w And the letters|strong="H5612"\w* \w were sent|strong="H7971"\w* \w by|strong="H3027"\w* \w couriers|strong="H7323"\w* \w to|strong="H413"\w* \w each|strong="H3605"\w* \w of the royal|strong="H4428"\w* \w provinces|strong="H4082"\w* \w with the order to destroy|strong="H8045"\w*, \w kill|strong="H2026"\w*, \w and annihilate|strong="H6"\w* \w all|strong="H3605"\w* \w the Jews|strong="H3064"\w*— \w young|strong="H5288"\w* \w and|strong="H5704"\w* \w old|strong="H2205"\w*, \w women|strong="H802"\w* \w and children|strong="H2945"\w*— \w and to plunder|strong="H962"\w* \w their possessions|strong="H7998"\w* \w on a single|strong="H259"\w* \w day|strong="H3117"\w*, \w the thirteenth|strong="H7969"\w* \w day of Adar|strong="H143"\w*, \w the twelfth|strong="H8147"\w* \w month|strong="H2320"\w*.
