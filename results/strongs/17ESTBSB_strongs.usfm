\p \v 1 \w That|strong="H1931"\w* \w night|strong="H3915"\w* \w sleep|strong="H8142"\w* \w escaped|strong="H5074"\w* \w the king|strong="H4428"\w*; \w so he ordered|strong="H559"\w* \w the Book|strong="H5612"\w* \w of Records|strong="H2146"\w*, \w the Chronicles|strong="H1697"\w*,\f + \fr 6:1 \ft Or \fqa the Book of Memorials, the Annals \ft or \fqa the Book of Records of Historical Events\f* \w to be|strong="H1961"\w* \w brought in|strong="H935"\w* \w and read|strong="H7121"\w* \w to|strong="H6440"\w* \w him|strong="H4428"\w*. \v 2 \w And there it was found|strong="H4672"\w* \w recorded|strong="H3789"\w* \w that|strong="H834"\w* \w Mordecai|strong="H4782"\w* \w had exposed|strong="H5046"\w* \w Bigthana|strong="H904"\w*\f + \fr 6:2 \fqa Bigthana \ft is a variant of \fqa Bigthan\ft ; see \ref Esther 2:21|EST 2:21\ref*.\f* \w and Teresh|strong="H8657"\w*, \w two|strong="H8147"\w* \w of the eunuchs|strong="H5631"\w* \w who guarded|strong="H8104"\w* \w the king’s|strong="H4428"\w* \w entrance|strong="H5592"\w*, \w when|strong="H834"\w* \w they had conspired|strong="H1245"\w* \w to assassinate|strong="H7971"\w* \w King|strong="H4428"\w* \w Xerxes|strong="H325"\w*.
