\p \v 11 \w Then the LORD|strong="H3068"\w* \w said|strong="H559"\w* \w to me|strong="H413"\w*, “\w Do not|strong="H408"\w* \w pray|strong="H6419"\w* \w for|strong="H1157"\w* \w the well-being|strong="H2896"\w* \w of this|strong="H2088"\w* \w people|strong="H5971"\w*. \v 12 \w Although|strong="H3588"\w* \w they may fast|strong="H6684"\w*, \w I will not|strong="H369"\w* \w listen to|strong="H8085"\w* \w their cry|strong="H7440"\w*; \w although|strong="H3588"\w* \w they may offer|strong="H5927"\w* \w burnt offerings|strong="H5930"\w* \w and grain offerings|strong="H4503"\w*, \w I will not|strong="H369"\w* \w accept them|strong="H7521"\w*. \w Instead|strong="H3588"\w*, \w I|strong="H595"\w* \w will finish them off|strong="H3615"\w* \w by sword|strong="H2719"\w* \w and famine|strong="H7458"\w* \w and plague|strong="H1698"\w*.”
\p \v 13 “\w Ah|strong="H162"\w*, \w Lord|strong="H136"\w* \w GOD|strong="H3069"\w*!” \w I replied|strong="H559"\w*, “\w Look|strong="H2009"\w*, \w the prophets|strong="H5030"\w* \w are telling|strong="H559"\w* them, ‘\w You will not|strong="H3808"\w* \w see|strong="H7200"\w* \w the sword|strong="H2719"\w* \w or suffer|strong="H1961"\w* \w famine|strong="H7458"\w*, \w but|strong="H3588"\w* \w I will give|strong="H5414"\w* you \w lasting|strong="H571"\w* \w peace|strong="H7965"\w* \w in this|strong="H2088"\w* \w place|strong="H4725"\w*.’”
\p \v 14 “\w The prophets|strong="H5030"\w* \w are prophesying|strong="H5012"\w* \w lies|strong="H8267"\w* \w in My name|strong="H8034"\w*,” \w replied|strong="H559"\w* \w the LORD|strong="H3068"\w*. “\w I did not|strong="H3808"\w* \w send them|strong="H7971"\w* \w or|strong="H3808"\w* \w appoint them|strong="H6680"\w* \w or|strong="H3808"\w* \w speak|strong="H1696"\w* \w to them|strong="H413"\w*. \w They|strong="H1992"\w* \w are prophesying|strong="H5012"\w* to you \w a false|strong="H8267"\w* \w vision|strong="H2377"\w*, \w a worthless divination|strong="H7081"\w*, \w the futility|strong="H434"\w* \w and delusion|strong="H8649"\w* \w of their own minds|strong="H3820"\w*.
\p \v 15 \w Therefore|strong="H3651"\w* \w this is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w says|strong="H559"\w* \w about|strong="H5921"\w* \w the prophets|strong="H5030"\w* \w who prophesy|strong="H5012"\w* \w in My name|strong="H8034"\w*: \w I|strong="H589"\w* \w did not|strong="H3808"\w* \w send them|strong="H7971"\w*, \w yet they|strong="H1992"\w* \w say|strong="H559"\w*, ‘\w No|strong="H3808"\w* \w sword|strong="H2719"\w* \w or famine|strong="H7458"\w* \w will touch|strong="H1961"\w* \w this|strong="H2063"\w* \w land|strong="H776"\w*.’
\p \w By sword|strong="H2719"\w* \w and famine|strong="H7458"\w* \w these very|strong="H1992"\w* \w prophets|strong="H5030"\w* \w will meet their end|strong="H8552"\w*! \v 16 \w And the people|strong="H5971"\w* \w to whom|strong="H834"\w* \w they|strong="H1992"\w* \w prophesy|strong="H5012"\w* \w will be|strong="H1961"\w* \w thrown|strong="H7993"\w* \w into the streets|strong="H2351"\w* \w of Jerusalem|strong="H3389"\w* \w because of|strong="H6440"\w* \w famine|strong="H7458"\w* \w and sword|strong="H2719"\w*. \w There will be no|strong="H369"\w* \w one to bury|strong="H6912"\w* them \w or their|strong="H1992"\w* \w wives|strong="H802"\w*, \w their sons|strong="H1121"\w* \w or their daughters|strong="H1323"\w*. \w I will pour out|strong="H8210"\w* \w their own evil|strong="H7451"\w* \w upon them|strong="H5921"\w*.
\p \v 17 \w You are to speak|strong="H559"\w* \w this|strong="H2088"\w* \w word|strong="H1697"\w* \w to them|strong="H413"\w*:
\b 
\q1 ‘\w My eyes|strong="H5869"\w* \w overflow|strong="H3381"\w* \w with tears|strong="H1832"\w*;
