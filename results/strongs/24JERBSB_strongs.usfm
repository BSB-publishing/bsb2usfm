\p \v 18 “\w Yet even|strong="H1571"\w* \w in those|strong="H1992"\w* \w days|strong="H3117"\w*,” \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*, “\w I will not|strong="H3808"\w* \w make|strong="H6213"\w* \w a full end|strong="H3617"\w* \w of you|strong="H854"\w*. \v 19 \w And|strong="H1961"\w* \w when|strong="H3588"\w* \w the people ask|strong="H559"\w*, ‘\w For|strong="H8478"\w* \w what|strong="H4100"\w* \w offense has the LORD|strong="H3068"\w* \w our God|strong="H430"\w* \w done|strong="H6213"\w* \w all|strong="H3605"\w* \w these things to us|strong="H428"\w*?’ \w You are to tell|strong="H559"\w* \w them|strong="H413"\w*, ‘\w Just as|strong="H834"\w* \w you have forsaken|strong="H5800"\w* \w Me|strong="H853"\w* \w and served|strong="H5647"\w* \w foreign|strong="H5236"\w* \w gods|strong="H430"\w* \w in your land|strong="H776"\w*, \w so|strong="H3651"\w* \w will you serve|strong="H5647"\w* \w foreigners|strong="H2114"\w* \w in a land|strong="H776"\w* \w that is not|strong="H3808"\w* your own.’”
