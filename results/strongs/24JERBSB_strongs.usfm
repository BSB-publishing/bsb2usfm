\p \v 19 \w For|strong="H3588"\w* \w this is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w* \w says|strong="H559"\w* \w about|strong="H413"\w* \w the pillars|strong="H5982"\w*, \w the sea|strong="H3220"\w*, \w the bases|strong="H4350"\w*, \w and the rest|strong="H3499"\w* \w of the articles|strong="H3627"\w* \w that remain|strong="H3498"\w* \w in this|strong="H2063"\w* \w city|strong="H5892"\w*, \v 20 \w which|strong="H834"\w* \w Nebuchadnezzar|strong="H5019"\w* \w king|strong="H4428"\w* \w of Babylon|strong="H894"\w* \w did not|strong="H3808"\w* \w take|strong="H3947"\w* \w when he carried|strong="H1540"\w* \w Jeconiah|strong="H3204"\w*\f + \fr 27:20 \fqa Jeconiah \ft is a variant of \fqa Jehoiachin\ft ; see \ref 2 Kings 24:12|2KI 24:12\ref*.\f* \w son|strong="H1121"\w* \w of Jehoiakim|strong="H3079"\w* \w king|strong="H4428"\w* \w of Judah|strong="H3063"\w* \w into exile from Jerusalem|strong="H3389"\w* \w to Babylon|strong="H894"\w*, \w along with|strong="H853"\w* \w all|strong="H3605"\w* \w the nobles|strong="H2715"\w* \w of Judah|strong="H3063"\w* \w and Jerusalem|strong="H3389"\w*. \v 21 \w Yes|strong="H3588"\w*, \w this is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w says|strong="H559"\w* \w about|strong="H5921"\w* \w the articles|strong="H3627"\w* \w that remain|strong="H3498"\w* \w in the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*, \w in the palace|strong="H1004"\w* \w of the king|strong="H4428"\w* \w of Judah|strong="H3063"\w*, \w and in Jerusalem|strong="H3389"\w*: \v 22 ‘\w They will be carried|strong="H935"\w* \w to Babylon|strong="H894"\w* \w and will remain|strong="H1961"\w* \w there|strong="H8033"\w* \w until|strong="H5704"\w* \w the day|strong="H3117"\w* \w I attend to them again|strong="H6485"\w*,’ \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*. ‘\w Then I will bring them back|strong="H