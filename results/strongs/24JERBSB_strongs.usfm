\p \v 16 \w Then the officials|strong="H8269"\w* \w and all|strong="H3605"\w* \w the people|strong="H5971"\w* \w told|strong="H559"\w* \w the priests|strong="H3548"\w* \w and prophets|strong="H5030"\w*, “\w This|strong="H2088"\w* \w man|strong="H376"\w* \w is not|strong="H369"\w* \w worthy|strong="H4941"\w* \w of death|strong="H4194"\w*, \w for|strong="H3588"\w* \w he has spoken|strong="H1696"\w* \w to us|strong="H413"\w* \w in the name|strong="H8034"\w* \w of the LORD|strong="H3068"\w* \w our God|strong="H430"\w*!”
\p \v 17 \w Some of the elders|strong="H2205"\w* \w of the land|strong="H776"\w* \w stood up|strong="H6965"\w* \w and said|strong="H559"\w* \w to|strong="H413"\w* \w the whole|strong="H3605"\w* \w assembly|strong="H6951"\w* \w of the people|strong="H5971"\w*, \v 18 “\w Micah|strong="H4320"\w* \w the Moreshite|strong="H4183"\w* \w prophesied|strong="H5012"\w* \w in the days|strong="H3117"\w* \w of Hezekiah|strong="H2396"\w* \w king|strong="H4428"\w* \w of Judah|strong="H3063"\w* \w and told|strong="H559"\w* \w all|strong="H3605"\w* \w the people|strong="H5971"\w* \w of Judah|strong="H3063"\w* \w that this is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w* \w says|strong="H559"\w*:
