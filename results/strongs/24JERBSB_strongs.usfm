\p \v 1 \w In the seventh|strong="H7637"\w* \w month|strong="H2320"\w*, \w Ishmael|strong="H3458"\w* \w son|strong="H1121"\w* \w of Nethaniah|strong="H5418"\w*, \w the son|strong="H1121"\w* \w of Elishama|strong="H476"\w*, \w who was a member of the royal|strong="H4410"\w* \w family|strong="H2233"\w* \w and one of the king’s|strong="H4428"\w* \w chief officers|strong="H7227"\w*, \w came|strong="H935"\w* \w with|strong="H854"\w* \w ten|strong="H6235"\w* \w men|strong="H582"\w* \w to|strong="H413"\w* \w Gedaliah|strong="H1436"\w* \w son|strong="H1121"\w* \w of Ahikam|strong="H296"\w* \w at Mizpah|strong="H4709"\w*, \w and they ate|strong="H398"\w* \w a meal|strong="H3899"\w* \w together|strong="H3162"\w* \w there|strong="H8033"\w*. \v 2 \w Then Ishmael|strong="H3458"\w* \w son|strong="H1121"\w* \w of Nethaniah|strong="H5418"\w* \w and the ten|strong="H6235"\w* \w men|strong="H582"\w* \w who|strong="H834"\w* \w were|strong="H1961"\w* \w with him|strong="H854"\w* \w got up|strong="H6965"\w* \w and struck down|strong="H5221"\w* \w Gedaliah|strong="H1436"\w* \w son|strong="H1121"\w* \w of Ahikam|strong="H296"\w*, \w the son|strong="H1121"\w* \w of Shaphan|strong="H8227"\w*, \w with the sword|strong="H2719"\w*, \w killing|strong="H4191"\w* \w the one|strong="H853"\w* \w whom|strong="H834"\w* \w the king|strong="H4428"\w* \w of Babylon|strong="H894"\w* \w had appointed to govern|strong="H6485"\w* \w the land|strong="H776"\w*. \v 3 \w Ishmael|strong="H3458"\w* \w also|strong="H853"\w* \w killed|strong="H5221"\w* \w all|strong="H3605"\w* \w the Jews|strong="H3064"\w* \w who|strong="H834"\w* \w were|strong="H1961"\w* \w with|strong="H854"\w* \w Gedaliah|strong="H1436"\w* \w at Mizpah|strong="H4709"\w*, \w as well as the Chaldean|strong="H3778"\w*\f + \fr 41:3 \ft Or \fqa Babylonian\f* \w soldiers|strong="H4421"\w* \w who|strong="H834"\w* \w were there|strong="H8033"\w*.
\p \v 4 \w On the second|strong="H8145"\w* \w day|strong="H3117"\w* \w after the murder|strong="H4191"\w* \w of Gedaliah|strong="H1436"\w*, \w when no|strong="H3808"\w* \w one|strong="H376"\w* \w yet knew about it|strong="H3045"\w*, \v 5 \w eighty|strong="H8084"\w* \w men|strong="H582"\w* \w who had shaved off|strong="H1548"\w* \w their beards|strong="H2206"\w*, \w torn|strong="H7167"\w* \w their garments|strong="H899"\w*, \w and cut themselves|strong="H1413"\w* \w came|strong="H935"\w* \w from Shechem|strong="H7927"\w*, \w Shiloh|strong="H7887"\w*, \w and Samaria|strong="H8111"\w*, \w carrying|strong="H935"\w* \w grain offerings|strong="H4503"\w* \w and frankincense|strong="H3828"\w* \w for the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*. \v 6 \w And Ishmael|strong="H3458"\w* \w son|strong="H1121"\w* \w of Nethaniah|strong="H5418"\w* \w went out|strong="H3318"\w* \w from|strong="H4480"\w* \w Mizpah|strong="H4709"\w* \w to meet them|strong="H7122"\w*, \w weeping|strong="H1058"\w* \w as he went|strong="H1980"\w*.
\p \w When Ishmael encountered the men|strong="H6298"\w*, \w he said|strong="H559"\w*, “\w Come|strong="H935"\w* \w to|strong="H413"\w* \w Gedaliah|strong="H1436"\w* \w son|strong="H1121"\w* \w of Ahikam|strong="H296"\w*.” \v 7 \w And when they came|strong="H935"\w* \w into|strong="H413"\w* \w the city|strong="H5892"\w*, \w Ishmael|strong="H3458"\w* \w son|strong="H1121"\w* \w of Nethaniah|strong="H5418"\w* \w and the men|strong="H582"\w* \w with him|strong="H854"\w* \w slaughtered them|strong="H7819"\w* \w and threw them into|strong="H413"\w* \w a cistern|strong="H953"\w*.
\p \v 8 \w But ten|strong="H6235"\w* \w of the men|strong="H582"\w* among them \w said|strong="H559"\w* \w to|strong="H413"\w* \w Ishmael|strong="H3458"\w*, “\w Do not|strong="H408"\w* \w kill us|strong="H4191"\w*, \w for|strong="H3588"\w* \w we have|strong="H3426"\w* \w hidden treasure|strong="H4301"\w* \w in the field|strong="H7704"\w*— \w wheat|strong="H2406"\w*, \w barley|strong="H8184"\w*, \w oil|strong="H8081"\w*, \w and honey|strong="H1706"\w*!” \w So he refrained|strong="H2308"\w* \w from killing them|strong="H4191"\w* \w with|strong="H8432"\w* \w the others|strong="H251"\w*.
\p \v 9 \w Now the cistern|strong="H953"\w* \w into which|strong="H834"\w* \w Ishmael|strong="H3458"\w* \w had thrown|strong="H7993"\w* \w all|strong="H3605"\w* \w the bodies|strong="H6297"\w* \w of the men|strong="H582"\w* \w he had struck down|strong="H5221"\w* \w along with|strong="H3027"\w* \w Gedaliah|strong="H1436"\w* \w was a large one that|strong="H834"\w* \w King|strong="H4428"\w* \w Asa|strong="H609"\w* \w had made|strong="H6213"\w* \w for fear|strong="H6440"\w* \w of Baasha|strong="H1201"\w* \w king|strong="H4428"\w* \w of Israel|strong="H3478"\w*. \w Ishmael|strong="H3458"\w* \w son|strong="H1121"\w* \w of Nethaniah|strong="H5418"\w* \w filled it|strong="H4390"\w* \w with the slain|strong="H2491"\w*.
\p \v 10 \w Then Ishmael|strong="H3458"\w* \w took captive|strong="H7617"\w* \w all|strong="H3605"\w* \w the remnant|strong="H7611"\w* \w of the people|strong="H5971"\w* \w of Mizpah|strong="H4709"\w*— \w the daughters|strong="H1323"\w* \w of the king|strong="H4428"\w* \w along with|strong="H853"\w* \w all|strong="H3605"\w* \w the others|strong="H5971"\w* \w who remained|strong="H7604"\w* \w in Mizpah|strong="H4709"\w*— \w over whom|strong="H834"\w* \w Nebuzaradan|strong="H5018"\w* \w captain|strong="H7227"\w* \w of the guard|strong="H2876"\w* \w had appointed|strong="H6485"\w* \w Gedaliah|strong="H1436"\w* \w son|strong="H1121"\w* \w of Ahikam|strong="H296"\w*. \w Ishmael|strong="H3458"\w* \w son|strong="H1121"\w* \w of Nethaniah|strong="H5418"\w* \w took them captive|strong="H7617"\w* \w and set off|strong="H1980"\w* \w to cross over|strong="H5674"\w* \w to|strong="H413"\w* \w the Ammonites|strong="H1121"\w*.
\s1 Johanan Rescues the Captives
\p \v 11 \w When Johanan|strong="H3110"\w* \w son|strong="H1121"\w* \w of Kareah|strong="H7143"\w* \w and all|strong="H3605"\w* \w the commanders|strong="H8269"\w* \w of the armies|strong="H2428"\w* \w with|strong="H854"\w* \w him|strong="H853"\w* \w heard|strong="H8085"\w* \w of all|strong="H3605"\w* \w the crimes|strong="H7451"\w* \w that|strong="H834"\w* \w Ishmael|strong="H3458"\w* \w son|strong="H1121"\w* \w of Nethaniah|strong="H5418"\w* \w had committed|strong="H6213"\w*, \v 12 \w they took|strong="H3947"\w* \w all|strong="H3605"\w* \w their men|strong="H582"\w* \w and went|strong="H1980"\w* \w to fight|strong="H3898"\w* \w Ishmael|strong="H3458"\w* \w son|strong="H1121"\w* \w of Nethaniah|strong="H5418"\w*. \w And they found|strong="H4672"\w* \w him|strong="H853"\w* \w near|strong="H413"\w* \w the great|strong="H7227"\w* \w pool|strong="H4325"\w* \w in Gibeon|strong="H1391"\w*.
\p \v 13 \w When all|strong="H3605"\w* \w the people|strong="H5971"\w* \w with|strong="H854"\w* \w Ishmael|strong="H3458"\w* \w saw|strong="H7200"\w* \w Johanan|strong="H3110"\w* \w son|strong="H1121"\w* \w of Kareah|strong="H7143"\w* \w and all|strong="H3605"\w* \w the commanders|strong="H8269"\w* \w of the army|strong="H2428"\w* \w with him|strong="H854"\w*, \w they rejoiced|strong="H8055"\w*, \v 14 \w and all|strong="H3605"\w* \w the people|strong="H5971"\w* \w whom|strong="H834"\w* \w Ishmael|strong="H3458"\w* \w had taken captive|strong="H7617"\w* \w at|strong="H4480"\w* \w Mizpah|strong="H4709"\w* \w turned|strong="H5437"\w* \w and went over|strong="H1980"\w* \w to|strong="H413"\w* \w Johanan|strong="H3110"\w* \w son|strong="H1121"\w* \w of Kareah|strong="H7143"\w*. \v 15 \w But Ishmael|strong="H3458"\w* \w son|strong="H1121"\w* \w of Nethaniah|strong="H5418"\w* \w and eight|strong="H8083"\w* \w of his men|strong="H582"\w* \w escaped|strong="H4422"\w* \w from|strong="H6440"\w* \w Johanan|strong="H3110"\w* \w and went|strong="H1980"\w* \w to|strong="H413"\w* \w the Ammonites|strong="H1121"\w*.
\p \v 16 \w Then Johanan|strong="H3110"\w* \w son|strong="H1121"\w* \w of Kareah|strong="H7143"\w* \w and all|strong="H3605"\w* \w the commanders|strong="H8269"\w* \w of the armies|strong="H2428"\w* \w with him|strong="H854"\w* \w took|strong="H3947"\w* \w the whole|strong="H3605"\w* \w remnant|strong="H7611"\w* \w of the people|strong="H5971"\w* \w from|strong="H4480"\w* \w Mizpah|strong="H4709"\w* \w whom|strong="H834"\w* \w he had recovered|strong="H7725"\w* \w from Ishmael|strong="H3458"\w* \w son|strong="H1121"\w* \w of Nethaniah|strong="H5418"\w* \w after|strong="H310"\w* \w Ishmael had killed|strong="H5221"\w* \w Gedaliah|strong="H1436"\w* \w son|strong="H1121"\w* \w of Ahikam|strong="H296"\w*: \w the soldiers|strong="H1397"\w*, \w women|strong="H802"\w*, \w children|strong="H2945"\w*, \w and court officials|strong="H5631"\w*\f + \fr 41:16 \ft Or \fqa eunuchs\f* \w he had brought back|strong="H7725"\w* \w from Gibeon|strong="H1391"\w*. \v 17 \w And they went|strong="H1980"\w* \w and stayed|strong="H3427"\w* \w in Geruth|strong="H1628"\w* \w Chimham|strong="H3644"\w*, \w near|strong="H681"\w* \w Bethlehem|strong="H1035"\w*, \w in order to proceed|strong="H1980"\w* \w into Egypt|strong="H4714"\w* \v 18 \w to escape|strong="H6440"\w* \w the Chaldeans|strong="H3778"\w*.\f + \fr 41:18 \ft That is, the Babylonians\f* \w For|strong="H3588"\w* \w they were afraid|strong="H3372"\w* \w of the Chaldeans|strong="H6440"\w* \w because|strong="H3588"\w* \w Ishmael|strong="H3458"\w* \w son|strong="H1121"\w* \w of Nethaniah|strong="H5418"\w* \w had struck down|strong="H5221"\w* \w Gedaliah|strong="H1436"\w* \w son|strong="H1121"\w* \w of Ahikam|strong="H296"\w*, \w whom|strong="H834"\w* \w the king|strong="H4428"\w* \w of Babylon|strong="H894"\w* \w had appointed|strong="H6485"\w* \w over the land|strong="H776"\w*.
\c 42
\s1 A Warning against Going to Egypt
\p \v 1 \w Then all|strong="H3605"\w* \w the commanders|strong="H8269"\w* \w of the forces|strong="H2428"\w*, \w along with Johanan|strong="H3110"\w* \w son|strong="H1121"\w* \w of Kareah|strong="H7143"\w*, \w Jezaniah|strong="H3153"\w*\f + \fr 42:1 \ft Hebrew; LXX \fqa Azariah\ft ; see \ref Jeremiah 43:2|JER 43:2\ref*.\f* \w son|strong="H1121"\w* \w of Hoshaiah|strong="H1955"\w*, \w and all|strong="H3605"\w* \w the people|strong="H5971"\w* \w from the least|strong="H6996"\w* \w to|strong="H5704"\w* \w the greatest|strong="H1419"\w*, \w approached|strong="H5066"\w* \v 2 \w Jeremiah|strong="H3414"\w* \w the prophet|strong="H5030"\w* \w and said|strong="H559"\w*, “\w May our petition|strong="H8467"\w* \w come|strong="H5307"\w* \w before you|strong="H6440"\w*; \w pray|strong="H6419"\w* \w to|strong="H413"\w* \w the LORD|strong="H3068"\w* \w your God|strong="H430"\w* \w on behalf of|strong="H1157"\w* \w this|strong="H2063"\w* \w entire|strong="H3605"\w* \w remnant|strong="H7611"\w*. \w For|strong="H3588"\w* \w few|strong="H4592"\w* \w of us remain|strong="H7604"\w* \w of the many|strong="H7235"\w*, \w as|strong="H834"\w* \w you can see|strong="H7200"\w* \w with your own eyes|strong="H5869"\w*. \v 3 \w Pray that the LORD|strong="H3068"\w* \w your God|strong="H430"\w* \w will tell|strong="H5046"\w* us \w the way|strong="H1870"\w* \w we should walk|strong="H1980"\w* \w and the thing|strong="H1697"\w* \w we should do|strong="H6213"\w*.”
\p \v 4 “\w I have heard you|strong="H8085"\w*,” \w replied|strong="H559"\w* \w Jeremiah|strong="H3414"\w* \w the prophet|strong="H5030"\w*. “\w I will surely|strong="H2005"\w* \w pray|strong="H6419"\w* \w to|strong="H413"\w* \w the LORD|strong="H3068"\w* \w your God|strong="H430"\w* \w as you request|strong="H1697"\w*, \w and I will tell you|strong="H5046"\w* \w everything|strong="H3605"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w answers|strong="H6030"\w*. \w I will not|strong="H3808"\w* \w withhold|strong="H4513"\w* \w a word|strong="H1697"\w* from you.”
\p \v 5 \w Then they|strong="H1992"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w Jeremiah|strong="H3414"\w*, “\w May the LORD|strong="H3068"\w* \w be|strong="H1961"\w* \w a true|strong="H571"\w* \w and faithful|strong="H539"\w* \w witness|strong="H5707"\w* against us \w if|strong="H518"\w* \w we do not|strong="H3808"\w* \w act upon|strong="H6213"\w* \w every|strong="H3605"\w* \w word|strong="H1697"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w your God|strong="H430"\w* \w sends you|strong="H7971"\w* \w to tell us|strong="H413"\w*. \v 6 \w Whether|strong="H518"\w* \w it is pleasant|strong="H2896"\w* \w or|strong="H518"\w* \w unpleasant|strong="H7451"\w*, \w we will obey|strong="H8085"\w* \w the voice|strong="H6963"\w* \w of the LORD|strong="H3068"\w* \w our God|strong="H430"\w* \w to whom|strong="H834"\w* \w we|strong="H580"\w* \w are sending|strong="H7971"\w* \w you|strong="H853"\w*, \w so that|strong="H4616"\w* \w it may go well with us|strong="H3190"\w* \w when|strong="H3588"\w* \w we obey|strong="H8085"\w* \w the voice|strong="H6963"\w* \w of the LORD|strong="H3068"\w* \w our God|strong="H430"\w*!”
\p \v 7 \w After|strong="H7093"\w* \w ten|strong="H6235"\w* \w days|strong="H3117"\w* \w the word|strong="H1697"\w* \w of the LORD|strong="H3068"\w* \w came|strong="H1961"\w* \w to|strong="H413"\w* \w Jeremiah|strong="H3414"\w*, \v 8 \w and he summoned|strong="H7121"\w* \w Johanan|strong="H3110"\w* \w son|strong="H1121"\w* \w of Kareah|strong="H7143"\w*, \w all|strong="H3605"\w* \w the commanders|strong="H8269"\w* \w of the forces|strong="H2428"\w* \w who|strong="H834"\w* \w were with him|strong="H854"\w*, \w and all|strong="H3605"\w* \w the people|strong="H5971"\w* \w from the least|strong="H6996"\w* \w to|strong="H5704"\w* \w the greatest|strong="H1419"\w*.
\p \v 9 \w Jeremiah told|strong="H559"\w* \w them|strong="H413"\w*, “\w Thus|strong="H3541"\w* \w says|strong="H559"\w* \w the LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w to|strong="H413"\w* \w whom|strong="H834"\w* \w you sent|strong="H7971"\w* \w me|strong="H853"\w* \w to present|strong="H5307"\w* \w your petition|strong="H8467"\w*: \v 10 ‘\w If|strong="H518"\w* \w you will indeed stay|strong="H3427"\w* \w in this|strong="H2063"\w* \w land|strong="H776"\w*, \w then I will build|strong="H1129"\w* \w you up|strong="H853"\w* \w and not|strong="H3808"\w* \w tear you down|strong="H2040"\w*; \w I will plant|strong="H5193"\w* \w you|strong="H853"\w* \w and not|strong="H3808"\w* \w uproot you|strong="H5428"\w*, \w for|strong="H3588"\w* \w I will relent|strong="H5162"\w* \w of|strong="H413"\w* \w the disaster|strong="H7451"\w* \w I have brought|strong="H6213"\w* upon you.
\p \v 11 \w Do not|strong="H408"\w* \w be afraid|strong="H3372"\w* \w of|strong="H6440"\w* \w the king|strong="H4428"\w* \w of Babylon|strong="H894"\w*, \w whom|strong="H834"\w* \w you|strong="H859"\w* \w now fear|strong="H3373"\w*; \w do not|strong="H408"\w* \w be afraid|strong="H3372"\w* \w of him|strong="H4480"\w*, \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*, \w for|strong="H3588"\w* \w I|strong="H589"\w* \w am with|strong="H854"\w* \w you to save|strong="H3467"\w* \w you|strong="H853"\w* \w and deliver|strong="H5337"\w* \w you|strong="H853"\w* \w from him|strong="H3027"\w*. \v 12 \w And I will show|strong="H5414"\w* you \w compassion|strong="H7356"\w*, \w and he will have compassion|strong="H7355"\w* \w on you|strong="H853"\w* \w and restore|strong="H7725"\w* \w you|strong="H853"\w* \w to|strong="H413"\w* \w your own land|strong="H127"\w*.’
\p \v 13 \w But if|strong="H518"\w* \w you|strong="H859"\w* \w say|strong="H559"\w*, ‘\w We will not|strong="H3808"\w* \w stay|strong="H3427"\w* \w in this|strong="H2063"\w* \w land|strong="H776"\w*,’ \w and you thus disobey|strong="H8085"\w* \w the voice|strong="H6963"\w* \w of the LORD|strong="H3068"\w* \w your God|strong="H430"\w*, \v 14 \w and if you say|strong="H559"\w*, ‘\w No|strong="H3808"\w*, \w but|strong="H3588"\w* \w we will go|strong="H935"\w* \w to the land|strong="H776"\w* \w of Egypt|strong="H4714"\w* \w and live|strong="H3427"\w* \w there|strong="H8033"\w*, \w where|strong="H834"\w* \w we will not|strong="H3808"\w* \w see|strong="H7200"\w* \w war|strong="H4421"\w* \w or hear|strong="H8085"\w* \w the sound|strong="H6963"\w* \w of the ram’s horn|strong="H7782"\w* \w or hunger|strong="H7456"\w* \w for bread|strong="H3899"\w*,’ \v 15 \w then|strong="H6258"\w* \w hear|strong="H8085"\w* \w the word|strong="H1697"\w* \w of the LORD|strong="H3068"\w*, \w O remnant|strong="H7611"\w* \w of Judah|strong="H3063"\w*! \w This is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w says|strong="H559"\w*: ‘\w If|strong="H518"\w* \w you|strong="H859"\w* \w are determined|strong="H7760"\w* \w to go|strong="H935"\w* \w to Egypt|strong="H4714"\w* \w and reside|strong="H1481"\w* \w there|strong="H8033"\w*, \v 16 \w then the sword|strong="H2719"\w* \w you|strong="H859"\w* \w fear|strong="H3373"\w* \w will overtake|strong="H5381"\w* \w you|strong="H853"\w* \w there|strong="H8033"\w*, \w and the famine|strong="H7458"\w* \w you|strong="H859"\w* \w dread|strong="H1672"\w* \w will follow on your heels|strong="H1692"\w* \w into Egypt|strong="H4714"\w*, \w and you will die|strong="H4191"\w* \w there|strong="H8033"\w*. \v 17 \w So all|strong="H3605"\w* \w who|strong="H834"\w* \w resolve|strong="H7760"\w* \w to go|strong="H935"\w* \w to Egypt|strong="H4714"\w* \w to reside there|strong="H8033"\w* \w will|strong="H1961"\w* \w die|strong="H4191"\w* \w by sword|strong="H2719"\w* \w and famine|strong="H7458"\w* \w and plague|strong="H1698"\w*. \w Not one|strong="H3808"\w* of them \w will|strong="H1961"\w* \w survive|strong="H8300"\w* \w or escape|strong="H6412"\w* \w the disaster|strong="H7451"\w* \w I|strong="H589"\w* \w will bring|strong="H935"\w* \w upon them|strong="H5921"\w*.’
\p \v 18 \w For|strong="H3588"\w* \w this is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w says|strong="H559"\w*: ‘\w Just as|strong="H834"\w* \w My anger|strong="H639"\w* \w and wrath|strong="H2534"\w* \w were poured out|strong="H5413"\w* \w on|strong="H5921"\w* \w the residents|strong="H3427"\w* \w of Jerusalem|strong="H3389"\w*, \w so|strong="H3651"\w* \w will My wrath|strong="H2534"\w* \w be poured out|strong="H5413"\w* \w on you|strong="H5921"\w* \w if you go|strong="H935"\w* \w to Egypt|strong="H4714"\w*. \w You will become|strong="H1961"\w* \w an object of cursing|strong="H423"\w* \w and horror|strong="H8047"\w*, \w of vilification|strong="H7045"\w* \w and disgrace|strong="H2781"\w*, \w and you will never|strong="H3808"\w* \w see|strong="H7200"\w* \w this|strong="H2088"\w* \w place|strong="H4725"\w* \w again|strong="H5750"\w*.’
\p \v 19 \w The LORD|strong="H3068"\w* \w has told|strong="H1696"\w* \w you|strong="H5921"\w*, \w O remnant|strong="H7611"\w* \w of Judah|strong="H3063"\w*, ‘\w Do not|strong="H408"\w* \w go|strong="H935"\w* \w to Egypt|strong="H4714"\w*.’ \w Know for sure|strong="H3045"\w* \w that|strong="H3588"\w* \w I have warned|strong="H5749"\w* you \w today|strong="H3117"\w*! \v 20 \w For|strong="H3588"\w* \w you|strong="H5315"\w* \w have deceived|strong="H8582"\w* \w yourselves|strong="H859"\w* \w by sending|strong="H7971"\w* \w me|strong="H853"\w* \w to|strong="H413"\w* \w the LORD|strong="H3068"\w* \w your God|strong="H430"\w*, \w saying|strong="H559"\w*, ‘\w Pray|strong="H6419"\w* \w to|strong="H413"\w* \w the LORD|strong="H3068"\w* \w our God|strong="H430"\w* \w on our behalf|strong="H1157"\w*, \w and as for all|strong="H3605"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w our God|strong="H430"\w* \w says|strong="H559"\w*, \w tell it|strong="H5046"\w* to us \w and we will do it|strong="H6213"\w*.’
\p \v 21 \w For I have told|strong="H5046"\w* you \w today|strong="H3117"\w*, \w but you have not|strong="H3808"\w* \w obeyed|strong="H8085"\w* \w the voice|strong="H6963"\w* \w of the LORD|strong="H3068"\w* \w your God|strong="H430"\w* \w in all|strong="H3605"\w* \w He has sent me|strong="H7971"\w* \w to tell you|strong="H413"\w*. \v 22 \w Now therefore|strong="H6258"\w*, \w know|strong="H3045"\w* \w for sure|strong="H3045"\w* \w that|strong="H3588"\w* \w by sword|strong="H2719"\w* \w and famine|strong="H7458"\w* \w and plague|strong="H1698"\w* \w you will die|strong="H4191"\w* \w in the place|strong="H4725"\w* \w where|strong="H834"\w* \w you desire|strong="H2654"\w* \w to go|strong="H935"\w* \w to reside|strong="H1481"\w*.”
\c 43
\s1 Jeremiah Taken to Egypt
\p \v 1 \w When Jeremiah|strong="H3414"\w* \w had finished|strong="H3615"\w* \w telling|strong="H1696"\w* \w all|strong="H3605"\w* \w the people|strong="H5971"\w* \w all|strong="H3605"\w* \w the words|strong="H1697"\w* \w of the LORD|strong="H3068"\w* \w their God|strong="H430"\w*— \w everything that|strong="H3605"\w* \w the LORD|strong="H3068"\w* \w had sent him|strong="H7971"\w* \w to say|strong="H413"\w*— \v 2 \w Azariah|strong="H5838"\w* \w son|strong="H1121"\w* \w of Hoshaiah|strong="H1955"\w*, \w Johanan|strong="H3110"\w* \w son|strong="H1121"\w* \w of Kareah|strong="H7143"\w*, \w and all|strong="H3605"\w* \w the arrogant|strong="H2086"\w* \w men|strong="H582"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w Jeremiah|strong="H3414"\w*, “\w You|strong="H859"\w* \w are lying|strong="H8267"\w*! \w The LORD|strong="H3068"\w* \w our God|strong="H430"\w* \w has not|strong="H3808"\w* \w sent you|strong="H7971"\w* \w to say|strong="H559"\w*, ‘\w You must not|strong="H3808"\w* \w go|strong="H935"\w* \w to Egypt|strong="H4714"\w* \w to reside there|strong="H8033"\w*.’ \v 3 \w Rather|strong="H3588"\w*, \w Baruch|strong="H1263"\w* \w son|strong="H1121"\w* \w of Neriah|strong="H5374"\w* \w is inciting|strong="H5496"\w* \w you|strong="H853"\w* against us \w to|strong="H4616"\w* \w deliver|strong="H5414"\w* \w us|strong="H853"\w* \w into the hands|strong="H3027"\w* \w of the Chaldeans|strong="H3778"\w*,\f + \fr 43:3 \ft That is, the Babylonians\f* \w so that they may put us to death|strong="H4191"\w* \w or exile|strong="H1540"\w* \w us|strong="H853"\w* \w to Babylon|strong="H894"\w*!”
\p \v 4 \w So Johanan|strong="H3110"\w* \w son|strong="H1121"\w* \w of Kareah|strong="H7143"\w* \w and all|strong="H3605"\w* \w the commanders|strong="H8269"\w* \w of the forces|strong="H2428"\w* \w disobeyed|strong="H8085"\w* \w the command|strong="H6963"\w* \w of the LORD|strong="H3068"\w* \w to stay|strong="H3427"\w* \w in the land|strong="H776"\w* \w of Judah|strong="H3063"\w*. \v 5 \w Instead, Johanan|strong="H3110"\w* \w son|strong="H1121"\w* \w of Kareah|strong="H7143"\w* \w and all|strong="H3605"\w* \w the commanders|strong="H8269"\w* \w of the forces|strong="H2428"\w* \w took|strong="H3947"\w* \w the whole|strong="H3605"\w* \w remnant|strong="H7611"\w* \w of Judah|strong="H3063"\w*, \w those who|strong="H834"\w* \w had returned|strong="H7725"\w* \w to the land|strong="H776"\w* \w of Judah|strong="H3063"\w* \w from all|strong="H3605"\w* \w the nations|strong="H1471"\w* \w to which|strong="H834"\w* \w they had been scattered|strong="H5080"\w*, \v 6 \w the men|strong="H1397"\w*, \w the women|strong="H802"\w*, \w the children|strong="H2945"\w*, \w the king’s|strong="H4428"\w* \w daughters|strong="H1323"\w*, \w and everyone|strong="H3605"\w* \w whom|strong="H834"\w* \w Nebuzaradan|strong="H5018"\w* \w captain|strong="H7227"\w* \w of the guard|strong="H2876"\w* \w had allowed to remain|strong="H5117"\w* \w with|strong="H854"\w* \w Gedaliah|strong="H1436"\w* \w son|strong="H1121"\w* \w of Ahikam|strong="H296"\w*, \w the son|strong="H1121"\w* \w of Shaphan|strong="H8227"\w*, \w as well as|strong="H853"\w* \w Jeremiah|strong="H3414"\w* \w the prophet|strong="H5030"\w* \w and Baruch|strong="H1263"\w* \w son|strong="H1121"\w* \w of Neriah|strong="H5374"\w*.
\p \v 7 \w So they entered|strong="H935"\w* \w the land|strong="H776"\w* \w of Egypt|strong="H4714"\w* \w because|strong="H3588"\w* \w they did not|strong="H3808"\w* \w obey|strong="H8085"\w* \w the voice|strong="H6963"\w* \w of the LORD|strong="H3068"\w*, \w and they went|strong="H935"\w* \w as far as|strong="H5704"\w* \w Tahpanhes|strong="H8471"\w*.
\p \v 8 \w Then the word|strong="H1697"\w* \w of the LORD|strong="H3068"\w* \w came|strong="H1961"\w* \w to|strong="H413"\w* \w Jeremiah|strong="H3414"\w* \w at Tahpanhes|strong="H8471"\w*: \v 9 “\w In the sight|strong="H5869"\w* \w of the Jews|strong="H3064"\w*, \w pick up|strong="H3947"\w* \w some large|strong="H1419"\w* \w stones|strong="H68"\w* \w and bury them|strong="H2934"\w* \w in the clay|strong="H4423"\w* \w of the brick pavement|strong="H4404"\w* \w at the entrance|strong="H6607"\w* \w to Pharaoh’s|strong="H6547"\w* \w palace|strong="H1004"\w* \w at Tahpanhes|strong="H8471"\w*.
\p \v 10 \w Then tell them|strong="H559"\w* \w that|strong="H413"\w* \w this is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w says|strong="H559"\w*: ‘\w I will send for|strong="H7971"\w* \w My servant|strong="H5650"\w* \w Nebuchadnezzar|strong="H5019"\w* \w king|strong="H4428"\w* \w of Babylon|strong="H894"\w*, \w and I will set|strong="H7760"\w* \w his throne|strong="H3678"\w* \w over|strong="H4605"\w* \w these|strong="H428"\w* \w stones|strong="H68"\w* \w that|strong="H834"\w* \w I have embedded|strong="H2934"\w*, \w and he will spread|strong="H5186"\w* \w his royal pavilion|strong="H8237"\w* \w over them|strong="H5921"\w*. \v 11 \w He will come|strong="H935"\w* \w and strike down|strong="H5221"\w* \w the land|strong="H776"\w* \w of Egypt|strong="H4714"\w*, \w bringing death|strong="H4194"\w* \w to those|strong="H834"\w* \w destined for death|strong="H4194"\w*, \w captivity|strong="H7628"\w* \w to those|strong="H834"\w* \w destined for captivity|strong="H7628"\w*, \w and the sword|strong="H2719"\w* \w to those|strong="H834"\w* \w destined for the sword|strong="H2719"\w*.
\p \v 12 \w I will kindle|strong="H3341"\w* \w a fire|strong="H784"\w* \w in the temples|strong="H1004"\w* \w of the gods|strong="H430"\w* \w of Egypt|strong="H4714"\w*, \w and Nebuchadnezzar will burn those temples|strong="H8313"\w* \w and take their gods as captives|strong="H7617"\w*.\f + \fr 43:12 \ft Literally \fqa and he will burn them and take them captive\f* \w So he will wrap himself|strong="H5844"\w* \w with|strong="H853"\w* \w the land|strong="H776"\w* \w of Egypt|strong="H4714"\w* \w as|strong="H834"\w* \w a shepherd|strong="H7462"\w* \w wraps himself|strong="H5844"\w* \w in his garment|strong="H899"\w*, \w and he will depart|strong="H3318"\w* \w from there|strong="H8033"\w* \w unscathed|strong="H7965"\w*. \v 13 \w He will demolish|strong="H7665"\w* \w the sacred pillars|strong="H4676"\w* \w of the temple of the sun|strong="H1053"\w* \w in the land|strong="H776"\w* \w of Egypt|strong="H4714"\w*,\f + \fr 43:13 \ft LXX \fqa He will demolish the pillars of Heliopolis in On \ft or \fqa He will demolish the pillars of Heliopolis in Egypt\ft ; Hebrew \fqa He will demolish the pillars of Beth-shemesh in the land of Egypt\f* \w and|strong="H853"\w* \w he will burn down|strong="H8313"\w* \w the temples|strong="H1004"\w* \w of the gods|strong="H430"\w* \w of Egypt|strong="H4714"\w*.’”
\c 44
\s1 Judgment on the Jews in Egypt
\p \v 1 \w This is the word|strong="H1697"\w* \w that|strong="H834"\w* \w came|strong="H1961"\w* \w to|strong="H413"\w* \w Jeremiah|strong="H3414"\w* \w concerning|strong="H413"\w* \w all|strong="H3605"\w* \w the Jews|strong="H3064"\w* \w living|strong="H3427"\w* \w in the land|strong="H776"\w* \w of Egypt|strong="H4714"\w*\f + \fr 44:1 \ft Or \fqa Lower Egypt \ft or \fqa northern Egypt\ft ; also in verse 15\f*— \w in Migdol|strong="H4024"\w*, \w Tahpanhes|strong="H8471"\w*, \w and Memphis|strong="H5297"\w*\f + \fr 44:1 \ft LXX; Hebrew \fqa Noph\f*— \w and in the land|strong="H776"\w* \w of Pathros|strong="H6624"\w*:\f + \fr 44:1 \ft Or \fqa Upper Egypt \ft or \fqa southern Egypt\ft ; also in verse 15\f* \v 2 “\w This is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w says|strong="H559"\w*: \w You|strong="H859"\w* \w have seen|strong="H7200"\w* \w all|strong="H3605"\w* \w the disaster|strong="H7451"\w* \w that|strong="H834"\w* \w I brought|strong="H935"\w* \w against|strong="H5921"\w* \w Jerusalem|strong="H3389"\w* \w and all|strong="H3605"\w* \w the cities|strong="H5892"\w* \w of Judah|strong="H3063"\w*; \w and behold|strong="H2005"\w*, \w they lie today in ruins|strong="H2723"\w* \w and|strong="H2088"\w* \w desolation|strong="H369"\w* \v 3 \w because of|strong="H6440"\w* \w the evil|strong="H7451"\w* \w they have done|strong="H6213"\w*.
\p \w They provoked Me to anger|strong="H3707"\w* \w by continuing|strong="H1980"\w* \w to burn incense|strong="H6999"\w* \w and to serve|strong="H5647"\w* \w other|strong="H312"\w* \w gods|strong="H430"\w* \w that neither|strong="H3808"\w* \w they|strong="H1992"\w* \w nor you|strong="H859"\w* \w nor your fathers|strong="H1"\w* \w ever knew|strong="H3045"\w*. \v 4 \w Yet I sent|strong="H7971"\w* \w you|strong="H413"\w* \w all|strong="H3605"\w* \w My servants|strong="H5650"\w* \w the prophets|strong="H5030"\w* \w again and again|strong="H7925"\w*,\f + \fr 44:4 \ft Literally \fqa the prophets, rising up early and sending (them),\f* \w saying|strong="H559"\w*: ‘\w Do not|strong="H408"\w* \w do|strong="H6213"\w* \w this|strong="H2063"\w* \w detestable|strong="H8441"\w* \w thing|strong="H1697"\w* \w that|strong="H834"\w* \w I hate|strong="H8130"\w*.’
\p \v 5 \w But they did not|strong="H3808"\w* \w listen|strong="H8085"\w* \w or incline|strong="H5186"\w* \w their ears|strong="H241"\w*; \w they did not|strong="H3808"\w* \w turn|strong="H7725"\w* \w from their wickedness|strong="H7451"\w* \w or stop|strong="H1115"\w* \w burning incense|strong="H6999"\w* \w to other|strong="H312"\w* \w gods|strong="H430"\w*. \v 6 \w Therefore My wrath|strong="H2534"\w* \w and anger|strong="H639"\w* \w poured out|strong="H5413"\w* \w and burned|strong="H1197"\w* \w in the cities|strong="H5892"\w* \w of Judah|strong="H3063"\w* \w and in the streets|strong="H2351"\w* \w of Jerusalem|strong="H3389"\w*, \w so that they have become|strong="H1961"\w* \w the desolate|strong="H2723"\w* \w ruin|strong="H8077"\w* \w they are today|strong="H3117"\w*.
\p \v 7 \w So now|strong="H6258"\w*, \w this is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w God|strong="H430"\w* \w of Hosts|strong="H6635"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w says|strong="H559"\w*: \w Why|strong="H4100"\w* \w are you|strong="H859"\w* \w doing|strong="H6213"\w* \w such great|strong="H1419"\w* \w harm|strong="H7451"\w* \w to|strong="H413"\w* \w yourselves|strong="H5315"\w* \w by cutting off|strong="H3772"\w* \w from|strong="H8432"\w* \w Judah|strong="H3063"\w* \w man|strong="H376"\w* \w and woman|strong="H802"\w*, \w child|strong="H5768"\w* \w and infant|strong="H3243"\w*, \w leaving|strong="H3498"\w* yourselves \w without|strong="H1115"\w* \w a remnant|strong="H7611"\w*? \v 8 \w Why are you provoking Me to anger|strong="H3707"\w* \w by the work|strong="H4639"\w* \w of your hands|strong="H3027"\w* \w by burning incense|strong="H6999"\w* \w to other|strong="H312"\w* \w gods|strong="H430"\w* \w in the land|strong="H776"\w* \w of Egypt|strong="H4714"\w*, \w where|strong="H834"\w* \w you|strong="H859"\w* \w have gone|strong="H935"\w* \w to reside|strong="H1481"\w*?
\p \w As a result|strong="H4616"\w*, \w you will be cut off|strong="H3772"\w* \w and|strong="H4616"\w* \w will become|strong="H1961"\w* \w an object of cursing|strong="H7045"\w* \w and reproach|strong="H2781"\w* \w among all|strong="H3605"\w* \w the nations|strong="H1471"\w* \w of the earth|strong="H776"\w*. \v 9 \w Have you forgotten|strong="H7911"\w* \w the wickedness|strong="H7451"\w* \w of your fathers|strong="H1"\w* \w and|strong="H853"\w* \w of the kings|strong="H4428"\w* \w of Judah|strong="H3063"\w* \w and|strong="H853"\w* \w their wives|strong="H802"\w*, \w as well as|strong="H853"\w* \w the wickedness that|strong="H7451"\w* \w you|strong="H853"\w* \w and|strong="H7451"\w* \w your wives|strong="H802"\w* \w committed|strong="H6213"\w* \w in the land|strong="H776"\w* \w of Judah|strong="H3063"\w* \w and in the streets|strong="H2351"\w* \w of Jerusalem|strong="H3389"\w*? \v 10 \w To|strong="H5704"\w* \w this|strong="H2088"\w* \w day|strong="H3117"\w* \w they have not|strong="H3808"\w* \w humbled themselves|strong="H1792"\w* \w or|strong="H3808"\w* \w shown reverence|strong="H3372"\w*, \w nor|strong="H3808"\w* \w have they followed|strong="H1980"\w* \w My instruction|strong="H8451"\w* \w or the statutes|strong="H2708"\w* \w that|strong="H834"\w* \w I set|strong="H5414"\w* \w before you|strong="H6440"\w* \w and|strong="H6440"\w* \w your fathers|strong="H1"\w*.
\p \v 11 \w Therefore|strong="H3651"\w* \w this is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w says|strong="H559"\w*: \w I will set|strong="H7760"\w* \w My face|strong="H6440"\w* \w to bring disaster|strong="H7451"\w* \w and to cut off|strong="H3772"\w* \w all|strong="H3605"\w* \w Judah|strong="H3063"\w*. \v 12 \w And I will take away|strong="H3947"\w* \w the remnant|strong="H7611"\w* \w of Judah|strong="H3063"\w* \w who|strong="H834"\w* \w have resolved|strong="H7760"\w* \w to go|strong="H935"\w* \w to the land|strong="H776"\w* \w of Egypt|strong="H4714"\w* \w to reside there|strong="H8033"\w*; \w they will meet their end|strong="H8552"\w*. \w They will all|strong="H3605"\w* \w fall|strong="H5307"\w* \w by the sword|strong="H2719"\w* \w or be consumed|strong="H8552"\w* \w by famine|strong="H7458"\w*. \w From the least|strong="H6996"\w* \w to|strong="H5704"\w* \w the greatest|strong="H1419"\w*, \w they will die|strong="H4191"\w* \w by sword|strong="H2719"\w* \w or famine|strong="H7458"\w*; \w and they will become|strong="H1961"\w* \w an object of cursing|strong="H423"\w* \w and horror|strong="H8047"\w*, \w of vilification|strong="H7045"\w* \w and reproach|strong="H2781"\w*.
\p \v 13 \w I will punish|strong="H6485"\w* \w those who live|strong="H3427"\w* \w in the land|strong="H776"\w* \w of Egypt|strong="H4714"\w*, \w just as|strong="H834"\w* \w I punished|strong="H6485"\w* \w Jerusalem|strong="H3389"\w*, \w by sword|strong="H2719"\w* \w and famine|strong="H7458"\w* \w and plague|strong="H1698"\w*, \v 14 \w so that none of|strong="H3808"\w* \w the remnant|strong="H7611"\w* \w of Judah|strong="H3063"\w* \w who have gone|strong="H935"\w* \w to reside|strong="H1481"\w* \w in Egypt|strong="H4714"\w* \w will|strong="H1961"\w* \w escape|strong="H6412"\w* \w or survive|strong="H8300"\w* \w to return|strong="H7725"\w* \w to the land|strong="H776"\w* \w of Judah|strong="H3063"\w*, \w where|strong="H834"\w* \w they|strong="H1992"\w* \w long|strong="H5375"\w* \w to return|strong="H7725"\w* \w and live|strong="H3427"\w*; \w for|strong="H3588"\w* \w none|strong="H3808"\w* \w will return|strong="H7725"\w* \w except|strong="H3588"\w* \w a few fugitives|strong="H6412"\w*.”
\s1 The Stubbornness of the People
\p \v 15 \w Then all|strong="H3605"\w* \w the men|strong="H582"\w* \w who knew|strong="H3045"\w* \w that|strong="H3588"\w* \w their wives|strong="H802"\w* \w were burning incense|strong="H6999"\w* \w to other|strong="H312"\w* \w gods|strong="H430"\w*, \w and all|strong="H3605"\w* \w the women|strong="H802"\w* \w standing by|strong="H5975"\w*— \w a great|strong="H1419"\w* \w assembly|strong="H6951"\w*— \w along with all|strong="H3605"\w* \w the people|strong="H5971"\w* \w living|strong="H3427"\w* \w in the land|strong="H776"\w* \w of Egypt|strong="H4714"\w* \w and in Pathros|strong="H6624"\w*,\f + \fr 44:15 \ft That is, in Lower and Upper Egypt; possibly \fqa in the land of Egypt at Pathros\f* \w said|strong="H6030"\w* \w to Jeremiah|strong="H3414"\w*, \v 16 “\w As for the word|strong="H1697"\w* \w you have spoken|strong="H1696"\w* \w to us|strong="H413"\w* \w in the name|strong="H8034"\w* \w of the LORD|strong="H3068"\w*, \w we will not|strong="H369"\w* \w listen|strong="H8085"\w* \w to you|strong="H413"\w*! \v 17 \w Instead|strong="H3588"\w*, \w we will do|strong="H6213"\w* \w everything|strong="H3605"\w* \w we vowed|strong="H1697"\w* \w to do|strong="H3318"\w*: \w We will burn incense|strong="H6999"\w* \w to the Queen|strong="H4446"\w* \w of Heaven|strong="H8064"\w* \w and offer|strong="H5258"\w* \w drink offerings|strong="H5262"\w* to her, \w just as|strong="H834"\w* \w we|strong="H587"\w*, \w our fathers|strong="H1"\w*, \w our kings|strong="H4428"\w*, \w and our officials|strong="H8269"\w* \w did|strong="H6213"\w* \w in the cities|strong="H5892"\w* \w of Judah|strong="H3063"\w* \w and in the streets|strong="H2351"\w* \w of Jerusalem|strong="H3389"\w*.
\p \w At that time we had plenty|strong="H7646"\w* \w of food|strong="H3899"\w* \w and good things|strong="H2896"\w*, \w and we saw|strong="H7200"\w* \w no|strong="H3808"\w* \w disaster|strong="H7451"\w*. \v 18 \w But from the time|strong="H4480"\w* \w we stopped|strong="H2308"\w* \w burning incense|strong="H6999"\w* \w to the Queen|strong="H4446"\w* \w of Heaven|strong="H8064"\w* \w and pouring out|strong="H5258"\w* \w drink offerings|strong="H5262"\w* to her, \w we have lacked|strong="H2637"\w* \w everything|strong="H3605"\w* \w and have been perishing|strong="H8552"\w* \w by sword|strong="H2719"\w* \w and famine|strong="H7458"\w*.”
