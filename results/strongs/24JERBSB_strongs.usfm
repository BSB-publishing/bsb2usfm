\c 7
\s1 Jeremiah’s Message at the Temple Gate
\p \v 1 \w This is the word|strong="H1697"\w* \w that|strong="H834"\w* \w came|strong="H1961"\w* \w to|strong="H413"\w* \w Jeremiah|strong="H3414"\w* \w from the LORD|strong="H3068"\w*, \w saying|strong="H559"\w*, \v 2 “\w Stand|strong="H5975"\w* \w in the gate|strong="H8179"\w* \w of the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w* \w and proclaim|strong="H7121"\w* \w this|strong="H2088"\w* \w message|strong="H1697"\w*: \w Hear|strong="H8085"\w* \w the word|strong="H1697"\w* \w of the LORD|strong="H3068"\w*, \w all|strong="H3605"\w* \w you people of Judah|strong="H3063"\w* \w who enter|strong="H935"\w* \w through these|strong="H428"\w* \w gates|strong="H8179"\w* \w to worship|strong="H7812"\w* \w the LORD|strong="H3068"\w*. \v 3 \w Thus|strong="H3541"\w* \w says|strong="H559"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*: \w Correct|strong="H3190"\w* \w your ways|strong="H1870"\w* \w and deeds|strong="H4611"\w*, \w and I will let you live|strong="H7931"\w* \w in this|strong="H2088"\w* \w place|strong="H4725"\w*. \v 4 \w Do not|strong="H408"\w* \w trust|strong="H982"\w* \w in|strong="H413"\w* \w deceptive|strong="H8267"\w* \w words|strong="H1697"\w*, \w saying|strong="H559"\w*:
\b 
\q1 ‘\w This is|strong="H1992"\w* \w the temple|strong="H1964"\w* \w of the LORD|strong="H3068"\w*,
\q2 \w the temple|strong="H1964"\w* \w of the LORD|strong="H3068"\w*,
\q2 \w the temple|strong="H1964"\w* \w of the LORD|strong="H3068"\w*.’
\p \v 5 \w For|strong="H3588"\w* \w if|strong="H518"\w* \w you really correct|strong="H3190"\w* \w your ways|strong="H1870"\w* \w and deeds|strong="H4611"\w*, \w if|strong="H518"\w* \w you act|strong="H6213"\w* \w justly|strong="H4941"\w* \w toward one|strong="H376"\w* \w another|strong="H7453"\w*, \v 6 \w if you no|strong="H3808"\w* \w longer oppress|strong="H6231"\w* \w the foreigner|strong="H1616"\w* \w and the fatherless|strong="H3490"\w* \w and the widow|strong="H490"\w*, \w and if you no|strong="H408"\w* \w longer shed|strong="H8210"\w* \w innocent|strong="H5355"\w* \w blood|strong="H1818"\w* \w in this|strong="H2088"\w* \w place|strong="H4725"\w* \w or follow|strong="H310"\w* \w other|strong="H312"\w* \w gods|strong="H430"\w* \w to your own harm|strong="H7451"\w*, \v 7 \w then I will let you live|strong="H7931"\w* \w in this|strong="H2088"\w* \w place|strong="H4725"\w*, \w in the land|strong="H776"\w* \w that|strong="H834"\w* \w I gave|strong="H5414"\w* \w to your fathers|strong="H1"\w* \w forever|strong="H4480"\w* \w and|strong="H5704"\w* \w ever|strong="H5769"\w*.
\p \v 8 \w But look|strong="H2009"\w*, \w you|strong="H859"\w* \w keep trusting|strong="H982"\w* \w in|strong="H5921"\w* \w deceptive|strong="H8267"\w* \w words|strong="H1697"\w* \w to no|strong="H1115"\w* \w avail|strong="H3276"\w*. \v 9 \w Will you steal|strong="H1589"\w* \w and murder|strong="H7523"\w*, \w commit adultery|strong="H5003"\w* \w and perjury|strong="H7650"\w*, \w burn incense|strong="H6999"\w* \w to Baal|strong="H1168"\w*, \w and follow|strong="H1980"\w* \w other|strong="H312"\w* \w gods|strong="H430"\w* \w that|strong="H834"\w* \w you have not|strong="H3808"\w* \w known|strong="H3045"\w*, \v 10 \w and then come|strong="H935"\w* \w and stand|strong="H5975"\w* \w before Me|strong="H6440"\w* \w in this|strong="H2088"\w* \w house|strong="H1004"\w*, \w which bears|strong="H7121"\w* \w My Name|strong="H8034"\w*, \w and say|strong="H559"\w*, ‘\w We are delivered|strong="H5337"\w*, \w so|strong="H4616"\w* \w we can continue with|strong="H6213"\w* \w all|strong="H3605"\w* \w these|strong="H428"\w* \w abominations|strong="H8441"\w*’? \v 11 \w Has this|strong="H2088"\w* \w house|strong="H1004"\w*, \w which|strong="H834"\w* \w bears|strong="H7121"\w* \w My Name|strong="H8034"\w*, \w become|strong="H1961"\w* \w a den|strong="H4631"\w* \w of robbers|strong="H6530"\w*\f + \fr 7:11 \ft Cited in \ref Matthew 21:13|MAT 21:13\ref*, Mark 11:17, and Luke 19:46\f* \w in|strong="H5921"\w* \w your sight|strong="H5869"\w*? \w Yes|strong="H2009"\w*, \w I|strong="H595"\w* \w too|strong="H1571"\w* \w have seen it|strong="H7200"\w*, \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*.
\p \v 12 \w But|strong="H3588"\w* \w go|strong="H1980"\w* \w now|strong="H4994"\w* \w to|strong="H413"\w* \w the place|strong="H4725"\w* \w in Shiloh|strong="H7887"\w* \w where|strong="H834"\w* \w I first|strong="H7223"\w* \w made a dwelling|strong="H7931"\w* \w for My Name|strong="H8034"\w*, \w and see|strong="H7200"\w* \w what|strong="H834"\w* \w I did|strong="H6213"\w* to it \w because of|strong="H6440"\w* \w the wickedness|strong="H7451"\w* \w of My people|strong="H5971"\w* \w Israel|strong="H3478"\w*. \v 13 \w And now|strong="H6258"\w*, \w because|strong="H3282"\w* \w you have done|strong="H6213"\w* \w all|strong="H3605"\w* \w these|strong="H428"\w* \w things|strong="H4639"\w*, \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*, \w and because I have spoken|strong="H1696"\w* \w to you|strong="H413"\w* \w again and again|strong="H7925"\w*\f + \fr 7:13 \ft Literally \fqa I have spoken to you, rising up early and speaking,\f* \w but you would not|strong="H3808"\w* \w listen|strong="H8085"\w*, \w and I have called|strong="H7121"\w* \w to you|strong="H853"\w* \w but you would not|strong="H3808"\w* \w answer|strong="H6030"\w*, \v 14 \w therefore what I did|strong="H6213"\w* \w to Shiloh|strong="H7887"\w* \w I will now do|strong="H6213"\w* \w to the house|strong="H1004"\w* \w that|strong="H834"\w* \w bears|strong="H7121"\w* \w My Name|strong="H8034"\w*, \w the house in which|strong="H834"\w* \w you|strong="H859"\w* \w trust|strong="H982"\w*, \w the place|strong="H4725"\w* \w that|strong="H834"\w* \w I gave|strong="H5414"\w* to you \w and your fathers|strong="H1"\w*. \v 15 \w And I will cast|strong="H7993"\w* \w you|strong="H853"\w* \w out of|strong="H5921"\w* \w My presence|strong="H6440"\w*, \w just as|strong="H834"\w* \w I have cast out|strong="H7993"\w* \w all|strong="H3605"\w* \w your brothers|strong="H251"\w*, \w all|strong="H3605"\w* \w the descendants|strong="H2233"\w* \w of Ephraim|strong="H669"\w*.
\s1 Judah’s Idolatry Persists
\p \v 16 \w As for you|strong="H859"\w*, \w do not|strong="H408"\w* \w pray|strong="H6419"\w* \w for|strong="H1157"\w* \w these|strong="H2088"\w* \w people|strong="H5971"\w*, \w do not|strong="H408"\w* \w offer|strong="H5375"\w* \w a plea|strong="H7440"\w* \w or petition|strong="H8605"\w* \w on their behalf|strong="H1157"\w*, \w and do not|strong="H408"\w* \w beg|strong="H6293"\w* Me, \w for|strong="H3588"\w* \w I will not|strong="H369"\w* \w listen|strong="H8085"\w* \w to you|strong="H853"\w*. \v 17 \w Do you not|strong="H369"\w* \w see|strong="H7200"\w* \w what|strong="H4100"\w* \w they|strong="H1992"\w* \w are doing|strong="H6213"\w* \w in the cities|strong="H5892"\w* \w of Judah|strong="H3063"\w* \w and in the streets|strong="H2351"\w* \w of Jerusalem|strong="H3389"\w*? \v 18 \w The sons|strong="H1121"\w* \w gather|strong="H3950"\w* \w wood|strong="H6086"\w*, \w the fathers|strong="H1"\w* \w light|strong="H1197"\w* \w the fire|strong="H784"\w*, \w and the women|strong="H802"\w* \w knead|strong="H3888"\w* \w the dough|strong="H1217"\w* \w to make|strong="H6213"\w* \w cakes|strong="H3561"\w* \w for the Queen|strong="H4446"\w* \w of Heaven|strong="H8064"\w*; \w they pour out|strong="H5258"\w* \w drink offerings|strong="H5262"\w* \w to other|strong="H312"\w* \w gods|strong="H430"\w* \w to|strong="H4616"\w* \w provoke Me to anger|strong="H3707"\w*. \v 19 \w But am I the One|strong="H1992"\w* \w they are provoking|strong="H3707"\w*? \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*. \w Is it not|strong="H3808"\w* \w themselves|strong="H853"\w* \w they spite|strong="H4616"\w*, \w to their own shame|strong="H1322"\w*?
\p \v 20 \w Therefore|strong="H3651"\w* \w this is what|strong="H3541"\w* \w the Lord|strong="H136"\w* \w GOD|strong="H3069"\w* \w says|strong="H559"\w*: \w Behold|strong="H2009"\w*, \w My anger|strong="H639"\w* \w and My fury|strong="H2534"\w* \w will|strong="H5413"\w* \w be poured out on|strong="H413"\w* \w this|strong="H2088"\w* \w place|strong="H4725"\w*, \w on|strong="H5921"\w* \w man|strong="H120"\w* \w and beast|strong="H929"\w*, \w on|strong="H5921"\w* \w the trees|strong="H6086"\w* \w of the field|strong="H7704"\w* \w and|strong="H5921"\w* \w the produce|strong="H6529"\w* \w of the land|strong="H127"\w*, \w and it will burn|strong="H1197"\w* \w and not|strong="H3808"\w* \w be extinguished|strong="H3518"\w*.
\p \v 21 \w This is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w says|strong="H559"\w*: \w Add your burnt offerings|strong="H5930"\w* \w to|strong="H5921"\w* \w your other sacrifices|strong="H2077"\w* \w and eat|strong="H398"\w* \w the meat yourselves|strong="H1320"\w*! \v 22 \w For|strong="H3588"\w* \w when|strong="H3117"\w* \w I brought|strong="H3318"\w* \w your fathers|strong="H1"\w* \w out of the land|strong="H776"\w* \w of Egypt|strong="H4714"\w*, \w I did not merely|strong="H3808"\w* \w command them|strong="H6680"\w* \w about|strong="H5921"\w* \w burnt offerings|strong="H5930"\w* \w and sacrifices|strong="H2077"\w*, \v 23 \w but|strong="H3588"\w* \w this is what|strong="H2088"\w* \w I commanded them|strong="H6680"\w*: \w Obey Me|strong="H8085"\w*, \w and I will be|strong="H1961"\w* your \w God|strong="H430"\w*, \w and you|strong="H859"\w* \w will be|strong="H1961"\w* My \w people|strong="H5971"\w*. \w You must walk|strong="H1980"\w* \w in all|strong="H3605"\w* \w the ways|strong="H1870"\w* \w I have commanded|strong="H6680"\w* \w you|strong="H853"\w*, \w so that|strong="H4616"\w* \w it may go well|strong="H3190"\w* with you.
\p \v 24 \w Yet they did not|strong="H3808"\w* \w listen|strong="H8085"\w* \w or|strong="H3808"\w* \w incline|strong="H5186"\w* \w their ear|strong="H241"\w*, \w but they followed|strong="H1980"\w* \w the stubborn|strong="H8307"\w* \w inclinations|strong="H4156"\w* \w of their own evil|strong="H7451"\w* \w hearts|strong="H3820"\w*. \w They went|strong="H1961"\w* \w backward|strong="H268"\w* \w and not|strong="H3808"\w* \w forward|strong="H6440"\w*. \v 25 \w From|strong="H4480"\w* \w the day|strong="H3117"\w* \w your fathers|strong="H1"\w* \w came out|strong="H3318"\w* \w of the land|strong="H776"\w* \w of Egypt|strong="H4714"\w* \w until|strong="H5704"\w* \w this|strong="H2088"\w* \w day|strong="H3117"\w*, \w I have sent|strong="H7971"\w* \w you|strong="H413"\w* \w all|strong="H3605"\w* \w My servants|strong="H5650"\w* \w the prophets|strong="H5030"\w* \w again and again|strong="H7925"\w*.\f + \fr 7:25 \ft Literally \fqa I have sent you all My servants the prophets daily, rising up early and sending (them).\f* \v 26 \w Yet they would not|strong="H3808"\w* \w listen|strong="H8085"\w* \w to Me|strong="H413"\w* \w or|strong="H3808"\w* \w incline|strong="H5186"\w* \w their ear|strong="H241"\w*, \w but they stiffened|strong="H7185"\w* \w their necks|strong="H6203"\w* \w and did more evil|strong="H7489"\w* \w than their fathers|strong="H1"\w*.
\p \v 27 \w When you tell|strong="H1696"\w* \w them|strong="H413"\w* \w all|strong="H3605"\w* \w these|strong="H428"\w* \w things|strong="H1697"\w*, \w they will not|strong="H3808"\w* \w listen|strong="H8085"\w* \w to you|strong="H413"\w*. \w When you call|strong="H7121"\w* \w to them|strong="H413"\w*, \w they will not|strong="H3808"\w* \w answer|strong="H6030"\w*. \v 28 \w Therefore you must say|strong="H559"\w* \w to them|strong="H413"\w*, ‘\w This|strong="H2088"\w* \w is the nation|strong="H1471"\w* \w that|strong="H834"\w* \w would not|strong="H3808"\w* \w listen|strong="H8085"\w* \w to the voice|strong="H6963"\w* \w of the LORD|strong="H3068"\w* \w their God|strong="H430"\w* \w and would not|strong="H3808"\w* \w receive|strong="H3947"\w* \w correction|strong="H4148"\w*. \w Truth|strong="H530"\w* \w has perished|strong="H6"\w*; \w it has disappeared|strong="H3772"\w* \w from their lips|strong="H6310"\w*. \v 29 \w Cut off|strong="H1494"\w* \w your hair|strong="H5145"\w* \w and throw it away|strong="H7993"\w*. \w Raise up|strong="H5375"\w* \w a lamentation|strong="H7015"\w* \w on|strong="H5921"\w* \w the barren heights|strong="H8205"\w*, \w for|strong="H3588"\w* \w the LORD|strong="H3068"\w* \w has rejected|strong="H3988"\w* \w and forsaken|strong="H5203"\w* \w the generation|strong="H1755"\w* \w of His wrath|strong="H5678"\w*.’
\s1 The Valley of Slaughter
\p \v 30 \w For|strong="H3588"\w* \w the people|strong="H1121"\w* \w of Judah|strong="H3063"\w* \w have done|strong="H6213"\w* \w evil|strong="H7451"\w* \w in My sight|strong="H5869"\w*, \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*. \w They have set up|strong="H7760"\w* \w their abominations|strong="H8251"\w* \w in the house|strong="H1004"\w* \w that|strong="H834"\w* \w bears|strong="H7121"\w* \w My Name|strong="H8034"\w*, \w and so have defiled it|strong="H2930"\w*. \v 31 \w They have built|strong="H1129"\w* \w the high places|strong="H1116"\w* \w of Topheth|strong="H8612"\w* \w in the Valley of Ben-hinnom|strong="H1516"\w* \w so they could burn|strong="H8313"\w* \w their sons|strong="H1121"\w* \w and daughters|strong="H1323"\w* \w in the fire|strong="H784"\w* — \w something I never|strong="H3808"\w* \w commanded|strong="H6680"\w*, \w nor|strong="H3808"\w* \w did it even enter|strong="H5927"\w* \w My mind|strong="H3820"\w*.
\p \v 32 \w So|strong="H3651"\w* \w behold|strong="H2009"\w*, \w the days|strong="H3117"\w* \w are coming|strong="H935"\w*, \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*, \w when this place will no|strong="H3808"\w* \w longer|strong="H5750"\w* \w be called|strong="H559"\w* \w Topheth|strong="H8612"\w* \w and the Valley of Ben-hinnom|strong="H1516"\w*, \w but|strong="H3588"\w* \w the Valley|strong="H1516"\w* \w of Slaughter|strong="H2028"\w*. \w For they will bury the dead|strong="H6912"\w* \w in Topheth|strong="H8612"\w* \w until there is no|strong="H369"\w* \w more room|strong="H4725"\w*. \v 33 \w The corpses|strong="H5038"\w* \w of this|strong="H2088"\w* \w people|strong="H5971"\w* \w will become|strong="H1961"\w* \w food|strong="H3978"\w* \w for the birds|strong="H5775"\w* \w of the air|strong="H8064"\w* \w and the beasts|strong="H929"\w* \w of the earth|strong="H776"\w*, \w and there will be no one|strong="H369"\w* \w to scare them away|strong="H2729"\w*.
\p \v 34 \w I will remove|strong="H7673"\w* \w from the cities|strong="H5892"\w* \w of Judah|strong="H3063"\w* \w and the streets|strong="H2351"\w* \w of Jerusalem|strong="H3389"\w* \w the sounds|strong="H6963"\w* \w of joy|strong="H8342"\w* \w and gladness|strong="H8057"\w* \w and the voices|strong="H6963"\w* \w of the bride|strong="H3618"\w* \w and|strong="H6963"\w* \w bridegroom|strong="H2860"\w*, \w for|strong="H3588"\w* \w the land|strong="H776"\w* \w will become|strong="H1961"\w* \w a wasteland|strong="H2723"\w*.”
\c 8
\s1 Judah’s Sin and Punishment
\p \v 1 “\w At that|strong="H1931"\w* \w time|strong="H6256"\w*,” \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*, “\w the bones|strong="H6106"\w* \w of the kings|strong="H4428"\w* \w of Judah|strong="H3063"\w*, \w the bones|strong="H6106"\w* \w of the officials|strong="H8269"\w*, \w the bones|strong="H6106"\w* \w of the priests|strong="H3548"\w*, \w the bones|strong="H6106"\w* \w of the prophets|strong="H5030"\w*, \w and the bones|strong="H6106"\w* \w of the people|strong="H3427"\w* \w of Jerusalem|strong="H3389"\w* \w will be removed|strong="H3318"\w* \w from their graves|strong="H6913"\w*. \v 2 \w They will be exposed|strong="H7849"\w* \w to the sun|strong="H8121"\w* \w and moon|strong="H3394"\w*, \w and to all|strong="H3605"\w* \w the host|strong="H6635"\w* \w of heaven|strong="H8064"\w* \w which|strong="H834"\w* \w they have loved|strong="H157"\w*, \w served|strong="H5647"\w*, \w followed|strong="H1980"\w*, \w consulted|strong="H1875"\w*, \w and worshiped|strong="H7812"\w*. \w Their bones will not|strong="H3808"\w* \w be gathered up|strong="H622"\w* \w or|strong="H3808"\w* \w buried|strong="H6912"\w*, \w but will become|strong="H1961"\w* \w like dung|strong="H1828"\w* \w lying on|strong="H5921"\w* \w the ground|strong="H127"\w*. \v 3 \w And wherever|strong="H3605"\w* \w I have banished them|strong="H5080"\w*, \w the remnant|strong="H7611"\w* \w of this|strong="H2063"\w* \w evil|strong="H7451"\w* \w family|strong="H4940"\w* \w will choose|strong="H977"\w* \w death|strong="H4194"\w* \w over|strong="H4480"\w* \w life|strong="H2416"\w*,” \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*.
\p \v 4 \w So you are to tell|strong="H559"\w* \w them|strong="H413"\w* \w this is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w says|strong="H559"\w*:
