\p \v 15 \w Again|strong="H7925"\w* \w and again|strong="H7971"\w* \w I have sent|strong="H7971"\w* \w you|strong="H413"\w*\f + \fr 35:15 \ft Literally \fqa Rising up early and sending (you), I have sent you\f* \w all|strong="H3605"\w* \w My servants|strong="H5650"\w* \w the prophets|strong="H5030"\w*, \w proclaiming|strong="H559"\w*: ‘\w Turn|strong="H7725"\w* \w now|strong="H4994"\w*, \w each of you|strong="H376"\w*, \w from your wicked|strong="H7451"\w* \w ways|strong="H1870"\w*, \w and correct|strong="H3190"\w* \w your actions|strong="H4611"\w*. \w Do not|strong="H408"\w* \w go after|strong="H1980"\w* \w other|strong="H312"\w* \w gods|strong="H430"\w* \w to serve them|strong="H5647"\w*. \w Live|strong="H3427"\w* \w in|strong="H413"\w* \w the land|strong="H127"\w* \w that|strong="H834"\w* \w I have given|strong="H5414"\w* to you \w and your fathers|strong="H1"\w*.’ \w But you have not|strong="H3808"\w* \w inclined|strong="H5186"\w* \w your ear|strong="H241"\w* \w or|strong="H3808"\w* \w listened|strong="H8085"\w* \w to Me|strong="H413"\w*. \v 16 \w Yes|strong="H3588"\w*, \w the sons|strong="H1121"\w* \w of Jonadab|strong="H3082"\w* \w son|strong="H1121"\w* \w of Rechab|strong="H7394"\w* \w carried out|strong="H6965"\w* \w the command|strong="H4687"\w* \w their forefather|strong="H1"\w* \w gave them|strong="H6680"\w*, \w but these|strong="H2088"\w* \w people|strong="H5971"\w* \w have not|strong="H3808"\w* \w listened|strong="H8085"\w* \w to Me|strong="H413"\w*.
\p \v 17 \w Therefore|strong="H3651"\w* \w this is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w God|strong="H430"\w* \w of Hosts|strong="H6635"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w says|strong="H559"\w*: ‘\w Behold|strong="H2005"\w*, \w I will bring|strong="H935"\w* \w to|strong="H413"\w* \w Judah|strong="H3063"\w* \w and to|strong="H413"\w* \w all|strong="H3605"\w* \w the residents|strong="H3427"\w* \w of Jerusalem|strong="H3389"\w* \w all|strong="H3605"\w* \w the disaster|strong="H7451"\w* \w I have pronounced|strong="H1696"\w* \w against them|strong="H5921"\w*, \w because|strong="H3282"\w* \w I have spoken|strong="H1696"\w* \w to them|strong="H413"\w* \w but they have not|strong="H3808"\w* \w obeyed|strong="H8085"\w*, \w and I have called|strong="H7121"\w* to them \w but they have not|strong="H3808"\w* \w answered|strong="H6030"\w*.’”
\p \v 18 \w Then Jeremiah|strong="H3414"\w* \w said|strong="H559"\w* \w to the house|strong="H1004"\w* \w of the Rechabites|strong="H7397"\w*: “\w This is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w says|strong="H559"\w*: ‘\w Because|strong="H3282"\w* \w you have obeyed|strong="H8085"\w* \w the command|strong="H4687"\w* \w of your forefather|strong="H1"\w* \w Jonadab|strong="H3082"\w* \w and have kept|strong="H8104"\w* \w all|strong="H3605"\w* \w his commandments|strong="H4687"\w* \w and have done|strong="H6213"\w* \w all|strong="H3605"\w* \w that|strong="H834"\w* \w he charged you to do|strong="H6680"\w*, \v 19 \w this is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w says|strong="H559"\w*: \w Jonadab|strong="H3122"\w* \w son|strong="H1121"\w* \w of Rechab|strong="H7394"\w* \w will never|strong="H3808"\w* \w fail to have|strong="H3772"\w* \w a man|strong="H376"\w* \w to stand|strong="H5975"\w* \w before Me|strong="H6440"\w*.’”
\c 36
\s1 Jeremiah’s Scroll Read in the Temple
\p \v 1 \w In the fourth|strong="H7243"\w* \w year|strong="H8141"\w* \w of Jehoiakim|strong="H3079"\w* \w son|strong="H1121"\w* \w of Josiah|strong="H2977"\w* \w king|strong="H4428"\w* \w of Judah|strong="H3063"\w*, \w this|strong="H2088"\w* \w word|strong="H1697"\w* \w came|strong="H1961"\w* \w to|strong="H413"\w* \w Jeremiah|strong="H3414"\w* \w from the LORD|strong="H3068"\w*: \v 2 “\w Take|strong="H3947"\w* \w a scroll|strong="H4039"\w* \w and write|strong="H3789"\w* \w on|strong="H413"\w* \w it all|strong="H3605"\w* \w the words|strong="H1697"\w* \w I have spoken|strong="H1696"\w* \w to|strong="H413"\w* \w you concerning|strong="H5921"\w* \w Israel|strong="H3478"\w*, \w Judah|strong="H3063"\w*, \w and all|strong="H3605"\w* \w the nations|strong="H1471"\w*, \w from the day|strong="H3117"\w* \w I first spoke|strong="H1696"\w* \w to you|strong="H413"\w* \w during the reign|strong="H3117"\w* \w of Josiah|strong="H2977"\w* \w until today|strong="H5704"\w*. \v 3 \w Perhaps|strong="H194"\w* \w when the people|strong="H1004"\w* \w of Judah|strong="H3063"\w* \w hear|strong="H8085"\w* \w about all|strong="H3605"\w* \w the calamity|strong="H7451"\w* \w I|strong="H595"\w* \w plan|strong="H2803"\w* \w to bring|strong="H6213"\w* upon them, \w each of them|strong="H376"\w* \w will turn|strong="H7725"\w* \w from his wicked|strong="H7451"\w* \w way|strong="H1870"\w*. \w Then I will forgive|strong="H5545"\w* \w their iniquity|strong="H5771"\w* \w and their sin|strong="H2403"\w*.”
\p \v 4 \w So Jeremiah|strong="H3414"\w* \w called|strong="H7121"\w* \w Baruch|strong="H1263"\w* \w son|strong="H1121"\w* \w of Neriah|strong="H5374"\w*, \w and at the dictation|strong="H6310"\w* \w of Jeremiah|strong="H3414"\w*, \w Baruch|strong="H1263"\w* \w wrote|strong="H3789"\w* \w on|strong="H5921"\w* \w a scroll|strong="H4039"\w* \w all|strong="H3605"\w* \w the words|strong="H1697"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had spoken|strong="H1696"\w* \w to Jeremiah|strong="H413"\w*.
\p \v 5 \w Then Jeremiah|strong="H3414"\w* \w commanded|strong="H6680"\w* \w Baruch|strong="H1263"\w*, “\w I|strong="H589"\w* \w am restricted|strong="H6113"\w*; \w I cannot|strong="H3808"\w* \w enter|strong="H935"\w* \w the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*; \v 6 \w so you|strong="H859"\w* \w are to go|strong="H935"\w* \w to the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w* \w on a day|strong="H3117"\w* \w of fasting|strong="H6685"\w*, \w and in the hearing|strong="H241"\w* \w of the people|strong="H5971"\w* \w you are to read|strong="H7121"\w* \w the words|strong="H1697"\w* \w of the LORD|strong="H3068"\w* \w from the scroll|strong="H4039"\w* \w you have written|strong="H3789"\w* \w at my dictation|strong="H6310"\w*. \w Read them|strong="H7121"\w* \w in the hearing|strong="H241"\w* \w of all|strong="H3605"\w* \w the people of Judah|strong="H3063"\w* \w who are coming|strong="H935"\w* \w from their cities|strong="H5892"\w*.
\p \v 7 \w Perhaps|strong="H194"\w* \w they will bring|strong="H5307"\w* \w their petition|strong="H8467"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*, \w and each|strong="H376"\w* \w one will turn|strong="H7725"\w* \w from his wicked|strong="H7451"\w* \w way|strong="H1870"\w*; \w for|strong="H3588"\w* \w great are|strong="H1419"\w* \w the anger|strong="H639"\w* \w and fury|strong="H2534"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w has pronounced|strong="H1696"\w* \w against|strong="H413"\w* \w this|strong="H2088"\w* \w people|strong="H5971"\w*.”
\p \v 8 \w So Baruch|strong="H1263"\w* \w son|strong="H1121"\w* \w of Neriah|strong="H5374"\w* \w did|strong="H6213"\w* \w everything|strong="H3605"\w* \w that|strong="H834"\w* \w Jeremiah|strong="H3414"\w* \w the prophet|strong="H5030"\w* \w had commanded him|strong="H6680"\w*. \w In the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w* \w he read|strong="H7121"\w* \w the words|strong="H1697"\w* \w of the LORD|strong="H3068"\w* \w from the scroll|strong="H5612"\w*.
\p \v 9 \w Now|strong="H1961"\w* \w in the ninth|strong="H8671"\w* \w month|strong="H2320"\w* \w of the fifth|strong="H2549"\w* \w year|strong="H8141"\w* \w of Jehoiakim|strong="H3079"\w* \w son|strong="H1121"\w* \w of Josiah|strong="H2977"\w* \w king|strong="H4428"\w* \w of Judah|strong="H3063"\w*, \w a fast|strong="H6685"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w was proclaimed|strong="H7121"\w* \w to all|strong="H3605"\w* \w the people|strong="H5971"\w* \w of Jerusalem|strong="H3389"\w* \w and all|strong="H3605"\w* \w who had come|strong="H935"\w* \w there|strong="H3389"\w* \w from the cities|strong="H5892"\w* \w of Judah|strong="H3063"\w*. \v 10 \w From the chamber|strong="H3957"\w* \w of Gemariah|strong="H1587"\w* \w son|strong="H1121"\w* \w of Shaphan|strong="H8227"\w* \w the scribe|strong="H5608"\w*, \w which was in the upper|strong="H5945"\w* \w courtyard|strong="H2691"\w* \w at the opening|strong="H6607"\w* \w of the New|strong="H2319"\w* \w Gate|strong="H8179"\w* \w of the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*, \w Baruch|strong="H1263"\w* \w read|strong="H7121"\w* \w from the scroll|strong="H5612"\w* \w the words|strong="H1697"\w* \w of Jeremiah|strong="H3414"\w* \w in the hearing|strong="H241"\w* \w of all|strong="H3605"\w* \w the people|strong="H5971"\w*.
\s1 Jeremiah’s Scroll Read in the Palace
\p \v 11 \w When Micaiah|strong="H4321"\w* \w son|strong="H1121"\w* \w of Gemariah|strong="H1587"\w*, \w the son|strong="H1121"\w* \w of Shaphan|strong="H8227"\w*, \w heard|strong="H8085"\w* \w all|strong="H3605"\w* \w the words|strong="H1697"\w* \w of the LORD|strong="H3068"\w* \w from|strong="H5921"\w* \w the scroll|strong="H5612"\w*, \v 12 \w he went down|strong="H3381"\w* \w to|strong="H5921"\w* \w the scribe’s|strong="H5608"\w* \w chamber|strong="H3957"\w* \w in the king’s|strong="H4428"\w* \w palace|strong="H1004"\w*, \w where|strong="H8033"\w* \w all|strong="H3605"\w* \w the officials|strong="H8269"\w* \w were sitting|strong="H3427"\w*: \w Elishama|strong="H476"\w* \w the scribe|strong="H5608"\w*, \w Delaiah|strong="H1806"\w* \w son|strong="H1121"\w* \w of Shemaiah|strong="H8098"\w*, \w Elnathan|strong="H494"\w* \w son|strong="H1121"\w* \w of Achbor|strong="H5907"\w*, \w Gemariah|strong="H1587"\w* \w son|strong="H1121"\w* \w of Shaphan|strong="H8227"\w*, \w Zedekiah|strong="H6667"\w* \w son|strong="H1121"\w* \w of Hananiah|strong="H2608"\w*, \w and all|strong="H3605"\w* \w the other officials|strong="H8269"\w*. \v 13 \w And Micaiah|strong="H4321"\w* \w reported|strong="H5046"\w* to them \w all|strong="H3605"\w* \w the words|strong="H1697"\w* \w he had heard|strong="H8085"\w* \w Baruch|strong="H1263"\w* \w read|strong="H7121"\w* \w from the scroll|strong="H5612"\w* \w in the hearing|strong="H241"\w* \w of the people|strong="H5971"\w*.
\p \v 14 \w Then all|strong="H3605"\w* \w the officials|strong="H8269"\w* \w sent|strong="H7971"\w* \w word to|strong="H413"\w* \w Baruch|strong="H1263"\w* \w through Jehudi|strong="H3065"\w* \w son|strong="H1121"\w* \w of Nethaniah|strong="H5418"\w*, \w the son|strong="H1121"\w* \w of Shelemiah|strong="H8018"\w*, \w the son|strong="H1121"\w* \w of Cushi|strong="H3570"\w*, \w saying|strong="H559"\w*, “\w Bring|strong="H3947"\w* \w the scroll|strong="H4039"\w* \w that|strong="H834"\w* \w you read|strong="H7121"\w* in \w the hearing|strong="H241"\w* \w of the people|strong="H5971"\w*, \w and come here|strong="H1980"\w*.”
\p \w So Baruch|strong="H1263"\w* \w son|strong="H1121"\w* \w of Neriah|strong="H5374"\w* \w took|strong="H3947"\w* \w the scroll|strong="H4039"\w* \w and went|strong="H935"\w* \w to them|strong="H413"\w*.
\p \v 15 “\w Please|strong="H4994"\w* \w sit down|strong="H3427"\w*,” \w they said|strong="H559"\w*, “\w and read|strong="H7121"\w* \w it in our hearing|strong="H241"\w*.”
\p \w So Baruch|strong="H1263"\w* \w read|strong="H7121"\w* \w it in their hearing|strong="H241"\w*.
\p \v 16 \w When they had heard|strong="H8085"\w* \w all|strong="H3605"\w* \w these words|strong="H1697"\w*, \w they turned to|strong="H413"\w* \w one|strong="H376"\w* \w another|strong="H7453"\w* \w in fear|strong="H6342"\w* \w and said|strong="H559"\w* \w to|strong="H413"\w* \w Baruch|strong="H1263"\w*, “\w Surely we must report|strong="H5046"\w* \w all|strong="H3605"\w* \w these|strong="H428"\w* \w words|strong="H1697"\w* \w to the king|strong="H4428"\w*.”
\p \v 17 “\w Tell|strong="H5046"\w* us \w now|strong="H4994"\w*,” \w they asked|strong="H7592"\w* \w Baruch|strong="H1263"\w*, “\w how|strong="H349"\w* \w did you write|strong="H3789"\w* \w all|strong="H3605"\w* \w these|strong="H428"\w* \w words|strong="H1697"\w*? \w Was it at Jeremiah’s dictation|strong="H6310"\w*?”
\p \v 18 “It was at \w his dictation|strong="H6310"\w*,” \w Baruch|strong="H1263"\w* \w replied|strong="H559"\w*. “\w He recited|strong="H7121"\w* \w all|strong="H3605"\w* \w these|strong="H428"\w* \w words|strong="H1697"\w* \w to me|strong="H413"\w* \w and I|strong="H589"\w* \w wrote them|strong="H3789"\w* \w in ink|strong="H1773"\w* \w on|strong="H5921"\w* \w the scroll|strong="H5612"\w*.”
\p \v 19 \w Then the officials|strong="H8269"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w Baruch|strong="H1263"\w*, “\w You|strong="H859"\w* \w and Jeremiah|strong="H3414"\w* \w must hide yourselves|strong="H5641"\w* \w and tell|strong="H3045"\w* \w no|strong="H408"\w* \w one|strong="H376"\w* \w where|strong="H375"\w* \w you are|strong="H859"\w*.”
\s1 Jehoiakim Burns the Scroll
\p \v 20 \w So the officials went|strong="H935"\w* \w to|strong="H413"\w* \w the king|strong="H4428"\w* \w in the courtyard|strong="H2691"\w*. \w And|strong="H853"\w* \w having stored|strong="H6485"\w* \w the scroll|strong="H4039"\w* \w in the chamber|strong="H3957"\w* \w of Elishama|strong="H476"\w* \w the scribe|strong="H5608"\w*, \w they reported|strong="H5046"\w* \w everything|strong="H3605"\w* \w to|strong="H241"\w* \w the king|strong="H4428"\w*.
\p \v 21 \w Then the king|strong="H4428"\w* \w sent|strong="H7971"\w* \w Jehudi|strong="H3065"\w* \w to get|strong="H3947"\w* \w the scroll|strong="H4039"\w*, \w and he took it|strong="H3947"\w* \w from the chamber|strong="H3957"\w* \w of Elishama|strong="H476"\w* \w the scribe|strong="H5608"\w*. \w And Jehudi|strong="H3065"\w* \w read it|strong="H7121"\w* \w in the hearing|strong="H241"\w* \w of the king|strong="H4428"\w* \w and all|strong="H3605"\w* \w the officials|strong="H8269"\w* \w who were standing|strong="H5975"\w* \w beside|strong="H5921"\w* \w him|strong="H4428"\w*.
\p \v 22 \w Since it was the ninth|strong="H8671"\w* \w month|strong="H2320"\w*, \w the king|strong="H4428"\w* \w was sitting|strong="H3427"\w* \w in his winter|strong="H2779"\w* \w quarters|strong="H1004"\w* \w with a fire|strong="H254"\w* \w burning|strong="H1197"\w* \w before him|strong="H6440"\w*. \v 23 \w And|strong="H1961"\w* \w as soon as Jehudi|strong="H3065"\w* \w had read|strong="H7121"\w* \w three|strong="H7969"\w* \w or four|strong="H702"\w* \w columns|strong="H1817"\w*, \w Jehoiakim would cut them off|strong="H7167"\w* \w with a scribe’s|strong="H5608"\w* \w knife|strong="H8593"\w* \w and throw them|strong="H7993"\w* \w into|strong="H413"\w* \w the firepot|strong="H254"\w*, \w until|strong="H5704"\w* \w the entire|strong="H3605"\w* \w scroll|strong="H4039"\w* \w had been consumed|strong="H8552"\w* \w by|strong="H5921"\w* \w the fire|strong="H784"\w*.
\p \v 24 \w Yet in hearing|strong="H8085"\w* \w all|strong="H3605"\w* \w these|strong="H428"\w* \w words|strong="H1697"\w*, \w the king|strong="H4428"\w* \w and|strong="H3605"\w* \w his servants|strong="H5650"\w* \w did not|strong="H3808"\w* \w become frightened|strong="H6342"\w* \w or tear|strong="H7167"\w* \w their garments|strong="H899"\w*. \v 25 \w Even though|strong="H1571"\w* \w Elnathan|strong="H494"\w*, \w Delaiah|strong="H1806"\w*, \w and Gemariah|strong="H1587"\w* \w urged|strong="H6293"\w* \w the king|strong="H4428"\w* \w not|strong="H1115"\w* \w to burn|strong="H8313"\w* \w the scroll|strong="H4039"\w*, \w he would not|strong="H3808"\w* \w listen|strong="H8085"\w* \w to them|strong="H413"\w*. \v 26 \w Instead, the king|strong="H4428"\w* \w commanded|strong="H6680"\w* \w Jerahmeel|strong="H3396"\w*, \w a son|strong="H1121"\w* \w of the king|strong="H4428"\w*, \w as well as|strong="H853"\w* \w Seraiah|strong="H8304"\w* \w son|strong="H1121"\w* \w of Azriel|strong="H5837"\w* \w and Shelemiah|strong="H8018"\w* \w son|strong="H1121"\w* \w of Abdeel|strong="H5655"\w*, \w to seize|strong="H3947"\w* \w Baruch|strong="H1263"\w* \w the scribe|strong="H5608"\w* \w and Jeremiah|strong="H3414"\w* \w the prophet|strong="H5030"\w*. \w But the LORD|strong="H3068"\w* \w had hidden them|strong="H5641"\w*.
\s1 Jeremiah Rewrites the Scroll
\p \v 27 \w After|strong="H310"\w* \w the king|strong="H4428"\w* \w had burned|strong="H8313"\w* \w the scroll|strong="H4039"\w* \w containing the words|strong="H1697"\w* \w that|strong="H834"\w* \w Baruch|strong="H1263"\w* \w had written|strong="H3789"\w* \w at Jeremiah’s|strong="H3414"\w* \w dictation|strong="H6310"\w*, \w the word|strong="H1697"\w* \w of the LORD|strong="H3068"\w* \w came|strong="H1961"\w* \w to|strong="H413"\w* \w Jeremiah|strong="H3414"\w*: \v 28 “\w Take|strong="H3947"\w* \w another|strong="H312"\w* \w scroll|strong="H4039"\w* \w and|strong="H7725"\w* \w rewrite|strong="H3789"\w* \w on it|strong="H5921"\w* \w the very words|strong="H1697"\w* \w that|strong="H834"\w* \w were|strong="H1961"\w* \w on|strong="H5921"\w* \w the original|strong="H7223"\w* \w scroll|strong="H4039"\w*, \w which|strong="H834"\w* \w Jehoiakim|strong="H3079"\w* \w king|strong="H4428"\w* \w of Judah|strong="H3063"\w* \w has burned|strong="H8313"\w*.
