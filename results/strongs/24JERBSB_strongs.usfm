\s1 Captives Carried to Babylon
\r (\ref 2 Kings 25:18–21|2KI 25:18-21\ref*)
\p \v 24 \w The captain|strong="H7227"\w* \w of the guard|strong="H2876"\w* \w also took away|strong="H3947"\w* \w Seraiah|strong="H8304"\w* \w the chief|strong="H7218"\w* \w priest|strong="H3548"\w*, \w Zephaniah|strong="H6846"\w* \w the priest|strong="H3548"\w* \w of second rank|strong="H4932"\w*, \w and the three|strong="H7969"\w* \w doorkeepers|strong="H8104"\w*. \v 25 \w Of those|strong="H4480"\w* \w still in the city|strong="H5892"\w*, \w he took|strong="H3947"\w* \w a|strong="H259"\w* \w court official|strong="H5631"\w* \w who|strong="H834"\w* \w had been|strong="H1961"\w* \w appointed|strong="H6496"\w* \w over|strong="H5921"\w* \w the men|strong="H582"\w* \w of war|strong="H4421"\w*, \w as well as seven|strong="H7651"\w* \w trusted royal|strong="H4428"\w* \w advisers|strong="H7200"\w*. \w He also took|strong="H853"\w* \w the scribe|strong="H5608"\w* \w of the captain|strong="H8269"\w* \w of the army|strong="H6635"\w*, \w who had enlisted|strong="H6633"\w* \w the people|strong="H5971"\w* \w of the land|strong="H776"\w*, \w and sixty|strong="H8346"\w* \w men|strong="H376"\w* \w who were found|strong="H4672"\w* \w in|strong="H8432"\w* \w the city|strong="H5892"\w*.
\p \v 26 \w Nebuzaradan|strong="H5018"\w* \w captain|strong="H7227"\w* \w of the guard|strong="H2876"\w* \w took|strong="H3947"\w* \w them|strong="H853"\w* \w and brought|strong="H1980"\w* \w them|strong="H853"\w* \w to|strong="H413"\w* \w the king|strong="H4428"\w* \w of Babylon|strong="H894"\w* \w at Riblah|strong="H7247"\w*. \v 27 \w There at Riblah|strong="H7247"\w* \w in the land|strong="H776"\w* \w of Hamath|strong="H2574"\w*, \w the king|strong="H4428"\w* \w of Babylon|strong="H894"\w* \w struck them|strong="H5221"\w* \w down|strong="H853"\w* \w and put them to death|strong="H4191"\w*. \w So Judah|strong="H3063"\w* \w was taken into exile|strong="H1540"\w*, \w away from|strong="H5921"\w* \w its own land|strong="H127"\w*.
\p \v 28 \w These|strong="H2088"\w* \w are the people|strong="H5971"\w* \w Nebuchadnezzar|strong="H5019"\w* \w carried away|strong="H1540"\w*:
\b 
\li1 \w in the seventh|strong="H7651"\w* \w year|strong="H8141"\w*, \w 3,023|strong="H7969"\w* \w Jews|strong="H3064"\w*;
\li1 \v 29 \w in Nebuchadnezzar’s|strong="H5019"\w* \w eighteenth|strong="H8083"\w* \w year|strong="H8141"\w*, \w 832|strong="H8083"\w* \w people|strong="H5315"\w* \w from Jerusalem|strong="H3389"\w*;
\li1 \v 30 \w in Nebuchadnezzar’s|strong="H5019"\w* \w twenty-third|strong="H7969"\w* \w year|strong="H8141"\w*, \w Nebuzaradan|strong="H5018"\w* \w captain|strong="H7227"\w* \w of the guard|strong="H2876"\w* \w carried away|strong="H1540"\w* \w 745|strong="H7651"\w* \w Jews|strong="H3064"\w*.
\p \w So in all|strong="H3605"\w*, \w 4,600|strong="H702"\w* \w people were taken away|strong="H5315"\w*.
\s1 Jehoiachin Released from Prison
\r (\ref 2 Kings 25:27–30|2KI 25:27-30\ref*)
\p \v 31 \w On the twenty-fifth|strong="H6242"\w* \w day of the twelfth|strong="H8147"\w* \w month|strong="H2320"\w* \w of the thirty-seventh|strong="H7970"\w* \w year|strong="H8141"\w* \w of the exile|strong="H1546"\w* \w of Jehoiachin|strong="H3078"\w* \w king|strong="H4428"\w* \w of Judah|strong="H3063"\w*, \w in the first year|strong="H8141"\w* \w of the reign|strong="H4438"\w* \w of Evil-merodach|strong="H192"\w* \w king|strong="H4428"\w* \w of Babylon|strong="H894"\w*, \w he pardoned|strong="H5375"\w*\f + \fr 52:31 \ft Literally \fqa he lifted up the head of\f* \w Jehoiachin|strong="H3078"\w* \w king|strong="H4428"\w* \w of Judah|strong="H3063"\w* \w and released him|strong="H3318"\w* \w from|strong="H853"\w* \w prison|strong="H1004"\w*. \v 32 \w And he spoke|strong="H1696"\w* \w kindly|strong="H2896"\w* \w to Jehoiachin|strong="H854"\w* \w and set|strong="H5414"\w* \w his throne|strong="H3678"\w* \w above|strong="H4605"\w* \w the thrones|strong="H3678"\w* \w of the other kings|strong="H4428"\w* \w who were|strong="H834"\w* \w with him|strong="H854"\w* \w in Babylon|strong="H894"\w*.
\p \v 33 \w So Jehoiachin changed|strong="H8138"\w* \w out of his prison|strong="H3608"\w* \w clothes|strong="H899"\w*, \w and he dined|strong="H398"\w* \w regularly|strong="H8548"\w* \w at the king’s table|strong="H6440"\w* \w for the rest|strong="H3605"\w* \w of his life|strong="H2416"\w*. \v 34 \w And the king|strong="H4428"\w* \w of Babylon|strong="H894"\w* \w provided|strong="H737"\w* Jehoiachin \w a daily|strong="H3117"\w* \w portion|strong="H1697"\w* \w for the rest|strong="H3605"\w* \w of his life|strong="H2416"\w*, \w until|strong="H5704"\w* \w the day|strong="H3117"\w* \w of his death|strong="H4194"\w*.
