\p \v 19 \w Did Hezekiah|strong="H2396"\w* \w king|strong="H4428"\w* \w of Judah|strong="H3063"\w* \w or anyone else|strong="H3605"\w* \w in Judah|strong="H3063"\w* \w put him to death|strong="H4191"\w*? \w Did Hezekiah not|strong="H3808"\w* \w fear|strong="H3373"\w* \w the LORD|strong="H3068"\w* \w and seek|strong="H2470"\w* \w His|strong="H3068"\w* \w favor|strong="H6440"\w*, \w and did not the LORD|strong="H3068"\w* \w relent|strong="H5162"\w* \w of|strong="H413"\w* \w the disaster|strong="H7451"\w* \w He had pronounced|strong="H1696"\w* \w against them|strong="H5921"\w*? \w But we|strong="H587"\w* \w are about to bring|strong="H6213"\w* \w great|strong="H1419"\w* \w harm|strong="H7451"\w* \w on|strong="H5921"\w* \w ourselves|strong="H5315"\w*!”
\s1 The Prophet Uriah
\p \v 20 \w Now there was|strong="H1961"\w* \w another man|strong="H376"\w* \w prophesying|strong="H5012"\w* \w in the name|strong="H8034"\w* \w of the LORD|strong="H3068"\w*, \w Uriah|strong="H223"\w* \w son|strong="H1121"\w* \w of Shemaiah|strong="H8098"\w* \w from|strong="H7157"\w* \w Kiriath-jearim|strong="H7157"\w*. \w He prophesied|strong="H5012"\w* \w against|strong="H5921"\w* \w this|strong="H2063"\w* \w city|strong="H5892"\w* \w and against|strong="H5921"\w* \w this|strong="H2063"\w* \w land|strong="H776"\w* \w the same things|strong="H3605"\w* \w that Jeremiah did|strong="H3414"\w*.\f + \fr 26:20 \ft Literally \fqa according to all the words of Jeremiah\f* \v 21 \w King|strong="H4428"\w* \w Jehoiakim|strong="H3079"\w* \w and all|strong="H3605"\w* \w his mighty men|strong="H1368"\w* \w and|strong="H3605"\w* \w officials|strong="H8269"\w* \w heard|strong="H8085"\w* \w his words|strong="H1697"\w*, \w and the king|strong="H4428"\w* \w sought|strong="H1245"\w* \w to put him to death|strong="H4191"\w*. \w But when Uriah|strong="H223"\w* \w found out about it|strong="H8085"\w*, \w he fled|strong="H1272"\w* \w in fear|strong="H3372"\w* \w and went|strong="H935"\w* \w to Egypt|strong="H4714"\w*.
