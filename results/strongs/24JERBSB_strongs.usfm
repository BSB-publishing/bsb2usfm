\p \v 4 \w For|strong="H3588"\w* \w if|strong="H518"\w* \w you will indeed carry out|strong="H6213"\w* \w these|strong="H2088"\w* \w commands|strong="H1697"\w*, \w then kings|strong="H4428"\w* \w who sit|strong="H3427"\w* \w on|strong="H5921"\w* \w David’s|strong="H1732"\w* \w throne|strong="H3678"\w* \w will enter|strong="H935"\w* \w through the gates|strong="H8179"\w* \w of this|strong="H2088"\w* \w palace|strong="H1004"\w* \w riding|strong="H7392"\w* \w on chariots|strong="H7393"\w* \w and horses|strong="H5483"\w* — \w they|strong="H1931"\w* \w and their officials|strong="H5650"\w* \w and their people|strong="H5971"\w*. \v 5 \w But if|strong="H518"\w* \w you do not|strong="H3808"\w* \w obey|strong="H8085"\w* \w these|strong="H428"\w* \w words|strong="H1697"\w*, \w then I swear|strong="H7650"\w* by Myself, \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*, \w that|strong="H3588"\w* \w this|strong="H2088"\w* \w house|strong="H1004"\w* \w will become|strong="H1961"\w* \w a pile of rubble|strong="H2723"\w*.’”
