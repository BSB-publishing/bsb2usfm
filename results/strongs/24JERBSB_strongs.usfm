\p \v 9 \w Then|strong="H853"\w* \w Nebuzaradan|strong="H5018"\w* \w captain|strong="H7227"\w* \w of the guard|strong="H2876"\w* \w carried|strong="H1540"\w* \w away to Babylon|strong="H894"\w* \w the remnant|strong="H3499"\w* \w of the people|strong="H5971"\w* \w who had remained|strong="H7604"\w* \w in the city|strong="H5892"\w*, \w along with|strong="H853"\w* \w the deserters|strong="H5307"\w* \w who|strong="H834"\w* \w had defected|strong="H5307"\w* \w to|strong="H5921"\w* \w him|strong="H853"\w*. \v 10 \w But Nebuzaradan|strong="H5018"\w* \w left behind|strong="H7604"\w* \w in the land|strong="H776"\w* \w of Judah|strong="H3063"\w* \w some of|strong="H4480"\w* \w the poor|strong="H1800"\w* \w people|strong="H5971"\w* \w who|strong="H834"\w* \w had no property|strong="H369"\w*, \w and at that|strong="H1931"\w* \w time|strong="H3117"\w* \w he gave|strong="H5414"\w* them \w vineyards|strong="H3754"\w* \w and fields|strong="H3010"\w*.
\s1 Jeremiah Delivered
\p \v 11 \w Now Nebuchadnezzar|strong="H5019"\w* \w king|strong="H4428"\w* \w of Babylon|strong="H894"\w* \w had given orders|strong="H6680"\w* \w about|strong="H5921"\w* \w Jeremiah|strong="H3414"\w* \w through|strong="H3027"\w* \w Nebuzaradan|strong="H5018"\w* \w captain|strong="H7227"\w* \w of the guard|strong="H2876"\w*, \w saying|strong="H559"\w*, \v 12 “\w Take him|strong="H3947"\w*, \w look after|strong="H5869"\w* \w him|strong="H5921"\w*, \w and do not|strong="H408"\w* \w let any|strong="H3972"\w* \w harm|strong="H7451"\w* \w come|strong="H6213"\w* to him; \w do|strong="H6213"\w* \w for him|strong="H5973"\w* \w whatever|strong="H834"\w* \w he says|strong="H1696"\w*.”
