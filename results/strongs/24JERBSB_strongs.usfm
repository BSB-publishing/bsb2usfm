\p \v 19 \w This is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w said|strong="H559"\w* \w to me|strong="H413"\w*: “\w Go|strong="H1980"\w* \w and stand|strong="H5975"\w* \w at the gate|strong="H8179"\w* \w of the people|strong="H1121"\w*, \w through which|strong="H834"\w* \w the kings|strong="H4428"\w* \w of Judah|strong="H3063"\w* \w go in|strong="H935"\w* \w and out|strong="H3318"\w*; and stand \w at all the other|strong="H3605"\w* \w gates|strong="H8179"\w* \w of Jerusalem|strong="H3389"\w*.
\p \v 20 \w Say|strong="H559"\w* \w to them|strong="H413"\w*, ‘\w Hear|strong="H8085"\w* \w the word|strong="H1697"\w* \w of the LORD|strong="H3068"\w*, \w O kings|strong="H4428"\w* \w of Judah|strong="H3063"\w*, \w all people|strong="H3605"\w* \w of Judah|strong="H3063"\w* \w and|strong="H3605"\w* \w Jerusalem|strong="H3389"\w* \w who enter|strong="H935"\w* \w through these|strong="H428"\w* \w gates|strong="H8179"\w*. \v 21 \w This is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w says|strong="H559"\w*: \w Take heed|strong="H8104"\w* \w for yourselves|strong="H5315"\w*; \w do not|strong="H408"\w* \w carry|strong="H5375"\w* \w a load|strong="H4853"\w* \w or bring it|strong="H935"\w* \w through the gates|strong="H8179"\w* \w of Jerusalem|strong="H3389"\w* \w on the Sabbath|strong="H7676"\w* \w day|strong="H3117"\w*. \v 22 \w You must not|strong="H3808"\w* \w carry a load|strong="H4853"\w* \w out|strong="H3318"\w* \w of your houses|strong="H1004"\w* \w or do|strong="H6213"\w* \w any|strong="H3605"\w* \w work|strong="H4399"\w* \w on the Sabbath|strong="H7676"\w* \w day|strong="H3117"\w*, \w but you must keep|strong="H6942"\w* \w the Sabbath|strong="H7676"\w* \w day holy|strong="H3117"\w*, \w just as|strong="H834"\w* \w I commanded|strong="H6680"\w* \w your forefathers|strong="H1"\w*. \v 23 \w Yet they would not|strong="H3808"\w* \w listen|strong="H8085"\w* \w or incline|strong="H5186"\w* \w their ear|strong="H241"\w*, \w but they stiffened|strong="H7185"\w* \w their necks|strong="H6203"\w* \w and would not|strong="H1115"\w* \w listen|strong="H8085"\w* \w or receive|strong="H3947"\w* \w My discipline|strong="H4148"\w*.
\p \v 24 \w If|strong="H518"\w*, \w however|strong="H1961"\w*, \w you listen carefully|strong="H8085"\w* \w to Me|strong="H413"\w*, \w says|strong="H5002"\w* \w the LORD|strong="H3068"\w*, \w and bring|strong="H935"\w* \w no|strong="H1115"\w* \w load|strong="H4853"\w* \w through the gates|strong="H8179"\w* \w of this|strong="H2063"\w* \w city|strong="H5892"\w* \w on the Sabbath|strong="H7676"\w* \w day|strong="H3117"\w*, \w and keep|strong="H6942"\w* \w the Sabbath|strong="H7676"\w* \w day holy|strong="H3117"\w*, \w and do|strong="H6213"\w* \w no|strong="H1115"\w* \w work|strong="H4399"\w* on it, \v 25 \w then kings|strong="H4428"\w* \w and princes|strong="H8269"\w* \w will enter|strong="H935"\w* \w through the gates|strong="H8179"\w* \w of this|strong="H2063"\w* \w city|strong="H5892"\w*. \w They will sit|strong="H3427"\w* \w on|strong="H5921"\w* \w the throne|strong="H3678"\w* \w of David|strong="H1732"\w*, \w riding|strong="H7392"\w* \w in chariots|strong="H7393"\w* \w and on horses|strong="H5483"\w* \w with their|strong="H1992"\w* \w officials|strong="H8269"\w*, \w along with the men|strong="H376"\w* \w of Judah|strong="H3063"\w* \w and the residents|strong="H3427"\w* \w of Jerusalem|strong="H3389"\w*, \w and this|strong="H2063"\w* \w city|strong="H5892"\w* \w will be inhabited|strong="H3427"\w* \w forever|strong="H5769"\w*. \v 26 \w And people will come|strong="H935"\w* \w from the cities|strong="H5892"\w* \w of Judah|strong="H3063"\w* \w and the places around|strong="H5439"\w* \w Jerusalem|strong="H3389"\w*, \w from the land|strong="H776"\w* \w of Benjamin|strong="H1144"\w*, \w and from|strong="H4480"\w* \w the foothills|strong="H8219"\w*,\f + \fr 17:26 \ft Hebrew \fqa Shephelah \ft or \fqa lowlands\ft ; that is, the western foothills of Judea\f* \w the hill country|strong="H2022"\w*, \w and|strong="H4480"\w* \w the Negev|strong="H5045"\w*, \w bringing|strong="H935"\w* \w burnt offerings|strong="H5930"\w* \w and sacrifices|strong="H2077"\w*, \w grain offerings