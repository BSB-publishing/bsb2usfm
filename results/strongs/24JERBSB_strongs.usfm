\p \v 35 \w Thus|strong="H3541"\w* \w says|strong="H559"\w* \w the LORD|strong="H3068"\w*, \w who gives|strong="H5414"\w* \w the sun|strong="H8121"\w* \w for light|strong="H216"\w* \w by day|strong="H3119"\w*, \w who sets in order|strong="H2708"\w* \w the moon|strong="H3394"\w* \w and stars|strong="H3556"\w* \w for light|strong="H216"\w* \w by night|strong="H3915"\w*, \w who stirs up|strong="H7280"\w* \w the sea|strong="H3220"\w* \w so that its waves|strong="H1530"\w* \w roar|strong="H1993"\w* — \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w* \w is His name|strong="H8034"\w*:
