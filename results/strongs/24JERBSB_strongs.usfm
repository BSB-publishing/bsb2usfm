\p \v 1 \w This is the word|strong="H1697"\w* \w that|strong="H834"\w* \w came|strong="H1961"\w* \w to|strong="H413"\w* \w Jeremiah|strong="H3414"\w* \w from|strong="H854"\w* \w the LORD|strong="H3068"\w* \w after|strong="H310"\w* \w Nebuzaradan|strong="H5018"\w* \w captain|strong="H7227"\w* \w of the guard|strong="H2876"\w* \w had released|strong="H7971"\w* \w him|strong="H853"\w* \w at|strong="H4480"\w* \w Ramah|strong="H7414"\w*, \w having found|strong="H3947"\w* \w him|strong="H1931"\w* \w bound|strong="H631"\w* \w in chains|strong="H246"\w* \w among|strong="H8432"\w* \w all|strong="H3605"\w* \w the captives|strong="H1546"\w* \w of Jerusalem|strong="H3389"\w* \w and Judah|strong="H3063"\w* \w who were being exiled|strong="H1540"\w* \w to Babylon|strong="H894"\w*.
