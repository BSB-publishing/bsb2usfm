\c 37
\s1 Jeremiah Warns Zedekiah
\p \v 1 \w Nebuchadnezzar|strong="H5019"\w* \w king|strong="H4428"\w* \w of Babylon|strong="H894"\w* \w made Zedekiah|strong="H6667"\w* \w son|strong="H1121"\w* \w of Josiah|strong="H2977"\w* \w the king|strong="H4427"\w* \w of Judah|strong="H3063"\w*, \w and he reigned|strong="H4427"\w* \w in place|strong="H8478"\w* \w of Coniah|strong="H3659"\w*\f + \fr 37:1 \fqa Coniah \ft is a variant of \fqa Jehoiachin\ft .\f* \w son|strong="H1121"\w* \w of Jehoiakim|strong="H3079"\w*. \v 2 \w But he|strong="H1931"\w* \w and his officers|strong="H5650"\w* \w and the people|strong="H5971"\w* \w of the land|strong="H776"\w* \w refused|strong="H3808"\w* \w to obey|strong="H8085"\w* \w the words|strong="H1697"\w* \w that the LORD|strong="H3068"\w* \w had spoken|strong="H1696"\w* \w through|strong="H3027"\w* \w Jeremiah|strong="H3414"\w* \w the prophet|strong="H5030"\w*.
