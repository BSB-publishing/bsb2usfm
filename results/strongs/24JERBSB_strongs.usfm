\q2 \w they would have proclaimed|strong="H8085"\w* \w My words|strong="H1697"\w* \w to My people|strong="H5971"\w*
\q1 \w and turned them back|strong="H7725"\w*
\q2 \w from their evil|strong="H7451"\w* \w ways|strong="H1870"\w* \w and|strong="H7455"\w* \w deeds|strong="H4611"\w*.”
\b 
\q1 
\p \v 23 “\w Am I only|strong="H589"\w* \w a God|strong="H430"\w* \w nearby|strong="H7138"\w*,” \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*, “\w and not|strong="H3808"\w* \w a God|strong="H430"\w* \w far away|strong="H7350"\w*?”
\p \v 24 “\w Can|strong="H518"\w* \w a man|strong="H376"\w* \w hide|strong="H5641"\w* \w in secret places|strong="H4565"\w* \w where I|strong="H589"\w* \w cannot|strong="H3808"\w* \w see him|strong="H7200"\w*?” \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*.
\p “\w Do I|strong="H589"\w* \w not|strong="H3808"\w* \w fill|strong="H4390"\w* \w the heavens|strong="H8064"\w* \w and|strong="H853"\w* \w the earth|strong="H776"\w*?” \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*.
\q1 
\p \v 25 “\w I have heard|strong="H8085"\w* \w the sayings|strong="H559"\w* \w of the prophets|strong="H5030"\w* \w who prophesy|strong="H5012"\w* \w lies|strong="H8267"\w* \w in My name|strong="H8034"\w*: ‘\w I had a dream|strong="H2492"\w*! \w I had a dream|strong="H2492"\w*!’ \v 26 \w How long|strong="H5704"\w* \w will this continue|strong="H3426"\w* \w in the hearts|strong="H3820"\w* \w of these prophets|strong="H5030"\w* \w who prophesy|strong="H5012"\w* \w falsehood|strong="H8267"\w*, \w these prophets|strong="H5030"\w* \w of the delusion|strong="H8649"\w* \w of their own minds|strong="H3820"\w*? \v 27 \w They suppose|strong="H2803"\w* \w the dreams|strong="H2472"\w* \w that|strong="H834"\w* \w they tell|strong="H5608"\w* \w one|strong="H376"\w* \w another|strong="H7453"\w* \w will make My people|strong="H5971"\w* \w forget|strong="H7911"\w* \w My name|strong="H8034"\w*, \w just as|strong="H834"\w* \w their fathers|strong="H1"\w* \w forgot|strong="H7911"\w* \w My name|strong="H8034"\w* \w through the worship of Baal|strong="H1168"\w*.
\p \v 28 \w Let the prophet|strong="H5030"\w* \w who|strong="H834"\w* \w has|strong="H854"\w* \w a dream|strong="H2472"\w* \w retell|strong="H5608"\w* \w it|strong="H2472"\w*, \w but let him who|strong="H834"\w* \w has|strong="H854"\w* \w My word|strong="H1697"\w* \w speak|strong="H1696"\w* \w it|strong="H1697"\w* \w truthfully|strong="H571"\w*. \w For what|strong="H4100"\w* \w is straw|strong="H8401"\w* \w compared to|strong="H854"\w* \w grain|strong="H1250"\w*?” \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*. \v 29 “\w Is not|strong="H3808"\w* \w My word|strong="H1697"\w* \w like fire|strong="H784"\w*,” \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*, “\w and like a hammer|strong="H6360"\w* \w that smashes|strong="H6327"\w* \w a rock|strong="H5553"\w*?”
\p \v 30 “\w Therefore|strong="H3651"\w* \w behold|strong="H2005"\w*,” \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*, “\w I am against|strong="H5921"\w* \w the prophets|strong="H5030"\w* \w who steal|strong="H1589"\w* \w from one|strong="H376"\w* \w another|strong="H7453"\w* \w words they attribute to Me|strong="H1697"\w*.”
\p \v 31 “\w Yes|strong="H2005"\w*,” \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*, “\w I am against|strong="H5921"\w* \w the prophets|strong="H5030"\w* \w who wag|strong="H3947"\w* \w their own tongues|strong="H3956"\w* \w and proclaim|strong="H5001"\w*, ‘\w The LORD declares it|strong="H5002"\w*.’”
\p \v 32 “\w Indeed|strong="H2005"\w*,” \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*, “\w I am against|strong="H5921"\w* \w those who prophesy|strong="H5012"\w* \w false|strong="H8267"\w* \w dreams|strong="H2472"\w* \w and retell them|strong="H5608"\w* \w to lead My people|strong="H5971"\w* \w astray|strong="H8582"\w* \w with their reckless|strong="H6350"\w* \w lies|strong="H8267"\w*. \w It was not|strong="H3808"\w* \w I|strong="H595"\w* \w who sent them|strong="H7971"\w* \w or commanded them|strong="H6680"\w*, \w and they are of no|strong="H3808"\w* \w benefit|strong="H3276"\w* \w at all|strong="H3276"\w* \w to these|strong="H2088"\w* \w people|strong="H5971"\w*,” \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*.
\s1 False Prophecies
\p \v 33 “\w Now when|strong="H3588"\w* \w this|strong="H2088"\w* \w people|strong="H5971"\w* \w or|strong="H176"\w* \w a prophet|strong="H5030"\w* \w or|strong="H176"\w* \w priest|strong="H3548"\w* \w asks you|strong="H7592"\w*, ‘\w What|strong="H4100"\w* \w is the burden|strong="H4853"\w* \w of the LORD|strong="H3068"\w*?’ \w you are to say|strong="H559"\w* \w to them|strong="H413"\w*, ‘\w What|strong="H4100"\w* \w burden|strong="H4853"\w*? \w I will forsake|strong="H5203"\w* \w you|strong="H853"\w*, \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*.’
\p \v 34 \w As for the prophet|strong="H5030"\w* \w or priest|strong="H3548"\w* \w or anyone|strong="H5971"\w* \w who|strong="H834"\w* \w claims|strong="H559"\w*, ‘\w This is the burden|strong="H4853"\w* \w of the LORD|strong="H3068"\w*,’ \w I will punish|strong="H6485"\w* \w that|strong="H1931"\w* \w man|strong="H376"\w* \w and his household|strong="H1004"\w*.
\p \v 35 \w This is what|strong="H3541"\w* \w each man|strong="H376"\w* \w is to say|strong="H559"\w* \w to|strong="H5921"\w* \w his friend|strong="H7453"\w* \w and to|strong="H413"\w* \w his brother|strong="H251"\w*: ‘\w What|strong="H4100"\w* \w has the LORD|strong="H3068"\w* \w answered|strong="H6030"\w*?’ \w or ‘What|strong="H4100"\w* \w has the LORD|strong="H3068"\w* \w spoken|strong="H1696"\w*?’ \v 36 \w But refer|strong="H2142"\w* \w no|strong="H3808"\w* \w more|strong="H5750"\w* \w to the burden|strong="H4853"\w* \w of the LORD|strong="H3068"\w*, \w for|strong="H3588"\w* \w each|strong="H376"\w* \w man’s word|strong="H1697"\w* \w becomes|strong="H1961"\w* \w the burden|strong="H4853"\w*, \w so that you pervert|strong="H2015"\w* \w the words|strong="H1697"\w* \w of the living|strong="H2416"\w* \w God|strong="H430"\w*, \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*, \w our God|strong="H430"\w*.
\p \v 37 \w Thus|strong="H3541"\w* \w you are to say|strong="H559"\w* \w to|strong="H413"\w* \w the prophet|strong="H5030"\w*: ‘\w What|strong="H4100"\w* \w has the LORD|strong="H3068"\w* \w answered you|strong="H6030"\w*?’ \w and ‘What|strong="H4100"\w* \w has the LORD|strong="H3068"\w* \w spoken|strong="H1696"\w*?’
\p \v 38 \w But if|strong="H518"\w* \w you claim|strong="H559"\w*, ‘\w This is the burden|strong="H4853"\w* \w of the LORD|strong="H3068"\w*,’ \w then|strong="H3651"\w* \w this is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w says|strong="H559"\w*: \w Because|strong="H3282"\w* \w you have said|strong="H559"\w*, ‘\w This is the burden|strong="H4853"\w* \w of the LORD|strong="H3068"\w*,’ \w and I specifically told|strong="H7971"\w* \w you not|strong="H3808"\w* \w to make this claim|strong="H559"\w*, \v 39 \w therefore|strong="H3651"\w* \w I will surely|strong="H2005"\w* \w forget|strong="H5382"\w* \w you|strong="H853"\w* \w and will cast you|strong="H5203"\w* \w out of|strong="H5921"\w* \w My presence|strong="H6440"\w*, \w both you|strong="H853"\w* \w and|strong="H853"\w* \w the city|strong="H5892"\w* \w that|strong="H834"\w* \w I gave|strong="H5414"\w* to you \w and your fathers|strong="H1"\w*. \v 40 \w And I will bring|strong="H5414"\w* \w upon you|strong="H5921"\w* \w everlasting|strong="H5769"\w* \w shame|strong="H2781"\w* \w and perpetual|strong="H5769"\w* \w humiliation|strong="H3640"\w* \w that|strong="H834"\w* \w will never|strong="H3808"\w* \w be forgotten|strong="H7911"\w*.”
\c 24
\s1 The Good and Bad Figs
\p \v 1 \w After|strong="H310"\w* \w Nebuchadnezzar|strong="H5019"\w* \w king|strong="H4428"\w* \w of Babylon|strong="H894"\w* \w had carried away|strong="H1540"\w* \w Jeconiah|strong="H3204"\w*\f + \fr 24:1 \fqa Jeconiah \ft is a variant of \fqa Jehoiachin\ft ; see \ref 2 Kings 24:12|2KI 24:12\ref*.\f* \w son|strong="H1121"\w* \w of Jehoiakim|strong="H3079"\w* \w king|strong="H4428"\w* \w of Judah|strong="H3063"\w*, \w as well as|strong="H853"\w* \w the officials|strong="H8269"\w* \w of Judah|strong="H3063"\w* \w and the craftsmen|strong="H2796"\w* \w and metalsmiths|strong="H4525"\w* \w from Jerusalem|strong="H3389"\w*, \w and had brought them|strong="H935"\w* \w to Babylon|strong="H894"\w*,\f + \fr 24:1 \ft Or \fqa metalsmiths, and had brought them from Jerusalem to Babylon\f* \w the LORD|strong="H3068"\w* \w showed me|strong="H7200"\w* \w two|strong="H8147"\w* \w baskets|strong="H1731"\w* \w of figs|strong="H8384"\w* \w placed|strong="H3259"\w* \w in front of|strong="H6440"\w* \w the temple|strong="H1964"\w* \w of the LORD|strong="H3068"\w*. \v 2 \w One|strong="H259"\w* \w basket|strong="H1731"\w* \w had very|strong="H3966"\w* \w good|strong="H2896"\w* \w figs|strong="H8384"\w*, \w like those that ripen early|strong="H8384"\w*, \w but the other|strong="H259"\w* \w basket|strong="H1731"\w* \w contained very|strong="H3966"\w* \w poor|strong="H7451"\w* \w figs|strong="H8384"\w*, \w so bad|strong="H7455"\w* \w they could not|strong="H3808"\w* \w be eaten|strong="H398"\w*.
\p \v 3 “\w Jeremiah|strong="H3414"\w*,” \w the LORD|strong="H3068"\w* \w asked|strong="H559"\w*, “\w what|strong="H4100"\w* \w do you|strong="H859"\w* \w see|strong="H7200"\w*?”
\p “\w Figs|strong="H8384"\w*!” \w I replied|strong="H559"\w*. “\w The good|strong="H2896"\w* \w figs|strong="H8384"\w* \w are very|strong="H3966"\w* \w good|strong="H2896"\w*, \w but the bad figs|strong="H7451"\w* \w are very|strong="H3966"\w* \w bad|strong="H7451"\w*, \w so bad|strong="H7455"\w* \w they cannot|strong="H3808"\w* \w be eaten|strong="H398"\w*.”
\p \v 4 \w Then the word|strong="H1697"\w* \w of the LORD|strong="H3068"\w* \w came|strong="H1961"\w* \w to me|strong="H413"\w*, \w saying|strong="H559"\w*, \v 5 “\w This is what|strong="H3541"\w* \w the LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w says|strong="H559"\w*: ‘\w Like these|strong="H428"\w* \w good|strong="H2896"\w* \w figs|strong="H8384"\w*, \w so|strong="H3651"\w* \w I regard|strong="H5234"\w* \w as good|strong="H2896"\w* \w the exiles|strong="H1546"\w* \w from Judah|strong="H3063"\w*, \w whom|strong="H834"\w* \w I have sent away|strong="H7971"\w* \w from|strong="H4480"\w* \w this|strong="H2088"\w* \w place|strong="H4725"\w* \w to the land|strong="H776"\w* \w of the Chaldeans|strong="H3778"\w*.\f + \fr 24:5 \ft That is, the Babylonians\f* \v 6 \w I will keep|strong="H7760"\w* \w My eyes|strong="H5869"\w* \w on them|strong="H5921"\w* \w for good|strong="H2896"\w* \w and will return them|strong="H7725"\w* \w to|strong="H5921"\w* \w this|strong="H2063"\w* \w land|strong="H776"\w*. \w I will build them up|strong="H1129"\w* \w and not|strong="H3808"\w* \w tear them down|strong="H2040"\w*; \w I will plant them|strong="H5193"\w* \w and not|strong="H3808"\w* \w uproot them|strong="H5428"\w*. \v 7 \w I will give|strong="H5414"\w* them \w a heart|strong="H3820"\w* \w to know Me|strong="H3045"\w*, \w that|strong="H3588"\w* \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w*. \w They will be|strong="H1961"\w* My \w people|strong="H5971"\w*, \w and I|strong="H595"\w* \w will be|strong="H1961"\w* their \w God|strong="H430"\w*, \w for|strong="H3588"\w* \w they will return|strong="H7725"\w* \w to Me|strong="H413"\w* \w with all|strong="H3605"\w* \w their heart|strong="H3820"\w*.
\p \v 8 \w But like the bad|strong="H7451"\w* \w figs|strong="H8384"\w*, \w so bad|strong="H7455"\w* \w they cannot|strong="H3808"\w* \w be eaten|strong="H398"\w*,’ \w says|strong="H559"\w* \w the LORD|strong="H3068"\w*, ‘\w so|strong="H3651"\w* \w will I deal with|strong="H5414"\w* \w Zedekiah|strong="H6667"\w* \w king|strong="H4428"\w* \w of Judah|strong="H3063"\w*, \w his officials|strong="H8269"\w*, \w and the remnant|strong="H7611"\w* \w of Jerusalem|strong="H3389"\w*— \w those remaining|strong="H7604"\w* \w in this|strong="H2063"\w* \w land|strong="H776"\w* \w and those living|strong="H3427"\w* \w in the land|strong="H776"\w* \w of Egypt|strong="H4714"\w*. \v 9 \w I will make them|strong="H5414"\w* \w a horror|strong="H2113"\w* \w and an offense|strong="H7451"\w* \w to all|strong="H3605"\w* \w the kingdoms|strong="H4467"\w* \w of the earth|strong="H776"\w*, \w a disgrace|strong="H2781"\w* \w and an object of scorn|strong="H4912"\w*, \w ridicule|strong="H8148"\w*, \w and cursing|strong="H7045"\w* \w wherever|strong="H3605"\w* \w I have banished them|strong="H5080"\w*. \v 10 \w And I will send|strong="H7971"\w* against them \w sword|strong="H2719"\w* \w and famine|strong="H7458"\w* \w and plague|strong="H1698"\w*, \w until|strong="H5704"\w* \w they have perished|strong="H8552"\w* \w from|strong="H5921"\w* \w the land|strong="H127"\w* \w that|strong="H834"\w* \w I gave|strong="H5414"\w* to them \w and their fathers|strong="H1"\w*.’”
\c 25
\s1 Seventy Years of Captivity
\p \v 1 \w This is the word|strong="H1697"\w* \w that|strong="H834"\w* \w came|strong="H1961"\w* \w to|strong="H5921"\w* \w Jeremiah|strong="H3414"\w* \w concerning|strong="H5921"\w* \w all|strong="H3605"\w* \w the people|strong="H5971"\w* \w of Judah|strong="H3063"\w* \w in the fourth|strong="H7243"\w* \w year|strong="H8141"\w* \w of Jehoiakim|strong="H3079"\w* \w son|strong="H1121"\w* \w of Josiah|strong="H2977"\w* \w king|strong="H4428"\w* \w of Judah|strong="H3063"\w*, \w which|strong="H1931"\w* \w was the first|strong="H7224"\w* \w year|strong="H8141"\w* \w of Nebuchadnezzar|strong="H5019"\w* \w king|strong="H4428"\w* \w of Babylon|strong="H894"\w*. \v 2 \w So|strong="H834"\w* \w the prophet|strong="H5030"\w* \w Jeremiah|strong="H3414"\w* \w spoke|strong="H1696"\w* \w to|strong="H5921"\w* \w all|strong="H3605"\w* \w the people|strong="H5971"\w* \w of Judah|strong="H3063"\w* \w and all|strong="H3605"\w* \w the residents|strong="H3427"\w* \w of Jerusalem|strong="H3389"\w* \w as follows|strong="H559"\w*:
\p \v 3 “\w From|strong="H4480"\w* \w the thirteenth|strong="H7969"\w* \w year|strong="H8141"\w* \w of Josiah|strong="H2977"\w* \w son|strong="H1121"\w* \w of Amon|strong="H526"\w* \w king|strong="H4428"\w* \w of Judah|strong="H3063"\w* \w until|strong="H5704"\w* \w this very|strong="H2088"\w* \w day|strong="H3117"\w*— \w twenty-three|strong="H7969"\w* \w years|strong="H8141"\w*— \w the word|strong="H1697"\w* \w of the LORD|strong="H3068"\w* \w has come|strong="H1961"\w* \w to me|strong="H413"\w*, \w and I have spoken|strong="H1696"\w* \w to you|strong="H413"\w* \w again|strong="H7925"\w* \w and again|strong="H1696"\w*,\f + \fr 25:3 \ft Literally \fqa I have spoken to you, rising up early and speaking,\f* \w but you have not|strong="H3808"\w* \w listened|strong="H8085"\w*. \v 4 \w And the LORD|strong="H3068"\w* \w has sent|strong="H7971"\w* \w all|strong="H3605"\w* \w His servants|strong="H5650"\w* \w the prophets|strong="H5030"\w* \w to|strong="H413"\w* \w you|strong="H853"\w* \w again|strong="H7925"\w* \w and again|strong="H7971"\w*,\f + \fr 25:4 \ft Literally \fqa to you, rising up early and sending (them),\f* \w but you have not|strong="H3808"\w* \w listened|strong="H8085"\w* \w or|strong="H3808"\w* \w inclined|strong="H5186"\w* \w your ear|strong="H241"\w* \w to hear|strong="H8085"\w*.
\p \v 5 \w The prophets told you|strong="H559"\w*, ‘\w Turn|strong="H7725"\w* \w now|strong="H4994"\w*, \w each of you|strong="H376"\w*, \w from your evil|strong="H7451"\w* \w ways|strong="H1870"\w* \w and|strong="H7455"\w* \w deeds|strong="H4611"\w*, \w and you can dwell|strong="H3427"\w* \w in|strong="H5921"\w* \w the land|strong="H127"\w* \w that|strong="H834"\w* \w the LORD has given|strong="H5414"\w* to you \w and your fathers|strong="H1"\w* \w forever|strong="H5769"\w* \w and|strong="H5704"\w* \w ever|strong="H5769"\w*. \v 6 \w Do not|strong="H408"\w* \w follow|strong="H1980"\w* \w other|strong="H312"\w* \w gods|strong="H430"\w* \w to serve|strong="H5647"\w* \w and worship|strong="H7812"\w* them, \w and do not|strong="H3808"\w* \w provoke Me to anger|strong="H3707"\w* \w with the works|strong="H4639"\w* \w of your hands|strong="H3027"\w*. \w Then I will do you no|strong="H3808"\w* \w harm|strong="H7489"\w*.’
\p \v 7 ‘\w But to your own harm|strong="H7451"\w*, \w you have not|strong="H3808"\w* \w listened|strong="H8085"\w* \w to Me|strong="H413"\w*,’ \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*, ‘\w so|strong="H4616"\w* \w you have provoked Me to anger|strong="H3707"\w* \w with the works|strong="H4639"\w* \w of your hands|strong="H3027"\w*.’
\p \v 8 \w Therefore|strong="H3651"\w* \w this is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w* \w says|strong="H559"\w*: ‘\w Because|strong="H3282"\w* \w you have not|strong="H3808"\w* \w obeyed|strong="H8085"\w* \w My words|strong="H1697"\w*, \v 9 \w behold|strong="H2005"\w*, \w I will summon|strong="H7971"\w* \w all|strong="H3605"\w* \w the families|strong="H4940"\w* \w of the north|strong="H6828"\w*, \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*, \w and I will send for|strong="H413"\w* \w My servant|strong="H5650"\w* \w Nebuchadnezzar|strong="H5019"\w* \w king|strong="H4428"\w* \w of Babylon|strong="H894"\w*, \w whom I will bring|strong="H935"\w* \w against|strong="H5921"\w* \w this|strong="H2063"\w* \w land|strong="H776"\w*, \w against|strong="H5921"\w* \w its residents|strong="H3427"\w*, \w and against|strong="H5921"\w* \w all|strong="H3605"\w* \w the|strong="H428"\w* \w surrounding|strong="H5439"\w* \w nations|strong="H1471"\w*. \w So I will devote them to destruction|strong="H2763"\w*\f + \fr 25:9 \ft Forms of the Hebrew \fqa cherem \ft refer to the giving over of things or persons, either by destroying them or by giving them as an offering.\f* \w and make them|strong="H7760"\w* \w an object of horror|strong="H8047"\w* \w and contempt|strong="H8322"\w*, \w an everlasting|strong="H5769"\w* \w desolation|strong="H2723"\w*.
\p \v 10 \w Moreover, I will banish|strong="H6"\w* from them \w the sounds|strong="H6963"\w* \w of joy|strong="H8342"\w* \w and gladness|strong="H8057"\w*, \w the voices|strong="H6963"\w* \w of the bride|strong="H3618"\w* \w and|strong="H6963"\w* \w bridegroom|strong="H2860"\w*, \w the sound|strong="H6963"\w* \w of the millstones|strong="H7347"\w*, \w and the light|strong="H216"\w* \w of the lamp|strong="H5216"\w*. \v 11 \w And this|strong="H2063"\w* \w whole|strong="H3605"\w* \w land|strong="H776"\w* \w will become|strong="H1961"\w* \w a desolate|strong="H2723"\w* \w wasteland|strong="H8047"\w*, \w and these|strong="H428"\w* \w nations|strong="H1471"\w* \w will serve|strong="H5647"\w* \w the king|strong="H4428"\w* \w of Babylon|strong="H894"\w* \w for seventy|strong="H7657"\w* \w years|strong="H8141"\w*.
\p \v 12 \w But when|strong="H1961"\w* \w seventy|strong="H7657"\w* \w years|strong="H8141"\w* \w are complete|strong="H4390"\w*, \w I will punish|strong="H6485"\w* \w the king|strong="H4428"\w* \w of Babylon|strong="H894"\w* \w and that|strong="H1931"\w* \w nation|strong="H1471"\w*, \w the land|strong="H776"\w* \w of the Chaldeans|strong="H3778"\w*,\f + \fr 25:12 \ft That is, the Babylonians\f* \w for their guilt|strong="H5771"\w*, \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*, \w and I will make|strong="H7760"\w* \w it|strong="H853"\w* \w an everlasting|strong="H5769"\w* \w desolation|strong="H8077"\w*.
\p \v 13 \w I will bring|strong="H935"\w* \w upon|strong="H5921"\w* \w that|strong="H1931"\w* \w land|strong="H776"\w* \w all|strong="H3605"\w* \w the words|strong="H1697"\w* \w I have pronounced|strong="H1696"\w* \w against it|strong="H5921"\w*, \w all|strong="H3605"\w* \w that is written|strong="H3789"\w* \w in this|strong="H2088"\w* \w book|strong="H5612"\w*, \w which|strong="H834"\w* \w Jeremiah|strong="H3414"\w* \w has prophesied|strong="H5012"\w* \w against|strong="H5921"\w* \w all|strong="H3605"\w* \w the nations|strong="H1471"\w*. \v 14 \w For|strong="H3588"\w* \w many|strong="H7227"\w* \w nations|strong="H1471"\w* \w and great|strong="H1419"\w* \w kings|strong="H4428"\w* \w will enslave|strong="H5647"\w* \w them|strong="H1992"\w*, \w and I will repay|strong="H7999"\w* them \w according to their deeds|strong="H6467"\w* \w and according to the work|strong="H4639"\w* \w of their hands|strong="H3027"\w*.’”
\s1 The Cup of God’s Wrath
\p \v 15 \w This is what|strong="H3541"\w* \w the LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w said|strong="H559"\w* \w to me|strong="H413"\w*: “\w Take|strong="H3947"\w* \w from My hand|strong="H3027"\w* \w this|strong="H2063"\w* \w cup|strong="H3563"\w* \w of the wine|strong="H3196"\w* \w of wrath|strong="H2534"\w*, \w and make all|strong="H3605"\w* \w the nations|strong="H1471"\w* \w to whom|strong="H834"\w* \w I|strong="H595"\w* \w send|strong="H7971"\w* \w you|strong="H413"\w* \w drink|strong="H8248"\w* \w from it|strong="H853"\w*. \v 16 \w And they will drink|strong="H8354"\w* \w and stagger|strong="H1607"\w* \w and go out of their minds|strong="H1984"\w*, \w because of|strong="H6440"\w* \w the sword|strong="H2719"\w* \w that|strong="H834"\w* \w I|strong="H595"\w* \w will send|strong="H7971"\w* \w among them|strong="H996"\w*.”
\p \v 17 \w So I took|strong="H3947"\w* \w the cup|strong="H3563"\w* \w from the LORD’s|strong="H3068"\w* \w hand|strong="H3027"\w* \w and made all|strong="H3605"\w* \w the nations|strong="H1471"\w* \w drink|strong="H8248"\w* \w from it|strong="H853"\w*, \w each one to whom|strong="H413"\w* \w the LORD|strong="H3068"\w* \w had sent me|strong="H7971"\w*, \v 18 \w to make|strong="H5414"\w* \w them|strong="H853"\w* \w a ruin|strong="H2723"\w*, \w an object of horror|strong="H8047"\w* \w and contempt|strong="H8322"\w* \w and cursing|strong="H7045"\w*, \w as they are to this|strong="H2088"\w* \w day|strong="H3117"\w* — \w Jerusalem|strong="H3389"\w* \w and the cities|strong="H5892"\w* \w of Judah|strong="H3063"\w*, \w its kings|strong="H4428"\w* \w and officials|strong="H8269"\w*; \v 19 \w Pharaoh|strong="H6547"\w* \w king|strong="H4428"\w* \w of Egypt|strong="H4714"\w*, \w his officials|strong="H5650"\w*, \w his leaders|strong="H8269"\w*, \w and|strong="H853"\w* \w all|strong="H3605"\w* \w his people|strong="H5971"\w*; \v 20 \w all|strong="H3605"\w* \w the mixed tribes|strong="H6154"\w*; \w all|strong="H3605"\w* \w the kings|strong="H4428"\w* \w of Uz|strong="H5780"\w*; \w all|strong="H3605"\w* \w the kings|strong="H4428"\w* \w of the Philistines|strong="H6430"\w*: \w Ashkelon|strong="H831"\w*, \w Gaza|strong="H5804"\w*, \w Ekron|strong="H6138"\w*, \w and the remnant|strong="H7611"\w* \w of Ashdod|strong="H795"\w*; \v 21 \w Edom|strong="H123"\w*, \w Moab|strong="H4124"\w*, \w and the Ammonites|strong="H1121"\w*; \v 22 \w all|strong="H3605"\w* \w the kings|strong="H4428"\w* \w of Tyre|strong="H6865"\w* \w and|strong="H853"\w* \w Sidon|strong="H6721"\w*; \w the kings|strong="H4428"\w* \w of the coastlands|strong="H339"\w* \w across|strong="H5676"\w* \w the sea|strong="H3220"\w*; \v 23 \w Dedan|strong="H1719"\w*, \w Tema|strong="H8485"\w*, \w Buz|strong="H938"\w*, \w and all|strong="H3605"\w* \w who cut|strong="H7112"\w* \w the corners of their hair|strong="H6285"\w*; \v 24 \w all|strong="H3605"\w* \w the kings|strong="H4428"\w* \w of Arabia|strong="H6152"\w*, \w and all|strong="H3605"\w* \w the kings|strong="H4428"\w* \w of the mixed tribes|strong="H6154"\w* \w who dwell|strong="H7931"\w* \w in the desert|strong="H4057"\w*; \v 25 \w all|strong="H3605"\w* \w the kings|strong="H4428"\w* \w of Zimri|strong="H2174"\w*, \w Elam|strong="H5867"\w*, \w and|strong="H853"\w* \w Media|strong="H4074"\w*; \v 26 \w all|strong="H3605"\w* \w the kings|strong="H4428"\w* \w of the north|strong="H6828"\w*, \w both near|strong="H7138"\w* \w and far|strong="H7350"\w*, \w one|strong="H376"\w* \w after|strong="H413"\w* \w another|strong="H251"\w* — \w all|strong="H3605"\w* \w the kingdoms|strong="H4467"\w* \w on|strong="H5921"\w* \w the face|strong="H6440"\w* \w of the earth|strong="H127"\w*. \w And after all of them|strong="H310"\w*, \w the king|strong="H4428"\w* \w of Sheshach|strong="H8347"\w*\f + \fr 25:26 \fqa Sheshach \ft is a code name for Babylon.\f* \w will drink it too|strong="H8354"\w*.
\p \v 27 “\w Then you are to tell them|strong="H559"\w* \w that|strong="H413"\w* \w this is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w says|strong="H559"\w*: ‘\w Drink|strong="H8354"\w*, \w get drunk|strong="H7937"\w*, \w and vomit|strong="H7006"\w*. \w Fall down|strong="H5307"\w* \w and never|strong="H3808"\w* \w get up again|strong="H6965"\w*, \w because of|strong="H6440"\w* \w the sword|strong="H2719"\w* \w I|strong="H595"\w* \w will send|strong="H7971"\w* \w among you|strong="H996"\w*.’
\p \v 28 \w If|strong="H3588"\w* \w they refuse|strong="H3985"\w* \w to take|strong="H3947"\w* \w the cup|strong="H3563"\w* \w from your hand|strong="H3027"\w* \w and drink it|strong="H8354"\w*, \w you are to tell them|strong="H559"\w* \w that|strong="H413"\w* \w this is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w* \w says|strong="H559"\w*: ‘\w You most certainly must drink it|strong="H8354"\w*! \v 29 \w For|strong="H3588"\w* \w behold|strong="H2009"\w*, \w I|strong="H595"\w* \w am beginning|strong="H2490"\w* \w to bring disaster|strong="H7489"\w* \w on the city|strong="H5892"\w* \w that|strong="H834"\w* \w bears|strong="H7121"\w* \w My Name|strong="H8034"\w*, \w so how could you|strong="H859"\w* \w possibly go unpunished|strong="H5352"\w*? \w You will not|strong="H3808"\w* \w go unpunished|strong="H5352"\w*, \w for|strong="H3588"\w* \w I|strong="H589"\w* \w am calling down|strong="H7121"\w* \w a sword|strong="H2719"\w* \w upon|strong="H5921"\w* \w all|strong="H3605"\w* \w the inhabitants|strong="H3427"\w* \w of the earth|strong="H776"\w*, \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*.’
\p \v 30 \w So you|strong="H859"\w* \w are to prophesy|strong="H5012"\w* \w all|strong="H3605"\w* \w these|strong="H428"\w* \w words|strong="H1697"\w* \w against|strong="H413"\w* \w them|strong="H853"\w* \w and say|strong="H559"\w* \w to them|strong="H413"\w*:
\b 
\q1 ‘\w The LORD|strong="H3068"\w* \w will roar|strong="H7580"\w* \w from on high|strong="H4791"\w*;
\q2 \w He will raise|strong="H5414"\w* \w His voice|strong="H6963"\w* \w from His holy|strong="H6944"\w* \w habitation|strong="H4583"\w*.
\q1 \w He will roar loudly|strong="H7580"\w* \w over|strong="H5921"\w* \w His pasture|strong="H5116"\w*;
\q2 \w like those who tread the grapes|strong="H1869"\w*,
\q1 \w He will call out|strong="H6030"\w* \w with a shout|strong="H1959"\w*
\q2 \w against|strong="H413"\w* \w all|strong="H3605"\w* \w the inhabitants|strong="H3427"\w* \w of the earth|strong="H776"\w*.
\q1 \v 31 \w The tumult|strong="H7588"\w* \w will resound|strong="H935"\w* \w to|strong="H5704"\w* \w the ends|strong="H7097"\w* \w of the earth|strong="H776"\w*
\q2 \w because|strong="H3588"\w* \w the LORD|strong="H3068"\w* \w brings a charge|strong="H7379"\w* \w against the nations|strong="H1471"\w*.
\q1 \w He|strong="H1931"\w* \w brings judgment|strong="H8199"\w* \w on all|strong="H3605"\w* \w mankind|strong="H1320"\w*
\q2 \w and puts|strong="H5414"\w* \w the wicked|strong="H7563"\w* \w to the sword|strong="H2719"\w*,’”
\qr \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*.
\q1 
\p \v 32 \w This is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w* \w says|strong="H559"\w*:
\b 
\q1 “\w Behold|strong="H2009"\w*! \w Disaster|strong="H7451"\w* \w is spreading|strong="H3318"\w*
\q2 \w from nation|strong="H1471"\w* \w to|strong="H413"\w* \w nation|strong="H1471"\w*;
