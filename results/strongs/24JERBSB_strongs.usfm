\p \v 7 \w So|strong="H3651"\w* \w behold|strong="H2009"\w*, \w the days|strong="H3117"\w* \w are coming|strong="H935"\w*, \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*, \w when they will no|strong="H3808"\w* \w longer|strong="H5750"\w* \w say|strong="H559"\w*, ‘\w As surely as the LORD|strong="H3068"\w* \w lives|strong="H2416"\w*, \w who|strong="H834"\w* \w brought|strong="H5927"\w* \w the Israelites up|strong="H1121"\w* \w out of the land|strong="H776"\w* \w of Egypt|strong="H4714"\w*.’ \v 8 \w Instead|strong="H3588"\w* \w they will say|strong="H518"\w*, ‘\w As surely as the LORD|strong="H3068"\w* \w lives|strong="H2416"\w*, \w who|strong="H834"\w* \w brought|strong="H5927"\w* \w and led|strong="H935"\w* \w the descendants|strong="H2233"\w* \w of the house|strong="H1004"\w* \w of Israel|strong="H3478"\w* \w up out of the land|strong="H776"\w* \w of the north|strong="H6828"\w* \w and all|strong="H3605"\w* \w the other lands|strong="H776"\w* \w to which|strong="H834"\w* \w He had banished them|strong="H5080"\w*.’ \w Then they will dwell|strong="H3427"\w* \w once more in|strong="H5921"\w* \w their own land|strong="H127"\w*.”
\s1 Lying Prophets
\p \v 9 \w As for the prophets|strong="H5030"\w*:
\b 
\q1 \w My heart|strong="H3820"\w* \w is broken|strong="H7665"\w* \w within me|strong="H7130"\w*,
