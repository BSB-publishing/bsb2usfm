\p \v 12 \w For|strong="H3588"\w* \w this is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w says|strong="H559"\w*: “\w If|strong="H2009"\w* \w those who|strong="H834"\w* \w do not|strong="H369"\w* \w deserve|strong="H4941"\w* \w to drink|strong="H8354"\w* \w the cup|strong="H3563"\w* \w must drink it|strong="H8354"\w*, \w can you|strong="H859"\w* \w possibly remain unpunished|strong="H5352"\w*? \w You will not|strong="H3808"\w* \w go unpunished|strong="H5352"\w*, \w for|strong="H3588"\w* \w you must drink it too|strong="H8354"\w*. \v 13 \w For|strong="H3588"\w* by Myself \w I have sworn|strong="H7650"\w*, \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*, \w that|strong="H3588"\w* \w Bozrah|strong="H1224"\w* \w will become|strong="H1961"\w* \w a desolation|strong="H8047"\w*, \w a disgrace|strong="H2781"\w*, \w a ruin|strong="H2721"\w*, \w and a curse|strong="H7045"\w*, \w and all|strong="H3605"\w* \w her cities|strong="H5892"\w* \w will be|strong="H1961"\w* \w in ruins|strong="H2723"\w* \w forever|strong="H5769"\w*.”
\b 
\q1 \v 14 \w I have heard|strong="H8085"\w* \w a message|strong="H8052"\w* \w from the LORD|strong="H3068"\w*;
\q2 \w an envoy|strong="H6735"\w* \w has been sent|strong="H7971"\w* \w to the nations|strong="H1471"\w*:
\q1 “\w Assemble yourselves|strong="H6908"\w* \w to march|strong="H935"\w* \w against her|strong="H5921"\w*!
\q2 \w Rise up|strong="H6965"\w* \w for battle|strong="H4421"\w*!”
\b 
\q1 \v 15 “\w For|strong="H3588"\w* \w behold|strong="H2009"\w*, \w I will make you|strong="H5414"\w* \w small|strong="H6996"\w* \w among nations|strong="H1471"\w*,
\q2 \w despised|strong="H959"\w* \w among men|strong="H120"\w*.
\q1 \v 16 \w The terror you cause|strong="H8606"\w*
\q2 \w and the pride of your|strong="H2087"\w* \w heart|strong="H3820"\w*
