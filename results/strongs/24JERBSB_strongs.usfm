\p \v 8 \w You must not|strong="H3808"\w* \w enter|strong="H935"\w* \w a house|strong="H1004"\w* \w where there is feasting|strong="H4960"\w* \w and sit down|strong="H3427"\w* \w with them|strong="H854"\w* \w to eat|strong="H398"\w* \w and drink|strong="H8354"\w*. \v 9 \w For|strong="H3588"\w* \w this is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w of Hosts|strong="H6635"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w says|strong="H559"\w*: \w I am going to remove|strong="H7673"\w* \w from|strong="H4480"\w* \w this|strong="H2088"\w* \w place|strong="H4725"\w*, \w before your very eyes|strong="H5869"\w* \w and in your days|strong="H3117"\w*, \w the sounds|strong="H6963"\w* \w of joy|strong="H8342"\w* \w and gladness|strong="H8057"\w*, \w the voices|strong="H6963"\w* \w of the bride|strong="H3618"\w* \w and bridegroom|strong="H2860"\w*.
