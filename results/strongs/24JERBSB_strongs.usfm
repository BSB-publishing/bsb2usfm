\p \v 17 \w For|strong="H3588"\w* \w My eyes|strong="H5869"\w* \w are on|strong="H5921"\w* \w all|strong="H3605"\w* \w their ways|strong="H1870"\w*. \w They are not|strong="H3808"\w* \w hidden|strong="H5641"\w* \w from My face|strong="H6440"\w*, \w and their guilt|strong="H5771"\w* \w is not|strong="H3808"\w* \w concealed|strong="H6845"\w* \w from|strong="H5048"\w* \w My eyes|strong="H5869"\w*. \v 18 \w And I will first|strong="H7223"\w* \w repay them|strong="H7999"\w* \w double|strong="H4932"\w* \w their iniquity|strong="H5771"\w* \w and their sin|strong="H2403"\w*, \w because|strong="H5921"\w* \w they have defiled|strong="H2490"\w* \w My land|strong="H776"\w* \w with the carcasses|strong="H5038"\w* \w of their detestable idols|strong="H8251"\w*, \w and they have filled|strong="H4390"\w* \w My inheritance|strong="H5159"\w* \w with their abominations|strong="H8441"\w*.”
