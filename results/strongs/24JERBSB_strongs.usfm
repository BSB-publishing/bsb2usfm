\s1 Another Plot against Jeremiah
\r (\ref Jeremiah 11:18–23|JER 11:18-23\ref*)
\p \v 18 \w Then some said|strong="H559"\w*, “\w Come|strong="H1980"\w*, \w let us make plans|strong="H2803"\w* \w against|strong="H5921"\w* \w Jeremiah|strong="H3414"\w*, \w for|strong="H3588"\w* \w the law|strong="H8451"\w* \w will never|strong="H3808"\w* \w be lost|strong="H6"\w* \w to the priest|strong="H3548"\w*, \w nor counsel|strong="H6098"\w* \w to the wise|strong="H2450"\w*, \w nor an oracle|strong="H1697"\w* \w to the prophet|strong="H5030"\w*. \w Come|strong="H1980"\w*, \w let us denounce him|strong="H5221"\w* \w and pay no|strong="H408"\w* \w heed|strong="H7181"\w* \w to|strong="H413"\w* \w any|strong="H3605"\w* \w of his words|strong="H1697"\w*.”
