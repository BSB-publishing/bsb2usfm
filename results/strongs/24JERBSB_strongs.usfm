\p \w And all|strong="H3605"\w* \w the people|strong="H5971"\w* \w assembled|strong="H6950"\w* \w against|strong="H413"\w* \w Jeremiah|strong="H3414"\w* \w in the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*.
\p \v 10 \w When the officials|strong="H8269"\w* \w of Judah|strong="H3063"\w* \w heard|strong="H8085"\w* \w these|strong="H428"\w* \w things|strong="H1697"\w*, \w they went up|strong="H5927"\w* \w from the king’s|strong="H4428"\w* \w palace|strong="H1004"\w* \w to the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w* \w and sat|strong="H3427"\w* \w there|strong="H3068"\w* \w at the entrance|strong="H6607"\w* \w of the New|strong="H2319"\w* \w Gate|strong="H8179"\w*.
\p \v 11 \w Then the priests|strong="H3548"\w* \w and prophets|strong="H5030"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w the officials|strong="H8269"\w* \w and|strong="H413"\w* \w all|strong="H3605"\w* \w the people|strong="H5971"\w*, “\w This|strong="H2088"\w* \w man|strong="H376"\w* \w is worthy|strong="H4941"\w* \w of death|strong="H4194"\w*, \w for|strong="H3588"\w* \w he has prophesied|strong="H5012"\w* \w against|strong="H413"\w* \w this|strong="H2063"\w* \w city|strong="H5892"\w*, \w as|strong="H834"\w* \w you have heard|strong="H8085"\w* \w with your own ears|strong="H241"\w*!”
\p \v 12 \w But Jeremiah|strong="H3414"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w all|strong="H3605"\w* \w the officials|strong="H8269"\w* \w and|strong="H413"\w* \w all|strong="H3605"\w* \w the people|strong="H5971"\w*, “\w The LORD|strong="H3068"\w* \w sent me|strong="H7971"\w* \w to prophesy|strong="H5012"\w* \w against|strong="H413"\w* \w this|strong="H2088"\w* \w house|strong="H1004"\w* \w and against|strong="H413"\w* \w this|strong="H2063"\w* \w city|strong="H5892"\w* \w all|strong="H3605"\w* \w the words|strong="H1697"\w* \w that|strong="H834"\w* \w you have heard|strong="H8085"\w*. \v 13 \w So now|strong="H6258"\w*, \w correct|strong="H3190"\w* \w your ways|strong="H1870"\w* \w and deeds|strong="H4611"\w*, \w and obey|strong="H8085"\w* \w the voice|strong="H6963"\w* \w of the LORD|strong="H3068"\w* \w your God|strong="H430"\w*, \w so that He|strong="H3068"\w* \w might relent|strong="H5162"\w* \w of|strong="H413"\w* \w the disaster|strong="H7451"\w* \w He has pronounced|strong="H1696"\w* \w against you|strong="H5921"\w*. \v 14 \w As for me|strong="H589"\w*, \w here|strong="H2005"\w* \w I am in your hands|strong="H3027"\w*; \w do|strong="H6213"\w* to me \w what you think|strong="H5869"\w* \w is good|strong="H2896"\w* \w and right|strong="H3477"\w*. \v 15 \w But|strong="H389"\w* \w know for certain|strong="H3045"\w* \w that|strong="H3588"\w* \w if|strong="H518"\w* \w you|strong="H859"\w* \w put me to death|strong="H4191"\w*, \w you|strong="H859"\w* \w will bring|strong="H5414"\w* \w innocent|strong="H5355"\w* \w blood|strong="H1818"\w* \w upon yourselves|strong="H5921"\w*, \w upon|strong="H413"\w* \w this|strong="H2063"\w* \w city|strong="H5892"\w*, \w and upon|strong="H413"\w* \w its residents|strong="H3427"\w*; \w for|strong="H3588"\w* \w truly|strong="H571"\w* \w the LORD|strong="H3068"\w* \w has sent me|strong="H7971"\w* \w to speak|strong="H1696"\w* \w all|strong="H3605"\w* \w these|strong="H428"\w* \w words|strong="H1697"\w* \w in your hearing