\p \v 25 “\w Behold|strong="H2009"\w*, \w the days|strong="H3117"\w* \w are coming|strong="H935"\w*,” \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*, “\w when I will punish|strong="H6485"\w* \w all who are|strong="H3605"\w* \w circumcised|strong="H4135"\w* \w only in the flesh|strong="H6190"\w*— \v 26 \w Egypt|strong="H4714"\w*, \w Judah|strong="H3063"\w*, \w Edom|strong="H123"\w*, \w Ammon|strong="H5983"\w*, \w Moab|strong="H4124"\w*, \w and all|strong="H3605"\w* \w the inhabitants|strong="H3427"\w* \w of the desert|strong="H4057"\w* \w who clip the hair|strong="H7112"\w* \w of their temples|strong="H6285"\w*. \w For all|strong="H3605"\w* \w these nations|strong="H1471"\w* \w are uncircumcised|strong="H6189"\w*, \w and the whole|strong="H3605"\w* \w house|strong="H1004"\w* \w of Israel|strong="H3478"\w* \w is uncircumcised|strong="H6189"\w* \w in heart|strong="H3820"\w*.”
\c 10
\s1 The Sovereignty of God
\p \v 1 \w Hear|strong="H8085"\w* \w the word|strong="H1697"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w speaks|strong="H1696"\w* \w to you|strong="H5921"\w*, \w O house|strong="H1004"\w* \w of Israel|strong="H3478"\w*. \v 2 \w This is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w says|strong="H559"\w*:
\b 
\q1 “\w Do not|strong="H408"\w* \w learn|strong="H3925"\w* \w the ways|strong="H1870"\w* \w of the nations|strong="H1471"\w*
