\q2 \w you will understand|strong="H995"\w* this \w clearly|strong="H998"\w*.
\b 
\q1 \v 21 \w I did not|strong="H3808"\w* \w send|strong="H7971"\w* \w these prophets|strong="H5030"\w*,
\q2 \w yet they|strong="H1992"\w* \w have run with their message|strong="H7323"\w*;
\q1 \w I did not|strong="H3808"\w* \w speak|strong="H1696"\w* \w to them|strong="H413"\w*,
\q2 \w yet they|strong="H1992"\w* \w have prophesied|strong="H5012"\w*.
