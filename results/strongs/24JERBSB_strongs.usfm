\p \v 5 \w By My great|strong="H1419"\w* \w power|strong="H3581"\w* \w and outstretched|strong="H5186"\w* \w arm|strong="H2220"\w*, \w I|strong="H595"\w* \w made|strong="H6213"\w* \w the earth|strong="H776"\w* \w and the men|strong="H120"\w* \w and|strong="H853"\w* \w beasts|strong="H929"\w* \w on|strong="H5921"\w* \w the face|strong="H6440"\w* \w of it|strong="H776"\w*, \w and I give it|strong="H5414"\w* \w to whom|strong="H834"\w* \w I please|strong="H3474"\w*. \v 6 \w So now|strong="H6258"\w* \w I|strong="H595"\w* \w have placed|strong="H5414"\w* \w all|strong="H3605"\w* \w these|strong="H428"\w* \w lands|strong="H776"\w* \w under the authority|strong="H3027"\w* \w of My servant|strong="H5650"\w* \w Nebuchadnezzar|strong="H5019"\w* \w king|strong="H4428"\w* \w of Babylon|strong="H894"\w*. \w I have even|strong="H1571"\w* \w made|strong="H5414"\w* \w the beasts|strong="H2416"\w* \w of the field|strong="H7704"\w* \w subject|strong="H5647"\w* to him. \v 7 \w All|strong="H3605"\w* \w nations|strong="H1471"\w* \w will serve him|strong="H5647"\w* \w and|strong="H853"\w* \w his son|strong="H1121"\w* \w and grandson|strong="H1121"\w*, \w until|strong="H5704"\w* \w the time|strong="H6256"\w* \w of his own land|strong="H776"\w* \w comes|strong="H935"\w*; \w then many|strong="H7227"\w* \w nations|strong="H1471"\w* \w and great|strong="H1419"\w* \w kings|strong="H4428"\w* \w will enslave|strong="H5647"\w* him.
\p \v 8 \w As for the nation|strong="H1471"\w* \w or kingdom|strong="H4467"\w* \w that|strong="H834"\w* \w does not|strong="H3808"\w* \w serve|strong="H5647"\w* \w Nebuchadnezzar|strong="H5019"\w* \w king|strong="H4428"\w* \w of Babylon|strong="H894"\w* \w and does not|strong="H3808"\w* \w place|strong="H5414"\w* \w its neck|strong="H6677"\w* \w under his yoke|strong="H5923"\w*, \w I will punish|strong="H6485"\w* \w that|strong="H1931"\w* \w nation|strong="H1471"\w* \w by sword|strong="H2719"\w* \w and famine|strong="H7458"\w* \w and plague|strong="H1698"\w*, \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*, \w until|strong="H5704"\w* \w I have destroyed|strong="H8552"\w* \w it|strong="H853"\w* \w by his hand|strong="H3027"\w*.
