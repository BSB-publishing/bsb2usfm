\p \v 1 \w Then the word|strong="H1697"\w* \w of the LORD|strong="H3068"\w* \w came|strong="H1961"\w* \w to me|strong="H413"\w*, \w saying|strong="H559"\w*, \v 2 “\w You must not|strong="H3808"\w* \w marry|strong="H3947"\w* \w or|strong="H3808"\w* \w have|strong="H1961"\w* \w sons|strong="H1121"\w* \w or daughters|strong="H1323"\w* \w in this|strong="H2088"\w* \w place|strong="H4725"\w*.”
\p \v 3 \w For|strong="H3588"\w* \w this is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w says|strong="H559"\w* \w concerning|strong="H5921"\w* \w the sons|strong="H1121"\w* \w and|strong="H5921"\w* \w daughters|strong="H1323"\w* \w born in this|strong="H2088"\w* \w place|strong="H4725"\w*, \w and|strong="H5921"\w* \w the mothers|strong="H517"\w* \w who bore them|strong="H3209"\w*, \w and the fathers|strong="H1"\w* \w who fathered|strong="H3205"\w* \w them|strong="H853"\w* \w in this|strong="H2063"\w* \w land|strong="H776"\w*: \v 4 “\w They will die|strong="H4191"\w* \w from deadly|strong="H4463"\w* \w diseases|strong="H8463"\w*. \w They will not|strong="H3808"\w* \w be mourned|strong="H5594"\w* \w or buried|strong="H6912"\w*, \w but will lie|strong="H1961"\w* \w like dung|strong="H1828"\w* \w on|strong="H5921"\w* \w the ground|strong="H127"\w*. \w They will be finished off|strong="H3615"\w* \w by sword|strong="H2719"\w* \w and famine|strong="H7458"\w*, \w and their corpses|strong="H5038"\w* \w will become|strong="H1961"\w* \w food|strong="H3978"\w* \w for the birds|strong="H5775"\w* \w of the air|strong="H8064"\w* \w and beasts|strong="H929"\w* \w of the earth|strong="H776"\w*.”
