\q2 \w I have seen|strong="H7200"\w* \w a horrible thing|strong="H8186"\w*:
\q1 \w They commit adultery|strong="H5003"\w*
\q2 \w and walk|strong="H1980"\w* \w in lies|strong="H8267"\w*.
\q1 \w They strengthen|strong="H2388"\w* \w the hands|strong="H3027"\w* \w of evildoers|strong="H7489"\w*,
\q2 \w so that no|strong="H1115"\w* \w one|strong="H376"\w* \w turns his back|strong="H7725"\w* \w on wickedness|strong="H7451"\w*.
