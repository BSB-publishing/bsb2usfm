\p \v 11 \w For|strong="G1063"\w* \w we hear that|strong="G191"\w* \w some|strong="G5100"\w* \w of|strong="G1722"\w* \w you|strong="G4771"\w* \w are leading|strong="G4043"\w* \w undisciplined lives|strong="G814"\w*, \w accomplishing|strong="G2038"\w* \w nothing|strong="G3367"\w*, \w but|strong="G235"\w* \w being busybodies|strong="G4020"\w*. \v 12 \w We command|strong="G3853"\w* \w and|strong="G2532"\w* \w urge|strong="G3870"\w* \w such people|strong="G5108"\w* \w by|strong="G1722"\w* \w our Lord|strong="G2962"\w* \w Jesus|strong="G2424"\w* \w Christ|strong="G5547"\w* \w to|strong="G2443"\w* \w begin working|strong="G2038"\w* \w quietly|strong="G2271"\w* \w to earn their own living|strong="G2068"\w*. \v 13 \w But as for|strong="G1161"\w* \w you|strong="G4771"\w*, \w brothers|strong="G80"\w*, \w do not|strong="G3361"\w* \w grow weary|strong="G1573"\w* \w in well-doing|strong="G2569"\w*.
\p \v 14 \w Take note|strong="G4593"\w* \w of|strong="G3778"\w* \w anyone who|strong="G5100"\w* \w does not|strong="G3756"\w* \w obey|strong="G5219"\w* \w the|strong="G3588"\w* \w instructions we have given|strong="G3056"\w* \w in|strong="G1223"\w* \w this|strong="G3588"\w* \w letter|strong="G1992"\w*. \w Do not|strong="G3361"\w* \w associate with|strong="G4874"\w* \w him|strong="G846"\w*, \w so that|strong="G2443"\w* \w he may be ashamed|strong="G1788"\w*. \v 15 \w Yet|strong="G2532"\w* \w do not|strong="G3361"\w* \w regard him|strong="G2233"\w* \w as|strong="G5613"\w* \w an enemy|strong="G2190"\w*, \w but|strong="G235"\w* \w admonish him|strong="G3560"\w* \w as|strong="G5613"\w* \w a brother|strong="G80"\w*.
