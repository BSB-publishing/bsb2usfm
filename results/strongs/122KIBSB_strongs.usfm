\s1 The Murder of Gedaliah
\r (\ref Jeremiah 41:1–10|JER 41:1-10\ref*)
\p \v 25 \w In the seventh|strong="H7637"\w* \w month, however|strong="H2320"\w*, \w Ishmael|strong="H3458"\w* \w son|strong="H1121"\w* \w of Nethaniah|strong="H5418"\w*, \w the son|strong="H1121"\w* \w of Elishama|strong="H476"\w*, \w who was a member of the royal|strong="H4410"\w* \w family|strong="H2233"\w*, \w came|strong="H935"\w* \w with|strong="H854"\w* \w ten|strong="H6235"\w* \w men|strong="H582"\w* \w and struck down|strong="H5221"\w* \w and killed|strong="H4191"\w* \w Gedaliah|strong="H1436"\w*, \w along with the Judeans|strong="H3064"\w* \w and Chaldeans|strong="H3778"\w* \w who|strong="H834"\w* \w were|strong="H1961"\w* \w with him|strong="H854"\w* \w at Mizpah|strong="H4709"\w*. \v 26 \w Then all|strong="H3605"\w* \w the people|strong="H5971"\w* \w small|strong="H6996"\w* \w and|strong="H5704"\w* \w great|strong="H1419"\w*, \w together with the commanders|strong="H8269"\w* \w of the army|strong="H2428"\w*, \w arose|strong="H6965"\w* \w and fled|strong="H935"\w* \w to Egypt|strong="H4714"\w* \w for|strong="H3588"\w* \w fear|strong="H3372"\w* \w of|strong="H6440"\w* \w the Chaldeans|strong="H3778"\w*.
\s1 Jehoiachin Released from Prison
\r (\ref Jeremiah 52:31–34|JER 52:31-34\ref*)
\p \v 27 \w On the twenty-seventh day|strong="H6242"\w* \w of the twelfth|strong="H8147"\w* \w month|strong="H2320"\w* \w of the thirty-seventh|strong="H7970"\w* \w year|strong="H8141"\w* \w of the exile|strong="H1546"\w* \w of Judah’s|strong="H3063"\w* \w King|strong="H4428"\w* \w Jehoiachin|strong="H3078"\w*, \w in the year|strong="H8141"\w* \w Evil-merodach|strong="H192"\w* \w became king|strong="H4428"\w* \w of Babylon|strong="H894"\w*, \w he released|strong="H5375"\w*\f + \fr 25:27 \ft Literally \fqa lifted up the head of\f* \w King|strong="H4428"\w* \w Jehoiachin|strong="H3078"\w* \w of Judah|strong="H3063"\w* \w from|strong="H1004"\w* \w prison|strong="H3608"\w*. \v 28 \w And he spoke|strong="H1696"\w* \w kindly|strong="H2896"\w* \w to Jehoiachin|strong="H854"\w* \w and set|strong="H5414"\w* \w his throne|strong="H3678"\w* \w above|strong="H5921"\w* \w the thrones|strong="H3678"\w* \w of the other kings|strong="H4428"\w* \w who were|strong="H834"\w* \w with him|strong="H854"\w* \w in Babylon|strong="H894"\w*.
\p \v 29 \w So Jehoiachin changed|strong="H8132"\w* \w out of his prison|strong="H3608"\w* \w clothes|strong="H899"\w*, \w and he dined|strong="H398"\w* \w regularly|strong="H8548"\w* \w at the king’s table|strong="H6440"\w* \w for the rest|strong="H3605"\w* \w of his life|strong="H2416"\w*. \v 30 \w And the king|strong="H4428"\w* \w provided Jehoiachin|strong="H5414"\w* \w a daily|strong="H3117"\w* \w portion|strong="H8548"\w* \w for the rest|strong="H3605"\w* \w of his life|strong="H2416"\w*.
