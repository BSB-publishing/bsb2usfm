\p \v 26 \w As the king|strong="H4428"\w* \w of Israel|strong="H3478"\w* \w was passing by|strong="H5674"\w* \w on|strong="H5921"\w* \w the wall|strong="H2346"\w*, \w a woman|strong="H802"\w* \w cried out|strong="H6817"\w* \w to him|strong="H413"\w*, “\w Help me|strong="H3467"\w*, \w my lord|strong="H113"\w* \w the king|strong="H4428"\w*!”
