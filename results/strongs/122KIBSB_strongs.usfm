\p \v 1 \w In the seventeenth|strong="H7651"\w* \w year|strong="H8141"\w* \w of Pekah|strong="H6492"\w* \w son|strong="H1121"\w* \w of Remaliah|strong="H7425"\w*, \w Ahaz|strong="H271"\w* \w son|strong="H1121"\w* \w of Jotham|strong="H3147"\w* \w became king|strong="H4427"\w* \w of Judah|strong="H3063"\w*. \v 2 \w Ahaz|strong="H271"\w* \w was twenty|strong="H6242"\w* \w years old|strong="H1121"\w* \w when he became king|strong="H4427"\w*, \w and he reigned|strong="H4427"\w* \w in Jerusalem|strong="H3389"\w* \w sixteen|strong="H8337"\w* \w years|strong="H8141"\w*. \w And unlike David|strong="H1732"\w* \w his father|strong="H1"\w*, \w he did not|strong="H3808"\w* \w do|strong="H6213"\w* \w what was right|strong="H3477"\w* \w in the eyes|strong="H5869"\w* \w of the LORD|strong="H3068"\w* \w his God|strong="H430"\w*. \v 3 \w Instead, he walked|strong="H1980"\w* \w in the ways|strong="H1870"\w* \w of the kings|strong="H4428"\w* \w of Israel|strong="H3478"\w* \w and even|strong="H1571"\w* \w sacrificed|strong="H5674"\w* \w his son|strong="H1121"\w* \w in the fire|strong="H784"\w*,\f + \fr 16:3 \ft Literally \fqa made his son pass through the fire\f* \w according to the abominations|strong="H8441"\w* \w of the nations|strong="H1471"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had driven out|strong="H3423"\w* \w before|strong="H6440"\w* \w the Israelites|strong="H1121"\w*. \v 4 \w And he sacrificed|strong="H2076"\w* \w and burned incense|strong="H6999"\w* \w on the high places|strong="H1116"\w*, \w on|strong="H5921"\w* \w the hills|strong="H1389"\w*, \w and under|strong="H8478"\w* \w every|strong="H3605"\w* \w green|strong="H7488"\w* \w tree|strong="H6086"\w*.
\p \v 5 \w Then|strong="H227"\w* \w Rezin|strong="H7526"\w* \w king|strong="H4428"\w* \w of Aram|strong="H758"\w* \w and Pekah|strong="H6492"\w* \w son|strong="H1121"\w* \w of Remaliah|strong="H7425"\w* \w king|strong="H4428"\w* \w of Israel|strong="H3478"\w* \w came up|strong="H5927"\w* \w to wage war|strong="H4421"\w* \w against Jerusalem|strong="H3389"\w*. \w They besieged|strong="H6696"\w* \w Ahaz|strong="H271"\w* \w but could|strong="H3201"\w* \w not|strong="H3808"\w* \w overcome him|strong="H3898"\w*.
\p \v 6 \w At that|strong="H1931"\w* \w time|strong="H6256"\w* \w Rezin|strong="H7526"\w* \w king|strong="H4428"\w* \w of Aram|strong="H758"\w* \w recovered|strong="H7725"\w* \w Elath|strong="H359"\w*\f + \fr 16:6 \fqa Elath \ft is a variant of \fqa Eloth\ft ; see \ref 1 Kings 9:26|1KI 9:26\ref*.\f* \w for Aram|strong="H758"\w*,\f + \fr 16:6 \ft Or \fqa Syria\f* \w drove out|strong="H5394"\w* \w the men of Judah|strong="H3064"\w*, \w and sent|strong="H935"\w* \w the Edomites|strong="H761"\w* \w into Elath|strong="H359"\w*, \w where|strong="H8033"\w* \w they live|strong="H3427"\w* \w to|strong="H5704"\w* \w this|strong="H2088"\w* \w day|strong="H3117"\w*.
\p \v 7 \w So Ahaz|strong="H271"\w* \w sent|strong="H7971"\w* \w messengers|strong="H4397"\w* \w to|strong="H413"\w* \w Tiglath-pileser|strong="H8407"\w* \w king|strong="H4428"\w* \w of Assyria|strong="H804"\w*, \w saying|strong="H559"\w*, “\w I|strong="H589"\w* \w am your servant|strong="H5650"\w* \w and your son|strong="H1121"\w*. \w Come up|strong="H5927"\w* \w and save me|strong="H3467"\w* \w from the hands|strong="H3709"\w* \w of the kings|strong="H4428"\w* \w of Aram|strong="H758"\w* \w and|strong="H4428"\w* \w Israel|strong="H3478"\w*, \w who are rising up|strong="H6965"\w* \w against me|strong="H5921"\w*.”
\p \v 8 \w Ahaz|strong="H271"\w* \w also took|strong="H3947"\w* \w the silver|strong="H3701"\w* \w and gold|strong="H2091"\w* \w found|strong="H4672"\w* \w in the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w* \w and in the treasuries|strong="H214"\w* \w of the king’s|strong="H4428"\w* \w palace|strong="H1004"\w*, \w and he sent it|strong="H7971"\w* \w as a gift|strong="H7810"\w* \w to the king|strong="H4428"\w* \w of Assyria|strong="H804"\w*. \v 9 \w So the king|strong="H4428"\w* \w of Assyria|strong="H804"\w* \w responded|strong="H8085"\w* \w to him|strong="H413"\w*, \w marched up|strong="H5927"\w* \w to|strong="H413"\w* \w Damascus|strong="H1834"\w*, \w and captured it|strong="H8610"\w*. \w He took its people|strong="H1540"\w* \w to Kir as captives|strong="H7024"\w* \w and|strong="H853"\w* \w put Rezin|strong="H7526"\w* \w to death|strong="H4191"\w*.
\s1 The Idolatry of Ahaz
