\c 18
\s1 Hezekiah Destroys Idolatry in Judah
\r (\ref 2 Chronicles 29:1–2|2CH 29:1-2\ref*)
\p \v 1 \w In the third|strong="H7969"\w* \w year|strong="H8141"\w* \w of the reign|strong="H4428"\w* \w of Hoshea|strong="H1954"\w* \w son|strong="H1121"\w* \w of Elah|strong="H425"\w* \w over Israel|strong="H3478"\w*, \w Hezekiah|strong="H2396"\w* \w son|strong="H1121"\w* \w of Ahaz|strong="H271"\w* \w became king|strong="H4427"\w* \w of Judah|strong="H3063"\w*. \v 2 \w He was|strong="H1961"\w* \w twenty-five|strong="H6242"\w* \w years old|strong="H1121"\w* \w when he became king|strong="H4427"\w*, \w and he reigned|strong="H4427"\w* \w in Jerusalem|strong="H3389"\w* \w twenty-nine|strong="H6242"\w* \w years|strong="H8141"\w*. \w His mother’s|strong="H517"\w* \w name|strong="H8034"\w* \w was Abi|strong="H21"\w*,\f + \fr 18:2 \fqa Abi \ft is a variant of \fqa Abijah\ft ; see \ref 2 Chronicles 29:1|2CH 29:1\ref*.\f* \w the daughter|strong="H1323"\w* \w of Zechariah|strong="H2148"\w*. \v 3 \w And he did|strong="H6213"\w* \w what was right|strong="H3477"\w* \w in the eyes|strong="H5869"\w* \w of the LORD|strong="H3068"\w*, \w just as|strong="H3605"\w* \w his father|strong="H1"\w* \w David|strong="H1732"\w* \w had done|strong="H6213"\w*. \v 4 \w He removed|strong="H5493"\w* \w the high places|strong="H1116"\w*, \w shattered|strong="H7665"\w* \w the sacred pillars|strong="H4676"\w*, \w and cut down|strong="H3772"\w* \w the Asherah poles|strong="H842"\w*. \w He also demolished|strong="H3807"\w* \w the bronze|strong="H5178"\w* \w snake|strong="H5175"\w* \w called|strong="H7121"\w* \w Nehushtan|strong="H5180"\w*\f + \fr 18:4 \fqa Nehushtan \ft sounds like the Hebrew for \fqa bronze \ft and also for \fqa snake\ft .\f* \w that|strong="H834"\w* \w Moses|strong="H4872"\w* \w had made|strong="H6213"\w*, \w for|strong="H3588"\w* \w up to|strong="H5704"\w* \w that|strong="H1992"\w* \w time|strong="H3117"\w* \w the Israelites|strong="H1121"\w* \w had burned incense|strong="H6999"\w* to it.
\p \v 5 \w Hezekiah trusted|strong="H982"\w* \w in the LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*. \w No|strong="H3808"\w* \w king|strong="H4428"\w* \w of Judah|strong="H3063"\w* \w was|strong="H1961"\w* \w like him|strong="H3644"\w*, \w either before him|strong="H6440"\w* \w or after him|strong="H310"\w*. \v 6 \w He remained faithful|strong="H1692"\w* \w to the LORD|strong="H3068"\w* \w and did not|strong="H3808"\w* \w turn|strong="H5493"\w* \w from following Him|strong="H310"\w*; \w he kept|strong="H8104"\w* \w the commandments|strong="H4687"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had given|strong="H6680"\w* \w Moses|strong="H4872"\w*.
