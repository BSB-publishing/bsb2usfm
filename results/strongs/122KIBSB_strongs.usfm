\p \v 8 \w When|strong="H3588"\w* \w the Rabshakeh|strong="H7262"\w* \w heard|strong="H8085"\w* \w that|strong="H3588"\w* \w the king|strong="H4428"\w* \w of Assyria|strong="H804"\w* \w had left|strong="H5265"\w* \w Lachish|strong="H3923"\w*, \w he withdrew|strong="H7725"\w* \w and found|strong="H4672"\w* \w the king fighting|strong="H3898"\w* \w against|strong="H5921"\w* \w Libnah|strong="H3841"\w*.
