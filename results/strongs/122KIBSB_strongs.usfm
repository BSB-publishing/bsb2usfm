\p \v 16 \w So Uriah|strong="H223"\w* \w the priest|strong="H3548"\w* \w did|strong="H6213"\w* \w just as|strong="H3605"\w* \w King|strong="H4428"\w* \w Ahaz|strong="H271"\w* \w had commanded|strong="H6680"\w*.
\p \v 17 \w King|strong="H4428"\w* \w Ahaz also|strong="H271"\w* \w cut off|strong="H7112"\w* \w the frames|strong="H4526"\w* \w of the movable stands|strong="H4350"\w* \w and removed|strong="H5493"\w* \w the bronze basin|strong="H3595"\w* \w from each of them|strong="H5921"\w*. \w He took down|strong="H3381"\w* \w the Sea|strong="H3220"\w* \w from|strong="H5921"\w* \w the bronze|strong="H5178"\w* \w oxen|strong="H1241"\w* \w that|strong="H834"\w* \w were under it|strong="H8478"\w* \w and put|strong="H5414"\w* \w it|strong="H853"\w* \w on|strong="H5921"\w* \w a stone|strong="H68"\w* \w base|strong="H4837"\w*. \v 18 \w And|strong="H853"\w* \w on account|strong="H6440"\w* \w of the king|strong="H4428"\w* \w of Assyria|strong="H804"\w*, \w he removed|strong="H5437"\w* \w the Sabbath|strong="H7676"\w* \w canopy|strong="H4329"\w*\f + \fr 16:18 \ft Or \fqa the base of his throne\ft ; see also LXX.\f* \w they had built|strong="H1129"\w* \w in the temple|strong="H1004"\w* \w and closed the royal|strong="H4428"\w* \w entryway|strong="H3996"\w* \w outside|strong="H2435"\w* \w the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*.
