\p \v 1 \w Now Naaman|strong="H5283"\w*, \w the commander|strong="H8269"\w* \w of the army|strong="H6635"\w* \w of the king|strong="H4428"\w* \w of Aram|strong="H758"\w*, \w was|strong="H1961"\w* \w a great|strong="H1419"\w* \w man|strong="H376"\w* \w in his master’s|strong="H113"\w* \w sight|strong="H6440"\w* \w and highly regarded|strong="H5375"\w*, \w for|strong="H3588"\w* through him \w the LORD|strong="H3068"\w* \w had given|strong="H5414"\w* \w victory|strong="H8668"\w* \w to Aram|strong="H758"\w*. \w And he was|strong="H1961"\w* \w a mighty|strong="H1368"\w* \w man|strong="H376"\w* \w of valor|strong="H2428"\w*, \w but he was a leper|strong="H6879"\w*.\f + \fr 5:1 \ft A \fqa leper\ft , or one with \fqa leprosy\ft , was one afflicted with a skin disease; here and throughout this chapter; see Leviticus 13.\f*
\p \v 2 \w At this time the Arameans|strong="H758"\w* \w had gone out|strong="H3318"\w* \w in bands|strong="H1416"\w* \w and had taken|strong="H7617"\w* \w a young|strong="H6996"\w* \w girl|strong="H5291"\w* \w from the land|strong="H776"\w* \w of Israel|strong="H3478"\w*, \w and she was serving|strong="H1961"\w* \w Naaman’s|strong="H5283"\w* \w wife|strong="H802"\w*. \v 3 \w She said|strong="H559"\w* \w to|strong="H413"\w* \w her mistress|strong="H1404"\w*, “\w If only|strong="H305"\w* \w my master|strong="H113"\w* \w would go to the prophet|strong="H5030"\w* \w who|strong="H834"\w* \w is in Samaria|strong="H8111"\w*, \w he would cure|strong="H622"\w* \w him|strong="H853"\w* \w of his leprosy|strong="H6883"\w*.”
\p \v 4 \w And Naaman went|strong="H935"\w* \w and told|strong="H5046"\w* \w his master|strong="H113"\w* \w what|strong="H2063"\w* \w the girl|strong="H5291"\w* \w from the land|strong="H776"\w* \w of Israel|strong="H3478"\w* \w had said|strong="H1696"\w*.
\p \v 5 “\w Go now|strong="H1980"\w*,” \w said|strong="H559"\w* \w the king|strong="H4428"\w* \w of Aram|strong="H758"\w*, “\w and I will send you with|strong="H7971"\w* \w a letter|strong="H5612"\w* \w to|strong="H413"\w* \w the king|strong="H4428"\w* \w of Israel|strong="H3478"\w*.”
\p \w So Naaman departed|strong="H1980"\w*, \w taking|strong="H3947"\w* \w with him|strong="H3027"\w* \w ten|strong="H6235"\w* \w talents|strong="H3603"\w* \w of silver|strong="H3701"\w*,\f + \fr 5:5 \fqa 10 talents \ft is approximately 754 pounds or 342 kilograms of silver.\f* \w six|strong="H8337"\w* \w thousand shekels|strong="H505"\w* \w of gold|strong="H2091"\w*,\f + \fr 5:5 \fqa 6,000 shekels \ft is approximately 150.8 pounds or 68.4 kilograms of gold.\f* \w and ten|strong="H6235"\w* \w sets|strong="H2487"\w* \w of clothing|strong="H899"\w*.
\p \v 6 \w And the letter|strong="H5612"\w* \w that he took|strong="H935"\w* \w to|strong="H413"\w* \w the king|strong="H4428"\w* \w of Israel|strong="H3478"\w* \w stated|strong="H559"\w*: “\w With|strong="H6258"\w* \w this|strong="H2088"\w* \w letter|strong="H5612"\w* \w I am sending|strong="H7971"\w* \w my servant|strong="H5650"\w* \w Naaman|strong="H5283"\w*, \w so that you may cure him|strong="H622"\w* \w of his leprosy|strong="H6883"\w*.”
\p \v 7 \w When the king|strong="H4428"\w* \w of Israel|strong="H3478"\w* \w read|strong="H7121"\w* \w the letter|strong="H5612"\w*, \w he tore|strong="H7167"\w* \w his clothes|strong="H899"\w* \w and asked|strong="H559"\w*, “\w Am I|strong="H589"\w* \w God|strong="H430"\w*, \w killing|strong="H4191"\w* \w and giving life|strong="H2421"\w*, \w that|strong="H3588"\w* \w this man|strong="H2088"\w* \w expects|strong="H7971"\w* \w me|strong="H413"\w* \w to cure|strong="H622"\w* \w a leper|strong="H6883"\w*? \w Surely you can|strong="H3045"\w* \w see|strong="H7200"\w* \w that|strong="H3588"\w* \w he|strong="H1931"\w* \w is seeking a quarrel|strong="H579"\w* with me!”
\p \v 8 \w Now|strong="H1961"\w* \w when Elisha|strong="H477"\w* \w the man|strong="H376"\w* \w of God|strong="H430"\w* \w heard|strong="H8085"\w* \w that|strong="H3588"\w* \w the king|strong="H4428"\w* \w of Israel|strong="H3478"\w* \w had torn|strong="H7167"\w* \w his clothes|strong="H899"\w*, \w he sent|strong="H7971"\w* \w a message to|strong="H413"\w* \w the king|strong="H4428"\w*: “\w Why|strong="H4100"\w* \w have you torn|strong="H7167"\w* \w your clothes|strong="H899"\w*? \w Please|strong="H4994"\w* \w let the man come|strong="H935"\w* \w to me|strong="H413"\w*, \w and he will know|strong="H3045"\w* \w that|strong="H3588"\w* \w there is|strong="H3426"\w* \w a prophet|strong="H5030"\w* \w in Israel|strong="H3478"\w*.”
\p \v 9 \w So Naaman|strong="H5283"\w* \w came|strong="H935"\w* \w with his horses|strong="H5483"\w* \w and chariots|strong="H7393"\w* \w and stood|strong="H5975"\w* \w at the door|strong="H6607"\w* \w of Elisha’s|strong="H477"\w* \w house|strong="H1004"\w*.
\p \v 10 \w Then Elisha|strong="H477"\w* \w sent|strong="H7971"\w* \w him|strong="H413"\w* \w a messenger|strong="H4397"\w*, \w who said|strong="H559"\w*, “\w Go|strong="H1980"\w* \w and wash yourself|strong="H7364"\w* \w seven|strong="H7651"\w* \w times|strong="H6471"\w* \w in the Jordan|strong="H3383"\w*, \w and your flesh|strong="H1320"\w* \w will be restored|strong="H7725"\w*, \w and you will be clean|strong="H2891"\w*.”
\p \v 11 \w But Naaman|strong="H5283"\w* \w went away|strong="H1980"\w* \w angry|strong="H7107"\w*, \w saying|strong="H559"\w*, “\w I thought that|strong="H559"\w* \w he would surely come out|strong="H3318"\w*, \w stand|strong="H5975"\w* \w and call|strong="H7121"\w* \w on the name|strong="H8034"\w* \w of the LORD|strong="H3068"\w* \w his God|strong="H430"\w*, \w and wave|strong="H5130"\w* \w his hand|strong="H3027"\w* \w over|strong="H413"\w* \w the spot|strong="H4725"\w* \w to cure|strong="H622"\w* \w my leprosy|strong="H6879"\w*. \v 12 \w Are not|strong="H3808"\w* \w the Abanah|strong="H71"\w* \w and Pharpar|strong="H6554"\w*, \w the rivers|strong="H5104"\w* \w of Damascus|strong="H1834"\w*, \w better|strong="H2896"\w* \w than all|strong="H3605"\w* \w the waters|strong="H4325"\w* \w of Israel|strong="H3478"\w*? \w Could I not|strong="H3808"\w* \w have washed|strong="H7364"\w* in them \w and been cleansed|strong="H2891"\w*?” \w So he turned|strong="H6437"\w* \w and went away|strong="H1980"\w* \w in a rage|strong="H2534"\w*.
\p \v 13 \w Naaman’s servants, however|strong="H5650"\w*, \w approached him|strong="H5066"\w* \w and said|strong="H1696"\w*, “\w My father|strong="H1"\w*, \w if the prophet|strong="H5030"\w* \w had told|strong="H1696"\w* \w you|strong="H413"\w* \w to do some great|strong="H1419"\w* \w thing|strong="H1697"\w*, \w would you not|strong="H3808"\w* \w have done it|strong="H6213"\w*? \w How much more, then|strong="H637"\w*, \w when|strong="H3588"\w* \w he tells|strong="H559"\w* \w you|strong="H413"\w*, ‘\w Wash|strong="H7364"\w* \w and be cleansed|strong="H2891"\w*’?”
\p \v 14 \w So Naaman went down|strong="H3381"\w* \w and dipped himself|strong="H2881"\w* \w in the Jordan|strong="H3383"\w* \w seven|strong="H7651"\w* \w times|strong="H6471"\w*, \w according to the word|strong="H1697"\w* \w of the man|strong="H376"\w* \w of God|strong="H430"\w*, \w and his flesh|strong="H1320"\w* \w was restored|strong="H7725"\w* \w and became like that|strong="H1320"\w* \w of a little|strong="H6996"\w* \w child|strong="H5288"\w*, \w and he was clean|strong="H2891"\w*.
\s1 Gehazi’s Greed and Leprosy
\p \v 15 \w Then Naaman|strong="H1931"\w* \w and all|strong="H3605"\w* \w his attendants|strong="H4264"\w* \w went back|strong="H7725"\w* \w to|strong="H413"\w* \w the man|strong="H376"\w* \w of God|strong="H430"\w*, \w stood|strong="H5975"\w* \w before him|strong="H6440"\w*, \w and declared|strong="H559"\w*, “\w Now|strong="H4994"\w* \w I know|strong="H3045"\w* \w for sure|strong="H2009"\w* \w that|strong="H3588"\w* \w there is no|strong="H369"\w* \w God|strong="H430"\w* \w in all|strong="H3605"\w* \w the earth|strong="H776"\w* \w except|strong="H3588"\w* \w in Israel|strong="H3478"\w*. \w So|strong="H6258"\w* \w please|strong="H4994"\w* \w accept|strong="H3947"\w* \w a gift|strong="H1293"\w* \w from|strong="H854"\w* \w your servant|strong="H5650"\w*.”
\p \v 16 \w But Elisha replied|strong="H559"\w*, “\w As surely as the LORD|strong="H3068"\w* \w lives|strong="H2416"\w*, \w before whom|strong="H6440"\w* \w I stand|strong="H5975"\w*, \w I will not|strong="H518"\w* \w accept it|strong="H3947"\w*.” \w And although Naaman urged|strong="H6484"\w* him \w to accept it|strong="H3947"\w*, \w he refused|strong="H3985"\w*.
\p \v 17 “\w If you will not|strong="H3808"\w*,” \w said|strong="H559"\w* \w Naaman|strong="H5283"\w*, “\w please|strong="H4994"\w* \w let me, your servant,|strong="H5650"\w* \w be given|strong="H5414"\w* \w as much soil|strong="H127"\w* \w as a pair|strong="H6776"\w* \w of mules|strong="H6505"\w* \w can carry|strong="H4853"\w*. \w For|strong="H3588"\w* \w your servant|strong="H5650"\w* \w will never|strong="H3808"\w* \w again|strong="H5750"\w* \w make|strong="H6213"\w* \w a burnt offering|strong="H5930"\w* \w or a sacrifice|strong="H2077"\w* \w to any other|strong="H312"\w* \w god|strong="H430"\w* \w but|strong="H518"\w* \w the LORD|strong="H3068"\w*. \v 18 \w Yet may the LORD|strong="H3068"\w* \w forgive|strong="H5545"\w* \w your servant|strong="H5650"\w* \w this|strong="H2088"\w* \w one thing|strong="H1697"\w*: \w When my master|strong="H113"\w* \w goes into|strong="H935"\w* \w the temple|strong="H1004"\w* \w of Rimmon|strong="H7417"\w* \w to worship|strong="H7812"\w* \w there|strong="H8033"\w*, \w and he|strong="H1931"\w* \w leans|strong="H8172"\w* \w on|strong="H5921"\w* \w my arm|strong="H3027"\w*, \w and I bow down|strong="H7812"\w* \w in the temple|strong="H1004"\w* \w of Rimmon|strong="H7417"\w*, \w may|strong="H4494"\w* \w the LORD|strong="H3068"\w* \w forgive|strong="H5545"\w* \w your servant|strong="H5650"\w* \w in this|strong="H2088"\w* \w matter|strong="H1697"\w*.”
\p \v 19 “\w Go|strong="H1980"\w* \w in peace|strong="H7965"\w*,” \w said Elisha|strong="H559"\w*.
\p \w But after Naaman had traveled|strong="H1980"\w* \w a short distance|strong="H3530"\w*, \v 20 \w Gehazi|strong="H1522"\w*, \w the servant|strong="H5288"\w* \w of Elisha|strong="H477"\w* \w the man|strong="H376"\w* \w of God|strong="H430"\w*, \w said|strong="H559"\w*, “\w Look|strong="H2009"\w*, \w my master|strong="H113"\w* \w has spared|strong="H2820"\w* \w this|strong="H2088"\w* \w Aramean|strong="H761"\w*, \w Naaman|strong="H5283"\w*, \w by not accepting|strong="H3947"\w* \w what|strong="H834"\w* \w he brought|strong="H935"\w*. \w As surely as the LORD|strong="H3068"\w* \w lives|strong="H2416"\w*, \w I will run|strong="H7323"\w* \w after him|strong="H310"\w* \w and get|strong="H3947"\w* \w something|strong="H3972"\w* \w from him|strong="H854"\w*.”
\p \v 21 \w So Gehazi|strong="H1522"\w* \w pursued|strong="H7291"\w* \w Naaman|strong="H5283"\w*. \w And when Naaman|strong="H5283"\w* \w saw him|strong="H7200"\w* \w running|strong="H7323"\w* \w toward him|strong="H310"\w*, \w he got down|strong="H5307"\w* \w from|strong="H5921"\w* \w the chariot|strong="H4818"\w* \w to meet him|strong="H7122"\w* \w and asked|strong="H559"\w*, “\w Is everything all right|strong="H7965"\w*?”
\p \v 22 “\w Everything is all right|strong="H7965"\w*,” \w Gehazi replied|strong="H559"\w*. “\w My master|strong="H113"\w* \w has sent me|strong="H7971"\w* \w to say|strong="H559"\w*, ‘\w Look|strong="H2009"\w*, \w two|strong="H8147"\w* \w young men|strong="H5288"\w* \w from the sons|strong="H1121"\w* \w of the prophets|strong="H5030"\w* \w have just now|strong="H6258"\w* \w come|strong="H935"\w* \w to me|strong="H413"\w* \w from the hill country|strong="H2022"\w* \w of Ephraim|strong="H669"\w*. \w Please|strong="H4994"\w* \w give|strong="H5414"\w* them \w a talent|strong="H3603"\w* \w of silver|strong="H3701"\w*\f + \fr 5:22 \fqa A talent \ft is approximately 75.4 pounds or 34.2 kilograms of silver.\f* \w and two|strong="H8147"\w* \w sets|strong="H2487"\w* \w of clothing|strong="H899"\w*.’”
\p \v 23 \w But Naaman|strong="H5283"\w* \w insisted|strong="H559"\w*, “\w Please|strong="H2974"\w*, \w take|strong="H3947"\w* \w two talents|strong="H3603"\w*.” \w And he urged|strong="H6555"\w* Gehazi to accept them. \w Then he tied up|strong="H6696"\w* \w two talents|strong="H3603"\w* \w of silver|strong="H3701"\w* \w in two|strong="H8147"\w* \w bags|strong="H2754"\w* \w along with two|strong="H8147"\w* \w sets|strong="H2487"\w* \w of clothing|strong="H899"\w* \w and gave them|strong="H5414"\w* \w to|strong="H413"\w* \w two|strong="H8147"\w* \w of his servants|strong="H5288"\w*, \w who carried them|strong="H5375"\w* \w ahead of Gehazi|strong="H6440"\w*.
\p \v 24 \w When Gehazi came|strong="H935"\w* \w to|strong="H413"\w* \w the hill|strong="H6076"\w*, \w he took|strong="H3947"\w* \w the gifts from the servants|strong="H3027"\w* \w and stored them|strong="H6485"\w* \w in the house|strong="H1004"\w*. \w Then he dismissed|strong="H7971"\w* \w the men|strong="H582"\w*, \w and they departed|strong="H1980"\w*.
\p \v 25 \w When Gehazi|strong="H1931"\w* \w went in|strong="H935"\w* \w and stood|strong="H5975"\w* \w before|strong="H413"\w* \w his master|strong="H113"\w*, \w Elisha|strong="H477"\w* \w asked|strong="H559"\w* \w him|strong="H413"\w*, “\w Gehazi|strong="H1522"\w*, \w where have you been|strong="H575"\w*?”
\p “\w Your servant|strong="H5650"\w* \w did not|strong="H3808"\w* \w go|strong="H1980"\w* \w anywhere|strong="H575"\w*,” \w he replied|strong="H559"\w*.
