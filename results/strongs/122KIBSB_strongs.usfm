\p \v 10 \w Then King|strong="H4428"\w* \w Ahaz|strong="H271"\w* \w went|strong="H1980"\w* \w to Damascus|strong="H1834"\w* \w to meet|strong="H7122"\w* \w Tiglath-pileser|strong="H8407"\w* \w king|strong="H4428"\w* \w of Assyria|strong="H804"\w*. \w On seeing|strong="H7200"\w* \w the altar|strong="H4196"\w* \w in Damascus|strong="H1834"\w*, \w King|strong="H4428"\w* \w Ahaz|strong="H271"\w* \w sent|strong="H7971"\w* \w Uriah|strong="H223"\w* \w the priest|strong="H3548"\w* \w a model|strong="H1823"\w* \w of the altar|strong="H4196"\w* \w and complete plans|strong="H8403"\w* \w for its construction|strong="H4639"\w*. \v 11 \w And Uriah|strong="H223"\w* \w the priest|strong="H3548"\w* \w built|strong="H1129"\w* \w the altar|strong="H4196"\w* \w according to all|strong="H3605"\w* \w the instructions|strong="H834"\w* \w King|strong="H4428"\w* \w Ahaz|strong="H271"\w* \w had sent|strong="H7971"\w* \w from Damascus|strong="H1834"\w*, \w and|strong="H3651"\w* \w he completed it|strong="H6213"\w* \w before|strong="H5704"\w* \w King|strong="H4428"\w* \w Ahaz|strong="H271"\w* \w returned|strong="H935"\w*.
