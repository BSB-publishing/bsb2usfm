\p \v 3 \w Now|strong="H1961"\w* \w in the eighteenth|strong="H8083"\w* \w year|strong="H8141"\w* \w of his reign|strong="H4428"\w*, \w King|strong="H4428"\w* \w Josiah|strong="H2977"\w* \w sent|strong="H7971"\w* \w the scribe|strong="H5608"\w*, \w Shaphan|strong="H8227"\w* \w son|strong="H1121"\w* \w of Azaliah|strong="H683"\w*, \w the son|strong="H1121"\w* \w of Meshullam|strong="H4918"\w*, \w to the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*, \w saying|strong="H559"\w*, \v 4 “\w Go up|strong="H5927"\w* \w to|strong="H413"\w* \w Hilkiah|strong="H2518"\w* \w the high|strong="H1419"\w* \w priest|strong="H3548"\w* \w and have him count|strong="H8552"\w* \w the money|strong="H3701"\w* \w that has been brought|strong="H935"\w* \w into the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*, \w which|strong="H834"\w* \w the doorkeepers|strong="H5592"\w* \w have collected|strong="H622"\w* \w from the people|strong="H5971"\w*. \v 5 \w And let them deliver it|strong="H5414"\w* \w into|strong="H5921"\w* \w the hands|strong="H3027"\w* \w of the supervisors|strong="H6485"\w* \w of those doing|strong="H6213"\w* \w the work|strong="H4399"\w* \w on the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*, \w who in turn are to give|strong="H5414"\w* \w it|strong="H853"\w* \w to the workmen|strong="H6213"\w* \w repairing|strong="H2388"\w* \w the damages|strong="H919"\w* \w to the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w* — \v 6 \w to the carpenters|strong="H2796"\w*, \w builders|strong="H1129"\w*, \w and masons|strong="H1443"\w* — \w to buy|strong="H7069"\w* \w timber|strong="H6086"\w* \w and dressed|strong="H4274"\w* \w stone|strong="H68"\w* \w to repair|strong="H2388"\w* \w the temple|strong="H1004"\w*. \v 7 \w But|strong="H389"\w* \w they need not|strong="H3808"\w* \w account|strong="H2803"\w* \w for the money|strong="H3701"\w* \w put|strong="H5414"\w* \w into|strong="H5921"\w* \w their hands|strong="H3027"\w*, \w since|strong="H3588"\w* \w they|strong="H1992"\w* \w work|strong="H6213"\w* \w with integrity|strong="H530"\w*.”
\s1 Hilkiah Finds the Book of the Law
\r (\ref 2 Chronicles 34:14–21|2CH 34:14-21\ref*)
\p \v 8 \w Then Hilkiah|strong="H2518"\w* \w the high|strong="H1419"\w* \w priest|strong="H3548"\w* \w said to|strong="H559"\w* \w Shaphan|strong="H8227"\w* \w the scribe|strong="H5608"\w*, “\w I have found|strong="H4672"\w* \w the Book|strong="H5612"\w* \w of the Law|strong="H8451"\w* \w in the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*!” \w And he|strong="H2518"\w* \w gave|strong="H5414"\w* \w it|strong="H5612"\w* \w to|strong="H413"\w* \w Shaphan|strong="H8227"\w*, \w who read it|strong="H7121"\w*.
\p \v 9 \w And Shaphan|strong="H8227"\w* \w the scribe|strong="H5608"\w* \w went|strong="H935"\w* \w to|strong="H413"\w* \w the king|strong="H4428"\w* \w and reported|strong="H7725"\w*, “\w Your servants|strong="H5650"\w* \w have paid out|strong="H5413"\w* \w the money|strong="H3701"\w* \w that was found|strong="H4672"\w* \w in the temple|strong="H1004"\w* \w and have put|strong="H5414"\w* \w it into|strong="H5921"\w* \w the hands|strong="H3027"\w* \w of the workers|strong="H6213"\w* \w and supervisors|strong="H6485"\w* \w of the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*.”
\p \v 10 \w Moreover , Shaphan|strong="H8227"\w* \w the scribe|strong="H5608"\w* \w told|strong="H5046"\w* \w the king|strong="H4428"\w*, “\w Hilkiah|strong="H2518"\w* \w the priest|strong="H3548"\w* \w has given|strong="H5414"\w* me \w a book|strong="H5612"\w*.” \w And Shaphan|strong="H8227"\w* \w read it|strong="H7121"\w* \w in the presence|strong="H6440"\w* \w of the king|strong="H4428"\w*.
\p \v 11 \w When the king|strong="H4428"\w* \w heard|strong="H8085"\w* \w the words|strong="H1697"\w* \w of the Book|strong="H5612"\w* \w of the Law|strong="H8451"\w*, \w he tore|strong="H7167"\w* \w his clothes|strong="H899"\w* \v 12 \w and|strong="H4428"\w* \w commanded|strong="H6680"\w* \w Hilkiah|strong="H2518"\w* \w the priest|strong="H3548"\w*, \w Ahikam|strong="H296"\w* \w son|strong="H1121"\w* \w of Shaphan|strong="H8227"\w*, \w Achbor|strong="H5907"\w*\f + \fr 22:12 \fqa Achbor \ft is another name for \fqa Abdon\ft ; see \ref 2 Chronicles 34:20|2CH 34:20\ref*.\f* \w son|strong="H1121"\w* \w of Micaiah|strong="H4320"\w*,\f + \fr 22:12 \fqa Micaiah \ft is a variant of \fqa Micah\ft ; see \ref 2 Chronicles 34:20|2CH 34:20\ref*.\f* \w Shaphan|strong="H8227"\w* \w the scribe|strong="H5608"\w*, \w and Asaiah|strong="H6222"\w* \w the servant|strong="H5650"\w* \w of the king|strong="H4428"\w*: \v 13 “\w Go|strong="H1980"\w* \w and inquire|strong="H1875"\w* \w of the LORD|strong="H3068"\w* \w for me|strong="H1157"\w*, \w for|strong="H1157"\w* \w the people|strong="H5971"\w*, \w and for|strong="H1157"\w* \w all|strong="H3605"\w* \w Judah|strong="H3063"\w* \w concerning|strong="H5921"\w* \w the words|strong="H1697"\w* \w in this|strong="H2088"\w* \w book|strong="H5612"\w* \w that has been found|strong="H4672"\w*. \w For|strong="H3588"\w* \w great|strong="H1419"\w* \w is the wrath|strong="H2534"\w* \w of the LORD|strong="H3068"\w* \w that|strong="H834"\w* \w burns|strong="H3341"\w* against us \w because|strong="H834"\w* \w our fathers|strong="H1"\w* \w have not|strong="H3808"\w* \w obeyed|strong="H8085"\w* \w the words|strong="H1697"\w* \w of this|strong="H2088"\w* \w book|strong="H5612"\w* \w by doing|strong="H6213"\w* \w all|strong="H3605"\w* \w that is written|strong="H3789"\w* \w about us|strong="H5921"\w*.”
\s1 Huldah’s Prophecy
\r (\ref 2 Chronicles 34:22–28|2CH 34:22-28\ref*)
\p \v 14 \w So Hilkiah|strong="H2518"\w* \w the priest|strong="H3548"\w*, \w Ahikam|strong="H296"\w*, \w Achbor|strong="H5907"\w*, \w Shaphan|strong="H8227"\w*, \w and Asaiah|strong="H6222"\w* \w went|strong="H1980"\w* \w and spoke|strong="H1696"\w* \w to|strong="H413"\w* \w Huldah|strong="H2468"\w* \w the prophetess|strong="H5031"\w*, \w the wife|strong="H802"\w* \w of Shallum|strong="H7967"\w* \w son|strong="H1121"\w* \w of Tikvah|strong="H8616"\w*,\f + \fr 22:14 \fqa Tikvah \ft is a variant of \fqa Tokhath\ft ; see \ref 2 Chronicles 34:22|2CH 34:22\ref*.\f* \w the son|strong="H1121"\w* \w of Harhas|strong="H2745"\w*,\f + \fr 22:14 \fqa Harhas \ft is a variant of \fqa Hasrah\ft ; see \ref 2 Chronicles 34:22|2CH 34:22\ref*.\f* \w the keeper|strong="H8104"\w* \w of the wardrobe|strong="H899"\w*. \w She|strong="H1931"\w* \w lived|strong="H3427"\w* \w in Jerusalem|strong="H3389"\w*, \w in the Second District|strong="H4932"\w*.\f + \fr 22:14 \ft Or \fqa the Second Quarter\ft , a newer section of Jerusalem; Hebrew \fqa the Mishneh\f*
\p \v 15 \w And Huldah said|strong="H559"\w* \w to them|strong="H413"\w*, “\w This is what|strong="H3541"\w* \w the LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w says|strong="H559"\w*: ‘\w Tell|strong="H559"\w* \w the man|strong="H376"\w* \w who|strong="H834"\w* \w sent|strong="H7971"\w* \w you|strong="H853"\w* \v 16 \w that this is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w says|strong="H559"\w*: \w I am about to bring|strong="H935"\w* \w calamity|strong="H7451"\w* \w on|strong="H413"\w* \w this|strong="H2088"\w* \w place|strong="H4725"\w* \w and on|strong="H5921"\w* \w its people|strong="H3427"\w*, \w according to all|strong="H3605"\w* \w the words|strong="H1697"\w* \w of the book|strong="H5612"\w* \w that|strong="H834"\w* \w the king|strong="H4428"\w* \w of Judah|strong="H3063"\w* \w has read|strong="H7121"\w*, \v 17 \w because|strong="H8478"\w* \w they have forsaken Me|strong="H5800"\w* \w and burned incense|strong="H6999"\w* \w to other|strong="H312"\w* \w gods|strong="H430"\w*, \w that|strong="H4616"\w* \w they might provoke Me to anger|strong="H3707"\w* \w with all|strong="H3605"\w* \w the works|strong="H4639"\w* \w of their hands|strong="H3027"\w*. \w My wrath|strong="H2534"\w* \w will be kindled|strong="H3341"\w* \w against this|strong="H2088"\w* \w place|strong="H4725"\w* \w and will not|strong="H3808"\w* \w be quenched|strong="H3518"\w*.’
\p \v 18 \w But as for|strong="H413"\w* \w the king|strong="H4428"\w* \w of Judah|strong="H3063"\w*, \w who sent|strong="H7971"\w* \w you|strong="H853"\w* \w to inquire|strong="H1875"\w* \w of the LORD|strong="H3068"\w*, \w tell him|strong="H559"\w* \w that this is what|strong="H3541"\w* \w the LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of Israel|strong="H3478"\w*, \w says|strong="H559"\w*: ‘\w As for the words|strong="H1697"\w* \w that|strong="H834"\w* \w you heard|strong="H8085"\w*, \v 19 \w because|strong="H3282"\w* \w your heart|strong="H3824"\w* \w was tender|strong="H7401"\w* \w and you humbled yourself|strong="H3665"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w when you heard|strong="H8085"\w* \w what|strong="H834"\w* \w I spoke|strong="H1696"\w* \w against|strong="H5921"\w* \w this|strong="H2088"\w* \w place|strong="H4725"\w* \w and against|strong="H5921"\w* \w its people|strong="H3427"\w*, \w that they would become|strong="H1961"\w* \w a desolation|strong="H8047"\w* \w and a curse|strong="H7045"\w*, \w and because you have torn|strong="H7167"\w* \w your clothes|strong="H899"\w* \w and wept|strong="H1058"\w* \w before Me|strong="H6440"\w*, \w I|strong="H595"\w* \w have heard you|strong="H8085"\w*,’ \w declares|strong="H5002"\w* \w the LORD|strong="H3068"\w*.
\p \v 20 ‘\w Therefore|strong="H3651"\w* \w I will indeed gather|strong="H622"\w* \w you to|strong="H5921"\w* \w your fathers|strong="H1"\w*, \w and you will be gathered|strong="H622"\w* \w to|strong="H413"\w* \w your grave|strong="H6913"\w* \w in peace|strong="H7965"\w*. \w Your eyes|strong="H5869"\w* \w will not|strong="H3808"\w* \w see|strong="H7200"\w* \w all|strong="H3605"\w* \w the calamity|strong="H7451"\w* \w that|strong="H834"\w* \w I|strong="H589"\w* \w will bring|strong="H935"\w* \w on|strong="H5921"\w* \w this|strong="H2088"\w* \w place|strong="H4725"\w*.’”
\p \w So they brought|strong="H7725"\w* \w her|strong="H853"\w* \w answer|strong="H1697"\w* \w back to the king|strong="H4428"\w*.
\c 23
\s1 Josiah Renews the Covenant
\r (\ref 2 Chronicles 34:29–33|2CH 34:29-33\ref*)
\p \v 1 \w Then the king|strong="H4428"\w* \w summoned|strong="H7971"\w* \w all|strong="H3605"\w* \w the elders|strong="H2205"\w* \w of Judah|strong="H3063"\w* \w and Jerusalem|strong="H3389"\w*. \v 2 \w And he|strong="H4428"\w* \w went up|strong="H5927"\w* \w to the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w* \w with all|strong="H3605"\w* \w the people|strong="H3427"\w* \w of Judah|strong="H3063"\w* \w and|strong="H3605"\w* \w Jerusalem|strong="H3389"\w*, \w as well as|strong="H854"\w* \w the priests|strong="H3548"\w* \w and the prophets|strong="H5030"\w*— \w all|strong="H3605"\w* \w the people|strong="H5971"\w* \w small|strong="H6996"\w* \w and|strong="H5704"\w* \w great|strong="H1419"\w*— \w and in their hearing|strong="H241"\w* \w he read|strong="H7121"\w* \w all|strong="H3605"\w* \w the words|strong="H1697"\w* \w of the Book|strong="H5612"\w* \w of the Covenant|strong="H1285"\w* \w that had been found|strong="H4672"\w* \w in the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*.
\p \v 3 \w So the king|strong="H4428"\w* \w stood|strong="H5975"\w* \w by|strong="H5921"\w* \w the pillar|strong="H5982"\w* \w and made|strong="H3772"\w* \w a covenant|strong="H1285"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w to follow|strong="H1980"\w* \w the LORD|strong="H3068"\w* \w and to keep|strong="H8104"\w* \w His commandments|strong="H4687"\w*, \w decrees|strong="H5715"\w*, \w and statutes|strong="H2708"\w* \w with all|strong="H3605"\w* \w his heart|strong="H3820"\w* \w and all|strong="H3605"\w* \w his soul|strong="H5315"\w*, \w and to carry out|strong="H6965"\w* \w the words|strong="H1697"\w* \w of the|strong="H2063"\w* \w covenant|strong="H1285"\w* \w that were written|strong="H3789"\w* \w in|strong="H5921"\w* \w this|strong="H2088"\w* \w book|strong="H5612"\w*. \w And all|strong="H3605"\w* \w the people|strong="H5971"\w* \w entered|strong="H5975"\w* \w into the covenant|strong="H1285"\w*.
\s1 Josiah Destroys Idolatry
\r (\ref 1 Kings 13:1–10|1KI 13:1-10\ref*; \ref 2 Chronicles 34:3–7|2CH 34:3-7\ref*)
\p \v 4 \w Then the king|strong="H4428"\w* \w commanded|strong="H6680"\w* \w Hilkiah|strong="H2518"\w* \w the high|strong="H1419"\w* \w priest|strong="H3548"\w*, \w the priests|strong="H3548"\w* \w second in rank|strong="H4932"\w*, \w and the doorkeepers|strong="H8104"\w* \w to remove|strong="H3318"\w* \w from the temple|strong="H1964"\w* \w of the LORD|strong="H3068"\w* \w all|strong="H3605"\w* \w the articles|strong="H3627"\w* \w made|strong="H6213"\w* \w for Baal|strong="H1168"\w*, \w Asherah|strong="H842"\w*, \w and all|strong="H3605"\w* \w the host|strong="H6635"\w* \w of heaven|strong="H8064"\w*. \w And he burned them|strong="H8313"\w* \w outside|strong="H2351"\w* \w Jerusalem|strong="H3389"\w* \w in the fields|strong="H7709"\w* \w of Kidron|strong="H6939"\w* \w and carried|strong="H5375"\w* \w their ashes|strong="H6083"\w* \w to Bethel|strong="H1008"\w*.
\p \v 5 \w Josiah also did away with|strong="H7673"\w* \w the idolatrous priests|strong="H3649"\w* \w ordained|strong="H5414"\w* \w by the kings|strong="H4428"\w* \w of Judah|strong="H3063"\w* \w to burn incense|strong="H6999"\w* \w on the high places|strong="H1116"\w* \w of the cities|strong="H5892"\w* \w of Judah|strong="H3063"\w* \w and in the places all around|strong="H4524"\w* \w Jerusalem|strong="H3389"\w* — \w those who had burned incense|strong="H6999"\w* \w to Baal|strong="H1168"\w*, \w to the sun|strong="H8121"\w* \w and moon|strong="H3394"\w*, \w to the constellations|strong="H4208"\w*, \w and to all|strong="H3605"\w* \w the host|strong="H6635"\w* \w of heaven|strong="H8064"\w*.
\p \v 6 \w He brought|strong="H3318"\w* \w the Asherah pole|strong="H842"\w* \w from the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w* \w to|strong="H413"\w* \w the Kidron|strong="H6939"\w* \w Valley|strong="H5158"\w* \w outside|strong="H2351"\w* \w Jerusalem|strong="H3389"\w*, \w and there|strong="H6939"\w* \w he burned|strong="H8313"\w* \w it|strong="H853"\w*, \w ground|strong="H1854"\w* \w it to powder|strong="H6083"\w*, \w and threw|strong="H7993"\w* \w its dust|strong="H6083"\w* \w on|strong="H5921"\w* \w the graves|strong="H6913"\w* \w of the common|strong="H1121"\w* \w people|strong="H5971"\w*. \v 7 \w He also tore down|strong="H5422"\w* \w the quarters|strong="H1004"\w* \w of the male shrine prostitutes|strong="H6945"\w* \w that were|strong="H834"\w* \w in the house|strong="H1004"\w* \w of the LORD|strong="H3068"\w*, \w where|strong="H834"\w* \w the women|strong="H802"\w* \w had woven|strong="H707"\w* \w tapestries|strong="H1004"\w* \w for Asherah|strong="H842"\w*.
\p \v 8 \w Then Josiah brought|strong="H935"\w* \w all|strong="H3605"\w* \w the priests|strong="H3548"\w* \w from the cities|strong="H5892"\w* \w of Judah|strong="H3063"\w* \w and desecrated|strong="H2930"\w* \w the high places|strong="H1116"\w*, \w from|strong="H834"\w* \w Geba|strong="H1387"\w* \w to|strong="H5704"\w* \w Beersheba|strong="H884"\w*, \w where|strong="H8033"\w* \w the priests|strong="H3548"\w* \w had burned incense|strong="H6999"\w*. \w He tore down|strong="H5422"\w* \w the high places|strong="H1116"\w* \w of the gates|strong="H8179"\w* \w at the entrance|strong="H6607"\w* \w of the gate|strong="H8179"\w* \w of Joshua|strong="H3091"\w* \w the governor|strong="H8269"\w* \w of the city|strong="H5892"\w*, \w which was|strong="H834"\w* \w to|strong="H5921"\w* \w the left|strong="H8040"\w* \w of the city|strong="H5892"\w* \w gate|strong="H8179"\w*. \v 9 \w Although|strong="H389"\w* \w the priests|strong="H3548"\w* \w of the high places|strong="H1116"\w* \w did not|strong="H3808"\w* \w come up|strong="H5927"\w* \w to|strong="H413"\w* \w the altar|strong="H4196"\w* \w of the LORD|strong="H3068"\w* \w in Jerusalem|strong="H3389"\w*, \w they ate|strong="H398"\w* \w unleavened bread|strong="H4682"\w* \w with|strong="H8432"\w* \w their fellow priests|strong="H251"\w*.
