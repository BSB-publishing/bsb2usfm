\p \v 3 \w Then one of them|strong="H259"\w* \w said|strong="H559"\w*, “\w Please|strong="H4994"\w* \w come|strong="H1980"\w* \w with|strong="H854"\w* \w your servants|strong="H5650"\w*.”
\p “\w I will|strong="H589"\w* \w come|strong="H1980"\w*,” \w he replied|strong="H559"\w*.
\p \v 4 \w So Elisha went|strong="H1980"\w* \w with them|strong="H854"\w*, \w and when they came|strong="H935"\w* \w to the Jordan|strong="H3383"\w*, \w they began to cut down|strong="H1504"\w* \w some trees|strong="H6086"\w*. \v 5 \w As one|strong="H259"\w* \w of them was cutting down|strong="H5307"\w* \w a tree|strong="H6982"\w*, \w the iron axe head|strong="H1270"\w* \w fell|strong="H5307"\w* \w into|strong="H413"\w* \w the water|strong="H4325"\w*. “\w Oh|strong="H162"\w*, \w my master|strong="H113"\w*,” \w he cried out|strong="H6817"\w*, “\w it|strong="H1931"\w* \w was borrowed|strong="H7592"\w*!”
