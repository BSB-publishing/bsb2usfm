\p \v 31 \w Do not|strong="H408"\w* \w listen|strong="H8085"\w* \w to|strong="H413"\w* \w Hezekiah|strong="H2396"\w*, \w for|strong="H3588"\w* \w this is what|strong="H3541"\w* \w the king|strong="H4428"\w* \w of Assyria|strong="H804"\w* \w says|strong="H559"\w*: \w Make|strong="H6213"\w* \w peace|strong="H1293"\w* \w with me|strong="H854"\w*\f + \fr 18:31 \ft Or \fqa Make a blessing with me\f* \w and come out|strong="H3318"\w* \w to me|strong="H413"\w*. \w Then every one of you|strong="H376"\w* \w will eat|strong="H398"\w* \w from his own vine|strong="H1612"\w* \w and his own fig tree|strong="H8384"\w* \w and|strong="H376"\w* \w drink|strong="H8354"\w* \w water|strong="H4325"\w* \w from his own cistern|strong="H953"\w*, \v 32 \w until|strong="H5704"\w* \w I come|strong="H935"\w* \w and take you away|strong="H3947"\w* \w to|strong="H413"\w* \w a land|strong="H776"\w* \w like your own|strong="H776"\w*— \w a land|strong="H776"\w* \w of grain|strong="H1715"\w* \w and new wine|strong="H8492"\w*, \w a land|strong="H776"\w* \w of bread|strong="H3899"\w* \w and vineyards|strong="H3754"\w*, \w a land|strong="H776"\w* \w of olive trees|strong="H2132"\w* \w and honey|strong="H1706"\w*— \w so that you may live|strong="H2421"\w* \w and not|strong="H3808"\w* \w die|strong="H4191"\w*. \w But do not|strong="H408"\w* \w listen|strong="H8085"\w* \w to|strong="H413"\w* \w Hezekiah|strong="H2396"\w*, \w for|strong="H3588"\w* \w he misleads you|strong="H5496"\w* \w when he says|strong="H559"\w*, ‘\w The LORD|strong="H3068"\w* \w will deliver us|strong="H5337"\w*.’
