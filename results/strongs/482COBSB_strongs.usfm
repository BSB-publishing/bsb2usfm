\p \v 1 \w Now|strong="G1063"\w* \w about|strong="G4012"\w* \w the|strong="G3588"\w* \w service|strong="G1248"\w* \w to|strong="G1519"\w* \w the|strong="G3588"\w* \w saints|strong="G40"\w*, \w there is|strong="G1510"\w* \w no need|strong="G4053"\w* \w for me|strong="G1473"\w* \w to write|strong="G1125"\w* \w to you|strong="G4771"\w*. \v 2 \w For|strong="G1063"\w* \w I know|strong="G1492"\w* \w your|strong="G4771"\w* \w eagerness to help|strong="G4288"\w*, \w and|strong="G3739"\w* \w I have been boasting|strong="G2744"\w* \w to the Macedonians|strong="G3110"\w* \w that|strong="G3754"\w* \w since|strong="G575"\w* \w last year|strong="G4070"\w* \w you|strong="G4771"\w* \w in Achaia|strong="G882"\w* \w were prepared to give|strong="G3903"\w*. \w And|strong="G2532"\w* \w your|strong="G4771"\w* \w zeal|strong="G2205"\w* \w has stirred|strong="G2042"\w* \w most of them to do likewise|strong="G4119"\w*.
