\p \v 12 \w We do not dare|strong="G5111"\w* \w to classify|strong="G1469"\w* \w or|strong="G2228"\w* \w compare|strong="G4793"\w* \w ourselves with|strong="G1438"\w* \w some|strong="G5100"\w* \w who|strong="G3588"\w* \w commend|strong="G4921"\w* \w themselves|strong="G1438"\w*. \w When they|strong="G846"\w* \w measure|strong="G3354"\w* \w themselves|strong="G1438"\w* \w by|strong="G1722"\w* \w themselves|strong="G1438"\w* \w and|strong="G2532"\w* \w compare|strong="G4793"\w* \w themselves|strong="G1438"\w* \w with themselves|strong="G1438"\w*, \w they show their ignorance|strong="G4920"\w*. \v 13 \w We|strong="G1473"\w*, \w however|strong="G1161"\w*, \w will not boast|strong="G2744"\w* \w beyond our limits|strong="G280"\w*, \w but only|strong="G235"\w* \w within|strong="G2596"\w* \w the|strong="G3588"\w* \w field of influence|strong="G3358"\w* \w that|strong="G3739"\w* \w God|strong="G2316"\w* \w has assigned|strong="G3307"\w* \w to us|strong="G1473"\w* — \w a field|strong="G3358"\w* \w that reaches|strong="G2185"\w* \w even|strong="G2532"\w* \w to|strong="G891"\w* \w you|strong="G4771"\w*. \v 14 \w We are not overstepping|strong="G5239"\w* \w our bounds|strong="G1438"\w*, \w as if|strong="G5613"\w* \w we had not come|strong="G2185"\w* \w to|strong="G1519"\w* \w you|strong="G4771"\w*. \w Indeed|strong="G1063"\w*, \w we were the first to reach|strong="G5348"\w* \w you|strong="G4771"\w* \w with|strong="G1722"\w* \w the|strong="G3588"\w* \w gospel|strong="G2098"\w* \w of Christ|strong="G5547"\w*.
\p \v 15 \w Neither|strong="G3756"\w* \w do we boast|strong="G2744"\w* \w beyond our limits|strong="G280"\w* \w in|strong="G1722"\w* \w the labors|strong="G2873"\w* \w of others|strong="G245"\w*. \w But|strong="G1161"\w* \w we hope that|strong="G1680"\w* \w as your|strong="G4771"\w* \w faith|strong="G4102"\w* \w increases|strong="G837"\w*, \w our|strong="G1473"\w* \w area of influence|strong="G2583"\w* \w among|strong="G1722"\w* \w you|strong="G4771"\w* \w will greatly increase as well|strong="G3170"\w*, \v 16 \w so that|strong="G1519"\w* \w we can preach the gospel|strong="G2097"\w* \w in the regions|strong="G3588"\w* \w beyond|strong="G5238"\w* \w you|strong="G4771"\w*. \w Then we will not be boasting|strong="G2744"\w* \w in|strong="G1722"\w* \w the work|strong="G3588"\w* \w already done|strong="G2092"\w* \w in|strong="G1519"\w* \w another man’s|strong="G245"\w* \w territory|strong="G2583"\w*.
