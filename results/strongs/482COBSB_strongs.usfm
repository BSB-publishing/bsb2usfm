\p \v 6 \w Remember|strong="G1161"\w* \w this|strong="G3778"\w*: \w Whoever|strong="G3588"\w* \w sows|strong="G4687"\w* \w sparingly|strong="G5340"\w* \w will also|strong="G2532"\w* \w reap|strong="G2325"\w* \w sparingly|strong="G5340"\w*, \w and|strong="G2532"\w* \w whoever|strong="G3588"\w* \w sows|strong="G4687"\w* \w generously|strong="G2129"\w* \w will also|strong="G2532"\w* \w reap|strong="G2325"\w* \w generously|strong="G2129"\w*. \v 7 \w Each one|strong="G1538"\w* \w should give what|strong="G2531"\w* \w he has decided|strong="G4255"\w* \w in his|strong="G3588"\w* \w heart to give|strong="G2588"\w*, \w not|strong="G3361"\w* \w out of|strong="G1537"\w* \w regret|strong="G3077"\w* \w or|strong="G2228"\w* \w compulsion|strong="G318"\w*. \w For|strong="G1063"\w* \w God|strong="G2316"\w* \w loves|strong="G25"\w* \w a cheerful|strong="G2431"\w* \w giver|strong="G1395"\w*.\f + \fr 9:7 \ft See \ref Proverbs 22:8|PRO 22:8\ref*, LXX addition.\f* \v 8 \w And|strong="G1161"\w* \w God|strong="G2316"\w* \w is able|strong="G1414"\w* \w to make all|strong="G3956"\w* \w grace|strong="G5485"\w* \w abound|strong="G4052"\w* \w to|strong="G1519"\w* \w you|strong="G4771"\w*, \w so that|strong="G2443"\w* \w in|strong="G1722"\w* \w all things|strong="G3956"\w*, \w at all times|strong="G3842"\w*, \w having|strong="G2192"\w* \w all that|strong="G3956"\w* \w you need|strong="G841"\w*, \w you will abound|strong="G4052"\w* \w in|strong="G1519"\w* \w every|strong="G3956"\w* \w good|strong="G18"\w* \w work|strong="G2041"\w*. \v 9 \w As|strong="G2531"\w* \w it is written|strong="G1125"\w*:
