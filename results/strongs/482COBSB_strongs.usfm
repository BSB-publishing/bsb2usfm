\s1 Paul’s Apostolic Authority
\p \v 1 \w Now|strong="G1161"\w* \w by|strong="G1223"\w* \w the|strong="G3588"\w* \w mildness|strong="G4240"\w* \w and|strong="G2532"\w* \w gentleness|strong="G1932"\w* \w of Christ|strong="G5547"\w*, \w I appeal|strong="G3870"\w* \w to you|strong="G4771"\w* — \w I|strong="G1473"\w*, \w Paul|strong="G3972"\w*, \w who|strong="G3739"\w* \w am humble|strong="G5011"\w* \w when face to face|strong="G4383"\w* \w with|strong="G1722"\w* \w you|strong="G4771"\w*, \w but|strong="G1161"\w* \w bold|strong="G2292"\w* \w when away|strong="G548"\w*. \v 2 \w I beg you|strong="G1189"\w* \w that|strong="G3588"\w* \w when I come|strong="G3918"\w* \w I may not need to be|strong="G2292"\w* \w as bold|strong="G4006"\w* \w as|strong="G3739"\w* \w I expect|strong="G3049"\w* \w toward|strong="G1909"\w* \w those|strong="G5100"\w* \w who|strong="G3588"\w* \w presume that|strong="G3049"\w* \w we|strong="G1473"\w* \w live|strong="G4043"\w* \w according to|strong="G2596"\w* \w the flesh|strong="G4561"\w*.
\p \v 3 \w For|strong="G1063"\w* \w though we live|strong="G4043"\w* \w in|strong="G1722"\w* \w the flesh|strong="G4561"\w*, \w we do not wage war|strong="G4754"\w* \w according to|strong="G2596"\w* \w the flesh|strong="G4561"\w*. \v 4 \w The|strong="G3588"\w* \w weapons|strong="G3696"\w* \w of|strong="G3588"\w* \w our|strong="G1473"\w* \w warfare|strong="G4752"\w* \w are not|strong="G3756"\w* \w the weapons of the flesh|strong="G4559"\w*. \w Instead|strong="G235"\w*, \w they have|strong="G3588"\w* \w divine|strong="G2316"\w* \w power|strong="G1415"\w* \w to|strong="G4314"\w* \w demolish|strong="G2506"\w* \w strongholds|strong="G3794"\w*. \v 5 \w We demolish|strong="G2507"\w* \w arguments|strong="G3053"\w* \w and|strong="G2532"\w* \w every|strong="G3956"\w* \w presumption|strong="G5313"\w* \w set up|strong="G1869"\w* \w against|strong="G2596"\w* \w the|strong="G3588"\w* \w knowledge|strong="G1108"\w* \w of God|strong="G2316"\w*; \w and|strong="G2532"\w* \w we take captive|strong="G163"\w* \w every|strong="G3956"\w* \w thought|strong="G3540"\w* \w to|strong="G1519"\w* \w make it obedient|strong="G5218"\w* \w to Christ|strong="G5547"\w*. \v 6 \w And|strong="G2532"\w* \w we|strong="G1722"\w* \w will be|strong="G2192"\w* \w ready|strong="G2092"\w* \w to punish|strong="G1556"\w* \w every act of|strong="G3956"\w* \w disobedience|strong="G3876"\w*, \w as soon as|strong="G3752"\w* \w your|strong="G4771"\w* \w obedience|strong="G5218"\w* \w is complete|strong="G4137"\w*.
\p \v 7 \w You are looking|strong="G991"\w* \w at|strong="G2596"\w* \w outward appearances|strong="G4383"\w*. \w If|strong="G1487"\w* \w anyone|strong="G5100"\w* \w is confident|strong="G3982"\w* \w that he|strong="G1438"\w* \w belongs to|strong="G1510"\w* \w Christ|strong="G5547"\w*, \w he should remind|strong="G3049"\w* \w himself|strong="G1438"\w* \w that|strong="G3754"\w* \w we|strong="G1473"\w* \w belong to Christ|strong="G3779"\w* \w just|strong="G2532"\w* \w as much as|strong="G2531"\w* \w he|strong="G846"\w* \w does|strong="G5547"\w*. \v 8 \w For|strong="G1063"\w* \w even|strong="G5037"\w* \w if|strong="G1437"\w* \w I boast|strong="G2744"\w* \w somewhat|strong="G5100"\w* \w excessively|strong="G4053"\w* \w about|strong="G4012"\w* \w the|strong="G3588"\w* \w authority|strong="G1849"\w* \w the|strong="G3588"\w* \w Lord|strong="G2962"\w* \w gave|strong="G1325"\w* \w us|strong="G1473"\w* \w for|strong="G1519"\w* \w building you up|strong="G3619"\w* \w rather than|strong="G2532"\w* \w tearing you down|strong="G2506"\w*, \w I will not be ashamed|strong="G153"\w*.
