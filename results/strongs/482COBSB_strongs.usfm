\p \v 10 \w Now|strong="G1161"\w* \w He who|strong="G3588"\w* \w supplies|strong="G2023"\w* \w seed|strong="G4703"\w* \w to the|strong="G3588"\w* \w sower|strong="G4687"\w* \w and|strong="G2532"\w* \w bread|strong="G740"\w* \w for|strong="G1519"\w* \w food|strong="G1035"\w* \w will supply|strong="G5524"\w* \w and|strong="G2532"\w* \w multiply|strong="G4129"\w* \w your|strong="G4771"\w* \w store of seed|strong="G4703"\w* \w and|strong="G2532"\w* \w will increase|strong="G837"\w* \w the|strong="G3588"\w* \w harvest|strong="G1081"\w* \w of|strong="G3588"\w* \w your|strong="G4771"\w* \w righteousness|strong="G1343"\w*. \v 11 \w You will be enriched|strong="G4148"\w* \w in|strong="G1722"\w* \w every way|strong="G3956"\w* \w to|strong="G1519"\w* \w be generous|strong="G572"\w* \w on every occasion|strong="G3956"\w*, \w and|strong="G3748"\w* \w through|strong="G1223"\w* \w us|strong="G1473"\w* \w your generosity will produce|strong="G2716"\w* \w thanksgiving|strong="G2169"\w* \w to God|strong="G2316"\w*. \v 12 \w For|strong="G3754"\w* \w this|strong="G3778"\w* \w ministry|strong="G1248"\w* \w of service|strong="G3009"\w* \w is|strong="G1510"\w* \w not|strong="G3756"\w* \w only|strong="G3440"\w* \w supplying|strong="G4322"\w* \w the|strong="G3588"\w* \w needs|strong="G5303"\w* \w of the|strong="G3588"\w* \w saints|strong="G40"\w* \w but|strong="G235"\w* \w is also overflowing|strong="G4052"\w* \w in|strong="G1223"\w* \w many|strong="G4183"\w* \w expressions of thanksgiving|strong="G2169"\w* \w to God|strong="G2316"\w*.
