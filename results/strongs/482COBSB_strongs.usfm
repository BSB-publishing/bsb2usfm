\p \v 14 \w See|strong="G2400"\w*, \w I am|strong="G2192"\w* \w ready|strong="G2093"\w* \w to come|strong="G2064"\w* \w to|strong="G4314"\w* \w you|strong="G4771"\w* \w a third time|strong="G5154"\w*, \w and|strong="G2532"\w* \w I will not be a burden|strong="G2655"\w*, \w because|strong="G1063"\w* \w I am not seeking|strong="G2212"\w* \w your|strong="G4771"\w* \w possessions|strong="G3588"\w*, \w but|strong="G235"\w* \w you|strong="G4771"\w*. \w For|strong="G1063"\w* \w children|strong="G5043"\w* \w should not have|strong="G3784"\w* \w to save up|strong="G2343"\w* \w for their|strong="G3588"\w* \w parents|strong="G1118"\w*, \w but|strong="G235"\w* \w parents|strong="G1118"\w* \w for their|strong="G3588"\w* \w children|strong="G5043"\w*. \v 15 \w And|strong="G1161"\w* \w for the sake of|strong="G5228"\w* \w your|strong="G4771"\w* \w souls|strong="G5590"\w*, \w I|strong="G1473"\w* \w will most gladly|strong="G2236"\w* \w spend my money|strong="G1159"\w* \w and|strong="G2532"\w* \w myself|strong="G1550"\w*. \w If|strong="G1487"\w* \w I love|strong="G25"\w* \w you|strong="G4771"\w* \w more|strong="G4057"\w*, \w will you love me|strong="G25"\w* \w less|strong="G2276"\w*?
\p \v 16 \w Be that as it may|strong="G1510"\w*, \w I|strong="G1473"\w* \w was not a burden|strong="G2599"\w* \w to you|strong="G4771"\w*; \w but|strong="G235"\w* \w crafty|strong="G3835"\w* \w as I am|strong="G5225"\w*, \w I caught|strong="G2983"\w* \w you|strong="G4771"\w* \w by trickery|strong="G1388"\w*. \v 17 \w Did I exploit|strong="G4122"\w* \w you|strong="G4771"\w* \w by|strong="G1223"\w* \w anyone|strong="G5100"\w* \w I sent|strong="G649"\w* \w you|strong="G4771"\w*? \v 18 \w I urged|strong="G3870"\w* \w Titus to visit you|strong="G5103"\w*, \w and|strong="G2532"\w* \w I sent|strong="G4882"\w* \w our|strong="G3588"\w* \w brother with him|strong="G80"\w*. \w Did Titus|strong="G5103"\w* \w exploit|strong="G4122"\w* \w you|strong="G4771"\w* \w in any way|strong="G3385"\w*? \w Did we not walk|strong="G4043"\w* \w in the|strong="G3588"\w* \w same|strong="G846"\w* \w Spirit|strong="G4151"\w* \w and follow|strong="G3756"\w* \w in the|strong="G3588"\w* \w same|strong="G846"\w* \w footsteps|strong="G2487"\w*?\f + \fr 12:18 \ft Literally \fqa Did we not walk in the same Spirit? Not in the same footsteps?\f*
\p \v 19 \w Have you been thinking|strong="G1380"\w* \w all along|strong="G3819"\w* \w that|strong="G3754"\w* \w we were making a defense|strong="G626"\w* \w to you|strong="G4771"\w*? \w We speak|strong="G2980"\w* \w before|strong="G2713"\w* \w God|strong="G2316"\w* \w in|strong="G1722"\w* \w Christ|strong="G5547"\w*, \w and|strong="G1161"\w* \w all|strong="G3956"\w* \w of this|strong="G3588"\w*, \w beloved|strong="G27"\w*, \w is|strong="G5228"\w* \w to build you up|strong="G3619"\w*. \v 20 \w For|strong="G1063"\w* \w I am afraid|strong="G5399"\w* \w that|strong="G3361"\w* \w when I come|strong="G2064"\w*, \w I may not find|strong="G2147"\w* \w you|strong="G4771"\w* \w as|strong="G3634"\w* \w I wish|strong="G2309"\w*, \w and|strong="G2504"\w* \w you|strong="G4771"\w* \w may not find me|strong="G2147"\w* \w as|strong="G3634"\w* \w you wish|strong="G2309"\w*. \w I fear|strong="G3361"\w* \w that there may be|strong="G4459"\w* \w quarreling|strong="G2054"\w*, \w jealousy|strong="G2205"\w*, \w rage|strong="G2372"\w*, \w rivalry|strong="G2052"\w*, \w slander|strong="G2636"\w*, \w gossip|strong="G5587"\w*, \w arrogance|strong="G5450"\w*, \w and disorder|strong="G181"\w*. \v 21 \w I am afraid that|strong="G3361"\w* \w when I come|strong="G2064"\w* \w again|strong="G3825"\w*, \w my|strong="G1473"\w* \w God|strong="G2316"\w* \w will humble|strong="G5013"\w* \w me|strong="G1473"\w* \w before|strong="G4314"\w* \w you|strong="G4771"\w*, \w and|strong="G2532"\w* \w I will be grieved over|strong="G3996"\w* \w many|strong="G4183"\w* \w who|strong="G3588"\w* \w have sinned earlier|strong="G4258"\w* \w and|strong="G2532"\w* \w have not repented|strong="G3340"\w* \w of|strong="G1909"\w* \w their acts of|strong="G4238"\w* \w impurity|strong="G167"\w*, \w sexual immorality|strong="G4202"\w*, \w and|strong="G2532"\w* \w debauchery|strong="G766"\w*.
\c 13
\s1 Examine Yourselves
\p \v 1 \w This is|strong="G3778"\w* \w the third time|strong="G5154"\w* \w I am coming|strong="G2064"\w* \w to|strong="G4314"\w* \w you|strong="G4771"\w*. “\w Every|strong="G3956"\w* \w matter|strong="G4487"\w* \w must be established|strong="G2476"\w* \w by|strong="G1909"\w* \w the testimony|strong="G4750"\w* \w of two|strong="G1417"\w* \w or|strong="G2532"\w* \w three|strong="G5140"\w* \w witnesses|strong="G3144"\w*.”\f + \fr 13:1 \ft \ref Deuteronomy 19:15|DEU 19:15\ref*\f*
\p \v 2 \w I already warned you|strong="G4302"\w* \w the|strong="G3588"\w* \w second time|strong="G1208"\w* \w I was with you|strong="G3918"\w*. \w So|strong="G2532"\w* \w now|strong="G3568"\w* \w in my absence|strong="G548"\w* \w I warn|strong="G4302"\w* \w those who|strong="G3588"\w* \w sinned earlier|strong="G4258"\w* \w and|strong="G2532"\w* \w everyone|strong="G3956"\w* \w else|strong="G3062"\w*: \w If|strong="G1437"\w* \w I return|strong="G2064"\w*, \w I will not spare anyone|strong="G5339"\w*, \v 3 \w since|strong="G1893"\w* \w you are demanding|strong="G2212"\w* \w proof|strong="G1382"\w* \w that|strong="G3588"\w* \w Christ|strong="G5547"\w* \w is speaking|strong="G2980"\w* \w through|strong="G1722"\w* \w me|strong="G1473"\w*. \w He|strong="G3739"\w* \w is not weak|strong="G770"\w* \w in dealing with|strong="G1519"\w* \w you|strong="G4771"\w* \w but|strong="G235"\w* \w is powerful|strong="G1414"\w* \w among|strong="G1722"\w* \w you|strong="G4771"\w*. \v 4 \w For|strong="G1063"\w* \w He was indeed crucified|strong="G4717"\w* \w in|strong="G1537"\w* \w weakness|strong="G769"\w*, \w yet|strong="G235"\w* \w He lives|strong="G2198"\w* \w by|strong="G1537"\w* \w God’s|strong="G2316"\w* \w power|strong="G1411"\w*. \w For|strong="G1063"\w* \w we are|strong="G1473"\w* \w also|strong="G2532"\w* \w weak|strong="G770"\w* \w in|strong="G1722"\w* \w Him|strong="G846"\w*, \w yet|strong="G235"\w* \w by|strong="G1537"\w* \w God’s|strong="G2316"\w* \w power|strong="G1411"\w* \w we will live|strong="G2198"\w* \w with|strong="G4862"\w* \w Him|strong="G846"\w* \w concerning|strong="G1519"\w* \w you|strong="G4771"\w*.
\p \v 5 \w Examine|strong="G3985"\w* \w yourselves to see|strong="G1438"\w* \w whether|strong="G1487"\w* \w you are|strong="G1510"\w* \w in|strong="G1722"\w* \w the|strong="G3588"\w* \w faith|strong="G4102"\w*; \w test|strong="G1381"\w* \w yourselves|strong="G1438"\w*. \w Do you not|strong="G3756"\w* \w realize|strong="G1921"\w* \w that|strong="G3754"\w* \w Jesus|strong="G2424"\w* \w Christ|strong="G5547"\w* \w is in|strong="G1722"\w* \w you|strong="G4771"\w* — \w unless|strong="G1487"\w* \w you|strong="G1510"\w* \w fail the test|strong="G96"\w*? \v 6 \w And|strong="G1161"\w* \w I hope|strong="G1679"\w* \w you will realize|strong="G1097"\w* \w that|strong="G3754"\w* \w we|strong="G1473"\w* \w have|strong="G1510"\w* \w not|strong="G3756"\w* \w failed the test|strong="G96"\w*.
\p \v 7 \w Now|strong="G1161"\w* \w we pray|strong="G2172"\w* \w to|strong="G4314"\w* \w God|strong="G2316"\w* \w that you|strong="G4771"\w* \w will not do|strong="G4160"\w* \w anything|strong="G3367"\w* \w wrong|strong="G2556"\w* — \w not|strong="G3756"\w* \w that|strong="G2443"\w* \w we|strong="G1473"\w* \w will appear|strong="G5316"\w* \w to have stood the test|strong="G1384"\w*, \w but|strong="G235"\w* \w that|strong="G2443"\w* \w you|strong="G4771"\w* \w will do|strong="G4160"\w* \w what is|strong="G3588"\w* \w right|strong="G2570"\w*, \w even if|strong="G1161"\w* \w we|strong="G1473"\w* \w appear|strong="G1510"\w* \w to|strong="G5613"\w* \w have failed|strong="G96"\w*. \v 8 \w For|strong="G1063"\w* \w we cannot do|strong="G1410"\w* \w anything|strong="G5100"\w* \w against|strong="G2596"\w* \w the|strong="G3588"\w* \w truth|strong="G225"\w*, \w but only|strong="G235"\w* \w for|strong="G5228"\w* \w the|strong="G3588"\w* \w truth|strong="G225"\w*. \v 9 \w In fact|strong="G1063"\w*, \w we rejoice|strong="G5463"\w* \w when|strong="G3752"\w* \w we|strong="G1473"\w* \w are weak|strong="G770"\w* \w but|strong="G1161"\w* \w you|strong="G4771"\w* \w are|strong="G1510"\w* \w strong|strong="G1415"\w*, \w and|strong="G2532"\w* \w our prayer is for|strong="G2172"\w* \w your|strong="G4771"\w* \w perfection|strong="G2676"\w*.
\p \v 10 \w This is why|strong="G3778"\w* \w I write|strong="G1125"\w* \w these things|strong="G3778"\w* \w while absent|strong="G548"\w*, \w so that|strong="G2443"\w* \w when I am present|strong="G3918"\w* \w I will not need to be|strong="G5530"\w* \w severe|strong="G664"\w* \w in my use of|strong="G2596"\w* \w the|strong="G3588"\w* \w authority|strong="G1849"\w* \w that|strong="G3739"\w* \w the|strong="G3588"\w* \w Lord|strong="G2962"\w* \w gave|strong="G1325"\w* \w me|strong="G1473"\w* \w for|strong="G1519"\w* \w building you up|strong="G3619"\w*, \w not|strong="G3756"\w* \w for|strong="G1519"\w* \w tearing you down|strong="G2506"\w*.
\s1 Benediction and Farewell
\p \v 11 \w Finally|strong="G3063"\w*, \w brothers|strong="G80"\w*, \w rejoice|strong="G5463"\w*! \w Aim for perfect harmony|strong="G2675"\w*, \w encourage one another|strong="G3870"\w*,\f + \fr 13:11 \ft Or \fqa listen to my appeal\f* \w be of|strong="G3588"\w* \w one|strong="G846"\w* \w mind|strong="G5426"\w*, \w live in peace|strong="G1514"\w*. \w And|strong="G2532"\w* \w the|strong="G3588"\w* \w God|strong="G2316"\w* \w of love|strong="G26"\w* \w and|strong="G2532"\w* \w peace|strong="G1515"\w* \w will be|strong="G1510"\w* \w with|strong="G3326"\w* \w you|strong="G4771"\w*.
