\p \v 16 \w If|strong="G1437"\w* \w anyone|strong="G5100"\w* \w sees|strong="G3708"\w* \w his|strong="G846"\w* \w brother|strong="G80"\w* \w committing|strong="G264"\w* \w a sin|strong="G266"\w* \w not|strong="G3361"\w* \w leading to|strong="G4314"\w* \w death|strong="G2288"\w*, \w he should ask God|strong="G154"\w*, \w who will give|strong="G1325"\w* \w life|strong="G2222"\w* \w to those who|strong="G3588"\w* \w commit this kind of sin|strong="G264"\w*. \w There is|strong="G1510"\w* \w a sin|strong="G266"\w* \w that leads to|strong="G4314"\w* \w death|strong="G2288"\w*; \w I am not saying|strong="G3004"\w* \w he should ask|strong="G2065"\w* \w regarding|strong="G4012"\w* \w that sin|strong="G1565"\w*. \v 17 \w All|strong="G3956"\w* \w unrighteousness|strong="G93"\w* \w is|strong="G1510"\w* \w sin|strong="G266"\w*, \w yet|strong="G2532"\w* \w there is|strong="G1510"\w* \w sin|strong="G266"\w* \w that does not lead to|strong="G4314"\w* \w death|strong="G2288"\w*.
\s1 The True God
\p \v 18 \w We know|strong="G1492"\w* \w that|strong="G3754"\w* \w anyone|strong="G3956"\w* \w born|strong="G1080"\w* \w of|strong="G1537"\w* \w God|strong="G2316"\w* \w does not keep on sinning|strong="G264"\w*; \w the One who|strong="G3588"\w* \w was born|strong="G1080"\w* \w of|strong="G1537"\w* \w God|strong="G2316"\w* \w protects|strong="G5083"\w* \w him|strong="G846"\w*,\f + \fr 5:18 \ft Or \fqa the one who was born of God protects himself \ft or \fqa God protects the one born of Him\f* \w and|strong="G2532"\w* \w the|strong="G3588"\w* \w evil one|strong="G4190"\w*\f + \fr 5:18 \ft Or \fqa evil\ft ; similarly in verse 19\f* \w cannot touch|strong="G680"\w* \w him|strong="G846"\w*. \v 19 \w We know|strong="G1492"\w* \w that|strong="G3754"\w* \w we are|strong="G1510"\w* \w of|strong="G1537"\w* \w God|strong="G2316"\w*, \w and that|strong="G2532"\w* \w the|strong="G3588"\w* \w whole|strong="G3650"\w* \w world|strong="G2889"\w* \w is under the power|strong="G2749"\w* \w of|strong="G1722"\w* \w the|strong="G3588"\w* \w evil one|strong="G4190"\w*. \v 20 \w And|strong="G1161"\w* \w we know|strong="G1492"\w* \w that|strong="G3754"\w* \w the|strong="G3588"\w* \w Son|strong="G5207"\w* \w of God|strong="G2316"\w* \w has come|strong="G2240"\w* \w and|strong="G2532"\w* \w has given|strong="G1325"\w* \w us|strong="G1473"\w* \w understanding|strong="G1271"\w*, \w so that|strong="G2443"\w* \w we may know|strong="G1097"\w* \w Him who is|strong="G3588"\w* \w true|strong="G228"\w*; \w and|strong="G2532"\w* \w we are|strong="G1510"\w* \w in|strong="G1722"\w* \w Him who is|strong="G3588"\w* \w true|strong="G228"\w* — \w in|strong="G1722"\w* \w His|strong="G846"\w* \w Son|strong="G5207"\w* \w Jesus|strong="G2424"\w* \w Christ|strong="G5547"\w*. \w He|strong="G3778"\w* \w is|strong="G1510"\w* \w the|strong="G3588"\w* \w true|strong="G228"\w* \w God|strong="G2316"\w* \w and|strong="G2532"\w* \w eternal|strong="G166"\w* \w life|strong="G2222"\w*.
