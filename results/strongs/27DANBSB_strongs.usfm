\p \v 11 \w Then|strong="H116"\w* \w I kept|strong="H1934"\w* \w watching|strong="H2370"\w* \w because of|strong="H4481"\w* \w the arrogant|strong="H7260"\w* \w words|strong="H4406"\w* \w the horn|strong="H7162"\w* \w was speaking|strong="H4449"\w*. \w As|strong="H5705"\w* \w I continued to watch|strong="H2370"\w*, \w the beast|strong="H2423"\w* \w was slain|strong="H6992"\w*, \w and its body|strong="H1655"\w* \w was destroyed|strong="H7"\w* \w and thrown into|strong="H3052"\w* \w the blazing|strong="H3346"\w* \w fire|strong="H785"\w*. \v 12 \w As for the rest|strong="H7606"\w* \w of the beasts|strong="H2423"\w*, \w their dominion|strong="H7985"\w* \w was removed|strong="H5709"\w*, \w but they were granted|strong="H3052"\w* \w an extension|strong="H754"\w* \w of life|strong="H2417"\w* \w for|strong="H5705"\w* \w a season|strong="H2166"\w* \w and a time|strong="H5732"\w*.
\s1 Daniel’s Vision of the Son of Man
\p \v 13 \w In my vision|strong="H2376"\w* \w in the night|strong="H3916"\w* \w I continued|strong="H1934"\w* \w to watch|strong="H2370"\w*,
\q1 \w and I saw|strong="H718"\w* \w One like the Son|strong="H1247"\w* \w of Man|strong="H606"\w*\f + \fr 7:13 \ft Or \fqa one like a son of man\f*
\q2 \w coming|strong="H858"\w* \w with|strong="H5974"\w* \w the clouds|strong="H6050"\w* \w of heaven|strong="H8065"\w*.\f + \fr 7:13 \ft See \ref Matthew 24:30|MAT 24:30\ref*, Matthew 26:64, Mark 13:26, Mark 14:62, Luke 21:27, Revelation 1:13, and Revelation 14:14.\f*
\q1 \w He approached|strong="H4291"\w* \w the Ancient|strong="H6268"\w* \w of Days|strong="H3118"\w*
