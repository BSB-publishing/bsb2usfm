\p \v 24 \w At the command|strong="H560"\w* \w of the king|strong="H4430"\w*, \w the|strong="H479"\w* \w men|strong="H1400"\w* \w who|strong="H1768"\w* \w had falsely accused|strong="H399"\w* \w Daniel|strong="H1841"\w* \w were brought|strong="H858"\w* \w and thrown|strong="H7412"\w* \w into the den|strong="H1358"\w* \w of lions|strong="H744"\w*— \w they|strong="H581"\w* \w and their children|strong="H1123"\w* \w and wives|strong="H5389"\w*. \w And before|strong="H3809"\w* \w they had reached|strong="H4291"\w* \w the bottom|strong="H773"\w* \w of the den|strong="H1358"\w*, \w the lions|strong="H744"\w* \w overpowered|strong="H7981"\w* them \w and crushed|strong="H1855"\w* \w all|strong="H3606"\w* \w their bones|strong="H1635"\w*.
