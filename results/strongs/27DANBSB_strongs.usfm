\p \v 19 \w At the first light|strong="H5053"\w* \w of dawn|strong="H8238"\w*, \w the king|strong="H4430"\w* \w got up|strong="H6966"\w* \w and hurried|strong="H927"\w* \w to the den|strong="H1358"\w* \w of|strong="H1768"\w* \w lions|strong="H744"\w*. \v 20 \w When he reached|strong="H7127"\w* \w the den|strong="H1358"\w*, \w he cried out|strong="H2200"\w* \w in a voice|strong="H7032"\w* \w of anguish|strong="H6088"\w*, “\w O Daniel|strong="H1841"\w*, \w servant|strong="H5649"\w* \w of the living|strong="H2417"\w* \w God|strong="H426"\w*, \w has your God|strong="H426"\w*, \w whom|strong="H1768"\w* \w you|strong="H607"\w* \w serve|strong="H6399"\w* \w continually|strong="H8411"\w*, \w been able|strong="H3202"\w* \w to deliver you|strong="H7804"\w* \w from|strong="H4481"\w* \w the lions|strong="H744"\w*?”
\p \v 21 \w Then|strong="H116"\w* \w Daniel|strong="H1841"\w* \w replied|strong="H4449"\w*, “\w O king|strong="H4430"\w*, \w may you live|strong="H2418"\w* \w forever|strong="H5957"\w*! \v 22 \w My God|strong="H426"\w* \w sent|strong="H7972"\w* \w His angel|strong="H4398"\w* \w and shut|strong="H5463"\w* \w the mouths|strong="H6433"\w* \w of the lions|strong="H744"\w*. \w They have not|strong="H3809"\w* \w hurt me|strong="H2255"\w*, \w for|strong="H6903"\w* \w I was found|strong="H7912"\w* \w innocent|strong="H2136"\w* \w in His sight|strong="H6925"\w*, \w and|strong="H638"\w* \w I have done|strong="H5648"\w* \w no|strong="H3809"\w* \w wrong|strong="H2248"\w* \w against you|strong="H6925"\w*, \w O king|strong="H4430"\w*.”
