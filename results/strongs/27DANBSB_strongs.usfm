\p \w So|strong="H116"\w* \w Shadrach|strong="H7715"\w*, \w Meshach|strong="H4336"\w*, \w and Abednego|strong="H5665"\w* \w came out|strong="H5312"\w* \w of|strong="H4481"\w* \w the fire|strong="H5135"\w*, \v 27 \w and when the satraps|strong="H324"\w*, \w prefects|strong="H5460"\w*, \w governors|strong="H6347"\w*, \w and royal|strong="H4430"\w* \w advisers|strong="H1907"\w* \w had gathered around|strong="H3673"\w*, \w they saw|strong="H2370"\w* \w that the fire|strong="H5135"\w* \w had no|strong="H3809"\w* \w effect|strong="H7981"\w* \w on the bodies|strong="H1655"\w* \w of these|strong="H479"\w* \w men|strong="H1400"\w*. \w Not|strong="H3809"\w* \w a hair|strong="H8177"\w* \w of their heads|strong="H7217"\w* \w was singed|strong="H2761"\w*, \w their robes|strong="H5622"\w* \w were unaffected|strong="H3809"\w*, \w and there was no|strong="H3809"\w* \w smell|strong="H7382"\w* \w of fire|strong="H5135"\w* on them.
\p \v 28 \w Nebuchadnezzar|strong="H5020"\w* \w declared|strong="H6032"\w*, “\w Blessed|strong="H1289"\w* \w be the God|strong="H426"\w* \w of|strong="H1768"\w* \w Shadrach|strong="H7715"\w*, \w Meshach|strong="H4336"\w*, \w and Abednego|strong="H5665"\w*, \w who has sent|strong="H7972"\w* \w His angel|strong="H4398"\w*\f + \fr 3:28 \ft Or \fqa Angel\f* \w and delivered|strong="H7804"\w* \w His servants|strong="H5649"\w* \w who|strong="H1768"\w* \w trusted|strong="H7365"\w* \w in Him|strong="H5922"\w*. \w They violated|strong="H8133"\w* \w the king’s|strong="H4430"\w* \w command|strong="H4406"\w* \w and risked their lives|strong="H1655"\w* \w rather than serve|strong="H6399"\w* \w or worship|strong="H5457"\w* \w any|strong="H3606"\w* \w god|strong="H426"\w* \w except|strong="H3861"\w* \w their own God|strong="H426"\w*. \v 29 Therefore I \w decree|strong="H7761"\w* \w that|strong="H1768"\w* \w the people|strong="H5972"\w* \w of any|strong="H3606"\w* \w nation|strong="H524"\w* \w or language|strong="H3961"\w* \w who|strong="H1768"\w* \w say|strong="H560"\w* \w anything offensive|strong="H7955"\w* \w against|strong="H5922"\w* \w the God|strong="H426"\w* \w of|strong="H1768"\w* \w Shadrach|strong="H7715"\w*, \w Meshach|strong="H4336"\w*, \w and Abednego|strong="H5665"\w* \w will be cut|strong="H5648"\w* \w into pieces|strong="H1917"\w* \w and their houses|strong="H1005"\w* \w reduced|strong="H7739"\w* \w to rubble|strong="H5122"\w*. \w For|strong="H6903"\w* \w there is|strong="H383"\w* \w no|strong="H3809"\w* \w other|strong="H321"\w* \w god|strong="H426"\w* \w who|strong="H1768"\w* \w can|strong="H3202"\w* \w deliver|strong="H5338"\w* \w in this way|strong="H1836"\w*.”
