\q2 \w but|strong="H1297"\w* \w leave|strong="H7662"\w* \w the stump|strong="H6136"\w* \w with its roots|strong="H8330"\w* \w in the ground|strong="H772"\w*,
\q1 \w with a band|strong="H613"\w* \w of|strong="H1768"\w* \w iron|strong="H6523"\w* \w and bronze around it|strong="H5174"\w*,
\q2 \w in the tender grass|strong="H1883"\w* \w of|strong="H1768"\w* \w the field|strong="H1251"\w*.
\b 
\q1 \w Let him be drenched|strong="H6647"\w* \w with the dew|strong="H2920"\w* \w of heaven|strong="H8065"\w*,
\q2 \w and graze|strong="H2508"\w* \w with|strong="H5974"\w* \w the beasts|strong="H2423"\w* \w of the field|strong="H1251"\w*
\q2 \w till|strong="H5705"\w* \w seven|strong="H7655"\w* \w times|strong="H5732"\w* \w pass him|strong="H2499"\w* \w by|strong="H5922"\w*.’
\p \v 24 \w This|strong="H1836"\w* \w is the interpretation|strong="H6591"\w*, \w O king|strong="H4430"\w*, \w and this is the decree|strong="H1510"\w* \w that the Most High|strong="H5943"\w* \w has issued|strong="H4291"\w* \w against|strong="H5922"\w* \w my lord|strong="H4756"\w* \w the king|strong="H4430"\w*:
\p \v 25 \w You will be driven away|strong="H2957"\w* \w from|strong="H4481"\w* \w mankind|strong="H606"\w*, \w and your dwelling|strong="H4070"\w* \w will be|strong="H1934"\w* \w with|strong="H5974"\w* \w the beasts|strong="H2423"\w* \w of the field|strong="H1251"\w*. \w You will feed on|strong="H2939"\w* \w grass|strong="H6211"\w* \w like an ox|strong="H8450"\w* \w and be drenched|strong="H6647"\w* \w with the dew|strong="H2920"\w* \w of heaven|strong="H8065"\w*, \w and seven|strong="H7655"\w* \w times|strong="H5732"\w* \w shall pass|strong="H2499"\w* \w you by|strong="H5922"\w*, \w until|strong="H5705"\w* \w you acknowledge|strong="H3046"\w* \w that|strong="H1768"\w* \w the Most High|strong="H5943"\w* \w rules|strong="H7990"\w* \w over the kingdom|strong="H4437"\w* \w of mankind|strong="H606"\w* \w and gives it|strong="H5415"\w* \w to whom|strong="H4479"\w* \w He wishes|strong="H6634"\w*.
\p \v 26 \w As for|strong="H1768"\w* \w the command|strong="H560"\w* \w to leave|strong="H7662"\w* \w the stump|strong="H6136"\w* \w of|strong="H1768"\w* \w the tree|strong="H363"\w* \w with its roots|strong="H8330"\w*, \w your kingdom|strong="H4437"\w* \w will be restored|strong="H7011"\w* \w to you|strong="H4481"\w* \w as soon as|strong="H1768"\w* \w you acknowledge|strong="H3046"\w* \w that|strong="H1768"\w* \w Heaven|strong="H8065"\w* \w rules|strong="H7990"\w*. \v 27 \w Therefore|strong="H2006"\w*, \w may my advice|strong="H4431"\w* \w be pleasing|strong="H8232"\w* \w to you|strong="H5922"\w*, \w O king|strong="H4430"\w*. \w Break away|strong="H6562"\w* \w from your sins|strong="H2408"\w* \w by doing what is right|strong="H6665"\w*, \w and from your iniquities|strong="H5758"\w* \w by showing mercy|strong="H2604"\w* \w to the oppressed|strong="H6033"\w*. \w Perhaps|strong="H2006"\w* \w there will be|strong="H1934"\w* \w an extension|strong="H754"\w* \w of your prosperity|strong="H7963"\w*.”
\s1 The Second Dream Fulfilled
\p \v 28 \w All|strong="H3606"\w* \w this happened|strong="H4291"\w* \w to|strong="H5922"\w* \w King|strong="H4430"\w* \w Nebuchadnezzar|strong="H5020"\w*. \v 29 \w Twelve|strong="H8648"\w* \w months|strong="H3393"\w* \w later|strong="H7118"\w*, \w as he was|strong="H1934"\w* \w walking|strong="H1981"\w* \w on|strong="H5922"\w* \w the roof of the royal palace|strong="H1965"\w* \w of|strong="H1768"\w* \w Babylon|strong="H895"\w*, \v 30 \w the king|strong="H4430"\w* \w exclaimed|strong="H6032"\w*, “\w Is this|strong="H1668"\w* \w not|strong="H3809"\w* \w Babylon|strong="H895"\w* \w the Great|strong="H7229"\w*, \w which|strong="H1768"\w* \w I myself|strong="H576"\w* \w have built|strong="H1124"\w* \w as a royal|strong="H4437"\w* \w residence|strong="H1005"\w* \w by the might|strong="H8632"\w* \w of my power|strong="H2632"\w* \w and for the glory|strong="H3367"\w* \w of my majesty|strong="H1923"\w*?”
\p \v 31 \w While the words|strong="H4406"\w* \w were still|strong="H5751"\w* \w in the king’s|strong="H4430"\w* \w mouth|strong="H6433"\w*, \w a voice|strong="H7032"\w* \w came|strong="H5308"\w* \w from|strong="H4481"\w* \w heaven|strong="H8065"\w*: “\w It is decreed|strong="H560"\w* to you, \w King|strong="H4430"\w* \w Nebuchadnezzar|strong="H5020"\w*, \w that the kingdom|strong="H4437"\w* \w has departed|strong="H5709"\w* \w from you|strong="H4481"\w*. \v 32 \w You will be driven away|strong="H2957"\w* \w from|strong="H4481"\w* \w mankind|strong="H606"\w* \w to live|strong="H4070"\w* \w with|strong="H5974"\w* \w the beasts|strong="H2423"\w* \w of the field|strong="H1251"\w*, \w and you will feed on|strong="H2939"\w* \w grass|strong="H6211"\w* \w like an ox|strong="H8450"\w*. \w And seven|strong="H7655"\w* \w times|strong="H5732"\w* \w will pass|strong="H2499"\w* \w you by|strong="H5922"\w*, \w until|strong="H5705"\w* \w you acknowledge|strong="H3046"\w* \w that|strong="H1768"\w* \w the Most High|strong="H5943"\w* \w rules|strong="H7990"\w* \w over the kingdom|strong="H4437"\w* \w of mankind|strong="H606"\w* \w and gives it|strong="H5415"\w* \w to whom|strong="H4479"\w* \w He wishes|strong="H6634"\w*.”
\p \v 33 At that \w moment|strong="H8160"\w* \w the sentence|strong="H4406"\w* \w against|strong="H5922"\w* \w Nebuchadnezzar|strong="H5020"\w* \w was fulfilled|strong="H5487"\w*. \w He was driven away|strong="H2957"\w* \w from|strong="H4481"\w* \w mankind|strong="H606"\w*. \w He ate|strong="H399"\w* \w grass|strong="H6211"\w* \w like an ox|strong="H8450"\w*, \w and his body|strong="H1655"\w* \w was drenched|strong="H6647"\w* \w with the dew|strong="H2920"\w* \w of heaven|strong="H8065"\w*, \w until|strong="H5705"\w* \w his hair|strong="H8177"\w* \w grew|strong="H7236"\w* \w like the feathers of an eagle|strong="H5403"\w* \w and his nails|strong="H2953"\w* \w like the claws of a bird|strong="H6853"\w*.
\s1 Nebuchadnezzar Restored
\p \v 34 \w But at the end|strong="H7118"\w* \w of those days|strong="H3118"\w* \w I|strong="H576"\w*, \w Nebuchadnezzar|strong="H5020"\w*, \w looked up|strong="H5870"\w* \w to heaven|strong="H8065"\w*, \w and my sanity|strong="H4486"\w* \w was restored|strong="H8421"\w* \w to me|strong="H5922"\w*. \w Then I praised|strong="H1289"\w* \w the Most High|strong="H5943"\w*, \w and I honored|strong="H7624"\w* \w and glorified|strong="H1922"\w* \w Him who lives|strong="H2417"\w* \w forever|strong="H5957"\w*:
\q1 “\w For His dominion|strong="H7985"\w* \w is an everlasting|strong="H5957"\w* \w dominion|strong="H7985"\w*,
\q2 \w and His kingdom|strong="H4437"\w* \w endures from|strong="H5974"\w* \w generation|strong="H1859"\w* \w to generation|strong="H1859"\w*.
\q1 \v 35 \w All|strong="H3606"\w* \w the peoples|strong="H1753"\w* \w of the earth|strong="H772"\w*
\q2 \w are counted|strong="H2804"\w* \w as nothing|strong="H3809"\w*,
\q1 \w and He does|strong="H5648"\w* \w as He pleases|strong="H6634"\w*
