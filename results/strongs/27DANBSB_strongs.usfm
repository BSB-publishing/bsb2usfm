\q2 \w and the peoples|strong="H1753"\w* \w of the earth|strong="H772"\w*.
\q1 \w There is|strong="H383"\w* \w no|strong="H3809"\w* \w one who|strong="H1768"\w* \w can restrain|strong="H4223"\w* \w His hand|strong="H3028"\w*
\q2 \w or say|strong="H560"\w* to Him, ‘\w What|strong="H4101"\w* \w have You done|strong="H5648"\w*?’”
\p \v 36 At \w the same time|strong="H2166"\w* \w my sanity|strong="H4486"\w* \w was restored|strong="H8421"\w*, \w my honor|strong="H1923"\w* \w and splendor|strong="H2122"\w* \w returned|strong="H8421"\w* \w to me|strong="H5922"\w* \w for the glory|strong="H3367"\w* \w of my kingdom|strong="H4437"\w*. \w My advisers|strong="H1907"\w* \w and nobles|strong="H7261"\w* \w sought me out|strong="H1156"\w*, \w and I was restored|strong="H8627"\w* \w to|strong="H5922"\w* \w my throne|strong="H4437"\w*, \w and surpassing|strong="H3493"\w* \w greatness|strong="H7238"\w* \w was added|strong="H3255"\w* to me. \v 37 \w Now|strong="H3705"\w* \w I|strong="H576"\w*, \w Nebuchadnezzar|strong="H5020"\w*, \w praise|strong="H7624"\w* \w and exalt|strong="H7313"\w* \w and glorify|strong="H1922"\w* \w the King|strong="H4430"\w* \w of heaven|strong="H8065"\w*, \w for|strong="H1768"\w* \w all|strong="H3606"\w* \w His works|strong="H4567"\w* \w are true|strong="H7187"\w* \w and all His ways|strong="H735"\w* \w are just|strong="H1780"\w*. \w And He is able|strong="H3202"\w* \w to humble|strong="H8214"\w* \w those|strong="H1768"\w* \w who walk|strong="H1981"\w* \w in pride|strong="H1467"\w*.
\c 5
\s1 Belshazzar’s Feast
\p \v 1 \w Later,|strong="H4430"\w*\f + \fr 5:1 \ft Aramaic does not include \fqa Later\ft . Some translators include \fqa Many years later \ft to account for the time elapsed, probably about 30 years, since the previous chapter.\f* \w King Belshazzar|strong="H1113"\w* \w held|strong="H5648"\w* \w a great|strong="H7229"\w* \w feast|strong="H3900"\w* \w for a thousand|strong="H506"\w* \w of his nobles|strong="H7261"\w*, \w and he drank|strong="H8355"\w* \w wine|strong="H2562"\w* \w with|strong="H6903"\w* \w them|strong="H506"\w*. \v 2 \w Under the influence of the wine|strong="H2562"\w*, \w Belshazzar|strong="H1113"\w* \w gave orders|strong="H560"\w* \w to bring|strong="H858"\w* \w in the gold|strong="H1722"\w* \w and silver|strong="H3702"\w* \w vessels|strong="H3984"\w* \w that|strong="H1768"\w* \w Nebuchadnezzar|strong="H5020"\w* \w his father|strong="H2"\w*\f + \fr 5:2 \ft Or \fqa predecessor \ft or \fqa grandfather\ft ; also in verses 11, 13, and 18\f* \w had taken|strong="H5312"\w* \w from|strong="H4481"\w* \w the temple|strong="H1965"\w* \w in Jerusalem|strong="H3390"\w*, \w so that the king|strong="H4430"\w* \w could drink|strong="H8355"\w* from them, \w along with his nobles|strong="H7261"\w*, \w his wives|strong="H7695"\w*, \w and his concubines|strong="H3904"\w*.
\p \v 3 \w Thus|strong="H116"\w* \w they brought in|strong="H858"\w* \w the gold|strong="H1722"\w* \w vessels|strong="H3984"\w* \w that|strong="H1768"\w* \w had been taken|strong="H5312"\w* \w from|strong="H4481"\w* \w the temple|strong="H1965"\w*, \w the house|strong="H1005"\w* \w of God|strong="H426"\w* \w in Jerusalem|strong="H3390"\w*, \w and the king|strong="H4430"\w* \w drank|strong="H8355"\w* from them, \w along with his nobles|strong="H7261"\w*, \w his wives|strong="H7695"\w*, \w and his concubines|strong="H3904"\w*. \v 4 \w As they drank|strong="H8355"\w* \w the wine|strong="H2562"\w*, \w they praised|strong="H7624"\w* \w their gods|strong="H426"\w* \w of gold|strong="H1722"\w* \w and silver|strong="H3702"\w*, \w bronze|strong="H5174"\w* \w and iron|strong="H6523"\w*, \w wood|strong="H636"\w* \w and stone|strong="H69"\w*.
\s1 The Handwriting on the Wall
\p \v 5 At \w that moment|strong="H8160"\w* \w the fingers|strong="H677"\w* \w of|strong="H1768"\w* \w a human|strong="H606"\w* \w hand|strong="H3028"\w* \w appeared|strong="H5312"\w* \w and wrote|strong="H3790"\w* \w on|strong="H5922"\w* \w the plaster|strong="H1528"\w* \w of|strong="H1768"\w* \w the wall|strong="H3797"\w*, \w near|strong="H6903"\w* \w the lampstand|strong="H5043"\w* \w in|strong="H1768"\w* \w the royal|strong="H4430"\w* \w palace|strong="H1965"\w*. \w As the king|strong="H4430"\w* \w watched|strong="H2370"\w* \w the hand|strong="H6447"\w* \w that|strong="H1768"\w* \w was writing|strong="H3790"\w*, \v 6 \w his face|strong="H2122"\w* \w grew pale|strong="H8133"\w* \w and his thoughts|strong="H7476"\w* \w so alarmed him|strong="H927"\w* \w that his hips|strong="H2783"\w* \w gave way|strong="H8271"\w* \w and his knees|strong="H755"\w* \w knocked together|strong="H1668"\w*.
\p \v 7 \w The king|strong="H4430"\w* \w called out for|strong="H7123"\w* \w the enchanters|strong="H826"\w*, \w astrologers|strong="H3779"\w*,\f + \fr 5:7 \ft Or \fqa Chaldeans\ft ; also in verse 11\f* \w and diviners|strong="H1505"\w* \w to be brought in|strong="H5954"\w*, \w and he|strong="H4430"\w* \w said|strong="H560"\w* \w to these wise men|strong="H2445"\w* \w of Babylon|strong="H895"\w*, “\w Whoever|strong="H1768"\w* \w reads|strong="H7123"\w* \w this|strong="H1836"\w* \w inscription|strong="H3792"\w* \w and tells me|strong="H2324"\w* \w its interpretation|strong="H6591"\w* \w will be clothed|strong="H3848"\w* \w in purple|strong="H711"\w* \w and have a gold|strong="H1722"\w* \w chain|strong="H2002"\w* \w placed around|strong="H5922"\w* \w his neck|strong="H6676"\w*, \w and he will be made the third|strong="H8523"\w* \w highest ruler|strong="H7981"\w* \w in the kingdom|strong="H4437"\w*.”
\p \v 8 \w So|strong="H116"\w* \w all|strong="H3606"\w* \w the king’s|strong="H4430"\w* \w wise men|strong="H2445"\w* \w came in|strong="H5954"\w*, \w but they could|strong="H3546"\w* \w not|strong="H3809"\w* \w read|strong="H7123"\w* \w the inscription|strong="H3792"\w* \w or interpret it|strong="H6591"\w* \w for him|strong="H4430"\w*. \v 9 \w Then|strong="H116"\w* \w King|strong="H4430"\w* \w Belshazzar|strong="H1113"\w* \w became even more|strong="H7690"\w* \w terrified|strong="H927"\w*, \w his face|strong="H2122"\w* \w grew even more pale|strong="H8133"\w*, \w and his nobles|strong="H7261"\w* \w were bewildered|strong="H7672"\w*.
\p \v 10 \w Hearing|strong="H6903"\w* \w the outcry|strong="H4406"\w* \w of the king|strong="H4430"\w* \w and his nobles|strong="H7261"\w*, \w the queen|strong="H4433"\w*\f + \fr 5:10 \ft Or \fqa queen mother\f* \w entered|strong="H5954"\w* \w the banquet|strong="H4961"\w* \w hall|strong="H1005"\w*. “\w O king|strong="H4430"\w*, \w may you live|strong="H2418"\w* \w forever|strong="H5957"\w*!” \w she|strong="H4433"\w* \w said|strong="H560"\w*. “\w Do not|strong="H409"\w* \w let your thoughts|strong="H7476"\w* \w terrify you|strong="H927"\w*, \w or your face|strong="H2122"\w* \w grow pale|strong="H8133"\w*. \v 11 \w There is|strong="H383"\w* \w a man|strong="H1400"\w* \w in your kingdom|strong="H4437"\w* \w who|strong="H1768"\w* \w has the spirit|strong="H7308"\w* \w of the holy|strong="H6922"\w* \w gods|strong="H426"\w* in him. \w In the days|strong="H3118"\w* \w of your father|strong="H2"\w* \w he was found|strong="H7912"\w* \w to have insight|strong="H5094"\w*, \w intelligence|strong="H7924"\w*, \w and wisdom|strong="H2452"\w* \w like that|strong="H2452"\w* \w of the gods|strong="H426"\w*.
\p \w Your father|strong="H2"\w*, \w King|strong="H4430"\w* \w Nebuchadnezzar|strong="H5020"\w*, \w appointed him|strong="H6966"\w* \w chief|strong="H7229"\w* \w of the magicians|strong="H2749"\w*, \w enchanters|strong="H826"\w*, \w astrologers|strong="H3779"\w*, \w and diviners|strong="H1505"\w*. \w Your own father|strong="H2"\w*, \w the king|strong="H4430"\w*, \v 12 \w did this|strong="H3606"\w* \w because|strong="H6903"\w* \w Daniel|strong="H1841"\w*, \w the one|strong="H1768"\w* \w he|strong="H4430"\w* \w named|strong="H7761"\w* \w Belteshazzar|strong="H1096"\w*, \w was found|strong="H7912"\w* \w to have an extraordinary|strong="H3493"\w* \w spirit|strong="H7308"\w*, \w as well as knowledge|strong="H4486"\w*, \w understanding|strong="H7924"\w*, \w and the ability to interpret|strong="H6590"\w* \w dreams|strong="H2493"\w*, \w explain|strong="H263"\w* \w riddles|strong="H280"\w*, \w and solve|strong="H8271"\w* \w difficult problems|strong="H7001"\w*. \w Summon|strong="H7123"\w* \w Daniel|strong="H1841"\w*, \w therefore|strong="H3705"\w*, \w and he will give you|strong="H2324"\w* \w the interpretation|strong="H6591"\w*.”
\s1 Daniel Interprets the Handwriting
\p \v 13 \w So|strong="H116"\w* \w Daniel|strong="H1841"\w* \w was brought|strong="H5954"\w* \w before|strong="H6925"\w* \w the king|strong="H4430"\w*, \w who|strong="H4430"\w* \w asked|strong="H560"\w* \w him|strong="H1841"\w*, “\w Are you|strong="H607"\w* \w Daniel|strong="H1841"\w*, \w one|strong="H1768"\w* \w of|strong="H4481"\w* \w the exiles|strong="H1123"\w* \w my father|strong="H2"\w* \w the king|strong="H4430"\w* \w brought|strong="H858"\w* \w from|strong="H4481"\w* \w Judah|strong="H3061"\w*? \v 14 \w I have heard|strong="H8086"\w* \w that|strong="H1768"\w* \w the spirit|strong="H7308"\w* \w of the gods|strong="H426"\w* is in you, \w and that you have insight|strong="H5094"\w*, \w intelligence|strong="H7924"\w*, \w and extraordinary|strong="H3493"\w* \w wisdom|strong="H2452"\w*.
\p \v 15 \w Now|strong="H3705"\w* \w the wise men|strong="H2445"\w* \w and enchanters|strong="H826"\w* \w were brought|strong="H5954"\w* \w before me|strong="H6925"\w* \w to read|strong="H7123"\w* \w this|strong="H1836"\w* \w inscription|strong="H3792"\w* \w and interpret it|strong="H6591"\w* \w for me|strong="H3046"\w*, \w but they could|strong="H3546"\w* \w not|strong="H3809"\w* \w give|strong="H2324"\w* \w its|strong="H4406"\w* \w interpretation|strong="H6591"\w*. \v 16 \w But|strong="H576"\w* \w I have heard|strong="H8086"\w* \w about you|strong="H5922"\w*, \w that|strong="H1768"\w* \w you are able|strong="H3202"\w* \w to give interpretations|strong="H6591"\w* \w and solve|strong="H8271"\w* \w difficult problems|strong="H7001"\w*. \w Therefore|strong="H3705"\w*, \w if|strong="H2006"\w* \w you can|strong="H3202"\w* \w read|strong="H7123"\w* \w this inscription|strong="H3792"\w* \w and give me|strong="H3046"\w* \w its interpretation|strong="H6591"\w*, \w you will be clothed|strong="H3848"\w* \w in purple|strong="H711"\w* \w and have a gold|strong="H1722"\w* \w chain|strong="H2002"\w* \w placed around|strong="H5922"\w* \w your neck|strong="H6676"\w*, \w and you will be made the third|strong="H8531"\w* \w highest ruler|strong="H7981"\w* \w in the kingdom|strong="H4437"\w*.”
\p \v 17 \w In response|strong="H116"\w*, \w Daniel|strong="H1841"\w* \w said|strong="H560"\w* \w to the king|strong="H4430"\w*, “\w You may keep|strong="H1934"\w* \w your gifts|strong="H4978"\w* for yourself \w and give|strong="H3052"\w* \w your rewards|strong="H5023"\w* \w to someone else|strong="H321"\w*. \w Nevertheless|strong="H1297"\w*, \w I will read|strong="H7123"\w* \w the inscription|strong="H3792"\w* \w for the king|strong="H4430"\w* \w and interpret it|strong="H6591"\w* \w for him|strong="H3046"\w*. \v 18 \w As for you|strong="H607"\w*, \w O king|strong="H4430"\w*, \w the Most High|strong="H5943"\w* \w God|strong="H426"\w* \w gave|strong="H3052"\w* \w your father|strong="H2"\w* \w Nebuchadnezzar|strong="H5020"\w* \w sovereignty|strong="H4437"\w* \w and greatness|strong="H7238"\w*, \w glory|strong="H3367"\w* \w and honor|strong="H1923"\w*. \v 19 \w Because of|strong="H4481"\w* \w the greatness|strong="H7238"\w* \w that|strong="H1768"\w* \w He bestowed|strong="H3052"\w* on him, \w the people|strong="H5972"\w* \w of every|strong="H3606"\w* \w nation|strong="H524"\w* \w and language|strong="H3961"\w* \w trembled|strong="H2112"\w* \w in fear|strong="H1763"\w* \w before|strong="H4481"\w* \w him|strong="H6925"\w*. \w He|strong="H1934"\w* \w killed|strong="H6992"\w* \w whom|strong="H1768"\w* \w he|strong="H1934"\w* \w wished|strong="H6634"\w* \w and kept alive|strong="H2418"\w* \w whom|strong="H1768"\w* \w he|strong="H1934"\w* \w wished|strong="H6634"\w*; \w he exalted|strong="H7313"\w* \w whom|strong="H1768"\w* \w he|strong="H1934"\w* \w wished|strong="H6634"\w* \w and humbled|strong="H8214"\w* \w whom|strong="H1768"\w* \w he|strong="H1934"\w* \w wished|strong="H6634"\w*.
\p \v 20 \w But when|strong="H1768"\w* \w his heart|strong="H3825"\w* \w became arrogant|strong="H7313"\w* \w and his spirit|strong="H7308"\w* \w was hardened|strong="H8631"\w* \w with pride|strong="H2103"\w*, \w he was deposed|strong="H5182"\w* \w from|strong="H4481"\w* \w his royal|strong="H4437"\w* \w throne|strong="H3764"\w*, \w and his glory|strong="H3367"\w* \w was taken|strong="H5709"\w* \w from him|strong="H4481"\w*. \v 21 \w He was driven away|strong="H2957"\w* \w from|strong="H4481"\w* \w mankind|strong="H1123"\w*, \w and his mind|strong="H3825"\w* \w was like|strong="H5974"\w* \w that of a beast|strong="H2423"\w*. \w He lived|strong="H4070"\w* \w with|strong="H5974"\w* \w the wild donkeys|strong="H6167"\w* \w and ate|strong="H2939"\w* \w grass|strong="H6211"\w* \w like an ox|strong="H8450"\w*, \w and his body|strong="H1655"\w* \w was drenched|strong="H6647"\w* \w with the dew|strong="H2920"\w* \w of heaven|strong="H8065"\w* \w until|strong="H5705"\w* \w he acknowledged|strong="H3046"\w* \w that|strong="H1768"\w* \w the Most High|strong="H5943"\w* \w God|strong="H426"\w* \w rules|strong="H7990"\w* \w over the kingdom|strong="H4437"\w* \w of mankind|strong="H606"\w*, \w setting|strong="H6966"\w* \w over it|strong="H5922"\w* \w whom|strong="H4479"\w* \w He wishes|strong="H6634"\w*.
\p \v 22 \w But you|strong="H607"\w* \w his son|strong="H1247"\w*,\f + \fr 5:22 \ft Or \fqa descendant \ft or \fqa successor \ft or \fqa grandson\f* \w O Belshazzar|strong="H1113"\w*, \w have not|strong="H3809"\w* \w humbled|strong="H8214"\w* \w your heart|strong="H3825"\w*, \w even though|strong="H6903"\w* \w you knew|strong="H3046"\w* \w all|strong="H3606"\w* \w this|strong="H1836"\w*. \v 23 \w Instead, you have exalted|strong="H7313"\w* \w yourself against|strong="H5922"\w* \w the Lord|strong="H4756"\w* \w of heaven|strong="H8065"\w*. \w The vessels|strong="H3984"\w* \w from|strong="H1768"\w* \w His house|strong="H1005"\w* \w were brought|strong="H858"\w* \w to you|strong="H6925"\w*, \w and as you|strong="H607"\w* \w drank|strong="H8355"\w* \w wine|strong="H2562"\w* from them \w with your nobles|strong="H7261"\w*, \w wives|strong="H7695"\w*, \w and concubines|strong="H3904"\w*, \w you praised|strong="H7624"\w* \w your gods|strong="H426"\w* \w of silver|strong="H3702"\w* \w and gold|strong="H1722"\w*, \w bronze|strong="H5174"\w* \w and iron|strong="H6523"\w*, \w wood|strong="H636"\w* \w and stone|strong="H69"\w*, \w which|strong="H1768"\w* \w cannot|strong="H3809"\w* \w see|strong="H2370"\w* \w or|strong="H3809"\w* \w hear|strong="H8086"\w* \w or|strong="H3809"\w* \w understand|strong="H3046"\w*. \w But you have failed to|strong="H3809"\w* \w glorify|strong="H1922"\w* \w the God|strong="H426"\w* \w who|strong="H1768"\w* holds \w in His hand|strong="H3028"\w* \w your very breath|strong="H5396"\w* \w and all|strong="H3606"\w* \w your ways|strong="H735"\w*. \v 24 \w Therefore|strong="H116"\w* \w He sent|strong="H7972"\w* \w the hand|strong="H3028"\w* \w that wrote|strong="H7560"\w* \w the|strong="H1836"\w* \w inscription|strong="H3792"\w*.
\p \v 25 \w Now this|strong="H1836"\w* \w is the inscription|strong="H3792"\w* \w that|strong="H1768"\w* \w was written|strong="H7560"\w*:
\pc \w MENE|strong="H4484"\w*, \w MENE|strong="H4484"\w*, \w TEKEL|strong="H8625"\w*, \w PARSIN|strong="H6537"\w*.
\p \v 26 \w And this|strong="H1836"\w* \w is the interpretation|strong="H6591"\w* \w of the message|strong="H4406"\w*:
\li1 \w MENE|strong="H4484"\w*\f + \fr 5:26 \fqa Mene \ft sounds like the Aramaic for \fqa numbered\ft .\f* \w means that God|strong="H426"\w* \w has numbered|strong="H4483"\w* \w the days of your reign|strong="H4437"\w* \w and brought it to an end|strong="H8000"\w*.
\li1 \v 27 \w TEKEL|strong="H8625"\w*\f + \fr 5:27 \fqa Tekel \ft sounds like the Aramaic for \fqa weighed\ft .\f* \w means that you have been weighed|strong="H8625"\w* \w on the scales|strong="H3977"\w* \w and found|strong="H7912"\w* \w deficient|strong="H2627"\w*.
\li1 \v 28 \w PERES|strong="H6537"\w*\f + \fr 5:28 \fqa Peres \ft (the singular of \fqa Parsin\ft ) sounds like the Aramaic for \fqa divided \ft and for \fqa Persia\ft .\f* \w means that your kingdom|strong="H4437"\w* \w has been divided|strong="H6537"\w* \w and given over|strong="H3052"\w* \w to the Medes|strong="H4076"\w* \w and Persians|strong="H6540"\w*.”
\p \v 29 \w Then|strong="H116"\w* \w Belshazzar|strong="H1113"\w* \w gave the command|strong="H560"\w*, \w and they clothed|strong="H3848"\w* \w Daniel|strong="H1841"\w* \w in purple|strong="H711"\w*, \w placed a gold|strong="H1722"\w* \w chain|strong="H2002"\w* \w around|strong="H5922"\w* \w his neck|strong="H6676"\w*, \w and proclaimed|strong="H3745"\w* \w him|strong="H5922"\w* \w the third highest|strong="H8531"\w* \w ruler|strong="H7990"\w* \w in the kingdom|strong="H4437"\w*.
\p \v 30 That \w very night|strong="H3916"\w* \w Belshazzar|strong="H1113"\w* \w king|strong="H4430"\w* \w of the Chaldeans|strong="H3779"\w*\f + \fr 5:30 \ft That is, the Babylonians\f* \w was slain|strong="H6992"\w*, \v 31 \w and Darius|strong="H1868"\w* \w the Mede|strong="H4076"\w* \w received|strong="H6902"\w* \w the kingdom|strong="H4437"\w* \w at the age|strong="H1247"\w* \w of sixty-two|strong="H8361"\w*.
\c 6
\s1 The Plot against Daniel
\p \v 1 \w Now it|strong="H8232"\w* \w pleased|strong="H6925"\w* \w Darius|strong="H1868"\w* \w to appoint|strong="H6966"\w* \w 120|strong="H3969"\w* \w satraps|strong="H324"\w* \w to rule|strong="H1934"\w* \w throughout|strong="H3606"\w* \w the kingdom|strong="H4437"\w*, \v 2 \w and over them|strong="H5924"\w* \w three|strong="H8532"\w* \w administrators|strong="H5632"\w*, \w including Daniel|strong="H1841"\w*, to whom \w these|strong="H459"\w* \w satraps|strong="H324"\w* \w were accountable|strong="H2941"\w* \w so that the king|strong="H4430"\w* \w would|strong="H1934"\w* \w not|strong="H3809"\w* \w suffer loss|strong="H5142"\w*. \v 3 \w Soon|strong="H116"\w*, \w by|strong="H6903"\w* \w his extraordinary|strong="H3493"\w* \w spirit|strong="H7308"\w*, \w Daniel|strong="H1841"\w* \w distinguished himself|strong="H5330"\w* \w among|strong="H5922"\w* \w the administrators|strong="H5632"\w* \w and satraps|strong="H324"\w*. \w So the king|strong="H4430"\w* \w planned|strong="H6246"\w* \w to set him|strong="H6966"\w* \w over|strong="H5922"\w* \w the whole|strong="H3606"\w* \w kingdom|strong="H4437"\w*.
\p \v 4 \w Thus|strong="H116"\w* \w the administrators|strong="H5632"\w* \w and satraps|strong="H324"\w* \w sought|strong="H1934"\w* \w a charge|strong="H5931"\w* \w against Daniel|strong="H1841"\w* \w concerning|strong="H6655"\w* \w the kingdom|strong="H4437"\w*, \w but they could|strong="H3202"\w* \w find|strong="H7912"\w* \w no|strong="H3606"\w* \w charge|strong="H5931"\w* \w or corruption|strong="H7844"\w*, \w because|strong="H6903"\w* \w he|strong="H1932"\w* \w was trustworthy|strong="H540"\w*, \w and no|strong="H3809"\w* \w negligence|strong="H7960"\w* \w or corruption|strong="H7844"\w* \w was found|strong="H7912"\w* \w in him|strong="H5922"\w*. \v 5 \w Finally|strong="H116"\w* \w these|strong="H479"\w* \w men|strong="H1400"\w* \w said|strong="H560"\w*, “\w We will never|strong="H3809"\w* \w find|strong="H7912"\w* \w any|strong="H3606"\w* \w charge|strong="H5931"\w* \w against this|strong="H1836"\w* \w Daniel|strong="H1841"\w* \w unless|strong="H3861"\w* \w we find something|strong="H7912"\w* \w against him|strong="H5922"\w* \w concerning the law|strong="H1882"\w* \w of his God|strong="H426"\w*.”
\p \v 6 \w So|strong="H116"\w* \w the administrators|strong="H5632"\w* \w and satraps|strong="H324"\w* \w went together|strong="H7284"\w* \w to|strong="H5922"\w* \w the king|strong="H4430"\w* \w and said|strong="H560"\w*, “\w O King|strong="H4430"\w* \w Darius|strong="H1868"\w*, \w may you live|strong="H2418"\w* \w forever|strong="H5957"\w*! \v 7 \w All|strong="H3606"\w* \w the royal|strong="H4437"\w* \w administrators|strong="H5632"\w*, \w prefects|strong="H5460"\w*, \w satraps|strong="H324"\w*, \w advisers|strong="H1907"\w*, \w and governors|strong="H6347"\w* \w have agreed|strong="H3272"\w* \w that the king|strong="H4430"\w* \w should establish|strong="H6966"\w* \w an ordinance|strong="H7010"\w* \w and enforce|strong="H8631"\w* \w a decree|strong="H633"\w* \w that|strong="H1768"\w* \w for|strong="H5705"\w* \w thirty|strong="H8533"\w* \w days|strong="H3118"\w* \w anyone|strong="H3606"\w* \w who|strong="H1768"\w* \w petitions|strong="H1156"\w* \w any|strong="H3606"\w* \w god|strong="H426"\w* \w or man|strong="H606"\w* \w except you|strong="H3861"\w*, \w O king|strong="H4430"\w*, \w will be thrown|strong="H7412"\w* \w into the den|strong="H1358"\w* \w of lions|strong="H744"\w*. \v 8 \w Therefore|strong="H3705"\w*, \w O king|strong="H4430"\w*, \w establish|strong="H6966"\w* \w the decree|strong="H633"\w* \w and sign|strong="H7560"\w* \w the document|strong="H3792"\w* \w so that|strong="H1768"\w* \w it cannot|strong="H3809"\w* \w be changed|strong="H8133"\w* — \w in accordance with the law|strong="H1882"\w* \w of the Medes|strong="H4076"\w* \w and Persians|strong="H6540"\w*, \w which|strong="H1768"\w* \w cannot|strong="H3809"\w* \w be repealed|strong="H5709"\w*.”
\p \v 9 \w Therefore|strong="H3606"\w* \w King|strong="H4430"\w* \w Darius|strong="H1868"\w* \w signed|strong="H7560"\w* \w the written|strong="H3792"\w* \w decree|strong="H633"\w*.
\s1 Daniel in the Lions’ Den
\p \v 10 \w Now when|strong="H1768"\w* \w Daniel|strong="H1841"\w* \w learned|strong="H3046"\w* \w that|strong="H1768"\w* \w the document|strong="H3792"\w* \w had been signed|strong="H7560"\w*, \w he went|strong="H5954"\w* \w into his house|strong="H1005"\w*, \w where the windows|strong="H3551"\w* of his \w upper room|strong="H5952"\w* \w opened|strong="H6606"\w* \w toward|strong="H5049"\w* \w Jerusalem|strong="H3390"\w*, \w and three|strong="H8532"\w* \w times|strong="H2166"\w* \w a day|strong="H3118"\w* \w he|strong="H1932"\w* \w got down|strong="H1289"\w* \w on|strong="H5922"\w* \w his knees|strong="H1291"\w*, \w prayed|strong="H6739"\w*, \w and gave thanks|strong="H3029"\w* \w to|strong="H6925"\w* \w his God|strong="H426"\w*, \w just as|strong="H6903"\w* \w he had done|strong="H5648"\w* \w before|strong="H4481"\w*. \v 11 \w Then|strong="H116"\w* \w these|strong="H479"\w* \w men|strong="H1400"\w* \w went as a group|strong="H7284"\w* \w and found|strong="H7912"\w* \w Daniel|strong="H1841"\w* \w petitioning|strong="H1156"\w* \w and imploring|strong="H2604"\w* \w his God|strong="H426"\w*. \v 12 \w So|strong="H116"\w* \w they approached|strong="H7127"\w* \w the king|strong="H4430"\w* \w and asked|strong="H560"\w* \w about|strong="H5922"\w* \w his royal|strong="H4430"\w* \w decree|strong="H633"\w*: “\w Did you not|strong="H3809"\w* \w sign|strong="H7560"\w* \w a decree|strong="H633"\w* \w that|strong="H1768"\w* \w for|strong="H5705"\w* \w thirty|strong="H8533"\w* \w days|strong="H3118"\w* \w any|strong="H3606"\w* \w man|strong="H606"\w* \w who|strong="H1768"\w* \w petitions|strong="H1156"\w* \w any|strong="H3606"\w* \w god|strong="H426"\w* \w or man|strong="H606"\w* \w except you|strong="H3861"\w*, \w O king|strong="H4430"\w*, \w will be thrown|strong="H7412"\w* \w into the den|strong="H1358"\w* \w of lions|strong="H744"\w*?”
\p \w The king|strong="H4430"\w* \w replied|strong="H6032"\w*, “\w According to the law|strong="H1882"\w* \w of the Medes|strong="H4076"\w* \w and Persians|strong="H6540"\w* \w the order|strong="H4406"\w* \w stands|strong="H3330"\w*, \w and it cannot|strong="H3809"\w* \w be repealed|strong="H5709"\w*.”
\p \v 13 \w Then|strong="H116"\w* \w they told|strong="H6032"\w* \w the king|strong="H4430"\w*, “\w Daniel|strong="H1841"\w*, \w one|strong="H1768"\w* \w of|strong="H4481"\w* \w the exiles|strong="H1123"\w* \w from|strong="H1768"\w* \w Judah|strong="H3061"\w*, \w shows no|strong="H3809"\w* \w regard|strong="H7761"\w* \w for you|strong="H5922"\w*, \w O king|strong="H4430"\w*, \w or for|strong="H5922"\w* \w the decree|strong="H633"\w* \w that|strong="H1768"\w* \w you have signed|strong="H7560"\w*. \w He still makes|strong="H1156"\w* \w his petition|strong="H1159"\w* \w three|strong="H8532"\w* \w times|strong="H2166"\w* \w a day|strong="H3118"\w*.”
\p \v 14 \w As soon as|strong="H1768"\w* \w the king|strong="H4430"\w* \w heard|strong="H8086"\w* \w this|strong="H4406"\w*, \w he was deeply|strong="H7690"\w* \w distressed|strong="H888"\w* \w and|strong="H5922"\w* \w set|strong="H7761"\w* \w his mind|strong="H1079"\w* \w on delivering|strong="H7804"\w* \w Daniel|strong="H1841"\w*, \w and he labored|strong="H7712"\w* \w until|strong="H5705"\w* \w sundown|strong="H4606"\w* \w to rescue him|strong="H5338"\w*.
\p \v 15 \w Then|strong="H116"\w* \w the|strong="H479"\w* \w men|strong="H1400"\w* \w approached|strong="H7284"\w* \w the king together|strong="H4430"\w* \w and said|strong="H560"\w* \w to him|strong="H4430"\w*, “\w Remember|strong="H3046"\w*, \w O king|strong="H4430"\w*, \w that|strong="H1768"\w* \w by the law|strong="H1882"\w* \w of the Medes|strong="H4076"\w* \w and Persians|strong="H6540"\w* \w no|strong="H3606"\w* \w decree|strong="H633"\w* \w or ordinance|strong="H7010"\w* \w established|strong="H6966"\w* \w by the king|strong="H4430"\w* \w can be changed|strong="H8133"\w*.”
\p \v 16 \w So|strong="H116"\w* \w the king|strong="H4430"\w* \w gave the order|strong="H560"\w*, \w and they brought|strong="H858"\w* \w Daniel|strong="H1841"\w* \w and threw him|strong="H7412"\w* \w into the den|strong="H1358"\w* \w of|strong="H1768"\w* \w lions|strong="H744"\w*.
\p \w The king|strong="H4430"\w* \w said|strong="H6032"\w* \w to Daniel|strong="H1841"\w*, “\w May your God|strong="H426"\w*, \w whom|strong="H1768"\w* \w you|strong="H607"\w* \w serve|strong="H6399"\w* \w continually|strong="H8411"\w*, \w deliver you|strong="H7804"\w*!”
\p \v 17 \w A|strong="H2298"\w* \w stone|strong="H69"\w* \w was brought|strong="H858"\w* \w and placed|strong="H7761"\w* \w over|strong="H5922"\w* \w the mouth|strong="H6433"\w* \w of the den|strong="H1358"\w*, \w and the king|strong="H4430"\w* \w sealed it|strong="H2857"\w* \w with his own signet ring|strong="H5824"\w* \w and with the rings|strong="H5824"\w* \w of his nobles|strong="H7261"\w*, \w so that|strong="H1768"\w* \w nothing|strong="H3809"\w* \w concerning Daniel|strong="H1841"\w* \w could be changed|strong="H8133"\w*.
