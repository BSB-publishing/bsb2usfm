\s1 Daniel Interprets the Dream
\p \v 24 \w Therefore|strong="H6903"\w* \w Daniel|strong="H1841"\w* \w went|strong="H5954"\w* \w to|strong="H5922"\w* \w Arioch|strong="H746"\w*, \w whom|strong="H1768"\w* \w the king|strong="H4430"\w* \w had appointed|strong="H4483"\w* \w to destroy|strong="H7"\w* \w the wise men|strong="H2445"\w* \w of Babylon|strong="H895"\w*, \w and said|strong="H560"\w* to him, “\w Do not|strong="H409"\w* \w execute|strong="H7"\w* \w the wise men|strong="H2445"\w* \w of Babylon|strong="H895"\w*! \w Bring me|strong="H5954"\w* \w before|strong="H6925"\w* \w the king|strong="H4430"\w*, \w and I will give|strong="H2324"\w* \w him|strong="H4430"\w* \w the interpretation|strong="H6591"\w*.”
\p \v 25 \w Arioch|strong="H746"\w* \w hastily|strong="H927"\w* \w brought|strong="H5954"\w* \w Daniel|strong="H1841"\w* \w before|strong="H6925"\w* \w the king|strong="H4430"\w* \w and said|strong="H560"\w* to him, “\w I have found|strong="H7912"\w* \w a man|strong="H1400"\w* \w among|strong="H4481"\w* \w the exiles|strong="H1123"\w* \w from Judah|strong="H3061"\w* \w who|strong="H1768"\w* \w will tell|strong="H3046"\w* \w the king|strong="H4430"\w* \w the interpretation|strong="H6591"\w*.”
\p \v 26 \w The king|strong="H4430"\w* \w responded|strong="H6032"\w* \w to Daniel|strong="H1841"\w*, \w whose|strong="H1768"\w* \w name|strong="H8036"\w* \w was Belteshazzar|strong="H1096"\w*, “\w Are you able|strong="H3546"\w* \w to tell me|strong="H3046"\w* \w what|strong="H1768"\w* \w I saw|strong="H2370"\w* \w in the dream|strong="H2493"\w*, \w as well as its interpretation|strong="H6591"\w*?”
\p \v 27 \w Daniel|strong="H1841"\w* \w answered|strong="H6032"\w* \w the king|strong="H4430"\w*, “\w No|strong="H3809"\w* \w wise man|strong="H2445"\w*, \w enchanter|strong="H826"\w*, \w medium|strong="H2749"\w*, \w or magician|strong="H1505"\w* \w can|strong="H3202"\w* \w explain|strong="H2324"\w* \w to the king|strong="H4430"\w* \w the mystery|strong="H7328"\w* \w of which|strong="H1768"\w* \w he|strong="H4430"\w* \w inquires|strong="H7593"\w*. \v 28 \w But|strong="H1297"\w* \w there is|strong="H383"\w* \w a God|strong="H426"\w* \w in heaven|strong="H8065"\w* \w who reveals|strong="H1541"\w* \w mysteries|strong="H7328"\w*, \w and He has made known|strong="H3046"\w* \w to King|strong="H4430"\w* \w Nebuchadnezzar|strong="H5020"\w* \w what|strong="H4101"\w* \w will happen|strong="H1934"\w* \w in the latter|strong="H320"\w* \w days|strong="H3118"\w*. \w Your dream|strong="H2493"\w* \w and the visions|strong="H2376"\w* \w that came into your mind|strong="H7217"\w* \w as you lay on|strong="H5922"\w* \w your bed|strong="H4903"\w* \w were these|strong="H1836"\w*:
\p \v 29 \w As you|strong="H607"\w* \w lay on|strong="H5922"\w* \w your bed|strong="H4903"\w*, \w O king|strong="H4430"\w*, \w your thoughts|strong="H7476"\w* \w turned|strong="H5559"\w* \w to|strong="H4101"\w* \w the future|strong="H311"\w*, \w and the Revealer|strong="H1541"\w* \w of Mysteries|strong="H7328"\w* \w made known to you|strong="H3046"\w* \w what|strong="H4101"\w* \w will happen|strong="H1934"\w*. \v 30 \w And to me|strong="H576"\w* \w this|strong="H1836"\w* \w mystery|strong="H7328"\w* \w has been revealed|strong="H1541"\w*, \w not|strong="H3809"\w* \w because|strong="H1768"\w* \w I have|strong="H383"\w* \w more wisdom|strong="H2452"\w* \w than|strong="H4481"\w* \w any man|strong="H3606"\w* \w alive|strong="H2417"\w*, \w but|strong="H3861"\w* \w in order that|strong="H5922"\w* \w the interpretation|strong="H6591"\w* \w might be made known|strong="H3046"\w* \w to the king|strong="H4430"\w*, \w and that you may understand|strong="H3046"\w* \w the thoughts|strong="H7476"\w* \w of your mind|strong="H3825"\w*.
\p \v 31 \w As you|strong="H607"\w*, \w O king|strong="H4430"\w*, \w were watching|strong="H2370"\w*, \w a|strong="H2298"\w* \w great|strong="H7690"\w* \w statue|strong="H6755"\w*\f + \fr 2:31 \ft Or \fqa image\ft ; here and through the rest of Daniel 2\f* \w appeared|strong="H431"\w*. \w A great|strong="H7229"\w* \w and dazzling|strong="H2122"\w* \w statue|strong="H6755"\w* \w stood|strong="H6966"\w* \w before you|strong="H6903"\w*, \w and its form|strong="H7299"\w* \w was awesome|strong="H1763"\w*. \v 32 \w The head|strong="H7217"\w* \w of the statue|strong="H6755"\w* \w was pure|strong="H2869"\w* \w gold|strong="H1722"\w*, \w its chest|strong="H2306"\w* \w and arms|strong="H1872"\w* \w were silver|strong="H3702"\w*, \w its belly|strong="H4577"\w* \w and thighs|strong="H3410"\w* \w were bronze|strong="H5174"\w*, \v 33 \w its legs|strong="H8243"\w* \w were iron|strong="H6523"\w*, \w and its feet|strong="H7271"\w* \w were part|strong="H4481"\w* \w iron|strong="H6523"\w* \w and part|strong="H4481"\w* \w clay|strong="H2635"\w*.
\p \v 34 \w As you|strong="H1934"\w* \w watched|strong="H2370"\w*, \w a stone|strong="H69"\w* \w was cut out|strong="H1505"\w*,\f + \fr 2:34 \ft LXX \fqa cut out from a mountain\f* \w but not|strong="H3809"\w* \w by human hands|strong="H3028"\w*. \w It struck|strong="H4223"\w* \w the statue|strong="H6755"\w* \w on|strong="H5922"\w* \w its feet|strong="H7271"\w* \w of|strong="H1768"\w* \w iron|strong="H6523"\w* \w and clay|strong="H2635"\w*, \w and crushed|strong="H1855"\w* \w them|strong="H1994"\w*. \v 35 \w Then|strong="H116"\w* \w the iron|strong="H6523"\w*, \w clay|strong="H2635"\w*, \w bronze|strong="H5174"\w*, \w silver|strong="H3702"\w*, \w and gold|strong="H1722"\w* \w were shattered|strong="H1855"\w* \w and became|strong="H1934"\w* \w like chaff|strong="H5784"\w* \w on|strong="H4481"\w* \w the threshing floor|strong="H147"\w* \w in summer|strong="H7007"\w*. \w The wind|strong="H7308"\w* \w carried them|strong="H1994"\w* \w away|strong="H5376"\w*, \w and|strong="H3606"\w* \w not|strong="H3809"\w* \w a trace|strong="H870"\w* of them \w could be found|strong="H7912"\w*. \w But the stone|strong="H69"\w* \w that|strong="H1768"\w* \w had struck|strong="H4223"\w* \w the statue|strong="H6755"\w* \w became|strong="H1934"\w* \w a great|strong="H7229"\w* \w mountain|strong="H2906"\w* \w and filled|strong="H4391"\w* \w the whole|strong="H3606"\w* \w earth|strong="H772"\w*.
\p \v 36 \w This|strong="H1836"\w* \w was the dream|strong="H2493"\w*; \w now we will tell|strong="H560"\w* \w the king|strong="H4430"\w* \w its interpretation|strong="H6591"\w*.
\p \v 37 \w You|strong="H607"\w*, \w O king|strong="H4430"\w*, \w are the king|strong="H4430"\w* \w of kings|strong="H4430"\w*, \w to whom|strong="H1768"\w* \w the God|strong="H426"\w* \w of heaven|strong="H8065"\w* \w has given|strong="H3052"\w* \w sovereignty|strong="H4437"\w*, \w power|strong="H2632"\w*, \w strength|strong="H8632"\w*, \w and glory|strong="H3367"\w*. \v 38 \w Wherever|strong="H3606"\w* \w the sons|strong="H1123"\w* \w of men|strong="H606"\w* \w or beasts|strong="H2423"\w* \w of the field|strong="H1251"\w* \w or birds|strong="H5776"\w* \w of the air|strong="H8065"\w* \w dwell|strong="H1753"\w*, \w He has given them|strong="H3052"\w* \w into your hand|strong="H3028"\w* \w and has made you ruler|strong="H7981"\w* \w over them all|strong="H3606"\w*. \w You are|strong="H607"\w* \w that|strong="H1932"\w* \w head|strong="H7217"\w* \w of|strong="H1768"\w* \w gold|strong="H1722"\w*.
\p \v 39 \w But after you|strong="H870"\w*, \w there will arise|strong="H6966"\w* \w another|strong="H317"\w* \w kingdom|strong="H4437"\w*, \w inferior|strong="H772"\w* \w to yours|strong="H4481"\w*.
\p \w Next, a|strong="H317"\w* \w third|strong="H8523"\w* \w kingdom|strong="H4437"\w*, \w one of|strong="H1768"\w* \w bronze|strong="H5174"\w*, \w will rule|strong="H7981"\w* \w the whole|strong="H3606"\w* \w earth|strong="H772"\w*.
\p \v 40 \w Finally, there will be|strong="H1934"\w* \w a fourth|strong="H7244"\w* \w kingdom|strong="H4437"\w* \w as strong|strong="H8624"\w* \w as iron|strong="H6523"\w*; \w for|strong="H6903"\w* \w iron|strong="H6523"\w* \w shatters|strong="H1855"\w* \w and crushes|strong="H2827"\w* \w all things|strong="H3606"\w*, \w and like iron|strong="H6523"\w* \w that|strong="H1768"\w* \w crushes|strong="H7490"\w* \w all things|strong="H3606"\w*, \w it will shatter|strong="H1855"\w* \w and crush|strong="H7490"\w* \w all the others|strong="H459"\w*. \v 41 \w And just as|strong="H1768"\w* \w you saw that|strong="H2370"\w* \w the feet|strong="H7271"\w* \w and toes|strong="H677"\w* \w were made|strong="H4481"\w* \w partly of|strong="H1768"\w* \w fired clay|strong="H2635"\w* \w and partly of|strong="H4481"\w* \w iron|strong="H6523"\w*, \w so this will be|strong="H1934"\w* \w a divided|strong="H6386"\w* \w kingdom|strong="H4437"\w*, \w yet|strong="H4481"\w* \w some of the strength|strong="H5326"\w* \w of|strong="H1768"\w* \w iron|strong="H6523"\w* \w will be in it|strong="H1934"\w* — \w just as|strong="H6903"\w* \w you saw|strong="H2370"\w* \w the iron|strong="H6523"\w* \w mixed|strong="H6151"\w* \w with clay|strong="H2635"\w*. \v 42 \w And as the toes|strong="H677"\w* \w of the feet|strong="H7271"\w* \w were partly|strong="H4481"\w* \w iron|strong="H6523"\w* \w and partly|strong="H4481"\w* \w clay|strong="H2635"\w*, \w so this kingdom|strong="H4437"\w* \w will be|strong="H1934"\w* \w partly|strong="H7118"\w* \w strong|strong="H8624"\w* \w and partly|strong="H4481"\w* \w brittle|strong="H8406"\w*. \v 43 \w As|strong="H1768"\w* \w you saw|strong="H2370"\w* \w the iron|strong="H6523"\w* \w mixed|strong="H6151"\w* \w with clay|strong="H2635"\w*, \w so the peoples|strong="H2234"\w*\f + \fr 2:43 \ft Aramaic \fqa the seed of men\f* \w will mix with one another|strong="H6151"\w* \w but will not|strong="H3809"\w* \w hold together|strong="H1693"\w* \w any more|strong="H1888"\w* \w than|strong="H1768"\w* \w iron|strong="H6523"\w* \w mixes|strong="H6151"\w* \w with|strong="H5974"\w* \w clay|strong="H2635"\w*.
\p \v 44 \w In the days|strong="H3118"\w* \w of those|strong="H581"\w* \w kings|strong="H4430"\w*, \w the God|strong="H426"\w* \w of heaven|strong="H8065"\w* \w will set up|strong="H6966"\w* \w a kingdom|strong="H4437"\w* \w that|strong="H1768"\w* \w will never|strong="H5957"\w* \w be destroyed|strong="H2255"\w*, \w nor will|strong="H3809"\w* \w it|strong="H4437"\w* \w be left|strong="H7662"\w* \w to another|strong="H321"\w* \w people|strong="H5972"\w*. \w It will shatter|strong="H1855"\w* \w all|strong="H3606"\w* \w these|strong="H459"\w* \w kingdoms|strong="H4437"\w* \w and bring them to an end|strong="H5487"\w*, \w but will itself stand|strong="H6966"\w* \w forever|strong="H5957"\w*. \v 45 \w And just as|strong="H3606"\w* \w you saw|strong="H2370"\w* \w a stone|strong="H69"\w* \w being cut out|strong="H1505"\w* \w of the mountain|strong="H2906"\w* \w without|strong="H3809"\w* \w human hands|strong="H3028"\w*, \w and it shattered|strong="H1855"\w* \w the iron|strong="H6523"\w*, \w bronze|strong="H5174"\w*, \w clay|strong="H2635"\w*, \w silver|strong="H3702"\w*, \w and gold|strong="H1722"\w*, \w so the great|strong="H7229"\w* \w God|strong="H426"\w* \w has told|strong="H3046"\w* \w the king|strong="H4430"\w* \w what|strong="H4101"\w* \w will happen|strong="H1934"\w* \w in the future|strong="H311"\w*.
\p \w The dream|strong="H2493"\w* \w is true|strong="H3330"\w*, \w and its interpretation|strong="H6591"\w* \w is trustworthy|strong="H540"\w*.”
\s1 Nebuchadnezzar Promotes Daniel
\p \v 46 \w At this|strong="H116"\w*, \w King|strong="H4430"\w* \w Nebuchadnezzar|strong="H5020"\w* \w fell|strong="H5308"\w* \w on|strong="H5922"\w* \w his face|strong="H600"\w*, \w paid homage|strong="H5457"\w* \w to Daniel|strong="H1841"\w*, \w and ordered|strong="H560"\w* \w that an offering|strong="H4504"\w* \w and incense|strong="H5208"\w* \w be presented|strong="H5260"\w* to him. \v 47 \w The king|strong="H4430"\w* \w said|strong="H6032"\w* \w to Daniel|strong="H1841"\w*, “\w Your God|strong="H426"\w* \w is truly|strong="H4481"\w* \w the God|strong="H426"\w* \w of gods|strong="H426"\w* \w and Lord|strong="H4756"\w* \w of kings|strong="H4430"\w*, \w the Revealer|strong="H1541"\w* \w of Mysteries|strong="H7328"\w*, \w since|strong="H1768"\w* \w you were able|strong="H3202"\w* \w to reveal|strong="H1541"\w* \w this|strong="H1836"\w* \w mystery|strong="H7328"\w*.”
\p \v 48 \w Then|strong="H116"\w* \w the king|strong="H4430"\w* \w promoted|strong="H7236"\w* \w Daniel|strong="H1841"\w* \w and gave|strong="H3052"\w* him \w many|strong="H7690"\w* \w generous|strong="H7260"\w* \w gifts|strong="H4978"\w*. \w He made him ruler|strong="H7981"\w* \w over|strong="H5922"\w* \w the entire|strong="H3606"\w* \w province|strong="H4083"\w* \w of Babylon|strong="H895"\w* \w and chief|strong="H7229"\w* \w administrator|strong="H5460"\w* \w over|strong="H5922"\w* \w all|strong="H3606"\w* \w the wise men|strong="H2445"\w* \w of Babylon|strong="H895"\w*. \v 49 \w And at Daniel’s|strong="H1841"\w* \w request|strong="H1156"\w*, \w the king|strong="H4430"\w* \w appointed|strong="H4483"\w* \w Shadrach|strong="H7715"\w*, \w Meshach|strong="H4336"\w*, \w and Abednego|strong="H5665"\w* \w to|strong="H5922"\w* \w manage|strong="H5673"\w* \w the province|strong="H4083"\w* \w of Babylon|strong="H895"\w*, \w while Daniel|strong="H1841"\w* \w remained in the king’s|strong="H4430"\w* \w court|strong="H8651"\w*.
\c 3
\s1 Nebuchadnezzar’s Golden Statue
\p \v 1 \w King|strong="H4430"\w* \w Nebuchadnezzar|strong="H5020"\w* \w made|strong="H5648"\w* \w a golden|strong="H1722"\w* \w statue|strong="H6755"\w*\f + \fr 3:1 \ft Or \fqa image\ft ; here and throughout Daniel 3\f* \w sixty|strong="H8361"\w* \w cubits|strong="H521"\w* \w high|strong="H7314"\w* \w and six|strong="H8353"\w* \w cubits|strong="H521"\w* \w wide|strong="H6613"\w*,\f + \fr 3:1 \ft The statue was approximately 90 feet high and 9 feet wide (27.4 meters high and 2.7 meters wide).\f* \w and he set it up|strong="H6966"\w* \w on the plain|strong="H1236"\w* \w of Dura|strong="H1757"\w* \w in the province|strong="H4083"\w* \w of Babylon|strong="H895"\w*. \v 2 \w Then King|strong="H4430"\w* \w Nebuchadnezzar|strong="H5020"\w* \w sent|strong="H7972"\w* \w word to assemble|strong="H3673"\w* \w the satraps|strong="H324"\w*, \w prefects|strong="H5460"\w*, \w governors|strong="H6347"\w*, \w advisers|strong="H148"\w*, \w treasurers|strong="H1411"\w*, \w judges|strong="H1884"\w*, \w magistrates|strong="H8614"\w*, \w and all the other|strong="H3606"\w* \w officials|strong="H7984"\w* \w of the provinces|strong="H4083"\w* \w to attend|strong="H858"\w* \w the dedication|strong="H2597"\w* \w of the statue|strong="H6755"\w* \w he|strong="H4430"\w* \w had set up|strong="H6966"\w*.
\p \v 3 \w So|strong="H116"\w* \w the satraps|strong="H324"\w*, \w prefects|strong="H5460"\w*, \w governors|strong="H6347"\w*, \w advisers|strong="H148"\w*, \w treasurers|strong="H1411"\w*, \w judges|strong="H1884"\w*, \w magistrates|strong="H8614"\w*, \w and all|strong="H3606"\w* \w the rulers|strong="H7984"\w* \w of the provinces|strong="H4083"\w* \w assembled|strong="H3673"\w* \w for the dedication|strong="H2597"\w* \w of the statue|strong="H6755"\w* \w that|strong="H1768"\w* \w King|strong="H4430"\w* \w Nebuchadnezzar|strong="H5020"\w* \w had set up|strong="H6966"\w*, \w and they stood|strong="H6966"\w* \w before|strong="H6903"\w* \w it|strong="H6755"\w*.
\p \v 4 \w Then the herald|strong="H3744"\w* \w loudly|strong="H2429"\w* \w proclaimed|strong="H7123"\w*, “\w O people|strong="H5972"\w* \w of every nation|strong="H524"\w* \w and language|strong="H3961"\w*, \w this is what you are commanded|strong="H560"\w*: \v 5 \w As soon as|strong="H5732"\w* \w you hear|strong="H8086"\w* \w the sound|strong="H7032"\w* \w of the horn|strong="H7162"\w*, \w flute|strong="H4953"\w*, \w zither|strong="H7030"\w*, \w lyre|strong="H5443"\w*, \w harp|strong="H6460"\w*, \w pipes|strong="H5481"\w*, \w and all|strong="H3606"\w* \w kinds|strong="H2178"\w* \w of music|strong="H2170"\w*,\f + \fr 3:5 \ft The precise identification of some musical instruments in this chapter is uncertain.\f* \w you must fall down|strong="H5308"\w* \w and worship|strong="H5457"\w* \w the golden|strong="H1722"\w* \w statue that|strong="H6755"\w* \w King|strong="H4430"\w* \w Nebuchadnezzar|strong="H5020"\w* \w has set up|strong="H6966"\w*. \v 6 \w And whoever|strong="H4479"\w* \w does not|strong="H3809"\w* \w fall down|strong="H5308"\w* \w and worship|strong="H5457"\w* \w will immediately|strong="H8160"\w* \w be thrown|strong="H7412"\w* \w into|strong="H1459"\w* \w the blazing|strong="H3345"\w* \w fiery|strong="H5135"\w* \w furnace|strong="H861"\w*.”
\p \v 7 \w Therefore|strong="H1836"\w*, \w as soon as|strong="H1768"\w* \w all|strong="H3606"\w* \w the people|strong="H5972"\w* \w heard|strong="H8086"\w* \w the sound|strong="H7032"\w* \w of the horn|strong="H7162"\w*, \w flute|strong="H4953"\w*, \w zither|strong="H7030"\w*, \w lyre|strong="H5443"\w*, \w harp|strong="H6460"\w*, \w and all|strong="H3606"\w* \w kinds|strong="H2178"\w* \w of music|strong="H2170"\w*, \w the people|strong="H5972"\w* \w of every|strong="H3606"\w* \w nation|strong="H524"\w* \w and language|strong="H3961"\w* \w would fall down|strong="H5308"\w* \w and worship|strong="H5457"\w* \w the golden|strong="H1722"\w* \w statue|strong="H6755"\w* \w that|strong="H1768"\w* \w King|strong="H4430"\w* \w Nebuchadnezzar|strong="H5020"\w* \w had set up|strong="H6966"\w*.
\s1 Shadrach, Meshach, and Abednego Accused
\p \v 8 \w At this time|strong="H1836"\w* \w some astrologers|strong="H3779"\w*\f + \fr 3:8 \ft Or \fqa Chaldeans\f* \w came forward|strong="H7127"\w* \w and maliciously|strong="H399"\w* \w accused|strong="H7170"\w* \w the Jews|strong="H3062"\w*, \v 9 \w saying|strong="H6032"\w* \w to King|strong="H4430"\w* \w Nebuchadnezzar|strong="H5020"\w*, “\w O king|strong="H4430"\w*, \w may you live|strong="H2418"\w* \w forever|strong="H5957"\w*! \v 10 \w You|strong="H607"\w*, \w O king|strong="H4430"\w*, \w have issued|strong="H7761"\w* \w a decree|strong="H2942"\w* \w that|strong="H1768"\w* \w everyone|strong="H3606"\w* \w who|strong="H1768"\w* \w hears|strong="H8086"\w* \w the sound|strong="H7032"\w* \w of the horn|strong="H7162"\w*, \w flute|strong="H4953"\w*, \w zither|strong="H7030"\w*, \w lyre|strong="H5443"\w*, \w harp|strong="H6460"\w*, \w pipes|strong="H5481"\w*, \w and all|strong="H3606"\w* \w kinds|strong="H2178"\w* \w of music|strong="H2170"\w* \w must fall down|strong="H5308"\w* \w and worship|strong="H5457"\w* \w the golden|strong="H1722"\w* \w statue|strong="H6755"\w*, \v 11 \w and that whoever|strong="H4479"\w* \w does not|strong="H3809"\w* \w fall down|strong="H5308"\w* \w and worship|strong="H5457"\w* \w will be thrown|strong="H7412"\w* \w into|strong="H1459"\w* \w the blazing|strong="H3345"\w* \w fiery|strong="H5135"\w* \w furnace|strong="H861"\w*. \v 12 \w But there are|strong="H383"\w* \w some|strong="H1400"\w* \w Jews|strong="H3062"\w* \w you have appointed|strong="H4483"\w* \w to manage|strong="H5922"\w* \w the province|strong="H4083"\w* \w of Babylon|strong="H895"\w* — \w Shadrach|strong="H7715"\w*, \w Meshach|strong="H4336"\w*, \w and Abednego|strong="H5665"\w* — \w who|strong="H479"\w* \w have ignored|strong="H3809"\w* \w you|strong="H2942"\w*, \w O king|strong="H4430"\w*, \w and have refused to|strong="H3809"\w* \w serve|strong="H6399"\w* \w your gods|strong="H426"\w* \w or worship|strong="H5457"\w* \w the golden|strong="H1722"\w* \w statue|strong="H6755"\w* \w you have set up|strong="H6966"\w*.”
