\p \v 28 \w So Daniel|strong="H1841"\w* \w prospered|strong="H6744"\w* \w during the reign|strong="H4437"\w* \w of Darius|strong="H1868"\w* \w and the reign|strong="H4437"\w* \w of Cyrus|strong="H3567"\w*\f + \fr 6:28 \ft Or \fqa prospered during the reign of Darius, that is, the reign of Cyrus\f* \w the Persian|strong="H6543"\w*.
\c 7
\s1 Daniel’s Vision of the Four Beasts
\r (\ref Revelation 13:1–10|REV 13:1-10\ref*)
\p \v 1 \w In the first|strong="H2298"\w* \w year|strong="H8140"\w* \w of the reign|strong="H4430"\w* \w of Belshazzar|strong="H1113"\w* \w over Babylon|strong="H895"\w*, \w Daniel|strong="H1841"\w* \w had|strong="H2370"\w* \w a dream|strong="H2493"\w*, \w and visions|strong="H2376"\w* \w passed through his mind|strong="H7217"\w* \w as he lay|strong="H5922"\w* \w on his bed|strong="H4903"\w*. \w He wrote down|strong="H3790"\w* \w the dream|strong="H2493"\w*, \w and this is the summary|strong="H7217"\w* \w of his account|strong="H4406"\w*.
\p \v 2 \w Daniel|strong="H1841"\w* \w declared|strong="H6032"\w*: “\w In my vision|strong="H2376"\w* \w in|strong="H5974"\w* \w the night|strong="H3916"\w* \w I|strong="H1934"\w* \w looked|strong="H2370"\w*, \w and suddenly|strong="H718"\w* \w the four|strong="H703"\w* \w winds|strong="H7308"\w* \w of heaven|strong="H8065"\w* \w were churning up|strong="H1519"\w* \w the great|strong="H7229"\w* \w sea|strong="H3221"\w*.\f + \fr 7:2 \ft Perhaps \fqa the Great Sea\ft , that is, the Mediterranean Sea\f* \v 3 \w Then four|strong="H703"\w* \w great|strong="H7260"\w* \w beasts|strong="H2423"\w* \w came up|strong="H5559"\w* \w out of|strong="H4481"\w* \w the sea|strong="H3221"\w*, \w each one|strong="H1668"\w* \w different|strong="H8133"\w* \w from|strong="H4481"\w* \w the others|strong="H1668"\w*:
\li1 \v 4 \w The first beast|strong="H6933"\w* \w was like a lion|strong="H744"\w*, and it had \w the wings|strong="H1611"\w* \w of an eagle|strong="H5403"\w*. \w I|strong="H1934"\w* \w watched|strong="H2370"\w* \w until|strong="H5705"\w* \w its wings|strong="H1611"\w* \w were torn off|strong="H4804"\w* \w and it was lifted up|strong="H5191"\w* \w from|strong="H4481"\w* \w the ground|strong="H772"\w* \w and made to stand|strong="H6966"\w* \w on|strong="H5922"\w* \w two feet|strong="H7271"\w* \w like a man|strong="H606"\w* \w and given|strong="H3052"\w* \w the mind|strong="H3825"\w* \w of a man|strong="H606"\w*.
\li1 \v 5 \w Suddenly|strong="H718"\w* \w another|strong="H317"\w* \w beast appeared|strong="H2423"\w*, \w which|strong="H8578"\w* \w looked like|strong="H1821"\w* \w a bear|strong="H1678"\w*. \w It was raised up|strong="H6966"\w* \w on one|strong="H2298"\w* \w of its sides|strong="H7859"\w*, \w and it had three|strong="H8532"\w* \w ribs|strong="H5967"\w* \w in its mouth|strong="H6433"\w* \w between|strong="H997"\w* \w its teeth|strong="H8128"\w*. \w So|strong="H3652"\w* \w it was told|strong="H560"\w*, ‘\w Get up|strong="H6966"\w* \w and gorge yourself|strong="H399"\w* \w on flesh|strong="H1321"\w*!’
\li1 \v 6 \w Next|strong="H870"\w*, \w as I|strong="H1934"\w* \w watched|strong="H2370"\w*, \w suddenly|strong="H718"\w* \w another beast appeared|strong="H317"\w*. \w It was like a leopard|strong="H5245"\w*, \w and on|strong="H5922"\w* \w its back|strong="H1355"\w* it had \w four|strong="H703"\w* \w wings|strong="H1611"\w* \w like those of|strong="H1768"\w* \w a bird|strong="H5776"\w*. \w The beast also|strong="H2423"\w* \w had four|strong="H703"\w* \w heads|strong="H7217"\w*, \w and it was given|strong="H3052"\w* \w authority to rule|strong="H7985"\w*.
\li1 \v 7 \w After|strong="H870"\w* \w this|strong="H1836"\w*, \w as I|strong="H1934"\w* \w watched|strong="H2370"\w* \w in my vision|strong="H2376"\w* \w in the night|strong="H3916"\w*, \w suddenly|strong="H718"\w* \w a fourth|strong="H7244"\w* \w beast appeared|strong="H2423"\w*, \w and it was terrifying|strong="H1763"\w* — \w dreadful|strong="H574"\w* \w and extremely|strong="H3493"\w* \w strong|strong="H8624"\w* — with \w large|strong="H7260"\w* \w iron|strong="H6523"\w* \w teeth|strong="H8128"\w*. \w It devoured|strong="H399"\w* \w and crushed|strong="H1855"\w*; \w then it trampled|strong="H7512"\w* \w underfoot|strong="H7271"\w* \w whatever was left|strong="H7606"\w*. \w It was different|strong="H8133"\w* \w from|strong="H4481"\w* \w all|strong="H3606"\w* \w the beasts|strong="H2423"\w* \w before it|strong="H6925"\w*, \w and it had ten|strong="H6236"\w* \w horns|strong="H7162"\w*. \v 8 \w While I was|strong="H1934"\w* \w contemplating|strong="H7920"\w* \w the horns|strong="H7162"\w*, \w suddenly another|strong="H317"\w* \w horn|strong="H7162"\w*, \w a little one|strong="H2192"\w*, \w came up|strong="H5559"\w* \w among them|strong="H997"\w*, \w and three|strong="H8532"\w* \w of|strong="H4481"\w* \w the first|strong="H6933"\w* \w horns|strong="H7162"\w* \w were uprooted|strong="H6132"\w* \w before|strong="H4481"\w* \w it|strong="H6925"\w*. \w This|strong="H1668"\w* \w horn|strong="H7162"\w* \w had eyes|strong="H5870"\w* \w like those|strong="H5870"\w* \w of a man|strong="H606"\w* \w and a mouth|strong="H6433"\w* \w that spoke|strong="H4449"\w* \w words of arrogance|strong="H7260"\w*.
\s1 Daniel’s Vision of the Ancient of Days
