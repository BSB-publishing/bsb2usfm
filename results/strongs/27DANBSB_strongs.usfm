\q2 \w in the tender grass|strong="H1883"\w* \w of|strong="H1768"\w* \w the field|strong="H1251"\w*.
\b 
\q1 \w Let him be drenched|strong="H6647"\w* \w with the dew|strong="H2920"\w* \w of heaven|strong="H8065"\w*
\q2 \w and graze|strong="H2508"\w* \w with|strong="H5974"\w* \w the beasts|strong="H2423"\w* \w on the grass|strong="H6211"\w* \w of the earth|strong="H772"\w*.
\q1 \v 16 \w Let his mind|strong="H3825"\w* \w be changed|strong="H8133"\w* \w from|strong="H4481"\w* \w that of a man|strong="H606"\w*,
\q2 \w and let him be given|strong="H3052"\w* \w the mind|strong="H3825"\w* \w of a beast|strong="H2423"\w*
\q2 \w till seven|strong="H7655"\w* \w times|strong="H5732"\w* \w pass him|strong="H2499"\w* \w by|strong="H5922"\w*.
\q1 \v 17 \w This decision|strong="H6600"\w* \w is the decree|strong="H1510"\w* \w of the watchers|strong="H5894"\w*,
\q2 \w the verdict|strong="H7595"\w* \w declared|strong="H3983"\w* \w by the holy ones|strong="H6922"\w*,
\q2 \w so that|strong="H5705"\w* \w the living|strong="H2417"\w* \w will know|strong="H3046"\w*
\q1 \w that|strong="H1768"\w* \w the Most High|strong="H5943"\w* \w rules|strong="H7990"\w* \w over the kingdom|strong="H4437"\w* \w of mankind|strong="H606"\w*
\q2 \w and gives it|strong="H5415"\w* \w to whom|strong="H4479"\w* \w He wishes|strong="H6634"\w*,
\q2 \w setting|strong="H6966"\w* \w over it|strong="H5922"\w* \w the lowliest|strong="H8215"\w* \w of men|strong="H606"\w*.’
\p \v 18 \w This|strong="H1836"\w* \w is the dream|strong="H2493"\w* \w that I|strong="H576"\w*, \w King|strong="H4430"\w* \w Nebuchadnezzar|strong="H5020"\w*, \w saw|strong="H2370"\w*. \w Now|strong="H607"\w*, \w Belteshazzar|strong="H1096"\w*, \w tell me|strong="H560"\w* \w the interpretation|strong="H6591"\w*, \w because|strong="H6903"\w* \w none|strong="H3809"\w* \w of the wise men|strong="H2445"\w* \w of my kingdom|strong="H4437"\w* \w can|strong="H3202"\w* \w interpret it|strong="H6591"\w* \w for me|strong="H3046"\w*. \w But you|strong="H607"\w* \w are able|strong="H3546"\w*, \w because|strong="H1768"\w* \w the spirit|strong="H7308"\w* \w of the holy|strong="H6922"\w* \w gods|strong="H426"\w* is in you.”
\s1 Daniel Interprets the Second Dream
\p \v 19 \w For|strong="H116"\w* \w a|strong="H2298"\w* \w time|strong="H8160"\w*, \w Daniel|strong="H1841"\w*, \w who|strong="H1768"\w* \w was also known as|strong="H8036"\w* \w Belteshazzar|strong="H1096"\w*, \w was perplexed|strong="H8075"\w*, \w and his thoughts|strong="H7476"\w* \w alarmed him|strong="H927"\w*.
\p \w So the king|strong="H4430"\w* \w said|strong="H6032"\w*, “\w Belteshazzar|strong="H1096"\w*, \w do not|strong="H409"\w* \w let the dream|strong="H2493"\w* \w or its interpretation|strong="H6591"\w* \w alarm you|strong="H927"\w*.”
\p “\w My lord|strong="H4756"\w*,” \w replied|strong="H6032"\w* \w Belteshazzar|strong="H1096"\w*, “\w may the dream|strong="H2493"\w* \w apply to those who hate you|strong="H8131"\w*, \w and its interpretation|strong="H6591"\w* \w to your enemies|strong="H6146"\w*!
\p \v 20 \w The tree|strong="H363"\w* \w you saw|strong="H2370"\w* \w that|strong="H1768"\w* \w grew large|strong="H7236"\w* \w and strong|strong="H8631"\w*, \w whose top|strong="H7314"\w* \w reached|strong="H4291"\w* \w the sky|strong="H8065"\w* \w and was visible|strong="H2379"\w* \w to all|strong="H3606"\w* \w the earth|strong="H772"\w*, \v 21 \w whose foliage|strong="H6074"\w* \w was beautiful|strong="H8209"\w* \w and whose fruit|strong="H4"\w* \w was abundant|strong="H7690"\w*, \w providing food|strong="H4203"\w* \w for all|strong="H3606"\w*, \w under which|strong="H8460"\w* \w the beasts|strong="H2423"\w* \w of the field|strong="H1251"\w* \w lived|strong="H1753"\w*, \w and in whose branches|strong="H6056"\w* \w the birds|strong="H6853"\w* \w of the air|strong="H8065"\w* \w nested|strong="H7932"\w*— \v 22 \w you|strong="H607"\w*, \w O king|strong="H4430"\w*, \w are that tree|strong="H1932"\w*! \w For you have become great|strong="H7236"\w* \w and strong|strong="H8631"\w*; \w your greatness|strong="H7238"\w* \w has grown|strong="H7236"\w* \w to reach|strong="H4291"\w* \w the sky|strong="H8065"\w*, \w and your dominion|strong="H7985"\w* \w extends to the ends|strong="H5491"\w* \w of the earth|strong="H772"\w*.
\p \v 23 \w And|strong="H1768"\w* \w you, O king|strong="H4430"\w*, \w saw|strong="H2370"\w* \w a watcher|strong="H5894"\w*, \w a holy one|strong="H6922"\w*, \w coming down|strong="H5182"\w* \w from|strong="H4481"\w* \w heaven|strong="H8065"\w* \w and saying|strong="H560"\w*:
