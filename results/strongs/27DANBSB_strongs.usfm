\q2 \w and its height|strong="H7314"\w* \w was great|strong="H7690"\w*.
\q1 \v 11 \w The tree|strong="H363"\w* \w grew large|strong="H7236"\w* \w and strong|strong="H8631"\w*;
\q2 \w its top|strong="H7314"\w* \w reached|strong="H4291"\w* \w the sky|strong="H8065"\w*,
\q1 \w and it was visible|strong="H2379"\w*
\q2 \w to the ends|strong="H5491"\w* \w of the earth|strong="H772"\w*.
\q1 \v 12 \w Its leaves|strong="H6074"\w* \w were beautiful|strong="H8209"\w*,
\q2 \w its fruit|strong="H4"\w* \w was abundant|strong="H7690"\w*,
\q2 and upon it \w was food|strong="H4203"\w* \w for all|strong="H3606"\w*.
