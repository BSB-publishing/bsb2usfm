\c 8
\s1 The Second Plague: Frogs
\p \v 1 \w Then the LORD|strong="H3068"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, “\w Go|strong="H935"\w* \w to|strong="H413"\w* \w Pharaoh|strong="H6547"\w* \w and tell him that|strong="H559"\w* \w this is what|strong="H3541"\w* \w the LORD|strong="H3068"\w* \w says|strong="H559"\w*: ‘\w Let My people|strong="H5971"\w* \w go|strong="H7971"\w*, \w so that they may worship Me|strong="H5647"\w*. \v 2 \w But if|strong="H518"\w* \w you|strong="H859"\w* \w refuse|strong="H3986"\w* \w to let them go|strong="H7971"\w*, \w I|strong="H595"\w* \w will plague|strong="H5062"\w* \w your whole country|strong="H1366"\w* \w with frogs|strong="H6854"\w*. \v 3 \w The Nile|strong="H2975"\w* \w will teem|strong="H8317"\w* \w with frogs|strong="H6854"\w*, \w and they will come|strong="H5927"\w* \w into your palace|strong="H1004"\w* \w and up to your bedroom|strong="H2315"\w* \w and onto|strong="H5921"\w* \w your bed|strong="H4296"\w*, \w into the houses|strong="H1004"\w* \w of your officials|strong="H5650"\w* \w and your people|strong="H5971"\w*, \w and into your ovens|strong="H8574"\w* \w and kneading bowls|strong="H4863"\w*. \v 4 \w The frogs|strong="H6854"\w* \w will come up|strong="H5927"\w* on you \w and your people|strong="H5971"\w* \w and all|strong="H3605"\w* \w your officials|strong="H5650"\w*.’”
\p \v 5 \w And the LORD|strong="H3068"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, “\w Tell|strong="H559"\w* \w Aaron|strong="H175"\w*, ‘\w Stretch out|strong="H5186"\w* \w your hand|strong="H3027"\w* \w with your staff|strong="H4294"\w* \w over|strong="H5921"\w* \w the rivers|strong="H5104"\w* \w and canals|strong="H2975"\w* \w and ponds|strong="H98"\w*, \w and cause the frogs|strong="H6854"\w* \w to come up onto|strong="H5927"\w* \w the land|strong="H776"\w* \w of Egypt|strong="H4714"\w*.’”
