\p \v 30 \w They also made|strong="H6213"\w* \w the plate|strong="H6731"\w* \w of the holy|strong="H6944"\w* \w crown|strong="H5145"\w* \w of pure|strong="H2889"\w* \w gold|strong="H2091"\w*, \w and they engraved|strong="H3789"\w* \w on it|strong="H5921"\w*, \w like an inscription|strong="H4385"\w* \w on a seal|strong="H2368"\w*:
