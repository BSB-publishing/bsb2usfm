\p \v 12 \w Then Moses|strong="H4872"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w the LORD|strong="H3068"\w*, “\w Look|strong="H7200"\w*, \w You|strong="H859"\w* \w have been telling me|strong="H559"\w*, ‘\w Lead|strong="H5927"\w* \w this|strong="H2088"\w* \w people up|strong="H5971"\w*,’ \w but You|strong="H859"\w* \w have not|strong="H3808"\w* \w let me know|strong="H3045"\w* \w whom|strong="H834"\w* \w You will send|strong="H7971"\w* \w with me|strong="H5973"\w*. \w Yet You|strong="H859"\w* \w have said|strong="H559"\w*, ‘\w I know|strong="H3045"\w* \w you by name|strong="H8034"\w*, \w and you have|strong="H1571"\w* \w found|strong="H4672"\w* \w favor|strong="H2580"\w* \w in My sight|strong="H5869"\w*.’ \v 13 \w Now|strong="H6258"\w* \w if|strong="H518"\w* \w indeed|strong="H4994"\w* \w I have found|strong="H4672"\w* \w favor|strong="H2580"\w* \w in Your sight|strong="H5869"\w*, \w please|strong="H4994"\w* \w let me know|strong="H3045"\w* \w Your ways|strong="H1870"\w*, \w that I may know You|strong="H3045"\w* \w and find|strong="H4672"\w* \w favor|strong="H2580"\w* \w in Your sight|strong="H5869"\w*. \w Remember|strong="H7200"\w* \w that|strong="H3588"\w* \w this|strong="H2088"\w* \w nation|strong="H1471"\w* \w is Your people|strong="H5971"\w*.”
