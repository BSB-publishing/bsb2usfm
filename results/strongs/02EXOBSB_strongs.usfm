\p \v 22 \w If|strong="H3588"\w* \w men|strong="H582"\w* \w who are fighting|strong="H5327"\w* \w strike|strong="H5062"\w* \w a pregnant|strong="H2030"\w* \w woman|strong="H802"\w* \w and her child|strong="H3206"\w* \w is born prematurely|strong="H3318"\w*,\f + \fr 21:22 \ft Literally \fqa and her children come out\f* \w but there is|strong="H1961"\w* \w no further|strong="H3808"\w* \w injury|strong="H611"\w*, \w he shall surely be fined|strong="H6064"\w* \w as|strong="H834"\w* \w the woman’s|strong="H802"\w* \w husband|strong="H1167"\w* \w demands|strong="H7896"\w* \w and as the court allows|strong="H5414"\w*. \v 23 \w But if|strong="H518"\w* \w a serious injury|strong="H611"\w* \w results|strong="H1961"\w*, \w then you must require|strong="H5414"\w* \w a life|strong="H5315"\w* \w for|strong="H8478"\w* \w a life|strong="H5315"\w* — \v 24 \w eye|strong="H5869"\w* \w for|strong="H8478"\w* \w eye|strong="H5869"\w*, \w tooth|strong="H8127"\w* \w for|strong="H8478"\w* \w tooth|strong="H8127"\w*,\f + \fr 21:24 \ft Cited in \ref Matthew 5:38|MAT 5:38\ref*\f* \w hand|strong="H3027"\w* \w for|strong="H8478"\w* \w hand|strong="H3027"\w*, \w foot|strong="H7272"\w* \w for|strong="H8478"\w* \w foot|strong="H7272"\w*, \v 25 \w burn|strong="H3555"\w* \w for|strong="H8478"\w* \w burn|strong="H3555"\w*, \w wound|strong="H6482"\w* \w for|strong="H8478"\w* \w wound|strong="H6482"\w*, \w and stripe|strong="H2250"\w* \w for|strong="H8478"\w* \w stripe|strong="H2250"\w*.
\p \v 26 \w If|strong="H3588"\w* \w a man|strong="H376"\w* \w strikes|strong="H5221"\w* \w and blinds|strong="H7843"\w* \w the eye|strong="H5869"\w* \w of his manservant|strong="H5650"\w* \w or|strong="H176"\w* \w maidservant|strong="H519"\w*, \w he must let the servant go|strong="H7971"\w* \w free|strong="H2670"\w* \w as compensation for|strong="H8478"\w* \w the eye|strong="H5869"\w*. \v 27 \w And if|strong="H518"\w* \w he knocks out|strong="H5307"\w* \w the tooth|strong="H8127"\w* \w of his manservant|strong="H5650"\w* \w or|strong="H176"\w* \w maidservant|strong="H519"\w*, \w he must let the servant go|strong="H7971"\w* \w free|strong="H2670"\w* \w as compensation for|strong="H8478"\w* \w the tooth|strong="H8127"\w*.
\p \v 28 \w If|strong="H3588"\w* \w an ox|strong="H7794"\w*\f + \fr 21:28 \ft Or \fqa a bull\ft ; also in verses 29–36\f* \w gores|strong="H5055"\w* \w a man|strong="H376"\w* \w or|strong="H176"\w* \w woman|strong="H802"\w* \w to death|strong="H4191"\w*, \w the ox|strong="H7794"\w* \w must surely be stoned|strong="H5619"\w*, \w and its meat|strong="H1320"\w* \w must not|strong="H3808"\w* \w be eaten|strong="H398"\w*. \w But the owner|strong="H1167"\w* \w of the ox|strong="H7794"\w* \w shall not be held responsible|strong="H5355"\w*.
\p \v 29 \w But if|strong="H518"\w* \w the ox|strong="H7794"\w* \w has a habit|strong="H8543"\w* \w of goring|strong="H5056"\w*, \w and its owner|strong="H1167"\w* \w has been warned|strong="H5749"\w* \w yet does not|strong="H3808"\w* \w restrain it|strong="H8104"\w*, \w and it kills|strong="H4191"\w* \w a man|strong="H376"\w* \w or|strong="H176"\w* \w woman|strong="H802"\w*, \w then the ox|strong="H7794"\w* \w must be stoned|strong="H5619"\w* \w and its owner|strong="H1167"\w* \w must also|strong="H1571"\w* \w be put to death|strong="H4191"\w*. \v 30 \w If|strong="H518"\w* \w payment|strong="H3724"\w* \w is demanded|strong="H7896"\w* \w of him instead|strong="H5921"\w*, \w he may redeem|strong="H6306"\w* \w his life|strong="H5315"\w* \w by paying|strong="H5414"\w* \w the full|strong="H3605"\w* \w amount demanded|strong="H7896"\w* \w of him|strong="H5921"\w*.
\p \v 31 \w If|strong="H176"\w* \w the ox gores|strong="H5055"\w* \w a son|strong="H1121"\w* \w or|strong="H176"\w* \w a daughter|strong="H1323"\w*, \w it shall be done|strong="H6213"\w* to him \w according to the same|strong="H2088"\w* \w rule|strong="H4941"\w*.
\p \v 32 \w If|strong="H518"\w* \w the ox|strong="H7794"\w* \w gores|strong="H5055"\w* \w a manservant|strong="H5650"\w* \w or|strong="H176"\w* \w maidservant|strong="H519"\w*, \w the owner must pay|strong="H5414"\w* \w thirty|strong="H7970"\w* \w shekels|strong="H8255"\w* \w of silver|strong="H3701"\w*\f + \fr 21:32 \fqa \ref 30|0\ref* shekels\ft is \ref approximately 12|12\ref* ounces or 342 grams of silver.\f* \w to the master of that servant|strong="H113"\w*, \w and the ox|strong="H7794"\w* \w must be stoned|strong="H5619"\w*.
\p \v 33 \w If|strong="H3588"\w* \w a man|strong="H376"\w* \w opens|strong="H6605"\w* \w or|strong="H176"\w* \w digs|strong="H3738"\w* \w a pit|strong="H953"\w* \w and fails|strong="H3808"\w* \w to cover it|strong="H3680"\w*, \w and an ox|strong="H7794"\w* \w or|strong="H176"\w* \w a donkey|strong="H2543"\w* \w falls|strong="H5307"\w* \w into it|strong="H8033"\w*, \v 34 \w the owner|strong="H1167"\w* \w of the pit|strong="H953"\w* \w shall make restitution|strong="H7999"\w*; \w he must pay|strong="H7725"\w* \w its owner|strong="H1167"\w*, \w and the dead animal|strong="H4191"\w* \w will be|strong="H1961"\w* his.
\p \v 35 \w If|strong="H3588"\w* \w a man’s|strong="H376"\w* \w ox|strong="H7794"\w* \w injures|strong="H5062"\w* \w his neighbor’s|strong="H7453"\w* \w ox|strong="H7794"\w* \w and it dies|strong="H4191"\w*, \w they must sell|strong="H4376"\w* \w the live|strong="H2416"\w* \w one|strong="H7794"\w* \w and divide|strong="H2673"\w* \w the proceeds|strong="H3701"\w*; \w they also must|strong="H1571"\w* \w divide|strong="H2673"\w* \w the dead animal|strong="H4191"\w*. \v 36 \w But if|strong="H176"\w* \w it was known|strong="H3045"\w* \w that|strong="H3588"\w* \w the ox|strong="H7794"\w* \w had a habit|strong="H8543"\w* \w of goring|strong="H5056"\w*, \w yet its owner|strong="H1167"\w* \w failed|strong="H3808"\w* \w to restrain it|strong="H8104"\w*, \w he shall pay full compensation|strong="H7999"\w*, \w ox|strong="H7794"\w* \w for|strong="H8478"\w* \w ox|strong="H7794"\w*, \w and the dead animal|strong="H4191"\w* \w will be|strong="H1961"\w* his.[’’]
\c 22
\s1 Property Laws
\p \v 1 “\w If|strong="H3588"\w* \w a man|strong="H376"\w* \w steals|strong="H1589"\w* \w an ox|strong="H7794"\w*\f + \fr 22:1 \ft Or \fqa a bull \ft or \fqa a cow\ft ; also in verses 4, 9, and 10\f* \w or|strong="H176"\w* \w a sheep|strong="H7716"\w* \w and slaughters|strong="H2873"\w* \w or|strong="H176"\w* \w sells it|strong="H4376"\w*, \w he must repay|strong="H7999"\w* \w five|strong="H2568"\w* \w oxen|strong="H1241"\w* \w for|strong="H8478"\w* \w an ox|strong="H7794"\w* \w and four|strong="H702"\w* \w sheep|strong="H7716"\w* \w for a sheep|strong="H6629"\w*.
\p \v 2 \w If|strong="H518"\w* \w a thief|strong="H1590"\w* \w is caught|strong="H4672"\w* \w breaking in|strong="H4290"\w* \w and is beaten|strong="H5221"\w* \w to death|strong="H4191"\w*, \w no one|strong="H369"\w* \w shall be guilty of bloodshed|strong="H1818"\w*. \v 3 \w But if|strong="H518"\w* \w it happens after sunrise|strong="H2224"\w*, \w there is guilt for his bloodshed|strong="H1818"\w*.
\p \w A thief must make full restitution|strong="H7999"\w*; \w if|strong="H518"\w* \w he has nothing|strong="H369"\w*, \w he himself shall be sold|strong="H4376"\w* \w for his theft|strong="H1591"\w*. \v 4 \w If what was stolen|strong="H518"\w* \w is actually found|strong="H4672"\w* \w alive|strong="H2416"\w* \w in his possession|strong="H3027"\w*— \w whether ox|strong="H7794"\w* \w or|strong="H5704"\w* \w donkey|strong="H2543"\w* \w or|strong="H5704"\w* \w sheep|strong="H7716"\w*— \w he must pay back|strong="H7999"\w* \w double|strong="H8147"\w*.
\p \v 5 \w If|strong="H3588"\w* \w a man|strong="H376"\w* \w grazes his livestock|strong="H1197"\w* \w in a field|strong="H7704"\w* \w or|strong="H176"\w* \w vineyard|strong="H3754"\w* \w and allows them|strong="H1165"\w* \w to stray|strong="H7971"\w* \w so that they graze|strong="H1197"\w* \w in someone else’s|strong="H312"\w* \w field|strong="H7704"\w*, \w he must make restitution|strong="H7999"\w* \w from the best|strong="H4315"\w* \w of his own field|strong="H7704"\w* \w or vineyard|strong="H3754"\w*.
\p \v 6 \w If|strong="H3588"\w* \w a fire|strong="H784"\w* \w breaks out|strong="H3318"\w* \w and spreads|strong="H4672"\w* \w to thornbushes|strong="H6975"\w* \w so that it consumes|strong="H398"\w* \w stacked|strong="H1430"\w* \w or|strong="H176"\w* \w standing grain|strong="H7054"\w*, \w or|strong="H176"\w* \w the whole field|strong="H7704"\w*, \w the one who started|strong="H1197"\w* \w the fire|strong="H1200"\w* \w must make full restitution|strong="H7999"\w*.
\p \v 7 \w If|strong="H3588"\w* \w a man|strong="H376"\w* \w gives|strong="H5414"\w* \w his neighbor|strong="H7453"\w* \w money|strong="H3701"\w* \w or|strong="H176"\w* \w goods|strong="H3627"\w* \w for safekeeping|strong="H8104"\w* \w and they are stolen|strong="H1589"\w* \w from the neighbor’s|strong="H376"\w* \w house|strong="H1004"\w*, \w the thief|strong="H1590"\w*, \w if|strong="H518"\w* \w caught|strong="H4672"\w*, \w must pay back|strong="H7999"\w* \w double|strong="H8147"\w*. \v 8 \w If|strong="H518"\w* \w the thief|strong="H1590"\w* \w is not|strong="H3808"\w* \w found|strong="H4672"\w*, \w the owner|strong="H1167"\w* \w of the house|strong="H1004"\w* \w must appear|strong="H7126"\w* \w before|strong="H413"\w* \w the judges|strong="H430"\w*\f + \fr 22:8 \ft Or \fqa before God\ft ; also in verse 9\f* \w to determine whether|strong="H518"\w* \w he has taken|strong="H7971"\w* \w his neighbor’s|strong="H7453"\w* \w property|strong="H4399"\w*.
\p \v 9 \w In|strong="H5921"\w* \w all|strong="H3605"\w* \w cases|strong="H1697"\w* \w of illegal possession|strong="H6588"\w* \w of|strong="H5921"\w* \w an ox|strong="H7794"\w*, \w a donkey|strong="H2543"\w*, \w a sheep|strong="H7716"\w*, \w a garment|strong="H8008"\w*, \w or any|strong="H3605"\w* \w lost item|strong="H9"\w* \w that|strong="H834"\w* \w someone claims|strong="H559"\w*, ‘\w This|strong="H2088"\w* \w is mine|strong="H1931"\w*,’ \w both parties|strong="H8147"\w* \w shall bring|strong="H935"\w* \w their cases|strong="H1697"\w* \w before|strong="H5704"\w* \w the judges|strong="H430"\w*. \w The one whom the judges|strong="H430"\w* \w find guilty|strong="H7561"\w*\f + \fr 22:9 \ft Or \fqa whom God condemns\f* \w must pay back|strong="H7999"\w* \w double|strong="H8147"\w* \w to his neighbor|strong="H7453"\w*.
\p \v 10 \w If|strong="H3588"\w* \w a man|strong="H376"\w* \w gives|strong="H5414"\w* \w a donkey|strong="H2543"\w*, \w an ox|strong="H7794"\w*, \w a sheep|strong="H7716"\w*, \w or any|strong="H3605"\w* \w other animal|strong="H929"\w* \w to be cared for|strong="H8104"\w* \w by his neighbor|strong="H7453"\w*, \w but it dies|strong="H4191"\w* \w or|strong="H176"\w* \w is injured|strong="H7665"\w* \w or|strong="H176"\w* \w stolen|strong="H7617"\w* \w while no|strong="H369"\w* \w one is watching|strong="H7200"\w*, \v 11 \w an oath|strong="H7621"\w* \w before the LORD|strong="H3068"\w* \w shall be made|strong="H1961"\w* \w between|strong="H996"\w* \w the parties|strong="H8147"\w* \w to determine whether|strong="H518"\w* \w or not|strong="H3808"\w* \w the man has taken|strong="H7971"\w* \w his neighbor’s|strong="H7453"\w* \w property|strong="H4399"\w*. \w The owner|strong="H1167"\w* \w must accept the oath|strong="H3947"\w* \w and require no|strong="H3808"\w* \w restitution|strong="H7999"\w*.
\p \v 12 \w But if|strong="H518"\w* \w the animal was actually|strong="H1589"\w* \w stolen|strong="H1589"\w* \w from the neighbor|strong="H5973"\w*, \w he must make restitution|strong="H7999"\w* \w to the owner|strong="H1167"\w*.
\p \v 13 \w If|strong="H518"\w* \w the animal was torn to pieces|strong="H2963"\w*, \w he shall bring|strong="H935"\w* \w it as evidence|strong="H5707"\w*; \w he need not|strong="H3808"\w* \w make restitution|strong="H7999"\w* \w for the torn carcass|strong="H2966"\w*.
\p \v 14 \w If|strong="H3588"\w* \w a man|strong="H376"\w* \w borrows|strong="H7592"\w* \w an animal|strong="H5973"\w* \w from his neighbor|strong="H7453"\w* \w and it is injured|strong="H7665"\w* \w or|strong="H176"\w* \w dies|strong="H4191"\w* \w while its owner|strong="H1167"\w* \w is not|strong="H369"\w* \w present|strong="H5973"\w*, \w he must make full restitution|strong="H7999"\w*. \v 15 \w If|strong="H518"\w* \w the owner|strong="H1167"\w* \w was present|strong="H5973"\w*, \w no|strong="H3808"\w* \w restitution is required|strong="H7999"\w*. \w If|strong="H518"\w* \w the animal|strong="H1931"\w* \w was rented|strong="H7916"\w*, \w the fee covers the loss|strong="H7939"\w*.
\s1 Laws of Social Responsibility
\p \v 16 \w If|strong="H3588"\w* \w a man|strong="H376"\w* \w seduces|strong="H6601"\w* \w a virgin|strong="H1330"\w* \w who|strong="H834"\w* \w is not|strong="H3808"\w* \w pledged in marriage|strong="H781"\w* \w and sleeps|strong="H7901"\w* \w with her|strong="H5973"\w*, \w he must pay the full dowry|strong="H4117"\w* for her \w to be his wife|strong="H802"\w*. \v 17 \w If|strong="H518"\w* \w her father|strong="H1"\w* \w absolutely refuses|strong="H3985"\w* \w to give her|strong="H5414"\w* to him, \w the man still must pay|strong="H8254"\w* \w an amount comparable|strong="H3701"\w* \w to the bridal price|strong="H4119"\w* \w of a virgin|strong="H1330"\w*.
\p \v 18 \w You must not|strong="H3808"\w* \w allow a sorceress|strong="H3784"\w* \w to live|strong="H2421"\w*.
\p \v 19 \w Whoever|strong="H3605"\w* \w lies|strong="H7901"\w* \w with|strong="H5973"\w* \w an animal|strong="H929"\w* \w must surely be put to death|strong="H4191"\w*.
\p \v 20 \w If anyone sacrifices|strong="H2076"\w* \w to any god|strong="H430"\w* \w other than|strong="H1115"\w* \w the LORD|strong="H3068"\w* \w alone|strong="H905"\w*, \w he must be set apart for destruction|strong="H2763"\w*.\f + \fr 22:20 \ft Forms of the Hebrew \fqa cherem \ft refer to the giving over of things or persons to the LORD, either by destroying them or by giving them as an offering.\f*
\p \v 21 \w You must not|strong="H3808"\w* \w exploit|strong="H3238"\w* \w or|strong="H3808"\w* \w oppress|strong="H3905"\w* \w a foreign resident|strong="H1616"\w*, \w for|strong="H3588"\w* \w you yourselves were|strong="H1961"\w* \w foreigners|strong="H1616"\w* \w in the land|strong="H776"\w* \w of Egypt|strong="H4714"\w*.
\p \v 22 \w You must not|strong="H3808"\w* \w mistreat|strong="H6031"\w* \w any|strong="H3605"\w* \w widow|strong="H490"\w* \w or orphan|strong="H3490"\w*. \v 23 \w If|strong="H518"\w* \w you do mistreat them|strong="H6031"\w*, \w and they cry out|strong="H6817"\w* \w to Me|strong="H413"\w* \w in distress|strong="H6817"\w*, \w I will surely hear|strong="H8085"\w* \w their cry|strong="H6818"\w*. \v 24 \w My anger|strong="H639"\w* \w will be kindled|strong="H2734"\w*, \w and I will kill|strong="H2026"\w* \w you|strong="H853"\w* \w with the sword|strong="H2719"\w*; \w then your wives|strong="H802"\w* \w will become|strong="H1961"\w* \w widows|strong="H490"\w* \w and your children|strong="H1121"\w* \w will be fatherless|strong="H3490"\w*.
\p \v 25 \w If|strong="H518"\w* \w you lend|strong="H3867"\w* \w money|strong="H3701"\w* \w to one of My people|strong="H5971"\w* \w among you|strong="H5973"\w* \w who is poor|strong="H6041"\w*, \w you must not|strong="H3808"\w* \w act|strong="H1961"\w* \w as a creditor|strong="H5383"\w* to him; \w you are not to charge|strong="H7760"\w* \w him|strong="H5921"\w* \w interest|strong="H5392"\w*.
\p \v 26 \w If|strong="H518"\w* \w you take your neighbor’s|strong="H7453"\w* \w cloak|strong="H8008"\w* \w as collateral|strong="H2254"\w*, \w return it|strong="H7725"\w* to him \w by|strong="H5704"\w* \w sunset|strong="H935"\w*, \v 27 \w because|strong="H3588"\w* \w his cloak|strong="H1931"\w* \w is the only|strong="H905"\w* \w covering|strong="H3682"\w* \w he has|strong="H1931"\w* \w for|strong="H8071"\w* \w his body|strong="H5785"\w*. \w What else|strong="H4100"\w* \w will he sleep in|strong="H7901"\w*? \w And if|strong="H3588"\w* \w he cries out|strong="H6817"\w* \w to Me|strong="H413"\w*, \w I will hear|strong="H8085"\w*, \w for|strong="H3588"\w* \w I|strong="H589"\w* \w am compassionate|strong="H2587"\w*.
\p \v 28 \w You must not|strong="H3808"\w* \w blaspheme|strong="H7043"\w* \w God|strong="H430"\w* \w or curse|strong="H779"\w* \w the ruler|strong="H5387"\w* \w of your people|strong="H5971"\w*.\f + \fr 22:28 \ft LXX \fqa or speak evil about the ruler of your people\ft ; cited in \ref Acts 23:5|ACT 23:5\ref*\f*
\p \v 29 \w You must not|strong="H3808"\w* \w hold back|strong="H309"\w* \w offerings from your granaries|strong="H4395"\w* \w or vats|strong="H1831"\w*. \w You are to give|strong="H5414"\w* Me \w the firstborn|strong="H1060"\w* \w of your sons|strong="H1121"\w*. \v 30 \w You shall do|strong="H6213"\w* \w likewise|strong="H3651"\w* \w with your cattle|strong="H7794"\w* \w and your sheep|strong="H6629"\w*. \w Let them stay|strong="H1961"\w* \w with|strong="H5973"\w* \w their mothers|strong="H517"\w* \w for seven|strong="H7651"\w* \w days|strong="H3117"\w*, \w but on the eighth|strong="H8066"\w* \w day|strong="H3117"\w* \w you are to give them|strong="H5414"\w* to Me.
\p \v 31 \w You are to be|strong="H1961"\w* My \w holy|strong="H6944"\w* \w people|strong="H376"\w*. \w You must not|strong="H3808"\w* \w eat|strong="H398"\w* \w the meat|strong="H1320"\w* \w of a mauled animal|strong="H2966"\w* \w found in the field|strong="H7704"\w*; \w you are to throw|strong="H7993"\w* \w it|strong="H853"\w* \w to the dogs|strong="H3611"\w*.[’’]
\c 23
\s1 Justice and Mercy
\p \v 1 “\w You shall not|strong="H3808"\w* \w spread|strong="H5375"\w* \w a false|strong="H7723"\w* \w report|strong="H8088"\w*. \w Do not|strong="H408"\w* \w join|strong="H7896"\w* \w the wicked|strong="H7563"\w* \w by being|strong="H1961"\w* \w a malicious|strong="H2555"\w* \w witness|strong="H5707"\w*.
\p \v 2 \w You shall not|strong="H3808"\w* \w follow|strong="H1961"\w* \w the crowd|strong="H7227"\w* \w in wrongdoing|strong="H7451"\w*. \w When you testify|strong="H6030"\w* \w in|strong="H5921"\w* \w a lawsuit|strong="H7379"\w*, \w do not|strong="H3808"\w* \w pervert justice|strong="H5186"\w* \w by siding|strong="H5186"\w* \w with|strong="H310"\w* \w the crowd|strong="H7227"\w*. \v 3 \w And do not|strong="H3808"\w* \w show favoritism|strong="H1921"\w* \w to a poor man|strong="H1800"\w* \w in his lawsuit|strong="H7379"\w*.
\p \v 4 \w If|strong="H3588"\w* \w you encounter|strong="H6293"\w* \w your enemy’s|strong="H341"\w* \w stray|strong="H8582"\w* \w ox|strong="H7794"\w* \w or|strong="H176"\w* \w donkey|strong="H2543"\w*, \w you must return it|strong="H7725"\w* to him.
\p \v 5 \w If|strong="H3588"\w* \w you see|strong="H7200"\w* \w the donkey|strong="H2543"\w* \w of one who hates you|strong="H8130"\w* \w fallen|strong="H7257"\w* \w under|strong="H8478"\w* \w its load|strong="H4853"\w*, \w do not|strong="H2308"\w* \w leave|strong="H5800"\w* it there; \w you must help him|strong="H5800"\w* \w with it|strong="H5973"\w*.
\p \v 6 \w You shall not|strong="H3808"\w* \w deny|strong="H5186"\w* \w justice|strong="H4941"\w* \w to the poor|strong="H34"\w* \w in their lawsuits|strong="H7379"\w*. \v 7 \w Stay far away|strong="H7368"\w* \w from a false|strong="H8267"\w* \w accusation|strong="H1697"\w*. \w Do not|strong="H408"\w* \w kill|strong="H2026"\w* \w the innocent|strong="H5355"\w* \w or the just|strong="H6662"\w*, \w for|strong="H3588"\w* \w I will not|strong="H3808"\w* \w acquit|strong="H6663"\w* \w the guilty|strong="H7563"\w*.
\p \v 8 \w Do not|strong="H3808"\w* \w accept|strong="H3947"\w* \w a bribe|strong="H7810"\w*, \w for|strong="H3588"\w* \w a bribe|strong="H7810"\w* \w blinds|strong="H5786"\w* \w those who see|strong="H6493"\w* \w and twists|strong="H5557"\w* \w the words|strong="H1697"\w* \w of the righteous|strong="H6662"\w*.
\p \v 9 \w Do not|strong="H3808"\w* \w oppress|strong="H3905"\w* \w a foreign resident|strong="H1616"\w*, \w since you|strong="H859"\w* \w yourselves know|strong="H3045"\w* \w how it feels to be foreigners|strong="H1616"\w*; \w for|strong="H3588"\w* \w you were|strong="H1961"\w* \w foreigners|strong="H1616"\w* \w in the land|strong="H776"\w* \w of Egypt|strong="H4714"\w*.
\s1 Sabbath Laws
\r (\ref Leviticus 25:1–7|LEV 25:1-7\ref*; \ref Deuteronomy 15:1–6|DEU 15:1-6\ref*)
\p \v 10 \w For six|strong="H8337"\w* \w years|strong="H8141"\w* \w you are to sow|strong="H2232"\w* \w your land|strong="H776"\w* \w and gather|strong="H622"\w* \w its produce|strong="H8393"\w*, \v 11 \w but in the seventh year|strong="H7637"\w* \w you must let it rest|strong="H8058"\w* \w and lie fallow|strong="H5203"\w*, \w so that the poor|strong="H34"\w* \w among your people|strong="H5971"\w* \w may eat|strong="H398"\w* \w from the field|strong="H7704"\w* \w and the wild animals|strong="H2416"\w* \w may consume|strong="H398"\w* \w what they leave|strong="H3499"\w*. \w Do|strong="H6213"\w* \w the same|strong="H3651"\w* \w with your vineyard|strong="H3754"\w* \w and olive grove|strong="H2132"\w*.
