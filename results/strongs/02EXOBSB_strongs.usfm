\c 20
\s1 The Ten Commandments
\r (\ref Deuteronomy 5:6–21|DEU 5:6-21\ref*)
\p \v 1 \w And God|strong="H430"\w* \w spoke|strong="H1696"\w* \w all|strong="H3605"\w* \w these|strong="H428"\w* \w words|strong="H1697"\w*:
\p \v 2 “\w I|strong="H595"\w* \w am the LORD|strong="H3068"\w* \w your God|strong="H430"\w*, \w who|strong="H834"\w* \w brought you out|strong="H3318"\w* \w of the land|strong="H776"\w* \w of Egypt|strong="H4714"\w*, \w out of the house|strong="H1004"\w* \w of slavery|strong="H5650"\w*.
