\c 40
\s1 Setting Up the Tabernacle
\r (\ref Acts 7:44–47|ACT 7:44-47\ref*; \ref Hebrews 9:1–10|HEB 9:1-10\ref*)
\p \v 1 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 2 “\w On the first|strong="H259"\w* \w day|strong="H3117"\w* \w of the first|strong="H7223"\w* \w month|strong="H2320"\w* \w you are to set up|strong="H6965"\w* \w the tabernacle|strong="H4908"\w*, \w the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \v 3 \w Put|strong="H7760"\w* \w the ark|strong="H727"\w* \w of the Testimony|strong="H5715"\w*\f + \fr 40:3 \ft That is, \fqa the ark of the covenant\ft ; also in verses 5 and 21\f* \w in it|strong="H8033"\w* \w and screen|strong="H5526"\w* \w off|strong="H5921"\w* \w the ark|strong="H727"\w* \w with the veil|strong="H6532"\w*. \v 4 \w Then bring in|strong="H935"\w* \w the table|strong="H7979"\w* \w and set out|strong="H6186"\w* \w its arrangement|strong="H6187"\w*; \w bring in|strong="H935"\w* \w the lampstand as well|strong="H4501"\w*, \w and set up|strong="H5927"\w* \w its lamps|strong="H5216"\w*.
\p \v 5 \w Place|strong="H5414"\w* \w the gold|strong="H2091"\w* \w altar|strong="H4196"\w* \w of incense|strong="H7004"\w* \w in front|strong="H6440"\w* \w of the ark|strong="H727"\w* \w of the Testimony|strong="H5715"\w*, \w and hang|strong="H7760"\w* \w the curtain|strong="H4539"\w* \w at the entrance|strong="H6607"\w* \w to the tabernacle|strong="H4908"\w*. \v 6 \w Place|strong="H5414"\w* \w the altar|strong="H4196"\w* \w of burnt offering|strong="H5930"\w* \w in front|strong="H6440"\w* \w of the entrance|strong="H6607"\w* \w to the tabernacle|strong="H4908"\w*, \w the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \v 7 \w And place|strong="H5414"\w* \w the basin|strong="H3595"\w* \w between|strong="H996"\w* \w the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w* \w and the altar|strong="H4196"\w*, \w and put|strong="H5414"\w* \w water in it|strong="H4325"\w*.
\p \v 8 \w Set up|strong="H7760"\w* \w the surrounding|strong="H5439"\w* \w courtyard|strong="H2691"\w* \w and hang|strong="H5414"\w* \w the curtain|strong="H4539"\w* \w for the entrance|strong="H8179"\w* \w to the courtyard|strong="H2691"\w*.
\p \v 9 \w Take|strong="H3947"\w* \w the anointing|strong="H4888"\w* \w oil|strong="H8081"\w* \w and anoint|strong="H4886"\w* \w the tabernacle|strong="H4908"\w* \w and everything|strong="H3605"\w* in it; \w consecrate|strong="H6942"\w* \w it|strong="H853"\w* \w along with|strong="H853"\w* \w all|strong="H3605"\w* \w its furnishings|strong="H3627"\w*, \w and it shall be|strong="H1961"\w* \w holy|strong="H6944"\w*. \v 10 \w Anoint|strong="H4886"\w* \w the altar|strong="H4196"\w* \w of burnt offering|strong="H5930"\w* \w and all|strong="H3605"\w* \w its utensils|strong="H3627"\w*; \w consecrate|strong="H6942"\w* \w the altar|strong="H4196"\w*, \w and it shall be|strong="H1961"\w* \w most|strong="H6944"\w* \w holy|strong="H6944"\w*. \v 11 \w Anoint|strong="H4886"\w* \w the basin|strong="H3595"\w* \w and its stand|strong="H3653"\w* \w and consecrate them|strong="H6942"\w*.
\p \v 12 \w Then bring|strong="H7126"\w* \w Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w* \w to|strong="H413"\w* \w the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w* \w and wash|strong="H7364"\w* \w them|strong="H853"\w* \w with water|strong="H4325"\w*. \v 13 \w And you are to clothe|strong="H3847"\w* \w Aaron|strong="H175"\w* \w with the holy|strong="H6944"\w* \w garments|strong="H899"\w*, \w anoint him|strong="H4886"\w*, \w and consecrate him|strong="H6942"\w*, \w so that he may serve Me as a priest|strong="H3547"\w*. \v 14 \w Bring his sons|strong="H1121"\w* \w forward|strong="H7126"\w* \w and clothe|strong="H3847"\w* \w them|strong="H853"\w* \w with tunics|strong="H3801"\w*. \v 15 \w Anoint|strong="H4886"\w* \w them|strong="H853"\w* \w just as|strong="H834"\w* \w you anointed|strong="H4886"\w* \w their father|strong="H1"\w*, \w so that they may also serve Me as priests|strong="H3547"\w*. \w Their anointing|strong="H4888"\w* \w will qualify|strong="H1961"\w* them \w for a permanent|strong="H5769"\w* \w priesthood|strong="H3550"\w* \w throughout their generations|strong="H1755"\w*.”
