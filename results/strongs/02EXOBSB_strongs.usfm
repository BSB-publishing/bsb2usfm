\c 7
\s1 God Commands Moses and Aaron
\p \v 1 \w The LORD|strong="H3068"\w* \w answered|strong="H559"\w* \w Moses|strong="H4872"\w*, “\w See|strong="H7200"\w*, \w I have made|strong="H5414"\w* \w you like God|strong="H430"\w* \w to Pharaoh|strong="H6547"\w*, \w and your brother|strong="H251"\w* \w Aaron|strong="H175"\w* \w will be|strong="H1961"\w* \w your prophet|strong="H5030"\w*. \v 2 \w You|strong="H859"\w* \w are to speak|strong="H1696"\w* \w all|strong="H3605"\w* \w that|strong="H834"\w* \w I command you|strong="H6680"\w*, \w and your brother|strong="H251"\w* \w Aaron|strong="H175"\w* \w is to tell|strong="H1696"\w* \w Pharaoh|strong="H6547"\w* \w to let the Israelites|strong="H1121"\w* \w go|strong="H7971"\w* \w out of his land|strong="H776"\w*.
