\s1 The Ten Curtains for the Tabernacle
\r (\ref Exodus 26:1–6|EXO 26:1-6\ref*)
\p \v 8 \w All|strong="H3605"\w* \w the skilled craftsmen|strong="H2450"\w* \w among the workmen|strong="H6213"\w* \w made|strong="H6213"\w* \w the ten|strong="H6235"\w* \w curtains|strong="H3407"\w* \w for the tabernacle|strong="H4908"\w*. \w They were made|strong="H6213"\w* \w of finely spun|strong="H7806"\w* \w linen|strong="H8336"\w*, \w as well as blue|strong="H8504"\w*, \w purple|strong="H713"\w*, \w and scarlet yarn|strong="H8438"\w*, \w with cherubim|strong="H3742"\w* \w skillfully|strong="H2803"\w* \w worked into them|strong="H4639"\w*. \v 9 \w Each|strong="H259"\w* \w curtain|strong="H3407"\w* \w was twenty-eight|strong="H8083"\w* \w cubits|strong="H520"\w* \w long|strong="H753"\w* \w and four|strong="H702"\w* \w cubits|strong="H520"\w* \w wide|strong="H7341"\w*;\f + \fr 36:9 \ft Each of the ten curtains was \ref approximately 42|42\ref* feet long and 6 feet wide (12.8 meters long and 1.8 meters wide).\f* \w all|strong="H3605"\w* \w the curtains|strong="H3407"\w* \w were the same|strong="H259"\w* \w size|strong="H4060"\w*. \v 10 \w And he joined|strong="H2266"\w* \w five|strong="H2568"\w* \w of the curtains|strong="H3407"\w* \w together|strong="H413"\w*, \w and the other five|strong="H2568"\w* \w he joined|strong="H2266"\w* \w as well|strong="H413"\w*.
\p \v 11 \w He made|strong="H6213"\w* \w loops|strong="H3924"\w* \w of blue material|strong="H8504"\w* \w on|strong="H5921"\w* \w the edge|strong="H8193"\w* \w of the end|strong="H7098"\w* \w curtain|strong="H3407"\w* \w in the first|strong="H259"\w* \w set|strong="H4225"\w*, \w and also|strong="H6213"\w* \w on the end|strong="H7020"\w* \w curtain|strong="H3407"\w* \w in the second|strong="H8145"\w* \w set|strong="H4225"\w*. \v 12 \w He made|strong="H6213"\w* \w fifty|strong="H2572"\w* \w loops|strong="H3924"\w* \w on one|strong="H259"\w* \w curtain|strong="H3407"\w* \w and fifty|strong="H2572"\w* \w loops|strong="H3924"\w* \w on the end|strong="H7097"\w* \w curtain|strong="H3407"\w* \w of the second|strong="H8145"\w* \w set|strong="H4225"\w*, \w so that the loops|strong="H3924"\w* \w lined up|strong="H6901"\w* \w opposite|strong="H413"\w* \w one|strong="H259"\w* \w another|strong="H259"\w*. \v 13 \w He also made|strong="H6213"\w* \w fifty|strong="H2572"\w* \w gold|strong="H2091"\w* \w clasps|strong="H7165"\w* \w to join|strong="H2266"\w* \w the curtains|strong="H3407"\w* \w together|strong="H413"\w*, \w so that the tabernacle|strong="H4908"\w* \w was|strong="H1961"\w* \w a unit|strong="H259"\w*.
\s1 The Eleven Curtains of Goat Hair
\r (\ref Exodus 26:7–14|EXO 26:7-14\ref*)
\p \v 14 \w He then made|strong="H6213"\w* \w curtains|strong="H3407"\w* \w of goat hair|strong="H5795"\w* \w for the tent|strong="H168"\w* \w over|strong="H5921"\w* \w the tabernacle|strong="H4908"\w* — \w eleven|strong="H6249"\w* \w curtains|strong="H3407"\w* \w in all|strong="H6213"\w*. \v 15 \w Each|strong="H259"\w* \w of the eleven|strong="H6249"\w* \w curtains|strong="H3407"\w* \w was the same|strong="H259"\w* \w size|strong="H4060"\w* — \w thirty|strong="H7970"\w* \w cubits|strong="H520"\w* \w long|strong="H753"\w* \w and four|strong="H702"\w* \w cubits|strong="H520"\w* \w wide|strong="H7341"\w*.\f + \fr 36:15 \ft Each of the eleven curtains was \ref approximately 45|45\ref* feet long and 6 feet wide (13.7 meters long and 1.8 meters wide).\f* \v 16 \w He joined|strong="H2266"\w* \w five|strong="H2568"\w* \w of the curtains|strong="H3407"\w* \w into one set|strong="H905"\w* \w and the other|strong="H3407"\w* \w six|strong="H8337"\w* \w into another|strong="H905"\w*. \v 17 \w He made|strong="H6213"\w* \w fifty|strong="H2572"\w* \w loops|strong="H3924"\w* \w along|strong="H5921"\w* \w the edge|strong="H8193"\w* \w of the end|strong="H7020"\w* \w curtain|strong="H3407"\w* \w in the first set|strong="H4225"\w*, \w and fifty|strong="H2572"\w* \w loops|strong="H3924"\w* \w along|strong="H5921"\w* \w the edge|strong="H8193"\w* \w of the corresponding curtain|strong="H3407"\w* \w in the second|strong="H8145"\w* \w set|strong="H2279"\w*. \v 18 \w He also made|strong="H6213"\w* \w fifty|strong="H2572"\w* \w bronze|strong="H5178"\w* \w clasps|strong="H7165"\w* \w to join the tent|strong="H168"\w* \w together|strong="H2266"\w* \w as a unit|strong="H259"\w*.
\p \v 19 \w Additionally, he made|strong="H6213"\w* \w for the tent|strong="H168"\w* \w a covering|strong="H4372"\w* \w of ram|strong="H352"\w* \w skins|strong="H5785"\w* \w dyed red|strong="H119"\w*, \w and over that|strong="H4605"\w* \w a covering|strong="H4372"\w* \w of fine leather|strong="H8476"\w*.\f + \fr 36:19 \ft Possibly the hides of large aquatic mammals\f*
\s1 The Frames and Bases
\r (\ref Exodus 26:15–30|EXO 26:15-30\ref*)
\p \v 20 \w Next, he constructed|strong="H6213"\w* \w upright|strong="H5975"\w* \w frames|strong="H7175"\w* \w of acacia|strong="H7848"\w* \w wood|strong="H6086"\w* \w for the tabernacle|strong="H4908"\w*. \v 21 \w Each frame|strong="H7175"\w* \w was ten|strong="H6235"\w* \w cubits|strong="H520"\w* \w long|strong="H753"\w* \w and a cubit|strong="H520"\w* \w and a half|strong="H2677"\w* \w wide|strong="H7341"\w*.\f + \fr 36:21 \ft Each frame was \ref approximately 15|15\ref* feet long and 2.25 feet wide (4.6 meters long and 68.6 centimeters wide).\f* \v 22 \w Two|strong="H8147"\w* \w tenons|strong="H3027"\w*\f + \fr 36:22 \ft That is, projecting pieces of wood made for insertion into another piece; similarly in verse 24.\f* \w were connected|strong="H7947"\w* \w to|strong="H413"\w* \w each|strong="H259"\w* \w other|strong="H259"\w* \w for each|strong="H259"\w* \w frame|strong="H7175"\w*. \w He made|strong="H6213"\w* \w all|strong="H3605"\w* \w the frames|strong="H7175"\w* \w of the tabernacle|strong="H4908"\w* \w in this way|strong="H3651"\w*.
\p \v 23 \w He constructed|strong="H6213"\w* \w twenty|strong="H6242"\w* \w frames|strong="H7175"\w* \w for the south|strong="H5045"\w* \w side|strong="H6285"\w* \w of the tabernacle|strong="H4908"\w*, \v 24 \w with|strong="H6213"\w* \w forty|strong="H705"\w* \w silver|strong="H3701"\w* \w bases|strong="H134"\w* \w to put under|strong="H8478"\w* \w the twenty|strong="H6242"\w* \w frames|strong="H7175"\w* — \w two|strong="H8147"\w* \w bases|strong="H134"\w* \w for each frame|strong="H7175"\w*, \w one|strong="H259"\w* \w under|strong="H8478"\w* \w each|strong="H259"\w* \w tenon|strong="H3027"\w*.
\p \v 25 \w For the second|strong="H8145"\w* \w side|strong="H6763"\w* \w of the tabernacle|strong="H4908"\w*, \w the north|strong="H6828"\w* \w side|strong="H6285"\w*, \w he made|strong="H6213"\w* \w twenty|strong="H6242"\w* \w frames|strong="H7175"\w* \v 26 \w and forty|strong="H705"\w* \w silver|strong="H3701"\w* \w bases|strong="H134"\w* — \w two|strong="H8147"\w* \w bases|strong="H134"\w* \w under|strong="H8478"\w* \w each|strong="H259"\w* \w frame|strong="H7175"\w*.
\p \v 27 \w He made|strong="H6213"\w* \w six|strong="H8337"\w* \w frames|strong="H7175"\w* \w for the rear|strong="H3411"\w* \w of the tabernacle|strong="H4908"\w*, \w the west side|strong="H3220"\w*, \v 28 \w and|strong="H6213"\w* \w two|strong="H8147"\w* \w frames|strong="H7175"\w* \w for the two back|strong="H3411"\w* \w corners|strong="H4742"\w* \w of the tabernacle|strong="H4908"\w*, \v 29 \w coupled together|strong="H8380"\w* \w from bottom|strong="H4295"\w* \w to|strong="H413"\w* \w top|strong="H7218"\w* \w and fitted into|strong="H413"\w* \w a single|strong="H259"\w* \w ring|strong="H2885"\w*. \w He made|strong="H6213"\w* \w both|strong="H8147"\w* \w corners|strong="H4740"\w* \w in this way|strong="H3651"\w*. \v 30 \w So there were|strong="H1961"\w* \w eight|strong="H8083"\w* \w frames|strong="H7175"\w* \w and sixteen|strong="H8337"\w* \w silver|strong="H3701"\w* \w bases|strong="H134"\w* — \w two|strong="H8147"\w* \w under|strong="H8478"\w* \w each|strong="H259"\w* \w frame|strong="H7175"\w*.
\p \v 31 \w He also made|strong="H6213"\w* \w five|strong="H2568"\w* \w crossbars|strong="H1280"\w* \w of acacia|strong="H7848"\w* \w wood|strong="H6086"\w* \w for the frames|strong="H7175"\w* \w on one|strong="H259"\w* \w side|strong="H6763"\w* \w of the tabernacle|strong="H4908"\w*, \v 32 \w five|strong="H2568"\w* \w for those|strong="H7175"\w* \w on the other|strong="H8145"\w* \w side|strong="H6763"\w*, \w and five|strong="H2568"\w* \w for those|strong="H7175"\w* \w on the rear side|strong="H3411"\w* \w of the tabernacle|strong="H4908"\w*, \w to the west|strong="H3220"\w*.
\p \v 33 \w He made|strong="H6213"\w* \w the central|strong="H8484"\w* \w crossbar|strong="H1280"\w* \w to run through|strong="H1272"\w* \w the center|strong="H8432"\w* \w of the frames|strong="H7175"\w*, \w from|strong="H4480"\w* \w one end|strong="H7097"\w* \w to|strong="H413"\w* \w the other|strong="H7097"\w*. \v 34 \w And|strong="H853"\w* \w he overlaid|strong="H6823"\w* \w the frames|strong="H7175"\w* \w with gold|strong="H2091"\w* \w and made|strong="H6213"\w* \w gold|strong="H2091"\w* \w rings|strong="H2885"\w* \w to hold|strong="H1004"\w* \w the crossbars|strong="H1280"\w*. \w He also overlaid|strong="H6823"\w* \w the crossbars|strong="H1280"\w* \w with gold|strong="H2091"\w*.
\s1 The Veil
\r (\ref Exodus 26:31–35|EXO 26:31-35\ref*)
\p \v 35 \w Next, he made|strong="H6213"\w* \w the veil|strong="H6532"\w* \w of blue|strong="H8504"\w*, \w purple|strong="H713"\w*, \w and scarlet yarn|strong="H8438"\w*, \w and finely spun|strong="H7806"\w* \w linen|strong="H8336"\w*, \w with cherubim|strong="H3742"\w* \w skillfully|strong="H2803"\w* \w worked into it|strong="H4639"\w*.
\p \v 36 \w He also made|strong="H6213"\w* \w four|strong="H702"\w* \w posts|strong="H5982"\w* \w of acacia wood|strong="H7848"\w* for it \w and overlaid them|strong="H6823"\w* \w with gold|strong="H2091"\w*, \w along with gold|strong="H2091"\w* \w hooks|strong="H2053"\w*; \w and he cast|strong="H3332"\w* \w four|strong="H702"\w* \w silver|strong="H3701"\w* \w bases|strong="H134"\w* for the posts.
\s1 The Curtain for the Entrance
\r (\ref Exodus 26:36–37|EXO 26:36-37\ref*)
\p \v 37 \w For the entrance|strong="H6607"\w* \w to the tent|strong="H168"\w*, \w he made|strong="H6213"\w* \w a curtain|strong="H4539"\w* \w embroidered|strong="H7551"\w* \w with blue|strong="H8504"\w*, \w purple|strong="H713"\w*, \w and scarlet yarn|strong="H8438"\w*, \w and finely spun|strong="H7806"\w* \w linen|strong="H8336"\w*, \v 38 \w together with|strong="H853"\w* \w five|strong="H2568"\w* \w posts|strong="H5982"\w* \w and their hooks|strong="H2053"\w*.
\p \w He overlaid|strong="H6823"\w* \w the tops|strong="H7218"\w* \w of the posts and their bands|strong="H2838"\w* \w with gold|strong="H2091"\w*, \w and their five|strong="H2568"\w* \w bases|strong="H134"\w* \w were bronze|strong="H5178"\w*.
\c 37
\s1 Constructing the Ark
\r (\ref Exodus 25:10–16|EXO 25:10-16\ref*)
\p \v 1 \w Bezalel went on|strong="H1212"\w* \w to construct|strong="H6213"\w* \w the ark|strong="H727"\w* \w of acacia|strong="H7848"\w* \w wood|strong="H6086"\w*, \w two|strong="H520"\w* \w and a half cubits|strong="H2677"\w* \w long|strong="H753"\w*, \w a cubit|strong="H520"\w* \w and a half|strong="H2677"\w* \w wide|strong="H7341"\w*, \w and a cubit|strong="H520"\w* \w and a half|strong="H2677"\w* \w high|strong="H6967"\w*.\f + \fr 37:1 \ft The ark was \ref approximately 3|3\ref*.75 feet long, 2.25 feet wide, and 2.25 feet high (114.3 centimeters long, 68.6 centimeters wide, and 68.6 centimeters high).\f* \v 2 \w He overlaid|strong="H6823"\w* \w it with pure|strong="H2889"\w* \w gold|strong="H2091"\w*, \w both inside|strong="H1004"\w* \w and out|strong="H2351"\w*, \w and made|strong="H6213"\w* \w a gold|strong="H2091"\w* \w molding|strong="H2213"\w* \w around it|strong="H5439"\w*. \v 3 \w And he cast|strong="H3332"\w* \w four|strong="H702"\w* \w gold|strong="H2091"\w* \w rings|strong="H2885"\w* \w for|strong="H5921"\w* \w its four|strong="H702"\w* \w feet|strong="H6471"\w*, \w two|strong="H8147"\w* \w rings|strong="H2885"\w* \w on|strong="H5921"\w* \w one|strong="H259"\w* \w side|strong="H6763"\w* \w and two|strong="H8147"\w* \w on|strong="H5921"\w* \w the other|strong="H8145"\w*. \v 4 \w Then he made|strong="H6213"\w* \w poles|strong="H905"\w* \w of acacia|strong="H7848"\w* \w wood|strong="H6086"\w* \w and overlaid|strong="H6823"\w* \w them|strong="H853"\w* \w with gold|strong="H2091"\w*. \v 5 \w He inserted|strong="H935"\w* \w the poles|strong="H905"\w* \w into the rings|strong="H2885"\w* \w on|strong="H5921"\w* \w the sides|strong="H6763"\w* \w of the ark|strong="H727"\w* \w in order to carry|strong="H5375"\w* \w it|strong="H727"\w*.
\s1 The Mercy Seat
\r (\ref Exodus 25:17–22|EXO 25:17-22\ref*)
\p \v 6 \w He constructed|strong="H6213"\w* \w a mercy seat|strong="H3727"\w* \w of pure|strong="H2889"\w* \w gold|strong="H2091"\w*, \w two|strong="H520"\w* \w and a half cubits|strong="H2677"\w* \w long|strong="H753"\w* \w and a cubit|strong="H520"\w* \w and a half|strong="H2677"\w* \w wide|strong="H7341"\w*.\f + \fr 37:6 \ft The mercy seat was \ref approximately 3|3\ref*.75 feet long and 2.25 feet wide (114.3 centimeters long and 68.6 centimeters wide).\f* \v 7 \w He made|strong="H6213"\w* \w two|strong="H8147"\w* \w cherubim|strong="H3742"\w* \w of hammered|strong="H4749"\w* \w gold|strong="H2091"\w* \w at the|strong="H8147"\w* \w ends|strong="H7098"\w* \w of the mercy seat|strong="H3727"\w*, \v 8 \w one|strong="H259"\w* \w cherub|strong="H3742"\w* \w on one|strong="H2088"\w* \w end|strong="H7098"\w* \w and one|strong="H259"\w* \w on the other|strong="H2088"\w*, \w all made|strong="H6213"\w* \w from one piece of gold|strong="H7117"\w*. \v 9 \w And the cherubim|strong="H3742"\w* \w had wings|strong="H3671"\w* \w that spread|strong="H6566"\w* \w upward|strong="H4605"\w*, \w overshadowing|strong="H5526"\w* \w the mercy seat|strong="H3727"\w*. \w The cherubim faced|strong="H6440"\w* \w each|strong="H376"\w* \w other|strong="H251"\w*, \w looking toward|strong="H413"\w* \w the mercy seat|strong="H3727"\w*.
\s1 The Table of Showbread
\r (\ref Exodus 25:23–30|EXO 25:23-30\ref*; \ref Leviticus 24:5–9|LEV 24:5-9\ref*)
\p \v 10 \w He also made|strong="H6213"\w* \w the table|strong="H7979"\w* \w of acacia|strong="H7848"\w* \w wood|strong="H6086"\w* \w two cubits|strong="H520"\w* \w long|strong="H753"\w*, \w a cubit|strong="H520"\w* \w wide|strong="H7341"\w*, \w and a cubit|strong="H520"\w* \w and a half|strong="H2677"\w* \w high|strong="H6967"\w*.\f + \fr 37:10 \ft The table was \ref approximately 3|3\ref* feet long, 1.5 feet wide, and 2.25 feet high (91.4 centimeters long, 45.7 centimeters wide, and 68.6 centimeters high).\f* \v 11 \w He overlaid|strong="H6823"\w* \w it|strong="H853"\w* \w with pure|strong="H2889"\w* \w gold|strong="H2091"\w* \w and made|strong="H6213"\w* \w a gold|strong="H2091"\w* \w molding|strong="H2213"\w* \w around it|strong="H5439"\w*. \v 12 \w And he made|strong="H6213"\w* \w a rim|strong="H4526"\w* \w around|strong="H5439"\w* it \w a handbreadth wide|strong="H2948"\w*\f + \fr 37:12 \fqa A handbreadth\ft is \ref approximately 2|2\ref*.9 inches or 7.4 centimeters.\f* \w and put|strong="H6213"\w* \w a gold|strong="H2091"\w* \w molding|strong="H2213"\w* \w on|strong="H5439"\w* \w the rim|strong="H4526"\w*.
\p \v 13 \w He cast|strong="H3332"\w* \w four|strong="H702"\w* \w gold|strong="H2091"\w* \w rings|strong="H2885"\w* for the table \w and fastened|strong="H5414"\w* \w them|strong="H2885"\w* \w to|strong="H5921"\w* \w the four|strong="H702"\w* \w corners|strong="H6285"\w* \w at its four|strong="H702"\w* \w legs|strong="H7272"\w*. \v 14 \w The rings|strong="H2885"\w* \w were placed|strong="H1961"\w* \w close|strong="H5980"\w* \w to the rim|strong="H4526"\w*, \w to serve as holders|strong="H1004"\w* \w for the poles|strong="H905"\w* \w used to carry|strong="H5375"\w* \w the table|strong="H7979"\w*. \v 15 \w He made|strong="H6213"\w* \w the poles|strong="H905"\w* \w of acacia|strong="H7848"\w* \w wood|strong="H6086"\w* \w for carrying|strong="H5375"\w* \w the table|strong="H7979"\w* \w and overlaid|strong="H6823"\w* \w them|strong="H853"\w* \w with gold|strong="H2091"\w*.
\p \v 16 \w He also made|strong="H6213"\w* \w the utensils|strong="H3627"\w* \w for|strong="H5921"\w* \w the table|strong="H7979"\w* \w out of pure|strong="H2889"\w* \w gold|strong="H2091"\w*: \w its plates|strong="H7086"\w* \w and dishes|strong="H3709"\w*, \w as well as its bowls|strong="H4518"\w* \w and pitchers|strong="H7184"\w* \w for pouring drink offerings|strong="H5258"\w*.
\s1 The Lampstand
\r (\ref Exodus 25:31–40|EXO 25:31-40\ref*; \ref Numbers 8:1–4|NUM 8:1-4\ref*)
\p \v 17 \w Then he made|strong="H6213"\w* \w the lampstand|strong="H4501"\w* \w out of pure|strong="H2889"\w* \w hammered|strong="H4749"\w* \w gold|strong="H2091"\w*, \w all of one piece|strong="H4480"\w*: \w its base|strong="H3409"\w* \w and shaft|strong="H7070"\w*, \w its cups|strong="H1375"\w*, \w and its buds|strong="H3730"\w* \w and petals|strong="H6525"\w*. \v 18 \w Six|strong="H8337"\w* \w branches|strong="H7070"\w* \w extended|strong="H3318"\w* \w from the sides|strong="H6654"\w*, \w three|strong="H7969"\w* \w on one|strong="H259"\w* \w side|strong="H6654"\w* \w and three|strong="H7969"\w* \w on the other|strong="H8145"\w*. \v 19 \w There were three|strong="H7969"\w* \w cups|strong="H1375"\w* \w shaped like almond blossoms|strong="H8246"\w* \w on the first|strong="H259"\w* \w branch|strong="H7070"\w*, \w each with buds|strong="H3730"\w* \w and petals|strong="H6525"\w*, \w three|strong="H7969"\w* \w on the next|strong="H259"\w* \w branch|strong="H7070"\w*, \w and the same|strong="H3651"\w* \w for all six|strong="H8337"\w* \w branches|strong="H7070"\w* \w that extended|strong="H3318"\w* \w from|strong="H4480"\w* \w the lampstand|strong="H4501"\w*.
\p \v 20 \w And on the lampstand|strong="H4501"\w* \w were four|strong="H702"\w* \w cups|strong="H1375"\w* \w shaped like almond blossoms|strong="H8246"\w* \w with buds|strong="H3730"\w* \w and petals|strong="H6525"\w*. \v 21 \w A bud|strong="H3730"\w* \w was under|strong="H8478"\w* \w the first pair|strong="H8147"\w* \w of branches|strong="H7070"\w* \w that extended|strong="H3318"\w* \w from the lampstand|strong="H4480"\w*, \w a bud|strong="H3730"\w* \w under|strong="H8478"\w* \w the second pair|strong="H8147"\w*, \w and a bud|strong="H3730"\w* \w under|strong="H8478"\w* \w the third pair|strong="H8147"\w*. \v 22 \w The buds|strong="H3730"\w* \w and branches|strong="H7070"\w* \w were|strong="H1961"\w* \w all|strong="H3605"\w* \w of one piece with the lampstand|strong="H4480"\w*, \w hammered|strong="H4749"\w* \w out of pure|strong="H2889"\w* \w gold|strong="H2091"\w*.
\p \v 23 \w He also made|strong="H6213"\w* \w its seven|strong="H7651"\w* \w lamps|strong="H5216"\w*, \w its wick trimmers|strong="H4457"\w*, \w and trays|strong="H4289"\w* \w of pure|strong="H2889"\w* \w gold|strong="H2091"\w*. \v 24 \w He made|strong="H6213"\w* \w the lampstand|strong="H853"\w* \w and all|strong="H3605"\w* \w its utensils|strong="H3627"\w* \w from a talent|strong="H3603"\w* \w of pure|strong="H2889"\w* \w gold|strong="H2091"\w*.\f + \fr 37:24 \fqa A talent\ft is \ref approximately 75|75\ref*.4 pounds or 34.2 kilograms of gold.\f*
\s1 The Altar of Incense
\r (\ref Exodus 30:1–10|EXO 30:1-10\ref*)
\p \v 25 \w He made|strong="H6213"\w* \w the altar|strong="H4196"\w* \w of incense|strong="H7004"\w* \w out of acacia|strong="H7848"\w* \w wood|strong="H6086"\w*. \w It was square|strong="H7251"\w*, \w a cubit|strong="H520"\w* \w long|strong="H753"\w*, \w a cubit|strong="H520"\w* \w wide|strong="H7341"\w*, \w and two cubits|strong="H520"\w* \w high|strong="H6967"\w*.\f + \fr 37:25 \ft The altar was \ref approximately 1|1\ref*.5 feet in length and width, and 3 feet high (45.7 centimeters in length and width, and 91.4 centimeters high).\f* \w Its horns|strong="H7161"\w* \w were|strong="H1961"\w* \w of one piece|strong="H4480"\w*. \v 26 \w And he overlaid|strong="H6823"\w* \w with pure|strong="H2889"\w* \w gold|strong="H2091"\w* \w the top|strong="H1406"\w* \w and|strong="H853"\w* \w all|strong="H5439"\w* \w the sides|strong="H7023"\w* \w and horns|strong="H7161"\w*. \w Then he made|strong="H6213"\w* \w a molding|strong="H2213"\w* \w of gold|strong="H2091"\w* \w around it|strong="H5439"\w*.
\p \v 27 \w He made|strong="H6213"\w* \w two|strong="H8147"\w* \w gold|strong="H2091"\w* \w rings|strong="H2885"\w* \w below|strong="H8478"\w* \w the molding|strong="H2213"\w* \w on|strong="H5921"\w* \w opposite sides|strong="H6654"\w* \w to hold|strong="H1004"\w* \w the poles|strong="H905"\w* \w used to carry|strong="H5375"\w* \w it|strong="H853"\w*. \v 28 \w And he made|strong="H6213"\w* \w the poles|strong="H905"\w* \w of acacia|strong="H7848"\w* \w wood|strong="H6086"\w* \w and overlaid|strong="H6823"\w* \w them|strong="H853"\w* \w with gold|strong="H2091"\w*.
\p \v 29 \w He also made|strong="H6213"\w* \w the sacred|strong="H6944"\w* \w anointing|strong="H4888"\w* \w oil|strong="H8081"\w* \w and the pure|strong="H2889"\w*, \w fragrant|strong="H5561"\w* \w incense|strong="H7004"\w*, \w the work of a perfumer|strong="H7543"\w*.
\c 38
\s1 The Bronze Altar
\r (\ref Exodus 27:1–8|EXO 27:1-8\ref*)
\p \v 1 \w Bezalel constructed|strong="H6213"\w*\f + \fr 38:1 \ft Literally \fqa He constructed\f* \w the altar|strong="H4196"\w* \w of burnt offering|strong="H5930"\w* \w from acacia|strong="H7848"\w* \w wood|strong="H6086"\w*. \w It was square|strong="H7251"\w*, \w five|strong="H2568"\w* \w cubits|strong="H520"\w* \w long|strong="H753"\w*, \w five|strong="H2568"\w* \w cubits|strong="H520"\w* \w wide|strong="H7341"\w*, \w and three|strong="H7969"\w* \w cubits|strong="H520"\w* \w high|strong="H6967"\w*.\f + \fr 38:1 \ft The altar was \ref approximately 7|7\ref*.5 feet in length and width, and 4.5 feet high (2.3 meters in length and width, and 1.4 meters high).\f* \v 2 \w He made|strong="H6213"\w* \w a horn|strong="H7161"\w* \w at each of|strong="H5921"\w* \w its four|strong="H702"\w* \w corners|strong="H6438"\w*, \w so that the horns and altar|strong="H7161"\w* \w were|strong="H1961"\w* \w of one piece|strong="H4480"\w*, \w and he overlaid|strong="H6823"\w* \w the altar with bronze|strong="H5178"\w*.
\p \v 3 \w He made|strong="H6213"\w* \w all|strong="H3605"\w* \w the altar’s|strong="H4196"\w* \w utensils|strong="H3627"\w* \w of bronze|strong="H5178"\w* — \w its pots|strong="H5518"\w*, \w shovels|strong="H3257"\w*, \w sprinkling bowls|strong="H4219"\w*, \w meat forks|strong="H4207"\w*, \w and firepans|strong="H4289"\w*. \v 4 \w He made|strong="H6213"\w* \w a grate|strong="H4345"\w* \w of bronze|strong="H5178"\w* \w mesh|strong="H7568"\w* \w for the altar|strong="H4196"\w* \w under|strong="H8478"\w* \w its ledge|strong="H3749"\w*, \w halfway|strong="H2677"\w* \w up from the bottom|strong="H4295"\w*.
\p \v 5 \w At the four|strong="H702"\w* \w corners|strong="H7117"\w* \w of the bronze|strong="H5178"\w* \w grate|strong="H4345"\w* \w he cast|strong="H3332"\w* \w four|strong="H702"\w* \w rings|strong="H2885"\w* \w as holders|strong="H1004"\w* \w for the poles|strong="H905"\w*. \v 6 \w And he made|strong="H6213"\w* \w the poles|strong="H905"\w* \w of acacia|strong="H7848"\w* \w wood|strong="H6086"\w* \w and overlaid|strong="H6823"\w* \w them|strong="H853"\w* \w with bronze|strong="H5178"\w*. \v 7 \w Then he inserted|strong="H935"\w* \w the poles|strong="H905"\w* \w into the rings|strong="H2885"\w* \w on|strong="H5921"\w* \w the sides|strong="H6763"\w* \w of the altar|strong="H4196"\w* \w for carrying|strong="H5375"\w* \w it|strong="H853"\w*. \w He made|strong="H6213"\w* \w the altar|strong="H853"\w* \w with boards|strong="H3871"\w* \w so that it was hollow|strong="H5014"\w*.
\s1 The Bronze Basin
\r (\ref Exodus 30:17–21|EXO 30:17-21\ref*)
\p \v 8 \w Next he made|strong="H6213"\w* \w the bronze|strong="H5178"\w* \w basin|strong="H3595"\w* \w and its stand|strong="H3653"\w* \w from the mirrors|strong="H4759"\w* \w of the women who|strong="H834"\w* \w served|strong="H6633"\w* \w at the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*.
\s1 The Courtyard
\r (\ref Exodus 27:9–19|EXO 27:9-19\ref*)
\p \v 9 \w Then he constructed|strong="H6213"\w* \w the courtyard|strong="H2691"\w*. \w The south|strong="H5045"\w* \w side|strong="H6285"\w* \w of the courtyard|strong="H2691"\w* \w was a hundred|strong="H3967"\w* \w cubits long|strong="H520"\w*\f + \fr 38:9 \fqa \ref 100|0\ref* cubits\ft is \ref approximately 150|150\ref* feet or 45.7 meters.\f* \w and had curtains|strong="H7050"\w* \w of finely spun|strong="H7806"\w* \w linen|strong="H8336"\w*, \v 10 \w with twenty|strong="H6242"\w* \w posts|strong="H5982"\w* \w and twenty|strong="H6242"\w* \w bronze|strong="H5178"\w* \w bases|strong="H134"\w*, \w and with silver|strong="H3701"\w* \w hooks|strong="H2053"\w* \w and bands|strong="H2838"\w* \w on the posts|strong="H5982"\w*. \v 11 \w The north|strong="H6828"\w* \w side|strong="H6285"\w* \w was also a hundred|strong="H3967"\w* \w cubits long|strong="H520"\w*, \w with twenty|strong="H6242"\w* \w posts|strong="H5982"\w* \w and twenty|strong="H6242"\w* \w bronze|strong="H5178"\w* \w bases|strong="H134"\w*. \w The hooks|strong="H2053"\w* \w and bands|strong="H2838"\w* \w of the posts|strong="H5982"\w* \w were silver|strong="H3701"\w*. \v 12 \w The west|strong="H3220"\w* \w side|strong="H6285"\w* \w was fifty|strong="H2572"\w* \w cubits long|strong="H520"\w*\f + \fr 38:12 \fqa \ref 50|0\ref* cubits\ft is \ref approximately 75|75\ref* feet or 22.9 meters.\f* \w and had curtains|strong="H7050"\w*, \w with ten|strong="H6235"\w* \w posts|strong="H5982"\w* \w and ten|strong="H6235"\w* \w bases|strong="H134"\w*. \w The hooks|strong="H2053"\w* \w and bands|strong="H2838"\w* \w of the posts|strong="H5982"\w* \w were silver|strong="H3701"\w*. \v 13 \w And the east|strong="H6924"\w* \w side|strong="H6285"\w*, \w toward the sunrise|strong="H4217"\w*, \w was also fifty|strong="H2572"\w* \w cubits long|strong="H520"\w*.
\p \v 14 \w The curtains|strong="H7050"\w* \w on|strong="H413"\w* \w one side|strong="H3802"\w* \w of the entrance were fifteen|strong="H2568"\w* \w cubits long|strong="H520"\w*,\f + \fr 38:14 \fqa \ref 15|5\ref* cubits\ft is \ref approximately 22|22\ref*.5 feet or 6.9 meters.\f* \w with three|strong="H7969"\w* \w posts|strong="H5982"\w* \w and three|strong="H7969"\w* \w bases|strong="H134"\w*. \v 15 \w And the curtains|strong="H7050"\w* \w on the other|strong="H8145"\w* \w side|strong="H3802"\w* \w were also fifteen|strong="H2568"\w* \w cubits long|strong="H520"\w*, \w with three|strong="H7969"\w* \w posts|strong="H5982"\w* \w and three|strong="H7969"\w* \w bases|strong="H134"\w* \w as well|strong="H2088"\w*. \v 16 \w All|strong="H3605"\w* \w the curtains|strong="H7050"\w* \w around|strong="H5439"\w* \w the courtyard|strong="H2691"\w* \w were made of finely spun|strong="H7806"\w* \w linen|strong="H8336"\w*. \v 17 \w The bases|strong="H134"\w* \w for the posts|strong="H5982"\w* \w were bronze|strong="H5178"\w*, \w the hooks|strong="H2053"\w* \w and bands|strong="H2838"\w* \w were silver|strong="H3701"\w*, \w and the plating|strong="H6826"\w* \w for the tops|strong="H7218"\w* \w of the posts was silver|strong="H3701"\w*. \w So all|strong="H3605"\w* \w the posts|strong="H5982"\w* \w of the courtyard|strong="H2691"\w* \w were banded|strong="H2836"\w* \w with silver|strong="H3701"\w*.
\p \v 18 \w The curtain|strong="H4539"\w* \w for the entrance|strong="H8179"\w* \w to the courtyard|strong="H2691"\w* \w was embroidered|strong="H7551"\w* \w with blue|strong="H8504"\w*, \w purple|strong="H713"\w*, \w and scarlet yarn|strong="H8438"\w*, \w and finely spun|strong="H7806"\w* \w linen|strong="H8336"\w*. \w It was twenty|strong="H6242"\w* \w cubits|strong="H520"\w* \w long|strong="H753"\w*\f + \fr 38:18 \fqa \ref 20|0\ref* cubits\ft is \ref approximately 30|30\ref* feet or 9.1 meters.\f* \w and, like|strong="H5980"\w* \w the curtains|strong="H7050"\w* \w of the courtyard|strong="H2691"\w*, \w five|strong="H2568"\w* \w cubits|strong="H520"\w* \w high|strong="H6967"\w*,\f + \fr 38:18 \fqa 5 cubits\ft is \ref approximately 7|7\ref*.5 feet or 2.3 meters.\f* \v 19 \w with four|strong="H702"\w* \w posts|strong="H5982"\w* \w and four|strong="H702"\w* \w bronze|strong="H5178"\w* \w bases|strong="H134"\w*. \w Their hooks|strong="H2053"\w* \w were silver|strong="H3701"\w*, \w as well as the bands|strong="H2838"\w* \w and the plating|strong="H6826"\w* \w of their tops|strong="H7218"\w*. \v 20 \w All|strong="H3605"\w* \w the tent pegs|strong="H3489"\w* \w for the tabernacle|strong="H4908"\w* \w and for the surrounding|strong="H5439"\w* \w courtyard|strong="H2691"\w* \w were bronze|strong="H5178"\w*.
\s1 An Inventory of Materials
\r (\ref Ezra 2:68–70|EZR 2:68-70\ref*; \ref Nehemiah 7:70–73|NEH 7:70-73\ref*)
\p \v 21 \w This|strong="H428"\w* \w is the inventory|strong="H6485"\w* \w for the tabernacle|strong="H4908"\w*, \w the tabernacle|strong="H4908"\w* \w of the Testimony|strong="H5715"\w*, \w as|strong="H834"\w* \w recorded|strong="H6485"\w* \w at|strong="H5921"\w* \w Moses’|strong="H4872"\w* \w command|strong="H6310"\w* \w by|strong="H5656"\w* \w the Levites|strong="H3881"\w* \w under the direction|strong="H3027"\w* \w of Ithamar|strong="H385"\w* \w son|strong="H1121"\w* \w of Aaron|strong="H175"\w* \w the priest|strong="H3548"\w*. \v 22 \w Bezalel|strong="H1212"\w* \w son|strong="H1121"\w* \w of Uri|strong="H221"\w*, \w the son|strong="H1121"\w* \w of Hur|strong="H2354"\w*, \w of the tribe|strong="H4294"\w* \w of Judah|strong="H3063"\w*, \w made|strong="H6213"\w* \w everything|strong="H3605"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w Moses|strong="H4872"\w*. \v 23 \w With him was|strong="H854"\w* \w Oholiab|strong="H171"\w* \w son|strong="H1121"\w* \w of Ahisamach|strong="H294"\w*, \w of the tribe|strong="H4294"\w* \w of Dan|strong="H1835"\w*, \w an engraver|strong="H2796"\w*, \w designer|strong="H2803"\w*, \w and embroiderer|strong="H7551"\w* \w in blue|strong="H8504"\w*, \w purple|strong="H713"\w*, \w and scarlet yarn|strong="H8438"\w* \w and fine linen|strong="H8336"\w*.
\p \v 24 \w All|strong="H3605"\w* \w the gold|strong="H2091"\w* \w from the wave offering|strong="H8573"\w* \w used|strong="H6213"\w* \w for the work|strong="H4399"\w* \w on the sanctuary|strong="H6944"\w* \w totaled|strong="H1961"\w* \w 29|strong="H8672"\w* \w talents|strong="H3603"\w* \w and 730|strong="H7651"\w* \w shekels|strong="H8255"\w*,\f + \fr 38:24 \ft The total weight of the gold was \ref approximately 1|1\ref*.1 tons or 1 metric ton.\f* \w according to the sanctuary|strong="H6944"\w* \w shekel|strong="H8255"\w*.
\p \v 25 \w The silver|strong="H3701"\w* \w from those numbered|strong="H6485"\w* \w among the congregation|strong="H5712"\w* \w totaled 100|strong="H3967"\w* \w talents|strong="H3603"\w* \w and 1,775|strong="H505"\w* \w shekels|strong="H8255"\w*,\f + \fr 38:25 \ft The total weight of the silver was \ref approximately 3|3\ref*.79 tons or 3.44 metric tons.\f* \w according to the sanctuary|strong="H6944"\w* \w shekel|strong="H8255"\w*— \v 26 \w a beka|strong="H1235"\w* \w per person|strong="H1538"\w*, \w that is, half|strong="H4276"\w* \w a shekel|strong="H8255"\w*,\f + \fr 38:26 \fqa A beka\ft is half a shekel, or \ref approximately 0|0\ref*.2 ounces or 5.7 grams.\f* \w according to the sanctuary|strong="H6944"\w* \w shekel|strong="H8255"\w*, \w from everyone|strong="H3605"\w* \w twenty|strong="H6242"\w* \w years|strong="H8141"\w* \w of age|strong="H1121"\w* \w or older|strong="H4605"\w* \w who had crossed over|strong="H5674"\w* \w to|strong="H5921"\w* \w be numbered|strong="H6485"\w*, \w a total of 603,550|strong="H8337"\w* \w men|strong="H2572"\w*.
\p \v 27 \w The hundred|strong="H3967"\w* \w talents|strong="H3603"\w* \w of silver|strong="H3701"\w*\f + \fr 38:27 \fqa \ref 100|0\ref* talents\ft is \ref approximately 3|3\ref*.77 tons or 3.42 metric tons of silver.\f* \w were|strong="H1961"\w* \w used to cast|strong="H3332"\w* \w the bases|strong="H134"\w* \w of the sanctuary|strong="H6944"\w* \w and the bases|strong="H134"\w* \w of the veil|strong="H6532"\w*— \w 100|strong="H3967"\w* \w bases|strong="H134"\w* \w from the 100|strong="H3967"\w* \w talents|strong="H3603"\w*, \w one talent|strong="H3603"\w* \w per base|strong="H134"\w*.
\p \v 28 \w With the 1,775 shekels|strong="H505"\w* [of silver]\f + \fr 38:28 \fqa \ref 1,775|5\ref* shekels\ft is \ref approximately 44|44\ref*.6 pounds or 20.2 kilograms of silver.\f* \w he made|strong="H6213"\w* \w the hooks|strong="H2053"\w* \w for the posts|strong="H5982"\w*, \w overlaid|strong="H6823"\w* \w their tops|strong="H7218"\w*, \w and supplied bands|strong="H2836"\w* \w for them|strong="H853"\w*.
\p \v 29 \w The bronze|strong="H5178"\w* \w from the wave offering|strong="H8573"\w* \w totaled 70|strong="H7657"\w* \w talents|strong="H3603"\w* \w and 2,400|strong="H505"\w* \w shekels|strong="H8255"\w*.\f + \fr 38:29 \ft The total weight of the bronze was \ref approximately 2|2\ref*.67 tons or 2.42 metric tons.\f* \v 30 \w He used it to make|strong="H6213"\w* \w the bases|strong="H134"\w* \w for the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*, \w the bronze|strong="H5178"\w* \w altar|strong="H4196"\w* \w and its bronze|strong="H5178"\w* \w grating|strong="H4345"\w*, \w all|strong="H3605"\w* \w the utensils|strong="H3627"\w* \w for the altar|strong="H4196"\w*, \v 31 \w the bases|strong="H134"\w* \w for the surrounding|strong="H5439"\w* \w courtyard|strong="H2691"\w* \w and|strong="H134"\w* \w its gate|strong="H8179"\w*, \w and|strong="H853"\w* \w all|strong="H3605"\w* \w the tent pegs|strong="H3489"\w* \w for the tabernacle|strong="H4908"\w* \w and|strong="H3605"\w* \w its surrounding|strong="H5439"\w* \w courtyard|strong="H2691"\w*.
\c 39
\s1 The Ephod
\r (\ref Exodus 28:6–14|EXO 28:6-14\ref*)
\p \v 1 \w From|strong="H4480"\w* \w the blue|strong="H8504"\w*, \w purple|strong="H713"\w*, \w and scarlet yarn|strong="H8438"\w* \w they made|strong="H6213"\w* \w specially woven|strong="H8278"\w* \w garments|strong="H899"\w* \w for ministry|strong="H8334"\w* \w in the sanctuary|strong="H6944"\w*, \w as well as the holy|strong="H6944"\w* \w garments|strong="H899"\w* \w for Aaron|strong="H175"\w*, \w just as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w Moses|strong="H4872"\w*.
\p \v 2 \w Bezalel made|strong="H6213"\w*\f + \fr 39:2 \ft Literally \fqa He made\f* \w the ephod|strong="H646"\w* \w of finely spun|strong="H7806"\w* \w linen|strong="H8336"\w* \w embroidered with gold|strong="H2091"\w*, \w and with blue|strong="H8504"\w*, \w purple|strong="H713"\w*, \w and scarlet yarn|strong="H8438"\w*. \v 3 \w They hammered out|strong="H7554"\w* \w thin sheets|strong="H6341"\w* \w of gold|strong="H2091"\w* \w and cut|strong="H7112"\w* \w threads from them|strong="H6616"\w* \w to interweave|strong="H6213"\w* \w with the blue|strong="H8504"\w*, \w purple|strong="H713"\w*, \w and scarlet yarn|strong="H8438"\w*, \w and fine linen|strong="H8336"\w* — \w the work|strong="H4639"\w* \w of a skilled craftsman|strong="H2803"\w*. \v 4 \w They made|strong="H6213"\w* \w shoulder pieces|strong="H3802"\w* for the ephod, \w which were attached|strong="H2266"\w* \w at|strong="H5921"\w* \w two|strong="H8147"\w* \w of its corners|strong="H7098"\w*, \w so it could be fastened|strong="H2266"\w*. \v 5 \w And the skillfully woven waistband|strong="H2805"\w* \w of|strong="H5921"\w* \w the ephod|strong="H642"\w* \w was of one piece with the ephod|strong="H4480"\w*, \w of the same|strong="H1931"\w* \w workmanship|strong="H4639"\w* — \w with gold|strong="H2091"\w*, \w with blue|strong="H8504"\w*, \w purple|strong="H713"\w*, \w and scarlet yarn|strong="H8438"\w*, \w and with finely spun|strong="H7806"\w* \w linen|strong="H8336"\w*, \w just as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w Moses|strong="H4872"\w*.
\p \v 6 \w They mounted|strong="H6213"\w* \w the onyx|strong="H7718"\w* \w stones|strong="H68"\w* \w in gold|strong="H2091"\w* \w filigree settings|strong="H4865"\w*, \w engraved|strong="H6605"\w* \w like a seal|strong="H2368"\w* \w with|strong="H5921"\w* \w the names|strong="H8034"\w* \w of the sons|strong="H1121"\w* \w of Israel|strong="H3478"\w*. \v 7 \w Then they fastened|strong="H7760"\w* \w them|strong="H853"\w* \w on|strong="H5921"\w* \w the shoulder pieces|strong="H3802"\w* \w of the ephod|strong="H646"\w* \w as memorial|strong="H2146"\w* \w stones|strong="H68"\w* \w for the sons|strong="H1121"\w* \w of Israel|strong="H3478"\w*, \w as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w Moses|strong="H4872"\w*.
\s1 The Breastpiece
\r (\ref Exodus 28:15–30|EXO 28:15-30\ref*)
\p \v 8 \w He made|strong="H6213"\w* \w the breastpiece|strong="H2833"\w* \w with the same workmanship|strong="H4639"\w* \w as the ephod|strong="H646"\w*, \w with gold|strong="H2091"\w*, \w with blue|strong="H8504"\w*, \w purple|strong="H713"\w*, \w and scarlet yarn|strong="H8438"\w*, \w and with finely spun|strong="H7806"\w* \w linen|strong="H8336"\w*. \v 9 \w It|strong="H6213"\w* \w was square|strong="H7251"\w* \w when folded over double|strong="H3717"\w*, \w a span|strong="H2239"\w* \w long|strong="H753"\w* \w and a span|strong="H2239"\w* \w wide|strong="H7341"\w*.\f + \fr 39:9 \ft The breastpiece, when folded over, was \ref approximately 9|9\ref* inches or 22.9 centimeters in both length and width.\f*
\p \v 10 \w And they mounted|strong="H4390"\w* on it \w four|strong="H702"\w* \w rows|strong="H2905"\w* \w of gemstones|strong="H68"\w*:\f + \fr 39:10 \ft The precise identification of some of these gemstones is uncertain.\f*
\li1 \w The first|strong="H259"\w* \w row had|strong="H2905"\w* \w a ruby|strong="H124"\w*, \w a topaz|strong="H6357"\w*, \w and an emerald|strong="H1304"\w*;
\li1 \v 11 \w the second|strong="H8145"\w* \w row had|strong="H2905"\w* \w a turquoise|strong="H5306"\w*, \w a sapphire|strong="H5601"\w*, \w and a diamond|strong="H3095"\w*;
\li1 \v 12 \w the third|strong="H7992"\w* \w row had|strong="H2905"\w* \w a jacinth|strong="H3958"\w*, \w an agate|strong="H7618"\w*, \w and an amethyst|strong="H306"\w*;
\li1 \v 13 \w and the fourth|strong="H7243"\w* \w row had|strong="H2905"\w* \w a beryl|strong="H8658"\w*, \w an onyx|strong="H7718"\w*, \w and a jasper|strong="H3471"\w*.
\p \w These stones were mounted|strong="H5437"\w* \w in gold|strong="H2091"\w* \w filigree|strong="H4865"\w* \w settings|strong="H4396"\w*.
