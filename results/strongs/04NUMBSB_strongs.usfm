\p \v 32 \w While the Israelites|strong="H1121"\w* \w were|strong="H1961"\w* \w in the wilderness|strong="H4057"\w*, \w a man|strong="H376"\w* \w was found|strong="H4672"\w* \w gathering|strong="H7197"\w* \w wood|strong="H6086"\w* \w on the Sabbath|strong="H7676"\w* \w day|strong="H3117"\w*. \v 33 \w Those who found|strong="H4672"\w* \w the man|strong="H853"\w* \w gathering|strong="H7197"\w* \w wood|strong="H6086"\w* \w brought|strong="H7126"\w* \w him|strong="H853"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \w Aaron|strong="H175"\w*, \w and the whole|strong="H3605"\w* \w congregation|strong="H5712"\w*, \v 34 \w and because|strong="H3588"\w* \w it had not been|strong="H3808"\w* \w declared|strong="H6567"\w* \w what|strong="H4100"\w* \w should be done|strong="H6213"\w* to him, \w they placed|strong="H5117"\w* \w him|strong="H853"\w* \w in custody|strong="H4929"\w*.
