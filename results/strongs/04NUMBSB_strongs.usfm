\s1 Balaam’s Final Three Oracles
\p \v 20 \w Then Balaam saw|strong="H7200"\w* \w Amalek|strong="H6002"\w* \w and lifted up|strong="H5375"\w* \w an oracle|strong="H4912"\w*, \w saying|strong="H559"\w*:
\q1 “\w Amalek|strong="H6002"\w* \w was first|strong="H7225"\w* \w among the nations|strong="H1471"\w*,
\q2 \w but his end|strong="H319"\w* \w is destruction|strong="H8"\w*.”
\b 
\p \v 21 \w Next he saw|strong="H7200"\w* \w the Kenites|strong="H7017"\w* \w and lifted up|strong="H5375"\w* \w an oracle|strong="H4912"\w*, \w saying|strong="H559"\w*:
\q1 “\w Your dwelling place|strong="H4186"\w* \w is secure|strong="H386"\w*,
\q2 \w and your nest|strong="H7064"\w* \w is set|strong="H7760"\w* \w in a cliff|strong="H5553"\w*.
\q1 \v 22 \w Yet|strong="H3588"\w* \w Kain|strong="H7014"\w* \w will be|strong="H1961"\w* \w destroyed|strong="H1197"\w*
\q2 \w when|strong="H5704"\w* \w Asshur|strong="H804"\w*\f + \fr 24:22 \ft Or \fqa Assyria\ft ; also in verse 24\f* \w takes you captive|strong="H7617"\w*.”
\p \v 23 \w Once more Balaam lifted up|strong="H5375"\w* \w an oracle|strong="H4912"\w*, \w saying|strong="H559"\w*:
\q1 “\w Ah|strong="H188"\w*, \w who|strong="H4310"\w* \w can live|strong="H2421"\w*
\q2 \w unless God|strong="H410"\w* \w has ordained it|strong="H7760"\w*?
