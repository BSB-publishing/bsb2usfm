\li1 \v 20 \w The tribe|strong="H4294"\w* \w of Manasseh|strong="H4519"\w* \w will be next to it|strong="H5921"\w*. \w The leader|strong="H5387"\w* \w of the Manassites|strong="H1121"\w* \w is Gamaliel|strong="H1583"\w* \w son|strong="H1121"\w* \w of Pedahzur|strong="H6301"\w*, \v 21 \w and his division|strong="H6635"\w* \w numbers|strong="H6485"\w* \w 32,200|strong="H8147"\w*.
\li1 \v 22 \w Next will be the tribe|strong="H4294"\w* \w of Benjamin|strong="H1144"\w*. \w The leader|strong="H5387"\w* \w of the Benjamites|strong="H1121"\w* \w is Abidan|strong="H27"\w* \w son|strong="H1121"\w* \w of Gideoni|strong="H1441"\w*, \v 23 \w and his division|strong="H6635"\w* \w numbers|strong="H6485"\w* \w 35,400|strong="H2568"\w*.
\pmo \v 24 \w The total|strong="H3605"\w* \w number of men|strong="H6485"\w* \w in the divisions|strong="H6635"\w* \w of the camp|strong="H4264"\w* \w of Ephraim|strong="H669"\w* \w is 108,100|strong="H3967"\w*; \w they shall set out|strong="H5265"\w* \w third|strong="H7992"\w*.
\p \v 25 \w On the north side|strong="H6828"\w*, \w the divisions|strong="H6635"\w* \w of Dan|strong="H1835"\w* \w are to camp|strong="H4264"\w* \w under their standard|strong="H1714"\w*:
\li1 \w The leader|strong="H5387"\w* \w of the Danites|strong="H1121"\w* \w is Ahiezer|strong="H295"\w* \w son|strong="H1121"\w* \w of Ammishaddai|strong="H5996"\w*, \v 26 \w and his division|strong="H6635"\w* \w numbers|strong="H6485"\w* \w 62,700|strong="H8147"\w*.
\li1 \v 27 \w The tribe|strong="H4294"\w* \w of Asher|strong="H836"\w* \w will camp|strong="H2583"\w* \w next to it|strong="H5921"\w*. \w The leader|strong="H5387"\w* \w of the Asherites|strong="H1121"\w* \w is Pagiel|strong="H6295"\w* \w son|strong="H1121"\w* \w of Ocran|strong="H5918"\w*, \v 28 \w and his division|strong="H6635"\w* \w numbers|strong="H6485"\w* \w 41,500|strong="H259"\w*.
\li1 \v 29 \w Next will be the tribe|strong="H4294"\w* \w of Naphtali|strong="H5321"\w*. \w The leader|strong="H5387"\w* \w of the Naphtalites|strong="H1121"\w* \w is Ahira|strong="H299"\w* \w son|strong="H1121"\w* \w of Enan|strong="H5881"\w*, \v 30 \w and his division|strong="H6635"\w* \w numbers|strong="H6485"\w* \w 53,400|strong="H7969"\w*.
\pmo \v 31 \w The total|strong="H3605"\w* \w number of men|strong="H6485"\w* \w in the camp|strong="H4264"\w* \w of Dan|strong="H1835"\w* \w is 157,600|strong="H3967"\w*; \w they shall set out|strong="H5265"\w* \w last|strong="H314"\w*, \w under their standards|strong="H1714"\w*.”
\p \v 32 \w These|strong="H428"\w* \w are the Israelites|strong="H1121"\w*, \w numbered|strong="H6485"\w* \w according to their families|strong="H1"\w*. \w The total|strong="H3605"\w* \w of those counted|strong="H6485"\w* \w in the camps|strong="H4264"\w*, \w by their divisions|strong="H6635"\w*, \w was 603,550|strong="H8337"\w*. \v 33 \w But the Levites|strong="H3881"\w* \w were not|strong="H3808"\w* \w counted|strong="H6485"\w* \w among|strong="H8432"\w* \w the other Israelites|strong="H1121"\w*, \w as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w Moses|strong="H4872"\w*.
