\c 1
\s1 The First Census of Israel
\r (\ref Numbers 26:1–4|NUM 26:1-4\ref*)
\p \v 1 \w On the first|strong="H259"\w* \w day of the second|strong="H8145"\w* \w month|strong="H2320"\w* \w of the second|strong="H8145"\w* \w year|strong="H8141"\w* \w after the Israelites had come out|strong="H3318"\w* \w of the land|strong="H776"\w* \w of Egypt|strong="H4714"\w*, \w the LORD|strong="H3068"\w* \w spoke|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w* \w in the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w* \w in the Wilderness|strong="H4057"\w* \w of Sinai|strong="H5514"\w*. \w He said|strong="H559"\w*: \v 2 “\w Take a census|strong="H5375"\w* \w of the whole|strong="H3605"\w* \w congregation|strong="H5712"\w* \w of Israel|strong="H3478"\w* \w by their clans|strong="H4940"\w* \w and families|strong="H1"\w*, \w listing|strong="H4557"\w* \w every|strong="H3605"\w* \w man|strong="H2145"\w* \w by name|strong="H8034"\w*, \w one by one|strong="H1538"\w*.
\p \v 3 \w You|strong="H859"\w* \w and Aaron|strong="H175"\w* \w are to number|strong="H6485"\w* \w those|strong="H853"\w* \w who are twenty|strong="H6242"\w* \w years of age|strong="H1121"\w* \w or older|strong="H4605"\w* \w by their divisions|strong="H6635"\w*— \w everyone|strong="H3605"\w* \w who can serve|strong="H3318"\w* \w in Israel’s|strong="H3478"\w* \w army|strong="H6635"\w*. \v 4 \w And one man|strong="H376"\w* \w from each tribe|strong="H4294"\w*, \w the head|strong="H7218"\w* \w of each family|strong="H1"\w*, \w must be there|strong="H1961"\w* \w with you|strong="H854"\w*.
\s1 The Leaders of the Tribes
\p \v 5 \w These|strong="H428"\w* \w are the names|strong="H8034"\w* \w of the men|strong="H582"\w* \w who|strong="H834"\w* \w are to assist|strong="H5975"\w* \w you|strong="H854"\w*:
\li1 \w From the tribe of Reuben|strong="H7205"\w*, \w Elizur|strong="H468"\w* \w son|strong="H1121"\w* \w of Shedeur|strong="H7707"\w*;
\li1 \v 6 \w from Simeon|strong="H8095"\w*, \w Shelumiel|strong="H8017"\w* \w son|strong="H1121"\w* \w of Zurishaddai|strong="H6701"\w*;
\li1 \v 7 \w from Judah|strong="H3063"\w*, \w Nahshon|strong="H5177"\w* \w son|strong="H1121"\w* \w of Amminadab|strong="H5992"\w*;
\li1 \v 8 \w from Issachar|strong="H3485"\w*, \w Nethanel|strong="H5417"\w* \w son|strong="H1121"\w* \w of Zuar|strong="H6686"\w*;
\li1 \v 9 \w from Zebulun|strong="H2074"\w*, \w Eliab|strong="H446"\w* \w son|strong="H1121"\w* \w of Helon|strong="H2497"\w*;
\li1 \v 10 \w from the sons|strong="H1121"\w* \w of Joseph|strong="H3130"\w*:
\li2 \w from Ephraim|strong="H669"\w*, \w Elishama|strong="H476"\w* \w son|strong="H1121"\w* \w of Ammihud|strong="H5989"\w*,
\li2 \w and from Manasseh|strong="H4519"\w*, \w Gamaliel|strong="H1583"\w* \w son|strong="H1121"\w* \w of Pedahzur|strong="H6301"\w*;
\li1 \v 11 \w from Benjamin|strong="H1144"\w*, \w Abidan|strong="H27"\w* \w son|strong="H1121"\w* \w of Gideoni|strong="H1441"\w*;
\li1 \v 12 \w from Dan|strong="H1835"\w*, \w Ahiezer|strong="H295"\w* \w son|strong="H1121"\w* \w of Ammishaddai|strong="H5996"\w*;
\li1 \v 13 \w from Asher|strong="H836"\w*, \w Pagiel|strong="H6295"\w* \w son|strong="H1121"\w* \w of Ocran|strong="H5918"\w*;
\li1 \v 14 \w from Gad|strong="H1410"\w*, \w Eliasaph|strong="H460"\w* \w son|strong="H1121"\w* \w of Deuel|strong="H1845"\w*;
\li1 \v 15 \w and from Naphtali|strong="H5321"\w*, \w Ahira|strong="H299"\w* \w son|strong="H1121"\w* \w of Enan|strong="H5881"\w*.”
\p \v 16 \w These men|strong="H428"\w* \w were appointed|strong="H7148"\w* \w from the congregation|strong="H5712"\w*; \w they were|strong="H1992"\w* \w the leaders|strong="H5387"\w* \w of the tribes|strong="H4294"\w* \w of their fathers|strong="H1"\w*, \w the heads|strong="H7218"\w* \w of the clans|strong="H505"\w* \w of Israel|strong="H3478"\w*.
\s1 The Number of Every Tribe
\p \v 17 \w So Moses|strong="H4872"\w* \w and Aaron|strong="H175"\w* \w took|strong="H3947"\w* \w these men|strong="H428"\w* \w who|strong="H834"\w* \w had been designated|strong="H5344"\w* \w by name|strong="H8034"\w*, \v 18 \w and|strong="H853"\w* \w on the first|strong="H259"\w* \w day of the second|strong="H8145"\w* \w month|strong="H2320"\w* \w they assembled|strong="H6950"\w* \w the whole|strong="H3605"\w* \w congregation|strong="H5712"\w* \w and recorded their ancestry|strong="H3205"\w* \w by|strong="H5921"\w* \w clans|strong="H4940"\w* \w and families|strong="H1"\w*, \w counting|strong="H4557"\w* \w one by one|strong="H1538"\w* \w the names|strong="H8034"\w* \w of those twenty|strong="H6242"\w* \w years of age|strong="H1121"\w* \w or older|strong="H4605"\w*, \v 19 \w just as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w Moses|strong="H4872"\w*.
\p \w So Moses numbered them|strong="H6485"\w* \w in the Wilderness|strong="H4057"\w* \w of Sinai|strong="H5514"\w*:
\li1 \v 20 \w From the sons|strong="H1121"\w* \w of Reuben|strong="H7205"\w*, \w the firstborn|strong="H1060"\w* \w of Israel|strong="H3478"\w*, \w according to the records|strong="H8435"\w* \w of their clans|strong="H4940"\w* \w and families|strong="H1"\w*, \w counting|strong="H4557"\w* \w one|strong="H1538"\w* \w by one the names|strong="H8034"\w* \w of every|strong="H3605"\w* \w male|strong="H2145"\w* \w twenty|strong="H6242"\w* \w years of age|strong="H1121"\w* \w or older|strong="H4605"\w* \w who could serve|strong="H3318"\w* \w in the army|strong="H6635"\w*, \v 21 \w those registered|strong="H6485"\w* \w to the tribe|strong="H4294"\w* \w of Reuben|strong="H7205"\w* \w numbered 46,500|strong="H8337"\w*.
\li1 \v 22 \w From the sons|strong="H1121"\w* \w of Simeon|strong="H8095"\w*, \w according to the records|strong="H8435"\w* \w of their clans|strong="H4940"\w* \w and families|strong="H1"\w*, \w counting|strong="H4557"\w* \w one by one|strong="H1538"\w* \w the names|strong="H8034"\w* \w of every|strong="H3605"\w* \w male|strong="H2145"\w* \w twenty|strong="H6242"\w* \w years of age|strong="H1121"\w* \w or older|strong="H4605"\w* \w who could serve|strong="H3318"\w* \w in the army|strong="H6635"\w*, \v 23 \w those registered|strong="H6485"\w* \w to the tribe|strong="H4294"\w* \w of Simeon|strong="H8095"\w* \w numbered 59,300|strong="H8672"\w*.
\li1 \v 24 \w From the sons|strong="H1121"\w* \w of Gad|strong="H1410"\w*, \w according to the records|strong="H8435"\w* \w of their clans|strong="H4940"\w* \w and families|strong="H1"\w*, \w counting|strong="H4557"\w* \w the names|strong="H8034"\w* \w of all those|strong="H3605"\w* \w twenty|strong="H6242"\w* \w years of age|strong="H1121"\w* \w or older|strong="H4605"\w* \w who could serve|strong="H3318"\w* \w in the army|strong="H6635"\w*, \v 25 \w those registered|strong="H6485"\w* \w to the tribe|strong="H4294"\w* \w of Gad|strong="H1410"\w* \w numbered 45,650|strong="H2568"\w*.
\li1 \v 26 \w From the sons|strong="H1121"\w* \w of Judah|strong="H3063"\w*, \w according to the records|strong="H8435"\w* \w of their clans|strong="H4940"\w* \w and families|strong="H1"\w*, \w counting|strong="H4557"\w* \w the names|strong="H8034"\w* \w of all those|strong="H3605"\w* \w twenty|strong="H6242"\w* \w years of age|strong="H1121"\w* \w or older|strong="H4605"\w* \w who could serve|strong="H3318"\w* \w in the army|strong="H6635"\w*, \v 27 \w those registered|strong="H6485"\w* \w to the tribe|strong="H4294"\w* \w of Judah|strong="H3063"\w* \w numbered 74,600|strong="H702"\w*.
\li1 \v 28 \w From the sons|strong="H1121"\w* \w of Issachar|strong="H3485"\w*, \w according to the records|strong="H8435"\w* \w of their clans|strong="H4940"\w* \w and families|strong="H1"\w*, \w counting|strong="H4557"\w* \w the names|strong="H8034"\w* \w of all those|strong="H3605"\w* \w twenty|strong="H6242"\w* \w years of age|strong="H1121"\w* \w or older|strong="H4605"\w* \w who could serve|strong="H3318"\w* \w in the army|strong="H6635"\w*, \v 29 \w those registered|strong="H6485"\w* \w to the tribe|strong="H4294"\w* \w of Issachar|strong="H3485"\w* \w numbered 54,400|strong="H702"\w*.
\li1 \v 30 \w From the sons|strong="H1121"\w* \w of Zebulun|strong="H2074"\w*, \w according to the records|strong="H8435"\w* \w of their clans|strong="H4940"\w* \w and families|strong="H1"\w*, \w counting|strong="H4557"\w* \w the names|strong="H8034"\w* \w of all those|strong="H3605"\w* \w twenty|strong="H6242"\w* \w years of age|strong="H1121"\w* \w or older|strong="H4605"\w* \w who could serve|strong="H3318"\w* \w in the army|strong="H6635"\w*, \v 31 \w those registered|strong="H6485"\w* \w to the tribe|strong="H4294"\w* \w of Zebulun|strong="H2074"\w* \w numbered 57,400|strong="H7651"\w*.
\li1 \v 32 \w From the sons|strong="H1121"\w* \w of Joseph|strong="H3130"\w*:
\li2 \w From the sons|strong="H1121"\w* \w of Ephraim|strong="H669"\w*, \w according to the records|strong="H8435"\w* \w of their clans|strong="H4940"\w* \w and families|strong="H1"\w*, \w counting|strong="H4557"\w* \w the names|strong="H8034"\w* \w of all those|strong="H3605"\w* \w twenty|strong="H6242"\w* \w years of age|strong="H1121"\w* \w or older|strong="H4605"\w* \w who could serve|strong="H3318"\w* \w in the army|strong="H6635"\w*, \v 33 \w those registered|strong="H6485"\w* \w to the tribe|strong="H4294"\w* \w of Ephraim|strong="H669"\w* \w numbered 40,500|strong="H705"\w*.
\li2 \v 34 \w And from the sons|strong="H1121"\w* \w of Manasseh|strong="H4519"\w*, \w according to the records|strong="H8435"\w* \w of their clans|strong="H4940"\w* \w and families|strong="H1"\w*, \w counting|strong="H4557"\w* \w the names|strong="H8034"\w* \w of all those|strong="H3605"\w* \w twenty|strong="H6242"\w* \w years of age|strong="H1121"\w* \w or older|strong="H4605"\w* \w who could serve|strong="H3318"\w* \w in the army|strong="H6635"\w*, \v 35 \w those registered|strong="H6485"\w* \w to the tribe|strong="H4294"\w* \w of Manasseh|strong="H4519"\w* \w numbered 32,200|strong="H8147"\w*.
\li1 \v 36 \w From the sons|strong="H1121"\w* \w of Benjamin|strong="H1144"\w*, \w according to the records|strong="H8435"\w* \w of their clans|strong="H4940"\w* \w and families|strong="H1"\w*, \w counting|strong="H4557"\w* \w the names|strong="H8034"\w* \w of all those|strong="H3605"\w* \w twenty|strong="H6242"\w* \w years of age|strong="H1121"\w* \w or older|strong="H4605"\w* \w who could serve|strong="H3318"\w* \w in the army|strong="H6635"\w*, \v 37 \w those registered|strong="H6485"\w* \w to the tribe|strong="H4294"\w* \w of Benjamin|strong="H1144"\w* \w numbered 35,400|strong="H2568"\w*.
\li1 \v 38 \w From the sons|strong="H1121"\w* \w of Dan|strong="H1835"\w*, \w according to the records|strong="H8435"\w* \w of their clans|strong="H4940"\w* \w and families|strong="H1"\w*, \w counting|strong="H4557"\w* \w the names|strong="H8034"\w* \w of all those|strong="H3605"\w* \w twenty|strong="H6242"\w* \w years of age|strong="H1121"\w* \w or older|strong="H4605"\w* \w who could serve|strong="H3318"\w* \w in the army|strong="H6635"\w*, \v 39 \w those registered|strong="H6485"\w* \w to the tribe|strong="H4294"\w* \w of Dan|strong="H1835"\w* \w numbered 62,700|strong="H8147"\w*.
\li1 \v 40 \w From the sons|strong="H1121"\w* \w of Asher|strong="H836"\w*, \w according to the records|strong="H8435"\w* \w of their clans|strong="H4940"\w* \w and families|strong="H1"\w*, \w counting|strong="H4557"\w* \w the names|strong="H8034"\w* \w of all those|strong="H3605"\w* \w twenty|strong="H6242"\w* \w years of age|strong="H1121"\w* \w or older|strong="H4605"\w* \w who could serve|strong="H3318"\w* \w in the army|strong="H6635"\w*, \v 41 \w those registered|strong="H6485"\w* \w to the tribe|strong="H4294"\w* \w of Asher|strong="H836"\w* \w numbered 41,500|strong="H259"\w*.
\li1 \v 42 \w From the sons|strong="H1121"\w* \w of Naphtali|strong="H5321"\w*, \w according to the records|strong="H8435"\w* \w of their clans|strong="H4940"\w* \w and families|strong="H1"\w*, \w counting|strong="H4557"\w* \w the names|strong="H8034"\w* \w of all those|strong="H3605"\w* \w twenty|strong="H6242"\w* \w years of age|strong="H1121"\w* \w or older|strong="H4605"\w* \w who could serve|strong="H3318"\w* \w in the army|strong="H6635"\w*, \v 43 \w those registered|strong="H6485"\w* \w to the tribe|strong="H4294"\w* \w of Naphtali|strong="H5321"\w* \w numbered 53,400|strong="H7969"\w*.
\p \v 44 \w These|strong="H428"\w* \w were the men|strong="H834"\w* \w numbered|strong="H6485"\w* \w by Moses|strong="H4872"\w* \w and Aaron|strong="H175"\w*, \w with the assistance of the twelve|strong="H8147"\w* \w leaders|strong="H5387"\w* \w of Israel|strong="H3478"\w*, \w each one|strong="H259"\w* \w representing his family|strong="H1"\w*. \v 45 \w So all|strong="H3605"\w* \w the Israelites|strong="H1121"\w* \w twenty|strong="H6242"\w* \w years of age|strong="H1121"\w* \w or older|strong="H4605"\w* \w who could serve|strong="H3318"\w* \w in Israel’s|strong="H3478"\w* \w army|strong="H6635"\w* \w were|strong="H1961"\w* \w counted|strong="H6485"\w* \w according to their families|strong="H1"\w*. \v 46 \w And|strong="H1961"\w* \w all|strong="H3605"\w* \w those counted|strong="H6485"\w* \w totaled 603,550|strong="H8337"\w*.
\s1 The Exemption of the Levites
\p \v 47 \w The Levites, however|strong="H3881"\w*, \w were not|strong="H3808"\w* \w numbered|strong="H6485"\w* \w along with them|strong="H8432"\w* \w by the tribe|strong="H4294"\w* \w of their fathers|strong="H1"\w*. \v 48 \w For the LORD|strong="H3068"\w* \w had said to|strong="H1696"\w* \w Moses|strong="H4872"\w*: \v 49 “\w Do not|strong="H3808"\w* \w number|strong="H6485"\w* \w the tribe|strong="H4294"\w* \w of Levi|strong="H3878"\w* \w in the census|strong="H7218"\w* \w with|strong="H8432"\w* \w the other Israelites|strong="H1121"\w*. \v 50 \w Instead|strong="H859"\w*, \w you are to appoint|strong="H6485"\w* \w the Levites|strong="H3881"\w* \w over|strong="H5921"\w* \w the tabernacle|strong="H4908"\w* \w of the Testimony|strong="H5715"\w*, \w all|strong="H3605"\w* \w its furnishings|strong="H3627"\w*, \w and everything|strong="H3605"\w* in it. \w They|strong="H1992"\w* \w shall carry|strong="H5375"\w* \w the tabernacle|strong="H4908"\w* \w and all|strong="H3605"\w* \w its articles|strong="H3627"\w*, \w care for it|strong="H8334"\w*, \w and camp|strong="H2583"\w* \w around|strong="H5439"\w* \w it|strong="H4908"\w*.
\p \v 51 \w Whenever the tabernacle|strong="H4908"\w* \w is to move|strong="H5265"\w*, \w the Levites|strong="H3881"\w* \w are to take it down|strong="H3381"\w*, \w and whenever it|strong="H4908"\w* \w is to be pitched|strong="H2583"\w*, \w the Levites|strong="H3881"\w* \w are to set it up|strong="H6965"\w*. \w Any outsider|strong="H2114"\w* \w who goes near it|strong="H7131"\w* \w must be put to death|strong="H4191"\w*.
\p \v 52 \w The Israelites|strong="H1121"\w* \w are to camp|strong="H2583"\w* \w by their divisions|strong="H6635"\w*, \w each man|strong="H376"\w* \w in|strong="H5921"\w* \w his own camp|strong="H4264"\w* \w and under|strong="H5921"\w* \w his own standard|strong="H1714"\w*. \v 53 \w But the Levites|strong="H3881"\w* \w are to camp|strong="H2583"\w* \w around|strong="H5439"\w* \w the tabernacle|strong="H4908"\w* \w of the Testimony|strong="H5715"\w* \w and watch over it|strong="H8104"\w*, \w so that no|strong="H3808"\w* \w wrath|strong="H7110"\w* \w will fall|strong="H1961"\w* \w on|strong="H5921"\w* \w the congregation|strong="H5712"\w* \w of Israel|strong="H3478"\w*. \w So the Levites|strong="H3881"\w* \w are responsible|strong="H4931"\w* \w for the tabernacle|strong="H4908"\w* \w of the Testimony|strong="H5715"\w*.”
\p \v 54 \w Thus the Israelites|strong="H1121"\w* \w did|strong="H6213"\w* \w everything|strong="H3605"\w* \w just as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w Moses|strong="H4872"\w*.
\c 2
\s1 The Order of the Camps
\p \v 1 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w* \w and Aaron|strong="H175"\w*: \v 2 “\w The Israelites|strong="H1121"\w* \w are to camp|strong="H2583"\w* \w around|strong="H5439"\w* \w the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w* \w at a distance from it|strong="H5048"\w*, \w each man|strong="H376"\w* \w under|strong="H5921"\w* \w his standard|strong="H1714"\w*, \w with the banners|strong="H226"\w* \w of his family|strong="H1"\w*.
\p \v 3 \w On the east side|strong="H6924"\w*, \w toward the sunrise|strong="H4217"\w*, \w the divisions|strong="H6635"\w* \w of Judah|strong="H3063"\w* \w are to camp|strong="H2583"\w* \w under their standard|strong="H1714"\w*:
\li1 \w The leader|strong="H5387"\w* \w of the Judahites|strong="H3063"\w* \w is Nahshon|strong="H5177"\w* \w son|strong="H1121"\w* \w of Amminadab|strong="H5992"\w*, \v 4 \w and his division|strong="H6635"\w* \w numbers|strong="H6485"\w* \w 74,600|strong="H702"\w*.
\li1 \v 5 \w The tribe|strong="H4294"\w* \w of Issachar|strong="H3485"\w* \w will camp|strong="H2583"\w* \w next to it|strong="H5921"\w*. \w The leader|strong="H5387"\w* \w of the Issacharites|strong="H1121"\w* \w is Nethanel|strong="H5417"\w* \w son|strong="H1121"\w* \w of Zuar|strong="H6686"\w*, \v 6 \w and his division|strong="H6635"\w* \w numbers|strong="H6485"\w* \w 54,400|strong="H702"\w*.
\li1 \v 7 \w Next will be the tribe|strong="H4294"\w* \w of Zebulun|strong="H2074"\w*. \w The leader|strong="H5387"\w* \w of the Zebulunites|strong="H1121"\w* \w is Eliab|strong="H446"\w* \w son|strong="H1121"\w* \w of Helon|strong="H2497"\w*, \v 8 \w and his division|strong="H6635"\w* \w numbers|strong="H6485"\w* \w 57,400|strong="H7651"\w*.
\pmo \v 9 \w The total|strong="H3605"\w* \w number of men|strong="H6485"\w* \w in the divisions|strong="H6635"\w* \w of the camp|strong="H4264"\w* \w of Judah|strong="H3063"\w* \w is 186,400|strong="H3967"\w*; \w they shall set out|strong="H5265"\w* \w first|strong="H7223"\w*.
\p \v 10 \w On the south side|strong="H8486"\w*, \w the divisions|strong="H6635"\w* \w of Reuben|strong="H7205"\w* \w are to camp|strong="H4264"\w* \w under their standard|strong="H1714"\w*:
\li1 \w The leader|strong="H5387"\w* \w of the Reubenites|strong="H1121"\w* \w is Elizur|strong="H468"\w* \w son|strong="H1121"\w* \w of Shedeur|strong="H7707"\w*, \v 11 \w and his division|strong="H6635"\w* \w numbers|strong="H6485"\w* \w 46,500|strong="H8337"\w*.
\li1 \v 12 \w The tribe|strong="H4294"\w* \w of Simeon|strong="H8095"\w* \w will camp|strong="H2583"\w* \w next to it|strong="H5921"\w*. \w The leader|strong="H5387"\w* \w of the Simeonites|strong="H1121"\w* \w is Shelumiel|strong="H8017"\w* \w son|strong="H1121"\w* \w of Zurishaddai|strong="H6701"\w*, \v 13 \w and his division|strong="H6635"\w* \w numbers|strong="H6485"\w* \w 59,300|strong="H8672"\w*.
\li1 \v 14 \w Next will be the tribe|strong="H4294"\w* \w of Gad|strong="H1410"\w*. \w The leader|strong="H5387"\w* \w of the Gadites|strong="H1121"\w* \w is Eliasaph|strong="H460"\w* \w son|strong="H1121"\w* \w of Deuel|strong="H7467"\w*,\f + \fr 2:14 \ft Many MT manuscripts, SP, and Vulgate (see also \ref Numbers 1:14|NUM 1:14\ref*); most MT manuscripts \fqa Reuel\f* \v 15 \w and his division|strong="H6635"\w* \w numbers|strong="H6485"\w* \w 45,650|strong="H2568"\w*.
