\p \v 8 \w Now the son|strong="H1121"\w* \w of Pallu|strong="H6396"\w* \w was Eliab|strong="H446"\w*, \v 9 \w and the sons|strong="H1121"\w* \w of Eliab|strong="H446"\w* \w were Nemuel|strong="H5241"\w*, \w Dathan|strong="H1885"\w*, \w and Abiram|strong="H48"\w*.
\p \w It|strong="H1931"\w* \w was Dathan|strong="H1885"\w* \w and Abiram|strong="H48"\w*, \w chosen|strong="H7121"\w* \w by the congregation|strong="H5712"\w*, \w who|strong="H834"\w* \w rebelled|strong="H5327"\w* \w against|strong="H5921"\w* \w Moses|strong="H4872"\w* \w and|strong="H5921"\w* \w Aaron|strong="H175"\w* \w with the followers|strong="H5712"\w* \w of Korah|strong="H7141"\w* \w who rebelled|strong="H5327"\w* \w against|strong="H5921"\w* \w the LORD|strong="H3068"\w*. \v 10 \w And the earth|strong="H776"\w* \w opened|strong="H6605"\w* \w its mouth|strong="H6310"\w* \w and swallowed|strong="H1104"\w* \w them|strong="H853"\w* \w along with Korah|strong="H7141"\w*, \w whose followers|strong="H5712"\w* \w died|strong="H4191"\w* \w when the fire|strong="H784"\w* \w consumed|strong="H398"\w* \w 250|strong="H2572"\w* \w men|strong="H376"\w*. \w They serve|strong="H1961"\w* \w as a warning sign|strong="H5251"\w*. \v 11 \w However, the line|strong="H1121"\w* \w of Korah|strong="H7141"\w* \w did not|strong="H3808"\w* \w die out|strong="H4191"\w*.
