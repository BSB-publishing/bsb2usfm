\p \v 8 \w The next day|strong="H4283"\w* \w Moses|strong="H4872"\w* \w entered|strong="H935"\w* \w the Tent|strong="H168"\w* \w of the Testimony|strong="H5715"\w* \w and saw|strong="H2009"\w* \w that Aaron’s|strong="H175"\w* \w staff|strong="H4294"\w*, \w representing the house|strong="H1004"\w* \w of Levi|strong="H3878"\w*, \w had sprouted|strong="H6524"\w*, \w put forth|strong="H3318"\w* \w buds|strong="H6525"\w*, \w blossomed|strong="H6692"\w*, \w and produced|strong="H1580"\w* \w almonds|strong="H8247"\w*. \v 9 \w Then Moses|strong="H4872"\w* \w brought out|strong="H3318"\w* \w all|strong="H3605"\w* \w the staffs|strong="H4294"\w* \w from the LORD’s|strong="H3068"\w* \w presence|strong="H6440"\w* \w to|strong="H413"\w* \w all|strong="H3605"\w* \w the Israelites|strong="H1121"\w*. \w They saw them|strong="H7200"\w*, \w and each man|strong="H376"\w* \w took|strong="H3947"\w* \w his own staff|strong="H4294"\w*.
\p \v 10 \w The LORD|strong="H3068"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, “\w Put|strong="H7725"\w* \w Aaron’s|strong="H175"\w* \w staff|strong="H4294"\w* \w back in front of|strong="H6440"\w* \w the Testimony|strong="H5715"\w*, \w to be kept|strong="H4931"\w* \w as a sign|strong="H226"\w* \w for the rebellious|strong="H1121"\w*, \w so that you may put an end|strong="H3615"\w* \w to their grumbling|strong="H8519"\w* \w against Me|strong="H5921"\w*, \w lest|strong="H3808"\w* \w they die|strong="H4191"\w*.” \v 11 \w So Moses|strong="H4872"\w* \w did|strong="H6213"\w* \w as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded him|strong="H6680"\w*.
\p \v 12 \w Then the Israelites|strong="H1121"\w* \w declared|strong="H559"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, “\w Look|strong="H2005"\w*, \w we are perishing|strong="H1478"\w*! \w We are lost|strong="H6"\w*; \w we are all|strong="H3605"\w* \w lost|strong="H6"\w*! \v 13 \w Anyone|strong="H3605"\w* \w who comes near|strong="H7131"\w* \w the tabernacle|strong="H4908"\w* \w of the LORD|strong="H3068"\w* \w will die|strong="H4191"\w*. \w Are we all|strong="H8552"\w* \w going to perish|strong="H1478"\w*?”
\c 18
\s1 Duties of Priests and Levites
\p \v 1 \w So the LORD|strong="H3068"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w Aaron|strong="H175"\w*, “\w You|strong="H859"\w* \w and your sons|strong="H1121"\w* \w and your father’s|strong="H1"\w* \w house|strong="H1004"\w* \w must bear|strong="H5375"\w* \w the iniquity involving|strong="H5771"\w* \w the sanctuary|strong="H4720"\w*. \w And you|strong="H859"\w* \w and your sons|strong="H1121"\w* \w alone|strong="H854"\w* \w must bear|strong="H5375"\w* \w the iniquity involving|strong="H5771"\w* \w your priesthood|strong="H3550"\w*. \v 2 \w But bring|strong="H7126"\w* \w with you|strong="H854"\w* \w also|strong="H1571"\w* \w your brothers|strong="H251"\w* \w from the tribe|strong="H4294"\w* \w of Levi|strong="H3878"\w*, \w the tribe|strong="H7626"\w* \w of your father|strong="H1"\w*, \w that they may join|strong="H3867"\w* \w you|strong="H5921"\w* \w and assist|strong="H8334"\w* \w you|strong="H859"\w* \w and your sons|strong="H1121"\w* \w before|strong="H6440"\w* \w the Tent|strong="H168"\w* \w of the Testimony|strong="H5715"\w*. \v 3 \w And they shall attend|strong="H8104"\w* \w to your duties|strong="H4931"\w* \w and to all the duties|strong="H4931"\w* \w of the Tent|strong="H168"\w*; \w but|strong="H413"\w* \w they must not|strong="H3808"\w* \w come near|strong="H7126"\w* \w to the furnishings|strong="H3627"\w* \w of the sanctuary|strong="H6944"\w* \w or|strong="H413"\w* \w the altar|strong="H4196"\w*, \w or|strong="H3808"\w* \w both|strong="H1571"\w* \w they|strong="H1992"\w* \w and|strong="H1571"\w* \w you|strong="H859"\w* \w will die|strong="H4191"\w*. \v 4 \w They are to join|strong="H3867"\w* \w you|strong="H5921"\w* \w and attend|strong="H8104"\w* \w to the duties|strong="H4931"\w* \w of the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*, \w doing all|strong="H3605"\w* \w the work|strong="H5656"\w* \w at the Tent|strong="H168"\w*; \w but no|strong="H3808"\w* \w outsider|strong="H2114"\w* \w may come near|strong="H7126"\w* \w you|strong="H413"\w*.
\p \v 5 \w And you shall attend|strong="H8104"\w* \w to the duties|strong="H4931"\w* \w of the sanctuary|strong="H6944"\w* \w and|strong="H853"\w* \w of the altar|strong="H4196"\w*, \w so that wrath|strong="H7110"\w* \w may not|strong="H3808"\w* \w fall|strong="H1961"\w* \w on|strong="H5921"\w* \w the Israelites|strong="H1121"\w* \w again|strong="H5750"\w*. \v 6 \w Behold|strong="H2009"\w*, \w I Myself|strong="H589"\w* \w have selected|strong="H3947"\w* \w your fellow|strong="H251"\w* \w Levites|strong="H3881"\w* \w from|strong="H8432"\w* \w the Israelites|strong="H1121"\w* \w as a gift|strong="H4979"\w* to you, \w dedicated|strong="H5414"\w* \w to the LORD|strong="H3068"\w* \w to perform|strong="H5647"\w* \w the service|strong="H5656"\w* \w for the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \v 7 \w But only you|strong="H859"\w* \w and your sons|strong="H1121"\w* \w shall attend|strong="H8104"\w* \w to your priesthood|strong="H3550"\w* \w for everything|strong="H3605"\w* \w concerning|strong="H1697"\w* \w the altar|strong="H4196"\w* \w and what is inside|strong="H1004"\w* \w the veil|strong="H6532"\w*, \w and you are to perform that service|strong="H5647"\w*. \w I am giving|strong="H5414"\w* \w you the work|strong="H5656"\w* \w of the priesthood|strong="H3550"\w* \w as a gift|strong="H4979"\w*, \w but any outsider|strong="H2114"\w* \w who comes near the sanctuary|strong="H7131"\w* \w must be put to death|strong="H4191"\w*.”
\s1 Offerings for Priests and Levites
\p \v 8 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Aaron|strong="H175"\w*, “\w Behold|strong="H2009"\w*, \w I|strong="H589"\w* \w have put|strong="H5414"\w* you \w in charge|strong="H4931"\w* \w of My offerings|strong="H8641"\w*. \w As for all|strong="H3605"\w* \w the sacred offerings|strong="H6944"\w* \w of the Israelites|strong="H3478"\w*, \w I have given them|strong="H5414"\w* to you \w and your sons|strong="H1121"\w* \w as a portion|strong="H4888"\w* \w and a permanent|strong="H5769"\w* \w statute|strong="H2706"\w*. \v 9 \w A portion of|strong="H4480"\w* \w the most holy offerings|strong="H6944"\w* \w reserved from the fire|strong="H784"\w* \w will be|strong="H1961"\w* yours. \w From all|strong="H3605"\w* \w the offerings|strong="H7133"\w* \w they render|strong="H7725"\w* to Me \w as most holy offerings|strong="H6944"\w*, \w whether grain offerings|strong="H4503"\w* \w or sin offerings|strong="H2403"\w* \w or guilt offerings|strong="H817"\w*, \w that part belongs|strong="H1931"\w* to you \w and your sons|strong="H1121"\w*. \v 10 \w You are to eat it|strong="H398"\w* \w as a most holy offering|strong="H6944"\w*,\f + \fr 18:10 \ft Or \fqa You are to eat it in a most holy place\f* \w and every|strong="H3605"\w* \w male|strong="H2145"\w* \w may eat|strong="H398"\w* \w it|strong="H853"\w*. \w You shall regard it|strong="H1961"\w* \w as holy|strong="H6944"\w*.
\p \v 11 \w And this|strong="H2088"\w* is yours as well: \w the offering|strong="H8641"\w* \w of their gifts|strong="H4976"\w*, \w along with all|strong="H3605"\w* \w the wave offerings|strong="H8573"\w* \w of the Israelites|strong="H3478"\w*. \w I have given this|strong="H5414"\w* to you \w and your sons|strong="H1121"\w* \w and daughters|strong="H1323"\w* \w as a permanent|strong="H5769"\w* \w statute|strong="H2706"\w*. \w Every|strong="H3605"\w* \w ceremonially clean person|strong="H2889"\w* \w in your household|strong="H1004"\w* \w may eat it|strong="H398"\w*. \v 12 \w I give you|strong="H5414"\w* \w all|strong="H3605"\w* \w the freshest|strong="H2459"\w* \w olive oil|strong="H3323"\w* \w and all|strong="H3605"\w* \w the finest|strong="H2459"\w* \w new wine|strong="H8492"\w* \w and grain|strong="H1715"\w* \w that|strong="H834"\w* \w the Israelites give|strong="H5414"\w* \w to the LORD|strong="H3068"\w* \w as their firstfruits|strong="H7225"\w*. \v 13 \w The firstfruits|strong="H1061"\w* \w of everything|strong="H3605"\w* \w in their land|strong="H776"\w* \w that|strong="H834"\w* \w they bring|strong="H935"\w* \w to the LORD|strong="H3068"\w* \w will belong|strong="H1961"\w* to you. \w Every|strong="H3605"\w* \w ceremonially clean person|strong="H2889"\w* \w in your household|strong="H1004"\w* \w may eat them|strong="H398"\w*.
\p \v 14 \w Every|strong="H3605"\w* \w devoted thing|strong="H2764"\w* \w in Israel|strong="H3478"\w* \w belongs to you|strong="H1961"\w*. \v 15 \w The firstborn|strong="H6363"\w* \w of every|strong="H3605"\w* \w womb|strong="H1320"\w*, \w whether|strong="H834"\w* \w man|strong="H120"\w* \w or beast|strong="H929"\w*, \w that is offered|strong="H7126"\w* \w to the LORD|strong="H3068"\w* \w belongs|strong="H1961"\w* to you. \w But|strong="H389"\w* \w you must surely redeem|strong="H6299"\w* \w every firstborn|strong="H1060"\w* \w son|strong="H120"\w* \w and|strong="H6299"\w* \w every firstborn male|strong="H1060"\w* \w of unclean|strong="H2931"\w* \w animals|strong="H929"\w*. \v 16 \w You are to pay the redemption price|strong="H6299"\w* \w for a month-old male|strong="H1121"\w* \w according to your valuation|strong="H6187"\w*: \w five|strong="H2568"\w* \w shekels|strong="H8255"\w* \w of silver|strong="H3701"\w*,\f + \fr 18:16 \fqa 5 shekels\ft is \ref approximately 2|2\ref* ounces or 57 grams of silver.\f* \w according to the sanctuary|strong="H6944"\w* \w shekel|strong="H8255"\w*, \w which|strong="H1931"\w* \w is twenty|strong="H6242"\w* \w gerahs|strong="H1626"\w*.\f + \fr 18:16 \fqa \ref 20|0\ref* gerahs\ft is equivalent to one shekel \ref (approximately 0|0\ref*.4 ounces or 11.4 grams).\f*
\p \v 17 \w But|strong="H389"\w* \w you must not|strong="H3808"\w* \w redeem|strong="H6299"\w* \w the firstborn|strong="H1060"\w* \w of an ox|strong="H7794"\w*, \w a sheep|strong="H3775"\w*, \w or|strong="H176"\w* \w a goat|strong="H5795"\w*; \w they|strong="H1992"\w* \w are holy|strong="H6944"\w*. \w You are to splatter|strong="H2236"\w* \w their blood|strong="H1818"\w* \w on|strong="H5921"\w* \w the altar|strong="H4196"\w* \w and burn|strong="H6999"\w* \w their fat|strong="H2459"\w* \w as a food offering|strong="H801"\w*, \w a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w* \w to the LORD|strong="H3068"\w*. \v 18 \w And their meat|strong="H1320"\w* \w belongs|strong="H1961"\w* to you, \w just as the breast|strong="H2373"\w* \w and right|strong="H3225"\w* \w thigh|strong="H7785"\w* \w of the wave offering|strong="H8573"\w* \w belong|strong="H1961"\w* to you.
\p \v 19 \w All|strong="H3605"\w* \w the holy|strong="H6944"\w* \w offerings|strong="H8641"\w* \w that|strong="H834"\w* \w the Israelites|strong="H3478"\w* \w present|strong="H7311"\w* \w to the LORD|strong="H3068"\w* \w I give|strong="H5414"\w* to you \w and to your sons|strong="H1121"\w* \w and daughters|strong="H1323"\w* \w as a permanent|strong="H5769"\w* \w statute|strong="H2706"\w*. \w It|strong="H1931"\w* \w is a permanent|strong="H5769"\w* \w covenant|strong="H1285"\w* \w of salt|strong="H4417"\w*\f + \fr 18:19 \ft That is, a perpetual covenant\f* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* for you \w and your offspring|strong="H2233"\w*.”
\p \v 20 \w Then the LORD|strong="H3068"\w* \w said|strong="H559"\w* \w to Aaron|strong="H175"\w*, “\w You will have no|strong="H3808"\w* \w inheritance|strong="H5157"\w* \w in their land|strong="H776"\w*, \w nor|strong="H3808"\w* \w will you have|strong="H1961"\w* \w any portion|strong="H2506"\w* \w among them|strong="H8432"\w*. \w I|strong="H589"\w* \w am your portion|strong="H2506"\w* \w and your inheritance|strong="H5159"\w* \w among|strong="H8432"\w* \w the Israelites|strong="H1121"\w*.
\p \v 21 \w Behold|strong="H2009"\w*, \w I have given|strong="H5414"\w* \w to the Levites|strong="H1121"\w* \w all|strong="H3605"\w* \w the tithes|strong="H4643"\w* \w in Israel|strong="H3478"\w* \w as an inheritance|strong="H5159"\w* \w in return for|strong="H2500"\w* \w the work|strong="H5656"\w* \w they|strong="H1992"\w* \w do|strong="H5647"\w*, \w the service|strong="H5656"\w* \w of the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \v 22 \w No|strong="H3808"\w* \w longer|strong="H5750"\w* \w may the Israelites|strong="H1121"\w* \w come|strong="H413"\w* \w near|strong="H7126"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*, \w or they will incur|strong="H5375"\w* \w guilt|strong="H2399"\w* \w and die|strong="H4191"\w*.
\p \v 23 \w The Levites|strong="H3881"\w* \w are to perform|strong="H5647"\w* \w the work|strong="H5656"\w* \w of the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*, \w and they|strong="H1992"\w* \w must bear|strong="H5375"\w* \w their iniquity|strong="H5771"\w*. \w This is a permanent|strong="H5769"\w* \w statute|strong="H2708"\w* \w for the generations to come|strong="H1755"\w*. \w The Levites will not|strong="H3808"\w* \w receive an inheritance|strong="H5157"\w* \w among|strong="H8432"\w* \w the Israelites|strong="H1121"\w*. \v 24 \w For|strong="H3588"\w* \w I have given|strong="H5414"\w* \w to the Levites|strong="H3881"\w* \w as their inheritance|strong="H5159"\w* \w the tithe|strong="H4643"\w* \w that|strong="H834"\w* \w the Israelites|strong="H1121"\w* \w present|strong="H7311"\w* \w to the LORD|strong="H3068"\w* \w as a contribution|strong="H8641"\w*. \w That is why|strong="H5921"\w* \w I told them|strong="H559"\w* \w that they would not|strong="H3808"\w* \w receive an inheritance|strong="H5157"\w* \w among|strong="H8432"\w* \w the Israelites|strong="H1121"\w*.”
\p \v 25 \w And the LORD|strong="H3068"\w* \w instructed|strong="H1696"\w* \w Moses|strong="H4872"\w*, \v 26 “\w Speak|strong="H1696"\w* \w to|strong="H413"\w* \w the Levites|strong="H3881"\w* \w and tell them|strong="H559"\w*: ‘\w When|strong="H3588"\w* \w you receive|strong="H3947"\w* \w from|strong="H854"\w* \w the Israelites|strong="H1121"\w* \w the tithe|strong="H4643"\w* \w that|strong="H834"\w* \w I have given|strong="H5414"\w* you \w as your inheritance|strong="H5159"\w*, \w you must present|strong="H7311"\w* \w part|strong="H4480"\w* \w of it|strong="H4480"\w* \w as an offering|strong="H8641"\w* \w to the LORD|strong="H3068"\w*— \w a tithe|strong="H4643"\w* \w of the tithe|strong="H4643"\w*. \v 27 \w Your offering|strong="H8641"\w* \w will be reckoned|strong="H2803"\w* to you \w as grain|strong="H1715"\w* \w from|strong="H4480"\w* \w the threshing floor|strong="H1637"\w* \w or juice|strong="H4395"\w* \w from|strong="H4480"\w* \w the winepress|strong="H3342"\w*. \v 28 \w So|strong="H3651"\w* \w you|strong="H859"\w* \w are to present|strong="H7311"\w* \w an offering|strong="H8641"\w* \w to the LORD|strong="H3068"\w* \w from all|strong="H3605"\w* \w the tithes|strong="H4643"\w* \w you receive|strong="H3947"\w* \w from the Israelites|strong="H1121"\w*, \w and from these|strong="H4480"\w* \w you are to give|strong="H5414"\w* \w the LORD’s|strong="H3068"\w* \w offering|strong="H8641"\w* \w to Aaron|strong="H175"\w* \w the priest|strong="H3548"\w*. \v 29 \w You must present|strong="H7311"\w* \w the offering|strong="H8641"\w* \w due the LORD|strong="H3068"\w* \w from|strong="H3605"\w* \w all|strong="H3605"\w* \w the best|strong="H2459"\w* \w of every|strong="H3605"\w* \w gift|strong="H4979"\w*, \w the holiest part|strong="H4720"\w* \w of it|strong="H4480"\w*.’
\p \v 30 \w Therefore say|strong="H559"\w* \w to the Levites|strong="H413"\w*, ‘\w When you have presented|strong="H7311"\w* \w the best part|strong="H2459"\w*, \w it will be reckoned|strong="H2803"\w* \w to you|strong="H3881"\w* \w as the produce|strong="H8393"\w* \w of the threshing floor|strong="H1637"\w* \w or winepress|strong="H3342"\w*. \v 31 \w And you|strong="H859"\w* \w and your households|strong="H1004"\w* \w may eat the rest of it anywhere|strong="H398"\w*; \w it|strong="H1931"\w* \w is the compensation|strong="H7939"\w* \w for|strong="H2500"\w* \w your work|strong="H5656"\w* \w at the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \v 32 \w Once you have presented|strong="H7311"\w* \w the best part|strong="H2459"\w* \w of it|strong="H4480"\w*, \w you will not|strong="H3808"\w* \w incur|strong="H5375"\w* \w guilt|strong="H2399"\w* \w because of it|strong="H5921"\w*. \w But|strong="H853"\w* \w you must not|strong="H3808"\w* \w defile|strong="H2490"\w* \w the sacred offerings|strong="H6944"\w* \w of the Israelites|strong="H3478"\w*, \w or else|strong="H3808"\w* \w you will die|strong="H4191"\w*.’”
\c 19
\s1 The Red Heifer
\p \v 1 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w* \w and Aaron|strong="H175"\w*, \v 2 “\w This|strong="H2063"\w* \w is the statute|strong="H2708"\w* \w of the law|strong="H8451"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w has commanded|strong="H6680"\w*: \w Instruct|strong="H1696"\w* \w the Israelites|strong="H1121"\w* \w to bring|strong="H3947"\w* \w you|strong="H413"\w* \w an unblemished|strong="H8549"\w* \w red|strong="H122"\w* \w heifer|strong="H6510"\w* \w that|strong="H834"\w* \w has no|strong="H369"\w* \w defect|strong="H3971"\w* \w and has never|strong="H3808"\w* \w been placed|strong="H5927"\w* \w under a yoke|strong="H5923"\w*. \v 3 \w Give|strong="H5414"\w* \w it to|strong="H413"\w* \w Eleazar|strong="H499"\w* \w the priest|strong="H3548"\w*, \w and he will have it brought|strong="H3318"\w* \w outside|strong="H2351"\w* \w the camp|strong="H4264"\w* \w and slaughtered|strong="H7819"\w* \w in his presence|strong="H6440"\w*.
\p \v 4 \w Eleazar|strong="H499"\w* \w the priest|strong="H3548"\w* \w is to take|strong="H3947"\w* \w some of its blood|strong="H1818"\w* \w on his finger|strong="H676"\w* \w and sprinkle|strong="H5137"\w* \w it|strong="H1818"\w* \w seven|strong="H7651"\w* \w times|strong="H6471"\w* \w toward|strong="H413"\w* \w the front|strong="H6440"\w* \w of the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \v 5 \w Then the heifer|strong="H6510"\w* \w must be burned|strong="H8313"\w* \w in his sight|strong="H5869"\w*. \w Its hide|strong="H5785"\w*, \w its flesh|strong="H1320"\w*, \w and its blood|strong="H1818"\w* \w are to be burned|strong="H8313"\w*, \w along with|strong="H5921"\w* \w its dung|strong="H6569"\w*. \v 6 \w The priest|strong="H3548"\w* \w is to take|strong="H3947"\w* \w cedar|strong="H730"\w* \w wood|strong="H6086"\w*, \w hyssop|strong="H231"\w*, \w and scarlet wool|strong="H8144"\w* \w and throw|strong="H7993"\w* \w them|strong="H413"\w* \w onto|strong="H8432"\w* \w the burning|strong="H8316"\w* \w heifer|strong="H6510"\w*.
\p \v 7 \w Then the priest|strong="H3548"\w* \w must wash|strong="H3526"\w* \w his clothes|strong="H899"\w* \w and bathe|strong="H7364"\w* \w his body|strong="H1320"\w* \w in water|strong="H4325"\w*; \w after that|strong="H310"\w* \w he may enter|strong="H935"\w* \w the camp|strong="H4264"\w*, \w but he|strong="H3548"\w* \w will be ceremonially unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*. \v 8 \w The one who burned|strong="H8313"\w* \w the heifer|strong="H853"\w* \w must also wash|strong="H3526"\w* \w his clothes|strong="H899"\w* \w and bathe|strong="H7364"\w* \w his body|strong="H1320"\w* \w in water|strong="H4325"\w*, \w and he too will be ceremonially unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*.
\p \v 9 \w Then a man|strong="H376"\w* \w who is ceremonially clean|strong="H2889"\w* \w is to gather up|strong="H622"\w* \w the ashes|strong="H665"\w* \w of the heifer|strong="H6510"\w* \w and store them|strong="H5117"\w* \w in a ceremonially clean|strong="H2889"\w* \w place|strong="H4725"\w* \w outside|strong="H2351"\w* \w the camp|strong="H4264"\w*. \w They must be|strong="H1961"\w* \w kept|strong="H4931"\w* \w by the congregation|strong="H5712"\w* \w of Israel|strong="H3478"\w* \w for preparing the water|strong="H4325"\w* \w of purification|strong="H5079"\w*; \w this is|strong="H1931"\w* \w for purification from sin|strong="H2403"\w*. \v 10 \w The man who has gathered up|strong="H622"\w* \w the ashes|strong="H665"\w* \w of the heifer|strong="H6510"\w* \w must also wash|strong="H3526"\w* \w his clothes|strong="H899"\w*, \w and he will be ceremonially unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*. \w This|strong="H1961"\w* \w is a permanent|strong="H5769"\w* \w statute|strong="H2708"\w* \w for the Israelites|strong="H1121"\w* \w and for the foreigner|strong="H1616"\w* \w residing|strong="H1481"\w* \w among them|strong="H8432"\w*.
\s1 Purification of the Unclean
\p \v 11 \w Whoever touches|strong="H5060"\w* \w any|strong="H3605"\w* \w dead|strong="H4191"\w* \w body|strong="H5315"\w* \w will be unclean|strong="H2930"\w* \w for seven|strong="H7651"\w* \w days|strong="H3117"\w*. \v 12 \w He|strong="H1931"\w* \w must purify himself|strong="H2398"\w* with the water \w on the third|strong="H7992"\w* \w day|strong="H3117"\w* \w and on the seventh|strong="H7637"\w* \w day|strong="H3117"\w*; \w then he will be clean|strong="H2891"\w*. \w But if|strong="H518"\w* \w he does not|strong="H3808"\w* \w purify himself|strong="H2398"\w* \w on the third|strong="H7992"\w* \w and seventh|strong="H7637"\w* \w days|strong="H3117"\w*, \w he will not|strong="H3808"\w* \w be clean|strong="H2891"\w*. \v 13 \w Anyone|strong="H3605"\w* \w who touches|strong="H5060"\w* \w a human|strong="H120"\w* \w corpse|strong="H4191"\w* \w and fails|strong="H3808"\w* \w to purify|strong="H2398"\w* \w himself|strong="H853"\w* \w defiles|strong="H2930"\w* \w the tabernacle|strong="H4908"\w* \w of the LORD|strong="H3068"\w*. \w That|strong="H1931"\w* \w person|strong="H5315"\w* \w must be cut off|strong="H3772"\w* \w from Israel|strong="H3478"\w*. \w He remains|strong="H1961"\w* \w unclean|strong="H2931"\w*, \w because|strong="H3588"\w* \w the water|strong="H4325"\w* \w of purification|strong="H5079"\w* \w has not|strong="H3808"\w* \w been sprinkled|strong="H2236"\w* \w on him|strong="H5921"\w*, \w and his uncleanness|strong="H2932"\w* \w is still on him|strong="H5750"\w*.
\p \v 14 \w This|strong="H2063"\w* \w is the law|strong="H8451"\w* \w when|strong="H3588"\w* \w a person|strong="H120"\w* \w dies|strong="H4191"\w* \w in a tent|strong="H168"\w*: \w Everyone|strong="H3605"\w* \w who enters|strong="H935"\w* \w the tent|strong="H168"\w* \w and everyone|strong="H3605"\w* \w already in the tent|strong="H168"\w* \w will be unclean|strong="H2930"\w* \w for seven|strong="H7651"\w* \w days|strong="H3117"\w*, \v 15 \w and any|strong="H3605"\w* \w open|strong="H6605"\w* \w container|strong="H3627"\w* \w without|strong="H369"\w* \w a lid|strong="H6781"\w* \w fastened|strong="H6616"\w* \w on it|strong="H5921"\w* \w is unclean|strong="H2931"\w*.
\p \v 16 \w Anyone|strong="H3605"\w* \w in|strong="H5921"\w* \w the open field|strong="H6440"\w* \w who|strong="H834"\w* \w touches|strong="H5060"\w* \w someone who has been killed|strong="H2491"\w* \w by the sword|strong="H2719"\w* \w or|strong="H176"\w* \w has died of natural causes|strong="H4191"\w*, \w or|strong="H176"\w* \w anyone who touches a human|strong="H120"\w* \w bone|strong="H6106"\w* \w or|strong="H176"\w* \w a grave|strong="H6913"\w*, \w will be unclean|strong="H2930"\w* \w for seven|strong="H7651"\w* \w days|strong="H3117"\w*.
\p \v 17 \w For the purification of the unclean person,|strong="H2931"\w* \w take|strong="H3947"\w* \w some of the ashes|strong="H6083"\w* \w of the burnt|strong="H8316"\w* \w sin offering|strong="H2403"\w*, \w put them|strong="H5414"\w* \w in|strong="H413"\w* \w a jar|strong="H3627"\w*, \w and pour fresh|strong="H2416"\w* \w water|strong="H4325"\w*\f + \fr 19:17 \ft Or \fqa flowing water \ft or \fqa living water\f* \w over them|strong="H5921"\w*. \v 18 \w Then a man|strong="H376"\w* \w who is ceremonially clean|strong="H2889"\w* \w is to take|strong="H3947"\w* \w some hyssop|strong="H231"\w*, \w dip|strong="H2881"\w* \w it in the water|strong="H4325"\w*, \w and sprinkle|strong="H5137"\w* \w the tent|strong="H168"\w*, \w all|strong="H3605"\w* \w the furnishings|strong="H3627"\w*, \w and the people|strong="H5315"\w* \w who|strong="H834"\w* \w were|strong="H1961"\w* \w there|strong="H8033"\w*. \w He is also to sprinkle the one who touched|strong="H5060"\w* \w a bone|strong="H6106"\w*, \w a grave|strong="H6913"\w*, \w or a person who has died|strong="H4191"\w* \w or|strong="H176"\w* \w been slain|strong="H2491"\w*.
\p \v 19 \w The man who is ceremonially clean|strong="H2889"\w* \w is to sprinkle|strong="H5137"\w* \w the unclean person|strong="H2931"\w* \w on the third|strong="H7992"\w* \w day|strong="H3117"\w* \w and on the seventh|strong="H7637"\w* \w day|strong="H3117"\w*. \w After he purifies|strong="H2398"\w* \w the unclean person on the seventh|strong="H7637"\w* \w day|strong="H3117"\w*, \w the one being cleansed must wash|strong="H3526"\w* \w his clothes|strong="H899"\w* \w and bathe|strong="H7364"\w* \w in water|strong="H4325"\w*, \w and that evening|strong="H6153"\w* \w he will be clean|strong="H2891"\w*. \v 20 \w But if a person|strong="H376"\w* \w who|strong="H834"\w* \w is unclean|strong="H2930"\w* \w does not|strong="H3808"\w* \w purify|strong="H2398"\w* \w himself|strong="H1931"\w*, \w he|strong="H5315"\w* \w will be cut off|strong="H3772"\w* \w from|strong="H8432"\w* \w the assembly|strong="H6951"\w*, \w because|strong="H3588"\w* \w he has defiled|strong="H2930"\w* \w the sanctuary|strong="H4720"\w* \w of the LORD|strong="H3068"\w*. \w The water|strong="H4325"\w* \w of purification|strong="H5079"\w* \w has not|strong="H3808"\w* \w been sprinkled|strong="H2236"\w* \w on him|strong="H5921"\w*; \w he|strong="H1931"\w* \w is unclean|strong="H2931"\w*.
\p \v 21 \w This|strong="H1961"\w* \w is a permanent|strong="H5769"\w* \w statute|strong="H2708"\w* for the people: \w The one who sprinkles|strong="H5137"\w* \w the water|strong="H4325"\w* \w of purification|strong="H5079"\w* \w must wash|strong="H3526"\w* \w his clothes|strong="H899"\w*, \w and whoever touches|strong="H5060"\w* \w the water|strong="H4325"\w* \w of purification|strong="H5079"\w* \w will be unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*. \v 22 \w Anything|strong="H3605"\w* \w the unclean|strong="H2931"\w* \w person touches|strong="H5060"\w* \w will become unclean|strong="H2930"\w*, \w and anyone|strong="H5315"\w* \w who touches it|strong="H5060"\w* \w will be unclean|strong="H2930"\w* \w until|strong="H5704"\w* \w evening|strong="H6153"\w*.”
\c 20
\s1 Water from the Rock
\r (\ref Exodus 17:1–7|EXO 17:1-7\ref*)
\p \v 1 \w In the first|strong="H7223"\w* \w month|strong="H2320"\w*, \w the whole|strong="H3605"\w* \w congregation|strong="H5712"\w* \w of Israel|strong="H3478"\w* \w entered|strong="H935"\w* \w the Wilderness|strong="H4057"\w* \w of Zin|strong="H6790"\w* \w and|strong="H5971"\w* \w stayed|strong="H3427"\w* \w in Kadesh|strong="H6946"\w*. \w There|strong="H8033"\w* \w Miriam|strong="H4813"\w* \w died|strong="H4191"\w* \w and was buried|strong="H6912"\w*.
\p \v 2 \w Now there was|strong="H1961"\w* \w no|strong="H3808"\w* \w water|strong="H4325"\w* \w for the congregation|strong="H5712"\w*, \w so they gathered|strong="H6950"\w* \w against|strong="H5921"\w* \w Moses|strong="H4872"\w* \w and Aaron|strong="H175"\w*. \v 3 \w The people|strong="H5971"\w* \w quarreled|strong="H7378"\w* \w with|strong="H5973"\w* \w Moses|strong="H4872"\w* \w and said|strong="H559"\w*, “\w If only|strong="H3863"\w* \w we had perished|strong="H1478"\w* \w with our brothers|strong="H251"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*! \v 4 \w Why|strong="H4100"\w* \w have you brought|strong="H935"\w* \w the LORD’s|strong="H3068"\w* \w assembly|strong="H6951"\w* \w into|strong="H413"\w* \w this|strong="H2088"\w* \w wilderness|strong="H4057"\w* \w for us|strong="H587"\w* \w and our livestock|strong="H1165"\w* \w to die|strong="H4191"\w* \w here|strong="H8033"\w*? \v 5 \w Why|strong="H4100"\w* \w have you led us up|strong="H5927"\w* \w out of Egypt|strong="H4714"\w* \w to bring|strong="H935"\w* \w us|strong="H853"\w* \w to|strong="H413"\w* \w this|strong="H2088"\w* \w wretched|strong="H7451"\w* \w place|strong="H4725"\w*? \w It is not|strong="H3808"\w* \w a place|strong="H4725"\w* \w of grain|strong="H2233"\w*, \w figs|strong="H8384"\w*, \w vines|strong="H1612"\w*, \w or pomegranates|strong="H7416"\w* — \w and there is no|strong="H369"\w* \w water|strong="H4325"\w* \w to drink|strong="H8354"\w*!”
\p \v 6 \w Then Moses|strong="H4872"\w* \w and Aaron|strong="H175"\w* \w went|strong="H935"\w* \w from the presence|strong="H6440"\w* \w of the assembly|strong="H6951"\w* \w to|strong="H413"\w* \w the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \w They fell facedown|strong="H5307"\w*, \w and the glory|strong="H3519"\w* \w of the LORD|strong="H3068"\w* \w appeared|strong="H7200"\w* \w to them|strong="H413"\w*. \v 7 \w And the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 8 “\w Take|strong="H3947"\w* \w the staff|strong="H4294"\w* \w and assemble|strong="H6950"\w* \w the congregation|strong="H5712"\w*. \w You|strong="H859"\w* \w and your brother|strong="H251"\w* \w Aaron|strong="H175"\w* \w are to speak|strong="H1696"\w* \w to|strong="H413"\w* \w the rock|strong="H5553"\w* \w while they watch|strong="H5869"\w*, \w and it will pour out|strong="H5414"\w* \w its water|strong="H4325"\w*. \w You will bring out|strong="H3318"\w* \w water|strong="H4325"\w* \w from|strong="H4480"\w* \w the rock|strong="H5553"\w* \w and provide drink|strong="H8248"\w* \w for the congregation|strong="H5712"\w* \w and their livestock|strong="H1165"\w*.”
\p \v 9 \w So Moses|strong="H4872"\w* \w took|strong="H3947"\w* \w the staff|strong="H4294"\w* \w from the LORD’s|strong="H3068"\w* \w presence|strong="H6440"\w*, \w just as|strong="H834"\w* \w he had been commanded|strong="H6680"\w*. \v 10 \w Then Moses|strong="H4872"\w* \w and Aaron|strong="H175"\w* \w gathered|strong="H6950"\w* \w the assembly|strong="H6951"\w* \w in|strong="H413"\w* \w front|strong="H6440"\w* \w of the rock|strong="H5553"\w*, \w and Moses said|strong="H559"\w* to them, “\w Listen|strong="H8085"\w* \w now|strong="H4994"\w*, \w you rebels|strong="H4784"\w*, \w must we bring you water|strong="H4325"\w* \w out|strong="H3318"\w* \w of|strong="H4480"\w* \w this|strong="H2088"\w* \w rock|strong="H5553"\w*?” \v 11 \w Then Moses|strong="H4872"\w* \w raised|strong="H7311"\w* \w his hand|strong="H3027"\w* \w and struck|strong="H5221"\w* \w the rock|strong="H5553"\w* \w twice|strong="H6471"\w* \w with his staff|strong="H4294"\w*, \w so that a great amount of|strong="H7227"\w* \w water|strong="H4325"\w* \w gushed out|strong="H3318"\w*, \w and the congregation|strong="H5712"\w* \w and their livestock|strong="H1165"\w* \w were able to drink|strong="H8354"\w*.
\p \v 12 \w But the LORD|strong="H3068"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w* \w and|strong="H413"\w* \w Aaron|strong="H175"\w*, “\w Because|strong="H3282"\w* \w you did not|strong="H3808"\w* \w trust|strong="H539"\w* Me \w to show My holiness|strong="H6942"\w* \w in the sight|strong="H5869"\w* \w of the Israelites|strong="H3478"\w*, \w you will not|strong="H3808"\w* \w bring|strong="H935"\w* \w this|strong="H2088"\w* \w assembly|strong="H6951"\w* \w into the land|strong="H776"\w* \w that|strong="H834"\w* \w I have given|strong="H5414"\w* them.”
\p \v 13 \w These|strong="H1992"\w* \w were the waters|strong="H4325"\w* \w of Meribah|strong="H4809"\w*,\f + \fr 20:13 \fqa Meribah \ft means \fqa quarreling\ft ; also in verse 24; see Exodus 17:7.\f* \w where|strong="H834"\w* \w the Israelites|strong="H1121"\w* \w quarreled|strong="H7378"\w* \w with|strong="H854"\w* \w the LORD|strong="H3068"\w*, \w and He showed His holiness|strong="H6942"\w* among them.
\s1 Edom Refuses Passage
\p \v 14 \w From Kadesh|strong="H6946"\w*, \w Moses|strong="H4872"\w* \w sent|strong="H7971"\w* \w messengers|strong="H4397"\w* \w to tell|strong="H413"\w* \w the king|strong="H4428"\w* \w of Edom|strong="H123"\w*, “\w This is what|strong="H3541"\w* \w your brother|strong="H251"\w* \w Israel|strong="H3478"\w* \w says|strong="H559"\w*: \w You|strong="H859"\w* \w know|strong="H3045"\w* \w all|strong="H3605"\w* \w the hardship|strong="H8513"\w* \w that|strong="H834"\w* \w has befallen us|strong="H4672"\w*, \v 15 \w how our fathers|strong="H1"\w* \w went down|strong="H3381"\w* \w to Egypt|strong="H4714"\w*, \w where we lived|strong="H3427"\w* \w many|strong="H7227"\w* \w years|strong="H3117"\w*. \w The Egyptians|strong="H4713"\w* \w mistreated|strong="H7489"\w* us \w and our fathers|strong="H1"\w*, \v 16 \w and when we cried out|strong="H6817"\w* \w to|strong="H413"\w* \w the LORD|strong="H3068"\w*, \w He heard|strong="H8085"\w* \w our voice|strong="H6963"\w*, \w sent|strong="H7971"\w* \w an angel|strong="H4397"\w*, \w and brought us|strong="H3318"\w* \w out of Egypt|strong="H4714"\w*.
\p \w Now look|strong="H2009"\w*, \w we|strong="H587"\w* \w are in Kadesh|strong="H6946"\w*, \w a city|strong="H5892"\w* \w on the edge|strong="H7097"\w* \w of your territory|strong="H1366"\w*. \v 17 \w Please|strong="H4994"\w* \w let us pass|strong="H5674"\w* \w through your land|strong="H776"\w*. \w We will not|strong="H3808"\w* \w go through|strong="H5674"\w* \w any field|strong="H7704"\w* \w or vineyard|strong="H3754"\w*, \w or|strong="H3808"\w* \w drink|strong="H8354"\w* \w water|strong="H4325"\w* \w from any well|strong="H875"\w*. \w We will stay on|strong="H1980"\w* \w the King’s|strong="H4428"\w* \w Highway|strong="H1870"\w*; \w we will not|strong="H3808"\w* \w turn|strong="H5186"\w* \w to the right|strong="H3225"\w* \w or to the left|strong="H8040"\w* \w until|strong="H5704"\w* \w we have passed through|strong="H5674"\w* \w your territory|strong="H1366"\w*.”
\p \v 18 \w But Edom|strong="H123"\w* \w answered|strong="H559"\w*, “\w You may not|strong="H3808"\w* \w travel|strong="H5674"\w* through our land, \w or we will come out|strong="H3318"\w* \w and confront you|strong="H7122"\w* \w with the sword|strong="H2719"\w*.”
\p \v 19 “\w We will stay|strong="H5927"\w* \w on the main road|strong="H4546"\w*,” \w the Israelites|strong="H1121"\w* \w replied|strong="H559"\w*, “\w and if|strong="H518"\w* \w we|strong="H589"\w* \w or our herds|strong="H4735"\w* \w drink|strong="H8354"\w* \w your water|strong="H4325"\w*, \w we will pay|strong="H5414"\w* \w for it|strong="H4377"\w*. \w There will be no|strong="H369"\w* \w problem|strong="H1697"\w*; \w only|strong="H7535"\w* \w let us pass through|strong="H5674"\w* \w on foot|strong="H7272"\w*.”
\p \v 20 \w But Edom|strong="H123"\w* \w insisted|strong="H559"\w*, “\w You may not|strong="H3808"\w* \w pass through|strong="H5674"\w*.” \w And they came out|strong="H3318"\w* \w to confront the Israelites|strong="H7122"\w* \w with a large|strong="H3515"\w* \w army|strong="H5971"\w* \w and a strong|strong="H2389"\w* \w hand|strong="H3027"\w*. \v 21 \w So Edom|strong="H123"\w* \w refused|strong="H3985"\w* \w to allow|strong="H5414"\w* \w Israel|strong="H3478"\w* \w to pass|strong="H5674"\w* \w through their territory|strong="H1366"\w*, \w and Israel|strong="H3478"\w* \w turned away|strong="H5186"\w* \w from them|strong="H5921"\w*.
\s1 The Death of Aaron
\p \v 22 \w After they had set out|strong="H5265"\w* \w from Kadesh|strong="H6946"\w*, \w the whole|strong="H3605"\w* \w congregation|strong="H5712"\w* \w of Israel|strong="H3478"\w* \w came|strong="H935"\w* \w to Mount|strong="H2022"\w* \w Hor|strong="H2023"\w*. \v 23 \w And at Mount|strong="H2022"\w* \w Hor|strong="H2023"\w*, \w near|strong="H5921"\w* \w the border|strong="H1366"\w* \w of the land|strong="H776"\w* \w of Edom|strong="H123"\w*, \w the LORD|strong="H3068"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w* \w and Aaron|strong="H175"\w*, \v 24 “\w Aaron|strong="H175"\w* \w will be gathered|strong="H622"\w* \w to|strong="H413"\w* \w his people|strong="H5971"\w*; \w he will not|strong="H3808"\w* \w enter|strong="H935"\w* \w the land|strong="H776"\w* \w that|strong="H834"\w* \w I have given|strong="H5414"\w* \w the Israelites|strong="H1121"\w*, \w because|strong="H5921"\w* \w both of you rebelled|strong="H4784"\w* \w against My command|strong="H6310"\w* \w at the waters|strong="H4325"\w* \w of Meribah|strong="H4809"\w*. \v 25 \w Take|strong="H3947"\w* \w Aaron|strong="H175"\w* \w and his son|strong="H1121"\w* \w Eleazar|strong="H499"\w* \w and bring them up|strong="H5927"\w* \w Mount|strong="H2022"\w* \w Hor|strong="H2023"\w*. \v 26 \w Remove|strong="H6584"\w* \w Aaron’s|strong="H175"\w* \w priestly garments|strong="H899"\w* \w and put them on|strong="H3847"\w* \w his son|strong="H1121"\w* \w Eleazar|strong="H499"\w*. \w Aaron|strong="H175"\w* \w will be gathered to his people|strong="H622"\w* \w and will die|strong="H4191"\w* \w there|strong="H8033"\w*.”
\p \v 27 \w So Moses|strong="H4872"\w* \w did|strong="H6213"\w* \w as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w*, \w and they climbed|strong="H5927"\w* \w Mount|strong="H2022"\w* \w Hor|strong="H2023"\w* \w in the sight|strong="H5869"\w* \w of the whole|strong="H3605"\w* \w congregation|strong="H5712"\w*. \v 28 \w After Moses|strong="H4872"\w* \w had removed|strong="H6584"\w* \w Aaron’s|strong="H175"\w* \w garments|strong="H899"\w* \w and put them on|strong="H3847"\w* \w his son|strong="H1121"\w* \w Eleazar|strong="H499"\w*, \w Aaron|strong="H175"\w* \w died|strong="H4191"\w* \w there|strong="H8033"\w* \w on top|strong="H7218"\w* \w of the mountain|strong="H2022"\w*. \w Then Moses|strong="H4872"\w* \w and Eleazar|strong="H499"\w* \w came down|strong="H3381"\w* \w from|strong="H4480"\w* \w the mountain|strong="H2022"\w*. \v 29 \w When the whole|strong="H3605"\w* \w congregation|strong="H5712"\w* \w saw|strong="H7200"\w* \w that|strong="H3588"\w* \w Aaron|strong="H175"\w* \w had died|strong="H1478"\w*, \w the entire|strong="H3605"\w* \w house|strong="H1004"\w* \w of Israel|strong="H3478"\w* \w mourned|strong="H1058"\w* \w for him|strong="H175"\w* \w thirty|strong="H7970"\w* \w days|strong="H3117"\w*.
