\li1 \v 29 \w They set out|strong="H5265"\w* \w from Mithkah|strong="H4989"\w* \w and camped|strong="H2583"\w* \w at Hashmonah|strong="H2832"\w*.
\li1 \v 30 \w They set out|strong="H5265"\w* \w from Hashmonah|strong="H2832"\w* \w and camped|strong="H2583"\w* \w at Moseroth|strong="H4149"\w*.
