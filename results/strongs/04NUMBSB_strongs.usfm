\p \v 35 \w On the eighth|strong="H8066"\w* \w day|strong="H3117"\w* \w you are to hold|strong="H1961"\w* \w a solemn assembly|strong="H6116"\w*; \w you must not|strong="H3808"\w* \w do|strong="H6213"\w* \w any|strong="H3605"\w* \w regular work|strong="H4399"\w*. \v 36 \w As a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w* \w to the LORD|strong="H3068"\w*, \w you are to present|strong="H7126"\w* \w a food offering|strong="H801"\w*, \w a burnt offering|strong="H5930"\w* \w of one|strong="H259"\w* \w bull|strong="H6499"\w*, \w one|strong="H259"\w* \w ram|strong="H352"\w*, \w and seven|strong="H7651"\w* \w male lambs|strong="H3532"\w* \w a year old|strong="H1121"\w*, \w all unblemished|strong="H8549"\w*, \v 37 \w along with the grain and drink offerings|strong="H4503"\w* \w for the bulls|strong="H6499"\w*, \w rams|strong="H352"\w*, \w and lambs|strong="H3532"\w*, \w according to the number|strong="H4557"\w* \w prescribed|strong="H4941"\w*. \v 38 \w Include one|strong="H259"\w* \w male goat|strong="H8163"\w* \w as a sin offering|strong="H2403"\w*, \w in addition to|strong="H905"\w* \w the regular|strong="H8548"\w* \w burnt offering|strong="H5930"\w* \w with its grain offering|strong="H4503"\w* \w and drink offering|strong="H5262"\w*.
\p \v 39 \w You are to present|strong="H6213"\w* \w these offerings|strong="H428"\w* \w to the LORD|strong="H3068"\w* \w at your appointed times|strong="H4150"\w*, \w in addition to|strong="H905"\w* \w your vow|strong="H5088"\w* \w and freewill offerings|strong="H5071"\w*, \w whether burnt offerings|strong="H5930"\w*, \w grain offerings|strong="H4503"\w*, \w drink offerings|strong="H5262"\w*, \w or peace offerings|strong="H8002"\w*.”
\p \v 40 \w So Moses|strong="H4872"\w* \w spoke|strong="H559"\w* \w all this|strong="H3605"\w* \w to the Israelites|strong="H1121"\w* \w just as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w him|strong="H4872"\w*.
\c 30
\s1 Laws about Vows
\r (\ref Matthew 5:33–37|MAT 5:33-37\ref*)
\p \v 1 \w Then Moses|strong="H4872"\w* \w said|strong="H1696"\w* \w to the heads|strong="H7218"\w* \w of the tribes|strong="H4294"\w* \w of Israel|strong="H3478"\w*, “\w This|strong="H2088"\w* \w is what|strong="H834"\w* \w the LORD|strong="H3068"\w* \w has commanded|strong="H6680"\w*: \v 2 \w If|strong="H3588"\w* \w a man|strong="H376"\w* \w makes|strong="H5087"\w* \w a vow|strong="H5088"\w* \w to the LORD|strong="H3068"\w* \w or|strong="H176"\w* \w swears|strong="H7650"\w* \w an oath|strong="H7621"\w* \w to obligate|strong="H631"\w* \w himself|strong="H5315"\w* \w by a pledge|strong="H632"\w*, \w he must not|strong="H3808"\w* \w break|strong="H2490"\w* \w his word|strong="H1697"\w*; \w he must do|strong="H6213"\w* \w everything|strong="H3605"\w* \w he has promised|strong="H3318"\w*.\f + \fr 30:2 \ft Cited in \ref Matthew 5:33|MAT 5:33\ref*\f*
\p \v 3 \w And if|strong="H3588"\w* \w a woman|strong="H802"\w* \w in her father’s|strong="H1"\w* \w house|strong="H1004"\w* \w during her youth|strong="H5271"\w* \w makes|strong="H5087"\w* \w a vow|strong="H5088"\w* \w to the LORD|strong="H3068"\w* \w or obligates herself|strong="H631"\w* \w by a pledge|strong="H632"\w*, \v 4 \w and her father|strong="H1"\w* \w hears about|strong="H8085"\w* \w her vow|strong="H5088"\w* \w or pledge|strong="H632"\w* \w but|strong="H1"\w* \w says nothing|strong="H2790"\w* to her, \w then all|strong="H3605"\w* \w the vows|strong="H5088"\w* \w or|strong="H3605"\w* \w pledges|strong="H632"\w* \w by which|strong="H834"\w* \w she has bound|strong="H631"\w* \w herself|strong="H5315"\w* \w shall stand|strong="H6965"\w*. \v 5 \w But if|strong="H518"\w* \w her father|strong="H1"\w* \w prohibits her|strong="H5106"\w* \w on the day|strong="H3117"\w* \w he hears|strong="H8085"\w* \w about it|strong="H3605"\w*, \w then none|strong="H3808"\w* \w of the vows|strong="H5088"\w* \w or pledges|strong="H632"\w* \w by which|strong="H834"\w* \w she has bound|strong="H631"\w* \w herself|strong="H5315"\w* \w shall stand|strong="H6965"\w*. \w The LORD|strong="H3068"\w* \w will absolve|strong="H5545"\w* her \w because|strong="H3588"\w* \w her father|strong="H1"\w* \w has prohibited her|strong="H5106"\w*.
\p \v 6 \w If|strong="H518"\w* \w a woman marries|strong="H1961"\w* \w while under a vow|strong="H5088"\w* \w or|strong="H176"\w* \w rash promise|strong="H4008"\w* \w by which|strong="H834"\w* \w she|strong="H5315"\w* \w has bound|strong="H631"\w* \w herself|strong="H5921"\w*, \v 7 \w and her husband|strong="H376"\w* \w hears of it|strong="H8085"\w* \w but says nothing|strong="H2790"\w* to her \w on that day|strong="H3117"\w*, \w then the vows|strong="H5088"\w* \w or pledges|strong="H632"\w* \w by which|strong="H834"\w* \w she|strong="H5315"\w* \w has bound|strong="H631"\w* \w herself|strong="H5921"\w* \w shall stand|strong="H6965"\w*. \v 8 \w But if|strong="H518"\w* \w her husband|strong="H376"\w* \w prohibits|strong="H5106"\w* \w her|strong="H853"\w* \w when|strong="H3117"\w* \w he hears of it|strong="H8085"\w*, \w he nullifies|strong="H6565"\w* \w the vow|strong="H5088"\w* \w that|strong="H834"\w* \w binds her|strong="H5921"\w* \w or the rash promise|strong="H4008"\w* \w she|strong="H5315"\w* \w has made|strong="H631"\w*, \w and the LORD|strong="H3068"\w* \w will absolve|strong="H5545"\w* her.
\p \v 9 \w Every|strong="H3605"\w* \w vow|strong="H5088"\w* \w a widow|strong="H490"\w* \w or divorced woman|strong="H1644"\w* \w pledges to fulfill|strong="H631"\w* \w is binding|strong="H6965"\w* \w on her|strong="H5921"\w*.
\p \v 10 \w If|strong="H518"\w* \w a woman in her husband’s|strong="H376"\w* \w house|strong="H1004"\w* \w has made a vow|strong="H5087"\w* \w or|strong="H176"\w* \w put herself|strong="H5315"\w* \w under|strong="H5921"\w* \w an obligation|strong="H631"\w* \w with an oath|strong="H7621"\w*, \v 11 \w and her husband|strong="H376"\w* \w hears of it|strong="H8085"\w* \w but says nothing|strong="H2790"\w* to her \w and does not|strong="H3808"\w* \w prohibit her|strong="H5106"\w*, \w then all|strong="H3605"\w* \w the vows|strong="H5088"\w* \w or|strong="H3605"\w* \w pledges|strong="H632"\w* \w by which|strong="H834"\w* \w she has bound|strong="H631"\w* \w herself|strong="H5315"\w* \w shall stand|strong="H6965"\w*. \v 12 \w But if|strong="H518"\w* \w her husband|strong="H376"\w* \w nullifies them|strong="H6565"\w* \w on the day|strong="H3117"\w* \w he hears of them|strong="H8085"\w*, \w then nothing|strong="H3605"\w* \w that came from|strong="H4161"\w* \w her lips|strong="H8193"\w*, \w whether her vows|strong="H5088"\w* \w or pledges|strong="H632"\w*, \w shall stand|strong="H6965"\w*. \w Her husband|strong="H376"\w* \w has nullified them|strong="H6565"\w*, \w and the LORD|strong="H3068"\w* \w will absolve|strong="H5545"\w* her.
\p \v 13 \w Her husband|strong="H376"\w* \w may confirm|strong="H6965"\w* \w or nullify|strong="H6565"\w* \w any|strong="H3605"\w* \w vow|strong="H5088"\w* \w or any|strong="H3605"\w* \w sworn|strong="H7621"\w* \w pledge|strong="H632"\w* \w to deny|strong="H6031"\w* \w herself|strong="H5315"\w*.\f + \fr 30:13 \ft Or \fqa to fast\f* \v 14 \w But if|strong="H518"\w* \w her husband|strong="H376"\w* \w says nothing|strong="H2790"\w* to her \w from day|strong="H3117"\w* \w to|strong="H413"\w* \w day|strong="H3117"\w*, \w then he confirms|strong="H6965"\w* \w all|strong="H3605"\w* \w the vows|strong="H5088"\w* \w and|strong="H176"\w* \w pledges|strong="H632"\w* \w that|strong="H834"\w* \w bind her|strong="H5921"\w*. \w He has confirmed|strong="H6965"\w* \w them|strong="H853"\w*, \w because|strong="H3588"\w* \w he said nothing|strong="H2790"\w* to her \w on the day|strong="H3117"\w* \w he heard about them|strong="H8085"\w*. \v 15 \w But if|strong="H518"\w* \w he nullifies|strong="H6565"\w* \w them|strong="H853"\w* \w after|strong="H310"\w* \w he hears of them|strong="H8085"\w*, \w then he will bear|strong="H5375"\w* \w her|strong="H853"\w* \w iniquity|strong="H5771"\w*.”
\p \v 16 \w These|strong="H428"\w* \w are the statutes|strong="H2706"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w commanded|strong="H6680"\w* \w Moses|strong="H4872"\w* \w concerning the relationship between|strong="H996"\w* \w a man|strong="H376"\w* \w and his wife|strong="H802"\w*, \w and between|strong="H996"\w* \w a father|strong="H1"\w* \w and a young daughter|strong="H1323"\w* \w still in his|strong="H1"\w* \w home|strong="H1004"\w*.
\c 31
\s1 Vengeance on Midian
\p \v 1 \w And the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 2 “\w Take vengeance|strong="H5358"\w* \w on|strong="H854"\w* \w the Midianites|strong="H4084"\w* \w for the Israelites|strong="H1121"\w*. \w After that|strong="H310"\w*, \w you will be gathered|strong="H622"\w* \w to|strong="H413"\w* \w your people|strong="H5971"\w*.”
\p \v 3 \w So Moses|strong="H4872"\w* \w told|strong="H1696"\w* \w the people|strong="H5971"\w*, “\w Arm|strong="H2502"\w* \w some of your men|strong="H582"\w* \w for war|strong="H6635"\w*, \w that they may go|strong="H1961"\w* \w against|strong="H5921"\w* \w the Midianites|strong="H4080"\w* \w and execute|strong="H5414"\w* \w the LORD’s|strong="H3068"\w* \w vengeance|strong="H5360"\w* \w on them|strong="H4080"\w*. \v 4 \w Send|strong="H7971"\w* \w into battle|strong="H6635"\w* \w a thousand men|strong="H505"\w* \w from each|strong="H3605"\w* \w tribe|strong="H4294"\w* \w of Israel|strong="H3478"\w*.”
\p \v 5 \w So a thousand men|strong="H505"\w* \w were recruited|strong="H4560"\w* \w from each tribe|strong="H4294"\w* \w of Israel|strong="H3478"\w*— \w twelve|strong="H8147"\w* \w thousand|strong="H505"\w* \w armed|strong="H2502"\w* \w for war|strong="H6635"\w*. \v 6 \w And Moses|strong="H4872"\w* \w sent|strong="H7971"\w* \w the thousand|strong="H505"\w* \w from each tribe|strong="H4294"\w* \w into battle|strong="H6635"\w*, \w along with|strong="H853"\w* \w Phinehas|strong="H6372"\w* \w son|strong="H1121"\w* \w of Eleazar|strong="H499"\w* \w the priest|strong="H3548"\w*, \w who took with him|strong="H3027"\w* \w the vessels|strong="H3627"\w* \w of the sanctuary|strong="H6944"\w* \w and the trumpets|strong="H2689"\w* \w for signaling|strong="H8643"\w*.
\p \v 7 \w Then they waged war|strong="H6633"\w* \w against|strong="H5921"\w* \w Midian|strong="H4080"\w*, \w as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w Moses|strong="H4872"\w*, \w and they killed|strong="H2026"\w* \w every|strong="H3605"\w* \w male|strong="H2145"\w*. \v 8 \w Among|strong="H5921"\w* \w the slain|strong="H2491"\w* \w were|strong="H2026"\w* \w Evi|strong="H189"\w*, \w Rekem|strong="H7552"\w*, \w Zur|strong="H6698"\w*, \w Hur|strong="H2354"\w*, \w and Reba|strong="H7254"\w*— \w the five|strong="H2568"\w* \w kings|strong="H4428"\w* \w of Midian|strong="H4080"\w*. \w They also killed|strong="H2026"\w* \w Balaam|strong="H1109"\w* \w son|strong="H1121"\w* \w of Beor|strong="H1160"\w* \w with the sword|strong="H2719"\w*.
\p \v 9 \w The Israelites|strong="H1121"\w* \w captured|strong="H7617"\w* \w the Midianite|strong="H4080"\w* \w women|strong="H802"\w* \w and their children|strong="H2945"\w*, \w and they plundered|strong="H962"\w* \w all|strong="H3605"\w* \w their herds|strong="H929"\w*, \w flocks|strong="H4735"\w*, \w and goods|strong="H2428"\w*. \v 10 \w Then|strong="H853"\w* \w they burned|strong="H8313"\w* \w all|strong="H3605"\w* \w the cities|strong="H5892"\w* \w where the Midianites had lived|strong="H4186"\w*, \w as well as all|strong="H3605"\w* \w their encampments|strong="H2918"\w*, \v 11 \w and carried away|strong="H3947"\w* \w all|strong="H3605"\w* \w the plunder|strong="H7998"\w* \w and|strong="H3605"\w* \w spoils|strong="H4455"\w*, \w both people|strong="H120"\w* \w and animals|strong="H929"\w*.
