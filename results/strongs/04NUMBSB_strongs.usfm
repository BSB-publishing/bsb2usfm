\q2 \w and give|strong="H7760"\w* you \w peace|strong="H7965"\w*.’
\p \v 27 \w So they shall put|strong="H7760"\w* \w My name|strong="H8034"\w* \w on|strong="H5921"\w* \w the Israelites|strong="H1121"\w*, \w and I|strong="H589"\w* \w will bless them|strong="H1288"\w*.”
\c 7
\s1 Offerings of Dedication
\p \v 1 \w On the day|strong="H3117"\w* \w Moses|strong="H4872"\w* \w finished|strong="H3615"\w* \w setting up|strong="H6965"\w* \w the tabernacle|strong="H4908"\w*, \w he anointed|strong="H4886"\w* \w and consecrated|strong="H6942"\w* \w it|strong="H853"\w* \w and all|strong="H3605"\w* \w its furnishings|strong="H3627"\w*, \w along with|strong="H853"\w* \w the altar|strong="H4196"\w* \w and|strong="H853"\w* \w all|strong="H3605"\w* \w its utensils|strong="H3627"\w*. \v 2 \w And the leaders|strong="H5387"\w* \w of Israel|strong="H3478"\w*, \w the heads|strong="H7218"\w* \w of their families|strong="H1"\w*, \w presented an offering|strong="H7126"\w*. \w These men|strong="H1992"\w* \w were the tribal|strong="H4294"\w* \w leaders|strong="H5387"\w* \w who had supervised|strong="H5975"\w* \w the registration|strong="H6485"\w*. \v 3 \w They brought|strong="H935"\w* \w as their offering|strong="H7133"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w six|strong="H8337"\w* \w covered|strong="H6632"\w* \w carts|strong="H5699"\w* \w and twelve|strong="H8147"\w* \w oxen|strong="H1241"\w* — \w an ox|strong="H7794"\w* \w from each leader|strong="H259"\w* \w and a cart|strong="H5699"\w* \w from|strong="H5921"\w* \w every two|strong="H8147"\w* \w leaders|strong="H5387"\w* — \w and presented|strong="H7126"\w* \w them|strong="H853"\w* \w before|strong="H6440"\w* \w the tabernacle|strong="H4908"\w*.
