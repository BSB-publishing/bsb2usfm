\q2 \w they will subdue|strong="H6031"\w* \w Asshur|strong="H804"\w* \w and Eber|strong="H5677"\w*,
\q2 \w but they|strong="H1931"\w* \w too|strong="H1571"\w* \w will perish|strong="H8"\w* \w forever|strong="H5704"\w*.”
\p \v 25 \w Then Balaam|strong="H1109"\w* \w arose|strong="H6965"\w* \w and returned|strong="H7725"\w* \w to his homeland|strong="H4725"\w*, \w and Balak|strong="H1111"\w* \w also|strong="H1571"\w* \w went|strong="H1980"\w* \w on his way|strong="H1870"\w*.
\c 25
\s1 Moab Seduces Israel
\r (\ref 1 Corinthians 10:1–13|1CO 10:1-13\ref*)
\p \v 1 \w While Israel|strong="H3478"\w* \w was staying|strong="H3427"\w* \w in Shittim|strong="H7851"\w*,\f + \fr 25:1 \ft Or \fqa Acacia Grove\f* \w the men|strong="H5971"\w* \w began|strong="H2490"\w* \w to indulge in sexual immorality|strong="H2181"\w* \w with|strong="H413"\w* \w the daughters|strong="H1323"\w* \w of Moab|strong="H4124"\w*, \v 2 \w who also invited|strong="H7121"\w* \w them|strong="H5971"\w* \w to the sacrifices|strong="H2077"\w* \w for their gods|strong="H430"\w*. \w And the people|strong="H5971"\w* \w ate|strong="H398"\w* \w and bowed down|strong="H7812"\w* \w to these gods|strong="H430"\w*. \v 3 \w So Israel|strong="H3478"\w* \w joined in worshiping|strong="H6775"\w* \w Baal of Peor|strong="H1187"\w*, \w and the anger|strong="H639"\w* \w of the LORD|strong="H3068"\w* \w burned|strong="H2734"\w* \w against them|strong="H3478"\w*.
\p \v 4 \w Then the LORD|strong="H3068"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, “\w Take|strong="H3947"\w* \w all|strong="H3605"\w* \w the leaders|strong="H7218"\w* \w of the people|strong="H5971"\w* \w and execute|strong="H3363"\w* \w them|strong="H853"\w* \w in|strong="H5048"\w* \w broad daylight|strong="H8121"\w* \w before the LORD|strong="H3068"\w*, \w so that His|strong="H3068"\w* \w fierce|strong="H2740"\w* \w anger|strong="H639"\w* \w may turn away|strong="H7725"\w* \w from Israel|strong="H3478"\w*.”
\p \v 5 \w So Moses|strong="H4872"\w* \w told|strong="H559"\w* \w the judges|strong="H8199"\w* \w of Israel|strong="H3478"\w*, “\w Each of you must kill|strong="H2026"\w* \w all of his men|strong="H376"\w* \w who have joined in worshiping|strong="H6775"\w* \w Baal of Peor|strong="H1187"\w*.”
\s1 The Zeal of Phinehas
\p \v 6 \w Just then|strong="H2009"\w* \w an Israelite|strong="H1121"\w* \w man|strong="H376"\w* \w brought|strong="H7126"\w* \w to|strong="H413"\w* \w his family|strong="H251"\w* \w a Midianite woman|strong="H4084"\w* \w in the sight|strong="H5869"\w* \w of Moses|strong="H4872"\w* \w and|strong="H5869"\w* \w the whole|strong="H3605"\w* \w congregation|strong="H5712"\w* \w of Israel|strong="H3478"\w* \w while they|strong="H1992"\w* \w were weeping|strong="H1058"\w* \w at the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \v 7 \w On seeing this|strong="H7200"\w*, \w Phinehas|strong="H6372"\w* \w son|strong="H1121"\w* \w of Eleazar|strong="H499"\w*, \w the son|strong="H1121"\w* \w of Aaron|strong="H175"\w* \w the priest|strong="H3548"\w*, \w got up|strong="H6965"\w* \w from|strong="H8432"\w* \w the assembly|strong="H5712"\w*, \w took|strong="H3947"\w* \w a spear|strong="H7420"\w* \w in his hand|strong="H3027"\w*, \v 8 \w followed|strong="H935"\w* \w the Israelite|strong="H3478"\w* \w into|strong="H413"\w* \w the tent|strong="H6898"\w*, \w and drove the spear through|strong="H1856"\w* \w both of them|strong="H8147"\w*— \w through the Israelite|strong="H3478"\w* \w and on through|strong="H413"\w* \w the belly|strong="H6897"\w* \w of the woman|strong="H802"\w*.
\p \w So the plague|strong="H4046"\w* \w against|strong="H5921"\w* \w the Israelites|strong="H1121"\w* \w was halted|strong="H6113"\w*, \v 9 \w but those who died|strong="H4191"\w* \w in the plague|strong="H4046"\w* \w numbered 24,000|strong="H702"\w*.
\p \v 10 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 11 “\w Phinehas|strong="H6372"\w* \w son|strong="H1121"\w* \w of Eleazar|strong="H499"\w*, \w the son|strong="H1121"\w* \w of Aaron|strong="H175"\w* \w the priest|strong="H3548"\w*, \w has turned|strong="H7725"\w* \w My wrath|strong="H2534"\w* \w away from|strong="H5921"\w* \w the Israelites|strong="H1121"\w*; \w for he was zealous|strong="H7065"\w* \w for My sake|strong="H7068"\w* \w among them|strong="H8432"\w*, \w so that I did not|strong="H3808"\w* \w consume|strong="H3615"\w* \w the Israelites|strong="H1121"\w* \w in My zeal|strong="H7068"\w*. \v 12 \w Declare|strong="H559"\w*, \w therefore|strong="H3651"\w*, \w that|strong="H2005"\w* \w I am granting|strong="H5414"\w* him \w My covenant|strong="H1285"\w* \w of peace|strong="H7965"\w*. \v 13 \w It will be|strong="H1961"\w* \w a covenant|strong="H1285"\w* \w of permanent|strong="H5769"\w* \w priesthood|strong="H3550"\w* for him \w and his descendants|strong="H2233"\w*, \w because|strong="H8478"\w* \w he was zealous|strong="H7065"\w* \w for his God|strong="H430"\w* \w and made atonement|strong="H3722"\w* \w for|strong="H5921"\w* \w the Israelites|strong="H1121"\w*.”
\p \v 14 \w The name|strong="H8034"\w* \w of the Israelite|strong="H3478"\w* \w who was slain|strong="H5221"\w* \w with|strong="H854"\w* \w the Midianite woman|strong="H4084"\w* \w was Zimri|strong="H2174"\w* \w son|strong="H1121"\w* \w of Salu|strong="H5543"\w*, \w the leader|strong="H5387"\w* \w of a Simeonite|strong="H8099"\w* \w family|strong="H1"\w*. \v 15 \w And the name|strong="H8034"\w* \w of the slain|strong="H5221"\w* \w Midianite|strong="H4084"\w* \w woman|strong="H802"\w* \w was Cozbi|strong="H3579"\w*, \w the daughter|strong="H1323"\w* \w of Zur|strong="H6698"\w*, \w a tribal|strong="H523"\w* \w chief|strong="H7218"\w* \w of a Midianite|strong="H4080"\w* \w family|strong="H1"\w*.
\p \v 16 \w And the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to Moses|strong="H4872"\w*, \v 17 “\w Attack|strong="H6887"\w* \w the Midianites|strong="H4084"\w* \w and strike them dead|strong="H5221"\w*. \v 18 \w For|strong="H3588"\w* \w they|strong="H1992"\w* \w assailed|strong="H6887"\w* you \w deceitfully|strong="H5231"\w* \w when|strong="H834"\w* \w they seduced|strong="H5230"\w* you \w in|strong="H5921"\w* \w the matter|strong="H1697"\w* \w of Peor|strong="H6465"\w* \w and|strong="H5921"\w* \w their sister|strong="H269"\w* \w Cozbi|strong="H3579"\w*, \w the daughter|strong="H1323"\w* \w of the Midianite|strong="H4080"\w* \w leader|strong="H5387"\w*, \w the woman who was killed|strong="H5221"\w* \w on the day|strong="H3117"\w* \w the plague|strong="H4046"\w* \w came|strong="H5921"\w* \w because of|strong="H1697"\w* \w Peor|strong="H6465"\w*.”
\c 26
\s1 The Second Census of Israel
\r (\ref Numbers 1:1–4|NUM 1:1-4\ref*)
\p \v 1 \w After|strong="H310"\w* \w the plague had ended|strong="H4046"\w*, \w the LORD|strong="H3068"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w* \w and Eleazar|strong="H499"\w* \w son|strong="H1121"\w* \w of Aaron|strong="H175"\w* \w the priest|strong="H3548"\w*, \v 2 “\w Take a census|strong="H5375"\w* \w of the whole|strong="H3605"\w* \w congregation|strong="H5712"\w* \w of Israel|strong="H3478"\w* \w by the houses|strong="H1004"\w* \w of their fathers|strong="H1"\w* — \w all those|strong="H3605"\w* \w twenty|strong="H6242"\w* \w years of age|strong="H1121"\w* \w or older|strong="H4605"\w* \w who can serve|strong="H3318"\w* \w in the army|strong="H6635"\w* \w of Israel|strong="H3478"\w*.”
\p \v 3 \w So on the plains|strong="H6160"\w* \w of Moab|strong="H4124"\w* \w by|strong="H5921"\w* \w the Jordan|strong="H3383"\w*, \w across from Jericho|strong="H3405"\w*, \w Moses|strong="H4872"\w* \w and Eleazar|strong="H499"\w* \w the priest|strong="H3548"\w* \w issued|strong="H1696"\w* \w the instruction|strong="H559"\w*, \v 4 “\w Take a census of the men twenty|strong="H6242"\w* \w years of age|strong="H1121"\w* \w or older|strong="H4605"\w*,\f + \fr 26:4 \fqa Take a census of the men \ft is implied but not included in the Hebrew; see verse 2.\f* \w as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w has commanded|strong="H6680"\w* \w Moses|strong="H4872"\w*.”
\p \w And these were the Israelites|strong="H1121"\w* \w who came out|strong="H3318"\w* \w of the land|strong="H776"\w* \w of Egypt|strong="H4714"\w*:
\s1 The Tribe of Reuben
\p \v 5 \w Reuben|strong="H7205"\w* \w was the firstborn|strong="H1060"\w* \w of Israel|strong="H3478"\w*. \w These were the descendants|strong="H1121"\w* \w of Reuben|strong="H7205"\w*:
