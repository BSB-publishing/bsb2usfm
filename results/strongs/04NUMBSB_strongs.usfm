\p \w Now Kohath|strong="H6955"\w* \w was the father of|strong="H3205"\w* \w Amram|strong="H6019"\w*, \v 59 \w and Amram’s|strong="H6019"\w* \w wife|strong="H802"\w* \w was named|strong="H8034"\w* \w Jochebed|strong="H3115"\w*. \w She was also a daughter|strong="H1323"\w* \w of Levi|strong="H3878"\w*, \w born|strong="H3205"\w* \w to Levi|strong="H3878"\w* \w in Egypt|strong="H4714"\w*. \w To Amram|strong="H6019"\w* \w she bore|strong="H3205"\w* \w Aaron|strong="H175"\w*, \w Moses|strong="H4872"\w*, \w and their sister|strong="H269"\w* \w Miriam|strong="H4813"\w*. \v 60 \w Nadab|strong="H5070"\w*, \w Abihu|strong="H30"\w*, \w Eleazar|strong="H499"\w*, \w and Ithamar|strong="H385"\w* \w were born|strong="H3205"\w* \w to Aaron|strong="H175"\w*, \v 61 \w but Nadab|strong="H5070"\w* \w and Abihu|strong="H30"\w* \w died|strong="H4191"\w* \w when they offered|strong="H7126"\w* \w unauthorized|strong="H2114"\w*\f + \fr 26:61 \ft Or \fqa strange\f* \w fire|strong="H784"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*.
\p \v 62 \w The registration of the Levites|strong="H6485"\w* \w totaled|strong="H1961"\w* \w 23,000|strong="H7969"\w*, \w every|strong="H3605"\w* \w male|strong="H2145"\w* \w a month|strong="H2320"\w* \w old|strong="H1121"\w* \w or more|strong="H4605"\w*; \w they were not|strong="H3808"\w* \w numbered|strong="H6485"\w* \w among|strong="H8432"\w* \w the other Israelites|strong="H1121"\w*, \w because|strong="H3588"\w* \w no|strong="H3808"\w* \w inheritance|strong="H5159"\w* \w was given|strong="H5414"\w* \w to them among|strong="H8432"\w* \w the Israelites|strong="H1121"\w*.
\s1 Only Caleb and Joshua Remain
\p \v 63 \w These|strong="H428"\w* \w were the ones numbered|strong="H6485"\w* \w by Moses|strong="H4872"\w* \w and Eleazar|strong="H499"\w* \w the priest|strong="H3548"\w* \w when|strong="H834"\w* \w they counted|strong="H6485"\w* \w the Israelites|strong="H1121"\w* \w on the plains|strong="H6160"\w* \w of Moab|strong="H4124"\w* \w by|strong="H5921"\w* \w the Jordan|strong="H3383"\w*, \w across from Jericho|strong="H3405"\w*.
\p \v 64 \w Among all these, however|strong="H428"\w*, \w there was|strong="H1961"\w* \w not|strong="H3808"\w* \w one|strong="H376"\w* \w who had been numbered|strong="H6485"\w* \w by Moses|strong="H4872"\w* \w and Aaron|strong="H175"\w* \w the priest|strong="H3548"\w* \w when|strong="H834"\w* \w they counted|strong="H6485"\w* \w the Israelites|strong="H1121"\w* \w in the Wilderness|strong="H4057"\w* \w of Sinai|strong="H5514"\w*. \v 65 \w For|strong="H3588"\w* \w the LORD|strong="H3068"\w* \w had told|strong="H559"\w* them \w that they would surely die|strong="H4191"\w* \w in the wilderness|strong="H4057"\w*. \w Not one|strong="H3808"\w* \w was left|strong="H3498"\w* \w except|strong="H3588"\w* \w Caleb|strong="H3612"\w* \w son|strong="H1121"\w* \w of Jephunneh|strong="H3312"\w* \w and Joshua|strong="H3091"\w* \w son|strong="H1121"\w* \w of Nun|strong="H5126"\w*.
\c 27
\s1 The Daughters of Zelophehad
\r (\ref Numbers 36:1–13|NUM 36:1-13\ref*)
\p \v 1 \w Now the daughters|strong="H1323"\w* \w of Zelophehad|strong="H6765"\w* \w son|strong="H1121"\w* \w of Hepher|strong="H2660"\w*, \w the son|strong="H1121"\w* \w of Gilead|strong="H1568"\w*, \w the son|strong="H1121"\w* \w of Machir|strong="H4353"\w*, \w the son|strong="H1121"\w* \w of Manasseh|strong="H4519"\w*, \w belonged to the clans|strong="H4940"\w* \w of Manasseh|strong="H4519"\w* \w son|strong="H1121"\w* \w of Joseph|strong="H3130"\w*. \w These|strong="H428"\w* \w were the names|strong="H8034"\w* \w of his daughters|strong="H1323"\w*: \w Mahlah|strong="H4244"\w*, \w Noah|strong="H5270"\w*, \w Hoglah|strong="H2295"\w*, \w Milcah|strong="H4435"\w*, \w and Tirzah|strong="H8656"\w*. \w They approached|strong="H7126"\w* \v 2 \w the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*, \w stood|strong="H5975"\w* \w before|strong="H6440"\w* \w Moses|strong="H4872"\w*, \w Eleazar|strong="H499"\w* \w the priest|strong="H3548"\w*, \w the leaders|strong="H5387"\w*, \w and the whole|strong="H3605"\w* \w congregation|strong="H5712"\w*, \w and said|strong="H559"\w*, \v 3 “\w Our father|strong="H1"\w* \w died|strong="H4191"\w* \w in the wilderness|strong="H4057"\w*, \w but he|strong="H1931"\w* \w was|strong="H1961"\w* \w not|strong="H3808"\w* \w among|strong="H8432"\w* \w the followers|strong="H5712"\w* \w of Korah|strong="H7141"\w* \w who gathered together|strong="H3259"\w* \w against|strong="H5921"\w* \w the LORD|strong="H3068"\w*. \w Instead|strong="H3588"\w*, \w he died|strong="H4191"\w* \w because of his own sin|strong="H2399"\w*, \w and he had|strong="H1961"\w* \w no|strong="H3808"\w* \w sons|strong="H1121"\w*. \v 4 \w Why|strong="H4100"\w* \w should the name|strong="H8034"\w* \w of our father|strong="H1"\w* \w disappear|strong="H1639"\w* \w from|strong="H8432"\w* \w his clan|strong="H4940"\w* \w because|strong="H3588"\w* \w he had no|strong="H369"\w* \w sons|strong="H1121"\w*? \w Give|strong="H5414"\w* us \w property|strong="H272"\w* \w among|strong="H8432"\w* \w our father’s|strong="H1"\w* \w brothers|strong="H251"\w*.”
\p \v 5 \w So Moses|strong="H4872"\w* \w brought|strong="H7126"\w* \w their case|strong="H4941"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*, \v 6 \w and the LORD|strong="H3068"\w* \w answered|strong="H559"\w* \w him|strong="H4872"\w*, \v 7 “\w The daughters|strong="H1323"\w* \w of Zelophehad|strong="H6765"\w* \w speak|strong="H1696"\w* \w correctly|strong="H3651"\w*. \w You certainly must give|strong="H5414"\w* them \w property|strong="H272"\w* \w as an inheritance|strong="H5159"\w* \w among|strong="H8432"\w* \w their father’s|strong="H1"\w* \w brothers|strong="H251"\w* \w and transfer|strong="H5674"\w* \w their|strong="H853"\w* \w father’s|strong="H1"\w* \w inheritance|strong="H5159"\w* to them.
\p \v 8 \w Furthermore|strong="H413"\w*, \w you shall say|strong="H1696"\w* \w to the Israelites|strong="H1121"\w*, ‘\w If|strong="H3588"\w* \w a man|strong="H376"\w* \w dies|strong="H4191"\w* \w and leaves no|strong="H369"\w* \w son|strong="H1121"\w*, \w you are to transfer|strong="H5674"\w* \w his inheritance|strong="H5159"\w* \w to his daughter|strong="H1323"\w*. \v 9 \w If|strong="H518"\w* \w he has no|strong="H369"\w* \w daughter|strong="H1323"\w*, \w give|strong="H5414"\w* \w his inheritance|strong="H5159"\w* \w to his brothers|strong="H251"\w*. \v 10 \w If|strong="H518"\w* \w he has no|strong="H369"\w* \w brothers|strong="H251"\w*, \w give|strong="H5414"\w* \w his inheritance|strong="H5159"\w* \w to his father’s|strong="H1"\w* \w brothers|strong="H251"\w*. \v 11 \w And if|strong="H518"\w* \w his father|strong="H1"\w* \w has no|strong="H369"\w* \w brothers|strong="H251"\w*, \w give|strong="H5414"\w* \w his inheritance|strong="H5159"\w* \w to the next|strong="H7138"\w* \w of kin|strong="H7607"\w* \w from his clan|strong="H4940"\w*, \w that he may take possession of it|strong="H3423"\w*. \w This is to be|strong="H1961"\w* \w a statutory|strong="H2708"\w* \w ordinance|strong="H4941"\w* \w for the Israelites|strong="H1121"\w*, \w as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w has commanded|strong="H6680"\w* \w Moses|strong="H4872"\w*.’”
\s1 Moses Requests a Successor
\r (\ref Deuteronomy 3:23–29|DEU 3:23-29\ref*)
\p \v 12 \w Then the LORD|strong="H3068"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, “\w Go up|strong="H5927"\w* \w this|strong="H2088"\w* \w mountain|strong="H2022"\w* \w of the Abarim range|strong="H5682"\w*\f + \fr 27:12 \ft LXX \fqa Go up Mount Nebo beyond the Jordan\f* \w and see|strong="H7200"\w* \w the land|strong="H776"\w* \w that|strong="H834"\w* \w I have given|strong="H5414"\w* \w the Israelites|strong="H1121"\w*. \v 13 \w After you have seen it|strong="H7200"\w*, \w you|strong="H859"\w* \w too will|strong="H1571"\w* \w be gathered|strong="H622"\w* \w to|strong="H413"\w* \w your people|strong="H5971"\w*, \w as|strong="H834"\w* \w your brother|strong="H251"\w* \w Aaron|strong="H175"\w* \w was|strong="H622"\w*; \v 14 \w for|strong="H834"\w* \w when the congregation|strong="H5712"\w* \w contended|strong="H4808"\w* \w in the Wilderness|strong="H4057"\w* \w of Zin|strong="H6790"\w*, \w both of you rebelled|strong="H4784"\w* \w against My command|strong="H6310"\w* \w to show My holiness|strong="H6942"\w* \w in their sight|strong="H5869"\w* \w regarding the waters|strong="H4325"\w*.” \w Those|strong="H1992"\w* \w were the waters|strong="H4325"\w* \w of Meribah|strong="H4809"\w*\f + \fr 27:14 \fqa Meribah \ft means \fqa quarreling\ft ; see \ref Exodus 17:7|EXO 17:7\ref*.\f* \w in Kadesh|strong="H6946"\w*, \w in the Wilderness|strong="H4057"\w* \w of Zin|strong="H6790"\w*.
\p \v 15 \w So Moses|strong="H4872"\w* \w appealed|strong="H1696"\w* \w to|strong="H413"\w* \w the LORD|strong="H3068"\w*, \v 16 “\w May the LORD|strong="H3068"\w*, \w the God|strong="H430"\w* \w of the spirits|strong="H7307"\w* \w of all|strong="H3605"\w* \w flesh|strong="H1320"\w*, \w appoint|strong="H6485"\w* \w a man|strong="H376"\w* \w over|strong="H5921"\w* \w the congregation|strong="H5712"\w* \v 17 \w who|strong="H834"\w* \w will go out|strong="H3318"\w* \w and come in|strong="H935"\w* \w before them|strong="H6440"\w*, \w and who|strong="H834"\w* \w will lead them out|strong="H3318"\w* \w and bring them in|strong="H935"\w*, \w so that the congregation|strong="H5712"\w* \w of the LORD|strong="H3068"\w* \w will not|strong="H3808"\w* \w be|strong="H1961"\w* \w like sheep|strong="H6629"\w* \w without|strong="H369"\w* \w a shepherd|strong="H7462"\w*.”
\s1 Joshua to Succeed Moses
\r (\ref Deuteronomy 31:1–8|DEU 31:1-8\ref*)
\p \v 18 \w And the LORD|strong="H3068"\w* \w replied|strong="H559"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, “\w Take|strong="H3947"\w* \w Joshua|strong="H3091"\w* \w son|strong="H1121"\w* \w of Nun|strong="H5126"\w*, \w a man with|strong="H376"\w* \w the Spirit|strong="H7307"\w* in him, \w and lay|strong="H5564"\w* \w your hands|strong="H3027"\w* \w on him|strong="H5921"\w*. \v 19 \w Have him stand|strong="H5975"\w* \w before|strong="H6440"\w* \w Eleazar|strong="H499"\w* \w the priest|strong="H3548"\w* \w and the whole|strong="H3605"\w* \w congregation|strong="H5712"\w*, \w and commission|strong="H6680"\w* \w him|strong="H853"\w* \w in their sight|strong="H5869"\w*. \v 20 \w Confer|strong="H5414"\w* \w on him|strong="H5921"\w* \w some of your authority|strong="H1935"\w*, \w so that|strong="H4616"\w* \w the whole|strong="H3605"\w* \w congregation|strong="H5712"\w* \w of Israel|strong="H3478"\w* \w will obey him|strong="H8085"\w*. \v 21 \w He shall stand|strong="H5975"\w* \w before|strong="H6440"\w* \w Eleazar|strong="H499"\w* \w the priest|strong="H3548"\w*, \w who will seek counsel|strong="H7592"\w* for him \w before the LORD|strong="H3068"\w* \w by the judgment|strong="H4941"\w* \w of the Urim|strong="H224"\w*.\f + \fr 27:21 \ft Literally \fqa the Lights\f* \w At|strong="H5921"\w* \w his command|strong="H6310"\w*, \w he|strong="H1931"\w* \w and all|strong="H3605"\w* \w the Israelites|strong="H1121"\w* \w with him|strong="H854"\w*— \w the entire|strong="H3605"\w* \w congregation|strong="H5712"\w*— \w will go out|strong="H3318"\w* \w and come in|strong="H935"\w*.”
\p \v 22 \w Moses|strong="H4872"\w* \w did|strong="H6213"\w* \w as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded him|strong="H6680"\w*. \w He took|strong="H3947"\w* \w Joshua|strong="H3091"\w*, \w had him stand|strong="H5975"\w* \w before|strong="H6440"\w* \w Eleazar|strong="H499"\w* \w the priest|strong="H3548"\w* \w and the whole|strong="H3605"\w* \w congregation|strong="H5712"\w*, \v 23 \w and laid|strong="H5564"\w* \w his hands|strong="H3027"\w* \w on him|strong="H5921"\w* \w and commissioned him|strong="H6680"\w*, \w as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had instructed|strong="H1696"\w* \w through|strong="H3027"\w* \w Moses|strong="H4872"\w*.
\c 28
\s1 The Daily Offerings
\r (\ref Exodus 29:38–44|EXO 29:38-44\ref*)
\p \v 1 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 2 “\w Command|strong="H6680"\w* \w the Israelites|strong="H1121"\w* \w and say|strong="H559"\w* \w to them|strong="H413"\w*: \w See|strong="H8104"\w* \w that you present|strong="H7126"\w* to Me \w at its appointed time|strong="H4150"\w* \w the food|strong="H3899"\w* \w for My food offerings|strong="H801"\w*, \w as a pleasing|strong="H5207"\w* \w aroma to Me|strong="H7381"\w*.
\p \v 3 \w And tell them|strong="H559"\w* that \w this is|strong="H2088"\w* \w the food offering|strong="H801"\w* \w you are to present|strong="H7126"\w* \w to the LORD|strong="H3068"\w* \w as a regular|strong="H8548"\w* \w burnt offering|strong="H5930"\w* \w each day|strong="H3117"\w*: \w two|strong="H8147"\w* \w unblemished|strong="H8549"\w* \w year-old|strong="H1121"\w* \w male lambs|strong="H3532"\w*. \v 4 \w Offer|strong="H6213"\w* \w one|strong="H259"\w* \w lamb|strong="H3532"\w* \w in the morning|strong="H1242"\w* \w and the other|strong="H8145"\w* \w at|strong="H996"\w* \w twilight|strong="H6153"\w*,\f + \fr 28:4 \ft Hebrew \fqa between the two evenings\ft ; also in verse 8\f* \v 5 \w along with a tenth|strong="H6224"\w* \w of an ephah|strong="H374"\w* \w of fine flour|strong="H5560"\w*\f + \fr 28:5 \fqa A tenth of an ephah\ft is \ref approximately 2|2\ref* dry quarts or 2.2 liters (probably about 2.6 pounds or 1.2 kilograms of flour); also in verses 13, 21, and 29.\f* \w as a grain offering|strong="H4503"\w*, \w mixed|strong="H1101"\w* \w with a quarter|strong="H7243"\w* \w hin|strong="H1969"\w* \w of oil|strong="H8081"\w* \w from pressed olives|strong="H3795"\w*.\f + \fr 28:5 \ft Or \fqa a quarter hin of pure olive oil\ft ; Hebrew \fqa a quarter hin of pressed oil\ft ; that is, \ref approximately 0|0\ref*.97 quarts or 0.92 liters; similarly in verses 7 and 14\f*
\p \v 6 \w This is a regular|strong="H8548"\w* \w burnt offering|strong="H5930"\w* \w established|strong="H6213"\w* \w at Mount|strong="H2022"\w* \w Sinai|strong="H5514"\w* \w as a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w*, \w a food offering|strong="H801"\w* \w to the LORD|strong="H3068"\w*. \v 7 \w The drink offering|strong="H5262"\w* \w accompanying each|strong="H259"\w* \w lamb|strong="H3532"\w* \w shall be a quarter|strong="H7243"\w* \w hin|strong="H1969"\w*. \w Pour out|strong="H5258"\w* \w the offering|strong="H5262"\w* \w of fermented drink|strong="H7941"\w* \w to the LORD|strong="H3068"\w* \w in the sanctuary area|strong="H6944"\w*. \v 8 \w And|strong="H853"\w* \w offer|strong="H6213"\w* \w the second|strong="H8145"\w* \w lamb|strong="H3532"\w* \w at|strong="H996"\w* \w twilight|strong="H6153"\w*, \w with the same grain offering|strong="H4503"\w* \w and drink offering|strong="H5262"\w* \w as in the morning|strong="H1242"\w*. \w It is a food offering|strong="H801"\w*, \w a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w* \w to the LORD|strong="H3068"\w*.
\s1 The Sabbath Offerings
\p \v 9 \w On the Sabbath|strong="H7676"\w* \w day|strong="H3117"\w*, \w present two|strong="H8147"\w* \w unblemished|strong="H8549"\w* \w year-old|strong="H1121"\w* \w male lambs|strong="H3532"\w*, \w accompanied by a grain offering|strong="H4503"\w* \w of two-tenths of an ephah|strong="H8147"\w* \w of fine flour|strong="H5560"\w*\f + \fr 28:9 \fqa Two-tenths of an ephah\ft is \ref approximately 4|4\ref* dry quarts or 4.4 liters (probably about 5.1 pounds or 2.3 kilograms of flour); also in verses 12, 20, and 28.\f* \w mixed|strong="H1101"\w* \w with oil|strong="H8081"\w*, \w as well as a drink offering|strong="H5262"\w*.
\p \v 10 \w This is the burnt offering|strong="H5930"\w* \w for every Sabbath|strong="H7676"\w*, \w in addition to|strong="H5921"\w* \w the regular|strong="H8548"\w* \w burnt offering|strong="H5930"\w* \w and its drink offering|strong="H5262"\w*.
\s1 The Monthly Offerings
\p \v 11 \w At the beginning|strong="H7218"\w* \w of every month|strong="H2320"\w*, \w you are to present|strong="H7126"\w* \w to the LORD|strong="H3068"\w* \w a burnt offering|strong="H5930"\w* \w of two|strong="H8147"\w* \w young|strong="H1121"\w* \w bulls|strong="H6499"\w*, \w one|strong="H259"\w* \w ram|strong="H352"\w*, \w and seven|strong="H7651"\w* \w male lambs|strong="H3532"\w* \w a year old|strong="H1121"\w*, \w all unblemished|strong="H8549"\w*, \v 12 \w along with three-tenths of an ephah|strong="H7969"\w* \w of fine flour|strong="H5560"\w*\f + \fr 28:12 \fqa Three-tenths of an ephah\ft is \ref approximately 6|6\ref* dry quarts or 6.6 liters (probably about 7.6 pounds or 3.5 kilograms of flour); also in verses 20 and 28.\f* \w mixed|strong="H1101"\w* \w with oil|strong="H8081"\w* \w as a grain offering|strong="H4503"\w* \w with each|strong="H259"\w* \w bull|strong="H6499"\w*, \w two-tenths of an ephah|strong="H8147"\w* \w of fine flour|strong="H5560"\w* \w mixed|strong="H1101"\w* \w with oil|strong="H8081"\w* \w as a grain offering|strong="H4503"\w* \w with the ram|strong="H352"\w*, \v 13 \w and a tenth of an ephah|strong="H6241"\w* \w of fine flour|strong="H5560"\w* \w mixed|strong="H1101"\w* \w with oil|strong="H8081"\w* \w as a grain offering|strong="H4503"\w* \w with each|strong="H259"\w* \w lamb|strong="H3532"\w*. \w This is a burnt offering|strong="H5930"\w*, \w a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w*, \w a food offering|strong="H801"\w* \w to the LORD|strong="H3068"\w*.
\p \v 14 \w Their drink offerings|strong="H5262"\w* \w shall be|strong="H1961"\w* \w half|strong="H2677"\w* \w a hin|strong="H1969"\w* \w of wine|strong="H3196"\w*\f + \fr 28:14 \fqa Half a hin\ft is \ref approximately 1|1\ref*.9 quarts or 1.8 liters of wine.\f* \w with each bull|strong="H6499"\w*, \w a third|strong="H7992"\w* \w of a hin|strong="H1969"\w*\f + \fr 28:14 \fqa A third of a hin\ft is \ref approximately 1|1\ref*.3 quarts or 1.2 liters of wine.\f* \w with the ram|strong="H352"\w*, \w and a quarter|strong="H7243"\w* \w hin|strong="H1969"\w* \w with each lamb|strong="H3532"\w*. \w This|strong="H2063"\w* \w is the monthly|strong="H2320"\w* \w burnt offering|strong="H5930"\w* \w to be made at each new moon|strong="H2320"\w* \w throughout the year|strong="H8141"\w*.
\p \v 15 \w In addition to|strong="H5921"\w* \w the regular|strong="H8548"\w* \w burnt offering|strong="H5930"\w* \w with its drink offering|strong="H5262"\w*, \w one|strong="H259"\w* \w male goat|strong="H8163"\w* \w is to be presented|strong="H6213"\w* \w to the LORD|strong="H3068"\w* \w as a sin offering|strong="H2403"\w*.
\s1 Passover and the Feast of Unleavened Bread
\r (\ref Exodus 12:14–28|EXO 12:14-28\ref*; \ref Leviticus 23:4–8|LEV 23:4-8\ref*; \ref Deuteronomy 16:1–8|DEU 16:1-8\ref*)
\p \v 16 \w The fourteenth|strong="H702"\w* \w day|strong="H3117"\w* \w of the first|strong="H7223"\w* \w month|strong="H2320"\w* \w is the LORD’s|strong="H3068"\w* \w Passover|strong="H6453"\w*. \v 17 \w On the fifteenth|strong="H2568"\w* \w day|strong="H3117"\w* \w of this|strong="H2088"\w* \w month|strong="H2320"\w*, \w there shall be a feast|strong="H2282"\w*; \w for seven|strong="H7651"\w* \w days|strong="H3117"\w* \w unleavened bread|strong="H4682"\w* \w is to be eaten|strong="H398"\w*.
\p \v 18 \w On the first|strong="H7223"\w* \w day|strong="H3117"\w* \w there is to be a sacred|strong="H6944"\w* \w assembly|strong="H4744"\w*; \w you must not|strong="H3808"\w* \w do|strong="H6213"\w* \w any|strong="H3605"\w* \w regular work|strong="H4399"\w*. \v 19 \w Present|strong="H7126"\w* \w to the LORD|strong="H3068"\w* \w a food offering|strong="H801"\w*, \w a burnt offering|strong="H5930"\w* \w of two|strong="H8147"\w* \w young|strong="H1121"\w* \w bulls|strong="H6499"\w*, \w one|strong="H259"\w* \w ram|strong="H352"\w*, \w and seven|strong="H7651"\w* \w male lambs|strong="H3532"\w* \w a year old|strong="H1121"\w*, \w all|strong="H1961"\w* \w unblemished|strong="H8549"\w*. \v 20 \w The grain offering|strong="H4503"\w* \w shall consist of fine flour|strong="H5560"\w* \w mixed|strong="H1101"\w* \w with oil|strong="H8081"\w*; \w offer|strong="H6213"\w* \w three-tenths of an ephah|strong="H7969"\w* \w with each bull|strong="H6499"\w*, \w two-tenths of an ephah|strong="H8147"\w* \w with the ram|strong="H352"\w*, \v 21 \w and|strong="H6213"\w* \w a tenth of an ephah|strong="H6241"\w* \w with each|strong="H259"\w* \w of the seven|strong="H7651"\w* \w lambs|strong="H3532"\w*. \v 22 \w Include one|strong="H259"\w* \w male goat|strong="H8163"\w* \w as a sin offering|strong="H2403"\w* \w to make atonement|strong="H3722"\w* \w for you|strong="H5921"\w*.
\p \v 23 \w You are to present|strong="H6213"\w* \w these|strong="H428"\w* \w in addition to|strong="H905"\w* \w the|strong="H834"\w* \w regular|strong="H8548"\w* \w morning|strong="H1242"\w* \w burnt offering|strong="H5930"\w*. \v 24 \w Offer|strong="H6213"\w* \w the same|strong="H428"\w* \w food|strong="H3899"\w* \w each day|strong="H3117"\w* \w for seven|strong="H7651"\w* \w days|strong="H3117"\w* \w as a food offering|strong="H801"\w*, \w a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w* \w to the LORD|strong="H3068"\w*. \w It is to be offered|strong="H6213"\w* \w with|strong="H5921"\w* \w its drink offering|strong="H5262"\w* \w and the regular|strong="H8548"\w* \w burnt offering|strong="H5930"\w*.
\p \v 25 \w On the seventh|strong="H7637"\w* \w day|strong="H3117"\w* \w you shall hold|strong="H1961"\w* \w a sacred|strong="H6944"\w* \w assembly|strong="H4744"\w*; \w you must not|strong="H3808"\w* \w do|strong="H6213"\w* \w any|strong="H3605"\w* \w regular work|strong="H4399"\w*.
\s1 The Feast of Weeks
\r (\ref Deuteronomy 16:9–12|DEU 16:9-12\ref*)
\p \v 26 \w On the day|strong="H3117"\w* \w of firstfruits|strong="H1061"\w*, \w when you present|strong="H7126"\w* \w an offering of new|strong="H2319"\w* \w grain|strong="H4503"\w* \w to the LORD|strong="H3068"\w* \w during the Feast of Weeks|strong="H7620"\w*,\f + \fr 28:26 \ft That is, Shavuot, the late spring feast of pilgrimage to Jerusalem; it is also known as \fqa the Feast of Harvest\ft (see \ref Exodus 23:16|EXO 23:16\ref*) or \fqa the Feast of Pentecost\ft (see \ref Acts 2:1|ACT 2:1\ref*).\f* \w you are to hold|strong="H1961"\w* \w a sacred|strong="H6944"\w* \w assembly|strong="H4744"\w*; \w you must not|strong="H3808"\w* \w do|strong="H6213"\w* \w any|strong="H3605"\w* \w regular work|strong="H4399"\w*.
\p \v 27 \w Present|strong="H7126"\w* \w a burnt offering|strong="H5930"\w* \w of two|strong="H8147"\w* \w young|strong="H1121"\w* \w bulls|strong="H6499"\w*, \w one|strong="H259"\w* \w ram|strong="H352"\w*, \w and seven|strong="H7651"\w* \w male lambs|strong="H3532"\w* \w a year old|strong="H1121"\w* \w as a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w* \w to the LORD|strong="H3068"\w*, \v 28 \w together with their grain offerings|strong="H4503"\w* \w of fine flour|strong="H5560"\w* \w mixed|strong="H1101"\w* \w with oil|strong="H8081"\w*— \w three-tenths of an ephah|strong="H7969"\w* \w with each|strong="H259"\w* \w bull|strong="H6499"\w*, \w two-tenths of an ephah|strong="H8147"\w* \w with the ram|strong="H352"\w*, \v 29 \w and a tenth of an ephah|strong="H6241"\w* \w with each|strong="H259"\w* \w of the seven|strong="H7651"\w* \w lambs|strong="H3532"\w*.
\p \v 30 \w Include one|strong="H259"\w* \w male goat|strong="H8163"\w* \w to make atonement|strong="H3722"\w* \w for you|strong="H5921"\w*. \v 31 \w Offer them|strong="H6213"\w* \w with their drink offerings|strong="H5262"\w* \w in addition to|strong="H905"\w* \w the regular|strong="H8548"\w* \w burnt offering|strong="H5930"\w* \w and its grain offering|strong="H4503"\w*. \w The animals must be|strong="H1961"\w* \w unblemished|strong="H8549"\w*.[’’]
\c 29
\s1 The Feast of Trumpets
\r (\ref Leviticus 23:23–25|LEV 23:23-25\ref*)
\p \v 1 “\w On the first|strong="H259"\w* \w day|strong="H2320"\w* \w of the seventh|strong="H7637"\w* \w month|strong="H2320"\w*, \w you are to hold|strong="H1961"\w* \w a sacred|strong="H6944"\w* \w assembly|strong="H4744"\w*, \w and you must not|strong="H3808"\w* \w do|strong="H6213"\w* \w any|strong="H3605"\w* \w regular work|strong="H4399"\w*. \w This will be|strong="H1961"\w* \w a day|strong="H3117"\w* for you \w to sound the trumpets|strong="H8643"\w*.
\p \v 2 \w As a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w* \w to the LORD|strong="H3068"\w*, \w you are to present|strong="H6213"\w* \w a burnt offering|strong="H5930"\w* \w of one|strong="H259"\w* \w young|strong="H1121"\w* \w bull|strong="H6499"\w*, \w one|strong="H259"\w* \w ram|strong="H352"\w*, \w and seven|strong="H7651"\w* \w male lambs|strong="H3532"\w* \w a year old|strong="H1121"\w*, \w all unblemished|strong="H8549"\w*, \v 3 \w together with their grain offerings|strong="H4503"\w* \w of fine flour|strong="H5560"\w* \w mixed|strong="H1101"\w* \w with oil|strong="H8081"\w*— \w three-tenths of an ephah|strong="H7969"\w*\f + \fr 29:3 \fqa Three-tenths of an ephah\ft is \ref approximately 6|6\ref* dry quarts or 6.6 liters (probably about 7.6 pounds or 3.5 kilograms of flour); also in verses 9 and 14.\f* \w with the bull|strong="H6499"\w*, \w two-tenths of an ephah|strong="H8147"\w*\f + \fr 29:3 \fqa Two-tenths of an ephah\ft is \ref approximately 4|4\ref* dry quarts or 4.4 liters (probably about 5.1 pounds or 2.3 kilograms of flour); also in verses 9 and 14.\f* \w with the ram|strong="H352"\w*, \v 4 \w and a tenth of an ephah|strong="H6241"\w*\f + \fr 29:4 \fqa A tenth of an ephah\ft is \ref approximately 2|2\ref* dry quarts or 2.2 liters (probably about 2.6 pounds or 1.2 kilograms of flour); also in verses 10 and 15.\f* \w with each|strong="H259"\w* \w of the seven|strong="H7651"\w* \w male lambs|strong="H3532"\w*.
\p \v 5 \w Include one|strong="H259"\w* \w male goat|strong="H8163"\w* \w as a sin offering|strong="H2403"\w* \w to make atonement|strong="H3722"\w* \w for you|strong="H5921"\w*. \v 6 \w These are in addition to|strong="H905"\w* \w the monthly|strong="H2320"\w* \w and daily|strong="H8548"\w* \w burnt offerings|strong="H5930"\w* \w with their prescribed|strong="H4941"\w* \w grain offerings|strong="H4503"\w* \w and drink offerings|strong="H5262"\w*. \w They are a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w*, \w a food offering|strong="H801"\w* \w to the LORD|strong="H3068"\w*.
\s1 The Day of Atonement
\r (\ref Leviticus 16:1–34|LEV 16:1-34\ref*; \ref Leviticus 23:26–32|LEV 23:26-32\ref*)
\p \v 7 \w On the tenth|strong="H6218"\w* \w day of this|strong="H2088"\w* \w seventh|strong="H7637"\w* \w month|strong="H2320"\w*, \w you are to hold|strong="H1961"\w* \w a sacred|strong="H6944"\w* \w assembly|strong="H4744"\w*, \w and you shall humble|strong="H6031"\w* \w yourselves|strong="H5315"\w*;\f + \fr 29:7 \ft Or \fqa afflict your souls \ft or \fqa deny yourselves\f* \w you must not|strong="H3808"\w* \w do|strong="H6213"\w* \w any|strong="H3605"\w* \w work|strong="H4399"\w*.
\p \v 8 \w Present|strong="H7126"\w* \w as a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w* \w to the LORD|strong="H3068"\w* \w a burnt offering|strong="H5930"\w* \w of one|strong="H259"\w* \w young|strong="H1121"\w* \w bull|strong="H6499"\w*, \w one|strong="H259"\w* \w ram|strong="H352"\w*, \w and seven|strong="H7651"\w* \w male lambs|strong="H3532"\w* \w a year old|strong="H1121"\w*, \w all|strong="H1961"\w* \w unblemished|strong="H8549"\w*, \v 9 \w together with their grain offerings|strong="H4503"\w* \w of fine flour|strong="H5560"\w* \w mixed|strong="H1101"\w* \w with oil|strong="H8081"\w*— \w three-tenths of an ephah|strong="H7969"\w* \w with the bull|strong="H6499"\w*, \w two-tenths of an ephah|strong="H8147"\w* \w with the ram|strong="H352"\w*, \v 10 \w and a tenth of an ephah|strong="H6241"\w* \w with each|strong="H259"\w* \w of the seven|strong="H7651"\w* \w lambs|strong="H3532"\w*.
\p \v 11 \w Include one|strong="H259"\w* \w male goat|strong="H8163"\w* \w for a sin offering|strong="H2403"\w*, \w in addition to|strong="H905"\w* \w the sin offering|strong="H2403"\w* \w of atonement|strong="H3725"\w* \w and the regular|strong="H8548"\w* \w burnt offering|strong="H5930"\w* \w with its grain offering|strong="H4503"\w* \w and drink offerings|strong="H5262"\w*.
\s1 The Feast of Tabernacles
\r (\ref Deuteronomy 16:13–17|DEU 16:13-17\ref*)
\p \v 12 \w On the fifteenth|strong="H2568"\w* \w day|strong="H3117"\w* \w of the seventh|strong="H7637"\w* \w month|strong="H2320"\w*, \w you are to hold|strong="H1961"\w* \w a sacred|strong="H6944"\w* \w assembly|strong="H4744"\w*; \w you must not|strong="H3808"\w* \w do|strong="H6213"\w* \w any|strong="H3605"\w* \w regular work|strong="H4399"\w*, \w and you shall observe|strong="H2287"\w* \w a feast|strong="H2282"\w* \w to the LORD|strong="H3068"\w* \w for seven|strong="H7651"\w* \w days|strong="H3117"\w*.
\p \v 13 \w As a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w* \w to the LORD|strong="H3068"\w*, \w you are to present|strong="H7126"\w* \w a food offering|strong="H801"\w*, \w a burnt offering|strong="H5930"\w* \w of thirteen|strong="H7969"\w* \w young|strong="H1121"\w* \w bulls|strong="H6499"\w*, \w two|strong="H8147"\w* \w rams|strong="H352"\w*, \w and fourteen|strong="H702"\w* \w male lambs|strong="H3532"\w* \w a year old|strong="H1121"\w*, \w all|strong="H1961"\w* \w unblemished|strong="H8549"\w*, \v 14 \w along with the grain offering|strong="H4503"\w* \w of three-tenths of an ephah|strong="H7969"\w* \w of fine flour|strong="H5560"\w* \w mixed|strong="H1101"\w* \w with oil|strong="H8081"\w* \w with each|strong="H259"\w* \w of the thirteen|strong="H7969"\w* \w bulls|strong="H6499"\w*, \w two-tenths of an ephah|strong="H8147"\w* \w with each|strong="H259"\w* \w of the two|strong="H8147"\w* \w rams|strong="H352"\w*, \v 15 \w and a tenth of an ephah|strong="H6241"\w* \w with each|strong="H259"\w* \w of the fourteen|strong="H702"\w* \w lambs|strong="H3532"\w*. \v 16 \w Include one|strong="H259"\w* \w male goat|strong="H8163"\w* \w as a sin offering|strong="H2403"\w*, \w in addition to|strong="H905"\w* \w the regular|strong="H8548"\w* \w burnt offering|strong="H5930"\w* \w with its grain offering|strong="H4503"\w* \w and drink offering|strong="H5262"\w*.
