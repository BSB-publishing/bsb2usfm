\li1 \v 48 \w They set out|strong="H5265"\w* \w from the mountains|strong="H2022"\w* \w of Abarim|strong="H5682"\w* \w and camped|strong="H2583"\w* \w on the plains|strong="H6160"\w* \w of Moab|strong="H4124"\w* \w by|strong="H5921"\w* \w the Jordan|strong="H3383"\w* \w across from Jericho|strong="H3405"\w*.
\li1 \v 49 \w And there on the plains|strong="H6160"\w* \w of Moab|strong="H4124"\w* \w they camped|strong="H2583"\w* \w by|strong="H5921"\w* \w the Jordan|strong="H3383"\w*, \w from Beth-jeshimoth|strong="H1020"\w* \w to|strong="H5704"\w* \w Abel-shittim|strong="H63"\w*.\f + \fr 33:49 \ft Or \fqa the Meadow of the Acacias\ft ; that is, an area in the lowlands of Moab\f*
\s1 Instructions for Occupying Canaan
\p \v 50 \w On the plains|strong="H6160"\w* \w of Moab|strong="H4124"\w* \w by|strong="H5921"\w* \w the Jordan|strong="H3383"\w* \w across from Jericho|strong="H3405"\w*, \w the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 51 “\w Speak|strong="H1696"\w* \w to|strong="H413"\w* \w the Israelites|strong="H1121"\w* \w and tell|strong="H559"\w* \w them|strong="H413"\w*: \w When|strong="H3588"\w* \w you|strong="H859"\w* \w cross|strong="H5674"\w* \w the Jordan|strong="H3383"\w* \w into|strong="H413"\w* \w the land|strong="H776"\w* \w of Canaan|strong="H3667"\w*, \v 52 \w you must drive out|strong="H3423"\w* \w before you|strong="H6440"\w* \w all|strong="H3605"\w* \w the inhabitants|strong="H3427"\w* \w of the land|strong="H776"\w*, \w destroy|strong="H6"\w* \w all|strong="H3605"\w* \w their carved images|strong="H4906"\w* \w and cast|strong="H4541"\w* \w idols|strong="H6754"\w*, \w and|strong="H853"\w* \w demolish|strong="H8045"\w* \w all|strong="H3605"\w* \w their high places|strong="H1116"\w*.
\p \v 53 \w You are to take possession of|strong="H3423"\w* \w the land|strong="H776"\w* \w and settle|strong="H3427"\w* in it, \w for|strong="H3588"\w* \w I have given|strong="H5414"\w* you \w the land|strong="H776"\w* \w to possess|strong="H3423"\w*. \v 54 \w And you are to divide|strong="H5157"\w* \w the land|strong="H776"\w* \w by lot|strong="H1486"\w* \w according to your clans|strong="H4940"\w*. \w Give a larger|strong="H7235"\w* \w inheritance|strong="H5159"\w* \w to a larger clan|strong="H7227"\w* \w and a smaller|strong="H4591"\w* \w inheritance|strong="H5159"\w* \w to a smaller one|strong="H4592"\w*. \w Whatever|strong="H834"\w* \w falls|strong="H3318"\w* to each one \w by lot|strong="H1486"\w* \w will be|strong="H1961"\w* his. \w You will receive an inheritance|strong="H5157"\w* \w according to the tribes|strong="H4294"\w* \w of your fathers|strong="H1"\w*.
\p \v 55 \w But if|strong="H518"\w* \w you do not|strong="H3808"\w* \w drive out|strong="H3423"\w* \w the inhabitants|strong="H3427"\w* \w of the land|strong="H776"\w* \w before you|strong="H6440"\w*, \w those|strong="H834"\w* \w you allow to remain|strong="H3498"\w* \w will become|strong="H1961"\w* \w barbs|strong="H7899"\w* \w in your eyes|strong="H5869"\w* \w and thorns|strong="H6796"\w* \w in your sides|strong="H6654"\w*; \w they will harass|strong="H6887"\w* \w you in|strong="H5921"\w* \w the land|strong="H776"\w* \w where|strong="H834"\w* \w you|strong="H859"\w* \w settle|strong="H3427"\w*. \v 56 \w And then|strong="H1961"\w* \w I will do|strong="H6213"\w* to you \w what|strong="H834"\w* \w I had planned|strong="H1819"\w* \w to do|strong="H6213"\w* to them.”
\c 34
\s1 The Boundaries of Canaan
\r (\ref Genesis 15:8–21|GEN 15:8-21\ref*)
\p \v 1 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 2 “\w Command|strong="H6680"\w* \w the Israelites|strong="H1121"\w* \w and say|strong="H559"\w* \w to them|strong="H413"\w*: \w When|strong="H3588"\w* \w you|strong="H859"\w* \w enter|strong="H935"\w* \w the land|strong="H776"\w* \w of Canaan|strong="H3667"\w*, \w it|strong="H776"\w* \w will be allotted|strong="H5307"\w* to you \w as an inheritance|strong="H5159"\w* \w with these boundaries|strong="H1367"\w*:
\li1 \v 3 Your \w southern|strong="H5045"\w* \w border|strong="H6285"\w* \w will extend|strong="H1961"\w* \w from the Wilderness|strong="H4057"\w* \w of Zin|strong="H6790"\w* \w along|strong="H5921"\w* \w the border|strong="H3027"\w* \w of Edom|strong="H123"\w*. \w On the east|strong="H6924"\w*, \w your southern|strong="H5045"\w* \w border|strong="H1366"\w* \w will run|strong="H1961"\w* \w from the end|strong="H7097"\w* \w of the Salt|strong="H4417"\w* \w Sea|strong="H3220"\w*,\f + \fr 34:3 \ft That is, the Dead Sea; also in verse 12\f* \v 4 \w cross|strong="H5437"\w* \w south|strong="H5045"\w* \w of the Ascent|strong="H4610"\w* \w of Akrabbim|strong="H4610"\w*,\f + \fr 34:4 \ft Or \fqa the Ascent of Scorpions \ft or \fqa Scorpion Pass\f* \w continue|strong="H5674"\w* \w to Zin|strong="H6790"\w*, \w and go|strong="H1961"\w* \w south|strong="H5045"\w* \w of Kadesh-barnea|strong="H6947"\w*. \w Then it will go on|strong="H3318"\w* \w to Hazar-addar|strong="H2692"\w* \w and proceed|strong="H5674"\w* \w to Azmon|strong="H6111"\w*, \v 5 \w where it|strong="H1366"\w* \w will turn|strong="H5437"\w* \w from Azmon|strong="H6111"\w*, \w join the Brook|strong="H5158"\w* \w of Egypt|strong="H4714"\w*, \w and end|strong="H1961"\w* \w at the Sea|strong="H3220"\w*.\f + \fr 34:5 \ft That is, the Mediterranean Sea, also called the Great Sea; also in verses 6 and 7\f*
\li1 \v 6 Your \w western|strong="H3220"\w* \w border|strong="H1366"\w* \w will be|strong="H1961"\w* \w the coastline|strong="H1366"\w* \w of the Great|strong="H1419"\w* \w Sea|strong="H3220"\w*; \w this|strong="H2088"\w* \w will be|strong="H1961"\w* your \w boundary|strong="H1366"\w* \w on the west|strong="H3220"\w*.
\li1 \v 7 Your \w northern|strong="H6828"\w* \w border|strong="H1366"\w* \w will run|strong="H1961"\w* \w from|strong="H4480"\w* \w the Great|strong="H1419"\w* \w Sea|strong="H3220"\w* \w directly|strong="H8376"\w* \w to Mount|strong="H2022"\w* \w Hor|strong="H2023"\w*, \v 8 \w and from Mount|strong="H2022"\w* \w Hor|strong="H2023"\w* \w to Lebo-hamath|strong="H2574"\w*, \w then|strong="H1366"\w* \w extend|strong="H1961"\w* \w to Zedad|strong="H6657"\w*, \v 9 \w continue|strong="H3318"\w* \w to Ziphron|strong="H2202"\w*, \w and end|strong="H1961"\w* \w at Hazar-enan|strong="H2704"\w*. \w This|strong="H2088"\w* \w will be|strong="H1961"\w* your \w boundary|strong="H1366"\w* \w on the north|strong="H6828"\w*.
\li1 \v 10 \w And your eastern|strong="H6924"\w* \w border|strong="H1366"\w* \w will run straight|strong="H183"\w* from \w Hazar-enan|strong="H2704"\w* \w to Shepham|strong="H8221"\w*, \v 11 \w then|strong="H1366"\w* \w go down|strong="H3381"\w* \w from Shepham|strong="H8221"\w* \w to Riblah|strong="H7247"\w* \w on the east side|strong="H6924"\w* \w of Ain|strong="H5871"\w* \w and continue along|strong="H3381"\w* \w the slopes|strong="H3802"\w* \w east|strong="H6924"\w* \w of the Sea|strong="H3220"\w* \w of Chinnereth|strong="H3672"\w*.\f + \fr 34:11 \ft That is, the Sea of Galilee\f* \v 12 \w Then the border|strong="H1366"\w* \w will go down|strong="H3381"\w* \w along the Jordan|strong="H3383"\w* \w and end|strong="H1961"\w* \w at the Salt|strong="H4417"\w* \w Sea|strong="H3220"\w*.
\p \w This|strong="H2063"\w* \w will be|strong="H1961"\w* your \w land|strong="H776"\w*, \w defined by its borders|strong="H1367"\w* \w on all sides|strong="H5439"\w*.”
\p \v 13 \w So Moses|strong="H4872"\w* \w commanded|strong="H6680"\w* \w the Israelites|strong="H1121"\w*, “\w Apportion this|strong="H2063"\w* \w land|strong="H776"\w* \w by lot|strong="H1486"\w* \w as an inheritance|strong="H5157"\w*. \w The LORD|strong="H3068"\w* \w has commanded that|strong="H6680"\w* \w it be given|strong="H5414"\w* \w to the nine|strong="H8672"\w* \w and a half|strong="H2677"\w* \w tribes|strong="H4294"\w*. \v 14 \w For|strong="H3588"\w* \w the tribes|strong="H4294"\w* \w of the Reubenites|strong="H1121"\w* \w and|strong="H4294"\w* \w Gadites|strong="H1121"\w*, \w along with the half-tribe|strong="H2677"\w* \w of Manasseh|strong="H4519"\w*, \w have already received|strong="H3947"\w* \w their inheritance|strong="H5159"\w*. \v 15 \w These two|strong="H8147"\w* \w and a half|strong="H2677"\w* \w tribes|strong="H4294"\w* \w have received|strong="H3947"\w* \w their inheritance|strong="H5159"\w* \w across|strong="H5676"\w* \w the Jordan|strong="H3383"\w* \w from Jericho|strong="H3405"\w*, \w toward the sunrise|strong="H4217"\w*.”
\s1 Leaders to Divide the Land
\p \v 16 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 17 “\w These|strong="H428"\w* \w are the names|strong="H8034"\w* \w of the men|strong="H582"\w* \w who|strong="H834"\w* \w are to assign the land|strong="H776"\w* \w as an inheritance|strong="H5157"\w* for you: \w Eleazar|strong="H499"\w* \w the priest|strong="H3548"\w* \w and Joshua|strong="H3091"\w* \w son|strong="H1121"\w* \w of Nun|strong="H5126"\w*. \v 18 \w Appoint|strong="H3947"\w* \w one|strong="H259"\w* \w leader|strong="H5387"\w* \w from each|strong="H259"\w* \w tribe|strong="H4294"\w* \w to distribute|strong="H5157"\w* \w the land|strong="H776"\w*. \v 19 \w These|strong="H428"\w* \w are their names|strong="H8034"\w*:
\li1 \w Caleb|strong="H3612"\w* \w son|strong="H1121"\w* \w of Jephunneh|strong="H3312"\w* \w from the tribe|strong="H4294"\w* \w of Judah|strong="H3063"\w*;
\li1 \v 20 \w Shemuel|strong="H8050"\w* \w son|strong="H1121"\w* \w of Ammihud|strong="H5989"\w* \w from the tribe|strong="H4294"\w* \w of Simeon|strong="H8095"\w*;
\li1 \v 21 \w Elidad|strong="H449"\w* \w son|strong="H1121"\w* \w of Chislon|strong="H3692"\w* \w from the tribe|strong="H4294"\w* \w of Benjamin|strong="H1144"\w*;
\li1 \v 22 \w Bukki|strong="H1231"\w* \w son|strong="H1121"\w* \w of Jogli|strong="H3020"\w*, \w a leader|strong="H5387"\w* \w from the tribe|strong="H4294"\w* \w of Dan|strong="H1835"\w*;
\li1 \v 23 \w Hanniel|strong="H2592"\w* \w son|strong="H1121"\w* \w of Ephod|strong="H641"\w*, \w a leader|strong="H5387"\w* \w from the tribe|strong="H4294"\w* \w of Manasseh|strong="H1121"\w* \w son|strong="H1121"\w* \w of Joseph|strong="H3130"\w*;
\li1 \v 24 \w Kemuel|strong="H7055"\w* \w son|strong="H1121"\w* \w of Shiphtan|strong="H8204"\w*, \w a leader|strong="H5387"\w* \w from the tribe|strong="H4294"\w* \w of Ephraim|strong="H669"\w*;
\li1 \v 25 \w Eli-zaphan|strong="H469"\w* \w son|strong="H1121"\w* \w of Parnach|strong="H6535"\w*, \w a leader|strong="H5387"\w* \w from the tribe|strong="H4294"\w* \w of Zebulun|strong="H2074"\w*;
\li1 \v 26 \w Paltiel|strong="H6409"\w* \w son|strong="H1121"\w* \w of Azzan|strong="H5821"\w*, \w a leader|strong="H5387"\w* \w from the tribe|strong="H4294"\w* \w of Issachar|strong="H3485"\w*;
\li1 \v 27 \w Ahihud|strong="H282"\w* \w son|strong="H1121"\w* \w of Shelomi|strong="H8015"\w*, \w a leader|strong="H5387"\w* \w from the tribe|strong="H4294"\w* \w of Asher|strong="H836"\w*;
\li1 \v 28 \w and Pedahel|strong="H6300"\w* \w son|strong="H1121"\w* \w of Ammihud|strong="H5989"\w*, \w a leader|strong="H5387"\w* \w from the tribe|strong="H4294"\w* \w of Naphtali|strong="H5321"\w*.”
\p \v 29 \w These|strong="H428"\w* \w are the ones whom|strong="H834"\w* \w the LORD|strong="H3068"\w* \w commanded|strong="H6680"\w* \w to apportion the inheritance|strong="H5157"\w* \w to the Israelites|strong="H1121"\w* \w in the land|strong="H776"\w* \w of Canaan|strong="H3667"\w*.
\c 35
\s1 Forty-Eight Cities for the Levites
\r (\ref Joshua 21:1–45|JOS 21:1-45\ref*; \ref 1 Chronicles 6:54–81|1CH 6:54-81\ref*)
\p \v 1 \w Again the LORD|strong="H3068"\w* \w spoke|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w* \w on the plains|strong="H6160"\w* \w of Moab|strong="H4124"\w* \w by|strong="H5921"\w* \w the Jordan|strong="H3383"\w* \w across from Jericho|strong="H3405"\w*: \v 2 “\w Command|strong="H6680"\w* \w the Israelites|strong="H1121"\w* \w to give|strong="H5414"\w*, \w from the inheritance|strong="H5159"\w* \w they will possess|strong="H272"\w*, \w cities|strong="H5892"\w* \w for the Levites|strong="H3881"\w* \w to live in|strong="H3427"\w* \w and pasturelands|strong="H4054"\w* \w around|strong="H5439"\w* \w the cities|strong="H5892"\w*. \v 3 \w The cities|strong="H5892"\w* \w will be|strong="H1961"\w* for them \w to live in|strong="H3427"\w*, \w and the pasturelands|strong="H4054"\w* \w will be|strong="H1961"\w* \w for their herds|strong="H929"\w*, \w their flocks|strong="H7399"\w*, \w and all|strong="H3605"\w* \w their other livestock|strong="H2416"\w*.
\p \v 4 \w The pasturelands|strong="H4054"\w* \w around the cities|strong="H5892"\w* \w you are to give|strong="H5414"\w* \w the Levites|strong="H3881"\w* \w will extend|strong="H2351"\w* \w a thousand|strong="H505"\w* \w cubits|strong="H520"\w*\f + \fr 35:4 \fqa \ref 1,000|0\ref* cubits\ft is \ref approximately 1|1\ref*,500 feet or 457.2 meters.\f* \w from the wall|strong="H7023"\w* \w on every side|strong="H5439"\w*. \v 5 \w You are also to measure|strong="H4058"\w* \w two thousand|strong="H505"\w* \w cubits|strong="H520"\w*\f + \fr 35:5 \fqa \ref 2,000|0\ref* cubits\ft is \ref approximately 3|3\ref*,000 feet or 914.4 meters.\f* \w outside|strong="H2351"\w* \w the city|strong="H5892"\w* \w on the east|strong="H6924"\w*, \w two thousand|strong="H505"\w* \w on the south|strong="H5045"\w*, \w two thousand|strong="H505"\w* \w on the west|strong="H3220"\w*, \w and two thousand|strong="H505"\w* \w on the north|strong="H6828"\w*, \w with the city|strong="H5892"\w* \w in the center|strong="H8432"\w*. \w These areas|strong="H2088"\w* \w will serve|strong="H1961"\w* \w as larger pasturelands|strong="H4054"\w* \w for the cities|strong="H5892"\w*.
\p \v 6 \w Six|strong="H8337"\w* \w of the cities|strong="H5892"\w* \w you give|strong="H5414"\w* \w the Levites|strong="H3881"\w* \w are to be appointed|strong="H5414"\w* \w as cities|strong="H5892"\w* \w of refuge|strong="H4733"\w*, \w to which a manslayer|strong="H7523"\w* \w may flee|strong="H5127"\w*. \w In addition to these|strong="H5921"\w*, \w give the Levites|strong="H5414"\w* \w forty-two|strong="H705"\w* \w other cities|strong="H5892"\w*. \v 7 \w The total|strong="H3605"\w* \w number of cities|strong="H5892"\w* \w you give|strong="H5414"\w* \w the Levites|strong="H3881"\w* \w will be forty-eight|strong="H705"\w*, \w with their corresponding|strong="H853"\w* \w pasturelands|strong="H4054"\w*. \v 8 \w The cities|strong="H5892"\w* \w that|strong="H834"\w* \w you apportion|strong="H5414"\w* \w from the territory|strong="H272"\w* \w of the Israelites|strong="H3478"\w* \w should be given|strong="H5414"\w* \w to the Levites|strong="H3881"\w* \w in proportion to|strong="H6310"\w* \w the inheritance|strong="H5159"\w* \w of each tribe|strong="H376"\w*: \w more from|strong="H7235"\w* \w a larger tribe|strong="H7227"\w* \w and less from|strong="H4591"\w* \w a smaller one|strong="H4592"\w*.”
\s1 Six Cities of Refuge
\r (\ref Deuteronomy 4:41–43|DEU 4:41-43\ref*; \ref Deuteronomy 19:1–14|DEU 19:1-14\ref*; \ref Joshua 20:1–9|JOS 20:1-9\ref*)
\p \v 9 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 10 “\w Speak|strong="H1696"\w* \w to|strong="H413"\w* \w the Israelites|strong="H1121"\w* \w and tell them|strong="H559"\w*: \w When|strong="H3588"\w* \w you|strong="H859"\w* \w cross|strong="H5674"\w* \w the Jordan|strong="H3383"\w* \w into the land|strong="H776"\w* \w of Canaan|strong="H3667"\w*, \v 11 \w designate|strong="H7136"\w* \w cities|strong="H5892"\w* \w to serve as|strong="H1961"\w* your \w cities|strong="H5892"\w* \w of refuge|strong="H4733"\w*, \w so that a person|strong="H7523"\w* \w who kills|strong="H5221"\w* \w someone|strong="H5315"\w* \w unintentionally|strong="H7684"\w* \w may flee|strong="H5127"\w* \w there|strong="H8033"\w*. \v 12 \w You are to have|strong="H1961"\w* \w these cities|strong="H5892"\w* \w as a refuge|strong="H4733"\w* \w from the avenger|strong="H1350"\w*, \w so that the manslayer|strong="H7523"\w* \w will not|strong="H3808"\w* \w die|strong="H4191"\w* \w until|strong="H5704"\w* \w he stands|strong="H5975"\w* \w trial|strong="H4941"\w* \w before|strong="H6440"\w* \w the assembly|strong="H5712"\w*.
\p \v 13 \w The cities|strong="H5892"\w* \w you select|strong="H5414"\w* \w will be|strong="H1961"\w* your \w six|strong="H8337"\w* \w cities|strong="H5892"\w* \w of refuge|strong="H4733"\w*. \v 14 \w Select three|strong="H7969"\w* \w cities|strong="H5892"\w* \w across|strong="H5676"\w* \w the Jordan|strong="H3383"\w* \w and three|strong="H7969"\w* \w in the land|strong="H776"\w* \w of Canaan|strong="H3667"\w* \w as|strong="H1961"\w* \w cities|strong="H5892"\w* \w of refuge|strong="H4733"\w*. \v 15 \w These|strong="H428"\w* \w six|strong="H8337"\w* \w cities|strong="H5892"\w* \w will serve|strong="H1961"\w* \w as a refuge|strong="H4733"\w* \w for the Israelites|strong="H1121"\w* \w and for the foreigner|strong="H1616"\w* \w or stranger|strong="H8453"\w* \w among them|strong="H8432"\w*, \w so that anyone|strong="H3605"\w* \w who kills|strong="H5221"\w* \w a person|strong="H5315"\w* \w unintentionally|strong="H7684"\w* \w may flee|strong="H5127"\w* \w there|strong="H8033"\w*.
\p \v 16 \w If, however|strong="H518"\w*, \w anyone strikes|strong="H5221"\w* \w a person with an iron|strong="H1270"\w* \w object|strong="H3627"\w* \w and kills him|strong="H4191"\w*, \w he|strong="H1931"\w* \w is a murderer|strong="H7523"\w*; \w the murderer|strong="H7523"\w* \w must surely be put to death|strong="H4191"\w*. \v 17 \w Or if|strong="H518"\w* \w anyone has in his hand|strong="H3027"\w* \w a stone|strong="H68"\w* \w of deadly size|strong="H4191"\w*, \w and he strikes|strong="H5221"\w* \w and kills another|strong="H4191"\w*, \w he is a murderer|strong="H7523"\w*; \w the murderer|strong="H7523"\w* \w must surely be put to death|strong="H4191"\w*. \v 18 \w If|strong="H176"\w* \w anyone has in his hand|strong="H3027"\w* \w a deadly|strong="H4191"\w* \w object|strong="H3627"\w* \w of wood|strong="H6086"\w*, \w and he strikes|strong="H5221"\w* \w and kills another|strong="H4191"\w*, \w he is a murderer|strong="H7523"\w*; \w the murderer|strong="H7523"\w* \w must surely be put to death|strong="H4191"\w*.
\p \v 19 \w The avenger|strong="H1350"\w* \w of blood|strong="H1818"\w* \w is to put the murderer|strong="H7523"\w* \w to death|strong="H4191"\w*; \w when he finds|strong="H6293"\w* him, \w he|strong="H1931"\w* \w is to kill him|strong="H4191"\w*.
\p \v 20 \w Likewise, if|strong="H518"\w* \w anyone maliciously|strong="H8135"\w* \w pushes another|strong="H1920"\w* \w or|strong="H176"\w* \w intentionally|strong="H6660"\w* \w throws an object|strong="H7993"\w* \w at him|strong="H5921"\w* \w and kills him|strong="H4191"\w*, \v 21 \w or|strong="H176"\w* \w if in hostility|strong="H342"\w* \w he strikes him|strong="H5221"\w* \w with his hand|strong="H3027"\w* \w and he dies|strong="H4191"\w*, \w the one who struck him|strong="H5221"\w* \w must surely be put to death|strong="H4191"\w*; \w he|strong="H1931"\w* \w is a murderer|strong="H7523"\w*. \w When the avenger|strong="H1350"\w* \w of blood|strong="H1818"\w* \w finds|strong="H6293"\w* \w the murderer|strong="H7523"\w*, \w he is to kill|strong="H4191"\w* \w him|strong="H853"\w*.
\p \v 22 \w But if anyone|strong="H518"\w* \w pushes a person|strong="H1920"\w* \w suddenly|strong="H6621"\w*, \w without|strong="H3808"\w* \w hostility|strong="H342"\w*, \w or|strong="H176"\w* \w throws|strong="H7993"\w* \w an|strong="H3605"\w* \w object|strong="H3627"\w* \w at him|strong="H5921"\w* \w unintentionally|strong="H3808"\w*, \v 23 \w or|strong="H176"\w* \w without|strong="H3808"\w* \w looking|strong="H7200"\w* \w drops|strong="H5307"\w* \w a heavy stone|strong="H68"\w* \w that kills him|strong="H4191"\w*, \w but he|strong="H1931"\w* \w was not|strong="H3808"\w* \w an enemy|strong="H341"\w* \w and did not|strong="H3808"\w* \w intend|strong="H1245"\w* \w to harm him|strong="H7451"\w*, \v 24 \w then the congregation|strong="H5712"\w* \w must judge|strong="H8199"\w* \w between|strong="H996"\w* \w the slayer|strong="H5221"\w* \w and the avenger|strong="H1350"\w* \w of blood|strong="H1818"\w* \w according to|strong="H5921"\w* \w these|strong="H428"\w* \w ordinances|strong="H4941"\w*. \v 25 \w The assembly|strong="H5712"\w* \w is to protect|strong="H5337"\w* \w the manslayer|strong="H7523"\w* \w from the hand|strong="H3027"\w* \w of the avenger|strong="H1350"\w* \w of blood|strong="H1818"\w*. \w Then the assembly|strong="H5712"\w* \w will return|strong="H7725"\w* \w him|strong="H853"\w* \w to|strong="H413"\w* \w the city|strong="H5892"\w* \w of refuge|strong="H4733"\w* \w to which|strong="H834"\w* \w he fled|strong="H5127"\w*, \w and he must live|strong="H3427"\w* there \w until|strong="H5704"\w* \w the death|strong="H4194"\w* \w of the high|strong="H1419"\w* \w priest|strong="H3548"\w*, \w who|strong="H834"\w* \w was anointed|strong="H4886"\w* \w with the holy|strong="H6944"\w* \w oil|strong="H8081"\w*.
\p \v 26 \w But if|strong="H518"\w* \w the manslayer|strong="H7523"\w* \w ever goes outside|strong="H3318"\w* \w the limits|strong="H1366"\w* \w of the city|strong="H5892"\w* \w of refuge|strong="H4733"\w* \w to which he fled|strong="H5127"\w* \v 27 \w and the avenger|strong="H1350"\w* \w of blood|strong="H1818"\w* \w finds|strong="H4672"\w* \w him|strong="H853"\w* \w outside|strong="H2351"\w* \w of his city|strong="H5892"\w* \w of refuge|strong="H4733"\w* \w and kills him|strong="H7523"\w*, \w then the avenger|strong="H1350"\w* \w will not|strong="H369"\w* \w be guilty of bloodshed|strong="H1818"\w*, \v 28 \w because|strong="H3588"\w* \w the manslayer must remain|strong="H3427"\w* \w in his city|strong="H5892"\w* \w of refuge|strong="H4733"\w* \w until|strong="H5704"\w* \w the death|strong="H4194"\w* \w of the high|strong="H1419"\w* \w priest|strong="H3548"\w*. \w Only after|strong="H310"\w* \w the death|strong="H4194"\w* \w of the high|strong="H1419"\w* \w priest|strong="H3548"\w* \w may he|strong="H7523"\w* \w return|strong="H7725"\w* \w to|strong="H413"\w* \w the land|strong="H776"\w* \w he owns|strong="H272"\w*. \v 29 \w This|strong="H428"\w* \w will be|strong="H1961"\w* \w a statutory|strong="H2708"\w* \w ordinance|strong="H4941"\w* for you \w for the generations to come|strong="H1755"\w*, \w wherever|strong="H3605"\w* \w you live|strong="H4186"\w*.
\p \v 30 \w If anyone|strong="H3605"\w* \w kills|strong="H5221"\w* \w a person|strong="H5315"\w*, \w the murderer|strong="H7523"\w* \w is to be put to death|strong="H7523"\w* \w on the testimony|strong="H6310"\w* \w of the witnesses|strong="H5707"\w*. \w But no|strong="H3808"\w* \w one|strong="H5315"\w* \w is to be put to death|strong="H4191"\w* \w based on the testimony|strong="H6030"\w* \w of a lone|strong="H259"\w* \w witness|strong="H5707"\w*.
\p \v 31 \w You are not|strong="H3808"\w* \w to accept|strong="H3947"\w* \w a ransom|strong="H3724"\w* \w for the life|strong="H5315"\w* \w of a murderer|strong="H7523"\w* \w who|strong="H834"\w* \w deserves|strong="H7563"\w* \w to die|strong="H4191"\w*; \w he must surely be put to death|strong="H4191"\w*. \v 32 \w Nor|strong="H3808"\w* \w should you accept|strong="H3947"\w* \w a ransom|strong="H3724"\w* \w for the person who flees|strong="H5127"\w* \w to|strong="H413"\w* \w a city|strong="H5892"\w* \w of refuge|strong="H4733"\w* \w and allow him to return|strong="H7725"\w* \w and live|strong="H3427"\w* \w on his own land|strong="H776"\w* \w before|strong="H5704"\w* \w the death|strong="H4194"\w* \w of the high priest|strong="H3548"\w*.
\p \v 33 \w Do not|strong="H3808"\w* \w pollute|strong="H2610"\w* \w the land|strong="H776"\w* \w where|strong="H834"\w* \w you|strong="H859"\w* live, \w for|strong="H3588"\w* \w bloodshed|strong="H1818"\w* \w pollutes|strong="H2610"\w* \w the land|strong="H776"\w*, \w and no|strong="H3808"\w* \w atonement can be made|strong="H3722"\w* \w for the land|strong="H776"\w* \w on which the blood|strong="H1818"\w* \w is shed|strong="H8210"\w*, \w except|strong="H3588"\w* \w by the blood|strong="H1818"\w* \w of the one who shed it|strong="H8210"\w*. \v 34 \w Do not|strong="H3808"\w* \w defile|strong="H2930"\w* \w the land|strong="H776"\w* \w where|strong="H834"\w* \w you|strong="H859"\w* \w live|strong="H3427"\w* \w and where|strong="H834"\w* \w I|strong="H589"\w* \w dwell|strong="H7931"\w*. \w For|strong="H3588"\w* \w I|strong="H589"\w*, \w the LORD|strong="H3068"\w*, \w dwell|strong="H7931"\w* \w among|strong="H8432"\w* \w the Israelites|strong="H1121"\w*.”
\c 36
\s1 Zelophehad’s Daughters Marry
\r (\ref Numbers 27:1–11|NUM 27:1-11\ref*)
\p \v 1 \w Now the family|strong="H1"\w* \w heads|strong="H7218"\w* \w of the clan|strong="H4940"\w* \w of Gilead|strong="H1568"\w* \w son|strong="H1121"\w* \w of Machir|strong="H4353"\w* \w son|strong="H1121"\w* \w of Manasseh|strong="H4519"\w*, \w one of the clans|strong="H4940"\w* \w of Joseph|strong="H3130"\w*, \w approached|strong="H7126"\w* \w Moses|strong="H4872"\w* \w and the leaders|strong="H5387"\w* \w who were the heads|strong="H7218"\w* \w of the Israelite|strong="H1121"\w* \w families|strong="H3478"\w* \w and addressed them|strong="H1696"\w*, \v 2 \w saying|strong="H559"\w*, “\w When the LORD|strong="H3068"\w* \w commanded|strong="H6680"\w* \w my lord|strong="H113"\w* \w to give|strong="H5414"\w* \w the land|strong="H776"\w* \w as an inheritance|strong="H5159"\w* \w to the Israelites|strong="H1121"\w* \w by lot|strong="H1486"\w*, \w He|strong="H3068"\w* \w also commanded|strong="H6680"\w* \w him|strong="H113"\w* \w to give|strong="H5414"\w* \w the inheritance|strong="H5159"\w* \w of our brother|strong="H251"\w* \w Zelophehad|strong="H6765"\w* \w to his daughters|strong="H1323"\w*. \v 3 \w But if they marry|strong="H1961"\w* \w any of the men|strong="H259"\w* \w from the other tribes|strong="H7626"\w* \w of Israel|strong="H3478"\w*, \w their inheritance|strong="H5159"\w* \w will be withdrawn|strong="H1639"\w* \w from the portion|strong="H5159"\w* \w of our fathers|strong="H1"\w* \w and added|strong="H3254"\w* \w to|strong="H5921"\w* \w the tribe|strong="H4294"\w* \w into which|strong="H834"\w* \w they marry|strong="H1961"\w*. So our \w allotted|strong="H1486"\w* \w inheritance|strong="H5159"\w* \w would be taken away|strong="H1639"\w*. \v 4 \w And when|strong="H518"\w* \w the Jubilee|strong="H3104"\w* \w for the Israelites|strong="H1121"\w* \w comes|strong="H1961"\w*, \w their inheritance|strong="H5159"\w* \w will be added|strong="H3254"\w* \w to|strong="H5921"\w* \w the tribe|strong="H4294"\w* \w into which|strong="H834"\w* \w they marry|strong="H1961"\