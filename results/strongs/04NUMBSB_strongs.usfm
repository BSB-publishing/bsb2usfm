\li1 \v 35 \w They set out|strong="H5265"\w* \w from Abronah|strong="H5684"\w* \w and camped|strong="H2583"\w* \w at Ezion-geber|strong="H6100"\w*.
\li1 \v 36 \w They set out|strong="H5265"\w* \w from|strong="H6100"\w* \w Ezion-geber|strong="H6100"\w* \w and camped|strong="H2583"\w* \w at Kadesh|strong="H6946"\w* \w in the Wilderness|strong="H4057"\w* \w of Zin|strong="H6790"\w*.
\li1 \v 37 \w They set out|strong="H5265"\w* \w from Kadesh|strong="H6946"\w* \w and camped|strong="H2583"\w* \w at Mount|strong="H2022"\w* \w Hor|strong="H2023"\w*, \w on the outskirts|strong="H7097"\w* \w of the land|strong="H776"\w* \w of Edom|strong="H123"\w*. \v 38 \w At|strong="H5921"\w* \w the LORD’s|strong="H3068"\w* \w command|strong="H6310"\w*, \w Aaron|strong="H175"\w* \w the priest|strong="H3548"\w* \w climbed|strong="H5927"\w* \w Mount|strong="H2022"\w* \w Hor|strong="H2023"\w* \w and died|strong="H4191"\w* \w there|strong="H8033"\w* \w on the first|strong="H259"\w* \w day of the fifth|strong="H2549"\w* \w month|strong="H2320"\w*, \w in the fortieth|strong="H705"\w* \w year|strong="H8141"\w* \w after the Israelites|strong="H1121"\w* \w had come out|strong="H3318"\w* \w of the land|strong="H776"\w* \w of Egypt|strong="H4714"\w*. \v 39 \w Aaron|strong="H175"\w* \w was 123|strong="H7969"\w* \w years old|strong="H1121"\w* \w when he died|strong="H4191"\w* \w on Mount|strong="H2022"\w* \w Hor|strong="H2023"\w*.
\li1 \v 40 \w Now the Canaanite|strong="H3669"\w* \w king|strong="H4428"\w* \w of Arad|strong="H6166"\w*, \w who lived|strong="H3427"\w* \w in the Negev|strong="H5045"\w* \w in the land|strong="H776"\w* \w of Canaan|strong="H3667"\w*, \w heard|strong="H8085"\w* \w that the Israelites|strong="H1121"\w* \w were coming|strong="H935"\w*. \v 41 \w And the Israelites set out|strong="H5265"\w* \w from Mount|strong="H2022"\w* \w Hor|strong="H2023"\w* \w and camped|strong="H2583"\w* \w at Zalmonah|strong="H6758"\w*.
\li1 \v 42 \w They set out|strong="H5265"\w* \w from Zalmonah|strong="H6758"\w* \w and camped|strong="H2583"\w* \w at Punon|strong="H6325"\w*.
