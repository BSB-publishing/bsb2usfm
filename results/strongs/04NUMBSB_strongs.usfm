\p \v 22 \w Now if|strong="H3588"\w* \w you stray unintentionally|strong="H7686"\w* \w and do not|strong="H3808"\w* \w obey|strong="H6213"\w* \w all|strong="H3605"\w* \w these|strong="H428"\w* \w commandments|strong="H4687"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w has spoken|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*— \v 23 \w all|strong="H3605"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w has commanded|strong="H6680"\w* \w you through|strong="H3027"\w* \w Moses|strong="H4872"\w* \w from|strong="H4480"\w* \w the day|strong="H3117"\w* \w the LORD|strong="H3068"\w* \w gave them|strong="H6680"\w* \w and continuing through|strong="H1973"\w* \w the generations to come|strong="H1755"\w*— \v 24 \w and if|strong="H518"\w* \w it was done|strong="H6213"\w* \w unintentionally|strong="H7684"\w* \w without the knowledge|strong="H5869"\w* \w of the congregation|strong="H5712"\w*, \w then the whole|strong="H3605"\w* \w congregation|strong="H5712"\w* \w is to prepare|strong="H6213"\w* \w one|strong="H259"\w* \w young bull|strong="H6499"\w* \w as a burnt offering|strong="H5930"\w*, \w a pleasing|strong="H5207"\w* \w aroma|strong="H7381"\w* \w to the LORD|strong="H3068"\w*, \w with its grain offering|strong="H4503"\w* \w and drink offering|strong="H5262"\w* \w according to the regulation|strong="H4941"\w*, \w and one|strong="H259"\w* \w male goat|strong="H8163"\w* \w as a sin offering|strong="H2403"\w*.
