\p \v 6 \w So Moses|strong="H4872"\w* \w took|strong="H3947"\w* \w the carts|strong="H5699"\w* \w and oxen|strong="H1241"\w* \w and gave|strong="H5414"\w* \w them|strong="H853"\w* \w to|strong="H413"\w* \w the Levites|strong="H3881"\w*. \v 7 \w He gave|strong="H5414"\w* \w the Gershonites|strong="H1121"\w* \w two|strong="H8147"\w* \w carts|strong="H5699"\w* \w and four|strong="H702"\w* \w oxen|strong="H1241"\w*, \w as their service|strong="H5656"\w* \w required|strong="H6310"\w*, \v 8 \w and|strong="H853"\w* \w he gave|strong="H5414"\w* \w the Merarites|strong="H1121"\w* \w four|strong="H702"\w* \w carts|strong="H5699"\w* \w and eight|strong="H8083"\w* \w oxen|strong="H1241"\w*, \w as their service|strong="H5656"\w* \w required|strong="H6310"\w*, \w all under the direction|strong="H3027"\w* \w of Ithamar|strong="H385"\w* \w son|strong="H1121"\w* \w of Aaron|strong="H175"\w* \w the priest|strong="H3548"\w*. \v 9 \w But he did not|strong="H3808"\w* \w give any|strong="H5414"\w* \w to the Kohathites|strong="H1121"\w*, \w since|strong="H3588"\w* \w they were to carry|strong="H5375"\w* \w on their|strong="H5921"\w* \w shoulders|strong="H3802"\w* \w the holy objects|strong="H6944"\w* \w for which they were responsible|strong="H5656"\w*.
\p \v 10 \w When|strong="H3117"\w* \w the altar was anointed|strong="H4886"\w*, \w the leaders|strong="H5387"\w* \w approached|strong="H7126"\w* \w with their offerings|strong="H7133"\w* \w for its dedication|strong="H2598"\w* \w and|strong="H5387"\w* \w presented them|strong="H7126"\w* \w before|strong="H6440"\w* \w the altar|strong="H4196"\w*. \v 11 \w And the LORD|strong="H3068"\w* \w said|strong="H559"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, “\w Each day|strong="H3117"\w* \w one|strong="H259"\w* \w leader|strong="H5387"\w* \w is to present|strong="H7126"\w* \w his offering|strong="H7133"\w* \w for the dedication|strong="H2598"\w* \w of the altar|strong="H4196"\w*.”
