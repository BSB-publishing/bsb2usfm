\p \v 78 \w On the twelfth|strong="H8147"\w* \w day|strong="H3117"\w* \w Ahira|strong="H299"\w* \w son|strong="H1121"\w* \w of Enan|strong="H5881"\w*, \w the leader|strong="H5387"\w* \w of the Naphtalites, drew near|strong="H1121"\w*. \v 79 \w His offering|strong="H7133"\w* \w was one|strong="H259"\w* \w silver|strong="H3701"\w* \w platter|strong="H7086"\w* \w weighing|strong="H4948"\w* \w a hundred and thirty shekels|strong="H7970"\w*, \w and one|strong="H259"\w* \w silver|strong="H3701"\w* \w bowl|strong="H4219"\w* \w weighing seventy|strong="H7657"\w* \w shekels|strong="H8255"\w*, \w both according to the sanctuary|strong="H6944"\w* \w shekel|strong="H8255"\w* \w and|strong="H8147"\w* \w filled with|strong="H4392"\w* \w fine flour|strong="H5560"\w* \w mixed|strong="H1101"\w* \w with oil|strong="H8081"\w* \w for a grain offering|strong="H4503"\w*; \v 80 \w one|strong="H259"\w* \w gold|strong="H2091"\w* \w dish|strong="H3709"\w* \w weighing ten shekels|strong="H6235"\w*, \w filled with|strong="H4392"\w* \w incense|strong="H7004"\w*; \v 81 \w one|strong="H259"\w* \w young|strong="H1121"\w* \w bull|strong="H6499"\w*, \w one|strong="H259"\w* \w ram|strong="H352"\w*, \w and one|strong="H259"\w* \w male lamb|strong="H3532"\w* \w a year old|strong="H1121"\w* \w for a burnt offering|strong="H5930"\w*; \v 82 \w one|strong="H259"\w* \w male goat|strong="H8163"\w* \w for a sin offering|strong="H2403"\w*; \v 83 \w and a peace offering|strong="H8002"\w* \w of two|strong="H8147"\w* \w oxen|strong="H1241"\w*, \w five|strong="H2568"\w* \w rams|strong="H352"\w*, \w five|strong="H2568"\w* \w male goats|strong="H6260"\w*, \w and five|strong="H2568"\w* \w male lambs|strong="H3532"\w* \w a year old|strong="H1121"\w*. \w This|strong="H2088"\w* \w was the offering|strong="H7133"\w* \w of Ahira|strong="H299"\w* \w son|strong="H1121"\w* \w of Enan|strong="H5881"\w*.
\p \v 84 \w So these were the offerings|strong="H2063"\w* \w from the leaders|strong="H5387"\w* \w of Israel|strong="H3478"\w* \w for the dedication|strong="H2598"\w* \w of the altar|strong="H4196"\w* \w when it was anointed|strong="H4886"\w*: \w twelve|strong="H8147"\w* \w silver|strong="H3701"\w* \w platters|strong="H7086"\w*, \w twelve|strong="H8147"\w* \w silver|strong="H3701"\w* \w bowls|strong="H4219"\w*, \w and twelve|strong="H8147"\w* \w gold|strong="H2091"\w* \w dishes|strong="H3709"\w*.
\p \v 85 \w Each|strong="H259"\w* \w silver|strong="H3701"\w* \w platter|strong="H7086"\w* \w weighed a hundred and thirty shekels|strong="H7970"\w*, \w and each|strong="H259"\w* \w silver bowl|strong="H4219"\w* \w seventy shekels|strong="H7657"\w*. \w The total weight|strong="H3605"\w* \w of the silver|strong="H3701"\w* \w articles|strong="H3627"\w* \w was two thousand|strong="H505"\w* \w four|strong="H702"\w* \w hundred shekels|strong="H3967"\w*,\f + \fr 7:85 \fqa \ref 2,400|0\ref* shekels\ft is \ref approximately 60|60\ref*.3 pounds or 27.4 kilograms.\f* \w according to the sanctuary|strong="H6944"\w* \w shekel|strong="H8255"\w*.
\p \v 86 \w The twelve|strong="H8147"\w* \w gold|strong="H2091"\w* \w dishes|strong="H3709"\w* \w filled with|strong="H4392"\w* \w incense|strong="H7004"\w* \w weighed ten shekels|strong="H6235"\w* \w each|strong="H6235"\w*, \w according to the sanctuary|strong="H6944"\w* \w shekel|strong="H8255"\w*. \w The total|strong="H3605"\w* \w weight of the gold|strong="H2091"\w* \w dishes|strong="H3709"\w* \w was a hundred|strong="H3967"\w* \w and twenty shekels|strong="H6242"\w*.\f + \fr 7:86 \fqa \ref 120|0\ref* shekels\ft is \ref approximately 3|3\ref* pounds or 1.4 kilograms.\f*
\p \v 87 \w All|strong="H3605"\w* \w the livestock|strong="H1241"\w* \w for the burnt offering|strong="H5930"\w* \w totaled twelve|strong="H8147"\w* \w bulls|strong="H6499"\w*, \w twelve|strong="H8147"\w* \w rams|strong="H352"\w*, \w and twelve|strong="H8147"\w* \w male lambs|strong="H3532"\w* \w a year old|strong="H1121"\w* — \w together with their grain offerings|strong="H4503"\w* — \w and twelve|strong="H8147"\w* \w male goats|strong="H8163"\w* \w for the sin offering|strong="H2403"\w*.
\p \v 88 \w All|strong="H3605"\w* \w the livestock|strong="H1241"\w* \w sacrificed|strong="H2077"\w* \w for the peace offering|strong="H8002"\w* \w totaled twenty-four|strong="H6242"\w* \w bulls|strong="H6499"\w*, \w sixty|strong="H8346"\w* \w rams|strong="H352"\w*, \w sixty|strong="H8346"\w* \w male goats|strong="H6260"\w*, \w and sixty|strong="H8346"\w* \w male lambs|strong="H3532"\w* \w a year old|strong="H1121"\w*. \w This|strong="H2063"\w* \w was the dedication offering|strong="H2598"\w* \w for the altar|strong="H4196"\w* \w after|strong="H310"\w* \w it was anointed|strong="H4886"\w*.
\p \v 89 \w When Moses|strong="H4872"\w* \w entered|strong="H935"\w* \w the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w* \w to speak|strong="H1696"\w* \w with the LORD|strong="H854"\w*, \w he heard|strong="H8085"\w* \w the voice|strong="H6963"\w* \w speaking|strong="H1696"\w* \w to him|strong="H413"\w* \w from between|strong="H996"\w* \w the two|strong="H8147"\w* \w cherubim|strong="H3742"\w* \w above|strong="H5921"\w* \w the mercy seat|strong="H3727"\w*\f + \fr 7:89 \ft Or \fqa atonement cover\f* \w on|strong="H5921"\w* \w the ark|strong="H727"\w* \w of the Testimony|strong="H5715"\w*.\f + \fr 7:89 \ft That is, \fqa the ark of the covenant\f* \w Thus the LORD spoke|strong="H1696"\w* \w to him|strong="H413"\w*.
\c 8
\s1 The Lampstand
\r (\ref Exodus 25:31–40|EXO 25:31-40\ref*; \ref Exodus 37:17–24|EXO 37:17-24\ref*)
\p \v 1 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 2 “\w Speak|strong="H1696"\w* \w to|strong="H413"\w* \w Aaron|strong="H175"\w* \w and tell|strong="H559"\w* \w him|strong="H413"\w*: ‘\w When you set up|strong="H5927"\w* \w the seven|strong="H7651"\w* \w lamps|strong="H5216"\w*, \w they are to light the area|strong="H215"\w* \w in front|strong="H4136"\w* \w of the lampstand|strong="H4501"\w*.’”
\p \v 3 \w And Aaron|strong="H175"\w* \w did|strong="H6213"\w* \w so|strong="H3651"\w*; \w he set up|strong="H5927"\w* \w the lamps|strong="H5216"\w* \w facing|strong="H6440"\w* \w toward|strong="H413"\w* \w the front|strong="H4136"\w* \w of the lampstand|strong="H4501"\w*, \w just as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w Moses|strong="H4872"\w*.
\p \v 4 \w This is how|strong="H2088"\w* \w the lampstand|strong="H4501"\w* \w was constructed|strong="H4639"\w*: \w it was made of hammered|strong="H4749"\w* \w gold|strong="H2091"\w* \w from|strong="H5704"\w* \w its base|strong="H3409"\w* \w to|strong="H5704"\w* \w its blossoms|strong="H6525"\w*, \w fashioned|strong="H6213"\w* \w according to the pattern|strong="H4758"\w* \w the LORD|strong="H3068"\w* \w had shown|strong="H7200"\w* \w Moses|strong="H4872"\w*.
\s1 Cleansing the Levites
\p \v 5 \w Again the LORD|strong="H3068"\w* \w spoke|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \w saying|strong="H559"\w*, \v 6 “\w Take|strong="H3947"\w* \w the Levites|strong="H3881"\w* \w from among|strong="H8432"\w* \w the Israelites|strong="H1121"\w* \w and make them ceremonially clean|strong="H2891"\w*. \v 7 \w This is what|strong="H3541"\w* \w you must do|strong="H6213"\w* \w to cleanse them|strong="H2891"\w*: \w Sprinkle|strong="H5137"\w* \w them|strong="H5921"\w* \w with the water|strong="H4325"\w* \w of purification|strong="H2403"\w*. \w Have them shave|strong="H5674"\w* \w their whole|strong="H3605"\w* \w bodies|strong="H1320"\w* \w and wash|strong="H3526"\w* \w their clothes|strong="H899"\w*, \w and so purify themselves|strong="H2891"\w*.
\p \v 8 \w Then have them take|strong="H3947"\w* \w a young bull|strong="H6499"\w* \w with its grain offering|strong="H4503"\w* \w of fine flour|strong="H5560"\w* \w mixed|strong="H1101"\w* \w with oil|strong="H8081"\w*, \w and you are to take|strong="H3947"\w* \w a second|strong="H8145"\w* \w young bull|strong="H6499"\w* \w for a sin offering|strong="H2403"\w*. \v 9 \w Bring|strong="H7126"\w* \w the Levites|strong="H3881"\w* \w before|strong="H6440"\w* \w the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w* \w and assemble|strong="H6950"\w* \w the whole|strong="H3605"\w* \w congregation|strong="H5712"\w* \w of Israel|strong="H3478"\w*. \v 10 \w You are to present|strong="H7126"\w* \w the Levites|strong="H3881"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w and have the Israelites|strong="H1121"\w* \w lay|strong="H5564"\w* \w their hands|strong="H3027"\w* \w upon|strong="H5921"\w* \w them|strong="H3881"\w*. \v 11 \w Aaron|strong="H175"\w* \w is to present|strong="H5130"\w* \w the Levites|strong="H3881"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w as a wave offering|strong="H8573"\w* \w from the sons|strong="H1121"\w* \w of Israel|strong="H3478"\w*, \w so that they may perform|strong="H5647"\w* \w the service|strong="H5656"\w* \w of the LORD|strong="H3068"\w*. \v 12 \w And the Levites|strong="H3881"\w* \w are to lay|strong="H5564"\w* \w their hands|strong="H3027"\w* \w on|strong="H5921"\w* \w the heads|strong="H7218"\w* \w of the bulls|strong="H6499"\w*, \w and offer|strong="H6213"\w* \w to the LORD|strong="H3068"\w* \w one|strong="H259"\w* \w as a sin offering|strong="H2403"\w* \w and the other|strong="H259"\w* \w as a burnt offering|strong="H5930"\w*, \w to make atonement|strong="H3722"\w* \w for|strong="H5921"\w* \w the Levites|strong="H3881"\w*.
\p \v 13 \w You are to have the Levites|strong="H3881"\w* \w stand|strong="H5975"\w* \w before|strong="H6440"\w* \w Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w* \w and then present|strong="H5130"\w* \w them|strong="H853"\w* \w before the LORD|strong="H3068"\w* \w as a wave offering|strong="H8573"\w*. \v 14 \w In this way you shall separate|strong="H914"\w* \w the Levites|strong="H3881"\w* \w from|strong="H8432"\w* \w the rest of the Israelites|strong="H3478"\w*, \w and the Levites|strong="H3881"\w* \w will belong|strong="H1961"\w* to Me. \v 15 \w After|strong="H310"\w* \w you have cleansed|strong="H2891"\w* \w them|strong="H853"\w* \w and presented|strong="H5130"\w* \w them|strong="H853"\w* \w as a wave offering|strong="H8573"\w*, \w they|strong="H3881"\w* \w may come|strong="H935"\w* \w to serve|strong="H5647"\w* \w at the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*.
\p \v 16 \w For|strong="H3588"\w* \w the Levites|strong="H1992"\w* \w have been wholly given|strong="H5414"\w* to Me \w from among|strong="H8432"\w* \w the sons|strong="H1121"\w* \w of Israel|strong="H3478"\w*. \w I have taken|strong="H3947"\w* \w them|strong="H853"\w* for Myself \w in place of|strong="H8478"\w* \w all|strong="H3605"\w* \w who come first|strong="H6363"\w* \w from the womb|strong="H7358"\w*, \w the firstborn|strong="H1060"\w* \w of all|strong="H3605"\w* \w the sons|strong="H1121"\w* \w of Israel|strong="H3478"\w*. \v 17 \w For|strong="H3588"\w* \w every|strong="H3605"\w* \w firstborn|strong="H1060"\w* \w male|strong="H1121"\w* \w in Israel|strong="H3478"\w* is Mine, \w both man|strong="H120"\w* \w and beast|strong="H929"\w*. \w I set them apart|strong="H6942"\w* for Myself \w on the day|strong="H3117"\w* \w I struck down|strong="H5221"\w* \w all|strong="H3605"\w* \w the firstborn|strong="H1060"\w* \w in the land|strong="H776"\w* \w of Egypt|strong="H4714"\w*. \v 18 \w But I have taken|strong="H3947"\w* \w the Levites|strong="H3881"\w* \w in place of|strong="H8478"\w* \w all|strong="H3605"\w* \w the firstborn|strong="H1060"\w* \w among the sons|strong="H1121"\w* \w of Israel|strong="H3478"\w*. \v 19 \w And I have given|strong="H5414"\w* \w the Levites|strong="H3881"\w* \w as a gift|strong="H5414"\w* \w to Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w* \w from among|strong="H8432"\w* \w the Israelites|strong="H3478"\w*, \w to perform|strong="H5647"\w* \w the service|strong="H5656"\w* \w for the Israelites|strong="H1121"\w* \w at the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w* \w and to make atonement|strong="H3722"\w* \w on their|strong="H1121"\w* \w behalf|strong="H5921"\w*, \w so that no|strong="H3808"\w* \w plague|strong="H5063"\w* \w will come|strong="H1961"\w* \w against the Israelites|strong="H1121"\w* \w when they|strong="H1121"\w* \w approach|strong="H5066"\w* \w the sanctuary|strong="H6944"\w*.”
\p \v 20 \w So Moses|strong="H4872"\w*, \w Aaron|strong="H175"\w*, \w and the whole|strong="H3605"\w* \w congregation|strong="H5712"\w* \w of Israel|strong="H3478"\w* \w did|strong="H6213"\w* \w with the Levites|strong="H3881"\w* \w everything|strong="H3605"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w Moses|strong="H4872"\w* \w they|strong="H1121"\w* \w should do|strong="H6213"\w*. \v 21 \w The Levites|strong="H3881"\w* \w purified|strong="H2398"\w* \w themselves and washed|strong="H3526"\w* \w their clothes|strong="H899"\w*, \w and Aaron|strong="H175"\w* \w presented|strong="H5130"\w* \w them|strong="H853"\w* \w as a wave offering|strong="H8573"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*. \w Aaron|strong="H175"\w* \w also made atonement|strong="H3722"\w* \w for them|strong="H5921"\w* \w to cleanse them|strong="H2891"\w*. \v 22 \w After|strong="H310"\w* \w that|strong="H3651"\w*, \w the Levites|strong="H3881"\w* \w came|strong="H935"\w* \w to perform|strong="H5647"\w* \w their service|strong="H5656"\w* \w at the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w* \w in the presence|strong="H6440"\w* \w of Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w*. \w Thus|strong="H3651"\w* \w they did|strong="H6213"\w* \w with the Levites|strong="H3881"\w* \w just as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w Moses|strong="H4872"\w*.
\s1 Retirement for Levites
\p \v 23 \w And the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 24 “\w This|strong="H2063"\w* \w applies|strong="H834"\w* \w to the Levites|strong="H3881"\w*: \w Men twenty-five|strong="H2568"\w* \w years of age|strong="H1121"\w* \w or older|strong="H4605"\w* \w shall enter|strong="H935"\w* \w to perform|strong="H6633"\w* \w the service|strong="H6635"\w* \w in the work|strong="H5656"\w* \w at the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \v 25 \w But at the age|strong="H1121"\w* \w of fifty|strong="H2572"\w*, \w they must retire|strong="H7725"\w* \w from performing|strong="H6635"\w* \w the work|strong="H5656"\w* \w and no|strong="H3808"\w* \w longer|strong="H5750"\w* \w serve|strong="H5647"\w*.
\p \v 26 \w After that, they may assist|strong="H8334"\w* \w their brothers|strong="H251"\w* \w in fulfilling|strong="H8104"\w* \w their duties|strong="H4931"\w* \w at the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*, \w but they themselves are not|strong="H3808"\w* \w to do|strong="H5647"\w* \w the work|strong="H5656"\w*. \w This is how|strong="H3602"\w* \w you are to assign|strong="H6213"\w* \w responsibilities|strong="H4931"\w* \w to the Levites|strong="H3881"\w*.”
\c 9
\s1 The Second Passover
\r (\ref Exodus 12:1–13|EXO 12:1-13\ref*)
\p \v 1 \w In the first|strong="H7223"\w* \w month|strong="H2320"\w* \w of the second|strong="H8145"\w* \w year|strong="H8141"\w* \w after Israel had come out|strong="H3318"\w* \w of the land|strong="H776"\w* \w of Egypt|strong="H4714"\w*, \w the LORD|strong="H3068"\w* \w spoke|strong="H1696"\w* \w to Moses|strong="H4872"\w* \w in the Wilderness|strong="H4057"\w* \w of Sinai|strong="H5514"\w*: \v 2 “\w The Israelites|strong="H1121"\w* \w are to observe|strong="H6213"\w* \w the Passover|strong="H6453"\w* \w at its appointed time|strong="H4150"\w*. \v 3 \w You are to observe|strong="H6213"\w* \w it|strong="H853"\w* \w at the appointed time|strong="H4150"\w*, \w at|strong="H996"\w* \w twilight|strong="H6153"\w* \w on the fourteenth|strong="H702"\w*\f + \fr 9:3 \ft Hebrew \fqa between the two evenings of the fourteenth\ft ; also in verses 5 and 11\f* \w day|strong="H3117"\w* \w of this|strong="H2088"\w* \w month|strong="H2320"\w*, \w in accordance with|strong="H3605"\w* \w its statutes|strong="H2708"\w* \w and ordinances|strong="H4941"\w*.”
\p \v 4 \w So Moses|strong="H4872"\w* \w told|strong="H1696"\w* \w the Israelites|strong="H1121"\w* \w to observe|strong="H6213"\w* \w the Passover|strong="H6453"\w*, \v 5 \w and they did so|strong="H6213"\w* \w in the Wilderness|strong="H4057"\w* \w of Sinai|strong="H5514"\w*, \w at|strong="H996"\w* \w twilight|strong="H6153"\w* \w on the fourteenth|strong="H702"\w* \w day|strong="H3117"\w* \w of the first|strong="H7223"\w* \w month|strong="H2320"\w*. \w The Israelites|strong="H1121"\w* \w did|strong="H6213"\w* \w everything|strong="H3605"\w* \w just as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w Moses|strong="H4872"\w*.
\p \v 6 \w But there were|strong="H1961"\w* \w some men|strong="H582"\w* \w who|strong="H834"\w* \w were|strong="H1961"\w* \w unclean|strong="H2931"\w* \w due to a dead body|strong="H120"\w*, \w so they could|strong="H3201"\w* \w not|strong="H3808"\w* \w observe|strong="H6213"\w* \w the Passover|strong="H6453"\w* \w on that|strong="H1931"\w* \w day|strong="H3117"\w*. \w And they came|strong="H7126"\w* \w before|strong="H6440"\w* \w Moses|strong="H4872"\w* \w and Aaron|strong="H175"\w* \w that same|strong="H1931"\w* \w day|strong="H3117"\w* \v 7 \w and said|strong="H559"\w* \w to Moses|strong="H413"\w*, “\w We|strong="H587"\w* \w are unclean|strong="H2931"\w* \w because of a dead body|strong="H120"\w*, \w but why|strong="H4100"\w* \w should we be excluded|strong="H1639"\w* \w from|strong="H1115"\w* \w presenting|strong="H7126"\w* \w the LORD’s|strong="H3068"\w* \w offering|strong="H7133"\w* \w with|strong="H8432"\w* \w the other Israelites|strong="H1121"\w* \w at the appointed time|strong="H4150"\w*?”
\p \v 8 “\w Wait here|strong="H5975"\w* \w until I find out|strong="H8085"\w* \w what|strong="H4100"\w* \w the LORD|strong="H3068"\w* \w commands|strong="H6680"\w* concerning you,” \w Moses|strong="H4872"\w* \w replied|strong="H559"\w*.
\p \v 9 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 10 “\w Tell|strong="H1696"\w* \w the Israelites|strong="H1121"\w*: ‘\w When|strong="H3588"\w* \w any one|strong="H376"\w* \w of you or|strong="H176"\w* \w your descendants|strong="H1755"\w* \w is|strong="H1961"\w* \w unclean|strong="H2931"\w* \w because of a dead body|strong="H5315"\w*, \w or|strong="H176"\w* \w is away|strong="H7350"\w* \w on a journey|strong="H1870"\w*, \w he may still observe|strong="H6213"\w* \w the Passover|strong="H6453"\w* \w to the LORD|strong="H3068"\w*. \v 11 \w Such people are to observe|strong="H6213"\w* \w it|strong="H853"\w* \w at|strong="H996"\w* \w twilight|strong="H6153"\w* \w on the fourteenth|strong="H702"\w* \w day|strong="H3117"\w* \w of the second|strong="H8145"\w* \w month|strong="H2320"\w*. \w They are to eat the lamb|strong="H398"\w*, \w together with|strong="H5921"\w* \w unleavened bread|strong="H4682"\w* \w and bitter herbs|strong="H4844"\w*; \v 12 \w they may not|strong="H3808"\w* \w leave|strong="H7604"\w* \w any of|strong="H4480"\w* \w it until|strong="H5704"\w* \w morning|strong="H1242"\w* \w or break|strong="H7665"\w* any of its \w bones|strong="H6106"\w*. \w They must observe|strong="H6213"\w* \w the Passover|strong="H6453"\w* \w according to all|strong="H3605"\w* \w its statutes|strong="H2708"\w*.
\p \v 13 \w But if a man|strong="H376"\w* \w who|strong="H834"\w* \w is|strong="H1931"\w* \w ceremonially clean|strong="H2889"\w* \w and is|strong="H1961"\w* \w not|strong="H3808"\w* \w on a journey|strong="H1870"\w* \w still fails|strong="H2308"\w* \w to observe|strong="H6213"\w* \w the Passover|strong="H6453"\w*, \w he must be cut off|strong="H3772"\w* \w from his people|strong="H5971"\w*, \w because|strong="H3588"\w* \w he did not|strong="H3808"\w* \w present|strong="H7126"\w* \w the LORD’s|strong="H3068"\w* \w offering|strong="H7133"\w* \w at its appointed time|strong="H4150"\w*. \w That|strong="H1931"\w* \w man|strong="H376"\w* \w will bear|strong="H5375"\w* \w the consequences of his sin|strong="H2399"\w*.
\p \v 14 \w If|strong="H3588"\w* \w a foreigner|strong="H1616"\w* \w dwelling|strong="H1481"\w* \w among you|strong="H854"\w* \w wants to observe|strong="H6213"\w* \w the Passover|strong="H6453"\w* \w to the LORD|strong="H3068"\w*, \w he is to do|strong="H6213"\w* \w so|strong="H3651"\w* \w according to the Passover|strong="H6453"\w* \w statute|strong="H2708"\w* \w and its ordinances|strong="H4941"\w*. \w You are to apply|strong="H1961"\w* \w the same|strong="H259"\w* \w statute|strong="H2708"\w* \w to both the foreigner|strong="H1616"\w* \w and the native|strong="H249"\w* \w of the land|strong="H776"\w*.’”
\s1 The Cloud above the Tabernacle
\r (\ref Exodus 40:34–38|EXO 40:34-38\ref*)
\p \v 15 \w On the day that|strong="H3117"\w* \w the tabernacle|strong="H4908"\w*, \w the Tent|strong="H168"\w* \w of the Testimony|strong="H5715"\w*, \w was set up|strong="H6965"\w*, \w the cloud|strong="H6051"\w* \w covered|strong="H3680"\w* \w it|strong="H4908"\w* \w and appeared|strong="H4758"\w* \w like fire|strong="H784"\w* \w above|strong="H5921"\w* \w the tabernacle|strong="H4908"\w* \w from evening|strong="H6153"\w* \w until|strong="H5704"\w* \w morning|strong="H1242"\w*. \v 16 \w It remained|strong="H1961"\w* \w that way|strong="H3651"\w* \w continually|strong="H8548"\w*; \w the cloud|strong="H6051"\w* \w would cover the tabernacle by day|strong="H3680"\w*,\f + \fr 9:16 \ft LXX, Syriac, and Vulgate; Hebrew does not include \fqa by day\f* \w and at night|strong="H3915"\w* \w it would appear|strong="H4758"\w* \w like fire|strong="H784"\w*. \v 17 \w Whenever|strong="H6310"\w* \w the cloud|strong="H6051"\w* \w was lifted|strong="H5927"\w* \w from above|strong="H5921"\w* \w the Tent|strong="H168"\w*, \w the Israelites|strong="H1121"\w* \w would set out|strong="H5265"\w*, \w and wherever|strong="H4725"\w* \w the cloud|strong="H6051"\w* \w settled|strong="H7931"\w*, \w there|strong="H8033"\w* \w the Israelites|strong="H1121"\w* \w would camp|strong="H2583"\w*. \v 18 \w At|strong="H5921"\w* \w the LORD’s|strong="H3068"\w* \w command|strong="H6310"\w* \w the Israelites|strong="H1121"\w* \w set out|strong="H5265"\w*, \w and at|strong="H5921"\w* \w the LORD’s|strong="H3068"\w* \w command|strong="H6310"\w* \w they camped|strong="H2583"\w*. \w As long as|strong="H3605"\w* \w the cloud|strong="H6051"\w* \w remained|strong="H7931"\w* \w over|strong="H5921"\w* \w the tabernacle|strong="H4908"\w*, \w they remained encamped|strong="H2583"\w*.
\p \v 19 \w Even when the cloud|strong="H6051"\w* \w lingered|strong="H748"\w* \w over|strong="H5921"\w* \w the tabernacle|strong="H4908"\w* \w for many|strong="H7227"\w* \w days|strong="H3117"\w*, \w the Israelites|strong="H1121"\w* \w kept|strong="H8104"\w* \w the LORD’s|strong="H3068"\w* \w charge|strong="H4931"\w* \w and did not|strong="H3808"\w* \w set out|strong="H5265"\w*. \v 20 \w Sometimes|strong="H3426"\w* \w the cloud|strong="H6051"\w* \w remained|strong="H1961"\w* \w over|strong="H5921"\w* \w the tabernacle|strong="H4908"\w* \w for only a few|strong="H4557"\w* \w days|strong="H3117"\w*, \w and they would camp|strong="H2583"\w* \w at|strong="H5921"\w* \w the LORD’s|strong="H3068"\w* \w command|strong="H6310"\w* \w and set out|strong="H5265"\w* \w at|strong="H5921"\w* \w the LORD’s|strong="H3068"\w* \w command|strong="H6310"\w*. \v 21 \w Sometimes|strong="H3426"\w* \w the cloud|strong="H6051"\w* \w remained|strong="H1961"\w* \w only from evening|strong="H6153"\w* \w until|strong="H5704"\w* \w morning|strong="H1242"\w*, \w and when it|strong="H6051"\w* \w lifted|strong="H5927"\w* \w in the morning|strong="H1242"\w*, \w they would set out|strong="H5265"\w*. \w Whether|strong="H176"\w* \w it was by day|strong="H3119"\w* \w or by night|strong="H3915"\w*, \w when the cloud|strong="H6051"\w* \w was taken up|strong="H5927"\w*, \w they would set out|strong="H5265"\w*.
\p \v 22 \w Whether|strong="H176"\w* \w the cloud lingered|strong="H748"\w* \w for two days|strong="H3117"\w*, \w a month|strong="H2320"\w*, \w or longer|strong="H176"\w*, \w the Israelites|strong="H1121"\w* \w camped|strong="H2583"\w* \w and did not|strong="H3808"\w* \w set out|strong="H5265"\w* \w as long as the cloud|strong="H6051"\w* \w remained|strong="H7931"\w* \w over|strong="H5921"\w* \w the tabernacle|strong="H4908"\w*; \w but when it was lifted|strong="H5927"\w*, \w they would set out|strong="H5265"\w*. \v 23 \w They camped|strong="H2583"\w* \w at|strong="H5921"\w* \w the LORD’s|strong="H3068"\w* \w command|strong="H6310"\w*, \w and they set out|strong="H5265"\w* \w at|strong="H5921"\w* \w the LORD’s|strong="H3068"\w* \w command|strong="H6310"\w*; \w they carried out|strong="H8104"\w* \w the LORD’s|strong="H3068"\w* \w charge|strong="H4931"\w* \w according to|strong="H5921"\w* \w His|strong="H3068"\w* \w command|strong="H6310"\w* \w through|strong="H3027"\w* \w Moses|strong="H4872"\w*.
\c 10
\s1 The Two Silver Trumpets
\p \v 1 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 2 “\w Make|strong="H6213"\w* \w two|strong="H8147"\w* \w trumpets|strong="H2689"\w* \w of hammered|strong="H4749"\w* \w silver|strong="H3701"\w* \w to be used|strong="H1961"\w* \w for calling|strong="H4744"\w* \w the congregation|strong="H5712"\w* \w and for having the camps|strong="H4264"\w* \w set out|strong="H4550"\w*. \v 3 \w When both are sounded|strong="H8628"\w*, \w the whole|strong="H3605"\w* \w congregation|strong="H5712"\w* \w is to assemble|strong="H3259"\w* \w before|strong="H413"\w* \w you at|strong="H413"\w* \w the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \v 4 \w But if|strong="H518"\w* \w only one|strong="H259"\w* \w is sounded|strong="H8628"\w*, \w then the leaders|strong="H5387"\w*, \w the heads|strong="H7218"\w* \w of the clans|strong="H505"\w* \w of Israel|strong="H3478"\w*, \w are to gather|strong="H3259"\w* \w before you|strong="H413"\w*.
\p \v 5 \w When you sound|strong="H8628"\w* \w short blasts|strong="H8643"\w*, \w the camps|strong="H4264"\w* \w that lie|strong="H2583"\w* \w on the east side|strong="H6924"\w* \w are to set out|strong="H5265"\w*. \v 6 \w When you sound|strong="H8628"\w* \w the short blasts|strong="H8643"\w* \w a second time|strong="H8145"\w*, \w the camps|strong="H4264"\w* \w that lie|strong="H2583"\w* \w on the south side|strong="H8486"\w* \w are to set out|strong="H5265"\w*. \w The blasts|strong="H8643"\w* \w are to signal them|strong="H8628"\w* \w to set out|strong="H4550"\w*. \v 7 \w To convene|strong="H6950"\w* \w the assembly|strong="H6951"\w*, \w you are to sound long blasts|strong="H8628"\w*, \w not|strong="H3808"\w* \w short ones|strong="H7321"\w*. \v 8 \w The sons|strong="H1121"\w* \w of Aaron|strong="H175"\w*, \w the priests|strong="H3548"\w*, \w are to sound|strong="H8628"\w* \w the trumpets|strong="H2689"\w*. \w This shall be|strong="H1961"\w* \w a permanent|strong="H5769"\w* \w statute|strong="H2708"\w* for you \w and the generations to come|strong="H1755"\w*.
\p \v 9 \w When|strong="H3588"\w* \w you enter|strong="H935"\w* \w into battle|strong="H4421"\w* \w in your land|strong="H776"\w* \w against|strong="H5921"\w* \w an adversary|strong="H6862"\w* \w who attacks|strong="H6887"\w* \w you|strong="H853"\w*, \w sound short blasts|strong="H7321"\w* \w on the trumpets|strong="H2689"\w*, \w and you will be remembered|strong="H2142"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w your God|strong="H430"\w* \w and saved|strong="H3467"\w* \w from your enemies|strong="H341"\w*. \v 10 \w And on your joyous|strong="H8057"\w* \w occasions|strong="H3117"\w*, \w your appointed feasts|strong="H4150"\w*, \w and the beginning|strong="H7218"\w* \w of each month|strong="H2320"\w*, \w you are to blow|strong="H8628"\w* \w the trumpets|strong="H2689"\w* \w over|strong="H5921"\w* \w your burnt offerings|strong="H5930"\w* \w and peace|strong="H8002"\w* \w offerings|strong="H2077"\w* \w to serve|strong="H1961"\w* \w as a reminder|strong="H2146"\w* for you \w before|strong="H6440"\w* \w your God|strong="H430"\w*. \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w* \w your God|strong="H430"\w*.”
\s1 From Sinai to Paran
\p \v 11 \w On the twentieth|strong="H6242"\w* \w day|strong="H2320"\w* \w of the second|strong="H8145"\w* \w month|strong="H2320"\w* \w of the second|strong="H8145"\w* \w year|strong="H8141"\w*, \w the cloud|strong="H6051"\w* \w was lifted|strong="H5927"\w* \w from above|strong="H5921"\w* \w the tabernacle|strong="H4908"\w* \w of the Testimony|strong="H5715"\w*, \v 12 \w and the Israelites|strong="H1121"\w* \w set out|strong="H5265"\w* \w from the Wilderness|strong="H4057"\w* \w of Sinai|strong="H5514"\w*, \w traveling from place to place|strong="H4550"\w* \w until the cloud|strong="H6051"\w* \w settled|strong="H7931"\w* \w in the Wilderness|strong="H4057"\w* \w of Paran|strong="H6290"\w*. \v 13 \w They set out|strong="H5265"\w* \w this first time|strong="H7223"\w* \w according to|strong="H5921"\w* \w the LORD’s|strong="H3068"\w* \w command|strong="H6310"\w* \w through|strong="H3027"\w* \w Moses|strong="H4872"\w*.
\p \v 14 \w First|strong="H7223"\w*, \w the divisions|strong="H6635"\w* \w of the camp|strong="H4264"\w* \w of Judah|strong="H1121"\w* \w set out|strong="H5265"\w* \w under their standard|strong="H1714"\w*, \w with Nahshon|strong="H5177"\w* \w son|strong="H1121"\w* \w of Amminadab|strong="H5992"\w* \w in command|strong="H5921"\w*. \v 15 \w Nethanel|strong="H5417"\w* \w son|strong="H1121"\w* \w of Zuar|strong="H6686"\w* \w was over|strong="H5921"\w* \w the division|strong="H6635"\w* \w of the tribe|strong="H4294"\w* \w of Issachar|strong="H3485"\w*, \v 16 \w and Eliab|strong="H446"\w* \w son|strong="H1121"\w* \w of Helon|strong="H2497"\w* \w was over|strong="H5921"\w* \w the division|strong="H6635"\w* \w of the tribe|strong="H4294"\w* \w of Zebulun|strong="H2074"\w*. \v 17 \w Then the tabernacle|strong="H4908"\w* \w was taken down|strong="H3381"\w*, \w and the Gershonites|strong="H1121"\w* \w and the Merarites|strong="H1121"\w* \w set out|strong="H5265"\w*, \w transporting|strong="H5375"\w* \w it|strong="H4908"\w*.
\p \v 18 \w Then the divisions|strong="H6635"\w* \w of the camp|strong="H4264"\w* \w of Reuben|strong="H7205"\w* \w set out|strong="H5265"\w* \w under their standard|strong="H1714"\w*, \w with Elizur|strong="H468"\w* \w son|strong="H1121"\w* \w of Shedeur|strong="H7707"\w* \w in command|strong="H5921"\w*. \v 19 \w Shelumiel|strong="H8017"\w* \w son|strong="H1121"\w* \w of Zurishaddai|strong="H6701"\w* \w was over|strong="H5921"\w* \w the division|strong="H6635"\w* \w of the tribe|strong="H4294"\w* \w of Simeon|strong="H8095"\w*, \v 20 \w and Eliasaph|strong="H460"\w* \w son|strong="H1121"\w* \w of Deuel|strong="H1845"\w* \w was over|strong="H5921"\w* \w the division|strong="H6635"\w* \w of the tribe|strong="H4294"\w* \w of Gad|strong="H1121"\w*. \v 21 \w Then the Kohathites|strong="H6956"\w* \w set out|strong="H5265"\w*, \w transporting|strong="H5375"\w* \w the holy objects|strong="H4720"\w*; \w the tabernacle|strong="H4908"\w* \w was to be set up|strong="H6965"\w* \w before|strong="H5704"\w* \w their arrival|strong="H935"\w*.
\p \v 22 \w Next, the divisions|strong="H6635"\w* \w of the camp|strong="H4264"\w* \w of Ephraim|strong="H1121"\w* \w set out|strong="H5265"\w* \w under their standard|strong="H1714"\w*, \w with Elishama|strong="H476"\w* \w son|strong="H1121"\w* \w of Ammihud|strong="H5989"\w* \w in command|strong="H5921"\w*. \v 23 \w Gamaliel|strong="H1583"\w* \w son|strong="H1121"\w* \w of Pedahzur|strong="H6301"\w* \w was over|strong="H5921"\w* \w the division|strong="H6635"\w* \w of the tribe|strong="H4294"\w* \w of Manasseh|strong="H1121"\w*, \v 24 \w and Abidan|strong="H27"\w* \w son|strong="H1121"\w* \w of Gideoni|strong="H1441"\w* \w was over|strong="H5921"\w* \w the division|strong="H6635"\w* \w of the tribe|strong="H4294"\w* \w of Benjamin|strong="H1144"\w*.
\p \v 25 \w Finally, the divisions|strong="H6635"\w* \w of the camp|strong="H4264"\w* \w of Dan|strong="H1121"\w* \w set out|strong="H5265"\w* \w under their standard|strong="H1714"\w*, \w serving as the rear guard|strong="H622"\w* \w for all|strong="H3605"\w* \w units|strong="H4264"\w*, \w with Ahiezer|strong="H295"\w* \w son|strong="H1121"\w* \w of Ammishaddai|strong="H5996"\w* \w in command|strong="H5921"\w*. \v 26 \w Pagiel|strong="H6295"\w* \w son|strong="H1121"\w* \w of Ocran|strong="H5918"\w* \w was over|strong="H5921"\w* \w the division|strong="H6635"\w* \w of the tribe|strong="H4294"\w* \w of Asher|strong="H1121"\w*, \v 27 \w and Ahira|strong="H299"\w* \w son|strong="H1121"\w* \w of Enan|strong="H5881"\w* \w was over|strong="H5921"\w* \w the division|strong="H6635"\w* \w of the tribe|strong="H4294"\w* \w of Naphtali|strong="H1121"\w*.
\p \v 28 \w This|strong="H428"\w* \w was the order of march|strong="H4550"\w* \w for the Israelite|strong="H1121"\w* \w divisions|strong="H6635"\w* \w as they set out|strong="H5265"\w*.
\p \v 29 \w Then Moses|strong="H4872"\w* \w said|strong="H559"\w* \w to Hobab|strong="H2246"\w*, \w the son|strong="H1121"\w* \w of Moses’|strong="H4872"\w* \w father-in-law|strong="H2859"\w* \w Reuel|strong="H7467"\w*\f + \fr 10:29 \fqa Reuel \ft was also called \fqa Jethro\ft ; see \ref Exodus 3:1|EXO 3:1\ref*.\f* \w the Midianite|strong="H4084"\w*, “\w We are|strong="H587"\w* \w setting out|strong="H5265"\w* \w for|strong="H413"\w* \w the place|strong="H4725"\w* \w of which|strong="H834"\w* \w the LORD|strong="H3068"\w* \w said|strong="H559"\w*: ‘\w I will give it|strong="H5414"\w* to you.’ \w Come|strong="H1980"\w* \w with us|strong="H854"\w*, \w and we will treat you well|strong="H3190"\w*, \w for|strong="H3588"\w* \w the LORD|strong="H3068"\w* \w has promised|strong="H1696"\w* \w good|strong="H2896"\w* \w things to|strong="H5921"\w* \w Israel|strong="H3478"\w*.”
\p \v 30 “\w I will not|strong="H3808"\w* \w go|strong="H1980"\w*,” \w Hobab replied|strong="H559"\w*. “\w Instead|strong="H3588"\w*, \w I am going back|strong="H1980"\w* \w to|strong="H413"\w* \w my own land|strong="H776"\w* \w and my own people|strong="H4138"\w*.”
