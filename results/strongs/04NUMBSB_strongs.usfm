\p \v 5 \w So at|strong="H5921"\w* \w the word|strong="H6310"\w* \w of the LORD|strong="H3068"\w*, \w Moses|strong="H4872"\w* \w commanded|strong="H6680"\w* \w the Israelites|strong="H1121"\w*: “\w The tribe|strong="H4294"\w* \w of the sons|strong="H1121"\w* \w of Joseph|strong="H3130"\w* \w speaks|strong="H1696"\w* \w correctly|strong="H3651"\w*. \v 6 \w This|strong="H2088"\w* \w is what|strong="H834"\w* \w the LORD|strong="H3068"\w* \w has commanded|strong="H6680"\w* \w concerning the daughters|strong="H1323"\w* \w of Zelophehad|strong="H6765"\w*: \w They may marry|strong="H1961"\w* \w anyone they please|strong="H2896"\w*, \w provided|strong="H389"\w* \w they marry|strong="H1961"\w* \w within a clan|strong="H4940"\w* \w of the tribe|strong="H4294"\w* \w of their father|strong="H1"\w*. \v 7 \w No|strong="H3808"\w* \w inheritance|strong="H5159"\w* \w in Israel|strong="H1121"\w* \w may be transferred|strong="H5437"\w* \w from tribe|strong="H4294"\w* \w to|strong="H413"\w* \w tribe|strong="H4294"\w*, \w because|strong="H3588"\w* \w each|strong="H376"\w* \w of the Israelites|strong="H3478"\w* \w is to retain|strong="H1692"\w* \w the inheritance|strong="H5159"\w* \w of the tribe|strong="H4294"\w* \w of his fathers|strong="H1"\w*. \v 8 \w Every|strong="H3605"\w* \w daughter|strong="H1323"\w* \w who possesses|strong="H3423"\w* \w an inheritance|strong="H5159"\w* \w from any Israelite|strong="H3478"\w* \w tribe|strong="H4294"\w* \w must marry|strong="H1961"\w* \w within a clan|strong="H4940"\w* \w of the tribe|strong="H4294"\w* \w of her father|strong="H1"\w*, \w so that|strong="H4616"\w* \w every|strong="H376"\w* \w Israelite|strong="H1121"\w* \w will possess|strong="H3423"\w* \w the inheritance|strong="H5159"\w* \w of his fathers|strong="H1"\w*. \v 9 \w No|strong="H3808"\w* \w inheritance|strong="H5159"\w* \w may be transferred|strong="H5437"\w* \w from one tribe|strong="H4294"\w* \w to|strong="H4294"\w* \w another|strong="H312"\w*, \w for|strong="H3588"\w* \w each|strong="H376"\w* \w tribe|strong="H4294"\w* \w of Israel|strong="H3478"\w* \w must retain|strong="H1692"\w* \w its inheritance|strong="H5159"\w*.”
\p \v 10 \w So the daughters|strong="H1323"\w* \w of Zelophehad|strong="H6765"\w* \w did|strong="H6213"\w* \w as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w Moses|strong="H4872"\w*. \v 11 \w Mahlah|strong="H4244"\w*, \w Tirzah|strong="H8656"\w*, \w Hoglah|strong="H2295"\w*, \w Milcah|strong="H4435"\w*, \w and Noah|strong="H5270"\w*, \w the daughters|strong="H1323"\w* \w of Zelophehad|strong="H6765"\w*, \w were married|strong="H802"\w* \w to cousins on their|strong="H1121"\w* \w father’s side|strong="H1730"\w*. \v 12 \w They married|strong="H1961"\w* \w within the clans|strong="H4940"\w* \w of the descendants|strong="H1121"\w* \w of Manasseh|strong="H4519"\w* \w son|strong="H1121"\w* \w of Joseph|strong="H3130"\w*, \w and their inheritance|strong="H5159"\w* \w remained|strong="H1961"\w* \w within|strong="H5921"\w* \w the tribe|strong="H4294"\w* \w of their father’s|strong="H1"\w* \w clan|strong="H4940"\w*.
\p \v 13 \w These|strong="H428"\w* \w are the commandments|strong="H4687"\w* \w and ordinances|strong="H4941"\w* \w that|strong="H834"\w* \w the LORD|strong="H3068"\w* \w gave|strong="H6680"\w* \w the Israelites|strong="H1121"\w* \w through|strong="H3027"\w* \w Moses|strong="H4872"\w* \w on the plains|strong="H6160"\w* \w of Moab|strong="H4124"\w* \w by|strong="H5921"\w* \w the Jordan|strong="H3383"\w* \w across from Jericho|strong="H3405"\w*.
