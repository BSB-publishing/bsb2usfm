\p \v 33 \w From Merari came|strong="H4848"\w* \w the clans|strong="H4940"\w* \w of the Mahlites|strong="H4250"\w* \w and Mushites|strong="H4188"\w*; \w these|strong="H428"\w* \w were the Merarite|strong="H4848"\w* \w clans|strong="H4940"\w*. \v 34 \w The number|strong="H6485"\w* \w of all|strong="H3605"\w* \w the males|strong="H2145"\w* \w a month|strong="H2320"\w* \w old|strong="H1121"\w* \w or more|strong="H4605"\w* \w was 6,200|strong="H8337"\w*.
\p \v 35 \w The leader|strong="H5387"\w* \w of the families|strong="H1004"\w* \w of the Merarites|strong="H4848"\w* \w was Zuriel|strong="H6700"\w* \w son|strong="H1121"\w* \w of Abihail|strong="H32"\w*; \w they were to camp|strong="H2583"\w* \w on|strong="H5921"\w* \w the north|strong="H6828"\w* \w side|strong="H3409"\w* \w of the tabernacle|strong="H4908"\w*.
\p \v 36 \w The duties|strong="H4931"\w* \w assigned|strong="H6486"\w* \w to the sons|strong="H1121"\w* \w of Merari|strong="H4847"\w* \w were the tabernacle’s|strong="H4908"\w* \w frames|strong="H7175"\w*, \w crossbars|strong="H1280"\w*, \w posts|strong="H5982"\w*, \w bases|strong="H134"\w*, \w and all|strong="H3605"\w* \w its equipment|strong="H3627"\w*— \w all|strong="H3605"\w* \w the service for these items|strong="H5656"\w*, \v 37 \w as well as the posts|strong="H5982"\w* \w of the surrounding|strong="H5439"\w* \w courtyard|strong="H2691"\w* \w with their bases|strong="H134"\w*, \w tent pegs|strong="H3489"\w*, \w and ropes|strong="H4340"\w*.
\s1 Moses and Aaron
\p \v 38 \w Moses|strong="H4872"\w*, \w Aaron|strong="H175"\w*, \w and Aaron’s sons|strong="H1121"\w* \w were to camp|strong="H2583"\w* \w to the east|strong="H6924"\w* \w of the tabernacle|strong="H4908"\w*, \w toward the sunrise|strong="H4217"\w*, \w before|strong="H6440"\w* \w the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \w They were to perform|strong="H8104"\w* \w the duties|strong="H4931"\w* \w of the sanctuary|strong="H4720"\w* \w as a service|strong="H4931"\w* \w on behalf of the Israelites|strong="H3478"\w*; \w but any outsider|strong="H2114"\w* \w who approached the sanctuary|strong="H7131"\w* \w was to be put to death|strong="H4191"\w*.
\p \v 39 \w The total|strong="H3605"\w* \w number|strong="H6485"\w* \w of Levites|strong="H3881"\w* \w that|strong="H834"\w* \w Moses|strong="H4872"\w* \w and Aaron|strong="H175"\w* \w counted|strong="H6485"\w* \w by their clans|strong="H4940"\w* \w at|strong="H5921"\w* \w the LORD’s|strong="H3068"\w* \w command|strong="H6310"\w*, \w including all|strong="H3605"\w* \w the males|strong="H2145"\w* \w a month|strong="H2320"\w* \w old|strong="H1121"\w* \w or more|strong="H4605"\w*, \w was 22,000|strong="H8147"\w*.
\s1 The Redemption of the Firstborn
\p \v 40 \w Then the LORD|strong="H3068"\w* \w said|strong="H559"\w* \w to Moses|strong="H4872"\w*, “\w Number|strong="H6485"\w* \w every|strong="H3605"\w* \w firstborn|strong="H1060"\w* \w male|strong="H2145"\w* \w of the Israelites|strong="H3478"\w* \w a month|strong="H2320"\w* \w old|strong="H1121"\w* \w or more|strong="H4605"\w*, \w and list|strong="H5375"\w* \w their names|strong="H8034"\w*. \v 41 \w You are to take|strong="H3947"\w* \w the Levites|strong="H3881"\w* for Me— \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w*— \w in place of|strong="H8478"\w* \w all|strong="H3605"\w* \w the firstborn|strong="H1060"\w* \w of Israel|strong="H3478"\w*, \w and the livestock|strong="H929"\w* \w of the Levites|strong="H3881"\w* \w in place of|strong="H8478"\w* \w all|strong="H3605"\w* \w the firstborn|strong="H1060"\w* \w of the livestock|strong="H929"\w* \w of the Israelites|strong="H3478"\w*.”
\p \v 42 \w So Moses|strong="H4872"\w* \w numbered|strong="H6485"\w* \w all|strong="H3605"\w* \w the firstborn|strong="H1060"\w* \w of the Israelites|strong="H3478"\w*, \w as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w him|strong="H853"\w*. \v 43 \w The total|strong="H3605"\w* \w number|strong="H6485"\w* \w of the firstborn|strong="H1060"\w* \w males|strong="H2145"\w* \w a month|strong="H2320"\w* \w old|strong="H1121"\w* \w or more|strong="H4605"\w*, \w listed|strong="H4557"\w* \w by name|strong="H8034"\w*, \w was|strong="H1961"\w* \w 22,273|strong="H8147"\w*.
\p \v 44 \w Again the LORD|strong="H3068"\w* \w spoke|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \w saying|strong="H559"\w*, \v 45 “\w Take|strong="H3947"\w* \w the Levites|strong="H3881"\w* \w in place|strong="H8478"\w* \w of all|strong="H3605"\w* \w the firstborn|strong="H1060"\w* \w of Israel|strong="H3478"\w*, \w and|strong="H853"\w* \w the livestock|strong="H929"\w* \w of the Levites|strong="H3881"\w* \w in place|strong="H8478"\w* \w of their livestock|strong="H929"\w*. \w The Levites|strong="H3881"\w* \w belong|strong="H1961"\w* to Me; \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w*. \v 46 \w To redeem|strong="H6302"\w* \w the 273|strong="H7969"\w* \w firstborn|strong="H1060"\w* \w Israelites|strong="H1121"\w* \w who outnumber|strong="H5736"\w* \w the Levites|strong="H3881"\w*, \v 47 \w you are to collect|strong="H3947"\w* \w five|strong="H2568"\w* \w shekels|strong="H8255"\w*\f + \fr 3:47 \fqa 5 shekels\ft is \ref approximately 2|2\ref* ounces or 57 grams.\f* \w for each one|strong="H1538"\w*, \w according to the sanctuary|strong="H6944"\w* \w shekel|strong="H8255"\w* \w of twenty|strong="H6242"\w* \w gerahs|strong="H1626"\w*.\f + \fr 3:47 \fqa \ref 20|0\ref* gerahs\ft is equivalent to one shekel \ref (approximately 0|0\ref*.4 ounces or 11.4 grams).\f* \v 48 \w Give|strong="H5414"\w* \w the money|strong="H3701"\w* \w to Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w* \w as the redemption price|strong="H6302"\w* \w for the excess|strong="H5736"\w* among the Israelites.”
\p \v 49 \w So Moses|strong="H4872"\w* \w collected|strong="H3947"\w* \w the redemption|strong="H6306"\w* \w money|strong="H3701"\w* \w from those in excess|strong="H5736"\w* \w of|strong="H5921"\w* \w the number redeemed|strong="H6302"\w* \w by the Levites|strong="H3881"\w*. \v 50 \w He collected|strong="H3947"\w* \w the money|strong="H3701"\w* \w from the firstborn|strong="H1060"\w* \w of the Israelites|strong="H3478"\w*: \w 1,365|strong="H2568"\w* \w shekels|strong="H8255"\w*,\f + \fr 3:50 \fqa \ref 1,365|5\ref* shekels\ft is \ref approximately 34|34\ref*.3 pounds or 15.6 kilograms.\f* \w according to the sanctuary shekel|strong="H6944"\w*. \v 51 \w And Moses|strong="H4872"\w* \w gave|strong="H5414"\w* \w the redemption|strong="H6302"\w* \w money|strong="H3701"\w* \w to Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w* \w in obedience to|strong="H5921"\w* \w the word|strong="H6310"\w* \w of the LORD|strong="H3068"\w*, \w just as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w him|strong="H4872"\w*.
\c 4
\s1 The Duties of the Kohathites
\r (\ref Numbers 3:27–32|NUM 3:27-32\ref*; \ref 1 Chronicles 23:12–20|1CH 23:12-20\ref*)
\p \v 1 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w* \w and Aaron|strong="H175"\w*, \v 2 “\w Take|strong="H5375"\w* \w a census|strong="H7218"\w* \w of the Kohathites|strong="H6955"\w* \w among|strong="H8432"\w* \w the Levites|strong="H3878"\w* \w by their clans|strong="H4940"\w* \w and families|strong="H1"\w*, \v 3 \w men from thirty|strong="H7970"\w* \w to|strong="H5704"\w* \w fifty|strong="H2572"\w* \w years old|strong="H1121"\w*— \w everyone|strong="H3605"\w* \w who is qualified|strong="H935"\w* \w to serve|strong="H6635"\w* \w in the work|strong="H4399"\w* \w at the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*.
\p \v 4 \w This|strong="H2063"\w* \w service|strong="H5656"\w* \w of the Kohathites|strong="H1121"\w* \w at the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w* \w regards the most|strong="H6944"\w* \w holy things|strong="H6944"\w*. \v 5 \w Whenever the camp|strong="H4264"\w* \w sets out|strong="H5265"\w*, \w Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w* \w are to go in|strong="H935"\w*, \w take down|strong="H3381"\w* \w the veil|strong="H6532"\w* \w of the curtain|strong="H4539"\w*, \w and cover|strong="H3680"\w* \w the ark|strong="H727"\w* \w of the Testimony|strong="H5715"\w*\f + \fr 4:5 \ft That is, \fqa the ark of the covenant\f* with it. \v 6 \w They are to place|strong="H5414"\w* \w over|strong="H5921"\w* \w this a covering|strong="H3681"\w* \w of fine leather|strong="H8476"\w*,\f + \fr 4:6 \ft Possibly the hides of large aquatic mammals; also in verses 8, 10, 11, 12, 14, and 25; see Exodus 25:5.\f* \w spread|strong="H6566"\w* \w a solid|strong="H3632"\w* \w blue|strong="H8504"\w* \w cloth|strong="H899"\w* \w over it|strong="H4605"\w*, \w and insert|strong="H7760"\w* \w its poles|strong="H905"\w*.
\p \v 7 \w Over|strong="H5921"\w* \w the table|strong="H7979"\w* \w of the Presence|strong="H6440"\w* \w they are to spread|strong="H6566"\w* \w a blue|strong="H8504"\w* \w cloth|strong="H899"\w* \w and place|strong="H5414"\w* \w the plates|strong="H7086"\w* \w and cups|strong="H3709"\w* \w on it|strong="H5921"\w*, \w along with|strong="H853"\w* \w the bowls|strong="H4518"\w* \w and pitchers|strong="H7184"\w* \w for the drink offering|strong="H5262"\w*. \w The regular|strong="H8548"\w* \w bread|strong="H3899"\w* \w offering is to remain|strong="H1961"\w* \w on it|strong="H5921"\w*. \v 8 \w And they shall spread|strong="H6566"\w* \w a scarlet|strong="H8438"\w* \w cloth|strong="H899"\w* \w over them|strong="H5921"\w*, \w cover|strong="H3680"\w* \w them|strong="H853"\w* \w with|strong="H4372"\w* \w fine leather|strong="H8476"\w*, \w and insert|strong="H7760"\w* \w the poles|strong="H905"\w*.
\p \v 9 \w They are to take|strong="H3947"\w* \w a blue|strong="H8504"\w* \w cloth|strong="H899"\w* \w and cover|strong="H3680"\w* \w the lampstand|strong="H4501"\w* \w used for light|strong="H3974"\w*, \w together|strong="H853"\w* \w with its lamps|strong="H5216"\w*, \w wick trimmers|strong="H4457"\w*, \w and trays|strong="H4289"\w*, \w as well as the jars|strong="H3627"\w* \w of oil|strong="H8081"\w* \w with which|strong="H834"\w* \w to supply|strong="H8334"\w* it. \v 10 \w Then they shall wrap|strong="H5414"\w* \w it|strong="H853"\w* \w and all|strong="H3605"\w* \w its utensils|strong="H3627"\w* \w inside|strong="H413"\w* \w a covering|strong="H4372"\w* \w of fine leather|strong="H8476"\w* \w and put|strong="H5414"\w* \w it on|strong="H5921"\w* \w the carrying frame|strong="H4132"\w*.
\p \v 11 \w Over|strong="H5921"\w* \w the gold|strong="H2091"\w* \w altar|strong="H4196"\w* \w they are to spread|strong="H6566"\w* \w a blue|strong="H8504"\w* \w cloth|strong="H899"\w*, \w cover|strong="H3680"\w* \w it|strong="H853"\w* \w with|strong="H4372"\w* \w fine leather|strong="H8476"\w*, \w and insert|strong="H7760"\w* \w the poles|strong="H905"\w*. \v 12 \w They are to take|strong="H3947"\w* \w all|strong="H3605"\w* \w the utensils|strong="H3627"\w* \w for serving|strong="H8335"\w* in \w the sanctuary|strong="H6944"\w*, \w place them|strong="H5414"\w* \w in|strong="H413"\w* \w a blue|strong="H8504"\w* \w cloth|strong="H899"\w*, \w cover|strong="H3680"\w* \w them|strong="H853"\w* \w with|strong="H4372"\w* \w fine leather|strong="H8476"\w*, \w and put them|strong="H5414"\w* \w on|strong="H5921"\w* \w the carrying frame|strong="H4132"\w*.
\p \v 13 \w Then they shall remove the ashes|strong="H1878"\w* \w from the bronze altar|strong="H4196"\w*, \w spread|strong="H6566"\w* \w a purple|strong="H713"\w* \w cloth|strong="H899"\w* \w over it|strong="H5921"\w*, \v 14 \w and place|strong="H5414"\w* \w on it|strong="H5921"\w* \w all|strong="H3605"\w* \w the vessels|strong="H3627"\w* \w used to serve|strong="H8334"\w* \w there|strong="H5921"\w*: \w the firepans|strong="H4289"\w*, \w meat forks|strong="H4207"\w*, \w shovels|strong="H3257"\w*, \w and sprinkling bowls|strong="H4219"\w*— \w all|strong="H3605"\w* \w the equipment|strong="H3627"\w* \w of the altar|strong="H4196"\w*. \w They are to spread|strong="H6566"\w* \w over it|strong="H5921"\w* \w a covering|strong="H3681"\w* \w of fine leather|strong="H8476"\w* \w and insert|strong="H7760"\w* \w the poles|strong="H905"\w*.
\p \v 15 \w When Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w* \w have finished|strong="H3615"\w* \w covering|strong="H3680"\w* \w the holy objects|strong="H6944"\w* \w and all|strong="H3605"\w* \w their equipment|strong="H3627"\w*, \w as soon as the camp|strong="H4264"\w* \w is ready to move|strong="H5265"\w*, \w the Kohathites|strong="H1121"\w* \w shall come|strong="H935"\w* \w and do the carrying|strong="H5375"\w*. \w But they must not|strong="H3808"\w* \w touch|strong="H5060"\w* \w the holy objects|strong="H6944"\w*, \w or they will die|strong="H4191"\w*. \w These|strong="H428"\w* \w are the transportation duties|strong="H4853"\w* \w of the Kohathites|strong="H1121"\w* \w regarding the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*.
\p \v 16 \w Eleazar|strong="H499"\w* \w son|strong="H1121"\w* \w of Aaron|strong="H175"\w* \w the priest|strong="H3548"\w* \w shall oversee|strong="H6486"\w* \w the oil|strong="H8081"\w* \w for the light|strong="H3974"\w*, \w the fragrant|strong="H5561"\w* \w incense|strong="H7004"\w*, \w the daily|strong="H8548"\w* \w grain offering|strong="H4503"\w*, \w and the anointing|strong="H4888"\w* \w oil|strong="H8081"\w*. \w He has oversight|strong="H6486"\w* \w of the entire|strong="H3605"\w* \w tabernacle|strong="H4908"\w* \w and everything|strong="H3605"\w* in it, \w including the holy objects|strong="H6944"\w* \w and their utensils|strong="H3627"\w*.”
\p \v 17 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w* \w and Aaron|strong="H175"\w*, \v 18 “\w Do not|strong="H408"\w* \w allow the Kohathite|strong="H6956"\w* \w tribal|strong="H7626"\w* \w clans|strong="H4940"\w* \w to be cut off|strong="H3772"\w* \w from among|strong="H8432"\w* \w the Levites|strong="H3881"\w*. \v 19 \w In order that they may live|strong="H2421"\w* \w and not|strong="H3808"\w* \w die|strong="H4191"\w* \w when they come near|strong="H5066"\w* \w the most|strong="H6944"\w* \w holy things|strong="H6944"\w*, \w do|strong="H6213"\w* \w this|strong="H2063"\w* for them: \w Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w* \w are to go in|strong="H935"\w* \w and assign|strong="H7760"\w* \w each man|strong="H376"\w* \w his task|strong="H5656"\w* \w and what he is to carry|strong="H4853"\w*. \v 20 \w But the Kohathites are not|strong="H3808"\w* \w to go in|strong="H935"\w* \w and look|strong="H7200"\w* \w at the holy objects|strong="H6944"\w*, \w even for a moment|strong="H1104"\w*, \w or they will die|strong="H4191"\w*.”
\s1 The Duties of the Gershonites
\r (\ref Numbers 3:21–26|NUM 3:21-26\ref*; \ref 1 Chronicles 23:7–11|1CH 23:7-11\ref*)
\p \v 21 \w And the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 22 “\w Take a census|strong="H5375"\w* \w of the Gershonites|strong="H1121"\w* \w as well|strong="H1571"\w*, \w by their families|strong="H1"\w* \w and clans|strong="H4940"\w*, \v 23 \w from thirty|strong="H7970"\w* \w to|strong="H5704"\w* \w fifty|strong="H2572"\w* \w years old|strong="H1121"\w*, \w counting|strong="H6485"\w* \w everyone|strong="H3605"\w* \w who comes|strong="H935"\w* \w to serve|strong="H6633"\w* \w in the work|strong="H5656"\w* \w at the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*.
\p \v 24 \w This|strong="H2063"\w* \w is the service|strong="H5656"\w* \w of the Gershonite|strong="H1649"\w* \w clans|strong="H4940"\w* \w regarding work|strong="H5647"\w* \w and transport|strong="H4853"\w*: \v 25 \w They are to carry|strong="H5375"\w* \w the curtains|strong="H3407"\w* \w of the tabernacle|strong="H4908"\w*, \w the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w* \w with the covering|strong="H4372"\w* \w of fine leather|strong="H8476"\w* \w over|strong="H5921"\w* \w it|strong="H4605"\w*, \w the curtains|strong="H4539"\w* \w for the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*, \v 26 \w the curtains|strong="H7050"\w* \w of the courtyard|strong="H2691"\w*, \w and|strong="H853"\w* \w the curtains|strong="H4539"\w* \w for the entrance|strong="H6607"\w* \w at the gate|strong="H8179"\w* \w of the courtyard|strong="H2691"\w* \w that|strong="H834"\w* \w surrounds|strong="H5921"\w* \w the tabernacle|strong="H4908"\w* \w and altar|strong="H4196"\w*, \w along with their ropes|strong="H4340"\w* \w and all|strong="H3605"\w* \w the equipment|strong="H3627"\w* \w for their service|strong="H5656"\w*. \w The Gershonites will do|strong="H5647"\w* \w all|strong="H3605"\w* \w that|strong="H834"\w* \w needs to be done|strong="H6213"\w* with these items.
\p \v 27 \w All|strong="H3605"\w* \w the service|strong="H5656"\w* \w of the Gershonites|strong="H1121"\w* — \w all|strong="H3605"\w* \w their transport duties|strong="H4853"\w* \w and|strong="H3605"\w* \w other work|strong="H5656"\w* — \w is to be done at|strong="H5921"\w* \w the direction|strong="H6310"\w* \w of Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w*; \w you are to assign|strong="H6485"\w* \w to them|strong="H5921"\w* \w all|strong="H3605"\w* \w that they are responsible|strong="H4931"\w* \w to carry|strong="H4853"\w*. \v 28 \w This|strong="H2063"\w* \w is the service|strong="H5656"\w* \w of the Gershonite|strong="H1121"\w* \w clans|strong="H4940"\w* \w at the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*, \w and their duties|strong="H4931"\w* \w shall be under the direction|strong="H3027"\w* \w of Ithamar|strong="H385"\w* \w son|strong="H1121"\w* \w of Aaron|strong="H175"\w* \w the priest|strong="H3548"\w*.
\s1 The Duties of the Merarites
\r (\ref Numbers 3:33–37|NUM 3:33-37\ref*; \ref 1 Chronicles 23:21–23|1CH 23:21-23\ref*)
\p \v 29 \w As for the sons|strong="H1121"\w* \w of Merari|strong="H4847"\w*, \w you are to number|strong="H6485"\w* \w them|strong="H853"\w* \w by their clans|strong="H4940"\w* \w and families|strong="H1"\w*, \v 30 \w from thirty|strong="H7970"\w* \w to|strong="H5704"\w* \w fifty|strong="H2572"\w* \w years old|strong="H1121"\w*, \w counting|strong="H6485"\w* \w everyone|strong="H3605"\w* \w who comes|strong="H935"\w* \w to serve|strong="H6635"\w* \w in the work|strong="H5656"\w* \w of the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*.
\p \v 31 \w This|strong="H2063"\w* \w is the duty|strong="H4931"\w* \w for all|strong="H3605"\w* \w their service|strong="H5656"\w* \w at the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*: \w to carry|strong="H4853"\w* \w the frames|strong="H7175"\w* \w of the tabernacle|strong="H4908"\w* \w with its crossbars|strong="H1280"\w*, \w posts|strong="H5982"\w*, \w and bases|strong="H134"\w*, \v 32 \w and the posts|strong="H5982"\w* \w of the surrounding|strong="H5439"\w* \w courtyard|strong="H2691"\w* \w with their bases|strong="H134"\w*, \w tent pegs|strong="H3489"\w*, \w and ropes|strong="H4340"\w*, \w including all|strong="H3605"\w* \w their equipment|strong="H3627"\w* \w and everything|strong="H3605"\w* \w related to their use|strong="H5656"\w*. \w You shall assign|strong="H6485"\w* \w by name|strong="H8034"\w* \w the items|strong="H3627"\w* \w that they are responsible|strong="H4931"\w* \w to carry|strong="H4853"\w*.
\p \v 33 \w This|strong="H2063"\w* \w is the service|strong="H5656"\w* \w of the Merarite|strong="H1121"\w* \w clans|strong="H4940"\w* \w according to all|strong="H3605"\w* \w their work|strong="H5656"\w* \w at the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*, \w under the direction|strong="H3027"\w* \w of Ithamar|strong="H385"\w* \w son|strong="H1121"\w* \w of Aaron|strong="H175"\w* \w the priest|strong="H3548"\w*.”
\s1 The Numbering of the Levite Clans
\p \v 34 \w So Moses|strong="H4872"\w*, \w Aaron|strong="H175"\w*, \w and the leaders|strong="H5387"\w* \w of the congregation|strong="H5712"\w* \w numbered|strong="H6485"\w* \w the Kohathites|strong="H1121"\w* \w by their clans|strong="H4940"\w* \w and families|strong="H1"\w*, \v 35 \w everyone|strong="H3605"\w* \w from thirty|strong="H7970"\w* \w to|strong="H5704"\w* \w fifty|strong="H2572"\w* \w years old|strong="H1121"\w* \w who came|strong="H935"\w* \w to serve|strong="H6635"\w* \w in the work|strong="H5656"\w* \w at the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \v 36 \w And those|strong="H1961"\w* \w numbered|strong="H6485"\w* \w by their clans|strong="H4940"\w* \w totaled 2,750|strong="H505"\w*. \v 37 \w These|strong="H428"\w* \w were counted|strong="H6485"\w* \w from the Kohathite|strong="H6956"\w* \w clans|strong="H4940"\w*, \w everyone|strong="H3605"\w* \w who could serve|strong="H5647"\w* \w at the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \w Moses|strong="H4872"\w* \w and Aaron|strong="H175"\w* \w numbered|strong="H6485"\w* \w them|strong="H834"\w* \w according to|strong="H5921"\w* \w the command|strong="H6310"\w* \w of the LORD|strong="H3068"\w* \w through|strong="H3027"\w* \w Moses|strong="H4872"\w*.
\p \v 38 \w Then the Gershonites|strong="H1121"\w* \w were numbered|strong="H6485"\w* \w by their clans|strong="H4940"\w* \w and families|strong="H1"\w*, \v 39 \w everyone|strong="H3605"\w* \w from thirty|strong="H7970"\w* \w to|strong="H5704"\w* \w fifty|strong="H2572"\w* \w years old|strong="H1121"\w* \w who came|strong="H935"\w* \w to serve|strong="H6635"\w* \w in the work|strong="H5656"\w* \w at the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \v 40 \w And those|strong="H1961"\w* \w numbered|strong="H6485"\w* \w by their clans|strong="H4940"\w* \w and families|strong="H1"\w* \w totaled 2,630|strong="H505"\w*. \v 41 \w These|strong="H428"\w* \w were counted|strong="H6485"\w* \w from the Gershonite|strong="H1648"\w* \w clans|strong="H4940"\w* \w who served|strong="H5647"\w* \w at the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*, \w whom|strong="H834"\w* \w Moses|strong="H4872"\w* \w and Aaron|strong="H175"\w* \w counted|strong="H6485"\w* \w at|strong="H5921"\w* \w the LORD’s|strong="H3068"\w* \w command|strong="H6310"\w*.
\p \v 42 \w And the Merarites|strong="H4847"\w* \w were numbered|strong="H6485"\w* \w by their clans|strong="H4940"\w* \w and families|strong="H1"\w*, \v 43 \w everyone|strong="H3605"\w* \w from thirty|strong="H7970"\w* \w to|strong="H5704"\w* \w fifty|strong="H2572"\w* \w years old|strong="H1121"\w* \w who came|strong="H935"\w* \w to serve|strong="H6635"\w* \w in the work|strong="H5656"\w* \w at the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \v 44 \w The men registered|strong="H6485"\w* \w by their clans|strong="H4940"\w* \w numbered 3,200|strong="H7969"\w*. \v 45 \w These|strong="H428"\w* \w were counted|strong="H6485"\w* \w from the Merarite|strong="H4847"\w* \w clans|strong="H4940"\w*, \w whom|strong="H834"\w* \w Moses|strong="H4872"\w* \w and Aaron|strong="H175"\w* \w numbered|strong="H6485"\w* \w at|strong="H5921"\w* \w the LORD’s|strong="H3068"\w* \w command|strong="H6310"\w* \w through|strong="H3027"\w* \w Moses|strong="H4872"\w*.
\p \v 46 \w So Moses|strong="H4872"\w*, \w Aaron|strong="H175"\w*, \w and the leaders|strong="H5387"\w* \w of Israel|strong="H3478"\w* \w numbered|strong="H6485"\w* \w by their clans|strong="H4940"\w* \w and families|strong="H1"\w* \w all|strong="H3605"\w* \w the Levites|strong="H3881"\w* \v 47 \w from thirty|strong="H7970"\w* \w to|strong="H5704"\w* \w fifty|strong="H2572"\w* \w years old|strong="H1121"\w* \w who came|strong="H935"\w* \w to do|strong="H5647"\w* \w the work|strong="H5656"\w* \w of serving|strong="H5656"\w* \w and carrying|strong="H4853"\w* \w the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \v 48 \w And|strong="H1961"\w* \w the number of men|strong="H6485"\w* \w was 8,580|strong="H8083"\w*. \v 49 \w At|strong="H5921"\w* \w the LORD’s|strong="H3068"\w* \w command|strong="H6310"\w* \w through|strong="H3027"\w* \w Moses|strong="H4872"\w* \w they were numbered|strong="H6485"\w*, \w and each one|strong="H376"\w* \w was assigned|strong="H6485"\w* \w his work|strong="H5656"\w* \w and burden|strong="H4853"\w*, \w as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had commanded|strong="H6680"\w* \w Moses|strong="H4872"\w*.
\c 5
\s1 Cleansing the Camps
\r (\ref Leviticus 13:1–46|LEV 13:1-46\ref*)
\p \v 1 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 2 “\w Command|strong="H6680"\w* \w the Israelites|strong="H1121"\w* \w to send away|strong="H7971"\w* \w from|strong="H4480"\w* \w the camp|strong="H4264"\w* \w anyone|strong="H3605"\w* \w with a skin disease|strong="H6879"\w*,\f + \fr 5:2 \ft Forms of the Hebrew \fqa tzaraath\ft , traditionally translated as \fqa leprosy\ft , were used for various skin diseases; see \ref Leviticus 13|LEV 13\ref*.\f* \w anyone|strong="H3605"\w* \w who has a bodily discharge|strong="H2100"\w*, \w and anyone|strong="H3605"\w* \w who is defiled|strong="H2931"\w* \w by a dead body|strong="H5315"\w*. \v 3 \w You must send away|strong="H7971"\w* \w male|strong="H2145"\w* \w and|strong="H5704"\w* \w female alike|strong="H5347"\w*; \w send them|strong="H7971"\w* \w outside|strong="H2351"\w* \w the camp|strong="H4264"\w* \w so they will not|strong="H3808"\w* \w defile|strong="H2930"\w* \w their camp|strong="H4264"\w*, \w where|strong="H834"\w* \w I|strong="H589"\w* \w dwell|strong="H7931"\w* \w among them|strong="H8432"\w*.”
\p \v 4 \w So the Israelites|strong="H1121"\w* \w did|strong="H6213"\w* \w this|strong="H3651"\w*, \w sending|strong="H7971"\w* \w such people|strong="H853"\w* \w outside|strong="H2351"\w* \w the camp|strong="H4264"\w*. \w They|strong="H1121"\w* \w did|strong="H6213"\w* \w just as|strong="H834"\w* \w the LORD|strong="H3068"\w* \w had instructed|strong="H1696"\w* \w Moses|strong="H4872"\w*.
\s1 Confession and Restitution
\r (\ref Luke 19:1–10|LUK 19:1-10\ref*)
\p \v 5 \w And the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 6 “\w Tell|strong="H1696"\w* \w the Israelites that|strong="H1121"\w* \w when|strong="H3588"\w* \w a man|strong="H376"\w* \w or|strong="H176"\w* \w woman|strong="H802"\w* \w acts|strong="H4603"\w* \w unfaithfully|strong="H4604"\w* \w against the LORD|strong="H3068"\w* \w by committing|strong="H6213"\w* \w any|strong="H3605"\w* \w sin|strong="H2403"\w* \w against another|strong="H120"\w*, \w that|strong="H1931"\w* \w person|strong="H5315"\w* \w is guilty|strong="H816"\w* \v 7 \w and must confess|strong="H3034"\w* \w the sin|strong="H2403"\w* \w he has committed|strong="H6213"\w*. \w He must make full restitution|strong="H7725"\w*, \w add|strong="H3254"\w* \w a fifth|strong="H2549"\w* \w to its value|strong="H5921"\w*, \w and give all this|strong="H5414"\w* \w to the one|strong="H834"\w* \w he has wronged|strong="H816"\w*.
\p \v 8 \w But if|strong="H518"\w* \w the man|strong="H376"\w* \w has no|strong="H369"\w* \w relative|strong="H1350"\w* \w to whom restitution can be made for|strong="H7725"\w* \w the wrong|strong="H817"\w*, \w the restitution|strong="H7725"\w* \w belongs to the LORD|strong="H3068"\w* \w and must be given to the priest|strong="H3548"\w* \w along with|strong="H905"\w* \w the ram|strong="H352"\w* \w of atonement|strong="H3725"\w*, \w by which|strong="H834"\w* \w the atonement is made|strong="H3722"\w* for \w him|strong="H5921"\w*.
\p \v 9 \w Every|strong="H3605"\w* \w sacred|strong="H6944"\w* \w contribution|strong="H8641"\w* \w the Israelites|strong="H1121"\w* \w bring|strong="H7126"\w* \w to the priest|strong="H3548"\w* \w shall belong|strong="H1961"\w* to him. \v 10 \w Each man’s|strong="H376"\w* \w sacred gifts|strong="H6944"\w* are his own, \w but whatever|strong="H834"\w* \w he|strong="H376"\w* \w gives|strong="H5414"\w* \w to the priest|strong="H3548"\w* \w will belong to|strong="H1961"\w* the priest.”
\s1 The Adultery Test
\p \v 11 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 12 “\w Speak|strong="H1696"\w* \w to|strong="H413"\w* \w the Israelites|strong="H1121"\w* \w and tell them that|strong="H559"\w* \w if|strong="H3588"\w* \w any man’s|strong="H376"\w* \w wife|strong="H802"\w* \w goes astray|strong="H7847"\w* \w and is unfaithful|strong="H4603"\w* to him \v 13 \w by sleeping with|strong="H7901"\w* \w another man|strong="H376"\w*, \w and it is concealed|strong="H5956"\w* \w from|strong="H5869"\w* \w her husband|strong="H376"\w* \w and her|strong="H1931"\w* \w impurity|strong="H2930"\w* \w is undetected|strong="H5641"\w* (\w since there is no|strong="H369"\w* \w witness against her|strong="H5707"\w* \w and she|strong="H1931"\w* \w was not|strong="H3808"\w* \w caught in the act|strong="H8610"\w*), \v 14 \w and if a feeling|strong="H7307"\w* \w of jealousy|strong="H7068"\w* \w comes over|strong="H5674"\w* \w her husband|strong="H5921"\w* \w and he suspects|strong="H7065"\w* \w his wife|strong="H802"\w* \w who|strong="H1931"\w* \w has defiled herself|strong="H2930"\w*— \w or|strong="H176"\w* \w if a feeling|strong="H7307"\w* \w of jealousy|strong="H7068"\w* \w comes over|strong="H5674"\w* \w him|strong="H5921"\w* \w and he suspects|strong="H7065"\w* \w her|strong="H802"\w* \w even though she|strong="H1931"\w* \w has not|strong="H3808"\w* \w defiled herself|strong="H2930"\w*— \v 15 \w then he|strong="H376"\w* \w is to bring|strong="H935"\w* \w his wife|strong="H802"\w* \w to|strong="H413"\w* \w the priest|strong="H3548"\w*.
\p \w He must also bring|strong="H935"\w* \w for her|strong="H5921"\w* \w an offering|strong="H7133"\w* \w of a tenth|strong="H6224"\w* \w of an ephah|strong="H374"\w* \w of barley|strong="H8184"\w* \w flour|strong="H7058"\w*.\f + \fr 5:15 \fqa A tenth of an ephah\ft is \ref approximately 2|2\ref* dry quarts or 2.2 liters (probably about 3.5 pounds or 1.6 kilograms of barley flour).\f* \w He is not|strong="H3808"\w* \w to pour|strong="H3332"\w* \w oil|strong="H8081"\w* \w over|strong="H5921"\w* \w it or put|strong="H5414"\w* \w frankincense|strong="H3828"\w* \w on it|strong="H5921"\w*, \w because|strong="H3588"\w* \w it|strong="H1931"\w* \w is a grain offering|strong="H4503"\w* \w for jealousy|strong="H7068"\w*, \w an offering|strong="H4503"\w* \w of memorial|strong="H2146"\w* \w as a reminder|strong="H2142"\w* \w of iniquity|strong="H5771"\w*.
\p \v 16 \w The priest|strong="H3548"\w* \w is to bring the wife forward|strong="H7126"\w* \w and have her stand|strong="H5975"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*. \v 17 \w Then he|strong="H3548"\w* \w is to take|strong="H3947"\w* \w some holy|strong="H6918"\w* \w water|strong="H4325"\w* \w in a clay|strong="H2789"\w* \w jar|strong="H3627"\w* \w and put|strong="H5414"\w* \w some of|strong="H4480"\w* \w the dust|strong="H6083"\w* \w from the tabernacle|strong="H4908"\w* \w floor|strong="H7172"\w* \w into|strong="H413"\w* \w the water|strong="H4325"\w*.
\p \v 18 \w After the priest|strong="H3548"\w* \w has the woman|strong="H802"\w* \w stand|strong="H5975"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*, \w he is to let down|strong="H6544"\w* \w her|strong="H802"\w* \w hair|strong="H7218"\w* \w and place|strong="H5414"\w* \w in|strong="H5921"\w* \w her hands|strong="H3709"\w* \w the grain offering|strong="H4503"\w* \w of memorial|strong="H2146"\w*, \w which|strong="H1931"\w* \w is the grain offering|strong="H4503"\w* \w for jealousy|strong="H7068"\w*. \w The priest|strong="H3548"\w* \w is|strong="H1961"\w* \w to hold|strong="H3027"\w* \w the bitter|strong="H4751"\w* \w water|strong="H4325"\w* \w that brings a curse|strong="H779"\w*. \v 19 \w And he|strong="H3548"\w* \w is to put the woman under oath|strong="H7650"\w* \w and say|strong="H559"\w* \w to|strong="H413"\w* \w her|strong="H802"\w*, ‘\w If|strong="H518"\w* \w no other|strong="H3808"\w* \w man|strong="H376"\w* \w has slept with you|strong="H7901"\w* \w and|strong="H518"\w* \w you have not|strong="H3808"\w* \w gone astray|strong="H7847"\w* \w and become defiled|strong="H2932"\w* \w while under|strong="H8478"\w* \w your husband’s authority|strong="H376"\w*, \w may you be immune|strong="H5352"\w* \w to this|strong="H428"\w* \w bitter|strong="H4751"\w* \w water|strong="H4325"\w* \w that brings a curse|strong="H779"\w*. \v 20 \w But if|strong="H3588"\w* \w you|strong="H859"\w* \w have gone astray|strong="H7847"\w* \w while under|strong="H8478"\w* \w your husband’s authority|strong="H376"\w* \w and|strong="H3588"\w* \w have defiled yourself|strong="H2930"\w* \w and lain|strong="H5414"\w* \w carnally|strong="H7903"\w* \w with a man|strong="H376"\w* \w other than|strong="H1107"\w* \w your husband|strong="H376"\w*’— \v 21 \w and the priest|strong="H3548"\w* \w shall have the woman|strong="H802"\w* \w swear|strong="H7650"\w* \w under the oath|strong="H7621"\w* \w of the curse|strong="H423"\w*— ‘\w then may the LORD|strong="H3068"\w* \w make|strong="H5414"\w* \w you|strong="H853"\w* \w an attested|strong="H423"\w* \w curse|strong="H7621"\w* \w among|strong="H8432"\w* \w your people|strong="H5971"\w* \w by making|strong="H5414"\w* \w your thigh|strong="H3409"\w* \w shrivel|strong="H5307"\w* \w and your belly|strong="H990"\w* \w swell|strong="H6639"\w*. \v 22 \w May this|strong="H428"\w* \w water|strong="H4325"\w* \w that brings a curse|strong="H779"\w* \w enter|strong="H935"\w* \w your stomach|strong="H4578"\w* \w and cause your belly|strong="H990"\w* \w to swell|strong="H6638"\w* \w and your thigh|strong="H3409"\w* \w to shrivel|strong="H5307"\w*.’
\p \w Then the woman|strong="H802"\w* \w is to say|strong="H559"\w*, ‘\w Amen|strong="H543"\w*, \w Amen|strong="H543"\w*.’
\p \v 23 \w And the priest|strong="H3548"\w* \w shall write|strong="H3789"\w* \w these|strong="H428"\w* \w curses|strong="H423"\w* \w on a scroll|strong="H5612"\w* \w and wash them off|strong="H4229"\w* \w into|strong="H413"\w* \w the bitter|strong="H4751"\w* \w water|strong="H4325"\w*. \v 24 \w He is to have the woman|strong="H802"\w* \w drink|strong="H8248"\w* \w the bitter|strong="H4751"\w* \w water|strong="H4325"\w* \w that brings a curse|strong="H779"\w*, \w and it|strong="H4325"\w* \w will enter|strong="H935"\w* her \w and may cause her bitter|strong="H4751"\w* \w suffering|strong="H779"\w*. \v 25 \w The priest|strong="H3548"\w* \w shall take|strong="H3947"\w* \w from her|strong="H802"\w* \w hand|strong="H3027"\w* \w the grain offering|strong="H4503"\w* \w for jealousy|strong="H7068"\w*, \w wave|strong="H5130"\w* \w it|strong="H4503"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*, \w and bring|strong="H7126"\w* \w it to|strong="H413"\w* \w the altar|strong="H4196"\w*. \v 26 \w Then the priest|strong="H3548"\w* \w is to take a handful|strong="H7061"\w* \w of|strong="H4480"\w* \w the grain offering|strong="H4503"\w* \w as a memorial portion|strong="H234"\w* \w and burn|strong="H6999"\w* \w it on the altar|strong="H4196"\w*; \w after that|strong="H310"\w* \w he is to have the woman|strong="H802"\w* \w drink|strong="H8248"\w* \w the water|strong="H4325"\w*.
\p \v 27 \w When he has made her drink|strong="H8248"\w* \w the water|strong="H4325"\w*, \w if|strong="H518"\w* \w she has defiled herself|strong="H2930"\w* \w and been unfaithful|strong="H4603"\w* \w to her husband|strong="H376"\w*, \w then the water|strong="H4325"\w* \w that brings a curse|strong="H779"\w* \w will enter|strong="H935"\w* her \w and cause bitter suffering|strong="H4751"\w*; \w her belly|strong="H990"\w* \w will swell|strong="H6638"\w*, \w her thigh|strong="H3409"\w* \w will shrivel|strong="H5307"\w*, \w and she will become|strong="H1961"\w* \w accursed|strong="H423"\w* \w among|strong="H7130"\w* \w her people|strong="H5971"\w*. \v 28 \w But if|strong="H518"\w* \w the woman|strong="H802"\w* \w has not|strong="H3808"\w* \w defiled herself|strong="H2930"\w* \w and is clean|strong="H2889"\w*, \w she|strong="H1931"\w* \w will be unaffected|strong="H5352"\w* \w and able to conceive|strong="H2232"\w* \w children|strong="H2233"\w*.
\p \v 29 \w This|strong="H2063"\w* \w is the law|strong="H8451"\w* \w of jealousy|strong="H7068"\w* \w when|strong="H834"\w* \w a wife|strong="H802"\w* \w goes astray|strong="H7847"\w* \w and defiles herself|strong="H2930"\w* \w while under|strong="H8478"\w* \w her husband’s authority|strong="H376"\w*, \v 30 \w or|strong="H176"\w* \w when|strong="H834"\w* \w a feeling|strong="H7307"\w* \w of jealousy|strong="H7068"\w* \w comes over|strong="H5674"\w* \w a husband|strong="H376"\w* \w and he suspects|strong="H7065"\w* \w his wife|strong="H802"\w*. \w He is to have the woman|strong="H802"\w* \w stand|strong="H5975"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*, \w and the priest|strong="H3548"\w* \w is to apply|strong="H6213"\w* to her \w this|strong="H2063"\w* \w entire|strong="H3605"\w* \w law|strong="H8451"\w*. \v 31 \w The husband|strong="H376"\w* \w will be free|strong="H5352"\w* \w from guilt|strong="H5771"\w*, \w but the|strong="H1931"\w* \w woman|strong="H802"\w* \w shall bear|strong="H5375"\w* \w her|strong="H853"\w* \w iniquity|strong="H5771"\w*.”
\c 6
\s1 The Nazirite Vow
\r (\ref Judges 13:1–25|JDG 13:1-25\ref*)
\p \v 1 \w And the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to Moses|strong="H4872"\w*, \v 2 “\w Speak|strong="H1696"\w* \w to|strong="H413"\w* \w the Israelites|strong="H1121"\w* \w and tell|strong="H559"\w* \w them that|strong="H413"\w* \w if|strong="H3588"\w* \w a man|strong="H376"\w* \w or|strong="H176"\w* \w woman|strong="H802"\w* \w makes a special|strong="H6381"\w* \w vow|strong="H5087"\w*, \w the vow|strong="H5088"\w* \w of a Nazirite|strong="H5139"\w*,\f + \fr 6:2 \fqa Nazirite \ft means \fqa one separated \ft or \fqa one consecrated\ft .\f* \w to separate himself|strong="H5144"\w* \w to the LORD|strong="H3068"\w*, \v 3 \w he is to abstain|strong="H5144"\w* \w from wine|strong="H3196"\w* \w and strong drink|strong="H7941"\w*. \w He must not|strong="H3808"\w* \w drink|strong="H8354"\w* \w vinegar|strong="H2558"\w* \w made from wine|strong="H3196"\w* \w or strong drink|strong="H7941"\w*, \w and he must not|strong="H3808"\w* \w drink|strong="H8354"\w* \w any|strong="H3605"\w* \w grape|strong="H6025"\w* \w juice|strong="H4952"\w* \w or eat|strong="H398"\w* \w fresh|strong="H3892"\w* \w grapes|strong="H6025"\w* \w or raisins|strong="H3002"\w*. \v 4 \w All|strong="H3605"\w* \w the days|strong="H3117"\w* \w of his separation|strong="H5145"\w*, \w he is not|strong="H3808"\w* \w to eat|strong="H398"\w* \w anything that comes from|strong="H6213"\w* \w the grapevine|strong="H1612"\w*, \w not even the seeds|strong="H2785"\w* \w or|strong="H5704"\w* \w skins|strong="H2085"\w*.
\p \v 5 \w For the entire|strong="H3605"\w* \w period|strong="H3117"\w* \w of his vow|strong="H5088"\w* \w of separation|strong="H5145"\w*, \w no|strong="H3808"\w* \w razor|strong="H8593"\w* \w shall touch|strong="H5674"\w* \w his head|strong="H7218"\w*. \w He must be|strong="H1961"\w* \w holy|strong="H6918"\w* \w until|strong="H5704"\w* \w the time|strong="H3117"\w* \w of|strong="H834"\w* \w his separation|strong="H5144"\w* \w to the LORD|strong="H3068"\w* \w is complete|strong="H4390"\w*; \w he must let the hair|strong="H8181"\w* \w of his head|strong="H7218"\w* \w grow|strong="H1431"\w* \w long|strong="H6545"\w*.
\p \v 6 \w Throughout|strong="H3605"\w* \w the days|strong="H3117"\w* \w of his separation|strong="H5144"\w* \w to the LORD|strong="H3068"\w*, \w he must not|strong="H3808"\w* \w go|strong="H935"\w* \w near|strong="H5921"\w* \w a dead|strong="H4191"\w* \w body|strong="H5315"\w*. \v 7 \w Even if his father|strong="H1"\w* \w or mother|strong="H517"\w* \w or brother|strong="H251"\w* \w or sister|strong="H269"\w* \w should die|strong="H4194"\w*, \w he is not|strong="H3808"\w* \w to defile himself|strong="H2930"\w*, \w because|strong="H3588"\w* \w the symbol of consecration|strong="H5145"\w* \w to his God|strong="H430"\w* \w is upon|strong="H5921"\w* \w his head|strong="H7218"\w*. \v 8 \w Throughout the time|strong="H3605"\w* \w of his separation|strong="H5145"\w*, \w he|strong="H1931"\w* \w is holy|strong="H6918"\w* \w to the LORD|strong="H3068"\w*.
\p \v 9 \w If|strong="H3588"\w* \w someone suddenly|strong="H6621"\w* \w dies|strong="H4191"\w* \w in his presence|strong="H5921"\w* \w and defiles|strong="H2930"\w* \w his consecrated head|strong="H7218"\w* \w of hair|strong="H5145"\w*, \w he must shave|strong="H1548"\w* \w his head|strong="H7218"\w* \w on the day|strong="H3117"\w* \w of his cleansing|strong="H2893"\w* — \w the seventh|strong="H7637"\w* \w day|strong="H3117"\w*. \v 10 \w On the eighth|strong="H8066"\w* \w day|strong="H3117"\w* \w he must bring|strong="H935"\w* \w two|strong="H8147"\w* \w turtledoves|strong="H8449"\w* \w or|strong="H176"\w* \w two|strong="H8147"\w* \w young|strong="H1121"\w* \w pigeons|strong="H3123"\w* \w to|strong="H413"\w* \w the priest|strong="H3548"\w* \w at|strong="H413"\w* \w the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*. \v 11 \w And the priest|strong="H3548"\w* \w is to offer|strong="H6213"\w* \w one|strong="H259"\w* \w as a sin offering|strong="H2403"\w*\f + \fr 6:11 \ft Or \fqa purification offering\ft ; here and throughout Numbers\f* \w and the other|strong="H259"\w* \w as a burnt offering|strong="H5930"\w* \w to make atonement|strong="H3722"\w* \w for him|strong="H5921"\w*, \w because|strong="H834"\w* \w he has sinned|strong="H2398"\w* \w by being in the presence|strong="H5921"\w* \w of the dead body|strong="H5315"\w*. \w On that|strong="H1931"\w* \w day|strong="H3117"\w* \w he must consecrate|strong="H6942"\w* \w his head again|strong="H7218"\w*. \v 12 \w He must rededicate|strong="H5144"\w* \w his time|strong="H3117"\w* \w of separation|strong="H5145"\w* \w to the LORD|strong="H3068"\w* \w and bring|strong="H935"\w* \w a year-old|strong="H1121"\w* \w male lamb|strong="H3532"\w* \w as a guilt offering|strong="H817"\w*. \w But the preceding|strong="H7223"\w* \w days|strong="H3117"\w* \w shall not be counted|strong="H5307"\w*, \w because|strong="H3588"\w* \w his separation|strong="H5145"\w* \w was defiled|strong="H2930"\w*.
\p \v 13 \w Now this|strong="H2063"\w* \w is the law|strong="H8451"\w* \w of the Nazirite|strong="H5139"\w* \w when|strong="H3117"\w* \w his time|strong="H3117"\w* \w of separation|strong="H5145"\w* \w is complete|strong="H4390"\w*: \w He must be brought|strong="H935"\w* \w to|strong="H413"\w* \w the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*, \v 14 \w and he is to present|strong="H7126"\w* \w an offering|strong="H7133"\w* \w to the LORD|strong="H3068"\w* \w of an|strong="H259"\w* \w unblemished|strong="H8549"\w* \w year-old|strong="H1121"\w* \w male lamb|strong="H3532"\w* \w as a burnt offering|strong="H5930"\w*, \w an|strong="H259"\w* \w unblemished|strong="H8549"\w* \w year-old|strong="H1323"\w* \w female lamb|strong="H3535"\w* \w as a sin offering|strong="H2403"\w*, \w and an|strong="H259"\w* \w unblemished|strong="H8549"\w* \w ram|strong="H352"\w* \w as a peace offering|strong="H8002"\w* — \v 15 \w together with their grain offerings|strong="H4503"\w* \w and drink offerings|strong="H5262"\w* — \w and a basket|strong="H5536"\w* \w of unleavened|strong="H4682"\w* \w cakes|strong="H2471"\w* \w made from fine flour|strong="H5560"\w* \w mixed|strong="H1101"\w* \w with oil|strong="H8081"\w* \w and unleavened|strong="H4682"\w* \w wafers|strong="H7550"\w* \w coated|strong="H4886"\w* \w with oil|strong="H8081"\w*.
\p \v 16 \w The priest|strong="H3548"\w* \w is to present all these|strong="H7126"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w and make|strong="H6213"\w* \w the sin offering|strong="H2403"\w* \w and|strong="H853"\w* \w the burnt offering|strong="H5930"\w*. \v 17 \w He shall also offer|strong="H6213"\w* \w the ram|strong="H352"\w* \w as a peace offering|strong="H8002"\w* \w to the LORD|strong="H3068"\w*, \w along with|strong="H5921"\w* \w the basket|strong="H5536"\w* \w of unleavened bread|strong="H4682"\w*. \w And the priest|strong="H3548"\w* \w is to offer|strong="H6213"\w* \w the accompanying grain offering|strong="H4503"\w* \w and drink offering|strong="H5262"\w*.
\p \v 18 \w Then at the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*, \w the Nazirite|strong="H5139"\w* \w is to shave|strong="H1548"\w* \w his consecrated|strong="H5145"\w* \w head|strong="H7218"\w*, \w take|strong="H3947"\w* \w the hair|strong="H8181"\w*, \w and put|strong="H5414"\w* \w it on|strong="H5921"\w* \w the fire|strong="H784"\w* \w under|strong="H8478"\w* \w the peace offering|strong="H8002"\w*. \v 19 \w And the priest|strong="H3548"\w* \w is to take|strong="H3947"\w* \w the boiled|strong="H1311"\w* \w shoulder|strong="H2220"\w* \w from|strong="H4480"\w* \w the ram|strong="H352"\w*, \w one|strong="H259"\w* \w unleavened|strong="H4682"\w* \w cake|strong="H2471"\w* \w from|strong="H4480"\w* \w the basket|strong="H5536"\w*, \w and one|strong="H259"\w* \w unleavened|strong="H4682"\w* \w wafer|strong="H7550"\w*, \w and put them|strong="H5414"\w* \w into|strong="H5921"\w* \w the hands|strong="H3709"\w* \w of the Nazirite|strong="H5139"\w* \w who has just|strong="H310"\w* \w shaved|strong="H1548"\w* \w the hair of his consecration|strong="H5145"\w*. \v 20 \w The priest|strong="H3548"\w* \w shall then wave|strong="H5130"\w* \w them|strong="H853"\w* \w as a wave offering|strong="H8573"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w*. \w This|strong="H1931"\w* \w is a holy|strong="H6944"\w* \w portion for the priest|strong="H3548"\w*, \w in addition to|strong="H5921"\w* \w the breast|strong="H2373"\w* \w of the wave offering|strong="H8573"\w* \w and the thigh|strong="H7785"\w* \w that was presented|strong="H8641"\w*. \w After that|strong="H310"\w*, \w the Nazirite|strong="H5139"\w* \w may drink|strong="H8354"\w* \w wine|strong="H3196"\w*.
\p \v 21 \w This|strong="H2063"\w* \w is the law|strong="H8451"\w* \w of the Nazirite|strong="H5139"\w* \w who|strong="H834"\w* \w vows|strong="H5087"\w* \w his offering|strong="H7133"\w* \w to the LORD|strong="H3068"\w* \w for|strong="H5921"\w* \w his separation|strong="H5145"\w*, \w in addition to|strong="H905"\w* \w whatever else|strong="H834"\w* \w he can afford|strong="H5381"\w*; \w he must fulfill|strong="H6213"\w* \w whatever|strong="H834"\w* \w vow|strong="H5088"\w* \w he makes|strong="H5087"\w*, \w according to|strong="H5921"\w* \w the law|strong="H8451"\w* \w of his separation|strong="H5145"\w*.”
\s1 Aaron’s Blessing
\p \v 22 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 23 “\w Tell|strong="H1696"\w* \w Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w*:\w This is how you are to bless|strong="H1288"\w* \w the Israelites|strong="H1121"\w*. \w Say|strong="H559"\w* to them:
