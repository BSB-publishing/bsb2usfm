\c 3
\s1 The Sons of Aaron
\r (\ref Leviticus 10:1–7|LEV 10:1-7\ref*)
\p \v 1 \w This|strong="H428"\w* \w is the account|strong="H8435"\w* \w of Aaron|strong="H175"\w* \w and Moses|strong="H4872"\w* \w at the time|strong="H3117"\w* \w the LORD|strong="H3068"\w* \w spoke|strong="H1696"\w* \w with|strong="H854"\w* \w Moses|strong="H4872"\w* \w on Mount|strong="H2022"\w* \w Sinai|strong="H5514"\w*.
\p \v 2 \w These|strong="H428"\w* \w are the names|strong="H8034"\w* \w of the sons|strong="H1121"\w* \w of Aaron|strong="H175"\w*: \w Nadab|strong="H5070"\w* \w the firstborn|strong="H1060"\w*, \w then Abihu|strong="H30"\w*, \w Eleazar|strong="H499"\w*, \w and Ithamar|strong="H385"\w*. \v 3 \w These|strong="H428"\w* \w were Aaron’s|strong="H175"\w* \w sons|strong="H1121"\w*, \w the anointed|strong="H4886"\w* \w priests|strong="H3548"\w*, \w who|strong="H834"\w* \w were ordained|strong="H4390"\w* \w to serve as priests|strong="H3547"\w*.
\p \v 4 \w Nadab|strong="H5070"\w* \w and Abihu, however|strong="H30"\w*, \w died|strong="H4191"\w* \w in the presence of|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w when they offered|strong="H7126"\w* \w unauthorized|strong="H2114"\w*\f + \fr 3:4 \ft Or \fqa strange\f* \w fire|strong="H784"\w* \w before|strong="H6440"\w* \w the LORD|strong="H3068"\w* \w in the Wilderness|strong="H4057"\w* \w of Sinai|strong="H5514"\w*. \w And since they had|strong="H1961"\w* \w no|strong="H3808"\w* \w sons|strong="H1121"\w*, \w only Eleazar|strong="H499"\w* \w and Ithamar|strong="H385"\w* \w served as priests|strong="H3547"\w* \w during|strong="H5921"\w* \w the lifetime|strong="H6440"\w* \w of their father|strong="H1"\w* \w Aaron|strong="H175"\w*.
\s1 The Duties of the Levites
\p \v 5 \w Then the LORD|strong="H3068"\w* \w said|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \v 6 “\w Bring|strong="H7126"\w* \w the tribe|strong="H4294"\w* \w of Levi|strong="H3881"\w* \w and present|strong="H5975"\w* \w them|strong="H853"\w* \w to|strong="H6440"\w* \w Aaron|strong="H175"\w* \w the priest|strong="H3548"\w* \w to assist him|strong="H8334"\w*. \v 7 \w They are to perform|strong="H8104"\w* \w duties for him|strong="H4931"\w* \w and for the whole|strong="H3605"\w* \w congregation|strong="H5712"\w* \w before|strong="H6440"\w* \w the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*, \w attending|strong="H5647"\w* \w to the service|strong="H5656"\w* \w of the tabernacle|strong="H4908"\w*. \v 8 \w They shall take care of|strong="H8104"\w* \w all|strong="H3605"\w* \w the furnishings|strong="H3627"\w* \w of the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w* \w and|strong="H853"\w* \w fulfill obligations|strong="H4931"\w* \w for the Israelites|strong="H1121"\w* \w by attending|strong="H5647"\w* \w to the service|strong="H5656"\w* \w of the tabernacle|strong="H4908"\w*.
\p \v 9 \w Assign|strong="H5414"\w* \w the Levites|strong="H3881"\w* \w to Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w*; \w they|strong="H1992"\w* \w have been given exclusively|strong="H5414"\w* to him\f + \fr 3:9 \ft Most MT manuscripts; some MT manuscripts, SP, and LXX (see also \ref Numbers 8:16|NUM 8:16\ref*) \fqa to Me\f* \w from among|strong="H854"\w* \w the Israelites|strong="H1121"\w*. \v 10 \w So|strong="H853"\w* \w you shall appoint|strong="H6485"\w* \w Aaron|strong="H175"\w* \w and his sons|strong="H1121"\w* \w to carry out|strong="H8104"\w* \w the duties of the priesthood|strong="H3550"\w*; \w but any outsider|strong="H2114"\w* \w who approaches the tabernacle|strong="H7131"\w* \w must be put to death|strong="H4191"\w*.”
\p \v 11 \w Again the LORD|strong="H3068"\w* \w spoke|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w*, \w saying|strong="H559"\w*, \v 12 “\w Behold|strong="H2009"\w*, \w I|strong="H589"\w* \w have taken|strong="H3947"\w* \w the Levites|strong="H3881"\w* \w from among|strong="H8432"\w* \w the children|strong="H1121"\w* \w of Israel|strong="H3478"\w* \w in place of|strong="H8478"\w* \w every|strong="H3605"\w* \w firstborn|strong="H6363"\w* \w Israelite|strong="H1121"\w* \w from the womb|strong="H7358"\w*. \w The Levites|strong="H3881"\w* \w belong|strong="H1961"\w* to Me, \v 13 \w for|strong="H3588"\w* \w all|strong="H3605"\w* \w the firstborn|strong="H1060"\w* are Mine. \w On the day|strong="H3117"\w* \w I struck down|strong="H5221"\w* \w every|strong="H3605"\w* \w firstborn|strong="H1060"\w* \w in the land|strong="H776"\w* \w of Egypt|strong="H4714"\w*, \w I consecrated|strong="H6942"\w* to Myself \w all|strong="H3605"\w* \w the firstborn|strong="H1060"\w* \w in Israel|strong="H3478"\w*, \w both man|strong="H120"\w* \w and|strong="H5704"\w* \w beast|strong="H929"\w*. \w They are|strong="H1961"\w* Mine; \w I|strong="H589"\w* \w am the LORD|strong="H3068"\w*.”
\s1 The Numbering of the Levites
\p \v 14 \w Then the LORD|strong="H3068"\w* \w spoke|strong="H1696"\w* \w to|strong="H413"\w* \w Moses|strong="H4872"\w* \w in the Wilderness|strong="H4057"\w* \w of Sinai|strong="H5514"\w*, \w saying|strong="H559"\w*, \v 15 “\w Number|strong="H6485"\w* \w the Levites|strong="H1121"\w* \w by their families|strong="H1"\w* \w and clans|strong="H4940"\w*. \w You are to count|strong="H6485"\w* \w every|strong="H3605"\w* \w male|strong="H2145"\w* \w a month|strong="H2320"\w* \w old|strong="H1121"\w* \w or more|strong="H4605"\w*.”
\p \v 16 \w So Moses|strong="H4872"\w* \w numbered|strong="H6485"\w* \w them|strong="H853"\w* \w according to|strong="H5921"\w* \w the word|strong="H6310"\w* \w of the LORD|strong="H3068"\w*, \w as|strong="H834"\w* \w he had been commanded|strong="H6680"\w*.
\p \v 17 \w These|strong="H428"\w* \w were|strong="H1961"\w* \w the sons|strong="H1121"\w* \w of Levi|strong="H3878"\w* \w by name|strong="H8034"\w*: \w Gershon|strong="H1648"\w*, \w Kohath|strong="H6955"\w*, \w and Merari|strong="H4847"\w*. \v 18 \w These|strong="H428"\w* \w were the names|strong="H8034"\w* \w of the sons|strong="H1121"\w* \w of Gershon|strong="H1648"\w* \w by their clans|strong="H4940"\w*: \w Libni|strong="H3845"\w* \w and Shimei|strong="H8096"\w*. \v 19 \w The sons|strong="H1121"\w* \w of Kohath|strong="H6955"\w* \w by their clans|strong="H4940"\w* \w were Amram|strong="H6019"\w*, \w Izhar|strong="H3324"\w*, \w Hebron|strong="H2275"\w*, \w and Uzziel|strong="H5816"\w*. \v 20 \w And the sons|strong="H1121"\w* \w of Merari|strong="H4847"\w* \w by their clans|strong="H4940"\w* \w were Mahli|strong="H4249"\w* \w and Mushi|strong="H4187"\w*. \w These|strong="H428"\w* \w were|strong="H1992"\w* \w the clans|strong="H4940"\w* \w of the Levites|strong="H3881"\w*, \w according to their families|strong="H1"\w*.
\s1 The Gershonites
\r (\ref Numbers 4:21–28|NUM 4:21-28\ref*; \ref 1 Chronicles 23:7–11|1CH 23:7-11\ref*)
\p \v 21 \w From Gershon came|strong="H1648"\w* \w the Libnite|strong="H3846"\w* \w clan|strong="H4940"\w* \w and the Shimeite|strong="H8097"\w* \w clan|strong="H4940"\w*; \w these|strong="H428"\w* \w were the Gershonite|strong="H1649"\w* \w clans|strong="H4940"\w*. \v 22 \w The number|strong="H6485"\w* \w of all|strong="H3605"\w* \w the males|strong="H2145"\w* \w a month|strong="H2320"\w* \w old|strong="H1121"\w* \w or more|strong="H4605"\w* \w was|strong="H6485"\w* \w 7,500|strong="H7651"\w*.
\p \v 23 \w The Gershonite|strong="H1649"\w* \w clans|strong="H4940"\w* \w were to camp|strong="H2583"\w* \w on the west|strong="H3220"\w*, \w behind|strong="H310"\w* \w the tabernacle|strong="H4908"\w*, \v 24 \w and the leader|strong="H5387"\w* \w of the families|strong="H1004"\w* \w of the Gershonites|strong="H1649"\w* \w was Eliasaph|strong="H460"\w* \w son|strong="H1121"\w* \w of Lael|strong="H3815"\w*.
\p \v 25 \w The duties|strong="H4931"\w* \w of the Gershonites|strong="H1121"\w* \w at the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w* \w were the tabernacle|strong="H4908"\w* \w and tent|strong="H168"\w*, \w its covering|strong="H4372"\w*, \w the curtain|strong="H4539"\w* \w for the entrance|strong="H6607"\w* \w to the Tent|strong="H168"\w* \w of Meeting|strong="H4150"\w*, \v 26 \w the curtains|strong="H7050"\w* \w of the courtyard|strong="H2691"\w*, \w the curtain|strong="H4539"\w* \w for the entrance|strong="H6607"\w* \w to the courtyard|strong="H2691"\w* \w that|strong="H834"\w* \w surrounds|strong="H5921"\w* \w the tabernacle|strong="H4908"\w* \w and altar|strong="H4196"\w*, \w and the cords|strong="H4340"\w*— \w all|strong="H3605"\w* \w the service for these items|strong="H5656"\w*.
\s1 The Kohathites
\r (\ref Numbers 4:1–20|NUM 4:1-20\ref*; \ref 1 Chronicles 23:12–20|1CH 23:12-20\ref*)
\p \v 27 \w From Kohath came|strong="H6955"\w* \w the clans|strong="H4940"\w* \w of the Amramites|strong="H6020"\w*, \w the Izharites|strong="H3325"\w*, \w the Hebronites|strong="H2276"\w*, \w and the Uzzielites|strong="H5817"\w*; \w these|strong="H428"\w* \w were the clans|strong="H4940"\w* \w of the Kohathites|strong="H6956"\w*. \v 28 \w The number|strong="H4557"\w* \w of all|strong="H3605"\w* \w the males|strong="H2145"\w* \w a month|strong="H2320"\w* \w old|strong="H1121"\w* \w or more|strong="H4605"\w* \w was 8,600|strong="H8083"\w*.\f + \fr 3:28 \ft Hebrew; some LXX manuscripts \fqa \ref 8,300|0\ref*\ft ; see the total in verse 39.\f* \w They were responsible for|strong="H8104"\w* \w the duties|strong="H4931"\w* \w of the sanctuary|strong="H6944"\w*.
\p \v 29 \w The clans|strong="H4940"\w* \w of the Kohathites|strong="H1121"\w* \w were to camp|strong="H2583"\w* \w on|strong="H5921"\w* \w the south|strong="H8486"\w* \w side|strong="H3409"\w* \w of the tabernacle|strong="H4908"\w*, \v 30 \w and the leader|strong="H5387"\w* \w of the families|strong="H1004"\w* \w of the Kohathites|strong="H6956"\w* \w was Elizaphan|strong="H469"\w*\f + \fr 3:30 \fqa Elizaphan \ft is a variant of \fqa Elzaphan\ft ; see \ref Exodus 6:22|EXO 6:22\ref* and Leviticus 10:4.\f* \w son|strong="H1121"\w* \w of Uzziel|strong="H5816"\w*.
\p \v 31 \w Their duties|strong="H4931"\w* \w were the ark|strong="H727"\w*, \w the table|strong="H7979"\w*, \w the lampstand|strong="H4501"\w*, \w the altars|strong="H4196"\w*, \w the articles|strong="H3627"\w* \w of the sanctuary|strong="H6944"\w* \w used|strong="H8334"\w* with them, \w and the curtain|strong="H4539"\w*— \w all|strong="H3605"\w* \w the service for these items|strong="H5656"\w*.
\p \v 32 \w The chief|strong="H5387"\w* \w of the leaders|strong="H5387"\w* \w of the Levites|strong="H3881"\w* \w was Eleazar|strong="H499"\w* \w son|strong="H1121"\w* \w of Aaron|strong="H175"\w* \w the priest|strong="H3548"\w*; \w he oversaw|strong="H6486"\w* \w those responsible for|strong="H8104"\w* \w the duties|strong="H4931"\w* \w of the sanctuary|strong="H6944"\w*.
