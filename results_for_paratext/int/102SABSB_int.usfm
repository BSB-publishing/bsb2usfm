\li1 \rb Ittai|אִתַּי֙\rb*\f + \fr 23:29 \fqa Ittai \ft is a variant of \fqa Ithai\ft ; see 1 Chronicles 11:31.\f* \rb son|בֶּן־\rb* \rb of Ribai|רִיבַ֔י\rb* \rb from Gibeah|מִגִּבְעַ֖ת\rb* \rb of the Benjamites|בְּנֵ֥י\rb*\rb |בִנְיָמִֽן׃ס\rb*,
\li1 \v 30 \rb Benaiah|בְּנָיָ֙הוּ֙\rb* \rb the Pirathonite|פִּרְעָ֣תֹנִ֔י\rb*,
\li1 \rb Hiddai|הִדַּ֖י\rb*\f + \fr 23:30 \fqa Hiddai \ft is a variant of \fqa Hurai\ft ; see 1 Chronicles 11:32.\f* \rb from the brooks|מִנַּ֥חֲלֵי\rb*\f + \fr 23:30 \ft Or \fqa from the ravines\f* \rb of Gaash|גָֽעַשׁ׃ס\rb*,
\li1 \v 31 \rb |אֲבִֽי־\rb* \rb Abi-albon|עַלְבוֹן֙\rb* \rb the Arbathite|הָֽעַרְבָתִ֔י\rb*,
\li1 \rb Azmaveth|עַזְמָ֖וֶת\rb* \rb the Barhumite|הַבַּרְחֻמִֽי׃ס\rb*,
\li1 \v 32 \rb Eliahba|אֶלְיַחְבָּא֙\rb* \rb the Shaalbonite|הַשַּׁ֣עַלְבֹנִ֔י\rb*,
\li1 \rb the sons|בְּנֵ֥י\rb* \rb of Jashen|יָשֵׁ֖ן\rb*,\f + \fr 23:32 \fqa Jashen \ft is a variant of \fqa Hashem\ft ; see 1 Chronicles 11:34.\f*
\li1 \rb Jonathan|יְהוֹנָתָֽן׃ס\rb* \v 33 \rb son of Shammah|שַׁמָּה֙\rb*\f + \fr 23:33 \ft Some LXX manuscripts (see also 1 Chronicles 11:34); Hebrew \fqa Jonathan, \fv 33\fv*Shammah\f* \rb the Hararite|הַֽהֲרָרִ֔י\rb*,
\li1 \rb Ahiam|אֲחִיאָ֥ם\rb* \rb son|בֶּן־\rb* \rb of Sharar|שָׁרָ֖ר\rb*\f + \fr 23:33 \ft Hebrew; some LXX manuscripts \fqa Sachar\ft ; see 1 Chronicles 11:35.\f* \rb the Hararite|הָארָרִֽי׃ס\rb*,
\li1 \v 34 \rb Eliphelet|אֱלִיפֶ֥לֶט\rb* \rb son|בֶּן־\rb* \rb of Ahasbai|אֲחַסְבַּ֖י\rb*\rb |בֶּן־\rb* \rb the Maacathite|הַמַּֽעֲכָתִ֑יס\rb*,
