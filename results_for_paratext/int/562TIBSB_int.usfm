\p \v 19 \rb Greet|Ἄσπασαι\rb* \rb Prisca|Πρίσκαν\rb*\f + \fr 4:19 \fqa Prisca \ft is a variant of \fqa Priscilla\ft ; see Acts 18:2.\f* \rb and|καὶ\rb* \rb Aquila|Ἀκύλαν\rb*, \rb as well as|καὶ\rb* \rb the|τὸν\rb* \rb household|οἶκον\rb* \rb of Onesiphorus|Ὀνησιφόρου\rb*.
\p \v 20 \rb Erastus|Ἔραστος\rb* \rb has remained|ἔμεινεν\rb* \rb at|ἐν\rb* \rb Corinth|Κορίνθῳ\rb*, \rb and|δὲ\rb* \rb Trophimus|Τρόφιμον\rb* \rb I left|ἀπέλιπον\rb* \rb sick|ἀσθενοῦντα\rb* \rb in|ἐν\rb* \rb Miletus|Μιλήτῳ\rb*.
\p \v 21 \rb Make every effort|Σπούδασον\rb* \rb to come to me|ἐλθεῖν\rb* \rb before|πρὸ\rb* \rb winter|χειμῶνος\rb*.
\p \rb Eubulus|Εὔβουλος\rb* \rb sends you greetings|Ἀσπάζεταί\rb*\rb |σε\rb*, \rb as do|καὶ\rb* \rb Pudens|Πούδης\rb*,\rb |καὶ\rb* \rb Linus|Λίνος\rb*,\rb |καὶ\rb* \rb Claudia|Κλαυδία\rb*, \rb and|καὶ\rb* \rb all|πάντες\rb* \rb the|οἱ\rb* \rb brothers|ἀδελφοὶ\rb*.
\p \v 22 \rb The|Ὁ\rb* \rb Lord|Κύριος\rb* \rb be with|μετὰ\rb* \rb your|σου\rb*\rb |τοῦ\rb* \rb spirit|πνεύματός\rb*.\rb |ἡ\rb* \rb Grace be|χάρις\rb* \rb with|μεθ’\rb* \rb you all|ὑμῶν\rb*.\f + \fr 4:22 \ft BYZ and TR include \fqa Amen.\f*
