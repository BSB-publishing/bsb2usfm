\p \v 53 \w But when|strong="H00518"\w* \w the priest|strong="H03548"\w* \w reexamines it|strong="H07200"\w*, \w if|strong="H02009"\w* \w the mildew|strong="H05061"\w* \w has not|strong="H03808"\w* \w spread|strong="H06581"\w* \w in the fabric|strong="H00899"\w*, \w weave|strong="H08359"\w*, \w -|strong="H00176"\w* \w knit|strong="H06154"\w*, \w . . .|strong="H00176"\w* \w or|strong="H00176"\w* \w -|strong="H03605"\w* \w leather|strong="H05785"\w* \w article|strong="H03627"\w*, \v 54 \w the priest|strong="H03548"\w* \w is to order|strong="H06680"\w* \w the|strong="H00834"\w* vvv \w contaminated [article]|strong="H05061"\w* \w to be washed|strong="H03526"\w* \w -|strong="H00853"\w* \w and isolated|strong="H05462"\w* \w for another|strong="H08145"\w* \w seven|strong="H07651"\w* \w days|strong="H03117"\w*. \v 55 \w After|strong="H00310"\w* \w it has been washed|strong="H03526"\w*, \w -|strong="H00853"\w* \w the priest|strong="H03548"\w* \w is to reexamine it|strong="H07200"\w*, \w and if|strong="H02009"\w* \w the mildewed|strong="H05061"\w* \w article|strong="H05061"\w* \w -|strong="H00853"\w* \w has not|strong="H03808"\w* \w changed|strong="H02015"\w* \w in appearance|strong="H05869"\w*, \w it|strong="H01931"\w* \w is unclean|strong="H02931"\w*. \w Even though the mildew|strong="H05061"\w* \w has not|strong="H03808"\w* \w spread|strong="H06581"\w*, \w you must burn it|strong="H08313"\w* \w . . .|strong="H00784"\w*, \w whether|strong="H01931"\w* \w the rot is|strong="H06356"\w* \w on the front|strong="H01372"\w* \w or|strong="H00176"\w* \w back|strong="H07146"\w*.
