\c 5
\s1 Sins Requiring a Sin Offering
\r (Leviticus 4:1–35; Leviticus 6:24–30)
\p \v 1 “\w If|strong="H03588"\w* \w someone|strong="H05315"\w* \w sins|strong="H02398"\w* \w by failing|strong="H03808"\w* \w to testify|strong="H05046"\w* \w when he hears|strong="H08085"\w* \w a public|strong="H06963"\w* \w charge|strong="H00423"\w* \w about something he|strong="H01931"\w* \w has witnessed|strong="H05707"\w*, \w whether|strong="H00176"\w* \w he has seen it|strong="H07200"\w* \w or|strong="H00176"\w* \w learned of it|strong="H03045"\w* \w . . .|strong="H00518"\w*, \w he shall bear|strong="H05375"\w* \w the iniquity|strong="H05771"\w*.
\p \v 2 \w Or|strong="H00176"\w* \w if a person|strong="H05315"\w* \w -|strong="H00834"\w* \w touches|strong="H05060"\w* \w anything|strong="H03605"\w* \w . . .|strong="H01697"\w* \w unclean|strong="H02931"\w*— \w -|strong="H00176"\w* \w whether the carcass|strong="H05038"\w* \w of [any] unclean|strong="H02931"\w* \w wild animal|strong="H02416"\w* \w -|strong="H02931"\w* \w or|strong="H00176"\w* \w . . .|strong="H05038"\w* \w livestock|strong="H00929"\w* \w or|strong="H00176"\w* \w . . .|strong="H05038"\w* \w -|strong="H02931"\w* \w crawling creature|strong="H08318"\w*— \w even if he is unaware|strong="H05956"\w* \w of it|strong="H04480"\w*, \w he|strong="H01931"\w* \w is unclean|strong="H02931"\w* \w and guilty|strong="H00816"\w*.
\p \v 3 \w Or|strong="H00176"\w* \w if|strong="H03588"\w* \w he touches|strong="H05060"\w* \w human|strong="H00120"\w* \w uncleanness|strong="H02932"\w*— \w anything|strong="H03605"\w* \w -|strong="H02932"\w* \w by which|strong="H00834"\w* \w one becomes unclean|strong="H02930"\w*— \w even if he is unaware|strong="H05956"\w* \w of it|strong="H04480"\w*, \w when he|strong="H01931"\w* \w realizes it|strong="H03045"\w*, \w he is guilty|strong="H00816"\w*.
\p \v 4 \w Or|strong="H00176"\w* \w if|strong="H03588"\w* \w someone|strong="H05315"\w* \w swears|strong="H07650"\w* \w thoughtlessly|strong="H00981"\w* \w with his lips|strong="H08193"\w* \w to do anything good|strong="H03190"\w* \w or|strong="H00176"\w* \w evil|strong="H07489"\w*— \w in|strong="H03605"\w* \w whatever matter|strong="H00834"\w* \w a man|strong="H00120"\w* \w may rashly pronounce|strong="H00981"\w* \w an oath|strong="H07621"\w*— \w even if he is unaware|strong="H05956"\w* \w of it|strong="H04480"\w*, \w when he|strong="H01931"\w* \w realizes it|strong="H03045"\w*, \w he is guilty|strong="H00816"\w* \w vvv|strong="H00259"\w* \w in [the matter]|strong="H00428"\w*.
\p \v 5 \w -|strong="H01961"\w* \w If|strong="H03588"\w* \w someone incurs guilt|strong="H00816"\w* \w in one|strong="H00259"\w* \w of these ways|strong="H00428"\w*, \w he must confess|strong="H03034"\w* \w -|strong="H00834"\w* \w the sin he has committed|strong="H02398"\w* \w . . .|strong="H05921"\w*, \v 6 \w and he must bring|strong="H00935"\w* \w -|strong="H00853"\w* \w his guilt offering|strong="H00817"\w* \w to the LORD|strong="H03068"\w* \w for|strong="H05921"\w* \w the sin|strong="H02403"\w* \w -|strong="H00834"\w* \w he has committed|strong="H02398"\w*: \w a female|strong="H05347"\w* \w lamb|strong="H03776"\w* \w or|strong="H00176"\w* \w goat|strong="H08166"\w* \w . . .|strong="H05795"\w* \w from|strong="H04480"\w* \w the flock|strong="H06629"\w* \w as a sin offering|strong="H02403"\w*. \w And the priest|strong="H03548"\w* \w will make atonement|strong="H03722"\w* \w for him|strong="H05921"\w* \w concerning his sin|strong="H02403"\w*.
\p \v 7 \w If, however|strong="H00518"\w*, \w he cannot|strong="H03808"\w* \w afford|strong="H05060"\w* \w . . .|strong="H03027"\w* \w . . .|strong="H01767"\w* \w a lamb|strong="H07716"\w*, \w he may bring|strong="H00935"\w* \w -|strong="H00853"\w* \w to the LORD|strong="H03068"\w* \w as restitution|strong="H00817"\w* \w -|strong="H00834"\w* \w for his sin|strong="H02398"\w* \w two|strong="H08147"\w* \w turtledoves|strong="H08449"\w* \w or|strong="H00176"\w* \w two|strong="H08147"\w* \w young|strong="H01121"\w* \w pigeons|strong="H03123"\w* — \w one|strong="H00259"\w* \w as a sin offering|strong="H02403"\w* \w and the other|strong="H00259"\w* \w as a burnt offering|strong="H05930"\w*. \v 8 \w He is to bring|strong="H00935"\w* \w them|strong="H00853"\w* \w to|strong="H00413"\w* \w the priest|strong="H03548"\w*, \w who shall first|strong="H07223"\w* \w present|strong="H07126"\w* \w -|strong="H00853"\w* \w the one|strong="H00834"\w* \w for the sin offering|strong="H02403"\w*. \w He is to twist|strong="H04454"\w* \w -|strong="H00853"\w* \w its head|strong="H07218"\w* \w at the front|strong="H04136"\w* \w of its neck|strong="H06203"\w* \w without|strong="H03808"\w* \w severing it|strong="H00914"\w*; \v 9 \w then he is to sprinkle|strong="H05137"\w* \w some of the blood|strong="H01818"\w* \w of the sin offering|strong="H02403"\w* \w on|strong="H05921"\w* \w the side|strong="H07023"\w* \w of the altar|strong="H04196"\w*, \w while the rest|strong="H07604"\w* \w of the blood|strong="H01818"\w* \w is drained out|strong="H04680"\w* \w at|strong="H00413"\w* \w the base|strong="H03247"\w* \w of the altar|strong="H04196"\w*. \w It [is]|strong="H01931"\w* \w a sin offering|strong="H02403"\w*. \v 10 \w And|strong="H00853"\w* \w [the priest] must prepare|strong="H06213"\w* \w the second [bird]|strong="H08145"\w* \w as a burnt offering|strong="H05930"\w* \w according to the ordinance|strong="H04941"\w*. \w In this way the priest|strong="H03548"\w* \w will make atonement|strong="H03722"\w* \w for him|strong="H05921"\w* \w for the sin|strong="H02403"\w* \w -|strong="H00834"\w* \w he has committed|strong="H02398"\w*, \w and he will be forgiven|strong="H05545"\w*.
\p \v 11 \w But if|strong="H00518"\w* \w he cannot|strong="H03808"\w* \w afford|strong="H05381"\w* \w . . .|strong="H03027"\w* \w two|strong="H08147"\w* \w turtledoves|strong="H08449"\w* \w or|strong="H00176"\w* \w two|strong="H08147"\w* \w young|strong="H01121"\w* \w pigeons|strong="H03123"\w*, \w he may bring|strong="H00935"\w* \w -|strong="H00853"\w* \w -|strong="H07133"\w* \w -|strong="H00834"\w* \w -|strong="H02398"\w* \w a tenth|strong="H06224"\w* \w of an ephah|strong="H00374"\w* \w of fine flour|strong="H05560"\w*\f + \fr 5:11 \fqa A tenth of an ephah \ft is approximately 2 dry quarts or 2.2 liters (probably about 2.6 pounds or 1.2 kilograms of flour).\f* \w as a sin offering|strong="H02403"\w*. \w He must not|strong="H03808"\w* \w put|strong="H07760"\w* \w olive oil|strong="H08081"\w* \w . . .|strong="H03808"\w* \w . . .|strong="H05414"\w* \w . . .|strong="H05921"\w* \w or frankincense|strong="H03828"\w* \w on it|strong="H05921"\w*, \w because|strong="H03588"\w* \w it|strong="H01931"\w* \w [is] a sin offering|strong="H02403"\w*. \v 12 \w He is to bring|strong="H00935"\w* \w it to|strong="H00413"\w* \w the priest|strong="H03548"\w*, \w who shall take|strong="H07061"\w* \w . . .|strong="H03548"\w* \w a handful|strong="H04393"\w* \w . . .|strong="H07062"\w* \w -|strong="H00853"\w* \w from it|strong="H04480"\w* \w as a memorial portion|strong="H00234"\w* \w and burn [it]|strong="H06999"\w* \w on the altar|strong="H04196"\w* \w atop|strong="H05921"\w* \w the food offerings|strong="H00801"\w* \w to the LORD|strong="H03068"\w*; \w it|strong="H01931"\w* \w is a sin offering|strong="H02403"\w*. \v 13 \w In this way the priest|strong="H03548"\w* \w will make atonement|strong="H03722"\w* \w for him|strong="H05921"\w* \w for|strong="H05921"\w* \w any|strong="H00259"\w* \w of these|strong="H00428"\w* \w sins|strong="H02403"\w* \w -|strong="H00834"\w* \w he has committed|strong="H02398"\w*, \w and he will be forgiven|strong="H05545"\w*. \w The remainder will belong to|strong="H01961"\w* \w the priest|strong="H03548"\w*, \w like the grain offering|strong="H04503"\w*.”
\s1 Laws for Guilt Offerings
\r (Leviticus 6:1–7; Leviticus 7:1–10)
\p \v 14 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00559"\w*, \v 15 “\w If|strong="H03588"\w* \w someone|strong="H05315"\w* \w acts|strong="H04603"\w* \w unfaithfully|strong="H04604"\w* \w and sins|strong="H02398"\w* \w unintentionally against|strong="H07684"\w* \w any of the LORD’s|strong="H03068"\w* \w holy things|strong="H06944"\w*, \w he must bring|strong="H00935"\w* \w -|strong="H00853"\w* \w his guilt offering|strong="H00817"\w* \w to the LORD|strong="H03068"\w*: \w an unblemished|strong="H08549"\w* \w ram|strong="H00352"\w* \w from|strong="H04480"\w* \w the flock|strong="H06629"\w*, \w of proper value|strong="H06187"\w*\f + \fr 5:15 \ft Or \fqa flock or its equivalence\f* \w in silver|strong="H03701"\w* \w shekels|strong="H08255"\w* \w according to the sanctuary|strong="H06944"\w* \w shekel|strong="H08255"\w*;\f + \fr 5:15 \fqa A shekel \ft is approximately 0.4 ounces or 11.4 grams of silver.\f* \w it is a guilt offering|strong="H00817"\w*. \v 16 \w Regarding any holy thing|strong="H06944"\w* \w he has harmed|strong="H02398"\w* \w . . .|strong="H04480"\w*, \w -|strong="H00853"\w* \w -|strong="H00834"\w* \w he must make restitution|strong="H07999"\w* \w -|strong="H00853"\w* \w by adding|strong="H03254"\w* \w a fifth|strong="H02549"\w* \w of its value to it|strong="H05921"\w* \w and giving|strong="H05414"\w* \w -|strong="H00853"\w* \w it to the priest|strong="H03548"\w*, \w [who]|strong="H03548"\w* \w will make atonement|strong="H03722"\w* \w on his behalf|strong="H05921"\w* \w with the ram|strong="H00352"\w* \w as a guilt offering|strong="H00817"\w*, \w and he will be forgiven|strong="H05545"\w*.
\p \v 17 \w If|strong="H00518"\w* \w someone|strong="H05315"\w* \w . . .|strong="H03588"\w* \w sins|strong="H02398"\w* \w and violates|strong="H06213"\w* \w any|strong="H00259"\w* \w . . .|strong="H03605"\w* \w of the LORD’s|strong="H03068"\w* \w commandments|strong="H04687"\w* \w -|strong="H00834"\w* \w even though he was|strong="H03808"\w* \w . . .|strong="H03808"\w* \w . . .|strong="H06213"\w* \w unaware|strong="H03045"\w*, \w he is guilty|strong="H00816"\w* \w and shall bear|strong="H05375"\w* \w his punishment|strong="H05771"\w*. \v 18 \w He is to bring|strong="H00935"\w* \w to|strong="H00413"\w* \w the priest|strong="H03548"\w* \w an unblemished|strong="H08549"\w* \w ram|strong="H00352"\w* \w of proper value|strong="H06187"\w* \w from|strong="H04480"\w* \w the flock|strong="H06629"\w* \w as a guilt offering|strong="H00817"\w*. \w Then the priest|strong="H03548"\w* \w will make atonement|strong="H03722"\w* \w on his behalf|strong="H05921"\w* \w for|strong="H05921"\w* \w the wrong|strong="H07684"\w* \w -|strong="H00834"\w* \w he has committed|strong="H07683"\w* \w . . .|strong="H01931"\w* \w in ignorance|strong="H03808"\w* \w . . .|strong="H03045"\w*, \w and he will be forgiven|strong="H05545"\w*. \v 19 \w It|strong="H01931"\w* \w is a guilt offering|strong="H00817"\w*; \w he was certainly guilty|strong="H00816"\w* \w . . .|strong="H00816"\w*\f + \fr 5:19 \ft Or \fqa he has paid full compensation\f* \w before the LORD|strong="H03068"\w*.”
