\p \v 4 \w These|strong="H00428"\w* \w are the LORD’s|strong="H03068"\w* \w appointed feasts|strong="H04150"\w*, \w the sacred|strong="H06944"\w* \w -|strong="H00834"\w* \w assemblies|strong="H04744"\w* \w you are to proclaim|strong="H07121"\w* \w -|strong="H00853"\w* \w at their appointed times|strong="H04150"\w*. \v 5 \w The Passover|strong="H06453"\w* \w to the LORD|strong="H03068"\w* \w begins at|strong="H00996"\w* \w twilight|strong="H06153"\w* \w on the fourteenth|strong="H00702"\w* \w . . .|strong="H06240"\w*\f + \fr 23:5 \ft Hebrew \fqa begins between the two evenings of the fourteenth\f* \w day|strong="H02320"\w* \w of the first|strong="H07223"\w* \w month|strong="H02320"\w*. \v 6 \w On the fifteenth|strong="H02568"\w* \w . . .|strong="H06240"\w* \w day|strong="H03117"\w* \w of the same|strong="H02088"\w* \w month [begins]|strong="H02320"\w* \w the Feast|strong="H02282"\w* \w of Unleavened Bread|strong="H04682"\w*\f + \fr 23:6 \ft That is, the seven-day period after the Passover during which no leaven may be eaten; see Exodus 12:14–20.\f* \w to the LORD|strong="H03068"\w*. \w For seven|strong="H07651"\w* \w days|strong="H03117"\w* \w you must eat|strong="H00398"\w* \w unleavened bread|strong="H04682"\w*. \v 7 \w On the first|strong="H07223"\w* \w day|strong="H03117"\w* \w you are to hold|strong="H01961"\w* \w a sacred|strong="H06944"\w* \w assembly|strong="H04744"\w*; \w you are not|strong="H03808"\w* \w to do|strong="H06213"\w* \w any|strong="H03605"\w* \w regular|strong="H05656"\w* \w work|strong="H04399"\w*. \v 8 \w For seven|strong="H07651"\w* \w days|strong="H03117"\w* \w you are to present|strong="H07126"\w* \w a food offering|strong="H00801"\w* \w to the LORD|strong="H03068"\w*. \w On the seventh|strong="H07637"\w* \w day|strong="H03117"\w* \w there shall be a sacred|strong="H06944"\w* \w assembly|strong="H04744"\w*; \w you must not|strong="H03808"\w* \w do|strong="H06213"\w* \w any|strong="H03605"\w* \w regular|strong="H05656"\w* \w work|strong="H04