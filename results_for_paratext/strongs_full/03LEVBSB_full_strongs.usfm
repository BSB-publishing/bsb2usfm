\p \v 21 \w If a man|strong="H00376"\w* \w -|strong="H00834"\w* \w marries|strong="H03947"\w* \w -|strong="H00853"\w* \w his brother’s|strong="H00251"\w* \w wife|strong="H00802"\w*, \w it|strong="H01931"\w* \w is an act of impurity|strong="H05079"\w*. \w He has uncovered|strong="H01540"\w* \w the nakedness|strong="H06172"\w* \w of his brother|strong="H00251"\w*; \w they shall be|strong="H01961"\w* \w childless|strong="H06185"\w*.
\s1 Distinguish between Clean and Unclean
\p \v 22 \w You are therefore to keep|strong="H08104"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w My statutes|strong="H02708"\w* \w -|strong="H00853"\w* \w and|strong="H03605"\w* \w ordinances|strong="H04941"\w* \w -|strong="H06213"\w*, \w -|strong="H00853"\w* \w so that the land|strong="H00776"\w* \w where|strong="H00834"\w* \w I|strong="H00589"\w* \w am bringing|strong="H00935"\w* \w -|strong="H00853"\w* \w -|strong="H08033"\w* \w you to live|strong="H03427"\w* \w will not|strong="H03808"\w* \w vomit you out|strong="H06958"\w* \w -|strong="H00853"\w*. \v 23 \w You must not|strong="H03808"\w* \w follow|strong="H01980"\w* \w the statutes|strong="H02708"\w* \w of the nations|strong="H01471"\w* \w -|strong="H00834"\w* \w I|strong="H00589"\w* \w am driving out|strong="H07971"\w* \w before you|strong="H06440"\w*. \w Because|strong="H03588"\w* \w -|strong="H00853"\w* \w they did|strong="H06213"\w* \w all|strong="H03605"\w* \w these things|strong="H00428"\w*, \w I abhorred|strong="H06973"\w* them.
\p \v 24 \w But I have told|strong="H00559"\w* you \w that you|strong="H00859"\w* \w will inherit|strong="H03423"\w* \w -|strong="H00853"\w* \w their land|strong="H00127"\w*, \w since I|strong="H00589"\w* \w will give|strong="H05414"\w* it to you \w as an inheritance|strong="H03423"\w* — \w -|strong="H00853"\w* \w a land|strong="H00776"\w* \w flowing|strong="H02100"\w* \w with milk|strong="H02461"\w* \w and honey|strong="H01706"\w*. \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*, \w who|strong="H00834"\w* \w has set you apart|strong="H00914"\w* \w -|strong="H00853"\w* \w from|strong="H04480"\w* \w the peoples|strong="H05971"\w*.
\p \v 25 \w You are therefore to distinguish|strong="H00914"\w* \w between|strong="H00996"\w* \w clean|strong="H02889"\w* \w and unclean|strong="H02931"\w* \w animals|strong="H00929"\w* \w and|strong="H00996"\w* \w -|strong="H02931"\w* \w birds|strong="H05775"\w* \w -|strong="H02889"\w*. \w Do not|strong="H03808"\w* \w become contaminated|strong="H08262"\w* \w -|strong="H00853"\w* \w -|strong="H05315"\w* \w by any animal|strong="H00929"\w* \w or bird|strong="H05775"\w*, \w or by anything|strong="H03605"\w* \w that|strong="H00834"\w* \w crawls|strong="H07430"\w* \w on the ground|strong="H00127"\w*; \w I have set these|strong="H00834"\w* \w apart|strong="H00914"\w* \w as unclean|strong="H02930"\w* for you. \v 26 \w You are to be|strong="H01961"\w* \w holy|strong="H06918"\w* to Me \w because|strong="H03588"\w* \w I|strong="H00589"\w*, \w the LORD|strong="H03068"\w*, \w am holy|strong="H06918"\w*, \w and I have set you apart|strong="H00914"\w* \w -|strong="H00853"\w* \w from|strong="H04480"\w* \w the nations|strong="H05971"\w* \w to be|strong="H01961"\w* My own.
\p \v 27 \w A man|strong="H00376"\w* \w or|strong="H00176"\w* \w a woman|strong="H00802"\w* \w . . .|strong="H03588"\w* \w who is|strong="H01961"\w* \w a medium|strong="H00178"\w* \w or|strong="H00176"\w* \w spiritist|strong="H03049"\w* \w must surely be put to death|strong="H04191"\w* \w . . .|strong="H04191"\w*. \w vvv|strong="H00068"\w* \w They shall be stoned|strong="H07275"\w*; \w -|strong="H00853"\w* \w their blood|strong="H01818"\w* [is] upon them.’”
\c 21
\s1 Holiness Required of Priests
\p \v 1 \w Then the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*, “\w Speak|strong="H00559"\w* \w to|strong="H00413"\w* \w Aaron’s|strong="H00175"\w* \w sons|strong="H01121"\w*, \w the priests|strong="H03548"\w*, \w and tell|strong="H00559"\w* \w them [that]|strong="H00413"\w* \w [a priest] is not|strong="H03808"\w* \w to defile himself|strong="H02930"\w* \w for a dead person|strong="H05315"\w* \w among his people|strong="H05971"\w*, \v 2 \w except|strong="H03588"\w* \w . . .|strong="H00518"\w* \w for his immediate|strong="H07138"\w* \w . . .|strong="H00413"\w* \w family|strong="H07607"\w* — \w his mother|strong="H00517"\w*, \w father|strong="H00001"\w*, \w son|strong="H01121"\w*, \w daughter|strong="H01323"\w*, \w or brother|strong="H00251"\w*, \v 3 \w or his unmarried|strong="H01330"\w* \w sister|strong="H00269"\w* \w who is near|strong="H07138"\w* \w to him|strong="H00413"\w*, \w since|strong="H00834"\w* \w she has|strong="H01961"\w* \w no|strong="H03808"\w* \w husband|strong="H00376"\w* - \w -|strong="H02930"\w*. \v 4 \w He is not|strong="H03808"\w* \w to defile himself|strong="H02930"\w* \w for those related to him by marriage|strong="H01167"\w* \w . . .|strong="H05971"\w*, \w and so profane himself|strong="H02490"\w*.
\p \v 5 \w Priests must not|strong="H03808"\w* \w make bald|strong="H07139"\w* \w . . .|strong="H07144"\w* \w spots on their heads|strong="H07218"\w*, \w shave off the edges|strong="H06285"\w* \w of their beards|strong="H02206"\w*, \w . . .|strong="H03808"\w* \w . . .|strong="H01548"\w* \w or make|strong="H08295"\w* \w cuts|strong="H08296"\w* \w in their bodies|strong="H01320"\w*. \w . . .|strong="H03808"\w* \v 6 \w They must be|strong="H01961"\w* \w holy|strong="H06918"\w* \w to their God|strong="H00430"\w* \w and not|strong="H03808"\w* \w profane|strong="H02490"\w* \w the name|strong="H08034"\w* \w of their God|strong="H00430"\w*. \w Because|strong="H03588"\w* \w -|strong="H00853"\w* \w they|strong="H01992"\w* \w present|strong="H07126"\w* \w to the LORD|strong="H03068"\w* \w the food offerings|strong="H00801"\w*, \w the food|strong="H03899"\w* \w of their God|strong="H00430"\w*, \w they must be|strong="H01961"\w* \w holy|strong="H06944"\w*.
\p \v 7 \w [A priest] must not|strong="H03808"\w* \w marry|strong="H03947"\w* \w . . .|strong="H00802"\w* \w a woman|strong="H00802"\w* \w defiled|strong="H02491"\w* \w by prostitution|strong="H02181"\w* \w or|strong="H03808"\w* \w -|strong="H03947"\w* \w divorced|strong="H01644"\w* \w by her husband|strong="H00376"\w*, \w for|strong="H03588"\w* \w [the priest]|strong="H01931"\w* \w is holy|strong="H06918"\w* \w to his God|strong="H00430"\w*. \v 8 \w You are to regard him as holy|strong="H06942"\w*, \w since|strong="H03588"\w* \w -|strong="H00853"\w* \w he|strong="H01931"\w* \w presents|strong="H07126"\w* \w the food|strong="H03899"\w* \w of your God|strong="H00430"\w*. \w He shall be|strong="H01961"\w* \w holy|strong="H06918"\w* to you, \w because|strong="H03588"\w* \w I|strong="H00589"\w* \w the LORD|strong="H03068"\w* \w am holy|strong="H06918"\w* — \w I who set you apart|strong="H06942"\w*. \v 9 \w If|strong="H03588"\w* \w a priest’s|strong="H03548"\w* \w daughter|strong="H01323"\w* \w . . .|strong="H00376"\w* \w defiles herself|strong="H02490"\w* \w by prostituting herself|strong="H02181"\w*, \w -|strong="H00853"\w* \w she|strong="H01931"\w* \w profanes|strong="H02490"\w* \w her father|strong="H00001"\w*; \w she must be burned|strong="H08313"\w* \w in the fire|strong="H00784"\w*.
\p \v 10 \w The priest|strong="H03548"\w* \w who is highest|strong="H01419"\w* \w among his brothers|strong="H00251"\w*, \w who|strong="H00834"\w* \w has had the anointing|strong="H04888"\w* \w oil|strong="H08081"\w* \w poured|strong="H03332"\w* \w on|strong="H05921"\w* \w his head|strong="H07218"\w* \w and has been ordained|strong="H04390"\w* \w -|strong="H00853"\w* \w -|strong="H03027"\w* \w to wear|strong="H03847"\w* \w -|strong="H00853"\w* \w the priestly garments|strong="H00899"\w*, \w -|strong="H00853"\w* \w must not {let}|strong="H03808"\w* \w his hair|strong="H07218"\w* \w hang loose|strong="H06544"\w*\f + \fr 21:10 \ft Or \fqa must not uncover his head\f* \w or tear|strong="H06533"\w* \w his garments|strong="H00899"\w* \w . . .|strong="H03808"\w*. \v 11 \w -|strong="H05921"\w* \w He must not|strong="H03808"\w* \w go|strong="H00935"\w* \w near any|strong="H03605"\w* \w dead|strong="H04191"\w* \w body|strong="H05315"\w*; \w he must not|strong="H03808"\w* \w defile himself|strong="H02930"\w*, \w even for his father|strong="H00001"\w* \w or mother|strong="H00517"\w*. \v 12 \w -|strong="H04480"\w* \w He must not|strong="H03808"\w* \w leave|strong="H03318"\w* \w . . .|strong="H03808"\w* \w -|strong="H04720"\w* \w or desecrate|strong="H02490"\w* \w -|strong="H00853"\w* \w the sanctuary|strong="H04720"\w* \w of his God|strong="H00430"\w*, \w for|strong="H03588"\w* \w the consecration|strong="H05145"\w* \w of the anointing|strong="H04888"\w* \w oil|strong="H08081"\w* \w of his God|strong="H00430"\w* \w is on him|strong="H05921"\w*. \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w*.
\p \v 13 \w The woman|strong="H00802"\w* \w he|strong="H01931"\w* \w marries|strong="H03947"\w* \w must be a virgin|strong="H01331"\w*. \v 14 \w He is not|strong="H03808"\w* \w to marry|strong="H03947"\w* \w . . .|strong="H03588"\w* \w . . .|strong="H00518"\w* \w a widow|strong="H00490"\w*, \w a divorced woman|strong="H01644"\w*, \w or one defiled|strong="H02491"\w* \w by prostitution|strong="H02181"\w*. \w -|strong="H00853"\w* \w -|strong="H00428"\w* \w He is to marry|strong="H03947"\w* \w . . .|strong="H00802"\w* \w a virgin|strong="H01330"\w* \w from his own people|strong="H05971"\w*, \v 15 \w so that he does not|strong="H03808"\w* \w defile|strong="H02490"\w* \w his offspring|strong="H02233"\w* \w among his people|strong="H05971"\w*, \w for|strong="H03588"\w* \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w* \w who sanctifies him|strong="H06942"\w*.”
\s1 Restrictions against Those with Blemishes
\p \v 16 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00559"\w*, \v 17 “\w Say|strong="H01696"\w* \w to|strong="H00413"\w* \w Aaron|strong="H00175"\w* \w -|strong="H00559"\w*, ‘\w For the generations to come|strong="H01755"\w*, \w -|strong="H00376"\w* \w none|strong="H03808"\w* \w of your descendants|strong="H02233"\w* \w who|strong="H00834"\w* \w has|strong="H01961"\w* \w a physical defect|strong="H03971"\w* \w may approach|strong="H07126"\w* \w to offer|strong="H07126"\w* \w the food|strong="H03899"\w* \w of his God|strong="H00430"\w*.
\p \v 18 \w -|strong="H03588"\w* \w No|strong="H03605"\w* \w . . .|strong="H03808"\w* \w man|strong="H00376"\w* \w who|strong="H00834"\w* \w has any defect|strong="H03971"\w* \w may approach|strong="H07126"\w* — \w no man|strong="H00376"\w* \w who is blind|strong="H05787"\w*, \w lame|strong="H06455"\w*, \w . . .|strong="H00176"\w* \w disfigured|strong="H02763"\w*, \w . . .|strong="H00176"\w* \w or|strong="H00176"\w* \w deformed|strong="H08311"\w*; \v 19 \w . . .|strong="H00176"\w* \w no man|strong="H00376"\w* \w who|strong="H00834"\w* \w has|strong="H01961"\w* \w a broken|strong="H07667"\w* \w foot|strong="H07272"\w* \w or|strong="H00176"\w* \w . . .|strong="H07667"\w* \w hand|strong="H03027"\w*, \v 20 \w or|strong="H00176"\w* \w who is a hunchback|strong="H01384"\w* \w or|strong="H00176"\w* \w dwarf|strong="H01851"\w*, \w or|strong="H00176"\w* \w who has an eye|strong="H05869"\w* \w defect|strong="H08400"\w*, \w a festering rash|strong="H01618"\w*, \w . . .|strong="H00176"\w* \w scabs|strong="H03217"\w*, \w . . .|strong="H00176"\w* \w or|strong="H00176"\w* \w a crushed|strong="H04790"\w* \w testicle|strong="H00810"\w*.
\p \v 21 \w No|strong="H03605"\w* \w . . .|strong="H00376"\w* \w descendant|strong="H02233"\w* \w of Aaron|strong="H00175"\w* \w the priest|strong="H03548"\w* \w . . .|strong="H03808"\w* \w who|strong="H00834"\w* \w has a defect|strong="H03971"\w* \w shall approach|strong="H05066"\w* \w to present|strong="H07126"\w* \w -|strong="H00853"\w* \w the food offerings|strong="H00801"\w* \w to the LORD|strong="H03068"\w*. \w [Since] he has a defect|strong="H03971"\w* \w -|strong="H00853"\w*, \w he is not|strong="H03808"\w* \w to come near|strong="H05066"\w* \w to offer|strong="H07126"\w* \w the food|strong="H03899"\w* \w of his God|strong="H00430"\w*. \v 22 \w He may eat|strong="H00398"\w* \w the most|strong="H06944"\w* \w holy|strong="H06944"\w* \w food|strong="H03899"\w* \w of his God|strong="H00430"\w* \w as well as|strong="H04480"\w* \w the holy [food]|strong="H06944"\w*, \v 23 \w but|strong="H00389"\w* \w because|strong="H03588"\w* \w he has a defect|strong="H03971"\w*, \w -|strong="H03808"\w* \w he must not|strong="H03808"\w* \w go|strong="H00935"\w* \w . . .|strong="H00413"\w* \w near|strong="H00413"\w* \w the veil|strong="H06532"\w* \w or approach|strong="H05066"\w* \w the altar|strong="H04196"\w*, \w vvv|strong="H03808"\w* \w so as not to desecrate|strong="H02490"\w* \w -|strong="H00853"\w* \w My sanctuaries|strong="H04720"\w*. \w For|strong="H03588"\w* \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w* \w who sanctifies them|strong="H06942"\w*.’”
\p \v 24 \w Moses|strong="H04872"\w* \w told|strong="H01696"\w* \w this to|strong="H00413"\w* \w Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w* \w . . .|strong="H00413"\w* \w and to|strong="H00413"\w* \w all|strong="H03605"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*.
\c 22
\s1 Restrictions against the Unclean
\p \v 1 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00559"\w*, \v 2 “\w Tell|strong="H01696"\w* \w . . .|strong="H00413"\w* \w Aaron|strong="H00175"\w* \w . . .|strong="H00413"\w* \w and his sons|strong="H01121"\w* \w to treat with respect|strong="H05144"\w* \w the sacred offerings|strong="H06944"\w* \w that the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*\w . . .|strong="H00834"\w* \w -|strong="H01992"\w* \w have consecrated to Me|strong="H06942"\w*, \w so that they do not|strong="H03808"\w* \w profane|strong="H02490"\w* \w -|strong="H00853"\w* \w My holy|strong="H06944"\w* \w name|strong="H08034"\w*. \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w*.
\p \v 3 \w Tell|strong="H00559"\w* \w them [that]|strong="H00413"\w* \w for the generations to come|strong="H01755"\w*, \w if any|strong="H03605"\w* \w -|strong="H00376"\w*\w . . .|strong="H00834"\w* \w -|strong="H03605"\w* \w of [their] descendants|strong="H02233"\w* \w . . .|strong="H00413"\w* \w in a state of uncleanness|strong="H02932"\w* \w . . .|strong="H05921"\w* \w approaches|strong="H07126"\w* \w the sacred offerings|strong="H06944"\w* \w that|strong="H00834"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w consecrate|strong="H06942"\w* \w to the LORD|strong="H03068"\w*, \w that|strong="H01931"\w* \w person|strong="H05315"\w* \w must be cut off|strong="H03772"\w* \w from My presence|strong="H06440"\w*. \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w*.
\p \v 4 \w If a descendant|strong="H02233"\w* \w . . .|strong="H00376"\w* \w . . .|strong="H00376"\w* \w of Aaron|strong="H00175"\w* \w . . .|strong="H01931"\w* \w has a skin disease|strong="H06879"\w*\f + \fr 22:4 \ft Forms of the Hebrew \fqa tzaraath\ft , traditionally translated as \fqa leprosy\ft , were used for various skin diseases; see Leviticus 13.\f* \w or|strong="H00176"\w* \w a discharge|strong="H02100"\w*, \w he may not eat|strong="H00398"\w* \w . . .|strong="H03808"\w* \w the sacred offerings|strong="H06944"\w* \w until|strong="H05704"\w* \w -|strong="H00834"\w* \w he is clean|strong="H02891"\w*. \w Whoever touches|strong="H05060"\w* \w anything|strong="H03605"\w* \w defiled|strong="H02931"\w* \w by a corpse|strong="H05315"\w* \w or|strong="H00176"\w* \w by a man|strong="H00376"\w* \w who|strong="H00834"\w* \w has|strong="H03318"\w*\w . . .|strong="H04480"\w* \w an emission|strong="H07902"\w* \w of semen|strong="H02233"\w*, \v 5 \w or|strong="H00176"\w* \w whoever|strong="H00376"\w* \w -|strong="H00834"\w* \w touches|strong="H05060"\w* \w a|strong="H03605"\w* \w crawling creature|strong="H08318"\w* \w -|strong="H00834"\w* \w -|strong="H02930"\w* \w or|strong="H00176"\w* \w a person|strong="H00120"\w* \w that|strong="H00834"\w* \w makes him unclean|strong="H02930"\w*, \w whatever|strong="H03605"\w* \w the uncleanness may be|strong="H02932"\w* — \v 6 \w the man|strong="H05315"\w* \w who|strong="H00834"\w* \w touches|strong="H05060"\w* any of these \w will remain unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*. \w He must not|strong="H03808"\w* \w eat|strong="H00398"\w* \w from|strong="H04480"\w* \w the sacred offerings|strong="H06944"\w* \w unless|strong="H03588"\w* \w . . .|strong="H00518"\w* \w he has bathed|strong="H07364"\w* \w himself|strong="H01320"\w* \w with water|strong="H04325"\w*.
\p \v 7 \w When the sun|strong="H08121"\w* \w has set|strong="H00935"\w*, \w he will become clean|strong="H02891"\w*, \w and then|strong="H00310"\w* \w he may eat|strong="H00398"\w* \w from|strong="H04480"\w* \w the sacred offerings|strong="H06944"\w*, \w for|strong="H03588"\w* \w they|strong="H01931"\w* \w are his food|strong="H03899"\w*. \v 8 \w He must not|strong="H03808"\w* \w eat|strong="H00398"\w* \w anything found dead|strong="H05038"\w* \w or torn by wild animals|strong="H02966"\w*, \w which would make him unclean|strong="H02930"\w*. \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w*. \v 9 \w [The priests] must keep|strong="H08104"\w* \w -|strong="H00853"\w* \w My charge|strong="H04931"\w*, \w lest|strong="H03808"\w* \w they bear|strong="H05375"\w* \w -|strong="H05921"\w* \w the guilt|strong="H02399"\w* \w and die|strong="H04191"\w* \w because|strong="H03588"\w* \w they profane it|strong="H02490"\w*. \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w* \w who sanctifies them|strong="H06942"\w*.
\p \v 10 \w No|strong="H03808"\w* \w one|strong="H03605"\w* \w outside [a priest’s family]|strong="H02114"\w* \w may eat|strong="H00398"\w* \w the sacred offering|strong="H06944"\w*, \w nor|strong="H03808"\w* \w may the guest|strong="H08453"\w* \w of a priest|strong="H03548"\w* \w or his hired hand|strong="H07916"\w* \w eat|strong="H00398"\w* \w [it]|strong="H06944"\w*. \v 11 \w But if|strong="H03588"\w* \w a priest|strong="H03548"\w* \w buys|strong="H07069"\w* \w a slave|strong="H05315"\w* \w with|strong="H07075"\w* \w his own money|strong="H03701"\w*, \w or if [a slave]|strong="H01992"\w* \w is born|strong="H03211"\w* \w in his household|strong="H01004"\w*, \w that [slave]|strong="H01931"\w* \w may eat|strong="H00398"\w* \w -|strong="H00398"\w* \w his food|strong="H03899"\w*.
