\p \v 48 \w If, however|strong="H00518"\w*, \w the priest|strong="H03548"\w* \w comes|strong="H00935"\w* \w . . .|strong="H00935"\w* \w and inspects it|strong="H07200"\w*, \w and|strong="H02009"\w* \w the mildew|strong="H05061"\w* \w has not|strong="H03808"\w* \w spread|strong="H06581"\w* \w -|strong="H01004"\w* \w after|strong="H00310"\w* \w the house|strong="H01004"\w* \w has been replastered|strong="H02902"\w*, \w -|strong="H00853"\w* \w he|strong="H03548"\w* \w -|strong="H00853"\w* \w shall pronounce the house|strong="H01004"\w* \w clean|strong="H02891"\w*, \w because|strong="H03588"\w* \w the mildew|strong="H05061"\w* \w is gone|strong="H07495"\w*.
