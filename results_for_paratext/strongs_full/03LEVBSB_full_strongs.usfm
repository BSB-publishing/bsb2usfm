\p \v 5 \w For this reason|strong="H04616"\w* \w -|strong="H00834"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w -|strong="H00853"\w* \w will bring|strong="H00935"\w* \w to the LORD|strong="H03068"\w* \w the sacrifices|strong="H02077"\w* \w -|strong="H00834"\w* \w they|strong="H01992"\w* \w have been offering|strong="H02076"\w* \w in|strong="H05921"\w* \w the open|strong="H06440"\w* \w fields|strong="H07704"\w*. \w They are to bring them|strong="H00935"\w* \w to|strong="H00413"\w* \w the priest|strong="H03548"\w* \w at|strong="H00413"\w* \w the entrance|strong="H06607"\w* \w to the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w* \w and offer|strong="H02076"\w* \w them|strong="H00853"\w* \w as sacrifices|strong="H02077"\w* \w of peace offerings|strong="H08002"\w* \w to the LORD|strong="H03068"\w*. \v 6 \w The priest|strong="H03548"\w* \w -|strong="H00853"\w* \w will then splatter|strong="H02236"\w* \w the blood|strong="H01818"\w* \w on|strong="H05921"\w* \w the altar|strong="H04196"\w* \w of the LORD|strong="H03068"\w* \w at the entrance|strong="H06607"\w* \w to the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w* \w and burn|strong="H06999"\w* \w the fat|strong="H02459"\w* \w as a pleasing|strong="H05207"\w* \w aroma|strong="H07381"\w* \w to the LORD|strong="H03068"\w*.
