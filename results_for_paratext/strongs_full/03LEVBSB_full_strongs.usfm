\s1 Sins Requiring a Guilt Offering
\r (Leviticus 5:14–19; Leviticus 7:1–10)
\p \v 1 \w And the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00559"\w*, \v 2 “\w If|strong="H03588"\w* \w someone|strong="H05315"\w* \w sins|strong="H02398"\w* \w and acts|strong="H04603"\w* \w unfaithfully|strong="H04604"\w* \w against the LORD|strong="H03068"\w* \w by deceiving|strong="H03584"\w* \w his neighbor|strong="H05997"\w* \w in regard to a deposit|strong="H06487"\w* \w or security|strong="H08667"\w* \w entrusted to him|strong="H03027"\w* \w or|strong="H00176"\w* \w stolen|strong="H01498"\w*, \w . . .|strong="H00176"\w* \w or|strong="H00176"\w* \w if he extorts|strong="H06231"\w* \w -|strong="H00853"\w* \w his neighbor|strong="H05997"\w* \v 3 \w or|strong="H00176"\w* \w finds|strong="H04672"\w* \w lost property|strong="H00009"\w* \w and lies|strong="H03584"\w* about it \w and swears|strong="H07650"\w* \w -|strong="H05921"\w* \w falsely|strong="H08267"\w* \w -|strong="H05921"\w*, \w or if he commits any such sin|strong="H02398"\w* \w . . .|strong="H00259"\w* \w . . .|strong="H03605"\w* \w that|strong="H00834"\w* . . . \w a man|strong="H00120"\w* \w might commit|strong="H06213"\w*— \v 4 \w -|strong="H01961"\w* \w once|strong="H03588"\w* \w he has sinned|strong="H02398"\w* \w and becomes guilty|strong="H00816"\w*, \w he must return|strong="H07725"\w* \w -|strong="H00853"\w* \w what|strong="H00834"\w* \w . . .|strong="H01497"\w* \w he has stolen|strong="H01500"\w* \w or|strong="H00176"\w* \w -|strong="H00853"\w* \w -|strong="H06233"\w* \w -|strong="H00834"\w* \w taken by extortion|strong="H06231"\w*, \w or|strong="H00176"\w* \w -|strong="H00853"\w* \w the deposit|strong="H06487"\w* \w -|strong="H00834"\w* \w entrusted|strong="H06485"\w* \w to him|strong="H00854"\w*, \w or|strong="H00176"\w* \w -|strong="H00853"\w* \w the lost property|strong="H00009"\w* \w -|strong="H00834"\w* \w he found|strong="H04672"\w*, \v 5 \w or|strong="H00176"\w* \w anything else|strong="H03605"\w* \w about|strong="H05921"\w* \w which|strong="H00834"\w* \w he has sworn|strong="H07650"\w* \w falsely|strong="H08267"\w*.
\p \w He must make|strong="H07218"\w* \w restitution in full|strong="H07999"\w* \w -|strong="H00853"\w*, \w add|strong="H03254"\w* \w a fifth|strong="H02549"\w* \w of the value|strong="H05921"\w*, \w and pay it|strong="H05414"\w* \w to the owner|strong="H00834"\w* \w . . .|strong="H01931"\w* . . . \w on the day|strong="H03117"\w* \w [he acknowledges] his guilt|strong="H00819"\w*. \v 6 \w -|strong="H00853"\w* \w Then he must bring|strong="H00935"\w* \w to|strong="H00413"\w* \w the priest|strong="H03548"\w* \w his guilt offering|strong="H00817"\w* \w to the LORD|strong="H03068"\w*: \w an unblemished|strong="H08549"\w* \w ram|strong="H00352"\w* \w of proper value|strong="H06187"\w* \w from|strong="H04480"\w* \w the flock|strong="H06629"\w* \w -|strong="H00817"\w*. \v 7 \w In this way the priest|strong="H03548"\w* \w will make atonement|strong="H03722"\w* \w for him|strong="H05921"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*, \w and he will be forgiven|strong="H05545"\w* \w for|strong="H05921"\w* \w anything|strong="H00259"\w* \w . . .|strong="H03605"\w* \w -|strong="H00834"\w* \w he may have done|strong="H06213"\w* \w to incur guilt|strong="H00819"\w*.”
\s1 The Burnt Offering
\r (Leviticus 1:1–17)
\p \v 8 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00559"\w*, \v 9 “\w Command|strong="H06680"\w* \w -|strong="H00853"\w* \w Aaron|strong="H00175"\w* \w -|strong="H00853"\w* \w and his sons|strong="H01121"\w* \w . . .|strong="H00559"\w* \w [that] this|strong="H02063"\w* \w is the law|strong="H08451"\w* \w of the burnt offering|strong="H05930"\w*: \w The burnt offering|strong="H05930"\w* \w . . .|strong="H01931"\w* \w is to remain|strong="H05921"\w* \w on|strong="H05921"\w* \w the hearth|strong="H04169"\w* \w of the altar|strong="H04196"\w* \w all|strong="H03605"\w* \w night|strong="H03915"\w*, \w until|strong="H05704"\w* \w morning|strong="H01242"\w*, \w and the fire|strong="H00784"\w* \w must be kept burning|strong="H03344"\w* \w on the altar|strong="H04196"\w*.
\p \v 10 \w And the priest|strong="H03548"\w* \w shall put on|strong="H03847"\w* \w his linen|strong="H00906"\w* \w robe|strong="H04055"\w* \w and linen|strong="H00906"\w* \w . . .|strong="H03847"\w* \w undergarments|strong="H04370"\w* \w . . .|strong="H05921"\w* \w . . .|strong="H01320"\w*, \w and he shall remove|strong="H07311"\w* \w -|strong="H00853"\w* \w from the altar|strong="H04196"\w* \w the ashes|strong="H01880"\w* \w -|strong="H00834"\w* \w of the burnt offering|strong="H05930"\w* \w . . .|strong="H05921"\w* \w that the fire|strong="H00784"\w* \w -|strong="H00853"\w* \w has consumed|strong="H00398"\w* \w and place them|strong="H07760"\w* \w beside|strong="H00681"\w* \w [it]|strong="H04196"\w*. \v 11 \w Then he must take off|strong="H06584"\w* \w -|strong="H00853"\w* \w his garments|strong="H00899"\w*, \w put on|strong="H03847"\w* \w other|strong="H00312"\w* \w clothes|strong="H00899"\w*, \w and carry|strong="H03318"\w* \w -|strong="H00853"\w* \w the ashes|strong="H01880"\w* \w outside|strong="H02351"\w* \w the camp|strong="H04264"\w* \w . . .|strong="H00413"\w* \w to|strong="H00413"\w* \w a ceremonially clean|strong="H02889"\w* \w place|strong="H04725"\w*.
\p \v 12 \w The fire|strong="H00784"\w* \w on|strong="H05921"\w* \w the altar|strong="H04196"\w* \w shall be kept burning|strong="H03344"\w*; \w it must not|strong="H03808"\w* \w be extinguished|strong="H03518"\w*. \w Every morning|strong="H01242"\w* \w . . .|strong="H01242"\w* \w the priest|strong="H03548"\w* \w is to add|strong="H01197"\w* \w wood|strong="H06086"\w* \w to the fire|strong="H05921"\w*, \w arrange|strong="H06186"\w* \w the burnt offering|strong="H05930"\w* \w on it|strong="H05921"\w*, \w and burn|strong="H06999"\w* \w the fat portions|strong="H02459"\w* \w of the peace offerings|strong="H08002"\w* \w on it|strong="H05921"\w*. \v 13 \w The fire|strong="H00784"\w* \w shall be kept burning|strong="H03344"\w* \w on|strong="H05921"\w* \w the altar|strong="H04196"\w* \w continually|strong="H08548"\w*; \w it must not|strong="H03808"\w* \w be extinguished|strong="H03518"\w*.
\s1 The Grain Offering
\r (Leviticus 2:1–16)
\p \v 14 \w Now this|strong="H02063"\w* \w is the law|strong="H08451"\w* \w of the grain offering|strong="H04503"\w*: \w Aaron’s|strong="H00175"\w* \w sons|strong="H01121"\w* \w shall present|strong="H07126"\w* \w it|strong="H00853"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w in|strong="H00413"\w* \w front|strong="H06440"\w* \w of the altar|strong="H04196"\w*. \v 15 \w The priest is to remove|strong="H07311"\w* \w a handful|strong="H07062"\w* \w of|strong="H04480"\w* \w fine flour|strong="H05560"\w* \w -|strong="H04503"\w* \w and olive oil|strong="H08081"\w* \w -|strong="H00853"\w*, \w together with all|strong="H03605"\w* \w the frankincense|strong="H03828"\w*\w . . .|strong="H00834"\w*\w . . .|strong="H05921"\w* \w from the grain offering|strong="H04503"\w*, \w and burn|strong="H06999"\w* \w the memorial portion|strong="H00234"\w* \w on the altar|strong="H04196"\w* \w as a pleasing|strong="H05207"\w* \w aroma|strong="H07381"\w* \w to the LORD|strong="H03068"\w*.
\p \v 16 \w Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w* \w are to eat|strong="H00398"\w* \w the remainder|strong="H03498"\w*\w . . .|strong="H04480"\w*. \w It must be eaten|strong="H00398"\w* \w without leaven|strong="H04682"\w* \w in a holy|strong="H06918"\w* \w place|strong="H04725"\w*; \w they are to eat it|strong="H00398"\w* \w in the courtyard|strong="H02691"\w* \w of the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*. \v 17 \w It must not|strong="H03808"\w* \w be baked|strong="H00644"\w* \w with leaven|strong="H02557"\w*; \w I have assigned|strong="H05414"\w* \w -|strong="H00853"\w* \w it as their portion|strong="H02506"\w* \w of My food offerings|strong="H00801"\w*. \w It [is]|strong="H01931"\w* \w most|strong="H06944"\w* \w holy|strong="H06944"\w*, \w like the sin offering|strong="H02403"\w* \w and the guilt offering|strong="H00817"\w*. \v 18 \w Any|strong="H03605"\w* \w male|strong="H02145"\w* \w among the sons|strong="H01121"\w* \w of Aaron|strong="H00175"\w* \w may eat it|strong="H00398"\w*. \w This is a permanent|strong="H05769"\w* \w portion|strong="H02706"\w* \w from the food offerings|strong="H00801"\w* \w to the LORD|strong="H03068"\w* \w for the generations to come|strong="H01755"\w*. \w Anything|strong="H03605"\w* \w that|strong="H00834"\w* \w touches|strong="H05060"\w* them \w will become holy|strong="H06942"\w*.”
\p \v 19 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00559"\w*, \v 20 “\w This|strong="H02088"\w* \w is the offering|strong="H07133"\w* \w that Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w* \w -|strong="H00834"\w* \w must present|strong="H07126"\w* \w to the LORD|strong="H03068"\w* \w on the day|strong="H03117"\w* \w he is anointed|strong="H04886"\w*: \w -|strong="H00853"\w* \w a tenth|strong="H06224"\w* \w of an ephah|strong="H00374"\w* \w of fine flour|strong="H05560"\w*\f + \fr 6:20 \fqa A tenth of an ephah \ft is approximately 2 dry quarts or 2.2 liters (probably about 2.6 pounds or 1.2 kilograms of flour).\f* \w as a regular|strong="H08548"\w* \w grain offering|strong="H04503"\w*, \w half|strong="H04276"\w* \w of it in the morning|strong="H01242"\w* \w and half|strong="H04276"\w* \w in the evening|strong="H06153"\w*. \v 21 \w It shall be prepared|strong="H06213"\w* \w with oil|strong="H08081"\w* \w on|strong="H05921"\w* \w a griddle|strong="H04227"\w*;\f + \fr 6:21 \ft That is, a shallow pan for baking or frying\f* \w you are to bring it|strong="H00935"\w* \w well-kneaded|strong="H07246"\w* \w and present it|strong="H07126"\w* \w as a grain offering|strong="H04503"\w* \w broken|strong="H08601"\w*\f + \fr 6:21 \ft Or \fqa baked\f* \w in pieces|strong="H06595"\w*, \w a pleasing|strong="H05207"\w* \w aroma|strong="H07381"\w* \w to the LORD|strong="H03068"\w*. \v 22 \w The priest|strong="H03548"\w*, \w who is one of Aaron’s sons|strong="H01121"\w* \w and will be anointed|strong="H04899"\w* \w to take his place|strong="H08478"\w*, \w is to prepare it|strong="H06213"\w*. \w -|strong="H00853"\w* \w As a permanent|strong="H05769"\w* \w portion|strong="H02706"\w* \w for the LORD|strong="H03068"\w*, \w it must be burned|strong="H06999"\w* \w completely|strong="H03632"\w*. \v 23 \w Every|strong="H03605"\w* \w grain offering|strong="H04503"\w* \w for a priest|strong="H03548"\w* \w shall be burned|strong="H01961"\w* \w completely|strong="H03632"\w*; \w it is not|strong="H03808"\w* \w to be eaten|strong="H00398"\w*.”
\s1 The Sin Offering
\r (Leviticus 4:1–35; Leviticus 5:1–13)
\p \v 24 \w And the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00559"\w*, \v 25 “\w Tell|strong="H01696"\w* \w . . .|strong="H00413"\w* \w Aaron|strong="H00175"\w* \w . . .|strong="H00413"\w* \w and his sons|strong="H01121"\w* \w . . .|strong="H00559"\w* \w [that] this|strong="H02063"\w* \w is the law|strong="H08451"\w* \w of the sin offering|strong="H02403"\w*: \w In the place|strong="H04725"\w* \w where|strong="H00834"\w* \w the burnt offering|strong="H05930"\w* \w is slaughtered|strong="H07819"\w*, \w the sin offering|strong="H02403"\w* \w shall be slaughtered|strong="H07819"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*; \w it [is] most|strong="H06944"\w* \w holy|strong="H06944"\w* \w . . .|strong="H01931"\w*. \v 26 \w The priest|strong="H03548"\w* \w who offers|strong="H02398"\w* \w it|strong="H00853"\w* \w shall eat it|strong="H00398"\w*; \w it must be eaten|strong="H00398"\w* \w in a holy|strong="H06918"\w* \w place|strong="H04725"\w*, \w in the courtyard|strong="H02691"\w* \w of the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*. \v 27 \w Anything|strong="H03605"\w* \w that|strong="H00834"\w* \w touches|strong="H05060"\w* \w its flesh|strong="H01320"\w* \w will become holy|strong="H06942"\w*, \w and if|strong="H00834"\w* \w any of the blood|strong="H01818"\w* \w is spattered|strong="H05137"\w* \w on|strong="H05921"\w* \w a garment|strong="H00899"\w*, \w you must wash|strong="H03526"\w* \w it|strong="H00834"\w* \w . . .|strong="H05137"\w* \w . . .|strong="H05921"\w* \w in a holy|strong="H06918"\w* \w place|strong="H04725"\w*.
\p \v 28 \w The clay|strong="H02789"\w* \w pot|strong="H03627"\w* \w in which|strong="H00834"\w* \w [the sin offering] is boiled|strong="H01310"\w* \w must be broken|strong="H07665"\w*; \w if|strong="H00518"\w* \w it is boiled|strong="H01310"\w* \w in a bronze|strong="H05178"\w* \w pot|strong="H03627"\w*, \w [the pot] must be scoured|strong="H04838"\w* \w and rinsed|strong="H07857"\w* \w with water|strong="H04325"\w*. \v 29 \w Any|strong="H03605"\w* \w male|strong="H02145"\w* \w among the priests|strong="H03548"\w* \w may eat it|strong="H00398"\w*; \w -|strong="H00853"\w* \w it [is]|strong="H01931"\w* \w most|strong="H06944"\w* \w holy|strong="H06944"\w*. \v 30 \w -|strong="H03605"\w* \w But no|strong="H03808"\w* \w sin offering|strong="H02403"\w* \w -|strong="H00834"\w* \w may be eaten|strong="H00398"\w* \w if its blood|strong="H01818"\w* \w has been brought|strong="H00935"\w* \w into|strong="H00413"\w* \w the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w* \w to make atonement|strong="H03722"\w* \w in the Holy Place|strong="H06944"\w*; \w . . .|strong="H00784"\w* \w it must be burned|strong="H08313"\w*.[’’]
\c 7
\s1 The Guilt Offering
\r (Leviticus 5:14–19; Leviticus 6:1–7)
\p \v 1 “\w Now this|strong="H02063"\w* \w is the law|strong="H08451"\w* \w of the guilt offering|strong="H00817"\w*, \w which [is]|strong="H01931"\w* \w most|strong="H06944"\w* \w holy|strong="H06944"\w*: \v 2 \w The guilt offering|strong="H00817"\w* \w -|strong="H00853"\w* \w must be slaughtered|strong="H07819"\w* \w -|strong="H00853"\w* \w in the place|strong="H04725"\w* \w where|strong="H00834"\w* \w the burnt offering|strong="H05930"\w* \w is slaughtered|strong="H07819"\w*, \w -|strong="H00853"\w* \w and [the priest] shall splatter|strong="H02236"\w* \w its blood|strong="H01818"\w* \w on all sides|strong="H05439"\w* \w of|strong="H05921"\w* \w the altar|strong="H04196"\w*. \v 3 \w And|strong="H00853"\w* \w all|strong="H03605"\w* \w the fat|strong="H02459"\w* \w from|strong="H04480"\w* \w it|strong="H00853"\w* \w shall be offered|strong="H07126"\w*: \w the fat tail|strong="H00451"\w*, \w -|strong="H00853"\w* \w the fat|strong="H02459"\w* \w that covers|strong="H03680"\w* \w -|strong="H00853"\w* \w the entrails|strong="H07130"\w*, \v 4 \w -|strong="H00853"\w* \w both|strong="H08147"\w* \w kidneys|strong="H03629"\w* \w -|strong="H00853"\w* \w with the fat|strong="H02459"\w* \w -|strong="H00834"\w* \w on them|strong="H05921"\w* \w -|strong="H00834"\w* \w near|strong="H05921"\w* \w the loins|strong="H03689"\w*, \w -|strong="H00853"\w* \w and the lobe|strong="H03508"\w* \w of|strong="H05921"\w* \w the liver|strong="H03516"\w*, \w which is to be removed|strong="H05493"\w* \w with|strong="H05921"\w* \w the kidneys|strong="H03629"\w*. \v 5 \w The priest|strong="H03548"\w* \w shall burn|strong="H06999"\w* \w them|strong="H00853"\w* \w on the altar|strong="H04196"\w* \w as a food offering|strong="H00801"\w* \w to the LORD|strong="H03068"\w*; \w it|strong="H01931"\w* \w is a guilt offering|strong="H00817"\w*. \v 6 \w Every|strong="H03605"\w* \w male|strong="H02145"\w* \w among the priests|strong="H03548"\w* \w may eat of it|strong="H00398"\w*. \w It must be eaten|strong="H00398"\w* \w in a holy|strong="H06918"\w* \w place|strong="H04725"\w*; \w it [is]|strong="H01931"\w* \w most|strong="H06944"\w* \w holy|strong="H06944"\w*.
\p \v 7 \w The guilt offering|strong="H00817"\w* \w is like the sin offering|strong="H02403"\w*; \w the same|strong="H00259"\w* \w law|strong="H08451"\w* applies to both. \w It belongs to|strong="H01961"\w* \w the priest|strong="H03548"\w* \w who|strong="H00834"\w* \w makes atonement|strong="H03722"\w* with it. \v 8 \w As for the priest|strong="H03548"\w* \w who presents|strong="H07126"\w* \w -|strong="H00853"\w* \w a burnt offering|strong="H05930"\w* \w for anyone|strong="H00376"\w*, \w the hide|strong="H05785"\w* \w of [that] offering|strong="H05930"\w* \w -|strong="H00834"\w* \w -|strong="H07126"\w* \w . . .|strong="H03548"\w* belongs to him \w . . .|strong="H01961"\w*. \v 9 \w Likewise , every|strong="H03605"\w* \w grain offering|strong="H04503"\w* \w that|strong="H00834"\w* \w is baked|strong="H00644"\w* \w in an oven|strong="H08574"\w* \w . . .|strong="H03605"\w* \w or cooked|strong="H06213"\w* \w in a pan|strong="H04802"\w*\f + \fr 7:9 \ft That is, a deep pan or stew pan\f* \w or on|strong="H05921"\w* \w a griddle|strong="H04227"\w*\f + \fr 7:9 \ft That is, a shallow pan for baking or frying\f* \w belongs|strong="H01961"\w* to \w the priest|strong="H03548"\w* \w who presents|strong="H07126"\w* \w it|strong="H00853"\w*, \v 10 \w and every|strong="H03605"\w* \w grain offering|strong="H04503"\w*, \w whether dry|strong="H02720"\w* \w or mixed|strong="H01101"\w* \w with oil|strong="H08081"\w*, \w belongs equally|strong="H00376"\w* \w . . .|strong="H00251"\w* \w to|strong="H01961"\w* \w all|strong="H03605"\w* \w the sons|strong="H01121"\w* \w of Aaron|strong="H00175"\w*.
\s1 The Peace Offering
\r (Leviticus 3:1–17)
\p \v 11 \w Now this|strong="H02063"\w* \w is the law|strong="H08451"\w* \w vvv|strong="H02077"\w* \w of the peace offering|strong="H08002"\w* \w that|strong="H00834"\w* \w one may present|strong="H07126"\w* \w to the LORD|strong="H03068"\w*: \v 12 \w If|strong="H00518"\w* \w he offers it|strong="H07126"\w* \w in|strong="H05921"\w* \w thanksgiving|strong="H08426"\w*, \w then along with|strong="H05921"\w* \w the sacrifice|strong="H02077"\w* \w of thanksgiving|strong="H08426"\w* \w he shall offer|strong="H07126"\w* \w unleavened|strong="H04682"\w* \w cakes|strong="H02471"\w* \w mixed|strong="H01101"\w* \w with olive oil|strong="H08081"\w*, \w unleavened|strong="H04682"\w* \w wafers|strong="H07550"\w* \w coated|strong="H04886"\w* \w with oil|strong="H08081"\w*, \w and well-kneaded|strong="H07246"\w* \w cakes|strong="H02471"\w* \w of fine flour|strong="H05560"\w* \w mixed|strong="H01101"\w* \w with oil|strong="H08081"\w*.
