\p \v 32 \w As for the cities|strong="H05892"\w* \w of the Levites|strong="H03881"\w*, \w the Levites|strong="H03881"\w* \w always|strong="H05769"\w* \w have|strong="H01961"\w* \w the right to redeem|strong="H01353"\w* \w their houses|strong="H01004"\w* \w in the cities|strong="H05892"\w* \w they possess|strong="H00272"\w*. \v 33 \w So whatever|strong="H00834"\w* \w belongs to|strong="H04480"\w* \w the Levites|strong="H03881"\w* \w may be redeemed|strong="H01350"\w*— \w a house|strong="H01004"\w* \w sold|strong="H04465"\w* \w in a city|strong="H05892"\w* \w they possess|strong="H00272"\w*— \w and must be released|strong="H03318"\w* \w in the Jubilee|strong="H03104"\w*, \w because|strong="H03588"\w* \w the houses|strong="H01004"\w* \w . . .|strong="H01931"\w* \w in the cities|strong="H05892"\w* \w of the Levites|strong="H03881"\w* \w are their possession|strong="H00272"\w* \w among|strong="H08432"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*. \v 34 \w But the open|strong="H07704"\w* \w pastureland|strong="H04054"\w* \w around their cities|strong="H05892"\w* \w may not|strong="H03808"\w* \w be sold|strong="H04376"\w*, \w for|strong="H03588"\w* \w this|strong="H01931"\w* is their \w permanent|strong="H05769"\w* \w possession|strong="H00272"\w*.
\s1 Redemption of the Poor
\p \v 35 \w Now if|strong="H03588"\w* \w your countryman|strong="H00251"\w* \w becomes destitute|strong="H04134"\w* \w and cannot support himself|strong="H04131"\w* \w . . .|strong="H03027"\w* \w among you|strong="H05973"\w*, \w then you are to help|strong="H02388"\w* him \w {as you would} a foreigner|strong="H01616"\w* \w or stranger|strong="H08453"\w*, \w so that he can continue to live|strong="H02421"\w* \w among you|strong="H05973"\w*. \v 36 \w Do not|strong="H00408"\w* \w take|strong="H03947"\w* \w any interest|strong="H05392"\w* \w or profit|strong="H08636"\w* \w from him|strong="H00854"\w*, \w but fear|strong="H03372"\w* \w your God|strong="H00430"\w*, \w that your countryman|strong="H00251"\w* \w may live|strong="H02421"\w* \w among you|strong="H05973"\w*. \v 37 \w You must not|strong="H03808"\w* \w lend|strong="H05414"\w* \w him|strong="H00853"\w* \w your silver|strong="H03701"\w* - \w at interest|strong="H05392"\w* \w or|strong="H03808"\w* \w sell him|strong="H05414"\w* \w your food|strong="H00400"\w* \w for profit|strong="H04768"\w*. \v 38 \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*, \w who|strong="H00834"\w* \w brought you|strong="H03318"\w* \w -|strong="H00853"\w* \w out of the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w* \w to give|strong="H05414"\w* you \w -|strong="H00853"\w* \w the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w* \w and to be|strong="H01961"\w* your \w God|strong="H00430"\w*.
\s1 Redemption of Bondmen
\p \v 39 \w If|strong="H03588"\w* \w a countryman|strong="H00251"\w* \w among you|strong="H05973"\w* \w becomes destitute|strong="H04134"\w* \w and sells himself|strong="H04376"\w* to you, \w then you must not|strong="H03808"\w* \w force him|strong="H05647"\w* into \w slave|strong="H05650"\w* \w labor|strong="H05656"\w*. \v 40 \w Let him stay|strong="H01961"\w* \w with you|strong="H05973"\w* \w as a hired worker|strong="H07916"\w* \w or temporary resident|strong="H08453"\w*; \w he is to work|strong="H05647"\w* \w for|strong="H05973"\w* \w you until|strong="H05704"\w* \w the Year|strong="H08141"\w* \w of Jubilee|strong="H03104"\w*. \v 41 \w Then he|strong="H01931"\w* \w and his children|strong="H01121"\w* \w . . .|strong="H05973"\w* \w are to be released|strong="H03318"\w* \w -|strong="H05973"\w*, \w and he may return|strong="H07725"\w* \w to|strong="H00413"\w* \w his clan|strong="H04940"\w* \w and to|strong="H00413"\w* \w . . .|strong="H07725"\w* \w the property|strong="H00272"\w* \w of his fathers|strong="H00001"\w*.
\p \v 42 \w Because|strong="H03588"\w* \w [the Israelites are]|strong="H01992"\w* \w My servants|strong="H05650"\w*, \w whom|strong="H00834"\w* \w I brought|strong="H03318"\w* \w -|strong="H00853"\w* \w out of the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w*, \w they are not|strong="H03808"\w* \w to be sold|strong="H04376"\w* \w . . .|strong="H04466"\w* \w as slaves|strong="H05650"\w*. \v 43 \w You are not|strong="H03808"\w* \w to rule|strong="H07287"\w* over them \w harshly|strong="H06531"\w*, \w but you shall fear|strong="H03372"\w* \w your God|strong="H00430"\w*.
\p \v 44 \w Your menservants|strong="H05650"\w* \w and maidservants|strong="H00519"\w* \w -|strong="H00834"\w* \w shall come|strong="H01961"\w* \w from|strong="H00854"\w* \w the nations|strong="H01471"\w* \w -|strong="H00834"\w* \w around you|strong="H05439"\w*, from [whom] \w you may purchase|strong="H07069"\w* \w [them]|strong="H05650"\w* \w . . .|strong="H00519"\w*. \v 45 \w You may also|strong="H01571"\w* \w purchase them|strong="H07069"\w* \w from the|strong="H01121"\w* \w foreigners|strong="H08453"\w* \w residing|strong="H01481"\w* \w among you|strong="H05973"\w* vvv \w or their clans|strong="H04940"\w* \w living among you|strong="H05973"\w* \w who|strong="H00834"\w* \w -|strong="H00834"\w* \w are born|strong="H03205"\w* \w in your land|strong="H00776"\w*. \w These may become|strong="H01961"\w* your \w property|strong="H00272"\w*. \v 46 \w You may leave|strong="H05157"\w* \w them|strong="H00853"\w* \w to your sons|strong="H01121"\w* \w after|strong="H00310"\w* \w you to inherit|strong="H03423"\w* \w as property|strong="H00272"\w*; \w you can make them slaves|strong="H05647"\w* \w for life|strong="H05769"\w*. \w But as for your brothers|strong="H00251"\w*, \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*, \w no|strong="H03808"\w* \w man|strong="H00376"\w* \w may rule|strong="H07287"\w* \w harshly|strong="H06531"\w* \w over his brother|strong="H00251"\w*.
\s1 Redemption of Servants
\p \v 47 \w If|strong="H03588"\w* \w a foreigner|strong="H01616"\w* \w residing|strong="H08453"\w* \w among you|strong="H05973"\w* \w prospers|strong="H05381"\w* \w . . .|strong="H03027"\w*, \w but your countryman|strong="H00251"\w* \w dwelling near him|strong="H05973"\w* \w becomes destitute|strong="H04134"\w* \w and sells himself|strong="H04376"\w* \w to the foreigner|strong="H01616"\w* \w -|strong="H08453"\w* \w -|strong="H05973"\w* \w or|strong="H00176"\w* \w to a member|strong="H06133"\w* \w of [his]|strong="H01616"\w* \w clan|strong="H04940"\w*, \v 48 \w he retains|strong="H01961"\w* \w the right of redemption|strong="H01353"\w* \w after|strong="H00310"\w* \w he has sold himself|strong="H04376"\w*. \w One|strong="H00259"\w* \w of his brothers|strong="H00251"\w* \w may redeem him|strong="H01350"\w*: \v 49 \w either|strong="H00176"\w* \w his uncle|strong="H01730"\w* \w or|strong="H00176"\w* \w cousin|strong="H01121"\w* \w . . .|strong="H01730"\w* \w -|strong="H01350"\w* \w or|strong="H00176"\w* \w any close relative|strong="H07607"\w* \w . . .|strong="H01320"\w* \w from his clan|strong="H04940"\w* \w may redeem him|strong="H01350"\w*. \w Or if|strong="H00176"\w* \w he prospers|strong="H05381"\w* \w . . .|strong="H03027"\w*, \w he may redeem himself|strong="H01350"\w*.
\p \v 50 \w He and|strong="H05973"\w* \w his purchaser|strong="H07069"\w* \w will then count the time|strong="H02803"\w* \w from the year|strong="H08141"\w* \w he sold|strong="H04376"\w* himself \w up to|strong="H05704"\w* \w the Year|strong="H08141"\w* \w of Jubilee|strong="H03104"\w*. \w The price|strong="H03701"\w* \w of his sale|strong="H04465"\w* \w will be|strong="H01961"\w* \w determined by the number|strong="H04557"\w* \w of years|strong="H08141"\w*, \w based on|strong="H01961"\w* \w -|strong="H05973"\w* \w the daily|strong="H03117"\w* \w wages of a hired hand|strong="H07916"\w*. \v 51 \w If|strong="H00518"\w* \w many|strong="H07227"\w* \w years|strong="H08141"\w* \w remain|strong="H05750"\w*, \w he must pay|strong="H07725"\w* \w for his redemption|strong="H01353"\w* \w in proportion to|strong="H06310"\w* \w his purchase|strong="H04736"\w* \w price|strong="H03701"\w*. \v 52 \w If|strong="H00518"\w* \w only a few|strong="H04592"\w* \w years|strong="H08141"\w* \w remain|strong="H07604"\w* \w until|strong="H05704"\w* \w the Year|strong="H08141"\w* \w of Jubilee|strong="H03104"\w*, \w he is to calculate|strong="H02803"\w* . . . \w and pay|strong="H07725"\w* \w -|strong="H00853"\w* \w his redemption|strong="H01353"\w* \w according to|strong="H06310"\w* \w his remaining years|strong="H08141"\w*. \v 53 \w He shall be treated|strong="H01961"\w* \w . . .|strong="H05973"\w* \w like a man hired|strong="H07916"\w* \w from year|strong="H08141"\w* \w to year|strong="H08141"\w*, \w but [a foreign owner] must not|strong="H03808"\w* \w rule over him|strong="H07287"\w* \w harshly|strong="H06531"\w* \w in your sight|strong="H05869"\w*.
\p \v 54 \w Even if|strong="H00518"\w* \w he is not|strong="H03808"\w* \w redeemed|strong="H01350"\w* \w in any of these ways|strong="H00428"\w*, \w he|strong="H01931"\w* \w and his children|strong="H01121"\w* \w . . .|strong="H05973"\w* \w shall be released|strong="H03318"\w* \w in the Year|strong="H08141"\w* \w of Jubilee|strong="H03104"\w*. \v 55 \w For|strong="H03588"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* are My \w servants|strong="H05650"\w*. \w They|strong="H01992"\w* \w are My servants|strong="H05650"\w*, \w whom|strong="H00834"\w* \w I brought|strong="H03318"\w* \w -|strong="H00853"\w* \w out of the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w*. \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*.[’’]
\c 26
\s1 Additional Blessings of Obedience
\p \v 1 “\w You must not|strong="H03808"\w* \w make|strong="H06213"\w* \w idols|strong="H00457"\w* for yourselves \w or set up|strong="H06965"\w* \w a carved image|strong="H06459"\w* \w or sacred pillar|strong="H04676"\w*; \w you must not|strong="H03808"\w* \w place|strong="H05414"\w* \w a sculpted|strong="H04906"\w* \w . . .|strong="H03808"\w* \w stone|strong="H00068"\w* \w in your land|strong="H00776"\w* \w to bow down|strong="H07812"\w* \w to it|strong="H05921"\w*. \w For|strong="H03588"\w* \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*.
\p \v 2 \w -|strong="H00853"\w* \w You must keep|strong="H08104"\w* \w My Sabbaths|strong="H07676"\w* \w and have reverence for|strong="H03372"\w* \w My sanctuary|strong="H04720"\w*. \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w*.
\p \v 3 \w If|strong="H00518"\w* \w you follow|strong="H01980"\w* \w -|strong="H00853"\w* \w My statutes|strong="H02708"\w* \w and carefully keep|strong="H08104"\w* \w . . .|strong="H06213"\w* \w -|strong="H00853"\w* \w My commandments|strong="H04687"\w*, \v 4 \w I will give|strong="H05414"\w* \w you rains|strong="H01653"\w* \w in their season|strong="H06256"\w*, \w and the land|strong="H00776"\w* \w will yield|strong="H05414"\w* \w its produce|strong="H02981"\w*, \w and the trees|strong="H06086"\w* \w of the field|strong="H07704"\w* \w will bear|strong="H05414"\w* \w their fruit|strong="H06529"\w*. \v 5 Your \w threshing|strong="H01786"\w* \w -|strong="H00853"\w* \w will continue|strong="H05381"\w* \w until the grape harvest|strong="H01210"\w*, \w and the grape harvest|strong="H01210"\w* \w will continue|strong="H05381"\w* \w -|strong="H00853"\w* \w until sowing time|strong="H02233"\w*; \w you will have your fill of|strong="H07648"\w* \w food|strong="H03899"\w* \w to eat|strong="H00398"\w* \w and will dwell|strong="H03427"\w* \w securely|strong="H00983"\w* \w in your land|strong="H00776"\w*.
\p \v 6 \w And I will give|strong="H05414"\w* \w peace|strong="H07965"\w* \w to the land|strong="H00776"\w*, \w and you will lie down|strong="H07901"\w* \w with nothing|strong="H00369"\w* \w to fear|strong="H02729"\w*. \w I will rid|strong="H07673"\w* \w -|strong="H04480"\w* \w the land|strong="H00776"\w* \w of dangerous|strong="H07451"\w* \w animals|strong="H02416"\w*, \w and no|strong="H03808"\w* \w sword|strong="H02719"\w* \w will pass|strong="H05674"\w* \w through your land|strong="H00776"\w*. \v 7 \w You will pursue|strong="H07291"\w* \w -|strong="H00853"\w* \w your enemies|strong="H00341"\w*, \w and they will fall|strong="H05307"\w* \w by the sword|strong="H02719"\w* \w before you|strong="H06440"\w*. \v 8 \w Five|strong="H02568"\w* of you \w will pursue|strong="H07291"\w* \w a hundred|strong="H03967"\w*, \w and a hundred|strong="H03967"\w* of you \w will pursue|strong="H07291"\w* \w ten thousand|strong="H07233"\w*, \w and your enemies|strong="H00341"\w* \w will fall|strong="H05307"\w* \w by the sword|strong="H02719"\w* \w before you|strong="H06440"\w*.
\p \v 9 \w I will turn|strong="H06437"\w* \w toward you|strong="H00413"\w* \w and make you fruitful|strong="H06509"\w* \w -|strong="H00853"\w* \w and multiply|strong="H07235"\w* \w you|strong="H00853"\w*, \w and I will establish|strong="H06965"\w* \w -|strong="H00853"\w* \w My covenant|strong="H01285"\w* \w with you|strong="H00854"\w*. \v 10 \w You will still be eating|strong="H00398"\w* \w the old|strong="H03465"\w* \w supply of grain|strong="H03462"\w* \w . . .|strong="H03465"\w* \w when you need to clear it out|strong="H03318"\w* \w to make room for|strong="H06440"\w* \w the new|strong="H02319"\w*.
\p \v 11 \w And I will make|strong="H05414"\w* \w My dwelling place|strong="H04908"\w*\f + \fr 26:11 \ft Or \fqa My tabernacle\f* \w among you|strong="H08432"\w*, \w and My soul|strong="H05315"\w* \w will not|strong="H03808"\w* \w despise|strong="H01602"\w*\f + \fr 26:11 \ft Or \fqa reject\ft ; also in verse 30\f* \w you|strong="H00853"\w*. \v 12 \w I will walk|strong="H01980"\w* \w among you|strong="H08432"\w* \w and be|strong="H01961"\w* your \w God|strong="H00430"\w*, \w and you|strong="H00859"\w* \w will be|strong="H01961"\w* My \w people|strong="H05971"\w*.\f + \fr 26:12 \ft Cited in 2 Corinthians 6:16\f* \v 13 \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*, \w who|strong="H00834"\w* \w brought|strong="H03318"\w* \w you|strong="H00853"\w* \w out of the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w* \w so that you would no longer be|strong="H01961"\w* \w slaves|strong="H05650"\w* to [the Egyptians]. \w I broke|strong="H07665"\w* \w the bars|strong="H04133"\w* \w of your yoke|strong="H05923"\w* \w and enabled you to walk|strong="H01980"\w* \w -|strong="H00853"\w* \w in uprightness|strong="H06968"\w*.
\s1 Punishments for Disobedience
\r (Leviticus 20:1–9; Deuteronomy 28:15–68)
\p \v 14 \w If, however|strong="H00518"\w*, \w you fail|strong="H03808"\w* \w to obey|strong="H08085"\w* Me \w . . .|strong="H03808"\w* \w and to carry out|strong="H06213"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w these|strong="H00428"\w* \w commandments|strong="H04687"\w*, \v 15 \w and if|strong="H00518"\w* \w you reject|strong="H03988"\w* \w . . .|strong="H00518"\w* \w -|strong="H00853"\w* \w My statutes|strong="H02708"\w*, \w despise|strong="H01602"\w* \w . . .|strong="H05315"\w* \w My ordinances|strong="H04941"\w*, \w and neglect|strong="H01115"\w* \w to carry out|strong="H06213"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w My commandments|strong="H04687"\w*, \w and so break|strong="H06565"\w* \w -|strong="H00853"\w* \w My covenant|strong="H01285"\w*, \v 16 \w then|strong="H00637"\w* \w this is what|strong="H02063"\w* \w I|strong="H00589"\w* \w will do|strong="H06213"\w* to you: \w I will bring|strong="H06485"\w* \w upon you|strong="H05921"\w* \w sudden terror|strong="H00928"\w* \w -|strong="H00853"\w*, \w wasting disease|strong="H07829"\w*, \w and|strong="H00853"\w* \w fever|strong="H06920"\w* \w that will destroy|strong="H03615"\w* \w your sight|strong="H05869"\w* \w and drain|strong="H01727"\w* \w your life|strong="H05315"\w*. \w You will sow|strong="H02232"\w* \w your seed|strong="H02233"\w* \w in vain|strong="H07385"\w*, \w because your enemies|strong="H00341"\w* \w will eat it|strong="H00398"\w*. \v 17 \w And I will set|strong="H05414"\w* \w My face|strong="H06440"\w* against you, \w so that you will be defeated|strong="H05062"\w* \w by|strong="H06440"\w* \w your enemies|strong="H00341"\w*. \w Those who hate you|strong="H08130"\w* \w will rule|strong="H07287"\w* over you, \w and you will flee|strong="H05127"\w* \w when no one|strong="H00369"\w* \w pursues|strong="H07291"\w* \w you|strong="H00853"\w*.
\p \v 18 \w And if|strong="H00518"\w* \w after|strong="H05704"\w* \w all this|strong="H00428"\w* \w you will not|strong="H03808"\w* \w obey|strong="H08085"\w* Me, \w I will proceed|strong="H03254"\w* \w to punish|strong="H03256"\w* \w you|strong="H00853"\w* \w sevenfold|strong="H07651"\w* \w for|strong="H05921"\w* \w your sins|strong="H02403"\w*. \v 19 \w I will break down|strong="H07665"\w* \w -|strong="H00853"\w* \w your stubborn|strong="H05797"\w* \w pride|strong="H01347"\w* \w and make|strong="H05414"\w* \w -|strong="H00853"\w* \w your sky|strong="H08064"\w* \w like iron|strong="H01270"\w* \w -|strong="H00853"\w* \w and your land|strong="H00776"\w* \w like bronze|strong="H05154"\w*, \v 20 \w and your strength|strong="H03581"\w* \w will be spent|strong="H08552"\w* \w in vain|strong="H07385"\w*. \w For your land|strong="H00776"\w* \w will not|strong="H03808"\w* \w yield|strong="H05414"\w* \w its|strong="H00853"\w* \w produce|strong="H02981"\w*, \w and the trees|strong="H06086"\w* \w of the land|strong="H00776"\w* \w will not|strong="H03808"\w* \w bear|strong="H05414"\w* \w their fruit|strong="H06529"\w*.
\p \v 21 \w If|strong="H00518"\w* \w you walk|strong="H01980"\w* \w in hostility|strong="H07147"\w* \w toward Me|strong="H05973"\w* \w and refuse|strong="H03808"\w* \w . . .|strong="H00014"\w* \w to obey|strong="H08085"\w* Me, \w I will multiply|strong="H03254"\w* \w . . .|strong="H05921"\w* \w your plagues|strong="H04347"\w* \w seven times|strong="H07651"\w*, \w according to your sins|strong="H02403"\w*. \v 22 \w I will send|strong="H07971"\w* \w -|strong="H00853"\w* \w wild|strong="H07704"\w* \w animals|strong="H02416"\w* against you \w to rob you of your children|strong="H07921"\w*, \w -|strong="H00853"\w* \w destroy|strong="H03772"\w* \w -|strong="H00853"\w* \w your livestock|strong="H00929"\w*, \w and reduce|strong="H04591"\w* \w your numbers|strong="H00853"\w*, \w until your roads|strong="H01870"\w* \w lie desolate|strong="H08074"\w*.
\p \v 23 \w And if|strong="H00518"\w* \w in spite of these|strong="H00428"\w* \w things you do not|strong="H03808"\w* \w accept My discipline|strong="H03256"\w* . . ., \w but continue to walk|strong="H01980"\w* \w in hostility|strong="H07147"\w* \w toward Me|strong="H05973"\w*, \v 24 \w then I|strong="H00589"\w* \w will act|strong="H01980"\w* \w . . .|strong="H00637"\w* \w with hostility|strong="H07147"\w* \w toward you|strong="H05973"\w*, \w and|strong="H01571"\w* \w I|strong="H00589"\w* \w will strike|strong="H05221"\w* \w you|strong="H00853"\w* \w sevenfold|strong="H07651"\w* \w for|strong="H05921"\w* \w your sins|strong="H02403"\w*. \v 25 \w And I will bring|strong="H00935"\w* \w a sword|strong="H02719"\w* \w against you|strong="H05921"\w* \w to execute|strong="H05358"\w* \w the vengeance|strong="H05359"\w* \w of the covenant|strong="H01285"\w*. \w Though you withdraw|strong="H00622"\w* \w into|strong="H00413"\w* \w your cities|strong="H05892"\w*, \w I will send|strong="H07971"\w* \w a plague|strong="H01698"\w* \w among you|strong="H08432"\w*, \w and you will be delivered|strong="H05414"\w* \w into the hand|strong="H03027"\w* \w of the enemy|strong="H00341"\w*. \v 26 \w When I cut off|strong="H07665"\w* your \w supply|strong="H04294"\w*\f + \fr 26:26 \ft Hebrew \fqa staff\f* \w of bread|strong="H03899"\w*, \w ten|strong="H06235"\w* \w women|strong="H00802"\w* \w will bake|strong="H00644"\w* \w your bread|strong="H03899"\w* \w in a single|strong="H00259"\w* \w oven|strong="H08574"\w* \w and dole out|strong="H07725"\w* \w your bread|strong="H03899"\w* \w by weight|strong="H04948"\w*, \w so that you will eat|strong="H00398"\w* \w but not|strong="H03808"\w* \w be satisfied|strong="H07646"\w*.
\p \v 27 \w But if|strong="H00518"\w* \w in spite of all this|strong="H02063"\w* \w you do not|strong="H03808"\w* \w obey|strong="H08085"\w* Me, \w but continue to walk|strong="H01980"\w* \w in hostility|strong="H07147"\w* \w toward Me|strong="H05973"\w*, \v 28 \w then I will walk|strong="H01980"\w* \w in fury|strong="H02534"\w* \w against|strong="H07147"\w* \w you|strong="H05973"\w*, \w and I|strong="H00589"\w*, \w even I|strong="H00637"\w*, \w will punish|strong="H03256"\w* \w you|strong="H00853"\w* \w sevenfold|strong="H07651"\w* \w for|strong="H05921"\w* \w your sins|strong="H02403"\w*. \v 29 \w You will eat|strong="H00398"\w* \w the flesh|strong="H01320"\w* \w of your own sons|strong="H01121"\w* \w -|strong="H00398"\w* \w [and]|strong="H01320"\w* \w daughters|strong="H01323"\w*. \v 30 \w I will destroy|strong="H08045"\w* \w -|strong="H00853"\w* \w your high places|strong="H01116"\w*, \w cut down|strong="H03772"\w* \w -|strong="H00853"\w* \w your incense altars|strong="H02553"\w*, \w and heap|strong="H05414"\w* \w -|strong="H00853"\w* \w your lifeless bodies|strong="H06297"\w* \w on|strong="H05921"\w* \w the lifeless remains|strong="H06297"\w* \w of your idols|strong="H01544"\w*; \w and My soul|strong="H05315"\w* \w will despise|strong="H01602"\w* \w you|strong="H00853"\w*.
\p \v 31 \w I will reduce|strong="H05414"\w* \w -|strong="H00853"\w* \w your cities|strong="H05892"\w* \w to rubble|strong="H02723"\w* \w and lay waste|strong="H08074"\w* \w -|strong="H00853"\w* \w your sanctuaries|strong="H04720"\w*, \w and I will refuse|strong="H03808"\w* \w to smell|strong="H07306"\w* \w the pleasing|strong="H05207"\w* \w aroma of your sacrifices|strong="H07381"\w*. \v 32 \w And I|strong="H00589"\w* \w -|strong="H00853"\w* \w will lay waste|strong="H08074"\w* \w the land|strong="H00776"\w*, \w so that your enemies|strong="H00341"\w* \w who dwell|strong="H03427"\w* in it \w will be appalled|strong="H08074"\w* \w . . .|strong="H05921"\w*. \v 33 \w But|strong="H00853"\w* \w I will scatter|strong="H02219"\w* \w you among the nations|strong="H01471"\w* \w and will draw out|strong="H07324"\w* \w a sword|strong="H02719"\w* \w after you|strong="H00310"\w* \w as your land|strong="H00776"\w* \w becomes|strong="H01961"\w* \w desolate|strong="H08077"\w* \w and your cities|strong="H05892"\w* \w are laid|strong="H01961"\w* \w waste|strong="H02723"\w*.
\p \v 34 \w Then|strong="H00227"\w* \w the land|strong="H00776"\w* \w shall enjoy|strong="H07521"\w* \w its|strong="H00853"\w* \w Sabbaths|strong="H07676"\w* \w all|strong="H03605"\w* \w the days|strong="H03117"\w* \w it lies desolate|strong="H08074"\w*, \w while you|strong="H00859"\w* \w are in the land|strong="H00776"\w* \w of your enemies|strong="H00341"\w*. \w At that time|strong="H00227"\w* \w the land|strong="H00776"\w* \w will rest|strong="H07673"\w* \w and enjoy|strong="H07521"\w* \w its|strong="H00853"\w* \w Sabbaths|strong="H07676"\w*. \v 35 \w As long as|strong="H03605"\w* \w . . .|strong="H03117"\w* \w it lies desolate|strong="H08074"\w*, \w [the land] will have the rest|strong="H07673"\w* \w -|strong="H00853"\w* \w -|strong="H00834"\w* \w it did not|strong="H03808"\w* \w receive|strong="H07673"\w* \w during the Sabbaths|strong="H07676"\w* \w when you lived|strong="H03427"\w* \w in it|strong="H05921"\w*.
\p \v 36 \w As for those of you who survive|strong="H07604"\w* . . ., \w I will send|strong="H00935"\w* \w a faintness|strong="H04816"\w* \w into their hearts|strong="H03824"\w* \w in the lands|strong="H00776"\w* \w of their enemies|strong="H00341"\w*, \w so that even the sound|strong="H06963"\w* \w of a windblown|strong="H05086"\w* \w leaf|strong="H05929"\w* \w will put them to flight|strong="H07291"\w* \w -|strong="H00853"\w*. \w And they will flee|strong="H05127"\w* \w as one flees|strong="H04499"\w* \w the sword|strong="H02719"\w*, \w and fall|strong="H05307"\w* \w when no one|strong="H00369"\w* \w pursues them|strong="H07291"\w*. \v 37 \w They will stumble|strong="H03782"\w* \w over one|strong="H00376"\w* \w another|strong="H00251"\w* \w as before|strong="H06440"\w* \w the sword|strong="H02719"\w*, \w though no one|strong="H00369"\w* \w is behind them|strong="H07291"\w*. \w So|strong="H03808"\w* you will not \w be|strong="H01961"\w* \w able to stand|strong="H08617"\w* \w against|strong="H06440"\w* \w your enemies|strong="H00341"\w*.
\p \v 38 \w You will perish|strong="H00006"\w* \w among the nations|strong="H01471"\w*, \w and the land|strong="H00776"\w* \w of your enemies|strong="H00341"\w* \w will consume|strong="H00398"\w* \w you|strong="H00853"\w*. \v 39 \w Those of you who survive|strong="H07604"\w* . . . \w in the lands|strong="H00776"\w* \w of your enemies|strong="H00341"\w* \w will waste away|strong="H04743"\w* \w in their iniquity|strong="H05771"\w* \w and|strong="H00637"\w* \w will decay|strong="H04743"\w* \w in the sins|strong="H05771"\w* \w of their fathers|strong="H00001"\w* \w . . .|strong="H00854"\w*.
\s1 God Remembers Those Who Repent
\p \v 40 \w But if they will confess|strong="H03034"\w* \w -|strong="H00853"\w* \w their iniquity|strong="H05771"\w* \w -|strong="H00853"\w* \w and [that]|strong="H05771"\w* \w of their fathers|strong="H00001"\w* \w in the unfaithfulness|strong="H04604"\w* \w that|strong="H00834"\w* \w they practiced|strong="H04603"\w* against Me, \w by which|strong="H00834"\w* \w vvv|strong="H00637"\w* \w they have also walked|strong="H01980"\w* \w in hostility|strong="H07147"\w* \w toward Me|strong="H05973"\w*— \v 41 \w and|strong="H00637"\w* \w I|strong="H00589"\w* \w acted|strong="H01980"\w* \w with hostility|strong="H07147"\w* \w toward them|strong="H05973"\w* \w and brought|strong="H00935"\w* \w them|strong="H00853"\w* \w into the land|strong="H00776"\w* \w of their enemies|strong="H00341"\w*— \w and|strong="H00176"\w* \w . . .|strong="H00227"\w* \w if their uncircumcised|strong="H06189"\w* \w . . .|strong="H00227"\w* \w hearts|strong="H03824"\w* \w will be humbled|strong="H03665"\w* \w and they will make amends|strong="H07521"\w* \w -|strong="H00853"\w* \w for their iniquity|strong="H05771"\w*, \v 42 \w then I will remember|strong="H02142"\w* \w -|strong="H00853"\w* \w My covenant|strong="H01285"\w* \w with Jacob|strong="H03290"\w* \w and|strong="H00637"\w* \w -|strong="H00853"\w* \w -|strong="H02142"\w* \w My covenant|strong="H01285"\w* \w with Isaac|strong="H03327"\w* \w . . .|strong="H00637"\w* \w -|strong="H00853"\w* \w and My covenant|strong="H01285"\w* \w with Abraham|strong="H00085"\w*, \w and I will remember|strong="H02142"\w* \w the land|strong="H00776"\w*.
\p \v 43 \w For the land|strong="H00776"\w* \w will be abandoned|strong="H05800"\w* by them, \w and it will enjoy|strong="H07521"\w* \w -|strong="H00853"\w* \w its Sabbaths|strong="H07676"\w* \w by lying desolate|strong="H08074"\w* without them. \w And they|strong="H01992"\w* \w will pay the penalty|strong="H07521"\w* \w -|strong="H00853"\w* \w for their iniquity|strong="H05771"\w*, \w because|strong="H03282"\w* \w . . .|strong="H03282"\w* \w they rejected|strong="H03988"\w* \w -|strong="H00853"\w* \w My ordinances|strong="H04941"\w* \w and abhorred|strong="H01602"\w* \w . . .|strong="H05315"\w* \w My statutes|strong="H02708"\w*.
\p \v 44 \w Yet|strong="H00637"\w* \w in spite of|strong="H01571"\w* \w this|strong="H02063"\w*, \w when they are|strong="H01961"\w* \w in the land|strong="H00776"\w* \w of their enemies|strong="H00341"\w*, \w I will not|strong="H03808"\w* \w reject|strong="H03988"\w* \w or|strong="H03808"\w* \w despise them|strong="H01602"\w* \w so as to destroy them|strong="H03615"\w* \w and break|strong="H06565"\w* \w My covenant|strong="H01285"\w* \w with them|strong="H00854"\w*; \w for|strong="H03588"\w* \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w* \w their God|strong="H00430"\w*. \v 45 But for their sake \w I will remember|strong="H02142"\w* \w the covenant|strong="H01285"\w* \w with their fathers|strong="H07223"\w*, \w whom|strong="H00834"\w* \w I brought out|strong="H03318"\w* \w -|strong="H00853"\w* \w of the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w* \w in the sight|strong="H05869"\w* \w of the nations|strong="H01471"\w*, \w that I might be|strong="H01961"\w* their \w God|strong="H00430"\w*. \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w*.”
\p \v 46 \w These|strong="H00428"\w* \w are the statutes|strong="H02706"\w*, \w ordinances|strong="H04941"\w*, \w and laws|strong="H08451"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w established|strong="H05414"\w* \w between Himself|strong="H00996"\w* \w . . .|strong="H00996"\w* \w and the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w through|strong="H03027"\w* \w Moses|strong="H04872"\w* \w on Mount|strong="H02022"\w* \w Sinai|strong="H05514"\w*.
\c 27
\s1 Rules about Valuations
\p \v 1 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00559"\w*, \v 2 “\w Speak|strong="H01696"\w* \w to|strong="H00413"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w and say|strong="H00559"\w* \w to them|strong="H00413"\w*, ‘\w When|strong="H03588"\w* \w someone|strong="H00376"\w* \w makes a special|strong="H06381"\w* \w vow|strong="H05088"\w* \w to the LORD|strong="H03068"\w* \w involving the value|strong="H06187"\w* \w of persons|strong="H05315"\w*, \v 3 \w if the valuation|strong="H06187"\w* \w concerns|strong="H01961"\w* \w a male|strong="H02145"\w* \w . . .|strong="H01121"\w* \w from twenty|strong="H06242"\w* \w -|strong="H08141"\w* \w to|strong="H05704"\w* \w . . .|strong="H01121"\w* \w sixty|strong="H08346"\w* \w years of age|strong="H08141"\w*, \w then your valuation|strong="H06187"\w* \w shall be|strong="H01961"\w* \w fifty|strong="H02572"\w* \w shekels|strong="H08255"\w* \w of silver|strong="H03701"\w*,\f + \fr 27:3 \fqa 50 shekels \ft is approximately 1.26 pounds or 569.8 grams of silver; also in verse 16.\f* \w according to the sanctuary|strong="H06944"\w* \w shekel|strong="H08255"\w*.\f + \fr 27:3 \fqa A shekel \ft weighed approximately 0.4 ounces or 11.4 grams; also in verse 25.\f* \v 4 \w Or if|strong="H00518"\w* \w it|strong="H01931"\w* \w is a female|strong="H05347"\w*, \w then your valuation|strong="H06187"\w* \w shall be|strong="H01961"\w* \w thirty|strong="H07970"\w* \w shekels|strong="H08255"\w*.\f + \fr 27:4 \fqa 30 shekels \ft is approximately 12 ounces or 342 grams of silver.\f* \v 5 \w And if [the person is]|strong="H00518"\w* \w from five|strong="H02568"\w* \w to|strong="H05704"\w* \w . . .|strong="H01121"\w* \w twenty|strong="H06242"\w* \w . . .|strong="H08141"\w* \w years of age|strong="H01121"\w* \w . . .|strong="H08141"\w*, \w then your valuation|strong="H06187"\w* \w for the male|strong="H02145"\w* \w shall be|strong="H01961"\w* \w twenty|strong="H06242"\w* \w shekels|strong="H08255"\w*,\f + \fr 27:5 \fqa 20 shekels \ft is approximately 8 ounces or 228 grams of silver.\f* \w and for the female|strong="H05347"\w* \w ten|strong="H06235"\w* \w shekels|strong="H08255"\w*.\f + \fr 27:5 \fqa 10 shekels \ft is approximately 4 ounces or 114 grams of silver; also in verse 7.\f*
\p \v 6 \w Now if [the person is]|strong="H00518"\w* \w -|strong="H01121"\w* \w from one month|strong="H02320"\w* \w to|strong="H05704"\w* \w . . .|strong="H01121"\w* \w five|strong="H02568"\w* \w years of age|strong="H08141"\w*, \w then your valuation|strong="H06187"\w* \w for the male|strong="H02145"\w* \w shall be|strong="H01961"\w* \w five|strong="H02568"\w* \w shekels|strong="H08255"\w* \w of silver|strong="H03701"\w*,\f + \fr 27:6 \fqa 5 shekels \ft is approximately 2 ounces or 57 grams of silver.\f* \w and for the female|strong="H05347"\w* \w -|strong="H06187"\w* \w three|strong="H07969"\w* \w shekels|strong="H08255"\w* \w of silver|strong="H03701"\w*.\f + \fr 27:6 \fqa 3 shekels \ft is approximately 1.2 ounces or 34.2 grams of silver.\f* \v 7 \w And if [the person is]|strong="H00518"\w* \w . . .|strong="H01121"\w* \w sixty|strong="H08346"\w* \w years of age|strong="H08141"\w* \w or older|strong="H04605"\w*, \w . . .|strong="H00518"\w* \w then your valuation|strong="H06187"\w* \w shall be|strong="H01961"\w* \w fifteen|strong="H02568"\w* \w . . .|strong="H06240"\w* \w shekels|strong="H08255"\w*\f + \fr 27:7 \fqa 15 shekels \ft is approximately 6 ounces or 171 grams of silver.\f* \w for the male|strong="H02145"\w* \w and ten|strong="H06235"\w* \w shekels|strong="H08255"\w* \w for the female|strong="H05347"\w*. \v 8 \w But if|strong="H00518"\w* \w [the one making the vow]|strong="H01931"\w* \w is too poor to pay|strong="H04134"\w* \w the valuation|strong="H06187"\w*, \w he is to present [the person]|strong="H05975"\w*\f + \fr 27:8 \ft Or \fqa present himself\f* \w before|strong="H06440"\w* \w the priest|strong="H03548"\w*, \w [who]|strong="H03548"\w* \w shall set the value|strong="H06186"\w* \w -|strong="H00853"\w* \w -|strong="H03548"\w* \w -|strong="H06186"\w* \w according to|strong="H05921"\w* \w . . .|strong="H06310"\w* \w what|strong="H00834"\w* \w the one making the vow|strong="H05087"\w* \w can afford|strong="H05381"\w* \w . . .|strong="H03027"\w*.
\p \v 9 \w If [he vows]|strong="H00518"\w* \w an|strong="H04480"\w* \w animal|strong="H00929"\w* \w that|strong="H00834"\w* \w may be brought|strong="H07126"\w* \w as an offering|strong="H07133"\w* \w to the LORD|strong="H03068"\w*, \w any|strong="H03605"\w* \w such [animal]|strong="H04480"\w* \w -|strong="H00834"\w* \w given|strong="H05414"\w* \w to the LORD|strong="H03068"\w* \w shall be|strong="H01961"\w* \w holy|strong="H06944"\w*. \v 10 \w He must not|strong="H03808"\w* \w replace it|strong="H02498"\w* \w . . .|strong="H03808"\w* \w or exchange it|strong="H04171"\w*, \w -|strong="H00853"\w* \w either good|strong="H02896"\w* \w for bad|strong="H07451"\w* \w or|strong="H00176"\w* \w bad|strong="H07451"\w* \w for good|strong="H02896"\w*. \w But if|strong="H00518"\w* \w he does substitute|strong="H04171"\w* \w . . .|strong="H04171"\w* \w one animal|strong="H00929"\w* \w for another|strong="H00929"\w*, \w both that animal|strong="H01931"\w* \w and its substitute|strong="H08545"\w* \w . . .|strong="H01961"\w* \w will be|strong="H01961"\w* \w holy|strong="H06944"\w*.
\p \v 11 \w But if|strong="H00518"\w* \w the vow involves any|strong="H03605"\w* \w of the unclean|strong="H02931"\w* \w animals|strong="H00929"\w* \w that|strong="H00834"\w* \w may not|strong="H03808"\w* \w be brought|strong="H07126"\w* \w . . .|strong="H04480"\w* \w as an offering|strong="H07133"\w* \w to the LORD|strong="H03068"\w*, \w the animal|strong="H00929"\w* \w must be presented|strong="H05975"\w* \w -|strong="H00853"\w* \w before|strong="H06440"\w* \w the priest|strong="H03548"\w*. \v 12 \w The priest|strong="H03548"\w* \w -|strong="H00853"\w* \w -|strong="H00996"\w* \w shall set its value|strong="H06186"\w*, \w whether high|strong="H02896"\w* \w . . .|strong="H00996"\w* \w or low|strong="H07451"\w*; \w as the priest|strong="H03548"\w* \w values it|strong="H06187"\w*, \w the price|strong="H03651"\w* \w will be set|strong="H01961"\w*. \v 13 \w If, however, [the owner]|strong="H00518"\w* \w decides to redeem [the animal]|strong="H01350"\w* \w . . .|strong="H01350"\w*, \w he must add|strong="H03254"\w* \w a fifth|strong="H02549"\w* \w to|strong="H05921"\w* \w its value|strong="H06187"\w*.
\p \v 14 \w Now if|strong="H03588"\w* \w a man|strong="H00376"\w* \w consecrates|strong="H06942"\w* \w -|strong="H00853"\w* \w his house|strong="H01004"\w* \w as holy|strong="H06944"\w* \w to the LORD|strong="H03068"\w*, \w then the priest|strong="H03548"\w* \w shall value it|strong="H06186"\w* \w either as|strong="H00996"\w* \w good|strong="H02896"\w* \w or|strong="H00996"\w* \w bad|strong="H07451"\w*. \w The price will stand|strong="H06965"\w* \w just as|strong="H00834"\w* \w the priest|strong="H03548"\w* \w . . .|strong="H03651"\w* \w values|strong="H06186"\w* \w it|strong="H00853"\w*. \v 15 \w But if|strong="H00518"\w* \w he who consecrated|strong="H06942"\w* \w his house|strong="H01004"\w* \w redeems|strong="H01350"\w* \w it|strong="H00853"\w*, \w he must add|strong="H03254"\w* \w a fifth|strong="H02549"\w* \w to|strong="H05921"\w* \w the assessed|strong="H06187"\w* \w value|strong="H03701"\w*, \w and it will belong|strong="H01961"\w* to him.
\p \v 16 \w If|strong="H00518"\w* \w a man|strong="H00376"\w* \w consecrates|strong="H06942"\w* \w to the LORD|strong="H03068"\w* \w a parcel|strong="H07704"\w* \w of his land|strong="H00272"\w*, \w then your valuation|strong="H06187"\w* \w shall be|strong="H01961"\w* \w proportional|strong="H06310"\w* \w to the seed required for it|strong="H02233"\w* — \w fifty|strong="H02572"\w* \w shekels|strong="H08255"\w* \w of silver|strong="H03701"\w* \w for every homer|strong="H02563"\w* \w of barley|strong="H08184"\w* \w seed|strong="H02233"\w*.\f + \fr 27:16 \fqa A homer \ft is a dry measure of approximately 6.24 bushels or 220 liters (probably about 291 pounds or 132 kilograms of barley seed).\f* \v 17 \w If|strong="H00518"\w* \w he consecrates|strong="H06942"\w* \w his field|strong="H07704"\w* \w during the Year|strong="H08141"\w* \w of Jubilee|strong="H03104"\w*, \w the price will stand|strong="H06965"\w* \w according to your valuation|strong="H06187"\w*.
\p \v 18 \w But if|strong="H00518"\w* \w he consecrates|strong="H06942"\w* \w his field|strong="H07704"\w* \w after|strong="H00310"\w* \w the Jubilee|strong="H03104"\w*, \w the priest|strong="H03548"\w* \w -|strong="H00853"\w* \w is to calculate|strong="H02803"\w* \w the price|strong="H03701"\w* \w in proportion to|strong="H05921"\w* \w . . .|strong="H06310"\w* \w the years|strong="H08141"\w* \w left|strong="H03498"\w* \w until|strong="H05704"\w* \w the next Year|strong="H08141"\w* \w of Jubilee|strong="H03104"\w*, \w so that your valuation|strong="H06187"\w* \w will be reduced|strong="H01639"\w*. \v 19 \w And if|strong="H00518"\w* \w the one who consecrated|strong="H06942"\w* \w -|strong="H00853"\w* \w the field|strong="H07704"\w* \w decides to redeem it|strong="H01350"\w* \w . . .|strong="H01350"\w*, \w -|strong="H00853"\w* \w he must add|strong="H03254"\w* \w a fifth|strong="H02549"\w* \w to|strong="H05921"\w* \w the assessed|strong="H06187"\w* \w value|strong="H03701"\w*, \w and it shall belong|strong="H06965"\w* to him.
\p \v 20 \w If, however|strong="H00518"\w*, \w he does not|strong="H03808"\w* \w redeem|strong="H01350"\w* \w -|strong="H00853"\w* \w the field|strong="H07704"\w*, \w or if|strong="H00518"\w* \w he has sold|strong="H04376"\w* \w -|strong="H00853"\w* \w it|strong="H07704"\w* \w to another|strong="H00312"\w* \w man|strong="H00376"\w*, \w it may no|strong="H03808"\w* \w longer|strong="H05750"\w* \w be redeemed|strong="H01350"\w*. \v 21 \w When the field|strong="H07704"\w* \w is released|strong="H03318"\w* \w in the Jubilee|strong="H03104"\w*, \w it will become|strong="H01961"\w* \w holy|strong="H06944"\w*, \w like a field|strong="H07704"\w* \w devoted|strong="H02764"\w* \w to the LORD|strong="H03068"\w*; \w it becomes|strong="H01961"\w* \w the property|strong="H00272"\w* \w of the priests|strong="H03548"\w*.
\p \v 22 \w Now if|strong="H00518"\w*\w . . .|strong="H00853"\w* \w [a man] consecrates|strong="H06942"\w* \w to the LORD|strong="H03068"\w* \w a field|strong="H07704"\w* \w he has purchased|strong="H04736"\w*, \w which|strong="H00834"\w* \w is not|strong="H03808"\w* \w a part|strong="H07704"\w* \w of his own property|strong="H00272"\w*, \v 23 \w then the priest|strong="H03548"\w* \w -|strong="H00853"\w* \w shall calculate|strong="H02803"\w* \w for him the value|strong="H04373"\w* \w . . .|strong="H06187"\w* \w up to|strong="H05704"\w* \w the Year|strong="H08141"\w* \w of Jubilee|strong="H03104"\w*, \w and [the man] shall pay|strong="H05414"\w* \w -|strong="H00853"\w* \w the assessed value|strong="H06187"\w* \w on that|strong="H01931"\w* \w day|strong="H03117"\w* \w as a sacred offering|strong="H06944"\w* \w to the LORD|strong="H03068"\w*. \v 24 \w In the Year|strong="H08141"\w* \w of Jubilee|strong="H03104"\w* \w the field|strong="H07704"\w* \w shall return|strong="H07725"\w* \w to the one from whom|strong="H00834"\w* \w it was bought|strong="H07069"\w* — \w . . .|strong="H00854"\w* \w -|strong="H00834"\w* - \w the original owner|strong="H00272"\w* \w of the land|strong="H00776"\w*. \v 25 \w Every|strong="H03605"\w* \w valuation|strong="H06187"\w* \w will be|strong="H01961"\w* \w according to the sanctuary|strong="H06944"\w* \w shekel|strong="H08255"\w*, \w twenty|strong="H06242"\w* \w gerahs|strong="H01626"\w* \w . . .|strong="H01961"\w* \w to the shekel|strong="H08255"\w*.\f + \fr 27:25 \fqa 20 gerahs \ft is equivalent to one shekel (approximately 0.4 ounces or 11.4 grams).\f*
\p \v 26 \w But|strong="H00389"\w* \w no|strong="H03808"\w* \w one|strong="H00376"\w* \w -|strong="H00853"\w* \w may consecrate|strong="H06942"\w* \w a firstborn|strong="H01060"\w* \w of the livestock|strong="H00929"\w*, \w because|strong="H00834"\w* \w a firstborn|strong="H01069"\w* \w belongs to the LORD|strong="H03068"\w*. \w Whether [it is]|strong="H00518"\w* \w an ox|strong="H07794"\w* \w or|strong="H00518"\w* \w a sheep|strong="H07716"\w*, \w it [is]|strong="H01931"\w* \w the LORD’s|strong="H03068"\w*. \v 27 \w But if|strong="H00518"\w* \w [it is] among the unclean|strong="H02931"\w* \w animals|strong="H00929"\w*, \w then he may redeem|strong="H06299"\w* \w it according to your valuation|strong="H06187"\w* \w and add|strong="H03254"\w* \w a fifth|strong="H02549"\w* \w of its value|strong="H05921"\w*. \w If|strong="H00518"\w* \w it is not|strong="H03808"\w* \w redeemed|strong="H01350"\w*, \w then it shall be sold|strong="H04376"\w* \w according to your valuation|strong="H06187"\w*.
\p \v 28 \w -|strong="H00389"\w* \w Nothing|strong="H03605"\w* \w that|strong="H00834"\w* \w a man|strong="H00376"\w* \w sets apart|strong="H02764"\w* \w . . .|strong="H02763"\w*\f + \fr 27:28 \ft Forms of the Hebrew \fqa cherem \ft refer to the giving over of things or persons to the LORD; similarly in verse 29.\f* \w to the LORD|strong="H03068"\w* \w from all he owns|strong="H03605"\w* — \w -|strong="H00834"\w* \w whether a man|strong="H00120"\w*, \w an animal|strong="H00929"\w*, \w or his inherited land|strong="H07704"\w* \w . . .|strong="H00272"\w* — \w -|strong="H03808"\w* \w can be sold|strong="H04376"\w* \w . . .|strong="H03808"\w* \w or redeemed|strong="H01350"\w*; \w everything|strong="H03605"\w* \w so devoted|strong="H02764"\w* \w [is] most|strong="H06944"\w* \w holy|strong="H06944"\w* \w . . .|strong="H01931"\w* \w to the LORD|strong="H03068"\w*.
