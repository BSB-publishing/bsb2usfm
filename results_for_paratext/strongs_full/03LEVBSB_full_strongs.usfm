\li1 \v 17 \w -|strong="H00853"\w* \w the little owl|strong="H03563"\w*, \w -|strong="H00853"\w* \w the cormorant|strong="H07994"\w*, \w -|strong="H00853"\w* \w the great owl|strong="H03244"\w*,
\li1 \v 18 \w -|strong="H00853"\w* \w the white owl|strong="H08580"\w*, \w -|strong="H00853"\w* \w the desert owl|strong="H06893"\w*, \w -|strong="H00853"\w* \w the osprey|strong="H07360"\w*,
\li1 \v 19 \w -|strong="H00853"\w* \w the stork|strong="H02624"\w*, \w any kind|strong="H04327"\w* \w -|strong="H00853"\w* \w of heron|strong="H00601"\w*,
\li1 \w the hoopoe|strong="H01744"\w*, \w and|strong="H00853"\w* \w the bat|strong="H05847"\w*.
\p \v 20 \w All|strong="H03605"\w* \w flying|strong="H05775"\w* \w insects|strong="H08318"\w* \w that walk|strong="H01980"\w* \w on|strong="H05921"\w* \w [all] fours|strong="H00702"\w* \w are detestable|strong="H08263"\w* \w . . .|strong="H01931"\w* to you. \v 21 \w However|strong="H00389"\w*, \w -|strong="H00853"\w* \w you may eat|strong="H00398"\w* \w the following|strong="H02088"\w* \w kinds of|strong="H03605"\w* \w flying|strong="H05775"\w* \w insects|strong="H08318"\w* \w that walk|strong="H01980"\w* \w on|strong="H05921"\w* \w all fours|strong="H00702"\w*: \w those|strong="H00834"\w* \w -|strong="H03808"\w* \w having jointed legs|strong="H03767"\w* \w above|strong="H04605"\w* \w their feet|strong="H07272"\w* \w for hopping|strong="H05425"\w* . . . \w on|strong="H05921"\w* \w the ground|strong="H00776"\w*. \v 22 \w -|strong="H00853"\w* \w Of these|strong="H00428"\w* - \w you may eat|strong="H00398"\w* \w -|strong="H00853"\w* \w any kind|strong="H04327"\w* \w -|strong="H00853"\w* \w of locust|strong="H00697"\w*, \w katydid|strong="H05556"\w*, \w . . .|strong="H04327"\w* \w -|strong="H00853"\w* \w cricket|strong="H02728"\w*, \w . . .|strong="H04327"\w* \w -|strong="H00853"\w* \w or grasshopper|strong="H02284"\w* \w . . .|strong="H04327"\w*. \v 23 \w All [other]|strong="H03605"\w* \w flying|strong="H05775"\w* \w insects|strong="H08318"\w* \w that|strong="H00834"\w* have \w four|strong="H00702"\w* \w legs|strong="H07272"\w* \w are detestable|strong="H08263"\w* \w . . .|strong="H01931"\w* to you.
\p \v 24 \w These [creatures]|strong="H00428"\w* \w will make you unclean|strong="H02930"\w*. \w Whoever|strong="H03605"\w* \w touches|strong="H05060"\w* \w their carcasses|strong="H05038"\w* \w will be unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*, \v 25 \w and whoever|strong="H03605"\w* \w picks up|strong="H05375"\w* \w one of their carcasses|strong="H05038"\w* \w must wash|strong="H03526"\w* \w his clothes|strong="H00899"\w*, \w and he will be unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*.
\p \v 26 \w Every|strong="H03605"\w* \w animal|strong="H00929"\w* \w with|strong="H00834"\w* \w . . .|strong="H01931"\w* \w vvv|strong="H08157"\w* \w hooves|strong="H06541"\w* \w not|strong="H00369"\w* \w completely divided|strong="H06536"\w*\f + \fr 11:26 \ft Literally \fqa a split hoof not completely divided\f* \w . . .|strong="H08156"\w* \w or that does not|strong="H00369"\w* \w chew|strong="H05927"\w* \w the cud|strong="H01625"\w* \w is unclean|strong="H02931"\w* \w . . .|strong="H01992"\w* for you. \w Whoever|strong="H03605"\w* \w touches|strong="H05060"\w* any of them \w will be unclean|strong="H02930"\w*.
\p \v 27 \w All|strong="H03605"\w* \w the four-footed|strong="H01980"\w* \w . . .|strong="H05921"\w* \w . . .|strong="H00702"\w* \w animals|strong="H02416"\w* \w that walk|strong="H01980"\w* \w on|strong="H05921"\w* \w their paws|strong="H03709"\w* \w . . .|strong="H03605"\w* \w are unclean|strong="H02931"\w* \w . . .|strong="H01992"\w* for you; \w whoever|strong="H03605"\w* \w touches|strong="H05060"\w* \w their carcasses|strong="H05038"\w* \w will be unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*, \v 28 \w and anyone who picks up|strong="H05375"\w* \w -|strong="H00853"\w* \w a carcass|strong="H05038"\w* \w must wash|strong="H03526"\w* \w his clothes|strong="H00899"\w*, \w and he will be unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*. \w They|strong="H01992"\w* \w are unclean|strong="H02931"\w* for you.
\p \v 29 \w The following|strong="H02088"\w* \w creatures|strong="H08318"\w* \w that move|strong="H08317"\w* \w along|strong="H05921"\w* \w the ground|strong="H00776"\w* \w are unclean|strong="H02931"\w* for you: \w the mole|strong="H02467"\w*, \w the mouse|strong="H05909"\w*, \w any kind|strong="H04327"\w* \w of great lizard|strong="H06632"\w*, \v 30 \w the gecko|strong="H00604"\w*, \w the monitor lizard|strong="H03581"\w*, \w the common lizard|strong="H03911"\w*, \w the skink|strong="H02546"\w*, \w and the chameleon|strong="H08580"\w*.
\p \v 31 \w These [animals]|strong="H00428"\w* \w are unclean|strong="H02931"\w* for you \w among all|strong="H03605"\w* \w the crawling creatures|strong="H08318"\w*. \w Whoever|strong="H03605"\w* \w touches|strong="H05060"\w* them \w when they are dead|strong="H04194"\w* \w shall be unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*. \v 32 \w When|strong="H03605"\w* \w one of them|strong="H00834"\w* \w dies|strong="H04194"\w* \w and falls|strong="H05307"\w* \w on|strong="H05921"\w* something, \w [that article] becomes unclean|strong="H02930"\w*; \w any|strong="H03605"\w* \w article|strong="H03627"\w* \w of wood|strong="H06086"\w*, \w . . .|strong="H00176"\w* \w clothing|strong="H00899"\w*, \w . . .|strong="H00176"\w* \w leather|strong="H05785"\w*, \w . . .|strong="H00176"\w* \w sackcloth|strong="H08242"\w*, \w or any|strong="H03605"\w* \w implement|strong="H03627"\w* \w -|strong="H00834"\w* \w used|strong="H06213"\w* \w for work|strong="H04399"\w* \w must be rinsed with water|strong="H04325"\w* \w . . .|strong="H00935"\w* \w and will remain unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*; \w then it will be clean|strong="H02891"\w*. \v 33 If any of them \w falls|strong="H05307"\w* \w into|strong="H00413"\w* \w . . .|strong="H08432"\w* \w a|strong="H03605"\w* \w clay|strong="H02789"\w* \w -|strong="H00834"\w* \w pot|strong="H03627"\w*, \w everything|strong="H03605"\w* \w -|strong="H00834"\w* \w in|strong="H08432"\w* \w it will be unclean|strong="H02930"\w*; \w -|strong="H00853"\w* \w you must break [the pot]|strong="H07665"\w*. \v 34 \w Any|strong="H03605"\w* \w vvv|strong="H00398"\w* \w vvv|strong="H00834"\w* \w food|strong="H00400"\w* \w -|strong="H00834"\w* \w coming|strong="H00935"\w* \w into contact|strong="H05921"\w* \w with water [from that pot]|strong="H04325"\w* \w will be unclean|strong="H02930"\w*, \w and any|strong="H03605"\w* \w drink|strong="H08354"\w* \w . . .|strong="H04945"\w* \w -|strong="H00834"\w* \w in such a|strong="H03605"\w* \w container|strong="H03627"\w* \w will be unclean|strong="H02930"\w*.
\p \v 35 \w Anything|strong="H03605"\w* \w upon which|strong="H00834"\w* \w one of their carcasses|strong="H05038"\w* \w falls|strong="H05307"\w* \w -|strong="H05921"\w* \w will be unclean|strong="H02930"\w*. \w If it is an oven|strong="H08574"\w* \w or cooking pot|strong="H03600"\w*, \w it must be smashed|strong="H05422"\w*; \w it|strong="H01992"\w* \w is unclean|strong="H02931"\w* \w and will remain|strong="H01961"\w* \w unclean|strong="H02931"\w* for you. \v 36 \w Nevertheless|strong="H00389"\w*, \w a spring|strong="H04599"\w* \w or cistern|strong="H00953"\w* \w containing|strong="H04723"\w* \w water|strong="H04325"\w* \w will remain|strong="H01961"\w* \w clean|strong="H02889"\w*, \w but one who touches|strong="H05060"\w* \w a carcass in it|strong="H05038"\w* \w will be unclean|strong="H02930"\w*. \v 37 \w If|strong="H03588"\w* \w a carcass|strong="H05038"\w* \w falls|strong="H05307"\w* \w on|strong="H05921"\w* \w any|strong="H03605"\w* \w seed|strong="H02233"\w* \w for sowing|strong="H02221"\w* \w -|strong="H00834"\w* \w -|strong="H02232"\w*, \w [the seed]|strong="H01931"\w* \w is clean|strong="H02889"\w*; \v 38 \w but if|strong="H03588"\w* \w water|strong="H04325"\w* \w has been put|strong="H05414"\w* \w on|strong="H05921"\w* \w the seed|strong="H02233"\w* \w and a carcass|strong="H05038"\w* \w falls|strong="H05307"\w* \w on it|strong="H05921"\w*, \w it|strong="H01931"\w* \w is unclean|strong="H02931"\w* for you.
\p \v 39 \w If|strong="H03588"\w* \w an|strong="H04480"\w* \w animal|strong="H00929"\w* \w that|strong="H00834"\w* \w . . .|strong="H01931"\w* you \w may eat|strong="H00402"\w* \w dies|strong="H04191"\w*, \w anyone who touches|strong="H05060"\w* \w the carcass|strong="H05038"\w* \w will be unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*. \v 40 \w Whoever eats|strong="H00398"\w* \w from the carcass|strong="H05038"\w* \w must wash|strong="H03526"\w* \w his clothes|strong="H00899"\w* \w and will be unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*, \w and anyone who picks up|strong="H05375"\w* \w -|strong="H00853"\w* \w the carcass|strong="H05038"\w* \w must wash|strong="H03526"\w* \w his clothes|strong="H00899"\w* \w and will be unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*.
\p \v 41 \w Every|strong="H03605"\w* \w creature|strong="H08318"\w* \w that moves|strong="H08317"\w* \w along|strong="H05921"\w* \w the ground|strong="H00776"\w* \w is detestable|strong="H08263"\w*; \w it|strong="H01931"\w* \w must not|strong="H03808"\w* \w be eaten|strong="H00398"\w*. \v 42 \w Do not|strong="H03808"\w* \w eat|strong="H00398"\w* \w any creature|strong="H08318"\w* \w that moves|strong="H08317"\w* \w along|strong="H05921"\w* \w the ground|strong="H00776"\w*, \w whether|strong="H03605"\w* \w it crawls|strong="H01980"\w* \w on|strong="H05921"\w* \w its belly|strong="H01512"\w* \w or|strong="H03605"\w* \w walks|strong="H01980"\w* \w on|strong="H05921"\w* \w four|strong="H00702"\w* \w or|strong="H05704"\w* \w . . .|strong="H03605"\w* \w more|strong="H07235"\w* \w feet|strong="H07272"\w*; \w . . .|strong="H03605"\w* \w for|strong="H03588"\w* \w such [creatures]|strong="H01992"\w* \w are detestable|strong="H08263"\w*.
\p \v 43 \w Do not|strong="H00408"\w* \w defile|strong="H08262"\w* \w -|strong="H00853"\w* \w yourselves|strong="H05315"\w* \w by any|strong="H03605"\w* \w crawling creature|strong="H08318"\w* \w . . .|strong="H08317"\w*; \w do not|strong="H03808"\w* \w become unclean|strong="H02930"\w* \w or defiled|strong="H02930"\w* by them. \v 44 \w For|strong="H03588"\w* \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*; \w consecrate yourselves, therefore|strong="H06942"\w*, \w and be|strong="H01961"\w* \w holy|strong="H06918"\w*, \w because|strong="H03588"\w* \w I|strong="H00589"\w* \w am holy|strong="H06918"\w*.\f + \fr 11:44 \ft Here and in verse 45; cited in 1 Peter 1:16\f* \w You must not|strong="H03808"\w* \w defile|strong="H02930"\w* \w -|strong="H00853"\w* \w yourselves|strong="H05315"\w* \w by any|strong="H03605"\w* \w creature|strong="H08318"\w* \w that crawls|strong="H07430"\w* \w along|strong="H05921"\w* \w the ground|strong="H00776"\w*. \v 45 \w For|strong="H03588"\w* \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w*, \w who brought you up|strong="H05927"\w* \w -|strong="H00853"\w* \w out of the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w* \w so that I would be|strong="H01961"\w* your \w God|strong="H00430"\w*; \w therefore be|strong="H01961"\w* \w holy|strong="H06918"\w*, \w because|strong="H03588"\w* \w I|strong="H00589"\w* \w am holy|strong="H06918"\w*.
\p \v 46 \w This|strong="H02063"\w* \w is the law|strong="H08451"\w* \w regarding animals|strong="H00929"\w*, \w birds|strong="H05775"\w*, \w all|strong="H03605"\w* \w living|strong="H02416"\w* \w creatures|strong="H05315"\w* \w that move|strong="H07430"\w* \w in the water|strong="H04325"\w*, \w and all|strong="H03605"\w* \w creatures|strong="H05315"\w* \w that crawl|strong="H08317"\w* \w along|strong="H05921"\w* \w the ground|strong="H00776"\w*. \v 47 \w You must distinguish|strong="H00914"\w* \w between|strong="H00996"\w* \w the unclean|strong="H02931"\w* \w and the clean|strong="H02889"\w*, \w . . .|strong="H00996"\w* \w between|strong="H00996"\w* \w animals|strong="H02416"\w* \w that may be eaten|strong="H00398"\w* \w . . .|strong="H00996"\w* \w and those|strong="H02416"\w* \w that|strong="H00834"\w* \w may not|strong="H03808"\w* \w -|strong="H00398"\w*.’”
\c 12
\s1 Purification after Childbirth
\p \v 1 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00559"\w*, \v 2 “\w Say|strong="H01696"\w* \w to|strong="H00413"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w -|strong="H00559"\w*, ‘\w -|strong="H03588"\w* \w A woman who|strong="H00802"\w* \w becomes pregnant|strong="H02232"\w* \w and gives birth to|strong="H03205"\w* \w a son|strong="H02145"\w* \w will be unclean|strong="H02930"\w* \w for seven|strong="H07651"\w* \w days|strong="H03117"\w*, \w as she is during the days|strong="H03117"\w* \w of her menstruation|strong="H05079"\w* \w . . .|strong="H01738"\w* \w . . .|strong="H02930"\w*. \v 3 \w And on the eighth|strong="H08066"\w* \w day|strong="H03117"\w* \w the flesh|strong="H01320"\w* \w of [the boy’s] foreskin|strong="H06190"\w* \w is to be circumcised|strong="H04135"\w*.
\p \v 4 \w The woman shall continue|strong="H03427"\w* \w in purification|strong="H02893"\w* \w from her bleeding|strong="H01818"\w* \w for thirty-three|strong="H07970"\w* \w . . .|strong="H07969"\w* \w days|strong="H03117"\w*\w . . .|strong="H03117"\w*. \w She must not|strong="H03808"\w* \w touch|strong="H05060"\w* \w anything|strong="H03605"\w* \w sacred|strong="H06944"\w* \w or go|strong="H00935"\w* \w into|strong="H00413"\w* \w the sanctuary|strong="H04720"\w* \w . . .|strong="H03808"\w* \w until|strong="H05704"\w* \w the days|strong="H03117"\w* \w of her purification|strong="H02893"\w* \w are complete|strong="H04390"\w*.
\p \v 5 \w If, however|strong="H00518"\w*, \w she gives birth to|strong="H03205"\w* \w a daughter|strong="H05347"\w*, \w [the woman] will be unclean|strong="H02930"\w* \w for two weeks|strong="H07620"\w* \w as she is during her menstruation|strong="H05079"\w*. \w Then she must continue|strong="H03427"\w* \w in|strong="H05921"\w* \w purification|strong="H02893"\w* \w from her bleeding|strong="H01818"\w* \w for sixty-six|strong="H08346"\w* \w . . .|strong="H03117"\w* \w . . .|strong="H08337"\w* \w days|strong="H03117"\w*.
\p \v 6 \w When the days|strong="H03117"\w* \w of her purification|strong="H02893"\w* \w are complete|strong="H04390"\w*, \w whether for a son|strong="H01121"\w* \w or|strong="H00176"\w* \w for a daughter|strong="H01323"\w*, \w she is to bring|strong="H00935"\w* \w to|strong="H00413"\w* \w the priest|strong="H03548"\w* \w at|strong="H00413"\w* \w the entrance|strong="H06607"\w* \w to the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w* \w a year-old|strong="H01121"\w* \w . . .|strong="H08141"\w* \w lamb|strong="H03532"\w* \w for a burnt offering|strong="H05930"\w* \w and a young|strong="H01121"\w* \w pigeon|strong="H03123"\w* \w or|strong="H00176"\w* \w a turtledove|strong="H08449"\w* \w for a sin offering|strong="H02403"\w*. \v 7 \w And [the priest] will present them|strong="H07126"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w and make atonement|strong="H03722"\w* \w for her|strong="H05921"\w*; \w and she shall be ceremonially cleansed|strong="H02891"\w* \w from her flow|strong="H04726"\w* \w of blood|strong="H01818"\w*. \w This|strong="H02063"\w* \w is the law|strong="H08451"\w* \w for a woman giving birth|strong="H03205"\w*, \w whether to a male|strong="H02145"\w* \w or|strong="H00176"\w* \w to a female|strong="H05347"\w*.
\p \v 8 \w But if|strong="H00518"\w* \w she cannot|strong="H03808"\w* \w afford|strong="H04672"\w* \w . . .|strong="H01767"\w* \w . . .|strong="H03027"\w* \w a lamb|strong="H07716"\w*, \w she shall bring|strong="H03947"\w* \w two|strong="H08147"\w* \w turtledoves|strong="H08449"\w* \w or|strong="H00176"\w* \w two|strong="H08147"\w* \w young|strong="H01121"\w* \w pigeons|strong="H03123"\w*,\f + \fr 12:8 \ft Cited in Luke 2:24\f* \w one|strong="H00259"\w* \w for a burnt offering|strong="H05930"\w* \w and the other|strong="H00259"\w* \w for a sin offering|strong="H02403"\w*. \w Then the priest|strong="H03548"\w* \w will make atonement|strong="H03722"\w* \w for her|strong="H05921"\w*, \w and she will be clean|strong="H02891"\w*.’”
\c 13
\s1 Laws about Skin Diseases
\r (Numbers 5:1–4)
\p \v 1 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00413"\w* \w and Aaron|strong="H00175"\w* \w . . .|strong="H00559"\w*, \v 2 “\w When|strong="H03588"\w* \w someone|strong="H00120"\w* \w has|strong="H01961"\w* \w a swelling|strong="H07613"\w* \w or|strong="H00176"\w* \w rash|strong="H05597"\w* \w or|strong="H00176"\w* \w bright spot|strong="H00934"\w* \w on his skin|strong="H05785"\w* \w . . .|strong="H01320"\w* \w that may be|strong="H01961"\w* \w an infectious|strong="H06883"\w* \w skin|strong="H05785"\w* \w . . .|strong="H01320"\w* \w disease|strong="H05061"\w*,\f + \fr 13:2 \ft Forms of the Hebrew \fqa tzaraath\ft , traditionally translated as \fqa leprosy\ft , were used for various skin diseases; here and throughout verses 3–46.\f* \w he must be brought|strong="H00935"\w* \w to|strong="H00413"\w* \w Aaron|strong="H00175"\w* \w the priest|strong="H03548"\w* \w or|strong="H00176"\w* \w to|strong="H00413"\w* \w one|strong="H00259"\w* \w of his sons|strong="H01121"\w* \w who is a priest|strong="H03548"\w*.
\p \v 3 \w The priest|strong="H03548"\w* \w -|strong="H00853"\w* \w is to examine|strong="H07200"\w* \w the infection|strong="H05061"\w* \w on his skin|strong="H05785"\w* \w . . .|strong="H01320"\w*, \w and if the hair|strong="H08181"\w* \w in the infection|strong="H05061"\w* \w has turned|strong="H02015"\w* \w white|strong="H03836"\w* \w and the sore|strong="H05061"\w* \w appears|strong="H04758"\w* \w to be deeper|strong="H06013"\w* \w than the skin|strong="H05785"\w* \w . . .|strong="H01320"\w*, \w . . .|strong="H05061"\w* \w it|strong="H01931"\w* \w is a skin disease|strong="H06883"\w*. \w After the priest|strong="H03548"\w* \w examines him|strong="H07200"\w*, \w he must pronounce him unclean|strong="H02930"\w* \w -|strong="H00853"\w*.
\p \v 4 \w If, however|strong="H00518"\w*, \w the spot|strong="H00934"\w* \w on his skin|strong="H05785"\w* \w . . .|strong="H01320"\w* \w is white|strong="H03836"\w* \w . . .|strong="H01931"\w* \w and does not|strong="H00369"\w* \w appear|strong="H04758"\w* \w to be deeper|strong="H06013"\w* \w than|strong="H04480"\w* \w the skin|strong="H05785"\w*, \w and the hair in it|strong="H08181"\w* \w has not|strong="H03808"\w* \w turned|strong="H02015"\w* \w white|strong="H03836"\w*, \w the priest|strong="H03548"\w* \w -|strong="H00853"\w* \w shall isolate|strong="H05462"\w* \w the infected person|strong="H05061"\w* \w for seven|strong="H07651"\w* \w days|strong="H03117"\w*. \v 5 \w On the seventh|strong="H07637"\w* \w day|strong="H03117"\w* \w the priest|strong="H03548"\w* \w is to reexamine him|strong="H07200"\w*, \w and if|strong="H02009"\w* \w he sees|strong="H05869"\w* \w that the infection|strong="H05061"\w* \w is unchanged|strong="H05975"\w* \w and has not|strong="H03808"\w* \w spread|strong="H06581"\w* \w . . .|strong="H05061"\w* \w on the skin|strong="H05785"\w*, \w the priest|strong="H03548"\w* \w must isolate him|strong="H05462"\w* \w for another|strong="H08145"\w* \w seven|strong="H07651"\w* \w days|strong="H03117"\w*. \v 6 \w The priest|strong="H03548"\w* \w -|strong="H00853"\w* \w will examine him|strong="H07200"\w* \w again|strong="H08145"\w* \w on the seventh|strong="H07637"\w* \w day|strong="H03117"\w*, \w and if|strong="H02009"\w* \w the sore|strong="H05061"\w* \w has faded|strong="H03543"\w* \w and has not|strong="H03808"\w* \w spread|strong="H06581"\w* \w . . .|strong="H05061"\w* \w on the skin|strong="H05785"\w*, \w the priest|strong="H03548"\w* \w shall pronounce him clean|strong="H02891"\w*; \w it|strong="H01931"\w* \w is a rash|strong="H04556"\w*. \w The person must wash|strong="H03526"\w* \w his clothes|strong="H00899"\w* \w and be clean|strong="H02891"\w*.
\p \v 7 \w But if|strong="H00518"\w* \w the rash|strong="H04556"\w* \w spreads further|strong="H06581"\w* \w . . .|strong="H06581"\w* \w on his skin|strong="H05785"\w* \w after|strong="H00310"\w* \w he has shown himself|strong="H07200"\w* \w to|strong="H00413"\w* \w the priest|strong="H03548"\w* \w for his cleansing|strong="H02893"\w*, \w he must present himself|strong="H07200"\w* \w again|strong="H08145"\w* \w to|strong="H00413"\w* \w the priest|strong="H03548"\w*. \v 8 \w The priest|strong="H03548"\w* \w will reexamine him|strong="H07200"\w*, \w and if|strong="H02009"\w* \w the rash|strong="H04556"\w* \w has spread|strong="H06581"\w* \w on the skin|strong="H05785"\w*, \w the priest|strong="H03548"\w* \w must pronounce him unclean|strong="H02930"\w*; \w it|strong="H01931"\w* \w [is] a skin disease|strong="H06883"\w*.
\p \v 9 \w When|strong="H03588"\w* \w anyone|strong="H00120"\w* \w develops|strong="H01961"\w* \w a skin disease|strong="H05061"\w*\w . . .|strong="H06883"\w*, \w he must be brought|strong="H00935"\w* \w to|strong="H00413"\w* \w the priest|strong="H03548"\w*. \v 10 \w The priest|strong="H03548"\w* \w will examine him|strong="H07200"\w*, \w and if|strong="H02009"\w* \w there is a white|strong="H03836"\w* \w swelling|strong="H07613"\w* \w on the skin|strong="H05785"\w* \w that|strong="H01931"\w* \w has turned|strong="H02015"\w* \w the hair|strong="H08181"\w* \w white|strong="H03836"\w*, \w . . .|strong="H04241"\w* \w and there is raw|strong="H02416"\w* \w flesh|strong="H01320"\w* \w in the swelling|strong="H07613"\w*, \v 11 \w it|strong="H01931"\w* \w is a chronic|strong="H03462"\w* \w skin disease|strong="H06883"\w* \w . . .|strong="H05785"\w* \w . . .|strong="H01320"\w* \w and the priest|strong="H03548"\w* \w must pronounce him unclean|strong="H02930"\w*. \w He need not|strong="H03808"\w* \w isolate him|strong="H05462"\w*, \w for|strong="H03588"\w* \w he|strong="H01931"\w* \w is unclean|strong="H02931"\w*.
\p \v 12 \w But if|strong="H00518"\w* \w the skin disease|strong="H06883"\w* \w breaks out|strong="H06524"\w* \w . . .|strong="H06524"\w* \w all over his skin|strong="H05785"\w* \w so that it|strong="H06883"\w* \w -|strong="H00853"\w* \w covers|strong="H03680"\w* \w all|strong="H03605"\w* \w the skin|strong="H05785"\w* \w of the infected person|strong="H05061"\w* \w from head|strong="H07218"\w* \w to|strong="H05704"\w* \w foot|strong="H07272"\w*, \w . . .|strong="H03605"\w* \w as far as the priest|strong="H03548"\w* \w can see|strong="H04758"\w*, \w . . .|strong="H05869"\w* \v 13 \w the priest|strong="H03548"\w* \w shall examine him|strong="H07200"\w*, \w and if|strong="H02009"\w* \w the disease|strong="H06883"\w* \w -|strong="H00853"\w* \w has covered|strong="H03680"\w* \w his entire|strong="H03605"\w* \w body|strong="H01320"\w*, \w he is to pronounce the infected person|strong="H05061"\w* \w clean|strong="H02891"\w*. \w -|strong="H00853"\w* \w Since it has all turned|strong="H02015"\w* \w . . .|strong="H03605"\w* \w white|strong="H03836"\w*, \w he|strong="H01931"\w* \w is clean|strong="H02889"\w*.
\p \v 14 \w But whenever|strong="H03117"\w* \w raw|strong="H02416"\w* \w flesh|strong="H01320"\w* \w appears|strong="H07200"\w* on [someone], \w he will be unclean|strong="H02930"\w*. \v 15 \w When the priest|strong="H03548"\w* \w -|strong="H00853"\w* \w sees|strong="H07200"\w* \w the raw|strong="H02416"\w* \w flesh|strong="H01320"\w*, \w he must pronounce him unclean|strong="H02930"\w*. \w The raw|strong="H02416"\w* \w flesh|strong="H01320"\w* \w is unclean|strong="H02931"\w*; \w it|strong="H01931"\w* \w is a skin disease|strong="H06883"\w*. \w . . .|strong="H01931"\w* \v 16 \w But|strong="H00176"\w* \w if|strong="H03588"\w* \w the raw|strong="H02416"\w* \w flesh|strong="H01320"\w* \w changes|strong="H07725"\w* \w and turns|strong="H02015"\w* \w white|strong="H03836"\w*, \w he must go|strong="H00935"\w* \w to|strong="H00413"\w* \w the priest|strong="H03548"\w*. \v 17 \w The priest|strong="H03548"\w* \w will reexamine him|strong="H07200"\w*, \w and if|strong="H02009"\w* \w the infection|strong="H05061"\w* \w has turned|strong="H02015"\w* \w white|strong="H03836"\w*, \w the priest|strong="H03548"\w* \w -|strong="H00853"\w* \w is to pronounce the infected person|strong="H05061"\w* \w clean|strong="H02891"\w*; \w then he|strong="H01931"\w* \w is clean|strong="H02889"\w*.
\p \v 18 \w When|strong="H03588"\w* \w a boil|strong="H07822"\w* \w appears|strong="H01961"\w* \w on someone’s skin|strong="H05785"\w* \w . . .|strong="H01320"\w* \w and it heals|strong="H07495"\w*, \v 19 \w and a white|strong="H03836"\w* \w swelling|strong="H07613"\w* \w or|strong="H00176"\w* \w a reddish-white|strong="H03836"\w* \w . . .|strong="H00125"\w* \w spot|strong="H00934"\w* \w develops|strong="H01961"\w* \w where|strong="H04725"\w* \w the boil was|strong="H07822"\w*, \w he must present himself|strong="H07200"\w* \w to|strong="H00413"\w* \w the priest|strong="H03548"\w*. \v 20 \w The priest|strong="H03548"\w* \w shall examine it|strong="H07200"\w*, \w and if|strong="H02009"\w* \w it appears|strong="H04758"\w* \w to be beneath|strong="H08217"\w* \w . . .|strong="H04480"\w* \w the skin|strong="H05785"\w* \w and the hair in it|strong="H08181"\w* \w has turned|strong="H02015"\w* \w white|strong="H03836"\w*, \w the priest|strong="H03548"\w* \w . . .|strong="H05061"\w* \w shall pronounce him unclean|strong="H02930"\w*; \w it|strong="H01931"\w* \w is a diseased infection|strong="H06883"\w* \w that has broken out|strong="H06524"\w* \w in the boil|strong="H07822"\w*.
\p \v 21 \w But when|strong="H00518"\w* \w the priest|strong="H03548"\w* \w examines it|strong="H07200"\w*, \w if|strong="H02009"\w* \w there is no|strong="H00369"\w* \w white|strong="H03836"\w* \w hair|strong="H08181"\w* in it, \w and it is not|strong="H00369"\w* \w . . .|strong="H04480"\w* \w beneath|strong="H08217"\w* \w the skin|strong="H05785"\w* \w . . .|strong="H01931"\w* \w and has faded|strong="H03544"\w*, \w the priest|strong="H03548"\w* \w shall isolate him|strong="H05462"\w* \w for seven|strong="H07651"\w* \w days|strong="H03117"\w*. \v 22 \w If|strong="H00518"\w* \w it spreads any further|strong="H06581"\w* \w . . .|strong="H06581"\w* \w on the skin|strong="H05785"\w*, \w the priest|strong="H03548"\w* \w -|strong="H00853"\w* \w must pronounce him unclean|strong="H02930"\w*; \w it|strong="H01931"\w* \w is an infection|strong="H05061"\w*. \v 23 \w But if|strong="H00518"\w* \w the spot|strong="H00934"\w* \w remains|strong="H05975"\w* \w unchanged|strong="H08478"\w* \w and does not|strong="H03808"\w* \w spread|strong="H06581"\w*, \w it|strong="H01931"\w* \w is only the scar|strong="H06867"\w* \w from the boil|strong="H07822"\w*, \w and the priest|strong="H03548"\w* \w shall pronounce him clean|strong="H02891"\w*.
\p \v 24 \w When|strong="H03588"\w* \w there is|strong="H01961"\w* \w a burn|strong="H04348"\w* \w . . .|strong="H00784"\w* \w on someone’s skin|strong="H05785"\w*\w . . .|strong="H00176"\w* \w -|strong="H01320"\w* \w and the raw|strong="H04241"\w* \w [area] of the burn|strong="H04348"\w* \w . . .|strong="H00934"\w* \w becomes|strong="H01961"\w* \w reddish-white|strong="H03836"\w* \w . . .|strong="H00125"\w* \w or|strong="H00176"\w* \w white|strong="H03836"\w*, \v 25 \w the priest|strong="H03548"\w* \w must examine it|strong="H07200"\w*. \w -|strong="H00853"\w* \w If|strong="H02009"\w* \w the hair|strong="H08181"\w* \w in the spot|strong="H00934"\w* \w has turned|strong="H02015"\w* \w white|strong="H03836"\w* \w and the spot appears|strong="H04758"\w* \w to be deeper|strong="H06013"\w* \w than|strong="H04480"\w* \w the skin|strong="H05785"\w*, \w it|strong="H01931"\w* \w is a disease|strong="H06883"\w* \w that has broken out|strong="H06524"\w* \w in the burn|strong="H04348"\w*. \w The priest|strong="H03548"\w* \w . . .|strong="H05061"\w* \w must pronounce him unclean|strong="H02930"\w*; \w -|strong="H00853"\w* \w it|strong="H01931"\w* \w is a diseased infection|strong="H06883"\w*.
\p \v 26 \w But if|strong="H00518"\w* \w the priest|strong="H03548"\w* \w examines it|strong="H07200"\w* \w and there is|strong="H02009"\w* \w no|strong="H00369"\w* \w white|strong="H03836"\w* \w hair|strong="H08181"\w* \w in the spot|strong="H00934"\w*, \w and it is not|strong="H00369"\w* \w . . .|strong="H04480"\w* \w beneath|strong="H08217"\w* \w the skin|strong="H05785"\w* \w . . .|strong="H01931"\w* \w but has faded|strong="H03544"\w*, \w the priest|strong="H03548"\w* \w shall isolate him|strong="H05462"\w* \w for seven|strong="H07651"\w* \w days|strong="H03117"\w*. \v 27 \w On the seventh|strong="H07637"\w* \w day|strong="H03117"\w* \w the priest|strong="H03548"\w* \w is to reexamine him|strong="H07200"\w*, \w and if|strong="H00518"\w* \w it has spread further|strong="H06581"\w* \w . . .|strong="H06581"\w* \w on the skin|strong="H05785"\w*, \w the priest|strong="H03548"\w* \w -|strong="H00853"\w* \w -|strong="H05061"\w* \w must pronounce him unclean|strong="H02930"\w*; \w it|strong="H01931"\w* \w is a diseased infection|strong="H06883"\w*. \v 28 \w But if|strong="H00518"\w* \w the spot|strong="H00934"\w* \w is unchanged|strong="H05975"\w* \w . . .|strong="H08478"\w* \w and has not|strong="H03808"\w* \w spread|strong="H06581"\w* \w on the skin|strong="H05785"\w* \w but has faded|strong="H03544"\w*, \w it|strong="H01931"\w* \w is a swelling|strong="H07613"\w* \w from the burn|strong="H04348"\w*, \w and the priest|strong="H03548"\w* \w is to pronounce him clean|strong="H02891"\w*; \w for|strong="H03588"\w* \w it|strong="H01931"\w* \w is only the scar|strong="H06867"\w* \w from the burn|strong="H04348"\w* \w . . .|strong="H01931"\w*.
\p \v 29 \w If|strong="H03588"\w* \w a man|strong="H00376"\w* \w or|strong="H00176"\w* \w woman|strong="H00802"\w* \w has|strong="H01961"\w* \w an infection|strong="H05061"\w* \w on the head|strong="H07218"\w* \w or|strong="H00176"\w* \w chin|strong="H02206"\w*, \v 30 \w the priest|strong="H03548"\w* \w -|strong="H00853"\w* \w shall examine|strong="H07200"\w* \w the infection|strong="H05061"\w*, \w and if|strong="H02009"\w* \w it appears|strong="H04758"\w* \w to be deeper|strong="H06013"\w* \w than|strong="H04480"\w* \w the skin|strong="H05785"\w* and \w the hair in it|strong="H08181"\w* \w is yellow|strong="H06669"\w* \w and thin|strong="H01851"\w*, \w the priest|strong="H03548"\w* \w must pronounce him unclean|strong="H02930"\w* \w -|strong="H00853"\w*; \w it|strong="H01931"\w* \w is a scaly outbreak|strong="H05424"\w*, \w an infectious disease|strong="H06883"\w* \w of the head|strong="H07218"\w* \w or|strong="H00176"\w* \w chin|strong="H02206"\w* \w . . .|strong="H01931"\w*.
\p \v 31 \w But if|strong="H03588"\w* \w the priest|strong="H03548"\w* \w -|strong="H00853"\w* \w examines|strong="H07200"\w* \w the scaly|strong="H05424"\w* \w infection|strong="H05061"\w* \w and|strong="H02009"\w* \w it does not|strong="H00369"\w* \w appear|strong="H04758"\w* \w to be deeper|strong="H06013"\w* \w than|strong="H04480"\w* \w the skin|strong="H05785"\w*, \w and there is no|strong="H00369"\w* \w black|strong="H07838"\w* \w hair|strong="H08181"\w* in it, \w the priest|strong="H03548"\w* \w -|strong="H00853"\w* \w shall isolate|strong="H05462"\w* \w the infected person|strong="H05424"\w* \w . . .|strong="H05061"\w* \w for seven|strong="H07651"\w* \w days|strong="H03117"\w*. \v 32 \w On the seventh|strong="H07637"\w* \w day|strong="H03117"\w* \w the priest|strong="H03548"\w* \w -|strong="H00853"\w* \w is to reexamine|strong="H07200"\w* \w the infection|strong="H05061"\w*, \w and if|strong="H02009"\w* \w the scaly outbreak|strong="H05424"\w* \w has not|strong="H03808"\w* \w spread|strong="H06581"\w* \w and there is|strong="H01961"\w* \w no|strong="H03808"\w* \w yellow|strong="H06669"\w* \w hair|strong="H08181"\w* in it, \w and it|strong="H05424"\w* \w does not|strong="H00369"\w* \w appear|strong="H04758"\w* \w to be deeper|strong="H06013"\w* \w than|strong="H04480"\w* \w the skin|strong="H05785"\w*, \v 33 \w then the person must shave himself|strong="H01548"\w* \w except for|strong="H00853"\w* \w . . .|strong="H03808"\w* \w -|strong="H01548"\w* \w the scaly area|strong="H05424"\w*. \w Then the priest|strong="H03548"\w* \w -|strong="H00853"\w* \w shall isolate|strong="H05462"\w* \w [him]|strong="H05424"\w* \w for another|strong="H08145"\w* \w seven|strong="H07651"\w* \w days|strong="H03117"\w*. \v 34 \w On the seventh|strong="H07637"\w* \w day|strong="H03117"\w* \w the priest|strong="H03548"\w* \w -|strong="H00853"\w* \w shall examine|strong="H07200"\w* \w the scaly outbreak|strong="H05424"\w*, \w and if|strong="H02009"\w* \w it|strong="H05424"\w* \w has n