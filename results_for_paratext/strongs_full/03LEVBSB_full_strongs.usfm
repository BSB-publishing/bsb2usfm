\p \v 23 \w When|strong="H03588"\w* \w you enter|strong="H00935"\w* \w . . .|strong="H00413"\w* \w the land|strong="H00776"\w* \w and plant|strong="H05193"\w* \w any|strong="H03605"\w* \w kind of tree|strong="H06086"\w* \w for food|strong="H03978"\w*, \w you shall regard|strong="H06188"\w* \w -|strong="H00853"\w* \w the fruit|strong="H06529"\w* \w as forbidden|strong="H06190"\w*.\f + \fr 19:23 \ft Hebrew \fqa as uncircumcised\ft ; twice in this verse\f* \w For three|strong="H07969"\w* \w years|strong="H08141"\w* \w it will be|strong="H01961"\w* \w forbidden|strong="H06189"\w* to you \w and must not|strong="H03808"\w* \w be eaten|strong="H00398"\w*. \v 24 \w In the fourth|strong="H07243"\w* \w year|strong="H08141"\w* \w all|strong="H03605"\w* \w its fruit|strong="H06529"\w* \w must be|strong="H01961"\w* \w consecrated|strong="H06944"\w* \w as a praise offering|strong="H01974"\w* \w to the LORD|strong="H03068"\w*. \v 25 \w But in the fifth|strong="H02549"\w* \w year|strong="H08141"\w* \w you may eat|strong="H00398"\w* \w -|strong="H00853"\w* \w its fruit|strong="H06529"\w*; thus your \w harvest|strong="H08393"\w* \w will be increased|strong="H03254"\w*. \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*.
