\s1 Laws about Mildew
\p \v 47 \w If|strong="H03588"\w* \w any fabric|strong="H00899"\w* \w is|strong="H01961"\w* vvv \w contaminated|strong="H05061"\w* \w with mildew|strong="H06883"\w*\f + \fr 13:47 \ft Forms of the Hebrew \fqa tzaraath\ft , traditionally translated as \fqa leprosy \ft regarding skin diseases, are translated as \fqa mildew \ft regarding blemishes on garments, utensils, or buildings; here and throughout the remainder of this chapter.\f*— \w any wool|strong="H06785"\w* \w or|strong="H00176"\w* \w . . .|strong="H00899"\w* \w linen|strong="H06593"\w* \w garment|strong="H00899"\w*, \v 48 \w -|strong="H00176"\w* \w any weave|strong="H08359"\w* \w or|strong="H00176"\w* \w knit|strong="H06154"\w* \w of linen|strong="H06593"\w* \w or wool|strong="H06785"\w*, \w or|strong="H00176"\w* \w any article of leather|strong="H05785"\w* \w . . .|strong="H00176"\w* \w . . .|strong="H03605"\w* \w -|strong="H04399"\w* \w -|strong="H05785"\w*— \v 49 \w and if the mark|strong="H05061"\w* \w in the fabric|strong="H00899"\w*,\w . . .|strong="H00176"\w* \w leather|strong="H05785"\w*, \w -|strong="H00176"\w* \w weave|strong="H08359"\w*, \w -|strong="H00176"\w* \w knit|strong="H06154"\w*, \w or|strong="H00176"\w* \w -|strong="H03605"\w* \w leather|strong="H05785"\w* \w article|strong="H03627"\w* \w is|strong="H01961"\w* \w green|strong="H03422"\w* \w or|strong="H00176"\w* \w red|strong="H00125"\w*, \w then it is|strong="H01931"\w* \w contaminated|strong="H05061"\w* \w with mildew|strong="H06883"\w* \w and must be shown|strong="H07200"\w* \w -|strong="H00853"\w* \w to the priest|strong="H03548"\w*. \v 50 \w And the priest|strong="H03548"\w* \w -|strong="H00853"\w* \w is to examine|strong="H07200"\w* \w the mildew|strong="H05061"\w* \w and isolate|strong="H05462"\w* \w -|strong="H00853"\w* \w the contaminated [fabric]|strong="H05061"\w* \w for seven|strong="H07651"\w* \w days|strong="H03117"\w*.
