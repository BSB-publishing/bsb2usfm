\p \v 22 \w When|strong="H00834"\w* \w a leader|strong="H05387"\w* \w sins|strong="H02398"\w* \w unintentionally|strong="H07684"\w* \w and does|strong="H06213"\w* \w what|strong="H00834"\w* \w is prohibited|strong="H03808"\w* \w by any|strong="H00259"\w* \w of|strong="H03605"\w* \w the commandments|strong="H04687"\w* \w of the LORD|strong="H03068"\w* \w his God|strong="H00430"\w* \w . . .|strong="H06213"\w*, \w he incurs guilt|strong="H00816"\w*. \v 23 \w -|strong="H00176"\w* \w When he becomes aware|strong="H03045"\w* \w . . .|strong="H00413"\w* \w of the sin|strong="H02403"\w* \w -|strong="H00834"\w* \w he has committed|strong="H02398"\w*, \w he must bring|strong="H00935"\w* \w -|strong="H00853"\w* \w an unblemished|strong="H08549"\w* \w male goat|strong="H08163"\w* \w . . .|strong="H05795"\w* \w . . .|strong="H02145"\w* \w as his offering|strong="H07133"\w*. \v 24 \w He is to lay|strong="H05564"\w* \w his hand|strong="H03027"\w* \w on|strong="H05921"\w* \w the head|strong="H07218"\w* \w of the goat|strong="H08163"\w* \w and slaughter|strong="H07819"\w* \w -|strong="H00853"\w* \w it at the place|strong="H04725"\w* \w where|strong="H00834"\w* \w the burnt offering|strong="H05930"\w* \w is slaughtered|strong="H07819"\w* \w -|strong="H00853"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*. \w It|strong="H01931"\w* \w is a sin offering|strong="H02403"\w*. \v 25 \w Then the priest|strong="H03548"\w* \w is to take|strong="H03947"\w* \w some of the blood|strong="H01818"\w* \w of the sin offering|strong="H02403"\w* \w with his finger|strong="H00676"\w*, \w put it|strong="H05414"\w* \w on|strong="H05921"\w* \w the horns|strong="H07161"\w* \w of the altar|strong="H04196"\w* \w of burnt offering|strong="H05930"\w*, \w and|strong="H00853"\w* \w pour out|strong="H08210"\w* \w the rest of the blood|strong="H01818"\w* \w at|strong="H00413"\w* \w the base|strong="H03247"\w* \w of the altar|strong="H04196"\w* \w -|strong="H05930"\w*. \v 26 \w -|strong="H00853"\w* \w