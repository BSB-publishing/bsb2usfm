\p \v 8 \w vvv|strong="H03808"\w* \w You must not eat|strong="H00398"\w* \w their meat|strong="H01320"\w* \w or touch|strong="H05060"\w* \w their carcasses|strong="H05038"\w*; \w . . .|strong="H03808"\w* \w they|strong="H01992"\w* \w are unclean|strong="H02931"\w* for you.
\p \v 9 \w -|strong="H00853"\w* \w Of all [the creatures]|strong="H03605"\w* \w that [live]|strong="H00834"\w* \w in the water|strong="H04325"\w*, \w whether in the seas|strong="H03220"\w* \w or in the streams|strong="H05158"\w* \w -|strong="H00853"\w*, \w -|strong="H00398"\w* \w you may eat|strong="H00398"\w* \w -|strong="H02088"\w* \w anything|strong="H03605"\w*\w . . .|strong="H00834"\w* \w with fins|strong="H05579"\w* \w and scales|strong="H07193"\w* \w . . .|strong="H04325"\w*.
\p \v 10 \w But the following|strong="H01992"\w* \w among all|strong="H03605"\w* \w the teeming|strong="H08318"\w* \w life|strong="H02416"\w* \w -|strong="H00834"\w* \w -|strong="H04325"\w* \w and creatures|strong="H05315"\w* \w in the water|strong="H04325"\w* \w are detestable|strong="H08263"\w* to you: \w everything|strong="H03605"\w* \w in the seas|strong="H03220"\w* \w or streams|strong="H05158"\w* \w that|strong="H00834"\w* \w does not|strong="H00369"\w* \w have fins|strong="H05579"\w* \w and scales|strong="H07193"\w* \w . . .|strong="H03605"\w*. \v 11 \w They shall be|strong="H01961"\w* \w an abomination|strong="H08263"\w* to you; \w you must not|strong="H03808"\w* \w eat|strong="H00398"\w* \w -|strong="H00853"\w* \w their meat|strong="H01320"\w*, \w and you must detest|strong="H08262"\w* \w their carcasses|strong="H05038"\w*. \v 12 \w Everything|strong="H03605"\w* \w in the water|strong="H04325"\w* \w that|strong="H00834"\w* \w does not|strong="H00369"\w* have \w fins|strong="H05579"\w* \w and scales|strong="H07193"\w* \w shall be detestable|strong="H08263"\w* \w . . .|strong="H01931"\w* to you.
\p \v 13 \w Additionally|strong="H00853"\w*, \w you are to detest|strong="H08262"\w* \w . . .|strong="H04480"\w* \w the following|strong="H00428"\w* \w birds|strong="H05775"\w*, \w and they must not|strong="H03808"\w* \w be eaten|strong="H00398"\w* \w because they|strong="H01992"\w* \w -|strong="H00853"\w* \w are detestable|strong="H08263"\w*:
\b 
\li1 \w the eagle|strong="H05404"\w*, \w -|strong="H00853"\w* \w the bearded vulture|strong="H06538"\w*, \w -|strong="H00853"\w* \w the black vulture|strong="H05822"\w*,
\li1 \v 14 \w -|strong="H00853"\w* \w the kite|strong="H01676"\w*, \w -|strong="H00853"\w* \w any kind|strong="H04327"\w* \w of falcon|strong="H00344"\w*,
