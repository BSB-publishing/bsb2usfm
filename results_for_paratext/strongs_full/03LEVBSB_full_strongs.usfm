\s1 Laws against Eating Blood
\p \v 10 \w If anyone|strong="H00376"\w* \w . . .|strong="H00376"\w* \w from|strong="H04480"\w* \w the house|strong="H01004"\w* \w of Israel|strong="H03478"\w* \w or a foreigner|strong="H01616"\w* \w living|strong="H01481"\w* \w among them|strong="H08432"\w* \w -|strong="H00834"\w* \w eats|strong="H00398"\w* \w any|strong="H03605"\w* \w blood|strong="H01818"\w*, \w I will set|strong="H05414"\w* \w My face|strong="H06440"\w* \w against that person|strong="H05315"\w* \w -|strong="H00398"\w* \w -|strong="H00853"\w* \w -|strong="H01818"\w* \w and cut him off|strong="H03772"\w* \w -|strong="H00853"\w* \w from among|strong="H07130"\w* \w his people|strong="H05971"\w*. \v 11 \w For|strong="H03588"\w* \w the life|strong="H05315"\w*\f + \fr 17:11 \ft Literally \fqa the soul\ft ; also in verse 14\f* \w of the flesh|strong="H01320"\w* \w is in the blood|strong="H01818"\w*, \w and I|strong="H00589"\w* \w have given|strong="H05414"\w* \w it|strong="H01931"\w* to you \w to make atonement|strong="H03722"\w* \w for|strong="H05921"\w* \w your souls|strong="H05315"\w* \w upon|strong="H05921"\w* \w the altar|strong="H04196"\w*; \w for|strong="H03588"\w* \w it [is]|strong="H01931"\w* \w the blood|strong="H01818"\w* \w [that] makes atonement|strong="H03722"\w* \w for the soul|strong="H05315"\w*. \v 12 \w Therefore|strong="H05921"\w* \w . . .|strong="H03651"\w* \w I say|strong="H00559"\w* \w to the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*, ‘\w None|strong="H03605"\w* \w . . .|strong="H05315"\w* \w . . .|strong="H03808"\w* of you \w may eat|strong="H00398"\w* \w blood|strong="H01818"\w*, \w nor may|strong="H03808"\w* \w any foreigner|strong="H01616"\w* \w living|strong="H01481"\w* \w among you|strong="H08432"\w* \w eat|strong="H00398"\w* \w blood|strong="H01818"\w*.’
\p \v 13 \w And if any|strong="H00376"\w* \w . . .|strong="H00376"\w* \w Israelite|strong="H01121"\w* \w . . .|strong="H03478"\w* \w . . .|strong="H04480"\w* \w or foreigner|strong="H01616"\w* \w living|strong="H01481"\w* \w among them|strong="H08432"\w* \w -|strong="H00834"\w* \w hunts down|strong="H06679"\w* \w a wild|strong="H02416"\w* \w animal|strong="H06718"\w* \w or|strong="H00176"\w* \w bird|strong="H05775"\w* \w that|strong="H00834"\w* \w may be eaten|strong="H00398"\w*, \w he must drain|strong="H08210"\w* \w -|strong="H00853"\w* \w its blood|strong="H01818"\w* \w and cover|strong="H03680"\w* \w it with dirt|strong="H06083"\w*. \v 14 \w For|strong="H03588"\w* \w the life|strong="H05315"\w* \w of all|strong="H03605"\w* \w flesh|strong="H01320"\w* \w is its blood|strong="H01818"\w*\w . . .|strong="H05315"\w* \w -|strong="H01931"\w*. \w Therefore I have told|strong="H00559"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*, ‘\w You must not|strong="H03808"\w* \w eat|strong="H00398"\w* \w the blood|strong="H01818"\w* \w of any|strong="H03605"\w* \w living thing|strong="H01320"\w*, \w because|strong="H03588"\w* \w the life|strong="H05315"\w* \w of all|strong="H03605"\w* \w flesh|strong="H01320"\w* \w is its blood|strong="H01818"\w*; \w whoever|strong="H01931"\w* \w . . .|strong="H03605"\w* \w eats it|strong="H00398"\w* \w must be cut off|strong="H03772"\w*.’
\p \v 15 \w And any|strong="H03605"\w* \w person|strong="H05315"\w*, \w whether native|strong="H00249"\w* \w or foreigner|strong="H01616"\w*, \w who|strong="H00834"\w* \w eats|strong="H00398"\w* \w anything found dead|strong="H05038"\w* \w or mauled by wild beasts|strong="H02966"\w* \w must wash|strong="H03526"\w* \w his clothes|strong="H00899"\w* \w and bathe|strong="H07364"\w* \w with water|strong="H04325"\w*, \w and he will be unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*; \w then he will be clean|strong="H02891"\w*. \v 16 \w But if|strong="H00518"\w* \w he does not|strong="H03808"\w* \w wash|strong="H03526"\w* \w his clothes and bathe|strong="H07364"\w* \w himself|strong="H01320"\w*, \w . . .|strong="H03808"\w* \w then he shall bear|strong="H05375"\w* \w his iniquity|strong="H05771"\w*.”
