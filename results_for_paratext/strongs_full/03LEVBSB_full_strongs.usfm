\c 14
\s1 Cleansing from Skin Diseases
\r (Matthew 8:1–4; Mark 1:40–45; Luke 5:12–16)
\p \v 1 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00559"\w*, \v 2 “\w This|strong="H02063"\w* \w is|strong="H01961"\w* \w the law|strong="H08451"\w* \w for the one afflicted with a skin disease|strong="H06879"\w*\f + \fr 14:2 \ft Forms of the Hebrew \fqa tzaraath\ft , traditionally translated as \fqa leprosy\ft , were used for various skin diseases; also in verses 3, 7, 32, 54, and 57.\f* \w on the day|strong="H03117"\w* \w of his cleansing|strong="H02893"\w*, \w when he is brought|strong="H00935"\w* \w to|strong="H00413"\w* \w the priest|strong="H03548"\w*. \v 3 \w The priest|strong="H03548"\w* \w . . .|strong="H00413"\w* \w is to go|strong="H03318"\w* \w outside|strong="H02351"\w* \w the camp|strong="H04264"\w* \w to examine him|strong="H07200"\w*, \w . . .|strong="H03548"\w* \w and if|strong="H02009"\w* \w the skin disease|strong="H06883"\w* \w of|strong="H04480"\w* \w the afflicted person|strong="H06879"\w* \w has healed|strong="H07495"\w* \w . . .|strong="H05061"\w*, \v 4 \w the priest|strong="H03548"\w* \w shall order|strong="H06680"\w* \w that two|strong="H08147"\w* \w live|strong="H02416"\w* \w clean|strong="H02889"\w* \w birds|strong="H06833"\w*, \w cedar|strong="H00730"\w* \w wood|strong="H06086"\w*, \w scarlet yarn|strong="H08144"\w* \w . . .|strong="H08438"\w*, \w and hyssop|strong="H00231"\w* \w be brought|strong="H03947"\w* \w for the one to be cleansed|strong="H02891"\w*.
\p \v 5 \w Then the priest|strong="H03548"\w* \w shall command|strong="H06680"\w* \w that one|strong="H00259"\w* \w of the birds|strong="H06833"\w* \w be slaughtered|strong="H07819"\w* \w -|strong="H00853"\w* \w over|strong="H05921"\w* \w fresh|strong="H02416"\w* \w water|strong="H04325"\w*\f + \fr 14:5 \ft Or \fqa flowing water \ft or \fqa living water\ft ; here and in verses 6, 50, 51, and 52\f* \w in|strong="H00413"\w* \w a clay|strong="H02789"\w* \w pot|strong="H03627"\w*. \v 6 \w -|strong="H00853"\w* \w And he is to take|strong="H03947"\w* \w -|strong="H00853"\w* \w -|strong="H00853"\w* \w the live|strong="H02416"\w* \w bird|strong="H06833"\w* \w together with the cedar|strong="H00730"\w* \w -|strong="H00853"\w* \w wood|strong="H06086"\w*, \w scarlet yarn|strong="H08144"\w* \w . . .|strong="H08438"\w*, \w -|strong="H00853"\w* \w and hyssop|strong="H00231"\w*, \w and dip|strong="H02881"\w* \w -|strong="H00853"\w* \w them|strong="H00853"\w* \w into the blood|strong="H01818"\w* \w . . .|strong="H06833"\w* \w of the bird|strong="H06833"\w* \w that was slaughtered|strong="H07819"\w* \w over|strong="H05921"\w*\w . . .|strong="H02416"\w* \w the fresh|strong="H02416"\w* \w water|strong="H04325"\w*. \v 7 \w Seven|strong="H07651"\w* \w times|strong="H06471"\w* \w he shall sprinkle|strong="H05137"\w* \w . . .|strong="H05921"\w* \w the one to be cleansed|strong="H02891"\w* \w of|strong="H04480"\w* \w the skin disease|strong="H06883"\w*. \w Then he shall pronounce him clean|strong="H02891"\w* \w and release|strong="H07971"\w* \w -|strong="H00853"\w* \w the live|strong="H02416"\w* \w bird|strong="H06833"\w* \w into|strong="H05921"\w* \w the open|strong="H06440"\w* \w field|strong="H07704"\w*.
\p \v 8 \w The one being cleansed|strong="H02891"\w* \w -|strong="H00853"\w* \w must wash|strong="H03526"\w* \w his clothes|strong="H00899"\w*, \w shave off|strong="H01548"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w his hair|strong="H08181"\w*, \w and bathe|strong="H07364"\w* \w with water|strong="H04325"\w*; \w then he will be ceremonially clean|strong="H02891"\w*. \w Afterward|strong="H00310"\w*, \w he may enter|strong="H00935"\w* \w . . .|strong="H00413"\w* \w the camp|strong="H04264"\w*, \w but he must remain|strong="H03427"\w* \w outside|strong="H02351"\w* \w his tent|strong="H00168"\w* \w for seven|strong="H07651"\w* \w days|strong="H03117"\w*. \v 9 \w On the seventh|strong="H07637"\w* \w day|strong="H03117"\w* \w . . .|strong="H01961"\w* \w he must shave off|strong="H01548"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w his hair|strong="H08181"\w* — \w -|strong="H00853"\w* \w his head|strong="H07218"\w*, \w -|strong="H00853"\w* \w his beard|strong="H02206"\w*, \w -|strong="H00853"\w* \w his eyebrows|strong="H01354"\w* \w . . .|strong="H05869"\w*, \w -|strong="H00853"\w* \w and the rest|strong="H03605"\w* \w of his hair|strong="H08181"\w*. \w . . .|strong="H01548"\w* \w He must wash|strong="H03526"\w* \w -|strong="H00853"\w* \w his clothes|strong="H00899"\w* \w and bathe|strong="H07364"\w* \w -|strong="H00853"\w* \w himself|strong="H01320"\w* \w with water|strong="H04325"\w*, \w and he will be clean|strong="H02891"\w*.
\p \v 10 \w On the eighth|strong="H08066"\w* \w day|strong="H03117"\w* \w he is to bring|strong="H03947"\w* \w two|strong="H08147"\w* \w unblemished|strong="H08549"\w* \w male lambs|strong="H03532"\w*, \w an|strong="H00259"\w* \w unblemished|strong="H08549"\w* \w ewe lamb|strong="H03535"\w* \w a year old|strong="H01323"\w* \w . . .|strong="H08141"\w*, \w a grain offering|strong="H04503"\w* \w of three-tenths [of an ephah]|strong="H07969"\w* \w . . .|strong="H06241"\w* \w of fine flour|strong="H05560"\w*\f + \fr 14:10 \fqa Three-tenths of an ephah \ft is approximately 6 dry quarts or 6.6 liters (probably about 7.6 pounds or 3.5 kilograms of flour).\f* \w mixed|strong="H01101"\w* \w with olive oil|strong="H08081"\w*, \w and one|strong="H00259"\w* \w log|strong="H03849"\w* \w of olive oil|strong="H08081"\w*.\f + \fr 14:10 \ft Or \fqa one log of oil\ft ; that is, approximately 0.33 quarts or 0.31 liters; also in verses 12, 15, 21, and 24\f* \v 11 \w The priest|strong="H03548"\w* \w who performs the cleansing|strong="H02891"\w* \w -|strong="H00853"\w* \w shall present|strong="H05975"\w* \w the one|strong="H00376"\w* \w to be cleansed|strong="H02891"\w*, \w together with these offerings|strong="H00854"\w*, \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w at the entrance|strong="H06607"\w* \w to the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*.
\p \v 12 \w Then the priest|strong="H03548"\w* \w -|strong="H00853"\w* \w is to take|strong="H03947"\w* \w one|strong="H00259"\w* \w of the male lambs|strong="H03532"\w* \w and present|strong="H07126"\w* \w -|strong="H00853"\w* \w it as a guilt offering|strong="H00817"\w*, \w -|strong="H00853"\w* \w along with the log|strong="H03849"\w* \w of olive oil|strong="H08081"\w*; \w and he must wave|strong="H05130"\w* \w them|strong="H00853"\w* \w as a wave offering|strong="H08573"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*. \v 13 \w Then he is to slaughter|strong="H07819"\w* \w -|strong="H00853"\w* \w the lamb|strong="H03532"\w* \w in the sanctuary|strong="H06944"\w* \w area|strong="H04725"\w*\w . . .|strong="H04725"\w* \w where|strong="H00834"\w* \w the sin offering|strong="H02403"\w* \w -|strong="H00853"\w* \w and burnt offering|strong="H05930"\w* \w are slaughtered|strong="H07819"\w*. \w -|strong="H00853"\w* \w Like|strong="H03588"\w* \w the sin offering|strong="H02403"\w*, \w the guilt offering|strong="H00817"\w* \w belongs to the priest|strong="H03548"\w*; \w it|strong="H01931"\w* \w [is] most|strong="H06944"\w* \w holy|strong="H06944"\w* \w . . .|strong="H01931"\w*.
\p \v 14 \w The priest|strong="H03548"\w* \w is to take|strong="H03947"\w* \w [some] of the blood|strong="H01818"\w* \w from the guilt offering|strong="H00817"\w* \w and put it|strong="H05414"\w* \w . . .|strong="H03548"\w* \w on|strong="H05921"\w* \w the right|strong="H03233"\w* \w earlobe|strong="H00241"\w* \w . . .|strong="H08571"\w* \w of the one to be cleansed|strong="H02891"\w*, \w on|strong="H05921"\w* \w the thumb|strong="H00931"\w* \w of his right|strong="H03233"\w* \w hand|strong="H03027"\w*, \w and on|strong="H05921"\w* \w the big toe|strong="H00931"\w* \w of his right|strong="H03233"\w* \w foot|strong="H07272"\w*. \v 15 \w Then the priest|strong="H03548"\w* \w shall take|strong="H03947"\w* \w [some] of the log|strong="H03849"\w* \w of olive oil|strong="H08081"\w*, \w pour|strong="H03332"\w* \w it into|strong="H05921"\w* \w his|strong="H03548"\w* \w left|strong="H08042"\w* \w palm|strong="H03709"\w*, \v 16 \w -|strong="H03548"\w* \w -|strong="H00853"\w* \w dip|strong="H02881"\w* \w his right|strong="H03233"\w* \w forefinger|strong="H00676"\w* \w into|strong="H04480"\w* \w the oil|strong="H08081"\w* \w -|strong="H00834"\w* \w in|strong="H05921"\w* \w his left|strong="H08042"\w* \w palm|strong="H03709"\w*, \w and sprinkle|strong="H05137"\w* \w some of|strong="H04480"\w* \w the oil|strong="H08081"\w* \w with his finger|strong="H00676"\w* \w seven|strong="H07651"\w* \w times|strong="H06471"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*. \v 17 \w And the priest|strong="H03548"\w* \w is to put|strong="H05414"\w* \w some|strong="H05921"\w* \w of the oil|strong="H08081"\w* \w -|strong="H00834"\w* \w remaining|strong="H03499"\w* \w in|strong="H05921"\w* \w his palm|strong="H03709"\w* \w on the right|strong="H03233"\w* \w earlobe|strong="H00241"\w* \w . . .|strong="H08571"\w* \w of the one to be cleansed|strong="H02891"\w*, \w on|strong="H05921"\w* \w the thumb|strong="H00931"\w* \w of his right|strong="H03233"\w* \w hand|strong="H03027"\w*, \w and on|strong="H05921"\w* \w the big toe|strong="H00931"\w* \w of his right|strong="H03233"\w* \w foot|strong="H07272"\w*, \w on top of|strong="H05921"\w* \w the blood|strong="H01818"\w* \w of the guilt offering|strong="H00817"\w*.
\p \v 18 \w The rest|strong="H03498"\w* \w of the oil|strong="H08081"\w* \w -|strong="H00834"\w* \w in his|strong="H05921"\w* \w palm|strong="H03709"\w*, \w the priest|strong="H03548"\w* \w is to put|strong="H05414"\w* \w on|strong="H05921"\w* \w the head|strong="H07218"\w* \w of the one to be cleansed|strong="H02891"\w*, \w -|strong="H03548"\w* \w to make atonement|strong="H03722"\w* \w for him|strong="H05921"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*. \v 19 \w Then the priest|strong="H03548"\w* \w -|strong="H00853"\w* \w is to sacrifice|strong="H06213"\w* \w the sin offering|strong="H02403"\w* \w and make atonement|strong="H03722"\w* \w for|strong="H05921"\w* \w the one to be cleansed|strong="H02891"\w* \w from his uncleanness|strong="H02932"\w*. \w After that|strong="H00310"\w*, \w [the priest] shall slaughter|strong="H07819"\w* \w -|strong="H00853"\w* \w the burnt offering|strong="H05930"\w* \v 20 \w -|strong="H03548"\w* \w -|strong="H00853"\w* \w and offer|strong="H05927"\w* \w [it]|strong="H05930"\w* \w on the altar|strong="H04196"\w*, \w with|strong="H00853"\w* \w the grain offering|strong="H04503"\w*, \w -|strong="H03548"\w* \w to make atonement|strong="H03722"\w* \w for him|strong="H05921"\w*, \w and he will be clean|strong="H02891"\w*.
\p \v 21 \w If, however|strong="H00518"\w*, \w [the person]|strong="H01931"\w* \w is poor|strong="H01800"\w* \w and cannot|strong="H00369"\w* \w afford these [offerings]|strong="H03027"\w* \w . . .|strong="H05381"\w*, \w he is to take|strong="H03947"\w* \w one|strong="H00259"\w* \w male lamb|strong="H03532"\w* \w as a guilt offering|strong="H00817"\w* \w to be waved|strong="H08573"\w* \w to make atonement|strong="H03722"\w* \w for him|strong="H05921"\w*, \w along with a tenth [of an ephah]|strong="H06241"\w* \w of fine flour|strong="H05560"\w*\f + \fr 14:21 \fqa A tenth of an ephah \ft is approximately 2 dry quarts or 2.2 liters (probably about 2.6 pounds or 1.2 kilograms of flour).\f* \w . . .|strong="H00259"\w* \w mixed|strong="H01101"\w* \w with olive oil|strong="H08081"\w* \w for a grain offering|strong="H04503"\w*, \w a log|strong="H03849"\w* \w of olive oil|strong="H08081"\w*, \v 22 \w and two|strong="H08147"\w* \w turtledoves|strong="H08449"\w* \w or|strong="H00176"\w* \w two|strong="H08147"\w* \w young|strong="H01121"\w* \w pigeons|strong="H03123"\w*, \w whichever|strong="H00834"\w* \w he can afford|strong="H05381"\w* \w . . .|strong="H03027"\w*, \w one|strong="H00259"\w* \w to be|strong="H01961"\w* \w a sin offering|strong="H02403"\w* \w and the other|strong="H00259"\w* \w a burnt offering|strong="H05930"\w*.
\p \v 23 \w On the eighth|strong="H08066"\w* \w day|strong="H03117"\w* \w he is to bring|strong="H00935"\w* \w them|strong="H00853"\w* \w for his cleansing|strong="H02893"\w* \w to|strong="H00413"\w* \w the priest|strong="H03548"\w* \w at|strong="H00413"\w* \w the entrance|strong="H06607"\w* \w to the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*. \v 24 \w The priest|strong="H03548"\w* \w -|strong="H00853"\w* \w shall take|strong="H03947"\w* \w the lamb|strong="H03532"\w* \w for the guilt offering|strong="H00817"\w*, \w along with|strong="H00853"\w* \w the log|strong="H03849"\w* \w of olive oil|strong="H08081"\w*, \w and wave|strong="H05130"\w* \w them|strong="H00853"\w* \w . . .|strong="H03548"\w* \w as a wave offering|strong="H08573"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*.
\p \v 25 \w And after he slaughters|strong="H07819"\w* \w -|strong="H00853"\w* \w the lamb|strong="H03532"\w* \w for the guilt offering|strong="H00817"\w*, \w the priest|strong="H03548"\w* \w is to take|strong="H03947"\w* \w [some] of the blood|strong="H01818"\w* \w of the guilt offering|strong="H00817"\w* \w and put|strong="H05414"\w* \w it on|strong="H05921"\w* \w the right|strong="H03233"\w* \w earlobe|strong="H08571"\w* \w . . .|strong="H00241"\w* \w of the one to be cleansed|strong="H02891"\w*, \w on|strong="H05921"\w* \w the thumb|strong="H00931"\w* \w of his right|strong="H03233"\w* \w hand|strong="H03027"\w*, \w and on|strong="H05921"\w* \w the big toe|strong="H00931"\w* \w of his right|strong="H03233"\w* \w foot|strong="H07272"\w*. \v 26 \w Then the priest|strong="H03548"\w* \w is to pour|strong="H03332"\w* \w some of|strong="H04480"\w* \w the oil|strong="H08081"\w* \w into|strong="H05921"\w* \w his|strong="H03548"\w* \w left|strong="H08042"\w* \w palm|strong="H03709"\w* \v 27 \w -|strong="H03548"\w* \w and sprinkle|strong="H05137"\w* \w with his right|strong="H03233"\w* \w forefinger|strong="H00676"\w* \w some of|strong="H04480"\w* \w the oil|strong="H08081"\w* \w -|strong="H00834"\w* \w in|strong="H05921"\w* \w his left|strong="H08042"\w* \w palm|strong="H03709"\w* \w seven|strong="H07651"\w* \w times|strong="H06471"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*. \v 28 \w The priest|strong="H03548"\w* \w shall also put|strong="H05414"\w* \w some of|strong="H04480"\w* \w the oil|strong="H08081"\w* \w -|strong="H00834"\w* \w in|strong="H05921"\w* \w his palm|strong="H03709"\w* \w on|strong="H05921"\w* \w the right|strong="H03233"\w* \w earlobe|strong="H08571"\w* \w . . .|strong="H00241"\w* \w of the one to be cleansed|strong="H02891"\w*, \w on|strong="H05921"\w* \w the thumb|strong="H00931"\w* \w of his right|strong="H03233"\w* \w hand|strong="H03027"\w*, \w and on|strong="H05921"\w* \w the big toe|strong="H00931"\w* \w of his right|strong="H03233"\w* \w foot|strong="H07272"\w* — \w on|strong="H05921"\w* \w the same places|strong="H04725"\w* \w as the blood|strong="H01818"\w* \w of the guilt offering|strong="H00817"\w*.
\p \v 29 \w The rest|strong="H03498"\w* \w of|strong="H04480"\w* \w the oil|strong="H08081"\w* \w -|strong="H00834"\w* \w in his|strong="H05921"\w* \w palm|strong="H03709"\w*, \w the priest|strong="H03548"\w* \w is to put|strong="H05414"\w* \w on|strong="H05921"\w* \w the head|strong="H07218"\w* \w of the one to be cleansed|strong="H02891"\w*, \w to make atonement|strong="H03722"\w* \w for him|strong="H05921"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*. \v 30 \w Then he must sacrifice|strong="H06213"\w* \w -|strong="H00853"\w* \w -|strong="H00259"\w* \w -|strong="H04480"\w* \w the turtledoves|strong="H08449"\w* \w or|strong="H00176"\w* \w . . .|strong="H04480"\w* \w young|strong="H01121"\w* \w pigeons|strong="H03123"\w*, \w whichever|strong="H00834"\w* \w he can afford|strong="H05381"\w* \w . . .|strong="H03027"\w*, \v 31 \w -|strong="H00853"\w* \w -|strong="H00834"\w* \w -|strong="H05381"\w* \w -|strong="H03027"\w* \w -|strong="H00853"\w* \w one|strong="H00259"\w* \w as a sin offering|strong="H02403"\w* \w -|strong="H00853"\w* \w and the other|strong="H00259"\w* \w as a burnt offering|strong="H05930"\w*,\f + \fr 14:31 \ft LXX and Syriac; Hebrew includes \fqa as he is able to afford,\f* \w together with|strong="H05921"\w* \w the grain offering|strong="H04503"\w*. \w In this way the priest|strong="H03548"\w* \w will make atonement|strong="H03722"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w for|strong="H05921"\w* \w the one to be cleansed|strong="H02891"\w*.
\p \v 32 \w This|strong="H02063"\w* \w is the law|strong="H08451"\w* \w for someone who has|strong="H00834"\w* . . . \w . . .|strong="H05061"\w* \w a skin disease|strong="H06883"\w* \w -|strong="H00834"\w* \w and cannot|strong="H03808"\w* \w afford|strong="H05381"\w* \w . . .|strong="H03027"\w* \w the cost of his cleansing|strong="H02893"\w*.”
\s1 Signs of Home Contamination
\p \v 33 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00413"\w* \w and Aaron|strong="H00175"\w* \w . . .|strong="H00559"\w*, \v 34 “\w When|strong="H03588"\w* \w you enter|strong="H00935"\w* \w . . .|strong="H00413"\w* \w the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*, \w which|strong="H00834"\w* \w I|strong="H00589"\w* \w am giving|strong="H05414"\w* you \w as your possession|strong="H00272"\w*, \w and I put|strong="H05414"\w* \w a contamination|strong="H05061"\w* \w of mildew|strong="H06883"\w*\f + \fr 14:34 \ft Forms of the Hebrew \fqa tzaraath\ft , traditionally translated as \fqa leprosy \ft regarding skin diseases, are translated as \fqa mildew \ft regarding blemishes on garments, utensils, or buildings; here and throughout the remainder of this chapter.\f* \w into a house|strong="H01004"\w* \w in that land|strong="H00776"\w* \w -|strong="H00272"\w*, \v 35 \w the owner|strong="H00834"\w* \w of the house|strong="H01004"\w* \w shall come|strong="H00935"\w* \w and tell|strong="H05046"\w* \w the priest|strong="H03548"\w* \w . . .|strong="H00559"\w*, ‘\w Something like mildew|strong="H05061"\w* \w has appeared|strong="H07200"\w* in my \w house|strong="H01004"\w*.’
\p \v 36 \w The priest|strong="H03548"\w* \w must order that|strong="H06680"\w* \w the house|strong="H01004"\w* \w be cleared|strong="H06437"\w* \w -|strong="H00853"\w* \w before|strong="H02962"\w* \w he|strong="H03548"\w* \w enters it|strong="H00935"\w* \w to examine|strong="H07200"\w* \w -|strong="H00853"\w* \w the mildew|strong="H05061"\w*, \w so that nothing|strong="H03808"\w* \w . . .|strong="H03605"\w* \w -|strong="H00834"\w* \w in the house|strong="H01004"\w* \w will become unclean|strong="H02930"\w*. \w After|strong="H00310"\w* \w this|strong="H03651"\w*, \w the priest|strong="H03548"\w* \w shall go in|strong="H00935"\w* \w to inspect|strong="H07200"\w* \w -|strong="H00853"\w* \w the house|strong="H01004"\w*.
