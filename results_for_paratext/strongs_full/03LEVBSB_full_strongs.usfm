\c 9
\s1 Aaron’s First Offerings
\p \v 1 \w -|strong="H01961"\w* \w On the eighth|strong="H08066"\w* \w day|strong="H03117"\w* \w Moses|strong="H04872"\w* \w summoned|strong="H07121"\w* \w Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w* \w and the elders|strong="H02205"\w* \w of Israel|strong="H03478"\w*. \v 2 \w He said|strong="H00559"\w* \w to|strong="H00413"\w* \w Aaron|strong="H00175"\w*, “\w Take|strong="H03947"\w* for yourself \w a young bull|strong="H05695"\w* \w . . .|strong="H01121"\w* \w . . .|strong="H01241"\w* \w for a sin offering|strong="H02403"\w* \w and a ram|strong="H00352"\w* \w for a burnt offering|strong="H05930"\w*, \w both without blemish|strong="H08549"\w*, \w and present them|strong="H07126"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*. \v 3 \w Then speak|strong="H01696"\w* \w to|strong="H00413"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w [and] say|strong="H00559"\w*, ‘\w Take|strong="H03947"\w* \w a male goat|strong="H08163"\w* \w . . .|strong="H05795"\w* \w for a sin offering|strong="H02403"\w*, \w a calf|strong="H05695"\w* \w and a lamb|strong="H03532"\w* — \w both a year old|strong="H01121"\w* \w . . .|strong="H08141"\w* \w [and] without blemish|strong="H08549"\w* — \w for a burnt offering|strong="H05930"\w*, \v 4 \w an ox|strong="H07794"\w*\f + \fr 9:4 \ft Or \fqa a bull \ft or \fqa a cow\ft ; also in verses 18 and 19\f* \w and a ram|strong="H00352"\w* \w for a peace offering|strong="H08002"\w* \w to sacrifice|strong="H02076"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*, \w and a grain offering|strong="H04503"\w* \w mixed|strong="H01101"\w* \w with oil|strong="H08081"\w*. \w For|strong="H03588"\w* \w today|strong="H03117"\w* \w the LORD|strong="H03068"\w* \w will appear|strong="H07200"\w* \w to you|strong="H00413"\w*.’”
