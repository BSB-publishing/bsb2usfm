\p \v 30 \w Thus any|strong="H03605"\w* \w tithe|strong="H04643"\w* \w from the land|strong="H00776"\w*, \w [whether] from the seed|strong="H02233"\w* \w of the land|strong="H00776"\w* \w or the fruit|strong="H06529"\w* \w of the trees|strong="H06086"\w*, \w belongs to the LORD|strong="H03068"\w*; \w it|strong="H01931"\w* \w is holy|strong="H06944"\w* \w to the LORD|strong="H03068"\w*. \v 31 \w If|strong="H00518"\w* \w a man|strong="H00376"\w* \w wishes|strong="H01350"\w* \w to redeem|strong="H01350"\w* \w part of his tithe|strong="H04643"\w*, \w he must add|strong="H03254"\w* \w a fifth|strong="H02549"\w* \w to its value|strong="H05921"\w*.
