\p \v 27 \w And if|strong="H00518"\w* \w one|strong="H05315"\w* \w . . .|strong="H00259"\w* \w of the common|strong="H00776"\w* \w people|strong="H05971"\w* \w sins|strong="H02398"\w* \w unintentionally|strong="H07684"\w* \w and does what|strong="H00834"\w* \w is prohibited|strong="H03808"\w* \w . . .|strong="H06213"\w* \w -|strong="H06213"\w* \w by any|strong="H00259"\w* \w of the LORD’s|strong="H03068"\w* \w commandments|strong="H04687"\w*, \w he incurs guilt|strong="H00816"\w*. \v 28 \w -|strong="H00176"\w* \w When he becomes aware|strong="H03045"\w* \w . . .|strong="H00413"\w* \w of the sin|strong="H02403"\w*\w . . .|strong="H00834"\w* \w he has committed|strong="H02398"\w*, \w he must bring|strong="H00935"\w* \w an unblemished|strong="H08549"\w* \w female|strong="H05347"\w* \w goat|strong="H08166"\w* \w . . .|strong="H05795"\w* \w as his offering|strong="H07133"\w* \w for|strong="H05921"\w* \w that sin|strong="H02403"\w* \w . . .|strong="H00834"\w* \w . . .|strong="H02398"\w*. \v 29 \w He is to lay|strong="H05564"\w* \w -|strong="H00853"\w* \w his hand|strong="H03027"\w* \w on|strong="H05921"\w* \w the head|strong="H07218"\w* \w of the sin offering|strong="H02403"\w* \w and slaughter|strong="H07819"\w* \w -|strong="H00853"\w* \w it|strong="H02403"\w* \w at the place|strong="H04725"\w* \w of the burnt offering|strong="H05930"\w*. \v 30 \w Then the priest|strong="H03548"\w* \w is to take|strong="H03947"\w* \w some of its blood|strong="H01818"\w* \w with his finger|strong="H00676"\w*, \w put it|strong="H05414"\w* \w on|strong="H05921"\w* \w the horns|strong="H07161"\w* \w of the altar|strong="H04196"\w* \w of burnt offering|strong="H05930"\w*, \w and|strong="H00853"\w* \w pour out|strong="H08210"\w* \w the rest|strong="H03605"\w* \w of the blood|strong="H01818"\w* \w at|strong="H00413"\w* \w the base|strong="H03247"\w* \w of the altar|strong="H04196"\w*. \v 31 \w Then|strong="H00853"\w* \w he is to remove|strong="H05493"\w* \w all|strong="H03605"\w* \w the fat|strong="H02459"\w*, \w just as|strong="H00834"\w* \w [it]|strong="H02459"\w* \w is removed|strong="H05493"\w* \w from|strong="H05921"\w* \w vvv|strong="H02077"\w* \w the peace offering|strong="H08002"\w*, \w and the priest|strong="H03548"\w* \w is to burn|strong="H06999"\w* \w it on the altar|strong="H04196"\w* \w as a pleasing|strong="H05207"\w* \w aroma|strong="H07381"\w* \w to the LORD|strong="H03068"\w*. \w In this way the priest|strong="H03548"\w* \w will make atonement|strong="H03722"\w* \w for him|strong="H05921"\w*, \w and he will be forgiven|strong="H05545"\w*.
\p \v 32 \w If, however|strong="H00518"\w*, \w he brings|strong="H00935"\w* \w a lamb|strong="H03532"\w* \w -|strong="H07133"\w* \w as a sin offering|strong="H02403"\w*, \w he must bring|strong="H00935"\w* \w an unblemished|strong="H08549"\w* \w female|strong="H05347"\w*. \v 33 \w And he is to lay|strong="H05564"\w* \w -|strong="H00853"\w* \w his hand|strong="H03027"\w* \w on|strong="H05921"\w* \w the head|strong="H07218"\w* \w of the sin offering|strong="H02403"\w* \w and slaughter|strong="H07819"\w* \w it|strong="H00853"\w* \w as a sin offering|strong="H02403"\w* \w at the place|strong="H04725"\w* \w where|strong="H00834"\w* \w the burnt offering|strong="H05930"\w* \w is slaughtered|strong="H07819"\w*. \w -|strong="H00853"\w* \v 34 \w Then the priest|strong="H03548"\w* \w is to take|strong="H03947"\w* \w some of the blood|strong="H01818"\w* \w of the sin offering|strong="H02403"\w* \w with his finger|strong="H00676"\w*, \w put it|strong="H05414"\w* \w on|strong="H05921"\w* \w the horns|strong="H07161"\w* \w of the altar|strong="H04196"\w* \w of burnt offering|strong="H05930"\w*, \w and|strong="H00853"\w* \w pour out|strong="H08210"\w* \w the rest|strong="H03605"\w* \w of its blood|strong="H01818"\w* \w at|strong="H00413"\w* \w the base|strong="H03247"\w* \w of the altar|strong="H04196"\w*. \v 35 \w And|strong="H00853"\w* \w he shall remove|strong="H05493"\w* \w all|strong="H03605"\w* \w the fat|strong="H02459"\w*, \w just as|strong="H00834"\w* \w the fat|strong="H02459"\w* \w of the lamb|strong="H03775"\w* \w is removed|strong="H05493"\w* \w vvv|strong="H02077"\w* \w from the peace offerings|strong="H08002"\w*, \w and [he]|strong="H03548"\w* \w -|strong="H00853"\w* \w shall burn|strong="H06999"\w* \w it on the altar|strong="H04196"\w* \w along with|strong="H05921"\w* \w the food offerings|strong="H00801"\w* \w to the LORD|strong="H03068"\w*. \w In this way the priest|strong="H03548"\w* \w will make atonement|strong="H03722"\w* \w for him|strong="H05921"\w* \w for|