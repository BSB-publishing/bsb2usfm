\p \v 53 \w Finally, he is to release|strong="H07971"\w* \w -|strong="H00853"\w* \w the live|strong="H02416"\w* \w bird|strong="H06833"\w* \w into|strong="H00413"\w* \w the open|strong="H06440"\w* \w fields|strong="H07704"\w* \w outside|strong="H02351"\w* \w the city|strong="H05892"\w*. \w . . .|strong="H00413"\w* \w In this way he will make atonement|strong="H03722"\w* \w for|strong="H05921"\w* \w the house|strong="H01004"\w*, \w and it will be clean|strong="H02891"\w*.
\p \v 54 \w This|strong="H02063"\w* \w is the law|strong="H08451"\w* \w for any|strong="H03605"\w* \w infectious skin disease|strong="H06883"\w* \w . . .|strong="H05061"\w*, \w for a scaly outbreak|strong="H05424"\w*, \v 55 \w for mildew|strong="H06883"\w* \w in clothing|strong="H00899"\w* \w or in a house|strong="H01004"\w*, \v 56 \w and for a swelling|strong="H07613"\w*, \w rash|strong="H05597"\w*, \w or spot|strong="H00934"\w*, \v 57 \w to determine|strong="H03384"\w* \w when|strong="H03117"\w* \w . . .|strong="H03117"\w* \w something is clean|strong="H02889"\w* \w or unclean|strong="H02931"\w*. \w This|strong="H02063"\w* \w is the law|strong="H08451"\w* \w regarding skin diseases and mildew|strong="H06883"\w*.\f + \fr 14:57 \ft The Hebrew translated here as \fqa skin diseases and mildew \ft is one singular term; see the footnotes for verses 2 and 34.\f*”
\c 15
\s1 The Uncleanness of Men
\r (Deuteronomy 23:9–14)
\p \v 1 \w And the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00413"\w* \w and Aaron|strong="H00175"\w* \w . . .|strong="H00559"\w*, \v 2 “\w Say|strong="H01696"\w* \w to|strong="H00413"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w -|strong="H00559"\w*, \w -|strong="H00413"\w* ‘\w When|strong="H03588"\w* \w any|strong="H00376"\w* \w man|strong="H00376"\w* \w has|strong="H01961"\w* \w a bodily|strong="H01320"\w* \w discharge|strong="H02100"\w*, \w the discharge|strong="H02101"\w* \w -|strong="H01931"\w* \w is unclean|strong="H02931"\w*. \v 3 \w This|strong="H02063"\w* \w uncleanness|strong="H02932"\w* \w is|strong="H01961"\w* \w from his discharge|strong="H02101"\w*, \w whether his body|strong="H01320"\w* \w -|strong="H00853"\w* \w allows|strong="H07325"\w* \w the discharge {to flow}|strong="H02101"\w* \w or|strong="H00176"\w* \w blocks it|strong="H02856"\w* \w -|strong="H01320"\w*. \w So his discharge|strong="H02101"\w* \w will bring about|strong="H01931"\w* \w uncleanness|strong="H02932"\w*.
\p \v 4 \w Any|strong="H03605"\w* \w bed|strong="H04904"\w* \w on|strong="H05921"\w* \w which|strong="H00834"\w* \w the man with the discharge|strong="H02100"\w* \w lies|strong="H07901"\w* \w will be unclean|strong="H02930"\w*, \w and any|strong="H03605"\w* \w furniture|strong="H03627"\w* \w on|strong="H05921"\w* \w which|strong="H00834"\w* \w he sits|strong="H03427"\w* \w will be unclean|strong="H02930"\w*. \v 5 \w Anyone|strong="H00376"\w* \w who|strong="H00834"\w* \w touches|strong="H05060"\w* \w his bed|strong="H04904"\w* \w must wash|strong="H03526"\w* \w his clothes|strong="H00899"\w* \w and bathe|strong="H07364"\w* \w with water|strong="H04325"\w*, \w and he will be unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*. \v 6 \w Whoever sits|strong="H03427"\w* \w on|strong="H05921"\w* \w furniture|strong="H03627"\w* \w on|strong="H05921"\w* \w which|strong="H00834"\w* \w the man with the discharge|strong="H02100"\w* \w was sitting|strong="H03427"\w* \w must wash|strong="H03526"\w* \w his clothes|strong="H00899"\w* \w and bathe|strong="H07364"\w* \w with water|strong="H04325"\w*, \w and he will be unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*.
\p \v 7 \w Whoever touches|strong="H05060"\w* \w the body|strong="H01320"\w* \w of the man with a discharge|strong="H02100"\w* \w must wash|strong="H03526"\w* \w his clothes|strong="H00899"\w* \w and bathe|strong="H07364"\w* \w with water|strong="H04325"\w*, \w and he will be unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*. \v 8 \w If|strong="H03588"\w* \w the man with the discharge|strong="H02100"\w* \w spits|strong="H07556"\w* \w on one who is clean|strong="H02889"\w*, \w [that person] must wash|strong="H03526"\w* \w his clothes|strong="H00899"\w* \w and bathe|strong="H07364"\w* \w with water|strong="H04325"\w*, \w and he will be unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*.
\p \v 9 \w Any|strong="H03605"\w* \w saddle|strong="H04817"\w* \w on|strong="H05921"\w* \w which|strong="H00834"\w* \w the man with the discharge|strong="H02100"\w* \w rides|strong="H07392"\w* \w will be unclean|strong="H02930"\w*. \v 10 \w Whoever|strong="H03605"\w* \w touches|strong="H05060"\w* \w anything|strong="H03605"\w* \w that|strong="H00834"\w* \w was|strong="H01961"\w* \w under him|strong="H08478"\w* \w will be unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*, \w and whoever carries|strong="H05375"\w* \w such things|strong="H00853"\w* \w must wash|strong="H03526"\w* \w his clothes|strong="H00899"\w* \w and bathe|strong="H07364"\w* \w with water|strong="H04325"\w*, \w and he will be unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*.
\p \v 11 \w If the man with the discharge|strong="H02100"\w* \w touches|strong="H05060"\w* \w anyone|strong="H03605"\w* \w -|strong="H00834"\w* \w without|strong="H03808"\w* \w first rinsing|strong="H07857"\w* \w his hands|strong="H03027"\w* \w with water|strong="H04325"\w*, \w the one who was touched must wash|strong="H03526"\w* \w his clothes|strong="H00899"\w* \w and bathe|strong="H07364"\w* \w with water|strong="H04325"\w*, \w and he will be unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*. \v 12 \w Any clay|strong="H02789"\w* \w pot|strong="H03627"\w* \w that|strong="H00834"\w* \w the man with the discharge|strong="H02100"\w* \w touches|strong="H05060"\w* \w must be broken|strong="H07665"\w*, \w and any|strong="H03605"\w* \w wooden|strong="H06086"\w* \w utensil|strong="H03627"\w* \w must be rinsed|strong="H07857"\w* \w with water|strong="H04325"\w*.
\s1 The Cleansing of Men
\p \v 13 \w When|strong="H03588"\w* \w the man|strong="H02100"\w* \w has been cleansed|strong="H02891"\w* \w from his discharge|strong="H02101"\w*, \w he must count off|strong="H05608"\w* \w seven|strong="H07651"\w* \w days|strong="H03117"\w* for his \w cleansing|strong="H02893"\w*, \w wash|strong="H03526"\w* \w his clothes|strong="H00899"\w*, \w and bathe|strong="H07364"\w* \w himself|strong="H01320"\w* \w in fresh|strong="H02416"\w* \w water|strong="H04325"\w*,\f + \fr 15:13 \ft Or \fqa flowing water \ft or \fqa living water\f* \w and he shall be clean|strong="H02891"\w*. \v 14 \w On the eighth|strong="H08066"\w* \w day|strong="H03117"\w* \w he is to take|strong="H03947"\w* \w two|strong="H08147"\w* \w turtledoves|strong="H08449"\w* \w or|strong="H00176"\w* \w two|strong="H08147"\w* \w young|strong="H01121"\w* \w pigeons|strong="H03123"\w*, \w come|strong="H00935"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w at|strong="H00413"\w* \w the entrance|strong="H06607"\w* \w to the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*, \w and give them|strong="H05414"\w* \w to|strong="H00413"\w* \w the priest|strong="H03548"\w*. \v 15 \w The priest|strong="H03548"\w* \w is to sacrifice|strong="H06213"\w* \w them|strong="H00853"\w*, \w one|strong="H00259"\w* \w as a sin offering|strong="H02403"\w* \w and the other|strong="H00259"\w* \w as a burnt offering|strong="H05930"\w*. \w In this way the priest|strong="H03548"\w* \w will make atonement|strong="H03722"\w* \w for|strong="H05921"\w* \w [the man] before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w because of his discharge|strong="H02101"\w*.
\p \v 16 \w When|strong="H03588"\w* \w . . .|strong="H03318"\w* \w . . .|strong="H04480"\w* \w a man|strong="H00376"\w* \w has an emission|strong="H07902"\w* \w of semen|strong="H02233"\w*, \w he must bathe|strong="H07364"\w* \w his whole|strong="H03605"\w* \w body|strong="H01320"\w* \w with water|strong="H04325"\w*, \w -|strong="H00853"\w* \w and he will be unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*. \v 17 \w Any|strong="H03605"\w* \w clothing|strong="H00899"\w* \w . . .|strong="H03605"\w* \w or leather|strong="H05785"\w* \w on|strong="H05921"\w* \w which|strong="H00834"\w* \w there is|strong="H01961"\w* \w an emission|strong="H07902"\w* \w of semen|strong="H02233"\w* \w must be washed|strong="H03526"\w* \w with water|strong="H04325"\w*, \w and it will remain unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*. \v 18 \w If a man|strong="H00376"\w* \w . . .|strong="H00854"\w* \w lies with|strong="H07901"\w* \w a woman|strong="H00802"\w* \w -|strong="H00834"\w* \w and there is an emission|strong="H07902"\w* \w of semen|strong="H02233"\w*, \w both must bathe|strong="H07364"\w* \w with water|strong="H04325"\w*, \w and they will remain unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*.
\s1 The Uncleanness of Women
\p \v 19 \w When|strong="H03588"\w* \w a woman|strong="H00802"\w* \w has|strong="H01961"\w* \w -|strong="H02101"\w* \w a discharge|strong="H02100"\w* \w consisting|strong="H01961"\w* \w of blood|strong="H01818"\w* \w from her body|strong="H01320"\w*, \w she will be|strong="H01961"\w* \w unclean due to her menstruation|strong="H05079"\w* \w for seven|strong="H07651"\w* \w days|strong="H03117"\w*, \w and anyone|strong="H03605"\w* \w who touches|strong="H05060"\w* her \w will be unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*. \v 20 \w Anything|strong="H03605"\w* \w on|strong="H05921"\w* \w which|strong="H00834"\w* \w she lies|strong="H07901"\w* \w -|strong="H03605"\w* \w -|strong="H00834"\w* \w or sits|strong="H03427"\w* \w during her menstruation|strong="H05079"\w* \w will be unclean|strong="H02930"\w*, \w -|strong="H05921"\w* \w -|strong="H02930"\w* \v 21 \w and anyone|strong="H03605"\w* \w who touches|strong="H05060"\w* \w her bed|strong="H04904"\w* \w must wash|strong="H03526"\w* \w his clothes|strong="H00899"\w* \w and bathe|strong="H07364"\w* \w with water|strong="H04325"\w*, \w and he will be unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*.
\p \v 22 \w Whoever|strong="H03605"\w* \w touches|strong="H05060"\w* \w any|strong="H03605"\w* \w furniture|strong="H03627"\w* \w on|strong="H05921"\w* \w which|strong="H00834"\w* \w she was sitting|strong="H03427"\w* \w must wash|strong="H03526"\w* \w his clothes|strong="H00899"\w* \w and bathe|strong="H07364"\w* \w with water|strong="H04325"\w*, \w and he will be unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*. \v 23 \w And whether|strong="H00518"\w* \w it is|strong="H01931"\w*\w . . .|strong="H05921"\w* \w a bed|strong="H04904"\w* \w or|strong="H00176"\w* \w furniture|strong="H03627"\w* \w on|strong="H05921"\w* \w which|strong="H00834"\w* \w she|strong="H01931"\w* \w was sitting|strong="H03427"\w* \w . . .|strong="H05921"\w*, \w whoever touches|strong="H05060"\w* it \w will be unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*.
\p \v 24 \w If|strong="H00518"\w* \w a man|strong="H00376"\w* \w . . .|strong="H00854"\w* \w lies with|strong="H07901"\w* \w her|strong="H07901"\w* \w and her menstrual flow|strong="H05079"\w* \w touches|strong="H01961"\w* \w him|strong="H05921"\w*, \w he will be unclean|strong="H02930"\w* \w for seven|strong="H07651"\w* \w days|strong="H03117"\w*, \w and any|strong="H03605"\w* \w bed|strong="H04904"\w* \w on|strong="H05921"\w* \w which|strong="H00834"\w* \w he lies|strong="H07901"\w* \w will become unclean|strong="H02930"\w*.
\p \v 25 \w When|strong="H03588"\w* \w a woman|strong="H00802"\w* \w has a discharge|strong="H02100"\w* \w . . .|strong="H02101"\w* \w of her blood|strong="H01818"\w* \w for many|strong="H07227"\w* \w days|strong="H03117"\w* \w at a time|strong="H06256"\w* \w other than|strong="H03808"\w* \w her menstrual period|strong="H05079"\w*, \w or|strong="H00176"\w* \w if|strong="H03588"\w* \w it continues|strong="H02100"\w* \w beyond|strong="H05921"\w* \w her period|strong="H05079"\w*, \w she|strong="H01931"\w* \w will be|strong="H01961"\w* \w unclean|strong="H02931"\w* \w all|strong="H03605"\w* \w the days|strong="H03117"\w* \w of her unclean|strong="H02932"\w* \w discharge|strong="H02101"\w*, \w just as she is during the days|strong="H03117"\w* \w of her menstruation|strong="H05079"\w*. \v 26 \w Any|strong="H03605"\w* \w bed|strong="H04904"\w* \w on|strong="H05921"\w* \w which|strong="H00834"\w* \w she lies|strong="H07901"\w* \w or any|strong="H03605"\w* \w furniture|strong="H03627"\w* \w on|strong="H05921"\w* \w which|strong="H00834"\w* \w she sits|strong="H03427"\w* \w during the days|strong="H03117"\w* \w of her discharge|strong="H02101"\w* \w -|strong="H01961"\w* \w -|strong="H05079"\w* \w will be|strong="H01961"\w* \w unclean|strong="H02931"\w* \w -|strong="H03605"\w*, \w like her bed|strong="H04904"\w* \w during her menstrual period|strong="H02932"\w* \w . . .|strong="H05079"\w*. \v 27 \w Anyone|strong="H03605"\w* \w who touches|strong="H05060"\w* these things \w will be unclean|strong="H02930"\w*; \w he must wash|strong="H03526"\w* \w his clothes|strong="H00899"\w* \w and bathe|strong="H07364"\w* \w with water|strong="H04325"\w*, \w and he will be unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*.
\s1 The Cleansing of Women
\p \v 28 \w When|strong="H00518"\w* \w [a woman] is cleansed|strong="H02891"\w* \w of her discharge|strong="H02101"\w*, \w she must count off|strong="H05608"\w* \w seven|strong="H07651"\w* \w days|strong="H03117"\w*, \w and after that|strong="H00310"\w* \w she will be ceremonially clean|strong="H02891"\w*. \v 29 \w On the eighth|strong="H08066"\w* \w day|strong="H03117"\w* \w she is to take|strong="H03947"\w* \w two|strong="H08147"\w* \w turtledoves|strong="H08449"\w* \w or|strong="H00176"\w* \w two|strong="H08147"\w* \w young|strong="H01121"\w* \w pigeons|strong="H03123"\w* \w and bring|strong="H00935"\w* \w them|strong="H00853"\w* \w to|strong="H00413"\w* \w the priest|strong="H03548"\w* \w at|strong="H00413"\w* \w the entrance|strong="H06607"\w* \w to the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*. \v 30 \w The priest|strong="H03548"\w* \w -|strong="H00853"\w* \w is to sacrifice|strong="H06213"\w* \w one|strong="H00259"\w* \w as a sin offering|strong="H02403"\w* \w -|strong="H00853"\w* \w and the other|strong="H00259"\w* \w as a burnt offering|strong="H05930"\w*. \w In this way the priest|strong="H03548"\w* \w will make atonement|strong="H03722"\w* \w for her|strong="H05921"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w for her unclean|strong="H02932"\w* \w discharge|strong="H02101"\w*.
\p \v 31 \w You must keep|strong="H05144"\w* \w -|strong="H00853"\w* \w the children|strong="H01121"\w* \w of Israel {separate}|strong="H03478"\w* \w from their uncleanness|strong="H02932"\w*, \w so that they do not|strong="H03808"\w* \w die|strong="H04191"\w* \w . . .|strong="H02932"\w* \w by defiling|strong="H02930"\w* \w -|strong="H00853"\w* \w My tabernacle|strong="H04908"\w*, \w which|strong="H00834"\w* \w is among them|strong="H08432"\w*.
\p \v 32 \w This|strong="H02063"\w* \w is the law|strong="H08451"\w* \w of him who has a discharge|strong="H02100"\w*, \w of the man who|strong="H00834"\w* \w has|strong="H03318"\w* \w vvv|strong="H04480"\w* \w an emission|strong="H07902"\w* \w of semen|strong="H02233"\w* whereby \w he is unclean|strong="H02930"\w*, \v 33 \w of a woman|strong="H01739"\w* \w in her menstrual period|strong="H05079"\w*, \w of any male|strong="H02145"\w* \w or female|strong="H05347"\w* \w who has a discharge|strong="H02100"\w* \w -|strong="H00853"\w* \w -|strong="H02101"\w*, \w and of a man|strong="H00376"\w* \w who|strong="H00834"\w* \w lies|strong="H07901"\w* \w with|strong="H05973"\w* \w an unclean woman|strong="H02931"\w*.’”
\c 16
\s1 The Day of Atonement
\r (Leviticus 23:26–32; Numbers 29:7–11)
\p \v 1 \w Now the LORD|strong="H03068"\w* \w spoke|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w after|strong="H00310"\w* \w the death|strong="H04194"\w* \w of two|strong="H08147"\w* \w of Aaron’s|strong="H00175"\w* \w sons|strong="H01121"\w* \w when they approached|strong="H07126"\w* \w the presence|strong="H06440"\w* \w of the LORD|strong="H03068"\w* \w -|strong="H04191"\w*. \v 2 \w And the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*: “\w Tell|strong="H01696"\w*\w . . .|strong="H00413"\w* \w your brother|strong="H00251"\w* \w Aaron|strong="H00175"\w* \w not|strong="H00408"\w* \w to enter|strong="H00935"\w* \w freely|strong="H03605"\w* \w . . .|strong="H06256"\w* \w into|strong="H00413"\w* \w the Most Holy Place|strong="H06944"\w*\f + \fr 16:2 \ft Or \fqa the Holy Place\ft ; also in verses 16, 17, 20, 23, and 27\f* \w behind|strong="H01004"\w* \w the veil|strong="H06532"\w* \w in|strong="H00413"\w* \w front|strong="H06440"\w* \w of the mercy seat|strong="H03727"\w*\f + \fr 16:2 \ft Or \fqa atonement cover\ft ; here and throughout this chapter\f* \w -|strong="H00834"\w* \w on|strong="H05921"\w* \w the ark|strong="H00727"\w*, \w or else|strong="H03808"\w* \w he will die|strong="H04191"\w*, \w because|strong="H03588"\w* \w I appear|strong="H07200"\w* \w in the cloud|strong="H06051"\w* \w above|strong="H05921"\w* \w the mercy seat|strong="H03727"\w*.
\p \v 3 \w This is how|strong="H02063"\w* \w Aaron|strong="H00175"\w* \w is to enter|strong="H00935"\w* \w . . .|strong="H00413"\w* \w the Holy Place|strong="H06944"\w*: \w with a young bull|strong="H06499"\w* \w . . .|strong="H01121"\w* \w . . .|strong="H01241"\w* \w for a sin offering|strong="H02403"\w* \w and a ram|strong="H00352"\w* \w for a burnt offering|strong="H05930"\w*. \v 4 \w He is to wear|strong="H03847"\w* \w the sacred|strong="H06944"\w* \w linen|strong="H00906"\w* \w tunic|strong="H03801"\w*, \w with linen|strong="H00906"\w* \w undergarments|strong="H04370"\w* \w -|strong="H01961"\w* \w -|strong="H05921"\w* \w -|strong="H01320"\w*. \w He must tie|strong="H02296"\w* \w a linen|strong="H00906"\w* \w sash|strong="H00073"\w* \w around him|strong="H00906"\w* \w and put on the linen|strong="H06801"\w* \w turban|strong="H04701"\w*. \w These|strong="H01992"\w* \w [are] holy|strong="H06944"\w* \w garments|strong="H00899"\w*, \w and he must bathe|strong="H07364"\w* \w himself|strong="H01320"\w* \w with water|strong="H04325"\w* \w -|strong="H00853"\w* \w before he wears them|strong="H03847"\w*. \v 5 \w And|strong="H00854"\w* \w he shall take|strong="H03947"\w* \w from the congregation|strong="H05712"\w* \w . . .|strong="H01121"\w* \w of Israel|strong="H03478"\w* \w two|strong="H08147"\w* \w male goats|strong="H08163"\w* \w . . .|strong="H05795"\w* \w for a sin offering|strong="H02403"\w* \w and one|strong="H00259"\w* \w ram|strong="H00352"\w* \w for a burnt offering|strong="H05930"\w*.
\p \v 6 \w Aaron|strong="H00175"\w* \w -|strong="H00853"\w* \w is to present|strong="H07126"\w* \w the bull|strong="H06499"\w* \w for his sin offering|strong="H02403"\w* \w -|strong="H00834"\w* \w and make atonement|strong="H03722"\w* \w for|strong="H01157"\w* \w himself|strong="H01157"\w* \w and his household|strong="H01004"\w*. \v 7 \w Then he shall take|strong="H03947"\w* \w -|strong="H00853"\w* \w the two|strong="H08147"\w* \w goats|strong="H08163"\w* \w and present|strong="H05975"\w* \w them|strong="H00853"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w at the entrance|strong="H06607"\w* \w to the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*.
\p \v 8 \w After Aaron|strong="H00175"\w* \w casts|strong="H05414"\w* \w lots|strong="H01486"\w* \w for|strong="H05921"\w* \w the two|strong="H08147"\w* \w goats|strong="H08163"\w*, \w one|strong="H00259"\w* \w -|strong="H01486"\w* \w for the LORD|strong="H03068"\w* \w . . .|strong="H01486"\w* \w and the other|strong="H00259"\w* \w for the scapegoat|strong="H05799"\w*,\f + \fr 16:8 \ft Literally \fqa the other to Azazel\ft ; similarly twice in verse 10 and once in verse 26\f* \v 9 \w he|strong="H00175"\w* \w -|strong="H00853"\w* \w shall present|strong="H07126"\w* \w the goat|strong="H08163"\w* \w -|strong="H00834"\w* \w chosen|strong="H05927"\w* \w . . .|strong="H05921"\w* \w by lot|strong="H01486"\w* \w for the LORD|strong="H03068"\w* \w and sacrifice|strong="H06213"\w* \w it as a sin offering|strong="H02403"\w*. \v 10 \w But the goat|strong="H08163"\w* \w -|strong="H00834"\w* \w chosen|strong="H05927"\w* \w by|strong="H05921"\w* \w lot|strong="H01486"\w* \w as the scapegoat|strong="H05799"\w* \w shall be presented|strong="H05975"\w* \w alive|strong="H02416"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w to make atonement|strong="H03722"\w* \w . . .|strong="H05921"\w* \w by sending|strong="H07971"\w* \w -|strong="H00853"\w* \w it into the wilderness|strong="H04057"\w* \w as the scapegoat|strong="H05799"\w*.
\p \v 11 \w When Aaron|strong="H00175"\w* \w -|strong="H00853"\w* \w presents|strong="H07126"\w* \w the bull|strong="H06499"\w* \w for his sin offering|strong="H02403"\w* \w -|strong="H00834"\w* \w and makes atonement|strong="H03722"\w* \w for himself|strong="H01157"\w* \w . . .|strong="H01157"\w* \w and his household|strong="H01004"\w*, \w he is to slaughter|strong="H07819"\w* \w -|strong="H00853"\w* \w the bull|strong="H06499"\w* \w for his own sin offering|strong="H02403"\w* \w -|strong="H00834"\w*. \v 12 \w Then he must take|strong="H03947"\w* \w a censer|strong="H04289"\w* \w full|strong="H04393"\w* \w of burning|strong="H00784"\w* \w coals|strong="H01513"\w* \w from|strong="H05921"\w* \w the altar|strong="H04196"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*, \w and two handfuls|strong="H04393"\w* \w . . .|strong="H02651"\w* \w of finely ground|strong="H01851"\w* \w fragrant|strong="H05561"\w* \w incense|strong="H07004"\w*, \w and take them|strong="H00935"\w* \w inside|strong="H01004"\w* \w the veil|strong="H06532"\w*. \v 13 \w He is to put|strong="H05414"\w* \w -|strong="H00853"\w* \w the incense|strong="H07004"\w* \w on|strong="H05921"\w* \w the fire|strong="H00784"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*, \w and the cloud|strong="H06051"\w* \w of incense|strong="H07004"\w* \w -|strong="H00853"\w* \w will cover|strong="H03680"\w* \w the mercy seat|strong="H03727"\w* \w -|strong="H00834"\w* \w above|strong="H05921"\w* \w the Testimony|strong="H05715"\w*,\f + \fr 16:13 \fqa The Testimony \ft refers to the stone tablets in the ark of the covenant inscribed with the Ten Commandments.\f* \w so that he will not|strong="H03808"\w* \w die|strong="H04191"\w*. \v 14 \w And he is to take|strong="H03947"\w* \w some of the bull’s|strong="H06499"\w* \w blood|strong="H01818"\w* \w and sprinkle|strong="H05137"\w* \w it with his finger|strong="H00676"\w* \w on|strong="H05921"\w* \w the east|strong="H06924"\w* \w side|strong="H06440"\w*