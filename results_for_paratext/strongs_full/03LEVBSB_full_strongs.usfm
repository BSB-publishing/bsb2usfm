\p \v 1 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00559"\w*, \v 2 “\w Tell|strong="H00559"\w* \w . . .|strong="H00413"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*, ‘\w Any|strong="H00376"\w* \w . . .|strong="H00376"\w* \w Israelite|strong="H01121"\w* \w . . .|strong="H03478"\w* \w or|strong="H04480"\w* \w foreigner|strong="H01616"\w* \w living|strong="H01481"\w* \w in Israel|strong="H03478"\w* \w who|strong="H00834"\w* \w gives|strong="H05414"\w* \w any of his children|strong="H02233"\w* \w to Molech|strong="H04432"\w* \w must be put to death|strong="H04191"\w* \w . . .|strong="H04191"\w*. \w The people|strong="H05971"\w* \w of the land|strong="H00776"\w* \w are to stone|strong="H07275"\w* \w him|strong="H00068"\w*. \v 3 \w And I|strong="H00589"\w* \w will set|strong="H05414"\w* \w -|strong="H00853"\w* \w My face|strong="H06440"\w* \w against that|strong="H01931"\w* \w man|strong="H00376"\w* \w and cut him off|strong="H03772"\w* \w -|strong="H00853"\w* \w from|strong="H07130"\w* \w his people|strong="H05971"\w*, \w because|strong="H03588"\w* \w by giving|strong="H05414"\w* \w his offspring|strong="H02233"\w* \w to Molech|strong="H04432"\w*, \w . . .|strong="H04616"\w* \w he has defiled|strong="H02930"\w* \w -|strong="H00853"\w* \w My sanctuary|strong="H04720"\w* \w and profaned|strong="H02490"\w* \w -|strong="H00853"\w* \w My holy|strong="H06944"\w* \w name|strong="H08034"\w*.
