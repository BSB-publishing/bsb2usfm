\c 25
\s1 Nebuchadnezzar Besieges Jerusalem
\p \v 1 \w So|strong="H01961"\w* \w in the ninth|strong="H08671"\w* \w year|strong="H08141"\w* \w of Zedekiah’s reign|strong="H04427"\w*, \w on the tenth|strong="H06218"\w* \w . . .|strong="H02320"\w* \w day of the tenth|strong="H06224"\w* \w month|strong="H02320"\w*, \w Nebuchadnezzar|strong="H05019"\w* \w king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w . . .|strong="H01931"\w* \w marched|strong="H00935"\w* \w against|strong="H05921"\w* \w Jerusalem|strong="H03389"\w* \w with his entire|strong="H03605"\w* \w army|strong="H02428"\w*. \w They encamped|strong="H02583"\w* \w outside [the city]|strong="H05921"\w* \w and built|strong="H01129"\w*\f + \fr 25:1 \ft Literally \fqa He encamped outside it and they built\f* \w a siege wall|strong="H01785"\w* \w . . .|strong="H05921"\w* \w all around it|strong="H05439"\w*. \v 2 \w And the city|strong="H05892"\w* \w was kept|strong="H00935"\w* \w under siege|strong="H04692"\w* \w until|strong="H05704"\w* \w King|strong="H04428"\w* \w Zedekiah’s|strong="H06667"\w* \w eleventh|strong="H06249"\w* \w . . .|strong="H06240"\w* \w year|strong="H08141"\w*.
\p \v 3 \w By the ninth [day]|strong="H08672"\w* \w of the [fourth] month|strong="H02320"\w*,\f + \fr 25:3 \ft Probable reading (see Jeremiah 52:6); MT does not include \fqa fourth\ft .\f* \w the famine|strong="H07458"\w* \w in the city|strong="H05892"\w* \w was so severe|strong="H02388"\w* \w that the people|strong="H05971"\w* \w of the land|strong="H00776"\w* \w had|strong="H01961"\w* \w no|strong="H03808"\w* \w food|strong="H03899"\w*. \v 4 \w Then the city|strong="H05892"\w* \w was breached|strong="H01234"\w*; \w and though the Chaldeans|strong="H03778"\w*\f + \fr 25:4 \ft That is, the Babylonians; also in verses 5, 6, 10, 13, 24, 25, and 26 \f* \w . . .|strong="H05921"\w* \w had surrounded|strong="H05439"\w* \w the city|strong="H05892"\w*, \w all|strong="H03605"\w* \w the men|strong="H00582"\w* \w of war|strong="H04421"\w* \w fled by night|strong="H03915"\w* \w by way|strong="H01870"\w* \w of the gate|strong="H08179"\w* \w between|strong="H00996"\w* \w the two walls|strong="H02346"\w* \w -|strong="H00834"\w* \w near|strong="H05921"\w* \w the king’s|strong="H04428"\w* \w garden|strong="H01588"\w*.
\p \w They headed|strong="H01980"\w* \w toward|strong="H01870"\w* \w the Arabah|strong="H06160"\w*,\f + \fr 25:4 \ft Or \fqa the Jordan Valley\f* \v 5 \w but the army|strong="H02428"\w* \w of the Chaldeans|strong="H03778"\w* \w pursued|strong="H07291"\w*\w . . .|strong="H00310"\w* \w [the king]|strong="H04428"\w* \w and overtook|strong="H05381"\w* \w him|strong="H00853"\w* \w in the plains|strong="H06160"\w* \w of Jericho|strong="H03405"\w*, \w and his whole|strong="H03605"\w* \w army|strong="H02428"\w* \w deserted|strong="H06327"\w* \w him|strong="H05921"\w*. \v 6 \w The Chaldeans seized|strong="H08610"\w* \w -|strong="H00853"\w* \w the king|strong="H04428"\w* \w and brought him up|strong="H05927"\w* \w -|strong="H00853"\w* \w to|strong="H00413"\w* \w the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w at Riblah|strong="H07247"\w*, \w where they pronounced|strong="H01696"\w* \w judgment|strong="H04941"\w* \w on him|strong="H00854"\w*. \v 7 \w And|strong="H00853"\w* \w they slaughtered|strong="H07819"\w* \w the sons|strong="H01121"\w* \w of Zedekiah|strong="H06667"\w* \w before his eyes|strong="H05869"\w*. \w Then|strong="H00853"\w* \w they put out|strong="H05786"\w* \w [his]|strong="H06667"\w* \w eyes|strong="H05869"\w*, \w bound him|strong="H00631"\w* \w with bronze shackles|strong="H05178"\w*, \w and took him|strong="H00935"\w* \w to Babylon|strong="H00894"\w*.
\s1 The Temple Destroyed
\p \v 8 \w On the seventh|strong="H07651"\w* \w . . .|strong="H02320"\w* \w day of the fifth|strong="H02549"\w* \w month|strong="H02320"\w*, \w -|strong="H01931"\w* \w in the nineteenth|strong="H08672"\w* \w . . .|strong="H06240"\w* \w . . .|strong="H08141"\w* \w year|strong="H08141"\w* \w of Nebuchadnezzar’s|strong="H05019"\w* \w reign|strong="H04428"\w*\w . . .|strong="H04428"\w* \w over Babylon|strong="H00894"\w*, \w Nebuzaradan|strong="H05018"\w* \w captain|strong="H07227"\w* \w of the guard|strong="H02876"\w*, \w a servant|strong="H05650"\w* \w of the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*, \w entered|strong="H00935"\w* \w Jerusalem|strong="H03389"\w*. \v 9 \w He burned down|strong="H08313"\w* \w -|strong="H00853"\w* \w the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*,\w . . .|strong="H00853"\w* \w the royal|strong="H04428"\w* \w -|strong="H00853"\w* \w palace|strong="H01004"\w*, \w and all|strong="H03605"\w* \w the houses|strong="H01004"\w* \w of Jerusalem|strong="H03389"\w* — \w -|strong="H00853"\w* \w -|strong="H08313"\w* \w -|strong="H00784"\w* \w every|strong="H03605"\w* \w significant|strong="H01419"\w* \w building|strong="H01004"\w*. \v 10 \w -|strong="H00853"\w* \w And the whole|strong="H03605"\w* \w army|strong="H02428"\w* \w of the Chaldeans|strong="H03778"\w* \w under|strong="H00834"\w* \w the captain|strong="H07227"\w* \w of the guard|strong="H02876"\w* \w broke down|strong="H05422"\w* \w the walls|strong="H02346"\w* \w around|strong="H05439"\w* \w Jerusalem|strong="H03389"\w*.
\p \v 11 \w -|strong="H00853"\w* \w Then Nebuzaradan|strong="H05018"\w* \w captain|strong="H07227"\w* \w of the guard|strong="H02876"\w* \w carried into exile|strong="H01540"\w* \w vvv|strong="H03499"\w* \w the people|strong="H05971"\w* \w who remained|strong="H07604"\w* \w in the city|strong="H05892"\w*, \w along with|strong="H00853"\w* \w the deserters|strong="H05307"\w* \w who|strong="H00834"\w* \w had defected|strong="H05307"\w* \w to|strong="H05921"\w* \w the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w -|strong="H00853"\w* \w and the rest|strong="H03499"\w* \w of the population|strong="H01995"\w*. \v 12 \w But the captain|strong="H07227"\w* \w of the guard|strong="H02876"\w* \w left behind|strong="H07604"\w* \w some of the poorest|strong="H01803"\w* \w of the land|strong="H00776"\w* \w to tend the vineyards|strong="H03755"\w* \w and fields|strong="H03009"\w*.
\p \v 13 \w Moreover|strong="H00853"\w*, \w the Chaldeans|strong="H03778"\w* \w broke up|strong="H07665"\w* \w the bronze|strong="H05178"\w* \w pillars|strong="H05982"\w* \w and|strong="H00853"\w* \w stands|strong="H04350"\w* \w -|strong="H00853"\w* \w and the bronze|strong="H05178"\w* \w -|strong="H00834"\w* \w Sea|strong="H03220"\w* \w -|strong="H01004"\w* \w -|strong="H03068"\w* \w -|strong="H00834"\w* \w in the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*, \w and they carried|strong="H05375"\w* \w -|strong="H00853"\w* \w the bronze|strong="H05178"\w* \w to Babylon|strong="H00894"\w*. \v 14 \w They also|strong="H00853"\w* \w took away|strong="H03947"\w* \w the pots|strong="H05518"\w*, \w -|strong="H00853"\w* \w shovels|strong="H03257"\w*, \w -|strong="H00853"\w* \w wick trimmers|strong="H04212"\w*, \w -|strong="H00853"\w* \w dishes|strong="H03709"\w*, \w -|strong="H00853"\w* \w and all|strong="H03605"\w* \w the articles|strong="H03627"\w* \w of bronze|strong="H05178"\w* \w -|strong="H00834"\w* \w used in the temple service|strong="H08334"\w*. \v 15 \w -|strong="H00853"\w* \w The captain|strong="H07227"\w* \w of the guard|strong="H02876"\w* \w also took away|strong="H03947"\w* \w the censers|strong="H04289"\w* \w -|strong="H00853"\w* \w and sprinkling bowls|strong="H04219"\w*— \w anything [made of]|strong="H00834"\w* \w pure gold|strong="H02091"\w* \w . . .|strong="H02091"\w* \w -|strong="H00834"\w* \w or fine silver|strong="H03701"\w* \w . . .|strong="H03701"\w*.
\p \v 16 \w As for the two|strong="H08147"\w* \w pillars|strong="H05982"\w*, \w the|strong="H00259"\w* \w Sea|strong="H03220"\w*, \w and the movable stands|strong="H04350"\w* \w that|strong="H00834"\w* \w Solomon|strong="H08010"\w* \w had made|strong="H06213"\w* \w for the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*, \w . . .|strong="H03808"\w* \w . . .|strong="H01961"\w* \w {the weight} of the bronze|strong="H05178"\w* \w from all|strong="H03605"\w* \w these|strong="H00428"\w* \w articles|strong="H03627"\w* \w [was beyond] measure|strong="H04948"\w*. \v 17 \w Each|strong="H00259"\w* \w pillar|strong="H05982"\w* \w was eighteen|strong="H08083"\w* \w . . .|strong="H06240"\w* \w cubits|strong="H00520"\w* \w tall|strong="H06967"\w*.\f + \fr 25:17 \fqa 18 cubits \ft is approximately 27 feet or 8.2 meters.\f* \w The bronze|strong="H05178"\w* \w capital|strong="H03805"\w* \w atop [one pillar]|strong="H05921"\w* \w -|strong="H03805"\w* \w was three|strong="H07969"\w* \w cubits|strong="H00520"\w* \w high|strong="H06967"\w*,\f + \fr 25:17 \fqa 3 cubits \ft is approximately 4.5 feet or 1.4 meters.\f* \w with a network|strong="H07639"\w* \w . . .|strong="H03805"\w* \w of bronze|strong="H05178"\w* \w pomegranates|strong="H07416"\w* \w -|strong="H05921"\w* \w all|strong="H03605"\w* \w around|strong="H05439"\w*. \w The second|strong="H08145"\w* \w . . .|strong="H05921"\w* \w pillar|strong="H05982"\w*, \w with its network|strong="H07639"\w*, \w was similar|strong="H00428"\w*.
\s1 Captives Carried to Babylon
\p \v 18 \w The captain|strong="H07227"\w* \w of the guard|strong="H02876"\w* \w -|strong="H00853"\w* \w also took away|strong="H03947"\w* \w Seraiah|strong="H08304"\w* \w the chief|strong="H07218"\w* \w -|strong="H00853"\w* \w priest|strong="H03548"\w*, \w Zephaniah|strong="H06846"\w* \w the priest|strong="H03548"\w* \w of second rank|strong="H04932"\w*, \w -|strong="H00853"\w* \w and the three|strong="H07969"\w* \w doorkeepers|strong="H08104"\w* \w . . .|strong="H05592"\w*. \v 19 \w Of those|strong="H04480"\w* \w still in the city|strong="H05892"\w*, \w he took|strong="H03947"\w* \w a|strong="H00259"\w* \w court official|strong="H05631"\w* \w who|strong="H00834"\w* \w . . .|strong="H01931"\w* \w had been appointed|strong="H06496"\w* \w over|strong="H05921"\w* \w the men|strong="H00582"\w* \w of war|strong="H04421"\w*, \w as well as five|strong="H02568"\w* \w . . .|strong="H00582"\w* \w royal|strong="H04428"\w* \w -|strong="H00834"\w* \w advisors|strong="H07200"\w* \w -|strong="H06440"\w* \w -|strong="H04672"\w* \w -|strong="H05892"\w*. \w [He] also [took]|strong="H00853"\w* \w the scribe|strong="H05608"\w* \w of the captain|strong="H08269"\w* \w of the army|strong="H06635"\w*, \w who had enlisted|strong="H06633"\w* \w -|strong="H00853"\w* \w the people|strong="H05971"\w* \w of the land|strong="H00776"\w*, \w and sixty|strong="H08346"\w* \w men|strong="H00376"\w* \w -|strong="H05971"\w* \w -|strong="H00776"\w* \w [who were] found|strong="H04672"\w* \w in the city|strong="H05892"\w*.
\p \v 20 \w Nebuzaradan|strong="H05018"\w* \w captain|strong="H07227"\w* \w of the guard|strong="H02876"\w* \w took|strong="H03947"\w* \w them|strong="H00853"\w* \w and brought|strong="H01980"\w* \w them|strong="H00853"\w* \w to|strong="H05921"\w* \w the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w at Riblah|strong="H07247"\w*. \v 21 \w There at Riblah|strong="H07247"\w* \w in the land|strong="H00776"\w* \w of Hamath|strong="H02574"\w*, \w the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w struck them|strong="H05221"\w* \w {down}|strong="H00853"\w* \w and put them to death|strong="H04191"\w*. \w So Judah|strong="H03063"\w* \w was taken into exile|strong="H01540"\w*, \w away from|strong="H05921"\w* \w its own land|strong="H00127"\w*.
\s1 Gedaliah Governs in Judah
\p \v 22 \w Nebuchadnezzar|strong="H05019"\w* \w king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w appointed|strong="H06485"\w* \w Gedaliah|strong="H01436"\w* \w son|strong="H01121"\w* \w of Ahikam|strong="H00296"\w*, \w the son|strong="H01121"\w* \w of Shaphan|strong="H08227"\w*, \w over|strong="H05921"\w* \w -|strong="H00853"\w* \w the people|strong="H05971"\w* \w -|strong="H07604"\w* \w -|strong="H00834"\w* \w he had left behind|strong="H07604"\w* \w in the land|strong="H00776"\w* \w of Judah|strong="H03063"\w*.
\p \v 23 \w When all|strong="H03605"\w* \w the commanders|strong="H08269"\w* \w of the armies|strong="H02428"\w* \w -|strong="H01992"\w* \w and their men|strong="H00582"\w* \w heard|strong="H08085"\w* \w that|strong="H03588"\w* \w the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w -|strong="H00853"\w* \w had appointed|strong="H06485"\w* \w Gedaliah {as governor}|strong="H01436"\w*, \w they came|strong="H00935"\w* \w to|strong="H00413"\w* \w Gedaliah|strong="H01436"\w* \w at Mizpah|strong="H04709"\w* — \w Ishmael|strong="H03458"\w* \w son|strong="H01121"\w* \w of Nethaniah|strong="H05418"\w*, \w Johanan|strong="H03110"\w* \w son|strong="H01121"\w* \w of Kareah|strong="H07143"\w*, \w Seraiah|strong="H08304"\w* \w son|strong="H01121"\w* \w of Tanhumeth|strong="H08576"\w* \w the Netophathite|strong="H05200"\w*, \w and Jaazaniah|strong="H02970"\w*\f + \fr 25:23 \fqa Jaazaniah \ft is a variant of \fqa Jezaniah\ft ; see Jeremiah 40:8.\f* \w son|strong="H01121"\w* \w of the Maacathite|strong="H04602"\w*, \w -|strong="H01992"\w* \w as well as their men|strong="H00582"\w*. \v 24 \w And Gedaliah|strong="H01436"\w* \w took an oath|strong="H07650"\w* before them \w and their men|strong="H00582"\w*, \w assuring|strong="H00559"\w* them, “\w Do not|strong="H00408"\w* \w be afraid|strong="H03372"\w* \w of the servants|strong="H05650"\w* \w of the Chaldeans|strong="H03778"\w*. \w Live|strong="H03427"\w* \w in the land|strong="H00776"\w* \w and serve|strong="H05647"\w* \w -|strong="H00853"\w* \w the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*, \w and it will be well|strong="H03190"\w* with you.”
\s1 The Murder of Gedaliah
\p \v 25 \w . . .|strong="H01961"\w* \w In the seventh|strong="H07637"\w* \w month, however|strong="H02320"\w*, \w Ishmael|strong="H03458"\w* \w son|strong="H01121"\w* \w of Nethaniah|strong="H05418"\w*, \w the son|strong="H01121"\w* \w of Elishama|strong="H00476"\w*, \w [who was a member] of the royal|strong="H04410"\w* \w family|strong="H02233"\w*, \w came|strong="H00935"\w* \w with|strong="H00854"\w* \w ten|strong="H06235"\w* \w men|strong="H00582"\w* \w and struck down|strong="H05221"\w* \w and killed|strong="H04191"\w* \w -|strong="H00853"\w* \w Gedaliah|strong="H01436"\w*, \w vvv|strong="H00853"\w* \w along with the Judeans|strong="H03064"\w* \w -|strong="H00853"\w* \w and Chaldeans|strong="H03778"\w* \w who|strong="H00834"\w* \w were|strong="H01961"\w* \w with him|strong="H00854"\w* \w at Mizpah|strong="H04709"\w*. \v 26 \w Then all|strong="H03605"\w* \w the people|strong="H05971"\w* \w small|strong="H06996"\w* \w and|strong="H05704"\w* \w great|strong="H01419"\w*, \w together with the commanders|strong="H08269"\w* \w of the army|strong="H02428"\w*, \w arose|strong="H06965"\w* \w and fled|strong="H00935"\w* \w to Egypt|strong="H04714"\w* \w for|strong="H03588"\w* \w fear|strong="H03372"\w* \w of|strong="H06440"\w* \w the Chaldeans|strong="H03778"\w*.
\s1 Jehoiachin Released from Prison
\p \v 27 \w -|strong="H01961"\w* \w On the twenty-seventh [day]|strong="H06242"\w* \w . . .|strong="H07651"\w* \w . . .|strong="H02320"\w* \w of the twelfth|strong="H08147"\w* \w . . .|strong="H06240"\w* \w month|strong="H02320"\w* \w of the thirty-seventh|strong="H07970"\w* \w . . .|strong="H07651"\w* \w year|strong="H08141"\w* \w of the exile|strong="H01546"\w* \w of Judah’s|strong="H03063"\w* \w King|strong="H04428"\w* \w Jehoiachin|strong="H03078"\w*, \w in the year|strong="H08141"\w* \w vvv|strong="H00192"\w* \w Evil-merodach|strong="H00192"\w* \w became king|strong="H04428"\w* \w . . .|strong="H04427"\w* \w -|strong="H00853"\w* \w of Babylon|strong="H00894"\w*, \w he released|strong="H05375"\w* \w . . .|strong="H07218"\w*\f + \fr 25:27 \ft Literally \fqa lifted up the head of\f* \w King|strong="H04428"\w* \w Jehoiachin|strong="H03078"\w* \w of Judah|strong="H03063"\w* \w from|strong="H01004"\w* \w prison|strong="H03608"\w*. \v 28 \w And he spoke|strong="H01696"\w* \w kindly|strong="H02896"\w* \w to Jehoiachin|strong="H00854"\w* \w and set|strong="H05414"\w* \w -|strong="H00853"\w* \w his throne|strong="H03678"\w* \w above|strong="H05921"\w* \w the thrones|strong="H03678"\w* \w of the [other] kings|strong="H04428"\w* \w who [were]|strong="H00834"\w* \w with him|strong="H00854"\w* \w in Babylon|strong="H00894"\w*.
\p \v 29 \w So Jehoiachin changed|strong="H08132"\w* \w -|strong="H00853"\w* \w out of his prison|strong="H03608"\w* \w clothes|strong="H00899"\w*, \w and he dined|strong="H00398"\w* \w . . .|strong="H03899"\w* \w regularly|strong="H08548"\w* \w at the king’s table|strong="H06440"\w* \w for the rest|strong="H03605"\w* \w . . .|strong="H03117"\w* \w of his life|strong="H02416"\w*. \v 30 \w -|strong="H00854"\w* \w And the king|strong="H04428"\w* \w vvv|strong="H00737"\w* \w provided [Jehoiachin]|strong="H05414"\w* \w a daily|strong="H03117"\w*\w . . .|strong="H00737"\w* \w portion|strong="H08548"\w*\w . . .|strong="H01697"\w*\w . . .|strong="H03117"\w* \w for the rest|strong="H03605"\w* \w . . .|strong="H03117"\w* \w of his life|strong="H02416"\w*.
