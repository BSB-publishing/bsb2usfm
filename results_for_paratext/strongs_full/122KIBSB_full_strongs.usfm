\s1 Jehu Kills the Priests of Baal
\p \v 18 \w Then Jehu|strong="H03058"\w* \w -|strong="H00853"\w* \w brought all|strong="H03605"\w* \w the people|strong="H05971"\w* \w together|strong="H06908"\w* \w and said|strong="H00559"\w* \w -|strong="H00413"\w*, “\w Ahab|strong="H00256"\w* \w served|strong="H05647"\w* \w -|strong="H00853"\w* \w Baal|strong="H01168"\w* \w a little|strong="H04592"\w*, \w but Jehu|strong="H03058"\w* \w will serve him|strong="H05647"\w* \w a lot|strong="H07235"\w*. \v 19 \w Now, therefore|strong="H06258"\w*, \w summon|strong="H07121"\w* \w to me|strong="H00413"\w* \w all|strong="H03605"\w* \w the prophets|strong="H05030"\w* \w of Baal|strong="H01168"\w*, \w all|strong="H03605"\w* \w his servants|strong="H05647"\w*, \w and all|strong="H03605"\w* \w his priests|strong="H03548"\w*. \w See that no one|strong="H00376"\w* \w . . .|strong="H00408"\w* \w is missing|strong="H06485"\w*, \w for|strong="H03588"\w* I have \w a great|strong="H01419"\w* \w sacrifice|strong="H02077"\w* \w for Baal|strong="H01168"\w*. \w Whoever|strong="H03605"\w* \w -|strong="H00834"\w* \w is missing|strong="H06485"\w* \w will not|strong="H03808"\w* \w live|strong="H02421"\w*.”
