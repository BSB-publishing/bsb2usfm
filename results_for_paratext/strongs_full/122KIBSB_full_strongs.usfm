\p \w And while|strong="H01961"\w* \w the harpist|strong="H05059"\w* \w played|strong="H05059"\w*, \w the hand|strong="H03027"\w* \w of the LORD|strong="H03068"\w* \w came|strong="H01961"\w* \w upon Elisha|strong="H05921"\w* \v 16 \w and he said|strong="H00559"\w*, “\w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: ‘\w Dig|strong="H06213"\w* \w this|strong="H02088"\w* \w valley|strong="H05158"\w* \w vvv|strong="H01356"\w* \w full of ditches|strong="H01356"\w*.’ \v 17 \w For|strong="H03588"\w* \w . . .|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*, ‘\w You will not|strong="H03808"\w* \w see|strong="H07200"\w* \w wind|strong="H07307"\w* \w . . .|strong="H03808"\w* \w . . .|strong="H07200"\w* \w or rain|strong="H01653"\w*, \w but the|strong="H01931"\w* \w valley|strong="H05158"\w* \w will be filled|strong="H04390"\w* \w with water|strong="H04325"\w*, \w and you will drink|strong="H08354"\w*— \w you|strong="H00859"\w* \w and your cattle|strong="H04735"\w* \w and your animals|strong="H00929"\w*.’ \v 18 \w This|strong="H02063"\w* \w is a simple matter|strong="H07043"\w* \w in the sight|strong="H05869"\w* \w of the LORD|strong="H03068"\w*, \w and He will also deliver|strong="H05414"\w* \w the Moabites|strong="H04124"\w* \w -|strong="H00853"\w* \w into your hand|strong="H03027"\w*. \v 19 \w And you shall attack|strong="H05221"\w* \w every|strong="H03605"\w* \w fortified|strong="H04013"\w* \w city|strong="H05892"\w* \w and every|strong="H03605"\w* \w city|strong="H05892"\w* \w of importance|strong="H04004"\w*. \w You shall cut down|strong="H05307"\w* \w every|strong="H03605"\w* \w good|strong="H02896"\w* \w tree|strong="H06086"\w*, \w stop up|strong="H05640"\w* \w every|strong="H03605"\w* \w spring|strong="H04599"\w* \w . . .|strong="H04325"\w*, \w and ruin|strong="H03510"\w* \w every|strong="H03605"\w* \w good|strong="H02896"\w* \w field|strong="H02513"\w* \w with stones|strong="H00068"\w*.”
