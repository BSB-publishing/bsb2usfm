\c 20
\s1 Hezekiah’s Illness and Recovery
\p \v 1 \w In those|strong="H01992"\w* \w days|strong="H03117"\w* \w Hezekiah|strong="H02396"\w* \w became mortally|strong="H04191"\w* \w ill|strong="H02470"\w*. \w The prophet|strong="H05030"\w* \w Isaiah|strong="H03470"\w* \w son|strong="H01121"\w* \w of Amoz|strong="H00531"\w* \w came|strong="H00935"\w* \w to him|strong="H00413"\w* \w and said|strong="H00559"\w* \w -|strong="H00413"\w*, “\w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: ‘\w Put your house|strong="H01004"\w* \w in order|strong="H06680"\w*, \w for|strong="H03588"\w* \w you|strong="H00859"\w* \w are about to die|strong="H04191"\w*; \w you will not|strong="H03808"\w* \w recover|strong="H02421"\w*.’”
\p \v 2 \w Then Hezekiah turned|strong="H05437"\w* \w -|strong="H00853"\w* \w his face|strong="H06440"\w* \w to|strong="H00413"\w* \w the wall|strong="H07023"\w* \w and prayed|strong="H06419"\w* \w to|strong="H00413"\w* \w the LORD|strong="H03068"\w*, \w saying|strong="H00559"\w*, \v 3 “\w Please|strong="H00577"\w*, \w O LORD|strong="H03068"\w*, \w remember|strong="H02142"\w* \w . . .|strong="H04994"\w* \w -|strong="H00853"\w* \w how|strong="H00834"\w* \w I have walked|strong="H01980"\w* \w before You|strong="H06440"\w* \w faithfully|strong="H00571"\w* \w and with wholehearted|strong="H03824"\w* \w devotion|strong="H08003"\w*; \w I have done|strong="H06213"\w* \w [what is] good|strong="H02896"\w* \w in Your sight|strong="H05869"\w*.” \w And Hezekiah|strong="H02396"\w* \w . . .|strong="H01065"\w* \w wept|strong="H01058"\w* \w bitterly|strong="H01419"\w*.
