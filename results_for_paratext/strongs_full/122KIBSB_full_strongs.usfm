\p \v 21 \w And when the king|strong="H04428"\w* \w of Israel|strong="H03478"\w* \w saw|strong="H07200"\w* \w them|strong="H00853"\w*, \w he asked|strong="H00559"\w* \w . . .|strong="H00413"\w* \w Elisha|strong="H00477"\w*, “\w My father|strong="H00001"\w*, \w shall I kill [them]|strong="H05221"\w*? \w Shall I kill [them]|strong="H05221"\w*?”
\p \v 22 “\w Do not|strong="H03808"\w* \w kill them|strong="H05221"\w*,” \w he replied|strong="H00559"\w*. “\w {Would} you|strong="H00859"\w* \w kill|strong="H05221"\w* \w those|strong="H00834"\w* \w you have captured|strong="H07617"\w* \w with your own sword|strong="H02719"\w* \w or bow|strong="H07198"\w*? \w Set|strong="H07760"\w* \w food|strong="H03899"\w* \w and water|strong="H04325"\w* \w before them|strong="H06440"\w*, \w that they may eat|strong="H00398"\w* \w and drink|strong="H08354"\w* \w and then return|strong="H01980"\w* \w to|strong="H00413"\w* \w their master|strong="H00113"\w*.”
\p \v 23 \w So [the king] prepared a great|strong="H01419"\w* \w feast|strong="H03739"\w* . . . \w for them|strong="H03740"\w*, \w and after they had finished eating|strong="H00398"\w* \w and drinking|strong="H08354"\w*, \w he sent them away|strong="H07971"\w*, \w and they returned|strong="H01980"\w* \w to|strong="H00413"\w* \w their master|strong="H00113"\w*. \w And the Aramean|strong="H00758"\w* \w raiders|strong="H01416"\w* \w did not|strong="H03808"\w* \w come|strong="H00935"\w* \w into the land|strong="H00776"\w* \w of Israel|strong="H03478"\w* \w again|strong="H03254"\w* \w . . .|strong="H05750"\w*.
\s1 The Siege and Famine of Samaria
\p \v 24 \w -|strong="H01961"\w* \w Some time later|strong="H00310"\w* \w . . .|strong="H03651"\w*, \w vvv|strong="H01130"\w* \w Ben-hadad|strong="H01130"\w* \w king|strong="H04428"\w* \w of Aram|strong="H00758"\w* \w -|strong="H00853"\w* \w assembled|strong="H06908"\w* \w his entire|strong="H03605"\w* \w army|strong="H04264"\w* \w and marched up|strong="H05927"\w* \w to besiege|strong="H06696"\w* \w . . .|strong="H05921"\w* \w Samaria|strong="H08111"\w*.
\p \v 25 \w So there was|strong="H01961"\w* \w a great|strong="H01419"\w* \w famine|strong="H07458"\w* \w in Samaria|strong="H08111"\w*. \w Indeed|strong="H02009"\w*, \w they besieged|strong="H06696"\w* \w [the city]|strong="H05921"\w* \w so long that|strong="H05704"\w* \w a donkey’s|strong="H02543"\w* \w head|strong="H07218"\w* \w sold|strong="H01961"\w* \w for eighty [shekels]|strong="H08084"\w* \w of silver|strong="H03701"\w*,\f + \fr 6:25 \fqa 80 shekels \ft is approximately 2 pounds or 907.2 grams of silver.\f* \w and a quarter|strong="H07255"\w* \w cab|strong="H06894"\w* \w of dove’s dung|strong="H02716"\w*\f + \fr 6:25 \ft Or \fqa a quarter cab of seed pods\ft ; that is, approximately 0.28 dry quarts or 0.31 liters\f* \w sold for five [shekels]|strong="H02568"\w* \w of silver|strong="H03701"\w*.\f + \fr 6:25 \fqa 5 shekels \ft is approximately 2 ounces or 57 grams of silver.\f*
\p \v 26 \w -|strong="H01961"\w* \w As the king|strong="H04428"\w* \w of Israel|strong="H03478"\w* \w was passing by|strong="H05674"\w* \w on|strong="H05921"\w* \w the wall|strong="H02346"\w*, \w a woman|strong="H00802"\w* \w cried out|strong="H06817"\w* \w to him|strong="H00413"\w*, \w . . .|strong="H00559"\w* “\w Help me|strong="H03467"\w*, \w my lord|strong="H00113"\w* \w the king|strong="H04428"\w*!”
\p \v 27 \w He answered|strong="H00559"\w*, “\w If the LORD|strong="H03068"\w* \w does not|strong="H00408"\w* \w help you|strong="H03467"\w*, \w where|strong="H00370"\w* \w can I find help for you|strong="H03467"\w*? \w From|strong="H04480"\w* \w the threshing floor|strong="H01637"\w* \w or|strong="H00176"\w* \w . . .|strong="H04480"\w* \w the winepress|strong="H03342"\w*?” \v 28 \w Then the king|strong="H04428"\w* \w asked|strong="H00559"\w* her, “\w What|strong="H04100"\w* is the matter?”
\p \w And she answered|strong="H00559"\w*, “\w This|strong="H02063"\w* \w woman|strong="H00802"\w* \w said|strong="H00559"\w* \w to me|strong="H00413"\w*, ‘\w Give up|strong="H05414"\w* \w -|strong="H00853"\w* \w your son|strong="H01121"\w*, \w that we may eat him|strong="H00398"\w* \w . . .|strong="H03117"\w*, \w and|strong="H00853"\w* \w tomorrow|strong="H04279"\w* \w we will eat|strong="H00398"\w* \w my son|strong="H01121"\w*.’ \v 29 \w So we boiled|strong="H01310"\w* \w -|strong="H00853"\w* \w my son|strong="H01121"\w* \w and ate him|strong="H00398"\w*, \w and the next|strong="H00312"\w* \w day|strong="H03117"\w* \w I said|strong="H00559"\w* \w to her|strong="H00413"\w*, ‘\w Give up|strong="H05414"\w* \w -|strong="H00853"\w* \w your son|strong="H01121"\w*, \w that we may eat him|strong="H00398"\w*.’ \w But she had hidden|strong="H02244"\w* \w -|strong="H00853"\w* \w her son|strong="H01121"\w*.”
\p \v 30 \w -|strong="H01961"\w* \w When the king|strong="H04428"\w* \w -|strong="H00853"\w* \w heard|strong="H08085"\w* \w the words|strong="H01697"\w* \w of the woman|strong="H00802"\w*, \w he tore|strong="H07167"\w* \w -|strong="H00853"\w* \w his clothes|strong="H00899"\w*. \w And as he|strong="H01931"\w* \w passed by|strong="H05674"\w* \w on|strong="H05921"\w* \w the wall|strong="H02346"\w*, \w the people|strong="H05971"\w* \w saw|strong="H07200"\w* \w vvv|strong="H02009"\w* \w the sackcloth|strong="H08242"\w* \w under his clothes|strong="H01004"\w* \w next to|strong="H05921"\w* \w his skin|strong="H01320"\w*. \v 31 \w He announced|strong="H00559"\w*, “\w May God|strong="H00430"\w* \w punish|strong="H03541"\w* \w . . .|strong="H06213"\w* me, \w and ever so|strong="H03541"\w* \w severely|strong="H03254"\w*, \w if|strong="H00518"\w* \w the head|strong="H07218"\w* \w of Elisha|strong="H00477"\w* \w son|strong="H01121"\w* \w of Shaphat|strong="H08202"\w* \w remains|strong="H05975"\w* \w on his shoulders|strong="H05921"\w* \w through this day|strong="H03117"\w*!”
\p \v 32 \w Now Elisha|strong="H00477"\w* \w was sitting|strong="H03427"\w* \w in his house|strong="H01004"\w*, \w and the elders|strong="H02205"\w* \w were sitting|strong="H03427"\w* \w with him|strong="H00854"\w*. \w The king sent|strong="H07971"\w* \w a messenger|strong="H00376"\w* \w ahead|strong="H06440"\w*, \w but before|strong="H02962"\w* \w [he]|strong="H04397"\w* \w arrived|strong="H00935"\w* \w . . .|strong="H00413"\w*, \w Elisha|strong="H01931"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w the elders|strong="H02205"\w*, “\w Do you see|strong="H07200"\w* \w how|strong="H03588"\w* \w this|strong="H02088"\w* \w murderer|strong="H01121"\w* \w . . .|strong="H07523"\w* \w has sent|strong="H07971"\w* \w someone to cut off|strong="H05493"\w* \w -|strong="H00853"\w* \w my head|strong="H07218"\w*? \w Look|strong="H07200"\w*, \w when the messenger|strong="H04397"\w* \w comes|strong="H00935"\w*, \w shut|strong="H05462"\w* \w the door|strong="H01817"\w* \w to keep him out|strong="H03905"\w*. \w -|strong="H00853"\w* \w -|strong="H01817"\w* \w Is not|strong="H03808"\w* \w the sound|strong="H06963"\w* \w of his master’s|strong="H00113"\w* \w footsteps|strong="H07272"\w* \w behind him|strong="H00310"\w*?”
\p \v 33 \w While Elisha was still|strong="H05750"\w* \w speaking|strong="H01696"\w* \w with them|strong="H05973"\w*, \w . . .|strong="H02009"\w* \w the messenger|strong="H04397"\w* \w came down|strong="H03381"\w* \w to him|strong="H00413"\w*. \w And [the king] said|strong="H00559"\w*, \w . . .|strong="H02009"\w* “\w This|strong="H02063"\w* \w calamity [is]|strong="H07451"\w* \w from|strong="H00854"\w* \w the LORD|strong="H03068"\w*. \w Why|strong="H04100"\w* \w should I wait|strong="H03176"\w* \w for the LORD|strong="H03068"\w* \w any longer|strong="H05750"\w*?”
\c 7
\s1 Elisha’s Prophecy of Plenty
\p \v 1 \w Then Elisha|strong="H00477"\w* \w said|strong="H00559"\w*, “\w Hear|strong="H08085"\w* \w the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w*! \w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: ‘\w About this time|strong="H06256"\w* \w tomorrow|strong="H04279"\w* \w at the gate|strong="H08179"\w* \w of Samaria|strong="H08111"\w*, \w a seah|strong="H05429"\w* \w of fine flour|strong="H05560"\w*\f + \fr 7:1 \fqa A seah \ft is approximately 6.6 dry quarts or 7.3 liters (probably about 8.2 pounds or 3.7 kilograms of flour); here and in verses 16 and 18.\f* \w [will sell] for a shekel|strong="H08255"\w*,\f + \fr 7:1 \fqa A shekel \ft is approximately 0.4 ounces or 11.4 grams, probably of silver; here and in verses 16 and 18.\f* \w and two seahs|strong="H05429"\w* \w of barley|strong="H08184"\w*\f + \fr 7:1 \fqa 2 seahs \ft is approximately 13.2 dry quarts or 14.6 liters (probably about 19.3 pounds or 8.8 kilograms of barley); here and in verses 16 and 18.\f* \w will sell for a shekel|strong="H08255"\w*.’”
\p \v 2 \w But the officer|strong="H07991"\w*\w . . .|strong="H00834"\w* \w on|strong="H05921"\w* \w whose arm|strong="H03027"\w* \w the king|strong="H04428"\w* \w leaned|strong="H08172"\w* \w -|strong="H00853"\w* \w answered|strong="H06030"\w* \w the man|strong="H00376"\w* \w of God|strong="H00430"\w*,\w . . .|strong="H00559"\w* “\w Look|strong="H02009"\w*, \w even if the LORD|strong="H03068"\w* \w were to make|strong="H06213"\w* \w windows|strong="H00699"\w* \w in heaven|strong="H08064"\w*, \w could this|strong="H02088"\w* \w really happen|strong="H01961"\w*?” \w -|strong="H01697"\w*
\p “\w You will see [it]|strong="H07200"\w* \w with your own eyes|strong="H05869"\w*,” \w replied [Elisha]|strong="H00559"\w*, \w . . .|strong="H02005"\w* “\w vvv|strong="H03808"\w* \w but you will not eat|strong="H00398"\w* \w any of it|strong="H08033"\w*.”
\s1 The Arameans Flee
\p \v 3 \w Now there were|strong="H01961"\w* \w four|strong="H00702"\w* \w men|strong="H00582"\w* \w with leprosy|strong="H06879"\w*\f + \fr 7:3 \fqa Leprosy \ft was a term used for various skin diseases; here and in verse 8; see Leviticus 13.\f* \w at the entrance|strong="H06607"\w* \w of the city gate|strong="H08179"\w*, \w and they said|strong="H00559"\w* \w to|strong="H00413"\w* \w one|strong="H00376"\w* \w another|strong="H07453"\w*, “\w Why|strong="H04100"\w* \w . . .|strong="H00587"\w* \w just sit|strong="H03427"\w* \w here|strong="H06311"\w* \w until|strong="H05704"\w* \w we die|strong="H04191"\w*? \v 4 \w If|strong="H00518"\w* \w we say|strong="H00559"\w*, ‘\w Let us go into|strong="H00935"\w* \w the city|strong="H05892"\w*,’ \w we will die|strong="H04191"\w* \w there|strong="H08033"\w* \w from the famine|strong="H07458"\w* \w in the city|strong="H05892"\w*; \w but if|strong="H00518"\w* \w we sit|strong="H03427"\w* \w here|strong="H06311"\w*, \w we will also die|strong="H04191"\w*. \w So come|strong="H01980"\w* \w now|strong="H06258"\w*, \w let us go over|strong="H05307"\w* \w to|strong="H00413"\w* \w the camp|strong="H04264"\w* \w of the Arameans|strong="H00758"\w*. \w If|strong="H00518"\w* \w they let us live|strong="H02421"\w*, \w we will live|strong="H02421"\w*; \w if|strong="H00518"\w* \w they kill us|strong="H04191"\w*, \w we will die|strong="H04191"\w*.”
\p \v 5 \w So they arose|strong="H06965"\w* \w at twilight|strong="H05399"\w* \w and went|strong="H00935"\w* \w to|strong="H00413"\w* \w the camp|strong="H04264"\w* \w of the Arameans|strong="H00758"\w*. \w But when they came|strong="H00935"\w* \w to|strong="H05704"\w* \w the outskirts|strong="H07097"\w* \w of the camp|strong="H04264"\w* \w . . .|strong="H00758"\w*, \w there was not|strong="H00369"\w* \w a man|strong="H00376"\w* \w to be found|strong="H02009"\w* \w -|strong="H08033"\w*. \v 6 \w For the Lord|strong="H00136"\w* \w {had caused} the Arameans|strong="H00758"\w* \w . . .|strong="H04264"\w* \w to hear|strong="H08085"\w* \w -|strong="H00853"\w* \w the sound|strong="H06963"\w* \w of chariots|strong="H07393"\w*, \w . . .|strong="H06963"\w* \w horses|strong="H05483"\w*, \w . . .|strong="H06963"\w* \w and a great|strong="H01419"\w* \w army|strong="H02428"\w*, \w so that they said|strong="H00559"\w* \w to|strong="H00413"\w* \w one|strong="H00376"\w* \w another|strong="H00251"\w*, “\w Look|strong="H02009"\w*,\w . . .|strong="H05921"\w* \w the king|strong="H04428"\w* \w of Israel|strong="H03478"\w* \w -|strong="H00853"\w* \w must have hired|strong="H07936"\w* \w the kings|strong="H04428"\w* \w of the Hittites|strong="H02850"\w* \w and|strong="H00853"\w* \w -|strong="H04428"\w* \w Egyptians|strong="H04714"\w* \w to attack|strong="H00935"\w* \w us|strong="H05921"\w*.”
\p \v 7 \w Thus [the Arameans] had arisen|strong="H06965"\w* \w and fled|strong="H05127"\w* \w at twilight|strong="H05399"\w*, \w abandoning|strong="H05800"\w* \w -|strong="H00853"\w* \w their tents|strong="H00168"\w* \w and|strong="H00853"\w* \w horses|strong="H05483"\w* \w and|strong="H00853"\w* \w donkeys|strong="H02543"\w*. \w The camp was intact|strong="H04264"\w* \w -|strong="H00834"\w*, \w -|strong="H01931"\w* \w and they had run|strong="H05127"\w* \w for|strong="H00413"\w* \w their lives|strong="H05315"\w*.
\p \v 8 \w When the|strong="H00428"\w* \w lepers|strong="H06879"\w* \w reached|strong="H00935"\w* \w . . .|strong="H05704"\w* \w the edge|strong="H07097"\w* \w of the camp|strong="H04264"\w*, \w they went|strong="H00935"\w* \w into|strong="H00413"\w* \w a|strong="H00259"\w* \w tent|strong="H00168"\w* \w to eat|strong="H00398"\w* \w and drink|strong="H08354"\w*. \w Then they carried off|strong="H05375"\w* \w . . .|strong="H08033"\w* \w the silver|strong="H03701"\w*, \w gold|strong="H02091"\w*, \w and clothing|strong="H00899"\w*, \w and went|strong="H01980"\w* \w and hid [them]|strong="H02934"\w*. \w On returning|strong="H07725"\w*, \w they entered|strong="H00935"\w* \w . . .|strong="H00413"\w* \w another|strong="H00312"\w* \w tent|strong="H00168"\w*, \w carried off [some items]|strong="H05375"\w* \w from there|strong="H08033"\w*, \w . . .|strong="H01980"\w* \w and hid them|strong="H02934"\w*.
\p \v 9 \w Finally, they said|strong="H00559"\w* \w to|strong="H00413"\w* \w one|strong="H00376"\w* \w another|strong="H07453"\w*, “\w We are|strong="H00587"\w* \w not|strong="H03808"\w* \w doing|strong="H06213"\w* \w what is right|strong="H03651"\w*. \w Today|strong="H03117"\w* \w . . .|strong="H02088"\w* \w is a day|strong="H03117"\w* \w of good news|strong="H01309"\w*. \w . . .|strong="H01931"\w* \w If we|strong="H00587"\w* \w are silent|strong="H02814"\w* \w and wait|strong="H02442"\w* \w until|strong="H05704"\w* \w morning|strong="H01242"\w* \w light|strong="H00216"\w*, \w our sin|strong="H05771"\w* \w will overtake us|strong="H04672"\w*. \w Now, therefore|strong="H06258"\w*, \w . . .|strong="H01980"\w* \w let us go|strong="H00935"\w* \w and tell|strong="H05046"\w* \w the king’s|strong="H04428"\w* \w household|strong="H01004"\w*.”
\p \v 10 \w So they went|strong="H00935"\w* \w and called out|strong="H07121"\w* \w to|strong="H00413"\w* \w the gatekeepers|strong="H07778"\w* \w of the city|strong="H05892"\w*, \w saying|strong="H05046"\w* . . . \w . . .|strong="H00559"\w*, “\w We went|strong="H00935"\w* \w to|strong="H00413"\w* \w the Aramean|strong="H00758"\w* \w . . .|strong="H02009"\w* \w camp|strong="H04264"\w* \w and no|strong="H00369"\w* \w one [was]|strong="H00376"\w* \w there|strong="H08033"\w*— \w not a trace|strong="H06963"\w* \w . . .|strong="H00120"\w* —\w . . .|strong="H03588"\w* \w only|strong="H00518"\w* \w tethered|strong="H00631"\w* \w horses|strong="H05483"\w* \w and donkeys|strong="H02543"\w* \w . . .|strong="H00631"\w*, \w and the tents|strong="H00168"\w* \w -|strong="H00834"\w* \w were intact|strong="H01992"\w*.”
\p \v 11 \w The gatekeepers|strong="H07778"\w* \w shouted the news|strong="H07121"\w*, \w and it was reported|strong="H05046"\w* \w to the king’s|strong="H04428"\w* \w . . .|strong="H06441"\w* \w household|strong="H01004"\w*.
\p \v 12 \w So the king|strong="H04428"\w* \w got up|strong="H06965"\w* \w in the night|strong="H03915"\w* \w and said|strong="H00559"\w* \w to|strong="H00413"\w* \w his servants|strong="H05650"\w*, “\w Let me tell|strong="H05046"\w* \w . . .|strong="H04994"\w* you \w -|strong="H00853"\w* \w what|strong="H00834"\w* \w the Arameans|strong="H00758"\w* \w have done|strong="H06213"\w* to us. \w They know|strong="H03045"\w*\w . . .|strong="H03588"\w* \w we|strong="H00587"\w* \w are starving|strong="H07457"\w*, \w so they have left|strong="H03318"\w*\w . . .|strong="H04480"\w* \w the camp|strong="H04264"\w* \w to hide|strong="H02247"\w* \w in the field|strong="H07704"\w*, \w thinking|strong="H00559"\w*, ‘\w When|strong="H03588"\w* \w they come out|strong="H03318"\w* \w of|strong="H04480"\w* \w the city|strong="H05892"\w*, \w we will take them|strong="H08610"\w* \w alive|strong="H02416"\w* \w and enter|strong="H00935"\w* \w . . .|strong="H00413"\w* \w the city|strong="H05892"\w*.’”
\p \v 13 \w But one|strong="H00259"\w* \w of his servants|strong="H05650"\w* \w . . .|strong="H00559"\w* \w replied|strong="H06030"\w*, “\w Please|strong="H04994"\w*, \w have [scouts] take|strong="H03947"\w* \w five|strong="H02568"\w* \w of|strong="H04480"\w* \w the horses|strong="H05483"\w* \w that|strong="H00834"\w* \w remain|strong="H07604"\w* \w . . .|strong="H07604"\w* in the city. \w Their plight|strong="H02009"\w* \w will be no worse than all|strong="H03605"\w* \w vvv|strong="H01995"\w* \w the Israelites|strong="H03478"\w* \w who|strong="H00834"\w* \w are left|strong="H07604"\w* here. \w You can see|strong="H02005"\w* \w that|strong="H03605"\w* \w vvv|strong="H01995"\w* \w all the Israelites|strong="H03478"\w* \w here|strong="H00834"\w* \w are doomed|strong="H08552"\w*. \w So let us send them|strong="H07971"\w* \w and find out|strong="H07200"\w*.”
\p \v 14 \w Then [the scouts] took|strong="H03947"\w* \w two|strong="H08147"\w* \w chariots|strong="H07393"\w* \w with horses|strong="H05483"\w*, \w and the king|strong="H04428"\w* \w sent them|strong="H07971"\w* \w after|strong="H00310"\w* \w the Aramean|strong="H00758"\w* \w army|strong="H04264"\w*, \w saying|strong="H00559"\w*, “\w Go|strong="H01980"\w* \w and see|strong="H07200"\w*.” \v 15 \w And they tracked them|strong="H01980"\w* \w . . .|strong="H00310"\w* \w as|strong="H05704"\w* \w far as the Jordan|strong="H03383"\w*, \w and indeed|strong="H02009"\w*, \w the whole|strong="H03605"\w* \w way|strong="H01870"\w* \w was littered with|strong="H04392"\w* \w the clothing|strong="H00899"\w* \w and equipment|strong="H03627"\w* \w -|strong="H00834"\w* \w the Arameans|strong="H00758"\w* \w had thrown off|strong="H07993"\w* \w in haste|strong="H02648"\w*. \w So the scouts|strong="H04397"\w* \w returned|strong="H07725"\w* \w and told|strong="H05046"\w* \w the king|strong="H04428"\w*.
\s1 Elisha’s Prophecy Fulfilled
\p \v 16 \w Then the people|strong="H05971"\w* \w went out|strong="H03318"\w* \w and plundered|strong="H00962"\w* \w -|strong="H00853"\w* \w the camp|strong="H04264"\w* \w of the Arameans|strong="H00758"\w*. \w It was then that|strong="H01961"\w* \w a seah|strong="H05429"\w* \w of fine flour|strong="H05560"\w* \w [sold] for a shekel|strong="H08255"\w*, \w and two seahs|strong="H05429"\w* \w of barley|strong="H08184"\w* \w [sold] for a shekel|strong="H08255"\w*, \w according to the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w*.
\p \v 17 \w Now the king|strong="H04428"\w* \w had appointed|strong="H06485"\w* \w -|strong="H00853"\w* \w the officer|strong="H07991"\w* \w on|strong="H05921"\w* \w whose|strong="H00834"\w* \w arm|strong="H03027"\w* \w he leaned|strong="H08172"\w* \w to be in charge of|strong="H05921"\w* \w the gate|strong="H08179"\w*, \w but the people|strong="H05971"\w* \w trampled him|strong="H07429"\w* \w in the gateway|strong="H08179"\w*, \w and he died|strong="H04191"\w*, \w just as|strong="H00834"\w*\w . . .|strong="H01696"\w* \w the man|strong="H00376"\w* \w of God|strong="H00430"\w* \w -|strong="H00834"\w* \w had foretold|strong="H01696"\w* \w when the king|strong="H04428"\w* \w had come|strong="H03381"\w* \w to him|strong="H00413"\w*. \v 18 \w It happened|strong="H01961"\w* \w just as the man|strong="H00376"\w* \w of God|strong="H00430"\w* \w had told|strong="H01696"\w* \w . . .|strong="H00413"\w* \w the king|strong="H04428"\w* \w . . .|strong="H00559"\w*: “\w About this time|strong="H06256"\w* \w tomorrow|strong="H04279"\w* \w at the gate|strong="H08179"\w* \w of Samaria|strong="H08111"\w*, \w two seahs|strong="H05429"\w* \w of barley|strong="H08184"\w* \w will sell for a shekel|strong="H08255"\w*, \w and a seah|strong="H05429"\w* \w of fine flour|strong="H05560"\w* \w will sell|strong="H01961"\w* \w for a shekel|strong="H08255"\w*.”
\p \v 19 \w And the officer|strong="H07991"\w* \w -|strong="H00853"\w* \w had answered|strong="H06030"\w* \w the man|strong="H00376"\w* \w of God|strong="H00430"\w*,\w . . .|strong="H00559"\w* “\w Look|strong="H02009"\w*, \w even if the LORD|strong="H03068"\w* \w were to make|strong="H06213"\w* \w windows|strong="H00699"\w* \w in heaven|strong="H08064"\w*, \w could this|strong="H02088"\w* \w really happen|strong="H01961"\w* \w . . .|strong="H01697"\w*?”
\p \w So Elisha had replied|strong="H00559"\w*, “\w -|strong="H02005"\w* \w You will see [it]|strong="H07200"\w* \w with your own eyes|strong="H05869"\w*, \w but you will not|strong="H03808"\w* \w eat|strong="H00398"\w* \w any of it|strong="H08033"\w*!”
\p \v 20 \w And that|strong="H03651"\w* \w is just what happened|strong="H01961"\w* to him. \w The people|strong="H05971"\w* \w trampled|strong="H07429"\w* \w him|strong="H00853"\w* \w in the gateway|strong="H08179"\w*, \w and he died|strong="H04191"\w*.
\c 8
\s1 The Shunammite’s Land Restored
\p \v 1 \w Now Elisha|strong="H00477"\w* \w had said|strong="H01696"\w* \w to|strong="H00413"\w* \w the woman|strong="H00802"\w* \w whose|strong="H00834"\w* \w son|strong="H01121"\w* \w . . .|strong="H00559"\w* \w he had restored to life|strong="H02421"\w*, \w -|strong="H00853"\w* “\w Arise|strong="H06965"\w*, \w you|strong="H00859"\w* \w and your household|strong="H01004"\w*; \w go|strong="H01980"\w* \w and live as a foreigner|strong="H01481"\w* \w wherever|strong="H00834"\w* \w you can|strong="H01481"\w*. \w For|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w has decreed that|strong="H07121"\w* \w a seven-year|strong="H07651"\w* \w . . .|strong="H08141"\w* \w famine|strong="H07458"\w* \w -|strong="H01571"\w* \w will come|strong="H00935"\w* \w to|strong="H00413"\w* \w the land|strong="H00776"\w*.”
\p \v 2 \w So the woman|strong="H00802"\w* \w had proceeded|strong="H06965"\w* \w to do|strong="H06213"\w* \w as the man|strong="H00376"\w* \w of God|strong="H00430"\w* \w . . .|strong="H01980"\w* \w had instructed|strong="H01697"\w*. \w And she|strong="H01931"\w* \w and her household|strong="H01004"\w* \w lived as foreigners|strong="H01481"\w* \w for seven|strong="H07651"\w* \w years|strong="H08141"\w* \w in the land|strong="H00776"\w* \w of the Philistines|strong="H06430"\w*.
\p \v 3 \w -|strong="H01961"\w* \w At the end|strong="H07097"\w* \w of seven|strong="H07651"\w* \w years|strong="H08141"\w*, \w when the woman|strong="H00802"\w* \w returned|strong="H07725"\w* \w from the land|strong="H00776"\w* \w of the Philistines|strong="H06430"\w*, \w she went|strong="H03318"\w* \w to|strong="H00413"\w* \w the king|strong="H04428"\w* \w to appeal|strong="H06817"\w* \w for|strong="H00413"\w* \w her house|strong="H01004"\w* \w and|strong="H00413"\w* \w her land|strong="H07704"\w*.
\p \v 4 \w Now the king|strong="H04428"\w* \w had been speaking|strong="H01696"\w* \w to|strong="H00413"\w* \w Gehazi|strong="H01522"\w*, \w the servant|strong="H05288"\w* \w of the man|strong="H00376"\w* \w of God|strong="H00430"\w*, \w saying|strong="H00559"\w*, “\w Please|strong="H04994"\w* \w relate|strong="H05608"\w* to me \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the great things|strong="H01419"\w*\w . . .|strong="H00834"\w* \w Elisha|strong="H00477"\w* \w has done|strong="H06213"\w*.”
\p \v 5 \w And|strong="H01961"\w* \w Gehazi|strong="H01931"\w* \w was telling|strong="H05608"\w* \w the king|strong="H04428"\w* \w -|strong="H00853"\w* \w how|strong="H00834"\w* \w Elisha had brought the dead|strong="H04191"\w* \w back to life|strong="H02421"\w*. \w -|strong="H00853"\w* \w Just then|strong="H02009"\w* \w the woman|strong="H00802"\w* \w whose|strong="H00834"\w* \w son|strong="H01121"\w* \w [Elisha] had revived|strong="H02421"\w* \w -|strong="H00853"\w* \w came to appeal|strong="H06817"\w* \w to|strong="H00413"\w* \w the king|strong="H04428"\w* \w for|strong="H05921"\w* \w her house|strong="H01004"\w* \w and|strong="H05921"\w* \w her land|strong="H07704"\w*. \w So Gehazi|strong="H01522"\w* \w said|strong="H00559"\w*, “\w My lord|strong="H00113"\w* \w the king|strong="H04428"\w*, \w this|strong="H02063"\w* \w is the woman|strong="H00802"\w*, \w and this|strong="H02088"\w* \w is the son|strong="H01121"\w* \w -|strong="H00834"\w* \w Elisha|strong="H00477"\w* \w restored to life|strong="H02421"\w*.”
\p \v 6 \w When the king|strong="H04428"\w* \w asked|strong="H07592"\w* \w the woman|strong="H00802"\w*, \w she confirmed it|strong="H05608"\w* -. \w So the king|strong="H04428"\w* \w appointed|strong="H05414"\w* for her \w an|strong="H00259"\w* \w officer|strong="H05631"\w*, \w saying|strong="H00559"\w*, “\w Restore|strong="H07725"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w that [was]|strong="H00834"\w* hers, \w -|strong="H00853"\w* \w along with all|strong="H03605"\w* \w the proceeds|strong="H08393"\w* \w of the field|strong="H07704"\w* \w from the day|strong="H03117"\w* \w that she left|strong="H05800"\w* \w -|strong="H00853"\w* \w the country|strong="H00776"\w* \w until|strong="H05704"\w* \w now|strong="H06258"\w*.”
\s1 Hazael Murders Ben-hadad
\p \v 7 \w Then Elisha|strong="H00477"\w* \w came|strong="H00935"\w* \w to Damascus|strong="H01834"\w* \w vvv|strong="H01130"\w* \w while Ben-hadad|strong="H01130"\w* \w king|strong="H04428"\w* \w of Aram|strong="H00758"\w* \w was sick|strong="H02470"\w*, \w and the king was told|strong="H05046"\w*, \w -|strong="H00559"\w* “\w The man|strong="H00376"\w* \w of God|strong="H00430"\w* \w . . .|strong="H05704"\w* \w has come|strong="H00935"\w* \w here|strong="H02008"\w*.”
\p \v 8 \w So the king|strong="H04428"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Hazael|strong="H02371"\w*, “\w Take|strong="H03947"\w* \w a gift|strong="H04503"\w* \w in your hand|strong="H03027"\w*, \w go|strong="H01980"\w* \w to meet|strong="H07122"\w* \w the man|strong="H00376"\w* \w of God|strong="H00430"\w*, \w and inquire|strong="H01875"\w* \w of|strong="H00853"\w* \w the LORD|strong="H03068"\w* \w through him|strong="H00853"\w* \w -|strong="H00559"\w*, ‘\w Will I recover|strong="H02421"\w* \w from this|strong="H02088"\w* \w illness|strong="H02483"\w*?’”
\p \v 9 \w So Hazael|strong="H02371"\w* \w went|strong="H01980"\w* \w to meet Elisha|strong="H07122"\w*, \w taking|strong="H03947"\w* \w with him|strong="H03027"\w* \w a gift|strong="H04503"\w* \w of forty|strong="H00705"\w* \w camel loads|strong="H04853"\w* \w . . .|strong="H01581"\w* \w of every|strong="H03605"\w* \w good thing|strong="H02898"\w* \w from Damascus|strong="H01834"\w*. \w And he went in|strong="H00935"\w* \w and stood|strong="H05975"\w* \w before him|strong="H06440"\w* \w and said|strong="H00559"\w*, “\w Your son|strong="H01121"\w* \w vvv|strong="H01130"\w* \w Ben-hadad|strong="H01130"\w* \w king|strong="H04428"\w* \w of Aram|strong="H00758"\w* \w has sent me|strong="H07971"\w* \w . . .|strong="H00413"\w* \w to ask|strong="H00559"\w*, ‘\w Will I recover|strong="H02421"\w* \w from this|strong="H02088"\w* \w illness|strong="H02483"\w*?’”
\p \v 10 \w Elisha|strong="H00477"\w* \w answered|strong="H00559"\w*, \w . . .|strong="H00413"\w* “\w Go|strong="H01980"\w* \w and tell him|strong="H00559"\w*, \w . . .|strong="H03808"\w* ‘\w You will surely recover|strong="H02421"\w* \w . . .|strong="H02421"\w*.’ \w But the LORD|strong="H03068"\w*\f + \fr 8:10 \ft Or \fqa “Go and say, ‘You will surely not recover.’ And the LORD\f* \w has shown me|strong="H07200"\w* \w that|strong="H03588"\w* \w in fact he will die|strong="H04191"\w* \w . . .|strong="H04191"\w*.”
\p \v 11 \w [Elisha] fixed|strong="H05975"\w*\w . . .|strong="H00853"\w* \w his gaze|strong="H06440"\w* \w steadily|strong="H07760"\w* \w [on him] until|strong="H05704"\w* \w Hazael became uncomfortable|strong="H00954"\w*. \w Then the man|strong="H00376"\w* \w of God|strong="H00430"\w* \w began to weep|strong="H01058"\w*.
\p \v 12 “\w Why|strong="H04069"\w* \w is my lord|strong="H00113"\w* \w weeping|strong="H01058"\w*?” \w asked|strong="H00559"\w* \w Hazael|strong="H02371"\w*.
\p “\w Because|strong="H03588"\w* \w I know|strong="H03045"\w* \w -|strong="H00853"\w* \w -|strong="H00834"\w* \w the evil|strong="H07451"\w* \w you will do|strong="H06213"\w* \w vvv|strong="H01121"\w* \w to the Israelites|strong="H03478"\w*,” \w [Elisha] replied|strong="H00559"\w*. “\w You will set|strong="H07971"\w* \w fire|strong="H00784"\w* \w to their fortresses|strong="H04013"\w*, \w kill|strong="H02026"\w* \w their young men|strong="H00970"\w* \w with the sword|strong="H02719"\w*, \w dash their little ones|strong="H05768"\w* \w to pieces|strong="H07376"\w*, \w and rip open|strong="H01234"\w* \w their pregnant women|strong="H02030"\w*.”
\p \v 13 “\w But|strong="H03588"\w* \w how {could}|strong="H04100"\w* \w your servant|strong="H05650"\w*, \w a mere dog|strong="H03611"\w*, \w -|strong="H03588"\w* \w do|strong="H06213"\w* \w such|strong="H02088"\w* \w a monstrous|strong="H01419"\w* \w thing|strong="H01697"\w*?” \w said|strong="H00559"\w* \w Hazael|strong="H02371"\w*.
\p \w And Elisha|strong="H00477"\w* \w answered|strong="H00559"\w*, “\w The LORD|strong="H03068"\w* \w has shown me|strong="H07200"\w* \w that you [will be]|strong="H00853"\w* \w king|strong="H04428"\w* \w over|strong="H05921"\w* \w Aram|strong="H00758"\w*.”
\p \v 14 \w So Hazael left|strong="H01980"\w*\w . . .|strong="H00854"\w* \w Elisha|strong="H00477"\w* \w and went|strong="H00935"\w* \w to|strong="H00413"\w* \w his master|strong="H00113"\w*, \w who asked|strong="H00559"\w* him, “\w What|strong="H04100"\w* \w did Elisha|strong="H00477"\w* \w say|strong="H00559"\w* to you?”
\p \w And he replied|strong="H00559"\w*, “\w He told me|strong="H00559"\w* [that] \w you would surely recover|strong="H02421"\w* \w . . .|strong="H02421"\w*.” \v 15 \w But|strong="H01961"\w* \w the next day|strong="H04283"\w* \w Hazael took|strong="H03947"\w* \w a thick cloth|strong="H04346"\w*, \w dipped|strong="H02881"\w* \w it in water|strong="H04325"\w*, \w and spread|strong="H06566"\w* \w it over|strong="H05921"\w* \w the king’s face|strong="H06440"\w*.
\p \w So Ben-hadad died|strong="H04191"\w*, \w and Hazael|strong="H02371"\w* \w reigned|strong="H04427"\w* \w in his place|strong="H08478"\w*.
\s1 Jehoram Reigns in Judah
\p \v 16 \w In the fifth|strong="H02568"\w* \w year|strong="H08141"\w* \w of the reign|strong="H04428"\w* \w of Joram|strong="H03141"\w* \w son|strong="H01121"\w* \w of Ahab|strong="H00256"\w* \w over Israel|strong="H03478"\w*, \w Jehoram|strong="H03088"\w* \w son|strong="H01121"\w* \w of Jehoshaphat|strong="H03092"\w* \w succeeded his father|strong="H04427"\w* \w . . .|strong="H03092"\w* \w . . .|strong="H04428"\w* \w . . .|strong="H03063"\w* \w as king|strong="H04428"\w* \w of Judah|strong="H03063"\w*. \v 17 \w [Jehoram] was|strong="H01961"\w* \w thirty-two|strong="H07970"\w* \w . . .|strong="H08147"\w* \w years old|strong="H01121"\w* \w . . .|strong="H08141"\w* \w when he became king|strong="H04427"\w*, \w and he reigned|strong="H04427"\w* \w in Jerusalem|strong="H03389"\w* \w eight|strong="H08083"\w* \w years|strong="H08141"\w*.
\p \v 18 \w And [Jehoram] walked|strong="H01980"\w* \w in the ways|strong="H01870"\w* \w of the kings|strong="H04428"\w* \w of Israel|strong="H03478"\w*, \w just as|strong="H00834"\w* \w the house|strong="H01004"\w* \w of Ahab|strong="H00256"\w* \w had done|strong="H06213"\w*. \w For|strong="H03588"\w* \w he married|strong="H00802"\w* \w a daughter|strong="H01323"\w* \w of Ahab|strong="H00256"\w* \w -|strong="H01961"\w* \w and did|strong="H06213"\w* \w evil|strong="H07451"\w* \w in the sight|strong="H05869"\w* \w of the LORD|strong="H03068"\w*.
\p \v 19 \w Yet for the sake|strong="H04616"\w* \w of His servant|strong="H05650"\w* \w David|strong="H01732"\w*, \w the LORD|strong="H03068"\w* \w was unwilling|strong="H03808"\w* \w . . .|strong="H00014"\w* \w to destroy|strong="H07843"\w* \w -|strong="H00853"\w* \w Judah|strong="H03063"\w*, \w since|strong="H00834"\w* \w He had promised|strong="H00559"\w* \w to maintain|strong="H05414"\w* \w a lamp|strong="H05216"\w* for David \w [and] his descendants|strong="H01121"\w* \w forever|strong="H03605"\w* \w . . .|strong="H03117"\w*.
\s1 Edom and Libnah Rebel
\p \v 20 \w In the days [of Jehoram]|strong="H03117"\w*,\f + \fr 8:20 \ft Literally \fqa In his days\f* \w Edom|strong="H00123"\w* \w rebelled|strong="H06586"\w* \w against|strong="H08478"\w* \w the hand|strong="H03027"\w* \w of Judah|strong="H03063"\w* \w and appointed|strong="H04427"\w* \w their own|strong="H05921"\w* \w king|strong="H04428"\w*. \v 21 \w So Jehoram|strong="H03141"\w*\f + \fr 8:21 \ft Hebrew \fqa Joram\ft , a variant of \fqa Jehoram \ft (the son of Jehoshaphat), as in verse 16; also in verses 23 and 24\f* \w crossed over|strong="H05674"\w* \w to Zair|strong="H06811"\w* \w with|strong="H05973"\w* \w . . .|strong="H01961"\w* \w all|strong="H03605"\w* \w his chariots|strong="H07393"\w*. \w When the Edomites|strong="H00123"\w* \w surrounded|strong="H05437"\w* \w him|strong="H00413"\w* \w and|strong="H00853"\w* \w his chariot|strong="H07393"\w* \w commanders|strong="H08269"\w*, \w he|strong="H01931"\w* \w rose up|strong="H06965"\w* \w and attacked|strong="H05221"\w* \w by night|strong="H03915"\w*. \w -|strong="H00853"\w* \w His troops, however|strong="H05971"\w*, \w fled|strong="H05127"\w* \w to their homes|strong="H00168"\w*.
\p \v 22 \w So to|strong="H05704"\w* \w this|strong="H02088"\w* \w day|strong="H03117"\w* \w Edom|strong="H00123"\w* \w has been in rebellion|strong="H06586"\w* \w against|strong="H08478"\w* \w the hand of|strong="H03027"\w* \w Judah|strong="H03063"\w*. \w Likewise|strong="H00227"\w*, \w Libnah|strong="H03841"\w* \w rebelled|strong="H06586"\w* \w at the same|strong="H01931"\w* \w time|strong="H06256"\w*.
\p \v 23 \w As for the rest|strong="H03499"\w* \w of the acts|strong="H01697"\w* \w of Jehoram|strong="H03141"\w*, \w along with all|strong="H03605"\w* \w his accomplishments|strong="H00834"\w* \w . . .|strong="H06213"\w*, \w are they|strong="H01992"\w* \w not|strong="H03808"\w* \w written|strong="H03789"\w* \w in|strong="H05921"\w* \w the book|strong="H05612"\w* \w of the Chronicles|strong="H01697"\w* \w . . .|strong="H03117"\w* \w of the Kings|strong="H04428"\w* \w of Judah|strong="H03063"\w*?
\p \v 24 \w And Jehoram|strong="H03141"\w* \w rested|strong="H07901"\w* \w with|strong="H05973"\w* \w his fathers|strong="H00001"\w* \w and was buried|strong="H06912"\w* \w with|strong="H05973"\w* \w [them]|strong="H00001"\w* \w in the City|strong="H05892"\w* \w of David|strong="H01732"\w*. \w And his son|strong="H01121"\w* \w Ahaziah|strong="H00274"\w* \w reigned|strong="H04427"\w* \w in his place|strong="H08478"\w*.
\s1 Ahaziah Reigns in Judah
\p \v 25 \w In the twelfth|strong="H08147"\w* \w . . .|strong="H06240"\w* \w . . .|strong="H08141"\w* \w year|strong="H08141"\w* \w of the reign|strong="H04428"\w* \w of Joram|strong="H03141"\w* \w son|strong="H01121"\w* \w of Ahab|strong="H00256"\w* \w over Israel|strong="H03478"\w*, \w Ahaziah|strong="H00274"\w* \w son|strong="H01121"\w* \w of Jehoram|strong="H03088"\w* \w became king|strong="H04427"\w* \w . . .|strong="H04428"\w* \w of Judah|strong="H03063"\w*. \v 26 \w Ahaziah|strong="H00274"\w* \w [was] twenty-two|strong="H06242"\w* \w . . .|strong="H08147"\w* \w years old|strong="H01121"\w* \w . . .|strong="H08141"\w* \w when he became king|strong="H04427"\w*, \w and he reigned|strong="H04427"\w* \w in Jerusalem|strong="H03389"\w* \w one|strong="H00259"\w* \w year|strong="H08141"\w*. \w His mother’s|strong="H00517"\w* \w name|strong="H08034"\w* \w was Athaliah|strong="H06271"\w*, \w the granddaughter|strong="H01323"\w* \w of Omri|strong="H06018"\w* \w king|strong="H04428"\w* \w of Israel|strong="H03478"\w*.
\p \v 27 \w And [Ahaziah] walked|strong="H01980"\w* \w in the ways|strong="H01870"\w* \w of the house|strong="H01004"\w* \w of Ahab|strong="H00256"\w* \w and did|strong="H06213"\w* \w evil|strong="H07451"\w* \w in the sight|strong="H05869"\w* \w of the LORD|strong="H03068"\w* \w like the house|strong="H01004"\w* \w of Ahab|strong="H00256"\w*, \w for|strong="H03588"\w* \w he|strong="H01931"\w* \w was a son-in-law|strong="H02860"\w* \w of the house|strong="H01004"\w* \w of Ahab|strong="H00256"\w*.
