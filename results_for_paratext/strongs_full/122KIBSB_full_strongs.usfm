\p \v 21 \w Now all|strong="H03605"\w* \w the Moabites|strong="H04124"\w* \w had heard|strong="H08085"\w* \w that|strong="H03588"\w* \w the kings|strong="H04428"\w* \w had come up|strong="H05927"\w* \w to fight|strong="H03898"\w* against them. \w So all|strong="H03605"\w* \w who could bear arms|strong="H02296"\w* \w . . .|strong="H02290"\w*, \w [young] and old|strong="H04605"\w*, \w were summoned|strong="H06817"\w* \w and stationed|strong="H05975"\w* \w at|strong="H05921"\w* \w the border|strong="H01366"\w*. \v 22 \w When they got up early|strong="H07925"\w* \w in the morning|strong="H01242"\w*, \w the sun|strong="H08121"\w* \w was shining|strong="H02224"\w* \w on|strong="H05921"\w* \w the water|strong="H04325"\w*, \w and [it]|strong="H04325"\w* \w looked|strong="H07200"\w* \w [as] red|strong="H00122"\w* \w as blood|strong="H01818"\w* \w to the Moabites|strong="H04124"\w* \w across the way|strong="H05048"\w* \w -|strong="H00853"\w*.
\p \v 23 “\w This|strong="H02088"\w* \w . . .|strong="H02717"\w* \w is blood|strong="H01818"\w*!” \w they exclaimed|strong="H00559"\w*. “\w The kings|strong="H04428"\w* \w have clashed swords|strong="H02717"\w* \w and slaughtered|strong="H05221"\w* \w one|strong="H00376"\w* \w -|strong="H00853"\w* \w another|strong="H07453"\w*. \w Now|strong="H06258"\w* \w to the plunder|strong="H07998"\w*, \w Moab|strong="H04124"\w*!”
\p \v 24 \w But when the Moabites came|strong="H00935"\w* \w to|strong="H00413"\w* \w the camp|strong="H04264"\w* \w of Israel|strong="H03478"\w*, \w the Israelites|strong="H03478"\w* \w rose up|strong="H06965"\w* \w and attacked|strong="H05221"\w* \w -|strong="H00853"\w* \w them|strong="H04124"\w*, \w and they fled|strong="H05127"\w* \w before them|strong="H06440"\w*. \w So [the Israelites] invaded [their land]|strong="H00935"\w* \w and struck down|strong="H05221"\w* \w -|strong="H00853"\w* \w the Moabites|strong="H04124"\w*. \v 25 \w They destroyed|strong="H02040"\w* \w the cities|strong="H05892"\w*, \w and each man|strong="H00376"\w* \w threw|strong="H07993"\w* \w stones|strong="H00068"\w* \w on every|strong="H03605"\w* \w good|strong="H02896"\w* \w field|strong="H02513"\w* \w until it was covered|strong="H04390"\w*. \w They stopped up|strong="H05640"\w* \w every|strong="H03605"\w* \w spring|strong="H04599"\w* \w . . .|strong="H04325"\w* \w and cut down|strong="H05307"\w* \w every|strong="H03605"\w* \w good|strong="H02896"\w* \w tree|strong="H06086"\w*. \w Only|strong="H05704"\w* \w vvv|strong="H07025"\w* \w Kir-haraseth|strong="H07025"\w* \w was left|strong="H07604"\w* \w with stones in place|strong="H00068"\w*, \w but men with slings|strong="H07051"\w* \w surrounded it|strong="H05437"\w* \w and attacked it [as well]|strong="H05221"\w*.
\p \v 26 \w When the king|strong="H04428"\w* \w of Moab|strong="H04124"\w* \w saw|strong="H07200"\w* \w that|strong="H03588"\w* \w the battle|strong="H04421"\w* \w was too fierce|strong="H02388"\w* \w for him|strong="H04480"\w*, \w he took|strong="H03947"\w* \w with him|strong="H00854"\w* \w seven|strong="H07651"\w* \w hundred|strong="H03967"\w* \w swordsmen|strong="H00376"\w* \w . . .|strong="H08025"\w* \w . . .|strong="H02719"\w* \w to break through|strong="H01234"\w* \w to|strong="H00413"\w* \w the king|strong="H04428"\w* \w of Edom|strong="H00123"\w*, \w but they could not prevail|strong="H03201"\w* \w . . .|strong="H03808"\w*. \v 27 \w So he took|strong="H03947"\w* \w -|strong="H00853"\w* \w his firstborn|strong="H01060"\w* \w son|strong="H01121"\w*, \w who|strong="H00834"\w* \w was to succeed him|strong="H04427"\w* \w . . .|strong="H08478"\w*, \w and offered him|strong="H05927"\w* \w as a burnt offering|strong="H05930"\w* \w on|strong="H05921"\w* \w the city wall|strong="H02346"\w*.
\p \w And there was|strong="H01961"\w* \w great|strong="H01419"\w* \w fury|strong="H07110"\w* \w against|strong="H05921"\w* \w the Israelites|strong="H03478"\w*,\f + \fr 3:27 \ft Or \fqa And Israel’s fury was great\f* \w so they withdrew|strong="H05265"\w* \w . . .|strong="H05921"\w* \w and returned|strong="H07725"\w* \w to [their own] land|strong="H00776"\w*.
\c 4
\s1 The Widow’s Oil
\p \v 1 \w Now the wife|strong="H00802"\w* \w . . .|strong="H00802"\w* \w of one|strong="H00259"\w* \w of the sons|strong="H01121"\w* \w of the prophets|strong="H05030"\w* \w cried out|strong="H06817"\w* \w to|strong="H00413"\w* \w Elisha|strong="H00477"\w* \w . . .|strong="H00559"\w*, “\w Your servant|strong="H05650"\w*, \w my husband|strong="H00376"\w*, \w is dead|strong="H04191"\w*, \w and you|strong="H00859"\w* \w know|strong="H03045"\w* \w that|strong="H03588"\w* \w your servant|strong="H05650"\w*\w . . .|strong="H01961"\w* \w feared|strong="H03373"\w* \w -|strong="H00853"\w* \w the LORD|strong="H03068"\w*. \w And now his creditor|strong="H05383"\w* \w is coming|strong="H00935"\w* \w to take|strong="H03947"\w* \w -|strong="H00853"\w* \w my two|strong="H08147"\w* \w children|strong="H03206"\w* as his \w slaves|strong="H05650"\w*!”
\p \v 2 “\w How|strong="H04100"\w* \w can I|strong="H06213"\w* help you?” \w asked|strong="H00559"\w* \w Elisha|strong="H00477"\w* \w . . .|strong="H00413"\w*. “\w Tell|strong="H05046"\w* me, \w what|strong="H04100"\w* \w do you have|strong="H03426"\w* . . . \w in the house|strong="H01004"\w*?”
\p \w She answered|strong="H00559"\w*, “\w Your servant|strong="H08198"\w* \w has nothing|strong="H00369"\w* \w . . .|strong="H03605"\w* \w in the house|strong="H01004"\w* \w vvv|strong="H03588"\w* \w but|strong="H00518"\w* \w a jar|strong="H00610"\w* \w of oil|strong="H08081"\w*.”
\p \v 3 “\w Go|strong="H01980"\w*,” \w said [Elisha]|strong="H00559"\w*, “\w borrow|strong="H07592"\w* - \w -|strong="H03627"\w* \w empty|strong="H07386"\w* \w jars|strong="H03627"\w* \w from|strong="H04480"\w* \w vvv|strong="H02351"\w* \w vvv|strong="H00854"\w* \w all|strong="H03605"\w* \w your neighbors|strong="H07934"\w*. \w Do not|strong="H00408"\w* \w gather just a few|strong="H04591"\w*. \v 4 \w Then go inside|strong="H00935"\w*, \w shut|strong="H05462"\w* \w the door|strong="H01817"\w* \w behind you|strong="H01157"\w* \w and|strong="H01157"\w* \w your sons|strong="H01121"\w*, \w and pour|strong="H03332"\w* \w oil into|strong="H05921"\w* \w all|strong="H03605"\w* \w these|strong="H00428"\w* \w jars|strong="H03627"\w*, \w setting the full ones|strong="H04392"\w* \w aside|strong="H05265"\w*.”
\p \v 5 \w So she left|strong="H01980"\w* \w him|strong="H00854"\w*, \w and after she had shut|strong="H05462"\w* \w the door|strong="H01817"\w* \w behind her|strong="H01157"\w* \w and|strong="H01157"\w* \w her sons|strong="H01121"\w*, \w they|strong="H01992"\w* \w kept bringing [jars]|strong="H05066"\w* \w to her|strong="H00413"\w*, \w and she|strong="H01931"\w* \w kept pouring|strong="H03332"\w*. \v 6 \w When|strong="H01961"\w* \w all the jars|strong="H03627"\w* \w were full|strong="H04390"\w*, \w she said|strong="H00559"\w* \w to|strong="H00413"\w* \w her son|strong="H01121"\w*, “\w Bring me|strong="H05066"\w* \w . . .|strong="H00413"\w* \w another|strong="H05750"\w* \w . . .|strong="H03627"\w*.”
\p \w But he replied|strong="H00559"\w*, \w . . .|strong="H00413"\w* “\w There are no|strong="H00369"\w* \w more|strong="H05750"\w* \w jars|strong="H03627"\w*.” \w Then the oil|strong="H08081"\w* \w stopped flowing|strong="H05975"\w*.
\p \v 7 \w She went|strong="H00935"\w* \w and told|strong="H05046"\w* \w the man|strong="H00376"\w* \w of God|strong="H00430"\w*, \w and he said|strong="H00559"\w*, “\w Go|strong="H01980"\w*, \w sell|strong="H04376"\w* \w -|strong="H00853"\w* \w the oil|strong="H08081"\w*, \w and pay|strong="H07999"\w* \w -|strong="H00853"\w* \w your debt|strong="H05386"\w*. \w Then you|strong="H00859"\w* \w and your sons|strong="H01121"\w* \w can live|strong="H02421"\w* \w on the remainder|strong="H03498"\w*.”
\s1 The Shunammite Woman
\p \v 8 \w -|strong="H01961"\w* \w One day|strong="H03117"\w* \w Elisha|strong="H00477"\w* \w went|strong="H05674"\w* \w to|strong="H00413"\w* \w Shunem|strong="H07766"\w*, \w and a prominent|strong="H01419"\w* \w woman|strong="H00802"\w* \w who lived there|strong="H08033"\w* \w persuaded|strong="H02388"\w* him \w to have a meal|strong="H00398"\w* \w . . .|strong="H03899"\w*. \w So whenever|strong="H01961"\w* \w . . .|strong="H01767"\w* \w he would pass by|strong="H05674"\w*, \w he would stop|strong="H05493"\w* \w there|strong="H08033"\w* \w to eat|strong="H00398"\w* \w . . .|strong="H03899"\w*.
\p \v 9 \w Then [the woman] said|strong="H00559"\w* \w to|strong="H00413"\w* \w her husband|strong="H00376"\w*, “\w Behold|strong="H02009"\w*, \w now|strong="H04994"\w* \w I know|strong="H03045"\w* \w that|strong="H03588"\w* \w the one|strong="H01931"\w* \w who often|strong="H08548"\w* \w comes our way|strong="H05674"\w* \w . . .|strong="H05921"\w* \w is a holy|strong="H06918"\w* \w man|strong="H00376"\w* \w of God|strong="H00430"\w*. \v 10 \w Please|strong="H04994"\w* \w let us make|strong="H06213"\w* \w a small|strong="H06996"\w* \w room upstairs|strong="H05944"\w* \w . . .|strong="H07023"\w* \w and put|strong="H07760"\w* \w in it|strong="H08033"\w* \w a bed|strong="H04296"\w*, \w a table|strong="H07979"\w*, \w a chair|strong="H03678"\w*, \w and a lamp|strong="H04501"\w* for him. \w Then when|strong="H01961"\w* \w he comes|strong="H00935"\w* \w to us|strong="H00413"\w*, \w he can stay|strong="H05493"\w* \w there|strong="H08033"\w*.”
\p \v 11 \w -|strong="H01961"\w* \w One day|strong="H03117"\w* \w [Elisha] came to visit|strong="H00935"\w* \w . . .|strong="H08033"\w* \w and went|strong="H05493"\w* \w to|strong="H00413"\w* \w his upper room|strong="H05944"\w* \w to lie down|strong="H07901"\w* \w . . .|strong="H08033"\w*. \v 12 \w And he said|strong="H00559"\w* \w to|strong="H00413"\w* \w Gehazi|strong="H01522"\w* \w his servant|strong="H05288"\w*, “\w Call|strong="H07121"\w* \w the|strong="H02063"\w* \w Shunammite woman|strong="H07767"\w*.”
\p \w And when he had called|strong="H07121"\w* her, \w she stood|strong="H05975"\w* \w before him|strong="H06440"\w*, \v 13 \w and [Elisha] said|strong="H00559"\w* to Gehazi, “\w Now|strong="H04994"\w* \w tell|strong="H00559"\w* \w her|strong="H00413"\w*, ‘\w Look|strong="H02009"\w*, \w you have gone to all|strong="H03605"\w* \w this|strong="H02063"\w* \w trouble|strong="H02729"\w* \w . . .|strong="H02731"\w* \w for us|strong="H00413"\w*. \w -|strong="H00853"\w* \w What|strong="H04100"\w* \w can we do|strong="H06213"\w* for you? \w . . .|strong="H03426"\w* \w Can we speak|strong="H01696"\w* \w on your behalf to|strong="H00413"\w* \w the king|strong="H04428"\w* \w or|strong="H00176"\w* \w -|strong="H00413"\w* \w the commander|strong="H08269"\w* \w of the army|strong="H06635"\w*?’”
\p “\w I|strong="H00595"\w* \w have a home|strong="H03427"\w* \w among|strong="H08432"\w* \w my own people|strong="H05971"\w*,” \w she replied|strong="H00559"\w*.
\p \v 14 \w So he asked|strong="H00559"\w*, “\w Then what|strong="H04100"\w* \w should be done|strong="H06213"\w* for her?”
\p “\w Well|strong="H00061"\w*, she has \w no|strong="H00369"\w* \w son|strong="H01121"\w*,” \w Gehazi|strong="H01522"\w* \w replied|strong="H00559"\w*, “\w and her husband|strong="H00376"\w* \w is old|strong="H02204"\w*.”
\p \v 15 “\w Call|strong="H07121"\w* her,” \w said Elisha|strong="H00559"\w*.
\p \w So Gehazi called|strong="H07121"\w* her, \w and she stood|strong="H05975"\w* \w in the doorway|strong="H06607"\w*. \v 16 \w And Elisha declared|strong="H00559"\w*, “\w At this|strong="H02088"\w* \w time|strong="H04150"\w* \w next year|strong="H06256"\w*, \w . . .|strong="H02416"\w* \w you|strong="H00859"\w* \w will hold|strong="H02263"\w* \w a son {in your arms}|strong="H01121"\w*.”
\p “\w No|strong="H00408"\w*, \w my lord|strong="H00113"\w*,” \w she said|strong="H00559"\w*. “\w Do not|strong="H00408"\w* \w lie|strong="H03576"\w* \w to your maidservant|strong="H08198"\w*, \w O man|strong="H00376"\w* \w of God|strong="H00430"\w*.”
\p \v 17 \w But the woman|strong="H00802"\w* \w did conceive|strong="H02029"\w*, \w and at that|strong="H02088"\w* \w time|strong="H04150"\w* \w the next year|strong="H06256"\w* \w . . .|strong="H02416"\w* \w she gave birth to|strong="H03205"\w* \w a son|strong="H01121"\w*, \w just as|strong="H00834"\w* \w Elisha|strong="H00477"\w* \w had told|strong="H01696"\w* \w her|strong="H00413"\w*.
\s1 Elisha Raises the Shunammite’s Son
\p \v 18 \w And|strong="H01961"\w* \w the child|strong="H03206"\w* \w grew|strong="H01431"\w*, \w and one day|strong="H03117"\w* \w he went out|strong="H03318"\w* \w to|strong="H00413"\w* \w his father|strong="H00001"\w*, \w who was with|strong="H00413"\w* \w the harvesters|strong="H07114"\w*.
\p \v 19 “\w My head|strong="H07218"\w*! \w My head|strong="H07218"\w*!” \w he complained|strong="H00559"\w* \w to|strong="H00413"\w* \w his father|strong="H00001"\w*.
\p \w So his father told|strong="H00559"\w* \w a servant|strong="H05288"\w*, “\w Carry him|strong="H05375"\w* \w . . .|strong="H00413"\w* \w to|strong="H00413"\w* \w his mother|strong="H00517"\w*.”
\p \v 20 \w After [the servant] had picked him up|strong="H05375"\w* \w and carried him|strong="H00935"\w* \w to|strong="H00413"\w* \w his mother|strong="H00517"\w*, \w [the boy] sat|strong="H03427"\w* \w on|strong="H05921"\w* \w her lap|strong="H01290"\w* \w until|strong="H05704"\w* \w noon|strong="H06672"\w*, \w and then he died|strong="H04191"\w*. \v 21 \w And she went up|strong="H05927"\w* \w and laid him|strong="H07901"\w* \w on|strong="H05921"\w* \w the bed|strong="H04296"\w* \w of the man|strong="H00376"\w* \w of God|strong="H00430"\w*. \w Then she shut [the door]|strong="H05462"\w* \w . . .|strong="H01157"\w* \w and went out|strong="H03318"\w*.
\p \v 22 \w And the woman called|strong="H07121"\w* \w . . .|strong="H00413"\w* \w her husband|strong="H00376"\w* \w and said|strong="H00559"\w*, “\w Please|strong="H04994"\w* \w send|strong="H07971"\w* me \w one|strong="H00259"\w* \w of|strong="H04480"\w* \w the servants|strong="H05288"\w* \w and one|strong="H00259"\w* \w of the donkeys|strong="H00860"\w*, \w that I may go quickly|strong="H07323"\w* \w to|strong="H05704"\w* \w the man|strong="H00376"\w* \w of God|strong="H00430"\w* \w and return|strong="H07725"\w*.”
\p \v 23 “\w Why|strong="H04069"\w* \w would you|strong="H00859"\w* \w go|strong="H01980"\w* \w to him|strong="H00413"\w* \w today|strong="H03117"\w*?” \w he replied|strong="H00559"\w*. “\w It is not|strong="H03808"\w* \w a New Moon|strong="H02320"\w* \w [or]|strong="H03808"\w* \w a Sabbath|strong="H07676"\w*.”
\p “\w Everything is all right|strong="H07965"\w*,” \w she said|strong="H00559"\w*.
\p \v 24 \w Then she saddled|strong="H02280"\w* \w the donkey|strong="H00860"\w* \w and told|strong="H00559"\w* \w . . .|strong="H00413"\w* \w her servant|strong="H05288"\w*, “\w Drive|strong="H05090"\w* \w onward|strong="H01980"\w*; \w do not|strong="H00408"\w* \w slow|strong="H06113"\w* \w the pace|strong="H07392"\w* for me \w -|strong="H03588"\w* \w unless|strong="H00518"\w* \w I tell|strong="H00559"\w* you.” \v 25 \w So she set out|strong="H01980"\w* \w and went|strong="H00935"\w* \w to|strong="H00413"\w* \w the man|strong="H00376"\w* \w of God|strong="H00430"\w* \w at|strong="H00413"\w* \w Mount|strong="H02022"\w* \w Carmel|strong="H03760"\w*. \w . . .|strong="H01961"\w*
\p \w When the man|strong="H00376"\w* \w of God|strong="H00430"\w* \w saw|strong="H07200"\w* \w her|strong="H00853"\w* \w at a distance|strong="H05048"\w*, \w he said|strong="H00559"\w* \w to|strong="H00413"\w* \w his servant|strong="H05288"\w* \w Gehazi|strong="H01522"\w*, “\w Look|strong="H02009"\w*, \w there is|strong="H01975"\w* \w the Shunammite woman|strong="H07767"\w*. \v 26 \w Please|strong="H04994"\w* \w run out|strong="H07323"\w* \w now|strong="H06258"\w* \w to meet her|strong="H07122"\w* \w and ask|strong="H00559"\w*, ‘\w Are you all right|strong="H07965"\w* . . .? \w Is your husband|strong="H00376"\w* \w all right|strong="H07965"\w*? \w Is your child|strong="H03206"\w* \w all right|strong="H07965"\w*?’”
\p \w And she answered|strong="H00559"\w*, “\w Everything is all right|strong="H07965"\w*.”
