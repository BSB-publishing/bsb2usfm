\c 10
\s1 Ahab’s Seventy Sons Killed
\p \v 1 \w Now Ahab|strong="H00256"\w* \w had seventy|strong="H07657"\w* \w sons|strong="H01121"\w* \w in Samaria|strong="H08111"\w*. \w So Jehu|strong="H03058"\w* \w wrote|strong="H03789"\w* \w letters|strong="H05612"\w* \w and sent them|strong="H07971"\w* \w to Samaria|strong="H08111"\w* \w to|strong="H00413"\w* \w the officials|strong="H08269"\w* \w of Jezreel|strong="H03157"\w*,\f + \fr 10:1 \ft Hebrew; LXX and Vulgate \fqa officials of the city \f* \w to the elders|strong="H02205"\w*, \w and to|strong="H00413"\w* \w the guardians [of the sons]|strong="H00539"\w*\f + \fr 10:1 \ft Hebrew does not include \fqa of the sons\ft .\f* \w of Ahab|strong="H00256"\w*, \w saying|strong="H00559"\w*: \v 2 “\w When this|strong="H02088"\w* \w . . .|strong="H00413"\w* \w letter|strong="H05612"\w* \w arrives|strong="H00935"\w*, \w since|strong="H06258"\w* \w your master’s|strong="H00113"\w* \w sons|strong="H01121"\w* \w are with you|strong="H00854"\w* \w and you have|strong="H00854"\w* \w chariots|strong="H07393"\w* \w and horses|strong="H05483"\w*, \w a fortified|strong="H04013"\w* \w city|strong="H05892"\w* \w and weaponry|strong="H05402"\w*, \v 3 \w select|strong="H07200"\w* \w the best|strong="H02896"\w* \w and most worthy|strong="H03477"\w* \w son|strong="H01121"\w* \w of your master|strong="H00113"\w*, \w set him|strong="H07760"\w* \w on|strong="H05921"\w* \w his father’s|strong="H00001"\w* \w throne|strong="H03678"\w*, \w and fight|strong="H03898"\w* \w for|strong="H05921"\w* \w your master’s|strong="H00113"\w* \w house|strong="H01004"\w*.”
