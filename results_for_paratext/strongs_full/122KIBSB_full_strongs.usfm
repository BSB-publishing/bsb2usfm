\p \v 5 \w Hezekiah trusted|strong="H00982"\w* \w in the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*. \w No|strong="H03808"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w -|strong="H00834"\w* \w -|strong="H01961"\w* \w was|strong="H01961"\w* \w like him|strong="H03644"\w*, \w . . .|strong="H03605"\w* \w either before him|strong="H06440"\w* \w or after him|strong="H00310"\w*. \v 6 \w He remained faithful|strong="H01692"\w* \w to the LORD|strong="H03068"\w* \w and did not|strong="H03808"\w* \w turn|strong="H05493"\w* \w from following Him|strong="H00310"\w*; \w he kept|strong="H08104"\w* \w the commandments|strong="H04687"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w had given|strong="H06680"\w* \w Moses|strong="H04872"\w*.
