\c 23
\s1 Josiah Renews the Covenant
\p \v 1 \w Then the king|strong="H04428"\w* \w summoned|strong="H07971"\w* \w . . .|strong="H00622"\w* \w . . .|strong="H00413"\w* \w all|strong="H03605"\w* \w the elders|strong="H02205"\w* \w of Judah|strong="H03063"\w* \w and Jerusalem|strong="H03389"\w*. \v 2 \w And [he]|strong="H04428"\w* \w went up|strong="H05927"\w* \w to the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w* \w with all|strong="H03605"\w* \w the people|strong="H03427"\w* \w -|strong="H00376"\w* \w of Judah|strong="H03063"\w* \w [and]|strong="H03605"\w* \w Jerusalem|strong="H03389"\w*, \w as well as|strong="H00854"\w* \w the priests|strong="H03548"\w* \w and the prophets|strong="H05030"\w*— \w all|strong="H03605"\w* \w the people|strong="H05971"\w* \w small|strong="H06996"\w* \w and|strong="H05704"\w* \w great|strong="H01419"\w*— \w and in their hearing|strong="H00241"\w* \w -|strong="H00853"\w* \w he read|strong="H07121"\w* \w all|strong="H03605"\w* \w the words|strong="H01697"\w* \w of the Book|strong="H05612"\w* \w of the Covenant|strong="H01285"\w* \w that had been found|strong="H04672"\w* \w in the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*.
\p \v 3 \w So the king|strong="H04428"\w* \w stood|strong="H05975"\w* \w by|strong="H05921"\w* \w the pillar|strong="H05982"\w* \w and made|strong="H03772"\w* \w -|strong="H00853"\w* \w a covenant|strong="H01285"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w to follow|strong="H01980"\w* \w . . .|strong="H00310"\w* \w the LORD|strong="H03068"\w* \w and to keep|strong="H08104"\w* \w His commandments|strong="H04687"\w*, \w -|strong="H00853"\w* \w decrees|strong="H05715"\w*, \w -|strong="H00853"\w* \w and statutes|strong="H02708"\w* \w with all|strong="H03605"\w* \w [his] heart|strong="H03820"\w* \w and all|strong="H03605"\w* \w [his] soul|strong="H05315"\w*, \w and to carry out|strong="H06965"\w* \w -|strong="H00853"\w* \w the words|strong="H01697"\w* \w of the|strong="H02063"\w* \w covenant|strong="H01285"\w* \w that were written|strong="H03789"\w* \w in|strong="H05921"\w* \w this|strong="H02088"\w* \w book|strong="H05612"\w*. \w And all|strong="H03605"\w* \w the people|strong="H05971"\w* \w entered|strong="H05975"\w* \w into the covenant|strong="H01285"\w*.
\s1 Josiah Destroys Idolatry
\p \v 4 \w Then the king|strong="H04428"\w* \w -|strong="H00853"\w* \w commanded|strong="H06680"\w* \w Hilkiah|strong="H02518"\w* \w the high|strong="H01419"\w* \w -|strong="H00853"\w* \w priest|strong="H03548"\w*, \w the priests|strong="H03548"\w* \w second in rank|strong="H04932"\w*, \w -|strong="H00853"\w* \w and the doorkeepers|strong="H08104"\w* \w . . .|strong="H05592"\w* \w to remove|strong="H03318"\w* \w from the temple|strong="H01964"\w* \w of the LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the articles|strong="H03627"\w* \w made|strong="H06213"\w* \w for Baal|strong="H01168"\w*, \w Asherah|strong="H00842"\w*, \w and all|strong="H03605"\w* \w the host|strong="H06635"\w* \w of heaven|strong="H08064"\w*. \w And he burned them|strong="H08313"\w* \w outside|strong="H02351"\w* \w Jerusalem|strong="H03389"\w* \w in the fields|strong="H07709"\w* \w of Kidron|strong="H06939"\w* \w and carried|strong="H05375"\w* \w -|strong="H00853"\w* \w their ashes|strong="H06083"\w* \w vvv|strong="H01008"\w* \w to Bethel|strong="H01008"\w*.
\p \v 5 \w [Josiah] also did away with|strong="H07673"\w* \w -|strong="H00853"\w* \w the idolatrous priests|strong="H03649"\w* \w -|strong="H00834"\w* \w ordained|strong="H05414"\w* \w by the kings|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w to burn incense|strong="H06999"\w* \w on the high places|strong="H01116"\w* \w of the cities|strong="H05892"\w* \w of Judah|strong="H03063"\w* \w and in the places all around|strong="H04524"\w* \w Jerusalem|strong="H03389"\w* — \w -|strong="H00853"\w* \w those who had burned incense|strong="H06999"\w* \w to Baal|strong="H01168"\w*, \w to the sun|strong="H08121"\w* \w and moon|strong="H03394"\w*, \w to the constellations|strong="H04208"\w*, \w and to all|strong="H03605"\w* \w the host|strong="H06635"\w* \w of heaven|strong="H08064"\w*.
\p \v 6 \w He brought|strong="H03318"\w* \w -|strong="H00853"\w* \w the Asherah pole|strong="H00842"\w* \w from the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w* \w to|strong="H00413"\w* \w the Kidron|strong="H06939"\w* \w Valley|strong="H05158"\w* \w outside|strong="H02351"\w* \w Jerusalem|strong="H03389"\w*, \w and [there]|strong="H06939"\w* \w . . .|strong="H05158"\w* \w he burned|strong="H08313"\w* \w it|strong="H00853"\w*, \w ground|strong="H01854"\w* \w [it] to powder|strong="H06083"\w*, \w and threw|strong="H07993"\w* \w -|strong="H00853"\w* \w its dust|strong="H06083"\w* \w on|strong="H05921"\w* \w the graves|strong="H06913"\w* \w of the common|strong="H01121"\w* \w people|strong="H05971"\w*. \v 7 \w He also tore down|strong="H05422"\w* \w -|strong="H00853"\w* \w the quarters|strong="H01004"\w* \w of the male shrine prostitutes|strong="H06945"\w* \w that [were]|strong="H00834"\w* \w in the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*, \w where|strong="H00834"\w* \w the women|strong="H00802"\w* \w had woven|strong="H00707"\w* \w . . .|strong="H08033"\w* \w tapestries|strong="H01004"\w* \w for Asherah|strong="H00842"\w*.
\p \v 8 \w Then Josiah brought|strong="H00935"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the priests|strong="H03548"\w* \w from the cities|strong="H05892"\w* \w of Judah|strong="H03063"\w* \w and desecrated|strong="H02930"\w* \w -|strong="H00853"\w* \w the high places|strong="H01116"\w*, \w from|strong="H00834"\w* \w Geba|strong="H01387"\w* \w to|strong="H05704"\w* \w vvv|strong="H00884"\w* \w Beersheba|strong="H00884"\w*, \w where|strong="H08033"\w* \w the priests|strong="H03548"\w* \w had burned incense|strong="H06999"\w*. \w He tore down|strong="H05422"\w* \w -|strong="H00853"\w* \w the high places|strong="H01116"\w* \w of the gates|strong="H08179"\w* \w -|strong="H00834"\w* \w at the entrance|strong="H06607"\w* \w of the gate|strong="H08179"\w* \w of Joshua|strong="H03091"\w* \w the governor|strong="H08269"\w* \w of the city|strong="H05892"\w*, \w which was|strong="H00834"\w* \w to|strong="H05921"\w* \w the left|strong="H08040"\w* \w . . .|strong="H00376"\w* \w of the city|strong="H05892"\w* \w gate|strong="H08179"\w*. \v 9 \w Although|strong="H00389"\w* \w the priests|strong="H03548"\w* \w of the high places|strong="H01116"\w* \w did not|strong="H03808"\w* \w come up|strong="H05927"\w* \w to|strong="H00413"\w* \w the altar|strong="H04196"\w* \w of the LORD|strong="H03068"\w* \w in Jerusalem|strong="H03389"\w*, \w -|strong="H03588"\w* \w -|strong="H00518"\w* \w they ate|strong="H00398"\w* \w unleavened bread|strong="H04682"\w* \w with|strong="H08432"\w* \w their fellow priests|strong="H00251"\w*.
\p \v 10 \w He also desecrated|strong="H02930"\w* \w -|strong="H00853"\w* \w Topheth|strong="H08612"\w* \w -|strong="H00834"\w* \w in the Valley|strong="H01516"\w* \w vvv|strong="H01121"\w* \w of Ben-hinnom|strong="H02011"\w*\f + \fr 23:10 \ft Or \fqa the Valley of the Son of Hinnom\f* \w so that no|strong="H01115"\w* \w one|strong="H00376"\w* \w -|strong="H00853"\w* \w could sacrifice|strong="H05674"\w* \w his son|strong="H01121"\w* \w -|strong="H00853"\w* \w or daughter|strong="H01323"\w* \w in the fire|strong="H00784"\w*\f + \fr 23:10 \ft Literally \fqa could pass his son or daughter through the fire\f* \w to Molech|strong="H04432"\w*. \v 11 \w And he removed|strong="H07673"\w* \w -|strong="H00853"\w* \w from the entrance|strong="H00935"\w* \w to the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w* \w the horses|strong="H05483"\w* \w that|strong="H00834"\w* \w the kings|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w had dedicated|strong="H05414"\w* \w to the sun|strong="H08121"\w*. \w They were|strong="H00834"\w* \w in the court|strong="H06503"\w*\f + \fr 23:11 \ft Hebrew \fqa parbarim\f* \w near|strong="H00413"\w* \w the chamber|strong="H03957"\w* \w of an official|strong="H05631"\w* \w vvv|strong="H05419"\w* \w named Nathan-melech|strong="H05419"\w*. \w And|strong="H00853"\w* \w [Josiah] burned up|strong="H08313"\w* \w . . .|strong="H00784"\w* \w the chariots|strong="H04818"\w* \w of the sun|strong="H08121"\w*.
\p \v 12 \w He pulled down|strong="H05422"\w* \w -|strong="H00853"\w* \w the altars|strong="H04196"\w* \w -|strong="H00834"\w* \w that|strong="H00834"\w* \w the kings|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w -|strong="H00853"\w* \w had set up|strong="H06213"\w* \w on|strong="H05921"\w* \w the roof|strong="H01406"\w* \w near the upper chamber|strong="H05944"\w* \w of Ahaz|strong="H00271"\w*, \w and the altars|strong="H04196"\w* \w that|strong="H00834"\w* \w Manasseh|strong="H04519"\w* \w had set up|strong="H06213"\w* \w in the two|strong="H08147"\w* \w courtyards|strong="H02691"\w* \w of the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*. \w The king|strong="H04428"\w* \w pulverized them|strong="H07323"\w* \w there|strong="H08033"\w*\f + \fr 23:12 \ft Or \fqa quickly removed them from there\f* \w and threw|strong="H07993"\w* \w -|strong="H00853"\w* \w their dust|strong="H06083"\w* \w into|strong="H00413"\w* \w the Kidron|strong="H06939"\w* \w Valley|strong="H05158"\w*.
\p \v 13 \w -|strong="H00853"\w* \w The king|strong="H04428"\w* \w also desecrated|strong="H02930"\w* \w the high places|strong="H01116"\w* \w -|strong="H00834"\w* \w east|strong="H05921"\w* \w of|strong="H06440"\w* \w Jerusalem|strong="H03389"\w*,\w . . .|strong="H00834"\w* \w to the south|strong="H03225"\w* \w of the Mount|strong="H02022"\w* \w of Corruption|strong="H04889"\w*, \w which|strong="H00834"\w* \w King|strong="H04428"\w* \w Solomon|strong="H08010"\w* \w of Israel|strong="H03478"\w* \w had built|strong="H01129"\w* \w for Ashtoreth|strong="H06253"\w* \w the abomination|strong="H08251"\w* \w of the Sidonians|strong="H06722"\w*, \w for Chemosh|strong="H03645"\w* \w the abomination|strong="H08251"\w* \w of the Moabites|strong="H04124"\w*, \w and for Milcom|strong="H04445"\w*\f + \fr 23:13 \fqa Milcom \ft is a variant of \fqa Molech\ft ; see Leviticus 18:21 and 1 Kings 11:7.\f* \w the abomination|strong="H08441"\w* \w of the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w*. \v 14 \w He smashed the sacred pillars|strong="H04676"\w* \w to pieces|strong="H07665"\w*, \w -|strong="H00853"\w* \w cut down|strong="H03772"\w* \w -|strong="H00853"\w* \w the Asherah poles|strong="H00842"\w*, \w and covered|strong="H04390"\w* \w -|strong="H00853"\w* \w the sites|strong="H04725"\w* \w with human|strong="H00120"\w* \w bones|strong="H06106"\w*.
\p \v 15 \w He even|strong="H01571"\w* \w -|strong="H00853"\w* \w pulled down|strong="H05422"\w* \w the altar|strong="H04196"\w* \w at Bethel|strong="H01008"\w*, \w the high place|strong="H01116"\w* \w -|strong="H00834"\w*\w . . .|strong="H00834"\w* \w set up|strong="H06213"\w*\w . . .|strong="H01008"\w* \w by Jeroboam|strong="H03379"\w* \w son|strong="H01121"\w* \w of Nebat|strong="H05028"\w*, \w who|strong="H00834"\w*\w . . .|strong="H00853"\w* \w had caused Israel|strong="H03478"\w* \w to sin|strong="H02398"\w* \w -|strong="H01571"\w* \w -|strong="H00853"\w* \w -|strong="H04196"\w* \w -|strong="H01931"\w* \w -|strong="H00853"\w*. \w Then he burned|strong="H08313"\w*\f + \fr 23:15 \ft Hebrew; LXX \fqa broke into pieces\f* \w -|strong="H00853"\w* \w the high place|strong="H01116"\w*, \w ground|strong="H01854"\w* \w [it]|strong="H01116"\w* \w to powder|strong="H06083"\w*, \w and burned|strong="H08313"\w* \w the Asherah pole|strong="H00842"\w*. \v 16 \w And as Josiah|strong="H02977"\w* \w turned|strong="H06437"\w*, \w he saw|strong="H07200"\w* \w -|strong="H00853"\w* \w the tombs|strong="H06913"\w*\w . . .|strong="H00834"\w* \w there|strong="H08033"\w* \w on the hillside|strong="H02022"\w*, \w and he sent|strong="H07971"\w* \w someone to take|strong="H03947"\w* \w -|strong="H00853"\w* \w the bones|strong="H06106"\w* \w out of|strong="H04480"\w* \w the tombs|strong="H06913"\w*, \w and he burned them|strong="H08313"\w* \w on|strong="H05921"\w* \w the altar|strong="H04196"\w* \w to defile it|strong="H02930"\w*, \w according to the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w -|strong="H00834"\w* \w proclaimed|strong="H07121"\w* \w by the man|strong="H00376"\w* \w of God|strong="H00430"\w* \w who|strong="H00834"\w* \w had foretold|strong="H07121"\w* \w -|strong="H00853"\w* \w these|strong="H00428"\w* \w things|strong="H01697"\w*.\f + \fr 23:16 \ft See 1 Kings 13:2; Hebrew; LXX includes \fqa when Jeroboam stood by the altar at the feast. And he turned and lifted his eyes to the tomb of the man of God.\f*
\p \v 17 \w Then [the king] asked|strong="H00559"\w*, “\w What|strong="H04100"\w* \w is this|strong="H01975"\w* \w monument|strong="H06725"\w*\w . . .|strong="H00834"\w* \w I|strong="H00589"\w* \w see|strong="H07200"\w*?”
\p \w And the men|strong="H00582"\w* \w of the city|strong="H05892"\w* \w replied|strong="H00559"\w* \w . . .|strong="H00413"\w*, “\w It is the tomb|strong="H06913"\w* \w of the man|strong="H00376"\w* \w of God|strong="H00430"\w* \w who|strong="H00834"\w* \w came|strong="H00935"\w* \w from Judah|strong="H03063"\w* \w and proclaimed|strong="H07121"\w* \w -|strong="H00853"\w* \w these|strong="H00428"\w* \w things|strong="H01697"\w* \w that|strong="H00834"\w* \w you have done|strong="H06213"\w* \w to|strong="H05921"\w* \w the altar|strong="H04196"\w* \w of|strong="H01008"\w* \w Bethel|strong="H01008"\w*.”
\p \v 18 “\w Let him rest|strong="H05117"\w*,” \w said [Josiah]|strong="H00559"\w*. “\w Do not|strong="H00408"\w* \w let anyone|strong="H00376"\w* \w disturb|strong="H05128"\w* \w his bones|strong="H06106"\w*.”
\p \w So they left his bones|strong="H06106"\w* \w -|strong="H00853"\w* \w undisturbed|strong="H04422"\w*, \w along with those|strong="H06106"\w* \w of the prophet|strong="H05030"\w* \w who|strong="H00834"\w* \w had come|strong="H00935"\w* \w from Samaria|strong="H08111"\w*.
\p \v 19 \w Just as Josiah|strong="H06213"\w* . . . \w . . .|strong="H03605"\w* \w . . .|strong="H04639"\w* \w -|strong="H00834"\w* \w had done|strong="H06213"\w* \w vvv|strong="H01008"\w* \w at Bethel|strong="H01008"\w*, \w so also|strong="H01571"\w* \w -|strong="H00853"\w* \w -|strong="H00834"\w* \w in the cities|strong="H05892"\w* \w of Samaria|strong="H08111"\w* \w [he]|strong="H02977"\w* \w removed|strong="H05493"\w* \w all|strong="H03605"\w* \w the shrines|strong="H01004"\w* \w of the high places|strong="H01116"\w* \w -|strong="H00834"\w* \w set up|strong="H06213"\w* \w by the kings|strong="H04428"\w* \w of Israel|strong="H03478"\w* \w who had provoked the LORD to anger|strong="H03707"\w*. \v 20 \w On|strong="H05921"\w* \w the altars|strong="H04196"\w* \w he slaughtered|strong="H02076"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the priests|strong="H03548"\w* \w of the high places|strong="H01116"\w* \w -|strong="H00834"\w* \w -|strong="H08033"\w*, \w and he burned|strong="H08313"\w* \w -|strong="H00853"\w* \w human|strong="H00120"\w* \w bones|strong="H06106"\w* \w on them|strong="H05921"\w*. \w Then he returned|strong="H07725"\w* \w to Jerusalem|strong="H03389"\w*.
\s1 Josiah Restores the Passover
\p \v 21 \w The king|strong="H04428"\w* \w -|strong="H00853"\w* \w commanded|strong="H06680"\w* \w all|strong="H03605"\w* \w the people|strong="H05971"\w*, \w . . .|strong="H00559"\w* “\w Keep|strong="H06213"\w* \w the Passover|strong="H06453"\w* \w of the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*, \w as [it is] written|strong="H03789"\w* \w in|strong="H05921"\w* \w this|strong="H02088"\w* \w Book|strong="H05612"\w* \w of the Covenant|strong="H01285"\w*.”
\p \v 22 \w -|strong="H03588"\w* \w No|strong="H03808"\w* \w such|strong="H02088"\w* \w Passover|strong="H06453"\w* \w had been observed|strong="H06213"\w* \w from the days|strong="H03117"\w* \w of the judges|strong="H08199"\w* \w who|strong="H00834"\w* \w had governed|strong="H08199"\w* \w -|strong="H00853"\w* \w Israel|strong="H03478"\w* \w through all|strong="H03605"\w* \w the days|strong="H03117"\w* \w of the kings|strong="H04428"\w* \w of Israel|strong="H03478"\w* \w . . .|strong="H04428"\w* \w and Judah|strong="H03063"\w*. \v 23 \w But|strong="H03588"\w* \w . . .|strong="H00518"\w* \w in the eighteenth|strong="H08083"\w* \w . . .|strong="H06240"\w* \w year|strong="H08141"\w* \w of Josiah’s|strong="H02977"\w* \w reign|strong="H04428"\w*, \w this|strong="H02088"\w* \w Passover|strong="H06453"\w* \w was observed|strong="H06213"\w* \w to the LORD|strong="H03068"\w* \w in Jerusalem|strong="H03389"\w*.
