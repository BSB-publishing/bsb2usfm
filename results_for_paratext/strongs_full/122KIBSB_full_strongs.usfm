\p \v 12 \w Then [Jehu] set out|strong="H06965"\w* \w . . .|strong="H00935"\w* \w . . .|strong="H01980"\w* \w toward Samaria|strong="H08111"\w*. \w . . .|strong="H01931"\w* \w vvv|strong="H01044"\w* \w At Beth-eked|strong="H01044"\w* \w of the Shepherds|strong="H07462"\w*, \w -|strong="H01870"\w* \v 13 \w Jehu|strong="H03058"\w* \w met|strong="H04672"\w* \w -|strong="H00853"\w* \w some relatives|strong="H00251"\w* \w of Ahaziah|strong="H00274"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w and asked|strong="H00559"\w*, “\w Who|strong="H04310"\w* \w are you|strong="H00859"\w*?”
