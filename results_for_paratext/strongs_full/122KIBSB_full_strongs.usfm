\p \w So Samaria|strong="H08111"\w* \w was captured|strong="H03920"\w* \w in the sixth|strong="H08337"\w* \w year|strong="H08141"\w* \w of Hezekiah|strong="H02396"\w*, \w which|strong="H01931"\w* \w was the ninth|strong="H08672"\w* \w year|strong="H08141"\w* \w of Hoshea|strong="H01954"\w* \w king|strong="H04428"\w* \w of Israel|strong="H03478"\w*. \v 11 \w The king|strong="H04428"\w* \w of Assyria|strong="H00804"\w* \w -|strong="H00853"\w* \w exiled|strong="H01540"\w* \w the Israelites|strong="H03478"\w* \w to Assyria|strong="H00804"\w* \w and settled them|strong="H05148"\w* \w in Halah|strong="H02477"\w*, \w in Gozan|strong="H01470"\w* \w by the Habor|strong="H02249"\w* \w River|strong="H05104"\w*, \w and in the cities|strong="H05892"\w* \w of the Medes|strong="H04074"\w*. \v 12 \w [This happened] because|strong="H05921"\w* \w -|strong="H00834"\w* \w they did not|strong="H03808"\w* \w listen|strong="H08085"\w* \w to the voice|strong="H06963"\w* \w of the LORD|strong="H03068"\w* \w their God|strong="H00430"\w*, \w but violated|strong="H05674"\w* \w -|strong="H00853"\w* \w His covenant|strong="H01285"\w*— \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w that|strong="H00834"\w* \w Moses|strong="H04872"\w* \w the servant|strong="H05650"\w* \w of the LORD|strong="H03068"\w* \w had commanded|strong="H06680"\w* — \w and would neither|strong="H03808"\w* \w listen|strong="H08085"\w* \w nor|strong="H03808"\w* \w obey|strong="H06213"\w*.
\s1 Sennacherib Invades Judah
\p \v 13 \w In the fourteenth|strong="H00702"\w* \w . . .|strong="H06240"\w* \w year|strong="H08141"\w* \w of Hezekiah’s|strong="H02396"\w* \w reign|strong="H04428"\w*, \w Sennacherib|strong="H05576"\w* \w king|strong="H04428"\w* \w of Assyria|strong="H00804"\w* \w attacked|strong="H05927"\w* \w . . .|strong="H05921"\w* \w and captured|strong="H08610"\w* \w all|strong="H03605"\w* \w the fortified|strong="H01219"\w* \w cities|strong="H05892"\w* \w of Judah|strong="H03063"\w*. \v 14 \w So Hezekiah|strong="H02396"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w sent|strong="H07971"\w* \w word to|strong="H00413"\w* \w the king|strong="H04428"\w* \w of Assyria|strong="H00804"\w* \w at Lachish|strong="H03923"\w*, \w saying|strong="H00559"\w*, “\w I have done wrong|strong="H02398"\w*; \w withdraw|strong="H07725"\w* \w from me|strong="H05921"\w*, \w -|strong="H00853"\w* \w and I will pay|strong="H05375"\w* \w whatever|strong="H00834"\w* \w you demand|strong="H05414"\w* \w from me|strong="H05921"\w*.”
\p \w And the king|strong="H04428"\w* \w of Assyria|strong="H00804"\w* \w exacted|strong="H07760"\w* \w from|strong="H05921"\w* \w Hezekiah|strong="H02396"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w three|strong="H07969"\w* \w hundred|strong="H03967"\w* \w talents|strong="H03603"\w* \w of silver|strong="H03701"\w*\f + \fr 18:14 \fqa 300 talents \ft is approximately 11.3 tons or 10.3 metric tons of silver.\f* \w and thirty|strong="H07970"\w* \w talents|strong="H03603"\w* \w of gold|strong="H02091"\w*.\f + \fr 18:14 \fqa 30 talents \ft is approximately 1.13 tons or 1.03 metric tons of gold.\f* \v 15 \w Hezekiah|strong="H02396"\w* \w -|strong="H00853"\w* \w gave him|strong="H05414"\w* \w all|strong="H03605"\w* \w the silver|strong="H03701"\w* \w that was found|strong="H04672"\w* \w in the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w* \w and in the treasuries|strong="H00214"\w* \w of the royal|strong="H04428"\w* \w palace|strong="H01004"\w*.
\p \v 16 \w At that|strong="H01931"\w* \w time|strong="H06256"\w* \w Hezekiah|strong="H02396"\w* \w -|strong="H00853"\w* \w stripped [the gold]|strong="H07112"\w* \w with which|strong="H02396"\w* \w he had plated|strong="H06823"\w* \w the doors|strong="H01817"\w* \w and|strong="H00853"\w* \w doorposts|strong="H00547"\w* \w -|strong="H00834"\w* \w of the temple|strong="H01964"\w* \w of the LORD|strong="H03068"\w*, \w and [he]|strong="H04428"\w* \w . . .|strong="H03063"\w* \w gave it|strong="H05414"\w* \w to the king|strong="H04428"\w* \w of Assyria|strong="H00804"\w*.
\s1 Sennacherib Threatens Jerusalem
\p \v 17 \w Nevertheless, the king|strong="H04428"\w* \w of Assyria|strong="H00804"\w* \w -|strong="H00853"\w* \w sent|strong="H07971"\w* \w the Tartan|strong="H08661"\w*,\f + \fr 18:17 \ft Hebrew \fqa Tartan \ft is the title of a field marshal, general, or commander in the Assyrian military.\f* \w -|strong="H00853"\w* \w vvv|strong="H07249"\w* \w the Rabsaris|strong="H07249"\w*,\f + \fr 18:17 \ft Hebrew \fqa Rabsaris \ft is the title of the chief eunuch in the Assyrian military.\f* \w -|strong="H00853"\w* \w vvv|strong="H07262"\w* \w and the Rabshakeh|strong="H07262"\w*,\f + \fr 18:17 \ft Hebrew \fqa Rabshakeh \ft is the title of a high-ranking Assyrian military officer; here and throughout chapters 18 and 19, as well as Isaiah 36 and 37.\f* \w along with a great army|strong="H03515"\w*, \w from|strong="H04480"\w* \w Lachish|strong="H03923"\w* \w to|strong="H00413"\w* \w King|strong="H04428"\w* \w Hezekiah|strong="H02396"\w* \w . . .|strong="H02428"\w* \w at Jerusalem|strong="H03389"\w*. \w They advanced up|strong="H05927"\w* \w . . .|strong="H00935"\w* \w to Jerusalem|strong="H03389"\w* \w . . .|strong="H05927"\w* \w . . .|strong="H00935"\w* \w and stationed themselves|strong="H05975"\w* \w by the aqueduct|strong="H08585"\w* \w of the upper|strong="H05945"\w* \w pool|strong="H01295"\w*, \w -|strong="H00834"\w* \w on the road|strong="H04546"\w* \w to the Launderer’s|strong="H03526"\w* \w Field|strong="H07704"\w*. \v 18 \w Then they called|strong="H07121"\w* \w for|strong="H00413"\w* \w the king|strong="H04428"\w*. \w And Eliakim|strong="H00471"\w* \w son|strong="H01121"\w* \w of Hilkiah|strong="H02518"\w* \w -|strong="H00834"\w* \w the palace|strong="H01004"\w* \w administrator|strong="H05921"\w*, \w Shebnah|strong="H07644"\w* \w the scribe|strong="H05608"\w*, \w and Joah|strong="H03098"\w* \w son|strong="H01121"\w* \w of Asaph|strong="H00623"\w* \w the recorder|strong="H02142"\w*, \w went out|strong="H03318"\w* \w to them|strong="H00413"\w*.
\p \v 19 \w vvv|strong="H07262"\w* \w The Rabshakeh|strong="H07262"\w* \w said|strong="H00559"\w* \w to them|strong="H00413"\w*, “\w Tell|strong="H00559"\w* \w . . .|strong="H04994"\w* \w . . .|strong="H00413"\w* \w Hezekiah|strong="H02396"\w* \w that this is what|strong="H03541"\w* \w the great|strong="H01419"\w* \w king|strong="H04428"\w*, \w the king|strong="H04428"\w* \w of Assyria|strong="H00804"\w*, \w says|strong="H00559"\w*: \w What|strong="H04100"\w* \w is the basis|strong="H00982"\w* \w [of] this|strong="H02088"\w* \w confidence|strong="H00986"\w* \w of yours|strong="H00834"\w*? \v 20 \w You claim|strong="H00559"\w* \w [to have] a strategy|strong="H06098"\w* \w and strength|strong="H01369"\w* \w for war|strong="H04421"\w*, \w but|strong="H00389"\w* \w [these are] empty|strong="H08193"\w* \w words|strong="H01697"\w*. \w In|strong="H05921"\w* \w whom|strong="H04310"\w* \w are you now|strong="H06258"\w* \w trusting|strong="H00982"\w*, \w that|strong="H03588"\w* \w you have rebelled|strong="H04775"\w* against me?
\p \v 21 \w Look|strong="H02009"\w* \w now|strong="H06258"\w*, \w you are trusting|strong="H00982"\w*\w . . .|strong="H05921"\w*\w . . .|strong="H05921"\w* \w in Egypt|strong="H04714"\w*, \w that splintered|strong="H07533"\w* \w . . .|strong="H02088"\w* \w reed|strong="H07070"\w* \w of a staff|strong="H04938"\w*\w . . .|strong="H05921"\w* \w vvv|strong="H00935"\w* \w that will pierce|strong="H05344"\w* \w the hand|strong="H03709"\w* \w of anyone|strong="H00376"\w* \w who|strong="H00834"\w* \w leans on it|strong="H05564"\w*. \w Such is|strong="H03651"\w* \w Pharaoh|strong="H06547"\w* \w king|strong="H04428"\w* \w of Egypt|strong="H04714"\w* \w to all|strong="H03605"\w* \w who trust|strong="H00982"\w* \w in him|strong="H05921"\w*. \v 22 \w But if|strong="H03588"\w* \w you say|strong="H00559"\w* \w to me|strong="H00413"\w*, ‘\w We trust|strong="H00982"\w* \w in|strong="H00413"\w* \w the LORD|strong="H03068"\w* \w our God|strong="H00430"\w*,’ \w is He|strong="H01931"\w* \w not|strong="H03808"\w* \w the One|strong="H00834"\w* \w whose high places|strong="H01116"\w* \w -|strong="H00853"\w* \w and altars|strong="H04196"\w* \w Hezekiah|strong="H02396"\w* \w -|strong="H00853"\w* \w has removed|strong="H05493"\w*, \w saying|strong="H00559"\w* \w to Judah|strong="H03063"\w* \w and Jerusalem|strong="H03389"\w*: ‘\w You must worship|strong="H07812"\w* \w before|strong="H06440"\w* \w this|strong="H02088"\w* \w altar|strong="H04196"\w* \w in Jerusalem|strong="H03389"\w*’?
\p \v 23 \w Now, therefore|strong="H06258"\w*, \w make a bargain|strong="H06148"\w* \w . . .|strong="H04994"\w* \w with|strong="H00854"\w* \w my master|strong="H00113"\w*, \w . . .|strong="H00854"\w* \w the king|strong="H04428"\w* \w of Assyria|strong="H00804"\w*. \w I will give|strong="H05414"\w* you \w two thousand|strong="H00505"\w* \w horses|strong="H05483"\w* — \w if|strong="H00518"\w* \w you can|strong="H03201"\w* \w put|strong="H05414"\w* \w riders|strong="H07392"\w* \w on them|strong="H05921"\w*! \v 24 \w For how|strong="H00349"\w* \w can you repel|strong="H07725"\w* \w -|strong="H00853"\w* \w -|strong="H06440"\w* \w a single|strong="H00259"\w* \w officer|strong="H06346"\w* \w among the least|strong="H06996"\w* \w of my master’s|strong="H00113"\w* \w servants|strong="H05650"\w* \w when you depend|strong="H00982"\w* . . . \w on|strong="H05921"\w* \w Egypt|strong="H04714"\w* \w for chariots|strong="H07393"\w* \w and horsemen|strong="H06571"\w*? \v 25 \w So now|strong="H06258"\w*, \w was it apart from|strong="H01107"\w* \w the LORD|strong="H03068"\w* \w that I have come up|strong="H05927"\w* \w against|strong="H05921"\w* \w this|strong="H02088"\w* \w place|strong="H04725"\w* \w to destroy it|strong="H07843"\w*? \w The LORD Himself|strong="H03068"\w* \w said|strong="H00559"\w* \w to me|strong="H00413"\w*, ‘\w Go up|strong="H05927"\w* \w against|strong="H05921"\w* \w this|strong="H02063"\w* \w land|strong="H00776"\w* \w and destroy it|strong="H07843"\w*.’”
\p \v 26 \w Then Eliakim|strong="H00471"\w* \w son|strong="H01121"\w* \w of Hilkiah|strong="H02518"\w*, \w along with Shebnah|strong="H07644"\w* \w and Joah|strong="H03098"\w*, \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w vvv|strong="H07262"\w* \w the Rabshakeh|strong="H07262"\w*, “\w Please|strong="H04994"\w* \w speak|strong="H01696"\w* \w to|strong="H00413"\w* \w your servants|strong="H05650"\w* \w in Aramaic|strong="H00762"\w*, \w since|strong="H03588"\w* \w we|strong="H00587"\w* \w understand it|strong="H08085"\w*. \w Do not|strong="H00408"\w* \w speak|strong="H01696"\w* \w with us|strong="H05973"\w* \w in Hebrew|strong="H03066"\w*\f + \fr 18:26 \ft Or \fqa in the dialect of Judah\ft ; also in verse 28\f* \w in the hearing|strong="H00241"\w* \w of the people|strong="H05971"\w* \w -|strong="H00834"\w* \w on|strong="H05921"\w* \w the wall|strong="H02346"\w*.”
\p \v 27 \w vvv|strong="H07262"\w* \w But the Rabshakeh|strong="H07262"\w* \w replied|strong="H00559"\w* \w . . .|strong="H00413"\w*, “\w Has my master|strong="H00113"\w* \w sent me|strong="H07971"\w* \w to speak|strong="H01696"\w* \w -|strong="H00853"\w* \w these|strong="H00428"\w* \w words|strong="H01697"\w* \w only to|strong="H05921"\w* \w you and|strong="H00413"\w* \w your master|strong="H00113"\w*, \w and not|strong="H03808"\w* \w to|strong="H05921"\w* \w the men|strong="H00582"\w* \w sitting|strong="H03427"\w* \w on|strong="H05921"\w* \w the wall|strong="H02346"\w*, \w who are destined with you|strong="H05973"\w* \w to eat|strong="H00398"\w* \w -|strong="H00853"\w* \w their own dung|strong="H02716"\w* \w and drink|strong="H08354"\w* \w -|strong="H00853"\w* \w their own urine|strong="H07890"\w*?”
\p \v 28 \w vvv|strong="H07262"\w* \w Then the Rabshakeh|strong="H07262"\w* \w stood|strong="H05975"\w* \w and called out|strong="H07121"\w* \w loudly|strong="H06963"\w* \w . . .|strong="H01419"\w* \w in Hebrew|strong="H03066"\w* \w -|strong="H01696"\w* \w -|strong="H00559"\w*: “\w Hear|strong="H08085"\w* \w the word|strong="H01697"\w* \w of the great|strong="H01419"\w* \w king|strong="H04428"\w*, \w the king|strong="H04428"\w* \w of Assyria|strong="H00804"\w*! \v 29 \w This is what|strong="H03541"\w* \w the king|strong="H04428"\w* \w says|strong="H00559"\w*: \w Do not|strong="H00408"\w* \w let Hezekiah|strong="H02396"\w* \w . . .|strong="H03588"\w* \w deceive|strong="H05377"\w* you; \w he cannot|strong="H03808"\w* \w . . .|strong="H03201"\w* \w deliver|strong="H05337"\w* \w you|strong="H00853"\w* \w from my hand|strong="H03027"\w*. \v 30 \w Do not|strong="H00408"\w* \w let Hezekiah|strong="H02396"\w* \w persuade you to trust|strong="H00982"\w* \w -|strong="H00853"\w* \w in|strong="H00413"\w* \w the LORD|strong="H03068"\w* \w when he says|strong="H00559"\w*, ‘\w The LORD|strong="H03068"\w* \w will surely deliver us|strong="H05337"\w* \w . . .|strong="H05337"\w*; \w this|strong="H02063"\w* \w city|strong="H05892"\w* \w will not|strong="H03808"\w* \w be given|strong="H05414"\w* \w -|strong="H00853"\w* \w into the hand|strong="H03027"\w* \w of the king|strong="H04428"\w* \w of Assyria|strong="H00804"\w*.’
\p \v 31 \w Do not|strong="H00408"\w* \w listen|strong="H08085"\w* \w to|strong="H00413"\w* \w Hezekiah|strong="H02396"\w*, \w for|strong="H03588"\w* \w this is what|strong="H03541"\w* \w the king|strong="H04428"\w* \w of Assyria|strong="H00804"\w* \w says|strong="H00559"\w*: \w Make|strong="H06213"\w* \w peace|strong="H01293"\w* \w with me|strong="H00854"\w*\f + \fr 18:31 \ft Or \fqa Make a blessing with me\f* \w and come out|strong="H03318"\w* \w to me|strong="H00413"\w*. \w Then every one of you|strong="H00376"\w* \w will eat|strong="H00398"\w* \w from his own vine|strong="H01612"\w* \w [and] his own fig tree|strong="H08384"\w* \w [and]|strong="H00376"\w* \w drink|strong="H08354"\w* \w . . .|strong="H00376"\w* \w water|strong="H04325"\w* \w from his own cistern|strong="H00953"\w*, \v 32 \w until|strong="H05704"\w* \w I come|strong="H00935"\w* \w and take you away|strong="H03947"\w* \w -|strong="H00853"\w* \w to|strong="H00413"\w* \w a land|strong="H00776"\w* \w like your own|strong="H00776"\w*— \w a land|strong="H00776"\w* \w of grain|strong="H01715"\w* \w and new wine|strong="H08492"\w*, \w a land|strong="H00776"\w* \w of bread|strong="H03899"\w* \w and vineyards|strong="H03754"\w*, \w a land|strong="H00776"\w* \w of olive trees|strong="H02132"\w* \w . . .|strong="H03323"\w* \w and honey|strong="H01706"\w*— \w so that you may live|strong="H02421"\w* \w and not|strong="H03808"\w* \w die|strong="H04191"\w*. \w But do not|strong="H00408"\w* \w listen|strong="H08085"\w* \w to|strong="H00413"\w* \w Hezekiah|strong="H02396"\w*, \w for|strong="H03588"\w* \w he misleads you|strong="H05496"\w* \w -|strong="H00853"\w* \w when he says|strong="H00559"\w*, ‘\w The LORD|strong="H03068"\w* \w will deliver us|strong="H05337"\w*.’
\p \v 33 \w Has the god|strong="H00430"\w* \w of any|strong="H00376"\w* \w nation|strong="H01471"\w* \w -|strong="H00853"\w* \w ever delivered|strong="H05337"\w* \w . . .|strong="H05337"\w* \w his land|strong="H00776"\w* \w from the hand|strong="H03027"\w* \w of the king|strong="H04428"\w* \w of Assyria|strong="H00804"\w*? \v 34 \w Where|strong="H00346"\w* \w are the gods|strong="H00430"\w* \w of Hamath|strong="H02574"\w* \w and Arpad|strong="H00774"\w*? \w Where|strong="H00346"\w* \w are the gods|strong="H00430"\w* \w of Sepharvaim|strong="H05617"\w*, \w Hena|strong="H02012"\w*, \w and Ivvah|strong="H05755"\w*? \w . . .|strong="H03588"\w* \w Have they delivered|strong="H05337"\w* \w -|strong="H00853"\w* \w Samaria|strong="H08111"\w* \w from my hand|strong="H03027"\w*? \v 35 \w Who|strong="H04310"\w* \w among all|strong="H03605"\w* \w the gods|strong="H00430"\w* \w of these lands|strong="H00776"\w* \w -|strong="H00834"\w* \w has delivered|strong="H05337"\w* \w -|strong="H00853"\w* \w his land|strong="H00776"\w* \w from my hand|strong="H03027"\w*? \w . . .|strong="H03588"\w* \w How then can the LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w deliver|strong="H05337"\w* \w Jerusalem|strong="H03389"\w* \w from my hand|strong="H03027"\w*?”
