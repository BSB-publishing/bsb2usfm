\p \v 27 \w When King|strong="H04428"\w* \w Ahaziah|strong="H00274"\w* \w of Judah|strong="H03063"\w* \w saw [this]|strong="H07200"\w*, \w he fled|strong="H05127"\w* \w up the road|strong="H01870"\w* \w vvv|strong="H01004"\w* \w toward Beth-haggan|strong="H01588"\w*.
