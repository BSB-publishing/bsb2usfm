you to keep|strong="H06213"\w* \w -|strong="H00853"\w* \w the Sabbath|strong="H07676"\w* \w day|strong="H03117"\w*.
\li1 \v 16 \w Honor|strong="H03513"\w* \w -|strong="H00853"\w* \w your father|strong="H00001"\w* \w -|strong="H00853"\w* \w and your mother|strong="H00517"\w*, \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w has commanded you|strong="H06680"\w*, \w so that|strong="H04616"\w* \w your days|strong="H03117"\w* \w may be long|strong="H00748"\w* \w and that|strong="H04616"\w* \w it may go well|strong="H03190"\w* with you \w in|strong="H05921"\w* \w the land|strong="H00127"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w is giving|strong="H05414"\w* you.\f + \fr 5:16 \ft Cited in Matthew 15:4, Matthew 19:19, Mark 7:10, Luke 18:20, and Ephesians 6:2–3\f*
