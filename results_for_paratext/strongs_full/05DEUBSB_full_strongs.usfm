\p \v 13 \w You are to celebrate|strong="H06213"\w* \w the Feast|strong="H02282"\w* \w of Tabernacles|strong="H05521"\w*\f + \fr 16:13 \ft Or \fqa Booths \ft or \fqa Shelters\ft ; see footnotes for verse 16.\f* \w for seven|strong="H07651"\w* \w days|strong="H03117"\w* \w after you have gathered|strong="H00622"\w* \w [the produce of] your threshing floor|strong="H01637"\w* \w and your winepress|strong="H03342"\w*. \v 14 \w And you shall rejoice|strong="H08055"\w* \w in your feast|strong="H02282"\w*— \w you|strong="H00859"\w*, \w your sons|strong="H01121"\w* \w and daughters|strong="H01323"\w*, \w your menservants|strong="H05650"\w* \w and maidservants|strong="H00519"\w*, \w and the Levite|strong="H03881"\w*, \w as well as the foreigner|strong="H01616"\w*, \w the fatherless|strong="H03490"\w*, \w and the widows|strong="H00490"\w* \w -|strong="H00834"\w* \w among you|strong="H08179"\w*.
