\p \v 4 \w Then the priest|strong="H03548"\w* \w shall take|strong="H03947"\w* \w the basket|strong="H02935"\w* \w from your hands|strong="H03027"\w* \w and place it|strong="H05117"\w* \w before|strong="H06440"\w* \w the altar|strong="H04196"\w* \w of the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*, \v 5 \w and you are to declare|strong="H06030"\w* \w . . .|strong="H00559"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*, “\w My father|strong="H00001"\w* \w was a wandering|strong="H00006"\w* \w Aramean|strong="H00761"\w*, \w and he went down|strong="H03381"\w* \w to Egypt|strong="H04714"\w* \w few in number|strong="H04592"\w* \w and lived|strong="H01481"\w* \w there|strong="H08033"\w* \w . . .|strong="H04962"\w* \w -|strong="H08033"\w* \w and became|strong="H01961"\w* \w a great|strong="H01419"\w* \w nation|strong="H01471"\w*, \w mighty|strong="H06099"\w* \w and numerous|strong="H07227"\w*. \v 6 \w But the Egyptians|strong="H04713"\w* \w mistreated us|strong="H07489"\w* \w -|strong="H00853"\w* \w and afflicted us|strong="H06031"\w*, \w putting us|strong="H05414"\w* \w . . .|strong="H05921"\w* \w to hard|strong="H07186"\w* \w labor|strong="H05656"\w*. \v 7 \w So we called out|strong="H06817"\w* \w to|strong="H00413"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of our fathers|strong="H00001"\w*; \w and the LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w heard|strong="H08085"\w* \w our voice|strong="H06963"\w* \w and saw|strong="H07200"\w* \w -|strong="H00853"\w* \w our affliction|strong="H06040"\w*, \w -|strong="H00853"\w* \w toil|strong="H05999"\w*, \w -|strong="H00853"\w* \w and oppression|strong="H03906"\w*. \v 8 \w Then the LORD|strong="H03068"\w* \w brought us|strong="H03318"\w* \w out of Egypt|strong="H04714"\w* \w with a mighty|strong="H02389"\w* \w hand|strong="H03027"\w* \w and an outstretched|strong="H05186"\w* \w arm|strong="H02220"\w*, \w with great|strong="H01419"\w* \w terr