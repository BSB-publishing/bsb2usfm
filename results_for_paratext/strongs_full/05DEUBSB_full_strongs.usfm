\s1 The Choice of Life or Death
\p \v 11 \w For|strong="H03588"\w* \w this|strong="H02063"\w* \w commandment|strong="H04687"\w* \w -|strong="H00834"\w* \w I|strong="H00595"\w* \w give|strong="H06680"\w* \w you today|strong="H03117"\w* \w is not|strong="H03808"\w* \w too difficult|strong="H06381"\w* \w . . .|strong="H01931"\w* \w for you|strong="H04480"\w* \w or|strong="H03808"\w* \w beyond your reach|strong="H07350"\w* \w . . .|strong="H01931"\w*. \v 12 \w It|strong="H01931"\w* \w is not|strong="H03808"\w* \w in heaven|strong="H08064"\w*, \w that you should need to ask|strong="H00559"\w*, ‘\w Who|strong="H04310"\w* \w will ascend|strong="H05927"\w* into \w heaven|strong="H08064"\w*\f + \fr 30:12 \ft Cited in Romans 10:6\f* \w to get it|strong="H03947"\w* for us \w and proclaim|strong="H08085"\w* \w it|strong="H00853"\w*, \w that we may obey it|strong="H06213"\w*?’ \v 13 \w And it|strong="H01931"\w* \w is not|strong="H03808"\w* \w beyond|strong="H05676"\w* \w the sea|strong="H03220"\w*, \w that you should need to ask|strong="H00559"\w*, ‘\w Who|strong="H04310"\w* \w will cross|strong="H05674"\w* . . . \w . . .|strong="H00413"\w* \w . . .|strong="H05676"\w* \w the sea|strong="H03220"\w*\f + \fr 30:13 \ft See Romans 10:7.\f* \w to get it|strong="H03947"\w* for us \w and proclaim|strong="H08085"\w* \w it|strong="H00853"\w*, \w that we may obey it|strong="H06213"\w*?’ \v 14 \w But|strong="H03588"\w* \w the word [is]|strong="H01697"\w* \w very|strong="H03966"\w* \w near|strong="H07138"\w* \w you|strong="H00413"\w*; \w [it is] in your mouth|strong="H06310"\w* \w and in your heart|strong="H03824"\w*,\f + \fr 30:14 \ft Cited in Romans 10:8\f* \w so that you may obey it|strong="H06213"\w*.
\p \v 15 \w See|strong="H07200"\w*, \w I have set|strong="H05414"\w* \w before you|strong="H06440"\w* \w today|strong="H03117"\w* \w -|strong="H00853"\w* \w life|strong="H02416"\w* \w -|strong="H00853"\w* \w and prosperity|strong="H02896"\w*, \w as well as|strong="H00853"\w* \w death|strong="H04194"\w* \w -|strong="H00853"\w* \w and disaster|strong="H07451"\w*. \v 16 \w For|strong="H00834"\w* \w I|strong="H00595"\w* \w am commanding|strong="H06680"\w* \w you today|strong="H03117"\w* \w to love|strong="H00157"\w* \w -|strong="H00853"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*, \w to walk|strong="H01980"\w* \w in His ways|strong="H01870"\w*, \w and to keep|strong="H08104"\w* \w His commandments|strong="H04687"\w*, \w statutes|strong="H02708"\w*, \w and ordinances|strong="H04941"\w*, \w so that you may live|strong="H02421"\w* \w and increase|strong="H07235"\w*, \w and the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w may bless|strong="H01288"\w* \w you in the land|strong="H00776"\w* \w that|strong="H00834"\w* \w you|strong="H00859"\w* \w are entering|strong="H00935"\w* \w . . .|strong="H08033"\w* \w to possess|strong="H03423"\w*.
\p \v 17 \w But if|strong="H00518"\w* \w your heart|strong="H03824"\w* \w turns away|strong="H06437"\w* \w and you do not|strong="H03808"\w* \w listen|strong="H08085"\w*, \w but are drawn away|strong="H05080"\w* \w to bow down|strong="H07812"\w* \w to other|strong="H00312"\w* \w gods|strong="H00430"\w* \w and worship them|strong="H05647"\w*, \v 18 \w I declare|strong="H05046"\w* to you \w today|strong="H03117"\w* \w that|strong="H03588"\w* \w you will surely perish|strong="H00006"\w* \w . . .|strong="H00006"\w*; \w vvv|strong="H03808"\w* \w you shall not prolong|strong="H00748"\w* \w [your] days|strong="H03117"\w* \w in|strong="H05921"\w* \w the land|strong="H00127"\w* \w that|strong="H00834"\w* \w you|strong="H00859"\w* \w are crossing|strong="H05674"\w* \w -|strong="H00853"\w* \w the Jordan|strong="H03383"\w* \w vvv|strong="H00935"\w* \w vvv|strong="H08033"\w* \w to possess|strong="H03423"\w*.
\p \v 19 \w I call heaven|strong="H08064"\w* \w -|strong="H00853"\w* \w and earth|strong="H00776"\w* \w as witnesses|strong="H05749"\w* against you \w today|strong="H03117"\w* \w -|strong="H00853"\w* \w that I have set|strong="H05414"\w* \w before|strong="H06440"\w* \w you life|strong="H02416"\w* \w and death|strong="H04194"\w*, \w blessing|strong="H01293"\w* \w and cursing|strong="H07045"\w*. \w Therefore choose|strong="H00977"\w* \w life|strong="H02416"\w*, \w so that|strong="H04616"\w* \w you|strong="H00859"\w* \w and your descendants|strong="H02233"\w* \w may live|strong="H02421"\w*, \v 20 \w and that you may love|strong="H00157"\w* \w -|strong="H00853"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*, \w obey Him|strong="H08085"\w*, \w . . .|strong="H06963"\w* \w and hold fast|strong="H01692"\w* to Him. \w For|strong="H03588"\w* \w He [is]|strong="H01931"\w* \w your life|strong="H02416"\w*, \w and He will prolong|strong="H00753"\w* \w your life|strong="H03117"\w* \w . . .|strong="H03427"\w* \w in|strong="H05921"\w* \w the land|strong="H00127"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w swore|strong="H07650"\w* \w to give|strong="H05414"\w* . . . \w to your fathers|strong="H00001"\w*, \w to Abraham|strong="H00085"\w*, \w Isaac|strong="H03327"\w*, \w and Jacob|strong="H03290"\w*.”
\c 31
\s1 Joshua to Succeed Moses
\p \v 1 \w When Moses|strong="H04872"\w* \w had finished|strong="H01980"\w* \w speaking|strong="H01696"\w*\f + \fr 31:1 \ft DSS and LXX; MT \fqa When Moses went out and spoke\f* \w -|strong="H00853"\w* \w these|strong="H00428"\w* \w words|strong="H01697"\w* \w to|strong="H00413"\w* \w all|strong="H03605"\w* \w Israel|strong="H03478"\w*, \v 2 \w he said|strong="H00559"\w* \w to them|strong="H00413"\w*, “\w I|strong="H00595"\w* \w am now|strong="H03117"\w* \w a hundred|strong="H03967"\w* \w and twenty|strong="H06242"\w* \w years old|strong="H01121"\w* \w . . .|strong="H08141"\w*; \w I am|strong="H03201"\w* \w no|strong="H03808"\w* \w longer|strong="H05750"\w* \w able to come|strong="H03318"\w* \w and go|strong="H00935"\w*, \w and the LORD|strong="H03068"\w* \w has said|strong="H00559"\w* \w to me|strong="H00413"\w*, ‘\w You shall not|strong="H03808"\w* \w cross|strong="H05674"\w* \w -|strong="H00853"\w* \w the|strong="H02088"\w* \w Jordan|strong="H03383"\w*.’
\p \v 3 \w The LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w Himself|strong="H01931"\w* \w will cross over|strong="H05674"\w* \w ahead of you|strong="H06440"\w*. \w He|strong="H01931"\w* \w will destroy|strong="H08045"\w* \w -|strong="H00853"\w* \w these|strong="H00428"\w* \w nations|strong="H01471"\w* \w before you|strong="H06440"\w*, \w and you will dispossess them|strong="H03423"\w*. \w Joshua|strong="H03091"\w* \w . . .|strong="H01931"\w* \w will cross|strong="H05674"\w* \w ahead of you|strong="H06440"\w*, \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w has said|strong="H01696"\w*. \v 4 \w And the LORD|strong="H03068"\w* \w will do|strong="H06213"\w* to them \w as|strong="H00834"\w* \w He did|strong="H06213"\w* \w to Sihon|strong="H05511"\w* \w and Og|strong="H05747"\w*, \w the kings|strong="H04428"\w* \w of the Amorites|strong="H00567"\w*, \w when|strong="H00834"\w* \w He destroyed|strong="H08045"\w* \w them|strong="H00853"\w* \w along with their land|strong="H00776"\w*.
\p \v 5 \w The LORD|strong="H03068"\w* \w will deliver them over|strong="H05414"\w* \w to you|strong="H06440"\w*, \w and you must do|strong="H06213"\w* to them \w exactly as|strong="H03605"\w* \w . . .|strong="H04687"\w* \w -|strong="H00834"\w* \w I have commanded|strong="H06680"\w* \w you|strong="H00853"\w*. \v 6 \w Be strong|strong="H02388"\w* \w and courageous|strong="H00553"\w*; \w do not|strong="H00408"\w* \w be afraid|strong="H03372"\w* \w . . .|strong="H00408"\w* \w or terrified|strong="H06206"\w* \w of them|strong="H06440"\w*, \w for|strong="H03588"\w* \w it is the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w who|strong="H01931"\w* \w goes|strong="H01980"\w* \w with you|strong="H05973"\w*; \w He will never|strong="H03808"\w* \w leave you|strong="H07503"\w* \w [nor]|strong="H03808"\w* \w forsake you|strong="H05800"\w*.”\f + \fr 31:6 \ft Cited in Hebrews 13:5; here and in verse 8\f*
\p \v 7 \w Then Moses|strong="H04872"\w* \w called|strong="H07121"\w* \w for Joshua|strong="H03091"\w* \w and said|strong="H00559"\w* \w to him|strong="H00413"\w* \w in the presence|strong="H05869"\w* \w of all|strong="H03605"\w* \w Israel|strong="H03478"\w*, “\w Be strong|strong="H02388"\w* \w and courageous|strong="H00553"\w*, \w for|strong="H03588"\w* \w you|strong="H00859"\w* \w will go|strong="H00935"\w* \w with|strong="H00854"\w* \w this|strong="H02088"\w* \w people|strong="H05971"\w* \w into|strong="H00413"\w* \w the land|strong="H00776"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w swore|strong="H07650"\w* \w to their fathers|strong="H00001"\w* \w to give|strong="H05414"\w* them, \w and you|strong="H00859"\w* \w shall give it to them as an inheritance|strong="H05157"\w*. \w -|strong="H00853"\w* \v 8 \w The LORD|strong="H03068"\w* \w Himself|strong="H01931"\w* \w goes|strong="H01980"\w* \w before you|strong="H06440"\w*; \w He|strong="H01931"\w* \w will be|strong="H01961"\w* \w with you|strong="H05973"\w*. \w He will never|strong="H03808"\w* \w leave you|strong="H07503"\w* \w nor|strong="H03808"\w* \w forsake you|strong="H05800"\w*. \w Do not|strong="H03808"\w* \w be afraid|strong="H03372"\w* \w [or]|strong="H03808"\w* \w discouraged|strong="H02865"\w*.”
\s1 The Reading of the Law
\p \v 9 \w So Moses|strong="H04872"\w* \w -|strong="H00853"\w* \w wrote down|strong="H03789"\w* \w this|strong="H02063"\w* \w law|strong="H08451"\w* \w and gave|strong="H05414"\w* \w it to|strong="H00413"\w* \w the priests|strong="H03548"\w*, \w the sons|strong="H01121"\w* \w of Levi|strong="H03881"\w*, \w who carried|strong="H05375"\w* \w -|strong="H00853"\w* \w the ark|strong="H00727"\w* \w of the covenant|strong="H01285"\w* \w of the LORD|strong="H03068"\w*, \w and to|strong="H00413"\w* \w all|strong="H03605"\w* \w the elders|strong="H02205"\w* \w of Israel|strong="H03478"\w*.
\p \v 10 \w Then Moses|strong="H04872"\w* \w -|strong="H00853"\w* \w -|strong="H00559"\w* \w commanded them|strong="H06680"\w*, “\w At the end|strong="H07093"\w* \w of [every] seven|strong="H07651"\w* \w years|strong="H08141"\w*, \w at the appointed time|strong="H04150"\w* \w in the year|strong="H08141"\w* \w of remission [of debt]|strong="H08059"\w*, \w during the Feast|strong="H02282"\w* \w of Tabernacles|strong="H05521"\w*,\f + \fr 31:10 \ft That is, Sukkot, the autumn feast of pilgrimage to Jerusalem; also translated as \fqa the Feast of Booths \ft or \fqa the Feast of Shelters \ft and originally called \fqa the Feast of Ingathering\ft (see Exodus 23:16 and Exodus 34:22).\f* \v 11 \w when all|strong="H03605"\w* \w Israel|strong="H03478"\w* \w . . .|strong="H07200"\w* \w . . .|strong="H00854"\w* \w comes|strong="H00935"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w at the place|strong="H04725"\w* \w -|strong="H00834"\w* \w He will choose|strong="H00977"\w*, \w you are to read|strong="H07121"\w* \w -|strong="H00853"\w* \w this|strong="H02063"\w* \w law|strong="H08451"\w* \w in the hearing|strong="H00241"\w* \w of|strong="H05048"\w* \w all|strong="H03605"\w* \w Israel|strong="H03478"\w*.
