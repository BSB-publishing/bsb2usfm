\p \v 22 \w If|strong="H03588"\w* \w a man|strong="H00376"\w* \w has committed|strong="H01961"\w* \w a sin|strong="H02399"\w* \w worthy|strong="H04941"\w* \w of death|strong="H04194"\w*, \w and he is executed|strong="H04191"\w*, \w and you hang|strong="H08518"\w* \w his body|strong="H00853"\w* \w on|strong="H05921"\w* \w a tree|strong="H06086"\w*,\f + \fr 21:22 \ft Or \fqa impale his body on a pole\ft ; similarly in verse 23\f* \v 23 \w you must not leave|strong="H03808"\w* \w the body|strong="H05038"\w* \w on|strong="H05921"\w* \w the tree|strong="H06086"\w* \w overnight|strong="H03885"\w*, \w but|strong="H03588"\w* \w you must be sure to bury|strong="H06912"\w* \w . . .|strong="H06912"\w* \w him|strong="H01931"\w* \w that day|strong="H03117"\w*, \w because|strong="H03588"\w* \w anyone who is hung [on a tree]|strong="H08518"\w* \w is under God’s|strong="H00430"\w* \w curse|strong="H07045"\w*.\f + \fr 21:23 \ft LXX; Hebrew \fqa anyone who is hanged is under God’s curse\ft ; cited in Galatians 3:13\f* \w You must not|strong="H03808"\w* \w defile|strong="H02930"\w* \w -|strong="H00853"\w* \w the land|strong="H00127"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w is giving|strong="H05414"\w* you \w as an inheritance|strong="H05159"\w*.
