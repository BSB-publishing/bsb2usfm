\s1 Purge the Idolater
\p \v 2 \w If|strong="H03588"\w* \w a man|strong="H00376"\w* \w or|strong="H00176"\w* \w woman|strong="H00802"\w* \w -|strong="H00834"\w* \w among you|strong="H07130"\w* \w in one|strong="H00259"\w* \w of the towns|strong="H08179"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w gives|strong="H05414"\w* you \w is found|strong="H04672"\w* \w doing|strong="H06213"\w* \w -|strong="H00853"\w* \w evil|strong="H07451"\w* \w in the sight|strong="H05869"\w* \w of the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w by transgressing|strong="H05674"\w* \w His covenant|strong="H01285"\w* \v 3 \w and going|strong="H01980"\w* \w to worship|strong="H05647"\w* \w other|strong="H00312"\w* \w gods|strong="H00430"\w*, \w bowing down|strong="H07812"\w* to them \w or to the sun|strong="H08121"\w* \w or|strong="H00176"\w* \w moon|strong="H03394"\w* \w or|strong="H00176"\w* \w any|strong="H03605"\w* \w of the host|strong="H06635"\w* \w of heaven|strong="H08064"\w*— \w which|strong="H00834"\w* \w I have forbidden|strong="H03808"\w* \w . . .|strong="H06680"\w*— \v 4 \w and if it is reported|strong="H05046"\w* \w and you hear about it|strong="H08085"\w*, \w you must investigate it|strong="H01875"\w* \w thoroughly|strong="H03190"\w*.
\p \w If|strong="H02009"\w* \w the report|strong="H01697"\w* \w is|strong="H06213"\w* \w true|strong="H00571"\w* \w . . .|strong="H03559"\w* \w and such|strong="H02063"\w* \w an abomination|strong="H08441"\w* \w has happened in Israel|strong="H03478"\w*, \v 5 \w you must bring out|strong="H03318"\w* \w -|strong="H00853"\w* \w to|strong="H00413"\w* \w your gates|strong="H08179"\w* \w -|strong="H00853"\w* \w -|strong="H00376"\w* \w . . .|strong="H00176"\w* \w -|strong="H00853"\w* \w -|strong="H00802"\w* \w -|strong="H01931"\w* \w the man|strong="H00376"\w* \w or|strong="H00176"\w* \w -|strong="H00853"\w* \w woman|strong="H00802"\w* \w . . .|strong="H01931"\w* \w who|strong="H00834"\w* \w has done|strong="H06213"\w* \w -|strong="H00853"\w* \w this|strong="H02088"\w* \w evil|strong="H07451"\w* \w thing|strong="H01697"\w*, \w and you must stone that person|strong="H05619"\w* \w . . .|strong="H00068"\w* \w to death|strong="H04191"\w*. \v 6 \w On|strong="H05921"\w* \w the testimony|strong="H06310"\w* \w of two|strong="H08147"\w* \w or|strong="H00176"\w* \w three|strong="H07969"\w* \w witnesses|strong="H05707"\w* \w a man shall be put to death|strong="H04191"\w* \w . . .|strong="H04191"\w*, \w but he shall not|strong="H03808"\w* \w be executed|strong="H04191"\w* \w on|strong="H05921"\w* \w the testimony|strong="H06310"\w* \w . . .|strong="H05707"\w* \w of a lone|strong="H00259"\w* \w witness|strong="H05707"\w*. \v 7 \w The hands|strong="H03027"\w* \w of the witnesses|strong="H05707"\w* \w shall be|strong="H01961"\w* - \w the first|strong="H07223"\w* \w in putting him to death|strong="H04191"\w*, \w and after that|strong="H00314"\w*, \w the hands|strong="H03027"\w* \w of all|strong="H03605"\w* \w the people|strong="H05971"\w*. \w So you must purge|strong="H01197"\w* \w the evil|strong="H07451"\w* \w from among you|strong="H07130"\w*.\f + \fr 17:7 \ft Cited in 1 Corinthians 5:13\f*
\s1 Courts of Law
\p \v 8 \w If|strong="H03588"\w* \w a case|strong="H01697"\w* \w is too difficult|strong="H06381"\w* \w for you|strong="H04480"\w* \w to judge|strong="H04941"\w*, \w whether|strong="H01697"\w* \w the controversy|strong="H07379"\w* \w within your gates|strong="H08179"\w* \w is regarding|strong="H00996"\w* \w bloodshed|strong="H01818"\w* \w . . .|strong="H01818"\w*, \w . . .|strong="H00996"\w* \w lawsuits|strong="H01779"\w* \w . . .|strong="H01779"\w*, \w . . .|strong="H00996"\w* \w or assaults|strong="H05061"\w* \w . . .|strong="H05061"\w*, \w . . .|strong="H06965"\w* \w you must go up|strong="H05927"\w* \w to|strong="H00413"\w* \w the place|strong="H04725"\w* \w -|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* - \w will choose|strong="H00977"\w*. \v 9 \w You are to go|strong="H00935"\w* \w to|strong="H00413"\w* \w the Levitical|strong="H03881"\w* \w priests|strong="H03548"\w* \w and to|strong="H00413"\w* \w the judge|strong="H08199"\w* \w who|strong="H00834"\w* \w . . .|strong="H01961"\w* \w presides at that|strong="H01992"\w* \w time|strong="H03117"\w*. \w Inquire of them|strong="H01875"\w*, \w and they will give|strong="H05046"\w* you \w -|strong="H00853"\w* \w a verdict|strong="H01697"\w* \w in the case|strong="H04639"\w*.
\p \v 10 \w You must abide by|strong="H06213"\w* \w . . .|strong="H05921"\w* \w . . .|strong="H06310"\w* \w the verdict|strong="H01697"\w* \w -|strong="H00834"\w* \w they give|strong="H05046"\w* you \w at|strong="H04480"\w* \w the place|strong="H04725"\w* \w . . .|strong="H01931"\w* \w -|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w will choose|strong="H00977"\w*. \w Be careful|strong="H08104"\w* \w to do|strong="H06213"\w* \w everything|strong="H03605"\w* \w -|strong="H00834"\w* \w they instruct you|strong="H03384"\w*, \v 11 \w according|strong="H05921"\w* \w to the terms|strong="H06310"\w* \w of law|strong="H08451"\w* \w -|strong="H00834"\w* \w they give|strong="H03384"\w* \w . . .|strong="H05921"\w* \w and the verdict|strong="H04941"\w* \w -|strong="H00834"\w* \w they proclaim|strong="H00559"\w*. \w -|strong="H06213"\w* \w Do not|strong="H03808"\w* \w turn aside|strong="H05493"\w* \w to the right|strong="H03225"\w* \w or to the left|strong="H08040"\w* \w from|strong="H04480"\w* \w the decision|strong="H01697"\w* \w -|strong="H00834"\w* \w they declare|strong="H05046"\w* to you.
\p \v 12 \w But the man|strong="H00376"\w* \w who|strong="H00834"\w* \w acts|strong="H06213"\w* \w presumptuously|strong="H02087"\w*, \w refusing|strong="H01115"\w* \w to listen|strong="H08085"\w* \w either to|strong="H00413"\w* \w the priest|strong="H03548"\w* \w who stands|strong="H05975"\w* \w there|strong="H08033"\w* \w -|strong="H00853"\w* \w to serve|strong="H08334"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*, \w or|strong="H00176"\w* \w to|strong="H00413"\w* \w the judge|strong="H08199"\w*, \w must be put to death|strong="H04191"\w*. \w . . .|strong="H00376"\w* \w . . .|strong="H01931"\w* \w You must purge|strong="H01197"\w* \w the evil|strong="H07451"\w* \w from Israel|strong="H03478"\w*. \v 13 \w Then all|strong="H03605"\w* \w the people|strong="H05971"\w* \w will hear|strong="H08085"\w* \w and be afraid|strong="H03372"\w*, \w and will no|strong="H03808"\w* \w longer|strong="H05750"\w* \w behave arrogantly|strong="H02102"\w*.
\s1 Guidelines for a King
\p \v 14 \w When|strong="H03588"\w* \w you enter|strong="H00935"\w* \w . . .|strong="H00413"\w* \w the land|strong="H00776"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w is giving|strong="H05414"\w* you \w and have taken possession of it|strong="H03423"\w* \w and settled|strong="H03427"\w* in it, \w and you say|strong="H00559"\w*, “\w Let us set|strong="H07760"\w* \w a king|strong="H04428"\w* \w over us|strong="H05921"\w* \w like all|strong="H03605"\w* \w the nations|strong="H01471"\w* \w -|strong="H00834"\w* \w around us|strong="H05439"\w*,” \v 15 \w you are to appoint|strong="H07760"\w* \w over yourselves|strong="H05921"\w* \w the king|strong="H04428"\w* \w whom|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w shall choose|strong="H00977"\w*. \w Appoint|strong="H07760"\w* \w a king|strong="H04428"\w* \w from among|strong="H07130"\w* \w your brothers|strong="H00251"\w*; \w . . .|strong="H07760"\w* \w you are not|strong="H03808"\w* \w . . .|strong="H03201"\w* \w to set|strong="H05414"\w* \w . . .|strong="H05921"\w* \w over yourselves|strong="H05921"\w* \w a foreigner|strong="H00376"\w* \w . . .|strong="H05237"\w* \w who|strong="H00834"\w* \w is|strong="H01931"\w* \w not|strong="H03808"\w* \w one of your brothers|strong="H00251"\w*.
\p \v 16 \w But|strong="H07535"\w* \w [the king] must not|strong="H03808"\w* \w acquire many|strong="H07235"\w* \w horses|strong="H05483"\w* for himself \w [or]|strong="H03808"\w* \w send the people|strong="H05971"\w* \w back|strong="H07725"\w* \w -|strong="H00853"\w* \w to Egypt|strong="H04714"\w* \w to|strong="H04616"\w* \w acquire more|strong="H07235"\w* \w horses|strong="H05483"\w*, \w for the LORD|strong="H03068"\w* \w has said|strong="H00559"\w* -, ‘\w You are|strong="H03254"\w* \w never|strong="H03808"\w* \w to go back|strong="H07725"\w* \w that|strong="H02088"\w* \w way|strong="H01870"\w* \w again|strong="H05750"\w*.’ \v 17 \w He must not|strong="H03808"\w* \w take many|strong="H07235"\w* \w wives|strong="H00802"\w* for himself, \w lest|strong="H03808"\w* \w his heart|strong="H03824"\w* \w go astray|strong="H05493"\w*. \w He must not|strong="H03808"\w* \w accumulate|strong="H07235"\w* for himself \w large amounts|strong="H03966"\w* \w of silver|strong="H03701"\w* \w and gold|strong="H02091"\w*.
\p \v 18 \w -|strong="H01961"\w* \w When he is seated|strong="H03427"\w* \w on|strong="H05921"\w* \w his royal|strong="H04467"\w* \w throne|strong="H03678"\w*, \w he must write|strong="H03789"\w* for himself\w . . .|strong="H00853"\w* \w a copy|strong="H04932"\w* \w of this|strong="H02063"\w* \w instruction|strong="H08451"\w* \w on|strong="H05921"\w* \w a scroll|strong="H05612"\w* \w in the presence|strong="H06440"\w* \w of the Levitical|strong="H03881"\w* \w priests|strong="H03548"\w*. \v 19 \w It is to remain|strong="H01961"\w* \w with him|strong="H05973"\w*, \w and he is to read|strong="H07121"\w* from it \w all|strong="H03605"\w* \w the days|strong="H03117"\w* \w of his life|strong="H02416"\w*, \w so that|strong="H04616"\w* \w he may learn|strong="H03925"\w* \w to fear|strong="H03372"\w* \w -|strong="H00853"\w* \w the LORD|strong="H03068"\w* \w his God|strong="H00430"\w* \w by carefully observing|strong="H08104"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the words|strong="H01697"\w* \w of this|strong="H02063"\w* \w -|strong="H00853"\w* \w instruction|strong="H08451"\w* \w and these|strong="H00428"\w* \w statutes|strong="H02706"\w* \w -|strong="H06213"\w*. \v 20 \w Then his heart|strong="H03824"\w* \w will not|strong="H01115"\w* \w be exalted|strong="H07311"\w* \w above|strong="H04480"\w* \w his countrymen|strong="H00251"\w*, \w and he will not|strong="H01115"\w* \w turn aside|strong="H05493"\w* \w from the commandment|strong="H04687"\w*, \w to the right|strong="H03225"\w* \w or to the left|strong="H08040"\w*, \w in order that|strong="H04616"\w* \w he|strong="H01931"\w* \w and his sons|strong="H01121"\w* \w may reign|strong="H00748"\w* \w many years|strong="H03117"\w* \w over|strong="H05921"\w* \w his kingdom|strong="H04467"\w* \w in|strong="H07130"\w* \w Israel|strong="H03478"\w*.
\c 18
\s1 Provision for Priests and Levites
\p \v 1 \w The Levitical|strong="H03881"\w* \w priests|strong="H03548"\w* — \w indeed the whole|strong="H03605"\w* \w tribe|strong="H07626"\w* \w of Levi|strong="H03878"\w* — \w shall have|strong="H01961"\w* \w no|strong="H03808"\w* \w portion|strong="H02506"\w* \w or inheritance|strong="H05159"\w* \w with|strong="H05973"\w* \w Israel|strong="H03478"\w*. \w They are to eat|strong="H00398"\w* \w the food offerings|strong="H00801"\w* \w to the LORD|strong="H03068"\w*; \w that is their inheritance|strong="H05159"\w*. \v 2 \w Although they have|strong="H01961"\w* \w no|strong="H03808"\w* \w inheritance|strong="H05159"\w* \w among|strong="H07130"\w* \w their brothers|strong="H00251"\w*, \w the LORD|strong="H03068"\w* \w . . .|strong="H01931"\w* \w [is] their inheritance|strong="H05159"\w*, \w as|strong="H00834"\w* \w He promised|strong="H01696"\w* them.
\p \v 3 \w This|strong="H02088"\w* \w shall be|strong="H01961"\w* \w the priests’|strong="H03548"\w* \w . . .|strong="H00854"\w* \w share|strong="H04941"\w* \w from the people|strong="H05971"\w* \w . . .|strong="H00854"\w* \w who offer|strong="H02076"\w* \w a sacrifice|strong="H02077"\w*, \w whether|strong="H00518"\w* \w a bull|strong="H07794"\w* \w or|strong="H00518"\w* \w a sheep|strong="H07716"\w*: \w the priests|strong="H03548"\w* \w are to be given|strong="H05414"\w* \w the shoulder|strong="H02220"\w*, \w the jowls|strong="H03895"\w*, \w and the stomach|strong="H06896"\w*. \v 4 \w You are to give|strong="H05414"\w* them \w the firstfruits|strong="H07225"\w* \w of your grain|strong="H01715"\w*, \w new wine|strong="H08492"\w*, \w and oil|strong="H03323"\w*, \w and the first|strong="H07225"\w* \w wool sheared|strong="H01488"\w* \w from your flock|strong="H06629"\w*. \v 5 \w For|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w has chosen|strong="H00977"\w* [Levi] \w and his sons|strong="H01121"\w* \w out of all|strong="H03605"\w* \w your tribes|strong="H07626"\w* \w to stand|strong="H05975"\w* \w and minister|strong="H08334"\w* \w in [His]|strong="H03068"\w* \w . . .|strong="H01931"\w* \w name|strong="H08034"\w* \w for all|strong="H03605"\w* \w time|strong="H03117"\w*.
