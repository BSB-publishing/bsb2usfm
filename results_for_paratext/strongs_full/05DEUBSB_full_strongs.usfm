\p \w Then you are to place [the basket]|strong="H05117"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w and bow down|strong="H07812"\w* \w before|strong="H06440"\w* \w Him|strong="H03068"\w* \w . . .|strong="H00430"\w*. \v 11 \w So you shall rejoice|strong="H08055"\w* — \w you|strong="H00859"\w*, \w the Levite|strong="H03881"\w*, \w and the foreigner dwelling|strong="H01616"\w* \w -|strong="H00834"\w* \w among you|strong="H07130"\w* — \w in all|strong="H03605"\w* \w the good|strong="H02896"\w* \w -|strong="H00834"\w* \w things the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w has given|strong="H05414"\w* to you \w and your household|strong="H01004"\w*.
\p \v 12 \w When|strong="H03588"\w* \w you have finished laying aside|strong="H03615"\w* \w . . .|strong="H06237"\w* \w -|strong="H00853"\w* \w a tenth|strong="H04643"\w* \w of all|strong="H03605"\w* \w your produce|strong="H08393"\w* \w in the third|strong="H07992"\w* \w year|strong="H08141"\w*, \w the year|strong="H08141"\w* \w of the tithe|strong="H04643"\w*, \w you are to give|strong="H05414"\w* \w it to the Levite|strong="H03881"\w*, \w the foreigner|strong="H01616"\w*, \w the fatherless|strong="H03490"\w*, \w and the widow|strong="H00490"\w*, \w that they may eat|strong="H00398"\w* \w and be filled|strong="H07646"\w* \w within your gates|strong="H08179"\w*.
\p \v 13 \w Then you shall declare|strong="H00559"\w* \w in the presence|strong="H06440"\w* \w of the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*, “\w I have removed|strong="H01197"\w* \w from|strong="H04480"\w* \w [my] house|strong="H01004"\w* \w the sacred [portion]|strong="H06944"\w* \w and|strong="H01571"\w* \w have given it|strong="H05414"\w* \w to the Levite|strong="H03881"\w*, \w the foreigner|strong="H01616"\w*, \w the fatherless|strong="H03490"\w*, \w and the widow|strong="H00490"\w*, \w according to all|strong="H03605"\w* \w the commandments|strong="H04687"\w* \w -|strong="H00834"\w* \w You have given me|strong="H06680"\w*. \w I have not|strong="H03808"\w* \w transgressed|strong="H05674"\w* \w or forgotten|strong="H07911"\w* \w Your commandments|strong="H04687"\w* \w . . .|strong="H03808"\w*. \v 14 \w I have not|strong="H03808"\w* \w eaten|strong="H00398"\w* \w any of [the sacred portion]|strong="H04480"\w* \w . . .|strong="H03808"\w* \w while in mourning|strong="H00205"\w*, \w or removed|strong="H01197"\w* \w any of it|strong="H04480"\w* \w while unclean|strong="H02931"\w*, \w . . .|strong="H03808"\w* \w or offered|strong="H05414"\w* \w any of|strong="H04480"\w* \w it for the dead|strong="H04191"\w*. \w I have obeyed|strong="H08085"\w* \w . . .|strong="H06963"\w* \w the LORD|strong="H03068"\w* \w my God|strong="H00430"\w*; \w I have done|strong="H06213"\w* \w everything|strong="H03605"\w* \w -|strong="H00834"\w* \w You commanded me|strong="H06680"\w*. \v 15 \w Look down|strong="H08259"\w* \w from|strong="H04480"\w* \w Your holy|strong="H06944"\w* \w habitation|strong="H04583"\w*, \w from heaven|strong="H08064"\w*, \w and bless|strong="H01288"\w* \w -|strong="H00853"\w* \w Your people|strong="H05971"\w* \w -|strong="H00853"\w* \w Israel|strong="H03478"\w* \w -|strong="H00853"\w* \w and the land|strong="H00127"\w* \w You have given|strong="H05414"\w* us \w -|strong="H00834"\w* \w as|strong="H00834"\w* \w You swore|strong="H07650"\w* \w to our fat