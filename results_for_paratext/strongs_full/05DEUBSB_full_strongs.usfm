\p \v 14 \w Then|strong="H06030"\w* \w the Levites|strong="H03881"\w* \w shall proclaim|strong="H00559"\w* \w in a loud|strong="H07311"\w* \w voice|strong="H06963"\w* \w to|strong="H00413"\w* \w every|strong="H03605"\w* \w Israelite|strong="H00376"\w* \w . . .|strong="H03478"\w*:
