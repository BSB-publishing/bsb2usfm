\c 28
\s1 The Blessings of Obedience
\p \v 1 “\w Now|strong="H01961"\w* \w if|strong="H00518"\w* \w you faithfully obey|strong="H08085"\w* \w . . .|strong="H08085"\w* \w the voice of|strong="H06963"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w and are careful|strong="H08104"\w* \w to follow|strong="H06213"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w His commandments|strong="H04687"\w* \w -|strong="H00834"\w* \w I|strong="H00595"\w* \w am giving you today|strong="H06680"\w* \w . . .|strong="H03117"\w*, \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w . . .|strong="H05945"\w* \w will set you|strong="H05414"\w* \w high above|strong="H05921"\w* \w all|strong="H03605"\w* \w the nations|strong="H01471"\w* \w of the earth|strong="H00776"\w*. \v 2 \w And all|strong="H03605"\w* \w these|strong="H00428"\w* \w blessings|strong="H01293"\w* \w will come|strong="H00935"\w* \w upon you|strong="H05921"\w* \w and overtake you|strong="H05381"\w*, \w if|strong="H03588"\w* \w you will obey|strong="H08085"\w* \w the voice of|strong="H06963"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*:
\b 
\q1 \v 3 \w You|strong="H00859"\w* \w will be blessed|strong="H01288"\w* \w in the city|strong="H05892"\w*
\q2 \w and blessed|strong="H01288"\w* \w . . .|strong="H00859"\w* \w in the country|strong="H07704"\w*.
\b 
\q1 \v 4 \w The fruit of|strong="H06529"\w* \w your womb|strong="H00990"\w* \w will be blessed|strong="H01288"\w*,
\q2 \w as well as the produce|strong="H06529"\w* \w of your land|strong="H00127"\w*
\q1 \w and the offspring|strong="H06529"\w* \w of your livestock|strong="H00929"\w* —
\q2 \w the calves|strong="H07698"\w* \w of your herds|strong="H00504"\w*
\q2 \w and the lambs|strong="H06251"\w* \w of your flocks|strong="H06629"\w*.
\b 
\q1 \v 5 \w Your basket|strong="H02935"\w* \w and kneading bowl|strong="H04863"\w* \w will be blessed|strong="H01288"\w*.
\b 
\q1 \v 6 \w You|strong="H00859"\w* \w will be blessed|strong="H01288"\w* \w when you come in|strong="H00935"\w*
\q2 \w and blessed|strong="H01288"\w* \w when you|strong="H00859"\w* \w go out|strong="H03318"\w*.
\p \v 7 \w The LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w will cause|strong="H05414"\w* \w the enemies|strong="H00341"\w* \w who rise up|strong="H06965"\w* \w against you|strong="H05921"\w* \w to be defeated|strong="H05062"\w* \w before you|strong="H06440"\w*. \w They will march out|strong="H03318"\w* \w against|strong="H00413"\w* \w you in one|strong="H00259"\w* \w direction|strong="H01870"\w* \w but flee|strong="H05127"\w* \w from you|strong="H06440"\w* \w in seven|strong="H07651"\w* \w -|strong="H01870"\w*.
\p \v 8 \w The LORD|strong="H03068"\w* \w -|strong="H00854"\w* \w -|strong="H00853"\w* \w will decree|strong="H06680"\w* \w a blessing|strong="H01293"\w* \w on your barns|strong="H00618"\w* \w and on everything|strong="H03605"\w* \w to which you put|strong="H04916"\w* \w your hand|strong="H03027"\w*; \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w will bless you|strong="H01288"\w* \w in the land|strong="H00776"\w* \w -|strong="H00834"\w* \w He is giving|strong="H05414"\w* you. \v 9 \w The LORD|strong="H03068"\w* \w will establish you|strong="H06965"\w* \w as His holy|strong="H06918"\w* \w people|strong="H05971"\w*, \w just as|strong="H00834"\w* \w He has sworn|strong="H07650"\w* to you, \w if|strong="H03588"\w* \w you keep|strong="H08104"\w* \w -|strong="H00853"\w* \w the commandments|strong="H04687"\w* \w of the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w and walk|strong="H01980"\w* \w in His ways|strong="H01870"\w*. \v 10 \w Then all|strong="H03605"\w* \w the peoples|strong="H05971"\w* \w of the earth|strong="H00776"\w* \w will see|strong="H07200"\w* \w that|strong="H03588"\w* \w you are called|strong="H07121"\w*\w . . .|strong="H05921"\w* \w by the name of|strong="H08034"\w* \w the LORD|strong="H03068"\w*, \w and they will stand in awe|strong="H03372"\w* \w of you|strong="H04480"\w*.
\p \v 11 \w The LORD|strong="H03068"\w* \w will make you prosper|strong="H03498"\w* \w abundantly|strong="H02896"\w* — \w in the fruit of|strong="H06529"\w* \w your womb|strong="H00990"\w*, \w the offspring|strong="H06529"\w* \w of your livestock|strong="H00929"\w*, \w and the produce|strong="H06529"\w* \w of your land|strong="H00127"\w* — \w in|strong="H05921"\w* \w the land|strong="H00127"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w swore|strong="H07650"\w* \w to your fathers|strong="H00001"\w* \w to give|strong="H05414"\w* you.
\p \v 12 \w The LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w will open|strong="H06605"\w* \w the heavens|strong="H08064"\w*, \w His abundant|strong="H02896"\w* \w -|strong="H00853"\w* \w storehouse|strong="H00214"\w*, \w to send|strong="H05414"\w* \w rain|strong="H04306"\w* \w on your land|strong="H00776"\w* \w in season|strong="H06256"\w* \w and to bless|strong="H01288"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the work|strong="H04639"\w* \w of your hands|strong="H03027"\w*. \w You will lend|strong="H03867"\w* \w to many|strong="H07227"\w* \w nations|strong="H01471"\w*, \w but|strong="H00859"\w* \w borrow|strong="H03867"\w* \w from none|strong="H03808"\w*.
\p \v 13 \w The LORD|strong="H03068"\w* \w will make|strong="H05414"\w* \w you the head|strong="H07218"\w* \w and not|strong="H03808"\w* \w the tail|strong="H02180"\w*; \w . . .|strong="H01961"\w* \w you will only|strong="H07535"\w* \w move upward|strong="H04605"\w* \w and never|strong="H03808"\w* \w . . .|strong="H01961"\w* \w downward|strong="H04295"\w*, \w if|strong="H03588"\w* \w you hear|strong="H08085"\w*\w . . .|strong="H00413"\w* \w and carefully|strong="H08104"\w* \w follow|strong="H06213"\w* \w the commandments|strong="H04687"\w* \w of the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*, \w which|strong="H00834"\w* \w I|strong="H00595"\w* \w am giving|strong="H06680"\w* \w you today|strong="H03117"\w*. \v 14 \w Do not|strong="H03808"\w* \w turn aside|strong="H05493"\w* \w to the right|strong="H03225"\w* \w or to the left|strong="H08040"\w* \w from any of|strong="H03605"\w* \w the words|strong="H01697"\w* \w -|strong="H00834"\w* \w I|strong="H00595"\w* \w command|strong="H06680"\w* \w you|strong="H00853"\w* \w today|strong="H03117"\w*, \w and do not go|strong="H01980"\w* \w after|strong="H00310"\w* \w other|strong="H00312"\w* \w gods|strong="H00430"\w* \w to serve them|strong="H05647"\w*.
\s1 The Curses of Disobedience
\p \v 15 \w -|strong="H01961"\w* \w If, however|strong="H00518"\w*, \w you do not|strong="H03808"\w* \w obey|strong="H08085"\w* \w . . .|strong="H06963"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w by carefully|strong="H08104"\w* \w following|strong="H06213"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w His commandments|strong="H04687"\w* \w and statutes|strong="H02708"\w* \w -|strong="H00834"\w* \w I|strong="H00595"\w* \w am giving you today|strong="H06680"\w* \w . . .|strong="H03117"\w*, \w all|strong="H03605"\w* \w these|strong="H00428"\w* \w curses|strong="H07045"\w* \w will come|strong="H00935"\w* \w upon you|strong="H05921"\w* \w and overtake you|strong="H05381"\w*:
\b 
\q1 \v 16 \w You|strong="H00859"\w* \w will be cursed|strong="H00779"\w* \w in the city|strong="H05892"\w*
\q2 \w and cursed|strong="H00779"\w* \w . . .|strong="H00859"\w* \w in the country|strong="H07704"\w*.
\b 
\q1 \v 17 \w Your basket|strong="H02935"\w* \w and kneading bowl|strong="H04863"\w* \w will be cursed|strong="H00779"\w*.
\b 
