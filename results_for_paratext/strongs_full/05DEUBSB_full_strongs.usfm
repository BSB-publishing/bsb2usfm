\q2 \w as well as the produce|strong="H06529"\w* \w of your land|strong="H00127"\w*,
\q1 \w the calves|strong="H07698"\w* \w of your herds|strong="H00504"\w*,
\q2 \w and the lambs|strong="H06251"\w* \w of your flocks|strong="H06629"\w*.
\b 
\q1 \v 19 \w You|strong="H00859"\w* \w will be cursed|strong="H00779"\w* \w when you come in|strong="H00935"\w*
\q2 \w and cursed|strong="H00779"\w* \w when you|strong="H00859"\w* \w go out|strong="H03318"\w*.
\p \v 20 \w The LORD|strong="H03068"\w* \w will send|strong="H07971"\w* \w curses|strong="H03994"\w* \w -|strong="H00853"\w* upon you \w -|strong="H00853"\w*, \w confusion|strong="H04103"\w* \w and|strong="H00853"\w* \w reproof|strong="H04045"\w* \w in all|strong="H03605"\w* \w to which you put|strong="H04916"\w* \w your hand|strong="H03027"\w* \w -|strong="H00834"\w* \w -|strong="H06213"\w*, \w until|strong="H05704"\w* \w you are destroyed|strong="H08045"\w* \w . . .|strong="H05704"\w* \w and quickly|strong="H04118"\w* \w perish|strong="H00006"\w* \w because of|strong="H06440"\w* \w the wickedness|strong="H07455"\w* \w you have committed|strong="H04611"\w* \w -|strong="H00834"\w* \w in forsaking Him|strong="H05800"\w*.\f + \fr 28:20 \ft Hebrew \fqa Me\f*
\p \v 21 \w The LORD|strong="H03068"\w* \w will make the plague|strong="H01698"\w* \w cling|strong="H01692"\w* to you\w . . .|strong="H00853"\w* \w until|strong="H05704"\w* \w He has exterminated|strong="H03615"\w* \w you|strong="H00853"\w* \w from|strong="H05921"\w* \w the land|strong="H00127"\w* \w that|strong="H00834"\w* \w you|strong="H00859"\w* \w are entering|strong="H00935"\w* \w . . .|strong="H08033"\w* \w to possess|strong="H03423"\w*. \v 22 \w The LORD|strong="H03068"\w* \w will strike you|strong="H05221"\w* \w with wasting disease|strong="H07829"\w*, \w with fever|strong="H06920"\w* \w and inflammation|strong="H01816"\w*, \w with scorching heat|strong="H02746"\w* \w and drought|strong="H02719"\w*,\f + \fr 28:22 \ft Or \fqa sword\f* \w and with blight|strong="H07711"\w* \w and mildew|strong="H03420"\w*; \w these will pursue|strong="H07291"\w* \w you until|strong="H05704"\w* \w you perish|strong="H00006"\w*. \v 23 \w The sky|strong="H08064"\w* \w -|strong="H00834"\w* \w over|strong="H05921"\w* \w your head|strong="H07218"\w* \w will be|strong="H01961"\w* \w bronze|strong="H05178"\w*, \w and the earth|strong="H00776"\w* \w -|strong="H00834"\w* \w beneath you|strong="H08478"\w* \w iron|strong="H01270"\w*.
\p \v 24 \w The LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w will turn|strong="H05414"\w* \w the rain|strong="H04306"\w* \w of your land|strong="H00776"\w* \w into dust|strong="H00080"\w* \w and powder|strong="H06083"\w*; \w it will descend|strong="H03381"\w* \w on you|strong="H05921"\w* \w from|strong="H04480"\w* \w the sky|strong="H08064"\w* \w until|strong="H05704"\w* \w you are destroyed|strong="H08045"\w*.
\p \v 25 \w The LORD|strong="H03068"\w* \w will cause|strong="H05414"\w* \w you to be defeated|strong="H05062"\w* \w before|strong="H06440"\w* \w your enemies|strong="H00341"\w*. \w You will march out|strong="H03318"\w* \w against them|strong="H00413"\w* \w in one|strong="H00259"\w* \w direction|strong="H01870"\w* \w but flee|strong="H05127"\w* \w from them|strong="H06440"\w* \w in seven|strong="H07651"\w* \w -|strong="H01870"\w*. \w You will be|strong="H01961"\w* \w an object of horror|strong="H02189"\w* \w to all|strong="H03605"\w* \w the kingdoms|strong="H04467"\w* \w of the earth|strong="H00776"\w*. \v 26 \w Your corpses|strong="H05038"\w* \w will be|strong="H01961"\w* \w food|strong="H03978"\w* \w for all|strong="H03605"\w* \w the birds|strong="H05775"\w* \w of the air|strong="H08064"\w* \w and beasts of|strong="H00929"\w* \w the earth|strong="H00776"\w*, \w with no|strong="H00369"\w* \w one to scare them away|strong="H02729"\w*.
\p \v 27 \w The LORD|strong="H03068"\w* \w will afflict|strong="H05221"\w* \w you with the boils|strong="H07822"\w* \w of Egypt|strong="H04714"\w*, \w with tumors|strong="H06076"\w* \w and scabs|strong="H01618"\w* \w and itch|strong="H02775"\w* \w from which|strong="H00834"\w* \w you cannot|strong="H03808"\w* \w . . .|strong="H03201"\w* \w be cured|strong="H07495"\w*.
\p \v 28 \w The LORD|strong="H03068"\w* \w will afflict|strong="H05221"\w* \w you with madness|strong="H07697"\w*, \w blindness|strong="H05788"\w*, \w and confusion|strong="H08541"\w* \w of mind|strong="H03824"\w*, \v 29 \w and at noon|strong="H06672"\w* \w you will|strong="H01961"\w* \w grope about|strong="H04959"\w* \w like|strong="H00834"\w* \w a blind man|strong="H05787"\w* \w -|strong="H04959"\w* \w in the darkness|strong="H00653"\w*. \w You will not|strong="H03808"\w* \w prosper|strong="H06743"\w* \w -|strong="H00853"\w* \w in your ways|strong="H01870"\w*. \w Day after day|strong="H03605"\w* \w you will be|strong="H01961"\w* \w -|strong="H00389"\w* \w oppressed|strong="H06231"\w* \w and plundered|strong="H01497"\w* \w . . .|strong="H03117"\w*, \w with no one|strong="H00369"\w* \w to save you|strong="H03467"\w*.
\p \v 30 \w You will be pledged in marriage|strong="H00781"\w* \w to a woman|strong="H00802"\w*, \w but another|strong="H00312"\w* \w man|strong="H00376"\w* \w will violate her|strong="H07693"\w*. \w You will build|strong="H01129"\w* \w a house|strong="H01004"\w* \w but will not|strong="H03808"\w* \w live|strong="H03427"\w* in it. \w You will plant|strong="H05193"\w* \w a vineyard|strong="H03754"\w* \w but will not|strong="H03808"\w* \w enjoy its fruit|strong="H02490"\w*. \v 31 \w Your ox|strong="H07794"\w* \w will be slaughtered|strong="H02873"\w* \w before your eyes|strong="H05869"\w*, \w but you will not|strong="H03808"\w* \w eat|strong="H00398"\w* \w any of it|strong="H04480"\w*. \w Your donkey|strong="H02543"\w* \w will be taken away|strong="H01497"\w* \w -|strong="H06440"\w* \w and not|strong="H03808"\w* \w returned|strong="H07725"\w* to you. \w Your flock|strong="H06629"\w* \w will be given|strong="H05414"\w* \w to your enemies|strong="H00341"\w*, \w and no one|strong="H00369"\w* \w will save|strong="H03467"\w* you.
\p \v 32 \w Your sons|strong="H01121"\w* \w and daughters|strong="H01323"\w* \w will be given|strong="H05414"\w* \w to another|strong="H00312"\w* \w nation|strong="H05971"\w*, \w while your eyes|strong="H05869"\w* \w grow weary|strong="H03616"\w* \w looking|strong="H07200"\w* \w for them|strong="H00413"\w* \w vvv|strong="H03605"\w* \w day after day|strong="H03117"\w*, \w with no|strong="H00369"\w* \w power in|strong="H00410"\w* \w your hand|strong="H03027"\w*. \v 33 \w A people|strong="H05971"\w* \w -|strong="H00834"\w* \w you do not|strong="H03808"\w* \w know|strong="H03045"\w* \w will eat|strong="H00398"\w* \w the produce|strong="H06529"\w* \w of your land|strong="H00127"\w* \w and of all|strong="H03605"\w* \w your toil|strong="H03018"\w*. \w All|strong="H03605"\w* \w your days|strong="H03117"\w* \w you will be|strong="H01961"\w* \w -|strong="H07535"\w* \w oppressed|strong="H06231"\w* \w and crushed|strong="H07533"\w*. \v 34 \w You will be|strong="H01961"\w* \w driven mad|strong="H07696"\w* \w by the sights|strong="H04758"\w* \w . . .|strong="H05869"\w* \w -|strong="H00834"\w* \w you see|strong="H07200"\w*.
