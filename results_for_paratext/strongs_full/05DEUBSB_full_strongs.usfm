\s1 The Death of Moses
\p \v 1 \w Then Moses|strong="H04872"\w* \w went up|strong="H05927"\w* \w from the plains|strong="H06160"\w* \w of Moab|strong="H04124"\w* \w to|strong="H00413"\w* \w Mount|strong="H02022"\w* \w Nebo|strong="H05015"\w*, \w to the top|strong="H07218"\w* \w of Pisgah|strong="H06449"\w*, \w which|strong="H00834"\w* \w faces|strong="H05921"\w* \w . . .|strong="H06440"\w* \w Jericho|strong="H03405"\w*. \w And the LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w showed him|strong="H07200"\w* \w the whole|strong="H03605"\w* \w land|strong="H00776"\w* — \w -|strong="H00853"\w* \w from Gilead|strong="H01568"\w* \w as far|strong="H05704"\w* \w as Dan|strong="H01835"\w*, \v 2 \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w of Naphtali|strong="H05321"\w*, \w -|strong="H00853"\w* \w the land|strong="H00776"\w* \w of Ephraim|strong="H00669"\w* \w and Manasseh|strong="H04519"\w*, \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the land|strong="H00776"\w* \w of Judah|strong="H03063"\w* \w as far as|strong="H05704"\w* \w the Western|strong="H00314"\w* \w Sea|strong="H03220"\w*,\f + \fr 34:2 \ft That is, the Mediterranean Sea, also called the Great Sea\f* \v 3 \w -|strong="H00853"\w* \w the Negev|strong="H05045"\w* \w -|strong="H00853"\w*, \w and the region|strong="H03603"\w* \w from the Valley|strong="H01237"\w* \w of Jericho|strong="H03405"\w* (\w the City|strong="H05892"\w* \w of Palms|strong="H08558"\w*) \w all the way|strong="H05704"\w* \w to Zoar|strong="H06820"\w*.
\p \v 4 \w And the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to him|strong="H00413"\w*, “\w This|strong="H02063"\w* \w is the land|strong="H00776"\w* \w that|strong="H00834"\w* \w I swore to give|strong="H07650"\w* \w Abraham|strong="H00085"\w*, \w Isaac|strong="H03327"\w*, \w and Jacob|strong="H03290"\w* \w when I said|strong="H00559"\w*, ‘\w I will give|strong="H05414"\w* \w it to your descendants|strong="H02233"\w*.’ \w I have let you see|strong="H07200"\w* \w it with your own eyes|strong="H05869"\w*, \w . . .|strong="H08033"\w* \w but you will not|strong="H03808"\w* \w cross into it|strong="H05674"\w*.”
\p \v 5 \w So Moses|strong="H04872"\w* \w the servant|strong="H05650"\w* \w of the LORD|strong="H03068"\w* \w died|strong="H04191"\w* \w there|strong="H08033"\w* \w in the land|strong="H00776"\w* \w of Moab|strong="H04124"\w*, \w as|strong="H05921"\w* \w the LORD|strong="H03068"\w* \w had said|strong="H06310"\w*. \v 6 \w And He buried|strong="H06912"\w* \w him|strong="H00853"\w*\f + \fr 34:6 \ft SP and some LXX manuscripts \fqa they buried him\f* \w in a valley|strong="H01516"\w* \w in the land|strong="H00776"\w* \w of Moab|strong="H04124"\w* \w facing|strong="H04136"\w* \w vvv|strong="H01047"\w* \w Beth-peor|strong="H01047"\w*, \w and no|strong="H03808"\w* \w one|strong="H00376"\w* \w -|strong="H00853"\w* \w to|strong="H05704"\w* \w this|strong="H02088"\w* \w day|strong="H03117"\w* \w knows|strong="H03045"\w* \w the location of his grave|strong="H06900"\w*.
\p \v 7 \w Moses [was]|strong="H04872"\w* \w a hundred|strong="H03967"\w* \w and twenty|strong="H06242"\w* \w years old|strong="H01121"\w* \w . . .|strong="H08141"\w* \w when he died|strong="H04191"\w*, \w yet his eyes|strong="H05869"\w* \w were not|strong="H03808"\w* \w weak|strong="H03543"\w*, \w and his vitality|strong="H03893"\w* \w had not|strong="H03808"\w* \w diminished|strong="H05127"\w*. \v 8 \w The Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w -|strong="H00853"\w* \w grieved|strong="H01058"\w* \w for Moses|strong="H04872"\w* \w in the plains|strong="H06160"\w* \w of Moab|strong="H04124"\w* \w thirty|strong="H07970"\w* \w days|strong="H03117"\w*, \w until the time|strong="H03117"\w* \w of weeping|strong="H01065"\w* \w and mourning|strong="H00060"\w* \w for Moses|strong="H04872"\w* \w came to an end|strong="H08552"\w*.
\p \v 9 \w Now Joshua|strong="H03091"\w* \w son|strong="H01121"\w* \w of Nun|strong="H05126"\w* \w was filled|strong="H04392"\w* \w with the spirit|strong="H07307"\w* \w of wisdom|strong="H02451"\w* \w because|strong="H03588"\w* \w Moses|strong="H04872"\w* \w -|strong="H00853"\w* \w had laid|strong="H05564"\w* \w his hands|strong="H03027"\w* \w on him|strong="H05921"\w*. \w So the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w obeyed|strong="H08085"\w* \w him|strong="H00413"\w* \w and did|strong="H06213"\w* \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w had commanded|strong="H06680"\w* \w Moses|strong="H04872"\w*. \v 10 \w Since that time|strong="H05750"\w*, \w no|strong="H03808"\w* \w prophet|strong="H05030"\w* \w has risen|strong="H06965"\w* \w in Israel|strong="H03478"\w* \w like Moses|strong="H04872"\w*, \w whom|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w knew|strong="H03045"\w* \w face|strong="H06440"\w* \w to|strong="H00413"\w* \w face|strong="H06440"\w*— \v 11 \w [no prophet who did] all|strong="H03605"\w* \w the signs|strong="H00226"\w* \w and wonders|strong="H04159"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w sent [Moses]|strong="H07971"\w* \w to do|strong="H06213"\w* \w in the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w* \w to Pharaoh|strong="H06547"\w* \w and to all|strong="H03605"\w* \w his officials|strong="H05650"\w* \w and all|strong="H03605"\w* \w his land|strong="H00776"\w*, \v 12 \w [and no prophet who] performed|strong="H06213"\w* \w all|strong="H03605"\w* \w the mighty|strong="H02389"\w* \w acts of power|strong="H03027"\w* \w and|strong="H03605"\w* \w awesome deeds|strong="H04172"\w* \w . . .|strong="H01419"\w*\f + \fr 34:12 \ft Or \fqa terrifying deeds\f* \w that|strong="H00834"\w* \w Moses [did]|strong="H04872"\w* \w in the sight|strong="H05869"\w* \w of all|strong="H03605"\w* \w Israel|strong="H03478"\w*.
