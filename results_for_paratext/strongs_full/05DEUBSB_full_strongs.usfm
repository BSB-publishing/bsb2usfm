\p \v 28 \w At the end|strong="H07097"\w* \w of every three|strong="H07969"\w* \w years|strong="H08141"\w*, \w bring|strong="H03318"\w* \w -|strong="H00853"\w* \w a tenth|strong="H04643"\w* \w of all|strong="H03605"\w* \w your produce|strong="H08393"\w* \w for that|strong="H01931"\w* \w year|strong="H08141"\w* \w and lay [it] up|strong="H05117"\w* \w within your gates|strong="H08179"\w*. \v 29 \w Then the Levite|strong="H03881"\w* (\w because|strong="H03588"\w* \w he has no|strong="H00369"\w* \w portion|strong="H02506"\w* \w or inheritance|strong="H05159"\w* \w among you|strong="H05973"\w*), \w the foreigner|strong="H01616"\w*, \w the fatherless|strong="H03490"\w*, \w and the widow|strong="H00490"\w* \w -|strong="H00834"\w* \w within your gates|strong="H08179"\w* \w may come|strong="H00935"\w* \w and eat|strong="H00398"\w* \w and be satisfied|strong="H07646"\w*. \w . . .|strong="H04616"\w* \w And the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w will bless|strong="H01288"\w* \w you in all|strong="H03605"\w* \w the work|strong="H04639"\w* \w of your hands|strong="H03027"\w* \w -|strong="H00834"\w* \w -|strong="H06213"\w*.
\c 15
\s1 The Seventh Year
\p \v 1 \w At the end|strong="H07093"\w* \w of every seven|strong="H07651"\w* \w years|strong="H08141"\w* \w vvv|strong="H06213"\w* \w you must cancel debts|strong="H08059"\w*. \v 2 \w This|strong="H02088"\w* \w is the manner|strong="H01697"\w* \w of remission|strong="H08059"\w*: \w Every|strong="H03605"\w* \w creditor|strong="H01167"\w* \w . . .|strong="H04874"\w* \w . . .|strong="H03027"\w* \w shall cancel|strong="H08058"\w* \w what|strong="H00834"\w* \w he has loaned|strong="H05383"\w* \w to his neighbor|strong="H07453"\w*. \w He is not|strong="H03808"\w* \w to collect|strong="H05065"\w* \w anything|strong="H00853"\w* \w from his neighbor|strong="H07453"\w* \w -|strong="H00853"\w* \w or brother|strong="H00251"\w*, \w because|strong="H03588"\w* \w the LORD’s|strong="H03068"\w* \w time of release|strong="H08059"\w* \w has been proclaimed|strong="H07121"\w*. \v 3 \w -|strong="H00853"\w* \w You may collect|strong="H05065"\w* \w something from a foreigner|strong="H05237"\w*, \w but you must forgive|strong="H08058"\w* \w . . .|strong="H03027"\w* \w whatever|strong="H00834"\w* \w your brother|strong="H00251"\w* \w owes|strong="H01961"\w* you \w . . .|strong="H00854"\w*.
