\s1 The Ten Commandments
\p \v 5 \w At that|strong="H01931"\w* \w time|strong="H06256"\w* \w I|strong="H00595"\w* \w was standing|strong="H05975"\w* \w between|strong="H00996"\w* \w the LORD|strong="H03068"\w* \w and you|strong="H00996"\w* \w to declare|strong="H05046"\w* to you \w -|strong="H00853"\w* \w the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w*, \w because|strong="H03588"\w* \w you were afraid|strong="H03372"\w* \w of|strong="H06440"\w* \w the fire|strong="H00784"\w* \w and would not|strong="H03808"\w* \w go up|strong="H05927"\w* \w the mountain|strong="H02022"\w*. \w And He said|strong="H00559"\w*: \v 6 “\w I|strong="H00595"\w* \w am the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*, \w who|strong="H00834"\w* \w brought you out|strong="H03318"\w* \w of the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w*, \w out of the house|strong="H01004"\w* \w of slavery|strong="H05650"\w*.
