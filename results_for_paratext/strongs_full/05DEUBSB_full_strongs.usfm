\s1 Inheritance Rights of the Firstborn
\p \v 15 \w If|strong="H03588"\w* \w a man|strong="H00376"\w* \w has|strong="H01961"\w* \w two|strong="H08147"\w* \w wives|strong="H00802"\w*, \w one|strong="H00259"\w* \w beloved|strong="H00157"\w* \w and the other|strong="H00259"\w* \w unloved|strong="H08130"\w*, \w and [both]|strong="H00157"\w* \w . . .|strong="H08130"\w* \w bear|strong="H03205"\w* him \w sons|strong="H01121"\w*, \w but the unloved|strong="H08146"\w* \w wife has|strong="H01961"\w* \w the firstborn|strong="H01060"\w* \w son|strong="H01121"\w*, \v 16 \w . . .|strong="H01961"\w* \w when|strong="H03117"\w* \w that man|strong="H00834"\w* \w . . .|strong="H01961"\w* \w assigns his inheritance|strong="H05157"\w* \w -|strong="H00853"\w* \w to his sons|strong="H01121"\w* \w -|strong="H00853"\w* \w he must not|strong="H03808"\w* \w appoint|strong="H03201"\w* \w the son|strong="H01121"\w* \w of the beloved wife|strong="H00157"\w* \w as|strong="H05921"\w* \w the firstborn|strong="H06440"\w* \w over|strong="H01121"\w* \w [the son]|strong="H01069"\w* \w -|strong="H00853"\w* \w of the unloved wife|strong="H08130"\w* \w . . .|strong="H01060"\w*.
