\li1 \v 18 \w You shall not|strong="H03808"\w* \w commit adultery|strong="H05003"\w*.\f + \fr 5:18 \ft Cited in Matthew 5:27, Matthew 19:18, Mark 10:19, Luke 18:20, Romans 13:9, and James 2:11\f*
\li1 \v 19 \w You shall not|strong="H03808"\w* \w steal|strong="H01589"\w*.\f + \fr 5:19 \ft Cited in Matthew 19:18, Mark 10:19, Luke 18:20, and Romans 13:9\f*
