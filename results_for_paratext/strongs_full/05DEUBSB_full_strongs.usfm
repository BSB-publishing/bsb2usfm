\s1 The Testimony of Two or Three Witnesses
\p \v 15 \w A lone|strong="H00259"\w* \w witness|strong="H05707"\w* \w is not sufficient|strong="H03808"\w* \w to establish|strong="H06965"\w* \w any|strong="H03605"\w* \w wrongdoing|strong="H05771"\w* \w [or]|strong="H03605"\w* \w sin|strong="H02403"\w* \w against a man|strong="H00376"\w*, \w regardless of what|strong="H03605"\w* \w offense|strong="H02399"\w* \w -|strong="H00834"\w* \w he may have committed|strong="H02398"\w*. \w A matter|strong="H01697"\w* \w must be established|strong="H06965"\w* \w by|strong="H05921"\w* \w the testimony|strong="H06310"\w* \w of two|strong="H08147"\w* \w or|strong="H00176"\w* \w . . .|strong="H05921"\w* \w . . .|strong="H06310"\w* \w three|strong="H07969"\w* \w . . .|strong="H05707"\w* \w witnesses|strong="H05707"\w*.\f + \fr 19:15 \ft Cited in Matthew 18:16 and 2 Corinthians 13:1\f*
\p \v 16 \w If|strong="H03588"\w* \w . . .|strong="H06965"\w* \w a false|strong="H02555"\w* \w witness|strong="H05707"\w* \w testifies|strong="H06030"\w* against \w someone|strong="H00376"\w*, \w accusing him of a crime|strong="H05627"\w*, \v 17 \w both|strong="H08147"\w* \w parties|strong="H00582"\w* \w -|strong="H00834"\w* \w to the dispute|strong="H07379"\w* \w must stand|strong="H05975"\w* \w in the presence|strong="H06440"\w* \w of the LORD|strong="H03068"\w*, \w before|strong="H06440"\w* \w the priests|strong="H03548"\w* \w and judges|strong="H08199"\w* \w who|strong="H00834"\w* \w are [in office]|strong="H01961"\w* \w at that|strong="H01992"\w* \w time|strong="H03117"\w*. \v 18 \w The judges|strong="H08199"\w* \w shall investigate|strong="H01875"\w* \w thoroughly|strong="H03190"\w*, \w and if|strong="H02009"\w* \w the witness|strong="H05707"\w* \w is proven to be a liar|strong="H08267"\w* \w . . .|strong="H05707"\w* \w who has falsely|strong="H08267"\w* \w accused|strong="H06030"\w* \w his brother|strong="H00251"\w*, \v 19 \w you must do|strong="H06213"\w* to him \w as|strong="H00834"\w* \w he intended|strong="H02161"\w* \w to do|strong="H06213"\w* \w to his brother|strong="H00251"\w*. \w So you must purge|strong="H01197"\w* \w the evil|strong="H07451"\w* \w from among you|strong="H07130"\w*.\f + \fr 19:19 \ft Cited in 1 Corinthians 5:13\f* \v 20 \w Then the rest [of the people]|strong="H07604"\w* \w will hear|strong="H08085"\w* \w and be afraid|strong="H03372"\w*, \w and they will never|strong="H03808"\w* \w again|strong="H03254"\w* \w . . .|strong="H05750"\w* \w do|strong="H06213"\w* \w anything|strong="H01697"\w* \w so|strong="H02088"\w* \w evil|strong="H07451"\w* \w among you|strong="H07130"\w*. \v 21 \w You must show no pity|strong="H03808"\w* \w . . .|strong="H02347"\w* \w . . .|strong="H05869"\w*: \w life|strong="H05315"\w* \w for life|strong="H05315"\w*, \w eye|strong="H05869"\w* \w for eye|strong="H05869"\w*, \w tooth|strong="H08127"\w* \w for tooth|strong="H08127"\w*,\f + \fr 19:21 \ft Cited in Matthew 5:38\f* \w hand|strong="H03027"\w* \w for hand|strong="H03027"\w*, \w [and] foot|strong="H07272"\w* \w for foot|strong="H07272"\w*.
\c 20
\s1 Laws of Warfare
\p \v 1 \w When|strong="H03588"\w* \w you go out|strong="H03318"\w* \w to war|strong="H04421"\w* \w against|strong="H05921"\w* \w your enemies|strong="H00341"\w* \w and see|strong="H07200"\w* \w horses|strong="H05483"\w*, \w chariots|strong="H07393"\w*, \w and an army|strong="H05971"\w* \w larger|strong="H07227"\w* \w than yours|strong="H04480"\w*, \w do not|strong="H03808"\w* \w be afraid|strong="H03372"\w* of them; \w for|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*, \w who brought you|strong="H05927"\w* \w out of the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w*, \w is with you|strong="H05973"\w*. \v 2 \w When you are about to|strong="H01961"\w* \w go|strong="H07126"\w* \w into|strong="H00413"\w* \w battle|strong="H04421"\w*, \w the priest|strong="H03548"\w* \w is to come forward|strong="H05066"\w* \w and address|strong="H01696"\w* \w . . .|strong="H00413"\w* \w the army|strong="H05971"\w*, \v 3 \w saying|strong="H00559"\w* \w to them|strong="H00413"\w*, “\w Hear|strong="H08085"\w*, \w O Israel|strong="H03478"\w*, \w today|strong="H03117"\w* \w you|strong="H00859"\w* \w are going|strong="H07131"\w* \w into battle|strong="H04421"\w* \w with|strong="H05921"\w* \w your enemies|strong="H00341"\w*. \w Do not|strong="H00408"\w* \w be fainthearted|strong="H07401"\w* \w . . .|strong="H03824"\w* \w [or]|strong="H00408"\w* \w afraid|strong="H03372"\w*; \w do not|strong="H00408"\w* \w be alarmed|strong="H02648"\w* \w . . .|strong="H00408"\w* \w or terrified|strong="H06206"\w* \w because of them|strong="H06440"\w*. \v 4 \w For|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w goes|strong="H01980"\w* \w with you|strong="H05973"\w* \w to fight|strong="H03898"\w* for you \w against|strong="H05973"\w* \w your enemies|strong="H00341"\w*, \w to give you the victory|strong="H03467"\w* \w -|strong="H00853"\w*.”
\p \v 5 \w Furthermore, the officers|strong="H07860"\w* \w . . .|strong="H00413"\w* \w are to address|strong="H01696"\w* \w the army|strong="H05971"\w*, \w saying|strong="H00559"\w*, “\w Has any|strong="H04310"\w* \w man|strong="H00376"\w* \w -|strong="H00834"\w* \w built|strong="H01129"\w* \w a new|strong="H02319"\w* \w house|strong="H01004"\w* \w and not|strong="H03808"\w* \w dedicated it|strong="H02596"\w*? \w Let him return|strong="H01980"\w* \w . . .|strong="H07725"\w* \w home|strong="H01004"\w*, \w or|strong="H06435"\w* \w he may die|strong="H04191"\w* \w in battle|strong="H04421"\w* \w and another|strong="H00312"\w* \w man|strong="H00376"\w* \w dedicate it|strong="H02596"\w*. \v 6 \w Has any|strong="H04310"\w* \w man|strong="H00376"\w* \w -|strong="H00834"\w* \w planted|strong="H05193"\w* \w a vineyard|strong="H03754"\w* \w and not|strong="H03808"\w* \w begun to enjoy its fruit|strong="H02490"\w*? \w Let him return|strong="H01980"\w* \w . . .|strong="H07725"\w* \w home|strong="H01004"\w*, \w or|strong="H06435"\w* \w he may die|strong="H04191"\w* \w in battle|strong="H04421"\w* \w and another|strong="H00312"\w* \w man|strong="H00376"\w* \w enjoy its fruit|strong="H02490"\w*. \v 7 \w Has any|strong="H04310"\w* \w man|strong="H00376"\w* \w -|strong="H00834"\w* \w become pledged|strong="H00781"\w* \w to a woman|strong="H00802"\w* \w and not|strong="H03808"\w* \w married her|strong="H03947"\w*? \w Let him return|strong="H01980"\w* \w . . .|strong="H07725"\w* \w home|strong="H01004"\w*, \w or|strong="H06435"\w* \w he may die|strong="H04191"\w* \w in battle|strong="H04421"\w* \w and another|strong="H00312"\w* \w man|strong="H00376"\w* \w marry her|strong="H03947"\w*.”
\p \v 8 \w Then the officers|strong="H07860"\w* \w shall speak|strong="H01696"\w* \w further|strong="H03254"\w* \w to|strong="H00413"\w* \w the army|strong="H05971"\w*, \w saying|strong="H00559"\w*, “\w Is any|strong="H04310"\w* \w man|strong="H00376"\w* \w afraid|strong="H03373"\w* \w or fainthearted|strong="H07390"\w* \w . . .|strong="H03824"\w*? \w Let him return|strong="H01980"\w* \w . . .|strong="H07725"\w* \w home|strong="H01004"\w*, \w so that the hearts|strong="H03824"\w* \w of his brothers|strong="H00251"\w* \w will not|strong="H03808"\w* \w melt|strong="H04549"\w* \w like his own|strong="H03824"\w*.” \w -|strong="H00853"\w*
\p \v 9 \w -|strong="H01961"\w* \w When the officers|strong="H07860"\w* \w have finished|strong="H03615"\w* \w addressing|strong="H01696"\w* \w . . .|strong="H00413"\w* \w the army|strong="H05971"\w*, \w they are to appoint|strong="H06485"\w* \w vvv|strong="H06635"\w* \w commanders|strong="H08269"\w* \w to lead it|strong="H07218"\w* \w . . .|strong="H05971"\w*.
\p \v 10 \w When|strong="H03588"\w* \w you approach|strong="H07126"\w* \w . . .|strong="H00413"\w* \w a city|strong="H05892"\w* \w to fight|strong="H03898"\w* \w against it|strong="H05921"\w*, \w you are to make an offer|strong="H07121"\w* \w . . .|strong="H00413"\w* \w of peace|strong="H07965"\w*. \v 11 \w . . .|strong="H01961"\w* \w If|strong="H00518"\w* \w they accept|strong="H06030"\w* \w your offer of peace|strong="H07965"\w* \w and open [their gates]|strong="H06605"\w*, \w -|strong="H01961"\w* \w all|strong="H03605"\w* \w the people|strong="H05971"\w* \w [there]|strong="H04672"\w* \w will become|strong="H01961"\w* \w forced laborers|strong="H04522"\w* \w to serve|strong="H05647"\w* you.
\p \v 12 \w But if|strong="H00518"\w* \w they refuse|strong="H03808"\w* \w to make peace|strong="H07999"\w* \w with you|strong="H05973"\w* \w and wage|strong="H06213"\w* \w war|strong="H04421"\w* \w against you|strong="H05973"\w*, \w lay siege|strong="H06696"\w* \w to [that city]|strong="H05921"\w*. \v 13 \w When the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w has delivered it|strong="H05414"\w* \w into your hand|strong="H03027"\w*, \w you must put|strong="H05221"\w* \w -|strong="H00853"\w* \w every|strong="H03605"\w* \w male|strong="H02138"\w* \w vvv|strong="H06310"\w* \w to the sword|strong="H02719"\w*. \v 14 \w But|strong="H07535"\w* \w the women|strong="H00802"\w*, \w children|strong="H02945"\w*, \w livestock|strong="H00929"\w*, \w and whatever|strong="H03605"\w* \w -|strong="H00834"\w* \w else is|strong="H01961"\w* \w in the city|strong="H05892"\w*— \w all|strong="H03605"\w* \w its spoil|strong="H07998"\w*— \w you may take as plunder|strong="H00962"\w*, \w and you shall use|strong="H00398"\w* \w -|strong="H00853"\w* \w the spoil|strong="H07998"\w* \w of your enemies|strong="H00341"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w gives|strong="H05414"\w* you. \v 15 \w This is how|strong="H03651"\w* \w you are to treat|strong="H06213"\w* \w all|strong="H03605"\w* \w the cities|strong="H05892"\w* \w that are far away|strong="H07350"\w* \w from you|strong="H04480"\w* \w . . .|strong="H03966"\w* \w -|strong="H00834"\w* \w and do not|strong="H03808"\w* \w -|strong="H05892"\w* \w belong to the|strong="H00428"\w* \w . . .|strong="H02007"\w* \w nations nearby|strong="H01471"\w*.
\p \v 16 \w However|strong="H07535"\w*, \w in the cities|strong="H05892"\w* \w of the|strong="H00428"\w* \w nations|strong="H05971"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w is giving|strong="H05414"\w* you \w as an inheritance|strong="H05159"\w*, \w vvv|strong="H03808"\w* \w you must not leave alive|strong="H02421"\w* \w anything|strong="H03605"\w* \w that breathes|strong="H05397"\w*. \v 17 \w For|strong="H03588"\w* \w you must devote them to complete destruction|strong="H02763"\w*\f + \fr 20:17 \ft Forms of the Hebrew \fqa cherem \ft refer to the giving over of things or persons to the LORD, either by destroying them or by giving them as an offering.\f* \w . . .|strong="H02763"\w*— \w the Hittites|strong="H02850"\w*, \w Amorites|strong="H00567"\w*, \w Canaanites|strong="H03669"\w*, \w Perizzites|strong="H06522"\w*, \w Hivites|strong="H02340"\w*, \w and Jebusites|strong="H02983"\w*— \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w has commanded you|strong="H06680"\w*, \v 18 \w so that|strong="H04616"\w* \w -|strong="H00834"\w* \w they cannot|strong="H03808"\w* \w teach|strong="H03925"\w* \w -|strong="H00853"\w* \w you to do|strong="H06213"\w* \w all|strong="H03605"\w* \w the detestable things|strong="H08441"\w* \w -|strong="H00834"\w* \w they do|strong="H06213"\w* \w for their gods|strong="H00430"\w*, \w and so cause you to sin|strong="H02398"\w* \w against the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*.
\p \v 19 \w When|strong="H03588"\w* \w you lay siege|strong="H06696"\w* \w to|strong="H00413"\w* \w a city|strong="H05892"\w* \w for an extended|strong="H07227"\w* \w time|strong="H03117"\w* \w while fighting|strong="H03898"\w* \w against it|strong="H05921"\w* \w to capture it|strong="H08610"\w*, \w you must not|strong="H03808"\w* \w destroy|strong="H07843"\w* \w -|strong="H00853"\w* \w its trees|strong="H06086"\w* \w by putting|strong="H05080"\w* \w an axe|strong="H01631"\w* \w to them|strong="H05921"\w*, \w because|strong="H03588"\w* \w you can eat their fruit|strong="H00398"\w* \w -|strong="H00853"\w* \w -|strong="H04480"\w*. \w You must not|strong="H03808"\w* \w cut them down|strong="H03772"\w*. \w . . .|strong="H03588"\w* \w Are the trees|strong="H06086"\w* \w of the field|strong="H07704"\w* \w human|strong="H00120"\w*, \w vvv|strong="H00935"\w* \w vvv|strong="H06440"\w* \w that you should besiege them|strong="H04692"\w*? \v 20 \w But|strong="H07535"\w* \w you may destroy|strong="H07843"\w* \w the trees|strong="H06086"\w* \w that|strong="H00834"\w* \w you know|strong="H03045"\w* \w . . .|strong="H03588"\w* \w do not|strong="H03808"\w* \w . . .|strong="H06086"\w* \w produce fruit|strong="H03978"\w* \w . . .|strong="H01931"\w* \w -|strong="H00853"\w*. \w [Use them]|strong="H03772"\w* \w to build|strong="H01129"\w* \w siege works|strong="H04692"\w* \w against|strong="H05921"\w* \w the city|strong="H05892"\w* \w that|strong="H00834"\w* \w . . .|strong="H01931"\w* \w is waging|strong="H06213"\w* \w war|strong="H04421"\w* \w against you|strong="H05973"\w*, \w until|strong="H05704"\w* \w it falls|strong="H03381"\w*.
\c 21
\s1 Atonement for an Unsolved Murder
\p \v 1 \w If|strong="H03588"\w* \w [one] is found|strong="H04672"\w* \w slain|strong="H02491"\w*, \w lying|strong="H05307"\w* \w in a field|strong="H07704"\w* \w in the land|strong="H00127"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w is giving|strong="H05414"\w* you \w to possess|strong="H03423"\w*, \w and it is not|strong="H03808"\w* \w known|strong="H03045"\w* \w who|strong="H04310"\w* \w killed him|strong="H05221"\w*, \v 2 \w your elders|strong="H02205"\w* \w and judges|strong="H08199"\w* \w must come out|strong="H03318"\w* \w and measure the distance|strong="H04058"\w* \w from the victim|strong="H02491"\w* \w to|strong="H00413"\w* \w the neighboring|strong="H05439"\w* \w cities|strong="H05892"\w* \w -|strong="H00834"\w*.
\p \v 3 \w Then|strong="H01961"\w* \w the elders|strong="H02205"\w* \w . . .|strong="H05892"\w* \w . . .|strong="H01931"\w* \w of the city|strong="H05892"\w* \w nearest|strong="H07138"\w* \w -|strong="H00413"\w* \w the victim|strong="H02491"\w* \w shall take|strong="H03947"\w* \w a heifer|strong="H05697"\w* \w . . .|strong="H01241"\w* \w that|strong="H00834"\w* \w has never|strong="H03808"\w* \w been yoked|strong="H05923"\w* \w or used for work|strong="H05647"\w*\w . . .|strong="H00834"\w*\w . . .|strong="H03808"\w*\w . . .|strong="H04900"\w*, \v 4 \w bring|strong="H03381"\w* \w -|strong="H02205"\w* \w -|strong="H01931"\w* \w -|strong="H00853"\w* \w -|strong="H05892"\w* \w the heifer|strong="H05697"\w* \w to|strong="H00413"\w* \w a valley|strong="H05158"\w* \w with running water|strong="H00386"\w* \w that|strong="H00834"\w* \w has not|strong="H03808"\w* \w been plowed|strong="H05647"\w* \w -|strong="H03808"\w* \w or sown|strong="H02232"\w*, \w {and break} its|strong="H05697"\w* \w neck|strong="H06202"\w* \w there|strong="H08033"\w* \w -|strong="H00853"\w* \w by the stream|strong="H05158"\w*.
\p \v 5 \w And the priests|strong="H03548"\w*, \w the sons|strong="H01121"\w* \w of Levi|strong="H03878"\w*, \w shall come forward|strong="H05066"\w*, \w for|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w has chosen them|strong="H00977"\w* \w to serve Him|strong="H08334"\w* \w and pronounce blessings|strong="H01288"\w* \w in His|strong="H03068"\w* \w name|strong="H08034"\w* \w and to give a ruling|strong="H05921"\w* \w . . .|strong="H06310"\w* \w . . .|strong="H01961"\w* \w in every|strong="H03605"\w* \w dispute|strong="H07379"\w* \w . . .|strong="H03605"\w* \w and case of assault|strong="H05061"\w*. \v 6 \w Then all|strong="H03605"\w* \w the elders|strong="H02205"\w* \w of the city|strong="H05892"\w* \w . . .|strong="H01931"\w* \w nearest|strong="H07138"\w* \w -|strong="H00413"\w* \w the victim|strong="H02491"\w* \w shall wash|strong="H07364"\w* \w -|strong="H00853"\w* \w their hands|strong="H03027"\w* \w by the stream|strong="H05158"\w* \w over|strong="H05921"\w* \w the heifer|strong="H05697"\w* \w whose neck has been broken|strong="H06202"\w*, \v 7 \w and they shall declare|strong="H06030"\w*, \w . . .|strong="H00559"\w* “\w Our hands|strong="H03027"\w* \w did not|strong="H03808"\w* \w shed|strong="H08210"\w* \w -|strong="H00853"\w* \w this|strong="H02088"\w* \w blood|strong="H01818"\w*, \w nor did|strong="H03808"\w* \w our eyes|strong="H05869"\w* \w see it|strong="H07200"\w*. \v 8 \w Accept this atonement|strong="H03722"\w*, \w O LORD|strong="H03068"\w*, \w for Your people|strong="H05971"\w* \w Israel|strong="H03478"\w* \w whom|strong="H00834"\w* \w You have redeemed|strong="H06299"\w*, \w and do not|strong="H00408"\w* \w hold|strong="H05414"\w* \w the shedding of innocent|strong="H05355"\w* \w blood|strong="H01818"\w* \w against|strong="H07130"\w* \w them|strong="H05971"\w* \w . . .|strong="H03478"\w*.” . . .
\p \w And the bloodshed|strong="H01818"\w* \w will be atoned for|strong="H03722"\w*. \v 9 \w So you|strong="H00859"\w* \w shall purge|strong="H01197"\w* \w from among you|strong="H07130"\w* \w the guilt of shedding innocent|strong="H05355"\w* \w blood|strong="H01818"\w*, \w since|strong="H03588"\w* \w you have done|strong="H06213"\w* \w what is right|strong="H03477"\w* \w in the eyes|strong="H05869"\w* \w of the LORD|strong="H03068"\w*.
\s1 Marrying a Captive Woman
\p \v 10 \w When|strong="H03588"\w* \w you go|strong="H03318"\w* \w to war|strong="H04421"\w* \w against|strong="H05921"\w* \w your enemies|strong="H00341"\w* \w and the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w delivers them|strong="H05414"\w* \w into your hand|strong="H03027"\w* \w and you take them|strong="H07617"\w* \w captive|strong="H07628"\w*, \v 11 \w if you see|strong="H07200"\w* \w a beautiful|strong="H03303"\w* \w . . .|strong="H08389"\w* \w woman|strong="H00802"\w* \w among [them]|strong="H07633"\w*, \w and you desire|strong="H02836"\w* her \w and want to take|strong="H03947"\w* her \w as your wife|strong="H00802"\w*, \v 12 \w then you shall bring her|strong="H00935"\w* \w into|strong="H00413"\w* \w . . .|strong="H08432"\w* \w your house|strong="H01004"\w*. \w She must shave|strong="H01548"\w* \w -|strong="H00853"\w* \w her head|strong="H07218"\w*, \w trim|strong="H06213"\w* \w -|strong="H00853"\w* \w her nails|strong="H06856"\w*, \v 13 \w and put aside|strong="H05493"\w* \w -|strong="H00853"\w* \w the clothing|strong="H08071"\w* \w of her captivity|strong="H07628"\w*.\w . . .|strong="H05921"\w*
