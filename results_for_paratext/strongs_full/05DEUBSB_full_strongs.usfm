\p \v 14 \w Then the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*, “\w Behold|strong="H02005"\w*, \w the time|strong="H03117"\w* \w of your death|strong="H04191"\w* \w is near|strong="H07126"\w*. \w Call|strong="H07121"\w* \w -|strong="H00853"\w* \w Joshua|strong="H03091"\w* \w and present yourselves|strong="H03320"\w* \w at the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*, \w so that I may commission him|strong="H06680"\w*.”
