\s1 The Defeat at Hormah
\p \v 41 “\w We have sinned|strong="H02398"\w* \w against the LORD|strong="H03068"\w*,” \w you replied|strong="H06030"\w* \w . . .|strong="H00559"\w* \w . . .|strong="H00413"\w*. “\w We|strong="H00587"\w* \w will go up|strong="H05927"\w* \w and fight|strong="H03898"\w*, \w as|strong="H03605"\w* \w -|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w our God|strong="H00430"\w* \w has commanded us|strong="H06680"\w*.” \w Then each|strong="H00376"\w* \w -|strong="H00853"\w* \w of you put on|strong="H02296"\w* \w his weapons|strong="H03627"\w* \w of war|strong="H04421"\w*, \w thinking it easy|strong="H01951"\w* \w to go up|strong="H05927"\w* \w into the hill country|strong="H02022"\w*.
\p \v 42 \w But the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to me|strong="H00413"\w*, “\w Tell|strong="H00559"\w* them \w not|strong="H03808"\w* \w to go up|strong="H05927"\w*\w . . .|strong="H03808"\w* \w and fight|strong="H03898"\w*, \w for|strong="H03588"\w* \w I [am] not|strong="H00369"\w* \w with you|strong="H07130"\w* \w to keep you from|strong="H03808"\w* \w defeat|strong="H05062"\w* \w by|strong="H06440"\w* \w your enemies|strong="H00341"\w*.”
\p \v 43 \w So I spoke|strong="H01696"\w* \w to you|strong="H00413"\w*, \w but you would not|strong="H03808"\w* \w listen|strong="H08085"\w*. \w You rebelled against|strong="H04784"\w* \w -|strong="H00853"\w* \w the command|strong="H06310"\w* \w of the LORD|strong="H03068"\w* \w and presumptuously|strong="H02102"\w* \w went up|strong="H05927"\w* \w into the hill country|strong="H02022"\w*.
\p \v 44 \w Then the Amorites|strong="H00567"\w* \w who lived|strong="H03427"\w* \w in|strong="H01931"\w* \w the hills|strong="H02022"\w* \w came out|strong="H03318"\w* \w against you|strong="H07122"\w* \w and chased|strong="H07291"\w* \w -|strong="H00853"\w* \w you like|strong="H00834"\w* \w . . .|strong="H06213"\w* \w a swarm of bees|strong="H01682"\w*. \w They routed|strong="H03807"\w* \w you|strong="H00853"\w* \w from Seir|strong="H08165"\w* \w all the way|strong="H05704"\w* \w to Hormah|strong="H02767"\w*. \v 45 \w And you returned|strong="H07725"\w* \w and wept|strong="H01058"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*, \w but [He]|strong="H03068"\w* \w would not|strong="H03808"\w* \w listen|strong="H08085"\w* \w to your voice|strong="H06963"\w* \w [or]|strong="H03808"\w* \w give ear|strong="H00238"\w* \w to you|strong="H00413"\w*.
\p \v 46 \w For this reason you stayed|strong="H03427"\w* \w in Kadesh|strong="H06946"\w* \w vvv|strong="H03117"\w* \w for a long time|strong="H07227"\w* — \w a very long time|strong="H03117"\w* \w -|strong="H00834"\w* \w -|strong="H03427"\w*.
\c 2
\s1 Wanderings in the Wilderness
\p \v 1 \w Then we turned back|strong="H06437"\w* \w and headed|strong="H05265"\w* \w for the wilderness|strong="H04057"\w* \w by way|strong="H01870"\w* \w of the Red|strong="H05488"\w* \w Sea|strong="H03220"\w*,\f + \fr 2:1 \ft Or \fqa the Sea of Reeds\f* \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w . . .|strong="H00413"\w* \w had instructed me|strong="H01696"\w*, \w and for many|strong="H07227"\w* \w days|strong="H03117"\w* \w we wandered around|strong="H05437"\w* \w -|strong="H00853"\w* \w Mount|strong="H02022"\w* \w Seir|strong="H08165"\w*.
\p \v 2 \w At this time the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to me|strong="H00413"\w* \w . . .|strong="H00559"\w*, \v 3 “\w You have been wandering around|strong="H05437"\w* \w -|strong="H00853"\w* \w this|strong="H02088"\w* \w hill country|strong="H02022"\w* \w long enough|strong="H07227"\w*; \w turn|strong="H06437"\w* \w to the north|strong="H06828"\w* \v 4 \w -|strong="H00853"\w* \w and command|strong="H06680"\w* \w . . .|strong="H00559"\w* \w the people|strong="H05971"\w*: ‘\w You|strong="H00859"\w* \w will pass|strong="H05674"\w* \w through the territory|strong="H01366"\w* \w of your brothers|strong="H00251"\w*, \w the descendants|strong="H01121"\w* \w of Esau|strong="H06215"\w*, \w who live|strong="H03427"\w* \w in Seir|strong="H08165"\w*. \w They will be afraid|strong="H03372"\w* of you, \w so you must be very|strong="H03966"\w* \w careful|strong="H08104"\w*. \v 5 \w Do not|strong="H00408"\w* \w provoke|strong="H01624"\w* them, \w for|strong="H03588"\w* \w I will not|strong="H03808"\w* \w give|strong="H05414"\w* you \w any of their land|strong="H00776"\w*, \w not even|strong="H05704"\w* \w a footprint|strong="H04096"\w* \w . . .|strong="H03709"\w*, \w . . .|strong="H07272"\w* \w because|strong="H03588"\w* \w I have given|strong="H05414"\w* \w -|strong="H00853"\w* \w Mount|strong="H02022"\w* \w Seir|strong="H08165"\w* \w to Esau|strong="H06215"\w* \w as [his] possession|strong="H03425"\w*. \v 6 \w You are to pay|strong="H07666"\w* \w them|strong="H00854"\w* \w in silver|strong="H03701"\w* \w for the food|strong="H00400"\w* \w you eat|strong="H00398"\w* \w and|strong="H01571"\w* \w -|strong="H03739"\w* \w -|strong="H00854"\w* \w -|strong="H03701"\w* \w the water|strong="H04325"\w* \w you drink|strong="H08354"\w*.’”
\p \v 7 \w Indeed|strong="H03588"\w*, \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w has blessed|strong="H01288"\w* \w you in all|strong="H03605"\w* \w the work|strong="H04639"\w* \w of your hands|strong="H03027"\w*. \w He has watched over|strong="H03045"\w* \w your journey|strong="H01980"\w* \w -|strong="H00853"\w* \w through this|strong="H02088"\w* \w vast|strong="H01419"\w* \w wilderness|strong="H04057"\w*. \w The LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w has been with you|strong="H05973"\w* \w these|strong="H02088"\w* \w forty|strong="H00705"\w* \w years|strong="H08141"\w*, \w and you have lacked|strong="H02637"\w* \w nothing|strong="H03808"\w* \w . . .|strong="H01697"\w*.
\p \v 8 \w So we passed by|strong="H05674"\w* \w . . .|strong="H00854"\w* \w our brothers|strong="H00251"\w*, \w the descendants|strong="H01121"\w* \w of Esau|strong="H06215"\w*, \w who live|strong="H03427"\w* \w in Seir|strong="H08165"\w*. \w We turned away|strong="H06437"\w* \w from the Arabah|strong="H06160"\w* \w road|strong="H01870"\w*, \w which comes up from Elath|strong="H00359"\w* \w vvv|strong="H06100"\w* \w and Ezion-geber|strong="H06100"\w*, \w and traveled|strong="H05674"\w* \w along the road|strong="H01870"\w* \w of the Wilderness|strong="H04057"\w* \w of Moab|strong="H04124"\w*. \v 9 \w Then the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to me|strong="H00413"\w*, “\w Do not|strong="H00413"\w* \w harass|strong="H06696"\w* \w -|strong="H00853"\w* \w the Moabites|strong="H04124"\w* \w [or]|strong="H00408"\w* \w provoke|strong="H01624"\w* them \w to war|strong="H04421"\w*, \w for|strong="H03588"\w* \w I will not|strong="H03808"\w* \w give|strong="H05414"\w* you \w any of their land|strong="H00776"\w* \w -|strong="H03425"\w*, \w because|strong="H03588"\w* \w I have given|strong="H05414"\w* \w -|strong="H00853"\w* \w Ar|strong="H06144"\w* \w to the descendants|strong="H01121"\w* \w of Lot|strong="H03876"\w* \w as [their] possession|strong="H03425"\w*.”
\p \v 10 (\w The Emites|strong="H00368"\w* \w used to|strong="H06440"\w* \w live|strong="H03427"\w* there, \w a people|strong="H05971"\w* \w great|strong="H01419"\w* \w and many|strong="H07227"\w*, \w as tall|strong="H07311"\w* \w as the Anakites|strong="H06062"\w*. \v 11 \w Like the Anakites|strong="H06062"\w*, \w they were also|strong="H00637"\w* \w . . .|strong="H01992"\w* \w regarded|strong="H02803"\w* \w as Rephaim|strong="H07497"\w*, \w though the Moabites|strong="H04125"\w* \w called|strong="H07121"\w* them \w Emites|strong="H00368"\w*. \v 12 \w The Horites|strong="H02752"\w* \w used to|strong="H06440"\w* \w live|strong="H03427"\w* \w in Seir|strong="H08165"\w*, \w but the descendants|strong="H01121"\w* \w of Esau|strong="H06215"\w* \w drove them out|strong="H03423"\w*. \w They destroyed [the Horites]|strong="H08045"\w* \w from before them|strong="H06440"\w* \w and settled|strong="H03427"\w* \w in their place|strong="H08478"\w*, \w just as|strong="H00834"\w* \w Israel|strong="H03478"\w* \w did|strong="H06213"\w* \w in the land|strong="H00776"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w gave|strong="H05414"\w* them \w as their possession|strong="H03425"\w*.)
\p \v 13 “\w Now|strong="H06258"\w* \w arise|strong="H06965"\w* \w and cross over|strong="H05674"\w* \w -|strong="H00853"\w* \w the Brook|strong="H05158"\w* \w of Zered|strong="H02218"\w*.”
\p \w So we crossed over|strong="H05674"\w* \w -|strong="H00853"\w* \w the Brook|strong="H05158"\w* \w of Zered|strong="H02218"\w*.
\p \v 14 \w The time|strong="H03117"\w* \w -|strong="H00834"\w* \w we spent traveling|strong="H01980"\w* \w from|strong="H06947"\w* \w Kadesh-barnea|strong="H06947"\w* \w until|strong="H05704"\w* \w -|strong="H00834"\w* \w we crossed over|strong="H05674"\w* \w -|strong="H00853"\w* \w the Brook|strong="H05158"\w* \w of Zered|strong="H02218"\w* \w was thirty-eight|strong="H07970"\w* \w . . .|strong="H08083"\w* \w years|strong="H08141"\w*, \w until|strong="H05704"\w* \w that entire|strong="H03605"\w* \w generation|strong="H01755"\w* \w of fighting|strong="H04421"\w* \w men|strong="H00582"\w* \w had perished|strong="H08552"\w* \w from|strong="H07130"\w* \w the camp|strong="H04264"\w*, \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had sworn|strong="H07650"\w* to them. \v 15 \w Indeed|strong="H01571"\w*, \w the LORD’s|strong="H03068"\w* \w hand|strong="H03027"\w* \w was|strong="H01961"\w* against them, \w to eliminate them|strong="H02000"\w* \w from|strong="H07130"\w* \w the camp|strong="H04264"\w*, \w until|strong="H05704"\w* \w they had all perished|strong="H08552"\w*.
\p \v 16 \w Now|strong="H01961"\w* \w when|strong="H00834"\w* \w . . .|strong="H08552"\w* \w all|strong="H03605"\w* \w the fighting|strong="H04421"\w* \w men|strong="H00582"\w* \w among|strong="H07130"\w* \w the people|strong="H05971"\w* \w had died|strong="H04191"\w*, \v 17 \w the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to me|strong="H00413"\w* \w . . .|strong="H00559"\w*, \v 18 “\w Today|strong="H03117"\w* \w -|strong="H00853"\w* \w you|strong="H00859"\w* \w are going to cross|strong="H05674"\w* \w the border|strong="H01366"\w* \w of Moab|strong="H04124"\w* \w -|strong="H00853"\w* \w at Ar|strong="H06144"\w*. \v 19 \w But when you get close|strong="H07126"\w* \w to|strong="H04136"\w* \w the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w*, \w do not|strong="H00408"\w* \w harass them|strong="H06696"\w* \w . . .|strong="H00408"\w* \w or provoke|strong="H01624"\w* them, \w for|strong="H03588"\w* \w I will not|strong="H03808"\w* \w give|strong="H05414"\w* you \w any of the land|strong="H00776"\w* \w of the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w* \w -|strong="H03425"\w*. \w -|strong="H03588"\w* \w I have given it|strong="H05414"\w* \w to the descendants|strong="H01121"\w* \w of Lot|strong="H03876"\w* \w as [their] possession|strong="H03425"\w*.”
\p \v 20 (\w That too|strong="H00637"\w*\w . . .|strong="H01931"\w* \w was regarded|strong="H02803"\w* \w as the land|strong="H00776"\w* \w of the Rephaim|strong="H07497"\w*, \w [who]|strong="H07497"\w* \w used to live|strong="H03427"\w* there \w . . .|strong="H06440"\w*, \w though the Ammonites|strong="H05984"\w* \w called|strong="H07121"\w* them \w Zamzummites|strong="H02157"\w*. \v 21 \w [They were] a people|strong="H05971"\w* \w great|strong="H01419"\w* \w and many|strong="H07227"\w*, \w as tall|strong="H07311"\w* \w as the Anakites|strong="H06062"\w*. \w But the LORD|strong="H03068"\w* \w destroyed them|strong="H08045"\w* \w from before [the Ammonites]|strong="H06440"\w*, \w who drove them out|strong="H03423"\w* \w and settled|strong="H03427"\w* \w in their place|strong="H08478"\w*, \v 22 \w just as|strong="H00834"\w* \w He had done|strong="H06213"\w* \w for the descendants|strong="H01121"\w* \w of Esau|strong="H06215"\w* \w who lived|strong="H03427"\w* \w in Seir|strong="H08165"\w*, \w when|strong="H00834"\w* \w He destroyed|strong="H08045"\w* \w -|strong="H00853"\w* \w the Horites|strong="H02752"\w* \w from before them|strong="H06440"\w*. \w They drove them out|strong="H03423"\w* \w and have lived|strong="H03427"\w* \w in their place|strong="H08478"\w* \w to|strong="H05704"\w* \w this|strong="H02088"\w* \w day|strong="H03117"\w*. \v 23 \w And the Avvim|strong="H05761"\w*, \w who lived|strong="H03427"\w* \w in villages|strong="H02691"\w* \w as|strong="H05704"\w* \w far as Gaza|strong="H05804"\w*, \w were destroyed by|strong="H08045"\w* \w the Caphtorites|strong="H03732"\w*, \w who came|strong="H03318"\w* \w out of Caphtor|strong="H03731"\w*\f + \fr 2:23 \ft That is, Crete\f* \w and settled|strong="H03427"\w* \w in their place|strong="H08478"\w*.)
\s1 The Defeat of Sihon
\p \v 24 “\w Arise|strong="H06965"\w*, \w set out|strong="H05265"\w*, \w and cross|strong="H05674"\w* \w -|strong="H00853"\w* \w the Arnon|strong="H00769"\w* \w Valley|strong="H05158"\w*. \w See|strong="H07200"\w*, \w I have delivered|strong="H05414"\w* \w into your hand|strong="H03027"\w* \w Sihon|strong="H05511"\w* \w the Amorite|strong="H00567"\w*, \w -|strong="H00853"\w* \w king|strong="H04428"\w* \w of Heshbon|strong="H02809"\w*, \w and his land|strong="H00776"\w*. \w -|strong="H00853"\w* \w Begin|strong="H02490"\w* \w to take possession of it|strong="H03423"\w* \w and engage|strong="H01624"\w* him \w in battle|strong="H04421"\w*. \v 25 \w This very|strong="H02088"\w* \w day|strong="H03117"\w* \w I will begin|strong="H02490"\w* \w to put|strong="H05414"\w* \w the dread|strong="H06343"\w* \w and fear|strong="H03374"\w* \w of you|strong="H05921"\w* \w upon all|strong="H03605"\w* \w vvv|strong="H06440"\w* \w the nations|strong="H05971"\w* \w under|strong="H08478"\w* \w heaven|strong="H08064"\w*. \w -|strong="H00834"\w* \w They will hear|strong="H08085"\w* \w the reports of you|strong="H08088"\w* \w and tremble|strong="H07264"\w* \w in anguish|strong="H02342"\w* \w because of you|strong="H06440"\w*.”
\p \v 26 \w So from the Wilderness|strong="H04057"\w* \w of Kedemoth|strong="H06932"\w* \w I sent|strong="H07971"\w* \w messengers|strong="H04397"\w* \w with an offer|strong="H01697"\w* \w of peace|strong="H07965"\w* \w to|strong="H00413"\w* \w Sihon|strong="H05511"\w* \w king|strong="H04428"\w* \w of Heshbon|strong="H02809"\w*, \w saying|strong="H00559"\w*, \v 27 “\w Let us pass|strong="H05674"\w* \w through your land|strong="H00776"\w*; \w we will stay on the main road|strong="H01870"\w* \w . . .|strong="H01870"\w* \w . . .|strong="H01980"\w*. \w We will not|strong="H03808"\w* \w turn|strong="H05493"\w* \w to the right|strong="H03225"\w* \w or to the left|strong="H08040"\w*. \v 28 \w You can sell us|strong="H07666"\w* \w food|strong="H00400"\w* \w -|strong="H03701"\w* \w to eat|strong="H00398"\w* \w [and]|strong="H05414"\w* \w water|strong="H04325"\w* \w to drink|strong="H08354"\w* \w in exchange for silver|strong="H03701"\w*. \w Only|strong="H07535"\w* \w let us pass through|strong="H05674"\w* \w on foot|strong="H07272"\w*, \v 29 \w just as|strong="H00834"\w* \w the descendants|strong="H01121"\w* \w of Esau|strong="H06215"\w* \w who live|strong="H03427"\w* \w in Seir|strong="H08165"\w* \w and the Moabites|strong="H04125"\w* \w who live|strong="H03427"\w* \w in Ar|strong="H06144"\w* \w did for us|strong="H06213"\w*, \w until|strong="H05704"\w* \w -|strong="H00834"\w* \w we cross|strong="H05674"\w* \w -|strong="H00853"\w* \w the Jordan|strong="H03383"\w* \w into|strong="H00413"\w* \w the land|strong="H00776"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w our God|strong="H00430"\w* \w is giving|strong="H05414"\w* us.”
\p \v 30 \w But Sihon|strong="H05511"\w* \w king|strong="H04428"\w* \w of Heshbon|strong="H02809"\w* \w would|strong="H00014"\w* \w not|strong="H03808"\w* \w let us pass|strong="H05674"\w* through, \w for|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w -|strong="H00853"\w* \w had made his spirit|strong="H07307"\w* \w stubborn|strong="H07185"\w* \w and his heart|strong="H03824"\w* \w obstinate|strong="H00553"\w*, \w -|strong="H00853"\w* \w that|strong="H04616"\w* \w He might deliver him|strong="H05414"\w* \w into your hand|strong="H03027"\w*, \w as is the case|strong="H02088"\w* \w this day|strong="H03117"\w*.
\p \v 31 \w Then the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to me|strong="H00413"\w*, “\w See|strong="H07200"\w*, \w I have begun|strong="H02490"\w* \w to deliver|strong="H05414"\w* \w Sihon|strong="H05511"\w* \w -|strong="H00853"\w* \w and his land|strong="H00776"\w* \w over to you|strong="H06440"\w*. \w Now|strong="H00853"\w* \w begin|strong="H02490"\w* \w to conquer|strong="H03423"\w* \w and possess|strong="H03423"\w* \w -|strong="H00853"\w* \w his land|strong="H00776"\w*.”
\p \v 32 \w So Sihon|strong="H05511"\w* \w -|strong="H01931"\w* \w and his whole|strong="H03605"\w* \w army|strong="H05971"\w* \w came out|strong="H03318"\w* \w for battle|strong="H04421"\w* \w against us|strong="H07122"\w* \w at Jahaz|strong="H03096"\w*. \v 33 \w And the LORD|strong="H03068"\w* \w our God|strong="H00430"\w* \w delivered him over|strong="H05414"\w* \w to us|strong="H06440"\w*, \w and we defeated him|strong="H05221"\w* \w -|strong="H00853"\w* \w -|strong="H00853"\w* \w and his sons|strong="H01121"\w* \w -|strong="H00853"\w* \w and his whole|strong="H03605"\w* \w army|strong="H05971"\w*.
\p \v 34 \w At that|strong="H01931"\w* \w time|strong="H06256"\w* \w we captured|strong="H03920"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w his cities|strong="H05892"\w* \w and devoted to destruction|strong="H02763"\w*\f + \fr 2:34 \ft Forms of the Hebrew \fqa cherem \ft refer to the giving over of things or persons to the LORD, either by destroying them or by giving them as an offering.\f* \w -|strong="H00853"\w* \w the people|strong="H04962"\w* \w of every|strong="H03605"\w* \w city|strong="H05892"\w*, \w including women|strong="H00802"\w* \w and children|strong="H02945"\w*. \w We left|strong="H07604"\w* \w no|strong="H03808"\w* \w survivors|strong="H08300"\w*. \v 35 \w We carried off for ourselves only|strong="H07535"\w*\w . . .|strong="H00962"\w* \w the livestock|strong="H00929"\w* \w and the plunder|strong="H07998"\w* \w from the cities|strong="H05892"\w* \w -|strong="H00834"\w* \w we captured|strong="H03920"\w*.
\p \v 36 \w From Aroer|strong="H06177"\w* \w -|strong="H00834"\w* \w on|strong="H05921"\w* \w the rim|strong="H08193"\w* \w of the Arnon|strong="H00769"\w* \w Valley|strong="H05158"\w*, \w along with the city|strong="H05892"\w* \w -|strong="H00834"\w* \w in the valley|strong="H05158"\w*, \w even as|strong="H05704"\w* \w far as Gilead|strong="H01568"\w*, \w not one|strong="H03808"\w* \w city|strong="H07151"\w* \w [had walls]|strong="H01961"\w* \w -|strong="H00834"\w* \w too high|strong="H07682"\w* \w for us|strong="H04480"\w*. \w -|strong="H00853"\w* \w The LORD|strong="H03068"\w* \w our God|strong="H00430"\w* \w gave|strong="H05414"\w* \w us|strong="H06440"\w* \w all of them|strong="H03605"\w*. \v 37 \w But|strong="H07535"\w* \w . . .|strong="H00413"\w* \w you did not|strong="H03808"\w* \w go near|strong="H07126"\w* \w the land|strong="H00776"\w* \w of the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w*, \w or [the land]|strong="H03605"\w* \w along the banks|strong="H03027"\w* \w of the Jabbok|strong="H02999"\w* \w River|strong="H05158"\w*, \w or the cities|strong="H05892"\w* \w of the hill country|strong="H02022"\w*, \w or any|strong="H03605"\w* \w place that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w our God|strong="H00430"\w* \w had forbidden|strong="H06680"\w*.
\c 3
\s1 The Defeat of Og
\p \v 1 \w Then we turned|strong="H06437"\w* \w and went up|strong="H05927"\w* \w the road|strong="H01870"\w* \w to Bashan|strong="H01316"\w*, \w and Og|strong="H05747"\w* \w king|strong="H04428"\w* \w of Bashan|strong="H01316"\w* \w . . .|strong="H01931"\w* \w and his whole|strong="H03605"\w* \w army|strong="H05971"\w* \w came out|strong="H03318"\w* \w to meet us|strong="H07122"\w* \w in battle|strong="H04421"\w* \w at Edrei|strong="H00154"\w*. \v 2 \w But the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to me|strong="H00413"\w*, “\w Do not|strong="H00408"\w* \w fear him|strong="H03372"\w*, \w -|strong="H00853"\w* \w for|strong="H03588"\w* \w I have delivered|strong="H05414"\w* \w him|strong="H00853"\w* \w into your hand|strong="H03027"\w*, \w along with|strong="H00853"\w* \w all|strong="H03605"\w* \w his people|strong="H05971"\w* \w -|strong="H00853"\w* \w and his land|strong="H00776"\w*. \w Do|strong="H06213"\w* to him \w as|strong="H00834"\w* \w you did|strong="H06213"\w* \w to Sihon|strong="H05511"\w* \w king|strong="H04428"\w* \w of the Amorites|strong="H00567"\w*, \w who|strong="H00834"\w* \w lived|strong="H03427"\w* \w in Heshbon|strong="H02809"\w*.”
\p \v 3 \w So the LORD|strong="H03068"\w* \w our God|strong="H00430"\w* \w also|strong="H01571"\w* \w -|strong="H00853"\w* \w delivered|strong="H05414"\w* \w Og|strong="H05747"\w* \w king|strong="H04428"\w* \w of Bashan|strong="H01316"\w* \w -|strong="H00853"\w* \w and his whole|strong="H03605"\w* \w army|strong="H05971"\w* \w into our hands|strong="H03027"\w*. \w We struck them down|strong="H05221"\w* \w -|strong="H05704"\w* \w until no|strong="H01115"\w* \w survivor|strong="H08300"\w* \w was left|strong="H07604"\w*.
\p \v 4 \w At that|strong="H01931"\w* \w time|strong="H06256"\w* \w we captured|strong="H03920"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w sixty|strong="H08346"\w* \w of his cities|strong="H05892"\w*. \w -|strong="H05892"\w* \w There was not|strong="H03808"\w* \w . . .|strong="H01961"\w* \w a single city|strong="H07151"\w* \w -|strong="H00834"\w* \w we failed to|strong="H03808"\w* \w take|strong="H03947"\w* \w -|strong="H00854"\w* — \w the entire|strong="H03605"\w* \w region|strong="H02256"\w* \w of Argob|strong="H00709"\w*, \w the kingdom|strong="H04467"\w* \w of Og|strong="H05747"\w* \w in Bashan|strong="H01316"\w*. \v 5 \w All|strong="H03605"\w* \w these|strong="H00428"\w* \w cities|strong="H05892"\w* \w were fortified|strong="H01219"\w* \w with high|strong="H01364"\w* \w walls|strong="H02346"\w* \w and gates|strong="H01817"\w* \w and bars|strong="H01280"\w*, \w and there were|strong="H00905"\w* \w . . .|strong="H05892"\w* \w many more|strong="H07235"\w* \w . . .|strong="H03966"\w* \w unwalled villages|strong="H06521"\w*. \v 6 \w We devoted them to destruction|strong="H02763"\w* \w -|strong="H00853"\w*,\f + \fr 3:6 \ft Forms of the Hebrew \fqa cherem \ft refer to the giving over of things or persons to the LORD, either by destroying them or by giving them as an offering.\f* \w as|strong="H00834"\w* \w we had done|strong="H06213"\w* \w to Sihon|strong="H05511"\w* \w king|strong="H04428"\w* \w of Heshbon|strong="H02809"\w*, \w utterly destroying|strong="H02763"\w* \w the men|strong="H04962"\w*, \w women|strong="H00802"\w*, \w and children|strong="H02945"\w* \w of every|strong="H03605"\w* \w city|strong="H05892"\w*.
\p \v 7 \w But all|strong="H03605"\w* \w the livestock|strong="H00929"\w* \w and plunder|strong="H07998"\w* \w of the cities|strong="H05892"\w* \w we carried off|strong="H00962"\w* for ourselves.
\p \v 8 \w At that|strong="H01931"\w* \w -|strong="H00853"\w* \w time|strong="H06256"\w* \w we took|strong="H03947"\w* \w from|strong="H03027"\w* \w the two|strong="H08147"\w* \w kings|strong="H04428"\w* \w of the Amorites|strong="H00567"\w* \w -|strong="H00834"\w* \w the land|strong="H00776"\w* \w across|strong="H05676"\w* \w the Jordan|strong="H03383"\w*, \w from the Arnon|strong="H00769"\w* \w Valley|strong="H05158"\w* \w as|strong="H05704"\w* \w far as Mount|strong="H02022"\w* \w Hermon|strong="H02768"\w* — \v 9 \w which the Sidonians|strong="H06722"\w* \w call|strong="H07121"\w* \w . . .|strong="H02768"\w* \w Sirion|strong="H08303"\w* \w but the Amorites|strong="H00567"\w* \w call|strong="H07121"\w* - \w Senir|strong="H08149"\w* — \v 10 \w all|strong="H03605"\w* \w the cities|strong="H05892"\w* \w of the plateau|strong="H04334"\w*, \w all|strong="H03605"\w* \w of Gilead|strong="H01568"\w*, \w and all|strong="H03605"\w* \w of Bashan|strong="H01316"\w* \w as far as|strong="H05704"\w* \w the cities|strong="H05892"\w* \w of Salecah|strong="H05548"\w* \w and Edrei|strong="H00154"\w* \w in the kingdom|strong="H04467"\w* \w of Og|strong="H05747"\w* \w -|strong="H01316"\w*.
\p \v 11 (\w For|strong="H03588"\w* \w only|strong="H07535"\w* \w Og|strong="H05747"\w* \w king|strong="H04428"\w* \w of Bashan|strong="H01316"\w* \w had remained|strong="H07604"\w* \w of the remnant|strong="H03499"\w* \w of the Rephaim|strong="H07497"\w*. \w . . .|strong="H02009"\w* \w His bed|strong="H06210"\w* \w . . .|strong="H06210"\w* \w of iron|strong="H01270"\w*, \w nine|strong="H08672"\w* \w cubits|strong="H00520"\w* \w long|strong="H00753"\w* \w and four|strong="H00702"\w* \w cubits|strong="H00520"\w* \w wide|strong="H07341"\w* \w -|strong="H00520"\w* \w -|strong="H00376"\w*,\f + \fr 3:11 \ft Og’s bed was approximately 14 feet long and 6 feet wide (4.3 meters long and 1.8 meters wide).\f* \w [is still]|strong="H03808"\w* \w -|strong="H01931"\w* \w in Rabbah|strong="H07237"\w* \w of the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w*.)
\s1 Land Division East of the Jordan
\p \v 12 \w So|strong="H00853"\w* \w at that|strong="H01931"\w* \w time|strong="H06256"\w* \w we took possession of|strong="H03423"\w* \w this|strong="H02063"\w* \w land|strong="H00776"\w*. \w To the Reubenites|strong="H07206"\w* \w and Gadites|strong="H01425"\w* \w I gave|strong="H05414"\w* \w [the land] beyond Aroer|strong="H06177"\w* \w -|strong="H00834"\w* \w along|strong="H05921"\w* \w the Arnon|strong="H00769"\w* \w Valley|strong="H05158"\w*, \w and half|strong="H02677"\w* \w the hill country|strong="H02022"\w* \w of Gilead|strong="H01568"\w*, \w along with its cities|strong="H05892"\w*.
\p \v 13 \w To the half-tribe|strong="H02677"\w* \w . . .|strong="H07626"\w* \w of Manasseh|strong="H04519"\w* \w I gave|strong="H05414"\w* \w the rest|strong="H03499"\w* \w of Gilead|strong="H01568"\w* \w and all|strong="H03605"\w* \w of Bashan|strong="H01316"\w*, \w the kingdom|strong="H04467"\w* \w of Og|strong="H05747"\w*. (\w The entire|strong="H03605"\w* \w region|strong="H02256"\w* \w of Argob|strong="H00709"\w*, \w the whole|strong="H03605"\w* \w territory of Bashan|strong="H01316"\w*, \w . . .|strong="H01931"\w* \w used to be called|strong="H07121"\w* \w the land|strong="H00776"\w* \w of the Rephaim|strong="H07497"\w*.) \v 14 \w Jair|strong="H02971"\w*, \w a descendant|strong="H01121"\w* \w of Manasseh|strong="H04519"\w*, \w took|strong="H03947"\w* \w -|strong="H00853"\w* \w the whole|strong="H03605"\w* \w region|strong="H02256"\w* \w of Argob|strong="H00709"\w* \w as far as|strong="H05704"\w* \w the border|strong="H01366"\w* \w of the Geshurites|strong="H01651"\w* \w and Maacathites|strong="H04602"\w*. \w He renamed|strong="H07121"\w* \w -|strong="H00853"\w* \w Bashan|strong="H01316"\w* \w . . .|strong="H05704"\w* \w after|strong="H05921"\w* \w himself|strong="H08034"\w*, \w vvv|strong="H02334"\w* \w Havvoth-jair|strong="H02334"\w*,\f + \fr 3:14 \ft Or \fqa the villages of Jair\f* \w -|strong="H00853"\w* \w by which [it is called]|strong="H02088"\w* \w to this day|strong="H03117"\w*.
\p \v 15 \w To Machir|strong="H04353"\w* \w I gave|strong="H05414"\w* \w -|strong="H00853"\w* \w Gilead|strong="H01568"\w*, \v 16 \w and to the Reubenites|strong="H07206"\w* \w and Gadites|strong="H01425"\w* \w I gave|strong="H05414"\w* \w the territory from|strong="H04480"\w* \w Gilead|strong="H01568"\w* \w to|strong="H05704"\w* \w the Arnon|strong="H00769"\w* \w Valley|strong="H05158"\w* \w (the middle|strong="H08432"\w* \w of the valley|strong="H05158"\w* \w was the border|strong="H01366"\w*) \w and up to|strong="H05704"\w* \w the Jabbok|strong="H02999"\w* \w River|strong="H05158"\w*, \w the border|strong="H01366"\w* \w of the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w*. \v 17 \w The Jordan [River]|strong="H03383"\w* \w in the Arabah|strong="H06160"\w* \w bordered it|strong="H01366"\w* \w from Chinnereth|strong="H03672"\w* \w to|strong="H05704"\w* \w the Sea|strong="H03220"\w* \w of the Arabah|strong="H06160"\w* \w (the Salt Sea|strong="H03220"\w* \w . . .|strong="H04417"\w*\f + \fr 3:17 \ft That is, the Dead Sea\f*) \w with|strong="H08478"\w* \w the slopes|strong="H00794"\w* \w of Pisgah|strong="H06449"\w* \w to the east|strong="H04217"\w*.
\p \v 18 \w At that|strong="H01931"\w* \w . . .|strong="H00559"\w* \w time|strong="H06256"\w* \w I commanded|strong="H06680"\w* \w you|strong="H00853"\w*: “\w The LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w has given|strong="H05414"\w* you \w -|strong="H00853"\w* \w this|strong="H02063"\w* \w land|strong="H00776"\w* \w to possess|strong="H03423"\w*. \w All [your]|strong="H03605"\w* \w men|strong="H01121"\w* \w of valor|strong="H02428"\w* \w are to cross over|strong="H05674"\w*, \w armed for battle|strong="H02502"\w*, \w ahead of|strong="H06440"\w* \w your brothers|strong="H00251"\w*, \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*. \v 19 \w But|strong="H07535"\w* \w your wives|strong="H00802"\w*, \w your children|strong="H02945"\w*, \w and your livestock|strong="H04735"\w*— \w I know|strong="H03045"\w* \w that|strong="H03588"\w* you have \w much|strong="H07227"\w* \w livestock|strong="H04735"\w*— \w may remain|strong="H03427"\w* \w in the cities|strong="H05892"\w* \w -|strong="H00834"\w* \w I have given|strong="H05414"\w* you, \v 20 \w until|strong="H05704"\w* \w -|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w gives rest|strong="H05117"\w* \w to your brothers|strong="H00251"\w* as He has to you, \w and they|strong="H01992"\w* \w -|strong="H00853"\w* \w too|strong="H01571"\w* \w have taken possession of|strong="H03423"\w* \w the land|strong="H00776"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w is giving|strong="H05414"\w* them \w across|strong="H05676"\w* \w the Jordan|strong="H03383"\w*. \w Then each of you|strong="H00376"\w* \w may return|strong="H07725"\w* \w to the possession|strong="H03425"\w* \w -|strong="H00834"\w* \w I have given|strong="H05414"\w* you.”
\p \v 21 \w And|strong="H00853"\w* \w at that|strong="H01931"\w* \w . . .|strong="H00559"\w* \w time|strong="H06256"\w* \w I commanded|strong="H06680"\w* \w Joshua|strong="H03091"\w*: “\w Your own eyes|strong="H05869"\w* \w have seen|strong="H07200"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w has done|strong="H06213"\w* \w to these|strong="H00428"\w* \w two|strong="H08147"\w* \w kings|strong="H04428"\w*. \w The LORD|strong="H03068"\w* \w will do|strong="H06213"\w* \w the same|strong="H03651"\w* \w to all|strong="H03605"\w* \w the kingdoms|strong="H04467"\w* \w -|strong="H00834"\w* \w you|strong="H00859"\w* \w are about to enter|strong="H05674"\w*. \w . . .|strong="H08033"\w* \v 22 \w Do not|strong="H03808"\w* \w be afraid of them|strong="H03372"\w*, \w for|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w Himself|strong="H01931"\w* \w will fight|strong="H03898"\w* for you.”
\s1 Moses Forbidden to Cross the Jordan
\p \v 23 \w At that|strong="H01931"\w* \w . . .|strong="H00559"\w* \w time|strong="H06256"\w* \w I also pleaded|strong="H02603"\w* \w . . .|strong="H00413"\w* \w with the LORD|strong="H03068"\w*: \v 24 “\w O Lord|strong="H00136"\w* \w GOD|strong="H03069"\w*, \w You|strong="H00859"\w* \w have begun|strong="H02490"\w* \w to show|strong="H07200"\w* \w -|strong="H00853"\w* \w Your greatness|strong="H01433"\w* \w -|strong="H00853"\w* \w and power|strong="H03027"\w* \w . . .|strong="H02389"\w* \w to Your servant|strong="H05650"\w*. \w -|strong="H00853"\w* \w For|strong="H00834"\w* \w what|strong="H04310"\w* \w god|strong="H00410"\w* \w in heaven|strong="H08064"\w* \w or on earth|strong="H00776"\w* \w -|strong="H00834"\w* \w can perform|strong="H06213"\w* \w such works|strong="H04639"\w* \w and mighty acts [as Yours]|strong="H01369"\w*? \v 25 \w Please|strong="H04994"\w* \w let me cross over|strong="H05674"\w* \w and see|strong="H07200"\w* \w -|strong="H00853"\w* \w the good|strong="H02896"\w* \w -|strong="H00834"\w* \w land|strong="H00776"\w* \w beyond|strong="H05676"\w* \w the Jordan|strong="H03383"\w* — \w that|strong="H02088"\w* \w pleasant|strong="H02896"\w* \w hill country|strong="H02022"\w* \w as well as Lebanon|strong="H03844"\w*!”
\p \v 26 \w But the LORD|strong="H03068"\w* \w was angry|strong="H05674"\w* with me \w on account of you|strong="H04616"\w*, \w and He would not|strong="H03808"\w* \w listen|strong="H08085"\w* \w to me|strong="H00413"\w*. “\w That is enough|strong="H07227"\w*,” \w the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to me|strong="H00413"\w*. “\w Do not|strong="H00408"\w* \w speak|strong="H01696"\w* \w to|strong="H00413"\w* \w Me|strong="H03254"\w* \w again|strong="H05750"\w* \w about this|strong="H02088"\w* \w matter|strong="H01697"\w*. \v 27 \w Go|strong="H05927"\w* \w to the top|strong="H07218"\w* \w of Pisgah|strong="H06449"\w* \w and look|strong="H05375"\w* \w . . .|strong="H05869"\w* \w to the west|strong="H03220"\w* \w and north|strong="H06828"\w* \w and south|strong="H08486"\w* \w and east|strong="H04217"\w*. \w See [the land]|strong="H07200"\w* \w with your own eyes|strong="H05869"\w*, \w for|strong="H03588"\w* \w you will not|strong="H03808"\w* \w cross|strong="H05674"\w* \w -|strong="H00853"\w* \w this|strong="H02088"\w* \w Jordan|strong="H03383"\w*. \v 28 \w But commission|strong="H06680"\w* \w -|strong="H00853"\w* \w Joshua|strong="H03091"\w*, \w encourage him|strong="H02388"\w*, \w and strengthen him|strong="H00553"\w*, \w for|strong="H03588"\w* \w he|strong="H01931"\w* \w will cross over|strong="H05674"\w* \w ahead of|strong="H06440"\w* \w the|strong="H02088"\w* \w . . .|strong="H01931"\w* \w people|strong="H05971"\w* \w and enable them to inherit|strong="H05157"\w* \w -|strong="H00853"\w* \w -|strong="H00853"\w* \w the land|strong="H00776"\w* \w that|strong="H00834"\w* \w you will see|strong="H07200"\w*.”
\p \v 29 \w So we stayed|strong="H03427"\w* \w in the valley|strong="H01516"\w* \w opposite|strong="H04136"\w* \w vvv|strong="H01047"\w* \w Beth-peor|strong="H01047"\w*.
\c 4
\s1 An Exhortation to Obedience
\p \v 1 \w Hear|strong="H08085"\w* \w . . .|strong="H00413"\w* \w now|strong="H06258"\w*, \w O Israel|strong="H03478"\w*, \w the statutes|strong="H02706"\w* \w . . .|strong="H00413"\w* \w and ordinances|strong="H04941"\w* \w -|strong="H00834"\w* \w I|strong="H00595"\w* \w am teaching|strong="H03925"\w* \w you|strong="H00853"\w* \w to follow|strong="H06213"\w*, \w so that|strong="H04616"\w* \w you may live|strong="H02421"\w* \w and may enter|strong="H00935"\w* \w and take possession|strong="H03423"\w* \w -|strong="H00853"\w* \w of the land|strong="H00776"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of your fathers|strong="H00001"\w*, \w is giving|strong="H05414"\w* you. \v 2 \w You must not|strong="H03808"\w* \w add|strong="H03254"\w* \w to|strong="H05921"\w* \w . . .|strong="H01697"\w* \w or subtract|strong="H01639"\w* \w from|strong="H04480"\w* \w what|strong="H00834"\w* \w I|strong="H00595"\w* \w command|strong="H06680"\w* \w you|strong="H00853"\w* \w . . .|strong="H03808"\w*, \w so that you may keep|strong="H08104"\w* \w -|strong="H00853"\w* \w the commandments|strong="H04687"\w* \w of the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w that|strong="H00834"\w* \w I|strong="H00595"\w* \w am giving you|strong="H06680"\w* \w -|strong="H00853"\w*.
