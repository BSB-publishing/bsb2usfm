\s1 Moses Intercedes for the People
\p \v 22 \w -|strong="H00853"\w* \w The LORD|strong="H03068"\w* \w spoke|strong="H01696"\w* \w these|strong="H00428"\w* \w commandments|strong="H01697"\w* \w in a loud|strong="H01419"\w* \w voice|strong="H06963"\w* \w to|strong="H00413"\w* \w your whole|strong="H03605"\w* \w assembly|strong="H06951"\w* \w out of|strong="H08432"\w* \w the fire|strong="H00784"\w*, \w the cloud|strong="H06051"\w*, \w and the deep darkness|strong="H06205"\w* \w on the mountain|strong="H02022"\w*; \w He added|strong="H03254"\w* \w nothing more|strong="H03808"\w*. \w And He wrote them|strong="H03789"\w* \w on|strong="H05921"\w* \w two|strong="H08147"\w* \w tablets|strong="H03871"\w* \w of stone|strong="H00068"\w* \w and gave them|strong="H05414"\w* \w to me|strong="H00413"\w*.
\p \v 23 \w -|strong="H01961"\w* \w And when you heard|strong="H08085"\w* \w -|strong="H00853"\w* \w the voice|strong="H06963"\w* \w out of|strong="H08432"\w* \w the darkness|strong="H02822"\w* \w while the mountain|strong="H02022"\w* \w was blazing|strong="H01197"\w* \w with fire|strong="H00784"\w*, \w all|strong="H03605"\w* \w the heads|strong="H07218"\w* \w of your tribes|strong="H07626"\w* \w and your elders|strong="H02205"\w* \w approached|strong="H07126"\w* \w me|strong="H00413"\w*, \v 24 \w and you said|strong="H00559"\w*, “\w Behold|strong="H02005"\w*, \w the LORD|strong="H03068"\w* \w our God|strong="H00430"\w* \w -|strong="H00853"\w* \w has shown us|strong="H07200"\w* \w His glory|strong="H03519"\w* \w -|strong="H00853"\w* \w and greatness|strong="H01433"\w*, \w -|strong="H00853"\w* \w and we have heard|strong="H08085"\w* \w His voice|strong="H06963"\w* \w out of|strong="H08432"\w* \w the fire|strong="H00784"\w*. \w Today|strong="H03117"\w* \w . . .|strong="H02088"\w* \w we have seen|strong="H07200"\w* \w that|strong="H03588"\w* \w a man|strong="H00120"\w* \w can live|strong="H02421"\w* \w [even if] God|strong="H00430"\w* \w speaks|strong="H01696"\w* \w with [him]|strong="H00854"\w*. \v 25 \w But now|strong="H06258"\w*, \w why|strong="H04100"\w* \w should we die|strong="H04191"\w*? \w For|strong="H03588"\w* \w this|strong="H02063"\w* \w great|strong="H01419"\w* \w fire|strong="H00784"\w* \w will consume us|strong="H00398"\w*, \w and we will die|strong="H04191"\w*, \w if|strong="H00518"\w* \w -|strong="H03254"\w* \w we|strong="H00587"\w* \w hear|strong="H08085"\w* \w -|strong="H00853"\w* \w the voice|strong="H06963"\w* \w of the LORD|strong="H03068"\w* \w our God|strong="H00430"\w* \w any longer|strong="H05750"\w*. \v 26 \w For|strong="H03588"\w* \w who|strong="H04310"\w* \w of all|strong="H03605"\w* \w flesh|strong="H01320"\w* \w -|strong="H00834"\w* \w has heard|strong="H08085"\w* \w the voice|strong="H06963"\w* \w of the living|strong="H02416"\w* \w God|strong="H00430"\w* \w speaking|strong="H01696"\w* \w out of|strong="H08432"\w* \w the fire|strong="H00784"\w*, \w as we [have]|strong="H03644"\w*, \w and survived|strong="H02421"\w*? \v 27 \w Go near|strong="H07126"\w*\w . . .|strong="H00859"\w* \w and listen|strong="H08085"\w* \w -|strong="H00853"\w* \w to all|strong="H03605"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w our God|strong="H00430"\w* \w says|strong="H00559"\w*. \w Then you|strong="H00859"\w* \w can tell|strong="H01696"\w* \w . . .|strong="H00413"\w* \w us|strong="H00853"\w* \w everything|strong="H03605"\w* \w -|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w our God|strong="H00430"\w* \w . . .|strong="H00413"\w* \w tells you|strong="H01696"\w*; \w we will listen|strong="H08085"\w* \w and obey|strong="H06213"\w*.”
\p \v 28 \w And the LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w -|strong="H06963"\w* \w heard|strong="H08085"\w* \w the words|strong="H01697"\w* \w you spoke|strong="H01696"\w* \w to me|strong="H00413"\w*, \w and [He]|strong="H03068"\w* \w said|strong="H00559"\w* \w to me|strong="H00413"\w*, “\w I have heard|strong="H08085"\w* \w -|strong="H00853"\w* \w -|strong="H06963"\w* \w the words|strong="H01697"\w* \w that|strong="H00834"\w* \w these|strong="H02088"\w* \w people|strong="H05971"\w* \w have spoken|strong="H01696"\w* \w to you|strong="H00413"\w*. \w They have done well|strong="H03190"\w* \w in all|strong="H03605"\w* \w that|strong="H00834"\w* \w they have spoken|strong="H01696"\w*. \v 29 \w If only|strong="H04310"\w* \w . . .|strong="H05414"\w* \w they had|strong="H01961"\w* \w such|strong="H02088"\w* - \w a heart|strong="H03824"\w* \w to fear|strong="H03372"\w* \w Me|strong="H00853"\w* \w and keep|strong="H08104"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w My commandments|strong="H04687"\w* \w always|strong="H03605"\w* \w . . .|strong="H03117"\w*, \w so that|strong="H04616"\w* \w it might be well|strong="H03190"\w* with them \w and with their children|strong="H01121"\w* \w forever|strong="H05769"\w*. \v 30 \w Go|strong="H01980"\w* \w and tell|strong="H00559"\w* them: ‘\w Return|strong="H07725"\w* to your \w tents|strong="H00168"\w*.’ \v 31 \w But you|strong="H00859"\w* \w stand|strong="H05975"\w* \w here|strong="H06311"\w* \w with Me|strong="H05978"\w*, \w that I may speak|strong="H01696"\w* \w to you|strong="H00413"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the commandments|strong="H04687"\w* \w and statutes|strong="H02706"\w* \w and ordinances|strong="H04941"\w* \w -|strong="H00834"\w* \w you are to teach them|strong="H03925"\w* \w to follow|strong="H06213"\w* \w in the land|strong="H00776"\w* \w that|strong="H00834"\w* \w I|strong="H00595"\w* \w am giving|strong="H05414"\w* them \w to possess|strong="H03423"\w*.”
\p \v 32 \w So be careful|strong="H08104"\w* \w to do|strong="H06213"\w* \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w -|strong="H00853"\w* \w has commanded you|strong="H06680"\w*; \w you are not|strong="H03808"\w* \w to turn aside|strong="H05493"\w* \w to the right|strong="H03225"\w* \w or to the left|strong="H08040"\w*. \v 33 \w You must walk|strong="H01980"\w* \w in all|strong="H03605"\w* \w the ways|strong="H01870"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w -|strong="H00853"\w* \w has commanded you|strong="H06680"\w*, \w so that|strong="H04616"\w* \w you may live|strong="H02421"\w* \w and prosper|strong="H02895"\w* \w and prolong|strong="H00748"\w* \w [your] days|strong="H03117"\w* \w in the land|strong="H00776"\w* \w that|strong="H00834"\w* \w you will possess|strong="H03423"\w*.
\c 6
\s1 The Greatest Commandment
\p \v 1 \w These are|strong="H02063"\w* \w the commandments|strong="H04687"\w* \w and statutes|strong="H02706"\w* \w and ordinances|strong="H04941"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w has instructed me|strong="H06680"\w* \w to teach you|strong="H03925"\w* \w -|strong="H00853"\w* \w to follow|strong="H06213"\w* \w in the land|strong="H00776"\w* \w that|strong="H00834"\w* \w you|strong="H00859"\w* \w are about to enter|strong="H05674"\w* \w . . .|strong="H08033"\w* \w and possess|strong="H03423"\w*, \v 2 \w so that you|strong="H04616"\w* \w and your children|strong="H01121"\w* \w and grandchildren|strong="H01121"\w* \w . . .|strong="H01121"\w* \w may fear|strong="H03372"\w* \w -|strong="H00853"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w all|strong="H03605"\w* \w the days|strong="H03117"\w* \w of your lives|strong="H02416"\w* \w by keeping|strong="H08104"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w His statutes|strong="H02708"\w* \w and commandments|strong="H04687"\w* \w that|strong="H00834"\w* \w I|strong="H00595"\w* \w give|strong="H06680"\w* \w you|strong="H00859"\w*, \w and so that|strong="H04616"\w* \w your days|strong="H03117"\w* \w may be prolonged|strong="H00748"\w*. \v 3 \w Hear|strong="H08085"\w*, \w O Israel|strong="H03478"\w*, \w and be careful|strong="H08104"\w* \w to observe them|strong="H06213"\w*, \w so that|strong="H00834"\w* \w you may prosper|strong="H03190"\w* - \w -|strong="H00834"\w* \w and multiply|strong="H07235"\w* \w greatly|strong="H03966"\w* \w in a land|strong="H00776"\w* \w flowing|strong="H02100"\w* \w with milk|strong="H02461"\w* \w and honey|strong="H01706"\w*, \w just as|strong="H00834"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of your fathers|strong="H00001"\w*, \w has promised|strong="H01696"\w* you.
\p \v 4 \w Hear|strong="H08085"\w*, \w O Israel|strong="H03478"\w*: \w The LORD|strong="H03068"\w* \w our God|strong="H00430"\w*, \w the LORD|strong="H03068"\w* \w is One|strong="H00259"\w*.\f + \fr 6:4 \ft Or \fqa The LORD our God is One LORD \ft or \fqa The LORD is our God, the LORD is One \ft or \fqa The LORD is our God, the LORD alone\ft ; cited in Mark 12:29\f* \v 5 \w And you shall love|strong="H00157"\w* \w -|strong="H00853"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w with all|strong="H03605"\w* \w your heart|strong="H03824"\w* \w and with all|strong="H03605"\w* \w your soul|strong="H05315"\w* \w and with all|strong="H03605"\w* \w your strength|strong="H03966"\w*.\f + \fr 6:5 \ft Cited in Matthew 22:37, Mark 12:30, and Luke 10:27\f*
\p \v 6 \w These|strong="H00428"\w* \w words|strong="H01697"\w* \w -|strong="H00834"\w* \w I|strong="H00595"\w* \w am commanding you|strong="H06680"\w* \w today|strong="H03117"\w* \w are to be|strong="H01961"\w* \w upon|strong="H05921"\w* \w your hearts|strong="H03824"\w*. \v 7 \w And you shall teach them diligently|strong="H08150"\w* \w to your children|strong="H01121"\w* \w and speak|strong="H01696"\w* of them \w when you sit|strong="H03427"\w* \w at home|strong="H01004"\w* \w and when you walk|strong="H01980"\w* \w along the road|strong="H01870"\w*, \w when you lie down|strong="H07901"\w* \w and when you get up|strong="H06965"\w*. \v 8 \w Tie them|strong="H07194"\w* \w as reminders|strong="H00226"\w* \w on|strong="H05921"\w* \w your hands|strong="H03027"\w* \w and bind them|strong="H01961"\w* \w . . .|strong="H02903"\w* \w on your foreheads|strong="H00996"\w* \w . . .|strong="H05869"\w*. \v 9 \w Write them|strong="H03789"\w* \w on|strong="H05921"\w* \w the doorposts|strong="H04201"\w* \w of your houses|strong="H01004"\w* \w and on your gates|strong="H08179"\w*.
\p \v 10 \w -|strong="H01961"\w* \w And when|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w brings|strong="H00935"\w* \w you into|strong="H00413"\w* \w the land|strong="H00776"\w*\w . . .|strong="H00834"\w* \w He swore|strong="H07650"\w* \w to your fathers|strong="H00001"\w*, \w to Abraham|strong="H00085"\w*, \w Isaac|strong="H03327"\w*, \w and Jacob|strong="H03290"\w*, \w that He would give|strong="H05414"\w* you— \w [a land with] great|strong="H01419"\w* \w and splendid|strong="H02896"\w* \w cities|strong="H05892"\w* \w that|strong="H00834"\w* \w you did not|strong="H03808"\w* \w build|strong="H01129"\w*, \v 11 \w with houses|strong="H01004"\w* \w full of|strong="H04392"\w* \w every|strong="H03605"\w* \w good|strong="H02898"\w* \w thing with which|strong="H00834"\w* \w you did not|strong="H03808"\w* \w fill them|strong="H04390"\w*, \w with wells|strong="H00953"\w* \w . . .|strong="H02672"\w* \w that|strong="H00834"\w* \w you did not|strong="H03808"\w* \w dig|strong="H02672"\w*, \w and with vineyards|strong="H03754"\w* \w and olive groves|strong="H02132"\w* \w that|strong="H00834"\w* \w you did not|strong="H03808"\w* \w plant|strong="H05193"\w*— \w and when you eat|strong="H00398"\w* \w and are satisfied|strong="H07646"\w*, \v 12 \w be careful|strong="H08104"\w* \w not|strong="H06435"\w* \w to forget|strong="H07911"\w* \w -|strong="H00853"\w* \w the LORD|strong="H03068"\w* \w who|strong="H00834"\w* \w brought you out|strong="H03318"\w* \w of the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w*, \w out of the house|strong="H01004"\w* \w of slavery|strong="H05650"\w*.
\p \v 13 \w -|strong="H00853"\w* \w Fear|strong="H03372"\w* \w -|strong="H00853"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*, \w serve Him [only]|strong="H05647"\w*, \w and take your oaths|strong="H07650"\w* \w in His name|strong="H08034"\w*.\f + \fr 6:13 \ft Or \fqa serve Him, and take your oaths only in His name\ft ; cited in Matthew 4:10 and Luke 4:8\f* \v 14 \w Do not|strong="H03808"\w* \w follow|strong="H01980"\w* \w . . .|strong="H00310"\w* \w other|strong="H00312"\w* \w gods|strong="H00430"\w*, \w the gods|strong="H00430"\w* \w of the peoples|strong="H05971"\w* \w -|strong="H00834"\w* \w around you|strong="H05439"\w*. \v 15 \w For|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*, \w who is among you|strong="H07130"\w*, \w is a jealous|strong="H07067"\w* \w God|strong="H00410"\w*. \w Otherwise|strong="H06435"\w* \w the anger|strong="H00639"\w* \w of the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w will be kindled|strong="H02734"\w* against you, \w and He will wipe you|strong="H08045"\w* \w off|strong="H05921"\w* \w the face|strong="H06440"\w* \w of the earth|strong="H00127"\w*.
\p \v 16 \w Do not|strong="H03808"\w* \w test|strong="H05254"\w* \w -|strong="H00853"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w as|strong="H00834"\w* \w you tested Him|strong="H05254"\w* \w at Massah|strong="H04532"\w*.\f + \fr 6:16 \fqa Massah \ft means \fqa testing\ft ; see Exodus 17:7; cited in Matthew 4:7 and Luke 4:12.\f* \v 17 \w You are to diligently keep|strong="H08104"\w* \w . . .|strong="H08104"\w* \w -|strong="H00853"\w* \w the commandments|strong="H04687"\w* \w of the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w and the testimonies|strong="H05713"\w* \w and statutes|strong="H02706"\w* \w -|strong="H00834"\w* \w He has given you|strong="H06680"\w*. \v 18 \w Do|strong="H06213"\w* \w what is right|strong="H03477"\w* \w and good|strong="H02896"\w* \w in the sight|strong="H05869"\w* \w of the LORD|strong="H03068"\w*, \w so that|strong="H04616"\w* \w it may be well|strong="H03190"\w* with you \w and that you may enter|strong="H00935"\w* \w and possess|strong="H03423"\w* \w -|strong="H00853"\w* \w the good|strong="H02896"\w* \w land|strong="H00776"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w your God swore|strong="H07650"\w* \w to give your fathers|strong="H00001"\w*, \v 19 \w driving out|strong="H01920"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w your enemies|strong="H00341"\w* \w before you|strong="H06440"\w*, \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w has said|strong="H01696"\w*.
\s1 Teach Your Children
\p \v 20 \w In the future|strong="H04279"\w*, \w when|strong="H03588"\w* \w your son|strong="H01121"\w* \w asks|strong="H07592"\w* \w . . .|strong="H00559"\w*, “\w What|strong="H04100"\w* \w is the meaning of the decrees|strong="H05713"\w* \w and statutes|strong="H02706"\w* \w and ordinances|strong="H04941"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w our God|strong="H00430"\w* \w -|strong="H00853"\w* \w has commanded you|strong="H06680"\w*?” \v 21 \w then you are to tell|strong="H00559"\w* \w him|strong="H01121"\w*, “\w We were|strong="H01961"\w* \w slaves|strong="H05650"\w* \w of Pharaoh|strong="H06547"\w* \w in Egypt|strong="H04714"\w*, \w but the LORD|strong="H03068"\w* \w brought us out|strong="H03318"\w* \w of Egypt|strong="H04714"\w* \w with a mighty|strong="H02389"\w* \w hand|strong="H03027"\w*. \v 22 \w Before our eyes|strong="H05869"\w* \w the LORD|strong="H03068"\w* \w inflicted|strong="H05414"\w* \w great|strong="H01419"\w* \w and devastating|strong="H07451"\w* \w signs|strong="H00226"\w* \w and wonders|strong="H04159"\w* \w on Egypt|strong="H04714"\w*, \w on Pharaoh|strong="H06547"\w*, \w and on all|strong="H03605"\w* \w his household|strong="H01004"\w*. \v 23 \w But He brought|strong="H03318"\w* \w us out|strong="H00853"\w* \w from there|strong="H08033"\w* \w to|strong="H04616"\w* \w lead us in|strong="H00935"\w* \w -|strong="H00853"\w* \w and give|strong="H05414"\w* us \w -|strong="H00853"\w* \w the land|strong="H00776"\w* \w that|strong="H00834"\w* \w He had sworn|strong="H07650"\w* \w to our fathers|strong="H00001"\w*.
\p \v 24 \w And the LORD|strong="H03068"\w* \w commanded us|strong="H06680"\w* \w to observe|strong="H06213"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w these|strong="H00428"\w* \w statutes|strong="H02706"\w* \w and to fear|strong="H03372"\w* \w -|strong="H00853"\w* \w the LORD|strong="H03068"\w* \w our God|strong="H00430"\w*, \w that we may always be prosperous|strong="H02896"\w* . . . \w . . .|strong="H03605"\w* \w . . .|strong="H03117"\w* \w and preserved|strong="H02421"\w*, \w as [we are] to this day|strong="H03117"\w* \w . . .|strong="H02088"\w*. \v 25 \w And if we are careful|strong="H08104"\w* \w to observe|strong="H06213"\w* \w -|strong="H00853"\w* \w every|strong="H03605"\w* \w one of these|strong="H02063"\w* \w commandments|strong="H04687"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w our God|strong="H00430"\w*, \w as|strong="H00834"\w* \w He has commanded us|strong="H06680"\w*, \w then that|strong="H03588"\w* \w will be|strong="H01961"\w* our \w righteousness|strong="H06666"\w*.”
\c 7
\s1 Drive Out the Nations
\p \v 1 \w When|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w brings|strong="H00935"\w* \w you into|strong="H00413"\w* \w the land|strong="H00776"\w* \w that|strong="H00834"\w* \w you|strong="H00859"\w* \w are entering|strong="H00935"\w* \w . . .|strong="H08033"\w* \w to possess|strong="H03423"\w*, \w and He drives out|strong="H05394"\w* \w before you|strong="H06440"\w* \w many|strong="H07227"\w* \w nations|strong="H01471"\w*— \w the Hittites|strong="H02850"\w*, \w Girgashites|strong="H01622"\w*, \w Amorites|strong="H00567"\w*, \w Canaanites|strong="H03669"\w*, \w Perizzites|strong="H06522"\w*, \w Hivites|strong="H02340"\w*, \w and Jebusites|strong="H02983"\w*, \w seven|strong="H07651"\w* \w nations|strong="H01471"\w* \w larger|strong="H07227"\w* \w and stronger|strong="H06099"\w* \w than you|strong="H04480"\w*— \v 2 \w and when the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w has delivered them over|strong="H05414"\w* \w to you|strong="H06440"\w* \w to defeat them|strong="H05221"\w*, \w then you must devote them to complete destruction|strong="H02763"\w* \w . . .|strong="H02763"\w* \w -|strong="H00853"\w*.\f + \fr 7:2 \ft Forms of the Hebrew \fqa cherem \ft refer to the giving over of things or persons to the LORD, either by destroying them or by giving them as an offering; also twice in verse 26.\f* \w Make|strong="H03772"\w* \w no|strong="H03808"\w* \w treaty|strong="H01285"\w*\f + \fr 7:2 \ft Forms of the Hebrew \fqa berit \ft are translated in most passages as \fqa covenant\ft .\f* with them \w and show them no|strong="H03808"\w* \w mercy|strong="H02603"\w*.
\p \v 3 \w Do not|strong="H03808"\w* \w intermarry|strong="H02859"\w* with them. \w Do not|strong="H03808"\w* \w give|strong="H05414"\w* \w your daughters|strong="H01323"\w* \w to their sons|strong="H01121"\w* \w or|strong="H03808"\w* \w take|strong="H03947"\w* \w their daughters|strong="H01323"\w* \w for your sons|strong="H01121"\w*, \v 4 \w because|strong="H03588"\w* \w they will turn your sons|strong="H01121"\w* \w away|strong="H05493"\w* \w -|strong="H00853"\w* \w from following Me|strong="H00310"\w* \w to serve|strong="H05647"\w* \w other|strong="H00312"\w* \w gods|strong="H00430"\w*. \w Then the anger|strong="H00639"\w* \w of the LORD|strong="H03068"\w* \w will burn|strong="H02734"\w* against you, \w and He will swiftly|strong="H04118"\w* \w destroy you|strong="H08045"\w*.
