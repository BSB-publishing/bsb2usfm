\s1 Obey the LORD’s Commands
\p \v 16 \w The LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w commands you|strong="H06680"\w* \w this|strong="H02088"\w* \w day|strong="H03117"\w* \w to follow|strong="H06213"\w* \w -|strong="H00853"\w* \w these|strong="H00428"\w* \w -|strong="H00853"\w* \w statutes|strong="H02706"\w* \w and ordinances|strong="H04941"\w*. \w You must be careful|strong="H08104"\w* \w to follow|strong="H06213"\w* \w them|strong="H00853"\w* \w with all|strong="H03605"\w* \w your heart|strong="H03824"\w* \w and with all|strong="H03605"\w* \w your soul|strong="H05315"\w*.
\p \v 17 \w -|strong="H00853"\w* \w Today|strong="H03117"\w* \w you have proclaimed|strong="H00559"\w* \w that the LORD|strong="H03068"\w* \w is|strong="H01961"\w* your \w God|strong="H00430"\w* \w and that you will walk|strong="H01980"\w* \w in His ways|strong="H01870"\w*, \w keep|strong="H08104"\w* \w His statutes|strong="H02706"\w* \w and commandments|strong="H04687"\w* \w and ordinances|strong="H04941"\w*, \w and listen|strong="H08085"\w* \w to His voice|strong="H06963"\w*.
\p \v 18 \w And today|strong="H03117"\w* \w the LORD|strong="H03068"\w* \w has proclaimed that|strong="H00559"\w* \w you are|strong="H01961"\w* His \w people|strong="H05971"\w* \w [and] treasured possession|strong="H05459"\w* \w as|strong="H00834"\w* \w He promised|strong="H01696"\w*, \w that you are to keep|strong="H08104"\w* \w all|strong="H03605"\w* \w His commandments|strong="H04687"\w*, \v 19 \w that He will set you|strong="H05414"\w* \w high|strong="H05945"\w* \w in praise|strong="H08416"\w* \w and name|strong="H08034"\w* \w and honor|strong="H08597"\w* \w above|strong="H05921"\w* \w all|strong="H03605"\w* \w the nations|strong="H01471"\w* \w -|strong="H00834"\w* \w He has made|strong="H06213"\w*, \w and that you will be|strong="H01961"\w* \w a holy|strong="H06918"\w* \w people|strong="H05971"\w* \w to the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*, \w as|strong="H00834"\w* \w He has promised|strong="H01696"\w*.
\c 27
\s1 The Altar on Mount Ebal
\p \v 1 \w Then Moses|strong="H04872"\w* \w and the elders|strong="H02205"\w* \w of Israel|strong="H03478"\w* \w -|strong="H00853"\w* \w commanded|strong="H06680"\w* \w the people|strong="H05971"\w* \w . . .|strong="H00559"\w*: “\w Keep|strong="H08104"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the commandments|strong="H04687"\w* \w -|strong="H00834"\w* \w I|strong="H00595"\w* \w am giving|strong="H06680"\w* \w you|strong="H00853"\w* \w today|strong="H03117"\w*.
\p \v 2 \w And|strong="H01961"\w* \w on the day|strong="H03117"\w* \w -|strong="H00834"\w* \w you cross|strong="H05674"\w* \w -|strong="H00853"\w* \w the Jordan|strong="H03383"\w* \w into|strong="H00413"\w* \w the land|strong="H00776"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w is giving|strong="H05414"\w* you, \w set up|strong="H06965"\w* \w large|strong="H01419"\w* \w stones|strong="H00068"\w* \w and coat|strong="H07874"\w* \w them|strong="H00853"\w* \w with plaster|strong="H07875"\w*. \v 3 \w Write|strong="H03789"\w* \w on them|strong="H05921"\w* \w all|strong="H03605"\w* \w the words|strong="H01697"\w* \w of this|strong="H02063"\w* \w law|strong="H08451"\w* \w -|strong="H00853"\w* \w when you have crossed over|strong="H05674"\w* \w to|strong="H04616"\w* \w -|strong="H00834"\w* \w enter|strong="H00935"\w* \w . . .|strong="H00413"\w* \w the land|strong="H00776"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w is giving|strong="H05414"\w* you, \w a land|strong="H00776"\w* \w flowing|strong="H02100"\w* \w with milk|strong="H02461"\w* \w and honey|strong="H01706"\w*, \w just as|strong="H00834"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of your fathers|strong="H00001"\w*, \w has promised you|strong="H01696"\w*. \v 4 \w And|strong="H01961"\w* \w when you have crossed|strong="H05674"\w* \w -|strong="H00853"\w* \w the Jordan|strong="H03383"\w*, \w you are to set up|strong="H06965"\w* \w -|strong="H00853"\w* \w these|strong="H00428"\w* \w stones|strong="H00068"\w* \w on Mount|strong="H02022"\w* \w Ebal|strong="H05858"\w*, \w as|strong="H00834"\w* \w I|strong="H00595"\w* \w am commanding you today|strong="H06680"\w* \w -|strong="H00853"\w* \w -|strong="H03117"\w*, \w and you are to coat|strong="H07874"\w* \w them|strong="H00853"\w* \w with plaster|strong="H07875"\w*.
\p \v 5 \w Moreover, you are to build|strong="H01129"\w* \w there|strong="H08033"\w* \w an altar|strong="H04196"\w* \w to the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*, \w an altar of|strong="H04196"\w* \w stones|strong="H00068"\w*. \w You must not|strong="H03808"\w* \w use|strong="H05130"\w* \w any iron tool|strong="H01270"\w* \w on them|strong="H05921"\w*. \v 6 \w You shall build|strong="H01129"\w* \w -|strong="H00853"\w* \w the altar|strong="H04196"\w* \w of the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w with uncut|strong="H08003"\w* \w stones|strong="H00068"\w* \w and offer|strong="H05927"\w* \w upon it|strong="H05921"\w* \w burnt offerings|strong="H05930"\w* \w to the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*. \v 7 \w There|strong="H08033"\w* \w you are to sacrifice|strong="H02076"\w* \w [your] peace offerings|strong="H08002"\w*, \w eating them|strong="H00398"\w* \w and rejoicing|strong="H08055"\w* \w in the presence|strong="H06440"\w* \w of the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*. \v 8 \w And you shall write|strong="H03789"\w* \w distinctly|strong="H00874"\w* \w . . .|strong="H03190"\w* \w upon|strong="H05921"\w* \w these stones|strong="H00068"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the words|strong="H01697"\w* \w of this|strong="H02063"\w* \w law|strong="H08451"\w*.”
