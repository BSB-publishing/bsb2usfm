\li2 \w Shallum|strong="H07967"\w* \w was their chief|strong="H07218"\w*; \v 18 \w -|strong="H05704"\w* \w -|strong="H02008"\w* \w he was previously stationed at the King’s|strong="H04428"\w* \w Gate|strong="H08179"\w* \w on the east side|strong="H04217"\w*. \w These|strong="H01992"\w* \w were the gatekeepers|strong="H07778"\w* \w from the camp|strong="H04264"\w* \w of the Levites|strong="H01121"\w* \w . . .|strong="H03878"\w*. \v 19 \w Shallum|strong="H07967"\w* \w son|strong="H01121"\w* \w of Kore|strong="H06981"\w*, \w the son|strong="H01121"\w* \w of Ebiasaph|strong="H00043"\w*,\f + \fr 9:19 \fqa Ebiasaph \ft is a variant of \fqa Abiasaph\ft ; see Exodus 6:24.\f* \w the son|strong="H01121"\w* \w of Korah|strong="H07141"\w*, \w and his relatives|strong="H00251"\w* \w vvv|strong="H00001"\w* \w vvv|strong="H01004"\w* \w from the Korahites|strong="H07145"\w* \w were assigned to guard|strong="H08104"\w* \w the thresholds|strong="H05592"\w* \w of the Tent|strong="H00168"\w*, \w just as their fathers|strong="H00001"\w* \w . . .|strong="H05921"\w* \w had been assigned to|strong="H05921"\w* \w . . .|strong="H04399"\w* \w . . .|strong="H05656"\w* \w guard|strong="H08104"\w* \w the entrance|strong="H03996"\w* \w to the dwelling|strong="H04264"\w* \w of the LORD|strong="H03068"\w*.
