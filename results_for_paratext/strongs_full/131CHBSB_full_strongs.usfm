\li1 \v 21 \w The sons|strong="H01121"\w* \w of Merari|strong="H04847"\w*: \w Mahli|strong="H04249"\w* \w and Mushi|strong="H04187"\w*.
\li1 \w The sons|strong="H01121"\w* \w of Mahli|strong="H04249"\w*: \w Eleazar|strong="H00499"\w* \w and Kish|strong="H07027"\w*. \v 22 \w Eleazar|strong="H00499"\w* \w died|strong="H04191"\w* \w without|strong="H03808"\w* \w having [any]|strong="H01961"\w* \w sons|strong="H01121"\w*; \w he had only|strong="H03588"\w* \w . . .|strong="H00518"\w* \w daughters|strong="H01323"\w*. \w Their cousins|strong="H00251"\w*, \w the sons|strong="H01121"\w* \w of Kish|strong="H07027"\w*, \w married them|strong="H05375"\w*.
