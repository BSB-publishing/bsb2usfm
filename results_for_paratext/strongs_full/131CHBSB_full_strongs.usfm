\c 28
\s1 David Commissions Solomon
\p \v 1 \w Now David|strong="H01732"\w* \w -|strong="H00853"\w* \w summoned|strong="H06950"\w* \w all|strong="H03605"\w* \w the leaders|strong="H08269"\w* \w of Israel|strong="H03478"\w* \w to|strong="H00413"\w* \w Jerusalem|strong="H03389"\w*: \w the leaders|strong="H08269"\w* \w of the tribes|strong="H07626"\w*, \w the leaders|strong="H08269"\w* \w of the divisions|strong="H04256"\w* \w in the king’s|strong="H04428"\w* \w service|strong="H08334"\w*, \w -|strong="H00853"\w* \w the commanders|strong="H08269"\w* \w of thousands|strong="H00505"\w* \w [and]|strong="H08269"\w* \w of hundreds|strong="H03967"\w*, \w and the officials|strong="H08269"\w* \w in charge of all|strong="H03605"\w* \w the property|strong="H07399"\w* \w and cattle|strong="H04735"\w* \w of the king|strong="H04428"\w* \w and his sons|strong="H01121"\w*, \w along with|strong="H05973"\w* \w the court officials|strong="H05631"\w* \w and mighty men|strong="H01368"\w*— \w every|strong="H03605"\w* \w mighty man|strong="H01368"\w* \w of valor|strong="H02428"\w*.
\p \v 2 \w Then King|strong="H04428"\w* \w David|strong="H01732"\w* \w rose|strong="H06965"\w* \w to|strong="H05921"\w* \w his feet|strong="H07272"\w* \w and said|strong="H00559"\w*, “\w Listen to me|strong="H08085"\w*, \w my brothers|strong="H00251"\w* \w and my people|strong="H05971"\w*. \w . . .|strong="H00589"\w* \w It was in|strong="H05973"\w* \w my heart|strong="H03824"\w* \w to build|strong="H01129"\w* \w a house|strong="H01004"\w* \w as a resting place|strong="H04496"\w* \w for the ark|strong="H00727"\w* \w of the covenant|strong="H01285"\w* \w of the LORD|strong="H03068"\w* \w and as a footstool|strong="H01916"\w* \w . . .|strong="H07272"\w* \w for our God|strong="H00430"\w*. \w I had made preparations|strong="H03559"\w* \w to build it|strong="H01129"\w*, \v 3 \w but God|strong="H00430"\w* \w said|strong="H00559"\w* to me, ‘\w You are not|strong="H03808"\w* \w to build|strong="H01129"\w* \w a house|strong="H01004"\w* \w for My Name|strong="H08034"\w*, \w because|strong="H03588"\w* \w you|strong="H00859"\w* \w are a man|strong="H00376"\w* \w of war|strong="H04421"\w* \w who has shed|strong="H08210"\w* \w blood|strong="H01818"\w*.’
\p \v 4 \w Yet the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w chose|strong="H00977"\w* me \w out of all|strong="H03605"\w* \w my father’s|strong="H00001"\w* \w house|strong="H01004"\w* \w to be|strong="H01961"\w* \w king|strong="H04428"\w* \w over|strong="H05921"\w* \w Israel|strong="H03478"\w* \w forever|strong="H05769"\w*. \w For|strong="H03588"\w* \w He chose|strong="H00977"\w* \w Judah|strong="H03063"\w* \w as leader|strong="H05057"\w*, \w and from the house|strong="H01004"\w* \w of Judah|strong="H03063"\w* \w [He chose] my father’s|strong="H00001"\w* \w household|strong="H01004"\w*, \w and from my father’s|strong="H00001"\w* . . . \w sons|strong="H01121"\w* \w He was pleased|strong="H07521"\w* \w to make me king|strong="H04427"\w* \w over|strong="H05921"\w* \w all|strong="H03605"\w* \w Israel|strong="H03478"\w*. \v 5 \w And of all|strong="H03605"\w* \w my sons|strong="H01121"\w*— \w for|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w has given|strong="H05414"\w* me \w many|strong="H07227"\w* \w sons|strong="H01121"\w*— \w He has chosen|strong="H00977"\w* \w Solomon|strong="H08010"\w* \w my son|strong="H01121"\w* \w to sit|strong="H03427"\w* \w on|strong="H05921"\w* \w the throne|strong="H03678"\w* \w of the kingdom|strong="H04438"\w* \w of the LORD|strong="H03068"\w* \w over|strong="H05921"\w* \w Israel|strong="H03478"\w*. \v 6 \w And He said|strong="H00559"\w* to me, ‘\w Solomon|strong="H08010"\w* \w your son|strong="H01121"\w* \w is the one|strong="H01931"\w* \w who will build|strong="H01129"\w* \w My house|strong="H01004"\w* \w and My courts|strong="H02691"\w*, \w for|strong="H03588"\w* \w I have chosen him|strong="H00977"\w* [as] My \w son|strong="H01121"\w*, \w and I|strong="H00589"\w* \w will be|strong="H01961"\w* his \w Father|strong="H00001"\w*. \v 7 \w I will establish|strong="H03559"\w* \w -|strong="H00853"\w* \w his kingdom|strong="H04438"\w* \w forever|strong="H05704"\w* \w . . .|strong="H05769"\w*, \w if|strong="H00518"\w* \w he resolutely|strong="H02388"\w* \w carries out|strong="H06213"\w* \w My commandments|strong="H04687"\w* \w and ordinances|strong="H04941"\w*, \w as is being done|strong="H03117"\w* \w this day|strong="H02088"\w*.’
\p \v 8 \w So now|strong="H06258"\w* \w in the sight|strong="H05869"\w* \w of all|strong="H03605"\w* \w Israel|strong="H03478"\w*, \w the assembly|strong="H06951"\w* \w of the LORD|strong="H03068"\w*, \w and in the hearing|strong="H00241"\w* \w of our God|strong="H00430"\w*, \w keep|strong="H08104"\w* \w and seek out|strong="H01875"\w* \w all|strong="H03605"\w* \w the commandments|strong="H04687"\w* \w of the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*, \w so that|strong="H04616"\w* \w you may possess|strong="H03423"\w* \w -|strong="H00853"\w* \w this good|strong="H02896"\w* \w land|strong="H00776"\w* \w and leave it as an inheritance|strong="H05157"\w* \w to your descendants|strong="H01121"\w* \w . . .|strong="H00310"\w* \w forever|strong="H05704"\w* \w . . .|strong="H05769"\w*. \v 9 \w As for you|strong="H00859"\w*, \w Solomon|strong="H08010"\w* \w my son|strong="H01121"\w*, \w know|strong="H03045"\w* \w -|strong="H00853"\w* \w the God|strong="H00430"\w* \w of your father|strong="H00001"\w* \w and serve Him|strong="H05647"\w* \w wholeheartedly|strong="H03820"\w* \w . . .|strong="H08003"\w* \w and with a willing|strong="H02655"\w* \w mind|strong="H05315"\w*, \w for|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w searches|strong="H01875"\w* \w every|strong="H03605"\w* \w heart|strong="H03824"\w* \w and understands|strong="H00995"\w* \w the intent|strong="H03336"\w* \w of every|strong="H03605"\w* \w thought|strong="H04284"\w*. \w If|strong="H00518"\w* \w you seek Him|strong="H01875"\w*, \w He will be found|strong="H04672"\w* by you; \w but if|strong="H00518"\w* \w you forsake Him|strong="H05800"\w*, \w He will reject you|strong="H02186"\w* \w forever|strong="H05703"\w*. \v 10 \w Consider|strong="H07200"\w* \w now|strong="H06258"\w* \w that|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w has chosen|strong="H00977"\w* you \w to build|strong="H01129"\w* \w a house|strong="H01004"\w* \w for the sanctuary|strong="H04720"\w*. \w Be strong|strong="H02388"\w* \w and do it|strong="H06213"\w*.”
\s1 The Plans for the Temple
