\p \v 23 \w So they|strong="H01992"\w* \w and their descendants|strong="H01121"\w* \w were assigned to|strong="H05921"\w* \w guard|strong="H04931"\w* \w the gates|strong="H08179"\w* \w of the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w* — \w the house|strong="H01004"\w* \w called the Tent|strong="H00168"\w*. \v 24 \w The gatekeepers|strong="H07778"\w* \w were stationed|strong="H01961"\w* \w on the four|strong="H00702"\w* \w sides|strong="H07307"\w*: \w east|strong="H04217"\w*, \w west|strong="H03220"\w*, \w north|strong="H06828"\w*, \w and south|strong="H05045"\w*. \v 25 \w Their relatives|strong="H00251"\w* \w came|strong="H00935"\w* \w from their villages|strong="H02691"\w* \w at fixed times|strong="H06256"\w* \w . . .|strong="H00413"\w* \w . . .|strong="H06256"\w* \w to serve with|strong="H05973"\w* \w them|strong="H00428"\w* \w for seven-day periods|strong="H07651"\w* \w . . .|strong="H03117"\w*. \v 26 \w But|strong="H03588"\w* \w . . .|strong="H00530"\w* \w the four|strong="H00702"\w* \w chief|strong="H01368"\w* \w gatekeepers|strong="H07778"\w*, \w . . .|strong="H01992"\w* \w who|strong="H01992"\w* \w were Levites|strong="H03881"\w*, \w were|strong="H01961"\w* \w entrusted with|strong="H05921"\w* \w the rooms|strong="H03957"\w* \w . . .|strong="H05921"\w* \w and the treasuries|strong="H00214"\w* \w of the house|strong="H01004"\w* \w of God|strong="H00430"\w*. \v 27 \w They would spend the night|strong="H03885"\w* \w stationed around|strong="H05439"\w* \w the house|strong="H01004"\w* \w of God|strong="H00430"\w*, \w because|strong="H03588"\w* \w they|strong="H05921"\w* \w were responsible for guarding it|strong="H04931"\w* \w . . .|strong="H01992"\w* \w . . .|strong="H05921"\w* \w and opening it|strong="H04668"\w* \w every morning|strong="H01242"\w* \w . . .|strong="H01242"\w*.
\p \v 28 Some of them \w were in charge of|strong="H05921"\w* \w the articles|strong="H03627"\w* \w used in worship|strong="H05656"\w*, \w to|strong="H03588"\w* \w count them|strong="H04557"\w* \w whenever they were brought in|strong="H00935"\w* \w . . .|strong="H04557"\w* \w [or] taken out|strong="H03318"\w*. \v 29 - \w Others were put|strong="H04487"\w* \w in charge of|strong="H05921"\w* \w the furnishings|strong="H03627"\w* \w . . .|strong="H05921"\w* \w and other|strong="H03605"\w* \w articles|strong="H03627"\w* \w of the sanctuary|strong="H06944"\w*, \w . . .|strong="H05921"\w* \w as well as the fine flour|strong="H05560"\w*, \w wine|strong="H03196"\w*, \w oil|strong="H08081"\w*, \w frankincense|strong="H03828"\w*, \w and spices|strong="H01314"\w*. \v 30 \w And [some]|strong="H04480"\w* \w of the sons|strong="H01121"\w* \w of the priests|strong="H03548"\w* \w mixed|strong="H07543"\w* \w . . .|strong="H04842"\w* \w the spices|strong="H01314"\w*.
\p \v 31 \w A Levite|strong="H03881"\w* \w . . .|strong="H01931"\w* \w named Mattithiah|strong="H04993"\w*, \w . . .|strong="H04480"\w* \w the firstborn son|strong="H01060"\w* \w of Shallum|strong="H07967"\w* \w the Korahite|strong="H07145"\w*, \w was entrusted|strong="H00530"\w* \w with|strong="H05921"\w* \w baking|strong="H04639"\w* \w the bread|strong="H02281"\w*. \v 32 \w Some of|strong="H04480"\w* \w their Kohathite|strong="H01121"\w* \w . . .|strong="H06956"\w* \w . . .|strong="H04480"\w* \w relatives|strong="H00251"\w* \w were responsible for|strong="H05921"\w* \w preparing|strong="H03559"\w* \w the rows|strong="H04635"\w* \w of the showbread|strong="H03899"\w* \w every Sabbath|strong="H07676"\w* \w . . .|strong="H07676"\w*.
