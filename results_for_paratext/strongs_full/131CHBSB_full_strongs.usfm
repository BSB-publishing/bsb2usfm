\li2 \w Ephah|strong="H05891"\w*, \w Epher|strong="H06081"\w*, \w Hanoch|strong="H02585"\w*, \w Abida|strong="H00028"\w*, \w and Eldaah|strong="H00420"\w*.
\li2 \w All|strong="H03605"\w* \w of these|strong="H00428"\w* \w were Keturah’s|strong="H06989"\w* \w sons|strong="H01121"\w*.
\b 
\li1 \v 34 \w Abraham|strong="H00085"\w* \w -|strong="H00853"\w* \w was the father of|strong="H03205"\w* \w Isaac|strong="H03327"\w*. \w The sons|strong="H01121"\w* \w of Isaac|strong="H03327"\w*:
\li2 \w Esau|strong="H06215"\w* \w and Israel|strong="H03478"\w*.
