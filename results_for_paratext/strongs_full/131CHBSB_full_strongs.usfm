\s1 Levite Duties Revised
\p \v 24 \w These|strong="H00428"\w* \w were the descendants|strong="H01121"\w* \w of Levi|strong="H03878"\w* \w by their families|strong="H00001"\w* \w . . .|strong="H01004"\w*— \w the heads|strong="H07218"\w* \w of families|strong="H00001"\w*, \w registered|strong="H06485"\w* \w . . .|strong="H04557"\w* \w individually|strong="H01538"\w* \w by name|strong="H08034"\w*— \w those twenty|strong="H06242"\w* \w years of age|strong="H01121"\w* \w . . .|strong="H08141"\w* \w or older|strong="H04605"\w* \w who worked|strong="H06213"\w* \w . . .|strong="H04399"\w* \w in the service|strong="H05656"\w* \w of the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*.
\p \v 25 \w For|strong="H03588"\w* \w David|strong="H01732"\w* \w had said|strong="H00559"\w*, “\w The LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w has given rest|strong="H05117"\w* \w to His people|strong="H05971"\w* \w and has come to dwell|strong="H07931"\w* \w in Jerusalem|strong="H03389"\w* \w forever|strong="H05704"\w* \w . . .|strong="H05769"\w*. \v 26 \w So now|strong="H01571"\w* \w the Levites|strong="H03881"\w* \w no|strong="H00369"\w* \w longer need to carry|strong="H05375"\w* \w -|strong="H00853"\w* \w the tabernacle|strong="H04908"\w* \w -|strong="H00853"\w* \w or any|strong="H03605"\w* \w of the articles|strong="H03627"\w* \w for its service|strong="H05656"\w*.”
\p \v 27 \w For|strong="H03588"\w* \w according to the final|strong="H00314"\w* \w . . .|strong="H01992"\w* \w instructions|strong="H01697"\w* \w of David|strong="H01732"\w*, \w the Levites|strong="H01121"\w* \w . . .|strong="H03878"\w* \w twenty|strong="H06242"\w* \w years of age|strong="H01121"\w* \w . . .|strong="H08141"\w* \w or older|strong="H04605"\w* \w were counted|strong="H04557"\w*, \v 28 \w but|strong="H03588"\w* \w their duty|strong="H04612"\w* \w was to assist|strong="H03027"\w* \w the descendants|strong="H01121"\w* \w of Aaron|strong="H00175"\w* \w with the service|strong="H05656"\w* \w of the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*, \w being responsible for|strong="H05921"\w* \w the courts|strong="H02691"\w* \w . . .|strong="H05921"\w* \w and chambers|strong="H03957"\w*, \w . . .|strong="H05921"\w* \w the purification|strong="H02893"\w* \w of all|strong="H03605"\w* \w the holy things|strong="H06944"\w*, \w and the work|strong="H04639"\w* \w of the service|strong="H05656"\w* \w of the house|strong="H01004"\w* \w of God|strong="H00430"\w*, \v 29 \w as well as for the rows|strong="H04635"\w* \w of the showbread|strong="H03899"\w*, \w the fine flour|strong="H05560"\w* \w for the grain offering|strong="H04503"\w*, \w the wafers|strong="H07550"\w* \w of unleavened bread|strong="H04682"\w*, \w the baking|strong="H04227"\w*, \w the mixing|strong="H07246"\w*, \w and all|strong="H03605"\w* \w measurements of quantity|strong="H04884"\w* \w and size|strong="H04060"\w*.
\p \v 30 \w They were also to stand|strong="H05975"\w* \w every morning|strong="H01242"\w* \w . . .|strong="H01242"\w* \w to give thanks|strong="H03034"\w* \w and praise|strong="H01984"\w* \w to the LORD|strong="H03068"\w*, \w and likewise|strong="H03651"\w* \w in the evening|strong="H06153"\w*. \v 31 \w Whenever|strong="H03605"\w* \w burnt offerings|strong="H05930"\w* \w were presented|strong="H05927"\w* \w to the LORD|strong="H03068"\w* \w on the Sabbaths|strong="H07676"\w*, \w New Moons|strong="H02320"\w*, \w and appointed feasts|strong="H04150"\w*, \w they were to serve regularly|strong="H08548"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w in the numbers|strong="H04557"\w* \w prescribed|strong="H04941"\w* \w for them|strong="H05921"\w*. \v 32 \w So [the Levites] were to carry out|strong="H08104"\w* \w -|strong="H00853"\w* \w the responsibilities|strong="H04931"\w* \w for the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w* \w and|strong="H00853"\w* \w . . .|strong="H04931"\w* \w the Holy Place|strong="H06944"\w*, \w and, under|strong="H04931"\w* \w their brothers|strong="H00251"\w* \w the descendants|strong="H01121"\w* \w of Aaron|strong="H00175"\w*, \w the service|strong="H05656"\w* \w of the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*.
\c 24
\s1 Twenty-Four Divisions of Priests
\p \v 1 \w [These were] the divisions|strong="H04256"\w* \w of the descendants|strong="H01121"\w* \w of Aaron|strong="H00175"\w*. \w The sons|strong="H01121"\w* \w of Aaron|strong="H00175"\w* \w were Nadab|strong="H05070"\w*, \w Abihu|strong="H00030"\w*, \w Eleazar|strong="H00499"\w*, \w and Ithamar|strong="H00385"\w*. \v 2 \w But Nadab|strong="H05070"\w* \w and Abihu|strong="H00030"\w* \w died|strong="H04191"\w* \w before|strong="H06440"\w* \w their father did|strong="H00001"\w*, \w and they had|strong="H01961"\w* . . . \w no|strong="H03808"\w* \w sons|strong="H01121"\w*; \w so Eleazar|strong="H00499"\w* \w and Ithamar|strong="H00385"\w* \w served as priests|strong="H03547"\w*.
\p \v 3 \w With the help of Eleazar’s|strong="H00499"\w* \w descendant|strong="H01121"\w* \w Zadok|strong="H06659"\w* \w -|strong="H04480"\w*\w . . .|strong="H04480"\w* \w and Ithamar’s|strong="H00385"\w* \w descendant|strong="H01121"\w* \w Ahimelech|strong="H00288"\w*, \w David|strong="H01732"\w* \w divided them|strong="H02505"\w* \w according to the offices|strong="H06486"\w* \w of their service|strong="H05656"\w*. \v 4 \w Since more|strong="H07227"\w* \w leaders|strong="H07218"\w* \w . . .|strong="H01397"\w* \w were found|strong="H04672"\w* \w among Eleazar’s|strong="H00499"\w* \w descendants|strong="H01121"\w* \w than|strong="H04480"\w* \w [those]|strong="H01121"\w* \w of Ithamar|strong="H00385"\w*, \w they were divided accordingly|strong="H02505"\w*. \w [There were] sixteen|strong="H08337"\w* \w . . .|strong="H06240"\w* \w heads|strong="H07218"\w* \w of families|strong="H00001"\w* \w from the descendants|strong="H01121"\w* \w . . .|strong="H01004"\w* \w of Eleazar|strong="H00499"\w* \w and eight|strong="H08083"\w* \w -|strong="H00001"\w* \w from the descendants|strong="H01121"\w* \w . . .|strong="H01004"\w* \w of Ithamar|strong="H00385"\w*.
\p \v 5 \w Thus they were divided|strong="H02505"\w* \w by lot|strong="H01486"\w*, \w . . .|strong="H00428"\w* \w . . .|strong="H05973"\w* \w . . .|strong="H00428"\w* \w for|strong="H03588"\w* \w there were|strong="H01961"\w* \w officers|strong="H08269"\w* \w of the sanctuary|strong="H06944"\w* \w and officers|strong="H08269"\w* \w of God|strong="H00430"\w* \w among both Eleazar’s|strong="H00499"\w* \w . . .|strong="H01121"\w* \w and Ithamar’s|strong="H00385"\w* \w descendants|strong="H01121"\w*.
\p \v 6 \w The scribe|strong="H05608"\w*, \w . . .|strong="H04480"\w* \w Shemaiah|strong="H08098"\w* \w son|strong="H01121"\w* \w of Nethanel|strong="H05417"\w*, \w a Levite|strong="H03881"\w*, \w recorded [their names]|strong="H03789"\w* \w in the presence|strong="H06440"\w* \w of the king|strong="H04428"\w* \w and of the officers|strong="H08269"\w*: \w Zadok|strong="H06659"\w* \w the priest|strong="H03548"\w*, \w Ahimelech|strong="H00288"\w* \w son|strong="H01121"\w* \w of Abiathar|strong="H00054"\w*, \w and the heads|strong="H07218"\w* \w of families|strong="H00001"\w* \w of the priests|strong="H03548"\w* \w and the Levites|strong="H03881"\w* — \w one|strong="H00259"\w* \w family|strong="H00001"\w* \w . . .|strong="H01004"\w* \w being taken|strong="H00270"\w* \w from Eleazar|strong="H00499"\w*, \w . . .|strong="H00270"\w* \w and then one|strong="H00270"\w* \w from Ithamar|strong="H00385"\w*.
\b 
\li1 \v 7 \w The first|strong="H07223"\w* \w lot|strong="H01486"\w* \w fell|strong="H03318"\w* \w to Jehoiarib|strong="H03080"\w*,
\li1 \w the second|strong="H08145"\w* \w to Jedaiah|strong="H03048"\w*,
\li1 \v 8 \w the third|strong="H07992"\w* \w to Harim|strong="H02766"\w*,
\li1 \w the fourth|strong="H07243"\w* \w to Seorim|strong="H08188"\w*,
\li1 \v 9 \w the fifth|strong="H02549"\w* \w to Malchijah|strong="H04441"\w*,
\li1 \w the sixth|strong="H08345"\w* \w to Mijamin|strong="H04326"\w*,
\li1 \v 10 \w the seventh|strong="H07637"\w* \w to Hakkoz|strong="H06976"\w*,
\li1 \w the eighth|strong="H08066"\w* \w to Abijah|strong="H00029"\w*,
\li1 \v 11 \w the ninth|strong="H08671"\w* \w to Jeshua|strong="H03442"\w*,
\li1 \w the tenth|strong="H06224"\w* \w to Shecaniah|strong="H07935"\w*,
\li1 \v 12 \w the eleventh|strong="H06249"\w* \w . . .|strong="H06240"\w* \w to Eliashib|strong="H00475"\w*,
\li1 \w the twelfth|strong="H08147"\w* \w . . .|strong="H06240"\w* \w to Jakim|strong="H03356"\w*,
\li1 \v 13 \w the thirteenth|strong="H07969"\w* \w . . .|strong="H06240"\w* \w to Huppah|strong="H02647"\w*,
\li1 \w the fourteenth|strong="H00702"\w* \w . . .|strong="H06240"\w* \w to Jeshebeab|strong="H03428"\w*,
\li1 \v 14 \w the fifteenth|strong="H02568"\w* \w . . .|strong="H06240"\w* \w to Bilgah|strong="H01083"\w*,
\li1 \w the sixteenth|strong="H08337"\w* \w . . .|strong="H06240"\w* \w to Immer|strong="H00564"\w*,
\li1 \v 15 \w the seventeenth|strong="H07651"\w* \w . . .|strong="H06240"\w* \w to Hezir|strong="H02387"\w*,
\li1 \w the eighteenth|strong="H08083"\w* \w to Happizzez|strong="H06240"\w* \w . . .|strong="H06483"\w*,
\li1 \v 16 \w the nineteenth|strong="H08672"\w* \w . . .|strong="H06240"\w* \w to Pethahiah|strong="H06611"\w*,
\li1 \w the twentieth|strong="H06242"\w* \w to Jehezkel|strong="H03168"\w*,
\li1 \v 17 \w the twenty-first|strong="H00259"\w* \w . . .|strong="H06242"\w* \w to Jachin|strong="H03199"\w*,
\li1 \w the twenty-second|strong="H08147"\w* \w . . .|strong="H06242"\w* \w to Gamul|strong="H01577"\w*,
\li1 \v 18 \w the twenty-third|strong="H07969"\w* \w . . .|strong="H06242"\w* \w to Delaiah|strong="H01806"\w*,
\li1 \w and the twenty-fourth|strong="H00702"\w* \w . . .|strong="H06242"\w* \w to Maaziah|strong="H04590"\w*.
\p \v 19 \w This was|strong="H00428"\w* \w their appointed order|strong="H06486"\w* \w for service|strong="H05656"\w* \w when they entered|strong="H00935"\w* \w the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*, \w according to the regulations|strong="H04941"\w* \w prescribed for them|strong="H03027"\w* \w by their forefather|strong="H00001"\w* \w Aaron|strong="H00175"\w*, \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w had commanded him|strong="H06680"\w*.
\s1 The Rest of the Levites
\p \v 20 \w Now [these were] the rest of the|strong="H03498"\w* \w descendants|strong="H01121"\w* \w of Levi|strong="H03878"\w*:
\b 
\li1 \w From the sons|strong="H01121"\w* \w of Amram|strong="H06019"\w*: \w Shubael|strong="H07619"\w*;\f + \fr 24:20 \fqa Shubael \ft (twice in this verse) is a variant of \fqa Shebuel\ft ; see 1 Chronicles 23:16 and 1 Chronicles 26:24.\f*
\li1 \w from the sons|strong="H01121"\w* \w of Shubael|strong="H07619"\w*: \w Jehdeiah|strong="H03165"\w*.
\li1 \v 21 \w As for Rehabiah|strong="H07345"\w*, \w from his sons|strong="H01121"\w* \w . . .|strong="H07345"\w*: \w The first|strong="H07218"\w* \w [was] Isshiah|strong="H03449"\w*.\f + \fr 24:21 \fqa Isshiah \ft is a variant of \fqa Jeshaiah\ft ; see 1 Chronicles 26:25.\f*
\li1 \v 22 \w From the Izharites|strong="H03325"\w*: \w Shelomoth|strong="H08013"\w*;\f + \fr 24:22 \fqa Shelomoth \ft (twice in this verse) is a variant of \fqa Shelomith\ft ; see 1 Chronicles 23:18.\f*
\li1 \w from the sons|strong="H01121"\w* \w of Shelomoth|strong="H08013"\w*: \w Jahath|strong="H03189"\w*.
\li1 \v 23 \w From the sons [of Hebron]|strong="H01121"\w*: \w Jeriah [was the first]|strong="H03404"\w*,\f + \fr 24:23 \ft Hebrew \fqa From the sons: Jeriah\ft ; see 1 Chronicles 23:19.\f* \w Amariah|strong="H00568"\w* \w the second|strong="H08145"\w*, \w Jahaziel|strong="H03166"\w* \w the third|strong="H07992"\w*, \w [and] Jekameam|strong="H03360"\w* \w the fourth|strong="H07243"\w*.
\li1 \v 24 \w [From] the sons|strong="H01121"\w* \w of Uzziel|strong="H05816"\w*: \w Micah|strong="H04318"\w*;
\li1 \w from the sons of|strong="H01121"\w* \w Micah|strong="H04318"\w*: \w Shamir|strong="H08053"\w*.
\li1 \v 25 \w The brother|strong="H00251"\w* \w of Micah|strong="H04318"\w*: \w Isshiah|strong="H03449"\w*;
\li1 \w from the sons|strong="H01121"\w* \w of Isshiah|strong="H03449"\w*: \w Zechariah|strong="H02148"\w*.
\li1 \v 26 \w The sons|strong="H01121"\w* \w of Merari|strong="H04847"\w*: \w Mahli|strong="H04249"\w* \w and Mushi|strong="H04187"\w*.
\li1 \w The son|strong="H01121"\w* \w of Jaaziah|strong="H03269"\w*: \w Beno|strong="H01121"\w*.
\li1 \v 27 \w The descendants|strong="H01121"\w* \w of Merari|strong="H04847"\w* \w from Jaaziah|strong="H03269"\w*: \w Beno|strong="H01121"\w*, \w Shoham|strong="H07719"\w*, \w Zaccur|strong="H02139"\w*, \w and Ibri|strong="H05681"\w*.
\li1 \v 28 \w From Mahli|strong="H04249"\w*: \w Eleazar|strong="H00499"\w*, \w who had|strong="H01961"\w* \w no|strong="H03808"\w* \w sons|strong="H01121"\w*.
\li1 \v 29 \w From Kish|strong="H07027"\w*: \w Jerahmeel|strong="H03396"\w* \w the son|strong="H01121"\w* \w of Kish|strong="H07027"\w*.
\li1 \v 30 \w And the sons|strong="H01121"\w* \w of Mushi|strong="H04187"\w*: \w Mahli|strong="H04249"\w*, \w Eder|strong="H05740"\w*, \w and Jerimoth|strong="H03406"\w*.\f + \fr 24:30 \fqa Jerimoth \ft is a variant of \fqa Jeremoth\ft ; see 1 Chronicles 23:23.\f*
\p \w These|strong="H00428"\w* \w were the sons|strong="H01121"\w* \w of the Levites|strong="H03881"\w*, \w according to their families|strong="H00001"\w* \w . . .|strong="H01004"\w*. \v 31 \w As|strong="H05980"\w* \w their brothers|strong="H00251"\w* \w the descendants|strong="H01121"\w* \w of Aaron did|strong="H00175"\w*, \w they|strong="H01992"\w* \w also|strong="H01571"\w* \w cast|strong="H05307"\w* \w lots|strong="H01486"\w* \w in the presence|strong="H06440"\w* \w of King|strong="H04428"\w* \w David|strong="H01732"\w* \w and of Zadok|strong="H06659"\w*, \w Ahimelech|strong="H00288"\w*, \w and the heads|strong="H07218"\w* \w of the families|strong="H00001"\w* \w of the priests|strong="H03548"\w* \w and Levites|strong="H03881"\w*— \w the family|strong="H00001"\w* \w heads|strong="H07218"\w* \w and their younger|strong="H06996"\w* \w brothers|strong="H00251"\w* \w alike|strong="H05980"\w*.
\c 25
\s1 Twenty-Four Divisions of Musicians
\p \v 1 \w Additionally, David|strong="H01732"\w* \w and the commanders|strong="H08269"\w* \w of the army|strong="H06635"\w* \w . . .|strong="H05656"\w* \w set apart|strong="H00914"\w* \w some of the sons|strong="H01121"\w* \w of Asaph|strong="H00623"\w*, \w Heman|strong="H01968"\w*, \w and Jeduthun|strong="H03038"\w* \w to prophesy|strong="H05030"\w* \w with the accompaniment of lyres|strong="H03658"\w*, \w harps|strong="H05035"\w*, \w and cymbals|strong="H04700"\w*. \w The following|strong="H01961"\w* \w is the list|strong="H04557"\w* \w of the men|strong="H00582"\w* \w who performed|strong="H04399"\w* \w this service|strong="H05656"\w*:
\b 
\li1 \v 2 \w From the sons|strong="H01121"\w* \w of Asaph|strong="H00623"\w*: \w Zaccur|strong="H02139"\w*, \w Joseph|strong="H03130"\w*, \w Nethaniah|strong="H05418"\w*, \w and Asarelah|strong="H00841"\w*. \w These sons|strong="H01121"\w* \w of Asaph|strong="H00623"\w* \w [were] under|strong="H05921"\w* \w the direction|strong="H03027"\w* \w of Asaph|strong="H00623"\w*, \w who prophesied|strong="H05012"\w* \w under|strong="H05921"\w* \w the direction|strong="H03027"\w* \w of the king|strong="H04428"\w*.
\li1 \v 3 \w -|strong="H03038"\w* \w From the sons|strong="H01121"\w* \w of Jeduthun|strong="H03038"\w*: \w Gedaliah|strong="H01436"\w*, \w Zeri|strong="H06874"\w*, \w Jeshaiah [, Shimei]|strong="H03470"\w*,\f + \fr 25:3 \ft One Hebrew manuscript and some LXX manuscripts (see also verse 17); most Hebrew manuscripts do not include \fqa Shimei\ft .\f* \w Hashabiah|strong="H02811"\w*, \w and Mattithiah|strong="H04993"\w* — \w six [in all]|strong="H08337"\w* — \w under|strong="H05921"\w* \w the direction|strong="H03027"\w* \w of their father|strong="H00001"\w* \w Jeduthun|strong="H03038"\w*, \w who prophesied|strong="H05012"\w* \w -|strong="H05921"\w* \w with the harp|strong="H03658"\w*, \w giving thanks|strong="H03034"\w* \w and praise|strong="H01984"\w* \w to the LORD|strong="H03068"\w*.
\li1 \v 4 \w -|strong="H01968"\w* \w From the sons|strong="H01121"\w* \w of Heman|strong="H01968"\w*: \w Bukkiah|strong="H01232"\w*, \w Mattaniah|strong="H04983"\w*, \w Uzziel|strong="H05816"\w*, \w Shebuel|strong="H07619"\w*,\f + \fr 25:4 \fqa Shebuel \ft is a variant of \fqa Shubael\ft ; see verse 20.\f* \w Jerimoth|strong="H03406"\w*,\f + \fr 25:4 \fqa Jerimoth \ft is a variant of \fqa Jeremoth\ft ; see verse 22.\f* \w Hananiah|strong="H02608"\w*, \w Hanani|strong="H02607"\w*, \w Eliathah|strong="H00448"\w*, \w Giddalti|strong="H01437"\w*, \w vvv|strong="H07320"\w* \w Romamti-ezer|strong="H07320"\w*, \w Joshbekashah|strong="H03436"\w*, \w Mallothi|strong="H04413"\w*, \w Hothir|strong="H01956"\w*, \w and Mahazioth|strong="H04238"\w*. \v 5 \w All|strong="H03605"\w* \w these|strong="H00428"\w* \w sons|strong="H01121"\w* \w of Heman|strong="H01968"\w* \w the king’s|strong="H04428"\w* \w seer|strong="H02374"\w* \w [were given him] through the promises|strong="H01697"\w* \w of God|strong="H00430"\w* \w to exalt|strong="H07311"\w* \w him|strong="H07161"\w*, \w for God|strong="H00430"\w* \w had given|strong="H05414"\w* \w Heman|strong="H01968"\w* \w fourteen|strong="H00702"\w* \w . . .|strong="H06240"\w* \w sons|strong="H01121"\w* \w and three|strong="H07969"\w* \w daughters|strong="H01323"\w*.
\p \v 6 \w All|strong="H03605"\w* \w these [were]|strong="H00428"\w* \w under|strong="H05921"\w* \w the direction|strong="H03027"\w* \w of their fathers|strong="H00001"\w* \w for the music|strong="H07892"\w* \w of the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w* \w with cymbals|strong="H04700"\w*, \w harps|strong="H05035"\w*, \w and lyres|strong="H03658"\w*, \w for the service|strong="H05656"\w* \w of the house|strong="H01004"\w* \w of God|strong="H00430"\w*.
\p \w Asaph|strong="H00623"\w*, \w Jeduthun|strong="H03038"\w*, \w and Heman|strong="H01968"\w* \w were under|strong="H05921"\w* \w the direction|strong="H03027"\w* \w of the king|strong="H04428"\w*. \v 7 \w Together with|strong="H05973"\w* \w their relatives|strong="H00251"\w*, \w who were all|strong="H03605"\w* \w trained|strong="H03925"\w* \w and skillful|strong="H00995"\w* \w in the songs|strong="H07892"\w* \w of the LORD|strong="H03068"\w*, \w -|strong="H01961"\w* \w they numbered|strong="H04557"\w* \w 288|strong="H03967"\w* \w . . .|strong="H08084"\w* \w . . .|strong="H08083"\w*. \v 8 \w They cast|strong="H05307"\w* \w lots|strong="H01486"\w* \w for their duties|strong="H04931"\w*, \w . . .|strong="H05980"\w* \w young|strong="H06996"\w* \w and old alike|strong="H01419"\w*, \w teacher|strong="H00995"\w* \w as|strong="H05973"\w* \w well as pupil|strong="H08527"\w*.
\b 
\li1 \v 9 \w The first|strong="H07223"\w* \w lot|strong="H01486"\w*, \w [which was] for Asaph|strong="H00623"\w*, \w fell|strong="H03318"\w* \w to Joseph, [his sons, and his brothers—12 in all]|strong="H03130"\w*;\f + \fr 25:9 \ft See LXX and the total in verse 7; Hebrew does not include \fqa his sons, and his brothers—12 in all;\f*
\li1 \w the second|strong="H08145"\w* \w to Gedaliah|strong="H01436"\w* \w -|strong="H01931"\w*, \w his sons|strong="H01121"\w*, \w and his brothers|strong="H00251"\w*— \w 12 [in all]|strong="H08147"\w* \w . . .|strong="H06240"\w*;
\li1 \v 10 \w the third|strong="H07992"\w* \w to Zaccur|strong="H02139"\w*, \w his sons|strong="H01121"\w*, \w and his brothers|strong="H00251"\w*— \w 12 [in all]|strong="H08147"\w* \w . . .|strong="H06240"\w*;
\li1 \v 11 \w the fourth|strong="H07243"\w* \w to Izri|strong="H03339"\w*,\f + \fr 25:11 \fqa Izri \ft is a variant of \fqa Zeri\ft ; see verse 3.\f* \w his sons|strong="H01121"\w*, \w and his brothers|strong="H00251"\w*— \w 12 [in all]|strong="H08147"\w* \w . . .|strong="H06240"\w*;
\li1 \v 12 \w the fifth|strong="H02549"\w* \w to Nethaniah|strong="H05418"\w*, \w his sons|strong="H01121"\w*, \w and his brothers|strong="H00251"\w*— \w 12 [in all]|strong="H08147"\w* \w . . .|strong="H06240"\w*;
\li1 \v 13 \w the sixth|strong="H08345"\w* \w to Bukkiah|strong="H01232"\w*, \w his sons|strong="H01121"\w*, \w and his brothers|strong="H00251"\w*— \w 12 [in all]|strong="H08147"\w* \w . . .|strong="H06240"\w*;
\li1 \v 14 \w the seventh|strong="H07637"\w* \w to Jesarelah|strong="H03480"\w*,\f + \fr 25:14 \fqa Jesarelah \ft is a variant of \fqa Asarelah\ft ; see verse 2.\f* \w his sons|strong="H01121"\w*, \w and his brothers|strong="H00251"\w*— \w 12 [in all]|strong="H08147"\w* \w . . .|strong="H06240"\w*;
\li1 \v 15 \w the eighth|strong="H08066"\w* \w to Jeshaiah|strong="H03470"\w*, \w his sons|strong="H01121"\w*, \w and his brothers|strong="H00251"\w*— \w 12 [in all]|strong="H08147"\w* \w . . .|strong="H06240"\w*;
\li1 \v 16 \w the ninth|strong="H08671"\w* \w to Mattaniah|strong="H04983"\w*, \w his sons|strong="H01121"\w*, \w and his brothers|strong="H00251"\w*— \w 12 [in all]|strong="H08147"\w* \w . . .|strong="H06240"\w*;
\li1 \v 17 \w the tenth|strong="H06224"\w* \w to Shimei|strong="H08096"\w*, \w his sons|strong="H01121"\w*, \w and his brothers|strong="H00251"\w*— \w 12 [in all]|strong="H08147"\w* \w . . .|strong="H06240"\w*;
\li1 \v 18 \w the eleventh|strong="H06249"\w* \w . . .|strong="H06240"\w* \w to Azarel|strong="H05832"\w*,\f + \fr 25:18 \fqa Azarel \ft is a variant of \fqa Uzziel\ft ; see verse 4.\f* \w his sons|strong="H01121"\w*, \w and his brothers|strong="H00251"\w*— \w 12 [in all]|strong="H08147"\w* \w . . .|strong="H06240"\w*;
\li1 \v 19 \w the twelfth|strong="H08147"\w* \w . . .|strong="H06240"\w* \w to Hashabiah|strong="H02811"\w*, \w his sons|strong="H01121"\w*, \w and his brothers|strong="H00251"\w*— \w 12 [in all]|strong="H08147"\w* \w . . .|strong="H06240"\w*;
\li1 \v 20 \w the thirteenth|strong="H07969"\w* \w . . .|strong="H06240"\w* \w to Shubael|strong="H07619"\w*, \w his sons|strong="H01121"\w*, \w and his brothers|strong="H00251"\w*— \w 12 [in all]|strong="H08147"\w* \w . . .|strong="H06240"\w*;
\li1 \v 21 \w the fourteenth|strong="H00702"\w* \w . . .|strong="H06240"\w* \w to Mattithiah|strong="H04993"\w*, \w his sons|strong="H01121"\w*, \w and his brothers|strong="H00251"\w*— \w 12 [in all]|strong="H08147"\w* \w . . .|strong="H06240"\w*;
\li1 \v 22 \w the fifteenth|strong="H02568"\w* \w . . .|strong="H06240"\w* \w to Jeremoth|strong="H03406"\w*,\f + \fr 25:22 \fqa Jeremoth \ft is a variant of \fqa Jerimoth\ft ; see verse 4.\f* \w his sons|strong="H01121"\w*, \w and his brothers|strong="H00251"\w*— \w 12 [in all]|strong="H08147"\w* \w . . .|strong="H06240"\w*;
\li1 \v 23 \w the sixteenth|strong="H08337"\w* \w . . .|strong="H06240"\w* \w to Hananiah|strong="H02608"\w*, \w his sons|strong="H01121"\w*, \w and his brothers|strong="H00251"\w*— \w 12 [in all]|strong="H08147"\w* \w . . .|strong="H06240"\w*;
\li1 \v 24 \w the seventeenth|strong="H07651"\w* \w . . .|strong="H06240"\w* \w to Joshbekashah|strong="H03436"\w*, \w his sons|strong="H01121"\w*, \w and his brothers|strong="H00251"\w*— \w 12 [in all]|strong="H08147"\w* \w . . .|strong="H06240"\w*;
\li1 \v 25 \w the eighteenth|strong="H08083"\w* \w . . .|strong="H06240"\w* \w to Hanani|strong="H02607"\w*, \w his sons|strong="H01121"\w*, \w and his brothers|strong="H00251"\w*— \w 12 [in all]|strong="H08147"\w* \w . . .|strong="H06240"\w*;
\li1 \v 26 \w the nineteenth|strong="H08672"\w* \w . . .|strong="H06240"\w* \w to Mallothi|strong="H04413"\w*, \w his sons|strong="H01121"\w*, \w and his brothers|strong="H00251"\w*— \w 12 [in all]|strong="H08147"\w* \w . . .|strong="H06240"\w*;
\li1 \v 27 \w the twentieth|strong="H06242"\w* \w to Eliathah|strong="H00448"\w*, \w his sons|strong="H01121"\w*, \w and his brothers|strong="H00251"\w*— \w 12 [in all]|strong="H08147"\w* \w . . .|strong="H06240"\w*;
\li1 \v 28 \w the twenty-first|strong="H00259"\w* \w . . .|strong="H06242"\w* \w to Hothir|strong="H01956"\w*, \w his sons|strong="H01121"\w*, \w and his brothers|strong="H00251"\w*— \w 12 [in all]|strong="H08147"\w* \w . . .|strong="H06240"\w*;
\li1 \v 29 \w the twenty-second|strong="H08147"\w* \w . . .|strong="H06242"\w* \w to Giddalti|strong="H01437"\w*, \w his sons|strong="H01121"\w*, \w and his brothers|strong="H00251"\w*— \w 12 [in all]|strong="H08147"\w* \w . . .|strong="H06240"\w*;
\li1 \v 30 \w the twenty-third|strong="H07969"\w* \w . . .|strong="H06242"\w* \w to Mahazioth|strong="H04238"\w*, \w his sons|strong="H01121"\w*, \w and his brothers|strong="H00251"\w*— \w 12 [in all]|strong="H08147"\w* \w . . .|strong="H06240"\w*;
\li1 \v 31 \w and the twenty-fourth|strong="H00702"\w* \w . . .|strong="H06242"\w* \w vvv|strong="H07320"\w* \w to Romamti-ezer|strong="H07320"\w*, \w his sons|strong="H01121"\w*, \w and his brothers|strong="H00251"\w*— \w 12 [in all]|strong="H08147"\w* \w . . .|strong="H06240"\w*.
\c 26
\s1 The Divisions of the Gatekeepers
\p \v 1 \w These were the divisions|strong="H04256"\w* \w of the gatekeepers|strong="H07778"\w*:
\b 
\li1 \w From the Korahites|strong="H07145"\w*: \w Meshelemiah|strong="H04920"\w* \w son|strong="H01121"\w* \w of Kore|strong="H06981"\w*, \w one of|strong="H04480"\w* \w the sons|strong="H01121"\w* \w of Asaph|strong="H00623"\w*.
\li1 \v 2 \w Meshelemiah|strong="H04920"\w* \w had sons|strong="H01121"\w*: \w Zechariah|strong="H02148"\w* \w the firstborn|strong="H01060"\w*, \w Jediael|strong="H03043"\w* \w the second|strong="H08145"\w*, \w Zebadiah|strong="H02069"\w* \w the third|strong="H07992"\w*, \w Jathniel|strong="H03496"\w* \w the fourth|strong="H07243"\w*, \v 3 \w Elam|strong="H05867"\w* \w the fifth|strong="H02549"\w*, \w Jehohanan|strong="H03076"\w* \w the sixth|strong="H08345"\w*, \w and Eliehoenai|strong="H00454"\w* \w the seventh|strong="H07637"\w*.
\li1 \v 4 \w vvv|strong="H05654"\w* \w And Obed-edom|strong="H05654"\w* \w also had sons|strong="H01121"\w*: \w Shemaiah|strong="H08098"\w* \w the firstborn|strong="H01060"\w*, \w Jehozabad|strong="H03075"\w* \w the second|strong="H08145"\w*, \w Joah|strong="H03098"\w* \w the third|strong="H07992"\w*, \w Sachar|strong="H07940"\w* \w the fourth|strong="H07243"\w*, \w Nethanel|strong="H05417"\w* \w the fifth|strong="H02549"\w*, \v 5 \w Ammiel|strong="H05988"\w* \w the sixth|strong="H08345"\w*, \w Issachar|strong="H03485"\w* \w the seventh|strong="H07637"\w*, \w and Peullethai|strong="H06469"\w* \w the eighth|strong="H08066"\w*. \w For|strong="H03588"\w* \w God|strong="H00430"\w* \w had blessed [Obed-edom]|strong="H01288"\w*.
\li1 \v 6 \w Also to his son|strong="H01121"\w* \w Shemaiah|strong="H08098"\w* \w were born|strong="H03205"\w* \w sons|strong="H01121"\w* \w who ruled|strong="H04474"\w* \w over their families|strong="H00001"\w* \w . . .|strong="H01004"\w* \w because|strong="H03588"\w* \w they|strong="H01992"\w* \w were strong|strong="H01368"\w*, \w capable men|strong="H02428"\w*. \v 7 \w Shemaiah’s|strong="H08098"\w* \w sons [were]|strong="H01121"\w* \w Othni|strong="H06273"\w*, \w Rephael|strong="H07501"\w*, \w Obed|strong="H05744"\w*, \w and Elzabad|strong="H00443"\w*; \w his brothers [were]|strong="H00251"\w* \w Elihu|strong="H00453"\w* \w and Semachiah|strong="H05565"\w*, \w also capable|strong="H02428"\w* \w men|strong="H01121"\w*. \v 8 \w All|strong="H03605"\w* \w these [were]|strong="H00428"\w* \w descendants|strong="H01121"\w* \w vvv|strong="H05654"\w* \w of Obed-edom|strong="H05654"\w*; \w they|strong="H01992"\w* \w and their sons|strong="H01121"\w* \w and brothers|strong="H00251"\w* \w were capable|strong="H02428"\w* \w men|strong="H00376"\w* \w with strength|strong="H03581"\w* \w to do the work|strong="H05656"\w*— \w 62|strong="H08346"\w* \w . . .|strong="H08147"\w* \w [in all]|strong="H05654"\w* \w from Obed-edom|strong="H05654"\w*.
\li1 \v 9 \w Meshelemiah|strong="H04920"\w* \w also had sons|strong="H01121"\w* \w and brothers|strong="H00251"\w* \w who were capable|strong="H02428"\w* \w men|strong="H01121"\w*— \w 18 [in all]|strong="H08083"\w* \w . . .|strong="H06240"\w*.
\li1 \v 10 \w Hosah|strong="H02621"\w* \w -|strong="H04480"\w* \w the Merarite|strong="H01121"\w* \w . . .|strong="H04847"\w* \w also had sons|strong="H01121"\w*: \w Shimri|strong="H08113"\w* \w the first|strong="H07218"\w* (\w although|strong="H03588"\w* \w he was|strong="H01961"\w* \w not|strong="H03808"\w* \w the firstborn|strong="H01060"\w*, \w his father|strong="H00001"\w* \w had appointed him|strong="H07760"\w* \w as the first|strong="H07218"\w*), \v 11 \w Hilkiah|strong="H02518"\w* \w the second|strong="H08145"\w*, \w Tebaliah|strong="H02882"\w* \w the third|strong="H07992"\w*, \w and Zechariah|strong="H02148"\w* \w the fourth|strong="H07243"\w*. \w The sons|strong="H01121"\w* \w and brothers|strong="H00251"\w* \w of Hosah|strong="H02621"\w* \w [numbered] 13|strong="H07969"\w* \w . . .|strong="H06240"\w* \w in all|strong="H03605"\w*.
\p \v 12 \w These|strong="H00428"\w* \w divisions|strong="H04256"\w* \w of the gatekeepers|strong="H07778"\w*, \w through their chief|strong="H07218"\w* \w men|strong="H01397"\w*, \w had duties|strong="H04931"\w* \w for ministering|strong="H08334"\w* \w in the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*, \w just as|strong="H05980"\w* \w their relatives did|strong="H00251"\w*. \v 13 \w They cast|strong="H05307"\w* \w lots|strong="H01486"\w* \w for each gate|strong="H08179"\w*, \w . . .|strong="H08179"\w* \w according to their families|strong="H00001"\w* \w . . .|strong="H01004"\w*, \w young|strong="H06996"\w* \w and old alike|strong="H01419"\w*.
\b 
\li1 \v 14 \w The lot|strong="H01486"\w* \w for the East [Gate]|strong="H04217"\w* \w fell|strong="H05307"\w* \w to Shelemiah|strong="H08018"\w*.\f + \fr 26:14 \fqa Shelemiah \ft is a variant of \fqa Meshelemiah\ft ; see verse 2.\f*
\li1 \w Then lots|strong="H01486"\w* \w were cast|strong="H05307"\w* \w for his son|strong="H01121"\w* \w Zechariah|strong="H02148"\w*, \w a wise|strong="H07922"\w* \w counselor|strong="H03289"\w*, \w and the lot|strong="H01486"\w* \w for the North Gate|strong="H06828"\w* \w fell to him|strong="H03318"\w*.
\li1 \v 15 \w [The lot for] the South [Gate]|strong="H05045"\w* \w [fell] to|strong="H05654"\w* \w Obed-edom|strong="H05654"\w*, \w and the lot for the storehouses|strong="H01004"\w* \w . . .|strong="H00624"\w* \w to his sons|strong="H01121"\w*.
\li1 \v 16 \w [The lots] for the West Gate|strong="H04628"\w* \w and|strong="H05973"\w* \w the Shallecheth|strong="H07996"\w* \w Gate|strong="H08179"\w* \w on the ascending|strong="H05927"\w* \w highway|strong="H04546"\w*\f + \fr 26:16 \ft Or \fqa on the upper road\f* \w [fell to] Shuppim|strong="H08206"\w* \w and Hosah|strong="H02621"\w*.
\p \w There were guards|strong="H04929"\w* \w stationed|strong="H05980"\w* \w at every watch|strong="H04929"\w*. \v 17 \w Each day|strong="H03117"\w* \w there were six|strong="H08337"\w* \w Levites|strong="H03881"\w* \w on the east|strong="H04217"\w*, \w four|strong="H00702"\w* \w on the north|strong="H06828"\w*, \w four|strong="H00702"\w* \w -|strong="H03117"\w* \w on the south|strong="H05045"\w*, \w and two pairs|strong="H08147"\w* \w . . .|strong="H08147"\w* \w at the storehouse|strong="H00624"\w*. \v 18 \w As for the court|strong="H06503"\w*\f + \fr 26:18 \ft Hebrew \fqa parbar\ft ; twice in this verse\f* \w on the west|strong="H04628"\w*, \w there were four|strong="H00702"\w* \w at the highway|strong="H04546"\w* \w and two|strong="H08147"\w* \w at the court|strong="H06503"\w*.
\p \v 19 \w These [were]|strong="H00428"\w* \w the divisions|strong="H04256"\w* \w of the gatekeepers|strong="H07778"\w* \w who were descendants|strong="H01121"\w* \w of Korah|strong="H07145"\w* \w [and]|strong="H01121"\w* \w Merari|strong="H04847"\w*.
\s1 The Treasurers, Officers, and Judges
\p \v 20 \w Now their fellow Levites [were]|strong="H03881"\w* \w -|strong="H00281"\w*\f + \fr 26:20 \ft LXX; Hebrew \fqa As for the Levites, Ahijah was\f* \w in charge of|strong="H05921"\w* \w the treasuries|strong="H00214"\w* \w of the house|strong="H01004"\w* \w of God|strong="H00430"\w* \w and the treasuries|strong="H00214"\w* \w of the dedicated things|strong="H06944"\w*. \v 21 \w From the descendants|strong="H01121"\w* \w of Ladan|strong="H03936"\w*, \w who were|strong="H01121"\w* \w Gershonites|strong="H01649"\w* \w through Ladan|strong="H03936"\w*\f + \fr 26:21 \fqa Ladan \ft is a variant of \fqa Libni\ft ; see 1 Chronicles 6:17.\f* \w and heads|strong="H07218"\w* \w of the families|strong="H00001"\w* \w of Ladan|strong="H03936"\w* \w the Gershonite|strong="H01649"\w*, \w [were] Jehieli|strong="H03172"\w*,\f + \fr 26:21 \fqa Jehieli \ft is a variant of \fqa Jehiel\ft ; also in verse 22; see 1 Chronicles 23:8.\f* \v 22 \w the sons|strong="H01121"\w* \w of Jehieli|strong="H03172"\w*, \w Zetham|strong="H02241"\w*, \w and his brother|strong="H00251"\w* \w Joel|strong="H03100"\w*. \w They were in charge of|strong="H05921"\w* \w the treasuries|strong="H00214"\w* \w of the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*.
\p \v 23 \w From the Amramites|strong="H06020"\w*, \w the Izharites|strong="H03325"\w*, \w the Hebronites|strong="H02276"\w*, \w and the Uzzielites|strong="H05817"\w*:
\b 
\li1 \v 24 \w Shebuel|strong="H07619"\w*, \w a descendant|strong="H01121"\w* \w of Gershom|strong="H01647"\w* \w son of|strong="H01121"\w* \w Moses|strong="H04872"\w*, \w was the officer|strong="H05057"\w* \w in charge of|strong="H05921"\w* \w the treasuries|strong="H00214"\w*. \v 25 \w His relatives|strong="H00251"\w* \w through Eliezer [included]|strong="H00461"\w* \w Rehabiah|strong="H07345"\w* \w his son|strong="H01121"\w*, \w Jeshaiah|strong="H03470"\w*\f + \fr 26:25 \fqa Jeshaiah \ft is a variant of \fqa Isshiah\ft ; see 1 Chronicles 24:21.\f* \w his son|strong="H01121"\w*, \w Joram|strong="H03141"\w* \w his son|strong="H01121"\w*, \w Zichri|strong="H02147"\w* \w his son|strong="H01121"\w*, \w and Shelomith|strong="H08013"\w* \w his son|strong="H01121"\w*. \v 26 \w This|strong="H01931"\w* \w Shelomith|strong="H08013"\w* \w and his brothers|strong="H00251"\w* \w were in charge of|strong="H05921"\w* \w all|strong="H03605"\w* \w the treasuries|strong="H00214"\w* \w . . .|strong="H06944"\w* \w for the things|strong="H00834"\w* \w dedicated|strong="H06942"\w* \w by King|strong="H04428"\w* \w David|strong="H01732"\w*, \w by the heads|strong="H07218"\w* \w of families|strong="H00001"\w* \w who were the commanders|strong="H08269"\w* \w of thousands|strong="H00505"\w* \w and of hundreds|strong="H03967"\w*, \w and by the army|strong="H06635"\w* \w commanders|strong="H08269"\w*. \v 27 \w They had dedicated|strong="H06942"\w* \w some of|strong="H04480"\w* \w the plunder|strong="H07998"\w* \w from|strong="H04480"\w* \w their battles|strong="H04421"\w* \w to the repair|strong="H02388"\w* \w of the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*. \v 28 \w Everything|strong="H03605"\w* \w that had been dedicated|strong="H06942"\w* \w by Samuel|strong="H08050"\w* \w the seer|strong="H07203"\w*, \w Saul|strong="H07586"\w* \w son|strong="H01121"\w* \w of Kish|strong="H07027"\w*, \w Abner|strong="H00074"\w* \w son|strong="H01121"\w* \w of Ner|strong="H05369"\w*, \w and Joab|strong="H03097"\w* \w son|strong="H01121"\w* \w of Zeruiah|strong="H06870"\w*, \w along with everything else|strong="H03605"\w* \w that was dedicated|strong="H06942"\w*, \w was under|strong="H05921"\w* \w the care|strong="H03027"\w* \w of Shelomith|strong="H08019"\w* \w and his brothers|strong="H00251"\w*.
\b 
\li1 \v 29 \w From the Izharites|strong="H03325"\w*, \w Chenaniah|strong="H03663"\w* \w and his sons|strong="H01121"\w* \w had the outside|strong="H02435"\w* \w duties|strong="H04399"\w*\f + \fr 26:29 \ft Or \fqa the duties outside (the temple) \ft or \fqa the duties outside (Jerusalem)\f* \w as officers|strong="H07860"\w* \w and judges|strong="H08199"\w* \w over|strong="H05921"\w* \w Israel|strong="H03478"\w*.
\li1 \v 30 \w From the Hebronites|strong="H02276"\w*, \w Hashabiah|strong="H02811"\w* \w and his relatives|strong="H00251"\w*, \w 1,700|strong="H00505"\w* \w . . .|strong="H07651"\w* \w . . .|strong="H03967"\w* \w . . .|strong="H05921"\w* \w capable|strong="H02428"\w* \w men|strong="H01121"\w*, \w had charge of the affairs|strong="H06486"\w* \w of Israel|strong="H03478"\w* \w . . .|strong="H05676"\w* \w west|strong="H04628"\w* \w of the Jordan|strong="H03383"\w* \w for all|strong="H03605"\w* \w the work|strong="H04399"\w* \w of the LORD|strong="H03068"\w* \w and for the service|strong="H05656"\w* \w of the king|strong="H04428"\w*. \v 31 \w As for the Hebronites|strong="H02276"\w*, \w Jerijah|strong="H03404"\w*\f + \fr 26:31 \fqa Jerijah \ft is a variant of \fqa Jeriah\ft ; see 1 Chronicles 23:19.\f* \w was the chief|strong="H07218"\w* \w of the Hebronites|strong="H02276"\w*, \w according to the genealogies|strong="H08435"\w* \w of his ancestors|strong="H00001"\w*. \w In the fortieth|strong="H00705"\w* \w year|strong="H08141"\w* \w of David’s|strong="H01732"\w* \w reign|strong="H04438"\w* \w [the records] were searched|strong="H01875"\w*, \w and strong|strong="H01368"\w*, \w capable men|strong="H02428"\w* \w were found|strong="H04672"\w* among [the Hebronites] \w at Jazer|strong="H03270"\w* \w in Gilead|strong="H01568"\w*. \v 32 \w Among Jerijah’s relatives|strong="H00251"\w* \w [there were] 2,700|strong="H00505"\w* \w . . .|strong="H07651"\w* \w . . .|strong="H03967"\w* \w capable|strong="H02428"\w* \w men|strong="H01121"\w* \w who were heads|strong="H07218"\w* \w of families|strong="H00001"\w*. \w King|strong="H04428"\w* \w David|strong="H01732"\w* \w appointed them|strong="H06485"\w* \w over|strong="H05921"\w* \w the Reubenites|strong="H07206"\w*, \w the Gadites|strong="H01425"\w*, \w and the half-tribe|strong="H02677"\w* \w . . .|strong="H07626"\w* \w of Manasseh|strong="H04520"\w* \w for every|strong="H03605"\w* \w matter [pertaining to]|strong="H01697"\w* \w God|strong="H00430"\w* \w and for the affairs|strong="H01697"\w* \w of the king|strong="H04428"\w*.
\c 27
\s1 Twelve Captains for Twelve Months
\p \v 1 \w This is the list|strong="H04557"\w* \w vvv|strong="H01121"\w* \w of the Israelites|strong="H03478"\w*— \w the heads|strong="H07218"\w* \w of families|strong="H00001"\w*, \w the commanders|strong="H08269"\w* \w of thousands|strong="H00505"\w* \w and of hundreds|strong="H03967"\w*, \w and their officers|strong="H07860"\w* \w who served|strong="H08334"\w* \w -|strong="H00853"\w* \w the king|strong="H04428"\w* \w in every|strong="H03605"\w* \w matter|strong="H01697"\w* \w concerning the divisions|strong="H04256"\w* \w on rotating military duty|strong="H00935"\w* \w . . .|strong="H03318"\w* \w each month|strong="H02320"\w* \w . . .|strong="H02320"\w* \w throughout|strong="H03605"\w* \w . . .|strong="H02320"\w* \w the year|strong="H08141"\w*. \w There were 24,000 men|strong="H06242"\w* \w . . .|strong="H00702"\w* \w . . .|strong="H00505"\w* \w in each|strong="H00259"\w* \w division|strong="H04256"\w*:
\b 
\li1 \v 2 \w Jashobeam|strong="H03434"\w* \w son|strong="H01121"\w* \w of Zabdiel|strong="H02068"\w* \w was in charge of|strong="H05921"\w* \w the first|strong="H07223"\w* \w division|strong="H04256"\w*, \w [which was assigned] the first|strong="H07223"\w* \w month|strong="H02320"\w*. \w [There were] 24,000|strong="H06242"\w* \w . . .|strong="H00702"\w* \w . . .|strong="H00505"\w* \w [men] in|strong="H05921"\w* \w his division|strong="H04256"\w*. \v 3 \w -|strong="H04480"\w* \w He was a descendant|strong="H01121"\w* \w of Perez|strong="H06557"\w* \w and chief|strong="H07218"\w* \w of all|strong="H03605"\w* \w the army|strong="H06635"\w* \w commanders|strong="H08269"\w* \w for the first|strong="H07223"\w* \w month|strong="H02320"\w*.
\li1 \v 4 \w Dodai|strong="H01737"\w*\f + \fr 27:4 \fqa Dodai \ft is a variant of \fqa Dodo\ft ; see 2 Samuel 23:9.\f* \w the Ahohite|strong="H00266"\w* \w was in charge of|strong="H05921"\w* \w the division|strong="H04256"\w* \w for the second|strong="H08145"\w* \w month|strong="H02320"\w*, \w and Mikloth|strong="H04732"\w* \w was the leader|strong="H05057"\w*. \w [There were] 24,000|strong="H06242"\w* \w . . .|strong="H00702"\w* \w . . .|strong="H00505"\w* \w [men] in|strong="H05921"\w* \w . . .|strong="H04256"\w* \w his division|strong="H04256"\w*.
\li1 \v 5 \w The third|strong="H07992"\w* \w army|strong="H06635"\w* \w commander|strong="H08269"\w*, \w as chief|strong="H07218"\w* \w for the third|strong="H07992"\w* \w month|strong="H02320"\w*, \w was Benaiah|strong="H01141"\w* \w son|strong="H01121"\w* \w of Jehoiada|strong="H03077"\w* \w the priest|strong="H03548"\w*. \w [There were] 24,000|strong="H06242"\w* \w . . .|strong="H00702"\w* \w . . .|strong="H00505"\w* \w [men] in|strong="H05921"\w* \w his division|strong="H04256"\w*. \v 6 \w This|strong="H01931"\w* \w Benaiah|strong="H01141"\w* \w was mighty|strong="H01368"\w* \w among the Thirty|strong="H07970"\w* \w and was over|strong="H05921"\w* \w the Thirty|strong="H07970"\w*, \w and his son|strong="H01121"\w* \w Ammizabad|strong="H05990"\w* \w was in charge of his division|strong="H04256"\w*.
\li1 \v 7 \w The fourth|strong="H07243"\w*, \w for the fourth|strong="H07243"\w* \w month|strong="H02320"\w*, \w was Joab’s|strong="H03097"\w* \w brother|strong="H00251"\w* \w vvv|strong="H06214"\w* \w Asahel|strong="H06214"\w*, \w and his son|strong="H01121"\w* \w Zebadiah|strong="H02069"\w* \w was commander after him|strong="H00310"\w*. \w [There were] 24,000|strong="H06242"\w* \w . . .|strong="H00702"\w* \w . . .|strong="H00505"\w* \w [men] in|strong="H05921"\w* \w his division|strong="H04256"\w*.
\li1 \v 8 \w The fifth|strong="H02549"\w*, \w for the fifth|strong="H02549"\w* \w month|strong="H02320"\w*, \w was the commander|strong="H08269"\w* \w Shamhuth|strong="H08049"\w*\f + \fr 27:8 \fqa Shamhuth \ft is a variant of \fqa Shammoth \ft or \fqa Shammah\ft ; see 1 Chronicles 11:27 and 2 Samuel 23:25.\f* \w the Izrahite|strong="H03155"\w*. \w [There were] 24,000|strong="H06242"\w* \w . . .|strong="H00702"\w* \w . . .|strong="H00505"\w* \w [men] in|strong="H05921"\w* \w his division|strong="H04256"\w*.
