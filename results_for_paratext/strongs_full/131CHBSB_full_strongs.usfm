\li1 \w the weight|strong="H04948"\w* \w of each silver|strong="H03701"\w* \w lampstand|strong="H04501"\w* \w and its lamps|strong="H05216"\w*, \w according to the use|strong="H05656"\w* \w of each lampstand|strong="H04501"\w* \w . . .|strong="H04501"\w* \w . . .|strong="H04501"\w*;
