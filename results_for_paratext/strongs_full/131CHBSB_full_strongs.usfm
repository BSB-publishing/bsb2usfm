\li2 \w Pasach|strong="H06457"\w*, \w Bimhal|strong="H01118"\w*, \w and Ashvath|strong="H06220"\w*. \w These|strong="H00428"\w* \w were Japhlet’s|strong="H03310"\w* \w sons|strong="H01121"\w*.
\b 
