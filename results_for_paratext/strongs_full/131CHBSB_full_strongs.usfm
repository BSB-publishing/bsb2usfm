\li1 \v 6 \w Elkanah|strong="H00511"\w*, \w Isshiah|strong="H03449"\w*, \w Azarel|strong="H05832"\w*, \w Joezer|strong="H03134"\w*, \w and Jashobeam|strong="H03434"\w*, \w [who were] Korahites|strong="H07145"\w*;
\li1 \v 7 \w and Joelah|strong="H03132"\w* \w and Zebadiah|strong="H02069"\w*, \w the sons|strong="H01121"\w* \w of Jeroham|strong="H03395"\w* \w from|strong="H04480"\w* \w Gedor|strong="H01446"\w*.
\p \v 8 \w Some|strong="H04480"\w* \w Gadites|strong="H01425"\w* \w defected|strong="H00914"\w* \w to|strong="H00413"\w* \w David|strong="H01732"\w* \w at his stronghold|strong="H04679"\w* \w in the wilderness|strong="H04057"\w*. \w They were mighty|strong="H01368"\w* \w men|strong="H00376"\w* \w of valor|strong="H02428"\w*, \w trained|strong="H06635"\w* \w for battle|strong="H04421"\w*, \w experts|strong="H06186"\w* \w with the shield|strong="H06793"\w* \w and spear|strong="H07420"\w*, \w whose faces [were like]|strong="H06440"\w* \w the faces|strong="H06440"\w* \w of lions|strong="H00738"\w* \w and who were as swift|strong="H04116"\w* \w as gazelles|strong="H06643"\w* \w on|strong="H05921"\w* \w the mountains|strong="H02022"\w*:
\li1 \v 9 \w Ezer|strong="H05829"\w* \w the chief|strong="H07218"\w*, \w Obadiah|strong="H05662"\w* \w the second [in command]|strong="H08145"\w*, \w Eliab|strong="H00446"\w* \w the third|strong="H07992"\w*, \v 10 \w Mishmannah|strong="H04925"\w* \w the fourth|strong="H07243"\w*, \w Jeremiah|strong="H03414"\w* \w the fifth|strong="H02549"\w*, \v 11 \w Attai|strong="H06262"\w* \w the sixth|strong="H08345"\w*, \w Eliel|strong="H00447"\w* \w the seventh|strong="H07637"\w*, \v 12 \w Johanan|strong="H03076"\w* \w the eighth|strong="H08066"\w*, \w Elzabad|strong="H00443"\w* \w the ninth|strong="H08671"\w*, \v 13 \w Jeremiah|strong="H03414"\w* \w the tenth|strong="H06224"\w*, \w and Machbanai|strong="H04344"\w* \w the eleventh|strong="H06249"\w* \w . . .|strong="H06240"\w*.
\p \v 14 \w These|strong="H00428"\w* \w Gadites|strong="H01121"\w* \w . . .|strong="H01410"\w* \w were army|strong="H06635"\w*\w . . .|strong="H00259"\w* \w commanders|strong="H07218"\w*, \w the least [of whom]|strong="H06996"\w* \w was a match for a hundred|strong="H03967"\w*, \w and the greatest|strong="H01419"\w* \w for a thousand|strong="H00505"\w*.
\p \v 15 \w These|strong="H00428"\w* \w are|strong="H01992"\w* \w the ones who|strong="H00834"\w* \w crossed|strong="H05674"\w*\w . . .|strong="H00853"\w* \w the Jordan|strong="H03383"\w* \w in the first|strong="H07223"\w*\w . . .|strong="H01931"\w* \w month|strong="H02320"\w* \w when it was overflowing|strong="H04390"\w* \w . . .|strong="H05921"\w* \w all|strong="H03605"\w* \w its banks|strong="H01428"\w*, \w and they put to flight|strong="H01272"\w*\w . . .|strong="H00853"\w* \w all [those]|strong="H03605"\w* \w in the valleys|strong="H06010"\w*, \w [both] to the east|strong="H04217"\w* \w and to the west|strong="H04628"\w*.
\p \v 16 \w Other Benjamites|strong="H01121"\w* \w . . .|strong="H01144"\w* \w and some men from Judah|strong="H03063"\w*\w . . .|strong="H05704"\w* \w also came|strong="H00935"\w* \w . . .|strong="H04480"\w* \w to David|strong="H01732"\w* \w in his stronghold|strong="H04679"\w*. \v 17 \w And David|strong="H03318"\w* \w went out|strong="H01732"\w* \w to meet them|strong="H06440"\w*, \w . . .|strong="H06030"\w* \w saying|strong="H00559"\w* -, “\w If|strong="H00518"\w* \w you have come|strong="H00935"\w* \w to me|strong="H00413"\w* \w in peace|strong="H07965"\w* \w to help me|strong="H05826"\w*, my \w heart|strong="H03824"\w* \w will be|strong="H01961"\w* \w united|strong="H03162"\w* \w with you|strong="H05921"\w*; \w but if|strong="H00518"\w* \w you have come to betray me|strong="H07411"\w* \w to my enemies|strong="H06862"\w* \w when my hands|strong="H03709"\w* \w are free|strong="H03808"\w* \w of violence|strong="H02555"\w*, \w may the God|strong="H00430"\w* \w of our fathers|strong="H00001"\w* \w see [it]|strong="H07200"\w* \w and judge you|strong="H03198"\w*.”
\p \v 18 \w Then the Spirit|strong="H07307"\w* \w came upon|strong="H03847"\w*\w . . .|strong="H00853"\w* \w Amasai|strong="H06022"\w*, \w the chief|strong="H07218"\w* \w of the Thirty, and he said|strong="H07970"\w*:
\b 
\q1 “We are yours, \w O David|strong="H01732"\w*!
\q2 \w We are with you|strong="H05973"\w*, \w O son|strong="H01121"\w* \w of Jesse|strong="H03448"\w*!
\q1 \w Peace|strong="H07965"\w*, \w peace|strong="H07965"\w* to you,
\q2 \w and peace|strong="H07965"\w* \w to your helpers|strong="H05826"\w*,
\q2 \w for|strong="H03588"\w* \w your God|strong="H00430"\w* \w helps you|strong="H05826"\w*.”
\p \w So David|strong="H01732"\w* \w received them|strong="H06901"\w* \w and made them|strong="H05414"\w* \w leaders|strong="H07218"\w* \w of his troops|strong="H01416"\w*.
\p \v 19 \w Some from|strong="H05307"\w* \w Manasseh|strong="H04519"\w* \w defected|strong="H05921"\w* \w to David|strong="H01732"\w* \w when he went|strong="H00935"\w* \w with|strong="H05973"\w* \w the Philistines|strong="H06430"\w* \w to fight|strong="H05921"\w* \w against|strong="H07586"\w* \w Saul|strong="H04421"\w*. (\w They did not|strong="H03808"\w* \w help the Philistines|strong="H05826"\w* \w because|strong="H03588"\w* \w the Philistine|strong="H06430"\w* \w rulers|strong="H05633"\w* \w consulted|strong="H06098"\w* \w and sent David away|strong="H07971"\w*, \w saying|strong="H00559"\w*, “\w It will cost us our heads|strong="H07218"\w* \w if he defects|strong="H05307"\w* \w to|strong="H00413"\w* \w his master|strong="H00113"\w* \w Saul|strong="H07586"\w*.”) \v 20 \w When David went|strong="H01980"\w* \w to|strong="H00413"\w* \w Ziklag|strong="H06860"\w*, \w these men of Manasseh|strong="H04519"\w* \w defected|strong="H05307"\w* \w to him|strong="H05921"\w*:
\li1 \w Adnah|strong="H05734"\w*, \w Jozabad|strong="H03107"\w*, \w Jediael|strong="H03043"\w*, \w Michael|strong="H04317"\w*, \w Jozabad|strong="H03107"\w*, \w Elihu|strong="H00453"\w*, \w and Zillethai|strong="H06769"\w*, \w chiefs|strong="H07218"\w* \w of thousands|strong="H00505"\w* \w -|strong="H00834"\w* \w in Manasseh|strong="H04519"\w*.
\p \v 21 \w They|strong="H01992"\w* \w helped|strong="H05826"\w*\w . . .|strong="H05973"\w* \w David|strong="H01732"\w* \w against|strong="H05921"\w* \w the raiders|strong="H01416"\w*, \w for|strong="H03588"\w* \w they were|strong="H01961"\w* \w all|strong="H03605"\w* \w mighty men|strong="H01368"\w* \w of valor|strong="H02428"\w* \w and commanders|strong="H08269"\w* \w in the army|strong="H06635"\w*.
\p \v 22 \w For|strong="H03588"\w* \w at [that] time|strong="H06256"\w* \w men came|strong="H00935"\w* \w to|strong="H05921"\w* \w David|strong="H01732"\w* \w day|strong="H03117"\w* \w after day|strong="H03117"\w* \w to help him|strong="H05826"\w*, \w until|strong="H05704"\w* \w he had a great|strong="H01419"\w* \w army|strong="H04264"\w*, \w like the army|strong="H04264"\w* \w of God|strong="H00430"\w*.
\s1 David’s Army Grows at Hebron
\p \v 23 \w Now these [are]|strong="H00428"\w* \w the numbers|strong="H04557"\w* \w of men|strong="H07218"\w* \w armed|strong="H02502"\w* \w for battle|strong="H06635"\w* \w who came|strong="H00935"\w* \w to|strong="H05921"\w* \w David|strong="H01732"\w* \w at Hebron|strong="H02275"\w* \w to turn Saul’s|strong="H07586"\w* \w kingdom|strong="H04438"\w* \w over|strong="H05437"\w* \w to him|strong="H00413"\w*, \w in accordance with the word of|strong="H06310"\w* \w the LORD|strong="H03068"\w*:
