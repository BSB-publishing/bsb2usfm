\li2 \w Heber|strong="H02268"\w*, \w as well as Malchiel|strong="H04439"\w*, \w who|strong="H01931"\w* \w was the father of|strong="H00001"\w* \w Birzaith|strong="H01269"\w*.
\b 
\li1 \v 32 \w Heber|strong="H02268"\w* \w was the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Japhlet|strong="H03310"\w*, \w -|strong="H00853"\w* \w Shomer|strong="H07763"\w*, \w -|strong="H00853"\w* \w and Hotham|strong="H02369"\w*, \w and|strong="H00853"\w* \w of their sister|strong="H00269"\w* \w Shua|strong="H07774"\w*.
\b 
