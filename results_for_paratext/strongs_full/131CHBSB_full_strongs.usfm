\p \v 13 \w Once again|strong="H03254"\w* \w . . .|strong="H05750"\w* \w the Philistines|strong="H06430"\w* \w raided|strong="H06584"\w* \w the valley|strong="H06010"\w*. \v 14 \w So David|strong="H01732"\w* \w again|strong="H05750"\w* \w inquired|strong="H07592"\w* \w of God|strong="H00430"\w*, \w who|strong="H00430"\w* \w answered|strong="H00559"\w* him, “\w Do not|strong="H03808"\w* \w march up|strong="H05927"\w* \w after them|strong="H00310"\w*, \w but circle around|strong="H05437"\w* \w them|strong="H05921"\w* \w and attack|strong="H00935"\w* them \w in front of|strong="H04136"\w* \w the balsam trees|strong="H01057"\w*.\f + \fr 14:14 \ft Or \fqa aspen trees \ft or \fqa poplar trees\ft ; also in verse 15\f* \v 15 \w As soon as|strong="H01961"\w* \w you hear|strong="H08085"\w* \w -|strong="H00853"\w* \w the sound|strong="H06963"\w* \w of marching|strong="H06807"\w* \w in the tops|strong="H07218"\w* \w of the balsam trees|strong="H01057"\w*, \w vvv|strong="H00227"\w* \w move out|strong="H03318"\w* \w to battle|strong="H04421"\w*, \w because this will mean that|strong="H03588"\w* \w God|strong="H00430"\w* \w has gone out|strong="H03318"\w* \w before you|strong="H06440"\w* \w to strike|strong="H05221"\w* \w -|strong="H00853"\w* \w the camp|strong="H04264"\w* \w of the Philistines|strong="H06430"\w*.”
