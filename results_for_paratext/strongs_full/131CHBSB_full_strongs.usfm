\li1 \w and the plans|strong="H08403"\w* \w for the chariot|strong="H04818"\w* \w of the gold|strong="H02091"\w* \w cherubim|strong="H03742"\w* \w that spread [their wings]|strong="H06566"\w* \w and overshadowed|strong="H05526"\w* \w . . .|strong="H05921"\w* \w the ark|strong="H00727"\w* \w of the covenant|strong="H01285"\w* \w of the LORD|strong="H03068"\w*.
\p \v 19 “\w All this,” [said David]|strong="H03605"\w*, “\w all|strong="H03605"\w* \w the details|strong="H04399"\w* \w of this plan|strong="H08403"\w*, \w the LORD|strong="H03068"\w* \w has made clear to me|strong="H07919"\w* \w in writing|strong="H03791"\w* \w by [His] hand|strong="H03027"\w* \w upon me|strong="H05921"\w*.”
\p \v 20 \w David also|strong="H01732"\w* \w said|strong="H00559"\w* \w to Solomon|strong="H08010"\w* \w his son|strong="H01121"\w*, “\w Be strong|strong="H02388"\w* \w and courageous|strong="H00553"\w*, \w and do [it]|strong="H06213"\w*. \w Do not|strong="H00408"\w* \w be afraid|strong="H03372"\w* \w . . .|strong="H00408"\w* \w or discouraged|strong="H02865"\w*, \w for|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w God|strong="H00430"\w*, \w my God|strong="H00430"\w*, \w is with you|strong="H05973"\w*. \w He will neither|strong="H03808"\w* \w fail you|strong="H07503"\w* \w . . .|strong="H03808"\w* \w nor forsake you|strong="H05800"\w* \w before|strong="H05704"\w* \w all|strong="H03605"\w* \w the work|strong="H04399"\w* \w for the service|strong="H05656"\w* \w of the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w* \w is finished|strong="H03615"\w*. \v 21 \w The divisions|strong="H04256"\w* \w of the priests|strong="H03548"\w* \w and Levites|strong="H03881"\w* \w are ready|strong="H02009"\w* \w for all|strong="H03605"\w* \w the service|strong="H05656"\w* \w of the house|strong="H01004"\w* \w of God|strong="H00430"\w*, \w [and]|strong="H05973"\w* \w every|strong="H03605"\w* \w willing man|strong="H05081"\w* \w of every|strong="H03605"\w* \w skill|strong="H02451"\w* \w will be at your disposal for the work|strong="H04399"\w*. \w The officials|strong="H08269"\w* \w and all|strong="H03605"\w* \w . . .|strong="H05656"\w* \w the people|strong="H05971"\w* \w . . .|strong="H03605"\w* \w are fully at your|strong="H03605"\w* \w command|strong="H01697"\w*.”
\c 29
\s1 Offerings for the Temple
\p \v 1 \w Then King|strong="H04428"\w* \w David|strong="H01732"\w* \w said|strong="H00559"\w* \w to the whole|strong="H03605"\w* \w assembly|strong="H06951"\w*, “\w My son|strong="H01121"\w* \w Solomon|strong="H08010"\w*, \w the one|strong="H00259"\w* whom \w God|strong="H00430"\w* \w has chosen|strong="H00977"\w*, \w is young|strong="H05288"\w* \w and inexperienced|strong="H07390"\w*. \w The task|strong="H04399"\w* \w is great|strong="H01419"\w* \w because|strong="H03588"\w* \w this palace|strong="H01002"\w* \w is not|strong="H03808"\w* \w for man|strong="H00120"\w*, \w but|strong="H03588"\w* \w for the LORD|strong="H03068"\w* \w God|strong="H00430"\w*. \v 2 \w Now with all|strong="H03605"\w* \w my ability|strong="H03581"\w* \w I have made provision|strong="H03559"\w* \w for the house|strong="H01004"\w* \w of my God|strong="H00430"\w* — \w gold|strong="H02091"\w* \w for the gold articles|strong="H02091"\w*, \w silver|strong="H03701"\w* \w for the silver|strong="H03701"\w*, \w bronze|strong="H05178"\w* \w for the bronze|strong="H05178"\w*, \w iron|strong="H01270"\w* \w for the iron|strong="H01270"\w*, \w and wood|strong="H06086"\w* \w for the wood|strong="H06086"\w*, \w as well as onyx|strong="H00068"\w* \w . . .|strong="H07718"\w* \w for the settings|strong="H04394"\w*, \w turquoise|strong="H00068"\w* \w . . .|strong="H06320"\w*, \w stones of various colors|strong="H07553"\w*, \w all kinds|strong="H03605"\w* \w of precious|strong="H03368"\w* \w stones|strong="H00068"\w*, \w and slabs|strong="H00068"\w* \w of marble|strong="H07893"\w* — \w all in abundance|strong="H07230"\w*.
\p \v 3 \w Moreover|strong="H05750"\w*, \w because of my delight|strong="H07521"\w* \w in the house|strong="H01004"\w* \w of my God|strong="H00430"\w*, \w . . .|strong="H03426"\w* \w I now give|strong="H05414"\w* \w for [it]|strong="H01004"\w* \w . . .|strong="H00430"\w* \w my personal treasures|strong="H05459"\w* \w of gold|strong="H02091"\w* \w and silver|strong="H03701"\w*, \w over and above|strong="H04605"\w* \w all|strong="H03605"\w* \w that I have provided|strong="H03559"\w* \w for this holy|strong="H06944"\w* \w temple|strong="H01004"\w*: \v 4 \w three|strong="H07969"\w* \w thousand|strong="H00505"\w* \w talents|strong="H03603"\w* \w of gold|strong="H02091"\w*\f + \fr 29:4 \fqa 3,000 talents \ft is approximately 113 tons or 103 metric tons of gold.\f* (\w the gold|strong="H02091"\w* \w of Ophir|strong="H00211"\w*) \w and seven|strong="H07651"\w* \w thousand|strong="H00505"\w* \w talents|strong="H03603"\w* \w of refined|strong="H02212"\w* \w silver|strong="H03701"\w*,\f + \fr 29:4 \fqa 7,000 talents \ft is approximately 264 tons or 239.5 metric tons of silver.\f* \w to overlay|strong="H02902"\w* \w the walls|strong="H07023"\w* \w of the buildings|strong="H01004"\w*, \v 5 \w vvv|strong="H02091"\w* \w for the gold work|strong="H02091"\w* \w and the silver work|strong="H03701"\w* \w . . .|strong="H03701"\w*, \w and for all|strong="H03605"\w* \w the work|strong="H04399"\w* \w to be done by|strong="H03027"\w* \w the craftsmen|strong="H02796"\w*. \w Now who|strong="H04310"\w* \w is willing|strong="H05068"\w* \w to consecrate|strong="H04390"\w* \w himself|strong="H03027"\w* \w to the LORD|strong="H03068"\w* \w today|strong="H03117"\w*?”
\p \v 6 \w Then the leaders|strong="H08269"\w* \w of the families|strong="H00001"\w*, \w the officers|strong="H08269"\w* \w of the tribes|strong="H07626"\w* \w of Israel|strong="H03478"\w*, \w the commanders|strong="H08269"\w* \w of thousands|strong="H00505"\w* \w and of hundreds|strong="H03967"\w*, \w and the officials|strong="H08269"\w* \w in charge of the king’s|strong="H04428"\w* \w work|strong="H04399"\w* \w gave willingly|strong="H05068"\w*. \v 7 \w Toward the service|strong="H05656"\w* \w of God’s|strong="H00430"\w* \w house|strong="H01004"\w* \w they gave|strong="H05414"\w* \w 5,000 {}|strong="H02568"\w* \w . . .|strong="H00505"\w* \w talents|strong="H03603"\w*\f + \fr 29:7 \fqa 5,000 talents \ft is approximately 188.5 tons or 171 metric tons of gold.\f* \w and 10,000|strong="H07239"\w* \w darics|strong="H00150"\w* \w of gold|strong="H02091"\w*,\f + \fr 29:7 \ft Or \fqa 10,000 gold drachmas\ft ; that is, approximately 185.2 pounds or 84 kilograms of gold coins\f* \w 10,000 {}|strong="H06235"\w* \w . . .|strong="H00505"\w* \w talents|strong="H03603"\w* \w of silver|strong="H03701"\w*,\f + \fr 29:7 \fqa 10,000 talents \ft is approximately 377 tons or 342 metric tons of silver.\f* \w 18,000 {}|strong="H07239"\w* \w . . .|strong="H08083"\w* \w . . .|strong="H00505"\w* \w talents|strong="H03603"\w* \w of bronze|strong="H05178"\w*,\f + \fr 29:7 \fqa 18,000 talents \ft is approximately 678.6 tons or 615.6 metric tons of bronze.\f* \w and 100,000|strong="H03967"\w* \w . . .|strong="H00505"\w* \w talents|strong="H03603"\w* \w of iron|strong="H01270"\w*.\f + \fr 29:7 \fqa 100,000 talents \ft is approximately 3,770 tons or 3,420 metric tons of iron.\f* \v 8 \w Whoever had|strong="H04672"\w* \w . . .|strong="H00854"\w* \w precious stones|strong="H00068"\w* \w gave them|strong="H05414"\w* \w to the treasury|strong="H00214"\w* \w of the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*, \w under|strong="H05921"\w* \w the care|strong="H03027"\w* \w of Jehiel|strong="H03171"\w*\f + \fr 29:8 \fqa Jehiel \ft is a variant of \fqa Jehieli\ft ; see 1 Chronicles 26:21.\f* \w the Gershonite|strong="H01649"\w*. \v 9 \w And the people|strong="H05971"\w* \w rejoiced|strong="H08055"\w* \w at|strong="H05921"\w* \w the willing response of their leaders|strong="H05068"\w*, \w for|strong="H03588"\w* \w they had given|strong="H05068"\w* \w to the LORD {freely}|strong="H03068"\w* \w vvv|strong="H03820"\w* \w and wholeheartedly|strong="H08003"\w*. \w And King|strong="H04428"\w* \w David|strong="H01732"\w* \w also|strong="H01571"\w* \w rejoiced|strong="H08055"\w* \w . . .|strong="H08057"\w* \w greatly|strong="H01419"\w*.
\s1 David’s Prayer of Blessing
\p \v 10 \w Then David|strong="H01732"\w* \w -|strong="H00853"\w* \w blessed|strong="H01288"\w* \w the LORD|strong="H03068"\w* \w in the sight|strong="H05869"\w* \w of all|strong="H03605"\w* \w the assembly|strong="H06951"\w* \w [and]|strong="H01732"\w* \w said|strong="H00559"\w*:
\pmo “\w May You|strong="H00859"\w* \w be blessed|strong="H01288"\w*, \w O LORD|strong="H03068"\w*, \w God|strong="H00430"\w* \w of our father|strong="H00001"\w* \w Israel|strong="H03478"\w*, \w from everlasting|strong="H05769"\w* \w to|strong="H05704"\w* \w everlasting|strong="H05769"\w*.
\pmo \v 11 Yours, \w O LORD|strong="H03068"\w*, \w is the greatness|strong="H01420"\w* \w and the power|strong="H01369"\w* \w and the glory|strong="H08597"\w* \w and the splendor|strong="H01935"\w* \w and the majesty|strong="H05331"\w*, \w for|strong="H03588"\w* \w everything|strong="H03605"\w* \w in heaven|strong="H08064"\w* \w and on earth belongs to You|strong="H00776"\w*.
\pmo Yours, \w O LORD|strong="H03068"\w*, \w is the kingdom|strong="H04467"\w*, \w and You are exalted|strong="H05375"\w* \w as head|strong="H07218"\w* \w over all|strong="H03605"\w*. \v 12 \w Both riches|strong="H06239"\w* \w and honor|strong="H03519"\w* \w come from You|strong="H06440"\w*, \w and You|strong="H00859"\w* \w are the ruler|strong="H04910"\w* \w over all|strong="H03605"\w*. \w In Your hands|strong="H03027"\w* \w [are] power|strong="H03581"\w* \w and might|strong="H01369"\w* \w -|strong="H03027"\w* \w to exalt|strong="H01431"\w* \w and give strength|strong="H02388"\w* \w to all|strong="H03605"\w*.
\pmo \v 13 \w Now therefore|strong="H06258"\w*, \w our God|strong="H00430"\w*, \w we|strong="H00587"\w* vvv \w give You thanks|strong="H03034"\w*, \w and we praise|strong="H01984"\w* \w Your glorious|strong="H08597"\w* \w name|strong="H08034"\w*. \v 14 \w But|strong="H03588"\w* \w who [am]|strong="H04310"\w* \w I|strong="H00589"\w*, \w and who|strong="H04310"\w* \w are my people|strong="H05971"\w*, \w that|strong="H03588"\w* \w we should be able|strong="H06113"\w* \w . . .|strong="H03581"\w* \w to give as generously|strong="H05068"\w* \w as this|strong="H02063"\w*? \w For|strong="H03588"\w* \w everything|strong="H03605"\w* \w comes from You|strong="H04480"\w*, \w and from Your own hand|strong="H03027"\w* \w we have given|strong="H05414"\w* to You. \v 15 \w For|strong="H03588"\w* \w we|strong="H00587"\w* \w [are] foreigners|strong="H01616"\w* \w and strangers|strong="H08453"\w* \w in Your presence|strong="H06440"\w*, \w as were all|strong="H03605"\w* \w our forefathers|strong="H00001"\w*. \w Our days|strong="H03117"\w* \w on|strong="H05921"\w* \w earth|strong="H00776"\w* \w are like a shadow|strong="H06738"\w*, \w without|strong="H00369"\w* \w hope|strong="H04723"\w*.
\pmo \v 16 \w O LORD|strong="H03068"\w* \w our God|strong="H00430"\w*, \w from Your hand|strong="H03027"\w* \w comes|strong="H01931"\w* \w all|strong="H03605"\w* \w this|strong="H02088"\w* \w abundance|strong="H01995"\w* \w that|strong="H00834"\w* \w we have provided|strong="H03559"\w* \w to build|strong="H01129"\w* You \w a house|strong="H01004"\w* \w for Your holy|strong="H06944"\w* \w Name|strong="H08034"\w*, \w and all of it|strong="H03605"\w* belongs to You. \v 17 \w I know|strong="H03045"\w*, \w my God|strong="H00430"\w*, \w that|strong="H03588"\w* \w You|strong="H00859"\w* \w test|strong="H00974"\w* \w the heart|strong="H03824"\w* \w and delight|strong="H07521"\w* \w in uprightness|strong="H04339"\w*. \w All|strong="H03605"\w* \w these things|strong="H00428"\w* \w I|strong="H00589"\w* \w have given willingly|strong="H05068"\w* \w and with an upright|strong="H03476"\w* \w heart|strong="H03824"\w*, \w and now|strong="H06258"\w* \w I have seen|strong="H07200"\w* \w Your people|strong="H05971"\w* \w who are present|strong="H04672"\w* \w here|strong="H06311"\w* \w giving joyfully|strong="H08057"\w* \w and willingly|strong="H05068"\w* to You.
\pmo \v 18 \w O LORD|strong="H03068"\w*, \w God|strong="H00430"\w* \w of our fathers|strong="H00001"\w* \w Abraham|strong="H00085"\w*, \w Isaac|strong="H03327"\w*, \w and Israel|strong="H03478"\w*, \w keep|strong="H08104"\w* \w this|strong="H02063"\w* \w desire|strong="H03336"\w* \w forever|strong="H05769"\w* \w in the intentions|strong="H04284"\w* \w of the hearts|strong="H03824"\w* \w of Your people|strong="H05971"\w*, \w and direct|strong="H03559"\w* \w their hearts|strong="H03824"\w* \w toward You|strong="H00413"\w*. \v 19 \w And give|strong="H05414"\w* \w my son|strong="H01121"\w* \w Solomon|strong="H08010"\w* \w a whole|strong="H08003"\w* \w heart|strong="H03824"\w* \w to keep|strong="H08104"\w* \w and carry out|strong="H06213"\w* \w all|strong="H03605"\w* \w Your commandments|strong="H04687"\w*, \w decrees|strong="H05715"\w*, \w and statutes|strong="H02706"\w*, \w and to build|strong="H01129"\w* \w [Your] palace|strong="H01002"\w* \w for which|strong="H00834"\w* \w I have made provision|strong="H03559"\w*.”
\p \v 20 \w Then David|strong="H01732"\w* \w said|strong="H00559"\w* \w to the whole|strong="H03605"\w* \w assembly|strong="H06951"\w*, “\w Bless|strong="H01288"\w* \w . . .|strong="H04994"\w* \w -|strong="H00853"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*.”
\p \w So the whole|strong="H03605"\w* \w assembly|strong="H06951"\w* \w blessed|strong="H01288"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of their fathers|strong="H00001"\w*. \w They bowed down|strong="H06915"\w* \w and paid homage|strong="H07812"\w* \w to the LORD|strong="H03068"\w* \w and to the king|strong="H04428"\w*.
\s1 Solomon Anointed King
\r (1 Kings 1:32–40)
\p \v 21 \w The next day|strong="H04283"\w* \w . . .|strong="H03117"\w* \w . . .|strong="H01931"\w* \w they offered|strong="H02076"\w* \w sacrifices|strong="H02077"\w* \w . . .|strong="H05927"\w* \w -|strong="H03068"\w* \w and presented burnt offerings|strong="H05930"\w* \w to the LORD|strong="H03068"\w*: \w a thousand|strong="H00505"\w* \w bulls|strong="H06499"\w*, \w a thousand|strong="H00505"\w* \w rams|strong="H00352"\w*, \w and a thousand|strong="H00505"\w* \w lambs|strong="H03532"\w*, \w along with their drink offerings|strong="H05262"\w*, \w and other sacrifices|strong="H02077"\w* \w in abundance|strong="H07230"\w* \w for all|strong="H03605"\w* \w Israel|strong="H03478"\w*. \v 22 \w That|strong="H01931"\w* \w day|strong="H03117"\w* \w they ate|strong="H00398"\w* \w and drank|strong="H08354"\w* \w with great|strong="H01419"\w* \w joy|strong="H08057"\w* \w in the presence|strong="H06440"\w* \w of the LORD|strong="H03068"\w*.
\p \w Then, for a second|strong="H08145"\w* \w time, they designated David’s|strong="H01732"\w* \w son|strong="H01121"\w* \w Solomon|strong="H08010"\w* \w as king|strong="H04427"\w*, \w anointing him|strong="H04886"\w* \w before the LORD|strong="H03068"\w* \w as ruler|strong="H05057"\w*, \w and Zadok|strong="H06659"\w* \w as the priest|strong="H03548"\w*.
\p \v 23 \w So Solomon|strong="H08010"\w* \w sat|strong="H03427"\w* \w on|strong="H05921"\w* \w the throne|strong="H03678"\w* \w of the LORD|strong="H03068"\w* \w as king|strong="H04428"\w* \w in place of|strong="H08478"\w* \w his father|strong="H00001"\w* \w David|strong="H01732"\w*. \w He prospered|strong="H06743"\w*, \w and all|strong="H03605"\w* \w Israel|strong="H03478"\w* \w obeyed him|strong="H08085"\w*. \w . . .|strong="H00413"\w* \v 24 \w All|strong="H03605"\w* \w the officials|strong="H08269"\w* \w and mighty men|strong="H01368"\w*, \w as well as|strong="H01571"\w* \w all|strong="H03605"\w* \w of King|strong="H04428"\w* \w David’s|strong="H01732"\w* \w sons|strong="H01121"\w*, \w pledged|strong="H05414"\w* \w their allegiance|strong="H03027"\w* \w to|strong="H08478"\w* \w King|strong="H04428"\w* \w Solomon|strong="H08010"\w*.
