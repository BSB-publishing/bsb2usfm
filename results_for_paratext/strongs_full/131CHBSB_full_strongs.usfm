\li2 \w Ahi|strong="H00277"\w*, \w Rohgah|strong="H07303"\w*,\f + \fr 7:34 \ft Or \fqa The sons of his brother Shemer: Rohgah\ft ; note that \fqa Shemer \ft is a variant of \fqa Shomer\ft ; see verse 32.\f* \w Hubbah|strong="H03160"\w*, \w and Aram|strong="H00758"\w*.
\b 
\li1 \v 35 \w The sons|strong="H01121"\w* \w of his brother|strong="H00251"\w* \w Helem|strong="H01987"\w*:\f + \fr 7:35 \fqa Helem \ft is possibly another name for \fqa Hotham\ft ; see verse 32.\f*
\li2 \w Zophah|strong="H06690"\w*, \w Imna|strong="H03234"\w*, \w Shelesh|strong="H08028"\w*, \w and Amal|strong="H06000"\w*.
\b 
\li1 \v 36 \w The sons|strong="H01121"\w* \w of Zophah|strong="H06690"\w*:
\li2 \w Suah|strong="H05477"\w*, \w Harnepher|strong="H02774"\w*, \w Shual|strong="H07777"\w*, \w Beri|strong="H01275"\w*, \w Imrah|strong="H03236"\w*, \v 37 \w Bezer|strong="H01221"\w*, \w Hod|strong="H01936"\w*, \w Shamma|strong="H08037"\w*, \w Shilshah|strong="H08030"\w*, \w Ithran|strong="H03506"\w*,\f + \fr 7:37 \fqa Ithran \ft is possibly a variant of \fqa Jether\ft ; see verse 38.\f* \w and Beera|strong="H00878"\w*.
\b 
