\p \v 1 \w So they brought|strong="H00935"\w* \w -|strong="H00853"\w* \w the ark|strong="H00727"\w* \w of God|strong="H00430"\w* \w and placed|strong="H03322"\w* \w -|strong="H00853"\w* \w it inside|strong="H08432"\w* \w the tent|strong="H00168"\w* \w that|strong="H00834"\w* \w David|strong="H01732"\w* \w had pitched|strong="H05186"\w* for it. \w And they presented|strong="H07126"\w* \w burnt offerings|strong="H05930"\w* \w and peace offerings|strong="H08002"\w* \w before|strong="H06440"\w* \w God|strong="H00430"\w*. \v 2 \w When David|strong="H01732"\w* \w had finished|strong="H03615"\w* \w sacrificing|strong="H05927"\w* \w the burnt offerings|strong="H05930"\w* \w and peace offerings|strong="H08002"\w*, \w he blessed|strong="H01288"\w* \w -|strong="H00853"\w* \w the people|strong="H05971"\w* \w in the name|strong="H08034"\w* \w of the LORD|strong="H03068"\w*. \v 3 \w Then he distributed|strong="H02505"\w* \w to every|strong="H03605"\w* \w . . .|strong="H00376"\w* \w man|strong="H00376"\w* \w and|strong="H05704"\w* \w woman|strong="H00802"\w* \w . . .|strong="H00376"\w* \w of Israel|strong="H03478"\w* \w a loaf|strong="H03603"\w* \w of bread|strong="H03899"\w*, \w a date cake|strong="H00829"\w*,\f + \fr 16:3 \ft Or \fqa a portion of meat\f* \w and a raisin cake|strong="H00809"\w*.
