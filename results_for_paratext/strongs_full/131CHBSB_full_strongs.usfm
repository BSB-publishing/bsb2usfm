\li1 \v 17 \w [the weight of] the pure|strong="H02889"\w* \w gold|strong="H02091"\w* \w for the forks|strong="H04207"\w*, \w sprinkling bowls|strong="H04219"\w*, \w and pitchers|strong="H07184"\w*;
\li1 \w the weight|strong="H04948"\w* \w of each gold|strong="H02091"\w* \w dish|strong="H03713"\w* \w . . .|strong="H03713"\w*;
