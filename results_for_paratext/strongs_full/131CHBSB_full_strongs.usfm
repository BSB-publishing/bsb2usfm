\li2 \v 24 \w [So from] Shem [came]|strong="H08035"\w* \w Arphaxad|strong="H00775"\w*, \w Shelah|strong="H07974"\w*,\f + \fr 1:24 \ft Literally \fqa Shem, Arphaxad, Shelah\ft ; some LXX manuscripts \fqa Shem, Arphaxad, Cainan, Shelah\ft ; see also Genesis 10:24 LXX and Luke 3:35–36.\f* \v 25 \w Eber|strong="H05677"\w*, \w Peleg|strong="H06389"\w*, \w Reu|strong="H07466"\w*, \v 26 \w Serug|strong="H08286"\w*, \w Nahor|strong="H05152"\w*, \w Terah|strong="H08646"\w*, \v 27 \w and Abram|strong="H00087"\w* \w (that is|strong="H01931"\w*, \w Abraham|strong="H00085"\w*).
\s1 The Descendants of Abraham
\r (Genesis 25:12–18)
\p \v 28 \w The sons|strong="H01121"\w* \w of Abraham|strong="H00085"\w* \w [were] Isaac|strong="H03327"\w* \w and Ishmael|strong="H03458"\w*. \v 29 \w These [are]|strong="H00428"\w* \w their genealogies|strong="H08435"\w*:
\b 
\li1 \w Nebaioth|strong="H05032"\w* \w the firstborn|strong="H01060"\w* \w of Ishmael|strong="H03458"\w*, \w then Kedar|strong="H06938"\w*, \w Adbeel|strong="H00110"\w*, \w Mibsam|strong="H04017"\w*, \v 30 \w Mishma|strong="H04927"\w*, \w Dumah|strong="H01746"\w*, \w Massa|strong="H04854"\w*, \w Hadad|strong="H02301"\w*, \w Tema|strong="H08485"\w*, \v 31 \w Jetur|strong="H03195"\w*, \w Naphish|strong="H05305"\w*, \w and Kedemah|strong="H06929"\w*. \w These|strong="H00428"\w* \w were|strong="H01992"\w* \w the sons|strong="H01121"\w* \w of Ishmael|strong="H03458"\w*.
\b 
\li1 \v 32 \w The sons|strong="H01121"\w* \w born|strong="H03205"\w* \w -|strong="H00853"\w* \w to Keturah|strong="H06989"\w*, \w Abraham’s|strong="H00085"\w* \w concubine|strong="H06370"\w*:
