\p \v 23 \w David|strong="H01732"\w* \w did not|strong="H03808"\w* \w count|strong="H05375"\w* \w . . .|strong="H04557"\w* \w the men|strong="H01121"\w* \w aged|strong="H08141"\w* \w twenty|strong="H06242"\w* \w or under|strong="H04295"\w*, \w because|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w had said that|strong="H00559"\w* \w He would make Israel|strong="H03478"\w* \w as numerous|strong="H07235"\w* \w -|strong="H00853"\w* \w as the stars|strong="H03556"\w* \w of the sky|strong="H08064"\w*. \v 24 \w Joab|strong="H03097"\w* \w son|strong="H01121"\w* \w of Zeruiah|strong="H06870"\w* \w began|strong="H02490"\w* \w to count [the men]|strong="H04487"\w* \w but did not|strong="H03808"\w* \w finish|strong="H03615"\w*. \w For because of this [census]|strong="H02063"\w* \w wrath|strong="H07110"\w* \w came|strong="H01961"\w* \w upon|strong="H05921"\w* \w Israel|strong="H03478"\w*, \w and the number|strong="H04557"\w* \w was not|strong="H03808"\w* \w entered|strong="H05927"\w* \w . . .|strong="H04557"\w* \w in the Book|strong="H01697"\w* \w of the Chronicles|strong="H03117"\w* \w of King|strong="H04428"\w* \w David|strong="H01732"\w*.
