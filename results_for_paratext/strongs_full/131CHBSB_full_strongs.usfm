\li1 \v 18 \w The Reubenites|strong="H01121"\w* \w . . .|strong="H07205"\w*, \w the Gadites|strong="H01425"\w*, \w and the half-tribe|strong="H02677"\w* \w . . .|strong="H07626"\w* \w of Manasseh|strong="H04519"\w* \w . . .|strong="H04480"\w* \w had 44,760|strong="H00705"\w* \w . . .|strong="H00702"\w* \w . . .|strong="H00505"\w* \w . . .|strong="H07651"\w* \w . . .|strong="H03967"\w* \w . . .|strong="H08346"\w* \w warriors|strong="H03318"\w* \w . . .|strong="H06635"\w*— \w vvv|strong="H01121"\w* \w valiant|strong="H02428"\w* \w men|strong="H00582"\w* \w who carried|strong="H05375"\w* \w the shield|strong="H04043"\w* \w and sword|strong="H02719"\w*, \w drew|strong="H01869"\w* \w the bow|strong="H07198"\w*, \w and were trained|strong="H03925"\w* \w for battle|strong="H04421"\w*. \v 19 \w They waged|strong="H06213"\w* \w war|strong="H04421"\w* \w against|strong="H05973"\w* \w the Hagrites|strong="H01905"\w*, \w as well as Jetur|strong="H03195"\w*, \w Naphish|strong="H05305"\w*, \w and Nodab|strong="H05114"\w*.
