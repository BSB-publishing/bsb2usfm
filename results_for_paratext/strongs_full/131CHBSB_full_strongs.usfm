\s1 The Kings of Edom
\r (Genesis 36:31–43)
\p \v 43 \w These [are]|strong="H00428"\w* \w the kings|strong="H04428"\w* \w who|strong="H00834"\w* \w reigned|strong="H04427"\w* \w in the land|strong="H00776"\w* \w of Edom|strong="H00123"\w* \w before|strong="H06440"\w* \w any king|strong="H04428"\w* \w reigned|strong="H04427"\w* \w over the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*:\f + \fr 1:43 \ft Or \fqa before an Israelite king ruled over them\f*
\b 
\li1 \w Bela|strong="H01106"\w* \w son|strong="H01121"\w* \w of Beor|strong="H01160"\w*. \w His city|strong="H05892"\w* \w was named|strong="H08034"\w* \w Dinhabah|strong="H01838"\w*.
\b 
\li1 \v 44 \w When Bela|strong="H01106"\w* \w died|strong="H04191"\w*, \w Jobab|strong="H03103"\w* \w son|strong="H01121"\w* \w of Zerah|strong="H02226"\w* \w from Bozrah|strong="H01224"\w* \w reigned|strong="H04427"\w* \w in his place|strong="H08478"\w*.
\b 
\li1 \v 45 \w When Jobab|strong="H03103"\w* \w died|strong="H04191"\w*, \w Husham|strong="H02367"\w* \w from the land|strong="H00776"\w* \w of the Temanites|strong="H08489"\w* \w reigned|strong="H04427"\w* \w in his place|strong="H08478"\w*.
\b 
\li1 \v 46 \w When Husham|strong="H02367"\w* \w died|strong="H04191"\w*, \w Hadad|strong="H01908"\w* \w son|strong="H01121"\w* \w of Bedad|strong="H00911"\w*, \w who defeated|strong="H05221"\w* \w -|strong="H00853"\w* \w Midian|strong="H04080"\w* \w in the country|strong="H07704"\w* \w of Moab|strong="H04124"\w*, \w reigned|strong="H04427"\w* \w in his place|strong="H08478"\w*. \w And the name|strong="H08034"\w* \w of his city|strong="H05892"\w* \w was Avith|strong="H05762"\w*.
\b 
\li1 \v 47 \w When Hadad|strong="H01908"\w* \w died|strong="H04191"\w*, \w Samlah|strong="H08072"\w* \w from Masrekah|strong="H04957"\w* \w reigned|strong="H04427"\w* \w in his place|strong="H08478"\w*.
\b 
\li1 \v 48 \w When Samlah|strong="H08072"\w* \w died|strong="H04191"\w*, \w Shaul|strong="H07586"\w* \w from Rehoboth|strong="H07344"\w* \w on the Euphrates|strong="H05104"\w*\f + \fr 1:48 \ft Hebrew \fqa the River\f* \w reigned|strong="H04427"\w* \w in his place|strong="H08478"\w*.
\b 
\li1 \v 49 \w When Shaul|strong="H07586"\w* \w died|strong="H04191"\w*, \w vvv|strong="H01177"\w* \w Baal-hanan|strong="H01177"\w* \w son|strong="H01121"\w* \w of Achbor|strong="H05907"\w* \w reigned|strong="H04427"\w* \w in his place|strong="H08478"\w*.
\b 
\li1 \v 50 \w vvv|strong="H01177"\w* \w When Baal-hanan|strong="H01177"\w* \w died|strong="H04191"\w*, \w Hadad|strong="H01908"\w* \w reigned|strong="H04427"\w* \w in his place|strong="H08478"\w*. \w His city|strong="H05892"\w* \w was named|strong="H08034"\w* \w Pau|strong="H06464"\w*,\f + \fr 1:50 \ft Many MT manuscripts, some LXX manuscripts, Vulgate, and Syriac (see also Genesis 36:39); most MT manuscripts \fqa Pai\f* \w and his wife’s|strong="H00802"\w* \w name|strong="H08034"\w* \w was Mehetabel|strong="H04105"\w* \w daughter|strong="H01323"\w* \w of Matred|strong="H04308"\w*, \w the daughter|strong="H01323"\w* \w vvv|strong="H04314"\w* \w of Me-zahab|strong="H04314"\w*.
\b 
\li1 \v 51 \w Then Hadad|strong="H01908"\w* \w . . .|strong="H01961"\w* \w died|strong="H04191"\w*.
\p \w Now the chiefs|strong="H00441"\w* \w of Edom [were]|strong="H00123"\w* \w . . .|strong="H00441"\w* \w Timna|strong="H08555"\w*, \w . . .|strong="H00441"\w* \w Alvah|strong="H05933"\w*, \w . . .|strong="H00441"\w* \w Jetheth|strong="H03509"\w*, \v 52 \w -|strong="H00441"\w* \w Oholibamah|strong="H00173"\w*, \w . . .|strong="H00441"\w* \w Elah|strong="H00425"\w*, \w . . .|strong="H00441"\w* \w Pinon|strong="H06373"\w*, \v 53 \w -|strong="H00441"\w* \w Kenaz|strong="H07073"\w*, \w . . .|strong="H00441"\w* \w Teman|strong="H08487"\w*, \w . . .|strong="H00441"\w* \w Mibzar|strong="H04014"\w*, \v 54 \w -|strong="H00441"\w* \w Magdiel|strong="H04025"\w*, \w . . .|strong="H00441"\w* \w and Iram|strong="H05902"\w*. \w These|strong="H00428"\w* \w [were] the chiefs|strong="H00441"\w* \w of Edom|strong="H00123"\w*.
\c 2
\s1 The Sons of Israel
\r (Genesis 35:21–26; Genesis 38:1–30)
\p \v 1 \w These [were]|strong="H00428"\w* \w the sons|strong="H01121"\w* \w of Israel|strong="H03478"\w*:
\b 
\li1 \w Reuben|strong="H07205"\w*, \w Simeon|strong="H08095"\w*, \w Levi|strong="H03878"\w*, \w Judah|strong="H03063"\w*, \w Issachar|strong="H03485"\w*, \w Zebulun|strong="H02074"\w*, \v 2 \w Dan|strong="H01835"\w*, \w Joseph|strong="H03130"\w*, \w Benjamin|strong="H01144"\w*, \w Naphtali|strong="H05321"\w*, \w Gad|strong="H01410"\w*, \w and Asher|strong="H00836"\w*.
\b 
\li1 \v 3 \w The sons|strong="H01121"\w* \w of Judah|strong="H03063"\w*:
\li2 \w Er|strong="H06147"\w*, \w Onan|strong="H00209"\w*, \w and Shelah|strong="H07956"\w*. \w These three|strong="H07969"\w* \w were born|strong="H03205"\w* to him by \w . . .|strong="H01323"\w* \w Bath-shua|strong="H07774"\w* \w the Canaanite|strong="H03669"\w*. \w Er|strong="H06147"\w*, \w Judah’s|strong="H03063"\w* \w firstborn|strong="H01060"\w*, \w was|strong="H01961"\w* \w wicked|strong="H07451"\w* \w in the sight|strong="H05869"\w* \w of the LORD|strong="H03068"\w*. \w So [the LORD] put him to death|strong="H04191"\w*.
\li2 \v 4 \w Tamar|strong="H08559"\w*, \w Judah’s daughter-in-law|strong="H03618"\w*, \w bore|strong="H03205"\w* to him \w -|strong="H00853"\w* \w Perez|strong="H06557"\w* \w -|strong="H00853"\w* \w and Zerah|strong="H02226"\w*. \w Judah|strong="H03063"\w* \w had five|strong="H02568"\w* \w sons|strong="H01121"\w* \w in all|strong="H03605"\w*.
\b 
\li1 \v 5 \w The sons|strong="H01121"\w* \w of Perez|strong="H06557"\w*:
\li2 \w Hezron|strong="H02696"\w* \w and Hamul|strong="H02538"\w*.
\b 
\li1 \v 6 \w The sons|strong="H01121"\w* \w of Zerah|strong="H02226"\w*:
