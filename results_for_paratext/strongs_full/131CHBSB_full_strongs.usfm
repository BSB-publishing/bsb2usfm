\p \v 62 \w The Gershomites|strong="H01121"\w*\f + \fr 6:62 \fqa Gershomites \ft is a variant of \fqa Gershonites\ft ; also in verse 71; see 1 Chronicles 23:7.\f* \w . . .|strong="H01647"\w*, \w according to their clans|strong="H04940"\w*, \w [were allotted] thirteen|strong="H07969"\w* \w . . .|strong="H06240"\w* \w cities|strong="H05892"\w* \w from the tribes|strong="H04294"\w* \w of Issachar|strong="H03485"\w*, \w . . .|strong="H04294"\w* \w Asher|strong="H00836"\w*, \w . . .|strong="H04294"\w* \w Naphtali|strong="H05321"\w*, \w . . .|strong="H04294"\w* \w and Manasseh|strong="H04519"\w* \w in Bashan|strong="H01316"\w*.
\p \v 63 \w The Merarites|strong="H01121"\w* \w . . .|strong="H04847"\w*, \w according to their clans|strong="H04940"\w*, \w were allotted|strong="H01486"\w* \w twelve|strong="H08147"\w* \w . . .|strong="H06240"\w* \w cities|strong="H05892"\w* \w from the tribes|strong="H04294"\w* \w of Reuben|strong="H07205"\w*, \w . . .|strong="H04294"\w* \w Gad|strong="H01410"\w*, \w . . .|strong="H04294"\w* \w and Zebulun|strong="H02074"\w*.
