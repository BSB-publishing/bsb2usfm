\p \v 15 \w You also have|strong="H05973"\w* \w many|strong="H07230"\w* \w workers|strong="H06213"\w* \w . . .|strong="H04399"\w*: \w stonecutters|strong="H02672"\w*, \w masons|strong="H02796"\w* \w . . .|strong="H00068"\w*, \w carpenters|strong="H06086"\w*, \w and men skilled|strong="H02450"\w* \w . . .|strong="H03605"\w* \w in every kind|strong="H03605"\w* \w of work|strong="H04399"\w* — \v 16 \w in gold|strong="H02091"\w* \w and silver|strong="H03701"\w*, \w bronze|strong="H05178"\w* \w and iron|strong="H01270"\w*— \w [craftsmen] beyond|strong="H00369"\w* \w number|strong="H04557"\w*. \w Now begin|strong="H06965"\w* \w the work|strong="H06213"\w*, \w and may the LORD|strong="H03068"\w* \w be|strong="H01961"\w* \w with you|strong="H05973"\w*.”
\p \v 17 \w Then David|strong="H01732"\w* \w ordered|strong="H06680"\w* \w all|strong="H03605"\w* \w the leaders|strong="H08269"\w* \w of Israel|strong="H03478"\w* \w to help|strong="H05826"\w* \w his son|strong="H01121"\w* \w Solomon|strong="H08010"\w*: \v 18 “\w [Is] not|strong="H03808"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w with you|strong="H05973"\w*, \w and has He [not] granted you rest|strong="H05117"\w* . . . \w on every side|strong="H05439"\w*? \w For|strong="H03588"\w* \w He has given|strong="H05414"\w* \w the inhabitants|strong="H03427"\w* \w of the land|strong="H00776"\w* \w into my hand|strong="H03027"\w*, \w -|strong="H00853"\w* \w and the land|strong="H00776"\w* \w has been subdued|strong="H03533"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w . . .|strong="H06440"\w* \w and His people|strong="H05971"\w*. \v 19 \w Now|strong="H06258"\w* \w set|strong="H05414"\w* \w your heart|strong="H03824"\w* \w and soul|strong="H05315"\w* \w to seek|strong="H01875"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*. \w Begin|strong="H06965"\w* \w building|strong="H01129"\w* \w -|strong="H00853"\w* \w the sanctuary|strong="H04720"\w* \w of the LORD|strong="H03068"\w* \w God|strong="H00430"\w*, \w so that you may bring|strong="H00935"\w* \w -|strong="H00853"\w* \w the ark|strong="H00727"\w* \w of the covenant|strong="H01285"\w* \w of the LORD|strong="H03068"\w* \w and the holy|strong="H06944"\w* \w articles|strong="H03627"\w* \w of God|strong="H00430"\w* \w into the temple|strong="H01004"\w* \w that will be built|strong="H01129"\w* \w for the Name|strong="H08034"\w* \w of the LORD|strong="H03068"\w*.”
\c 23
\s1 The Divisions of the Levites
\p \v 1 \w When David|strong="H01732"\w* \w was old|strong="H02204"\w* \w and full of|strong="H07646"\w* \w years|strong="H03117"\w*, \w he installed his son|strong="H01121"\w* \w Solomon|strong="H08010"\w* \w as king|strong="H04427"\w* \w -|strong="H00853"\w* \w over|strong="H05921"\w* \w Israel|strong="H03478"\w*. \v 2 \w Then he gathered|strong="H00622"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the leaders|strong="H08269"\w* \w of Israel|strong="H03478"\w*, \w as well as the priests|strong="H03548"\w* \w and Levites|strong="H03881"\w*.
\p \v 3 \w The Levites|strong="H03881"\w* \w thirty|strong="H07970"\w* \w years of age|strong="H01121"\w* \w . . .|strong="H08141"\w* \w or older|strong="H04605"\w* \w were counted|strong="H05608"\w*, \w and the total number|strong="H04557"\w* \w of men|strong="H01397"\w* \w was|strong="H01961"\w* \w 38,000 {}|strong="H07970"\w* \w . . .|strong="H08083"\w* \w . . .|strong="H00505"\w* \w -|strong="H01538"\w*. \v 4 “\w Of these,” [said David,]|strong="H00428"\w*\f + \fr 23:4 \ft Hebrew does not include \fqa said David,\f* \w “24,000|strong="H06242"\w* \w . . .|strong="H00702"\w* \w . . .|strong="H00505"\w* \w are to oversee|strong="H05329"\w* \w -|strong="H05921"\w* \w the work|strong="H04399"\w* \w of the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*, \w 6,000 {}|strong="H08337"\w* \w . . .|strong="H00505"\w* \w are to be officers|strong="H07860"\w* \w and judges|strong="H08199"\w*, \v 5 \w 4,000 {}|strong="H00702"\w* \w . . .|strong="H00505"\w* \w are to be gatekeepers|strong="H07778"\w*, \w and 4,000|strong="H00702"\w* \w . . .|strong="H00505"\w* \w are to praise|strong="H01984"\w* \w the LORD|strong="H03068"\w* \w with the instruments|strong="H03627"\w* \w -|strong="H00834"\w* \w I have made|strong="H06213"\w* \w for giving praise|strong="H01984"\w*.”
\p \v 6 \w Then David|strong="H01732"\w* \w divided [the Levites]|strong="H02505"\w* \w into divisions|strong="H04256"\w* \w according to the sons|strong="H01121"\w* \w of Levi|strong="H03878"\w*:
