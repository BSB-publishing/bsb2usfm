\s1 The Descendants of Ephraim
\p \v 20 \w The descendants|strong="H01121"\w* \w of Ephraim|strong="H00669"\w*:
\b 
\li1 \w Shuthelah|strong="H07803"\w*, \w Bered|strong="H01260"\w* \w his son|strong="H01121"\w*, \w Tahath|strong="H08480"\w* \w his son|strong="H01121"\w*, \w Eleadah|strong="H00497"\w* \w his son|strong="H01121"\w*, \w Tahath|strong="H08480"\w* \w his son|strong="H01121"\w*, \v 21 \w Zabad|strong="H02066"\w* \w his son|strong="H01121"\w*, \w and Shuthelah|strong="H07803"\w* \w his son|strong="H01121"\w*.
\b 
\li1 \w Ezer|strong="H05829"\w* \w and Elead|strong="H00496"\w* \w were killed|strong="H02026"\w* \w by the natives|strong="H00582"\w* \w . . .|strong="H03205"\w* \w . . .|strong="H00776"\w* \w of Gath|strong="H01661"\w*, \w because|strong="H03588"\w* \w they went down|strong="H03381"\w* \w to steal|strong="H03947"\w*\w . . .|strong="H00853"\w* \w their livestock|strong="H04735"\w*.
\b 
\li1 \v 22 \w Their father|strong="H00001"\w* \w Ephraim|strong="H00669"\w* \w mourned|strong="H00056"\w* \w for many|strong="H07227"\w* \w days|strong="H03117"\w*, \w and his relatives|strong="H00251"\w* \w came|strong="H00935"\w* \w to comfort him|strong="H05162"\w*. \v 23 \w And again he slept with|strong="H00935"\w* \w . . .|strong="H00413"\w* \w his wife|strong="H00802"\w*, \w and she conceived|strong="H02029"\w* \w and gave birth to|strong="H03205"\w* \w a son|strong="H01121"\w*. \w So he named|strong="H07121"\w* \w -|strong="H00853"\w* \w him|strong="H08034"\w* \w Beriah|strong="H01283"\w*,\f + \fr 7:23 \fqa Beriah \ft sounds like the Hebrew for \fqa tragedy \ft or \fqa disaster\ft .\f* \w because|strong="H03588"\w* \w tragedy|strong="H07451"\w* \w had come|strong="H01961"\w* \w upon his house|strong="H01004"\w*. \v 24 \w His daughter|strong="H01323"\w* \w was Sheerah|strong="H07609"\w*, \w who built|strong="H01129"\w* \w -|strong="H00853"\w* \w Lower|strong="H08481"\w* \w -|strong="H00853"\w* \w and Upper|strong="H05945"\w* \w vvv|strong="H01032"\w* \w Beth-horon|strong="H01032"\w*, \w as well as|strong="H00853"\w* \w vvv|strong="H00242"\w* \w Uzzen-sheerah|strong="H00242"\w*.
\b 
\li1 \v 25 \w Additionally, Rephah|strong="H07506"\w* \w [was] his son|strong="H01121"\w*, \w Resheph [his son]|strong="H07566"\w*,\f + \fr 7:25 \ft Some LXX manuscripts; Hebrew does not include \fqa his son\ft .\f* \w Telah|strong="H08520"\w* \w his son|strong="H01121"\w*, \w Tahan|strong="H08465"\w* \w his son|strong="H01121"\w*, \v 26 \w Ladan|strong="H03936"\w* \w his son|strong="H01121"\w*, \w Ammihud|strong="H05989"\w* \w his son|strong="H01121"\w*, \w Elishama|strong="H00476"\w* \w his son|strong="H01121"\w*, \v 27 \w Nun|strong="H05126"\w*\f + \fr 7:27 \ft Or \fqa Non\f* \w his son|strong="H01121"\w*, \w and Joshua|strong="H03091"\w* \w his son|strong="H01121"\w*.
\b 
\li1 \v 28 \w Their holdings|strong="H00272"\w* \w and settlements|strong="H04186"\w* \w included|strong="H01008"\w* \w Bethel|strong="H01008"\w* \w and its villages|strong="H01323"\w*, \w Naaran|strong="H05295"\w* \w to the east|strong="H04217"\w*, \w Gezer|strong="H01507"\w* \w and its villages|strong="H01323"\w* \w to the west|strong="H04628"\w*, \w and Shechem|strong="H07927"\w* \w and its villages|strong="H01323"\w* \w as far as|strong="H05704"\w* \w Ayyah|strong="H05804"\w*\f + \fr 7:28 \fqa Ayyah \ft is another name for \fqa Gaza\ft ; see also LXX.\f* \w and its villages|strong="H01323"\w*. \v 29 \w And along|strong="H05921"\w* \w the borders|strong="H03027"\w* \w vvv|strong="H01121"\w* \w of Manasseh|strong="H04519"\w* \w vvv|strong="H01052"\w* \w [were] Beth-shean|strong="H01052"\w* \w -|strong="H01323"\w*,\f + \fr 7:29 \fqa Beth-shean \ft is a variant of \fqa Beth-shan\ft ; see 1 Samuel 31:10 and 2 Samuel 21:12.\f* \w Taanach|strong="H08590"\w* \w -|strong="H01323"\w*, \w Megiddo|strong="H04023"\w* \w -|strong="H01323"\w*, \w and Dor|strong="H01756"\w*, \w together with their villages|strong="H01323"\w*. \w The descendants|strong="H01121"\w* \w of Joseph|strong="H03130"\w* \w son|strong="H01121"\w* \w of Israel|strong="H03478"\w* \w lived|strong="H03427"\w* \w in these towns|strong="H00428"\w*.
\s1 The Descendants of Asher
\p \v 30 \w The children|strong="H01121"\w* \w of Asher|strong="H00836"\w*:
\b 
\li1 \w Imnah|strong="H03232"\w*, \w Ishvah|strong="H03438"\w*, \w Ishvi|strong="H03440"\w*, \w Beriah|strong="H01283"\w*, \w and their sister|strong="H00269"\w* \w Serah|strong="H08294"\w*.
\b 
