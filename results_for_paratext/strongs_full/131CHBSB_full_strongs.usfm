\s1 David’s Reign and Death
\r (1 Kings 2:10–12)
\p \v 26 \w David|strong="H01732"\w* \w son|strong="H01121"\w* \w of Jesse|strong="H03448"\w* \w was king|strong="H04427"\w* \w over|strong="H05921"\w* \w all|strong="H03605"\w* \w Israel|strong="H03478"\w*. \v 27 \w The length|strong="H03117"\w* \w of David’s|strong="H00834"\w* \w reign|strong="H04427"\w* \w over|strong="H05921"\w* \w Israel|strong="H03478"\w* \w [was] forty|strong="H00705"\w* \w years|strong="H08141"\w* —\w . . .|strong="H04427"\w* \w seven|strong="H07651"\w* \w years|strong="H08141"\w* \w in Hebron|strong="H02275"\w* \w . . .|strong="H04427"\w* \w and thirty-three years|strong="H07970"\w* \w . . .|strong="H07969"\w* \w in Jerusalem|strong="H03389"\w*. \v 28 \w He died|strong="H04191"\w* \w at a ripe|strong="H02896"\w* \w old age|strong="H07872"\w*, \w full|strong="H07649"\w* \w of years|strong="H03117"\w*, \w riches|strong="H06239"\w*, \w and honor|strong="H03519"\w*, \w and his son|strong="H01121"\w* \w Solomon|strong="H08010"\w* \w reigned|strong="H04427"\w* \w in his place|strong="H08478"\w*.
\p \v 29 \w Now the acts|strong="H01697"\w* \w of King|strong="H04428"\w* \w David|strong="H01732"\w*, \w from first|strong="H07223"\w* \w to last|strong="H00314"\w*, \w are indeed|strong="H02009"\w* \w written|strong="H03789"\w* \w in|strong="H05921"\w* \w the Chronicles|strong="H01697"\w* \w of Samuel|strong="H08050"\w* \w the Seer|strong="H07203"\w*, \w . . .|strong="H05921"\w* \w the Chronicles|strong="H01697"\w* \w of Nathan|strong="H05416"\w* \w the Prophet|strong="H05030"\w*, \w and|strong="H05921"\w* \w the Chronicles|strong="H01697"\w* \w of Gad|strong="H01410"\w* \w the Seer|strong="H02374"\w*, \v 30 \w together with|strong="H05973"\w* \w all the details|strong="H03605"\w* \w of his reign|strong="H04438"\w*, \w his might|strong="H01369"\w*, \w and the circumstances|strong="H06256"\w* \w that|strong="H00834"\w* \w came|strong="H05674"\w* \w upon him|strong="H05921"\w* \w [and]|strong="H05921"\w* \w Israel|strong="H03478"\w* \w [and]|strong="H05921"\w* \w all|strong="H03605"\w* \w the kingdoms|strong="H04467"\w* \w of the lands|strong="H00776"\w*.
