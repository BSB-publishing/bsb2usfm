\li2 \w Arah|strong="H00733"\w*, \w Hanniel|strong="H02592"\w*, \w and Rizia|strong="H07525"\w*.
\b 
\li1 \v 40 \w All|strong="H03605"\w* \w these|strong="H00428"\w* \w [were] the descendants|strong="H01121"\w* \w of Asher|strong="H00836"\w* — \w heads|strong="H07218"\w* \w of their families|strong="H00001"\w* \w . . .|strong="H01004"\w*, \w choice|strong="H01305"\w* \w [and] mighty men|strong="H01368"\w* \w of valor|strong="H02428"\w*, \w and chiefs|strong="H07218"\w* \w among the leaders|strong="H05387"\w*. \w The number|strong="H04557"\w* \w of men|strong="H00582"\w* \w fit for battle|strong="H04421"\w* \w -|strong="H06635"\w*, \w recorded in their genealogies|strong="H03187"\w*, \w was 26,000|strong="H06242"\w* \w . . .|strong="H08337"\w* \w . . .|strong="H00505"\w*.
\c 8
\s1 Genealogy from Benjamin to Saul
\p \v 1 \w Benjamin|strong="H01144"\w* \w was the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Bela|strong="H01106"\w* \w his firstborn|strong="H01060"\w*, \w Ashbel|strong="H00788"\w* \w the second|strong="H08145"\w*, \w Aharah|strong="H00315"\w* \w the third|strong="H07992"\w*, \v 2 \w Nohah|strong="H05119"\w* \w the fourth|strong="H07243"\w*, \w and Rapha|strong="H07498"\w* \w the fifth|strong="H02549"\w*.
\b 
\li1 \v 3 \w -|strong="H01961"\w* \w The sons|strong="H01121"\w* \w of Bela|strong="H01106"\w*:
\li2 \w Addar|strong="H00146"\w*, \w Gera|strong="H01617"\w*, \w Abihud|strong="H00031"\w*,\f + \fr 8:3 \ft Possibly \fqa Gera the father of Ehud\ft ; see verse 7.\f* \v 4 \w Abishua|strong="H00050"\w*, \w Naaman|strong="H05283"\w*, \w Ahoah|strong="H00265"\w*, \v 5 \w Gera|strong="H01617"\w*, \w Shephuphan|strong="H08197"\w*, \w and Huram|strong="H02361"\w*.
\b 
\li1 \v 6 \w These [were]|strong="H00428"\w* \w the descendants|strong="H01121"\w* \w of Ehud|strong="H00261"\w* \w . . .|strong="H00428"\w* \w who|strong="H01992"\w* \w were the heads|strong="H07218"\w* \w of the families|strong="H00001"\w* \w living|strong="H03427"\w* \w in Geba|strong="H01387"\w* \w and were exiled|strong="H01540"\w* \w to|strong="H00413"\w* \w Manahath|strong="H04506"\w*:
\li2 \v 7 \w Naaman|strong="H05283"\w*, \w Ahijah|strong="H00281"\w*, \w and Gera|strong="H01617"\w*, \w who|strong="H01931"\w* \w carried them into exile|strong="H01540"\w* \w and who was the father|strong="H03205"\w* \w -|strong="H00853"\w* \w of Uzza|strong="H05798"\w* \w -|strong="H00853"\w* \w and Ahihud|strong="H00284"\w*.\f + \fr 8:7 \ft Or \fqa and Gera, that is Heglam, who was the father of Uzza and Ahihud.\f*
\b 
\li1 \v 8 \w Shaharaim|strong="H07842"\w* \w had sons|strong="H03205"\w* \w in the country|strong="H07704"\w* \w of Moab|strong="H04124"\w* \w after|strong="H04480"\w* \w he had divorced|strong="H07971"\w* \w -|strong="H00853"\w* \w his wives|strong="H00802"\w* \w Hushim|strong="H02366"\w* \w -|strong="H00853"\w* \w and Baara|strong="H01199"\w*. \v 9 \w -|strong="H03205"\w* \w His sons by|strong="H04480"\w* \w his wife|strong="H00802"\w* \w -|strong="H00853"\w* \w Hodesh|strong="H02321"\w*:
\li2 \w Jobab|strong="H03103"\w*, \w -|strong="H00853"\w* \w Zibia|strong="H06644"\w*, \w -|strong="H00853"\w* \w Mesha|strong="H04331"\w*, \w -|strong="H00853"\w* \w Malcam|strong="H04445"\w*, \v 10 \w -|strong="H00853"\w* \w Jeuz|strong="H03263"\w*, \w -|strong="H00853"\w* \w Sachia|strong="H07634"\w*, \w -|strong="H00853"\w* \w and Mirmah|strong="H04821"\w*. \w These|strong="H00428"\w* \w were his sons|strong="H01121"\w*, \w heads|strong="H07218"\w* \w of families|strong="H00001"\w*.
\b 
\li1 \v 11 \w He also had sons|strong="H03205"\w* \w -|strong="H00853"\w* \w by Hushim|strong="H02366"\w*:
\li2 \w Abitub|strong="H00036"\w* \w -|strong="H00853"\w* \w and Elpaal|strong="H00508"\w*.
\b 
\li1 \v 12 \w The sons|strong="H01121"\w* \w of Elpaal|strong="H00508"\w*:
\li2 \w Eber|strong="H05677"\w*, \w Misham|strong="H04936"\w*, \w Shemed|strong="H08106"\w* (\w who|strong="H01931"\w* \w built|strong="H01129"\w* \w -|strong="H00853"\w* \w Ono|strong="H00207"\w* \w -|strong="H00853"\w* \w and Lod|strong="H03850"\w* \w with its villages|strong="H01323"\w*), \v 13 \w and Beriah|strong="H01283"\w* \w and Shema|strong="H08087"\w* (\w who|strong="H01992"\w* \w were the heads|strong="H07218"\w* \w of families|strong="H00001"\w* \w living in|strong="H03427"\w* \w Aijalon|strong="H00357"\w* \w and who|strong="H01992"\w* \w drove out|strong="H01272"\w* \w -|strong="H00853"\w* \w the inhabitants|strong="H03427"\w* \w of Gath|strong="H01661"\w*).
\b 
\li1 \v 14 \w Ahio|strong="H00283"\w*, \w Shashak|strong="H08349"\w*, \w Jeremoth|strong="H03406"\w*, \v 15 \w Zebadiah|strong="H02069"\w*, \w Arad|strong="H06166"\w*, \w Eder|strong="H05738"\w*, \v 16 \w Michael|strong="H04317"\w*, \w Ishpah|strong="H03472"\w*, \w and Joha|strong="H03109"\w* \w [were] the sons|strong="H01121"\w* \w of Beriah|strong="H01283"\w*.
\b 
\li1 \v 17 \w Zebadiah|strong="H02069"\w*, \w Meshullam|strong="H04918"\w*, \w Hizki|strong="H02395"\w*, \w Heber|strong="H02268"\w*, \v 18 \w Ishmerai|strong="H03461"\w*, \w Izliah|strong="H03152"\w*, \w and Jobab|strong="H03103"\w* \w [were] the sons|strong="H01121"\w* \w of Elpaal|strong="H00508"\w*.
\b 
\li1 \v 19 \w Jakim|strong="H03356"\w*, \w Zichri|strong="H02147"\w*, \w Zabdi|strong="H02067"\w*, \v 20 \w Elienai|strong="H00462"\w*, \w Zillethai|strong="H06769"\w*, \w Eliel|strong="H00447"\w*, \v 21 \w Adaiah|strong="H05718"\w*, \w Beraiah|strong="H01256"\w*, \w and Shimrath|strong="H08119"\w* \w [were] the sons|strong="H01121"\w* \w of Shimei|strong="H08096"\w*.
\b 
\li1 \v 22 \w Ishpan|strong="H03473"\w*, \w Eber|strong="H05677"\w*, \w Eliel|strong="H00447"\w*, \v 23 \w Abdon|strong="H05658"\w*, \w Zichri|strong="H02147"\w*, \w Hanan|strong="H02605"\w*, \v 24 \w Hananiah|strong="H02608"\w*, \w Elam|strong="H05867"\w*, \w Anthothijah|strong="H06070"\w*, \v 25 \w Iphdeiah|strong="H03301"\w*, \w and Penuel|strong="H06439"\w* \w [were] the sons|strong="H01121"\w* \w of Shashak|strong="H08349"\w*.
\b 
\li1 \v 26 \w Shamsherai|strong="H08125"\w*, \w Shehariah|strong="H07841"\w*, \w Athaliah|strong="H06271"\w*, \v 27 \w Jaareshiah|strong="H03298"\w*, \w Elijah|strong="H00452"\w*, \w and Zichri|strong="H02147"\w* \w [were] the sons|strong="H01121"\w* \w of Jeroham|strong="H03395"\w*.
\b 
\li1 \v 28 \w All these|strong="H00428"\w* \w were heads|strong="H07218"\w* \w of families|strong="H00001"\w*, \w the chiefs|strong="H07218"\w* \w . . .|strong="H00428"\w* \w according to their genealogies|strong="H08435"\w*, \w and they lived|strong="H03427"\w* \w in Jerusalem|strong="H03389"\w*.
\b 
\li1 \v 29 \w [Jeiel] the father|strong="H00001"\w* \w of Gibeon|strong="H01391"\w* \w lived|strong="H03427"\w*\f + \fr 8:29 \ft Some LXX manuscripts (see also 1 Chronicles 9:35); Hebrew \fqa The father of Gibeon lived\f* \w in Gibeon|strong="H01391"\w*. \w His wife’s|strong="H00802"\w* \w name|strong="H08034"\w* \w was Maacah|strong="H04601"\w*, \v 30 \w and Abdon|strong="H05658"\w* \w was his firstborn|strong="H01060"\w* \w son|strong="H01121"\w*, \w then Zur|strong="H06698"\w*, \w Kish|strong="H07027"\w*, \w Baal|strong="H01168"\w*,\f + \fr 8:30 \ft Some LXX manuscripts include \fqa Ner\ft ; see 1 Chronicles 9:36.\f* \w Nadab|strong="H05070"\w*, \v 31 \w Gedor|strong="H01446"\w*, \w Ahio|strong="H00283"\w*, \w Zecher|strong="H02144"\w*,\f + \fr 8:31 \fqa Zecher \ft is likely a variant of \fqa Zechariah\ft ; see 1 Chronicles 9:37.\f* \v 32 \w and Mikloth|strong="H04732"\w*, \w who was the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Shimeah|strong="H08039"\w*.\f + \fr 8:32 \fqa Shimeah \ft is a variant of \fqa Shimeam\ft ; see 1 Chronicles 9:38.\f* \w They|strong="H01992"\w* \w too|strong="H00637"\w* \w lived|strong="H03427"\w* \w alongside|strong="H05048"\w* \w their relatives|strong="H00251"\w* \w in Jerusalem|strong="H03389"\w* \w -|strong="H05973"\w* \w -|strong="H00251"\w*.
\s1 The Family of Saul
\p \v 33 \w Ner|strong="H05369"\w* \w was the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Kish|strong="H07027"\w*, \w Kish|strong="H07027"\w* \w was the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Saul|strong="H07586"\w*, \w and Saul|strong="H07586"\w* \w was the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Jonathan|strong="H03083"\w*, \w -|strong="H00853"\w* \w vvv|strong="H04444"\w* \w Malchishua|strong="H04444"\w*, \w -|strong="H00853"\w* \w Abinadab|strong="H00041"\w*, \w -|strong="H00853"\w* \w and Esh-baal|strong="H00792"\w*.\f + \fr 8:33 \fqa Esh-baal \ft is also called \fqa Ish-bosheth\ft ; see 2 Samuel 2:8.\f*
\b 
\li1 \v 34 \w The son|strong="H01121"\w* \w of Jonathan|strong="H03083"\w* \w vvv|strong="H04807"\w*:
\li2 \w Merib-baal|strong="H04807"\w*,\f + \fr 8:34 \fqa Merib-baal \ft is also called \fqa Mephibosheth\ft ; see 2 Samuel 4:4.\f* \w vvv|strong="H04807"\w* \w and Merib-baal|strong="H04807"\w* \w was the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Micah|strong="H04318"\w*.\f + \fr 8:34 \fqa Micah \ft is a variant of \fqa Mica\ft ; see 2 Samuel 9:12.\f*
\b 
\li1 \v 35 \w The sons|strong="H01121"\w* \w of Micah|strong="H04318"\w*:
\li2 \w Pithon|strong="H06377"\w*, \w Melech|strong="H04429"\w*, \w Tarea|strong="H08390"\w*,\f + \fr 8:35 \fqa Tarea \ft is a variant of \fqa Tahrea\ft ; see 1 Chronicles 9:41.\f* \w and Ahaz|strong="H00271"\w*.
\b 
\li1 \v 36 \w Ahaz|strong="H00271"\w* \w was the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Jehoaddah|strong="H03085"\w*, \w Jehoaddah|strong="H03085"\w*\f + \fr 8:36 \fqa Jehoaddah \ft is a variant of \fqa Jarah \ft or \fqa Jadah\ft ; see 1 Chronicles 9:42.\f* \w was the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Alemeth|strong="H05964"\w*, \w -|strong="H00853"\w* \w Azmaveth|strong="H05820"\w*, \w -|strong="H00853"\w* \w and Zimri|strong="H02174"\w*, \w and Zimri|strong="H02174"\w* \w was the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Moza|strong="H04162"\w*.
\b 
\li1 \v 37 \w Moza|strong="H04162"\w* \w was the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Binea|strong="H01150"\w*. \w Raphah|strong="H07498"\w*\f + \fr 8:37 \fqa Raphah \ft is a variant of \fqa Rephaiah\ft ; see 1 Chronicles 9:43.\f* \w [was] his son|strong="H01121"\w*, \w Eleasah|strong="H00501"\w* \w his son|strong="H01121"\w*, \w [and] Azel|strong="H00682"\w* \w his son|strong="H01121"\w*.
\b 
\li1 \v 38 \w Azel|strong="H00682"\w* \w had six|strong="H08337"\w* \w sons|strong="H01121"\w*, \w and these|strong="H00428"\w* \w were their names|strong="H08034"\w*:
\li2 \w Azrikam|strong="H05840"\w*, \w Bocheru|strong="H01074"\w*, \w Ishmael|strong="H03458"\w*, \w Sheariah|strong="H08187"\w*, \w Obadiah|strong="H05662"\w*, \w and Hanan|strong="H02605"\w*. \w All|strong="H03605"\w* \w these|strong="H00428"\w* \w [were] the sons|strong="H01121"\w* \w of Azel|strong="H00682"\w*.
\b 
\li1 \v 39 \w The sons|strong="H01121"\w* \w of his brother|strong="H00251"\w* \w Eshek|strong="H06232"\w*:
\li2 \w Ulam|strong="H00198"\w* \w was his firstborn|strong="H01060"\w*, \w Jeush|strong="H03266"\w* \w second|strong="H08145"\w*, \w and Eliphelet|strong="H00467"\w* \w third|strong="H07992"\w*. \v 40 \w The sons|strong="H01121"\w* \w of Ulam|strong="H00198"\w* \w were|strong="H01961"\w* \w mighty|strong="H01368"\w* \w men|strong="H00582"\w* \w of valor|strong="H02428"\w*, \w archers|strong="H01869"\w* \w . . .|strong="H07198"\w*, \w and they had many|strong="H07235"\w* \w sons|strong="H01121"\w* \w and grandsons|strong="H01121"\w* \w . . .|strong="H01121"\w*— \w 150 [in all]|strong="H03967"\w* \w . . .|strong="H02572"\w*.
\p \w All|strong="H03605"\w* \w these|strong="H00428"\w* \w [were] the descendants|strong="H01121"\w* \w of Benjamin|strong="H01144"\w*.
\c 9
\s1 The People of Jerusalem
\p \v 1 \w So all|strong="H03605"\w* \w Israel|strong="H03478"\w* \w was recorded in the genealogies|strong="H03187"\w* \w . . .|strong="H02009"\w* \w written|strong="H03789"\w* \w in|strong="H05921"\w* \w the Book|strong="H05612"\w* \w of the Kings|strong="H04428"\w* \w of Israel|strong="H03478"\w*. \w But Judah|strong="H03063"\w* \w was exiled|strong="H01540"\w* \w to Babylon|strong="H00894"\w* \w because of their unfaithfulness|strong="H04604"\w*.
\p \v 2 \w Now the first|strong="H07223"\w* \w -|strong="H00834"\w* \w to resettle|strong="H03427"\w* \w their own property|strong="H00272"\w* \w in their cities|strong="H05892"\w* \w were Israelites|strong="H03478"\w*, \w priests|strong="H03548"\w*, \w Levites|strong="H03881"\w*, \w and temple servants|strong="H05411"\w*.\f + \fr 9:2 \ft Hebrew \fqa Nethinim\f*
