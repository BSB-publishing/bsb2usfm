\li2 \v 19 \w Two|strong="H08147"\w* \w sons|strong="H01121"\w* \w were born|strong="H03205"\w* \w to Eber|strong="H05677"\w*: \w One|strong="H00259"\w* \w was named|strong="H08034"\w* \w Peleg|strong="H06389"\w*,\f + \fr 1:19 \fqa Peleg \ft means \fqa division\ft .\f* \w because|strong="H03588"\w* \w in his days|strong="H03117"\w* \w the earth|strong="H00776"\w* \w was divided|strong="H06385"\w*, \w and his brother|strong="H00251"\w* \w was named|strong="H08034"\w* \w Joktan|strong="H03355"\w*.
