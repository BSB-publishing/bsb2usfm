\c 12
\s1 The Mighty Men Join David at Ziklag
\p \v 1 \w Now these [were] the [men]|strong="H00428"\w* \w who came|strong="H00935"\w* \w to|strong="H00413"\w* \w David|strong="H01732"\w* \w at Ziklag|strong="H06860"\w*, \w while|strong="H05750"\w* \w he was still banished|strong="H06113"\w* \w from the presence|strong="H06440"\w* \w of Saul|strong="H07586"\w* \w son|strong="H01121"\w* \w of Kish|strong="H07027"\w* (\w they|strong="H01992"\w* \w were among the mighty men|strong="H01368"\w* \w who helped him|strong="H05826"\w* \w in battle|strong="H04421"\w*; \v 2 \w they were archers|strong="H05401"\w* \w . . .|strong="H07198"\w* \w using both the right|strong="H03231"\w* \w and left [hands]|strong="H08041"\w* \w [to sling] stones|strong="H00068"\w* \w and [shoot] arrows|strong="H02671"\w* \w . . .|strong="H07198"\w*; \w [and they were] Saul’s|strong="H07586"\w* \w kinsmen|strong="H00251"\w* \w from Benjamin|strong="H01144"\w*):
\b 
\li1 \v 3 \w Ahiezer|strong="H00295"\w* \w their chief|strong="H07218"\w* \w and Joash|strong="H03101"\w*, \w [who were] the sons|strong="H01121"\w* \w of Shemaah|strong="H08094"\w* \w the Gibeathite|strong="H01395"\w*;
