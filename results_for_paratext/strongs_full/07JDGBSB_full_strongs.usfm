\c 13
\s1 The Birth of Samson
\p \v 1 \w Again|strong="H03254"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w did|strong="H06213"\w* \w evil|strong="H07451"\w* \w in the sight|strong="H05869"\w* \w of the LORD|strong="H03068"\w*, \w so [He]|strong="H03068"\w* \w delivered them|strong="H05414"\w* \w into the hand|strong="H03027"\w* \w of the Philistines|strong="H06430"\w* \w for forty|strong="H00705"\w* \w years|strong="H08141"\w*.
\p \v 2 \w Now there was|strong="H01961"\w* \w a|strong="H00259"\w* \w man|strong="H00376"\w* \w from Zorah|strong="H06881"\w* \w named|strong="H08034"\w* \w Manoah|strong="H04495"\w*, \w from the clan|strong="H04940"\w* \w of the Danites|strong="H01839"\w*, \w whose wife [was]|strong="H00802"\w* \w barren|strong="H06135"\w* \w and had no|strong="H03808"\w* \w children|strong="H03205"\w*. \v 3 \w The angel|strong="H04397"\w*\f + \fr 13:3 \ft Or \fqa Angel\ft ; here and throughout chapter 13; corresponding pronouns may also be capitalized.\f* \w of the LORD|strong="H03068"\w* \w appeared|strong="H07200"\w* \w to|strong="H00413"\w* \w the woman|strong="H00802"\w* \w and said|strong="H00559"\w* \w to her|strong="H00413"\w*, “\w It is true|strong="H02009"\w* \w . . .|strong="H04994"\w* \w that you|strong="H00859"\w* \w are barren|strong="H06135"\w* \w and have no|strong="H03808"\w* \w children|strong="H03205"\w*; \w but you will conceive|strong="H02029"\w* \w and give birth to|strong="H03205"\w* \w a son|strong="H01121"\w*. \v 4 \w Now|strong="H06258"\w* \w please|strong="H04994"\w* \w be careful|strong="H08104"\w* \w not|strong="H00408"\w* \w to drink|strong="H08354"\w* \w wine|strong="H03196"\w* \w or strong drink|strong="H07941"\w*, \w and not|strong="H00408"\w* \w to eat|strong="H00398"\w* \w anything|strong="H03605"\w* \w unclean|strong="H02931"\w*. \v 5 \w For|strong="H03588"\w* \w behold|strong="H02009"\w*, \w you will conceive|strong="H02030"\w* \w and give birth to|strong="H03205"\w* \w a son|strong="H01121"\w*. \w And no|strong="H03808"\w* \w razor|strong="H04177"\w* \w shall touch|strong="H05927"\w* \w . . .|strong="H05921"\w* \w his head|strong="H07218"\w*, \w because|strong="H03588"\w* \w the boy|strong="H05288"\w* \w will be|strong="H01961"\w* \w a Nazirite|strong="H05139"\w*\f + \fr 13:5 \ft Or \fqa set apart\f* \w to God|strong="H00430"\w* \w from|strong="H04480"\w* \w the womb|strong="H00990"\w*, \w and he|strong="H01931"\w* \w will begin|strong="H02490"\w* \w the deliverance|strong="H03467"\w* \w -|strong="H00853"\w* \w of Israel|strong="H03478"\w* \w from the hand|strong="H03027"\w* \w of the Philistines|strong="H06430"\w*.”
\p \v 6 \w So the woman|strong="H00802"\w* \w went|strong="H00935"\w* \w and told|strong="H00559"\w* \w her husband|strong="H00376"\w*, \w . . .|strong="H00559"\w* “\w A man|strong="H00376"\w* \w of God|strong="H00430"\w* \w came|strong="H00935"\w* \w to me|strong="H00413"\w*. \w His appearance was like|strong="H04758"\w*\w . . .|strong="H04758"\w* \w the angel|strong="H04397"\w* \w of God|strong="H00430"\w*, \w exceedingly|strong="H03966"\w* \w awesome|strong="H03372"\w*. \w I did not|strong="H03808"\w* \w ask him|strong="H07592"\w* \w where|strong="H00335"\w* \w he came from|strong="H02088"\w*\w . . .|strong="H01931"\w*, \w -|strong="H00853"\w* \w and he did not|strong="H03808"\w* \w tell|strong="H05046"\w* me \w his name|strong="H08034"\w*. \v 7 \w But he said|strong="H00559"\w* to me, ‘\w Behold|strong="H02009"\w*, \w you will conceive|strong="H02030"\w* \w and give birth to|strong="H03205"\w* \w a son|strong="H01121"\w*. \w Now, therefore|strong="H06258"\w*, \w do not|strong="H00408"\w* \w drink|strong="H08354"\w* \w wine|strong="H03196"\w* \w or strong drink|strong="H07941"\w*, \w and do not|strong="H00408"\w* \w eat|strong="H00398"\w* \w anything|strong="H03605"\w* \w unclean|strong="H02932"\w*, \w because|strong="H03588"\w* \w the boy|strong="H05288"\w* \w will be|strong="H01961"\w* \w a Nazirite|strong="H05139"\w* \w to God|strong="H00430"\w* \w from|strong="H04480"\w* \w the womb|strong="H00990"\w* \w until|strong="H05704"\w* \w the day|strong="H03117"\w* \w of his death|strong="H04194"\w*.’”
\p \v 8 \w Then Manoah|strong="H04495"\w* \w prayed|strong="H06279"\w* \w to|strong="H00413"\w* \w the LORD|strong="H03068"\w* \w -|strong="H00559"\w*, “\w Please|strong="H00994"\w*, \w O Lord|strong="H00136"\w*, \w let the man|strong="H00376"\w* \w of God|strong="H00430"\w* \w -|strong="H00834"\w* \w You sent us|strong="H07971"\w* \w come|strong="H00935"\w* \w . . .|strong="H04994"\w* \w to us|strong="H00413"\w* \w again|strong="H05750"\w* \w to teach us|strong="H03384"\w* \w how|strong="H04100"\w* \w to raise|strong="H06213"\w* \w the boy|strong="H05288"\w* \w who is to be born|strong="H03205"\w*.”
\p \v 9 \w And God|strong="H00430"\w* \w listened|strong="H08085"\w* \w to the voice|strong="H06963"\w* \w of Manoah|strong="H04495"\w*, \w and the angel|strong="H04397"\w* \w of God|strong="H00430"\w* \w returned|strong="H00935"\w* \w . . .|strong="H05750"\w* \w to|strong="H00413"\w* \w the woman|strong="H00802"\w* \w as she|strong="H01931"\w* \w was sitting|strong="H03427"\w* \w in the field|strong="H07704"\w*; \w but her husband|strong="H00376"\w* \w Manoah|strong="H04495"\w* \w was not|strong="H00369"\w* \w with her|strong="H05973"\w*. \v 10 \w The woman|strong="H00376"\w* \w ran|strong="H07323"\w* \w . . .|strong="H05046"\w* \w quickly|strong="H04116"\w* \w to tell|strong="H00559"\w*\w . . .|strong="H00413"\w* \w her husband|strong="H00802"\w*, “\w Behold|strong="H02009"\w*, \w the man|strong="H00376"\w* \w who|strong="H00834"\w* \w came|strong="H00935"\w* \w to me|strong="H00413"\w* \w the [other] day|strong="H03117"\w* \w has reappeared|strong="H07200"\w* \w . . .|strong="H00413"\w*!”
\p \v 11 \w So Manoah|strong="H04495"\w* \w got up|strong="H06965"\w* \w and followed|strong="H01980"\w* \w . . .|strong="H00310"\w* \w his wife|strong="H00802"\w*. \w When he came|strong="H00935"\w* \w to|strong="H00413"\w* \w the man|strong="H00376"\w*, \w he asked|strong="H00559"\w*, “\w Are you|strong="H00859"\w* \w the man|strong="H00376"\w* \w who|strong="H00834"\w* \w spoke|strong="H01696"\w* \w to|strong="H00413"\w* \w my wife|strong="H00802"\w*?”
\p “\w I|strong="H00589"\w* \w am, ” he said|strong="H00559"\w*.
\p \v 12 \w Then Manoah|strong="H04495"\w* \w asked|strong="H00559"\w*, “\w When|strong="H06258"\w* \w your words|strong="H01697"\w* \w come to pass|strong="H00935"\w*, \w what|strong="H04100"\w* \w will be|strong="H01961"\w* \w the boy’s|strong="H05288"\w* \w rule of life|strong="H04941"\w* \w and mission|strong="H04639"\w*?”
\p \v 13 \w So the angel|strong="H04397"\w* \w of the LORD|strong="H03068"\w* \w . . .|strong="H00413"\w* \w answered|strong="H00559"\w* \w Manoah|strong="H04495"\w*, “\w Your wife|strong="H00802"\w* \w is to do|strong="H08104"\w* \w everything|strong="H03605"\w* \w -|strong="H00834"\w* \w I told her|strong="H00559"\w* \w . . .|strong="H00413"\w*. \v 14 \w She must not|strong="H03808"\w* \w eat|strong="H00398"\w* \w anything|strong="H03605"\w* \w that|strong="H00834"\w* \w comes|strong="H03318"\w* \w from the vine|strong="H01612"\w* \w . . .|strong="H03196"\w*, \w nor drink|strong="H08354"\w* \w any wine|strong="H03196"\w* \w or strong drink|strong="H07941"\w*, \w nor|strong="H00408"\w* \w eat|strong="H00398"\w* \w anything|strong="H03605"\w* \w unclean|strong="H02932"\w*. \w . . .|strong="H00408"\w* \w She must do|strong="H08104"\w* \w everything|strong="H03605"\w* \w -|strong="H00834"\w* \w I have commanded her|strong="H06680"\w*.”
\p \v 15 “\w Please|strong="H04994"\w* \w stay here|strong="H06113"\w* \w -|strong="H00853"\w*,” \w Manoah|strong="H04495"\w* \w . . .|strong="H00413"\w* \w said|strong="H00559"\w* \w to the angel|strong="H04397"\w* \w of the LORD|strong="H03068"\w*, “\w and we will prepare|strong="H06213"\w* \w a young goat|strong="H01423"\w* \w . . .|strong="H05795"\w* \w for you|strong="H06440"\w*.”
\p \v 16 \w And the angel|strong="H04397"\w* \w of the LORD|strong="H03068"\w* \w replied|strong="H00559"\w*\w . . .|strong="H00413"\w*\w . . .|strong="H04495"\w*, “\w Even if|strong="H00518"\w* \w I stay|strong="H06113"\w*, \w I will not|strong="H03808"\w* \w eat|strong="H00398"\w* \w your food|strong="H03899"\w*. \w But if|strong="H00518"\w* \w you prepare|strong="H06213"\w* \w a burnt offering|strong="H05930"\w*, \w offer it|strong="H05927"\w* \w to the LORD|strong="H03068"\w*.” \w For|strong="H03588"\w* \w Manoah|strong="H04495"\w* \w . . .|strong="H03588"\w* \w did not|strong="H03808"\w* \w know [that]|strong="H03045"\w* \w it [was]|strong="H01931"\w* \w the angel|strong="H04397"\w* \w of the LORD|strong="H03068"\w*.
\p \v 17 \w Then Manoah|strong="H04495"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w the angel|strong="H04397"\w* \w of the LORD|strong="H03068"\w*, “\w What|strong="H04310"\w* \w is your name|strong="H08034"\w*, \w so that|strong="H03588"\w* \w we may honor you|strong="H03513"\w* \w when your word|strong="H01697"\w* \w comes to pass|strong="H00935"\w*?”
\p \v 18 “\w Why|strong="H04100"\w* \w . . .|strong="H02088"\w* \w do you ask|strong="H07592"\w* \w my name|strong="H08034"\w*,” \w said|strong="H00559"\w* \w the angel|strong="H04397"\w* \w of the LORD|strong="H03068"\w* -, “\w since it|strong="H01931"\w* \w is beyond comprehension|strong="H06383"\w*?”
\p \v 19 \w Then Manoah|strong="H04495"\w* \w -|strong="H00853"\w* \w took|strong="H03947"\w* \w a young goat|strong="H01423"\w* \w . . .|strong="H05795"\w* \w -|strong="H00853"\w* \w and a grain offering|strong="H04503"\w* \w and offered them|strong="H05927"\w* \w on|strong="H05921"\w* \w a rock|strong="H06697"\w* \w to the LORD|strong="H03068"\w*. \w And as Manoah|strong="H04495"\w* \w and his wife|strong="H00802"\w* \w looked on|strong="H07200"\w*, \w the LORD did|strong="H06213"\w* \w a marvelous thing|strong="H06381"\w*. \v 20 \w -|strong="H01961"\w* \w When the flame|strong="H03851"\w* \w went up|strong="H05927"\w* \w from|strong="H05921"\w* \w the altar|strong="H04196"\w* \w to the sky|strong="H08064"\w*, \w the angel|strong="H04397"\w* \w of the LORD|strong="H03068"\w* \w ascended|strong="H05927"\w* \w in the|strong="H04196"\w* \w flame|strong="H03851"\w*.
\p \w When Manoah|strong="H04495"\w* \w and his wife|strong="H00802"\w* \w saw [this]|strong="H07200"\w*, \w they fell|strong="H05307"\w* \w facedown|strong="H05921"\w* \w . . .|strong="H06440"\w* \w to the ground|strong="H00776"\w*. \v 21 \w And when the angel|strong="H04397"\w* \w of the LORD|strong="H03068"\w* \w did not|strong="H03808"\w* \w appear|strong="H07200"\w* \w again|strong="H03254"\w* \w . . .|strong="H05750"\w* \w to|strong="H00413"\w* \w Manoah|strong="H04495"\w* \w and|strong="H00413"\w* \w his wife|strong="H00802"\w*, \w -|strong="H00227"\w* \w Manoah|strong="H04495"\w* \w realized|strong="H03045"\w* \w that|strong="H03588"\w* \w it [had been]|strong="H01931"\w* \w the angel|strong="H04397"\w* \w of the LORD|strong="H03068"\w*.
\p \v 22 “\w We are going to die|strong="H04191"\w*,” \w . . .|strong="H04191"\w* \w he|strong="H04495"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w his wife|strong="H00802"\w*, “\w for|strong="H03588"\w* \w we have seen|strong="H07200"\w* \w God|strong="H00430"\w*!”
\p \v 23 \w But his wife|strong="H00802"\w* \w replied|strong="H00559"\w*, “\w If|strong="H03863"\w* \w the LORD|strong="H03068"\w* \w had intended|strong="H02654"\w* \w to kill us|strong="H04191"\w*, \w He would not|strong="H03808"\w* \w have accepted|strong="H03947"\w* \w the burnt offering|strong="H05930"\w* \w and the grain offering|strong="H04503"\w* \w from our hands|strong="H03027"\w*, \w nor would He|strong="H03808"\w* \w have shown|strong="H07200"\w* \w us|strong="H00853"\w* \w all|strong="H03605"\w* \w these things|strong="H00428"\w* \w or spoken|strong="H08085"\w* \w to us|strong="H06256"\w* \w . . .|strong="H03808"\w* \w this way|strong="H02063"\w*.”
\p \v 24 \w So the woman|strong="H00802"\w* \w gave birth to|strong="H03205"\w* \w a son|strong="H01121"\w* \w and named|strong="H07121"\w* \w -|strong="H00853"\w* \w him|strong="H08034"\w* \w Samson|strong="H08123"\w*. \w The boy|strong="H05288"\w* \w grew|strong="H01431"\w*, \w and the LORD|strong="H03068"\w* \w blessed him|strong="H01288"\w*. \v 25 \w And the Spirit|strong="H07307"\w* \w of the LORD|strong="H03068"\w* \w began|strong="H02490"\w* \w to stir him|strong="H06470"\w* \w at Mahaneh-dan|strong="H04265"\w* \w . . .|strong="H04265"\w*,\f + \fr 13:25 \fqa Mahaneh-dan \ft means \fqa camp of Dan\ft .\f* \w between|strong="H00996"\w* \w Zorah|strong="H06881"\w* \w . . .|strong="H00996"\w* \w and Eshtaol|strong="H00847"\w*.
\c 14
\s1 Samson’s Marriage
\p \v 1 \w One day Samson|strong="H08123"\w* \w went down|strong="H03381"\w* \w to Timnah|strong="H08553"\w*, \w where he saw|strong="H07200"\w* \w . . .|strong="H00802"\w* \w a young Philistine|strong="H06430"\w* \w woman|strong="H01323"\w* \w . . .|strong="H08553"\w*. \v 2 \w So he returned|strong="H05927"\w* \w and told|strong="H05046"\w* \w his father|strong="H00001"\w* \w and mother|strong="H00517"\w* \w -|strong="H00559"\w* \w -|strong="H00802"\w*, “\w I have seen|strong="H07200"\w* \w a daughter|strong="H01323"\w* \w of the Philistines|strong="H06430"\w* \w in Timnah|strong="H08553"\w*. \w Now|strong="H06258"\w* \w get|strong="H03947"\w* \w her|strong="H00853"\w* for me \w as a wife|strong="H00802"\w*.”
\p \v 3 \w But his father|strong="H00001"\w* \w and mother|strong="H00517"\w* \w replied|strong="H00559"\w*, “\w Can’t you [find]|strong="H00369"\w* \w a young woman|strong="H01323"\w* \w among your relatives|strong="H00251"\w* \w or among any|strong="H03605"\w* \w of our people|strong="H05971"\w*? \w -|strong="H00802"\w* \w -|strong="H03588"\w* \w Must you|strong="H00859"\w* \w go|strong="H01980"\w* \w to the uncircumcised|strong="H06189"\w* \w Philistines|strong="H06430"\w* \w to get|strong="H03947"\w* \w a wife|strong="H00802"\w*?”
\p \w But Samson|strong="H08123"\w* \w . . .|strong="H00413"\w* \w told|strong="H00559"\w* \w his father|strong="H00001"\w*, “\w Get|strong="H03947"\w* \w her|strong="H00853"\w* for me, \w for|strong="H03588"\w* \w she|strong="H01931"\w* \w is pleasing|strong="H03474"\w* \w to my eyes|strong="H05869"\w*.” \v 4 (\w Now his father|strong="H00001"\w* \w and mother|strong="H00517"\w* \w did not|strong="H03808"\w* \w know|strong="H03045"\w* \w . . .|strong="H03588"\w* \w this|strong="H01931"\w* \w was from|strong="H03588"\w* \w the LORD|strong="H03068"\w*, \w who|strong="H01931"\w* \w was seeking|strong="H01245"\w* \w an occasion to move|strong="H08385"\w* \w against the Philistines|strong="H06430"\w*; \w for at that|strong="H01931"\w* \w time|strong="H06256"\w* \w the Philistines|strong="H06430"\w* \w were ruling|strong="H04910"\w* \w over Israel|strong="H03478"\w*.)
\p \v 5 \w Then Samson|strong="H08123"\w* \w went down|strong="H03381"\w* \w to Timnah|strong="H08553"\w* \w with his father|strong="H00001"\w* \w and mother|strong="H00517"\w* \w and came|strong="H00935"\w* \w to|strong="H05704"\w* \w the vineyards|strong="H03754"\w* \w of Timnah|strong="H08553"\w*. \w Suddenly|strong="H02009"\w* \w a young lion|strong="H03715"\w* \w . . .|strong="H00738"\w* \w came roaring|strong="H07580"\w* \w at him|strong="H07122"\w*, \v 6 \w and the Spirit|strong="H07307"\w* \w of the LORD|strong="H03068"\w* \w came powerfully|strong="H06743"\w* \w upon him|strong="H05921"\w*, \w and he tore the lion apart|strong="H08156"\w* \w with his bare|strong="H03972"\w* \w . . .|strong="H00369"\w* \w hands|strong="H03027"\w* \w as one would tear|strong="H08156"\w* \w a young goat|strong="H01423"\w*. \w But he did not|strong="H03808"\w* \w tell|strong="H05046"\w* \w his father|strong="H00001"\w* \w or mother|strong="H00517"\w* \w -|strong="H00853"\w* \w what|strong="H00834"\w* \w he had done|strong="H06213"\w*. \v 7 \w Then [Samson] continued on his way down|strong="H03381"\w* \w and spoke|strong="H01696"\w* \w to the woman|strong="H00802"\w*, \w because|strong="H08123"\w* \w she was pleasing|strong="H03474"\w* \w to his eyes|strong="H05869"\w*.
\s1 Samson’s Riddle
\p \v 8 \w When [Samson] returned|strong="H07725"\w* \w later|strong="H03117"\w* \w to take her|strong="H03947"\w*, \w he left|strong="H05493"\w* \w the road to see|strong="H07200"\w* \w -|strong="H00853"\w* \w the lion’s|strong="H00738"\w* \w carcass|strong="H04658"\w*, \w and in [it]|strong="H01472"\w* \w . . .|strong="H00738"\w* \w was|strong="H02009"\w* \w a swarm|strong="H05712"\w* \w of bees|strong="H01682"\w*, \w along with their honey|strong="H01706"\w*. \v 9 \w So he scooped|strong="H07287"\w* \w some honey into|strong="H00413"\w* \w his hands|strong="H03709"\w* \w and ate it|strong="H00398"\w* \w as he went along|strong="H01980"\w* \w . . .|strong="H01980"\w*. \w And when he returned|strong="H01980"\w* \w to|strong="H00413"\w* \w his father|strong="H00001"\w* \w . . .|strong="H00413"\w* \w and mother|strong="H00517"\w*, \w he gave|strong="H05414"\w* some to them \w and they ate it|strong="H00398"\w*. \w But he did not|strong="H03808"\w* \w tell|strong="H05046"\w* them \w that|strong="H03588"\w* \w he had taken|strong="H07287"\w* \w the honey|strong="H01706"\w* \w from the lion’s|strong="H00738"\w* \w carcass|strong="H01472"\w*.
\p \v 10 \w Then his father|strong="H00001"\w* \w went|strong="H03381"\w* \w to|strong="H00413"\w* \w visit the woman|strong="H00802"\w*, \w and Samson|strong="H08123"\w* \w prepared|strong="H06213"\w* \w a feast|strong="H04960"\w* \w there|strong="H08033"\w*, \w as|strong="H03588"\w* \w . . .|strong="H03651"\w* \w was customary|strong="H06213"\w* \w for the bridegroom|strong="H00970"\w*. \v 11 \w And when|strong="H01961"\w* \w [the Philistines] saw him|strong="H07200"\w*,\f + \fr 14:11 \ft Or \fqa when the bride’s parents saw him\ft ; literally \fqa when they saw him\f* \w -|strong="H00853"\w* \w they selected|strong="H03947"\w* \w thirty|strong="H07970"\w* \w men to accompany him|strong="H04828"\w* \w . . .|strong="H01961"\w* \w . . .|strong="H00854"\w*.
\p \v 12 “\w Let me tell|strong="H02330"\w* \w . . .|strong="H04994"\w* you \w a riddle|strong="H02420"\w*,” \w Samson|strong="H08123"\w* \w said|strong="H00559"\w* to them. “\w If|strong="H00518"\w* \w you can solve|strong="H05046"\w* \w . . .|strong="H05046"\w* \w it|strong="H00853"\w* for me \w [within the] seven|strong="H07651"\w* \w days|strong="H03117"\w* \w of the feast|strong="H04960"\w* \w -|strong="H04672"\w*, \w I will give|strong="H05414"\w* you \w thirty|strong="H07970"\w* \w linen garments|strong="H05466"\w* \w and thirty|strong="H07970"\w* \w sets|strong="H02487"\w* \w of clothes|strong="H00899"\w*. \v 13 \w But if|strong="H00518"\w* \w you cannot|strong="H03808"\w* \w . . .|strong="H03201"\w* \w solve it|strong="H05046"\w*, \w you|strong="H00859"\w* \w must give|strong="H05414"\w* me \w thirty|strong="H07970"\w* \w linen garments|strong="H05466"\w* \w and thirty|strong="H07970"\w* \w sets|strong="H02487"\w* \w of clothes|strong="H00899"\w*.”
\p “\w Tell us|strong="H02330"\w* \w your riddle|strong="H02420"\w*,” \w they replied|strong="H00559"\w*. “\w Let us hear it|strong="H08085"\w*.”
\p \v 14 \w So he said|strong="H00559"\w* to them:
\b 
\q1 “\w Out of the eater|strong="H00398"\w* \w came|strong="H03318"\w* \w something to eat|strong="H03978"\w*,
\q2 \w and out of the strong|strong="H05794"\w* \w came|strong="H03318"\w* \w something sweet|strong="H04966"\w*.”
\p \w For three|strong="H07969"\w* \w days|strong="H03117"\w* \w they were unable|strong="H03808"\w* \w . . .|strong="H03201"\w* \w to explain|strong="H05046"\w* \w the riddle|strong="H02420"\w*. \v 15 \w So|strong="H01961"\w* \w on the fourth|strong="H07637"\w*\f + \fr 14:15 \ft LXX and Syriac; Hebrew \fqa seventh\f* \w day|strong="H03117"\w* \w they said|strong="H00559"\w* \w to Samson’s|strong="H08123"\w* \w wife|strong="H00802"\w*, “\w Entice|strong="H06601"\w* \w -|strong="H00853"\w* \w your husband|strong="H00376"\w* \w to explain|strong="H05046"\w* \w the riddle|strong="H02420"\w* to us, \w -|strong="H00853"\w* \w or|strong="H06435"\w* \w we will burn|strong="H08313"\w* \w you|strong="H00853"\w* \w -|strong="H00853"\w* \w and your father’s|strong="H00001"\w* \w household|strong="H01004"\w* \w to death|strong="H00784"\w*. \w Did you invite us|strong="H07121"\w* here \w . . .|strong="H03808"\w* \w to rob us|strong="H03423"\w*?”
\p \v 16 \w Then Samson’s|strong="H08123"\w* \w wife|strong="H00802"\w* \w came to him|strong="H05921"\w*, \w weeping|strong="H01058"\w*, \w and said|strong="H00559"\w*, \w . . .|strong="H07535"\w* “\w You hate me|strong="H08130"\w*! \w You do not really|strong="H03808"\w* \w love me|strong="H00157"\w*! \w You have posed|strong="H02330"\w* \w to my people|strong="H01121"\w* \w . . .|strong="H05971"\w* . . . \w a riddle|strong="H02420"\w*, \w but have not|strong="H03808"\w* \w explained it to me|strong="H05046"\w*.”
\p “\w Look|strong="H02009"\w*,” \w he said|strong="H00559"\w*, “\w I have not|strong="H03808"\w* \w even explained|strong="H05046"\w* \w it to my father|strong="H00001"\w* \w or mother|strong="H00517"\w*, \w so why should I explain it|strong="H05046"\w* to you?”
\p \v 17 \w She wept|strong="H01058"\w* \w . . .|strong="H05921"\w* \w the whole seven|strong="H07651"\w* \w days|strong="H03117"\w* \w -|strong="H00834"\w* \w -|strong="H01961"\w* \w of the feast|strong="H04960"\w*, \w and finally|strong="H01961"\w* \w on the seventh|strong="H07637"\w* \w day|strong="H03117"\w*, \w because|strong="H03588"\w* \w she had pressed him so much|strong="H06693"\w*, \w he told|strong="H05046"\w* her [the answer]. \w And in turn she explained|strong="H05046"\w* \w the riddle|strong="H02420"\w* \w to her people|strong="H01121"\w* \w . . .|strong="H05971"\w*.
\p \v 18 \w Before|strong="H02962"\w* \w sunset|strong="H00935"\w* \w . . .|strong="H02775"\w* \w on the seventh|strong="H07637"\w* \w day|strong="H03117"\w*, \w the men|strong="H00582"\w* \w of the city|strong="H05892"\w* \w said|strong="H00559"\w* to [Samson]:
\b 
\q1 “\w What|strong="H04100"\w* \w is sweeter|strong="H04966"\w* \w than honey|strong="H01706"\w*?
\q2 \w And what [is]|strong="H04100"\w* \w stronger|strong="H05794"\w* \w than a lion|strong="H00738"\w*?”
\p \w So he said|strong="H00559"\w* to them:
\b 
\q1 “\w If you had not|strong="H03884"\w* \w plowed|strong="H02790"\w* \w with my heifer|strong="H05697"\w*,
\q2 \w you would not|strong="H03808"\w* \w have solved|strong="H04672"\w* \w my riddle|strong="H02420"\w*!”
\p \v 19 \w Then the Spirit|strong="H07307"\w* \w of the LORD|strong="H03068"\w* \w came mightily|strong="H06743"\w* \w upon him|strong="H05921"\w*, \w and he went down|strong="H03381"\w* \w to Ashkelon|strong="H00831"\w*, \w killed|strong="H05221"\w* . . . \w thirty|strong="H07970"\w* \w of their men|strong="H00376"\w*, \w took|strong="H03947"\w* \w -|strong="H00853"\w* \w their apparel|strong="H02488"\w*, \w and gave|strong="H05414"\w* \w their clothes|strong="H02487"\w* \w to those who had solved|strong="H05046"\w* \w the riddle|strong="H02420"\w*. \w And burning|strong="H02734"\w* \w with anger|strong="H00639"\w*, \w Samson returned|strong="H05927"\w* \w to his father’s|strong="H00001"\w* \w house|strong="H01004"\w*, \v 20 \w and his|strong="H08123"\w* \w . . .|strong="H04828"\w* \w wife|strong="H00802"\w* \w was given|strong="H01961"\w* \w to one of the men who|strong="H00834"\w* \w had accompanied|strong="H07462"\w* him.
\c 15
\s1 Samson’s Revenge
\p \v 1 \w Later on|strong="H01961"\w* \w . . .|strong="H03117"\w*, \w at the time|strong="H03117"\w* \w of the wheat|strong="H02406"\w* \w harvest|strong="H07105"\w*, \w Samson|strong="H08123"\w* \w -|strong="H00853"\w* \w took|strong="H01423"\w* \w a young goat|strong="H05795"\w* \w and went to visit|strong="H06485"\w* \w his wife|strong="H00802"\w*. “\w I want to go|strong="H00935"\w* \w to|strong="H00413"\w* \w my wife|strong="H00802"\w* \w in her room|strong="H02315"\w*,” \w he said|strong="H00559"\w*. \w But her father|strong="H00001"\w* \w would not|strong="H03808"\w* \w let him|strong="H05414"\w* \w enter|strong="H00935"\w*.
\p \v 2 “\w I was sure|strong="H00559"\w* \w . . .|strong="H00559"\w* \w that|strong="H03588"\w* \w you thoroughly hated her|strong="H08130"\w* \w . . .|strong="H08130"\w*,” \w said|strong="H00559"\w* \w her father|strong="H00001"\w*, “\w so I gave her|strong="H05414"\w* \w to one of the men who accompanied you|strong="H04828"\w*. \w Is not|strong="H03808"\w* \w her younger|strong="H06996"\w* \w sister|strong="H00269"\w* \w more beautiful|strong="H02896"\w* \w than she|strong="H04480"\w*? \w Please|strong="H04994"\w* \w take her|strong="H01961"\w* \w instead|strong="H08478"\w*.”
\p \v 3 \w Samson|strong="H08123"\w* \w said|strong="H00559"\w* to them, “\w This time|strong="H06471"\w* \w I will be blameless|strong="H05352"\w* \w -|strong="H03588"\w* \w -|strong="H00589"\w* \w -|strong="H05973"\w* \w in doing|strong="H06213"\w* \w harm|strong="H07451"\w* \w to the Philistines|strong="H06430"\w*.”
\p \v 4 \w Then Samson|strong="H08123"\w* \w went out|strong="H01980"\w* \w and caught|strong="H03920"\w* \w three|strong="H07969"\w* \w hundred|strong="H03967"\w* \w foxes|strong="H07776"\w*. \w And he took|strong="H03947"\w* \w torches|strong="H03940"\w*, \w turned|strong="H06437"\w* \w the foxes tail-to-tail|strong="H02180"\w* \w . . .|strong="H00413"\w*, \w . . .|strong="H02180"\w* \w and fastened|strong="H07760"\w* \w a|strong="H00259"\w* \w torch|strong="H03940"\w* \w between|strong="H00996"\w* \w each pair|strong="H08147"\w* \w of tails|strong="H02180"\w* \w . . .|strong="H08432"\w*. \v 5 \w Then he lit|strong="H01197"\w* \w . . .|strong="H00784"\w* \w the torches|strong="H03940"\w* \w and released [the foxes]|strong="H07971"\w* \w into the standing grain|strong="H07054"\w* \w of the Philistines|strong="H06430"\w*, \w burning up|strong="H01197"\w* \w the piles of grain|strong="H01430"\w* \w . . .|strong="H05704"\w* \w and the standing grain|strong="H07054"\w*, \w as well as|strong="H05704"\w* \w the vineyards|strong="H03754"\w* \w and olive groves|strong="H02132"\w*.
\p \v 6 “\w Who|strong="H04310"\w* \w did|strong="H06213"\w* \w this|strong="H02063"\w*?” \w the Philistines|strong="H06430"\w* \w demanded|strong="H00559"\w*.
\p “\w It was Samson|strong="H08123"\w*, \w the son-in-law|strong="H02860"\w* \w of the Timnite|strong="H08554"\w*,” \w they were told|strong="H00559"\w*. “\w For|strong="H03588"\w* \w -|strong="H03947"\w* \w -|strong="H00853"\w* \w his wife|strong="H00802"\w* \w was given|strong="H05414"\w* \w to his companion|strong="H04828"\w*.”
\p \w So the Philistines|strong="H06430"\w* \w went up|strong="H05927"\w* \w and burned|strong="H08313"\w* \w her and her father|strong="H00001"\w* \w -|strong="H00853"\w* \w -|strong="H00853"\w* \w to death|strong="H00784"\w*.
\p \v 7 \w And Samson|strong="H08123"\w* \w told|strong="H00559"\w* them, “\w Because|strong="H00518"\w* \w you have done|strong="H06213"\w* \w this|strong="H02063"\w*, \w I will not rest|strong="H02308"\w* \w until|strong="H03588"\w* \w . . .|strong="H00518"\w* \w I have taken vengeance|strong="H05358"\w* upon you \w -|strong="H00310"\w*.” \v 8 \w And he struck|strong="H05221"\w* \w them|strong="H00853"\w* \w ruthlessly|strong="H07785"\w* \w . . .|strong="H05921"\w* \w . . .|strong="H03409"\w*\f + \fr 15:8 \ft Literally \fqa he struck them hip and thigh\f* \w with a great|strong="H01419"\w* \w slaughter|strong="H04347"\w*, \w and then went down|strong="H03381"\w* \w and stayed|strong="H03427"\w* \w in the cave|strong="H05585"\w* \w at the rock|strong="H05553"\w* \w of Etam|strong="H05862"\w*.
\p \v 9 \w Then the Philistines|strong="H06430"\w* \w went up|strong="H05927"\w*, \w camped|strong="H02583"\w* \w in Judah|strong="H03063"\w*, \w and deployed themselves|strong="H05203"\w* \w near [the town of] Lehi|strong="H03896"\w*.\f + \fr 15:9 \ft Literally \fqa and spread out in Lehi\f*
