\p \v 17 \w And|strong="H01961"\w* \w when [Samson] had finished|strong="H03615"\w* \w speaking|strong="H01696"\w*, \w he cast|strong="H07993"\w* \w the jawbone|strong="H03895"\w* \w from his hand|strong="H03027"\w*; \w and he named|strong="H07121"\w* \w that|strong="H01931"\w* \w place|strong="H04725"\w* \w vvv|strong="H07437"\w* \w Ramath-lehi|strong="H07437"\w*.\f + \fr 15:17 \fqa Ramath-lehi \ft means \fqa the hill of the jawbone\ft .\f*
\p \v 18 \w And being very|strong="H03966"\w* \w thirsty|strong="H06770"\w*, \w [Samson] cried out|strong="H07121"\w* \w to|strong="H00413"\w* \w the LORD|strong="H03068"\w* \w . . .|strong="H00559"\w*, “\w You|strong="H00859"\w* \w have accomplished|strong="H05414"\w* \w this|strong="H02063"\w* \w great|strong="H01419"\w* \w deliverance|strong="H08668"\w* \w through|strong="H03027"\w* \w Your servant|strong="H05650"\w*. \w -|strong="H00853"\w* \w Must I now|strong="H06258"\w* \w die|strong="H04191"\w* \w of thirst|strong="H06772"\w* \w and fall|strong="H05307"\w* \w into the hands|strong="H03027"\w* \w of the uncircumcised|strong="H06189"\w*?”
\p \v 19 \w So God|strong="H00430"\w* \w -|strong="H00853"\w* \w opened up|strong="H01234"\w* \w the hollow place|strong="H04388"\w*\w . . .|strong="H00834"\w* \w in Lehi|strong="H03895"\w*, \w and water|strong="H04325"\w* \w came out|strong="H03318"\w* \w of it|strong="H04480"\w*. \w When Samson drank|strong="H08354"\w*, \w his strength|strong="H07307"\w* \w returned|strong="H07725"\w*, \w and he was revived|strong="H02421"\w*. \w That is why|strong="H05921"\w* \w . . .|strong="H03651"\w* \w he named it|strong="H07121"\w* \w . . .|strong="H08034"\w* \w vvv|strong="H05875"\w* \w En-hakkore|strong="H05875"\w*,\f + \fr 15:19 \fqa En-hakkore \ft means \fqa the spring of him who calls\ft .\f* \w and it remains|strong="H00834"\w* \w in Lehi|strong="H03896"\w* \w to|strong="H05704"\w* \w this|strong="H02088"\w* \w day|strong="H03117"\w*.
\p \v 20 \w And [Samson] judged|strong="H08199"\w* \w -|strong="H00853"\w* \w Israel|strong="H03478"\w* \w for twenty|strong="H06242"\w* \w years|strong="H08141"\w* \w in the days|strong="H03117"\w* \w of the Philistines|strong="H06430"\w*.
\c 16
\s1 Samson Escapes Gaza
\p \v 1 \w One day Samson|strong="H08123"\w* \w went|strong="H01980"\w* \w to Gaza|strong="H05804"\w*, \w where|strong="H08033"\w* \w . . .|strong="H00802"\w* \w he saw|strong="H07200"\w* \w a prostitute|strong="H02181"\w* \w and went in to spend the night|strong="H00935"\w* \w with her|strong="H00413"\w*.
