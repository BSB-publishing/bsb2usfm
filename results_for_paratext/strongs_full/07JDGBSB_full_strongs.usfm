\c 19
\s1 The Crime of the Benjamites
\p \v 1 \w Now|strong="H01961"\w* \w in those|strong="H01992"\w* \w days|strong="H03117"\w*, \w when there was no|strong="H00369"\w* \w king|strong="H04428"\w* \w in Israel|strong="H03478"\w*, \w . . .|strong="H01961"\w* \w . . .|strong="H00376"\w* \w a Levite|strong="H03881"\w* \w who lived|strong="H01481"\w* \w in the remote|strong="H03411"\w* \w hill country|strong="H02022"\w* \w of Ephraim|strong="H00669"\w* \w took|strong="H03947"\w* for himself \w vvv|strong="H00802"\w* \w a concubine|strong="H06370"\w* \w vvv|strong="H01035"\w* \w from Bethlehem|strong="H01035"\w* \w in Judah|strong="H03063"\w*. \v 2 \w But she|strong="H06370"\w* \w was unfaithful|strong="H02181"\w* \w to him|strong="H05921"\w*\f + \fr 19:2 \ft LXX \fqa became angry with him\f* \w and left|strong="H01980"\w* \w him|strong="H00854"\w* \w to return to|strong="H00413"\w* \w her father’s|strong="H00001"\w* \w house|strong="H01004"\w* \w in|strong="H00413"\w* \w vvv|strong="H01035"\w* \w Bethlehem|strong="H01035"\w* \w in Judah|strong="H03063"\w*.
\p \w After she had been|strong="H01961"\w* \w there|strong="H08033"\w* \w -|strong="H03117"\w* \w four|strong="H00702"\w* \w months|strong="H02320"\w*, \v 3 \w her husband|strong="H00376"\w* \w got up|strong="H06965"\w* \w and went|strong="H01980"\w* \w after her|strong="H00310"\w* \w to speak|strong="H01696"\w* \w kindly|strong="H03820"\w* \w to her|strong="H05921"\w* \w and bring her back|strong="H07725"\w*, \w taking his servant|strong="H05288"\w* \w . . .|strong="H05973"\w* \w and a pair|strong="H06776"\w* \w of donkeys|strong="H02543"\w*. \w So [the girl] brought him|strong="H00935"\w* \w into her father’s|strong="H00001"\w* \w house|strong="H01004"\w*, \w and when [her]|strong="H05291"\w* \w father|strong="H00001"\w* \w saw him|strong="H07200"\w*, \w he gladly|strong="H08055"\w* \w welcomed him|strong="H07122"\w*. \v 4 \w His father-in-law|strong="H02859"\w*, \w the girl’s|strong="H05291"\w* \w father|strong="H00001"\w*, \w persuaded him to stay|strong="H02388"\w* . . ., \w so he remained|strong="H03427"\w* \w with him|strong="H00854"\w* \w three|strong="H07969"\w* \w days|strong="H03117"\w*, \w eating|strong="H00398"\w*, \w drinking|strong="H08354"\w*, \w and lodging|strong="H03885"\w* \w there|strong="H08033"\w*.
\p \v 5 \w -|strong="H01961"\w* \w On the fourth|strong="H07243"\w* \w day|strong="H03117"\w*, \w they got up early|strong="H07925"\w* \w in the morning|strong="H01242"\w* \w and prepared|strong="H06965"\w* \w to depart|strong="H01980"\w*, \w but the girl’s|strong="H05291"\w* \w father|strong="H00001"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w his son-in-law|strong="H02860"\w*, “\w Refresh|strong="H05582"\w* \w your heart|strong="H03820"\w* \w with a morsel|strong="H06595"\w* \w of bread|strong="H03899"\w*, \w and then|strong="H00310"\w* \w you can go|strong="H01980"\w*.” \v 6 \w So they sat down|strong="H03427"\w* \w and the two|strong="H08147"\w* \w of them ate|strong="H00398"\w* \w and drank|strong="H08354"\w* \w together|strong="H03162"\w*. \w Then the girl’s|strong="H05291"\w* \w father|strong="H00001"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w the man|strong="H00376"\w*, “\w Please|strong="H04994"\w* \w agree|strong="H02974"\w* \w to stay overnight|strong="H03885"\w* \w and let your heart|strong="H03820"\w* \w be merry|strong="H03190"\w*.” \v 7 \w The man|strong="H00376"\w* \w got up|strong="H06965"\w* \w to depart|strong="H01980"\w*, \w but his father-in-law|strong="H02859"\w* \w . . .|strong="H07725"\w* \w persuaded|strong="H06484"\w* him, \w so he stayed|strong="H03885"\w* \w there that night|strong="H08033"\w*.
\p \v 8 \w On the fifth|strong="H02549"\w* \w day|strong="H03117"\w*, \w he got up early|strong="H07925"\w* \w in the morning|strong="H01242"\w* \w to depart|strong="H01980"\w*, \w but the girl’s|strong="H05291"\w* \w father|strong="H00001"\w* \w said|strong="H00559"\w*, “\w Please|strong="H04994"\w* \w refresh|strong="H05582"\w* \w your heart|strong="H03824"\w*.” \w So they waited|strong="H04102"\w* \w until|strong="H05704"\w* \w late afternoon|strong="H05186"\w* \w . . .|strong="H03117"\w* \w and the two|strong="H08147"\w* \w of them ate|strong="H00398"\w*. \v 9 \w When the man|strong="H00376"\w* \w got up|strong="H06965"\w* \w to depart|strong="H01980"\w* \w . . .|strong="H01931"\w* \w with his concubine|strong="H06370"\w* \w and his servant|strong="H05288"\w*, \w his father-in-law|strong="H02859"\w*, \w the girl’s|strong="H05291"\w* \w father|strong="H00001"\w*, \w said|strong="H00559"\w* to him, “\w Look|strong="H02009"\w*, \w the day|strong="H03117"\w* \w is drawing|strong="H07503"\w* \w to a close|strong="H06150"\w*. \w Please|strong="H04994"\w* \w spend the night|strong="H03885"\w*. \w . . .|strong="H04994"\w* \w See|strong="H02009"\w*, \w the day|strong="H03117"\w* \w is almost over|strong="H02583"\w*. \w Spend the night|strong="H03885"\w* \w here|strong="H06311"\w*, \w that your heart|strong="H03824"\w* \w may be merry|strong="H03190"\w*. \w Then you can get up early|strong="H07925"\w* \w tomorrow|strong="H04279"\w* \w for your journey|strong="H01870"\w* \w . . .|strong="H01980"\w* \w home|strong="H00168"\w*.”
\p \v 10 \w But the man|strong="H00376"\w* \w was unwilling|strong="H03808"\w* \w . . .|strong="H00014"\w* \w to spend the night|strong="H03885"\w*. \w He got up|strong="H06965"\w* \w and departed|strong="H01980"\w*, \w and arrived|strong="H00935"\w* \w . . .|strong="H05704"\w* \w opposite|strong="H05227"\w* \w Jebus|strong="H02982"\w* \w (that is|strong="H01931"\w*, \w Jerusalem)|strong="H03389"\w*, \w with|strong="H05973"\w* \w his two|strong="H06776"\w* \w saddled|strong="H02280"\w* \w donkeys|strong="H02543"\w* \w and his concubine|strong="H06370"\w* \w -|strong="H05973"\w*. \v 11 \w When they|strong="H01992"\w* \w were near|strong="H05973"\w* \w Jebus|strong="H02982"\w* \w and the day|strong="H03117"\w* \w was almost|strong="H03966"\w* \w gone|strong="H03381"\w*, \w the servant|strong="H05288"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w his master|strong="H00113"\w*, \w . . .|strong="H01980"\w* “\w Please|strong="H04994"\w*, \w let us stop|strong="H05493"\w* \w at|strong="H00413"\w* \w this|strong="H02063"\w* \w Jebusite|strong="H02983"\w* \w city|strong="H05892"\w* \w and spend the night|strong="H03885"\w* here.”
