\p \v 24 \w Then he|strong="H01439"\w* \w added|strong="H00559"\w* \w -|strong="H00413"\w*, “\w Let me make a request|strong="H07592"\w* \w . . .|strong="H07596"\w* of you, \w that each of you|strong="H00376"\w* \w give|strong="H05414"\w* me \w an earring|strong="H05141"\w* \w from his plunder|strong="H07998"\w*.” (\w For|strong="H03588"\w* \w [the enemies] had gold|strong="H02091"\w* \w earrings|strong="H05141"\w* \w because|strong="H03588"\w* \w they|strong="H01992"\w* \w were Ishmaelites|strong="H03459"\w*.)
