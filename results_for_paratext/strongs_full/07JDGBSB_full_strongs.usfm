\p \v 26 \w Meanwhile, Gaal|strong="H01603"\w* \w son|strong="H01121"\w* \w of Ebed|strong="H05651"\w* \w came|strong="H00935"\w* \w with his brothers|strong="H00251"\w* \w and crossed|strong="H05674"\w* \w into Shechem|strong="H07927"\w*, \w and the leaders|strong="H01167"\w* \w of Shechem|strong="H07927"\w* \w put their confidence|strong="H00982"\w* in him. \v 27 \w And after they had gone out|strong="H03318"\w* \w into the fields|strong="H07704"\w*, \w gathered [grapes]|strong="H01219"\w* \w -|strong="H00853"\w* \w from their vineyards|strong="H03754"\w*, \w and trodden [them]|strong="H01869"\w*, \w they held|strong="H06213"\w* \w a festival|strong="H01974"\w* \w and went|strong="H00935"\w* \w into the house|strong="H01004"\w* \w of their god|strong="H00430"\w*; \w and as they ate|strong="H00398"\w* \w and drank|strong="H08354"\w*, \w they cursed|strong="H07043"\w* \w -|strong="H00853"\w* \w Abimelech|strong="H00040"\w*.
\p \v 28 \w Then Gaal|strong="H01603"\w* \w son|strong="H01121"\w* \w of Ebed|strong="H05651"\w* \w said|strong="H00559"\w*, “\w Who|strong="H04310"\w* \w is Abimelech|strong="H00040"\w*, \w and who|strong="H04310"\w* \w is Shechem|strong="H07927"\w*, \w that|strong="H03588"\w* \w we should serve him|strong="H05647"\w*? \w Is he not|strong="H03808"\w* \w the son|strong="H01121"\w* \w of Jerubbaal|strong="H03378"\w*, \w and is not Zebul|strong="H02083"\w* \w his officer|strong="H06496"\w*? \w You are to serve|strong="H05647"\w* \w -|strong="H00853"\w* \w the men|strong="H00582"\w* \w of Hamor|strong="H02544"\w*, \w the father|strong="H00001"\w* \w of Shechem|strong="H07927"\w*. \w Why|strong="H04069"\w* \w should we|strong="H00587"\w* \w serve Abimelech|strong="H05647"\w*? \v 29 \w If only|strong="H04310"\w* \w . . .|strong="H05414"\w* \w -|strong="H00853"\w* \w this|strong="H02088"\w* \w people|strong="H05971"\w* \w were under my authority|strong="H03027"\w*, \w I would remove|strong="H05493"\w* \w -|strong="H00853"\w* \w Abimelech|strong="H00040"\w*; \w I would say|strong="H00559"\w* \w to [him]|strong="H00040"\w*, ‘\w Muster|strong="H07235"\w* \w your army|strong="H06635"\w* \w and come out|strong="H03318"\w*!’”\f + \fr 9:29 \ft LXX; Hebrew \fqa I would remove Abimelech.” And he said to him, “Muster your army and come out!”\f*
\s1 The Fall of Shechem
\p \v 30 \w When Zebul|strong="H02083"\w* \w the governor|strong="H08269"\w* \w of the city|strong="H05892"\w* \w -|strong="H00853"\w* \w heard|strong="H08085"\w* \w the words|strong="H01697"\w* \w of Gaal|strong="H01603"\w* \w son|strong="H01121"\w* \w of Ebed|strong="H05651"\w*, \w he burned|strong="H02734"\w* \w with anger|strong="H00639"\w*. \v 31 \w So he covertly sent|strong="H07971"\w* \w . . .|strong="H08649"\w* \w messengers|strong="H04397"\w* \w to|strong="H00413"\w* \w Abimelech|strong="H00040"\w*\f + \fr 9:31 \ft Or \fqa he sent messengers to Abimelech in Arumah\ft ; see verse 41.\f* \w to say|strong="H00559"\w*, “\w Look|strong="H02009"\w*, \w Gaal|strong="H01603"\w* \w son|strong="H01121"\w* \w of Ebed|strong="H05651"\w* \w and his brothers|strong="H00251"\w* \w have come|strong="H00935"\w* \w to Shechem|strong="H07927"\w* \w . . .|strong="H02009"\w* \w and are stirring up|strong="H06696"\w*\f + \fr 9:31 \ft Or \fqa besieging \ft or \fqa closing up\f* \w -|strong="H00853"\w* \w the city|strong="H05892"\w* \w against you|strong="H05921"\w*. \v 32 \w Now then|strong="H06258"\w*, \w tonight|strong="H03915"\w* \w you|strong="H00859"\w* \w and the people|strong="H05971"\w* \w -|strong="H00834"\w* \w with you|strong="H00854"\w* \w are to come|strong="H06965"\w* \w and lie in wait|strong="H00693"\w* \w in the fields|strong="H07704"\w*. \v 33 \w And|strong="H01961"\w* \w in the morning|strong="H01242"\w* \w at sunrise|strong="H02224"\w* \w . . .|strong="H08121"\w*, \w get up|strong="H07925"\w* \w and advance|strong="H06584"\w* \w against|strong="H05921"\w* \w the city|strong="H05892"\w*. \w . . .|strong="H02009"\w* \w When [Gaal]|strong="H01931"\w* \w and his men|strong="H05971"\w* \w -|strong="H00834"\w* \w -|strong="H00854"\w* \w come out|strong="H03318"\w* \w against you|strong="H00413"\w*, \w do|strong="H06213"\w* to them \w whatever|strong="H00834"\w* \w you are able|strong="H04672"\w* \w . . .|strong="H03027"\w*.”
\p \v 34 \w So Abimelech|strong="H00040"\w* \w and all|strong="H03605"\w* \w his troops|strong="H05971"\w* \w -|strong="H00834"\w* \w -|strong="H05973"\w* \w set out|strong="H06965"\w* \w by night|strong="H03915"\w* \w and lay in wait|strong="H00693"\w* \w against|strong="H05921"\w* \w Shechem|strong="H07927"\w* \w in four|strong="H00702"\w* \w companies|strong="H07218"\w*.
\p \v 35 \w Now Gaal|strong="H01603"\w* \w son|strong="H01121"\w* \w of Ebed|strong="H05651"\w* \w went out|strong="H03318"\w* \w and stood|strong="H05975"\w* \w at the entrance|strong="H06607"\w* \w of the city|strong="H05892"\w* \w gate|strong="H08179"\w* \w just as Abimelech|strong="H00040"\w* \w and his men|strong="H05971"\w* \w -|strong="H00834"\w* \w -|strong="H00854"\w* \w came out|strong="H06965"\w* \w from|strong="H04480"\w* \w their hiding places|strong="H03993"\w*.
\p \v 36 \w When Gaal|strong="H01603"\w* \w -|strong="H00853"\w* \w saw|strong="H07200"\w* \w the people|strong="H05971"\w*, \w he said|strong="H00559"\w* \w to|strong="H00413"\w* \w Zebul|strong="H02083"\w*, “\w Look|strong="H02009"\w*, \w people|strong="H05971"\w* \w are coming down|strong="H03381"\w* \w from the mountains|strong="H07218"\w* \w . . .|strong="H02022"\w*!”
\p \w But Zebul|strong="H02083"\w* \w -|strong="H00853"\w* \w replied|strong="H00559"\w* \w . . .|strong="H00413"\w*, “\w The shadows|strong="H06738"\w* \w of the mountains|strong="H02022"\w* \w look|strong="H07200"\w* \w like men|strong="H00582"\w* \w to you|strong="H00859"\w*.”
\p \v 37 \w Then Gaal|strong="H01603"\w* \w spoke up|strong="H01696"\w* \w . . .|strong="H00559"\w* \w again|strong="H03254"\w* \w . . .|strong="H05750"\w*, “\w Look|strong="H02009"\w*, \w people|strong="H05971"\w* \w are coming down|strong="H03381"\w* \w from|strong="H05973"\w* \w the center|strong="H02872"\w* \w of the land|strong="H00776"\w*,\f + \fr 9:37 \ft Literally \fqa the navel of the earth\f* \w and one|strong="H00259"\w* \w company|strong="H07218"\w* \w is coming|strong="H00935"\w* \w by way of|strong="H01870"\w* \w the Diviners’|strong="H06049"\w* \w Oak|strong="H00436"\w*.\f + \fr 9:37 \ft Or \fqa the Diviners’ Terebinth \ft or \fqa the diviners’ tree\f*”
\p \v 38 “\w Where|strong="H00346"\w* \w is your gloating|strong="H06310"\w* \w -|strong="H00834"\w* \w now|strong="H00645"\w*?” \w Zebul|strong="H02083"\w* \w replied|strong="H00559"\w* \w . . .|strong="H00413"\w*. “\w You said|strong="H00559"\w*, ‘\w Who|strong="H04310"\w* \w is Abimelech|strong="H00040"\w* \w that|strong="H03588"\w* \w we should serve him|strong="H05647"\w*?’ \w Are these not|strong="H03808"\w* \w . . .|strong="H02088"\w* \w the people|strong="H05971"\w* \w -|strong="H00834"\w* \w you ridiculed|strong="H03988"\w*? \w Go out|strong="H03318"\w* \w now|strong="H06258"\w* \w . . .|strong="H04994"\w* \w and fight|strong="H03898"\w* them!”
\p \v 39 \w So Gaal|strong="H01603"\w* \w went out|strong="H03318"\w* \w before|strong="H06440"\w* \w the leaders|strong="H01167"\w* \w of Shechem|strong="H07927"\w* \w and fought|strong="H03898"\w* \w against Abimelech|strong="H00040"\w*, \v 40 \w but Abimelech|strong="H00040"\w* \w pursued him|strong="H07291"\w*, \w and Gaal fled|strong="H05127"\w* \w before him|strong="H06440"\w*. \w And many [Shechemites]|strong="H07227"\w* \w fell|strong="H05307"\w* \w wounded|strong="H02491"\w* \w all the way|strong="H05704"\w* \w to the entrance|strong="H06607"\w* \w of the gate|strong="H08179"\w*. \v 41 \w Abimelech|strong="H00040"\w* \w stayed|strong="H03427"\w* \w in Arumah|strong="H00725"\w*, \w and Zebul|strong="H02083"\w* \w -|strong="H00853"\w* \w drove|strong="H01644"\w* \w Gaal|strong="H01603"\w* \w -|strong="H00853"\w* \w and his brothers|strong="H00251"\w* \w out of|strong="H03427"\w* \w Shechem|strong="H07927"\w*.
\p \v 42 \w -|strong="H01961"\w* \w The next day|strong="H04283"\w* \w the people [of Shechem]|strong="H05971"\w* \w went out|strong="H03318"\w* \w into the fields|strong="H07704"\w*, \w and this was reported|strong="H05046"\w* \w to Abimelech|strong="H00040"\w*. \v 43 \w So he took|strong="H03947"\w* \w -|strong="H00853"\w* \w his men|strong="H05971"\w*, \w divided them|strong="H02673"\w* \w into three|strong="H07969"\w* \w companies|strong="H07218"\w*, \w and lay in wait|strong="H00693"\w* \w in the fields|strong="H07704"\w*. \w When he saw|strong="H07200"\w* \w . . .|strong="H02009"\w* \w the people|strong="H05971"\w* \w coming out|strong="H03318"\w* \w of|strong="H04480"\w* \w the city|strong="H05892"\w*, \w he rose up|strong="H06965"\w* \w against them|strong="H05921"\w* \w and attacked them|strong="H05221"\w*.
\p \v 44 \w Then Abimelech|strong="H00040"\w* \w and the companies|strong="H07218"\w* \w -|strong="H00834"\w* \w with him|strong="H05973"\w* \w rushed forward|strong="H06584"\w* \w and took their stand|strong="H05975"\w* \w at the entrance|strong="H06607"\w* \w of the city|strong="H05892"\w* \w gate|strong="H08179"\w*. \w The other two|strong="H08147"\w* \w companies|strong="H07218"\w* \w rushed|strong="H06584"\w* \w against|strong="H05921"\w* \w all|strong="H03605"\w* \w who [were]|strong="H00834"\w* \w in the fields|strong="H07704"\w* \w and struck them down|strong="H05221"\w*. \v 45 \w And all|strong="H03605"\w* \w that|strong="H01931"\w* \w day|strong="H03117"\w* \w Abimelech|strong="H00040"\w* \w fought|strong="H03898"\w* \w against the city|strong="H05892"\w* \w until he had captured it|strong="H03920"\w* \w -|strong="H00853"\w* \w -|strong="H05892"\w* \w -|strong="H00853"\w* \w and killed|strong="H02026"\w* \w its people|strong="H05971"\w* \w -|strong="H00834"\w* -. \w Then he demolished|strong="H05422"\w* \w -|strong="H00853"\w* \w the city|strong="H05892"\w* \w and sowed|strong="H02232"\w* \w it with salt|strong="H04417"\w*.
\p \v 46 \w On hearing of this|strong="H08085"\w*, \w all|strong="H03605"\w* \w the leaders|strong="H01167"\w* \w in the tower|strong="H04026"\w* \w of Shechem|strong="H07927"\w* \w entered|strong="H00935"\w* \w . . .|strong="H00413"\w* \w the inner chamber|strong="H06877"\w* \w of the temple|strong="H01004"\w* \w vvv|strong="H00410"\w* \w of El-berith|strong="H01286"\w*.\f + \fr 9:46 \fqa El-berith \ft was another name for \fqa Baal-berith\ft ; see verse 4.\f* \v 47 \w And when Abimelech|strong="H00040"\w* \w was told|strong="H05046"\w* \w that|strong="H03588"\w* \w all|strong="H03605"\w* \w the leaders|strong="H01167"\w* \w in the tower|strong="H04026"\w* \w of Shechem|strong="H07927"\w* \w were gathered there|strong="H06908"\w*, \v 48 \w he|strong="H00040"\w* \w and all|strong="H03605"\w* \w his men|strong="H05971"\w* \w -|strong="H00834"\w* \w -|strong="H00854"\w* \w went up|strong="H05927"\w* \w to Mount|strong="H02022"\w* \w Zalmon|strong="H06756"\w*. \w . . .|strong="H01931"\w* \w Abimelech|strong="H00040"\w* \w -|strong="H00853"\w* \w took|strong="H03947"\w* \w his axe|strong="H07134"\w* \w in his hand|strong="H03027"\w* \w and cut|strong="H03772"\w* \w a branch|strong="H07754"\w* \w from the trees|strong="H06086"\w*, \w which he lifted|strong="H05375"\w*\w . . .|strong="H07760"\w* \w to|strong="H05921"\w* \w his shoulder|strong="H07926"\w*, \w saying|strong="H00559"\w* \w to|strong="H00413"\w* \w his men|strong="H05971"\w* \w -|strong="H00834"\w* \w -|strong="H05973"\w*, “\w Hurry|strong="H04116"\w* \w and do|strong="H06213"\w* \w what|strong="H04100"\w* \w you have seen me|strong="H07200"\w* \w do|strong="H06213"\w* \w . . .|strong="H03644"\w*.”
\p \v 49 \w So each|strong="H03605"\w* \w man|strong="H00376"\w* \w -|strong="H05971"\w* \w also|strong="H01571"\w* \w cut|strong="H03772"\w* \w his own branch|strong="H07754"\w* \w and followed|strong="H01980"\w* \w . . .|strong="H00310"\w* \w Abimelech|strong="H00040"\w*. \w Then they piled [the branches]|strong="H07760"\w* \w against|strong="H05921"\w* \w the inner chamber|strong="H06877"\w* \w and set|strong="H03341"\w* \w -|strong="H00853"\w* \w [it]|strong="H06877"\w* \w on fire|strong="H00784"\w* \w above them|strong="H05921"\w*, \w killing|strong="H04191"\w* \w . . .|strong="H01571"\w* \w everyone|strong="H03605"\w* \w . . .|strong="H00582"\w* \w in the tower|strong="H04026"\w* \w of Shechem|strong="H07927"\w*, \w about a thousand|strong="H00505"\w* \w men|strong="H00376"\w* \w and women|strong="H00802"\w*.
\s1 Abimelech’s Punishment
\p \v 50 \w Then Abimelech|strong="H00040"\w* \w went|strong="H01980"\w* \w to|strong="H00413"\w* \w Thebez|strong="H08405"\w*, \w encamped|strong="H02583"\w* \w against it|strong="H08405"\w*, \w and captured it|strong="H03920"\w*. \v 51 \w But there was|strong="H01961"\w* \w a strong|strong="H05797"\w* \w tower|strong="H04026"\w* \w inside|strong="H08432"\w* \w the city|strong="H05892"\w*, \w and all|strong="H03605"\w* \w the men|strong="H00582"\w*, \w women|strong="H00802"\w*, \w . . .|strong="H03605"\w* \w and leaders|strong="H01167"\w* \w of the city|strong="H05892"\w* \w fled|strong="H05127"\w* \w there|strong="H08033"\w*. \w They locked themselves in|strong="H05462"\w* \w . . .|strong="H01157"\w* \w and went up|strong="H05927"\w* \w to|strong="H05921"\w* \w the roof|strong="H01406"\w* \w of the tower|strong="H04026"\w*.
\p \v 52 \w When Abimelech|strong="H00040"\w* \w came|strong="H00935"\w* \w to|strong="H05704"\w* \w attack|strong="H03898"\w* \w the tower|strong="H04026"\w*, \w he approached|strong="H05066"\w* \w . . .|strong="H05704"\w* \w its|strong="H04026"\w* \w entrance|strong="H06607"\w* \w to set it on fire|strong="H08313"\w* \w . . .|strong="H00784"\w*. \v 53 \w But a|strong="H00259"\w* \w woman|strong="H00802"\w* \w dropped|strong="H07993"\w* \w an upper|strong="H06400"\w* \w millstone|strong="H07393"\w* \w on|strong="H05921"\w* \w Abimelech’s|strong="H00040"\w* \w head|strong="H07218"\w*, \w crushing|strong="H07533"\w* \w -|strong="H00853"\w* \w his skull|strong="H01538"\w*. \v 54 \w He quickly|strong="H04120"\w* \w . . .|strong="H00413"\w* \w . . .|strong="H05288"\w* \w called|strong="H07121"\w* \w his armor-bearer|strong="H05375"\w* \w . . .|strong="H03627"\w*, \w saying|strong="H00559"\w*, “\w Draw|strong="H08025"\w* \w your sword|strong="H02719"\w* \w and kill me|strong="H04191"\w*, \w lest|strong="H06435"\w* \w they say|strong="H00559"\w* of me, ‘\w A woman|strong="H00802"\w* \w killed him|strong="H02026"\w*.’”
\p \w So Abimelech’s armor-bearer ran [his sword] through him|strong="H01856"\w*, \w . . .|strong="H05288"\w* \w and he died|strong="H04191"\w*. \v 55 \w And when the Israelites|strong="H00376"\w* \w . . .|strong="H03478"\w* \w saw|strong="H07200"\w* \w that|strong="H03588"\w* \w Abimelech|strong="H00040"\w* \w was dead|strong="H04191"\w*, \w they all|strong="H00376"\w* \w went|strong="H01980"\w* \w home|strong="H04725"\w*.
\p \v 56 \w In this way God|strong="H00430"\w* \w -|strong="H00853"\w* \w repaid|strong="H07725"\w* \w the wickedness|strong="H07451"\w* \w that|strong="H00834"\w* \w Abimelech|strong="H00040"\w* \w had done|strong="H06213"\w* \w to his father|strong="H00001"\w* \w in murdering|strong="H02026"\w* \w -|strong="H00853"\w* \w his seventy|strong="H07657"\w* \w brothers|strong="H00251"\w*. \v 57 \w And|strong="H00853"\w* \w God|strong="H00430"\w* \w also brought|strong="H07725"\w* \w all|strong="H03605"\w* \w the wickedness|strong="H07451"\w* \w of the men|strong="H00582"\w* \w of Shechem|strong="H07927"\w* \w {back} upon their own heads|strong="H07218"\w*. \w So the curse|strong="H07045"\w* \w of Jotham|strong="H03147"\w* \w son|strong="H01121"\w* \w of Jerubbaal|strong="H03378"\w* \w came|strong="H00935"\w* \w upon them|strong="H00413"\w*.
\c 10
\s1 Tola
\p \v 1 \w After the time|strong="H00310"\w* \w of Abimelech|strong="H00040"\w*, \w a man|strong="H00376"\w* \w of Issachar|strong="H03485"\w*, \w Tola|strong="H08439"\w* \w son|strong="H01121"\w* \w of Puah|strong="H06312"\w*, \w the son|strong="H01121"\w* \w of Dodo|strong="H01734"\w*, \w rose up|strong="H06965"\w* \w to save|strong="H03467"\w* \w -|strong="H00853"\w* \w Israel|strong="H03478"\w*\w . . .|strong="H01931"\w*. \w He lived|strong="H03427"\w* \w in Shamir|strong="H08069"\w*, \w in the hill country|strong="H02022"\w* \w of Ephraim|strong="H00669"\w*.
\p \v 2 \w Tola judged|strong="H08199"\w*\f + \fr 10:2 \ft Or \fqa governed \ft or \fqa led\ft ; here and throughout the book of Judges\f* \w -|strong="H00853"\w* \w Israel|strong="H03478"\w* \w twenty-three|strong="H06242"\w* \w . . .|strong="H07969"\w* \w years|strong="H08141"\w*, \w and when he died|strong="H04191"\w*, \w he was buried|strong="H06912"\w* \w in Shamir|strong="H08069"\w*.
\s1 Jair
\p \v 3 \w [Tola]|strong="H00310"\w* \w was followed by|strong="H06965"\w* \w Jair|strong="H02971"\w* \w the Gileadite|strong="H01569"\w*, \w who judged|strong="H08199"\w* \w -|strong="H00853"\w* \w Israel|strong="H03478"\w* \w twenty-two|strong="H06242"\w* \w . . .|strong="H08147"\w* \w years|strong="H08141"\w*. \v 4 \w He had|strong="H01961"\w* \w thirty|strong="H07970"\w* \w sons|strong="H01121"\w* \w who rode|strong="H07392"\w* \w on|strong="H05921"\w* \w thirty|strong="H07970"\w* \w donkeys|strong="H05895"\w*. And they had \w thirty|strong="H07970"\w* \w towns|strong="H05892"\w* - \w -|strong="H00834"\w* \w in the land|strong="H00776"\w* \w of Gilead|strong="H01568"\w*, \w which to|strong="H05704"\w* \w this|strong="H02088"\w* \w day|strong="H03117"\w* \w are called|strong="H07121"\w* \w vvv|strong="H02334"\w* \w Havvoth-jair|strong="H02334"\w*.\f + \fr 10:4 \ft Or \fqa the villages of Jair\f*
\p \v 5 \w When Jair|strong="H02971"\w* \w died|strong="H04191"\w*, \w he was buried|strong="H06912"\w* \w in Kamon|strong="H07056"\w*.
\s1 Oppression by the Philistines and Ammonites
\p \v 6 \w And again|strong="H03254"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w did|strong="H06213"\w* \w evil|strong="H07451"\w* \w in the sight|strong="H05869"\w* \w of the LORD|strong="H03068"\w*. \w They served|strong="H05647"\w* \w -|strong="H00853"\w* \w the Baals|strong="H01168"\w*, \w -|strong="H00853"\w* \w the Ashtoreths|strong="H06252"\w*, \w -|strong="H00853"\w* \w the gods|strong="H00430"\w* \w of Aram|strong="H00758"\w*,\w . . .|strong="H00853"\w*\w . . .|strong="H00430"\w* \w Sidon|strong="H06721"\w*, \w and|strong="H00853"\w* \w . . .|strong="H00430"\w* \w Moab|strong="H04124"\w*, \w and|strong="H00853"\w* \w the gods|strong="H00430"\w* \w of the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w* \w -|strong="H00853"\w* \w -|strong="H00430"\w* \w and Philistines|strong="H06430"\w*. \w Thus they forsook|strong="H05800"\w* \w -|strong="H00853"\w* \w the LORD|strong="H03068"\w* \w and did not|strong="H03808"\w* \w serve Him|strong="H05647"\w*.
\p \v 7 \w So the anger|strong="H00639"\w* \w of the LORD|strong="H03068"\w* \w burned|strong="H02734"\w* \w against Israel|strong="H03478"\w*, \w and He sold them|strong="H04376"\w* \w into the hands|strong="H03027"\w* \w of the Philistines|strong="H06430"\w* \w . . .|strong="H03027"\w* \w and Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w*, \v 8 \w who that very|strong="H01931"\w* \w year|strong="H08141"\w* \w harassed|strong="H07492"\w* \w and oppressed|strong="H07533"\w* \w -|strong="H00853"\w* \w the Israelites|strong="H01121"\w*, \w . . .|strong="H03478"\w* \w and they did so for eighteen|strong="H08083"\w* \w . . .|strong="H06240"\w* \w years|strong="H08141"\w* \w -|strong="H00853"\w* \w to all|strong="H03605"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w -|strong="H00834"\w* \w on the other side|strong="H05676"\w* \w of the Jordan|strong="H03383"\w* \w -|strong="H00834"\w* \w in Gilead|strong="H01568"\w*, \w the land|strong="H00776"\w* \w of the Amorites|strong="H00567"\w*.
\p \v 9 \w The Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w* \w -|strong="H00853"\w* \w also|strong="H01571"\w* \w crossed|strong="H05674"\w* \w the Jordan|strong="H03383"\w* \w to fight|strong="H03898"\w* \w against Judah|strong="H03063"\w*, \w Benjamin|strong="H01144"\w*, \w and the house|strong="H01004"\w* \w of Ephraim|strong="H00669"\w*, \w and Israel|strong="H03478"\w* \w was in deep|strong="H03966"\w* \w distress|strong="H03334"\w*.
\p \v 10 \w Then the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w cried out|strong="H02199"\w* \w to|strong="H00413"\w* \w the LORD|strong="H03068"\w*, \w saying|strong="H00559"\w*, “\w We have sinned|strong="H02398"\w* against You, \w for we have indeed|strong="H03588"\w* \w forsaken|strong="H05800"\w* \w -|strong="H00853"\w* \w our God|strong="H00430"\w* \w and served|strong="H05647"\w* \w -|strong="H00853"\w* \w the Baals|strong="H01168"\w*.”
\p \v 11 \w The LORD|strong="H03068"\w* \w replied|strong="H00559"\w*\w . . .|strong="H00413"\w*\w . . .|strong="H01121"\w*\w . . .|strong="H03478"\w*, \w -|strong="H03808"\w* “\w When the Egyptians|strong="H04714"\w*, \w . . .|strong="H04480"\w* \w Amorites|strong="H00567"\w*, \w . . .|strong="H04480"\w* \w Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w*, \w . . .|strong="H04480"\w* \w Philistines|strong="H06430"\w*, \v 12 \w Sidonians|strong="H06722"\w*, \w Amalekites|strong="H06002"\w*, \w and Maonites|strong="H04584"\w*\f + \fr 10:12 \ft Hebrew; some LXX manuscripts \fqa Midianites\f* \w oppressed you|strong="H03905"\w* \w -|strong="H00853"\w* \w and you cried out|strong="H06817"\w* \w to Me|strong="H00413"\w*, \w did I not save|strong="H03467"\w* \w you|strong="H00853"\w* \w from their hands|strong="H03027"\w*? \v 13 \w But you|strong="H00859"\w* \w have forsaken|strong="H05800"\w* \w Me|strong="H00853"\w* \w and served|strong="H05647"\w* \w other|strong="H00312"\w* \w gods|strong="H00430"\w*, \w so|strong="H03651"\w* \w I will no|strong="H03808"\w* \w longer|strong="H03254"\w* \w save|strong="H03467"\w* \w you|strong="H00853"\w*. \v 14 \w Go|strong="H01980"\w* \w and cry out|strong="H02199"\w* \w to|strong="H00413"\w* \w the gods|strong="H00430"\w* \w -|strong="H00834"\w* \w you have chosen|strong="H00977"\w*. \w Let them|strong="H01992"\w* \w save|strong="H03467"\w* you \w in your time|strong="H06256"\w* \w of trouble|strong="H06869"\w*.”
\p \v 15 “\w We have sinned|strong="H02398"\w*,” \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w the LORD|strong="H03068"\w*. “\w Deal|strong="H06213"\w* \w . . .|strong="H00859"\w* with us \w . . .|strong="H03605"\w* \w as You see|strong="H05869"\w* \w fit|strong="H02896"\w*; \w but|strong="H00389"\w* \w please|strong="H04994"\w* \w deliver us today|strong="H05337"\w* \w . . .|strong="H03117"\w* \w . . .|strong="H02088"\w*!” \v 16 \w So they put away|strong="H05493"\w* \w -|strong="H00853"\w* \w the foreign|strong="H05236"\w* \w gods|strong="H00430"\w* \w from among them|strong="H07130"\w* \w and served|strong="H05647"\w* \w -|strong="H00853"\w* \w the LORD|strong="H03068"\w*, \w and He|strong="H05315"\w* \w could no longer bear|strong="H07114"\w* \w the misery|strong="H05999"\w* \w of Israel|strong="H03478"\w*.
\p \v 17 \w Then the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w* \w were called to arms|strong="H06817"\w* \w and camped|strong="H02583"\w* \w in Gilead|strong="H01568"\w*, \w and the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w assembled|strong="H00622"\w* \w and camped|strong="H02583"\w* \w at Mizpah|strong="H04709"\w*. \v 18 \w And the rulers|strong="H08269"\w* \w of Gilead|strong="H01568"\w* \w said|strong="H00559"\w* \w . . .|strong="H05971"\w* \w to|strong="H00413"\w* \w one|strong="H00376"\w* \w another|strong="H07453"\w*, “\w Whoever|strong="H04310"\w* \w . . .|strong="H00376"\w* \w -|strong="H00834"\w* \w will launch|strong="H02490"\w* \w the attack|strong="H03898"\w* \w against the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w* \w will be|strong="H01961"\w* \w the head|strong="H07218"\w* \w of all|strong="H03605"\w* \w who live|strong="H03427"\w* \w in Gilead|strong="H01568"\w*.”
\c 11
\s1 Jephthah Delivers Israel
\p \v 1 \w Now Jephthah|strong="H03316"\w* \w the Gileadite|strong="H01569"\w* \w was|strong="H01961"\w* \w a mighty man|strong="H01368"\w* \w of valor|strong="H02428"\w*; \w he|strong="H01931"\w* \w was the son|strong="H01121"\w* \w . . .|strong="H00802"\w* \w of a prostitute|strong="H02181"\w*, \w and Gilead|strong="H01568"\w* \w -|strong="H00853"\w* \w was his|strong="H03316"\w* \w father|strong="H03205"\w*. \v 2 \w And Gilead’s|strong="H01568"\w* . . . \w wife|strong="H00802"\w* \w bore him|strong="H03205"\w* \w sons|strong="H01121"\w* \w who|strong="H01121"\w* \w . . .|strong="H00802"\w* \w grew up|strong="H01431"\w*, \w drove Jephthah|strong="H03316"\w* \w out|strong="H01644"\w*, \w -|strong="H00853"\w* \w and said|strong="H00559"\w* to him, “\w You shall have no|strong="H03808"\w* \w inheritance|strong="H05157"\w* \w in our father’s|strong="H00001"\w* \w house|strong="H01004"\w*, \w because|strong="H03588"\w* \w you|strong="H00859"\w* \w are the son|strong="H01121"\w* \w of another|strong="H00312"\w* \w woman|strong="H00802"\w*.”
\p \v 3 \w So Jephthah|strong="H03316"\w* \w fled|strong="H01272"\w* \w from|strong="H06440"\w* \w his brothers|strong="H00251"\w* \w and settled|strong="H03427"\w* \w in the land|strong="H00776"\w* \w of Tob|strong="H02897"\w*, \w where worthless men|strong="H07386"\w* \w gathered around|strong="H03950"\w* \w . . .|strong="H00413"\w* \w [him]|strong="H03316"\w* \w . . .|strong="H00582"\w* \w and traveled|strong="H03318"\w* \w with him|strong="H05973"\w*.
\p \v 4 \w Some time later|strong="H01961"\w* \w . . .|strong="H03117"\w*, \w when the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w* \w fought|strong="H03898"\w* \w against|strong="H05973"\w* \w Israel|strong="H03478"\w* \v 5 \w and|strong="H01961"\w* \w -|strong="H00834"\w* \w -|strong="H01121"\w* \w -|strong="H05983"\w* \w made war|strong="H03898"\w* \w with|strong="H05973"\w* \w [them]|strong="H03478"\w*, \w the elders|strong="H02205"\w* \w of Gilead|strong="H01568"\w* \w went|strong="H01980"\w* \w to get|strong="H03947"\w* \w -|strong="H00853"\w* \w Jephthah|strong="H03316"\w* \w from the land|strong="H00776"\w* \w of Tob|strong="H02897"\w*. \v 6 “\w Come|strong="H01980"\w*,” \w they said|strong="H00559"\w* \w -|strong="H03316"\w*, “\w be|strong="H01961"\w* our \w commander|strong="H07101"\w*, \w so that we can fight|strong="H03898"\w* \w against the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w*.”
\p \v 7 \w Jephthah|strong="H03316"\w* \w replied|strong="H00559"\w* \w to the elders|strong="H02205"\w* \w of Gilead|strong="H01568"\w*, “\w Did you|strong="H00859"\w* \w not|strong="H03808"\w* \w hate|strong="H08130"\w* \w me|strong="H00853"\w* \w and expel me|strong="H01644"\w* \w from my father’s|strong="H00001"\w* \w house|strong="H01004"\w*? \w Why|strong="H04069"\w* \w then have you come|strong="H00935"\w* \w to me|strong="H00413"\w* \w now|strong="H06258"\w*, \w when|strong="H00834"\w* \w you are in distress|strong="H06862"\w* . . .?”
\p \v 8 \w They|strong="H02205"\w* \w . . .|strong="H01568"\w* \w answered|strong="H00559"\w* \w Jephthah|strong="H03316"\w*, “\w This is why|strong="H03651"\w* \w we now|strong="H06258"\w* \w turn|strong="H07725"\w* \w . . .|strong="H00413"\w* \w to you|strong="H00413"\w*, \w that you may go|strong="H01980"\w* \w with us|strong="H05973"\w*, \w fight|strong="H03898"\w* \w the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w*, \w and become|strong="H01961"\w* \w leader|strong="H07218"\w* \w over all|strong="H03605"\w* of us \w who live|strong="H03427"\w* \w in Gilead|strong="H01568"\w*.”
\p \v 9 \w But Jephthah|strong="H03316"\w* \w asked|strong="H00559"\w* \w vvv|strong="H00413"\w* \w [them]|strong="H02205"\w* \w . . .|strong="H01568"\w*, “\w If|strong="H00518"\w* \w you|strong="H00859"\w* \w -|strong="H00853"\w* \w take me back|strong="H07725"\w* \w to fight|strong="H03898"\w* \w the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w* \w and the LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w gives them|strong="H05414"\w* \w to me|strong="H06440"\w*, \w will I|strong="H00595"\w* \w really be|strong="H01961"\w* your \w leader|strong="H07218"\w*?”
\p \v 10 \w And the elders|strong="H02205"\w* \w of Gilead|strong="H01568"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Jephthah|strong="H03316"\w*, “\w The LORD|strong="H03068"\w* \w is|strong="H01961"\w* \w our witness|strong="H08085"\w* \w . . .|strong="H00996"\w* \w if|strong="H00518"\w* \w we do not|strong="H03808"\w* \w do|strong="H06213"\w* \w as you say|strong="H01697"\w*.” \w . . .|strong="H03651"\w*
\p \v 11 \w So Jephthah|strong="H03316"\w* \w went|strong="H01980"\w* \w with|strong="H05973"\w* \w the elders|strong="H02205"\w* \w of Gilead|strong="H01568"\w*, \w and the people|strong="H05971"\w* \w -|strong="H00853"\w* \w made him|strong="H07760"\w* \w their|strong="H05921"\w* \w leader|strong="H07218"\w* \w and commander|strong="H07101"\w*. \w And Jephthah|strong="H03316"\w* \w -|strong="H00853"\w* \w repeated|strong="H01696"\w* \w all|strong="H03605"\w* \w his terms|strong="H01697"\w* \w in the presence|strong="H06440"\w* \w of the LORD|strong="H03068"\w* \w at Mizpah|strong="H04709"\w*.
\p \v 12 \w Then Jephthah|strong="H03316"\w* \w sent|strong="H07971"\w* \w messengers|strong="H04397"\w* \w to|strong="H00413"\w* \w the king|strong="H04428"\w* \w of the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w*, \w saying|strong="H00559"\w*, “\w What|strong="H04100"\w* do you have against me . . . \w that|strong="H03588"\w* \w you have come|strong="H00935"\w* \w to fight|strong="H03898"\w* \w against|strong="H00413"\w* \w my land|strong="H00776"\w*?”
\p \v 13 \w The king|strong="H04428"\w* \w of the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w* \w answered|strong="H00559"\w*\w . . .|strong="H00413"\w* \w Jephthah’s|strong="H03316"\w* \w . . .|strong="H03588"\w* \w messengers|strong="H04397"\w*, “\w When Israel|strong="H03478"\w* \w -|strong="H00853"\w* \w came up|strong="H05927"\w* \w out of Egypt|strong="H04714"\w*, \w they seized|strong="H03947"\w* \w my land|strong="H00776"\w*, \w from the Arnon|strong="H00769"\w* \w to|strong="H05704"\w* \w the Jabbok|strong="H02999"\w* \w and all the way|strong="H05704"\w* \w to the Jordan|strong="H03383"\w*. \w Now, therefore|strong="H06258"\w*, \w restore|strong="H07725"\w* \w it|strong="H00853"\w* \w peaceably|strong="H07965"\w*.”
\p \v 14 \w Jephthah|strong="H03316"\w* \w again|strong="H03254"\w* \w . . .|strong="H05750"\w* \w sent|strong="H07971"\w* \w messengers|strong="H04397"\w* \w to|strong="H00413"\w* \w the king|strong="H04428"\w* \w of the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w* \v 15 \w to tell|strong="H00559"\w* him, “\w This is what|strong="H03541"\w* \w Jephthah|strong="H03316"\w* \w says|strong="H00559"\w*: \w Israel|strong="H03478"\w* \w -|strong="H00853"\w* \w did not|strong="H03808"\w* \w take away|strong="H03947"\w* \w the land|strong="H00776"\w* \w of Moab|strong="H04124"\w* \w [or]|strong="H00853"\w* \w -|strong="H00776"\w* \w -|strong="H01121"\w* \w of the Ammonites|strong="H05983"\w*. \v 16 \w But|strong="H03588"\w* \w when [Israel] came up|strong="H05927"\w* \w out of Egypt|strong="H04714"\w*, \w [they]|strong="H03478"\w* \w traveled|strong="H01980"\w* \w through the wilderness|strong="H04057"\w* \w to|strong="H05704"\w* \w the Red|strong="H05488"\w* \w Sea|strong="H03220"\w*\f + \fr 11:16 \ft Or \fqa the Sea of Reeds\f* \w and came|strong="H00935"\w* \w to Kadesh|strong="H06946"\w*. \v 17 \w Then Israel|strong="H03478"\w* \w sent|strong="H07971"\w* \w messengers|strong="H04397"\w* \w to|strong="H00413"\w* \w the king|strong="H04428"\w* \w of Edom|strong="H00123"\w*, \w saying|strong="H00559"\w*, ‘\w Please|strong="H04994"\w* \w let us pass|strong="H05674"\w* \w through your land|strong="H00776"\w*,’ \w but the king|strong="H04428"\w* \w of Edom|strong="H00123"\w* \w would not|strong="H03808"\w* \w listen|strong="H08085"\w*. \w They also|strong="H01571"\w* \w sent|strong="H07971"\w* \w messengers to|strong="H00413"\w* \w the king|strong="H04428"\w* \w of Moab|strong="H04124"\w*, \w but he would not|strong="H03808"\w* \w consent|strong="H00014"\w*. \w So Israel|strong="H03478"\w* \w stayed|strong="H03427"\w* \w in Kadesh|strong="H06946"\w*.
\p \v 18 \w Then [Israel] traveled|strong="H01980"\w* \w through the wilderness|strong="H04057"\w* \w and bypassed|strong="H05437"\w* \w -|strong="H00853"\w* \w the lands|strong="H00776"\w* \w of Edom|strong="H00123"\w* \w and|strong="H00853"\w*\w . . .|strong="H00776"\w* \w Moab|strong="H04124"\w*. \w They came|strong="H00935"\w* \w to|strong="H04217"\w* \w the east side|strong="H08121"\w* \w of the land|strong="H00776"\w* \w of Moab|strong="H04124"\w* \w and camped|strong="H02583"\w* \w on the other side|strong="H05676"\w* \w of the Arnon|strong="H00769"\w*. \w But they did not|strong="H03808"\w* \w enter|strong="H00935"\w* \w the territory|strong="H01366"\w* \w of Moab|strong="H04124"\w*, \w since|strong="H03588"\w* \w the Arnon|strong="H00769"\w* \w was its border|strong="H01366"\w* \w -|strong="H04124"\w*.
\p \v 19 \w And Israel|strong="H03478"\w* \w sent|strong="H07971"\w* \w messengers|strong="H04397"\w* \w to|strong="H00413"\w* \w Sihon|strong="H05511"\w* \w king|strong="H04428"\w* \w of the Amorites|strong="H00567"\w*, \w who ruled|strong="H04428"\w* \w in Heshbon|strong="H02809"\w*, \w -|strong="H03478"\w* \w and said|strong="H00559"\w* to him, ‘\w Please|strong="H04994"\w* \w let us pass|strong="H05674"\w* \w through your land|strong="H00776"\w* \w into|strong="H05704"\w* \w our own place|strong="H04725"\w*.’ \v 20 \w But Sihon|strong="H05511"\w* \w -|strong="H00853"\w* \w would not|strong="H03808"\w* \w trust|strong="H00539"\w* \w Israel|strong="H03478"\w* \w to pass|strong="H05674"\w* \w through his territory|strong="H01366"\w*. \w So [he]|strong="H05511"\w* \w -|strong="H00853"\w* \w gathered|strong="H00622"\w* \w all|strong="H03605"\w* \w his people|strong="H05971"\w*, \w encamped|strong="H02583"\w* \w in Jahaz|strong="H03096"\w*, \w and fought|strong="H03898"\w* \w with|strong="H05973"\w* \w Israel|strong="H03478"\w*.
\p \v 21 \w Then the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w -|strong="H00853"\w* \w delivered|strong="H05414"\w* \w Sihon|strong="H05511"\w* \w -|strong="H00853"\w* \w and all|strong="H03605"\w* \w his people|strong="H05971"\w* \w into the hand|strong="H03027"\w* \w of Israel|strong="H03478"\w*, \w who defeated them|strong="H05221"\w*. \w So Israel|strong="H03478"\w* \w -|strong="H00853"\w* \w took possession of|strong="H03423"\w* \w all|strong="H03605"\w* \w the land|strong="H00776"\w* \w of the Amorites|strong="H00567"\w* \w who inhabited|strong="H03427"\w* \w that|strong="H01931"\w* \w country|strong="H00776"\w*, \v 22 \w seizing|strong="H03423"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the land|strong="H01366"\w* \w . . .|strong="H00567"\w* \w from|strong="H04480"\w* \w the Arnon|strong="H00769"\w* \w to|strong="H05704"\w* \w the Jabbok|strong="H02999"\w* \w and from the wilderness|strong="H04057"\w* \w to|strong="H05704"\w* \w the Jordan|strong="H03383"\w*.
\p \v 23 \w Now since|strong="H06258"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w has driven out|strong="H03423"\w* \w -|strong="H00853"\w* \w the Amorites|strong="H00567"\w* \w from before|strong="H06440"\w* \w His people|strong="H05971"\w* \w Israel|strong="H03478"\w*, \w should you now|strong="H00859"\w* \w possess it|strong="H03423"\w*? \v 24 \w Do you not|strong="H03808"\w* \w -|strong="H00853"\w* \w possess|strong="H03423"\w* \w whatever|strong="H00834"\w* \w your god|strong="H00430"\w* \w -|strong="H00853"\w* \w Chemosh|strong="H03645"\w* \w grants you|strong="H03423"\w*? \w So also|strong="H00853"\w*, \w we possess|strong="H03423"\w* \w whatever|strong="H03605"\w* \w -|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w our God|strong="H00430"\w* \w has granted|strong="H03423"\w* \w us|strong="H06440"\w*. \w -|strong="H00853"\w* \v 25 \w Are you|strong="H00859"\w* \w now|strong="H06258"\w* \w so much better|strong="H02895"\w* \w . . .|strong="H02895"\w* \w than Balak|strong="H01111"\w* \w son|strong="H01121"\w* \w of Zippor|strong="H06834"\w*, \w king|strong="H04428"\w* \w of Moab|strong="H04124"\w*? \w Did he ever contend|strong="H07378"\w* \w . . .|strong="H07378"\w* \w with|strong="H05973"\w* \w Israel|strong="H03478"\w* \w or|strong="H00518"\w* \w fight|strong="H03898"\w* \w . . .|strong="H03898"\w* against them?
