\p \v 13 \w After this, Gideon|strong="H01439"\w* \w son|strong="H01121"\w* \w of Joash|strong="H03101"\w* \w returned|strong="H07725"\w* \w from|strong="H04480"\w* \w the battle|strong="H04421"\w* \w along the Ascent of|strong="H04608"\w* \w Heres|strong="H02776"\w*. \v 14 \w There he captured|strong="H03920"\w* \w a young man|strong="H05288"\w* \w . . .|strong="H00582"\w* \w of Succoth|strong="H05523"\w* \w and interrogated him|strong="H07592"\w*. \w The young man wrote down|strong="H03789"\w* \w for him|strong="H00413"\w* \w -|strong="H00853"\w* \w the names of the seventy-seven|strong="H07657"\w* \w . . .|strong="H07651"\w* \w -|strong="H00376"\w* \w leaders|strong="H08269"\w* \w and|strong="H00853"\w* \w elders|strong="H02205"\w* \w of Succoth|strong="H05523"\w*.
\p \v 15 \w And [Gideon] went|strong="H00935"\w* \w to|strong="H00413"\w* \w the men|strong="H00582"\w* \w of Succoth|strong="H05523"\w* \w and said|strong="H00559"\w*, “\w Here|strong="H02009"\w* \w are Zebah|strong="H02078"\w* \w and Zalmunna|strong="H06759"\w*, \w about whom|strong="H00834"\w* \w you taunted|strong="H02778"\w* \w me|strong="H00853"\w*, \w saying|strong="H00559"\w*, ‘\w [Are] the hands|strong="H03709"\w* \w of Zebah|strong="H02078"\w* \w and Zalmunna|strong="H06759"\w* \w already|strong="H06258"\w* \w in your possession|strong="H03027"\w*, \w that|strong="H03588"\w* \w we should give|strong="H05414"\w* \w bread|strong="H03899"\w* \w to your weary|strong="H03287"\w* \w men|strong="H00582"\w*?’” \v 16 \w Then he took|strong="H03947"\w* \w -|strong="H00853"\w* \w the elders|strong="H02205"\w* \w of the city|strong="H05892"\w*, \w and [using]|strong="H00853"\w* \w the thorns|strong="H06975"\w* \w and briers|strong="H01303"\w* \w of the wilderness|strong="H04057"\w* \w -|strong="H00853"\w* -, \w -|strong="H00853"\w* \w he disciplined|strong="H03045"\w* \w the men|strong="H00582"\w* \w of Succoth|strong="H05523"\w*. \v 17 \w -|strong="H00853"\w* \w He also pulled down|strong="H05422"\w* \w the tower|strong="H04026"\w* \w of Penuel|strong="H06439"\w* \w and killed|strong="H02026"\w* \w -|strong="H00853"\w* \w the men|strong="H00582"\w* \w of the city|strong="H05892"\w*.
