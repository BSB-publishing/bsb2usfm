\p \v 16 “\w Surely|strong="H03588"\w* \w I will be|strong="H01961"\w* \w with you|strong="H05973"\w*,” \w the LORD|strong="H03068"\w* \w replied|strong="H00559"\w* \w -|strong="H00413"\w*, “\w and you will strike down|strong="H05221"\w* \w [all] the Midianites|strong="H04080"\w* \w -|strong="H00853"\w* \w as one|strong="H00259"\w* \w man|strong="H00376"\w*.”
