\p \v 14 \w So they continued|strong="H01980"\w* \w on their journey|strong="H05674"\w*, \w and the sun|strong="H08121"\w* \w set|strong="H00935"\w* \w as they neared|strong="H00681"\w* \w Gibeah|strong="H01390"\w* \w -|strong="H00834"\w* \w in Benjamin|strong="H01144"\w*. \v 15 \w They stopped|strong="H05493"\w* \w . . .|strong="H08033"\w* \w to go in|strong="H00935"\w* \w and lodge|strong="H03885"\w* \w in Gibeah|strong="H01390"\w*. \w The Levite went in|strong="H00935"\w* \w and sat down|strong="H03427"\w* \w in the city|strong="H05892"\w* \w square|strong="H07339"\w*, \w but no|strong="H00369"\w* \w one|strong="H00376"\w* \w would take|strong="H00622"\w* \w them|strong="H00853"\w* \w into his home|strong="H01004"\w* \w for the night|strong="H03885"\w*.
\p \v 16 \w -|strong="H02009"\w* \w That evening|strong="H06153"\w* \w an old|strong="H02205"\w* \w man|strong="H00376"\w* \w -|strong="H00376"\w* \w from the hill country|strong="H02022"\w* \w of Ephraim|strong="H00669"\w*, \w . . .|strong="H01931"\w* \w who was residing|strong="H01481"\w* \w in Gibeah|strong="H01390"\w* (\w the men|strong="H00582"\w* \w of that place|strong="H04725"\w* \w vvv|strong="H01145"\w* \w were Benjamites|strong="H01145"\w*), \w came in|strong="H00935"\w* \w from|strong="H04480"\w* \w his work|strong="H04639"\w* \w in|strong="H04480"\w* \w the field|strong="H07704"\w*. \v 17 \w When he looked up|strong="H05375"\w* \w . . .|strong="H05869"\w* \w and saw|strong="H07200"\w* \w -|strong="H00853"\w* \w vvv|strong="H00376"\w* \w the traveler|strong="H00732"\w* \w in the city|strong="H05892"\w* \w square|strong="H07339"\w*, \w the old|strong="H02205"\w* \w man|strong="H00376"\w* \w asked|strong="H00559"\w*, “\w Where|strong="H00575"\w* \w are you going|strong="H01980"\w*, \w and where|strong="H00370"\w* \w have you come from|strong="H00935"\w*?”
\p \v 18 \w [The Levite] replied|strong="H00559"\w*, \w . . .|strong="H00413"\w* “\w We are|strong="H00587"\w* \w traveling|strong="H05674"\w* \w vvv|strong="H01035"\w* \w from Bethlehem|strong="H01035"\w* \w in Judah|strong="H03063"\w* \w to|strong="H05704"\w* \w the remote|strong="H03411"\w* \w hill country|strong="H02022"\w* \w of Ephraim|strong="H00669"\w*, \w where|strong="H08033"\w* \w I am from|strong="H00595"\w*. \w I went|strong="H01980"\w* \w to|strong="H05704"\w* \w vvv|strong="H01035"\w* \w Bethlehem|strong="H01035"\w* \w in Judah|strong="H03063"\w*, \w -|strong="H00853"\w* \w and now I am|strong="H00589"\w* \w going|strong="H01980"\w* \w to the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*;\f + \fr 19:18 \ft LXX \fqa I am going to my home\ft ; see verse 29.\f* \w but no|strong="H00369"\w* \w one|strong="H00376"\w* \w has taken|strong="H00622"\w* \w me|strong="H00853"\w* \w into his home|strong="H01004"\w*, \v 19 \w even though there is|strong="H03426"\w* \w both|strong="H01571"\w* \w straw|strong="H08401"\w* \w and|strong="H01571"\w* \w feed|strong="H04554"\w* \w for our donkeys|strong="H02543"\w*, \w and|strong="H01571"\w* \w bread|strong="H03899"\w* \w and wine|strong="H03196"\w* \w . . .|strong="H03426"\w* for me \w and the maidservant|strong="H00519"\w* \w and young man|strong="H05288"\w* \w with me|strong="H05973"\w*. \w There is nothing that|strong="H00369"\w* \w we, your servants|strong="H05650"\w*, \w . . .|strong="H03605"\w* \w . . .|strong="H01697"\w* \w lack|strong="H04270"\w*.”
\p \v 20 “\w Peace|strong="H07965"\w* to you,” \w said|strong="H00559"\w* \w the old|strong="H02205"\w* \w man|strong="H00376"\w*. “\w Let me supply|strong="H05921"\w* \w . . .|strong="H07535"\w* \w everything|strong="H03605"\w* \w you need|strong="H04270"\w*. \w Only|strong="H07535"\w* \w do not|strong="H00408"\w* \w spend the night|strong="H03885"\w* \w in the square|strong="H07339"\w*.” \v 21 \w So he brought him|strong="H00935"\w* \w to his house|strong="H01004"\w* \w and fed|strong="H01101"\w* \w his donkeys|strong="H02543"\w*. \w And they washed|strong="H07364"\w* \w their feet|strong="H07272"\w* \w and ate|strong="H00398"\w* \w and drank|strong="H08354"\w*.
\p \v 22 \w While they|strong="H01992"\w* \w were enjoying|strong="H03190"\w* \w -|strong="H00853"\w* \w themselves|strong="H03820"\w*, \w suddenly|strong="H02009"\w* \w the wicked|strong="H01100"\w* \w men|strong="H00582"\w* \w of the city|strong="H05892"\w* \w -|strong="H00582"\w* \w -|strong="H01121"\w* \w surrounded|strong="H05437"\w* \w -|strong="H00853"\w* \w the house|strong="H01004"\w*. \w Pounding|strong="H01849"\w* \w on|strong="H05921"\w* \w the door|strong="H01817"\w*, \w they said|strong="H00559"\w* \w to|strong="H00413"\w* \w the old|strong="H02205"\w* \w man|strong="H00376"\w* \w who owned|strong="H01167"\w* \w the house|strong="H01004"\w* \w -|strong="H00559"\w*, “\w Bring out|strong="H03318"\w* \w -|strong="H00853"\w* \w the man|strong="H00376"\w* \w who|strong="H00834"\w* \w came|strong="H00935"\w* \w to|strong="H00413"\w* \w your house|strong="H01004"\w*, \w so we can have relations with him|strong="H03045"\w*!”
\p \v 23 \w vvv|strong="H00376"\w* \w The owner|strong="H01167"\w* \w of the house|strong="H01004"\w* \w went out|strong="H03318"\w* \w -|strong="H00413"\w* \w and said|strong="H00559"\w* \w to them|strong="H00413"\w*, “\w No|strong="H00408"\w*, \w my brothers|strong="H00251"\w*, \w do not|strong="H00408"\w* \w do this wicked thing|strong="H07489"\w*! \w . . .|strong="H04994"\w* \w After all|strong="H00310"\w* \w -|strong="H00834"\w*, \w this|strong="H02088"\w* \w . . .|strong="H00408"\w* \w man|strong="H00376"\w* \w is a guest|strong="H00935"\w* \w in my house|strong="H01004"\w*. \w Do not|strong="H00408"\w* \w commit|strong="H06213"\w* \w -|strong="H00853"\w* \w this|strong="H02063"\w* \w outrage|strong="H05039"\w*. \v 24 \w Look|strong="H02009"\w*, \w let me bring out|strong="H03318"\w* \w my virgin|strong="H01330"\w* \w daughter|strong="H01323"\w* \w and the man’s concubine|strong="H06370"\w* \w -|strong="H04994"\w*, \w -|strong="H00853"\w* \w and you can use|strong="H06031"\w* \w them|strong="H00853"\w* \w and do|strong="H06213"\w* with them \w as you wish|strong="H02896"\w* \w -|strong="H05869"\w*. \w But do not|strong="H03808"\w* \w do|strong="H06213"\w* \w such|strong="H02063"\w* \w a vile|strong="H05039"\w* \w thing|strong="H01697"\w* \w to this|strong="H02088"\w* \w man|strong="H00376"\w*.”
