\p \v 1 \w After Ehud|strong="H00164"\w* \w died|strong="H04191"\w*, \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w again|strong="H03254"\w* \w did|strong="H06213"\w* \w evil|strong="H07451"\w* \w in the sight|strong="H05869"\w* \w of the LORD|strong="H03068"\w*. \v 2 \w So the LORD|strong="H03068"\w* \w sold them|strong="H04376"\w* \w into the hand|strong="H03027"\w* \w of Jabin|strong="H02985"\w* \w king|strong="H04428"\w* \w of Canaan|strong="H03667"\w*, \w who|strong="H00834"\w* \w reigned|strong="H04427"\w* \w in Hazor|strong="H02674"\w*. \w The commander|strong="H08269"\w* \w of his forces|strong="H06635"\w* \w was Sisera|strong="H05516"\w*, \w who|strong="H01931"\w* \w lived|strong="H03427"\w* \w in Harosheth-hagoyim|strong="H02800"\w* \w . . .|strong="H01471"\w*. \v 3 \w Then the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w cried out|strong="H06817"\w* \w to|strong="H00413"\w* \w the LORD|strong="H03068"\w*, \w because|strong="H03588"\w* Jabin had \w nine|strong="H08672"\w* \w hundred|strong="H03967"\w* \w chariots|strong="H07393"\w* \w of iron|strong="H01270"\w*, \w and he|strong="H01931"\w* \w had harshly|strong="H02394"\w* \w oppressed|strong="H03905"\w* \w -|strong="H00853"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w for twenty|strong="H06242"\w* \w years|strong="H08141"\w*.
