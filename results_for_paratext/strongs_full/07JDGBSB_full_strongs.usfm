\p \v 7 \w And there was|strong="H01961"\w* \w a young|strong="H05288"\w* \w -|strong="H01931"\w* \w Levite|strong="H03881"\w* \w vvv|strong="H01035"\w* \w from Bethlehem|strong="H01035"\w* \w in Judah|strong="H03063"\w* \w who|strong="H01931"\w* \w had been residing|strong="H01481"\w* \w . . .|strong="H08033"\w* \w within the clan|strong="H04940"\w* \w of Judah|strong="H03063"\w*. \v 8 \w This man|strong="H00376"\w* \w left|strong="H01980"\w* \w the city|strong="H05892"\w* \w vvv|strong="H01035"\w* \w of Bethlehem|strong="H01035"\w* \w in Judah|strong="H03063"\w* \w to settle|strong="H01481"\w* \w where|strong="H00834"\w* \w he could find [a place]|strong="H04672"\w*. \w And as he traveled|strong="H06213"\w* \w . . .|strong="H01870"\w*, \w he came|strong="H00935"\w* \w to|strong="H05704"\w* \w Micah’s|strong="H04318"\w* \w house|strong="H01004"\w* \w in the hill country|strong="H02022"\w* \w of Ephraim|strong="H00669"\w*.
\p \v 9 “\w Where|strong="H00370"\w* \w are you from|strong="H00935"\w*?” \w Micah|strong="H04318"\w* \w asked|strong="H00559"\w* him.
