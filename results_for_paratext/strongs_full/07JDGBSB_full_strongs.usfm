\s1 Gideon Destroys Baal’s Altar
\p \v 25 \w -|strong="H01961"\w* \w On that very|strong="H01931"\w* \w night|strong="H03915"\w* \w the LORD|strong="H03068"\w* \w said|strong="H00559"\w* to [Gideon], “\w Take|strong="H03947"\w* \w -|strong="H00853"\w* \w your father’s|strong="H00001"\w* \w young bull|strong="H06499"\w* \w . . .|strong="H07794"\w* \w -|strong="H00834"\w* \w and a second|strong="H08145"\w* \w bull|strong="H06499"\w* \w seven|strong="H07651"\w* \w years old|strong="H08141"\w*, \w tear down|strong="H02040"\w* \w -|strong="H00853"\w* \w your father’s|strong="H00001"\w* \w altar|strong="H04196"\w* \w to Baal|strong="H01168"\w*, \w -|strong="H00834"\w* \w -|strong="H00853"\w* \w and cut down|strong="H03772"\w* \w the Asherah pole|strong="H00842"\w* \w -|strong="H00834"\w* \w beside it|strong="H05921"\w*. \v 26 \w Then build|strong="H01129"\w* \w a proper|strong="H04634"\w* \w altar|strong="H04196"\w* \w to the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w on|strong="H05921"\w* \w the top|strong="H07218"\w* \w of this|strong="H02088"\w* \w stronghold|strong="H04581"\w*. \w And with the wood|strong="H06086"\w* \w of the Asherah pole|strong="H00842"\w* \w -|strong="H00834"\w* \w you cut down|strong="H03772"\w*, \w take|strong="H03947"\w* \w -|strong="H00853"\w* \w the second|strong="H08145"\w* \w bull|strong="H06499"\w* \w and offer|strong="H05927"\w* \w it as a burnt offering|strong="H05930"\w*.”
