\p \v 13 “\w No|strong="H03808"\w*,” \w they answered|strong="H00559"\w*, \w -|strong="H00559"\w* “\w we will not|strong="H03808"\w* \w . . .|strong="H04191"\w* \w kill you|strong="H04191"\w*, \w but|strong="H03588"\w* \w we will tie you up securely|strong="H00631"\w* \w . . .|strong="H00631"\w* \w and hand you over to|strong="H05414"\w* \w them|strong="H03027"\w*.” \w So they bound him|strong="H00631"\w* \w with two|strong="H08147"\w* \w new|strong="H02319"\w* \w ropes|strong="H05688"\w* \w and led him up|strong="H05927"\w* \w from|strong="H04480"\w* \w the rock|strong="H05553"\w*.
\p \v 14 \w When|strong="H01931"\w* \w [Samson] arrived|strong="H00935"\w* \w in|strong="H05704"\w* \w Lehi|strong="H03896"\w*, \w the Philistines|strong="H06430"\w* \w came out shouting|strong="H07321"\w* \w against him|strong="H07122"\w*. \w And the Spirit|strong="H07307"\w* \w of the LORD|strong="H03068"\w* \w came mightily|strong="H06743"\w* \w upon him|strong="H05921"\w*. \w The ropes|strong="H05688"\w* \w -|strong="H00834"\w* \w on|strong="H05921"\w* \w his arms|strong="H02220"\w* \w became|strong="H01961"\w* \w like burnt|strong="H01197"\w* \w . . .|strong="H00784"\w* \w flax|strong="H06593"\w*, \w -|strong="H00834"\w* \w and the bonds|strong="H00612"\w* \w broke loose|strong="H04549"\w* \w from|strong="H05921"\w* \w his hands|strong="H03027"\w*. \v 15 \w He found|strong="H04672"\w* \w the fresh|strong="H02961"\w* \w jawbone|strong="H03895"\w* \w of a donkey|strong="H02543"\w*, \w reached out|strong="H07971"\w* \w his hand|strong="H03027"\w* \w and took it|strong="H03947"\w*, \w and struck down|strong="H05221"\w* - \w a thousand|strong="H00505"\w* \w men|strong="H00376"\w*. \v 16 \w Then Samson|strong="H08123"\w* \w said|strong="H00559"\w*:
