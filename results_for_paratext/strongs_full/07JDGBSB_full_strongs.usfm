\p \v 36 “\w My father|strong="H00001"\w*,” \w she replied|strong="H00559"\w*\w . . .|strong="H00413"\w*, “\w you have given your word|strong="H06475"\w* \w -|strong="H00853"\w* \w -|strong="H06310"\w* \w to|strong="H00413"\w* \w the LORD|strong="H03068"\w*. \w Do|strong="H06213"\w* to me \w as|strong="H00834"\w* \w you have said|strong="H03318"\w* \w . . .|strong="H06310"\w*, \w for|strong="H00310"\w* \w -|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w has|strong="H06213"\w* \w avenged|strong="H05360"\w* you \w of your enemies|strong="H00341"\w*, \w the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w*.” \v 37 \w She also said|strong="H00559"\w* \w to|strong="H00413"\w* \w her father|strong="H00001"\w*, “\w Let me do|strong="H06213"\w* . . . \w this|strong="H02088"\w* \w . . .|strong="H07503"\w* \w . . .|strong="H04480"\w* \w one thing|strong="H01697"\w*: \w Let me wander|strong="H01980"\w* \w . . .|strong="H03381"\w* \w for two|strong="H08147"\w* \w months|strong="H02320"\w* \w through|strong="H05921"\w* \w the mountains|strong="H02022"\w* \w . . .|strong="H00595"\w* \w with my friends|strong="H07464"\w* \w and mourn|strong="H01058"\w* \w . . .|strong="H05921"\w* \w my virginity|strong="H01331"\w*.”
