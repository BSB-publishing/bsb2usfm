\p \v 1 \w Again the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w did|strong="H06213"\w* \w evil|strong="H07451"\w* \w in the sight|strong="H05869"\w* \w of the LORD|strong="H03068"\w*; \w so He|strong="H03068"\w* \w delivered them|strong="H05414"\w* \w into the hand|strong="H03027"\w* \w of Midian|strong="H04080"\w* \w for seven|strong="H07651"\w* \w years|strong="H08141"\w*, \v 2 \w and the hand|strong="H03027"\w* \w of Midian|strong="H04080"\w* \w prevailed|strong="H05810"\w* \w against|strong="H05921"\w* \w Israel|strong="H03478"\w*. \w Because of|strong="H06440"\w* \w the Midianites|strong="H04080"\w*, \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w -|strong="H00853"\w* \w prepared|strong="H06213"\w* \w shelters|strong="H04492"\w* for themselves \w -|strong="H00834"\w* \w in the mountains|strong="H02022"\w*, \w -|strong="H00853"\w* \w caves|strong="H04631"\w*, \w -|strong="H00853"\w* \w and strongholds|strong="H04679"\w*.
