\p \v 13 \w Then the whole|strong="H03605"\w* \w congregation|strong="H05712"\w* \w sent|strong="H07971"\w* \w a message|strong="H01696"\w* \w . . .|strong="H07121"\w* - \w of peace|strong="H07965"\w* \w to|strong="H00413"\w* \w the Benjamites|strong="H01121"\w* \w . . .|strong="H01144"\w* \w who|strong="H00834"\w* \w were at the rock|strong="H05553"\w* \w of Rimmon|strong="H07417"\w*. \v 14 \w And at that|strong="H01931"\w* \w time|strong="H06256"\w* \w the Benjamites|strong="H01144"\w* \w returned|strong="H07725"\w* \w and were given|strong="H05414"\w* - \w the women|strong="H00802"\w* \w -|strong="H00834"\w* \w who were spared|strong="H02421"\w* \w . . .|strong="H00802"\w* \w from Jabesh-gilead|strong="H03003"\w* \w . . .|strong="H01568"\w*. \w But there were not|strong="H03808"\w* \w . . .|strong="H04672"\w* \w enough [women]|strong="H03651"\w* for all of them.
\p \v 15 \w The people|strong="H05971"\w* \w grieved|strong="H05162"\w* \w for Benjamin|strong="H01144"\w*, \w because|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w had made|strong="H06213"\w* \w a void|strong="H06556"\w* \w in the tribes|strong="H07626"\w* \w of Israel|strong="H03478"\w*.
\p \v 16 \w Then the elders|strong="H02205"\w* \w of the congregation|strong="H05712"\w* \w said|strong="H00559"\w*, “\w What|strong="H04100"\w* \w should we do|strong="H06213"\w* \w about wives|strong="H00802"\w* \w for those who remain|strong="H03498"\w*, \w since|strong="H03588"\w* \w the women|strong="H00802"\w* \w of Benjamin|strong="H01144"\w* \w have been destroyed|strong="H08045"\w*?” \v 17 \w They added|strong="H00559"\w*, “\w There must be heirs|strong="H03425"\w* \w for the survivors|strong="H06413"\w* \w of Benjamin|strong="H01144"\w*, \w so that a tribe|strong="H07626"\w* \w of Israel|strong="H03478"\w* \w will not|strong="H03808"\w* \w be wiped out|strong="H04229"\w*. \v 18 \w But we|strong="H00587"\w* \w cannot|strong="H03808"\w* \w . . .|strong="H03201"\w* \w give|strong="H05414"\w* them \w our daughters|strong="H01323"\w* \w as wives|strong="H00802"\w*.”
\p \w For|strong="H03588"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w . . .|strong="H00559"\w* \w had sworn|strong="H07650"\w*, “\w Cursed is|strong="H00779"\w* \w he who gives|strong="H05414"\w* \w a wife|strong="H00802"\w* \w to a Benjamite|strong="H01144"\w*.”
\p \v 19 “\w But look|strong="H02009"\w*,” \w they said|strong="H00559"\w*, “\w there is a yearly|strong="H03117"\w* \w . . .|strong="H03117"\w* \w feast|strong="H02282"\w* \w to the LORD|strong="H03068"\w* \w in Shiloh|strong="H07887"\w*, \w which [is]|strong="H00834"\w* \w north|strong="H06828"\w* \w vvv|strong="H01008"\w* \w of Bethel|strong="H01008"\w* \w vvv|strong="H04217"\w* \w east|strong="H08121"\w* \w of the road|strong="H04546"\w* \w that goes up|strong="H05927"\w* \w from|strong="H01008"\w* \w Bethel|strong="H01008"\w* \w to Shechem|strong="H07927"\w*, \w and south|strong="H05045"\w* \w of Lebonah|strong="H03829"\w*.”
\p \v 20 \w So they commanded|strong="H06680"\w* \w -|strong="H00853"\w* \w the Benjamites|strong="H01121"\w* \w . . .|strong="H01144"\w*: \w . . .|strong="H00559"\w* “\w Go|strong="H01980"\w*, \w hide|strong="H00693"\w* \w in the vineyards|strong="H03754"\w* \v 21 \w and watch|strong="H07200"\w*. \w When|strong="H00518"\w* \w you see|strong="H02009"\w* \w the daughters|strong="H01323"\w* \w of Shiloh|strong="H07887"\w* \w come out|strong="H03318"\w* \w to perform|strong="H02342"\w* \w their dances|strong="H04246"\w*, \w each of you|strong="H00376"\w* \w is to come out|strong="H03318"\w* \w of the vineyards|strong="H03754"\w*, \w catch|strong="H02414"\w* for himself \w a wife|strong="H00802"\w* \w from|strong="H04480"\w* \w the daughters|strong="H01323"\w* \w of Shiloh|strong="H07887"\w*, \w and go|strong="H01980"\w* \w to the land|strong="H00776"\w* \w of Benjamin|strong="H01144"\w*. \v 22 \w -|strong="H01961"\w* \w When|strong="H03588"\w* \w their fathers|strong="H00001"\w* \w or|strong="H00176"\w* \w brothers|strong="H00251"\w* \w come|strong="H00935"\w* \w to us|strong="H00413"\w* \w to complain|strong="H07378"\w*, \w we will tell them|strong="H00559"\w*, \w . . .|strong="H00413"\w* ‘\w Do us a favor|strong="H02603"\w* \w by [helping] them|strong="H00853"\w*, \w since|strong="H03588"\w* \w we did not|strong="H03808"\w* \w get|strong="H03947"\w* \w wives|strong="H00802"\w* \w for each of them|strong="H00376"\w* \w in the war|strong="H04421"\w*. \w Since|strong="H03588"\w* \w you|strong="H00859"\w* \w did not|strong="H03808"\w* \w actually|strong="H06256"\w* \w give them|strong="H05414"\w* [your daughters], \w you have no guilt|strong="H00816"\w*.’”
\p \v 23 \w The Benjamites|strong="H01121"\w* \w . . .|strong="H01144"\w* \w did|strong="H06213"\w* \w [as instructed]|strong="H03651"\w* \w and carried away|strong="H05375"\w* \w the number|strong="H04557"\w* \w of women|strong="H00802"\w* \w they needed from|strong="H04480"\w* \w the dancers|strong="H02342"\w* \w -|strong="H00834"\w* \w they caught|strong="H01497"\w*. \w They went|strong="H01980"\w* \w back|strong="H07725"\w* \w to|strong="H00413"\w* \w their own inheritance|strong="H05159"\w*, \w rebuilt|strong="H01129"\w* \w -|strong="H00853"\w* \w their cities|strong="H05892"\w*, \w and settled|strong="H03427"\w* in them. \v 24 \w And at that|strong="H01931"\w* \w time|strong="H06256"\w*, \w each|strong="H00376"\w* \w vvv|strong="H01121"\w* \w of the Israelites|strong="H03478"\w* \w returned|strong="H01980"\w* \w from there|strong="H08033"\w* \w to his own tribe|strong="H07626"\w* \w and clan|strong="H04940"\w*, \w . . .|strong="H03318"\w* \w each|strong="H00376"\w* \w -|strong="H08033"\w* \w to his own inheritance|strong="H05159"\w*.
\p \v 25 \w In those|strong="H01992"\w* \w days|strong="H03117"\w* \w there was no|strong="H00369"\w* \w king|strong="H04428"\w* \w in Israel|strong="H03478"\w*; \w everyone|strong="H00376"\w* \w did [what was]|strong="H06213"\w* \w right|strong="H03477"\w* \w in his own eyes|strong="H05869"\w*.
