\p \w So Jacob said|strong="H00559"\w*, “\w Please|strong="H04994"\w* \w bring them|strong="H03947"\w* \w to me|strong="H00413"\w*, \w that I may bless [them]|strong="H01288"\w*.”
\p \v 10 \w Now Israel’s|strong="H03478"\w* \w eyesight|strong="H05869"\w* \w was poor|strong="H03513"\w* \w because of old age|strong="H02207"\w*; \w he could|strong="H03201"\w* \w hardly|strong="H03808"\w* \w see|strong="H07200"\w*. \w Joseph brought|strong="H05066"\w* \w -|strong="H00853"\w* \w [his sons] to him|strong="H00413"\w*, \w and [his father] kissed|strong="H05401"\w* them \w and embraced|strong="H02263"\w* them.
\p \v 11 “\w I never|strong="H03808"\w* \w expected|strong="H06419"\w* \w to see|strong="H07200"\w* \w your face again|strong="H06440"\w*,” \w Israel|strong="H03478"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Joseph|strong="H03130"\w*, “\w but now|strong="H02009"\w* \w God|strong="H00430"\w* \w -|strong="H00853"\w* \w has let me see|strong="H07200"\w* \w -|strong="H00853"\w* \w your children|strong="H02233"\w* \w as well|strong="H01571"\w*.”
\p \v 12 \w Then Joseph|strong="H03130"\w* \w -|strong="H00853"\w* \w removed [his sons]|strong="H03318"\w* \w from|strong="H05973"\w* \w [his father’s] knees|strong="H01290"\w* \w and bowed|strong="H07812"\w* \w facedown|strong="H00639"\w* \w . . .|strong="H00776"\w*.
\p \v 13 \w And Joseph|strong="H03130"\w* \w -|strong="H00853"\w* \w took|strong="H03947"\w* \w both|strong="H08147"\w* \w of them|strong="H00853"\w*— \w with Ephraim|strong="H00669"\w* \w in his right hand|strong="H03225"\w* \w toward Israel’s|strong="H03478"\w* \w -|strong="H00853"\w* \w left hand|strong="H08040"\w*, \w and Manasseh|strong="H04519"\w* \w in his left hand|strong="H08040"\w* \w toward Israel’s|strong="H03478"\w* \w right hand|strong="H03225"\w*— \w and brought them close|strong="H05066"\w* \w to him|strong="H00413"\w*. \v 14 \w But Israel|strong="H03478"\w* \w -|strong="H00853"\w* \w stretched out|strong="H07971"\w* \w his right hand|strong="H03225"\w* \w and put|strong="H07896"\w* \w it on|strong="H05921"\w* \w the head|strong="H07218"\w* \w of Ephraim|strong="H00669"\w*, \w . . .|strong="H01931"\w* \w the younger|strong="H06810"\w*; \w -|strong="H00853"\w* \w and crossing|strong="H07919"\w* \w -|strong="H00853"\w* \w his hands|strong="H03027"\w*, \w he put his left|strong="H08040"\w* \w on|strong="H05921"\w* \w Manasseh’s|strong="H04519"\w* \w head|strong="H07218"\w*, \w although|strong="H03588"\w* \w Manasseh|strong="H04519"\w* \w was the firstborn|strong="H01060"\w*. \v 15 \w Then he blessed|strong="H01288"\w* \w -|strong="H00853"\w* \w Joseph|strong="H03130"\w* \w and said|strong="H00559"\w*:
\b 
\q1 “\w May the God|strong="H00430"\w* \w before|strong="H06440"\w* \w whom|strong="H00834"\w* \w my fathers|strong="H00001"\w* \w Abraham|strong="H00085"\w* \w and Isaac|strong="H03327"\w* \w walked|strong="H01980"\w*,
\q2 \w the God|strong="H00430"\w* \w who has been my shepherd|strong="H07462"\w* \w -|strong="H00853"\w* \w all my life|strong="H05750"\w* \w to|strong="H05704"\w* \w this|strong="H02088"\w* \w day|strong="H03117"\w*,
