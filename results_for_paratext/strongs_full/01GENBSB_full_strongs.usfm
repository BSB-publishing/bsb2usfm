\c 38
\s1 Judah and Tamar
\p \v 1 \w About|strong="H01961"\w* \w that|strong="H01931"\w* \w time|strong="H06256"\w*, \w Judah|strong="H03063"\w* \w . . .|strong="H00854"\w* \w left|strong="H03381"\w* \w his brothers|strong="H00251"\w* \w and settled|strong="H05186"\w* \w near|strong="H05704"\w* \w a man|strong="H00376"\w* \w named|strong="H08034"\w* \w Hirah|strong="H02437"\w*, \w an Adullamite|strong="H05726"\w*. \v 2 \w There|strong="H08033"\w* \w Judah|strong="H03063"\w* \w saw|strong="H07200"\w* \w the daughter|strong="H01323"\w* \w of a Canaanite|strong="H03669"\w* \w man|strong="H00376"\w* \w named|strong="H08034"\w* \w Shua|strong="H07770"\w*, \w and he took her as a wife|strong="H03947"\w* \w and slept with|strong="H00935"\w* \w her|strong="H00413"\w*. \v 3 \w So she conceived|strong="H02029"\w* \w and gave birth to|strong="H03205"\w* \w a son|strong="H01121"\w*, \w and [Judah] named|strong="H07121"\w* \w -|strong="H00853"\w* \w him|strong="H08034"\w* \w Er|strong="H06147"\w*. \v 4 \w Again|strong="H05750"\w* \w she conceived|strong="H02029"\w* \w and gave birth to|strong="H03205"\w* \w a son|strong="H01121"\w*, \w and she named|strong="H07121"\w* \w -|strong="H00853"\w* \w him|strong="H08034"\w* \w Onan|strong="H00209"\w*. \v 5 \w Then she gave birth to|strong="H03205"\w* \w another|strong="H03254"\w* \w . . .|strong="H05750"\w* \w son|strong="H01121"\w* \w and named|strong="H07121"\w* \w -|strong="H00853"\w* \w him|strong="H08034"\w* \w Shelah|strong="H07956"\w*; \w it was|strong="H01961"\w* \w at Chezib|strong="H03580"\w* \w that she gave birth to him|strong="H03205"\w* \w -|strong="H00853"\w*.
\p \v 6 \w Now Judah|strong="H03063"\w* \w acquired|strong="H03947"\w* \w a wife|strong="H00802"\w* \w for Er|strong="H06147"\w*, \w his firstborn|strong="H01060"\w*, \w and her name|strong="H08034"\w* \w was Tamar|strong="H08559"\w*. \v 7 \w But|strong="H01961"\w* \w Er|strong="H06147"\w*, \w Judah’s|strong="H03063"\w* \w firstborn|strong="H01060"\w*, \w was wicked|strong="H07451"\w* \w in the sight|strong="H05869"\w* \w of the LORD|strong="H03068"\w*; \w so the LORD|strong="H03068"\w* \w put him to death|strong="H04191"\w*. \v 8 \w Then Judah|strong="H03063"\w* \w said|strong="H00559"\w* \w to Onan|strong="H00209"\w*, “\w Sleep with|strong="H00935"\w* \w . . .|strong="H00413"\w* \w your brother’s|strong="H00251"\w* \w wife|strong="H00802"\w*. \w Perform your duty as her brother-in-law|strong="H02992"\w* \w -|strong="H00853"\w* \w and raise up|strong="H06965"\w* \w offspring|strong="H02233"\w* \w for your brother|strong="H00251"\w*.”
