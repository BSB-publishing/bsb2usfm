\p \v 11 \w Then Judah|strong="H03063"\w* \w said|strong="H00559"\w* \w to his daughter-in-law|strong="H03618"\w* \w Tamar|strong="H08559"\w*, “\w Live|strong="H03427"\w* \w as a widow|strong="H00490"\w* \w in your father’s|strong="H00001"\w* \w house|strong="H01004"\w* \w until|strong="H05704"\w* \w my son|strong="H01121"\w* \w Shelah|strong="H07956"\w* \w grows up|strong="H01431"\w*.” \w For|strong="H03588"\w* \w he thought|strong="H00559"\w*, “\w He|strong="H01931"\w* \w may|strong="H06435"\w* \w die|strong="H04191"\w* \w too|strong="H01571"\w*, \w like his brothers|strong="H00251"\w*.” \w So Tamar|strong="H08559"\w* \w went|strong="H01980"\w* \w to live|strong="H03427"\w* \w in her father’s|strong="H00001"\w* \w house|strong="H01004"\w*.
\p \v 12 \w After a long|strong="H07235"\w* \w time|strong="H03117"\w* \w Judah’s|strong="H03063"\w* \w wife|strong="H00802"\w*, \w the daughter|strong="H01323"\w* \w of Shua|strong="H07770"\w*, \w died|strong="H04191"\w*. \w When Judah|strong="H03063"\w* \w had finished mourning|strong="H05162"\w*, \w he|strong="H01931"\w* \w and his friend|strong="H07453"\w* \w Hirah|strong="H02437"\w* \w the Adullamite|strong="H05726"\w* \w went up|strong="H05927"\w* \w to|strong="H05921"\w* \w his sheepshearers|strong="H01494"\w* \w . . .|strong="H06629"\w* \w at Timnah|strong="H08553"\w*. \v 13 \w When Tamar|strong="H08559"\w* \w . . .|strong="H00559"\w* \w . . .|strong="H02009"\w* \w was told|strong="H05046"\w*, “\w Your father-in-law|strong="H02524"\w* \w is going up|strong="H05927"\w* \w to Timnah|strong="H08553"\w* \w to shear|strong="H01494"\w* \w his sheep|strong="H06629"\w*,” \v 14 \w she removed|strong="H05493"\w* \w her|strong="H05921"\w* \w widow’s|strong="H00491"\w* \w garments|strong="H00899"\w*, \w covered her face|strong="H05968"\w* \w with a veil|strong="H06809"\w* \w to disguise herself|strong="H03680"\w*, \w and sat|strong="H03427"\w* \w at the entrance|strong="H06607"\w* \w to Enaim|strong="H05879"\w*, \w which|strong="H00834"\w* \w is on|strong="H05921"\w* \w the way|strong="H01870"\w* \w to Timnah|strong="H08553"\w*. \w For|strong="H03588"\w* \w she saw|strong="H07200"\w* \w that|strong="H03588"\w* \w although Shelah|strong="H07956"\w* \w had grown up|strong="H01431"\w*, \w she|strong="H01931"\w* \w had not|strong="H03808"\w* \w been given|strong="H05414"\w* to him \w as a wife|strong="H00802"\w*.
\p \v 15 \w When Judah|strong="H03063"\w* \w saw her|strong="H07200"\w*, \w he thought|strong="H02803"\w* \w she was a prostitute|strong="H02181"\w* \w because|strong="H03588"\w* \w she had covered|strong="H03680"\w* \w her face|strong="H06440"\w*. \v 16 \w -|strong="H01870"\w* \w -|strong="H03588"\w* \w Not|strong="H03808"\w* \w realizing|strong="H03045"\w* \w that|strong="H03588"\w* \w she|strong="H01931"\w* \w was his daughter-in-law|strong="H03618"\w*, \w he went over|strong="H05186"\w* \w to her|strong="H00413"\w* \w and said|strong="H00559"\w*, “\w Come|strong="H03051"\w* \w now|strong="H04994"\w*, \w let me sleep with|strong="H00935"\w* \w you|strong="H00413"\w*.”
\p “\w What|strong="H04100"\w* \w will you give|strong="H05414"\w* me \w for|strong="H03588"\w* \w sleeping with|strong="H00935"\w* \w . . .|strong="H00413"\w* \w you|strong="H00413"\w*?” \w she inquired|strong="H00559"\w*.
