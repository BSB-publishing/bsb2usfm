\p \v 6 “\w Here|strong="H02009"\w*,” \w said|strong="H00559"\w* \w Abram|strong="H00087"\w* \w -|strong="H00413"\w* \w -|strong="H08297"\w*, “\w your servant|strong="H08198"\w* \w is in your hands|strong="H03027"\w*. \w Do|strong="H06213"\w* \w whatever you want|strong="H02896"\w*\w . . .|strong="H05869"\w* with her.” \w Then Sarai|strong="H08297"\w* \w treated|strong="H06031"\w* \w [Hagar] so harshly that she fled|strong="H01272"\w* \w from her|strong="H06440"\w*.
\p \v 7 \w Now the angel|strong="H04397"\w*\f + \fr 16:7 \ft Or \fqa Angel\ft ; also in verses 9, 10, and 11; corresponding pronouns may also be capitalized.\f* \w of the LORD|strong="H03068"\w* \w found|strong="H04672"\w* \w [Hagar] by|strong="H05921"\w* \w a spring|strong="H05869"\w* \w of water|strong="H04325"\w* \w in the desert|strong="H04057"\w* — \w . . .|strong="H05921"\w* \w the spring|strong="H05869"\w* \w along the road|strong="H01870"\w* \w to Shur|strong="H07793"\w*. \v 8 “\w Hagar|strong="H01904"\w*, \w servant|strong="H08198"\w* \w of Sarai|strong="H08297"\w*,” \w he said|strong="H00559"\w*, “\w where|strong="H00335"\w* \w . . .|strong="H02088"\w* \w have you come from|strong="H00935"\w*, \w and where|strong="H00575"\w* \w are you going|strong="H01980"\w*?”
\p “\w I am|strong="H00595"\w* \w running away|strong="H01272"\w* \w from|strong="H06440"\w* \w my mistress|strong="H01404"\w* \w Sarai|strong="H08297"\w*,” \w she replied|strong="H00559"\w*.
\p \v 9 \w So the angel|strong="H04397"\w* \w of the LORD|strong="H03068"\w* \w told|strong="H00559"\w* her, “\w Return|strong="H07725"\w* \w to|strong="H00413"\w* \w your mistress|strong="H01404"\w* \w and submit|strong="H06031"\w* \w to her authority|strong="H08478"\w* \w . . .|strong="H03027"\w*.” \v 10 \w Then the angel|strong="H04397"\w* \w . . .|strong="H03068"\w* \w added|strong="H00559"\w*, “\w I will greatly multiply|strong="H07235"\w* \w . . .|strong="H07235"\w* \w -|strong="H00853"\w* \w your offspring|strong="H02233"\w* \w so that|strong="H03808"\w* \w they will be too numerous|strong="H07230"\w* \w to count|strong="H05608"\w*.”
\p \v 11 \w The angel|strong="H04397"\w* \w of the LORD|strong="H03068"\w* \w proceeded|strong="H00559"\w* . . .:
