\p \v 28 \w These|strong="H00428"\w* \w are the tribes|strong="H07626"\w* \w of Israel|strong="H03478"\w*, \w twelve|strong="H08147"\w* \w . . .|strong="H06240"\w* \w in all|strong="H03605"\w*, \w and this|strong="H02063"\w* \w was what|strong="H00834"\w* \w their father|strong="H00001"\w* \w said|strong="H01696"\w* to them. \w He blessed them|strong="H01288"\w*, \w -|strong="H00853"\w* \w -|strong="H00376"\w* \w and he blessed|strong="H01288"\w* \w each one|strong="H00834"\w* \w -|strong="H00853"\w* \w with a suitable blessing|strong="H01293"\w*.
\s1 The Death of Jacob
\p \v 29 \w Then [Jacob] instructed them|strong="H06680"\w*, \w -|strong="H00853"\w* \w -|strong="H00559"\w* “\w I|strong="H00589"\w* \w am about to be gathered|strong="H00622"\w* \w to|strong="H00413"\w* \w my people|strong="H05971"\w*. \w Bury|strong="H06912"\w* \w me|strong="H00853"\w* \w with|strong="H00413"\w* \w my fathers|strong="H00001"\w* \w . . .|strong="H00413"\w* \w in|strong="H00413"\w* \w the cave|strong="H04631"\w* \w -|strong="H00834"\w* \w in the field|strong="H07704"\w* \w of Ephron|strong="H06085"\w* \w the Hittite|strong="H02850"\w*. \v 30 \w The cave|strong="H04631"\w*\w . . .|strong="H00834"\w* \w is in the field|strong="H07704"\w* \w of Machpelah|strong="H04375"\w* \w -|strong="H00834"\w* \w near|strong="H05921"\w* \w . . .|strong="H06440"\w* \w Mamre|strong="H04471"\w*, \w in the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*. \w This|strong="H00834"\w* \w is the field|strong="H07704"\w* \w Abraham|strong="H00085"\w* \w -|strong="H00853"\w* \w purchased|strong="H07069"\w* \w from|strong="H00854"\w* \w Ephron|strong="H06085"\w* \w the Hittite|strong="H02850"\w* \w as a burial|strong="H06913"\w* \w site|strong="H00272"\w*. \v 31 \w -|strong="H00853"\w* \w There|strong="H08033"\w* \w Abraham|strong="H00085"\w* \w -|strong="H00853"\w* \w and his wife|strong="H00802"\w* \w Sarah|strong="H08283"\w* \w are buried|strong="H06912"\w*, \w there|strong="H08033"\w* \w Isaac|strong="H03327"\w* \w -|strong="H00853"\w* \w and his wife|strong="H00802"\w* \w Rebekah|strong="H07259"\w* \w are buried|strong="H06912"\w*, \w -|strong="H00853"\w* \w and there|strong="H08033"\w* \w I buried|strong="H06912"\w* \w -|strong="H00853"\w* \w Leah|strong="H03812"\w*. \v 32 \w The field|strong="H07704"\w* \w and the cave|strong="H04631"\w* \w that is|strong="H00834"\w* in it \w . . .|strong="H00854"\w* \w were purchased|strong="H04735"\w* \w from the Hittites|strong="H01121"\w* \w . . .|strong="H02845"\w*.”
\p \v 33 \w When Jacob|strong="H03290"\w* \w had finished|strong="H03615"\w* \w instructing|strong="H06680"\w* \w -|strong="H00853"\w* \w his sons|strong="H01121"\w*, \w he pulled|strong="H00622"\w* \w his feet|strong="H07272"\w* \w into|strong="H00413"\w* \w the bed|strong="H04296"\w* \w and breathed his last|strong="H01478"\w*, \w and he was gathered|strong="H00622"\w* \w to|strong="H00413"\w* \w his people|strong="H05971"\w*.
\c 50
\s1 Mourning and Burial for Jacob
\p \v 1 \w Then Joseph|strong="H03130"\w* \w fell|strong="H05307"\w* \w upon|strong="H05921"\w* \w his father’s|strong="H00001"\w* \w face|strong="H06440"\w*, \w wept|strong="H01058"\w* \w over him|strong="H05921"\w*, \w and kissed|strong="H05401"\w* him.
\p \v 2 \w And Joseph|strong="H03130"\w* \w -|strong="H00853"\w* \w directed|strong="H06680"\w* \w the physicians|strong="H07495"\w* \w in his service|strong="H05650"\w* \w -|strong="H00853"\w* \w to embalm|strong="H02590"\w* \w -|strong="H00853"\w* \w his father|strong="H00001"\w* \w Israel|strong="H03478"\w*. \w So they|strong="H07495"\w* \w -|strong="H00853"\w* \w embalmed him|strong="H02590"\w*, \v 3 \w taking the forty|strong="H00705"\w* \w days|strong="H03117"\w* \w required to complete|strong="H04390"\w* \w -|strong="H03588"\w* \w -|strong="H03651"\w* \w . . .|strong="H04390"\w*\w . . .|strong="H03117"\w* \w the embalming|strong="H02590"\w*. \w And the Egyptians|strong="H04713"\w* \w mourned|strong="H01058"\w* \w -|strong="H00853"\w* \w for him seventy|strong="H07657"\w* \w days|strong="H03117"\w*.
\p \v 4 \w When the days|strong="H03117"\w* \w of mourning|strong="H01068"\w* \w had passed|strong="H05674"\w*, \w Joseph|strong="H03130"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Pharaoh’s|strong="H06547"\w* \w . . .|strong="H00559"\w* \w court|strong="H01004"\w*, “\w If|strong="H00518"\w* \w I have found|strong="H04672"\w* \w favor|strong="H02580"\w* \w in your eyes|strong="H05869"\w*, \w please|strong="H04994"\w* \w tell|strong="H01696"\w* \w . . .|strong="H04994"\w* \w . . .|strong="H00241"\w* \w Pharaoh that|strong="H06547"\w* \w . . .|strong="H00559"\w* \v 5 \w my father|strong="H00001"\w* \w made me swear an oath|strong="H07650"\w* \w when he said|strong="H00559"\w*, ‘\w . . .|strong="H02009"\w* \w I|strong="H00595"\w* \w am about to die|strong="H04191"\w*. \w You must bury me|strong="H06912"\w* \w . . .|strong="H08033"\w* \w in the tomb|strong="H06913"\w* \w that|strong="H00834"\w* \w I dug|strong="H03738"\w* \w for myself in the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*.’ \w Now|strong="H06258"\w* \w let me go|strong="H05927"\w* \w . . .|strong="H04994"\w* \w and bury|strong="H06912"\w* \w -|strong="H00853"\w* \w my father|strong="H00001"\w*, \w and then return|strong="H07725"\w*.”
\p \v 6 \w Pharaoh|strong="H06547"\w* \w replied|strong="H00559"\w*, “\w Go up|strong="H05927"\w* \w and bury|strong="H06912"\w* \w -|strong="H00853"\w* \w your father|strong="H00001"\w*, \w as|strong="H00834"\w* \w he made you swear [to do]|strong="H07650"\w*.”
\p \v 7 \w Then Joseph|strong="H03130"\w* \w went|strong="H05927"\w* \w to bury|strong="H06912"\w* \w -|strong="H00853"\w* \w his father|strong="H00001"\w*, \w and all|strong="H03605"\w* \w the servants|strong="H05650"\w* \w of Pharaoh|strong="H06547"\w* \w accompanied|strong="H05927"\w* \w him|strong="H00854"\w* — \w the elders|strong="H02205"\w* \w of Pharaoh’s household|strong="H01004"\w* \w and all|strong="H03605"\w* \w the elders|strong="H02205"\w* \w of the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w* — \v 8 \w along with all|strong="H03605"\w* \w of Joseph’s|strong="H03130"\w* \w household|strong="H01004"\w*, \w and his brothers|strong="H00251"\w*, \w and his father’s|strong="H00001"\w* \w household|strong="H01004"\w*. \w Only|strong="H07535"\w* \w their children|strong="H02945"\w* \w and flocks|strong="H06629"\w* \w and herds|strong="H01241"\w* \w were left|strong="H05800"\w* \w vvv|strong="H00776"\w* \w in Goshen|strong="H01657"\w*.
\p \v 9 \w Chariots|strong="H07393"\w* \w and|strong="H01571"\w* \w horsemen|strong="H06571"\w* \w alike|strong="H01571"\w* \w went up|strong="H05927"\w* \w with him|strong="H05973"\w*, \w and it was|strong="H01961"\w* \w an exceedingly|strong="H03966"\w* \w large|strong="H03515"\w* \w procession|strong="H04264"\w*. \v 10 \w When they reached|strong="H00935"\w* \w . . .|strong="H05704"\w* \w the threshing floor|strong="H01637"\w* \w of Atad|strong="H00329"\w*, \w which|strong="H00834"\w* \w is across|strong="H05676"\w* \w the Jordan|strong="H03383"\w*, \w they lamented|strong="H05594"\w* \w . . .|strong="H08033"\w* \w and wailed|strong="H04553"\w* \w loudly|strong="H01419"\w*, \w . . .|strong="H03515"\w* \w . . .|strong="H03966"\w* \w and Joseph mourned|strong="H06213"\w* \w . . .|strong="H00060"\w* \w for his father|strong="H00001"\w* \w seven|strong="H07651"\w* \w days|strong="H03117"\w*.
\p \v 11 \w When the Canaanites|strong="H03669"\w* \w -|strong="H00853"\w* \w vvv|strong="H03427"\w* \w of the land|strong="H00776"\w* \w saw|strong="H07200"\w* \w the mourning|strong="H00060"\w* \w . . .|strong="H01637"\w* \w at the threshing floor of Atad|strong="H00329"\w*, \w they said|strong="H00559"\w*, “\w This|strong="H02088"\w* \w is a solemn|strong="H03515"\w* \w ceremony of mourning|strong="H00060"\w* \w by the Egyptians|strong="H04714"\w*.” \w Thus|strong="H05921"\w* \w . . .|strong="H03651"\w* \w the place|strong="H00834"\w* \w across|strong="H05676"\w* \w the Jordan|strong="H03383"\w* \w is called|strong="H07121"\w* \w . . .|strong="H08034"\w* \w vvv|strong="H00067"\w* \w Abel-mizraim|strong="H00067"\w*.\f + \fr 50:11 \fqa Abel-mizraim \ft means \fqa mourning of the Egyptians\ft .\f*
\p \v 12 \w So Jacob’s sons|strong="H01121"\w* \w -|strong="H03651"\w* \w did|strong="H06213"\w* \w as|strong="H00834"\w* \w he had charged them|strong="H06680"\w*. \v 13 \w They|strong="H01121"\w* \w carried|strong="H05375"\w* \w him|strong="H00853"\w* \w to the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w* \w and buried|strong="H06912"\w* \w him|strong="H00853"\w* \w in the cave|strong="H04631"\w* \w at Machpelah|strong="H04375"\w* \w in the field|strong="H07704"\w* \w near|strong="H05921"\w* \w . . .|strong="H06440"\w* \w Mamre|strong="H04471"\w*, \w which|strong="H00834"\w* \w Abraham|strong="H00085"\w* \w -|strong="H00853"\w* \w -|strong="H07704"\w* \w had purchased|strong="H07069"\w* \w from Ephron|strong="H06085"\w* \w the Hittite|strong="H02850"\w* \w as a burial|strong="H06913"\w* \w . . .|strong="H00854"\w* \w site|strong="H00272"\w*.
