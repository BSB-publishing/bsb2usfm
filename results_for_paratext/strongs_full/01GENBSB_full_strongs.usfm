\s1 The Famine Continues
\p \v 13 \w There was no|strong="H00369"\w* \w food, however|strong="H03899"\w*, \w in all|strong="H03605"\w* \w that region|strong="H00776"\w*, \w because|strong="H03588"\w* \w the famine|strong="H07458"\w* \w was so|strong="H03966"\w* \w severe|strong="H03515"\w*; \w the lands|strong="H00776"\w* \w of Egypt|strong="H04714"\w* \w and|strong="H00776"\w* \w Canaan|strong="H03667"\w* \w had been exhausted|strong="H03856"\w* \w by|strong="H06440"\w* \w the famine|strong="H07458"\w*. \v 14 \w Joseph|strong="H03130"\w* \w -|strong="H00853"\w* \w collected|strong="H03950"\w* \w all|strong="H03605"\w* \w the money|strong="H03701"\w* \w to be found|strong="H04672"\w* \w in the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w* \w and the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w* \w in exchange for the grain|strong="H07668"\w* \w -|strong="H00834"\w* \w they|strong="H01992"\w* \w were buying|strong="H07666"\w*, \w and he|strong="H03130"\w* \w -|strong="H00853"\w* \w brought|strong="H00935"\w* \w [it]|strong="H03701"\w* \w into Pharaoh’s|strong="H06547"\w* \w palace|strong="H01004"\w*. \v 15 \w When the money|strong="H03701"\w* \w from the lands|strong="H00776"\w* \w of Egypt|strong="H04714"\w* \w and|strong="H00776"\w* \w Canaan|strong="H03667"\w* \w was gone|strong="H08552"\w*, \w all|strong="H03605"\w* \w the Egyptians|strong="H04713"\w* \w came|strong="H00935"\w* \w to|strong="H00413"\w* \w Joseph|strong="H03130"\w* \w and said|strong="H00559"\w*, “\w Give|strong="H03051"\w* us \w food|strong="H03899"\w*. \w Why|strong="H04100"\w* \w should we die|strong="H04191"\w* \w before your eyes|strong="H05048"\w*? \w For|strong="H03588"\w* \w our funds|strong="H03701"\w* \w have run out|strong="H00656"\w*!”
\p \v 16 “\w Then bring me|strong="H03051"\w* \w your livestock|strong="H04735"\w*,” \w said|strong="H00559"\w* \w Joseph|strong="H03130"\w*. “\w Since|strong="H00518"\w* \w the money|strong="H03701"\w* \w is gone|strong="H00656"\w*, \w I will sell|strong="H05414"\w* you food \w in exchange for your livestock|strong="H04735"\w*.” \v 17 \w So they brought|strong="H00935"\w* \w -|strong="H00853"\w* \w their livestock|strong="H04735"\w* \w to|strong="H00413"\w* \w Joseph|strong="H03130"\w*, \w and he|strong="H03130"\w* \w gave|strong="H05414"\w* them \w food|strong="H03899"\w* \w in exchange for their horses|strong="H05483"\w*, \w vvv|strong="H04735"\w* \w their flocks|strong="H06629"\w* \w -|strong="H04735"\w* \w and herds|strong="H01241"\w*, \w and their donkeys|strong="H02543"\w*. \w Throughout that|strong="H01931"\w* \w year|strong="H08141"\w* \w he provided them|strong="H05095"\w* \w with food|strong="H03899"\w* \w in exchange for all|strong="H03605"\w* \w their livestock|strong="H04735"\w*.
\p \v 18 \w When that|strong="H01931"\w* \w year|strong="H08141"\w* \w was over|strong="H08552"\w*, \w they came|strong="H00935"\w* \w to him|strong="H00413"\w* \w the second|strong="H08145"\w* \w year|strong="H08141"\w* \w and said|strong="H00559"\w*, “\w We cannot|strong="H03808"\w* \w hide|strong="H03582"\w* \w from our lord|strong="H00113"\w* \w that|strong="H03588"\w* \w our money|strong="H03701"\w* \w is gone|strong="H08552"\w* \w and all our livestock|strong="H04735"\w* \w . . .|strong="H00929"\w* \w belongs to|strong="H00413"\w* \w [you]|strong="H00113"\w*. \w There is nothing|strong="H03808"\w* \w left|strong="H07604"\w* \w for|strong="H06440"\w* \w our lord|strong="H00113"\w* \w except|strong="H01115"\w* \w . . .|strong="H00518"\w* \w . . .|strong="H00518"\w* \w our bodies|strong="H01472"\w* \w and our land|strong="H00127"\w*. \v 19 \w Why|strong="H04100"\w* \w should we perish|strong="H04191"\w* \w before your eyes|strong="H05869"\w*— \w we|strong="H00587"\w* \w and|strong="H01571"\w* \w our land|strong="H00127"\w* \w as well|strong="H01571"\w*? \w Purchase|strong="H07069"\w* \w us|strong="H00853"\w* \w and|strong="H00853"\w* \w our land|strong="H00127"\w* \w in exchange for food|strong="H03899"\w*. \w Then we|strong="H00587"\w*, \w along with our land|strong="H00127"\w*, \w will be|strong="H01961"\w* \w slaves|strong="H05650"\w* \w to Pharaoh|strong="H06547"\w*. \w Give us|strong="H05414"\w* \w seed|strong="H02233"\w* \w that we may live|strong="H02421"\w* \w and not|strong="H03808"\w* \w die|strong="H04191"\w*, \w and that the land|strong="H00127"\w* \w may not|strong="H03808"\w* \w become desolate|strong="H03456"\w*.”
\p \v 20 \w So Joseph|strong="H03130"\w* \w -|strong="H00853"\w* \w acquired|strong="H07069"\w* \w for Pharaoh|strong="H06547"\w* \w all|strong="H03605"\w* \w the land|strong="H00127"\w* \w in Egypt|strong="H04714"\w*; \w -|strong="H03588"\w* \w the Egyptians|strong="H04713"\w*, \w one and all|strong="H00376"\w*, \w sold|strong="H04376"\w* \w their fields|strong="H07704"\w* \w because|strong="H03588"\w* \w the famine|strong="H07458"\w* \w was so severe|strong="H02388"\w* \w upon them|strong="H05921"\w*. \w The land|strong="H00776"\w* \w became Pharaoh’s|strong="H01961"\w* \w . . .|strong="H06547"\w*, \v 21 \w -|strong="H00853"\w* \w and Joseph reduced|strong="H05674"\w* \w -|strong="H00853"\w* \w the people|strong="H05971"\w* \w to servitude|strong="H05892"\w*\f + \fr 47:21 \ft SP, LXX, Vulgate; Hebrew \fqa removed the people to the cities\f* \w from one end|strong="H07097"\w* \w . . .|strong="H01366"\w* \w of Egypt|strong="H04714"\w* \w to|strong="H05704"\w* \w the other|strong="H07097"\w*. \v 22 \w However|strong="H07535"\w*, \w he did not|strong="H03808"\w* \w acquire|strong="H07069"\w* \w the priests’ portion|strong="H03548"\w* \w of the land|strong="H00127"\w*, \w for|strong="H03588"\w* \w it had been given to them by Pharaoh|strong="H06547"\w*. \w They ate|strong="H00398"\w* \w -|strong="H00853"\w* \w the rations that|strong="H02706"\w* \w -|strong="H00834"\w* \w -|strong="H02706"\w* \w . . .|strong="H03548"\w* \w . . .|strong="H00854"\w* \w Pharaoh|strong="H06547"\w* \w supplied|strong="H05414"\w*; \w so|strong="H05921"\w* \w . . .|strong="H03651"\w* \w they did not|strong="H03808"\w* \w sell|strong="H04376"\w* \w -|strong="H00853"\w* \w their land|strong="H00127"\w*.
\p \v 23 \w Then Joseph|strong="H03130"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w the people|strong="H05971"\w*, “\w Now that|strong="H02005"\w* \w I have acquired|strong="H07069"\w* \w -|strong="H00853"\w* \w you and your land|strong="H00127"\w* \w for Pharaoh|strong="H06547"\w* \w this day|strong="H03117"\w* \w -|strong="H00853"\w*, \w here|strong="H01887"\w* \w is seed|strong="H02233"\w* for you \w to sow|strong="H02232"\w* \w -|strong="H00853"\w* \w in the land|strong="H00127"\w*. \v 24 \w . . .|strong="H01961"\w* \w At harvest time|strong="H08393"\w*, \w you are to give|strong="H05414"\w* \w a fifth|strong="H02549"\w* \w of it to Pharaoh|strong="H06547"\w*, \w and four-fifths|strong="H00702"\w* \w . . .|strong="H03027"\w* \w will be|strong="H01961"\w* yours \w as seed|strong="H02233"\w* \w for the field|strong="H07704"\w* \w and food for yourselves|strong="H00400"\w* \w -|strong="H00834"\w* \w and your households|strong="H01004"\w* \w . . .|strong="H00398"\w* \w and children|strong="H02945"\w*.”
\p \v 25 “\w You have saved our lives|strong="H02421"\w*,” \w they said|strong="H00559"\w*. “\w We have found|strong="H04672"\w* \w favor|strong="H02580"\w* \w in our lord’s|strong="H00113"\w* \w eyes|strong="H05869"\w*, \w and we will be|strong="H01961"\w* \w Pharaoh’s|strong="H06547"\w* \w servants|strong="H05650"\w*.” \v 26 \w So Joseph|strong="H03130"\w* \w established|strong="H07760"\w* \w -|strong="H00853"\w* \w a law|strong="H02706"\w* \w that a fifth|strong="H02569"\w* \w of the produce belongs to Pharaoh|strong="H06547"\w*, \w and it is in effect|strong="H05704"\w* \w in|strong="H05921"\w* \w the land|strong="H00127"\w* \w of Egypt|strong="H04714"\w* \w to this|strong="H02088"\w* \w day|strong="H03117"\w*. \w Only|strong="H07535"\w* \w the priests’|strong="H03548"\w* \w . . .|strong="H00905"\w* \w land|strong="H00127"\w* \w does not|strong="H03808"\w* \w belong to|strong="H01961"\w* \w Pharaoh|strong="H06547"\w*.
\s1 The Israelites Prosper in Goshen
\p \v 27 \w Now the Israelites|strong="H03478"\w* \w settled|strong="H03427"\w* \w in the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w*, \w in the region|strong="H00776"\w* \w of Goshen|strong="H01657"\w*. \w They acquired property|strong="H00270"\w* there \w and became fruitful|strong="H06509"\w* \w and increased greatly|strong="H03966"\w* \w in number|strong="H07235"\w*. \v 28 \w And Jacob|strong="H03290"\w* \w lived|strong="H02421"\w* \w in the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w* \w vvv|strong="H07651"\w* \w seventeen|strong="H06240"\w* \w years|strong="H08141"\w*, \w and the length of his life|strong="H08141"\w* \w . . .|strong="H02416"\w* \w was|strong="H01961"\w* \w . . .|strong="H03117"\w* \w . . .|strong="H03290"\w* \w 147|strong="H03967"\w* \w . . .|strong="H07651"\w* \w . . .|strong="H00705"\w* \w vvv|strong="H08141"\w* \w years|strong="H08141"\w*.
\p \v 29 \w When the time|strong="H03117"\w* \w drew near|strong="H07126"\w* \w for Israel|strong="H03478"\w* \w to die|strong="H04191"\w*, \w he called|strong="H07121"\w* \w his son|strong="H01121"\w* \w Joseph|strong="H03130"\w* \w and said|strong="H00559"\w* to him, “\w If|strong="H00518"\w* \w . . .|strong="H04994"\w* \w I have found|strong="H04672"\w* \w favor|strong="H02580"\w* \w in your eyes|strong="H05869"\w*, \w put|strong="H07760"\w* \w . . .|strong="H04994"\w* \w your hand|strong="H03027"\w* \w under|strong="H08478"\w* \w my thigh|strong="H03409"\w* \w and promise to show|strong="H06213"\w* \w me|strong="H05978"\w* \w kindness|strong="H02617"\w* \w and faithfulness|strong="H00571"\w*. \w Do not|strong="H00408"\w* \w . . .|strong="H04994"\w* \w bury me|strong="H06912"\w* \w in Egypt|strong="H04714"\w*, \v 30 \w but when I lie down|strong="H07901"\w* \w with|strong="H05973"\w* \w my fathers|strong="H00001"\w*, \w carry me|strong="H05375"\w* \w out of Egypt|strong="H04714"\w* \w and bury me|strong="H06912"\w* \w with them|strong="H06900"\w*.”
\p \w Joseph answered|strong="H00559"\w*, “\w I|strong="H00595"\w* \w will do|strong="H06213"\w* \w as you have requested|strong="H01697"\w*.”
\p \v 31 “\w Swear|strong="H07650"\w* to me,” \w Jacob said|strong="H00559"\w*.
\p \w So Joseph swore|strong="H07650"\w* to him, \w and Israel|strong="H03478"\w* \w bowed [in worship]|strong="H07812"\w* \w at|strong="H05921"\w* \w the head|strong="H07218"\w* \w of his bed|strong="H04296"\w*.\f + \fr 47:31 \ft Hebrew; LXX \fqa Israel worshiped as he leaned on the top of his staff\ft ; see Hebrews 11:21.\f*
\c 48
\s1 Jacob Blesses Ephraim and Manasseh
\p \v 1 \w -|strong="H01961"\w* \w Some time later|strong="H00310"\w* \w . . .|strong="H01697"\w* \w . . .|strong="H00428"\w* \w Joseph|strong="H03130"\w* \w . . .|strong="H02009"\w* \w was told|strong="H00559"\w*, “\w Your father|strong="H00001"\w* \w is ill|strong="H02470"\w*.” \w So he set out|strong="H03947"\w* \w -|strong="H00853"\w* \w with|strong="H05973"\w* \w -|strong="H00853"\w* \w his two|strong="H08147"\w* \w sons|strong="H01121"\w*, \w Manasseh|strong="H04519"\w* \w -|strong="H00853"\w* \w and Ephraim|strong="H00669"\w*. \v 2 \w When Jacob|strong="H03290"\w* \w . . .|strong="H00559"\w* \w . . .|strong="H02009"\w* \w was told|strong="H05046"\w*, “\w Your son|strong="H01121"\w* \w Joseph|strong="H03130"\w* \w has come|strong="H00935"\w* \w to you|strong="H00413"\w*,” \w Israel|strong="H03478"\w* \w rallied his strength|strong="H02388"\w* \w and sat up|strong="H03427"\w* \w in|strong="H05921"\w* \w bed|strong="H04296"\w*.
\p \v 3 \w Jacob|strong="H03290"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Joseph|strong="H03130"\w*, “\w God|strong="H00410"\w* \w Almighty|strong="H07706"\w*\f + \fr 48:3 \ft Hebrew \fqa El-Shaddai\f* \w appeared|strong="H07200"\w* \w to me|strong="H00413"\w* \w at Luz|strong="H03870"\w* \w in the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*, \w and there He blessed|strong="H01288"\w* \w me|strong="H00853"\w* \v 4 \w and told|strong="H00559"\w* \w me|strong="H00413"\w*, ‘\w Behold|strong="H02005"\w*, \w I will make you fruitful|strong="H06509"\w* \w and multiply you|strong="H07235"\w*; \w I will make you|strong="H05414"\w* \w a multitude|strong="H06951"\w* \w of peoples|strong="H05971"\w*, \w and will give|strong="H05414"\w* \w -|strong="H00853"\w* \w this|strong="H02063"\w* \w land|strong="H00776"\w* \w to your descendants|strong="H02233"\w* \w after you|strong="H00310"\w* \w as an everlasting|strong="H05769"\w* \w possession|strong="H00272"\w*.’
\p \v 5 \w And now|strong="H06258"\w* \w your two|strong="H08147"\w* \w sons|strong="H01121"\w* \w born|strong="H03205"\w* to you \w vvv|strong="H00776"\w* \w in Egypt|strong="H04714"\w* \w before|strong="H05704"\w* \w I came|strong="H00935"\w* \w to you|strong="H00413"\w* \w [here]|strong="H04714"\w* \w [shall be reckoned as]|strong="H01992"\w* mine; \w Ephraim|strong="H00669"\w* \w and Manasseh|strong="H04519"\w* \w shall be|strong="H01961"\w* mine, \w just as Reuben|strong="H07205"\w* \w and Simeon [are mine]|strong="H08095"\w*. \v 6 \w Any children|strong="H04138"\w* \w -|strong="H00834"\w* \w born|strong="H03205"\w* to you \w after them|strong="H00310"\w* \w shall be yours|strong="H01961"\w*, \w and they shall be called|strong="H07121"\w* \w by|strong="H05921"\w* \w the names|strong="H08034"\w* \w of their brothers|strong="H00251"\w* \w in the territory they inherit|strong="H05159"\w*.
\p \v 7 \w Now as for me|strong="H00589"\w*, \w when I was returning|strong="H00935"\w* \w from Paddan|strong="H06307"\w*,\f + \fr 48:7 \ft That is, northwest Mesopotamia\f* \w to my sorrow|strong="H05921"\w* \w Rachel|strong="H07354"\w* \w died|strong="H04191"\w* \w along the way|strong="H01870"\w* \w in the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*, \w . . .|strong="H05750"\w* \w some distance|strong="H03530"\w* \w . . .|strong="H00776"\w* \w . . .|strong="H00935"\w* \w from Ephrath|strong="H00672"\w*. \w So I buried her|strong="H06912"\w* \w there|strong="H08033"\w* \w beside the road|strong="H01870"\w* \w to Ephrath|strong="H00672"\w*” \w (that|strong="H01931"\w* \w [is]|strong="H01035"\w*, \w Bethlehem|strong="H01035"\w*).
\p \v 8 \w When Israel|strong="H03478"\w* \w -|strong="H00853"\w* \w saw|strong="H07200"\w* \w the sons|strong="H01121"\w* \w of Joseph|strong="H03130"\w*, \w he asked|strong="H00559"\w*, “\w Who|strong="H04310"\w* \w are these|strong="H00428"\w*?”
