\p \v 4 \w So Abram|strong="H00087"\w* \w departed|strong="H01980"\w*, \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had directed him|strong="H01696"\w*, \w . . .|strong="H00413"\w* \w and Lot|strong="H03876"\w* \w went|strong="H01980"\w* \w with him|strong="H00854"\w*. \w Abram|strong="H00087"\w* \w was seventy-five|strong="H02568"\w* \w . . .|strong="H07657"\w* \w years|strong="H08141"\w* \w old|strong="H01121"\w* \w . . .|strong="H08141"\w* \w when he left|strong="H03318"\w* \w Haran|strong="H02771"\w*. \v 5 \w And Abram|strong="H00087"\w* \w took|strong="H03947"\w* \w -|strong="H00853"\w* \w his wife|strong="H00802"\w* \w -|strong="H00853"\w* \w Sarai|strong="H08297"\w*, \w his nephew|strong="H01121"\w* \w . . .|strong="H00251"\w* \w -|strong="H00853"\w* \w Lot|strong="H03876"\w*, \w and all|strong="H03605"\w* \w the possessions|strong="H07399"\w* \w -|strong="H00834"\w* \w -|strong="H07408"\w* \w -|strong="H00853"\w* \w and people|strong="H05315"\w* \w -|strong="H00834"\w* \w they had acquired|strong="H06213"\w* \w in Haran|strong="H02771"\w*, \w and set out|strong="H03318"\w* \w . . .|strong="H01980"\w* \w for the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*.
\p \w When they came|strong="H00935"\w* \w to the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*, \v 6 \w Abram|strong="H00087"\w* \w traveled|strong="H05674"\w* \w through the land|strong="H00776"\w* \w as far as|strong="H05704"\w* \w the site|strong="H04725"\w* \w -|strong="H05704"\w* \w of the Oak|strong="H00436"\w*\f + \fr 12:6 \ft Or \fqa Terebinth \ft or \fqa Great Tree\f* \w of Moreh|strong="H04176"\w* \w at Shechem|strong="H07927"\w*. \w And at that time|strong="H00227"\w* \w the Canaanites|strong="H03669"\w* \w were in the land|strong="H00776"\w*.
\p \v 7 \w Then the LORD|strong="H03068"\w* \w appeared|strong="H07200"\w* \w to|strong="H00413"\w* \w Abram|strong="H00087"\w* \w and said|strong="H00559"\w*, “\w I will give|strong="H05414"\w* \w -|strong="H00853"\w* \w this|strong="H02063"\w* \w land|strong="H00776"\w* \w to your offspring|strong="H02233"\w*.\f + \fr 12:7 \ft Cited in Galatians 3:16\f*” \w So [Abram] built|strong="H01129"\w* \w an altar|strong="H04196"\w* \w there|strong="H08033"\w* \w to the LORD|strong="H03068"\w*, \w who had appeared|strong="H07200"\w* \w to him|strong="H00413"\w*.
\p \v 8 \w From there|strong="H08033"\w* \w [Abram] moved on|strong="H06275"\w* \w to the hill country|strong="H02022"\w* \w east|strong="H06924"\w* \w of|strong="H01008"\w* \w Bethel|strong="H01008"\w* \w and pitched|strong="H05186"\w* \w his tent|strong="H00168"\w*, \w with Bethel|strong="H01008"\w* \w . . .|strong="H01008"\w* \w to the west|strong="H03220"\w* \w and Ai|strong="H05857"\w* \w to the east|strong="H06924"\w*. \w There|strong="H08033"\w* \w he built|strong="H01129"\w* \w an altar|strong="H04196"\w* \w to the LORD|strong="H03068"\w*, \w and he called|strong="H07121"\w* \w on the name|strong="H08034"\w* \w of the LORD|strong="H03068"\w*.
\p \v 9 \w And Abram|strong="H00087"\w* \w journeyed on|strong="H05265"\w* \w . . .|strong="H01980"\w* \w toward|strong="H05265"\w* \w the Negev|strong="H05045"\w*.
\s1 Abram and Sarai in Egypt
\p \v 10 \w Now there was|strong="H01961"\w* \w a famine|strong="H07458"\w* \w in the land|strong="H00776"\w*. \w So Abram|strong="H00087"\w* \w went down|strong="H03381"\w* \w to Egypt|strong="H04714"\w* \w to live there|strong="H08033"\w* \w for a while|strong="H01481"\w* \w because|strong="H03588"\w* \w the famine|strong="H07458"\w* \w -|strong="H00776"\w* \w was severe|strong="H03515"\w*. \v 11 \w -|strong="H01961"\w* \w As|strong="H00834"\w* \w he was about|strong="H07126"\w* \w to enter|strong="H00935"\w* \w Egypt|strong="H04714"\w*, \w he said|strong="H00559"\w* \w to|strong="H00413"\w* \w his wife|strong="H00802"\w* \w Sarai|strong="H08297"\w*, “\w Look|strong="H02009"\w*, \w . . .|strong="H04994"\w* \w I know|strong="H03045"\w* \w that|strong="H03588"\w* \w you|strong="H00859"\w* \w [are] a beautiful|strong="H03303"\w* \w . . .|strong="H04758"\w* \w woman|strong="H00802"\w*, \v 12 \w and|strong="H01961"\w* \w when|strong="H03588"\w* \w the Egyptians|strong="H04713"\w* \w see you|strong="H07200"\w*, \w -|strong="H00853"\w* \w they will say|strong="H00559"\w*, ‘\w This|strong="H02063"\w* \w is his wife|strong="H00802"\w*.’ \w Then they will kill|strong="H02026"\w* \w me|strong="H00853"\w* \w but|strong="H00853"\w* \w will let you live|strong="H02421"\w*. \v 13 \w Please|strong="H04994"\w* \w say|strong="H00559"\w* \w you are|strong="H00859"\w* \w my sister|strong="H00269"\w*, \w so that|strong="H04616"\w* \w I will be treated well|strong="H03190"\w* . . . \w for your sake|strong="H05668"\w*, \w and on account of you|strong="H01558"\w* \w my life|strong="H05315"\w* \w will be spared|strong="H02421"\w*.”
\p \v 14 \w So|strong="H01961"\w* \w when Abram|strong="H00087"\w* \w entered|strong="H00935"\w* \w Egypt|strong="H04714"\w*, \w the Egyptians|strong="H04713"\w* \w -|strong="H00853"\w* \w saw|strong="H07200"\w* \w that|strong="H03588"\w* \w the woman|strong="H00802"\w* \w was very|strong="H03966"\w* \w beautiful|strong="H03303"\w*. \w . . .|strong="H01931"\w* \v 15 \w When Pharaoh’s|strong="H06547"\w* \w officials|strong="H08269"\w* \w saw|strong="H07200"\w* \w [Sarai]|strong="H00853"\w*, \w they commended|strong="H01984"\w* \w her|strong="H00853"\w* \w to|strong="H00413"\w* \w [him]|strong="H06547"\w*, \w and she|strong="H00802"\w* \w was taken|strong="H03947"\w* \w into the palace|strong="H01004"\w* \w of Pharaoh|strong="H06547"\w*. \v 16 \w He treated Abram|strong="H00087"\w* \w well|strong="H03190"\w* \w on her account|strong="H05668"\w*, \w and Abram acquired|strong="H01961"\w* - \w sheep|strong="H06629"\w* \w and cattle|strong="H01241"\w*, \w male and female donkeys|strong="H02543"\w* \w . . .|strong="H00860"\w*, \w menservants|strong="H05650"\w* \w and maidservants|strong="H08198"\w*, \w and camels|strong="H01581"\w*.
\p \v 17 \w The LORD, however|strong="H03068"\w*, \w -|strong="H00853"\w* \w afflicted|strong="H05060"\w* \w Pharaoh|strong="H06547"\w* \w and his household|strong="H01004"\w* \w with severe|strong="H01419"\w* \w -|strong="H00853"\w* \w plagues|strong="H05061"\w* \w because of|strong="H05921"\w* \w . . .|strong="H01697"\w* \w Abram’s|strong="H00087"\w* \w wife|strong="H00802"\w* \w Sarai|strong="H08297"\w*. \v 18 \w So Pharaoh|strong="H06547"\w* \w summoned|strong="H07121"\w* \w Abram|strong="H00087"\w* \w and asked|strong="H00559"\w*, “\w What|strong="H04100"\w* \w . . .|strong="H02063"\w* \w have you done|strong="H06213"\w* to me? \w Why|strong="H04100"\w* \w didn’t|strong="H03808"\w* \w you tell|strong="H05046"\w* me \w -|strong="H03588"\w* \w she|strong="H01931"\w* \w was your wife|strong="H00802"\w*? \v 19 \w Why|strong="H04100"\w* \w did you say|strong="H00559"\w*, ‘\w She is|strong="H01931"\w* \w my sister|strong="H00269"\w*,’ \w so that I took|strong="H03947"\w* \w her|strong="H00853"\w* as my \w wife|strong="H00802"\w*? \w Now then|strong="H06258"\w*, \w here|strong="H02009"\w* \w is your wife|strong="H00802"\w*. \w Take her|strong="H03947"\w* \w and go|strong="H01980"\w*!”
\p \v 20 \w Then Pharaoh|strong="H06547"\w* \w gave his men|strong="H00582"\w* \w orders|strong="H06680"\w* \w concerning [Abram]|strong="H05921"\w*, \w and they sent him away|strong="H07971"\w* \w . . .|strong="H00853"\w* \w -|strong="H00853"\w* \w with his wife|strong="H00802"\w* \w -|strong="H00853"\w* \w and all his possessions|strong="H03605"\w* \w -|strong="H00834"\w*.
\c 13
\s1 Abram and Lot Part Ways
\p \v 1 \w So Abram|strong="H00087"\w* \w went up|strong="H05927"\w* \w out of Egypt|strong="H04714"\w* \w into the Negev|strong="H05045"\w*— \w he|strong="H01931"\w* \w and his wife|strong="H00802"\w* \w and all his possessions|strong="H03605"\w* \w . . .|strong="H00834"\w* . . .— \w and Lot [was]|strong="H03876"\w* \w with him|strong="H05973"\w*. \v 2 \w And Abram|strong="H00087"\w* \w had become extremely|strong="H03966"\w* \w wealthy|strong="H03515"\w* \w in livestock|strong="H04735"\w* \w and silver|strong="H03701"\w* \w and gold|strong="H02091"\w*.
\p \v 3 \w From the Negev|strong="H05045"\w* \w he journeyed|strong="H01980"\w* \w from place to place|strong="H04550"\w* \w toward|strong="H01008"\w* \w Bethel|strong="H01008"\w*, \w until he came|strong="H05704"\w* \w to|strong="H05704"\w* \w the place|strong="H04725"\w* \w between|strong="H00996"\w* \w vvv|strong="H01008"\w* \w Bethel|strong="H01008"\w* \w and|strong="H00996"\w* \w Ai|strong="H05857"\w* \w where|strong="H00834"\w* \w his tent|strong="H00168"\w* \w had formerly|strong="H08462"\w* \w been pitched|strong="H01961"\w* \w . . .|strong="H08033"\w*, \v 4 \w to|strong="H00413"\w* \w the site|strong="H04725"\w* \w where|strong="H00834"\w* \w he had built|strong="H06213"\w* \w . . .|strong="H07223"\w* \w the altar|strong="H04196"\w*. \w And there|strong="H08033"\w* \w Abram|strong="H00087"\w* \w called|strong="H07121"\w* \w . . .|strong="H08033"\w* \w on the name|strong="H08034"\w* \w of the LORD|strong="H03068"\w*.
\p \v 5 \w Now Lot|strong="H03876"\w*, \w who was traveling|strong="H01980"\w* \w with|strong="H00854"\w* \w Abram|strong="H00087"\w*, \w also|strong="H01571"\w* \w had|strong="H01961"\w* \w flocks|strong="H06629"\w* \w and herds|strong="H01241"\w* \w and tents|strong="H00168"\w*. \v 6 \w But the land|strong="H00776"\w* \w was unable|strong="H03808"\w* \w to support|strong="H05375"\w* \w [both of] them|strong="H00853"\w* \w while they stayed|strong="H03427"\w* \w together|strong="H03162"\w*, \w for|strong="H03588"\w* \w they had|strong="H01961"\w* \w so many|strong="H07227"\w* \w possessions|strong="H07399"\w* \w that they were unable|strong="H03201"\w* \w . . .|strong="H03808"\w* \w to coexist|strong="H03427"\w* \w . . .|strong="H03162"\w*. \v 7 \w And there was|strong="H01961"\w* \w discord|strong="H07379"\w* \w between|strong="H00996"\w* \w the herdsmen|strong="H07462"\w* \w of Abram|strong="H00087"\w* \w . . .|strong="H00996"\w* \w . . .|strong="H04735"\w* \w and the herdsmen|strong="H07462"\w* \w of Lot|strong="H03876"\w* \w . . .|strong="H04735"\w*. \w At that time|strong="H00227"\w* \w the Canaanites|strong="H03669"\w* \w and the Perizzites|strong="H06522"\w* \w were also living|strong="H03427"\w* \w in the land|strong="H00776"\w*.
\p \v 8 \w So Abram|strong="H00087"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Lot|strong="H03876"\w*, “\w Please|strong="H04994"\w* \w let there be|strong="H01961"\w* \w no|strong="H00408"\w* \w contention|strong="H04808"\w* \w between you and me|strong="H00996"\w*, \w or between|strong="H00996"\w* \w . . .|strong="H00996"\w* \w your herdsmen|strong="H07462"\w* \w . . .|strong="H00996"\w* \w and my herdsmen|strong="H07462"\w*. \w After all|strong="H03588"\w*, \w . . .|strong="H00582"\w* \w we|strong="H00587"\w* \w are kinsmen|strong="H00251"\w*. \v 9 \w Is not|strong="H03808"\w* \w the whole|strong="H03605"\w* \w land|strong="H00776"\w* \w before you|strong="H06440"\w*? \w Now|strong="H04994"\w* \w separate yourself|strong="H06504"\w* \w from me|strong="H05921"\w*. \w If|strong="H00518"\w* \w you go to the left|strong="H08040"\w*, \w I will go to the right|strong="H03231"\w*; \w if|strong="H00518"\w* \w you go to the right|strong="H03225"\w*, \w I will go to the left|strong="H08041"\w*.”
\s1 Lot Proceeds toward Sodom
\p \v 10 \w And Lot|strong="H03876"\w* \w -|strong="H00853"\w* \w looked out|strong="H05375"\w* \w . . .|strong="H05869"\w* \w and saw|strong="H07200"\w* \w -|strong="H00853"\w* \w that the whole|strong="H03605"\w* \w plain|strong="H03603"\w* \w of the Jordan|strong="H03383"\w*, \w . . .|strong="H03588"\w* \w all the way|strong="H00935"\w* \w to Zoar|strong="H06820"\w*, \w was well watered|strong="H04945"\w* \w -|strong="H03605"\w* \w like the garden|strong="H01588"\w* \w of the LORD|strong="H03068"\w*, \w like the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w*. \w (This was before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w destroyed|strong="H07843"\w* \w Sodom|strong="H05467"\w* \w -|strong="H00853"\w* \w and Gomorrah|strong="H06017"\w*.) \v 11 \w So Lot|strong="H03876"\w* \w -|strong="H00853"\w* \w chose|strong="H00977"\w* \w the whole|strong="H03605"\w* \w plain|strong="H03603"\w* \w of the Jordan|strong="H03383"\w* for himself \w [and]|strong="H03876"\w* \w set out|strong="H05265"\w* \w toward the east|strong="H06924"\w*. \w And [Abram and Lot] parted|strong="H06504"\w* \w company|strong="H05921"\w* \w . . .|strong="H00376"\w* \w . . .|strong="H00251"\w*.
\p \v 12 \w Abram|strong="H00087"\w* \w lived|strong="H03427"\w* \w in the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*, \w but Lot|strong="H03876"\w* \w settled|strong="H03427"\w* \w in the cities|strong="H05892"\w* \w of the plain|strong="H03603"\w* \w and pitched [his] tent|strong="H00167"\w* \w toward|strong="H05704"\w* \w Sodom|strong="H05467"\w*. \v 13 \w But the men|strong="H00582"\w* \w of Sodom|strong="H05467"\w* \w were wicked|strong="H07451"\w*, \w sinning|strong="H02400"\w* \w greatly|strong="H03966"\w* \w against the LORD|strong="H03068"\w*.
\s1 God Renews the Promise to Abram
\p \v 14 \w After|strong="H00310"\w* \w Lot|strong="H03876"\w* \w had departed|strong="H06504"\w* \w . . .|strong="H05973"\w*, \w the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Abram|strong="H00087"\w*, “\w Now|strong="H04994"\w* \w lift up|strong="H05375"\w* \w your eyes|strong="H05869"\w* \w from|strong="H04480"\w* \w the place|strong="H04725"\w* \w where|strong="H00834"\w* \w you|strong="H00859"\w* \w are|strong="H08033"\w*, \w and look|strong="H07200"\w* \w to the north|strong="H06828"\w* \w and south|strong="H05045"\w* \w and east|strong="H06924"\w* \w and west|strong="H03220"\w*, \v 15 \w for|strong="H03588"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the land|strong="H00776"\w* \w that|strong="H00834"\w* \w you|strong="H00859"\w* \w see|strong="H07200"\w*, \w I will give|strong="H05414"\w* to you \w and your offspring|strong="H02233"\w* \w forever|strong="H05704"\w* \w . . .|strong="H05769"\w*.\f + \fr 13:15 \ft Cited in Galatians 3:16\f*
\p \v 16 \w I will make|strong="H07760"\w* \w -|strong="H00853"\w* \w your offspring|strong="H02233"\w* \w like the dust|strong="H06083"\w* \w of the earth|strong="H00776"\w*, \w so that|strong="H00834"\w* \w if|strong="H00518"\w* \w one|strong="H00376"\w* \w could|strong="H03201"\w* \w count|strong="H04487"\w* \w -|strong="H00853"\w* \w the dust|strong="H06083"\w* \w of the earth|strong="H00776"\w*, \w then|strong="H01571"\w* \w your offspring|strong="H02233"\w* \w could be counted|strong="H04487"\w*. \v 17 \w Get up|strong="H06965"\w* \w and walk|strong="H01980"\w* \w around the land|strong="H00776"\w*, \w through its length|strong="H00753"\w* \w and breadth|strong="H07341"\w*, \w for|strong="H03588"\w* \w I will give it|strong="H05414"\w* to you.”
