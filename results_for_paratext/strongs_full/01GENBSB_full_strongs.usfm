\p \v 25 \w Then our father|strong="H00001"\w* \w said|strong="H00559"\w*, ‘\w Go back|strong="H07725"\w* \w and buy|strong="H07666"\w* us \w some|strong="H04592"\w* \w food|strong="H00400"\w*.’
\p \v 26 \w But we answered|strong="H00559"\w*, ‘\w We cannot|strong="H03808"\w* \w . . .|strong="H03201"\w* \w go down there|strong="H03381"\w* \w unless|strong="H00518"\w* \w . . .|strong="H03426"\w* \w our younger|strong="H06996"\w* \w brother|strong="H00251"\w* \w goes|strong="H03381"\w* \w . . .|strong="H03588"\w* \w with us|strong="H00854"\w*. \w So if our younger|strong="H06996"\w* \w brother|strong="H00251"\w* \w is not|strong="H00369"\w* \w with us|strong="H00854"\w*, \w we cannot|strong="H03808"\w* \w . . .|strong="H03201"\w* \w see|strong="H07200"\w* \w . . .|strong="H06440"\w* \w the man|strong="H00376"\w*.’
\p \v 27 \w And your servant|strong="H05650"\w* \w my father|strong="H00001"\w* \w said|strong="H00559"\w* \w to us|strong="H00413"\w*, ‘\w You|strong="H00859"\w* \w know|strong="H03045"\w* \w that|strong="H03588"\w* \w my wife|strong="H00802"\w* \w bore|strong="H03205"\w* me \w two sons|strong="H08147"\w*. \v 28 \w When one of them|strong="H00259"\w* \w was gone|strong="H03318"\w* \w . . .|strong="H00854"\w*, \w I said|strong="H00559"\w*: “\w Surely|strong="H00389"\w* \w he has been torn to pieces|strong="H02963"\w* \w . . .|strong="H02963"\w*.” \w And I have not|strong="H03808"\w* \w seen him|strong="H07200"\w* \w . . .|strong="H05704"\w* \w since|strong="H02008"\w*. \v 29 \w -|strong="H00853"\w* \w Now if you also take|strong="H03947"\w* \w -|strong="H01571"\w* \w this one|strong="H02088"\w* \w from|strong="H05973"\w* \w me|strong="H06440"\w* \w and harm|strong="H00611"\w* \w comes to him|strong="H07136"\w*, \w you will bring my gray hair|strong="H07872"\w* \w down|strong="H03381"\w* \w -|strong="H00853"\w* \w to Sheol|strong="H07585"\w* \w in sorrow|strong="H07451"\w*.’
\p \v 30 \w So|strong="H06258"\w* \w if the boy|strong="H05288"\w* \w is not|strong="H00369"\w* \w with us|strong="H00854"\w* \w when I return|strong="H00935"\w* \w to|strong="H00413"\w* \w your servant|strong="H05650"\w*, \w and [if] my father|strong="H00001"\w*, \w whose life|strong="H05315"\w* \w is wrapped up|strong="H07194"\w* \w in the boy’s life|strong="H05315"\w*, \v 31 \w -|strong="H01961"\w* \w sees|strong="H07200"\w* \w that|strong="H03588"\w* \w the boy|strong="H05288"\w* \w [is] not [with us]|strong="H00369"\w*, \w he will die|strong="H04191"\w*. \w Then your servants|strong="H05650"\w* \w -|strong="H00853"\w* \w will have brought the gray hair|strong="H07872"\w* \w of your servant|strong="H05650"\w* \w our father|strong="H00001"\w* \w down|strong="H03381"\w* \w to Sheol|strong="H07585"\w* \w in sorrow|strong="H03015"\w*. \v 32 \w Indeed|strong="H03588"\w*, \w your servant|strong="H05650"\w* \w guaranteed|strong="H06148"\w* \w the boy’s safety|strong="H05288"\w* \w -|strong="H00853"\w* \w to|strong="H05973"\w* \w my father|strong="H00001"\w*, \w saying|strong="H00559"\w*, ‘\w If|strong="H00518"\w* \w I do not|strong="H03808"\w* \w return him|strong="H00935"\w* \w to you|strong="H00413"\w*, \w I will|strong="H03605"\w* \w bear the guilt|strong="H02398"\w* \w before you, my father|strong="H00001"\w*, \w all my life|strong="H03117"\w*.’
\p \v 33 \w Now|strong="H06258"\w* \w please|strong="H04994"\w* \w let your servant|strong="H05650"\w* \w stay here|strong="H03427"\w* \w as my lord’s|strong="H00113"\w* \w . . .|strong="H05288"\w* \w slave|strong="H05650"\w* \w in place of|strong="H08478"\w* \w the boy|strong="H05288"\w*. \w Let him return|strong="H05927"\w* \w with|strong="H05973"\w* \w his brothers|strong="H00251"\w*. \v 34 \w For|strong="H03588"\w* \w how|strong="H00349"\w* \w can I go back|strong="H05927"\w* \w to|strong="H00413"\w* \w my father|strong="H00001"\w* \w without|strong="H00369"\w* \w . . .|strong="H00854"\w* \w the boy|strong="H05288"\w*? \w I could not bear|strong="H06435"\w* \w to see|strong="H07200"\w* \w the misery|strong="H07451"\w* \w that|strong="H00834"\w* \w would overwhelm|strong="H04672"\w* \w -|strong="H00853"\w* \w [him]|strong="H00001"\w*.”
\c 45
\s1 Joseph Reveals His Identity
\p \v 1 \w Then Joseph|strong="H03130"\w* \w could|strong="H03201"\w* \w no longer|strong="H03808"\w* \w control himself|strong="H00662"\w* \w before all|strong="H03605"\w* \w his attendants|strong="H05324"\w*, \w vvv|strong="H05921"\w* \w and he cried out|strong="H07121"\w*, “\w Send everyone|strong="H03605"\w* \w . . .|strong="H00376"\w* \w away|strong="H03318"\w* \w from me|strong="H05921"\w*!”
\p \w So none|strong="H03808"\w* \w [of them] were with|strong="H05975"\w* \w . . .|strong="H00376"\w* \w [Joseph]|strong="H00854"\w* \w when he|strong="H03130"\w* \w made himself known|strong="H03045"\w* \w to|strong="H00413"\w* \w his brothers|strong="H00251"\w*. \v 2 \w But he wept|strong="H01065"\w* \w so loudly|strong="H05414"\w* \w -|strong="H00853"\w* \w -|strong="H06963"\w* \w that the Egyptians|strong="H04713"\w* \w heard him|strong="H08085"\w*, \w and Pharaoh’s|strong="H06547"\w* \w household|strong="H01004"\w* \w [soon] heard of it|strong="H08085"\w*.
\p \v 3 \w Joseph|strong="H03130"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w his brothers|strong="H00251"\w*, “\w I|strong="H00589"\w* \w am Joseph|strong="H03130"\w*! \w Is my father|strong="H00001"\w* \w still|strong="H05750"\w* \w alive|strong="H02416"\w*?”
\p \w But they|strong="H00251"\w* \w were unable|strong="H03808"\w* \w . . .|strong="H03201"\w* \w to answer|strong="H06030"\w* \w him|strong="H00853"\w*, \w because|strong="H03588"\w* \w they were terrified|strong="H00926"\w* \w in his presence|strong="H06440"\w*.
\p \v 4 \w Then Joseph|strong="H03130"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w his brothers|strong="H00251"\w*, “\w Please|strong="H04994"\w* \w . . .|strong="H00413"\w* \w come near me|strong="H05066"\w*.” \w And they [did so]|strong="H05066"\w*.
\p “\w I|strong="H00589"\w* \w am Joseph|strong="H03130"\w*, \w your brother|strong="H00251"\w*,” \w he said|strong="H00559"\w*, “\w the one|strong="H00834"\w* \w you sold|strong="H04376"\w* \w -|strong="H00853"\w* \w into Egypt|strong="H04714"\w*! \v 5 \w And now|strong="H06258"\w*, \w do not|strong="H00408"\w* \w be distressed|strong="H06087"\w* \w . . .|strong="H00408"\w* \w or angry|strong="H02734"\w* \w with yourselves|strong="H05869"\w* \w that|strong="H03588"\w* \w you sold|strong="H04376"\w* \w me|strong="H00853"\w* \w into this place|strong="H02008"\w*, \w because|strong="H03588"\w* \w it was to save lives|strong="H04241"\w* \w that God|strong="H00430"\w* \w sent me|strong="H07971"\w* \w before you|strong="H06440"\w*. \v 6 \w For|strong="H03588"\w* \w the famine|strong="H07458"\w* \w has covered|strong="H07130"\w* \w the land|strong="H00776"\w* \w these|strong="H02088"\w* \w two years|strong="H08141"\w*, \w and there will be five|strong="H02568"\w* \w more|strong="H05750"\w* \w years|strong="H08141"\w* \w -|strong="H00834"\w* \w without|strong="H00369"\w* \w plowing|strong="H02758"\w* \w or harvesting|strong="H07105"\w*. \v 7 \w God|strong="H00430"\w* \w sent me|strong="H07971"\w* \w before you|strong="H06440"\w* \w to preserve|strong="H07760"\w* you \w as a remnant|strong="H07611"\w* \w on the earth|strong="H00776"\w* \w and to save your lives|strong="H02421"\w* . . . \w by a great|strong="H01419"\w* \w deliverance|strong="H06413"\w*.\f + \fr 45:7 \ft Or \fqa and to keep you alive as a great band of survivors\f* \v 8 \w Therefore|strong="H06258"\w* \w it was not|strong="H03808"\w* \w you|strong="H00859"\w* \w who sent|strong="H07971"\w* \w me|strong="H00853"\w* \w here|strong="H02008"\w*, \w but|strong="H03588"\w* \w God|strong="H00430"\w*, \w who has made me|strong="H07760"\w* \w a father|strong="H00001"\w* \w to Pharaoh|strong="H06547"\w* — \w lord|strong="H00113"\w* \w of all|strong="H03605"\w* \w his household|strong="H01004"\w* \w and ruler|strong="H04910"\w* \w over all|strong="H03605"\w* \w the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w*.
\s1 Joseph Sends for His Father
\p \v 9 \w Now return|strong="H05927"\w* \w quickly|strong="H04116"\w* \w to|strong="H00413"\w* \w my father|strong="H00001"\w* \w and tell|strong="H00559"\w* \w him|strong="H00413"\w*, ‘\w This is what|strong="H03541"\w* \w your son|strong="H01121"\w* \w Joseph|strong="H03130"\w* \w says|strong="H00559"\w*: \w God|strong="H00430"\w* \w has made me|strong="H07760"\w* \w lord|strong="H00113"\w* \w of all|strong="H03605"\w* \w Egypt|strong="H04714"\w*. \w Come down|strong="H03381"\w* \w to me|strong="H00413"\w* \w without|strong="H00408"\w* \w delay|strong="H05975"\w*. \v 10 \w You shall settle|strong="H03427"\w* \w in the land|strong="H00776"\w* \w of Goshen|strong="H01657"\w* \w and be|strong="H01961"\w* \w near me|strong="H07138"\w*— \w . . .|strong="H00413"\w* \w you|strong="H00859"\w* \w and your children|strong="H01121"\w* \w and grandchildren|strong="H01121"\w* \w . . .|strong="H01121"\w*, \w your flocks|strong="H06629"\w* \w and herds|strong="H01241"\w*, \w and everything you own|strong="H03605"\w* \w -|strong="H00834"\w*. \v 11 \w And there|strong="H08033"\w* \w I will provide|strong="H03557"\w* \w for you|strong="H00853"\w*, \w because|strong="H03588"\w* \w there will be five|strong="H02568"\w* \w more|strong="H05750"\w* \w years|strong="H08141"\w* \w of famine|strong="H07458"\w*. \w Otherwise|strong="H06435"\w*, \w you|strong="H00859"\w* \w and your household|strong="H01004"\w* \w and everything|strong="H03605"\w* \w -|strong="H00834"\w* you own \w will come to destitution|strong="H03423"\w*.’
