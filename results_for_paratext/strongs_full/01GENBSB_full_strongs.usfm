\p \v 15 \w And the angel|strong="H04397"\w* \w of the LORD|strong="H03068"\w* \w called|strong="H07121"\w* \w to|strong="H00413"\w* \w Abraham|strong="H00085"\w* \w from|strong="H04480"\w* \w heaven|strong="H08064"\w* \w a second time|strong="H08145"\w*, \v 16 \w saying|strong="H00559"\w*, “By Myself \w I have sworn|strong="H07650"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, \w that|strong="H03588"\w* \w because|strong="H03282"\w* \w -|strong="H00834"\w* \w you have done|strong="H06213"\w* \w -|strong="H00853"\w* \w this|strong="H02088"\w* \w . . .|strong="H01697"\w* \w and have not|strong="H03808"\w* \w withheld|strong="H02820"\w* \w -|strong="H00853"\w* \w your only|strong="H03173"\w* \w son|strong="H01121"\w*, \w -|strong="H00853"\w* \v 17 \w -|strong="H03588"\w* \w I will surely bless you|strong="H01288"\w* \w . . .|strong="H01288"\w*, \w and I will multiply|strong="H07235"\w* \w . . .|strong="H07235"\w* \w -|strong="H00853"\w* \w your descendants|strong="H02233"\w*\f + \fr 22:17 \ft Cited in Hebrews 6:14\f* \w like the stars|strong="H03556"\w* \w in the sky|strong="H08064"\w* \w and the sand|strong="H02344"\w* \w -|strong="H00834"\w* \w on|strong="H05921"\w* \w the seashore|strong="H08193"\w* \w . . .|strong="H03220"\w*. \w Your descendants|strong="H02233"\w* \w -|strong="H00853"\w* \w will possess|strong="H03423"\w* \w the gates|strong="H08179"\w* \w of their enemies|strong="H00341"\w*. \v 18 \w And through your offspring|strong="H02233"\w* \w all|strong="H03605"\w* \w nations|strong="H01471"\w* \w of the earth|strong="H00776"\w* \w will be blessed|strong="H01288"\w*,\f + \fr 22:18 \ft Cited in Acts 3:25\f* \w because|strong="H06118"\w* \w -|strong="H00834"\w* \w you have obeyed|strong="H08085"\w* \w My voice|strong="H06963"\w*.”
