\c 9
\s1 The Covenant of the Rainbow
\p \v 1 \w And God|strong="H00430"\w* \w -|strong="H00853"\w* \w blessed|strong="H01288"\w* \w Noah|strong="H05146"\w* \w -|strong="H00853"\w* \w and his sons|strong="H01121"\w* \w and said|strong="H00559"\w* to them, “\w Be fruitful|strong="H06509"\w* \w and multiply|strong="H07235"\w* \w and fill|strong="H04390"\w* \w -|strong="H00853"\w* \w the earth|strong="H00776"\w*. \v 2 \w The fear|strong="H04172"\w* \w and dread of you|strong="H02844"\w* \w will fall|strong="H01961"\w* \w on|strong="H05921"\w* \w every|strong="H03605"\w* \w living creature|strong="H02416"\w* \w on the earth|strong="H00776"\w*, \w . . .|strong="H05921"\w* \w every|strong="H03605"\w* \w bird|strong="H05775"\w* \w of the air|strong="H08064"\w*, \w every|strong="H03605"\w* \w creature that|strong="H00834"\w* \w crawls|strong="H07430"\w* \w on the ground|strong="H00127"\w*, \w and all|strong="H03605"\w* \w the fish|strong="H01709"\w* \w of the sea|strong="H03220"\w*. \w They are delivered|strong="H05414"\w* \w into your hand|strong="H03027"\w*. \v 3 \w Everything|strong="H03605"\w* \w that lives|strong="H02416"\w* \w [and] moves|strong="H07431"\w* \w -|strong="H00834"\w* \w -|strong="H01931"\w* \w will be|strong="H01961"\w* \w food|strong="H00402"\w* for you; \w just as I gave you the green|strong="H03418"\w* \w plants|strong="H06212"\w*, \w I now give|strong="H05414"\w* you \w -|strong="H00853"\w* \w all things|strong="H03605"\w*. \v 4 \w But|strong="H00389"\w* \w you must not|strong="H03808"\w* \w eat|strong="H00398"\w* \w meat|strong="H01320"\w* \w with its lifeblood|strong="H05315"\w* \w [still] in it|strong="H01818"\w*. \v 5 \w And surely|strong="H00389"\w* \w -|strong="H00853"\w* \w I will require|strong="H01875"\w* \w . . .|strong="H03027"\w* \w the life of any|strong="H03605"\w* \w man|strong="H00120"\w* \w or beast|strong="H02416"\w* \w -|strong="H01875"\w* \w -|strong="H03027"\w* \w by whose hand|strong="H03027"\w* \w your lifeblood [is shed]|strong="H05315"\w* \w . . .|strong="H01818"\w*. \w I will demand an accounting|strong="H01875"\w* \w -|strong="H00853"\w* \w from anyone|strong="H00120"\w* \w [who takes] the life|strong="H05315"\w* \w of his fellow man|strong="H00376"\w* \w . . .|strong="H00251"\w*:
\b 
\q1 \v 6 \w Whoever sheds|strong="H08210"\w* \w the blood|strong="H01818"\w* \w of man|strong="H00120"\w*,
\q2 \w by man|strong="H00120"\w* \w his blood|strong="H01818"\w* \w will be shed|strong="H08210"\w*;
\q1 \w for|strong="H03588"\w* \w in His own|strong="H00430"\w* \w image|strong="H06754"\w*
\q2 \w God has made|strong="H06213"\w* \w -|strong="H00853"\w* \w mankind|strong="H00120"\w*.
\q1 \v 7 \w But as for you|strong="H00859"\w*,
\q2 \w be fruitful|strong="H06509"\w* \w and multiply|strong="H07235"\w*;
\q1 \w spread out|strong="H08317"\w* \w across the earth|strong="H00776"\w*
\q2 \w and multiply|strong="H07235"\w* upon it.”
\p \v 8 \w Then God|strong="H00430"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Noah|strong="H05146"\w* \w . . .|strong="H00413"\w* \w and his sons|strong="H01121"\w* \w with him|strong="H00854"\w*, \w . . .|strong="H00559"\w* \v 9 “\w Behold|strong="H02005"\w*, \w I now|strong="H00589"\w* \w establish|strong="H06965"\w* \w -|strong="H00853"\w* \w My covenant|strong="H01285"\w* \w with you|strong="H00854"\w* \w and your|strong="H00854"\w* \w descendants|strong="H02233"\w* \w after you|strong="H00310"\w*, \v 10 \w and with|strong="H00854"\w* \w every|strong="H03605"\w* \w living|strong="H02416"\w* \w creature|strong="H05315"\w* \w that|strong="H00834"\w* \w [was] with you|strong="H00854"\w* — \w the birds|strong="H05775"\w*, \w the livestock|strong="H00929"\w*, \w and every|strong="H03605"\w* \w beast|strong="H02416"\w* \w of the earth|strong="H00776"\w* \w -|strong="H00854"\w*— \w every|strong="H03605"\w* \w living thing|strong="H02416"\w* \w . . .|strong="H00776"\w* \w that came out|strong="H03318"\w* \w of the ark|strong="H08392"\w* \w . . .|strong="H03605"\w*. \v 11 \w And I establish|strong="H06965"\w* \w -|strong="H00853"\w* \w My covenant|strong="H01285"\w* \w with you|strong="H00854"\w*: \w Never|strong="H03808"\w* \w again|strong="H05750"\w* \w will all|strong="H03605"\w* \w life|strong="H01320"\w* \w be cut off|strong="H03772"\w* \w by the waters|strong="H04325"\w* \w of a flood|strong="H03999"\w*; \w never|strong="H03808"\w* \w again|strong="H05750"\w* \w will there be|strong="H01961"\w* \w a flood|strong="H03999"\w* \w to destroy|strong="H07843"\w* \w the earth|strong="H00776"\w*.”
\p \v 12 \w And God|strong="H00430"\w* \w said|strong="H00559"\w*, “\w This|strong="H02063"\w* \w is the sign|strong="H00226"\w* \w of the covenant|strong="H01285"\w* \w -|strong="H00834"\w* \w I|strong="H00589"\w* \w am making|strong="H05414"\w* \w between Me|strong="H00996"\w* \w and you|strong="H00996"\w* \w and|strong="H00996"\w* \w every|strong="H03605"\w* \w living|strong="H02416"\w* \w -|strong="H00834"\w* \w creature|strong="H05315"\w* \w with you|strong="H00854"\w*, \w [a covenant] for all generations|strong="H01755"\w* \w to come|strong="H05769"\w*: \v 13 \w -|strong="H00853"\w* \w I have set|strong="H05414"\w* \w My rainbow|strong="H07198"\w* \w in the clouds|strong="H06051"\w*, \w and it will be|strong="H01961"\w* \w a sign|strong="H00226"\w* \w of the covenant|strong="H01285"\w* \w between|strong="H00996"\w* \w Me|strong="H00996"\w* \w and the earth|strong="H00776"\w*.
\p \v 14 \w -|strong="H01961"\w* \w Whenever I form|strong="H06049"\w* \w clouds|strong="H06051"\w* \w over|strong="H05921"\w* \w the earth|strong="H00776"\w* \w and the rainbow|strong="H07198"\w* \w appears|strong="H07200"\w* \w in the clouds|strong="H06051"\w*, \v 15 \w I will remember|strong="H02142"\w* \w -|strong="H00853"\w* \w My covenant|strong="H01285"\w* \w -|strong="H00834"\w* \w between Me|strong="H00996"\w* \w and you|strong="H00996"\w* \w and|strong="H00996"\w* \w every|strong="H03605"\w* \w living|strong="H02416"\w* \w creature|strong="H05315"\w* \w of every|strong="H03605"\w* \w kind|strong="H01320"\w*. \w Never|strong="H03808"\w* \w again|strong="H05750"\w* \w will the waters|strong="H04325"\w* \w become|strong="H01961"\w* \w a flood|strong="H03999"\w* \w to destroy|strong="H07843"\w* \w all|strong="H03605"\w* \w life|strong="H01320"\w*. \v 16 \w And whenever the rainbow|strong="H07198"\w* \w appears|strong="H01961"\w* \w in the clouds|strong="H06051"\w*, \w I will see it|strong="H07200"\w* \w and remember|strong="H02142"\w* \w the everlasting|strong="H05769"\w* \w covenant|strong="H01285"\w* \w between|strong="H00996"\w* \w God|strong="H00430"\w* \w and|strong="H00996"\w* \w every|strong="H03605"\w* \w living|strong="H02416"\w* \w creature|strong="H05315"\w* \w of every|strong="H03605"\w* \w kind|strong="H01320"\w* \w that [is]|strong="H00834"\w* \w on|strong="H05921"\w* \w the earth|strong="H00776"\w*.”
\p \v 17 \w So God|strong="H00430"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Noah|strong="H05146"\w*, “\w This|strong="H02063"\w* \w is the sign|strong="H00226"\w* \w of the covenant|strong="H01285"\w* \w that|strong="H00834"\w* \w I have established|strong="H06965"\w* \w between|strong="H00996"\w* \w Me|strong="H00996"\w* \w and every|strong="H03605"\w* \w creature|strong="H01320"\w* \w -|strong="H00834"\w* \w on|strong="H05921"\w* \w the earth|strong="H00776"\w*.”
\s1 Noah’s Shame and Canaan’s Curse
\p \v 18 \w The sons|strong="H01121"\w* \w of Noah|strong="H05146"\w* \w who came out|strong="H03318"\w* \w of|strong="H04480"\w* \w the ark|strong="H08392"\w* \w were|strong="H01961"\w* \w Shem|strong="H08035"\w*, \w Ham|strong="H02526"\w*, \w and Japheth|strong="H03315"\w*. \w And Ham|strong="H02526"\w* \w . . .|strong="H01931"\w* \w was the father|strong="H00001"\w* \w of Canaan|strong="H03667"\w*. \v 19 \w These|strong="H00428"\w* \w three|strong="H07969"\w* \w were the sons|strong="H01121"\w* \w of Noah|strong="H05146"\w*, \w and from them|strong="H00428"\w* \w the whole|strong="H03605"\w* \w earth|strong="H00776"\w* \w was populated|strong="H05310"\w*.
\p \v 20 \w Now Noah|strong="H05146"\w*, \w a man|strong="H00376"\w* \w of the soil|strong="H00127"\w*, \w proceeded|strong="H02490"\w*\f + \fr 9:20 \ft Or \fqa was the first\f* \w to plant|strong="H05193"\w* \w a vineyard|strong="H03754"\w*. \v 21 \w But when he drank|strong="H08354"\w* \w some of|strong="H04480"\w* \w its wine|strong="H03196"\w*, \w he became drunk|strong="H07937"\w* \w and uncovered himself|strong="H01540"\w* \w inside|strong="H08432"\w* \w his tent|strong="H00168"\w*. \v 22 \w And Ham|strong="H02526"\w*, \w the father|strong="H00001"\w* \w of Canaan|strong="H03667"\w*, \w -|strong="H00853"\w* \w saw|strong="H07200"\w* \w his father’s|strong="H00001"\w* \w nakedness|strong="H06172"\w* \w and told|strong="H05046"\w* \w his two|strong="H08147"\w* \w brothers|strong="H00251"\w* \w outside|strong="H02351"\w*.
\p \v 23 \w Then Shem|strong="H08035"\w* \w and Japheth|strong="H03315"\w* \w -|strong="H00853"\w* \w took|strong="H03947"\w* \w a garment|strong="H08071"\w* \w and placed|strong="H07760"\w* \w it across|strong="H05921"\w* \w . . .|strong="H08147"\w* \w their shoulders|strong="H07926"\w*, \w and walking|strong="H01980"\w* \w backward|strong="H00322"\w*, \w they covered|strong="H03680"\w* \w -|strong="H00853"\w* \w their father’s|strong="H00001"\w* \w nakedness|strong="H06172"\w*. \w Their faces|strong="H06440"\w* \w were turned away|strong="H00322"\w* \w so that they did not|strong="H03808"\w* \w see|strong="H07200"\w* \w their father’s|strong="H00001"\w* \w nakedness|strong="H06172"\w*.
\p \v 24 \w When Noah|strong="H05146"\w* \w awoke|strong="H03364"\w* \w from his drunkenness|strong="H03196"\w* \w and learned|strong="H03045"\w* \w -|strong="H00853"\w* \w what|strong="H00834"\w* \w his youngest|strong="H06996"\w* \w son|strong="H01121"\w* \w had done|strong="H06213"\w* to him, \v 25 \w he said|strong="H00559"\w*,
\b 
\q1 “\w Cursed be|strong="H00779"\w* \w Canaan|strong="H03667"\w*!
