\p \v 21 \w Then Israel|strong="H03478"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Joseph|strong="H03130"\w*, “\w Look|strong="H02009"\w*, \w I|strong="H00595"\w* \w am about to die|strong="H04191"\w*, \w but God|strong="H00430"\w* \w will be|strong="H01961"\w* \w with you|strong="H05973"\w* \w and bring|strong="H07725"\w* \w you|strong="H00853"\w* \w back to|strong="H00413"\w* \w the land|strong="H00776"\w* \w of your fathers|strong="H00001"\w*. \v 22 And to you, \w as one who is above|strong="H05921"\w* \w your brothers|strong="H00251"\w*, \w I|strong="H00589"\w* \w give|strong="H05414"\w* \w the|strong="H00259"\w* \w ridge of land|strong="H07926"\w*\f + \fr 48:22 \ft Or \fqa one portion of the land\ft ; Hebrew \fqa shekem\ft , which sounds like the town and district called \fqa Shechem\f* \w that|strong="H00834"\w* \w I took|strong="H03947"\w* \w from|strong="H03027"\w* \w the Amorites|strong="H00567"\w* \w with my sword|strong="H02719"\w* \w and bow|strong="H07198"\w*.”
\c 49
\s1 Jacob Blesses His Sons
\p \v 1 \w Then Jacob|strong="H03290"\w* \w . . .|strong="H00413"\w* \w called for|strong="H07121"\w* \w his sons|strong="H01121"\w* \w and said|strong="H00559"\w*, “\w Gather around|strong="H00622"\w* \w so that I can tell|strong="H05046"\w* you\w . . .|strong="H00853"\w* \w what|strong="H00834"\w* \w will happen|strong="H07122"\w* \w to you|strong="H00853"\w* \w in the days|strong="H03117"\w* \w to come|strong="H00319"\w*:
\b 
\q1 \v 2 \w Come together|strong="H06908"\w* \w and listen|strong="H08085"\w*, \w O sons|strong="H01121"\w* \w of Jacob|strong="H03290"\w*;
\q2 \w listen|strong="H08085"\w* \w to|strong="H00413"\w* \w your father|strong="H00001"\w* \w Israel|strong="H03478"\w*.
\b 
\q1 \v 3 \w Reuben|strong="H07205"\w*, \w you|strong="H00859"\w* \w are my firstborn|strong="H01060"\w*, \w my might|strong="H03581"\w*,
\q2 \w and the beginning|strong="H07225"\w* \w of my strength|strong="H00202"\w*,
\q1 \w excelling|strong="H03499"\w* \w in honor|strong="H07613"\w*,
\q2 \w excelling|strong="H03499"\w* \w in power|strong="H05794"\w*.
\q1 \v 4 \w Uncontrolled|strong="H06349"\w* \w as the waters|strong="H04325"\w*,
\q2 \w you will no|strong="H00408"\w* \w longer excel|strong="H03498"\w*,
\q1 \w because|strong="H03588"\w* \w you went up|strong="H05927"\w* \w to your father’s|strong="H00001"\w* \w bed|strong="H04904"\w*,
\q2 \w onto|strong="H05927"\w* \w my couch|strong="H03326"\w*, \w and|strong="H00227"\w* \w defiled it|strong="H02490"\w*.
\b 
\q1 \v 5 \w Simeon|strong="H08095"\w* \w and Levi|strong="H03878"\w* \w are brothers|strong="H00251"\w*;
\q2 \w their swords|strong="H04380"\w*\f + \fr 49:5 \ft Or \fqa dwelling places\f* \w are weapons|strong="H03627"\w* \w of violence|strong="H02555"\w*.
