\c 15
\s1 God’s Covenant with Abram
\p \v 1 \w After|strong="H00310"\w* \w these|strong="H00428"\w* \w events|strong="H01697"\w*, \w the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w came|strong="H01961"\w* \w to|strong="H00413"\w* \w Abram|strong="H00087"\w* \w in a vision|strong="H04236"\w*: \w . . .|strong="H00559"\w*
