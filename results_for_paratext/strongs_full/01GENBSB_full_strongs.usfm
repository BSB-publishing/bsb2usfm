\p \v 1 \w So Joseph|strong="H03130"\w* \w went|strong="H00935"\w* \w and told|strong="H05046"\w* \w Pharaoh|strong="H06547"\w* \w . . .|strong="H00559"\w*: “\w My father|strong="H00001"\w* \w and my brothers|strong="H00251"\w*, \w with their flocks|strong="H06629"\w* \w and herds|strong="H01241"\w* \w and all|strong="H03605"\w* \w they own|strong="H00834"\w*, \w have come|strong="H00935"\w* \w from the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w* \w and are now|strong="H02005"\w* \w vvv|strong="H00776"\w* \w in Goshen|strong="H01657"\w*.”
