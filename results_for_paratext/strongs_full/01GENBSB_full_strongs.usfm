\c 17
\s1 Abraham to Father Many Nations
\p \v 1 \w When Abram|strong="H00087"\w* \w was|strong="H01961"\w* \w ninety-nine|strong="H08673"\w* \w . . .|strong="H08672"\w* \w years|strong="H08141"\w* \w old|strong="H01121"\w* \w . . .|strong="H08141"\w*, \w the LORD|strong="H03068"\w* \w appeared|strong="H07200"\w* \w to|strong="H00413"\w* \w him|strong="H00087"\w* \w and said|strong="H00559"\w*, \w . . .|strong="H00413"\w* “\w I|strong="H00589"\w* \w am God|strong="H00410"\w* \w Almighty|strong="H07706"\w*.\f + \fr 17:1 \ft Hebrew \fqa El-Shaddai\f* \w Walk|strong="H01980"\w* \w before Me|strong="H06440"\w* \w and be|strong="H01961"\w* \w blameless|strong="H08549"\w*. \v 2 \w I will establish|strong="H05414"\w* \w My covenant|strong="H01285"\w* \w between Me and you|strong="H00996"\w*, \w . . .|strong="H00996"\w* \w and I will multiply|strong="H07235"\w* \w you|strong="H00853"\w* \w exceedingly|strong="H03966"\w* \w . . .|strong="H03966"\w*.”
\p \v 3 \w Then Abram|strong="H00087"\w* \w fell facedown|strong="H05307"\w* \w . . .|strong="H05921"\w* \w . . .|strong="H06440"\w*, \w and God|strong="H00430"\w* \w . . .|strong="H00559"\w* \w said|strong="H01696"\w* \w to him|strong="H00854"\w*, \v 4 “\w As for Me|strong="H00589"\w*, \w this is|strong="H02009"\w* \w My covenant|strong="H01285"\w* \w with you|strong="H00854"\w*: \w You will be|strong="H01961"\w* \w the father|strong="H00001"\w* \w of many|strong="H01995"\w* \w nations|strong="H01471"\w*. \v 5 \w No|strong="H03808"\w* \w longer {will}|strong="H05750"\w* \w -|strong="H00853"\w* \w you be called|strong="H07121"\w* \w -|strong="H08034"\w* \w Abram|strong="H00087"\w*,\f + \fr 17:5 \fqa Abram \ft means \fqa exalted father\ft .\f* \w but your name|strong="H08034"\w* \w will be|strong="H01961"\w* \w Abraham|strong="H00085"\w*,\f + \fr 17:5 \fqa Abraham \ft means \fqa father of many\ft .\f* \w for|strong="H03588"\w* \w I have made you|strong="H05414"\w* \w a father|strong="H00001"\w* \w of many|strong="H01995"\w* \w nations|strong="H01471"\w*.\f + \fr 17:5 \ft Cited in Romans 4:17\f*
\p \v 6 \w I will make you exceedingly|strong="H03966"\w* \w . . .|strong="H03966"\w* \w -|strong="H00853"\w* \w fruitful|strong="H06509"\w*; \w I will make|strong="H05414"\w* \w nations [of you]|strong="H01471"\w*, \w and kings|strong="H04428"\w* \w will descend|strong="H03318"\w* \w from you|strong="H04480"\w*.
\p \v 7 \w I will establish|strong="H06965"\w* \w -|strong="H00853"\w* \w My covenant|strong="H01285"\w* \w as an everlasting|strong="H05769"\w* \w covenant|strong="H01285"\w* \w between Me and you|strong="H00996"\w* \w . . .|strong="H00996"\w* \w . . .|strong="H00996"\w* \w and your descendants|strong="H00310"\w* \w . . .|strong="H01755"\w* \w after you|strong="H02233"\w*, \w to be|strong="H01961"\w* your \w God|strong="H00430"\w* \w and the God of your descendants|strong="H02233"\w* \w after you|strong="H00310"\w*.
\p \v 8 And to you \w and your descendants|strong="H02233"\w*\w . . .|strong="H00310"\w* \w -|strong="H00853"\w* \w I will give|strong="H05414"\w* \w the land|strong="H00776"\w* \w where you are residing|strong="H04033"\w*— \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*— \w as an eternal|strong="H05769"\w* \w possession|strong="H00272"\w*; \w and I will be|strong="H01961"\w* their \w God|strong="H00430"\w*.”
\s1 The Covenant of Circumcision
\p \v 9 \w God|strong="H00430"\w* \w also said|strong="H00559"\w* \w to|strong="H00413"\w* \w Abraham|strong="H00085"\w*, “\w You|strong="H00859"\w* \w -|strong="H00853"\w* \w must keep|strong="H08104"\w* \w My covenant|strong="H01285"\w*— \w you|strong="H00859"\w* \w and your descendants|strong="H02233"\w* \w in the generations|strong="H01755"\w* \w after you|strong="H00310"\w*. \v 10 \w This|strong="H02063"\w* \w is My covenant|strong="H01285"\w* \w with|strong="H00996"\w* \w . . .|strong="H00996"\w* \w . . .|strong="H00996"\w* \w you and your descendants|strong="H02233"\w* \w after you|strong="H00310"\w*, \w which|strong="H00834"\w* \w you are to keep|strong="H08104"\w*: \w Every|strong="H03605"\w* \w male among you|strong="H02145"\w* \w must be circumcised|strong="H04135"\w*. \v 11 \w You are to circumcise|strong="H04135"\w* \w -|strong="H00853"\w* \w the flesh|strong="H01320"\w* \w of your foreskin|strong="H06190"\w*, \w and this will be|strong="H01961"\w* \w a sign|strong="H00226"\w* \w of the covenant|strong="H01285"\w* \w between Me and you|strong="H00996"\w*. \w . . .|strong="H00996"\w*
\p \v 12 \w Generation after generation|strong="H01755"\w*, \w every|strong="H03605"\w* \w male|strong="H02145"\w* - \w must be circumcised|strong="H04135"\w* \w -|strong="H01121"\w* \w when he is eight|strong="H08083"\w* \w days old|strong="H03117"\w*, \w including those born|strong="H03211"\w* \w in your household|strong="H01004"\w* \w and those purchased|strong="H04736"\w* \w . . .|strong="H03701"\w* \w from a|strong="H03605"\w* \w . . .|strong="H01121"\w* \w foreigner|strong="H05236"\w* — \w even those|strong="H01931"\w* \w who|strong="H00834"\w* \w are not|strong="H03808"\w* \w your offspring|strong="H02233"\w*. \v 13 \w Whether they are born|strong="H03211"\w* \w in your household|strong="H01004"\w* \w or purchased|strong="H04736"\w* \w . . .|strong="H03701"\w*, \w they must be circumcised|strong="H04135"\w* \w . . .|strong="H04135"\w*. \w My covenant|strong="H01285"\w* \w in your flesh|strong="H01320"\w* \w will be|strong="H01961"\w* \w an everlasting|strong="H05769"\w* \w covenant|strong="H01285"\w*.
