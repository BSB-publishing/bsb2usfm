\p \v 28 \w After|strong="H00310"\w* \w the flood|strong="H03999"\w*, \w Noah|strong="H05146"\w* \w lived|strong="H02421"\w* \w 350|strong="H07969"\w* \w . . .|strong="H03967"\w* \w . . .|strong="H02572"\w* \w years|strong="H08141"\w* \w . . .|strong="H08141"\w*. \v 29 \w So Noah|strong="H05146"\w* \w lived|strong="H03117"\w* \w a total of|strong="H01961"\w* \w . . .|strong="H03605"\w* \w 950|strong="H08672"\w* \w . . .|strong="H03967"\w* \w . . .|strong="H02572"\w* \w . . .|strong="H08141"\w* \w years|strong="H08141"\w*, \w and then he died|strong="H04191"\w*.
\c 10
\s1 The Table of Nations
\p \v 1 \w This|strong="H00428"\w* \w is the account|strong="H08435"\w* \w of Noah’s|strong="H05146"\w* \w sons|strong="H01121"\w* \w Shem|strong="H08035"\w*, \w Ham|strong="H02526"\w*, \w and Japheth|strong="H03315"\w*, \w . . .|strong="H03205"\w* who also \w had sons|strong="H01121"\w* \w after|strong="H00310"\w* \w the flood|strong="H03999"\w*.
\s2 The Japhethites
\p \v 2 \w The sons|strong="H01121"\w* \w of Japheth|strong="H03315"\w*:
\p \w Gomer|strong="H01586"\w*, \w Magog|strong="H04031"\w*, \w Madai|strong="H04074"\w*, \w Javan|strong="H03120"\w*, \w Tubal|strong="H08422"\w*, \w Meshech|strong="H04902"\w*, \w and Tiras|strong="H08494"\w*.
