\p \v 29 \w When they reached|strong="H00935"\w* \w . . .|strong="H00413"\w* \w their father|strong="H00001"\w* \w Jacob|strong="H03290"\w* \w in the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*, \w they described|strong="H05046"\w* to \w him|strong="H00853"\w* \w all|strong="H03605"\w* \w that had happened to them|strong="H07136"\w* \w -|strong="H00853"\w* \w -|strong="H00559"\w*: \v 30 “\w The man|strong="H00376"\w* \w who is lord|strong="H00113"\w* \w of the land|strong="H00776"\w* \w spoke|strong="H01696"\w* \w harshly|strong="H07186"\w* \w . . .|strong="H05414"\w* \w -|strong="H00853"\w* \w to us|strong="H00854"\w* \w and accused us of spying|strong="H07270"\w* \w -|strong="H00853"\w* \w on the country|strong="H00776"\w*.
\p \v 31 \w But we told|strong="H00559"\w* \w him|strong="H00413"\w*, ‘\w We|strong="H00587"\w* \w are|strong="H01961"\w* \w honest men|strong="H03651"\w*, \w not|strong="H03808"\w* \w spies|strong="H07270"\w*. \v 32 \w We|strong="H00587"\w* \w are twelve|strong="H08147"\w* \w . . .|strong="H06240"\w* \w brothers|strong="H00251"\w*, \w sons|strong="H01121"\w* \w of one father|strong="H00001"\w*. \w One|strong="H00259"\w* \w is no more|strong="H00369"\w*, \w and the youngest|strong="H06996"\w* \w is now|strong="H03117"\w* \w with|strong="H00854"\w* \w our father|strong="H00001"\w* \w in the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*.’
\p \v 33 \w Then the man|strong="H00376"\w* \w who is lord|strong="H00113"\w* \w of the land|strong="H00776"\w* \w said|strong="H00559"\w* \w to us|strong="H00413"\w*, ‘\w This is how|strong="H02063"\w* \w I will know|strong="H03045"\w* \w whether|strong="H03588"\w* \w you|strong="H00859"\w* \w are honest|strong="H03651"\w*: \w Leave|strong="H05117"\w* \w one|strong="H00259"\w* \w brother|strong="H00251"\w* \w with me|strong="H00854"\w*, \w -|strong="H00853"\w* \w take|strong="H03947"\w* \w food to relieve the hunger|strong="H07459"\w* \w of your households|strong="H01004"\w*, \w and go|strong="H01980"\w*. \v 34 \w But bring|strong="H00935"\w* \w -|strong="H00853"\w* \w your youngest|strong="H06996"\w* \w brother|strong="H00251"\w* \w back to me|strong="H00413"\w* \w so I will know|strong="H03045"\w* \w that|strong="H03588"\w* \w you|strong="H00859"\w* \w are not|strong="H03808"\w* \w spies|strong="H07270"\w* \w but|strong="H03588"\w* \w honest men|strong="H03651"\w* \w . . .|strong="H00859"\w* \w -|strong="H00853"\w*. \w Then I will give|strong="H05414"\w* \w your brother|strong="H00251"\w* back to you, \w -|strong="H00853"\w* \w and you can trade|strong="H05503"\w* \w in the land|strong="H00776"\w*.’”
\p \v 35 \w -|strong="H01961"\w* \w As they|strong="H01992"\w* \w began emptying|strong="H07324"\w* \w their sacks|strong="H08242"\w*, \w there|strong="H02009"\w* \w in each man’s|strong="H00376"\w* \w sack|strong="H08242"\w* \w was his bag|strong="H06872"\w* \w of silver|strong="H03701"\w*! \w And when they|strong="H01992"\w* \w and their father|strong="H00001"\w* \w saw|strong="H07200"\w* \w -|strong="H00853"\w* \w the bags|strong="H06872"\w* \w of silver|strong="H03701"\w*, \w they were dismayed|strong="H03372"\w*.
\p \v 36 \w Their father|strong="H00001"\w* \w -|strong="H00853"\w* \w Jacob|strong="H03290"\w* \w said|strong="H00559"\w* \w to them|strong="H00413"\w*, “\w You have deprived me of my sons|strong="H07921"\w*. \w Joseph|strong="H03130"\w* \w is gone|strong="H00369"\w* \w and Simeon|strong="H08095"\w* \w is no more|strong="H00369"\w*. \w -|strong="H00853"\w* \w Now you want to take|strong="H03947"\w* \w Benjamin|strong="H01144"\w*. \w Everything|strong="H03605"\w* \w is going|strong="H01961"\w* \w against me|strong="H05921"\w*!”
\p \v 37 \w Then Reuben|strong="H07205"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w his father|strong="H00001"\w*, \w . . .|strong="H00559"\w* \w -|strong="H00853"\w* “\w You may kill|strong="H04191"\w* \w my two|strong="H08147"\w* \w sons|strong="H01121"\w* \w if|strong="H00518"\w* \w I fail|strong="H03808"\w* \w to bring him back|strong="H00935"\w* \w to you|strong="H00413"\w*. \w Put|strong="H05414"\w* \w him|strong="H00853"\w* \w in|strong="H05921"\w* \w my care|strong="H03027"\w*, \w and I|strong="H00589"\w* \w will return him|strong="H07725"\w* \w . . .|strong="H00413"\w*.”
\p \v 38 \w But Jacob replied|strong="H00559"\w*, “\w My son|strong="H01121"\w* \w will not|strong="H03808"\w* \w go down there|strong="H03381"\w* \w with you|strong="H05973"\w*, \w for|strong="H03588"\w* \w his brother|strong="H00251"\w* \w is dead|strong="H04191"\w*, \w and he|strong="H01931"\w* \w alone|strong="H00905"\w* \w is left|strong="H07604"\w*. \w If any harm comes|strong="H07122"\w* \w . . .|strong="H00611"\w* \w to him on your|strong="H00834"\w* \w . . .|strong="H01980"\w* . . . \w journey|strong="H01870"\w*, \w {you will bring} my gray hair|strong="H07872"\w* \w down|strong="H03381"\w* \w -|strong="H00853"\w* \w to Sheol|strong="H07585"\w* \w in sorrow|strong="H03015"\w*.”
\c 43
\s1 The Return to Egypt with Benjamin
\p \v 1 \w Now the famine|strong="H07458"\w* \w was still severe|strong="H03515"\w* \w in the land|strong="H00776"\w*. \v 2 \w -|strong="H01961"\w* \w So when|strong="H00834"\w* \w -|strong="H00853"\w* \w [Jacob’s sons] had eaten all|strong="H03615"\w* \w . . .|strong="H00398"\w* \w the grain|strong="H07668"\w* \w -|strong="H00834"\w* \w they had brought|strong="H00935"\w* \w from Egypt|strong="H04714"\w*, \w their father|strong="H00001"\w* \w said|strong="H00559"\w* \w to them|strong="H00413"\w*, “\w Go back|strong="H07725"\w* \w and buy|strong="H07666"\w* us \w a little more|strong="H04592"\w* \w food|strong="H00400"\w*.”
\p \v 3 \w But Judah|strong="H03063"\w* \w . . .|strong="H00559"\w* \w replied|strong="H00559"\w* \w . . .|strong="H00413"\w*, “\w The man|strong="H00376"\w* \w . . .|strong="H00559"\w* \w solemnly warned|strong="H05749"\w* \w . . .|strong="H05749"\w* us, ‘\w You will not|strong="H03808"\w* \w see|strong="H07200"\w* \w my face|strong="H06440"\w* \w again unless|strong="H01115"\w* \w your brother|strong="H00251"\w* \w is with you|strong="H00854"\w*.’ \v 4 \w If|strong="H00518"\w* \w . . .|strong="H03426"\w* \w you will send|strong="H07971"\w* \w -|strong="H00853"\w* \w our brother|strong="H00251"\w* \w with us|strong="H00854"\w*, \w we will go down|strong="H03381"\w* \w and buy|strong="H07666"\w* \w food|strong="H00400"\w* for you. \v 5 \w But if|strong="H00518"\w* \w you will not|strong="H00369"\w* \w send him|strong="H07971"\w*, \w we will not|strong="H03808"\w* \w go|strong="H03381"\w*; \w for|strong="H03588"\w* \w the man|strong="H00376"\w* \w told|strong="H00559"\w* \w us|strong="H00413"\w*, ‘\w You will not|strong="H03808"\w* \w see|strong="H07200"\w* \w my face|strong="H06440"\w* \w again unless|strong="H01115"\w* \w your brother|strong="H00251"\w* \w is with you|strong="H00854"\w*.’”
\p \v 6 “\w Why|strong="H04100"\w* \w did you bring this trouble|strong="H07489"\w* upon me?” \w Israel|strong="H03478"\w* \w asked|strong="H00559"\w*. “\w Why did you tell|strong="H05046"\w* \w the man|strong="H00376"\w* \w you had another|strong="H05750"\w* . . . \w brother|strong="H00251"\w*?”
\p \v 7 \w They replied|strong="H00559"\w*, “\w The man|strong="H00376"\w* \w questioned|strong="H07592"\w* us \w in detail|strong="H07592"\w* \w about ourselves and our family|strong="H04138"\w*\w . . .|strong="H00559"\w*: ‘\w Is your father|strong="H00001"\w* \w still|strong="H05750"\w* \w alive|strong="H02416"\w*? \w Do you have|strong="H03426"\w* . . . \w another brother|strong="H00251"\w*?’ \w And we answered|strong="H05046"\w* him \w accordingly|strong="H05921"\w* \w . . .|strong="H06310"\w*. \w . . .|strong="H01697"\w* \w . . .|strong="H00428"\w* \w How could we possibly know|strong="H03045"\w* \w . . .|strong="H03045"\w* \w that|strong="H03588"\w* \w he would say|strong="H00559"\w*, ‘\w Bring|strong="H03381"\w* \w -|strong="H00853"\w* \w your brother here|strong="H00251"\w*’?”
\p \v 8 \w And Judah|strong="H03063"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w his father|strong="H00001"\w* \w Israel|strong="H03478"\w*, “\w Send|strong="H07971"\w* \w the boy|strong="H05288"\w* \w with me|strong="H00854"\w*, \w vvv|strong="H06965"\w* \w and we will go at once|strong="H01980"\w*, \w so that we may live|strong="H02421"\w* \w and not|strong="H03808"\w* \w die|strong="H04191"\w*— \w . . .|strong="H01571"\w* \w neither we|strong="H00587"\w*, \w . . .|strong="H01571"\w* \w nor you|strong="H00859"\w*, \w . . .|strong="H01571"\w* \w nor our children|strong="H02945"\w*. \v 9 \w I|strong="H00595"\w* \w will guarantee his safety|strong="H06148"\w*. \w You may hold me|strong="H01245"\w* \w personally responsible|strong="H03027"\w*. \w If|strong="H00518"\w* \w I do not|strong="H03808"\w* \w bring him back|strong="H00935"\w* \w -|strong="H00413"\w* \w and set him|strong="H03322"\w* \w before you|strong="H06440"\w*, then may I \w bear the guilt before you|strong="H02398"\w* \w all my life|strong="H03605"\w* \w . . .|strong="H03117"\w*. \v 10 \w If we had not|strong="H03588"\w* \w . . .|strong="H03884"\w* \w delayed|strong="H04102"\w*, \w . . .|strong="H03588"\w* \w we could have come and gone|strong="H07725"\w* \w . . .|strong="H02088"\w* \w twice|strong="H06471"\w* \w by now|strong="H06258"\w*.”
\p \v 11 \w Then their father|strong="H00001"\w* \w Israel|strong="H03478"\w* \w said|strong="H00559"\w* \w to them|strong="H00413"\w*, “\w If|strong="H00518"\w* \w it must be so|strong="H03651"\w*, \w then|strong="H00645"\w* \w do|strong="H06213"\w* \w this|strong="H02063"\w*: \w Put|strong="H03947"\w* \w some of the best products|strong="H02173"\w* \w of the land|strong="H00776"\w* \w in your packs|strong="H03627"\w* \w and carry them down|strong="H03381"\w* \w as a gift|strong="H04503"\w* \w for the man|strong="H00376"\w* — \w a little|strong="H04592"\w* \w balm|strong="H06875"\w* \w and a little|strong="H04592"\w* \w honey|strong="H01706"\w*, \w spices|strong="H05219"\w* \w and myrrh|strong="H03910"\w*, \w pistachios|strong="H00992"\w* \w and almonds|strong="H08247"\w*. \v 12 \w Take|strong="H03947"\w* \w double|strong="H04932"\w* \w the silver|strong="H03701"\w* \w with you|strong="H03027"\w* \w so that|strong="H00853"\w* \w you may return|strong="H07725"\w* \w the silver|strong="H03701"\w* \w that was put back|strong="H07725"\w* \w . . .|strong="H03027"\w* \w into the mouths|strong="H06310"\w* \w of your sacks|strong="H00572"\w*. \w Perhaps|strong="H00194"\w* \w it|strong="H01931"\w* \w was a mistake|strong="H04870"\w*. \v 13 \w -|strong="H00853"\w* \w Take|strong="H03947"\w* \w your brother as well|strong="H00251"\w*, \w and return|strong="H07725"\w* \w to|strong="H00413"\w* \w the man|strong="H00376"\w* \w at once|strong="H06965"\w*. \v 14 \w May God|strong="H00410"\w* \w Almighty|strong="H07706"\w*\f + \fr 43:14 \ft Hebrew \fqa El-Shaddai\f* \w grant|strong="H05414"\w* you \w mercy|strong="H07356"\w* \w before|strong="H06440"\w* \w the man|strong="H00376"\w*, \w that he may release|strong="H07971"\w* your \w -|strong="H00853"\w* \w other|strong="H00312"\w* \w -|strong="H00853"\w* \w brother|strong="H00251"\w* \w along with Benjamin|strong="H01144"\w*. \w As for me|strong="H00589"\w*, \w if|strong="H00834"\w* \w I am bereaved|strong="H07921"\w*, \w I am bereaved|strong="H07921"\w*.”
\p \v 15 \w So the men|strong="H00582"\w* \w -|strong="H00853"\w* \w took|strong="H03947"\w* \w these|strong="H02063"\w* \w gifts|strong="H04503"\w*, \w along with double|strong="H04932"\w* \w the amount of silver|strong="H03701"\w* \w . . .|strong="H03947"\w* \w . . .|strong="H03027"\w*, \w and|strong="H00853"\w* \w Benjamin as well|strong="H01144"\w*. \w vvv|strong="H06965"\w* \w Then they hurried down|strong="H03381"\w* \w to Egypt|strong="H04714"\w* \w and stood|strong="H05975"\w* \w before|strong="H06440"\w* \w Joseph|strong="H03130"\w*.
\s1 Joseph’s Hospitality to His Brothers
\p \v 16 \w When Joseph|strong="H03130"\w* \w saw|strong="H07200"\w* \w Benjamin|strong="H01144"\w* \w with [his brothers]|strong="H00854"\w*, \w -|strong="H00853"\w* \w he said|strong="H00559"\w* \w to the steward|strong="H00834"\w* \w of|strong="H05921"\w* \w his house|strong="H01004"\w*, “\w Take|strong="H00935"\w*\w . . .|strong="H00853"\w* \w these men|strong="H00582"\w* \w to my house|strong="H01004"\w*. \w Slaughter|strong="H02873"\w* \w an animal|strong="H02874"\w* \w and prepare it|strong="H03559"\w*, \w for|strong="H03588"\w* \w they shall dine|strong="H00398"\w* \w . . .|strong="H00582"\w* \w with me|strong="H00854"\w* \w at noon|strong="H06672"\w*.” \v 17 \w The man|strong="H00376"\w* \w did|strong="H06213"\w* \w as|strong="H00834"\w* \w Joseph|strong="H03130"\w* \w had commanded|strong="H00559"\w* \w and took|strong="H00935"\w* \w [the brothers]|strong="H00376"\w* \w -|strong="H00853"\w* \w -|strong="H00582"\w* \w to Joseph’s|strong="H03130"\w* \w house|strong="H01004"\w*.
\p \v 18 \w But the [brothers]|strong="H00582"\w* \w were frightened|strong="H03372"\w* \w that|strong="H03588"\w* \w they had been taken|strong="H00935"\w* \w to Joseph’s|strong="H03130"\w* \w house|strong="H01004"\w*. “\w We|strong="H00587"\w* \w have been brought|strong="H00935"\w* \w here because of|strong="H05921"\w* \w . . .|strong="H01697"\w* \w the silver|strong="H03701"\w* \w that was returned|strong="H07725"\w* \w in our bags|strong="H00572"\w* \w the first time|strong="H08462"\w*,” \w they said|strong="H00559"\w*. “\w They intend|strong="H01556"\w* \w . . .|strong="H05921"\w* \w to overpower|strong="H05307"\w* \w us|strong="H05921"\w* \w and take|strong="H03947"\w* \w us|strong="H00853"\w* \w as slaves|strong="H05650"\w*, \w along with|strong="H00853"\w* \w our donkeys|strong="H02543"\w*.”
\p \v 19 \w So they approached|strong="H05066"\w* \w Joseph’s|strong="H03130"\w* \w steward|strong="H00376"\w* \w -|strong="H00834"\w* \w -|strong="H05921"\w* \w . . .|strong="H01004"\w* \w and spoke|strong="H01696"\w* \w to him|strong="H00413"\w* \w . . .|strong="H00413"\w* \w at the entrance|strong="H06607"\w* \w to the house|strong="H01004"\w*. \v 20 “\w Please|strong="H00994"\w*, \w sir|strong="H00113"\w*,” \w they said|strong="H00559"\w*, “\w we really did come down|strong="H03381"\w* \w . . .|strong="H03381"\w* \w here the first time|strong="H08462"\w* \w to buy|strong="H07666"\w* \w food|strong="H00400"\w*. \v 21 \w But|strong="H01961"\w* \w when|strong="H03588"\w* \w we came|strong="H00935"\w* \w to|strong="H00413"\w* \w the place we lodged for the night|strong="H04411"\w*, \w we opened|strong="H06605"\w* \w -|strong="H00853"\w* \w our sacks|strong="H00572"\w* \w and, behold|strong="H02009"\w*, \w each of us [found]|strong="H00376"\w* \w his silver|strong="H03701"\w* \w in the mouth|strong="H06310"\w* \w of his sack|strong="H00572"\w*! \w It was the full amount|strong="H04948"\w* \w of our silver|strong="H03701"\w*, \w and we have brought it back|strong="H07725"\w* \w -|strong="H00853"\w* \w with us|strong="H03027"\w*. \v 22 \w We have brought|strong="H03381"\w* \w additional|strong="H00312"\w* \w silver|strong="H03701"\w* \w with us|strong="H03027"\w* \w to buy|strong="H07666"\w* \w food|strong="H00400"\w*. \w We do not|strong="H03808"\w* \w know|strong="H03045"\w* \w who|strong="H04310"\w* \w put|strong="H07760"\w* \w our silver|strong="H03701"\w* \w in our sacks|strong="H00572"\w*.”
\p \v 23 “\w It is fine|strong="H07965"\w* . . .,” \w said the steward|strong="H00559"\w*. “\w Do not|strong="H00408"\w* \w be afraid|strong="H03372"\w*. \w Your God|strong="H00430"\w*, \w the God|strong="H00430"\w* \w of your father|strong="H00001"\w*, \w gave|strong="H05414"\w* you \w the treasure|strong="H04301"\w* \w [that was] in your sacks|strong="H00572"\w*. \w I received|strong="H00935"\w* \w . . .|strong="H00413"\w* \w your silver|strong="H03701"\w*.” \w Then he brought Simeon|strong="H08095"\w* \w out|strong="H03318"\w* \w to them|strong="H00413"\w* \w -|strong="H00853"\w*. \v 24 \w And the [steward]|strong="H00376"\w* \w -|strong="H00853"\w* \w took|strong="H00935"\w* \w the men|strong="H00582"\w* \w into Joseph’s|strong="H03130"\w* \w house|strong="H01004"\w*, \w gave them|strong="H05414"\w* \w water|strong="H04325"\w* \w to wash|strong="H07364"\w* \w their feet|strong="H07272"\w*, \w and provided|strong="H05414"\w* \w food|strong="H04554"\w* \w for their donkeys|strong="H02543"\w*.
\p \v 25 \w Since|strong="H03588"\w* \w [the brothers] had been told|strong="H08085"\w* \w that|strong="H03588"\w* \w they were going to eat|strong="H00398"\w* \w a meal|strong="H03899"\w* \w there|strong="H08033"\w*, \w they prepared|strong="H03559"\w* \w -|strong="H00853"\w* \w their gift|strong="H04503"\w* \w for|strong="H05704"\w* \w Joseph’s|strong="H03130"\w* \w arrival|strong="H00935"\w* \w at noon|strong="H06672"\w*. \v 26 \w When Joseph|strong="H03130"\w* \w came|strong="H00935"\w* \w home|strong="H01004"\w*, \w they presented|strong="H00935"\w* . . . \w him|strong="H00853"\w* \w with the gifts|strong="H04503"\w* \w -|strong="H00834"\w* \w they had brought|strong="H03027"\w* \w . . .|strong="H01004"\w*, \w and they bowed|strong="H07812"\w* . . . \w to the ground before him|strong="H00776"\w*.
\p \v 27 \w He asked|strong="H07592"\w* . . . \w if they were well|strong="H07965"\w*, \w and then he asked|strong="H00559"\w*, “\w vvv|strong="H07965"\w* \w How is your elderly|strong="H02205"\w* \w father|strong="H00001"\w* \w -|strong="H00834"\w* \w you told [me about]|strong="H00559"\w*? \w Is he still|strong="H05750"\w* \w alive|strong="H02416"\w*?”
\p \v 28 “\w Your servant|strong="H05650"\w* \w our father|strong="H00001"\w* \w is well|strong="H07965"\w*,” \w they answered|strong="H00559"\w*. “\w He is still|strong="H05750"\w* \w alive|strong="H02416"\w*.” \w And they bowed down|strong="H06915"\w* \w to honor him|strong="H07812"\w*.
\p \v 29 \w When [Joseph] looked up|strong="H05375"\w* \w . . .|strong="H05869"\w* \w and saw|strong="H07200"\w* \w -|strong="H00853"\w* \w his brother|strong="H00251"\w* \w Benjamin|strong="H01144"\w*, \w his own mother’s|strong="H00517"\w* \w son|strong="H01121"\w*, \w he asked|strong="H00559"\w*, “\w Is this|strong="H02088"\w* \w your youngest|strong="H06996"\w* \w brother|strong="H00251"\w*, \w the one|strong="H00834"\w* \w you told me about|strong="H00559"\w*?” \w . . .|strong="H00413"\w* \w Then he declared|strong="H00559"\w*, “\w May God|strong="H00430"\w* \w be gracious to you|strong="H02603"\w*, \w my son|strong="H01121"\w*.”
\p \v 30 \w Joseph|strong="H03130"\w* \w hurried|strong="H04116"\w* \w out because|strong="H03588"\w* \w he was moved|strong="H03648"\w* \w . . .|strong="H07356"\w* \w to tears|strong="H01245"\w* \w . . .|strong="H01058"\w* \w for|strong="H00413"\w* \w his brother|strong="H00251"\w*, \w and he went|strong="H00935"\w* \w to a private room|strong="H02315"\w* \w to weep|strong="H01058"\w* \w . . .|strong="H08033"\w*. \v 31 \w Then he washed|strong="H07364"\w* \w his face|strong="H06440"\w* \w and came back out|strong="H03318"\w*. \w Regaining his composure|strong="H00662"\w*, \w he said|strong="H00559"\w*, “\w Serve|strong="H07760"\w* \w the meal|strong="H03899"\w*.”
\p \v 32 \w They separately served|strong="H07760"\w* \w Joseph|strong="H00905"\w*, \w [his brothers]|strong="H00905"\w*, \w and the Egyptians|strong="H04713"\w*. \w They ate|strong="H00398"\w* \w -|strong="H00854"\w* \w separately|strong="H00905"\w* \w because|strong="H03588"\w* \w the Egyptians|strong="H04713"\w* \w would|strong="H03201"\w* \w not|strong="H03808"\w* \w eat|strong="H00398"\w* \w . . .|strong="H03899"\w* \w with|strong="H00854"\w* \w the Hebrews|strong="H05680"\w*, \w since|strong="H03588"\w* \w that|strong="H01931"\w* \w was detestable|strong="H08441"\w* \w to them|strong="H04713"\w*. \v 33 \w They were seated|strong="H03427"\w* \w before [Joseph]|strong="H06440"\w* \w in order by age|strong="H01062"\w*, \w . . .|strong="H06812"\w* \w from the firstborn|strong="H01060"\w* \w to the youngest|strong="H06810"\w*, \w and the men|strong="H00582"\w* \w looked at|strong="H00413"\w* \w one|strong="H00376"\w* \w another|strong="H07453"\w* \w in astonishment|strong="H08539"\w*. \v 34 \w When the portions|strong="H04864"\w* \w . . .|strong="H00854"\w* \w were served|strong="H05375"\w* \w to them|strong="H00413"\w* \w from Joseph’s table|strong="H06440"\w*, \w Benjamin’s|strong="H01144"\w* \w . . .|strong="H04864"\w* \w portion|strong="H04864"\w* \w was five|strong="H02568"\w* \w times|strong="H03027"\w* \w larger than|strong="H07235"\w* \w any of the others|strong="H03605"\w*. \w So they feasted|strong="H08354"\w* \w and drank freely|strong="H07937"\w* \w with [Joseph]|strong="H05973"\w*.
