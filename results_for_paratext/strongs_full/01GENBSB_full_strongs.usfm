\c 33
\s1 Jacob Meets Esau
\p \v 1 \w Now Jacob|strong="H03290"\w* \w looked up|strong="H05375"\w* \w . . .|strong="H05869"\w* \w and saw|strong="H07200"\w* \w . . .|strong="H02009"\w* \w Esau|strong="H06215"\w* \w coming|strong="H00935"\w* \w toward him with|strong="H05973"\w* \w four|strong="H00702"\w* \w hundred|strong="H03967"\w* \w men|strong="H00376"\w*. \w So he divided|strong="H02673"\w* \w -|strong="H00853"\w* \w the children|strong="H03206"\w* \w . . .|strong="H05921"\w* \w among Leah|strong="H03812"\w*, \w . . .|strong="H05921"\w* \w Rachel|strong="H07354"\w*, \w . . .|strong="H05921"\w* \w and the two|strong="H08147"\w* \w maidservants|strong="H08198"\w*. \v 2 \w He put|strong="H07760"\w* \w -|strong="H00853"\w* \w the maidservants|strong="H08198"\w* \w and their|strong="H00853"\w* \w children|strong="H03206"\w* \w in front|strong="H07223"\w*, \w -|strong="H00853"\w* \w Leah|strong="H03812"\w* \w and her children|strong="H03206"\w* \w next|strong="H00314"\w*, \w -|strong="H00853"\w* \w and Rachel|strong="H07354"\w* \w -|strong="H00853"\w* \w and Joseph|strong="H03130"\w* \w at the rear|strong="H00314"\w*. \v 3 \w But [Jacob] himself|strong="H01931"\w* \w went on|strong="H05674"\w* \w ahead|strong="H06440"\w* \w and bowed|strong="H07812"\w* \w to the ground|strong="H00776"\w* \w seven|strong="H07651"\w* \w times|strong="H06471"\w* \w as|strong="H05704"\w* \w he approached|strong="H05066"\w* \w . . .|strong="H05704"\w* \w his brother|strong="H00251"\w*.
\p \v 4 \w Esau, however|strong="H06215"\w*, \w . . .|strong="H07122"\w* \w ran to him|strong="H07323"\w* \w and embraced him|strong="H02263"\w*, \w threw his arms around|strong="H05307"\w* \w . . .|strong="H05921"\w* \w his neck|strong="H06677"\w*, \w and kissed him|strong="H05401"\w*. \w And they both wept|strong="H01058"\w*.
\p \v 5 \w When Esau looked up|strong="H05375"\w* \w -|strong="H00853"\w* \w -|strong="H05869"\w* \w and saw|strong="H07200"\w* \w -|strong="H00853"\w* \w the women|strong="H00802"\w* \w -|strong="H00853"\w* \w and children|strong="H03206"\w*, \w he asked|strong="H00559"\w*, “\w Who|strong="H04310"\w* \w are these|strong="H00428"\w* with you?”
\p \w [Jacob] answered|strong="H00559"\w*, “\w [These are] the children|strong="H03206"\w* \w -|strong="H00834"\w* \w God|strong="H00430"\w* \w -|strong="H00853"\w* \w has graciously given|strong="H02603"\w* \w your servant|strong="H05650"\w*.” \v 6 \w Then the maidservants|strong="H08198"\w* \w and their|strong="H02007"\w* \w children|strong="H03206"\w* \w approached|strong="H05066"\w* \w and bowed down|strong="H07812"\w*. \v 7 \w Leah|strong="H03812"\w* \w and her children|strong="H03206"\w* \w also|strong="H01571"\w* \w approached|strong="H05066"\w* \w and bowed down|strong="H07812"\w*, \w and then|strong="H00310"\w* \w Joseph|strong="H03130"\w* \w and Rachel|strong="H07354"\w* \w approached|strong="H05066"\w* \w and bowed down|strong="H07812"\w*.
\p \v 8 “\w What|strong="H04310"\w* do you mean \w by sending this|strong="H02088"\w* \w -|strong="H00834"\w* \w whole|strong="H03605"\w* \w company|strong="H04264"\w* \w to meet me|strong="H06298"\w*?” \w asked Esau|strong="H00559"\w*.
\p “\w To find|strong="H04672"\w* \w favor|strong="H02580"\w* \w in your sight|strong="H05869"\w*, \w my lord|strong="H00113"\w*,” \w [Jacob] answered|strong="H00559"\w*.
\p \v 9 “\w I already have|strong="H03426"\w* \w plenty|strong="H07227"\w*, \w my brother|strong="H00251"\w*,” \w Esau|strong="H06215"\w* \w replied|strong="H00559"\w*. “\w Keep|strong="H01961"\w* \w what belongs|strong="H00834"\w* to you.”
\p \v 10 \w But Jacob|strong="H03290"\w* \w insisted|strong="H00559"\w*, “\w No|strong="H00408"\w*, \w please|strong="H04994"\w*! \w If|strong="H00518"\w* \w . . .|strong="H04994"\w* \w I have found|strong="H04672"\w* \w favor|strong="H02580"\w* \w in your sight|strong="H05869"\w*, \w then receive|strong="H03947"\w* \w this gift|strong="H04503"\w* \w from my hand|strong="H03027"\w*. \w For|strong="H05921"\w* \w . . .|strong="H03651"\w* \w indeed|strong="H03588"\w*, \w I have seen|strong="H07200"\w* \w your face|strong="H06440"\w*, \w and it is like seeing|strong="H07200"\w* \w the face|strong="H06440"\w* \w of God|strong="H00430"\w*, \w since you have received me favorably|strong="H07521"\w*. \v 11 \w Please|strong="H04994"\w* \w -|strong="H00853"\w* \w accept|strong="H03947"\w* \w my gift|strong="H01293"\w*\f + \fr 33:11 \ft Or \fqa blessing \ft or \fqa treaty of peace\f* \w that|strong="H00834"\w* \w was brought|strong="H00935"\w* to you, \w because|strong="H03588"\w* \w God|strong="H00430"\w* \w . . .|strong="H03588"\w* \w has been gracious|strong="H02603"\w* to me \w and I have|strong="H03426"\w* \w all I need|strong="H03605"\w*.” \w So Jacob pressed|strong="H06484"\w* him \w until he accepted|strong="H03947"\w*.
\p \v 12 \w Then Esau said|strong="H00559"\w*, “\w Let us be on our way|strong="H05265"\w* \w . . .|strong="H01980"\w*, \w and I will go|strong="H01980"\w* \w ahead of you|strong="H05048"\w*.”
\p \v 13 \w But Jacob replied|strong="H00559"\w* \w . . .|strong="H00413"\w*, “\w My lord|strong="H00113"\w* \w knows|strong="H03045"\w* \w that|strong="H03588"\w* \w the children|strong="H03206"\w* \w are frail|strong="H07390"\w*, \w and I must care for|strong="H05921"\w* \w sheep|strong="H06629"\w* \w and cattle|strong="H01241"\w* \w that are nursing their young|strong="H05763"\w*. \w If they are driven hard|strong="H01849"\w* \w for even a|strong="H00259"\w* \w day|strong="H03117"\w*, \w all|strong="H03605"\w* \w the animals|strong="H06629"\w* \w will die|strong="H04191"\w*. \v 14 \w Please|strong="H04994"\w* \w let my lord|strong="H00113"\w* \w go|strong="H05674"\w* \w ahead of|strong="H06440"\w* \w his servant|strong="H05650"\w*. \w I|strong="H00589"\w* \w will continue|strong="H05095"\w* \w on slowly|strong="H00328"\w*, \w at a comfortable pace|strong="H07272"\w* \w -|strong="H00834"\w* \w -|strong="H06440"\w* \w . . .|strong="H07272"\w* \w for the livestock|strong="H04399"\w* \w and children|strong="H03206"\w*, \w until|strong="H05704"\w* \w -|strong="H00834"\w* \w I come|strong="H00935"\w* \w to|strong="H00413"\w* \w my lord|strong="H00113"\w* \w at Seir|strong="H08165"\w*.”
\p \v 15 “\w Let me leave|strong="H03322"\w* \w . . .|strong="H04994"\w* \w some of|strong="H04480"\w* \w my|strong="H00834"\w* \w . . .|strong="H00854"\w* \w people|strong="H05971"\w* \w with you|strong="H05973"\w*,” \w Esau|strong="H06215"\w* \w said|strong="H00559"\w*.
\p \w But [Jacob] replied|strong="H00559"\w*, “\w Why|strong="H04100"\w* \w do that|strong="H02088"\w*? \w Let me find|strong="H04672"\w* \w favor|strong="H02580"\w* \w in the sight|strong="H05869"\w* \w of my lord|strong="H00113"\w*.”
\p \v 16 \w So that|strong="H01931"\w* \w day|strong="H03117"\w* \w Esau|strong="H06215"\w* \w started on his way|strong="H01870"\w* \w back|strong="H07725"\w* \w to Seir|strong="H08165"\w*, \v 17 \w but Jacob|strong="H03290"\w* \w went on|strong="H05265"\w* \w to Succoth|strong="H05523"\w*,\f + \fr 33:17 \fqa Succoth \ft means \fqa booths \ft or \fqa shelters \ft or \fqa tabernacles\ft ; twice in this verse.\f* \w where he built|strong="H01129"\w* \w a house|strong="H01004"\w* for himself \w and shelters|strong="H05521"\w* \w for his livestock|strong="H04735"\w*; \w . . .|strong="H06213"\w* \w that is why|strong="H05921"\w* \w . . .|strong="H03651"\w* \w the place|strong="H04725"\w* \w was called|strong="H07121"\w* \w . . .|strong="H08034"\w* \w Succoth|strong="H05523"\w*.
\s1 Jacob Settles in Shechem
\p \v 18 \w After Jacob|strong="H03290"\w* \w had come|strong="H00935"\w* \w vvv|strong="H06307"\w* \w from Paddan-aram|strong="H00758"\w*,\f + \fr 33:18 \ft That is, northwest Mesopotamia\f* \w he arrived|strong="H00935"\w* \w safely|strong="H08003"\w* \w at the city|strong="H05892"\w* \w of Shechem|strong="H07927"\w* \w -|strong="H00834"\w* \w in the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*, \w and he camped|strong="H02583"\w* \w . . .|strong="H00854"\w* \w just outside|strong="H06440"\w* \w the city|strong="H05892"\w*. \v 19 \w And the plot|strong="H02513"\w* \w of ground|strong="H07704"\w* \w where|strong="H00834"\w* \w he pitched|strong="H05186"\w* \w . . .|strong="H08033"\w* \w his tent|strong="H00168"\w*, \w he purchased|strong="H07069"\w* \w -|strong="H00853"\w* \w from|strong="H03027"\w* \w the sons|strong="H01121"\w* \w of Hamor|strong="H02544"\w*, \w Shechem’s|strong="H07927"\w* \w father|strong="H00001"\w*, \w for a hundred|strong="H03967"\w* \w pieces of silver|strong="H07192"\w*.\f + \fr 33:19 \ft Hebrew \fqa a hundred kesitahs\ft ; the value or weight of the kesitah is no longer known\f* \v 20 \w There|strong="H08033"\w* \w he set up|strong="H05324"\w* \w an altar|strong="H04196"\w* \w and called|strong="H07121"\w* it \w El-Elohe-Israel|strong="H00410"\w* \w . . .|strong="H00430"\w* \w . . .|strong="H03478"\w*.\f + \fr 33:20 \fqa El-Elohe-Israel \ft means \fqa God is the God of Israel \ft or \fqa mighty is the God of Israel\ft .\f*
\c 34
\s1 The Defiling of Dinah
\p \v 1 \w Now Dinah|strong="H01783"\w*, \w the daughter|strong="H01323"\w* \w Leah|strong="H03812"\w* \w -|strong="H00834"\w* \w had borne|strong="H03205"\w* \w to Jacob|strong="H03290"\w*, \w went out|strong="H03318"\w* \w to visit|strong="H07200"\w* \w the daughters|strong="H01323"\w* \w of the land|strong="H00776"\w*. \v 2 \w When Shechem|strong="H07927"\w* \w son|strong="H01121"\w* \w of Hamor|strong="H02544"\w* \w the Hivite|strong="H02340"\w*, \w the prince|strong="H05387"\w* \w of the region|strong="H00776"\w*, \w saw|strong="H07200"\w* \w her|strong="H00853"\w*, \w he took|strong="H03947"\w* \w her|strong="H00853"\w* \w and lay|strong="H07901"\w* \w with her|strong="H00854"\w* \w by force|strong="H06031"\w*. \v 3 \w And his soul|strong="H05315"\w* \w was drawn|strong="H01692"\w* \w to Dinah|strong="H01783"\w*, \w the daughter|strong="H01323"\w* \w of Jacob|strong="H03290"\w*. \w He loved|strong="H00157"\w* \w -|strong="H00853"\w* \w the young girl|strong="H05291"\w* \w and spoke to her tenderly|strong="H01696"\w* \w . . .|strong="H05921"\w* \w . . .|strong="H03820"\w* \w . . .|strong="H05291"\w*. \v 4 \w So Shechem|strong="H07927"\w* \w . . .|strong="H00413"\w* \w told|strong="H00559"\w* \w his father|strong="H00001"\w* \w . . .|strong="H00559"\w* \w Hamor|strong="H02544"\w*, “\w Get|strong="H03947"\w* me \w -|strong="H00853"\w* \w this|strong="H02063"\w* \w girl|strong="H03207"\w* \w as a wife|strong="H00802"\w*.”
\p \v 5 \w Jacob|strong="H03290"\w* \w heard|strong="H08085"\w* \w that|strong="H03588"\w* \w Shechem had defiled|strong="H02930"\w* \w -|strong="H00853"\w* \w his daughter|strong="H01323"\w* \w Dinah|strong="H01783"\w*, \w but since his sons|strong="H01121"\w* \w were|strong="H01961"\w* \w with|strong="H00854"\w* \w his livestock|strong="H04735"\w* \w in the field|strong="H07704"\w*, \w he|strong="H03290"\w* \w remained silent [about it]|strong="H02790"\w* \w until|strong="H05704"\w* \w they returned|strong="H00935"\w*. \v 6 \w Meanwhile, Shechem’s|strong="H07927"\w* \w . . .|strong="H00413"\w* \w father|strong="H00001"\w* \w Hamor|strong="H02544"\w* \w came|strong="H03318"\w* \w to speak|strong="H01696"\w* \w with|strong="H00854"\w* \w Jacob|strong="H03290"\w*. \v 7 \w When Jacob’s|strong="H03290"\w* \w sons|strong="H01121"\w* \w heard what had happened|strong="H08085"\w*, \w they returned|strong="H00935"\w* \w from|strong="H04480"\w* \w the field|strong="H07704"\w*. \w They were filled with|strong="H03966"\w* \w grief|strong="H06087"\w* \w . . .|strong="H00582"\w* \w and fury|strong="H02734"\w*, \w because|strong="H03588"\w* \w Shechem had committed|strong="H06213"\w* \w an outrage|strong="H05039"\w* \w in Israel|strong="H03478"\w*\f + \fr 34:7 \ft Or \fqa against Israel\f* \w by lying|strong="H07901"\w* \w with|strong="H00853"\w* \w Jacob’s|strong="H03290"\w* \w daughter|strong="H01323"\w* — \w a thing|strong="H03651"\w* \w that should not|strong="H03808"\w* \w be done|strong="H06213"\w*.
\p \v 8 \w But Hamor|strong="H02544"\w* \w said|strong="H01696"\w* \w to them|strong="H00854"\w* \w . . .|strong="H00559"\w*, “\w My son|strong="H01121"\w* \w Shechem|strong="H07927"\w* \w longs for|strong="H02836"\w* \w . . .|strong="H05315"\w* \w your daughter|strong="H01323"\w*. \w Please|strong="H04994"\w* \w give|strong="H05414"\w* \w her|strong="H00853"\w* to him \w as his wife|strong="H00802"\w*. \v 9 \w Intermarry with us|strong="H02859"\w*; \w . . .|strong="H00854"\w* \w give|strong="H05414"\w* us \w -|strong="H00853"\w* \w your daughters|strong="H01323"\w* \w and take|strong="H03947"\w* \w our daughters|strong="H01323"\w* for yourselves. \v 10 \w You may settle|strong="H03427"\w* \w among us|strong="H00854"\w*, \w and the land|strong="H00776"\w* \w {will} be|strong="H01961"\w* \w open to you|strong="H06440"\w*. \w Live here|strong="H03427"\w*, \w move about freely|strong="H05503"\w*, \w and acquire your own property|strong="H00270"\w*.”
\p \v 11 \w Then Shechem|strong="H07927"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Dinah’s father|strong="H00001"\w* \w . . .|strong="H00413"\w* \w and brothers|strong="H00251"\w*, “\w Grant me this favor|strong="H04672"\w* \w . . .|strong="H02580"\w*, \w . . .|strong="H05869"\w* \w and I will give|strong="H05414"\w* \w you whatever|strong="H00834"\w* \w you ask|strong="H00559"\w*. \w . . .|strong="H00413"\w* \v 12 \w Demand|strong="H07235"\w* \w a high|strong="H05921"\w* \w . . .|strong="H03966"\w* \w dowry|strong="H04119"\w* \w and [an expensive] gift|strong="H04976"\w*, \w and I will give you|strong="H05414"\w* \w whatever|strong="H00834"\w* \w you ask|strong="H00559"\w*. \w . . .|strong="H00413"\w* \w Only give|strong="H05414"\w* me \w -|strong="H00853"\w* \w the girl|strong="H05291"\w* \w as my wife|strong="H00802"\w*!”
\s1 The Revenge of Dinah’s Brothers
\p \v 13 \w But because|strong="H00834"\w* \w [Shechem] had defiled|strong="H02930"\w* \w -|strong="H00853"\w* \w their sister|strong="H00269"\w* \w Dinah|strong="H01783"\w*, \w Jacob’s|strong="H03290"\w* \w -|strong="H00853"\w* \w sons|strong="H01121"\w* \w answered|strong="H06030"\w* \w [him]|strong="H07927"\w* \w -|strong="H00853"\w* \w and his father|strong="H00001"\w* \w Hamor|strong="H02544"\w* \w deceitfully|strong="H04820"\w* \w . . .|strong="H01696"\w*. \v 14 “\w We cannot|strong="H03808"\w* \w . . .|strong="H03201"\w* \w do|strong="H06213"\w* \w such|strong="H02088"\w* \w a thing|strong="H01697"\w*,” \w they said|strong="H00559"\w* \w -|strong="H00413"\w*. “\w To give|strong="H05414"\w* \w -|strong="H00853"\w* \w our sister|strong="H00269"\w* \w . . .|strong="H00376"\w* \w -|strong="H00834"\w* to \w an uncircumcised man|strong="H06190"\w* \w . . .|strong="H03588"\w* \w would be a disgrace|strong="H02781"\w* \w . . .|strong="H01931"\w* to us. \v 15 \w We will consent|strong="H00225"\w* to this \w on one|strong="H00389"\w* \w . . .|strong="H02063"\w* \w condition|strong="H00518"\w*, \w that you become|strong="H01961"\w* \w circumcised|strong="H04135"\w* \w like us|strong="H03644"\w* — \w every one of|strong="H03605"\w* \w your males|strong="H02145"\w*. \v 16 \w Then we will give|strong="H05414"\w* \w -|strong="H00853"\w* you \w our daughters|strong="H01323"\w* \w and|strong="H00853"\w* \w take|strong="H03947"\w* \w your daughters|strong="H01323"\w* for ourselves. \w We will dwell|strong="H03427"\w* \w among you|strong="H00854"\w* \w and become|strong="H01961"\w* \w one|strong="H00259"\w* \w people|strong="H05971"\w*. \v 17 \w But if|strong="H00518"\w* \w you will not|strong="H03808"\w* \w agree|strong="H08085"\w* \w . . .|strong="H00413"\w* \w to be circumcised|strong="H04135"\w*, \w then we will take|strong="H03947"\w* \w -|strong="H00853"\w* \w our sister|strong="H01323"\w* \w and go|strong="H01980"\w*.”
\p \v 18 \w Their offer|strong="H01697"\w* \w . . .|strong="H05869"\w* \w seemed good|strong="H03190"\w* \w to Hamor|strong="H02544"\w* \w . . .|strong="H05869"\w* \w and his|strong="H02544"\w* \w son|strong="H01121"\w* \w Shechem|strong="H07927"\w*. \v 19 \w The young man|strong="H05288"\w*, \w who [was]|strong="H01931"\w* \w the most respected|strong="H03513"\w* \w of all|strong="H03605"\w* \w his father’s|strong="H00001"\w* \w household|strong="H01004"\w*, \w did not|strong="H03808"\w* \w hesitate|strong="H00309"\w* \w to fulfill|strong="H06213"\w* \w this request|strong="H01697"\w*, \w because|strong="H03588"\w* \w he was delighted|strong="H02654"\w* \w with Jacob’s|strong="H03290"\w* \w daughter|strong="H01323"\w*.
\p \v 20 \w So Hamor|strong="H02544"\w* \w and his son|strong="H01121"\w* \w Shechem|strong="H07927"\w* \w went|strong="H00935"\w* \w to|strong="H00413"\w* \w the gate|strong="H08179"\w* \w of their city|strong="H05892"\w* \w and addressed|strong="H01696"\w* \w . . .|strong="H00413"\w* \w the men|strong="H00582"\w* \w of their city|strong="H05892"\w* \w . . .|strong="H00559"\w*: \v 21 “\w These|strong="H00428"\w* \w men|strong="H00582"\w* \w are at peace|strong="H08003"\w* \w . . .|strong="H01992"\w* \w with us|strong="H00854"\w*. \w Let them live|strong="H03427"\w* \w and trade|strong="H05503"\w* \w in our land|strong="H00776"\w*; \w -|strong="H00853"\w* \w indeed|strong="H02009"\w*, \w [it]|strong="H00776"\w* \w is large|strong="H07342"\w* \w . . .|strong="H03027"\w* \w enough for them|strong="H06440"\w*. \w -|strong="H00853"\w* \w Let us take|strong="H03947"\w* . . . \w their daughters|strong="H01323"\w* \w in marriage|strong="H00802"\w* \w -|strong="H00853"\w* \w and give|strong="H05414"\w* \w our daughters|strong="H01323"\w* to them. \v 22 \w But only|strong="H00389"\w* \w on this condition|strong="H02063"\w* \w {will} the men|strong="H00582"\w* \w agree|strong="H00225"\w* - \w to dwell|strong="H03427"\w* \w with us|strong="H00854"\w* \w and be|strong="H01961"\w* \w one|strong="H00259"\w* \w people|strong="H05971"\w*: \w if all|strong="H03605"\w* our \w men|strong="H02145"\w* \w are circumcised|strong="H04135"\w* \w as|strong="H00834"\w* \w they are|strong="H01992"\w* \w . . .|strong="H04135"\w*. \v 23 \w Will not|strong="H03808"\w* \w their livestock|strong="H04735"\w*, \w their possessions|strong="H07075"\w*, \w and all|strong="H03605"\w* vvv \w their|strong="H01992"\w* \w animals [become ours]|strong="H00929"\w*? \w Only|strong="H00389"\w* \w let us consent|strong="H00225"\w* to them, \w and they will dwell|strong="H03427"\w* \w among us|strong="H00854"\w*.”
\p \v 24 \w All the men|strong="H03605"\w* \w who went out|strong="H03318"\w* \w of the city|strong="H05892"\w* \w gate|strong="H08179"\w* \w listened|strong="H08085"\w* \w to|strong="H00413"\w* \w Hamor|strong="H02544"\w* \w . . .|strong="H00413"\w* \w and his son|strong="H01121"\w* \w Shechem|strong="H07927"\w*, \w and every|strong="H03605"\w* \w male|strong="H02145"\w* \w . . .|strong="H03605"\w* \w vvv|strong="H03318"\w* \w vvv|strong="H08179"\w* \w of the city|strong="H05892"\w* \w was circumcised|strong="H04135"\w*.
