\p \v 20 \w Then Noah|strong="H05146"\w* \w built|strong="H01129"\w* \w an altar|strong="H04196"\w* \w to the LORD|strong="H03068"\w*. \w And taking|strong="H03947"\w* \w from every kind|strong="H03605"\w* \w of clean|strong="H02889"\w* \w animal|strong="H00929"\w* \w and|strong="H03605"\w* \w clean|strong="H02889"\w* \w bird|strong="H05775"\w*, \w he offered|strong="H05927"\w* \w burnt offerings|strong="H05930"\w* \w on the altar|strong="H04196"\w*. \v 21 \w When the LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w smelled|strong="H07306"\w* \w the pleasing|strong="H05207"\w* \w aroma|strong="H07381"\w*, \w He|strong="H03068"\w* \w said|strong="H00559"\w* \w in|strong="H00413"\w* \w His heart|strong="H03820"\w*, “\w Never again|strong="H03808"\w* \w . . .|strong="H03254"\w* \w . . .|strong="H05750"\w* \w -|strong="H00853"\w* \w will I curse|strong="H07043"\w* \w the ground|strong="H00127"\w* \w because of|strong="H05668"\w* \w man|strong="H00120"\w*, \w even though|strong="H03588"\w* \w every inclination|strong="H03336"\w* \w of [his]|strong="H00120"\w* \w heart|strong="H03820"\w* \w is evil|strong="H07451"\w* \w from his youth|strong="H05271"\w*. \w And never|strong="H03808"\w* \w again|strong="H03254"\w* \w . . .|strong="H05750"\w* \w will I destroy|strong="H05221"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w living creatures|strong="H02416"\w* \w as|strong="H00834"\w* \w I have done|strong="H06213"\w*.
\b 
