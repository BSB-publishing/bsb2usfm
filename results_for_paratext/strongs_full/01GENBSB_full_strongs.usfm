\p \v 14 \w Ephron|strong="H06085"\w* \w -|strong="H00853"\w* \w answered|strong="H06030"\w* \w Abraham|strong="H00085"\w* \w -|strong="H00559"\w*, \v 15 “\w Listen to me|strong="H08085"\w*, \w my lord|strong="H00113"\w*. \w The land|strong="H00776"\w* \w [is worth] four|strong="H00702"\w* \w hundred|strong="H03967"\w* \w shekels|strong="H08255"\w* \w of silver|strong="H03701"\w*,\f + \fr 23:15 \fqa 400 shekels \ft is approximately 10.1 pounds or 4.6 kilograms of silver; also in verse 16.\f* \w but what|strong="H04100"\w* \w is that|strong="H01931"\w* \w -|strong="H00853"\w* \w between you and me|strong="H00996"\w* \w . . .|strong="H00996"\w*? \w Bury|strong="H06912"\w* \w your dead|strong="H04191"\w*.”
\p \v 16 \w Abraham|strong="H00085"\w* \w agreed|strong="H08085"\w* \w to|strong="H00413"\w* \w Ephron’s terms|strong="H06085"\w* \w and|strong="H00085"\w* \w weighed out|strong="H08254"\w* \w [for him]|strong="H06085"\w* \w -|strong="H00853"\w* \w the price|strong="H03701"\w* \w -|strong="H00834"\w* \w he had named|strong="H01696"\w* \w in the hearing|strong="H00241"\w* \w of the Hittites|strong="H01121"\w* \w . . .|strong="H02845"\w*: \w four|strong="H00702"\w* \w hundred|strong="H03967"\w* \w shekels|strong="H08255"\w* \w of silver|strong="H03701"\w*, \w according to the standard|strong="H05674"\w* \w of the merchants|strong="H05503"\w*.
\p \v 17 \w So Ephron’s|strong="H06085"\w* \w field|strong="H07704"\w* \w at Machpelah|strong="H04375"\w* \w -|strong="H00834"\w* \w near|strong="H06440"\w* \w Mamre|strong="H04471"\w* \w -|strong="H07704"\w* \w -|strong="H00834"\w*, \w the cave|strong="H04631"\w* \w that [was]|strong="H00834"\w* in it, \w and all|strong="H03605"\w* \w the trees|strong="H06086"\w* \w -|strong="H00834"\w* \w within|strong="H03605"\w* \w the boundaries|strong="H01366"\w* \w . . .|strong="H05439"\w* \w of the field|strong="H07704"\w* \w -|strong="H00834"\w* \w were deeded over|strong="H06965"\w* \v 18 \w to Abraham’s|strong="H00085"\w* \w possession|strong="H04736"\w* \w in the presence|strong="H05869"\w* \w of all|strong="H03605"\w* \w the Hittites|strong="H01121"\w* \w . . .|strong="H02845"\w* \w who had come|strong="H00935"\w* \w to the gate|strong="H08179"\w* \w of his city|strong="H05892"\w*. \v 19 \w After|strong="H00310"\w* \w this|strong="H03651"\w*, \w Abraham|strong="H00085"\w* \w -|strong="H00853"\w* \w buried|strong="H06912"\w* \w his wife|strong="H00802"\w* \w Sarah|strong="H08283"\w* \w in|strong="H00413"\w* \w the cave|strong="H04631"\w* \w of the field|strong="H07704"\w* \w at Machpelah|strong="H04375"\w* \w near|strong="H05921"\w* \w . . .|strong="H06440"\w* \w Mamre|strong="H04471"\w* \w (that is|strong="H01931"\w*, \w Hebron|strong="H02275"\w*) \w in the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*. \v 20 \w So the field|strong="H07704"\w* \w and its|strong="H00834"\w* \w cave|strong="H04631"\w* \w were deeded|strong="H06965"\w* \w by the Hittites|strong="H01121"\w* \w . . .|strong="H02845"\w* \w to Abraham|strong="H00085"\w* \w as a burial|strong="H06913"\w* \w . . .|strong="H00854"\w* \w site|strong="H00272"\w*.
\c 24
\s1 A Wife for Isaac
\p \v 1 \w By now Abraham|strong="H00085"\w* \w was old|strong="H02204"\w* \w and well along|strong="H00935"\w* \w in years|strong="H03117"\w*, \w and the LORD|strong="H03068"\w* \w had blessed|strong="H01288"\w* \w -|strong="H00853"\w* \w him|strong="H00085"\w* \w in every way|strong="H03605"\w*. \v 2 \w So Abraham|strong="H00085"\w* \w instructed|strong="H00559"\w* \w . . .|strong="H00413"\w* \w the chief|strong="H02205"\w* \w servant|strong="H05650"\w* \w of his household|strong="H01004"\w*, \w who managed|strong="H04910"\w* \w all he owned|strong="H03605"\w* \w -|strong="H00834"\w*, “\w Place|strong="H07760"\w* \w . . .|strong="H04994"\w* \w your hand|strong="H03027"\w* \w under|strong="H08478"\w* \w my thigh|strong="H03409"\w*, \v 3 \w and I will have you swear|strong="H07650"\w* \w by the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of heaven|strong="H08064"\w* \w and the God|strong="H00430"\w* \w of earth|strong="H00776"\w*, \w that|strong="H00834"\w* \w you will not|strong="H03808"\w* \w take|strong="H03947"\w* \w a wife|strong="H00802"\w* \w for my son|strong="H01121"\w* \w from the daughters|strong="H01323"\w* \w of the Canaanites|strong="H03669"\w* \w among|strong="H07130"\w* \w whom|strong="H00834"\w* \w I|strong="H00595"\w* \w am dwelling|strong="H03427"\w*, \v 4 \w but|strong="H03588"\w* \w will go|strong="H01980"\w* \w to|strong="H00413"\w* \w my country|strong="H00776"\w* \w and|strong="H00413"\w* \w my kindred|strong="H04138"\w* \w to take|strong="H03947"\w* \w a wife|strong="H00802"\w* \w for my son|strong="H01121"\w* \w Isaac|strong="H03327"\w*.”
\p \v 5 \w The servant|strong="H05650"\w* \w asked|strong="H00559"\w* \w him|strong="H00413"\w*, “\w What if|strong="H00194"\w* \w the woman|strong="H00802"\w* \w is unwilling|strong="H03808"\w* \w . . .|strong="H00014"\w* \w to follow me|strong="H01980"\w* \w . . .|strong="H00310"\w* \w to|strong="H00413"\w* \w this|strong="H02063"\w* \w land|strong="H00776"\w*? \w Shall I then take your son back|strong="H07725"\w* \w . . .|strong="H01121"\w* \w . . .|strong="H07725"\w* \w -|strong="H00853"\w* \w to|strong="H00413"\w* \w the land|strong="H00776"\w* \w from|strong="H08033"\w* \w which|strong="H00834"\w* \w you came|strong="H03318"\w*?”
\p \v 6 \w Abraham|strong="H00085"\w* \w replied|strong="H00559"\w*, \w . . .|strong="H00413"\w* “\w Make sure|strong="H08104"\w* \w that you do not|strong="H06435"\w* \w take my son|strong="H01121"\w* \w back|strong="H07725"\w* \w -|strong="H00853"\w* \w there|strong="H08033"\w*. \v 7 \w The LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of heaven|strong="H08064"\w*, \w who|strong="H00834"\w* \w brought me|strong="H03947"\w* \w from my father’s|strong="H00001"\w* \w house|strong="H01004"\w* \w and my native|strong="H04138"\w* \w land|strong="H00776"\w*, \w who|strong="H00834"\w* \w spoke|strong="H01696"\w* to me \w and|strong="H00834"\w* \w promised me on oath|strong="H07650"\w* . . ., \w saying|strong="H00559"\w*, ‘\w To your offspring|strong="H02233"\w* \w I will give|strong="H05414"\w* \w -|strong="H00853"\w* \w this|strong="H02063"\w* \w land|strong="H00776"\w*’— \w He|strong="H01931"\w* \w will send|strong="H07971"\w* \w His angel|strong="H04397"\w* \w before you|strong="H06440"\w* \w so that you can take|strong="H03947"\w* \w a wife|strong="H00802"\w* \w for my son|strong="H01121"\w* \w from there|strong="H08033"\w*. \v 8 \w And if|strong="H00518"\w* \w the woman|strong="H00802"\w* \w is unwilling|strong="H03808"\w* \w . . .|strong="H00014"\w* \w to follow|strong="H01980"\w* \w you|strong="H00310"\w*, \w then you are released|strong="H05352"\w* \w from this|strong="H02063"\w* \w oath of mine|strong="H07621"\w*. \w Only|strong="H07535"\w* \w -|strong="H00853"\w* \w do not|strong="H03808"\w* \w take|strong="H07725"\w* \w my son|strong="H01121"\w* \w back there|strong="H08033"\w*.”
\p \v 9 \w So the servant|strong="H05650"\w* \w -|strong="H00853"\w* \w placed|strong="H07760"\w* \w his hand|strong="H03027"\w* \w under|strong="H08478"\w* \w the thigh|strong="H03409"\w* \w of his master|strong="H00113"\w* \w Abraham|strong="H00085"\w* \w and swore an oath|strong="H07650"\w* to him \w concerning|strong="H05921"\w* \w this|strong="H02088"\w* \w matter|strong="H01697"\w*.
\p \v 10 \w Then the servant|strong="H05650"\w* \w took|strong="H03947"\w* \w ten|strong="H06235"\w* \w of his master’s|strong="H00113"\w* \w camels|strong="H01581"\w* \w . . .|strong="H01581"\w* \w and departed|strong="H01980"\w* \w with all manner|strong="H03605"\w* \w of good things|strong="H02898"\w* \w from his master|strong="H00113"\w* \w in hand|strong="H03027"\w*. \w And he set out|strong="H06965"\w* \w . . .|strong="H01980"\w* \w for|strong="H00413"\w* \w -|strong="H00413"\w* \w Nahor’s|strong="H05152"\w* \w hometown|strong="H05892"\w* \w vvv|strong="H00763"\w* \w in Aram-naharaim|strong="H00763"\w*.\f + \fr 24:10 \ft That is, Mesopotamia; \fqa Aram-naharaim \ft means \fqa Aram of the two rivers\ft , likely the region between the Euphrates and Balih Rivers in northwestern Mesopotamia.\f* \v 11 \w As evening approached|strong="H06153"\w* \w . . .|strong="H06256"\w*, \w he made the camels|strong="H01581"\w* \w kneel down|strong="H01288"\w* \w near|strong="H00413"\w* \w the well|strong="H00875"\w* \w . . .|strong="H04325"\w* \w outside|strong="H02351"\w* \w the town|strong="H05892"\w* \w at the time|strong="H06256"\w* \w when the women went out|strong="H03318"\w* \w to draw water|strong="H07579"\w*.
\p \v 12 “\w O LORD|strong="H03068"\w*, \w God|strong="H00430"\w* \w of my master|strong="H00113"\w* \w Abraham|strong="H00085"\w*,” \w he prayed|strong="H00559"\w*, “\w please|strong="H04994"\w* \w grant me success today|strong="H07136"\w* \w . . .|strong="H06440"\w* \w . . .|strong="H03117"\w*, \w and show|strong="H06213"\w* \w kindness|strong="H02617"\w* \w to|strong="H05973"\w* \w my master|strong="H00113"\w* \w Abraham|strong="H00085"\w*. \v 13 \w Here|strong="H02009"\w* \w I am|strong="H00595"\w*, \w standing|strong="H05324"\w* \w beside|strong="H05921"\w* \w the spring|strong="H05869"\w* \w . . .|strong="H04325"\w*, \w and the daughters|strong="H01323"\w* \w of the townspeople|strong="H00582"\w* \w . . .|strong="H05892"\w* \w are coming out|strong="H03318"\w* \w to draw|strong="H07579"\w* \w water|strong="H04325"\w*. \v 14 \w Now may it happen|strong="H01961"\w* \w that the girl|strong="H05291"\w* \w to|strong="H00413"\w* \w whom|strong="H00834"\w* \w I say|strong="H00559"\w*, ‘\w Please|strong="H04994"\w* \w let down|strong="H05186"\w* \w your jar|strong="H03537"\w* \w that I may drink|strong="H08354"\w*,’ \w and who responds|strong="H00559"\w*, ‘\w Drink|strong="H08354"\w*, \w and I will water|strong="H08248"\w* \w -|strong="H00853"\w* \w your camels|strong="H01581"\w* \w as well|strong="H01571"\w*’— \w let her be the one You have appointed|strong="H03198"\w* \w for Your servant|strong="H05650"\w* \w Isaac|strong="H03327"\w*. By this \w I will know|strong="H03045"\w* \w that|strong="H03588"\w* \w You have shown|strong="H06213"\w* \w kindness|strong="H02617"\w* \w to|strong="H05973"\w* \w my master|strong="H00113"\w*.”
\s1 Rebekah Is Chosen
\p \v 15 \w -|strong="H01961"\w* \w Before|strong="H02962"\w* \w [the servant]|strong="H01931"\w* \w had finished|strong="H03615"\w* \w praying|strong="H01696"\w*, \w -|strong="H02009"\w* \w Rebekah|strong="H07259"\w* \w came out|strong="H03318"\w* \w with her jar|strong="H03537"\w* \w on|strong="H05921"\w* \w her shoulder|strong="H07926"\w*. \w She|strong="H00834"\w* \w was|strong="H03205"\w* \w the daughter of Bethuel|strong="H01328"\w* \w son|strong="H01121"\w* \w of Milcah|strong="H04435"\w*, \w the wife|strong="H00802"\w* \w of Abraham’s|strong="H00085"\w* \w brother|strong="H00251"\w* \w Nahor|strong="H05152"\w*. \v 16 \w Now the girl|strong="H05291"\w* \w was very|strong="H03966"\w* \w beautiful|strong="H02896"\w* \w . . .|strong="H04758"\w*, \w a virgin|strong="H01330"\w* \w . . .|strong="H03808"\w* \w who had not had relations|strong="H03045"\w* \w with any man|strong="H00376"\w*. \w She went down|strong="H03381"\w* \w to the spring|strong="H05869"\w*, \w filled|strong="H04390"\w* \w her jar|strong="H03537"\w*, \w and came up again|strong="H05927"\w*.
\p \v 17 \w So the servant|strong="H05650"\w* \w ran|strong="H07323"\w* \w to meet her|strong="H07122"\w* \w and said|strong="H00559"\w*, “\w Please|strong="H04994"\w* \w let me have|strong="H01572"\w* \w a little|strong="H04592"\w* \w water|strong="H04325"\w* \w from your jar|strong="H03537"\w*.”
\p \v 18 “\w Drink|strong="H08354"\w*, \w my lord|strong="H00113"\w*,” \w she replied|strong="H00559"\w*, \w and she quickly|strong="H04116"\w* \w lowered|strong="H03381"\w* \w her jar|strong="H03537"\w* \w to|strong="H05921"\w* \w her hands|strong="H03027"\w* \w and gave him a drink|strong="H08248"\w*.
\p \v 19 \w After she|strong="H03615"\w* \w had given him a drink|strong="H08248"\w*, \w she said|strong="H00559"\w*, “\w I will also|strong="H01571"\w* \w draw water|strong="H07579"\w* \w for your camels|strong="H01581"\w*, \w until|strong="H05704"\w* \w . . .|strong="H00518"\w* \w they have had enough|strong="H03615"\w* \w to drink|strong="H08354"\w*.” \v 20 \w And she quickly|strong="H04116"\w* \w emptied|strong="H06168"\w* \w her jar|strong="H03537"\w* \w into|strong="H00413"\w* \w the trough|strong="H08268"\w* \w and ran|strong="H07323"\w* \w back|strong="H05750"\w* \w to|strong="H00413"\w* \w the well|strong="H00875"\w* \w to draw water|strong="H07579"\w*, \w until she had drawn water|strong="H07579"\w* \w for all|strong="H03605"\w* \w his camels|strong="H01581"\w*.
\p \v 21 \w Meanwhile, the man|strong="H00376"\w* \w watched|strong="H07583"\w* her \w silently|strong="H02790"\w* \w to see|strong="H03045"\w* \w whether|strong="H00518"\w* \w or not|strong="H03808"\w* \w the LORD|strong="H03068"\w* \w had made his journey|strong="H01870"\w* \w a success|strong="H06743"\w*.
\p \v 22 \w And|strong="H01961"\w* \w after|strong="H00834"\w* \w the camels|strong="H01581"\w* \w had finished|strong="H03615"\w* \w drinking|strong="H08354"\w*, \w [he]|strong="H00376"\w* \w took out|strong="H03947"\w* \w a gold|strong="H02091"\w* \w ring|strong="H05141"\w* \w weighing|strong="H04948"\w* \w a beka|strong="H01235"\w*,\f + \fr 24:22 \fqa A beka \ft is half a shekel, or approximately 0.2 ounces or 5.7 grams.\f* \w and two|strong="H08147"\w* \w gold|strong="H02091"\w* \w bracelets|strong="H06781"\w* \w for|strong="H05921"\w* \w her wrists|strong="H03027"\w* \w weighing|strong="H04948"\w* \w ten [shekels]|strong="H06235"\w*.\f + \fr 24:22 \fqa 10 shekels \ft is approximately 4 ounces or 114 grams.\f* \v 23 “\w Whose|strong="H04310"\w* \w daughter|strong="H01323"\w* \w are you|strong="H00859"\w*?” \w he asked|strong="H00559"\w*. “\w Please|strong="H04994"\w* \w tell|strong="H05046"\w* me, \w is there|strong="H03426"\w* \w room|strong="H04725"\w* \w in your father’s|strong="H00001"\w* \w house|strong="H01004"\w* for us \w to spend the night|strong="H03885"\w*?”
\p \v 24 \w She replied|strong="H00559"\w*, \w . . .|strong="H00413"\w* “\w I|strong="H00595"\w* \w am the daughter|strong="H01323"\w* \w of Bethuel|strong="H01328"\w*, \w the son|strong="H01121"\w* \w that|strong="H00834"\w* \w Milcah|strong="H04435"\w* \w bore|strong="H03205"\w* \w to Nahor|strong="H05152"\w*.” \v 25 \w Then she added|strong="H00559"\w* \w . . .|strong="H00413"\w*, “\w We have|strong="H05973"\w* \w . . .|strong="H01571"\w* \w plenty|strong="H07227"\w* \w of straw|strong="H08401"\w* \w and|strong="H01571"\w* \w feed|strong="H04554"\w*, \w as well as|strong="H01571"\w* \w a place [for you]|strong="H04725"\w* \w to spend the night|strong="H03885"\w*.”
\p \v 26 \w Then the man|strong="H00376"\w* \w bowed down|strong="H06915"\w* \w and worshiped|strong="H07812"\w* \w the LORD|strong="H03068"\w*, \v 27 \w saying|strong="H00559"\w*, “\w Blessed|strong="H01288"\w* \w [be] the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of my master|strong="H00113"\w* \w Abraham|strong="H00085"\w*, \w who|strong="H00834"\w* \w has not|strong="H03808"\w* \w withheld|strong="H05800"\w* \w His kindness|strong="H02617"\w* \w and faithfulness|strong="H00571"\w* \w from|strong="H05973"\w* \w my master|strong="H00113"\w*. \w As for me|strong="H00595"\w*, \w the LORD|strong="H03068"\w* \w has led me|strong="H05148"\w* \w on the journey|strong="H01870"\w* \w to the house|strong="H01004"\w* \w of my master’s|strong="H00113"\w* \w relatives|strong="H00251"\w*.”
\p \v 28 \w The girl|strong="H05291"\w* \w ran|strong="H07323"\w* \w and told|strong="H05046"\w* \w her mother’s|strong="H00517"\w* \w household|strong="H01004"\w* \w about these|strong="H00428"\w* \w things|strong="H01697"\w*. \v 29 \w Now Rebekah|strong="H07259"\w* \w had a brother|strong="H00251"\w* \w named|strong="H08034"\w* \w Laban|strong="H03837"\w*, \w and [he]|strong="H03837"\w* \w rushed|strong="H07323"\w* \w out|strong="H02351"\w* \w to|strong="H00413"\w* \w the man|strong="H00376"\w* \w at|strong="H00413"\w* \w the spring|strong="H05869"\w*. \v 30 \w -|strong="H01961"\w* \w As soon as he saw|strong="H07200"\w* \w -|strong="H00853"\w* \w the ring|strong="H05141"\w*, \w and|strong="H00853"\w* \w the bracelets|strong="H06781"\w* \w on|strong="H05921"\w* \w his sister’s|strong="H00269"\w* \w wrists|strong="H03027"\w*, \w and heard|strong="H08085"\w* \w -|strong="H00853"\w* \w -|strong="H00269"\w* \w . . .|strong="H00559"\w* \w Rebekah’s|strong="H07259"\w* \w words|strong="H01697"\w*, “\w The man|strong="H00376"\w* \w said|strong="H01696"\w* \w this|strong="H03541"\w* \w to me|strong="H00413"\w*,” \w he went and found|strong="H00935"\w* \w -|strong="H00413"\w* \w the man|strong="H00376"\w* \w standing|strong="H05975"\w* \w -|strong="H02009"\w* \w by|strong="H05921"\w* \w the camels|strong="H01581"\w* \w near|strong="H05921"\w* \w the spring|strong="H05869"\w*.
\p \v 31 “\w Come|strong="H00935"\w*, \w you who are blessed|strong="H01288"\w* \w by the LORD|strong="H03068"\w*,” \w said Laban|strong="H00559"\w*. “\w Why|strong="H04100"\w* \w are you standing|strong="H05975"\w* \w out here|strong="H02351"\w*? \w I|strong="H00595"\w* \w have prepared|strong="H06437"\w* \w the house|strong="H01004"\w* \w and a place|strong="H04725"\w* \w for the camels|strong="H01581"\w*.” \v 32 \w So the man|strong="H00376"\w* \w came|strong="H00935"\w* \w to the house|strong="H01004"\w*, \w and the camels|strong="H01581"\w* \w were unloaded|strong="H06605"\w*. \w Straw|strong="H08401"\w* \w and feed|strong="H04554"\w* \w were brought|strong="H05414"\w* \w to the camels|strong="H01581"\w*, \w and water|strong="H04325"\w* \w to wash|strong="H07364"\w* \w his feet|strong="H07272"\w* \w and the feet|strong="H07272"\w* \w of his companions|strong="H00582"\w* \w -|strong="H00834"\w* \w -|strong="H00854"\w*.
\p \v 33 \w Then a meal was set|strong="H03455"\w* \w before [the man]|strong="H06440"\w*, \w but he said|strong="H00559"\w*, “\w I will not|strong="H03808"\w* \w . . .|strong="H00398"\w* \w eat|strong="H00398"\w* \w until|strong="H05704"\w* \w . . .|strong="H00518"\w* \w I have told you|strong="H01696"\w* \w what I came to say|strong="H01697"\w*.”
\p \w So Laban said|strong="H00559"\w*, “\w Please speak|strong="H01696"\w*.”
\p \v 34 “\w I|strong="H00595"\w* \w am Abraham’s|strong="H00085"\w* \w servant|strong="H05650"\w*,” \w he replied|strong="H00559"\w*. \v 35 “\w The LORD|strong="H03068"\w* \w has greatly|strong="H03966"\w* \w blessed|strong="H01288"\w* \w -|strong="H00853"\w* \w my master|strong="H00113"\w*, \w and he has become rich|strong="H01431"\w*. \w He has given|strong="H05414"\w* him \w sheep|strong="H06629"\w* \w and cattle|strong="H01241"\w*, \w silver|strong="H03701"\w* \w and gold|strong="H02091"\w*, \w menservants|strong="H05650"\w* \w and maidservants|strong="H08198"\w*, \w camels|strong="H01581"\w* \w and donkeys|strong="H02543"\w*. \v 36 \w My master’s|strong="H00113"\w* \w wife|strong="H00802"\w* \w Sarah|strong="H08283"\w* \w has borne|strong="H03205"\w* \w [him]|strong="H00113"\w* \w a son|strong="H01121"\w* \w in|strong="H00310"\w* \w her old age|strong="H02209"\w*, \w and [my master] has given|strong="H05414"\w* him \w -|strong="H00853"\w* \w everything he owns|strong="H03605"\w* \w -|strong="H00834"\w*.
\p \v 37 \w My master|strong="H00113"\w* \w made me swear an oath|strong="H07650"\w* \w and said|strong="H00559"\w*, ‘\w You shall not|strong="H03808"\w* \w take|strong="H03947"\w* \w a wife|strong="H00802"\w* \w for my son|strong="H01121"\w* \w from the daughters|strong="H01323"\w* \w of the Canaanites|strong="H03669"\w* \w -|strong="H00834"\w* \w in whose land|strong="H00776"\w* \w I|strong="H00595"\w* \w dwell|strong="H03427"\w*, \v 38 \w but|strong="H00518"\w* \w . . .|strong="H03808"\w* \w you shall go|strong="H01980"\w* \w to|strong="H00413"\w* \w my father’s|strong="H00001"\w* \w house|strong="H01004"\w* \w and to|strong="H00413"\w* \w my kindred|strong="H04940"\w* \w to take|strong="H03947"\w* \w a wife|strong="H00802"\w* \w for my son|strong="H01121"\w*.’
\p \v 39 \w Then I asked|strong="H00559"\w* \w . . .|strong="H00413"\w* \w my master|strong="H00113"\w*, ‘\w What if|strong="H00194"\w* \w the woman|strong="H00802"\w* \w will not|strong="H03808"\w* \w come|strong="H01980"\w* \w back with me|strong="H00310"\w*?’
\p \v 40 \w And he told|strong="H00559"\w* \w me|strong="H00413"\w*, ‘\w The LORD|strong="H03068"\w*, \w before|strong="H06440"\w* \w whom|strong="H00834"\w* \w I have walked|strong="H01980"\w*, \w will send|strong="H07971"\w* \w His angel|strong="H04397"\w* \w with you|strong="H00854"\w* \w and make your journey|strong="H01870"\w* \w a success|strong="H06743"\w*, \w so that you may take|strong="H03947"\w* \w a wife|strong="H00802"\w* \w for my son|strong="H01121"\w* \w from my kindred|strong="H04940"\w* \w and from my father’s|strong="H00001"\w* \w house|strong="H01004"\w*. \v 41 \w And when|strong="H03588"\w* \w you go|strong="H00935"\w* \w to|strong="H00413"\w* \w my kindred|strong="H04940"\w*, \w -|strong="H05352"\w* \w -|strong="H00423"\w* \w if|strong="H00518"\w* \w they refuse to|strong="H03808"\w* \w give her|strong="H05414"\w* to you, \w then|strong="H00227"\w* \w you will be|strong="H01961"\w* \w released|strong="H05355"\w* \w from my oath|strong="H00423"\w*.’
\p \v 42 \w So when I came|strong="H00935"\w* \w to|strong="H00413"\w* \w the spring|strong="H05869"\w* \w today|strong="H03117"\w*, \w I prayed|strong="H00559"\w*: \w O LORD|strong="H03068"\w*, \w God|strong="H00430"\w* \w of my master|strong="H00113"\w* \w Abraham|strong="H00085"\w*, \w if only|strong="H00518"\w* \w You would|strong="H03426"\w* \w . . .|strong="H04994"\w* \w make my journey|strong="H01870"\w* \w -|strong="H00834"\w* \w -|strong="H00595"\w* \w . . .|strong="H01980"\w* \w . . .|strong="H05921"\w* \w a success|strong="H06743"\w*! \v 43 \w Here|strong="H02009"\w* \w I am|strong="H00595"\w*, \w standing|strong="H05324"\w* \w beside|strong="H05921"\w* \w this spring|strong="H05869"\w* \w . . .|strong="H04325"\w*. \w Now [if]|strong="H01961"\w* \w a maiden|strong="H05959"\w* \w comes out|strong="H03318"\w* \w to draw water|strong="H07579"\w* \w and I say|strong="H00559"\w* \w to her|strong="H00413"\w*, ‘\w Please|strong="H04994"\w* \w let me drink|strong="H08248"\w* \w a little|strong="H04592"\w* \w water|strong="H04325"\w* \w from your jar|strong="H03537"\w*,’ \v 44 \w and she replies|strong="H00559"\w* \w . . .|strong="H00413"\w*, ‘\w Drink|strong="H08354"\w*, \w . . .|strong="H01571"\w* \w and I will draw water|strong="H07579"\w* \w for your camels|strong="H01581"\w* \w as well|strong="H01571"\w*,’ \w . . .|strong="H00859"\w* \w may she|strong="H01931"\w* \w be the woman|strong="H00802"\w* \w -|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w has appointed|strong="H03198"\w* \w for my master’s|strong="H00113"\w* \w son|strong="H01121"\w*.
\p \v 45 \w And before|strong="H02962"\w* \w I|strong="H00589"\w* \w had finished|strong="H03615"\w* \w praying|strong="H01696"\w* \w in|strong="H00413"\w* \w my heart|strong="H03820"\w*, \w there|strong="H02009"\w* \w was Rebekah|strong="H07259"\w* \w coming out|strong="H03318"\w* \w with her jar|strong="H03537"\w* \w on|strong="H05921"\w* \w her shoulder|strong="H07926"\w*, \w and she went down|strong="H03381"\w* \w to the spring|strong="H05869"\w* \w and drew water|strong="H07579"\w*. \w So I said|strong="H00559"\w* \w to her|strong="H00413"\w*, ‘\w Please|strong="H04994"\w* \w give me a drink|strong="H08248"\w*.’
