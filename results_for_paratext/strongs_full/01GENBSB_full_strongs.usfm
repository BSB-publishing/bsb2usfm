\s1 The Birth of Perez and Zerah
\p \v 27 \w When the time|strong="H06256"\w* \w came|strong="H01961"\w* \w for [Tamar] to give birth|strong="H03205"\w*, \w there|strong="H02009"\w* \w were twins|strong="H08380"\w* \w in her womb|strong="H00990"\w*. \v 28 \w And|strong="H01961"\w* \w as she was giving birth|strong="H03205"\w*, \w one of them put out|strong="H05414"\w* \w his hand|strong="H03027"\w*; \w so the midwife|strong="H03205"\w* \w took|strong="H03947"\w* \w a scarlet thread|strong="H08144"\w* \w and tied [it]|strong="H07194"\w* \w around|strong="H05921"\w* \w his wrist|strong="H03027"\w*. “\w This|strong="H02088"\w* \w one came out|strong="H03318"\w* \w first|strong="H07223"\w*,” \w she announced|strong="H00559"\w*. \v 29 \w -|strong="H01961"\w* \w But when he pulled his hand|strong="H03027"\w* \w . . .|strong="H02009"\w* \w back|strong="H07725"\w* \w and his brother|strong="H00251"\w* \w came out|strong="H03318"\w*, \w she said|strong="H00559"\w*, \w . . .|strong="H04100"\w* “\w You have broken out first|strong="H06555"\w* \w . . .|strong="H05921"\w* \w . . .|strong="H06556"\w*!” \w So he was named|strong="H07121"\w* \w . . .|strong="H08034"\w* \w Perez|strong="H06557"\w*.\f + \fr 38:29 \fqa Perez \ft means \fqa breaking out\ft .\f* \v 30 \w Then|strong="H00310"\w* \w his brother|strong="H00251"\w* \w came out|strong="H03318"\w* \w with|strong="H00834"\w* \w the scarlet thread|strong="H08144"\w* \w around|strong="H05921"\w* \w his wrist|strong="H03027"\w*, \w and he was named|strong="H07121"\w* \w . . .|strong="H08034"\w* \w Zerah|strong="H02226"\w*.\f + \fr 38:30 \fqa Zerah \ft can mean \fqa scarlet \ft or \fqa brightness\ft .\f*
\c 39
\s1 Joseph and Potiphar’s Wife
\p \v 1 \w Meanwhile, Joseph|strong="H03130"\w* \w had been taken down|strong="H03381"\w* \w to Egypt|strong="H04714"\w*, \w where an Egyptian|strong="H04713"\w* \w named Potiphar|strong="H06318"\w*, \w an officer|strong="H05631"\w* \w of Pharaoh|strong="H06547"\w* \w and captain|strong="H08269"\w* \w of the guard|strong="H02876"\w*, \w . . .|strong="H00376"\w* \w bought him|strong="H07069"\w* \w from|strong="H03027"\w* \w the Ishmaelites|strong="H03459"\w* \w who|strong="H00834"\w* \w had taken him|strong="H03381"\w* \w there|strong="H08033"\w*. \v 2 \w And the LORD|strong="H03068"\w* \w was|strong="H01961"\w* \w with|strong="H00854"\w* \w Joseph|strong="H03130"\w*, \w and he became|strong="H01961"\w* \w a successful|strong="H06743"\w* \w man|strong="H00376"\w*, \w serving|strong="H01961"\w* \w in the household|strong="H01004"\w* \w of his Egyptian|strong="H04713"\w* \w master|strong="H00113"\w*.
\p \v 3 \w When his master|strong="H00113"\w* \w saw|strong="H07200"\w* \w that|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w [was] with him|strong="H00854"\w* \w [and]|strong="H03068"\w* \w made him prosper|strong="H06743"\w* \w . . .|strong="H03027"\w* \w in all|strong="H03605"\w* \w -|strong="H00834"\w* \w he|strong="H01931"\w* \w did|strong="H06213"\w*, \v 4 \w Joseph|strong="H03130"\w* \w found|strong="H04672"\w* \w favor|strong="H02580"\w* \w in his sight|strong="H05869"\w* \w and became his personal attendant|strong="H08334"\w* \w -|strong="H00853"\w*.
\p \w Potiphar put him|strong="H06485"\w* \w in charge of|strong="H05921"\w* \w his household|strong="H01004"\w* \w and entrusted|strong="H05414"\w* . . . \w him|strong="H03027"\w* \w with everything|strong="H03605"\w* \w he owned|strong="H03426"\w*. \v 5 \w . . .|strong="H01961"\w* \w From the time|strong="H00227"\w* \w that he put [Joseph] in charge|strong="H06485"\w* \w -|strong="H00853"\w* \w of his household|strong="H01004"\w* \w and|strong="H05921"\w* \w all|strong="H03605"\w* \w -|strong="H00834"\w* \w he owned|strong="H03426"\w*, - \w the LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w blessed|strong="H01288"\w* \w the Egyptian’s|strong="H04713"\w* \w household|strong="H01004"\w* \w on account of|strong="H01558"\w* \w [him]|strong="H03130"\w*. \w . . .|strong="H01961"\w* \w The LORD’s|strong="H03068"\w* \w blessing|strong="H01293"\w* \w [was] on everything|strong="H03605"\w* \w -|strong="H00834"\w* \w he owned|strong="H03426"\w* . . ., \w both in his house|strong="H01004"\w* \w and in his field|strong="H07704"\w*. \v 6 \w So [Potiphar] left|strong="H05800"\w* \w all|strong="H03605"\w* \w that|strong="H00834"\w* he owned \w in Joseph’s|strong="H03130"\w* \w care|strong="H03027"\w*; \w he did not|strong="H03808"\w* \w concern himself|strong="H03045"\w* \w . . .|strong="H00854"\w* \w with anything|strong="H03972"\w* \w except|strong="H03588"\w* \w . . .|strong="H00518"\w* \w the food|strong="H03899"\w* \w -|strong="H00834"\w* \w he|strong="H01931"\w* \w ate|strong="H00398"\w*.
\p \w Now Joseph|strong="H03130"\w* \w was|strong="H01961"\w* \w well-built|strong="H03303"\w* \w . . .|strong="H08389"\w* \w and handsome|strong="H03303"\w* \w . . .|strong="H04758"\w*, \v 7 \w and|strong="H01961"\w* \w after some time|strong="H00310"\w* \w . . .|strong="H01697"\w* \w . . .|strong="H00428"\w* \w his master’s|strong="H00113"\w* \w -|strong="H00853"\w* \w wife|strong="H00802"\w* \w cast|strong="H05375"\w* \w her eyes|strong="H05869"\w* \w upon|strong="H00413"\w* \w Joseph|strong="H03130"\w* \w and said|strong="H00559"\w*, “\w Sleep|strong="H07901"\w* \w with me|strong="H05973"\w*.”
\p \v 8 \w But he refused|strong="H03985"\w*. “\w Look|strong="H02005"\w*,” \w he said|strong="H00559"\w* \w to|strong="H00413"\w* \w his master’s|strong="H00113"\w* \w wife|strong="H00802"\w*, “\w with me here|strong="H00854"\w*, \w my master|strong="H00113"\w* \w does not|strong="H03808"\w* \w concern himself|strong="H03045"\w* \w with anything|strong="H04100"\w* \w in his house|strong="H01004"\w*, \w and he has entrusted|strong="H05414"\w* \w everything|strong="H03605"\w* \w -|strong="H00834"\w* \w he owns|strong="H03426"\w* to \w my care|strong="H03027"\w*. \v 9 \w No|strong="H00369"\w* \w one in this|strong="H02088"\w* \w house|strong="H01004"\w* \w is greater|strong="H01419"\w* \w than I am|strong="H04480"\w*. \w He has withheld|strong="H02820"\w* \w nothing|strong="H03808"\w* \w . . .|strong="H03972"\w* \w from me|strong="H04480"\w* \w except|strong="H03588"\w* \w you|strong="H00518"\w*, \w -|strong="H00853"\w* \w because|strong="H00834"\w* \w you|strong="H00859"\w* \w are his wife|strong="H00802"\w*. \w So how|strong="H00349"\w* \w could I do|strong="H06213"\w* \w such|strong="H02063"\w* \w a great|strong="H01419"\w* \w evil|strong="H07451"\w* \w and sin|strong="H02398"\w* \w against God|strong="H00430"\w*?”
\p \v 10 \w Although|strong="H01961"\w* \w [Potiphar’s wife] spoke|strong="H01696"\w* \w to|strong="H00413"\w* \w Joseph|strong="H03130"\w* \w day|strong="H03117"\w* \w after day|strong="H03117"\w*, \w he refused|strong="H03808"\w* \w . . .|strong="H08085"\w* \w . . .|strong="H00413"\w* \w to go to bed|strong="H07901"\w* \w with her|strong="H00681"\w* \w [or even] be|strong="H01961"\w* \w near her|strong="H05973"\w*. \v 11 \w One day|strong="H03117"\w* \w . . .|strong="H02088"\w*, \w however|strong="H01961"\w*, \w [Joseph] went|strong="H00935"\w* \w into the house|strong="H01004"\w* \w to attend to|strong="H06213"\w* \w his work|strong="H04399"\w*, \w and not|strong="H00369"\w* \w a single|strong="H00376"\w* \w household|strong="H01004"\w* \w servant|strong="H00582"\w* \w [was]|strong="H08033"\w* \w inside|strong="H01004"\w*. \v 12 \w She grabbed [Joseph]|strong="H08610"\w* \w by his cloak|strong="H00899"\w* \w and said|strong="H00559"\w*, “\w Sleep|strong="H07901"\w* \w with me|strong="H05973"\w*!” \w But leaving|strong="H05800"\w* \w his cloak|strong="H00899"\w* \w in her hand|strong="H03027"\w*, \w he escaped|strong="H05127"\w* \w and ran|strong="H03318"\w* \w outside|strong="H02351"\w*.
\s1 Joseph Falsely Imprisoned
\p \v 13 \w -|strong="H01961"\w* \w When she saw|strong="H07200"\w* \w that|strong="H03588"\w* \w he had left|strong="H05800"\w* \w his cloak|strong="H00899"\w* \w in her hand|strong="H03027"\w* \w and had run|strong="H05127"\w* \w out [of the house]|strong="H02351"\w*, \v 14 \w she called|strong="H07121"\w* \w her household|strong="H01004"\w* \w servants|strong="H00582"\w*. “\w Look|strong="H07200"\w*,” \w she said|strong="H00559"\w*, \w -|strong="H00559"\w* “\w this Hebrew|strong="H05680"\w* \w . . .|strong="H00376"\w* \w has been brought|strong="H00935"\w* to us \w to make sport|strong="H06711"\w* of us. \w He came|strong="H00935"\w* \w to me|strong="H00413"\w* \w so he could sleep|strong="H07901"\w* \w with me|strong="H05973"\w*, \w but I screamed|strong="H07121"\w* \w as loud|strong="H06963"\w* \w as I could|strong="H01419"\w*. \v 15 \w -|strong="H01961"\w* \w When he heard me|strong="H08085"\w* \w . . .|strong="H03588"\w* \w scream for help|strong="H07311"\w* \w . . .|strong="H06963"\w*, \w . . .|strong="H07121"\w* \w he left|strong="H05800"\w* \w his cloak|strong="H00899"\w* \w beside me|strong="H00681"\w* \w and ran|strong="H05127"\w* \w . . .|strong="H03318"\w* \w out [of the house]|strong="H02351"\w*.”
\p \v 16 \w So [Potiphar’s wife] kept|strong="H05117"\w* \w Joseph’s cloak|strong="H00899"\w* \w beside her|strong="H00681"\w* \w until|strong="H05704"\w* \w his master|strong="H00113"\w* \w . . .|strong="H00413"\w* \w came|strong="H00935"\w* \w home|strong="H01004"\w*. \v 17 \w Then she told him|strong="H01696"\w* \w . . .|strong="H00413"\w* \w the same|strong="H00428"\w* \w . . .|strong="H00559"\w* \w story|strong="H01697"\w*: “\w The Hebrew|strong="H05680"\w* \w -|strong="H00834"\w* \w slave|strong="H05650"\w* \w you brought|strong="H00935"\w* \w us|strong="H00413"\w* \w came|strong="H00935"\w* to me \w to make sport|strong="H06711"\w* of me, \v 18 \w -|strong="H01961"\w* \w but when I screamed for help|strong="H07311"\w* \w . . .|strong="H06963"\w*, \w . . .|strong="H07121"\w* \w he left|strong="H05800"\w* \w his cloak|strong="H00899"\w* \w beside me|strong="H00681"\w* \w and ran|strong="H05127"\w* \w out [of the house]|strong="H02351"\w*.”
\p \v 19 \w When|strong="H01961"\w* \w his master|strong="H00113"\w* \w -|strong="H00853"\w* \w heard|strong="H08085"\w* \w the story|strong="H01697"\w* \w his wife|strong="H00802"\w* \w -|strong="H00834"\w* \w told|strong="H01696"\w* \w him|strong="H00413"\w*, \w saying|strong="H00559"\w*, “\w This|strong="H00428"\w* \w is what|strong="H01697"\w* \w your slave|strong="H05650"\w* \w did|strong="H06213"\w* to me,” \w he burned|strong="H02734"\w* \w with anger|strong="H00639"\w*. \v 20 \w So Joseph’s|strong="H03130"\w* \w master|strong="H00113"\w* \w took|strong="H03947"\w* \w him|strong="H00853"\w* \w and had him thrown|strong="H05414"\w* \w into|strong="H00413"\w* \w the prison|strong="H01004"\w* \w . . .|strong="H05470"\w* \w where|strong="H04725"\w* \w -|strong="H00834"\w* \w the king’s|strong="H04428"\w* \w prisoners|strong="H00631"\w* \w were confined|strong="H00631"\w*.
\p \w While [Joseph] was|strong="H01961"\w* \w there|strong="H08033"\w* \w in the prison|strong="H01004"\w* \w . . .|strong="H05470"\w*, \v 21 \w the LORD|strong="H03068"\w* \w was|strong="H01961"\w* \w with|strong="H00854"\w* \w [him]|strong="H03130"\w* \w and extended|strong="H05186"\w* \w kindness|strong="H02617"\w* \w to him|strong="H00413"\w*, \w granting him|strong="H05414"\w* \w favor|strong="H02580"\w* \w in the eyes|strong="H05869"\w* \w of the prison|strong="H01004"\w* \w . . .|strong="H05470"\w* \w warden|strong="H08269"\w*. \v 22 \w And the warden|strong="H08269"\w* \w . . .|strong="H01004"\w* \w . . .|strong="H05470"\w* \w put|strong="H05414"\w* \w all|strong="H03605"\w* \w the prisoners|strong="H00615"\w* \w . . .|strong="H00834"\w* \w -|strong="H00853"\w* \w under Joseph’s|strong="H03130"\w* \w -|strong="H00853"\w* \w care|strong="H03027"\w*, \w so that he|strong="H01931"\w* \w was|strong="H01961"\w* \w responsible|strong="H06213"\w* \w for all|strong="H03605"\w* \w that|strong="H00834"\w* \w was done|strong="H06213"\w* \w -|strong="H08033"\w* \w in|strong="H01004"\w* \w the prison|strong="H05470"\w*. \v 23 \w The warden|strong="H08269"\w* \w . . .|strong="H01004"\w* \w . . .|strong="H05470"\w* \w -|strong="H00853"\w* \w did not|strong="H00369"\w* \w concern himself|strong="H07200"\w* \w with anything|strong="H03605"\w* \w . . .|strong="H03972"\w* \w under Joseph’s care|strong="H03027"\w*, \w because|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w was with [Joseph]|strong="H00854"\w* \w -|strong="H03068"\w* \w and gave him success|strong="H06743"\w* \w in whatever|strong="H00834"\w* \w he|strong="H01931"\w* \w did|strong="H06213"\w*.
\c 40
\s1 The Cupbearer and the Baker
\p \v 1 \w -|strong="H01961"\w* \w Some time later|strong="H00310"\w* \w . . .|strong="H01697"\w* \w . . .|strong="H00428"\w*, \w -|strong="H04714"\w* \w the king’s|strong="H04428"\w* \w cupbearer|strong="H04945"\w* \w and baker|strong="H00644"\w* \w offended|strong="H02398"\w* \w their master|strong="H00113"\w*, \w the king|strong="H04428"\w* \w of Egypt|strong="H04714"\w*. \v 2 \w Pharaoh|strong="H06547"\w* \w was angry|strong="H07107"\w* \w with|strong="H05921"\w* \w his two|strong="H08147"\w* \w officers|strong="H05631"\w*, \w . . .|strong="H05921"\w* \w the chief|strong="H08269"\w* \w cupbearer|strong="H04945"\w* \w . . .|strong="H05921"\w* \w and the chief|strong="H08269"\w* \w baker|strong="H00644"\w*, \v 3 \w and imprisoned them|strong="H05414"\w* \w -|strong="H00853"\w* \w -|strong="H04929"\w* \w in the house|strong="H01004"\w* \w of the captain|strong="H08269"\w* \w of the guard|strong="H02876"\w*, \w the same prison|strong="H01004"\w* \w . . .|strong="H05470"\w* \w . . .|strong="H00413"\w* \w . . .|strong="H04725"\w* \w where|strong="H00834"\w* \w Joseph|strong="H03130"\w* \w was confined|strong="H00631"\w* \w . . .|strong="H08033"\w*. \v 4 \w The captain|strong="H08269"\w* \w of the guard|strong="H02876"\w* \w -|strong="H00853"\w* \w assigned|strong="H06485"\w* \w them|strong="H00854"\w* \w to Joseph|strong="H03130"\w*, \w and he became their personal attendant|strong="H08334"\w*. \w -|strong="H00853"\w*
\p \w After they had been|strong="H01961"\w* \w in custody|strong="H04929"\w* \w for some time|strong="H03117"\w*, \v 5 \w both|strong="H08147"\w* \w of these men|strong="H00376"\w* — \w the Egyptian|strong="H04714"\w* \w -|strong="H00834"\w* \w king’s|strong="H04428"\w* \w cupbearer|strong="H04945"\w* \w and baker|strong="H00644"\w*, \w who|strong="H00834"\w* \w were being held|strong="H00631"\w* \w in the prison|strong="H01004"\w* \w . . .|strong="H05470"\w* — \w had a dream|strong="H02492"\w* \w . . .|strong="H02472"\w* \w . . .|strong="H02472"\w* \w on the same|strong="H00259"\w* \w . . .|strong="H00376"\w* \w night|strong="H03915"\w*, \w and each dream|strong="H02472"\w* \w had its own meaning|strong="H06623"\w*.
\p \v 6 \w When Joseph|strong="H03130"\w* \w came|strong="H00935"\w* \w to them|strong="H00413"\w* \w in the morning|strong="H01242"\w*, \w he saw|strong="H07200"\w* \w -|strong="H00853"\w* \w -|strong="H02005"\w* \w that they were distraught|strong="H02196"\w*. \v 7 \w So he asked|strong="H07592"\w* \w -|strong="H00853"\w* \w the officials|strong="H05631"\w* \w of Pharaoh|strong="H06547"\w* \w who|strong="H00834"\w* \w were in custody|strong="H04929"\w* \w with him|strong="H00854"\w* \w in his master’s|strong="H00113"\w* \w . . .|strong="H00559"\w* \w house|strong="H01004"\w*, “\w Why|strong="H04069"\w* \w are your faces|strong="H06440"\w* \w so downcast|strong="H07451"\w* \w today|strong="H03117"\w*?”
\p \v 8 “\w We both had dreams|strong="H02472"\w* \w . . .|strong="H02492"\w*,” \w they replied|strong="H00559"\w* \w . . .|strong="H00413"\w*, “\w but there is no one|strong="H00369"\w* \w -|strong="H00853"\w* \w to interpret them|strong="H06622"\w*.”
\p \w Then Joseph|strong="H03130"\w* \w said|strong="H00559"\w* \w to them|strong="H00413"\w*, “\w Don’t|strong="H03808"\w* \w interpretations|strong="H06623"\w* \w belong to God|strong="H00430"\w*? \w Tell me your dreams|strong="H05608"\w* \w . . .|strong="H04994"\w*.”
\p \v 9 \w So the chief|strong="H08269"\w* \w cupbearer|strong="H04945"\w* \w -|strong="H00853"\w* \w told|strong="H05608"\w* \w Joseph|strong="H03130"\w* \w his dream|strong="H02472"\w* \w . . .|strong="H00559"\w*: “\w In my dream|strong="H02472"\w* \w there|strong="H02009"\w* \w was a vine|strong="H01612"\w* \w before me|strong="H06440"\w*, \v 10 \w and on the vine|strong="H01612"\w* \w were three|strong="H07969"\w* \w branches|strong="H08299"\w*. \w As it|strong="H01931"\w* \w budded|strong="H06524"\w*, \w its blossoms|strong="H05322"\w* \w opened|strong="H05927"\w* \w and its clusters|strong="H00811"\w* \w ripened|strong="H01310"\w* \w into grapes|strong="H06025"\w*. \v 11 \w Pharaoh’s|strong="H06547"\w* \w cup|strong="H03563"\w* \w was in my hand|strong="H03027"\w*, \w and I took|strong="H03947"\w* \w -|strong="H00853"\w* \w the grapes|strong="H06025"\w*, \w squeezed|strong="H07818"\w* \w them|strong="H00853"\w* \w into|strong="H00413"\w* \w [his]|strong="H06547"\w* \w cup|strong="H03563"\w*, \w and placed|strong="H05414"\w* \w -|strong="H00853"\w* \w the cup|strong="H03563"\w* \w in|strong="H05921"\w* \w [his]|strong="H06547"\w* \w hand|strong="H03709"\w*.”
\p \v 12 \w Joseph|strong="H03130"\w* \w replied|strong="H00559"\w* . . ., “\w This [is]|strong="H02088"\w* \w the interpretation|strong="H06623"\w*: \w The three|strong="H07969"\w* \w branches|strong="H08299"\w* \w are three|strong="H07969"\w* \w days|strong="H03117"\w* \w . . .|strong="H01992"\w*. \v 13 \w Within|strong="H05750"\w* \w three|strong="H07969"\w* \w days|strong="H03117"\w* \w Pharaoh|strong="H06547"\w* \w -|strong="H00853"\w* \w will lift up|strong="H05375"\w* \w your head|strong="H07218"\w* \w and restore|strong="H07725"\w* \w your|strong="H05921"\w* \w position|strong="H03653"\w*. \w You will put|strong="H05414"\w* \w Pharaoh’s|strong="H06547"\w* \w cup|strong="H03563"\w* \w in his hand|strong="H03027"\w*, \w just as|strong="H04639"\w* \w you did|strong="H07223"\w* \w when|strong="H00834"\w* \w you were|strong="H01961"\w* \w his cupbearer|strong="H04945"\w*. \v 14 \w But|strong="H03588"\w* \w . . .|strong="H00518"\w* \w when|strong="H00834"\w* \w it goes well|strong="H03190"\w* for you, \w please|strong="H04994"\w* \w remember|strong="H02142"\w* \w me|strong="H00854"\w* \w and show|strong="H06213"\w* \w me|strong="H05978"\w* \w kindness|strong="H02617"\w* \w by mentioning me|strong="H02142"\w* \w to|strong="H00413"\w* \w Pharaoh|strong="H06547"\w*, \w that he might bring me out|strong="H03318"\w* \w of|strong="H04480"\w* \w this|strong="H02088"\w* \w prison|strong="H01004"\w*. \v 15 \w For|strong="H03588"\w* \w I was kidnapped|strong="H01589"\w* \w . . .|strong="H01589"\w* \w from the land|strong="H00776"\w* \w of the Hebrews|strong="H05680"\w*, \w and even|strong="H01571"\w* \w here|strong="H06311"\w* \w I have done|strong="H06213"\w* \w nothing|strong="H03808"\w* \w . . .|strong="H03972"\w* \w for which|strong="H03588"\w* \w they should have put|strong="H07760"\w* \w me|strong="H00853"\w* \w in this dungeon|strong="H00953"\w*.”
\p \v 16 \w When the chief|strong="H08269"\w* \w baker|strong="H00644"\w* \w saw|strong="H07200"\w* \w that|strong="H03588"\w* \w the interpretation|strong="H06622"\w* \w was favorable|strong="H02896"\w*, \w he said|strong="H00559"\w* \w to|strong="H00413"\w* \w Joseph|strong="H03130"\w*, “\w I|strong="H00589"\w* \w too|strong="H00637"\w* \w had a dream|strong="H02472"\w*: \w There were|strong="H02009"\w* \w three|strong="H07969"\w* \w baskets|strong="H05536"\w* \w of white bread|strong="H02751"\w* \w on|strong="H05921"\w* \w my head|strong="H07218"\w*. \v 17 \w In the top|strong="H05945"\w* \w basket|strong="H05536"\w* \w were all sorts of|strong="H03605"\w* \w baked|strong="H00644"\w* \w goods|strong="H03978"\w* \w for Pharaoh|strong="H06547"\w*, \w . . .|strong="H04639"\w* \w but the birds|strong="H05775"\w* \w were eating|strong="H00398"\w* \w them|strong="H00853"\w* \w out of|strong="H04480"\w* \w the basket|strong="H05536"\w* \w on|strong="H05921"\w* \w my head|strong="H07218"\w*.”
\p \v 18 \w Joseph|strong="H03130"\w* \w . . .|strong="H00559"\w* \w replied|strong="H06030"\w*, “\w This|strong="H02088"\w* \w is the interpretation|strong="H06623"\w*: \w The three|strong="H07969"\w* \w baskets|strong="H05536"\w* \w are three|strong="H07969"\w* \w days|strong="H03117"\w* \w . . .|strong="H01992"\w*. \v 19 \w Within|strong="H05750"\w* \w three|strong="H07969"\w* \w days|strong="H03117"\w* \w Pharaoh|strong="H06547"\w* \w -|strong="H00853"\w* \w will lift off|strong="H05375"\w* \w your head|strong="H07218"\w* \w . . .|strong="H05921"\w* \w and hang|strong="H08518"\w* \w you|strong="H00853"\w* \w on|strong="H05921"\w* \w a tree|strong="H06086"\w*.\f + \fr 40:19 \ft Or \fqa and impale you on a pole\ft ; similarly in verse 22\f* \w Then the birds|strong="H05775"\w* \w -|strong="H00853"\w* \w will eat|strong="H00398"\w* \w the flesh|strong="H01320"\w* \w of your body|strong="H05921"\w*.”
\p \v 20 \w -|strong="H01961"\w* \w On the third|strong="H07992"\w* \w day|strong="H03117"\w*, \w which was Pharaoh’s|strong="H06547"\w* \w birthday|strong="H03117"\w* \w . . .|strong="H03205"\w*, \w -|strong="H00853"\w* \w he held|strong="H06213"\w* \w a feast|strong="H04960"\w* \w for all|strong="H03605"\w* \w his officials|strong="H05650"\w*, \w and in|strong="H08432"\w* \w [their presence]|strong="H05650"\w* \w he lifted up|strong="H05375"\w* \w -|strong="H00853"\w* \w the heads|strong="H07218"\w* \w of the chief|strong="H08269"\w* \w cupbearer|strong="H04945"\w* \w -|strong="H00853"\w* \w -|strong="H07218"\w* \w and the chief|strong="H08269"\w* \w baker|strong="H00644"\w*. \v 21 \w Pharaoh restored|strong="H07725"\w* \w -|strong="H00853"\w* \w the chief|strong="H08269"\w* \w cupbearer|strong="H04945"\w* \w to|strong="H05921"\w* \w his position|strong="H04945"\w*, \w so that he once again placed|strong="H05414"\w* \w the cup|strong="H03563"\w* \w in|strong="H05921"\w* \w Pharaoh’s|strong="H06547"\w* \w hand|strong="H03709"\w*. \v 22 \w But|strong="H00853"\w* \w Pharaoh hanged|strong="H08518"\w* \w the chief|strong="H08269"\w* \w baker|strong="H00644"\w*, \w just as|strong="H00834"\w* \w Joseph|strong="H03130"\w* \w had described|strong="H06622"\w* to them {in his interpretation}.\f + \fr 40:22 \ft Literally \fqa had interpreted to them\f*
\p \v 23 \w The chief|strong="H08269"\w* \w cupbearer|strong="H04945"\w*, \w -|strong="H00853"\w* \w however, did not|strong="H03808"\w* \w remember|strong="H02142"\w* \w Joseph|strong="H03130"\w*; \w he forgot all about him|strong="H07911"\w*.
\c 41
\s1 The Dreams of Pharaoh
\p \v 1 \w After|strong="H01961"\w* \w two full years|strong="H08141"\w* \w . . .|strong="H03117"\w* \w had passed|strong="H07093"\w*, \w Pharaoh|strong="H06547"\w* \w had a dream|strong="H02492"\w*: \w . . .|strong="H02009"\w* \w He was standing|strong="H05975"\w* \w beside|strong="H05921"\w* \w the Nile|strong="H02975"\w*, \v 2 \w -|strong="H02009"\w* \w when seven|strong="H07651"\w* \w cows|strong="H06510"\w*, \w sleek|strong="H03303"\w* \w . . .|strong="H04758"\w* \w and well-fed|strong="H01277"\w* \w . . .|strong="H01320"\w*, \w came up|strong="H05927"\w* \w from|strong="H04480"\w* \w the river|strong="H02975"\w* \w and began to graze|strong="H07462"\w* \w among the reeds|strong="H00260"\w*. \v 3 \w -|strong="H02009"\w* \w After them|strong="H00310"\w*, \w seven|strong="H07651"\w* \w other|strong="H00312"\w* \w cows|strong="H06510"\w*, \w sickly|strong="H07451"\w* \w . . .|strong="H04758"\w* \w and thin|strong="H01851"\w* \w . . .|strong="H01320"\w*, \w came up|strong="H05927"\w* \w from|strong="H04480"\w* \w the Nile|strong="H02975"\w* \w and stood|strong="H05975"\w* \w beside|strong="H00681"\w* \w the [well-fed] cows|strong="H06510"\w* \w on|strong="H05921"\w* \w the bank|strong="H08193"\w* \w of the river|strong="H02975"\w*. \v 4 \w And the cows|strong="H06510"\w* \w [that were] sickly|strong="H07451"\w* \w . . .|strong="H04758"\w* \w and thin|strong="H01851"\w* \w . . .|strong="H01320"\w* \w -|strong="H00853"\w* \w devoured|strong="H00398"\w* \w the seven|strong="H07651"\w* \w sleek|strong="H03303"\w* \w . . .|strong="H04758"\w*, \w well-fed|strong="H01277"\w* \w cows|strong="H06510"\w*.
\p \w Then Pharaoh|strong="H06547"\w* \w woke up|strong="H03364"\w*, \v 5 \w but he fell back asleep|strong="H03462"\w* \w and dreamed|strong="H02492"\w* \w a second time|strong="H08145"\w*: \w . . .|strong="H02009"\w* \w Seven|strong="H07651"\w* \w heads of grain|strong="H07641"\w*, \w plump|strong="H01277"\w* \w and ripe|strong="H02896"\w*, \w came up|strong="H05927"\w* \w on one|strong="H00259"\w* \w stalk|strong="H07070"\w*. \v 6 \w -|strong="H02009"\w* \w After them|strong="H00310"\w*, \w seven other|strong="H07651"\w* \w heads of grain|strong="H07641"\w* \w sprouted|strong="H06779"\w*, \w thin|strong="H01851"\w* \w and scorched|strong="H07710"\w* \w by the east wind|strong="H06921"\w*. \v 7 \w And the thin|strong="H01851"\w* \w -|strong="H00853"\w* \w heads of grain|strong="H07641"\w* \w swallowed up|strong="H01104"\w* \w the seven|strong="H07651"\w* \w plump|strong="H01277"\w*, \w ripe|strong="H04392"\w* \w ones|strong="H07641"\w*. \w Then Pharaoh|strong="H06547"\w* \w awoke|strong="H03364"\w* \w and realized|strong="H02009"\w* \w it was a dream|strong="H02472"\w*.
\p \v 8 \w In the morning|strong="H01242"\w* \w . . .|strong="H01961"\w* \w his spirit|strong="H07307"\w* \w was troubled|strong="H06470"\w*, \w so he summoned|strong="H07971"\w* \w . . .|strong="H07121"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the magicians|strong="H02748"\w* \w and|strong="H03605"\w* \w wise men|strong="H02450"\w* \w of Egypt|strong="H04714"\w*. \w -|strong="H00853"\w* \w Pharaoh|strong="H06547"\w* \w told|strong="H05608"\w* them \w -|strong="H00853"\w* \w his dreams|strong="H02472"\w*, \w but no one|strong="H00369"\w* \w could interpret|strong="H06622"\w* \w them|strong="H00853"\w* \w for him|strong="H06547"\w*.
