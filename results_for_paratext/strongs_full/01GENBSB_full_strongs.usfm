\s1 The Sons of Nahor
\p \v 20 \w Some time later|strong="H01961"\w* \w . . .|strong="H00310"\w* \w . . .|strong="H00428"\w* \w . . .|strong="H01697"\w*, \w Abraham|strong="H00085"\w* \w . . .|strong="H00559"\w* \w . . .|strong="H02009"\w* \w was told|strong="H05046"\w*, “\w Milcah|strong="H04435"\w* \w has also|strong="H01571"\w* \w . . .|strong="H01931"\w* \w borne|strong="H03205"\w* \w sons|strong="H01121"\w* \w to your brother|strong="H00251"\w* \w Nahor|strong="H05152"\w*: \v 21 \w -|strong="H00853"\w* \w Uz|strong="H05780"\w* \w the firstborn|strong="H01060"\w*, \w -|strong="H00853"\w* \w his brother|strong="H00251"\w* \w -|strong="H00853"\w* \w Buz|strong="H00938"\w*, \w Kemuel|strong="H07055"\w* (\w the father|strong="H00001"\w* \w of Aram|strong="H00758"\w*), \v 22 \w -|strong="H00853"\w* \w Chesed|strong="H03777"\w*, \w -|strong="H00853"\w* \w Hazo|strong="H02375"\w*, \w -|strong="H00853"\w* \w Pildash|strong="H06394"\w*, \w -|strong="H00853"\w* \w Jidlaph|strong="H03044"\w*, \w -|strong="H00853"\w* \w and Bethuel|strong="H01328"\w*.”
\p \v 23 \w And Bethuel|strong="H01328"\w* \w became the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Rebekah|strong="H07259"\w*. \w Milcah|strong="H04435"\w* \w bore|strong="H03205"\w* \w these|strong="H00428"\w* \w eight [sons]|strong="H08083"\w* \w to Abraham’s|strong="H00085"\w* \w brother|strong="H00251"\w* \w Nahor|strong="H05152"\w*. \v 24 \w Moreover|strong="H01571"\w*, \w [Nahor’s] concubine|strong="H06370"\w*, \w whose name|strong="H08034"\w* \w was Reumah|strong="H07208"\w*, \w . . .|strong="H01931"\w* \w -|strong="H00853"\w* \w bore|strong="H03205"\w* \w Tebah|strong="H02875"\w*, \w -|strong="H00853"\w* \w Gaham|strong="H01514"\w*, \w -|strong="H00853"\w* \w Tahash|strong="H08477"\w*, \w -|strong="H00853"\w* \w and Maacah|strong="H04601"\w*.
\c 23
\s1 The Death and Burial of Sarah
\p \v 1 \w Now|strong="H01961"\w* \w Sarah|strong="H08283"\w* \w lived to be|strong="H02416"\w* \w 127|strong="H03967"\w* \w . . .|strong="H06242"\w* \w . . .|strong="H07651"\w* \w . . .|strong="H08141"\w* \w . . .|strong="H08141"\w* \w years|strong="H08141"\w* \w old|strong="H08141"\w* \w . . .|strong="H08283"\w* \w . . .|strong="H02416"\w*. \v 2 \w [She]|strong="H08283"\w* \w died|strong="H04191"\w* \w vvv|strong="H07153"\w* \w in Kiriath-arba|strong="H07153"\w* \w (that is|strong="H01931"\w*, \w Hebron)|strong="H02275"\w* \w in the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*, \w and Abraham|strong="H00085"\w* \w went out|strong="H00935"\w* \w to mourn|strong="H05594"\w* \w and to weep|strong="H01058"\w* \w for [her]|strong="H08283"\w*.
