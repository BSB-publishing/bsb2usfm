\p \v 16 \w When the news|strong="H06963"\w* \w reached|strong="H08085"\w* \w Pharaoh’s|strong="H06547"\w* \w . . .|strong="H00559"\w* \w house|strong="H01004"\w* \w that Joseph’s|strong="H03130"\w* \w brothers|strong="H00251"\w* \w had come|strong="H00935"\w*, \w Pharaoh|strong="H06547"\w* \w . . .|strong="H05869"\w* \w and his servants|strong="H05650"\w* \w were pleased|strong="H03190"\w* \w . . .|strong="H05869"\w*.
