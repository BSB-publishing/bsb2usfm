\p \v 26 \w And Joktan|strong="H03355"\w* \w was the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Almodad|strong="H00486"\w*, \w -|strong="H00853"\w* \w Sheleph|strong="H08026"\w*, \w -|strong="H00853"\w* \w Hazarmaveth|strong="H02700"\w*, \w -|strong="H00853"\w* \w Jerah|strong="H03392"\w*, \v 27 \w -|strong="H00853"\w* \w Hadoram|strong="H01913"\w*, \w -|strong="H00853"\w* \w Uzal|strong="H00187"\w*, \w -|strong="H00853"\w* \w Diklah|strong="H01853"\w*, \v 28 \w -|strong="H00853"\w* \w Obal|strong="H05745"\w*, \w -|strong="H00853"\w* \w Abimael|strong="H00039"\w*, \w -|strong="H00853"\w* \w Sheba|strong="H07614"\w*, \v 29 \w -|strong="H00853"\w* \w Ophir|strong="H00211"\w*, \w -|strong="H00853"\w* \w Havilah|strong="H02341"\w*, \w -|strong="H00853"\w* \w and Jobab|strong="H03103"\w*. \w All|strong="H03605"\w* \w these|strong="H00428"\w* \w [were] sons|strong="H01121"\w* \w of Joktan|strong="H03355"\w*. \v 30 \w -|strong="H01961"\w* \w Their territory|strong="H04186"\w* \w extended from|strong="H00935"\w* \w Mesha|strong="H04852"\w* \w to Sephar|strong="H05611"\w*, \w in the eastern|strong="H06924"\w* \w hill country|strong="H02022"\w*.
\p \v 31 \w These|strong="H00428"\w* \w are the sons|strong="H01121"\w* \w of Shem|strong="H08035"\w*, \w according to their clans|strong="H04940"\w*, \w languages|strong="H03956"\w*, \w lands|strong="H00776"\w*, \w and nations|strong="H01471"\w*.
\p \v 32 \w All these|strong="H00428"\w* \w are the clans|strong="H04940"\w* \w of Noah’s|strong="H05146"\w* \w sons|strong="H01121"\w*, \w according to their generations|strong="H08435"\w* \w and nations|strong="H01471"\w*. \w From these|strong="H00428"\w* \w the nations|strong="H01471"\w* \w of the earth|strong="H00776"\w* \w spread out|strong="H06504"\w* \w after|strong="H00310"\w* \w the flood|strong="H03999"\w*.
\c 11
\s1 The Tower of Babel
\p \v 1 \w Now the whole|strong="H03605"\w* \w world|strong="H00776"\w* \w had|strong="H01961"\w* \w one|strong="H00259"\w* \w language|strong="H08193"\w* \w and a common|strong="H00259"\w* \w form of speech|strong="H01697"\w*. \v 2 \w And|strong="H01961"\w* \w as people journeyed|strong="H05265"\w* \w eastward|strong="H06924"\w*,\f + \fr 11:2 \ft Or \fqa from the east \ft or \fqa in the east\f* \w they found|strong="H04672"\w* \w a plain|strong="H01237"\w* \w in the land|strong="H00776"\w* \w of Shinar|strong="H08152"\w*\f + \fr 11:2 \ft That is, Babylonia\f* \w and settled|strong="H03427"\w* \w there|strong="H08033"\w*.
\p \v 3 \w And they said|strong="H00559"\w* \w to|strong="H00413"\w* \w one|strong="H00376"\w* \w another|strong="H07453"\w*, “\w Come|strong="H03051"\w*, \w let us make|strong="H03835"\w* \w bricks|strong="H03843"\w* \w and bake them|strong="H08313"\w* \w thoroughly|strong="H08316"\w*.” \w So they used|strong="H01961"\w* - \w brick|strong="H03843"\w* \w instead of stone|strong="H00068"\w*, \w and tar|strong="H02564"\w* \w -|strong="H01961"\w* - \w instead of mortar|strong="H02563"\w*.
\p \v 4 “\w Come|strong="H03051"\w*,” \w they said|strong="H00559"\w*, “\w let us build|strong="H01129"\w* for ourselves \w a city|strong="H05892"\w* \w with a tower|strong="H04026"\w* \w that reaches|strong="H07218"\w* \w to the heavens|strong="H08064"\w*, \w that we may make|strong="H06213"\w* \w a name|strong="H08034"\w* for ourselves \w and not|strong="H06435"\w* \w be scattered|strong="H06327"\w* \w over|strong="H05921"\w* \w the face|strong="H06440"\w* \w of all|strong="H03605"\w* \w the earth|strong="H00776"\w*.”
\p \v 5 \w Then the LORD|strong="H03068"\w* \w came down|strong="H03381"\w* \w to see|strong="H07200"\w* \w -|strong="H00853"\w* \w the city|strong="H05892"\w* \w -|strong="H00853"\w* \w and the tower|strong="H04026"\w* \w that|strong="H00834"\w* \w the sons|strong="H01121"\w* \w of men|strong="H00120"\w* \w were building|strong="H01129"\w*. \v 6 \w And the LORD|strong="H03068"\w* \w said|strong="H00559"\w*, “\w If|strong="H02005"\w* \w they have begun|strong="H02490"\w* \w to do|strong="H06213"\w* \w this|strong="H02088"\w* \w as one|strong="H00259"\w* \w people|strong="H05971"\w* \w speaking the same|strong="H03605"\w* \w . . .|strong="H00259"\w* \w language|strong="H08193"\w*, \w then|strong="H06258"\w* \w nothing|strong="H03808"\w* \w . . .|strong="H03605"\w* \w -|strong="H00834"\w* \w they devise|strong="H02161"\w* \w . . .|strong="H06213"\w* \w will be beyond|strong="H01219"\w* them. \v 7 \w Come|strong="H03051"\w*, \w let Us go down|strong="H03381"\w* \w . . .|strong="H08033"\w* \w and confuse|strong="H01101"\w* \w their language|strong="H08193"\w*, \w so that|strong="H00834"\w* \w they will not|strong="H03808"\w* \w understand|strong="H08085"\w* \w one|strong="H00376"\w* \w another’s|strong="H07453"\w* \w speech|strong="H08193"\w*.”
\p \v 8 \w So the LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w scattered them|strong="H06327"\w* \w from there|strong="H08033"\w* \w over|strong="H05921"\w* \w the face|strong="H06440"\w* \w of all|strong="H03605"\w* \w the earth|strong="H00776"\w*, \w and they stopped|strong="H02308"\w* \w building|strong="H01129"\w* \w the city|strong="H05892"\w*. \v 9 \w That is why|strong="H05921"\w* \w . . .|strong="H03651"\w* \w it|strong="H08034"\w* \w is called|strong="H07121"\w* \w Babel|strong="H00894"\w*,\f + \fr 11:9 \ft Or \fqa Babylon\ft ; the Hebrew word for \fqa Babel \ft sounds like the Hebrew for \fqa confused\ft .\f* \w for|strong="H03588"\w* \w there|strong="H08033"\w* \w the LORD|strong="H03068"\w* \w confused|strong="H01101"\w* \w the language|strong="H08193"\w* \w of the whole|strong="H03605"\w* \w world|strong="H00776"\w*, \w and from that place|strong="H08033"\w* \w the LORD|strong="H03068"\w* \w scattered them|strong="H06327"\w* \w over|strong="H05921"\w* \w the face|strong="H06440"\w* \w of all|strong="H03605"\w* \w the earth|strong="H00776"\w*.
\s1 Genealogy from Shem to Abram
\p \v 10 \w This|strong="H00428"\w* \w is the account|strong="H08435"\w* \w of Shem|strong="H08035"\w*. \w Two years|strong="H08141"\w* \w after|strong="H00310"\w* \w the flood|strong="H03999"\w*, \w when Shem|strong="H08035"\w* \w was 100|strong="H03967"\w* \w years|strong="H08141"\w* \w old|strong="H01121"\w*, \w he became the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Arphaxad|strong="H00775"\w*. \v 11 \w And after|strong="H00310"\w* \w he had become the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Arphaxad|strong="H00775"\w*, \w Shem|strong="H08035"\w* \w lived|strong="H02421"\w* \w 500|strong="H02568"\w* \w . . .|strong="H03967"\w* \w years|strong="H08141"\w* \w and had|strong="H03205"\w* \w other sons|strong="H01121"\w* \w and daughters|strong="H01323"\w*.
\p \v 12 \w When Arphaxad|strong="H00775"\w* \w was|strong="H02421"\w* \w 35|strong="H02568"\w* \w . . .|strong="H07970"\w* \w years old|strong="H08141"\w*, \w he became the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Shelah|strong="H07974"\w*. \v 13 \w And after|strong="H00310"\w* \w he had become the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Shelah|strong="H07974"\w*, \w Arphaxad|strong="H00775"\w* \w lived|strong="H02421"\w* \w 403|strong="H07969"\w* \w . . .|strong="H00702"\w* \w . . .|strong="H03967"\w* \w years|strong="H08141"\w* \w . . .|strong="H08141"\w* \w and had|strong="H03205"\w* \w other sons|strong="H01121"\w* \w and daughters|strong="H01323"\w*.\f + \fr 11:13 \ft Hebrew; LXX (see also Luke 3:35–36) \fv 12\fv*When Arphaxad was 135 years old, he became the father of Cainan. \fv 13\fv*And after he had become the father of Cainan, Arphaxad lived 430 years and had other sons and daughters, and then he died. When Cainan had lived 130 years, he became the father of Shelah. And after he had become the father of Shelah, Cainan lived 330 years and had other sons and daughters.\ft Note that LXX also adds 100 years to the ages of Shelah, Eber, Peleg, Reu, Serug, and Nahor in this genealogy.\f*
\p \v 14 \w When Shelah|strong="H07974"\w* \w was|strong="H02421"\w* \w 30|strong="H07970"\w* \w years old|strong="H08141"\w*, \w he became the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Eber|strong="H05677"\w*. \v 15 \w And after|strong="H00310"\w* \w he had become the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Eber|strong="H05677"\w*, \w Shelah|strong="H07974"\w* \w lived|strong="H02421"\w* \w 403|strong="H00702"\w* \w . . .|strong="H03967"\w* \w . . .|strong="H07969"\w* \w . . .|strong="H08141"\w* \w years|strong="H08141"\w* \w and had|strong="H03205"\w* \w other sons|strong="H01121"\w* \w and daughters|strong="H01323"\w*.
\p \v 16 \w When Eber|strong="H05677"\w* \w was|strong="H02421"\w* \w 34|strong="H00702"\w* \w . . .|strong="H07970"\w* \w years old|strong="H08141"\w*, \w he became the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Peleg|strong="H06389"\w*. \v 17 \w And after|strong="H00310"\w* \w he had become the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Peleg|strong="H06389"\w*, \w Eber|strong="H05677"\w* \w lived|strong="H02421"\w* \w 430|strong="H07970"\w* \w . . .|strong="H00702"\w* \w . . .|strong="H03967"\w* \w . . .|strong="H08141"\w* \w years|strong="H08141"\w* \w and had|strong="H03205"\w* \w other sons|strong="H01121"\w* \w and daughters|strong="H01323"\w*.
\p \v 18 \w When Peleg|strong="H06389"\w* \w was|strong="H02421"\w* \w 30|strong="H07970"\w* \w years old|strong="H08141"\w*, \w he became the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Reu|strong="H07466"\w*. \v 19 \w And after|strong="H00310"\w* \w he had become the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Reu|strong="H07466"\w*, \w Peleg|strong="H06389"\w* \w lived|strong="H02421"\w* \w 209|strong="H08672"\w* \w . . .|strong="H03967"\w* \w . . .|strong="H08141"\w* \w years|strong="H08141"\w* \w and had|strong="H03205"\w* \w other sons|strong="H01121"\w* \w and daughters|strong="H01323"\w*.
\p \v 20 \w When Reu|strong="H07466"\w* \w was|strong="H02421"\w* \w 32|strong="H08147"\w* \w . . .|strong="H07970"\w* \w years old|strong="H08141"\w*, \w he became the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Serug|strong="H08286"\w*. \v 21 \w And after|strong="H00310"\w* \w he had become the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Serug|strong="H08286"\w*, \w Reu|strong="H07466"\w* \w lived|strong="H02421"\w* \w 207|strong="H07651"\w* \w . . .|strong="H03967"\w* \w . . .|strong="H08141"\w* \w years|strong="H08141"\w* \w and had|strong="H03205"\w* \w other sons|strong="H01121"\w* \w and daughters|strong="H01323"\w*.
\p \v 22 \w When Serug|strong="H08286"\w* \w was|strong="H02421"\w* \w 30|strong="H07970"\w* \w years old|strong="H08141"\w*, \w he became the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Nahor|strong="H05152"\w*. \v 23 \w And after|strong="H00310"\w* \w he had become the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Nahor|strong="H05152"\w*, \w Serug|strong="H08286"\w* \w lived|strong="H02421"\w* \w 200|strong="H03967"\w* \w years|strong="H08141"\w* \w and had|strong="H03205"\w* \w other sons|strong="H01121"\w* \w and daughters|strong="H01323"\w*.
\p \v 24 \w When Nahor|strong="H05152"\w* \w was|strong="H02421"\w* \w 29|strong="H08672"\w* \w . . .|strong="H06242"\w* \w years old|strong="H08141"\w*, \w he became the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Terah|strong="H08646"\w*. \v 25 \w And after|strong="H00310"\w* \w he had become the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Terah|strong="H08646"\w*, \w Nahor|strong="H05152"\w* \w lived|strong="H02421"\w* \w 119|strong="H08672"\w* \w . . .|strong="H06240"\w* \w . . .|strong="H03967"\w* \w . . .|strong="H08141"\w* \w years|strong="H08141"\w* \w and had|strong="H03205"\w* \w other sons|strong="H01121"\w* \w and daughters|strong="H01323"\w*.
\p \v 26 \w When Terah|strong="H08646"\w* \w was|strong="H02421"\w* \w 70|strong="H07657"\w* \w years old|strong="H08141"\w*, \w he became the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Abram|strong="H00087"\w*, \w -|strong="H00853"\w* \w Nahor|strong="H05152"\w*, \w -|strong="H00853"\w* \w and Haran|strong="H02039"\w*.
\s1 Terah’s Descendants
\p \v 27 \w This|strong="H00428"\w* \w is the account|strong="H08435"\w* \w of Terah|strong="H08646"\w*. \w Terah|strong="H08646"\w* \w became the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Abram|strong="H00087"\w*, \w -|strong="H00853"\w* \w Nahor|strong="H05152"\w*, \w -|strong="H00853"\w* \w and Haran|strong="H02039"\w*. \w And Haran|strong="H02039"\w* \w became the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Lot|strong="H03876"\w*. \v 28 \w During|strong="H05921"\w* \w . . .|strong="H06440"\w* \w his father|strong="H00001"\w* \w Terah’s lifetime|strong="H08646"\w*, \w Haran|strong="H02039"\w* \w died|strong="H04191"\w* \w in his native|strong="H04138"\w* \w land|strong="H00776"\w*, \w in Ur|strong="H00218"\w* \w of the Chaldeans|strong="H03778"\w*.
\p \v 29 \w And Abram|strong="H00087"\w* \w and Nahor|strong="H05152"\w* \w took|strong="H03947"\w* \w wives|strong="H00802"\w* for themselves. \w Abram’s|strong="H00087"\w* \w wife|strong="H00802"\w* \w was named|strong="H08034"\w* \w Sarai|strong="H08297"\w*, \w and Nahor’s|strong="H05152"\w* \w wife|strong="H00802"\w* \w was named|strong="H08034"\w* \w Milcah|strong="H04435"\w*; \w she was the daughter|strong="H01323"\w* \w of Haran|strong="H02039"\w*, \w [who was] the father|strong="H00001"\w* \w of both Milcah|strong="H04435"\w* \w . . .|strong="H00001"\w* \w and Iscah|strong="H03252"\w*. \v 30 \w But Sarai|strong="H08297"\w* \w was|strong="H01961"\w* \w barren|strong="H06135"\w*; she had \w no|strong="H00369"\w* \w children|strong="H02056"\w*.
\p \v 31 \w And Terah|strong="H08646"\w* \w -|strong="H00853"\w* \w took|strong="H03947"\w* \w his son|strong="H01121"\w* \w -|strong="H00853"\w* \w Abram|strong="H00087"\w*, \w his grandson|strong="H01121"\w* \w . . .|strong="H01121"\w* \w Lot|strong="H03876"\w* \w son|strong="H01121"\w* \w of Haran|strong="H02039"\w*, \w and|strong="H00853"\w* \w his daughter-in-law|strong="H03618"\w* \w Sarai|strong="H08297"\w* \w the wife|strong="H00802"\w* \w -|strong="H01121"\w* \w of Abram|strong="H00087"\w*, \w and they set out|strong="H03318"\w* \w . . .|strong="H00854"\w* \w from Ur|strong="H00218"\w* \w of the Chaldeans|strong="H03778"\w* \w for|strong="H01980"\w* \w the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*. \w But when they arrived|strong="H00935"\w* \w in|strong="H05704"\w* \w Haran|strong="H02771"\w*, \w they settled|strong="H03427"\w* \w there|strong="H08033"\w*. \v 32 \w Terah|strong="H08646"\w* \w lived|strong="H01961"\w* \w . . .|strong="H03117"\w* \w 205|strong="H02568"\w* \w . . .|strong="H03967"\w* \w . . .|strong="H08141"\w* \w years|strong="H08141"\w*, \w and he died|strong="H04191"\w* \w . . .|strong="H08646"\w* \w in Haran|strong="H02771"\w*.
\c 12
\s1 The Call of Abram
\p \v 1 \w Then the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Abram|strong="H00087"\w*, “\w Leave|strong="H01980"\w* your \w country|strong="H00776"\w*, \w your kindred|strong="H04138"\w*, \w and your father’s|strong="H00001"\w* \w household|strong="H01004"\w*, \w and go to|strong="H00413"\w* \w the land|strong="H00776"\w* \w -|strong="H00834"\w* \w I will show you|strong="H07200"\w*.\f + \fr 12:1 \ft Cited in Acts 7:3\f*
