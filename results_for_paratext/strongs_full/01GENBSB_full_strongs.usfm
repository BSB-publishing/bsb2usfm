\c 36
\s1 The Descendants of Esau
\p \v 1 \w This|strong="H00428"\w* \w is the account|strong="H08435"\w* \w of Esau|strong="H06215"\w* \w (that is|strong="H01931"\w*, \w Edom)|strong="H00123"\w*. \v 2 \w Esau|strong="H06215"\w* \w took|strong="H03947"\w* \w -|strong="H00853"\w* \w his wives|strong="H00802"\w* \w from the daughters|strong="H01323"\w* \w of Canaan|strong="H03667"\w* \w -|strong="H00853"\w*: \w Adah|strong="H05711"\w* \w daughter|strong="H01323"\w* \w of Elon|strong="H00356"\w* \w the Hittite|strong="H02850"\w*, \w -|strong="H00853"\w* \w Oholibamah|strong="H00173"\w* \w daughter|strong="H01323"\w* \w of Anah|strong="H06034"\w* \w and granddaughter|strong="H01323"\w* \w of Zibeon|strong="H06649"\w* \w the Hivite|strong="H02340"\w*, \v 3 \w -|strong="H00853"\w* \w and Basemath|strong="H01315"\w* \w daughter|strong="H01323"\w* \w of Ishmael|strong="H03458"\w* \w and sister|strong="H00269"\w* \w of Nebaioth|strong="H05032"\w*. \v 4 \w And Adah|strong="H05711"\w* \w bore|strong="H03205"\w* \w Eliphaz|strong="H00464"\w* \w to Esau|strong="H06215"\w*, \w -|strong="H00853"\w* \w Basemath|strong="H01315"\w* \w gave birth to|strong="H03205"\w* \w -|strong="H00853"\w* \w Reuel|strong="H07467"\w*, \v 5 \w and Oholibamah|strong="H00173"\w* \w gave birth to|strong="H03205"\w* \w -|strong="H00853"\w* \w Jeush|strong="H03274"\w*, \w -|strong="H00853"\w* \w Jalam|strong="H03281"\w*, \w -|strong="H00853"\w* \w and Korah|strong="H07141"\w*. \w These|strong="H00428"\w* \w [were] the sons|strong="H01121"\w* \w of Esau|strong="H06215"\w*, \w who|strong="H00834"\w* \w were born|strong="H03205"\w* to him \w in the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*.
\p \v 6 \w Later, Esau|strong="H06215"\w* \w -|strong="H00853"\w* \w took|strong="H03947"\w* \w his wives|strong="H00802"\w* \w and|strong="H00853"\w* \w sons|strong="H01121"\w* \w and|strong="H00853"\w* \w daughters|strong="H01323"\w* \w and|strong="H00853"\w* \w all|strong="H03605"\w* \w the people|strong="H05315"\w* \w of his household|strong="H01004"\w*, \w along with|strong="H00853"\w* \w his livestock|strong="H04735"\w*, \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w his [other] animals|strong="H00929"\w*, \w -|strong="H00853"\w* \w and all|strong="H03605"\w* \w the property|strong="H07075"\w* \w -|strong="H00834"\w* \w he had acquired|strong="H07408"\w* \w in Canaan|strong="H03667"\w*, \w and he moved|strong="H01980"\w* \w to|strong="H00413"\w* \w . . .|strong="H00776"\w* \w a land|strong="H00776"\w* \w far away from|strong="H06440"\w* \w his brother|strong="H00251"\w* \w Jacob|strong="H03290"\w*. \v 7 \w For|strong="H03588"\w* \w their possessions|strong="H07399"\w* \w were|strong="H01961"\w* \w too great|strong="H07227"\w* \w for them to dwell|strong="H03427"\w* \w together|strong="H03162"\w*; \w the land|strong="H00776"\w* \w where they stayed|strong="H04033"\w* \w could|strong="H03201"\w* \w not|strong="H03808"\w* \w support them|strong="H05375"\w* \w -|strong="H00853"\w* \w because|strong="H06440"\w* \w of their livestock|strong="H04735"\w*. \v 8 \w So Esau|strong="H06215"\w* \w . . .|strong="H06215"\w* \w (that is|strong="H01931"\w*, \w Edom|strong="H00123"\w*) \w settled|strong="H03427"\w* \w in [the area of] Mount|strong="H02022"\w* \w Seir|strong="H08165"\w*.
\p \v 9 \w This|strong="H00428"\w* \w is the account|strong="H08435"\w* \w of Esau|strong="H06215"\w*, \w the father|strong="H00001"\w* \w of the Edomites|strong="H00123"\w*, \w in [the area of] Mount|strong="H02022"\w* \w Seir|strong="H08165"\w*.
\p \v 10 \w These|strong="H00428"\w* \w are the names|strong="H08034"\w* \w of Esau’s|strong="H06215"\w* \w sons|strong="H01121"\w*: \w Eliphaz|strong="H00464"\w* \w son|strong="H01121"\w* \w of Esau’s|strong="H06215"\w* \w wife|strong="H00802"\w* \w Adah|strong="H05711"\w*, \w and Reuel|strong="H07467"\w* \w son|strong="H01121"\w* \w of Esau’s|strong="H06215"\w* \w wife|strong="H00802"\w* \w Basemath|strong="H01315"\w*.
\p \v 11 \w The sons|strong="H01121"\w* \w of Eliphaz|strong="H00464"\w* \w were|strong="H01961"\w* \w Teman|strong="H08487"\w*, \w Omar|strong="H00201"\w*, \w Zepho|strong="H06825"\w*, \w Gatam|strong="H01609"\w*, \w and Kenaz|strong="H07073"\w*. \v 12 \w Additionally, Timna|strong="H08555"\w*, \w . . .|strong="H01961"\w* \w a concubine|strong="H06370"\w* \w of Esau’s|strong="H06215"\w* \w son|strong="H01121"\w* \w Eliphaz|strong="H00464"\w*, \w gave birth to|strong="H03205"\w* \w Amalek|strong="H06002"\w* \w -|strong="H00464"\w*. \w -|strong="H00853"\w* \w These|strong="H00428"\w* \w are the grandsons|strong="H01121"\w* \w of Esau’s|strong="H06215"\w* \w wife|strong="H00802"\w* \w Adah|strong="H05711"\w*.
\p \v 13 \w These [are]|strong="H00428"\w* \w the sons|strong="H01121"\w* \w of Reuel|strong="H07467"\w*: \w Nahath|strong="H05184"\w*, \w Zerah|strong="H02226"\w*, \w Shammah|strong="H08048"\w*, \w and Mizzah|strong="H04199"\w*. \w They|strong="H00428"\w* \w are|strong="H01961"\w* \w the grandsons|strong="H01121"\w* \w of Esau’s|strong="H06215"\w* \w wife|strong="H00802"\w* \w Basemath|strong="H01315"\w*.
\p \v 14 \w These|strong="H00428"\w* \w are|strong="H01961"\w* \w the sons|strong="H01121"\w* \w of Esau’s|strong="H06215"\w* \w wife|strong="H00802"\w* \w Oholibamah|strong="H00173"\w* (\w daughter|strong="H01323"\w* \w of Anah|strong="H06034"\w* \w and granddaughter|strong="H01323"\w* \w of Zibeon|strong="H06649"\w*) \w whom she bore|strong="H03205"\w* \w to Esau|strong="H06215"\w*: \w -|strong="H00853"\w* \w Jeush|strong="H03274"\w*, \w -|strong="H00853"\w* \w Jalam|strong="H03281"\w*, \w -|strong="H00853"\w* \w and Korah|strong="H07141"\w*.
\p \v 15 \w These|strong="H00428"\w* \w are the chiefs|strong="H00441"\w* \w among the sons|strong="H01121"\w* \w of Esau|strong="H06215"\w*. \w The sons|strong="H01121"\w* \w of Eliphaz|strong="H00464"\w* \w the firstborn|strong="H01060"\w* \w of Esau|strong="H06215"\w*: \w Chiefs|strong="H00441"\w* \w Teman|strong="H08487"\w*, \w . . .|strong="H00441"\w* \w Omar|strong="H00201"\w*, \w . . .|strong="H00441"\w* \w Zepho|strong="H06825"\w*, \w . . .|strong="H00441"\w* \w Kenaz|strong="H07073"\w*, \v 16 \w -|strong="H00441"\w* \w Korah|strong="H07141"\w*,\f + \fr 36:16 \ft Hebrew; SP (also in verse 11 and 1 Chronicles 1:36) does not include \fqa Korah\ft .\f* \w -|strong="H00441"\w* \w Gatam|strong="H01609"\w*, \w -|strong="H00441"\w* \w and Amalek|strong="H06002"\w*. \w They|strong="H00428"\w* \w are the chiefs|strong="H00441"\w* \w of Eliphaz|strong="H00464"\w* \w in the land|strong="H00776"\w* \w of Edom|strong="H00123"\w*, \w [and] they|strong="H00428"\w* \w are the grandsons|strong="H01121"\w* \w of Adah|strong="H05711"\w*.
\p \v 17 \w These|strong="H00428"\w* \w are the sons|strong="H01121"\w* \w of Esau’s|strong="H06215"\w* \w son|strong="H01121"\w* \w Reuel|strong="H07467"\w*: \w Chiefs|strong="H00441"\w* \w Nahath|strong="H05184"\w*, \w -|strong="H00441"\w* \w Zerah|strong="H02226"\w*, \w . . .|strong="H00441"\w* \w Shammah|strong="H08048"\w*, \w . . .|strong="H00441"\w* \w and Mizzah|strong="H04199"\w*. \w They|strong="H00428"\w* \w are the chiefs|strong="H00441"\w* \w descended from Reuel|strong="H07467"\w* \w in the land|strong="H00776"\w* \w of Edom|strong="H00123"\w*, \w [and] they|strong="H00428"\w* \w are the grandsons|strong="H01121"\w* \w of Esau’s|strong="H06215"\w* \w wife|strong="H00802"\w* \w Basemath|strong="H01315"\w*.
\p \v 18 \w These|strong="H00428"\w* \w are the sons|strong="H01121"\w* \w of Esau’s|strong="H06215"\w* \w wife|strong="H00802"\w* \w Oholibamah|strong="H00173"\w*: \w Chiefs|strong="H00441"\w* \w Jeush|strong="H03266"\w*, \w -|strong="H00441"\w* \w Jalam|strong="H03281"\w*, \w . . .|strong="H00441"\w* \w and Korah|strong="H07141"\w*. \w They|strong="H00428"\w* \w are the chiefs|strong="H00441"\w* \w descended from Esau’s|strong="H06215"\w* \w wife|strong="H00802"\w* \w Oholibamah|strong="H00173"\w*, \w the daughter|strong="H01323"\w* \w of Anah|strong="H06034"\w*.
\p \v 19 \w All these|strong="H00428"\w* \w are the sons|strong="H01121"\w* \w of Esau|strong="H06215"\w* \w (that is|strong="H01931"\w*, \w Edom|strong="H00123"\w*), \w and they|strong="H00428"\w* \w were their chiefs|strong="H00441"\w*.
\s1 The Descendants of Seir
\p \v 20 \w These|strong="H00428"\w* \w are the sons|strong="H01121"\w* \w of Seir|strong="H08165"\w* \w the Horite|strong="H02752"\w*, \w who were living|strong="H03427"\w* \w in the land|strong="H00776"\w*: \w Lotan|strong="H03877"\w*, \w Shobal|strong="H07732"\w*, \w Zibeon|strong="H06649"\w*, \w Anah|strong="H06034"\w*, \v 21 \w Dishon|strong="H01787"\w*, \w Ezer|strong="H00687"\w*, \w and Dishan|strong="H01789"\w*. \w They|strong="H00428"\w* \w are the chiefs|strong="H00441"\w* \w of the Horites|strong="H02752"\w*, \w the descendants|strong="H01121"\w* \w of Seir|strong="H08165"\w* \w in the land|strong="H00776"\w* \w of Edom|strong="H00123"\w*.
\p \v 22 \w The sons|strong="H01121"\w* \w of Lotan|strong="H03877"\w* \w were|strong="H01961"\w* \w Hori|strong="H02753"\w* \w and Hemam|strong="H01967"\w*.\f + \fr 36:22 \fqa Hemam \ft is a variant of \fqa Homam\ft ; see 1 Chronicles 1:39.\f* \w Timna|strong="H08555"\w* \w was Lotan’s|strong="H03877"\w* \w sister|strong="H00269"\w*.
\p \v 23 \w These|strong="H00428"\w* \w are the sons|strong="H01121"\w* \w of Shobal|strong="H07732"\w*: \w Alvan|strong="H05935"\w*, \w Manahath|strong="H04506"\w*, \w Ebal|strong="H05858"\w*, \w Shepho|strong="H08195"\w*, \w and Onam|strong="H00208"\w*.
\p \v 24 \w These|strong="H00428"\w* \w are the sons|strong="H01121"\w* \w of Zibeon|strong="H06649"\w*: \w Aiah|strong="H00345"\w* \w and Anah|strong="H06034"\w*. (\w This [is]|strong="H01931"\w* \w [the] Anah|strong="H06034"\w* \w who|strong="H00834"\w* \w found|strong="H04672"\w* \w -|strong="H00853"\w* \w the hot springs|strong="H03222"\w* \w in the wilderness|strong="H04057"\w* \w as he was pasturing|strong="H07462"\w* \w -|strong="H00853"\w* \w the donkeys|strong="H02543"\w* \w of his father|strong="H00001"\w* \w Zibeon|strong="H06649"\w*.)
\p \v 25 \w These|strong="H00428"\w* \w are the children|strong="H01121"\w* \w of Anah|strong="H06034"\w*: \w Dishon|strong="H01787"\w* \w and Oholibamah|strong="H00173"\w* \w daughter|strong="H01323"\w* \w of Anah|strong="H06034"\w*.
\p \v 26 \w These|strong="H00428"\w* \w are the sons|strong="H01121"\w* \w of Dishon|strong="H01789"\w*:\f + \fr 36:26 \ft Hebrew \fqa Dishan\ft , a variant of \fqa Dishon\f* \w Hemdan|strong="H02533"\w*, \w Eshban|strong="H00790"\w*, \w Ithran|strong="H03506"\w*, \w and Cheran|strong="H03763"\w*.
\p \v 27 \w These|strong="H00428"\w* \w are the sons|strong="H01121"\w* \w of Ezer|strong="H00687"\w*: \w Bilhan|strong="H01092"\w*, \w Zaavan|strong="H02190"\w*, \w and Akan|strong="H06130"\w*.
\p \v 28 \w These|strong="H00428"\w* \w are the sons|strong="H01121"\w* \w of Dishan|strong="H01789"\w*: \w Uz|strong="H05780"\w* \w and Aran|strong="H00765"\w*.
\p \v 29 \w These|strong="H00428"\w* \w are the chiefs|strong="H00441"\w* \w of the Horites|strong="H02752"\w*: \w Chiefs|strong="H00441"\w* \w Lotan|strong="H03877"\w*, \w . . .|strong="H00441"\w* \w Shobal|strong="H07732"\w*, \w . . .|strong="H00441"\w* \w Zibeon|strong="H06649"\w*, \w . . .|strong="H00441"\w* \w Anah|strong="H06034"\w*, \v 30 \w -|strong="H00441"\w* \w Dishon|strong="H01787"\w*, \w -|strong="H00441"\w* \w Ezer|strong="H00687"\w*, \w . . .|strong="H00441"\w* \w and Dishan|strong="H01789"\w*. \w They|strong="H00428"\w* \w are the chiefs|strong="H00441"\w* \w of the Horites|strong="H02753"\w*, \w according to their divisions|strong="H00441"\w* \w in the land|strong="H00776"\w* \w of Seir|strong="H08165"\w*.
\s1 The Kings of Edom
\p \v 31 \w These|strong="H00428"\w* \w are the kings|strong="H04428"\w* \w who|strong="H00834"\w* \w reigned|strong="H04427"\w* \w in the land|strong="H00776"\w* \w of Edom|strong="H00123"\w* \w before|strong="H06440"\w* \w any king|strong="H04428"\w* \w reigned|strong="H04427"\w* \w over the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*:\f + \fr 36:31 \ft Or \fqa before an Israelite king reigned over them:\f*
\b 
\li1 \v 32 \w Bela|strong="H01106"\w* \w son|strong="H01121"\w* \w of Beor|strong="H01160"\w* \w reigned|strong="H04427"\w* \w in Edom|strong="H00123"\w*; \w the name|strong="H08034"\w* \w of his city|strong="H05892"\w* \w was Dinhabah|strong="H01838"\w*.
\b 
\li1 \v 33 \w When Bela|strong="H01106"\w* \w died|strong="H04191"\w*, \w Jobab|strong="H03103"\w* \w son|strong="H01121"\w* \w of Zerah|strong="H02226"\w* \w from Bozrah|strong="H01224"\w* \w reigned|strong="H04427"\w* \w in his place|strong="H08478"\w*.
\b 
\li1 \v 34 \w When Jobab|strong="H03103"\w* \w died|strong="H04191"\w*, \w Husham|strong="H02367"\w* \w from the land|strong="H00776"\w* \w of the Temanites|strong="H08489"\w* \w reigned|strong="H04427"\w* \w in his place|strong="H08478"\w*.
\b 
\li1 \v 35 \w When Husham|strong="H02367"\w* \w died|strong="H04191"\w*, \w Hadad|strong="H01908"\w* \w son|strong="H01121"\w* \w of Bedad|strong="H00911"\w*, \w who defeated|strong="H05221"\w* \w -|strong="H00853"\w* \w Midian|strong="H04080"\w* \w in the country|strong="H07704"\w* \w of Moab|strong="H04124"\w*, \w reigned|strong="H04427"\w* \w in his place|strong="H08478"\w*. \w And the name|strong="H08034"\w* \w of his city|strong="H05892"\w* \w was Avith|strong="H05762"\w*.
\b 
\li1 \v 36 \w When Hadad|strong="H01908"\w* \w died|strong="H04191"\w*, \w Samlah|strong="H08072"\w* \w from Masrekah|strong="H04957"\w* \w reigned|strong="H04427"\w* \w in his place|strong="H08478"\w*.
\b 
\li1 \v 37 \w When Samlah|strong="H08072"\w* \w died|strong="H04191"\w*, \w Shaul|strong="H07586"\w* \w from Rehoboth|strong="H07344"\w* \w on the Euphrates|strong="H05104"\w*\f + \fr 36:37 \ft Hebrew \fqa the River\f* \w reigned|strong="H04427"\w* \w in his place|strong="H08478"\w*.
\b 
\li1 \v 38 \w When Shaul|strong="H07586"\w* \w died|strong="H04191"\w*, \w vvv|strong="H01177"\w* \w Baal-hanan|strong="H01177"\w* \w son|strong="H01121"\w* \w of Achbor|strong="H05907"\w* \w reigned|strong="H04427"\w* \w in his place|strong="H08478"\w*.
\b 
\li1 \v 39 \w vvv|strong="H01177"\w* \w When Baal-hanan|strong="H01177"\w* \w son|strong="H01121"\w* \w of Achbor|strong="H05907"\w* \w died|strong="H04191"\w*, \w Hadad|strong="H01924"\w*\f + \fr 36:39 \ft Some MT manuscripts, SP, and Syriac (see also 1 Chronicles 1:50); other MT manuscripts \fqa Hadar\f* \w reigned|strong="H04427"\w* \w in his place|strong="H08478"\w*. \w His city|strong="H05892"\w* \w was named|strong="H08034"\w* \w Pau|strong="H06464"\w*, \w and his wife’s|strong="H00802"\w* \w name|strong="H08034"\w* \w was Mehetabel|strong="H04105"\w* \w daughter|strong="H01323"\w* \w of Matred|strong="H04308"\w*, \w the daughter|strong="H01323"\w* \w vvv|strong="H04314"\w* \w of Me-zahab|strong="H04314"\w*.
\p \v 40 \w These|strong="H00428"\w* \w are the names|strong="H08034"\w* \w of Esau’s|strong="H06215"\w* \w chiefs|strong="H00441"\w*, \w according to their families|strong="H04940"\w* \w and regions|strong="H04725"\w*, \w by their names|strong="H08034"\w*: \w Chiefs|strong="H00441"\w* \w Timna|strong="H08555"\w*, \w . . .|strong="H00441"\w* \w Alvah|strong="H05933"\w*, \w . . .|strong="H00441"\w* \w Jetheth|strong="H03509"\w*, \v 41 \w -|strong="H00441"\w* \w Oholibamah|strong="H00173"\w*, \w . . .|strong="H00441"\w* \w Elah|strong="H00425"\w*, \w . . .|strong="H00441"\w* \w Pinon|strong="H06373"\w*, \v 42 \w -|strong="H00441"\w* \w Kenaz|strong="H07073"\w*, \w . . .|strong="H00441"\w* \w Teman|strong="H08487"\w*, \w . . .|strong="H00441"\w* \w Mibzar|strong="H04014"\w*, \v 43 \w -|strong="H00441"\w* \w Magdiel|strong="H04025"\w*, \w . . .|strong="H00441"\w* \w and Iram|strong="H05902"\w*. \w These|strong="H00428"\w* \w [were] the chiefs|strong="H00441"\w* \w of Edom|strong="H00123"\w*, \w according to their settlements|strong="H04186"\w* \w in the land|strong="H00776"\w* \w they possessed|strong="H00272"\w*. \w -|strong="H01931"\w* \w Esau|strong="H06215"\w* \w was the father|strong="H00001"\w* \w of the Edomites|strong="H00123"\w*.
\c 37
\s1 Joseph’s Dreams
\p \v 1 \w Now Jacob|strong="H03290"\w* \w lived|strong="H03427"\w* \w in the land|strong="H00776"\w* \w where his father|strong="H00001"\w* \w had resided|strong="H04033"\w*, \w the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*.
\p \v 2 \w This|strong="H00428"\w* \w is the account|strong="H08435"\w* \w of Jacob|strong="H03290"\w*. \w When Joseph|strong="H03130"\w* \w [was] seventeen|strong="H07651"\w* \w . . .|strong="H06240"\w* \w years|strong="H08141"\w* \w old|strong="H01121"\w*, \w he was|strong="H01961"\w* \w tending|strong="H07462"\w* \w the flock|strong="H06629"\w* \w . . .|strong="H01931"\w* \w with|strong="H00854"\w* \w his brothers|strong="H00251"\w*, \w -|strong="H05288"\w* \w -|strong="H00854"\w* \w the sons|strong="H01121"\w* \w of his father’s|strong="H00001"\w* \w wives|strong="H00802"\w* \w Bilhah|strong="H01090"\w* \w . . .|strong="H00854"\w* \w . . .|strong="H01121"\w* \w and Zilpah|strong="H02153"\w*, \w and he|strong="H03130"\w* \w -|strong="H00853"\w* \w brought|strong="H00935"\w* \w their father|strong="H00001"\w* \w a bad|strong="H07451"\w* \w report|strong="H01681"\w* \w about them|strong="H00413"\w*.
\p \v 3 \w Now Israel|strong="H03478"\w* \w loved|strong="H00157"\w* \w -|strong="H00853"\w* \w Joseph|strong="H03130"\w* \w more than|strong="H03605"\w* \w his other sons|strong="H01121"\w*, \w because|strong="H03588"\w* \w Joseph|strong="H01931"\w* \w had been born|strong="H01121"\w* to him \w in his old age|strong="H02208"\w*; \w so he made|strong="H06213"\w* him \w a robe|strong="H03801"\w* \w of many colors|strong="H06446"\w*.\f + \fr 37:3 \ft Possibly \fqa a robe with long sleeves\ft ; also in verses 23 and 32\f* \v 4 \w When [Joseph’s] brothers|strong="H00251"\w* \w saw|strong="H07200"\w* \w that|strong="H03588"\w* \w their father|strong="H00001"\w* \w loved|strong="H00157"\w* \w him|strong="H00853"\w* \w more than any|strong="H03605"\w* \w [of them]|strong="H00251"\w*, \w they hated|strong="H08130"\w* \w him|strong="H00853"\w* \w and could|strong="H03201"\w* \w not|strong="H03808"\w* \w speak|strong="H01696"\w* \w a kind word to him|strong="H07965"\w*.
