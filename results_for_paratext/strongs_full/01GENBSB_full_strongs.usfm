\p \v 21 \w When Reuben|strong="H07205"\w* \w heard [this]|strong="H08085"\w*, \w he tried to rescue [Joseph]|strong="H05337"\w* \w from their hands|strong="H03027"\w*. “\w Let us not|strong="H03808"\w* \w take|strong="H05221"\w* \w his life|strong="H05315"\w*,” \w he said|strong="H00559"\w*. \v 22 “\w Do not shed|strong="H08210"\w* \w [his] blood|strong="H01818"\w*. \w Throw|strong="H07993"\w* \w him|strong="H00853"\w* \w into|strong="H00413"\w* \w this|strong="H02088"\w* \w -|strong="H00834"\w* \w pit|strong="H00953"\w* \w in the wilderness|strong="H04057"\w*, \w but do not|strong="H00408"\w* \w lay|strong="H07971"\w* \w a hand|strong="H03027"\w* on him.” \w Reuben|strong="H07205"\w* \w . . .|strong="H00408"\w* \w said this|strong="H00559"\w* \w . . .|strong="H00413"\w* \w so that|strong="H04616"\w* \w he could rescue|strong="H05337"\w* \w [Joseph]|strong="H00853"\w* \w from their hands|strong="H03027"\w* \w and return him|strong="H07725"\w* \w to|strong="H00413"\w* \w his father|strong="H00001"\w*.
