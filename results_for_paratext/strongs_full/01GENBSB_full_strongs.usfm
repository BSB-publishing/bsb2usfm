\p \v 8 “\w Do you intend to reign|strong="H04427"\w* \w . . .|strong="H04427"\w* \w over us|strong="H05921"\w*?” \w . . .|strong="H00518"\w* \w his brothers|strong="H00251"\w* \w asked|strong="H00559"\w*. “\w Will you actually rule|strong="H04910"\w* \w . . .|strong="H04910"\w* us?” \w So they hated|strong="H08130"\w* \w him|strong="H00853"\w* \w even more|strong="H03254"\w* \w . . .|strong="H05750"\w* \w because of|strong="H05921"\w* \w his dream|strong="H02472"\w* \w . . .|strong="H05921"\w* \w and his statements|strong="H01697"\w*.
