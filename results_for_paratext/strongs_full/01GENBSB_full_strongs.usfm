\p \v 5 \w The Hittites|strong="H01121"\w* \w . . .|strong="H02845"\w* \w -|strong="H00853"\w* \w replied|strong="H06030"\w* \w to Abraham|strong="H00085"\w* \w . . .|strong="H00559"\w*, \v 6 “\w Listen to us|strong="H08085"\w*, \w sir|strong="H00113"\w*. \w You|strong="H00859"\w* \w are God’s|strong="H00430"\w* \w chosen one|strong="H05387"\w* \w among us|strong="H08432"\w*. \w Bury|strong="H06912"\w* \w -|strong="H00853"\w* \w your dead|strong="H04191"\w* \w . . .|strong="H00376"\w* \w in the finest|strong="H04005"\w* \w of our tombs|strong="H06913"\w*. \w None|strong="H03808"\w* \w of us|strong="H04480"\w* \w -|strong="H00853"\w* \w will withhold|strong="H03607"\w* \w -|strong="H04480"\w* \w his tomb|strong="H06913"\w* \w for burying|strong="H06912"\w* \w your dead|strong="H04191"\w*.”
