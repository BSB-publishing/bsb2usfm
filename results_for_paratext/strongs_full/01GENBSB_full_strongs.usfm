\p \v 17 \w When Joseph|strong="H03130"\w* \w saw|strong="H07200"\w* \w that|strong="H03588"\w* \w his father|strong="H00001"\w* \w had placed|strong="H07896"\w* \w his right|strong="H03225"\w* \w hand|strong="H03027"\w* \w on|strong="H05921"\w* \w Ephraim’s|strong="H00669"\w* \w head|strong="H07218"\w*, \w he was displeased|strong="H07489"\w* \w . . .|strong="H05869"\w* \w and took|strong="H08551"\w* \w his father’s|strong="H00001"\w* \w hand|strong="H03027"\w* \w to move|strong="H05493"\w* \w it|strong="H00853"\w* \w from|strong="H05921"\w* \w Ephraim’s|strong="H00669"\w* \w head|strong="H07218"\w* \w to|strong="H05921"\w* \w . . .|strong="H07218"\w* \w Manasseh’s|strong="H04519"\w*. \v 18 “\w Not|strong="H03808"\w* \w so|strong="H03651"\w*, \w my father|strong="H00001"\w*!” \w Joseph|strong="H03130"\w* \w said|strong="H00559"\w* \w -|strong="H00413"\w* \w -|strong="H00001"\w*. “\w -|strong="H03588"\w* \w This|strong="H02088"\w* \w one is the firstborn|strong="H01060"\w*; \w put|strong="H07760"\w* \w your right hand|strong="H03225"\w* \w on|strong="H05921"\w* \w his head|strong="H07218"\w*.”
\p \v 19 \w But his father|strong="H00001"\w* \w refused|strong="H03985"\w*. “\w I know|strong="H03045"\w*, \w my son|strong="H01121"\w*, \w I know|strong="H03045"\w*!” \w he said|strong="H00559"\w*. “\w He|strong="H01931"\w* \w too|strong="H01571"\w* \w shall become|strong="H01961"\w* \w a people|strong="H05971"\w*, \w and he|strong="H01931"\w* \w too|strong="H01571"\w* \w shall be great|strong="H01431"\w*; \w nevertheless|strong="H00199"\w*, \w his younger|strong="H06996"\w* \w brother|strong="H00251"\w* \w shall be greater|strong="H01431"\w* \w than he|strong="H04480"\w*, \w and his offspring|strong="H02233"\w* \w shall become|strong="H01961"\w* \w a multitude|strong="H04393"\w* \w of nations|strong="H01471"\w*.”
\p \v 20 \w So that day|strong="H03117"\w* \w [Jacob] blessed|strong="H01288"\w* \w them|strong="H01931"\w* \w and said|strong="H00559"\w*:
\b 
\q1 “By you \w shall Israel|strong="H03478"\w* \w pronounce|strong="H00559"\w* \w this blessing|strong="H01288"\w*:
