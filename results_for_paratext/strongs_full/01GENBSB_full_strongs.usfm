\p \v 36 \w Then Jacob|strong="H03290"\w* \w became incensed|strong="H02734"\w* \w and challenged|strong="H07378"\w* \w Laban|strong="H03837"\w*. \w . . .|strong="H06030"\w* “\w What|strong="H04100"\w* \w is my crime|strong="H06588"\w*?” \w he|strong="H03290"\w* \w said|strong="H00559"\w*. \w -|strong="H03837"\w* “\w For what|strong="H04100"\w* \w sin of mine|strong="H02403"\w* \w -|strong="H03588"\w* \w have you so hotly pursued|strong="H01814"\w* \w me|strong="H00310"\w*? \v 37 \w -|strong="H03588"\w* \w You have searched|strong="H04959"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w my goods|strong="H03627"\w*! \w . . .|strong="H04100"\w* \w Have you found|strong="H04672"\w* \w anything|strong="H03605"\w* \w that belongs to you|strong="H03627"\w*? \w . . .|strong="H01004"\w* \w Put|strong="H07760"\w* \w it here|strong="H03541"\w* \w before|strong="H05048"\w* \w my brothers|strong="H00251"\w* \w and yours|strong="H00251"\w*, \w that they may judge|strong="H03198"\w* \w between|strong="H00996"\w* \w the two of us|strong="H08147"\w*.
