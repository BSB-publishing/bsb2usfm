\s1 Abraham, Sarah, and Abimelech
\p \v 1 \w Now Abraham|strong="H00085"\w* \w journeyed|strong="H05265"\w* \w from there|strong="H08033"\w* \w to the region|strong="H00776"\w* \w of the Negev|strong="H05045"\w* \w and settled|strong="H03427"\w* \w between|strong="H00996"\w* \w Kadesh|strong="H06946"\w* \w . . .|strong="H00996"\w* \w and Shur|strong="H07793"\w*. \w While he was staying|strong="H01481"\w* \w in Gerar|strong="H01642"\w*, \v 2 \w Abraham|strong="H00085"\w* \w said|strong="H00559"\w* \w of|strong="H00413"\w* \w his wife|strong="H00802"\w* \w Sarah|strong="H08283"\w*, “\w She|strong="H01931"\w* \w is my sister|strong="H00269"\w*.” \w So Abimelech|strong="H00040"\w* \w king|strong="H04428"\w* \w of Gerar|strong="H01642"\w* \w had Sarah|strong="H08283"\w* \w brought|strong="H07971"\w* \w to him|strong="H03947"\w*. \w -|strong="H00853"\w*
