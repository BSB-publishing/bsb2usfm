\s1 The Seven Years of Plenty
\p \v 46 \w Now Joseph|strong="H03130"\w* \w was thirty|strong="H07970"\w* \w years old|strong="H01121"\w* \w . . .|strong="H08141"\w* \w when he entered the service|strong="H05975"\w* \w . . .|strong="H06440"\w* \w of Pharaoh|strong="H06547"\w* \w king|strong="H04428"\w* \w of Egypt|strong="H04714"\w*. \w And Joseph|strong="H03130"\w* \w left|strong="H03318"\w* \w Pharaoh’s|strong="H06547"\w* \w presence|strong="H06440"\w* \w and traveled|strong="H05674"\w* \w throughout|strong="H03605"\w* \w the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w*.
\p \v 47 \w During the seven|strong="H07651"\w* \w years|strong="H08141"\w* \w of abundance|strong="H07647"\w*, \w the land|strong="H00776"\w* \w brought forth|strong="H06213"\w* \w bountifully|strong="H07062"\w*. \v 48 \w During those seven|strong="H07651"\w* \w years|strong="H08141"\w*, \w Joseph collected|strong="H06908"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the excess food|strong="H00400"\w* \w in the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w* \w -|strong="H00834"\w* \w -|strong="H01961"\w* \w and stored|strong="H05414"\w* \w it|strong="H00400"\w* \w in the cities|strong="H05892"\w*. \w In every city|strong="H05892"\w* \w he laid up|strong="H05414"\w* \w the food|strong="H00400"\w* \w -|strong="H00834"\w* \w from the fields|strong="H07704"\w* \w around it|strong="H05439"\w*\w . . .|strong="H08432"\w*. \v 49 \w So Joseph|strong="H03130"\w* \w stored up|strong="H06651"\w* \w grain|strong="H01250"\w* \w in such abundance|strong="H07235"\w* \w . . .|strong="H03966"\w*, \w . . .|strong="H05704"\w* \w like the sand|strong="H02344"\w* \w of the sea|strong="H03220"\w*, \w that|strong="H03588"\w* \w he stopped|strong="H02308"\w* \w keeping track of it|strong="H05608"\w*; \w for|strong="H03588"\w* \w it was beyond|strong="H00369"\w* \w measure|strong="H04557"\w*.
