\p \v 6 \w Abram believed|strong="H00539"\w* \w the LORD|strong="H03068"\w*, \w and it was credited|strong="H02803"\w* to him \w as righteousness|strong="H06666"\w*.\f + \fr 15:6 \ft Cited in Romans 4:3, Romans 4:22, Galatians 3:6, and James 2:23\f*
\p \v 7 \w [The LORD] also told|strong="H00559"\w* \w him|strong="H00413"\w*, “\w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w*, \w who|strong="H00834"\w* \w brought you|strong="H03318"\w* \w out of Ur|strong="H00218"\w* \w of the Chaldeans|strong="H03778"\w* \w to give|strong="H05414"\w* you \w -|strong="H00853"\w* \w this|strong="H02063"\w* \w land|strong="H00776"\w* \w to possess|strong="H03423"\w*.”
\s1 God Confirms His Promise
\p \v 8 \w But [Abram] replied|strong="H00559"\w*, “\w Lord|strong="H00136"\w* \w GOD|strong="H03069"\w*, \w how|strong="H04100"\w* \w can I know|strong="H03045"\w* \w that|strong="H03588"\w* \w I will possess it|strong="H03423"\w*?”
\p \v 9 \w And [the LORD] said|strong="H00559"\w* \w to him|strong="H00413"\w*, “\w Bring|strong="H03947"\w* Me \w -|strong="H08027"\w* \w a heifer|strong="H05697"\w*, \w -|strong="H08027"\w* \w a goat|strong="H05795"\w*, \w and a ram|strong="H00352"\w*, \w [each] three years old|strong="H08027"\w*, \w along with a turtledove|strong="H08449"\w* \w and a young pigeon|strong="H01469"\w*.”
\p \v 10 \w So [Abram] brought|strong="H03947"\w* \w all|strong="H03605"\w* \w these|strong="H00428"\w* to Him \w -|strong="H00853"\w*, \w split|strong="H01334"\w* \w each of them|strong="H00853"\w* \w down the middle|strong="H08432"\w*, \w and laid|strong="H05414"\w* \w the halves|strong="H01335"\w* \w opposite|strong="H07122"\w* \w each|strong="H00376"\w* \w other|strong="H07453"\w*. \w The birds|strong="H06833"\w*, \w however|strong="H00853"\w*, \w he did not|strong="H03808"\w* \w cut in half|strong="H01334"\w*. \v 11 \w And the birds of prey|strong="H05861"\w* \w descended|strong="H03381"\w* \w on|strong="H05921"\w* \w the carcasses|strong="H06297"\w*, \w but Abram|strong="H00087"\w* \w drove them away|strong="H05380"\w*. \w -|strong="H00853"\w* \v 12 \w As the sun|strong="H08121"\w* \w was|strong="H01961"\w* \w setting|strong="H00935"\w*, \w Abram|strong="H00087"\w* \w fell|strong="H05307"\w* \w into|strong="H05921"\w* \w a deep sleep|strong="H08639"\w*, \w and suddenly|strong="H02009"\w* \w great|strong="H01419"\w* \w terror|strong="H00367"\w* \w and darkness|strong="H02825"\w* \w overwhelmed|strong="H05307"\w* \w him|strong="H05921"\w*.
\p \v 13 \w Then [the LORD] said|strong="H00559"\w* \w to Abram|strong="H00087"\w*, “\w Know for certain|strong="H03045"\w* \w . . .|strong="H03045"\w* \w that|strong="H03588"\w* \w your descendants|strong="H02233"\w* \w will be|strong="H01961"\w* \w strangers|strong="H01616"\w* \w in a land|strong="H00776"\w* \w that is not|strong="H03808"\w* their own, \w and they will be enslaved|strong="H05647"\w* \w and mistreated|strong="H06031"\w* \w -|strong="H00853"\w* \w four|strong="H00702"\w* \w hundred|strong="H03967"\w* \w years|strong="H08141"\w*. \v 14 \w But|strong="H01571"\w* \w -|strong="H00853"\w* \w I|strong="H00595"\w* \w will judge|strong="H01777"\w* \w the nation|strong="H01471"\w* \w -|strong="H00834"\w* \w they serve as slaves|strong="H05647"\w*, \w and afterward|strong="H00310"\w* \w . . .|strong="H03651"\w* \w they will depart|strong="H03318"\w* \w with many|strong="H01419"\w* \w possessions|strong="H07399"\w*.\f + \fr 15:14 \ft Cited in Acts 7:6–7\f* \v 15 \w You, however|strong="H00859"\w*, \w will go|strong="H00935"\w* \w to|strong="H00413"\w* \w your fathers|strong="H00001"\w* \w in peace|strong="H07965"\w* \w and be buried|strong="H06912"\w* \w at a ripe old age|strong="H07872"\w* \w . . .|strong="H02896"\w*. \v 16 \w In the fourth|strong="H07243"\w* \w generation|strong="H01755"\w* \w [your descendants] will return|strong="H07725"\w* \w here|strong="H02008"\w*, \w for|strong="H03588"\w* \w the iniquity|strong="H05771"\w* \w of the Amorites|strong="H00567"\w* \w [is] not|strong="H03808"\w* \w yet|strong="H05704"\w* \w . . .|strong="H02008"\w* \w complete|strong="H08003"\w*.”
\p \v 17 \w When the sun|strong="H08121"\w* \w had set|strong="H00935"\w* \w and darkness|strong="H05939"\w* \w had fallen|strong="H01961"\w*, \w . . .|strong="H01961"\w* \w behold|strong="H02009"\w*, \w a smoking|strong="H06227"\w* \w firepot|strong="H08574"\w* \w and a flaming|strong="H00784"\w* \w -|strong="H00834"\w* \w torch|strong="H03940"\w* \w appeared and passed|strong="H05674"\w* \w between|strong="H00996"\w* \w the halves|strong="H01506"\w* \w [of the carcasses]|strong="H00428"\w*. \v 18 \w On that|strong="H01931"\w* \w day|strong="H03117"\w* \w the LORD|strong="H03068"\w* \w made|strong="H03772"\w* \w a covenant|strong="H01285"\w* \w with|strong="H00854"\w* \w Abram|strong="H00087"\w*, \w saying|strong="H00559"\w*, “\w To your descendants|strong="H02233"\w* \w I have given|strong="H05414"\w* \w -|strong="H00853"\w* \w this|strong="H02063"\w* \w land|strong="H00776"\w* — \w from the river|strong="H05104"\w* \w of Egypt|strong="H04714"\w* \w to|strong="H05704"\w* \w the great|strong="H01419"\w* \w River|strong="H05104"\w* \w Euphrates|strong="H06578"\w* \w . . .|strong="H05104"\w* — \v 19 \w -|strong="H00853"\w* \w the land of the Kenites|strong="H07017"\w*, \w -|strong="H00853"\w* \w Kenizzites|strong="H07074"\w*, \w -|strong="H00853"\w* \w Kadmonites|strong="H06935"\w*, \v 20 \w -|strong="H00853"\w* \w Hittites|strong="H02850"\w*, \w -|strong="H00853"\w* \w Perizzites|strong="H06522"\w*, \w -|strong="H00853"\w* \w Rephaites|strong="H07497"\w*, \v 21 \w -|strong="H00853"\w* \w Amorites|strong="H00567"\w*, \w -|strong="H00853"\w* \w Canaanites|strong="H03669"\w*, \w -|strong="H00853"\w* \w Girgashites|strong="H01622"\w*, \w -|strong="H00853"\w* \w and Jebusites|strong="H02983"\w*.”
\c 16
\s1 Hagar and Ishmael
\p \v 1 \w Now Abram’s|strong="H00087"\w* \w wife|strong="H00802"\w* \w Sarai|strong="H08297"\w* \w had borne|strong="H03205"\w* him \w no [children]|strong="H03808"\w*, but \w she had an Egyptian|strong="H04713"\w* \w maidservant|strong="H08198"\w* \w named|strong="H08034"\w* \w Hagar|strong="H01904"\w*. \v 2 \w So Sarai|strong="H08297"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Abram|strong="H00087"\w*, “\w Look|strong="H02009"\w* \w now|strong="H04994"\w*, \w the LORD|strong="H03068"\w* \w has prevented me|strong="H06113"\w* \w from bearing [children]|strong="H03205"\w*. \w Please|strong="H04994"\w* \w go|strong="H00935"\w* \w to|strong="H00413"\w* \w my maidservant|strong="H08198"\w*; \w perhaps|strong="H00194"\w* \w I can build a family|strong="H01129"\w* \w by her|strong="H04480"\w*.”
\p \w And Abram|strong="H00087"\w* \w listened|strong="H08085"\w* \w to the voice|strong="H06963"\w* \w of Sarai|strong="H08297"\w*. \v 3 \w So after|strong="H07093"\w* \w [he]|strong="H00087"\w* \w had lived|strong="H03427"\w* \w vvv|strong="H00776"\w* \w in Canaan|strong="H03667"\w* \w for ten|strong="H06235"\w* \w years|strong="H08141"\w*, \w [his]|strong="H00087"\w* \w -|strong="H00853"\w* \w wife|strong="H00802"\w* \w Sarai|strong="H08297"\w* \w took|strong="H03947"\w* \w her Egyptian|strong="H04713"\w* \w maidservant|strong="H08198"\w* \w Hagar|strong="H01904"\w* \w and gave|strong="H05414"\w* \w her|strong="H00853"\w* \w to Abram|strong="H00087"\w* \w -|strong="H00376"\w* to be \w his wife|strong="H00802"\w*. \v 4 \w And he slept with|strong="H00935"\w* \w . . .|strong="H00413"\w* \w Hagar|strong="H01904"\w*, \w and she conceived|strong="H02029"\w*. \w But when [Hagar] realized|strong="H07200"\w* \w that|strong="H03588"\w* \w she was pregnant|strong="H02029"\w*, \w she began to despise|strong="H07043"\w* \w . . .|strong="H05869"\w* \w her mistress|strong="H01404"\w*.\f + \fr 16:4 \ft Or \fqa her mistress became despised in her sight\f*
