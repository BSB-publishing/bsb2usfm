\p \v 41 \w Thus|strong="H02088"\w* - \w for twenty|strong="H06242"\w* \w years|strong="H08141"\w* \w I have served|strong="H05647"\w* \w in your household|strong="H01004"\w*— \w fourteen|strong="H00702"\w* \w . . .|strong="H06240"\w* \w years|strong="H08141"\w* \w for your two|strong="H08147"\w* \w daughters|strong="H01323"\w* \w and six|strong="H08337"\w* \w years|strong="H08141"\w* \w for your flocks|strong="H06629"\w*— \w and you have changed|strong="H02498"\w* \w -|strong="H00853"\w* \w my wages|strong="H04909"\w* \w ten|strong="H06235"\w* \w times|strong="H04489"\w*! \v 42 \w If the God|strong="H00430"\w* \w of my father|strong="H00001"\w*, \w the God|strong="H00430"\w* \w of Abraham|strong="H00085"\w* \w and the Fear|strong="H06343"\w* \w of Isaac|strong="H03327"\w*, \w had not|strong="H03884"\w* \w been|strong="H01961"\w* with me, \w surely|strong="H03588"\w* \w by now|strong="H06258"\w* \w you would have sent me away|strong="H07971"\w* \w -|strong="H00853"\w* \w empty-handed|strong="H07387"\w*. \w But God|strong="H00430"\w* \w has seen|strong="H07200"\w* \w my affliction|strong="H06040"\w* \w -|strong="H00853"\w* \w and the toil|strong="H03018"\w* \w of my hands|strong="H03709"\w*, \w and last night|strong="H00570"\w* \w He rendered judgment|strong="H03198"\w*.”
\s1 Jacob’s Covenant with Laban
\p \v 43 \w But Laban|strong="H03837"\w* \w . . .|strong="H00559"\w* \w . . .|strong="H00413"\w* \w answered|strong="H06030"\w* \w Jacob|strong="H03290"\w*, “\w [These] daughters|strong="H01323"\w* \w are my daughters|strong="H01323"\w*, \w [these] sons|strong="H01121"\w* \w [are] my sons|strong="H01121"\w*, \w and [these] flocks|strong="H06629"\w* \w [are] my flocks|strong="H06629"\w*! \w Everything|strong="H03605"\w* \w -|strong="H00834"\w* \w you|strong="H00859"\w* \w see|strong="H07200"\w* \w is|strong="H01931"\w* mine! \w Yet what|strong="H04100"\w* \w can I do|strong="H06213"\w* \w today|strong="H03117"\w* \w about these|strong="H00428"\w* \w daughters|strong="H01323"\w* \w of mine or|strong="H00176"\w* \w the children|strong="H01121"\w* \w -|strong="H00834"\w* \w they have borne|strong="H03205"\w*? \v 44 \w Come|strong="H01980"\w* \w now|strong="H06258"\w*, \w let us make|strong="H03772"\w* \w a covenant|strong="H01285"\w*, \w you|strong="H00859"\w* \w and I|strong="H00589"\w*, \w and let it serve as|strong="H01961"\w* \w a witness|strong="H05707"\w* \w between you and me|strong="H00996"\w* \w . . .|strong="H00996"\w*.”
\p \v 45 \w So Jacob|strong="H03290"\w* \w picked out|strong="H03947"\w* \w a stone|strong="H00068"\w* \w and set it up|strong="H07311"\w* \w as a pillar|strong="H04676"\w*, \v 46 \w and [he]|strong="H03290"\w* \w said|strong="H00559"\w* \w to his relatives|strong="H00251"\w*, “\w Gather|strong="H03950"\w* \w [some] stones|strong="H00068"\w*.” \w So they took|strong="H03947"\w* \w stones|strong="H00068"\w* \w and made|strong="H06213"\w* \w a mound|strong="H01530"\w*, \w and there|strong="H08033"\w* \w by|strong="H05921"\w* \w the mound|strong="H01530"\w* \w they ate|strong="H00398"\w*. \v 47 \w Laban|strong="H03837"\w* \w called it|strong="H07121"\w* . . . \w vvv|strong="H03026"\w* \w Jegar-sahadutha|strong="H03026"\w*, \w and Jacob|strong="H03290"\w* \w called it|strong="H07121"\w* . . . \w Galeed|strong="H01567"\w*.\f + \fr 31:47 \ft The Aramaic \fqa Jegar-sahadutha \ft and the Hebrew \fqa Galeed \ft both mean \fqa heap of witnesses\ft .\f*
