\p \v 8 \w Cush|strong="H03568"\w* \w was the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Nimrod|strong="H05248"\w*, \w who|strong="H01931"\w* \w began|strong="H02490"\w* \w to be|strong="H01961"\w* \w a mighty one|strong="H01368"\w*\f + \fr 10:8 \ft Or \fqa who established himself as a mighty warrior \ft or \fqa who became the first fearless leader\f* \w on the earth|strong="H00776"\w*. \v 9 \w He|strong="H01931"\w* \w was|strong="H01961"\w* \w a mighty|strong="H01368"\w* \w hunter|strong="H06718"\w* \w before|strong="H06440"\w*\f + \fr 10:9 \ft Or \fqa in defiance of\ft ; twice in this verse\f* \w the LORD|strong="H03068"\w*; \w so|strong="H05921"\w* \w . . .|strong="H03651"\w* \w it is said|strong="H00559"\w*, “\w Like Nimrod|strong="H05248"\w*, \w a mighty|strong="H01368"\w* \w hunter|strong="H06718"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*.” \v 10 \w -|strong="H01961"\w* \w His kingdom|strong="H04467"\w* \w began|strong="H07225"\w* \w in Babylon|strong="H00894"\w*, \w Erech|strong="H00751"\w*, \w Accad|strong="H00390"\w*, \w and Calneh|strong="H03641"\w*, \w in the land|strong="H00776"\w* \w of Shinar|strong="H08152"\w*.\f + \fr 10:10 \ft That is, Babylonia\f* \v 11 \w From|strong="H04480"\w* \w that|strong="H01931"\w* \w land|strong="H00776"\w* \w he went forth|strong="H03318"\w* \w into Assyria|strong="H00804"\w*, \w where he built|strong="H01129"\w* \w -|strong="H00853"\w* \w Nineveh|strong="H05210"\w*, \w -|strong="H00853"\w* \w Rehoboth-Ir|strong="H07344"\w*, \w . . .|strong="H05893"\w* \w -|strong="H00853"\w* \w Calah|strong="H03625"\w*, \v 12 \w -|strong="H00853"\w* \w and Resen|strong="H07449"\w*, \w which is between|strong="H00996"\w* \w Nineveh|strong="H05210"\w* \w . . .|strong="H00996"\w* \w and the great|strong="H01419"\w* \w city|strong="H05892"\w* \w of Calah|strong="H03625"\w* \w . . .|strong="H01931"\w*.
\p \v 13 \w Mizraim|strong="H04714"\w* \w was the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w the Ludites|strong="H03866"\w*, \w -|strong="H00853"\w* \w the Anamites|strong="H06047"\w*, \w -|strong="H00853"\w* \w the Lehabites|strong="H03853"\w*, \w -|strong="H00853"\w* \w the Naphtuhites|strong="H05320"\w*, \v 14 \w -|strong="H00853"\w* \w the Pathrusites|strong="H06625"\w*, \w -|strong="H00853"\w* \w the Casluhites|strong="H03695"\w* (\w from|strong="H08033"\w* \w whom|strong="H00834"\w* \w the Philistines|strong="H06430"\w* \w came|strong="H03318"\w*), \w and|strong="H00853"\w* \w the Caphtorites|strong="H03732"\w*.\f + \fr 10:14 \ft Some translators adjust the Hebrew word order to \fqa the Casluhites, and the Caphtorites (from whom the Philistines came)\ft ; see also Jeremiah 47:4 and Amos 9:7.\f*
\p \v 15 \w And Canaan|strong="H03667"\w* \w was the father of|strong="H03205"\w* \w -|strong="H00853"\w* \w Sidon|strong="H06721"\w* \w his firstborn|strong="H01060"\w*,\f + \fr 10:15 \ft Or \fqa of the Sidonians, the foremost\f* \w and of|strong="H00853"\w* \w the Hittites|strong="H02845"\w*, \v 16 \w -|strong="H00853"\w* \w the Jebusites|strong="H02983"\w*, \w -|strong="H00853"\w* \w the Amorites|strong="H00567"\w*, \w -|strong="H00853"\w* \w the Girgashites|strong="H01622"\w*, \v 17 \w -|strong="H00853"\w* \w the Hivites|strong="H02340"\w*, \w -|strong="H00853"\w* \w the Arkites|strong="H06208"\w*, \w -|strong="H00853"\w* \w the Sinites|strong="H05513"\w*, \v 18 \w -|strong="H00853"\w* \w the Arvadites|strong="H00721"\w*, \w -|strong="H00853"\w* \w the Zemarites|strong="H06786"\w*, \w -|strong="H00853"\w* \w and the Hamathites|strong="H02577"\w*.
\p \w Later|strong="H00310"\w* \w the Canaanite|strong="H03669"\w* \w clans|strong="H04940"\w* \w were scattered|strong="H06327"\w*, \v 19 \w and the borders|strong="H01366"\w* \w of Canaan|strong="H03669"\w* \w extended from|strong="H01961"\w* \w Sidon|strong="H06721"\w* \w -|strong="H00935"\w* \w toward Gerar|strong="H01642"\w* \w as|strong="H05704"\w* \w far as Gaza|strong="H05804"\w*, \w and then|strong="H00935"\w* \w toward Sodom|strong="H05467"\w*, \w Gomorrah|strong="H06017"\w*, \w Admah|strong="H00126"\w*, \w and Zeboiim|strong="H06636"\w*, \w as|strong="H05704"\w* \w far as Lasha|strong="H03962"\w*.
\p \v 20 \w These [are]|strong="H00428"\w* \w the sons|strong="H01121"\w* \w of Ham|strong="H02526"\w* \w according to their clans|strong="H04940"\w*, \w languages|strong="H03956"\w*, \w lands|strong="H00776"\w*, \w and nations|strong="H01471"\w*.
\s2 The Semites
\p \v 21 \w And sons were also born|strong="H03205"\w* \w . . .|strong="H01571"\w* \w to Shem|strong="H08035"\w*, \w the older|strong="H01419"\w* \w brother|strong="H00251"\w* \w [of] Japheth|strong="H03315"\w*;\f + \fr 10:21 \ft Or \fqa Shem, whose older brother was Japheth\f* \w [Shem]|strong="H01931"\w* \w was the forefather|strong="H00001"\w* \w of all|strong="H03605"\w* \w the sons|strong="H01121"\w* \w of Eber|strong="H05677"\w*.
\p \v 22 \w The sons|strong="H01121"\w* \w of Shem|strong="H08035"\w*:
