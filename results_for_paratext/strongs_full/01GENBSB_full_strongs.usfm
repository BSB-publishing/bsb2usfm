\s1 Laban Pursues Jacob
\p \v 22 \w On the third|strong="H07992"\w* \w day|strong="H03117"\w* \w Laban|strong="H03837"\w* \w was informed|strong="H05046"\w* \w that|strong="H03588"\w* \w Jacob|strong="H03290"\w* \w had fled|strong="H01272"\w*. \v 23 \w So he took|strong="H03947"\w* \w -|strong="H00853"\w* \w his relatives|strong="H00251"\w* \w with him|strong="H05973"\w*, \w pursued|strong="H07291"\w* \w Jacob|strong="H00310"\w* \w . . .|strong="H01870"\w* \w for seven|strong="H07651"\w* \w days|strong="H03117"\w*, \w and overtook|strong="H01692"\w* \w him|strong="H00853"\w* \w in the hill country|strong="H02022"\w* \w of Gilead|strong="H01568"\w*. \v 24 \w But that night|strong="H03915"\w* \w God|strong="H00430"\w* \w came|strong="H00935"\w* \w to|strong="H00413"\w* \w Laban|strong="H03837"\w* \w the Aramean|strong="H00761"\w* \w in a dream|strong="H02472"\w* \w and warned|strong="H00559"\w* him, “\w Be careful|strong="H08104"\w* \w not|strong="H06435"\w* \w to say|strong="H01696"\w* \w anything to|strong="H05973"\w* \w Jacob|strong="H03290"\w*, \w either good|strong="H02896"\w* \w or|strong="H05704"\w* \w bad|strong="H07451"\w*.”
