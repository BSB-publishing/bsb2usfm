\p \w And the LORD|strong="H03068"\w* \w looked with favor|strong="H08159"\w* \w on|strong="H00413"\w* \w Abel|strong="H01893"\w* \w and|strong="H00413"\w* \w his offering|strong="H04503"\w*, \v 5 \w but|strong="H00413"\w* \w He had no|strong="H03808"\w* \w regard|strong="H08159"\w* \w for|strong="H00413"\w* \w Cain|strong="H07014"\w* \w and his offering|strong="H04503"\w*. \w So Cain|strong="H07014"\w* \w became very|strong="H03966"\w* \w angry|strong="H02734"\w*, \w and his countenance|strong="H06440"\w* \w fell|strong="H05307"\w*.
\p \v 6 “\w Why|strong="H04100"\w* \w are you angry|strong="H02734"\w*,” \w said|strong="H00559"\w* \w the LORD|strong="H03068"\w* \w to|strong="H00413"\w* \w Cain|strong="H07014"\w*, “- \w and why|strong="H04100"\w* \w has your countenance|strong="H06440"\w* \w fallen|strong="H05307"\w*? \v 7 \w If|strong="H00518"\w* \w you do what is right|strong="H03190"\w*, \w {will}|strong="H03808"\w* \w you not|strong="H03808"\w* \w be accepted|strong="H07613"\w*? \w But if|strong="H00518"\w* \w you refuse to do what is right|strong="H03190"\w*, \w sin|strong="H02403"\w* \w is crouching|strong="H07257"\w* \w at your door|strong="H06607"\w*; \w it desires|strong="H08669"\w* \w you|strong="H00413"\w*,\f + \fr 4:7 \ft Or \fqa it desires to control you\f* \w but you|strong="H00859"\w* \w must master|strong="H04910"\w* it.”
\p \v 8 \w Then Cain|strong="H07014"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w his brother|strong="H00251"\w* \w Abel, [“Let us go out to the field.”]|strong="H01893"\w*\f + \fr 4:8 \ft SP, LXX, Syriac, and Vulgate; Hebrew \fqa Then Cain spoke to his brother Abel.\f* \w And|strong="H01961"\w* \w while they were|strong="H01961"\w* \w in the field|strong="H07704"\w*, \w Cain|strong="H07014"\w* \w rose up|strong="H06965"\w* \w against|strong="H00413"\w* \w his brother|strong="H00251"\w* \w Abel|strong="H01893"\w* \w and killed him|strong="H02026"\w*.
