\c 1
\s1 The Proclamation of Cyrus
\r (2 Chronicles 36:22–23; Isaiah 45:1–25)
\p \v 1 \w In the first|strong="H00259"\w* \w year|strong="H08141"\w* \w of Cyrus|strong="H03566"\w* \w king|strong="H04428"\w* \w of Persia|strong="H06539"\w*, \w to fulfill|strong="H03615"\w* \w the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w spoken|strong="H06310"\w* \w through Jeremiah|strong="H03414"\w*, \w the LORD|strong="H03068"\w* \w stirred|strong="H05782"\w* \w -|strong="H00853"\w* \w the spirit|strong="H07307"\w* \w of Cyrus|strong="H03566"\w* \w king|strong="H04428"\w* \w of Persia|strong="H06539"\w* \w to send|strong="H05674"\w* \w a proclamation|strong="H06963"\w* \w throughout|strong="H03605"\w* \w his kingdom|strong="H04438"\w* \w and|strong="H01571"\w* \w to put it in writing|strong="H04385"\w* \w as follows|strong="H00559"\w*:
\pmo \v 2 “\w This is what|strong="H03541"\w* \w Cyrus|strong="H03566"\w* \w king|strong="H04428"\w* \w of Persia|strong="H06539"\w* \w says|strong="H00559"\w*:
\pmo ‘\w The LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of heaven|strong="H08064"\w*, \w who|strong="H01931"\w* \w has given|strong="H05414"\w* me \w all|strong="H03605"\w* \w the kingdoms|strong="H04467"\w* \w of the earth|strong="H00776"\w*, \w has appointed|strong="H06485"\w* \w me|strong="H05921"\w* \w to build|strong="H01129"\w* \w a house|strong="H01004"\w* for Him \w at Jerusalem|strong="H03389"\w* \w -|strong="H00834"\w* \w in Judah|strong="H03063"\w*.
\pmo \v 3 \w Whoever|strong="H04310"\w* among you \w belongs to|strong="H03605"\w* \w His people|strong="H05971"\w*, \w may his God|strong="H00430"\w* \w be|strong="H01961"\w* \w with him|strong="H05973"\w*, \w and may he go|strong="H05927"\w* \w to Jerusalem|strong="H03389"\w*\w . . .|strong="H00834"\w* \w in Judah|strong="H03063"\w* \w and build|strong="H01129"\w* \w -|strong="H00853"\w* \w the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*; \w He [is]|strong="H01931"\w* \w the God|strong="H00430"\w* \w who|strong="H00834"\w* \w is in Jerusalem|strong="H03389"\w*. \v 4 \w And let every|strong="H03605"\w* \w survivor|strong="H07604"\w*, \w wherever|strong="H03605"\w* \w . . .|strong="H04725"\w* \w -|strong="H00834"\w* \w he|strong="H01931"\w* \w lives|strong="H01481"\w*, \w . . .|strong="H08033"\w* \w be assisted|strong="H05375"\w* \w by the men|strong="H00582"\w* \w of that region|strong="H04725"\w* \w with silver|strong="H03701"\w*, \w gold|strong="H02091"\w*, \w goods|strong="H07399"\w*, \w and livestock|strong="H00929"\w*, \w along with|strong="H05973"\w* \w a freewill offering|strong="H05071"\w* \w for the house|strong="H01004"\w* \w of God|strong="H00430"\w* \w -|strong="H00834"\w* \w in Jerusalem|strong="H03389"\w*.’”
\p \v 5 \w So the family|strong="H00001"\w* \w heads|strong="H07218"\w* \w of Judah|strong="H03063"\w* \w and Benjamin|strong="H01144"\w*, \w along with the priests|strong="H03548"\w* \w and Levites|strong="H03881"\w*— \w everyone|strong="H03605"\w* \w whose spirit|strong="H07307"\w* \w God|strong="H00430"\w* \w -|strong="H00853"\w* \w had stirred|strong="H05782"\w*— \w prepared|strong="H06965"\w* \w to go up|strong="H05927"\w* \w and rebuild|strong="H01129"\w* \w -|strong="H00853"\w* \w the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w* \w -|strong="H00834"\w* \w in Jerusalem|strong="H03389"\w*.
\p \v 6 \w And all|strong="H03605"\w* \w their neighbors|strong="H05439"\w* \w supported|strong="H02388"\w* \w them|strong="H03027"\w* \w with articles|strong="H03627"\w* \w of silver|strong="H03701"\w* \w and gold|strong="H02091"\w*, \w with goods|strong="H07399"\w* \w and livestock|strong="H00929"\w*, \w and with valuables|strong="H04030"\w*, \w in addition|strong="H00905"\w* \w to|strong="H05921"\w* \w all|strong="H03605"\w* \w their freewill offerings|strong="H05068"\w*.
\s1 Cyrus Restores the Holy Vessels
\p \v 7 \w King|strong="H04428"\w* \w Cyrus|strong="H03566"\w* \w also brought out|strong="H03318"\w* \w -|strong="H00853"\w* \w the articles|strong="H03627"\w* \w belonging to the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w* \w that|strong="H00834"\w* \w Nebuchadnezzar|strong="H05019"\w* \w had carried away|strong="H03318"\w* \w from Jerusalem|strong="H03389"\w* \w and placed|strong="H05414"\w* \w in the temple|strong="H01004"\w* \w of his gods|strong="H00430"\w*. \v 8 \w Cyrus|strong="H03566"\w* \w king|strong="H04428"\w* \w of Persia|strong="H06539"\w* \w had them brought out|strong="H03318"\w* \w by|strong="H05921"\w* \w the hand|strong="H03027"\w* \w of Mithredath|strong="H04990"\w* \w the treasurer|strong="H01489"\w*, \w who counted them out|strong="H05608"\w* \w to Sheshbazzar|strong="H08339"\w* \w the prince|strong="H05387"\w* \w of Judah|strong="H03063"\w*.\f + \fr 1:8 \ft That is, the leader of the exiles returning to Judah\f* \v 9 \w This|strong="H00428"\w* \w was the inventory|strong="H04557"\w*:
\b 
