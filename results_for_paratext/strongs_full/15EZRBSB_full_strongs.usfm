\b 
\li1 \v 62 \w These [men]|strong="H00428"\w* \w searched for|strong="H01245"\w* \w their family records|strong="H03791"\w* \w . . .|strong="H03187"\w*, \w but they could not|strong="H03808"\w* \w find them|strong="H04672"\w* \w and so were excluded|strong="H01351"\w* \w from|strong="H04480"\w* \w the priesthood {as unclean}|strong="H03550"\w*. \v 63 \w The governor|strong="H08660"\w* \w ordered|strong="H00559"\w* them\w . . .|strong="H00834"\w* \w not|strong="H03808"\w* \w to eat|strong="H00398"\w* \w the most holy things|strong="H06944"\w* \w . . .|strong="H06944"\w* \w until|strong="H05704"\w* \w . . .|strong="H05975"\w* \w there was a priest|strong="H03548"\w* \w to consult the Urim|strong="H00224"\w* \w and Thummim|strong="H08550"\w*.\f + \fr 2:63 \ft Literally \fqa Lights and Perfections\f*
\p \v 64 \w The whole|strong="H03605"\w* \w assembly|strong="H06951"\w* \w [numbered]|strong="H00259"\w* \w 42,360 {}|strong="H00702"\w* \w . . .|strong="H07239"\w* \w . . .|strong="H00505"\w* \w . . .|strong="H07969"\w* \w . . .|strong="H03967"\w* \w . . .|strong="H08346"\w*, \v 65 \w in addition to|strong="H00905"\w* \w . . .|strong="H00428"\w* \w their 7,337|strong="H07651"\w* \w . . .|strong="H00505"\w* \w . . .|strong="H07969"\w* \w . . .|strong="H03967"\w* \w . . .|strong="H07970"\w* \w . . .|strong="H07651"\w* \w menservants|strong="H05650"\w* \w and maidservants|strong="H00519"\w*, \w as well as their 200|strong="H03967"\w* \w male|strong="H07891"\w* \w and female singers|strong="H07891"\w*. \v 66 \w They had 736|strong="H07651"\w* \w . . .|strong="H03967"\w* \w . . .|strong="H07970"\w* \w . . .|strong="H08337"\w* \w horses|strong="H05483"\w*, \w 245|strong="H03967"\w* \w . . .|strong="H00705"\w* \w . . .|strong="H02568"\w* \w mules|strong="H06505"\w*, \v 67 \w 435|strong="H00702"\w* \w . . .|strong="H03967"\w* \w . . .|strong="H07970"\w* \w . . .|strong="H02568"\w* \w camels|strong="H01581"\w*, \w and 6,720|strong="H08337"\w* \w . . .|strong="H00505"\w* \w . . .|strong="H07651"\w* \w . . .|strong="H03967"\w* \w . . .|strong="H06242"\w* \w donkeys|strong="H02543"\w*.
\s1 Offerings by the Exiles
\r (Exodus 38:21–31; Nehemiah 7:70–73)
\p \v 68 \w When they arrived|strong="H00935"\w* \w at the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w* \w -|strong="H00834"\w* \w in Jerusalem|strong="H03389"\w*, \w [some] of the heads|strong="H07218"\w* \w of the families|strong="H00001"\w* \w gave freewill offerings|strong="H05068"\w* \w to rebuild|strong="H05975"\w* \w the house|strong="H01004"\w* \w of God|strong="H00430"\w* \w on|strong="H05921"\w* \w its original site|strong="H04349"\w*. \v 69 \w According to their ability|strong="H03581"\w*, \w they gave|strong="H05414"\w* \w to the treasury|strong="H00214"\w* \w for this work|strong="H04399"\w* \w 61,000 {}|strong="H08337"\w* \w . . .|strong="H07239"\w* \w . . .|strong="H00505"\w* \w darics|strong="H01871"\w* \w of gold|strong="H02091"\w*,\f + \fr 2:69 \ft Or \fqa 61,000 gold drachmas\ft ; that is, approximately 1,129.7 pounds or 512.4 kilograms of gold coins\f* \w 5,000 {}|strong="H02568"\w* \w . . .|strong="H00505"\w* \w minas|strong="H04488"\w* \w of silver|strong="H03701"\w*,\f + \fr 2:69 \fqa 5,000 minas \ft is approximately 3.14 tons or 2.85 metric tons of silver.\f* \w and 100|strong="H03967"\w* \w priestly|strong="H03548"\w* \w garments|strong="H03801"\w*.
\p \v 70 \w So the priests|strong="H03548"\w*, \w the Levites|strong="H03881"\w*, \w the singers|strong="H07891"\w*, \w the gatekeepers|strong="H07778"\w*, \w and the temple servants|strong="H05411"\w*, \w along with some|strong="H04480"\w* \w of the people|strong="H05971"\w*, \w settled|strong="H03427"\w* \w in their own towns|strong="H05892"\w*; \w and the rest|strong="H03605"\w* \w of the Israelites|strong="H03478"\w*\f + \fr 2:70 \ft Or \fqa all Israel\f* \w settled [in their towns]|strong="H05892"\w*.
\c 3
\s1 Sacrifices Restored
\p \v 1 \w By the seventh|strong="H07637"\w* \w month|strong="H02320"\w*, \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w had settled|strong="H05060"\w* \w in their towns|strong="H05892"\w*, \w and the people|strong="H05971"\w* \w assembled|strong="H00622"\w* \w as one|strong="H00259"\w* \w man|strong="H00376"\w* \w in|strong="H00413"\w* \w Jerusalem|strong="H03389"\w*.
\p \v 2 \w Then Jeshua|strong="H03442"\w* \w son|strong="H01121"\w* \w of Jozadak|strong="H03136"\w*\f + \fr 3:2 \fqa Jozadak \ft is a variant of \fqa Jehozadak\ft ; also in verse 8; see 1 Chronicles 6:14.\f* \w and his fellow|strong="H00251"\w* \w priests|strong="H03548"\w*, \w along with Zerubbabel|strong="H02216"\w* \w son|strong="H01121"\w* \w of Shealtiel|strong="H07597"\w* \w and his associates|strong="H00251"\w*, \w began|strong="H06965"\w* \w to build|strong="H01129"\w* \w -|strong="H00853"\w* \w the altar|strong="H04196"\w* \w of the God|strong="H00430"\w* \w of Israel|strong="H03478"\w* \w to sacrifice|strong="H05927"\w* \w burnt offerings|strong="H05930"\w* \w on it|strong="H05921"\w*, \w as it is written|strong="H03789"\w* \w in the Law|strong="H08451"\w* \w of Moses|strong="H04872"\w* \w the man|strong="H00376"\w* \w of God|strong="H00430"\w*. \v 3 \w They set up|strong="H03559"\w* \w the altar|strong="H04196"\w* \w on|strong="H05921"\w* \w its foundation|strong="H04350"\w* \w and sacrificed|strong="H05927"\w* \w . . .|strong="H05921"\w* \w burnt offerings|strong="H05930"\w* \w on it|strong="H05921"\w* \w to the LORD|strong="H03068"\w* — \w [both] the morning|strong="H01242"\w* \w and evening|strong="H06153"\w* \w burnt offerings|strong="H05930"\w* — \w even though|strong="H03588"\w* \w they feared|strong="H00367"\w* \w the people|strong="H05971"\w* \w of the land|strong="H00776"\w*.
\p \v 4 \w They also celebrated|strong="H06213"\w* \w -|strong="H00853"\w* \w the Feast|strong="H02282"\w* \w of Tabernacles|strong="H05521"\w*\f + \fr 3:4 \ft That is, Sukkot, the autumn feast of pilgrimage to Jerusalem; also translated as \fqa the Feast of Booths \ft or \fqa the Feast of Shelters \ft and originally called \fqa the Feast of Ingathering\ft (see Exodus 23:16 and Exodus 34:22).\f* \w in accordance with what is written|strong="H03789"\w*, \w and they offered burnt offerings|strong="H05930"\w* \w daily|strong="H03117"\w* \w . . .|strong="H03117"\w* \w based on the number|strong="H04557"\w* \w prescribed|strong="H04941"\w* \w . . .|strong="H01697"\w* \w for each day|strong="H03117"\w* \w . . .|strong="H03117"\w*.
\p \v 5 \w After that|strong="H00310"\w*, \w they presented the regular|strong="H08548"\w* \w burnt offerings|strong="H05930"\w* \w and [those] for New Moons|strong="H02320"\w* \w and for all|strong="H03605"\w* \w the appointed|strong="H04150"\w* \w sacred feasts|strong="H06942"\w* \w of the LORD|strong="H03068"\w*, \w as well as all|strong="H03605"\w* \w the freewill offerings|strong="H05071"\w* \w brought|strong="H05068"\w* \w to the LORD|strong="H03068"\w*.
\p \v 6 \w On the first|strong="H00259"\w* \w day|strong="H03117"\w* \w of the seventh|strong="H07637"\w* \w month|strong="H02320"\w*, \w [the Israelites] began|strong="H02490"\w* \w to offer|strong="H05927"\w* \w burnt offerings|strong="H05930"\w* \w to the LORD|strong="H03068"\w*, \w {although the foundation} of the temple|strong="H01964"\w* \w of the LORD|strong="H03068"\w* \w vvv|strong="H03808"\w* \w had not been laid|strong="H03245"\w*. \v 7 \w They gave|strong="H05414"\w* \w money|strong="H03701"\w* \w to the masons|strong="H02672"\w* \w and carpenters|strong="H02796"\w*, \w and food|strong="H03978"\w* \w and drink|strong="H04960"\w* \w and oil|strong="H08081"\w* \w to the people of Sidon|strong="H06722"\w* \w and Tyre|strong="H06876"\w* \w to bring|strong="H00935"\w* \w cedar|strong="H00730"\w* \w logs|strong="H06086"\w* \w from|strong="H04480"\w* \w Lebanon|strong="H03844"\w* \w to|strong="H00413"\w* \w Joppa|strong="H03305"\w* \w by sea|strong="H03220"\w*, \w as authorized|strong="H07558"\w* \w . . .|strong="H05921"\w* \w by Cyrus|strong="H03566"\w* \w king|strong="H04428"\w* \w of Persia|strong="H06539"\w*.
\s1 Temple Restoration Begins
\p \v 8 \w In the second|strong="H08145"\w* \w month|strong="H02320"\w* \w of the second|strong="H08145"\w* \w year|strong="H08141"\w* \w after they had arrived|strong="H00935"\w* \w at|strong="H00413"\w* \w the house|strong="H01004"\w* \w of God|strong="H00430"\w* \w in Jerusalem|strong="H03389"\w*, \w Zerubbabel|strong="H02216"\w* \w son|strong="H01121"\w* \w of Shealtiel|strong="H07597"\w*, \w Jeshua|strong="H03442"\w* \w son|strong="H01121"\w* \w of Jozadak|strong="H03136"\w*, \w and the rest|strong="H07605"\w* \w of their associates|strong="H00251"\w* \w including the priests|strong="H03548"\w*, \w the Levites|strong="H03881"\w*, \w and all|strong="H03605"\w* \w who had returned|strong="H00935"\w* \w to Jerusalem|strong="H03389"\w* \w from the captivity|strong="H07628"\w*, \w began [the work]|strong="H02490"\w*. \w They appointed|strong="H05975"\w* \w -|strong="H00853"\w* \w Levites|strong="H03881"\w* \w twenty|strong="H06242"\w* \w years of age|strong="H01121"\w* \w . . .|strong="H08141"\w* \w or older|strong="H04605"\w* \w to supervise|strong="H05329"\w* \w . . .|strong="H05921"\w* \w the construction|strong="H04399"\w* \w of the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*. \v 9 \w So Jeshua|strong="H03442"\w* \w and his sons|strong="H01121"\w* \w and brothers|strong="H00251"\w*, \w Kadmiel|strong="H06934"\w* \w and his sons|strong="H01121"\w* (\w descendants|strong="H01121"\w* \w of Yehudah|strong="H03063"\w*),\f + \fr 3:9 \ft Hebrew \fqa sons of Judah\ft ; that is, most likely, \fqa sons of Yehudah\ft , another name for \fqa Hodevah \ft or \fqa Hodaviah\ft ; see Ezra 2:40 and Nehemiah 7:43.\f* \w [and] the sons|strong="H01121"\w* \w of Henadad|strong="H02582"\w* \w and their sons|strong="H01121"\w* \w and brothers|strong="H00251"\w* — \w all Levites|strong="H03881"\w* — \w joined|strong="H05975"\w* \w together|strong="H00259"\w* \w to supervise|strong="H05329"\w* \w . . .|strong="H05921"\w* \w those working|strong="H06213"\w* \w . . .|strong="H04399"\w* \w on the house|strong="H01004"\w* \w of God|strong="H00430"\w*.
\p \v 10 \w When the builders|strong="H01129"\w* \w -|strong="H00853"\w* \w had laid the foundation|strong="H03245"\w* \w of the temple|strong="H01964"\w* \w of the LORD|strong="H03068"\w*, \w the priests|strong="H03548"\w* \w in their apparel|strong="H03847"\w* \w with trumpets|strong="H02689"\w*, \w and the Levites|strong="H03881"\w* (\w the sons|strong="H01121"\w* \w of Asaph|strong="H00623"\w*) \w with cymbals|strong="H04700"\w*, \w took their positions|strong="H05975"\w* \w to praise|strong="H01984"\w* \w -|strong="H00853"\w* \w the LORD|strong="H03068"\w*, \w as|strong="H05921"\w* \w David|strong="H01732"\w* \w king|strong="H04428"\w* \w of Israel|strong="H03478"\w* \w had prescribed|strong="H03027"\w*. \v 11 \w And they sang responsively|strong="H06030"\w* \w with praise|strong="H01984"\w* \w and thanksgiving|strong="H03034"\w* \w to the LORD|strong="H03068"\w*:
\b 
\q1 “\w For|strong="H03588"\w* \w He is good|strong="H02896"\w*;
\q2 \w for|strong="H03588"\w* \w His loving devotion|strong="H02617"\w*\f + \fr 3:11 \ft Forms of the Hebrew \fqa chesed \ft are translated here and in most cases throughout the Scriptures as \fqa loving devotion\ft ; the range of meaning includes \fqa love\ft , \fqa goodness\ft , \fqa kindness\ft , \fqa faithfulness\ft , and \fqa mercy\ft , as well as \fqa loyalty to a covenant\ft .\f* \w to|strong="H05921"\w* \w Israel|strong="H03478"\w* \w endures forever|strong="H05769"\w*.”
\p \w Then all|strong="H03605"\w* \w the people|strong="H05971"\w* \w gave a great|strong="H01419"\w* \w shout|strong="H07321"\w* \w . . .|strong="H08643"\w* \w of praise|strong="H01984"\w* \w to the LORD|strong="H03068"\w*, \w because {the foundation}|strong="H05921"\w* \w of the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w* \w had been laid|strong="H03245"\w*.
\p \v 12 \w But many|strong="H07227"\w* \w of the older|strong="H02205"\w* \w priests|strong="H03548"\w*, \w Levites|strong="H03881"\w*, \w and family|strong="H00001"\w* \w heads|strong="H07218"\w* \w who|strong="H00834"\w* \w had seen|strong="H07200"\w* \w -|strong="H00853"\w* \w the first|strong="H07223"\w* \w temple|strong="H01004"\w* \w wept|strong="H01058"\w* \w loudly|strong="H06963"\w* \w . . .|strong="H01419"\w* \w when they saw|strong="H05869"\w* \w the foundation|strong="H03245"\w* \w of this|strong="H02088"\w* \w temple|strong="H01004"\w*. \w Still, many|strong="H07227"\w* \w others shouted|strong="H08643"\w* \w . . .|strong="H07311"\w* \w joyfully|strong="H06963"\w* \w . . .|strong="H08057"\w*. \v 13 \w The people|strong="H05971"\w* \w could not|strong="H00369"\w* \w distinguish|strong="H05234"\w* \w vvv|strong="H06963"\w* \w the shouts|strong="H08643"\w* \w of joy|strong="H08057"\w* \w from the sound|strong="H06963"\w* \w of weeping|strong="H01065"\w*, \w because|strong="H03588"\w* \w . . .|strong="H05971"\w* \w the people|strong="H05971"\w* \w were making so much noise|strong="H07321"\w* \w . . .|strong="H08643"\w* \w . . .|strong="H01419"\w*. \w And the sound|strong="H06963"\w* \w was heard|strong="H08085"\w* \w from|strong="H05704"\w* \w afar|strong="H07350"\w*.
\c 4
\s1 Adversaries Hinder the Work
\p \v 1 \w When the enemies|strong="H06862"\w* \w of Judah|strong="H03063"\w* \w and Benjamin|strong="H01144"\w* \w heard|strong="H08085"\w* \w that|strong="H03588"\w* \w the exiles|strong="H01121"\w* \w . . .|strong="H01473"\w* \w were building|strong="H01129"\w* \w a temple|strong="H01964"\w* \w for the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \v 2 \w they approached|strong="H05066"\w* \w . . .|strong="H00413"\w* \w Zerubbabel|strong="H02216"\w* \w . . .|strong="H00413"\w* \w and the heads|strong="H07218"\w* \w of the families|strong="H00001"\w*, \w saying|strong="H00559"\w* . . ., “\w Let us build|strong="H01129"\w* \w with you|strong="H05973"\w* \w because|strong="H03588"\w*, like you, \w we seek|strong="H01875"\w* \w your God|strong="H00430"\w* \w . . .|strong="H00587"\w* \w and have been sacrificing|strong="H02076"\w* \w to Him since|strong="H03808"\w* \w the time|strong="H03117"\w* \w of King|strong="H04428"\w*\w . . .|strong="H00634"\w* \w Esar-haddon|strong="H00634"\w* \w of Assyria|strong="H00804"\w*, \w who brought|strong="H05927"\w* \w us|strong="H00853"\w* \w here|strong="H06311"\w*.”
\p \v 3 \w But Zerubbabel|strong="H02216"\w*, \w Jeshua|strong="H03442"\w*, \w and the other|strong="H07605"\w* \w heads|strong="H07218"\w* \w of the families|strong="H00001"\w* \w of Israel|strong="H03478"\w* \w replied|strong="H00559"\w* -, “\w You have no|strong="H03808"\w* part with us \w in building|strong="H01129"\w* \w a house|strong="H01004"\w* \w for our God|strong="H00430"\w*, \w since|strong="H03588"\w* \w we|strong="H00587"\w* \w alone|strong="H03162"\w* \w must build|strong="H01129"\w* \w it for the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w as|strong="H00834"\w* \w -|strong="H04428"\w* \w Cyrus|strong="H03566"\w* \w king|strong="H04428"\w* \w of Persia|strong="H06539"\w* \w has commanded us|strong="H06680"\w*.”
\p \v 4 \w Then|strong="H01961"\w* \w the people|strong="H05971"\w* \w of the land|strong="H00776"\w* \w set out to discourage|strong="H07503"\w* \w . . .|strong="H03027"\w* \w the people|strong="H05971"\w* \w of Judah|strong="H03063"\w* \w and make them afraid|strong="H01089"\w* \w -|strong="H00853"\w* \w to build|strong="H01129"\w*. \v 5 \w They hired|strong="H07936"\w* \w counselors|strong="H03289"\w* \w against them|strong="H05921"\w* \w to frustrate|strong="H06565"\w* \w their plans|strong="H06098"\w* \w throughout|strong="H03605"\w* \w the reign|strong="H03117"\w* \w of Cyrus|strong="H03566"\w* \w king|strong="H04428"\w* \w of Persia|strong="H06539"\w* \w and down to|strong="H05704"\w* \w the reign|strong="H04438"\w* \w of Darius|strong="H01867"\w* \w king|strong="H04428"\w* \w of Persia|strong="H06539"\w*.
\s1 Opposition under Xerxes and Artaxerxes
\p \v 6 \w At the beginning|strong="H08462"\w* \w . . .|strong="H04438"\w* \w of the reign|strong="H04438"\w* \w of Xerxes|strong="H00325"\w*,\f + \fr 4:6 \ft Hebrew \fqa Ahasuerus\f* \w an accusation|strong="H07855"\w* \w was lodged|strong="H03789"\w* \w against|strong="H05921"\w* \w the people|strong="H03427"\w* \w of Judah|strong="H03063"\w* \w and Jerusalem|strong="H03389"\w*.
\p \v 7 \w And in the days|strong="H03117"\w* \w of Artaxerxes [king]|strong="H00783"\w* \w of Persia|strong="H06539"\w*, \w Bishlam|strong="H01312"\w*, \w Mithredath|strong="H04990"\w*, \w Tabeel|strong="H02870"\w*, \w and the rest of|strong="H07605"\w* \w his associates|strong="H03674"\w* \w wrote [a letter]|strong="H03789"\w* \w to|strong="H05921"\w* \w vvv|strong="H04428"\w* \w Artaxerxes|strong="H00783"\w*. \w -|strong="H03791"\w* \w [It]|strong="H05406"\w* \w was written|strong="H03789"\w* \w in Aramaic|strong="H00762"\w* \w and then translated|strong="H08638"\w* \w -|strong="H00762"\w*.\f + \fr 4:7 \ft The original text of Ezra 4:8 through Ezra 6:18 is in Aramaic.\f*
\p \v 8 \w Rehum|strong="H07348"\w* \w the commander|strong="H01169"\w* \w . . .|strong="H02942"\w* \w and Shimshai|strong="H08124"\w* \w the scribe|strong="H05613"\w* \w wrote|strong="H03790"\w* \w [the]|strong="H02298"\w* \w letter|strong="H00104"\w* \w against|strong="H05922"\w* \w Jerusalem|strong="H03390"\w* \w to King|strong="H04430"\w* \w Artaxerxes|strong="H00783"\w* \w as follows|strong="H03660"\w*:
\pmo \v 9 \w -|strong="H00116"\w* \w From Rehum|strong="H07348"\w* \w the commander|strong="H01169"\w* \w . . .|strong="H02942"\w*, \w Shimshai|strong="H08124"\w* \w the scribe|strong="H05613"\w*, \w and the rest|strong="H07606"\w* \w of their associates|strong="H03675"\w*— \w the judges|strong="H01784"\w* \w and officials|strong="H00671"\w* \w over Tripolis|strong="H02967"\w*, \w Persia|strong="H00670"\w*, \w Erech|strong="H00756"\w* \w and Babylon|strong="H00896"\w*, \w the Elamites|strong="H05962"\w* \w of Susa|strong="H07801"\w*\w . . .|strong="H01768"\w*, \v 10 \w and the rest|strong="H07606"\w* \w of the peoples|strong="H00524"\w* \w whom|strong="H01768"\w* \w the great|strong="H07229"\w* \w and honorable|strong="H03358"\w* \w Ashurbanipal|strong="H00620"\w*\f + \fr 4:10 \ft Aramaic \fqa Osnappar\ft , another name for \fqa Ashurbanipal\f* \w deported|strong="H01541"\w* \w and settled|strong="H03488"\w* \w . . .|strong="H01994"\w* \w in the cities|strong="H07149"\w* \w of|strong="H01768"\w* \w Samaria|strong="H08115"\w* \w and elsewhere|strong="H07606"\w* \w west|strong="H05675"\w* \w of the Euphrates|strong="H05103"\w* \w . . .|strong="H03706"\w*.\f + \fr 4:10 \ft Aramaic \fqa beyond the River\ft ; also in verses 11, 16, 17, and 20\f*
\pmo \v 11 (\w This|strong="H01836"\w* \w is the text|strong="H06573"\w* \w of the letter|strong="H00104"\w* \w . . .|strong="H01768"\w* \w they sent|strong="H07972"\w* \w to him|strong="H05922"\w*.)
\pmo \w To|strong="H05922"\w* \w King|strong="H04430"\w* \w Artaxerxes|strong="H00783"\w*,
\pmo \w From your servants|strong="H05649"\w*, \w the men|strong="H00606"\w* \w west|strong="H05675"\w* \w of the Euphrates|strong="H05103"\w* \w . . .|strong="H03706"\w*:
\pmo \v 12 \w Let it be|strong="H01934"\w* \w known|strong="H03046"\w* \w to the king|strong="H04430"\w* \w that|strong="H01768"\w* \w the Jews|strong="H03062"\w* \w who|strong="H01768"\w* \w came|strong="H05559"\w* \w from|strong="H04481"\w* \w you|strong="H03890"\w* \w to us|strong="H05922"\w* \w have returned|strong="H00858"\w* \w to Jerusalem|strong="H03390"\w* \w and are rebuilding|strong="H01124"\w* \w that rebellious|strong="H04779"\w* \w and wicked|strong="H00873"\w* \w city|strong="H07149"\w*. \w They are restoring|strong="H03635"\w* \w [its] walls|strong="H07792"\w* \w and repairing|strong="H02338"\w* \w its foundations|strong="H00787"\w*.
\pmo \v 13 \w Let it now|strong="H03705"\w* \w be|strong="H01934"\w* \w known|strong="H03046"\w* \w to the king|strong="H04430"\w* \w that|strong="H01768"\w* \w if|strong="H02006"\w* \w that|strong="H01791"\w* \w city|strong="H07149"\w* \w is rebuilt|strong="H01124"\w* \w and its walls|strong="H07792"\w* \w are restored|strong="H03635"\w*, \w they will not|strong="H03809"\w* \w pay|strong="H05415"\w* \w tribute|strong="H04061"\w*, \w duty|strong="H01093"\w*, \w or toll|strong="H01983"\w*, \w and the royal|strong="H04430"\w* \w treasury|strong="H00674"\w* \w will suffer|strong="H05142"\w*.
\pmo \v 14 \w Now|strong="H03705"\w* \w because|strong="H03606"\w*\w . . .|strong="H06903"\w*\w . . .|strong="H01768"\w*\w . . .|strong="H04416"\w* \w we are in the service|strong="H04415"\w* \w of the palace|strong="H01965"\w*\f + \fr 4:14 \ft Literally \fqa because the salt of the palace is our salt\f* \w vvv|strong="H03809"\w* \w and it is not fitting|strong="H00749"\w* for us \w to allow|strong="H02370"\w* \w . . .|strong="H05922"\w* \w . . .|strong="H01836"\w* \w the king|strong="H04430"\w* \w to be dishonored|strong="H06173"\w*, \w we have sent|strong="H07972"\w* \w to inform|strong="H03046"\w* \w the king|strong="H04430"\w* \v 15 \w that|strong="H01768"\w* \w a search should be made|strong="H01240"\w* \w of the record|strong="H01799"\w* \w books|strong="H05609"\w* \w of|strong="H01768"\w* \w your fathers|strong="H00002"\w*. \w [In these]|strong="H01799"\w* \w books|strong="H05609"\w* \w you will discover|strong="H07912"\w* \w and verify|strong="H03046"\w* \w that|strong="H01768"\w* \w the city|strong="H07149"\w*\w . . .|strong="H01791"\w* \w is a rebellious|strong="H04779"\w* \w city|strong="H07149"\w*, \w harmful|strong="H05142"\w* \w to kings|strong="H04430"\w* \w and provinces|strong="H04083"\w*, \w inciting|strong="H05648"\w* \w sedition|strong="H00849"\w* \w -|strong="H01459"\w* \w from|strong="H04481"\w* \w ancient|strong="H05957"\w* \w times|strong="H03118"\w*. \w That is why|strong="H05922"\w* \w this|strong="H01836"\w* \w city|strong="H07149"\w* \w . . .|strong="H01791"\w* \w was destroyed|strong="H02718"\w*.
\pmo \v 16 \w We|strong="H00586"\w* \w advise|strong="H03046"\w* \w the king|strong="H04430"\w* \w that|strong="H01768"\w* \w if|strong="H02006"\w* \w this|strong="H01791"\w* \w city|strong="H07149"\w* \w is rebuilt|strong="H01124"\w* \w and its walls|strong="H07792"\w* \w are restored|strong="H03635"\w*, \w . . .|strong="H06903"\w* \w . . .|strong="H01836"\w* \w you will have|strong="H00383"\w* \w no|strong="H03809"\w* - \w dominion|strong="H02508"\w* \w west|strong="H05675"\w* \w of the Euphrates|strong="H05103"\w*.
\s1 The Decree of Artaxerxes
\p \v 17 \w [Then] the king|strong="H04430"\w* \w sent|strong="H07972"\w* \w this reply|strong="H06600"\w*:
\pmo \w To|strong="H05922"\w* \w Rehum|strong="H07348"\w* \w the commander|strong="H01169"\w* \w . . .|strong="H02942"\w*, \w Shimshai|strong="H08124"\w* \w the scribe|strong="H05613"\w*, \w and the rest|strong="H07606"\w* \w of your associates|strong="H03675"\w* \w . . .|strong="H01768"\w* \w living|strong="H03488"\w* \w in Samaria|strong="H08115"\w* \w and elsewhere|strong="H07606"\w* \w in the region west|strong="H05675"\w* \w of the Euphrates|strong="H05103"\w*:
\pmo \w Greetings|strong="H08001"\w*. \w . . .|strong="H03706"\w*
\pmo \v 18 \w The letter|strong="H05407"\w* \w . . .|strong="H01768"\w* \w you sent|strong="H07972"\w* \w us|strong="H05922"\w* \w has been translated|strong="H06568"\w* \w and read|strong="H07123"\w* \w in my presence|strong="H06925"\w*. \v 19 \w vvv|strong="H04481"\w* \w I issued|strong="H07761"\w* \w a decree|strong="H02942"\w*, \w and a search was conducted|strong="H01240"\w*. \w It was discovered|strong="H07912"\w* \w that|strong="H01768"\w* \w this|strong="H01791"\w* \w . . .|strong="H04481"\w* \w city|strong="H07149"\w* \w has revolted|strong="H05376"\w* \w against|strong="H05922"\w* \w kings|strong="H04430"\w* \w from ancient|strong="H05957"\w* \w times|strong="H03118"\w*, \w engaging in rebellion|strong="H04776"\w* \w and sedition|strong="H00849"\w* \w . . .|strong="H05648"\w*. \v 20 \w And mighty|strong="H08624"\w* \w . . .|strong="H01934"\w* \w kings|strong="H04430"\w* \w have ruled over|strong="H05922"\w* \w Jerusalem|strong="H03390"\w* \w and exercised authority|strong="H07990"\w* \w over the whole|strong="H03606"\w* \w region west|strong="H05675"\w* \w of the Euphrates|strong="H05103"\w*; \w and tribute|strong="H04061"\w*, \w duty|strong="H01093"\w*, \w and toll|strong="H01983"\w* \w were paid|strong="H03052"\w* to them.
\pmo \v 21 \w Now, therefore|strong="H03705"\w*, \w issue|strong="H07761"\w* \w an order|strong="H02942"\w* \w for these|strong="H00479"\w* \w men|strong="H01400"\w* \w to stop|strong="H00989"\w*, \w so that this|strong="H01791"\w* \w city|strong="H07149"\w* \w will not|strong="H03809"\w* \w be rebuilt|strong="H01124"\w* \w until|strong="H05705"\w* \w I|strong="H04481"\w* \w so order|strong="H02942"\w* \w . . .|strong="H07761"\w*. \v 22 \w See that you|strong="H02095"\w* \w . . .|strong="H01934"\w* \w do not neglect|strong="H07960"\w* \w . . .|strong="H05648"\w* \w . . .|strong="H05922"\w* \w this matter|strong="H01836"\w*. \w Why|strong="H04101"\w* \w allow this threat|strong="H02257"\w* \w to increase|strong="H07680"\w* \w and the royal|strong="H04430"\w* \w interests to suffer|strong="H05142"\w*?
\p \v 23 \w When|strong="H00116"\w* \w . . .|strong="H04481"\w* \w . . .|strong="H01768"\w* \w the text|strong="H06573"\w* \w of the letter|strong="H05407"\w*\w . . .|strong="H01768"\w* \w from King|strong="H04430"\w* \w Artaxerxes|strong="H00783"\w* \w was read|strong="H07123"\w* \w to|strong="H06925"\w* \w Rehum|strong="H07348"\w*, \w Shimshai|strong="H08124"\w* \w the scribe|strong="H05613"\w*, \w and their associates|strong="H03675"\w*, \w they went|strong="H00236"\w* \w immediately|strong="H00924"\w* \w to|strong="H05922"\w* \w the Jews|strong="H03062"\w* \w in Jerusalem|strong="H03390"\w* \w and forcibly|strong="H00153"\w* \w . . .|strong="H02429"\w* \w stopped|strong="H00989"\w* \w them|strong="H01994"\w*.
\p \v 24 \w Thus|strong="H00116"\w* \w the construction|strong="H05673"\w* \w of the house|strong="H01005"\w* \w of God|strong="H00426"\w* \w . . .|strong="H01768"\w* \w in Jerusalem|strong="H03390"\w* \w ceased|strong="H00989"\w*, \w and it remained|strong="H01934"\w* \w at a standstill|strong="H00989"\w* \w until|strong="H05705"\w* \w the second|strong="H08648"\w* \w year|strong="H08140"\w* \w of the reign|strong="H04437"\w* \w of Darius|strong="H01868"\w* \w king|strong="H04430"\w* \w of Persia|strong="H06540"\w*.
\c 5
\s1 Temple Rebuilding Resumes
\r (Haggai 1:1–11)
\p \v 1 \w Later, the prophets|strong="H05029"\w* \w Haggai|strong="H02292"\w* \w and Zechariah|strong="H02148"\w* \w son|strong="H01247"\w* \w of Iddo|strong="H05714"\w* \w prophesied|strong="H05013"\w*\w . . .|strong="H05029"\w* \w to|strong="H05922"\w* \w the Jews|strong="H03062"\w* \w -|strong="H01768"\w* \w in Judah|strong="H03061"\w* \w and Jerusalem|strong="H03390"\w* \w in the name|strong="H08036"\w* \w of the God|strong="H00426"\w* \w of Israel|strong="H03479"\w*, \w who was over them|strong="H05922"\w*. \v 2 \w Then|strong="H00116"\w* \w Zerubbabel|strong="H02217"\w* \w son|strong="H01247"\w* \w of Shealtiel|strong="H07598"\w* \w and Jeshua|strong="H03443"\w* \w son|strong="H01247"\w* \w of Jozadak|strong="H03136"\w*\f + \fr 5:2 \fqa Jozadak \ft is a variant of \fqa Jehozadak\ft ; see 1 Chronicles 6:14.\f* \w rose up|strong="H06966"\w* \w and began|strong="H08271"\w* \w to rebuild|strong="H01124"\w* \w the house|strong="H01005"\w* \w of God|strong="H00426"\w* \w in Jerusalem|strong="H03390"\w*. \w And the prophets|strong="H05029"\w* \w . . .|strong="H01768"\w* \w of|strong="H01768"\w* \w God|strong="H00426"\w* \w were with them|strong="H05974"\w*, \w helping|strong="H05583"\w* them.
\p \v 3 \w At that time|strong="H02166"\w* \w Tattenai|strong="H08674"\w* \w the governor|strong="H06347"\w* \w [of the region] west|strong="H05675"\w* \w of the Euphrates|strong="H05103"\w*,\f + \fr 5:3 \ft Aramaic \fqa the governor beyond the River\ft ; also in verse 6\f* \w vvv|strong="H08370"\w* \w Shethar-bozenai|strong="H08370"\w*, \w and their associates|strong="H03675"\w* \w . . .|strong="H03652"\w* \w went|strong="H00858"\w* \w to [the Jews]|strong="H05922"\w* \w and asked|strong="H00560"\w*, “\w Who|strong="H04479"\w* \w authorized you|strong="H07761"\w* \w -|strong="H02942"\w* \w to rebuild|strong="H01124"\w* \w this|strong="H01836"\w* \w temple|strong="H01005"\w* \w and restore|strong="H03635"\w* \w this|strong="H01836"\w* \w structure|strong="H00846"\w*?”
\p \v 4 \w They also|strong="H00116"\w* \w . . .|strong="H03660"\w* \w asked|strong="H00560"\w*,\f + \fr 5:4 \ft LXX and Syriac; Aramaic \fqa Then we told them,\f* “\w What|strong="H04479"\w* \w are|strong="H00581"\w* \w the names|strong="H08036"\w* \w of the men|strong="H01400"\w* \w who|strong="H01768"\w* \w are constructing|strong="H01124"\w* \w this|strong="H01836"\w* \w building|strong="H01147"\w*?”
\p \v 5 \w But the eye|strong="H05870"\w* \w of their God|strong="H00426"\w* \w was|strong="H01934"\w* \w on|strong="H05922"\w* \w the elders|strong="H07868"\w* \w of the Jews|strong="H03062"\w*, \w so that they were not|strong="H03809"\w* \w stopped|strong="H00989"\w* \w -|strong="H01994"\w* \w until|strong="H05705"\w* \w a report|strong="H02941"\w* \w was sent|strong="H01946"\w* \w to Darius|strong="H01868"\w* \w and|strong="H00116"\w* \w written instructions|strong="H05407"\w* \w about|strong="H05922"\w* \w this matter|strong="H01836"\w* \w were returned|strong="H08421"\w*.
\s1 Tattenai’s Letter to Darius
\p \v 6 \w This is the text|strong="H06573"\w* \w of the letter|strong="H00104"\w* \w that|strong="H01768"\w* \w Tattenai|strong="H08674"\w* \w the governor|strong="H06347"\w* \w of the region west|strong="H05675"\w* \w of the Euphrates|strong="H05103"\w*, \w vvv|strong="H08370"\w* \w Shethar-bozenai|strong="H08370"\w*, \w and their associates|strong="H03675"\w*, \w the officials|strong="H00671"\w* \w . . .|strong="H01768"\w* \w in the region|strong="H05675"\w*, \w . . .|strong="H05103"\w* \w sent|strong="H07972"\w* \w to|strong="H05922"\w* \w King|strong="H04430"\w* \w Darius|strong="H01868"\w*. \v 7 \w The report|strong="H06600"\w* \w they sent|strong="H07972"\w* \w him|strong="H05922"\w* \w read as follows|strong="H03790"\w* \w . . .|strong="H01459"\w* \w . . .|strong="H01836"\w*:
\pmo \w To King|strong="H04430"\w* \w Darius|strong="H01868"\w*:
\pmo \w All|strong="H03606"\w* \w peace|strong="H08001"\w*.
\pmo \v 8 \w Let it be|strong="H01934"\w* \w known|strong="H03046"\w* \w to the king|strong="H04430"\w* \w that|strong="H01768"\w* \w we went|strong="H00236"\w* \w into the province|strong="H04083"\w* \w of Judah|strong="H03061"\w*, \w to the house|strong="H01005"\w* \w of the great|strong="H07229"\w* \w God|strong="H00426"\w*. \w [The people]|strong="H01932"\w* \w are rebuilding it|strong="H01124"\w* \w with large stones|strong="H00069"\w* \w . . .|strong="H01560"\w* \w and placing|strong="H07761"\w* \w timbers|strong="H00636"\w* \w in the walls|strong="H03797"\w*. \w This|strong="H01791"\w* \w work|strong="H05673"\w* \w is being carried out|strong="H05648"\w* \w diligently|strong="H00629"\w* \w and is prospering|strong="H06744"\w* \w in their hands|strong="H03028"\w*.
\pmo \v 9 \w So|strong="H00116"\w* \w we questioned|strong="H07593"\w* \w the|strong="H00479"\w* \w . . .|strong="H03660"\w* \w elders|strong="H07868"\w* \w and asked|strong="H00560"\w*, “\w Who|strong="H04479"\w* \w authorized|strong="H07761"\w* \w . . .|strong="H02942"\w* you \w to rebuild|strong="H01124"\w* \w this|strong="H01836"\w* \w temple|strong="H01005"\w* \w and restore|strong="H03635"\w* \w this|strong="H01836"\w* \w structure|strong="H00846"\w*?”
\pmo \v 10 \w We also|strong="H00638"\w* \w asked for|strong="H07593"\w* their \w names|strong="H08036"\w*, \w so that|strong="H01768"\w* \w we could write down|strong="H03790"\w* \w the names|strong="H08036"\w* \w of their leaders|strong="H01400"\w* \w . . .|strong="H01768"\w* \w . . .|strong="H07217"\w*\f + \fr 5:10 \ft Aramaic \fqa the names of the men at their heads\f* \w for your information|strong="H03046"\w*.
\pmo \v 11 \w And this|strong="H03660"\w* \w is the answer|strong="H06600"\w* \w they returned|strong="H08421"\w* \w . . .|strong="H00560"\w*:
\pmo “\w We|strong="H00586"\w* \w are|strong="H01994"\w* \w servants|strong="H05649"\w*\w . . .|strong="H01768"\w* \w of the God|strong="H00426"\w* \w of heaven|strong="H08065"\w* \w and earth|strong="H00772"\w*, \w and we are rebuilding|strong="H01124"\w* \w the temple|strong="H01005"\w* \w that|strong="H01768"\w* \w was|strong="H01934"\w* \w built|strong="H01124"\w* \w many|strong="H07690"\w* \w years|strong="H08140"\w* \w ago|strong="H06928"\w*, \w . . .|strong="H01836"\w* \w which a great|strong="H07229"\w* \w king|strong="H04430"\w* \w of Israel|strong="H03479"\w* \w built|strong="H01124"\w* \w and completed|strong="H03635"\w*. \v 12 \w But|strong="H03861"\w* \w since|strong="H04481"\w* \w . . .|strong="H01768"\w* \w our fathers|strong="H00002"\w* \w angered|strong="H07265"\w* \w the God|strong="H00426"\w* \w of heaven|strong="H08065"\w*, \w He delivered|strong="H03052"\w* \w them|strong="H01994"\w* \w into the hand|strong="H03028"\w* \w of Nebuchadnezzar|strong="H05020"\w* \w king|strong="H04430"\w* \w of Babylon|strong="H00895"\w*, \w the Chaldean|strong="H03679"\w* \w who destroyed|strong="H05642"\w* \w this|strong="H01836"\w* \w temple|strong="H01005"\w* \w and carried away|strong="H01541"\w* \w the people|strong="H05972"\w* \w to Babylon|strong="H00895"\w*.
\pmo \v 13 \w In the first|strong="H02298"\w* \w year [of his reign]|strong="H08140"\w*, \w however|strong="H01297"\w*, \w Cyrus|strong="H03567"\w* \w king|strong="H04430"\w* \w of|strong="H01768"\w* \w Babylon|strong="H00895"\w* \w -|strong="H03567"\w* \w -|strong="H04430"\w* \w issued|strong="H07761"\w* \w a decree|strong="H02942"\w* \w to rebuild|strong="H01124"\w* \w this|strong="H01836"\w* \w house|strong="H01005"\w* \w of God|strong="H00426"\w*. \v 14 \w He also|strong="H00638"\w* \w removed|strong="H05312"\w* \w -|strong="H01994"\w* \w from|strong="H04481"\w* \w the temple|strong="H01965"\w*\f + \fr 5:14 \ft Or \fqa palace\f* \w of|strong="H01768"\w* \w Babylon|strong="H00895"\w* \w the gold|strong="H01722"\w* \w and silver|strong="H03702"\w* \w articles|strong="H03984"\w* \w belonging to|strong="H01768"\w* \w the house|strong="H01005"\w* \w of God|strong="H00426"\w*, \w which|strong="H01768"\w* \w -|strong="H01768"\w* \w Nebuchadnezzar|strong="H05020"\w* \w had taken|strong="H05312"\w* \w and carried|strong="H02987"\w* \w -|strong="H01994"\w* \w [there]|strong="H01965"\w* \w . . .|strong="H01768"\w* \w . . .|strong="H00895"\w* \w from|strong="H04481"\w* \w the temple|strong="H01965"\w* \w -|strong="H01768"\w* \w in Jerusalem|strong="H03390"\w*. \w King|strong="H04430"\w* \w Cyrus|strong="H03567"\w* \w gave [these articles]|strong="H03052"\w* \w to a man named|strong="H08036"\w* \w . . .|strong="H01768"\w* \w Sheshbazzar|strong="H08340"\w*, \w whom he appointed|strong="H07761"\w* \w governor|strong="H06347"\w* \v 15 \w and instructed|strong="H00560"\w*, ‘\w Take|strong="H05376"\w* \w . . .|strong="H00236"\w* \w these|strong="H00429"\w* \w articles|strong="H03984"\w*, \w put|strong="H05182"\w* \w them|strong="H01994"\w* \w in the temple|strong="H01965"\w* \w . . .|strong="H01768"\w* \w in Jerusalem|strong="H03390"\w*, \w and let the house|strong="H01005"\w* \w of God|strong="H00426"\w* \w be rebuilt|strong="H01124"\w* \w on|strong="H05922"\w* \w its original site|strong="H00870"\w*.’
\pmo \v 16 \w So|strong="H00116"\w* \w this|strong="H01791"\w* \w Sheshbazzar|strong="H08340"\w* \w came|strong="H00858"\w* \w and laid|strong="H03052"\w* \w the foundation|strong="H00787"\w* \w of|strong="H01768"\w* \w the house|strong="H01005"\w* \w of God|strong="H00426"\w*\w . . .|strong="H01768"\w* \w in Jerusalem|strong="H03390"\w*, \w and from|strong="H04481"\w* \w that time|strong="H00116"\w* \w until|strong="H05705"\w* \w now|strong="H03705"\w* \w it has been under construction|strong="H01124"\w*, \w but it has not yet|strong="H03809"\w* \w been completed|strong="H08000"\w*.”
\pmo \v 17 \w Now, therefore,|strong="H03705"\w* \w if|strong="H02006"\w* \w -|strong="H05922"\w* \w it pleases|strong="H02869"\w* \w the king|strong="H04430"\w*, \w let a search be made|strong="H01240"\w* \w of the royal|strong="H01768"\w* \w . . .|strong="H04430"\w* \w . . .|strong="H08536"\w* \w archives|strong="H01005"\w* \w . . .|strong="H01596"\w*\w . . .|strong="H01768"\w* \w in Babylon|strong="H00895"\w* \w to see if|strong="H02006"\w* \w . . .|strong="H00383"\w* \w . . .|strong="H01768"\w* \w -|strong="H04481"\w* \w King|strong="H04430"\w* \w Cyrus|strong="H03567"\w* \w did indeed issue|strong="H07761"\w* \w a decree|strong="H02942"\w* \w to rebuild|strong="H01124"\w* \w the|strong="H01791"\w* \w house|strong="H01005"\w* \w of God|strong="H00426"\w* \w in Jerusalem|strong="H03390"\w*. \w Then let the king|strong="H04430"\w* \w send|strong="H07972"\w* \w us|strong="H05922"\w* \w his decision|strong="H07470"\w* \w in|strong="H05922"\w* \w this [matter]|strong="H01836"\w*.
\c 6
\s1 The Decree of Darius
\p \v 1 \w Thus|strong="H00116"\w* \w King|strong="H04430"\w* \w Darius|strong="H01868"\w* \w ordered|strong="H07761"\w* \w . . .|strong="H02942"\w* \w a search|strong="H01240"\w* \w of the archives|strong="H01005"\w* \w stored|strong="H05182"\w* \w . . .|strong="H05609"\w* \w . . .|strong="H01768"\w* \w in the treasury|strong="H01596"\w* \w of Babylon|strong="H00895"\w* \w . . .|strong="H08536"\w*. \v 2 \w And a scroll|strong="H04040"\w*\w . . .|strong="H02298"\w* \w was found|strong="H07912"\w* \w in the fortress|strong="H01001"\w* \w . . .|strong="H01768"\w* \w of Ecbatana|strong="H00307"\w*, \w in the province|strong="H04083"\w* \w of Media|strong="H04076"\w*, \w with the following|strong="H03652"\w* \w written|strong="H03790"\w* \w on it|strong="H01459"\w*:
\pmo \w Memorandum|strong="H01799"\w*:
\pmo \v 3 \w In the first|strong="H02298"\w* \w year|strong="H08140"\w* \w of King|strong="H04430"\w* \w Cyrus|strong="H03567"\w*, \w he|strong="H03567"\w* \w . . .|strong="H04430"\w* \w issued|strong="H07761"\w* \w a decree [concerning]|strong="H02942"\w* \w the house|strong="H01005"\w* \w of God|strong="H00426"\w* \w in Jerusalem|strong="H03390"\w*:
\pmo \w Let the house|strong="H01005"\w* \w be rebuilt|strong="H01124"\w* \w as a place|strong="H00870"\w* \w for|strong="H01768"\w* \w offering|strong="H01684"\w* \w sacrifices|strong="H01685"\w*, \w and let its foundations|strong="H00787"\w* \w be firmly laid|strong="H05446"\w*. \w It is to be sixty|strong="H08361"\w* \w cubits|strong="H00521"\w* \w high|strong="H07314"\w* \w [and] sixty|strong="H08361"\w* \w cubits|strong="H00521"\w* \w wide|strong="H06613"\w*,\f + \fr 6:3 \ft The house was to be approximately 90 feet or 27.4 meters in height and width; Syriac (see also 1 Kings 6:2) \fqa It is to be sixty cubits long, twenty cubits wide, and thirty cubits high\ft .\f* \v 4 \w with three|strong="H08532"\w* \w . . .|strong="H05073"\w* \w layers|strong="H05073"\w* \w of|strong="H01768"\w* \w cut stones|strong="H00069"\w* \w . . .|strong="H01560"\w* \w and one|strong="H02323"\w* \w of|strong="H01768"\w* \w timbers|strong="H00636"\w*. \w The costs|strong="H05313"\w* \w are to be paid|strong="H03052"\w* \w from|strong="H04481"\w* \w the royal|strong="H04430"\w* \w treasury|strong="H01005"\w*.
\pmo \v 5 \w Furthermore|strong="H00638"\w*, \w the gold|strong="H01722"\w* \w and silver|strong="H03702"\w* \w . . .|strong="H01768"\w* \w articles|strong="H03984"\w* \w of the house|strong="H01005"\w* \w of God|strong="H00426"\w*, \w which|strong="H01768"\w* \w Nebuchadnezzar|strong="H05020"\w* \w took|strong="H05312"\w* \w from|strong="H04481"\w* \w the temple|strong="H01965"\w* \w . . .|strong="H01768"\w* \w in Jerusalem|strong="H03390"\w* \w and carried|strong="H02987"\w* \w to Babylon|strong="H00895"\w*, \w must also be returned|strong="H08421"\w* \w -|strong="H01946"\w* \w to the temple|strong="H01965"\w* \w . . .|strong="H01768"\w* \w in Jerusalem|strong="H03390"\w* \w . . .|strong="H00870"\w* \w and deposited|strong="H05182"\w* \w in the house|strong="H01005"\w* \w of God|strong="H00426"\w*.
\p \v 6 \w Therefore [Darius decreed]|strong="H03705"\w*:
\pmo \w To Tattenai|strong="H08674"\w* \w governor|strong="H06347"\w* \w of the region west|strong="H05675"\w* \w of the Euphrates|strong="H05103"\w*,\f + \fr 6:6 \ft Aramaic \fqa governor beyond the River\ft ; similarly in verses 8 and 13\f* \w vvv|strong="H08370"\w* \w Shethar-bozenai|strong="H08370"\w*, \w and your associates|strong="H03675"\w* \w and officials|strong="H00671"\w* \w . . .|strong="H01768"\w* \w in the region|strong="H05675"\w* \w . . .|strong="H05103"\w*:
\pmo \w You must stay|strong="H01934"\w* \w away|strong="H07352"\w* \w from|strong="H04481"\w* \w that place|strong="H08536"\w*! \v 7 \w {Leave} this work|strong="H05673"\w* \w . . .|strong="H01791"\w* \w on the house|strong="H01005"\w* \w of God|strong="H00426"\w* \w alone|strong="H07662"\w*. \w Let the governor|strong="H06347"\w* \w and elders|strong="H07868"\w* \w . . .|strong="H03062"\w* \w of the Jews|strong="H03062"\w* \w rebuild|strong="H01124"\w* \w this|strong="H01791"\w* \w house|strong="H01005"\w* \w of God|strong="H00426"\w* \w on|strong="H05922"\w* \w its original site|strong="H00870"\w*.
\pmo \v 8 \w I hereby|strong="H04481"\w* \w vvv|strong="H07761"\w* \w decree|strong="H02942"\w* \w what|strong="H03964"\w* \w . . .|strong="H01768"\w* \w you must do|strong="H05648"\w* \w for|strong="H05974"\w* \w these|strong="H00479"\w* \w elders|strong="H07868"\w* \w of the Jews|strong="H03062"\w* \w who are rebuilding|strong="H01124"\w* \w this|strong="H01791"\w* \w house|strong="H01005"\w* \w of God|strong="H00426"\w*:
\pmo \w The cost|strong="H05313"\w* \w is to be|strong="H01934"\w* \w paid|strong="H03052"\w* \w in full|strong="H00629"\w* \w to these|strong="H00479"\w* \w men|strong="H01400"\w* \w from the royal|strong="H04430"\w* \w treasury|strong="H05232"\w* \w out of|strong="H01768"\w* \w the taxes|strong="H04061"\w* \w of [the provinces] west|strong="H05675"\w* \w of the Euphrates|strong="H05103"\w*, \w so that|strong="H01768"\w* \w the work will not|strong="H03809"\w* \w be hindered|strong="H00989"\w*. \v 9 \w Whatever|strong="H04101"\w* \w is needed|strong="H02818"\w*— \w young|strong="H01123"\w* \w bulls|strong="H08450"\w*, \w rams|strong="H01798"\w*, \w and lambs|strong="H00563"\w* \w for burnt offerings|strong="H05928"\w* \w to the God|strong="H00426"\w* \w of heaven|strong="H08065"\w*, \w as well as wheat|strong="H02591"\w*, \w salt|strong="H04416"\w*, \w wine|strong="H02562"\w*, \w and oil|strong="H04887"\w*, \w as requested|strong="H03983"\w* \w by the priests|strong="H03549"\w* \w . . .|strong="H01768"\w* \w in Jerusalem|strong="H03390"\w*— \w must be|strong="H01934"\w* \w given|strong="H03052"\w* to them \w daily|strong="H03118"\w* \w . . .|strong="H03118"\w* \w vvv|strong="H01768"\w* \w without|strong="H03809"\w* \w fail|strong="H07960"\w*. \v 10 \w Then|strong="H01768"\w* \w they will be able|strong="H01934"\w* \w to offer sacrifices|strong="H07127"\w* \w of a sweet aroma|strong="H05208"\w* \w to the God|strong="H00426"\w* \w of heaven|strong="H08065"\w* \w and to pray|strong="H06739"\w* \w for the lives|strong="H02417"\w* \w of the king|strong="H04430"\w* \w and his sons|strong="H01123"\w*.
\pmo \v 11 \w I also|strong="H04481"\w* \w decree|strong="H07761"\w* \w . . .|strong="H02942"\w* \w that|strong="H01768"\w* \w if any|strong="H03606"\w* \w man|strong="H00606"\w* \w -|strong="H01768"\w* \w interferes|strong="H08133"\w* \w with this|strong="H01836"\w* \w directive|strong="H06600"\w*, \w a beam|strong="H00636"\w* \w is to be torn|strong="H05256"\w* \w from|strong="H04481"\w* \w his house|strong="H01005"\w* \w and raised up|strong="H02211"\w*, \w and he is to be impaled|strong="H04223"\w* \w on it|strong="H05922"\w*. \w And his own house|strong="H01005"\w* \w shall be made|strong="H05648"\w* \w a pile of rubble|strong="H05122"\w* \w for|strong="H05922"\w* \w this [offense]|strong="H01836"\w*.\f + \fr 6:11 \ft Literally \fqa shall be made a dunghill because of this\f* \v 12 \w May God|strong="H00426"\w*, \w who|strong="H01768"\w* \w has caused His Name|strong="H08036"\w* \w to dwell|strong="H07932"\w* \w there|strong="H08536"\w*, \w overthrow|strong="H04049"\w* \w any|strong="H03606"\w* \w king|strong="H04430"\w* \w or people|strong="H05972"\w* \w who|strong="H01768"\w* \w lifts|strong="H07972"\w* \w a hand|strong="H03028"\w* \w to alter [this decree]|strong="H08133"\w* \w or to destroy|strong="H02255"\w* \w this|strong="H01791"\w* \w house|strong="H01005"\w* \w of God|strong="H00426"\w* \w . . .|strong="H01768"\w* \w in Jerusalem|strong="H03390"\w*.
\pmo \w I|strong="H00576"\w*, \w Darius|strong="H01868"\w*, \w have issued|strong="H07761"\w* \w the decree|strong="H02942"\w*. \w Let it be carried out|strong="H05648"\w* \w with diligence|strong="H00629"\w*.
\s1 The Temple Completed
\p \v 13 \w In response|strong="H00116"\w*, \w Tattenai|strong="H08674"\w* \w the governor|strong="H06347"\w* \w of the region west|strong="H05675"\w* \w of the Euphrates|strong="H05103"\w*, \w vvv|strong="H08370"\w* \w Shethar-bozenai|strong="H08370"\w*, \w and their associates|strong="H03675"\w* \w . . .|strong="H06903"\w* \w diligently|strong="H00629"\w* \w carried out|strong="H05648"\w* \w what|strong="H01768"\w* \w King|strong="H04430"\w* \w . . .|strong="H03660"\w* \w Darius|strong="H01868"\w* \w had decreed|strong="H07972"\w*. \v 14 \w So the Jewish|strong="H03062"\w* \w elders|strong="H07868"\w* \w built|strong="H01124"\w* \w and prospered|strong="H06744"\w* \w through the prophesying|strong="H05017"\w* \w of Haggai|strong="H02292"\w* \w the prophet|strong="H05029"\w* \w and Zechariah|strong="H02148"\w* \w son|strong="H01247"\w* \w of Iddo|strong="H05714"\w*.
\p \w They finished|strong="H03635"\w* \w building|strong="H01124"\w* \w according to|strong="H04481"\w* \w the command|strong="H02942"\w* \w of the God|strong="H00426"\w* \w of Israel|strong="H03479"\w* \w and the decrees|strong="H02942"\w* \w of Cyrus|strong="H03567"\w*, \w Darius|strong="H01868"\w*, \w and Artaxerxes|strong="H00783"\w*, \w kings|strong="H04430"\w* \w of Persia|strong="H06540"\w*. \v 15 \w And this|strong="H01836"\w* \w temple|strong="H01005"\w* \w was completed|strong="H03319"\w* \w on|strong="H05705"\w* \w the third|strong="H08532"\w* \w day|strong="H03118"\w* \w of the month|strong="H03393"\w* \w of Adar|strong="H00144"\w*,\f + \fr 6:15 \fqa Adar \ft is the twelfth month of the Hebrew lunar calendar, usually occurring within the months of February and March.\f* \w . . .|strong="H01768"\w* \w . . .|strong="H01932"\w* \w in the sixth|strong="H08353"\w* \w year|strong="H08140"\w* \w of the reign|strong="H04437"\w* \w of King|strong="H04430"\w* \w Darius|strong="H01868"\w*.
\s1 Dedication of the Temple
\p \v 16 \w Then the people|strong="H01123"\w* \w of Israel|strong="H03479"\w* — \w the priests|strong="H03549"\w*, \w the Levites|strong="H03879"\w*, \w and the rest|strong="H07606"\w* \w of the exiles|strong="H01123"\w* \w . . .|strong="H01547"\w* — \w celebrated|strong="H05648"\w* \w the dedication|strong="H02597"\w* \w of the|strong="H01836"\w* \w house|strong="H01005"\w* \w of God|strong="H00426"\w* \w with joy|strong="H02305"\w*.
\p \v 17 \w For the|strong="H01836"\w* \w dedication|strong="H02597"\w* \w of the house|strong="H01005"\w* \w of God|strong="H00426"\w* \w they offered|strong="H07127"\w* \w a hundred|strong="H03969"\w* \w bulls|strong="H08450"\w*, \w two hundred|strong="H03969"\w* \w rams|strong="H01798"\w*, \w four|strong="H00703"\w* \w hundred|strong="H03969"\w* \w lambs|strong="H00563"\w*, \w and a sin offering|strong="H02409"\w* \w for|strong="H05922"\w* \w all|strong="H03606"\w* \w Israel|strong="H03479"\w* \w of twelve|strong="H08648"\w* \w . . .|strong="H06236"\w* \w . . .|strong="H04510"\w* \w male goats|strong="H06841"\w* \w . . .|strong="H05796"\w*, \w one for each tribe|strong="H07625"\w* \w of Israel|strong="H03479"\w*.
\p \v 18 \w They also appointed|strong="H06966"\w* \w the priests|strong="H03549"\w* \w by their divisions|strong="H06392"\w* \w and the Levites|strong="H03879"\w* \w by their groups|strong="H04255"\w* \w to|strong="H05922"\w* \w the service|strong="H05673"\w* \w of God|strong="H00426"\w* \w . . .|strong="H01768"\w* \w in Jerusalem|strong="H03390"\w*, \w according to what is written|strong="H03792"\w* \w in the Book|strong="H05609"\w* \w of Moses|strong="H04873"\w*.
\s1 The Returned Exiles Keep the Passover
\p \v 19 \w On the fourteenth day|strong="H00702"\w* \w . . .|strong="H06240"\w* \w of the first|strong="H07223"\w* \w month|strong="H02320"\w*, \w the exiles|strong="H01121"\w* \w . . .|strong="H01473"\w* \w -|strong="H00853"\w* \w kept|strong="H06213"\w* \w the Passover|strong="H06453"\w*. \v 20 \w All|strong="H03605"\w* \w the priests|strong="H03548"\w* \w and Levites|strong="H03881"\w* \w . . .|strong="H00259"\w* \w -|strong="H03588"\w* \w had purified themselves|strong="H02891"\w* \w and were ceremonially clean|strong="H02889"\w*.
\p \w And [the Levites] slaughtered|strong="H07819"\w* \w the Passover lamb|strong="H06453"\w* \w for all|strong="H03605"\w* \w the exiles|strong="H01121"\w* \w . . .|strong="H01473"\w*, \w for their priestly|strong="H03548"\w* \w brothers|strong="H00251"\w*, and for themselves. \v 21 \w The Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w who had returned|strong="H07725"\w* \w from exile|strong="H01473"\w* \w ate it|strong="H00398"\w*, \w together with all|strong="H03605"\w* \w who had separated themselves|strong="H00914"\w* \w from the uncleanness|strong="H02932"\w* \w of the peoples|strong="H01471"\w*\f + \fr 6:21 \ft Or \fqa nations\f* \w of the land|strong="H00776"\w* \w vvv|strong="H00413"\w* \w to seek|strong="H01875"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*.
\p \v 22 \w For seven|strong="H07651"\w* \w days|strong="H03117"\w* \w they kept|strong="H06213"\w* \w the Feast|strong="H02282"\w* \w of Unleavened Bread|strong="H04682"\w*\f + \fr 6:22 \ft That is, the seven-day period after the Passover during which no leaven may be eaten; see Exodus 12:14–20.\f* \w with joy|strong="H08057"\w*, \w because|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w had made them joyful|strong="H08055"\w* \w and turned|strong="H05437"\w* \w the heart|strong="H03820"\w* \w of the king|strong="H04428"\w* \w of Assyria|strong="H00804"\w* \w toward them|strong="H05921"\w* \w to strengthen|strong="H02388"\w* \w their hands|strong="H03027"\w* \w in the work|strong="H04399"\w* \w on the house|strong="H01004"\w* \w of the God|strong="H00430"\w* \w . . .|strong="H00430"\w* \w of Israel|strong="H03478"\w*.
\c 7
\s1 Ezra Arrives in Jerusalem
\p \v 1 \w Many years later|strong="H00310"\w* \w . . .|strong="H00428"\w* \w . . .|strong="H01697"\w*,\f + \fr 7:1 \ft Literally \fqa After these things\f* \w during the reign|strong="H04438"\w* \w of Artaxerxes|strong="H00783"\w* \w king|strong="H04428"\w* \w of Persia|strong="H06539"\w*, \w Ezra|strong="H05830"\w* \w son|strong="H01121"\w* \w of Seraiah|strong="H08304"\w*, \w the son|strong="H01121"\w* \w of Azariah|strong="H05838"\w*, \w the son|strong="H01121"\w* \w of Hilkiah|strong="H02518"\w*, \v 2 \w the son|strong="H01121"\w* \w of Shallum|strong="H07967"\w*, \w the son|strong="H01121"\w* \w of Zadok|strong="H06659"\w*, \w the son|strong="H01121"\w* \w of Ahitub|strong="H00285"\w*, \v 3 \w the son|strong="H01121"\w* \w of Amariah|strong="H00568"\w*, \w the son|strong="H01121"\w* \w of Azariah|strong="H05838"\w*, \w the son|strong="H01121"\w* \w of Meraioth|strong="H04812"\w*, \v 4 \w the son|strong="H01121"\w* \w of Zerahiah|strong="H02228"\w*, \w the son|strong="H01121"\w* \w of Uzzi|strong="H05813"\w*, \w the son|strong="H01121"\w* \w of Bukki|strong="H01231"\w*, \v 5 \w the son|strong="H01121"\w* \w of Abishua|strong="H00050"\w*, \w the son|strong="H01121"\w* \w of Phinehas|strong="H06372"\w*, \w the son|strong="H01121"\w* \w of Eleazar|strong="H00499"\w*, \w the son|strong="H01121"\w* \w of Aaron|strong="H00175"\w* \w the chief|strong="H07218"\w* \w priest|strong="H03548"\w*— \v 6 \w this|strong="H01931"\w* \w Ezra|strong="H05830"\w* \w came up|strong="H05927"\w* \w from Babylon|strong="H00894"\w*. \w He [was]|strong="H01931"\w* \w a scribe|strong="H05608"\w* \w skilled|strong="H04106"\w* \w in the Law|strong="H08451"\w* \w of Moses|strong="H04872"\w*, \w which|strong="H00834"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w had given|strong="H05414"\w*.
\p \w The king|strong="H04428"\w* \w had granted|strong="H05414"\w* [Ezra] \w all|strong="H03605"\w* \w his requests|strong="H01246"\w*, \w for the hand|strong="H03027"\w* \w of the LORD|strong="H03068"\w* \w his God|strong="H00430"\w* \w was upon him|strong="H05921"\w*. \v 7 \w So in the seventh|strong="H07651"\w* \w year|strong="H08141"\w* \w of King|strong="H04428"\w* \w Artaxerxes|strong="H00783"\w*, \w he went up|strong="H05927"\w* \w to|strong="H00413"\w* \w Jerusalem|strong="H03389"\w* \w with some of|strong="H04480"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*, \w including priests|strong="H03548"\w*, \w Levites|strong="H03881"\w*, \w singers|strong="H07891"\w*, \w gatekeepers|strong="H07778"\w*, \w and temple servants|strong="H05411"\w*.\f + \fr 7:7 \ft Hebrew \fqa Nethinim\ft ; also in verse 24\f*
\p \v 8 \w Ezra arrived|strong="H00935"\w* \w in Jerusalem|strong="H03389"\w* \w in the fifth|strong="H02549"\w* \w . . .|strong="H01931"\w* \w month|strong="H02320"\w* \w of the seventh|strong="H07637"\w* \w year|strong="H08141"\w* \w of the king|strong="H04428"\w*. \v 9 \w -|strong="H03588"\w* \w He|strong="H01931"\w* \w had begun|strong="H03246"\w* \w the journey|strong="H04609"\w* \w from Babylon|strong="H00894"\w* \w on the first [day]|strong="H00259"\w* \w of the first|strong="H07223"\w* \w month|strong="H02320"\w*, \w and he arrived|strong="H00935"\w* \w in|strong="H00413"\w* \w Jerusalem|strong="H03389"\w* \w on the first|strong="H00259"\w* \w day of the fifth|strong="H02549"\w* \w month|strong="H02320"\w*, \w for the gracious|strong="H02896"\w* \w hand|strong="H03027"\w* \w of his God|strong="H00430"\w* \w was upon him|strong="H05921"\w*. \v 10 \w For|strong="H03588"\w* \w Ezra|strong="H05830"\w* \w had set|strong="H03559"\w* \w his heart|strong="H03824"\w* \w to study|strong="H01875"\w* \w -|strong="H00853"\w* \w the Law|strong="H08451"\w* \w of the LORD|strong="H03068"\w*, \w to practice it|strong="H06213"\w*, \w and to teach|strong="H03925"\w* \w its statutes|strong="H02706"\w* \w and ordinances|strong="H04941"\w* \w in Israel|strong="H03478"\w*.
\s1 Artaxerxes’ Letter for Ezra
\p \v 11 \w This|strong="H02088"\w* \w is the text|strong="H06572"\w* \w of the letter|strong="H05406"\w* \w -|strong="H00834"\w* \w King|strong="H04428"\w* \w Artaxerxes|strong="H00783"\w* \w had given|strong="H05414"\w* \w to Ezra|strong="H05830"\w* \w the priest|strong="H03548"\w* \w [and] scribe|strong="H05608"\w*, \w an expert|strong="H05608"\w* \w vvv|strong="H01697"\w* \w in the commandments|strong="H04687"\w* \w and statutes|strong="H02706"\w* \w of the LORD|strong="H03068"\w* \w to|strong="H05921"\w* \w Israel|strong="H03478"\w*:\f + \fr 7:11 \ft The original text of Ezra 7:12–26 is in Aramaic.\f*
\pmo \v 12 \w Artaxerxes|strong="H00783"\w*, \w king|strong="H04430"\w* \w of kings|strong="H04430"\w*.
\pmo \w To Ezra|strong="H05831"\w* \w the priest|strong="H03549"\w*, \w the scribe|strong="H05613"\w* \w of the Law|strong="H01882"\w* \w of|strong="H01768"\w* \w the God|strong="H00426"\w* \w of heaven|strong="H08065"\w*:
\pmo \w Greetings|strong="H01585"\w* \w . . .|strong="H03706"\w*.\f + \fr 7:12 \ft Aramaic \fqa Perfect now \ft (probably a greeting)\f*
\pmo \v 13 \w I|strong="H04481"\w* \w hereby|strong="H07761"\w* \w decree|strong="H02942"\w* \w that|strong="H01768"\w* \w any|strong="H03606"\w* \w volunteers|strong="H05069"\w* \w among the Israelites|strong="H05972"\w* \w . . .|strong="H03479"\w* \w in my kingdom|strong="H04437"\w*, \w . . .|strong="H04481"\w* \w including the priests|strong="H03549"\w* \w and Levites|strong="H03879"\w*, \w may go up|strong="H01946"\w* \w with you|strong="H05974"\w* \w -|strong="H01946"\w* \w to Jerusalem|strong="H03390"\w*. \v 14 \w -|strong="H03606"\w* \w -|strong="H06903"\w*\w . . .|strong="H01768"\w* \w You are sent|strong="H07972"\w* \w by|strong="H04481"\w* \w . . .|strong="H06925"\w* \w the king|strong="H04430"\w* \w and his seven|strong="H07655"\w* \w counselors|strong="H03272"\w* \w to evaluate|strong="H01240"\w* \w . . .|strong="H05922"\w* \w Judah|strong="H03061"\w* \w and Jerusalem|strong="H03390"\w* \w according to the Law|strong="H01882"\w* \w of your God|strong="H00426"\w*, \w which|strong="H01768"\w* \w is in your hand|strong="H03028"\w*.
\pmo \v 15 \w Moreover, you are to take with you|strong="H02987"\w* \w the silver|strong="H03702"\w* \w and gold|strong="H01722"\w* \w that|strong="H01768"\w* \w the king|strong="H04430"\w* \w and his counselors|strong="H03272"\w* \w have freely offered|strong="H05069"\w* \w to the God|strong="H00426"\w* \w of Israel|strong="H03479"\w*, \w whose|strong="H01768"\w* \w dwelling|strong="H04907"\w* \w is in Jerusalem|strong="H03390"\w*, \v 16 \w together with all|strong="H03606"\w* \w the silver|strong="H03702"\w* \w and gold|strong="H01722"\w* \w . . .|strong="H01768"\w* \w you may find|strong="H07912"\w* \w in all|strong="H03606"\w* \w the province|strong="H04083"\w* \w of Babylon|strong="H00895"\w*, \w as well as|strong="H05974"\w* \w the freewill offerings|strong="H05069"\w* \w of the people|strong="H05972"\w* \w and priests|strong="H03549"\w* \w . . .|strong="H05069"\w* \w to the house|strong="H01005"\w* \w of their God|strong="H00426"\w* \w . . .|strong="H01768"\w* \w in Jerusalem|strong="H03390"\w*. \v 17 \w With this|strong="H01836"\w* \w money|strong="H03702"\w*, \w . . .|strong="H03606"\w*\w . . .|strong="H06903"\w* \w therefore|strong="H01836"\w*, \w you are to buy|strong="H07066"\w* \w as many bulls|strong="H08450"\w*, \w rams|strong="H01798"\w*, \w and lambs|strong="H00563"\w* \w as needed|strong="H00629"\w*, \w together with their grain offerings|strong="H04504"\w* \w and drink offerings|strong="H05261"\w*, \w and offer|strong="H07127"\w* \w them|strong="H01994"\w* \w on|strong="H05922"\w* \w the altar|strong="H04056"\w* \w . . .|strong="H01768"\w* \w at the house|strong="H01005"\w* \w of your God|strong="H00426"\w* \w . . .|strong="H01768"\w* \w in Jerusalem|strong="H03390"\w*. \v 18 \w You and your brothers|strong="H00252"\w* \w may do|strong="H05648"\w* \w whatever|strong="H04101"\w* \w . . .|strong="H01768"\w* \w . . .|strong="H05922"\w* \w -|strong="H05922"\w* \w seems best|strong="H03191"\w* \w with the rest|strong="H07606"\w* \w of the silver|strong="H03702"\w* \w and gold|strong="H01722"\w*, \w according to the will|strong="H07470"\w* \w of your God|strong="H00426"\w* \w . . .|strong="H05648"\w*.
\pmo \v 19 \w You must deliver|strong="H08000"\w* \w to|strong="H06925"\w* \w the God|strong="H00426"\w* \w of Jerusalem|strong="H03390"\w* \w all the articles|strong="H03984"\w* \w . . .|strong="H01768"\w* \w given|strong="H03052"\w* to you \w for the service|strong="H06402"\w* \w of the house|strong="H01005"\w* \w of your God|strong="H00426"\w*. \v 20 \w And if anything else|strong="H07606"\w* \w is needed|strong="H02819"\w* \w for the house|strong="H01005"\w* \w of your God|strong="H00426"\w* \w that|strong="H01768"\w* you \w may have occasion|strong="H05308"\w* \w to supply|strong="H05415"\w*, \w you may pay [for it]|strong="H05415"\w* \w from|strong="H04481"\w* \w the royal|strong="H04430"\w* \w vvv|strong="H01005"\w* \w treasury|strong="H01596"\w*.
\pmo \v 21 \w -|strong="H04481"\w* \w I|strong="H00576"\w*, \w King|strong="H04430"\w* \w Artaxerxes|strong="H00783"\w*, \w vvv|strong="H07761"\w* \w decree|strong="H02942"\w* \w to all|strong="H03606"\w* \w the treasurers|strong="H01490"\w* \w -|strong="H01768"\w* \w west|strong="H05675"\w* \w of the Euphrates|strong="H05103"\w*:\f + \fr 7:21 \ft Aramaic \fqa beyond the River\ft ; also in verse 25\f*\w . . .|strong="H01768"\w* \w Whatever|strong="H03606"\w* \w . . .|strong="H01768"\w* \w Ezra|strong="H05831"\w* \w the priest|strong="H03549"\w*, \w the scribe|strong="H05613"\w* \w of the Law|strong="H01882"\w*\w . . .|strong="H01768"\w* \w of the God|strong="H00426"\w* \w of heaven|strong="H08065"\w*, \w may require of you|strong="H07593"\w*, \w it must be provided|strong="H05648"\w* \w promptly|strong="H00629"\w*, \v 22 \w up to|strong="H05705"\w* \w a hundred|strong="H03969"\w* \w talents|strong="H03604"\w* \w . . .|strong="H05705"\w* \w of silver|strong="H03702"\w*,\f + \fr 7:22 \fqa 100 talents \ft is approximately 3.77 tons or 3.42 metric tons of silver.\f* \w a hundred|strong="H03969"\w* \w cors|strong="H03734"\w* \w of wheat|strong="H02591"\w*,\f + \fr 7:22 \fqa 100 cors \ft is approximately 624 bushels or 22,000 liters (probably about 19.2 tons or 17.4 metric tons of wheat).\f* \w -|strong="H05705"\w* \w a hundred|strong="H03969"\w* \w baths|strong="H01325"\w* \w . . .|strong="H05705"\w* \w of wine|strong="H02562"\w*,\f + \fr 7:22 \fqa 100 baths \ft is approximately 580 gallons or 2,200 liters of wine.\f* \w a hundred|strong="H03969"\w* \w baths|strong="H01325"\w* \w of olive oil|strong="H04887"\w*,\f + \fr 7:22 \ft Or \fqa 100 baths of oil\ft ; that is, approximately 580 gallons or 2,200 liters\f* \w and salt|strong="H04416"\w* \w . . .|strong="H01768"\w* \w without|strong="H03809"\w* \w limit|strong="H03792"\w*. \v 23 \w Whatever|strong="H03606"\w* \w . . .|strong="H01768"\w* \w is commanded|strong="H02942"\w* \w by|strong="H04481"\w* \w the God|strong="H00426"\w* \w of heaven|strong="H08065"\w* \w must be done|strong="H05648"\w* \w diligently|strong="H00149"\w* \w for [His] house|strong="H01005"\w* \w . . .|strong="H00426"\w* \w . . .|strong="H08065"\w*. \w For|strong="H01768"\w* \w why|strong="H04101"\w* \w should wrath|strong="H07109"\w* \w fall|strong="H01934"\w* \w on|strong="H05922"\w* \w the realm|strong="H04437"\w* \w of the king|strong="H04430"\w* \w and his sons|strong="H01123"\w*? \v 24 And \w be advised|strong="H03046"\w* \w that|strong="H01768"\w* \w you have no|strong="H03809"\w* \w authority|strong="H07990"\w* \w to impose|strong="H07412"\w* \w tribute|strong="H04061"\w*, \w duty|strong="H01093"\w*, \w or toll|strong="H01983"\w* \w on|strong="H05922"\w* \w any|strong="H03606"\w* \w of the priests|strong="H03549"\w*, \w Levites|strong="H03879"\w*, \w singers|strong="H02171"\w*, \w doorkeepers|strong="H08652"\w*, \w temple servants|strong="H05412"\w*, \w or other servants|strong="H06399"\w* \w of this|strong="H01836"\w* \w house|strong="H01005"\w* \w of God|strong="H00426"\w*.
\pmo \v 25 \w And you|strong="H00607"\w*, \w Ezra|strong="H05831"\w*, \w according to the wisdom|strong="H02452"\w* \w of your God|strong="H00426"\w*, \w which you possess|strong="H01768"\w* \w . . .|strong="H03028"\w*, \w are to appoint|strong="H04483"\w* \w magistrates|strong="H08200"\w* \w and judges|strong="H01782"\w*\w . . .|strong="H01768"\w*\w . . .|strong="H01934"\w* \w to judge|strong="H01778"\w* \w all|strong="H03606"\w* \w the people|strong="H05972"\w* \w . . .|strong="H01768"\w* \w west|strong="H05675"\w* \w of the Euphrates|strong="H05103"\w* — \w all|strong="H03606"\w* \w who know|strong="H03046"\w* \w the laws|strong="H01882"\w* \w of your God|strong="H00426"\w*. \w And you are to teach [these laws]|strong="H03046"\w* \w to anyone who|strong="H01768"\w* \w does not|strong="H03809"\w* \w know them|strong="H03046"\w*. \v 26 \w If anyone|strong="H03606"\w* \w . . .|strong="H01768"\w* \w does|strong="H01934"\w* \w not|strong="H03809"\w* \w keep|strong="H05648"\w* \w the law|strong="H01882"\w* \w of|strong="H01768"\w* \w your God|strong="H00426"\w* \w and the law|strong="H01882"\w* \w of|strong="H01768"\w* \w the king|strong="H04430"\w*, \w let a strict|strong="H00629"\w* \w judgment|strong="H01780"\w* \w be|strong="H01934"\w* \w executed|strong="H05648"\w* \w against him|strong="H04481"\w*, \w whether|strong="H02006"\w* \w death|strong="H04193"\w*, \w . . .|strong="H02006"\w* \w banishment|strong="H08332"\w*, \w . . .|strong="H02006"\w* \w confiscation|strong="H06065"\w* \w of property|strong="H05232"\w*, \w or imprisonment|strong="H00613"\w*.
\s1 Ezra Blesses God
\p \v 27 \w Blessed [be]|strong="H01288"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of our fathers|strong="H00001"\w*, \w who|strong="H00834"\w* \w has put|strong="H05414"\w* \w -|strong="H02063"\w* \w into the heart|strong="H03820"\w* \w of the king|strong="H04428"\w* \w to so honor|strong="H06286"\w* \w -|strong="H00853"\w* \w the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w* \w -|strong="H00834"\w* \w in Jerusalem|strong="H03389"\w*, \v 28 \w and who has shown|strong="H05186"\w* \w me|strong="H05921"\w* \w favor|strong="H02617"\w* \w before|strong="H06440"\w* \w the king|strong="H04428"\w*, \w his counselors|strong="H03289"\w*, \w and all|strong="H03605"\w* \w his|strong="H04428"\w* \w powerful|strong="H01368"\w* \w officials|strong="H08269"\w*.
\p \w And because the hand|strong="H03027"\w* \w of the LORD|strong="H03068"\w* \w my God|strong="H00430"\w* \w [was] upon me|strong="H05921"\w*, \w I|strong="H00589"\w* \w took courage|strong="H02388"\w* \w and gathered|strong="H06908"\w* \w the leaders|strong="H07218"\w* \w of Israel|strong="H03478"\w* \w to return|strong="H05927"\w* \w with me|strong="H05973"\w*.
\c 8
\s1 The Exiles Who Returned with Ezra
\p \v 1 \w These|strong="H00428"\w* \w are the family|strong="H00001"\w* \w heads|strong="H07218"\w* \w and genealogical records|strong="H03187"\w* \w of those who returned|strong="H05927"\w* \w with me|strong="H05973"\w* \w from Babylon|strong="H00894"\w* \w during the reign|strong="H04438"\w* \w of King|strong="H04428"\w* \w Artaxerxes|strong="H00783"\w*:
\b 
\li1 \v 2 \w from the descendants|strong="H01121"\w* \w of Phinehas|strong="H06372"\w*, \w Gershom|strong="H01647"\w*;
\li1 \w from the descendants|strong="H01121"\w* \w of Ithamar|strong="H00385"\w*, \w Daniel|strong="H01841"\w*;
\li1 \w from the descendants of|strong="H01121"\w* \w David|strong="H01732"\w*, \w Hattush|strong="H02407"\w* \v 3 \w of the descendants|strong="H01121"\w* \w of Shecaniah|strong="H07935"\w*;
\li1 \w from the descendants|strong="H01121"\w* \w of Parosh|strong="H06551"\w*, \w Zechariah|strong="H02148"\w*, \w and with him|strong="H05973"\w* \w [were] registered|strong="H03187"\w* \w 150|strong="H03967"\w* \w . . .|strong="H02572"\w* \w men|strong="H02145"\w*;
\li1 \v 4 \w from the descendants|strong="H01121"\w* \w vvv|strong="H06355"\w* \w of Pahath-Moab|strong="H06355"\w*, \w Eliehoenai|strong="H00454"\w* \w son|strong="H01121"\w* \w of Zerahiah|strong="H02228"\w*, \w and with him|strong="H05973"\w* \w 200|strong="H03967"\w* \w men|strong="H02145"\w*;
\li1 \v 5 \w from the descendants [of Zattu]|strong="H01121"\w*, \w Shecaniah|strong="H07935"\w* \w son|strong="H01121"\w* \w of Jahaziel|strong="H03166"\w*,\f + \fr 8:5 \ft Some LXX manuscripts (see also 1 Esdras 8:32); Hebrew \fqa from the descendants of Shecaniah, the son of Jahaziel\f* \w and with him|strong="H05973"\w* \w 300|strong="H07969"\w* \w . . .|strong="H03967"\w* \w men|strong="H02145"\w*;
\li1 \v 6 \w from the descendants|strong="H01121"\w* \w of Adin|strong="H05720"\w*, \w Ebed|strong="H05651"\w* \w son|strong="H01121"\w* \w of Jonathan|strong="H03129"\w*, \w and with him|strong="H05973"\w* \w 50|strong="H02572"\w* \w men|strong="H02145"\w*;
\li1 \v 7 \w from the descendants|strong="H01121"\w* \w of Elam|strong="H05867"\w*, \w Jeshaiah|strong="H03470"\w* \w son|strong="H01121"\w* \w of Athaliah|strong="H06271"\w*, \w and with him|strong="H05973"\w* \w 70|strong="H07657"\w* \w men|strong="H02145"\w*;
\li1 \v 8 \w from the descendants|strong="H01121"\w* \w of Shephatiah|strong="H08203"\w*, \w Zebadiah|strong="H02069"\w* \w son|strong="H01121"\w* \w of Michael|strong="H04317"\w*, \w and with him|strong="H05973"\w* \w 80|strong="H08084"\w* \w men|strong="H02145"\w*;
\li1 \v 9 \w from the descendants|strong="H01121"\w* \w of Joab|strong="H03097"\w*, \w Obadiah|strong="H05662"\w* \w son|strong="H01121"\w* \w of Jehiel|strong="H03171"\w*, \w and with him|strong="H05973"\w* \w 218|strong="H03967"\w* \w . . .|strong="H08083"\w* \w . . .|strong="H06240"\w* \w men|strong="H02145"\w*;
\li1 \v 10 \w from the descendants [of Bani]|strong="H01121"\w*, \w Shelomith|strong="H08019"\w* \w son|strong="H01121"\w* \w of Josiphiah|strong="H03131"\w*,\f + \fr 8:10 \ft Some LXX manuscripts (see also 1 Esdras 8:36); Hebrew \fqa from the descendants of Shelomith, the son of Josiphiah\f* \w and with him|strong="H05973"\w* \w 160|strong="H03967"\w* \w . . .|strong="H08346"\w* \w men|strong="H02145"\w*;
\li1 \v 11 \w from the descendants|strong="H01121"\w* \w of Bebai|strong="H00893"\w*, \w Zechariah|strong="H02148"\w* \w son|strong="H01121"\w* \w of Bebai|strong="H00893"\w*, \w and with him|strong="H05973"\w* \w 28|strong="H06242"\w* \w . . .|strong="H08083"\w* \w men|strong="H02145"\w*;
\li1 \v 12 \w from the descendants|strong="H01121"\w* \w of Azgad|strong="H05803"\w*, \w Johanan|strong="H03110"\w* \w son|strong="H01121"\w* \w of Hakkatan|strong="H06997"\w*, \w and with him|strong="H05973"\w* \w 110|strong="H03967"\w* \w . . .|strong="H06235"\w* \w men|strong="H02145"\w*;
\li1 \v 13 \w from the later|strong="H00314"\w*\f + \fr 8:13 \ft Or \fqa the last\f* \w descendants|strong="H01121"\w* \w of Adonikam|strong="H00140"\w*, \w these|strong="H00428"\w* \w [were] their names|strong="H08034"\w*: \w Eliphelet|strong="H00467"\w*, \w Jeiel|strong="H03273"\w*, \w and Shemaiah|strong="H08098"\w*, \w and with them|strong="H05973"\w* \w 60|strong="H08346"\w* \w men|strong="H02145"\w*;
