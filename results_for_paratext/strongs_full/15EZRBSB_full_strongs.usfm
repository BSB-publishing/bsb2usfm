\s1 Ezra’s Prayer of Confession
\p \v 5 \w At the evening|strong="H06153"\w* \w offering|strong="H04503"\w*, \w I got up|strong="H06965"\w* \w from my humiliation|strong="H08589"\w* \w with my tunic|strong="H00899"\w* \w and cloak|strong="H04598"\w* \w torn|strong="H07167"\w*, \w and I fell|strong="H03766"\w* \w on|strong="H05921"\w* \w my knees|strong="H01290"\w*, \w spread out|strong="H06566"\w* \w my hands|strong="H03709"\w* \w to|strong="H00413"\w* \w the LORD|strong="H03068"\w* \w my God|strong="H00430"\w*, \v 6 \w and said|strong="H00559"\w*:
\pmo “\w O my God|strong="H00430"\w*, \w I am ashamed|strong="H00954"\w* \w and embarrassed|strong="H03637"\w* \w to lift up|strong="H07311"\w* \w my face|strong="H06440"\w* \w to You|strong="H00413"\w*, \w my God|strong="H00430"\w*, \w because|strong="H03588"\w* \w our iniquities|strong="H05771"\w* \w are higher than|strong="H07235"\w* \w . . .|strong="H04605"\w* \w our heads|strong="H07218"\w*, \w and our guilt|strong="H00819"\w* \w has reached|strong="H01431"\w* \w . . .|strong="H05704"\w* \w the heavens|strong="H08064"\w*. \v 7 \w From the days|strong="H03117"\w* \w of our fathers|strong="H00001"\w*\w . . .|strong="H00587"\w* \w to|strong="H05704"\w* \w this|strong="H02088"\w* \w day|strong="H03117"\w*, \w our guilt|strong="H00819"\w* \w has been great|strong="H01419"\w*. \w Because of our iniquities|strong="H05771"\w*, \w we|strong="H00587"\w* \w and our kings|strong="H04428"\w* \w [and] priests|strong="H03548"\w* \w have been delivered|strong="H05414"\w* \w into the hands|strong="H03027"\w* \w of the kings|strong="H04428"\w* \w of the earth|strong="H00776"\w* \w [and subjected] to the sword|strong="H02719"\w* \w and to captivity|strong="H07628"\w*, \w to pillage|strong="H00961"\w* \w and humiliation|strong="H01322"\w* \w . . .|strong="H06440"\w*, \w as we are this|strong="H02088"\w* \w day|strong="H03117"\w*.
\pmo \v 8 \w But now|strong="H06258"\w*, \w for a brief|strong="H04592"\w* \w moment|strong="H07281"\w*, \w grace|strong="H08467"\w* \w has come|strong="H01961"\w* \w from|strong="H00854"\w* \w the LORD|strong="H03068"\w* \w our God|strong="H00430"\w* \w to preserve|strong="H07604"\w* for us \w a remnant|strong="H06413"\w* \w and to give|strong="H05414"\w* us \w a stake|strong="H03489"\w*\f + \fr 9:8 \ft Or \fqa nail \ft or \fqa foothold\f* \w in His holy|strong="H06944"\w* \w place|strong="H04725"\w*. \w Even in our bondage|strong="H05659"\w*, \w our God|strong="H00430"\w* \w has given us|strong="H05414"\w* \w new life|strong="H04241"\w* \w . . .|strong="H04592"\w* \w and light|strong="H00215"\w* \w to our eyes|strong="H05869"\w*. \v 9 \w Though|strong="H03588"\w* \w we|strong="H00587"\w* \w are slaves|strong="H05650"\w*, \w our God|strong="H00430"\w* \w has not|strong="H03808"\w* \w forsaken us|strong="H05800"\w* \w in our bondage|strong="H05659"\w*, \w but He has extended|strong="H05186"\w* \w to us|strong="H05921"\w* \w grace|strong="H02617"\w* \w in the sight|strong="H06440"\w* \w of the kings|strong="H04428"\w* \w of Persia|strong="H06539"\w*, \w giving|strong="H05414"\w* us \w new life|strong="H04241"\w* \w to rebuild|strong="H07311"\w* \w -|strong="H00853"\w* \w the house|strong="H01004"\w* \w of our God|strong="H00430"\w* \w and repair|strong="H05975"\w* \w -|strong="H00853"\w* \w its ruins|strong="H02723"\w*, \w and giving|strong="H05414"\w* us \w a wall of protection|strong="H01447"\w* \w in Judah|strong="H03063"\w* \w and Jerusalem|strong="H03389"\w*.
\pmo \v 10 \w And now|strong="H06258"\w*, \w our God|strong="H00430"\w*, \w what|strong="H04100"\w* \w can we say|strong="H00559"\w* \w after|strong="H00310"\w* \w this|strong="H02063"\w*? \w For|strong="H03588"\w* \w we have forsaken|strong="H05800"\w* \w the commandments|strong="H04687"\w* \v 11 \w that|strong="H00834"\w* \w You gave|strong="H06680"\w* \w through|strong="H03027"\w* \w Your servants|strong="H05650"\w* \w the prophets|strong="H05030"\w*, \w saying|strong="H00559"\w*: ‘\w The land|strong="H00776"\w* \w that|strong="H00834"\w* \w you|strong="H00859"\w* \w are entering|strong="H00935"\w* \w to possess|strong="H03423"\w* \w is|strong="H01931"\w* \w a land|strong="H00776"\w* \w polluted|strong="H05079"\w* \w by the impurity|strong="H05079"\w* \w of its peoples|strong="H05971"\w* \w . . .|strong="H00776"\w* \w and the abominations|strong="H08441"\w* \w with which|strong="H00834"\w* \w they have filled it|strong="H04390"\w* \w from end|strong="H06310"\w* \w to|strong="H00413"\w* \w end|strong="H06310"\w* \w -|strong="H02932"\w*. \v 12 \w Now, therefore|strong="H06258"\w*, \w do not|strong="H00408"\w* \w give|strong="H05414"\w* \w your daughters {in marriage}|strong="H01323"\w* \w to their sons|strong="H01121"\w* \w or take|strong="H05375"\w* \w their daughters|strong="H01323"\w* \w . . .|strong="H00408"\w* \w for your sons|strong="H01121"\w*. \w Never|strong="H03808"\w* \w . . .|strong="H05704"\w* \w . . .|strong="H05769"\w* \w seek|strong="H01875"\w* \w their peace|strong="H07965"\w* \w or prosperity|strong="H02896"\w*, \w so that|strong="H04616"\w* \w you may be strong|strong="H02388"\w* \w and may eat|strong="H00398"\w* \w -|strong="H00853"\w* \w the good things|strong="H02898"\w* \w of the land|strong="H00776"\w*, \w leaving it as an inheritance|strong="H03423"\w* \w to your sons|strong="H01121"\w* \w forever|strong="H05704"\w* \w . . .|strong="H05769"\w*.’
\pmo \v 13 \w After|strong="H00310"\w* \w all|strong="H03605"\w* \w that has come|strong="H00935"\w* \w upon us|strong="H05921"\w* \w because of our evil|strong="H07451"\w* \w deeds|strong="H04639"\w* \w and our great|strong="H01419"\w* \w guilt|strong="H00819"\w* (\w though|strong="H03588"\w* \w You|strong="H00859"\w*, \w our God|strong="H00430"\w*, \w have punished us|strong="H02820"\w* \w less|strong="H04295"\w* \w than our iniquities [deserve]|strong="H05771"\w* \w and have given|strong="H05414"\w* us \w [such] a remnant|strong="H06413"\w* \w as this|strong="H02063"\w*), \v 14 \w shall we again|strong="H07725"\w* \w break|strong="H06565"\w* \w Your commandments|strong="H04687"\w* \w and intermarry|strong="H02859"\w* \w with the peoples|strong="H05971"\w* \w who commit these|strong="H00428"\w* \w abominations|strong="H08441"\w*? \w Would You not|strong="H03808"\w* \w become so angry|strong="H00599"\w* with us \w as to|strong="H05704"\w* \w wipe us out|strong="H03615"\w*, \w leaving no|strong="H00369"\w* \w remnant|strong="H07611"\w* \w or survivor|strong="H06413"\w*?
\pmo \v 15 \w O LORD|strong="H03068"\w*, \w God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w You|strong="H00859"\w* \w are righteous|strong="H06662"\w*! \w For|strong="H03588"\w* \w we remain|strong="H07604"\w* \w this|strong="H02088"\w* \w day|strong="H03117"\w* \w as a remnant|strong="H06413"\w*. \w Here we [are]|strong="H02005"\w* \w before You|strong="H06440"\w* \w in our guilt|strong="H00819"\w*, \w though|strong="H03588"\w* \w because|strong="H05921"\w* \w of it|strong="H02063"\w* \w no one|strong="H00369"\w* \w can stand|strong="H05975"\w* \w before You|strong="H06440"\w*.”
\c 10
\s1 Shecaniah’s Encouragement
\p \v 1 \w While Ezra|strong="H05830"\w* \w prayed|strong="H06419"\w* \w and made this confession|strong="H03034"\w*, \w weeping|strong="H01058"\w* \w and falling facedown|strong="H05307"\w* \w before|strong="H06440"\w* \w the house|strong="H01004"\w* \w of God|strong="H00430"\w*, \w a very|strong="H03966"\w* \w large|strong="H07227"\w* \w assembly|strong="H06951"\w* \w of Israelites|strong="H03478"\w* — \w men|strong="H00582"\w*, \w women|strong="H00802"\w*, \w and children|strong="H03206"\w* — \w gathered|strong="H06908"\w* \w around him|strong="H00413"\w*, \w and the people|strong="H05971"\w* \w wept bitterly|strong="H01058"\w* \w . . .|strong="H07235"\w* \w . . .|strong="H01059"\w* \w as well|strong="H03588"\w*.
\p \v 2 \w Then|strong="H06030"\w* \w Shecaniah|strong="H07935"\w* \w son|strong="H01121"\w* \w of Jehiel|strong="H03171"\w*, \w an Elamite|strong="H01121"\w* \w . . .|strong="H05867"\w*, \w said|strong="H00559"\w* \w to Ezra|strong="H05830"\w*: “\w We|strong="H00587"\w* \w have been unfaithful|strong="H04603"\w* \w to our God|strong="H00430"\w* \w by marrying|strong="H03427"\w* \w foreign|strong="H05237"\w* \w women|strong="H00802"\w* \w from the people|strong="H05971"\w* \w of the land|strong="H00776"\w*, \w yet|strong="H06258"\w* \w in spite of|strong="H05921"\w* \w this|strong="H02063"\w*, \w there is|strong="H03426"\w* \w hope|strong="H04723"\w* \w for Israel|strong="H03478"\w*. \v 3 \w So now|strong="H06258"\w* \w let us make|strong="H03772"\w* \w a covenant|strong="H01285"\w* \w before our God|strong="H00430"\w* \w to send away|strong="H03318"\w* \w all|strong="H03605"\w* \w the foreign wives|strong="H00802"\w* \w and their children|strong="H03205"\w*, . . . \w according to the counsel|strong="H06098"\w* \w of my lord|strong="H00136"\w* \w and of those who tremble|strong="H02730"\w* \w at the command|strong="H04687"\w* \w of our God|strong="H00430"\w*. \w Let it be done|strong="H06213"\w* \w according to the Law|strong="H08451"\w*. \v 4 \w Get up|strong="H06965"\w*, \w for|strong="H03588"\w* \w [this] matter [is]|strong="H01697"\w* \w your [responsibility]|strong="H05921"\w*, \w and we|strong="H00587"\w* \w will support you|strong="H05973"\w*. \w Be strong|strong="H02388"\w* \w and take action|strong="H06213"\w*!”
\p \v 5 \w So Ezra|strong="H05830"\w* \w got up|strong="H06965"\w* \w and made the leading|strong="H08269"\w* \w priests|strong="H03548"\w*, \w Levites|strong="H03881"\w*, \w and all|strong="H03605"\w* \w Israel|strong="H03478"\w* \w take an oath|strong="H07650"\w* \w -|strong="H00853"\w* \w to do what had been said|strong="H06213"\w* \w . . .|strong="H01697"\w* \w . . .|strong="H02088"\w*. \w And they took the oath|strong="H07650"\w*.
\s1 The People’s Confession of Sin
\p \v 6 \w Then Ezra|strong="H05830"\w* \w withdrew|strong="H06965"\w* \w from before|strong="H06440"\w* \w the house|strong="H01004"\w* \w of God|strong="H00430"\w* \w and walked|strong="H01980"\w* \w to|strong="H00413"\w* \w the chamber|strong="H03957"\w* \w of Jehohanan|strong="H03076"\w* \w son|strong="H01121"\w* \w of Eliashib|strong="H00475"\w*. \w And while he stayed|strong="H01980"\w*\f + \fr 10:6 \ft Or \fqa went\f* \w there|strong="H08033"\w*, \w he ate|strong="H00398"\w* \w no|strong="H03808"\w* \w food|strong="H03899"\w* \w and drank|strong="H08354"\w* \w no|strong="H03808"\w* \w water|strong="H04325"\w*, \w because|strong="H03588"\w* \w he was mourning|strong="H00056"\w* \w over|strong="H05921"\w* \w the unfaithfulness|strong="H04604"\w* \w of the exiles|strong="H01473"\w*.
\p \v 7 \w And a proclamation|strong="H06963"\w* \w was issued|strong="H05674"\w* \w throughout Judah|strong="H03063"\w* \w and Jerusalem|strong="H03389"\w* \w that all|strong="H03605"\w* \w the exiles|strong="H01121"\w* \w . . .|strong="H01473"\w* \w should gather|strong="H06908"\w* \w at Jerusalem|strong="H03389"\w*. \v 8 \w Whoever|strong="H03605"\w* \w -|strong="H00834"\w* \w failed|strong="H03808"\w* \w to appear|strong="H00935"\w* \w within three|strong="H07969"\w* \w days|strong="H03117"\w* \w would forfeit|strong="H02763"\w* \w all|strong="H03605"\w* \w his property|strong="H07399"\w*, \w . . .|strong="H01931"\w* \w according to the counsel|strong="H06098"\w* \w of the leaders|strong="H08269"\w* \w and elders|strong="H02205"\w*, \w and would himself be expelled|strong="H00914"\w* \w from the assembly|strong="H06951"\w* \w of the exiles|strong="H01473"\w*.
\p \v 9 \w So within the three|strong="H07969"\w* \w days|strong="H03117"\w*, \w all|strong="H03605"\w* \w the men|strong="H00582"\w* \w of Judah|strong="H03063"\w* \w and Benjamin|strong="H01144"\w* \w assembled|strong="H06908"\w* \w in Jerusalem|strong="H03389"\w*, \w . . .|strong="H01931"\w* \w and on the twentieth day|strong="H06242"\w* \w . . .|strong="H02320"\w* \w of the ninth|strong="H08671"\w* \w month|strong="H02320"\w*, \w all|strong="H03605"\w* \w the people|strong="H05971"\w* \w sat|strong="H03427"\w* \w in the square|strong="H07339"\w* \w at the house|strong="H01004"\w* \w of God|strong="H00430"\w*, \w trembling|strong="H07460"\w* \w regarding|strong="H05921"\w* \w this matter|strong="H01697"\w* \w and because of the heavy rain|strong="H01653"\w*.
\p \v 10 \w Then Ezra|strong="H05830"\w* \w the priest|strong="H03548"\w* \w stood up|strong="H06965"\w* \w and said|strong="H00559"\w* \w to them|strong="H00413"\w*, “\w You|strong="H00859"\w* \w have been unfaithful|strong="H04603"\w* \w by marrying|strong="H03427"\w* \w foreign|strong="H05237"\w* \w women|strong="H00802"\w*, \w adding|strong="H03254"\w* \w to|strong="H05921"\w* \w the guilt|strong="H00819"\w* \w of Israel|strong="H03478"\w*. \v 11 \w Now, therefore|strong="H06258"\w*, \w make|strong="H05414"\w* \w a confession|strong="H08426"\w* \w to the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of your fathers|strong="H00001"\w*, \w and do|strong="H06213"\w* \w His will|strong="H07522"\w*. \w Separate|strong="H00914"\w* \w yourselves|strong="H04480"\w* \w from the people|strong="H05971"\w* \w of the land|strong="H00776"\w* \w and from your foreign|strong="H05237"\w* \w wives|strong="H00802"\w*.”
\p \v 12 \w And the whole|strong="H03605"\w* \w assembly|strong="H06951"\w* \w . . .|strong="H00559"\w* \w responded|strong="H06030"\w* \w in a loud|strong="H01419"\w* \w voice|strong="H06963"\w*: “\w Truly|strong="H03651"\w* \w we must do|strong="H06213"\w* \w as you say|strong="H01697"\w* \w . . .|strong="H05921"\w*! \v 13 \w But|strong="H00061"\w* \w there are many|strong="H07227"\w* \w people here|strong="H05971"\w*, \w and it is the rainy|strong="H01653"\w* \w season|strong="H06256"\w*. \w We are not|strong="H00369"\w* \w able|strong="H03581"\w* \w to stay|strong="H05975"\w* \w out in the open|strong="H02351"\w*. \w Nor [is this]|strong="H03808"\w* \w the work|strong="H04399"\w* \w of one|strong="H00259"\w* \w or|strong="H03808"\w* \w two|strong="H08147"\w* \w days|strong="H03117"\w*, \w for|strong="H03588"\w* \w we have transgressed|strong="H06586"\w* \w greatly|strong="H07235"\w* \w in this|strong="H02088"\w* \w matter|strong="H01697"\w*. \v 14 \w Let our leaders|strong="H08269"\w* \w represent|strong="H05975"\w* \w . . .|strong="H04994"\w* \w the whole|strong="H03605"\w* \w assembly|strong="H06951"\w*. \w Then let everyone|strong="H03605"\w* \w -|strong="H00834"\w* \w in our towns|strong="H05892"\w* \w who has married|strong="H03427"\w* \w a foreign|strong="H05237"\w* \w woman|strong="H00802"\w* \w come|strong="H00935"\w* \w at an appointed|strong="H02163"\w* \w time|strong="H06256"\w*, \w together with|strong="H05973"\w* \w the elders|strong="H02205"\w* \w and judges|strong="H08199"\w* \w . . .|strong="H05704"\w* \w of each town|strong="H05892"\w* \w . . .|strong="H05892"\w*, \w until the fierce anger|strong="H02740"\w* \w . . .|strong="H00639"\w* \w of our God|strong="H00430"\w* \w -|strong="H05704"\w* \w in this|strong="H02088"\w* \w matter|strong="H01697"\w* \w is turned away|strong="H07725"\w* \w from us|strong="H04480"\w*.”
\p \v 15 (\w Only|strong="H00389"\w* \w Jonathan|strong="H03129"\w* \w son|strong="H01121"\w* \w of Asahel|strong="H06214"\w* \w and Jahzeiah|strong="H03167"\w* \w son|strong="H01121"\w* \w of Tikvah|strong="H08616"\w*, \w supported|strong="H05826"\w* \w by Meshullam|strong="H04918"\w* \w and Shabbethai|strong="H07678"\w* \w the Levite|strong="H03881"\w*, \w opposed|strong="H05975"\w* \w . . .|strong="H05921"\w* \w this [plan]|strong="H02063"\w*.)
\p \v 16 \w So the exiles|strong="H01121"\w* \w . . .|strong="H01473"\w* \w did|strong="H06213"\w* \w as proposed|strong="H03651"\w*. \w Ezra|strong="H05830"\w* \w the priest|strong="H03548"\w* \w selected|strong="H00914"\w* \w men|strong="H00582"\w* \w who were family|strong="H00001"\w* \w heads|strong="H07218"\w*, \w each of them|strong="H03605"\w* \w identified by name|strong="H08034"\w*, \w . . .|strong="H03427"\w* \w to represent their families|strong="H00001"\w* \w . . .|strong="H01004"\w*. \w On the first|strong="H00259"\w* \w day|strong="H03117"\w* \w of the tenth|strong="H06224"\w* \w month|strong="H02320"\w* \w they launched|strong="H01875"\w* \w the investigation|strong="H01697"\w*, \v 17 \w and by|strong="H05704"\w* \w the first|strong="H00259"\w* \w day|strong="H03117"\w* \w of the first|strong="H07223"\w* \w month|strong="H02320"\w* \w they had dealt|strong="H03615"\w* \w with all|strong="H03605"\w* \w the men|strong="H00582"\w* \w who had married|strong="H03427"\w* \w foreign|strong="H05237"\w* \w women|strong="H00802"\w*.
