\p \v 26 \w I weighed out|strong="H08254"\w* \w into|strong="H05921"\w* \w their hands|strong="H03027"\w* \w 650|strong="H08337"\w* \w . . .|strong="H03967"\w* \w . . .|strong="H02572"\w* \w talents|strong="H03603"\w* \w of silver|strong="H03701"\w*,\f + \fr 8:26 \fqa 650 talents \ft is approximately 24.5 tons or 22.2 metric tons of silver.\f* \w articles|strong="H03627"\w* \w of silver|strong="H03701"\w* \w [weighing] 100|strong="H03967"\w* \w talents|strong="H03603"\w*,\f + \fr 8:26 \fqa 100 talents \ft is approximately 3.77 tons or 3.42 metric tons of silver articles.\f* \w 100|strong="H03967"\w* \w talents|strong="H03603"\w* \w of gold|strong="H02091"\w*,\f + \fr 8:26 \fqa 100 talents \ft is approximately 3.77 tons or 3.42 metric tons of gold.\f* \v 27 \w 20|strong="H06242"\w* \w gold|strong="H02091"\w* \w bowls|strong="H03713"\w* \w [valued at] 1,000|strong="H00505"\w* \w darics|strong="H00150"\w*,\f + \fr 8:27 \ft Or \fqa worth 1,000 drachmas\ft ; that is, approximately 18.5 pounds or 8.4 kilograms of gold\f* \w and two|strong="H08147"\w* \w articles|strong="H03627"\w* \w of fine|strong="H02896"\w* \w polished|strong="H06668"\w* \w bronze|strong="H05178"\w*, \w as precious as|strong="H02530"\w* \w gold|strong="H02091"\w*.
\p \v 28 \w Then I told|strong="H00559"\w* \w them|strong="H00413"\w*, “\w You|strong="H00859"\w* \w are holy|strong="H06944"\w* \w to the LORD|strong="H03068"\w*, \w and these articles [are]|strong="H03627"\w* \w holy|strong="H06944"\w*. \w The silver|strong="H03701"\w* \w and gold|strong="H02091"\w* \w are a freewill offering|strong="H05071"\w* \w to the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of your fathers|strong="H00001"\w*. \v 29 \w Guard them|strong="H08245"\w* \w carefully|strong="H08104"\w* \w until|strong="H05704"\w* \w you weigh them out|strong="H08254"\w* \w in the chambers|strong="H03957"\w* \w of the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w* \w in Jerusalem|strong="H03389"\w* \w before|strong="H06440"\w* \w the leading|strong="H08269"\w* \w priests|strong="H03548"\w*, \w Levites|strong="H03881"\w*, \w and heads|strong="H08269"\w* \w of the Israelite|strong="H03478"\w* \w families|strong="H00001"\w*.”
