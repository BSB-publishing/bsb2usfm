\li1 \w 29|strong="H08672"\w* \w . . .|strong="H06242"\w* \w silver utensils|strong="H04252"\w*,
\li1 \v 10 \w 30|strong="H07970"\w* \w gold|strong="H02091"\w* \w bowls|strong="H03713"\w*,
\li1 \w 410|strong="H00702"\w* \w . . .|strong="H03967"\w* \w . . .|strong="H06235"\w* \w matching|strong="H04932"\w* \w silver|strong="H03701"\w* \w bowls|strong="H03713"\w*,
\li1 \w and 1,000|strong="H00505"\w* \w other|strong="H00312"\w* \w articles|strong="H03627"\w*.
\p \v 11 \w In all, there were|strong="H03605"\w* \w 5,400|strong="H02568"\w* \w . . .|strong="H00505"\w* \w . . .|strong="H00702"\w* \w . . .|strong="H03967"\w* \w gold|strong="H02091"\w* \w and silver|strong="H03701"\w* \w articles|strong="H03627"\w*. \w Sheshbazzar|strong="H08339"\w* \w brought|strong="H05927"\w* \w all [these]|strong="H03605"\w* \w along|strong="H05973"\w* \w when the exiles|strong="H01473"\w* \w went up|strong="H05927"\w* \w from Babylon|strong="H00894"\w* \w to Jerusalem|strong="H03389"\w*.
