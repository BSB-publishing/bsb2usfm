\p \v 16 \w And Naomi|strong="H05281"\w* \w -|strong="H00853"\w* \w took|strong="H03947"\w* \w the child|strong="H03206"\w*, \w placed him|strong="H07896"\w* \w on her lap|strong="H02436"\w*, \w and became|strong="H01961"\w* \w a nurse|strong="H00539"\w* to him. \v 17 \w The neighbor|strong="H07934"\w* \w women said|strong="H00559"\w*, “\w A son|strong="H01121"\w* \w has been born|strong="H03205"\w* \w to Naomi|strong="H05281"\w*,” \w . . .|strong="H07121"\w* \w . . .|strong="H08034"\w* \w and they named|strong="H07121"\w* him \w -|strong="H08034"\w* \w Obed|strong="H05744"\w*. \w He [became]|strong="H01931"\w* \w the father|strong="H00001"\w* \w of Jesse|strong="H03448"\w*, \w the father|strong="H00001"\w* \w of David|strong="H01732"\w*.
