\p \v 20 \w Then Naomi|strong="H05281"\w* \w said|strong="H00559"\w* \w to her daughter-in-law|strong="H03618"\w*, “\w May he|strong="H01931"\w* \w be blessed|strong="H01288"\w* \w by the LORD|strong="H03068"\w*, \w who|strong="H00834"\w* \w has not|strong="H03808"\w* \w withdrawn|strong="H05800"\w* \w His kindness|strong="H02617"\w* \w from|strong="H00854"\w* \w the living|strong="H02416"\w* \w . . .|strong="H00854"\w* \w or the dead|strong="H04191"\w*.” \w Naomi|strong="H05281"\w* \w continued|strong="H00559"\w*, “\w The man|strong="H00376"\w* \w is a close relative|strong="H07138"\w*. \w He|strong="H01931"\w* [is] one of our \w kinsman-redeemers|strong="H01350"\w*.\f + \fr 2:20 \ft The Hebrew word for \fqa kinsman-redeemer \ft or \fqa guardian-redeemer\ft is a legal term for the kinsman who redeems or vindicates a relative; see Leviticus 25:25–55.\f*”
\p \v 21 \w Then Ruth|strong="H07327"\w* \w the Moabitess|strong="H04125"\w* \w said|strong="H00559"\w*, “\w He also|strong="H01571"\w* \w . . .|strong="H03588"\w* \w told me|strong="H00559"\w*, \w . . .|strong="H00413"\w* ‘\w Stay|strong="H01692"\w* \w with|strong="H05973"\w* \w my young men|strong="H05288"\w* \w -|strong="H00834"\w* - \w until|strong="H05704"\w* \w . . .|strong="H00518"\w* \w they have finished gathering|strong="H03615"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* my \w harvest|strong="H07105"\w* \w -|strong="H00834"\w*.’”
\p \v 22 \w And Naomi|strong="H05281"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w her daughter-in-law|strong="H03618"\w* \w Ruth|strong="H07327"\w*, “\w My daughter|strong="H01323"\w*, \w . . .|strong="H03588"\w* \w it is good|strong="H02896"\w* \w for you to work|strong="H03318"\w* \w with|strong="H05973"\w* \w his young women|strong="H05291"\w*, \w so that nothing|strong="H03808"\w* \w will happen|strong="H06293"\w* to you \w in another|strong="H00312"\w* \w field|strong="H07704"\w*.”
\p \v 23 \w So Ruth stayed close|strong="H01692"\w* \w to the servant girls|strong="H05291"\w* \w of Boaz|strong="H01162"\w* \w to glean|strong="H03950"\w* \w grain until|strong="H05704"\w* \w the barley|strong="H08184"\w* \w . . .|strong="H07105"\w* \w and wheat|strong="H02406"\w* \w harvests|strong="H07105"\w* \w were finished|strong="H03615"\w*. \w And she lived|strong="H03427"\w* \w with|strong="H00854"\w* \w her mother-in-law|strong="H02545"\w*.
\c 3
\s1 Ruth’s Redemption Assured
\p \v 1 \w One day Ruth’s mother-in-law|strong="H02545"\w* \w Naomi|strong="H05281"\w* \w said|strong="H00559"\w* to her, “\w My daughter|strong="H01323"\w*, \w should I not|strong="H03808"\w* \w seek|strong="H01245"\w* \w a resting place|strong="H04494"\w* for you, \w that|strong="H00834"\w* \w it may be well|strong="H03190"\w* with you? \v 2 \w Now|strong="H06258"\w* \w is not|strong="H03808"\w* \w Boaz|strong="H01162"\w*, \w with|strong="H00854"\w* \w whose|strong="H00834"\w* \w servant girls|strong="H05291"\w* \w you have been [working]|strong="H01961"\w*, \w a relative of ours|strong="H04130"\w*? \w In fact|strong="H02009"\w*, \w tonight|strong="H03915"\w* \w he|strong="H01931"\w* \w is winnowing|strong="H02219"\w* \w -|strong="H00853"\w* \w barley|strong="H08184"\w* \w on the threshing floor|strong="H01637"\w*. \v 3 \w Therefore wash yourself|strong="H07364"\w*, \w put on perfume|strong="H05480"\w*, \w and wear|strong="H07760"\w* \w your best clothes|strong="H08071"\w*. \w . . .|strong="H05921"\w* \w Go down|strong="H03381"\w* \w to the threshing floor|strong="H01637"\w*, \w but do not|strong="H00408"\w* \w let the man|strong="H00376"\w* \w know|strong="H03045"\w* \w you are there until|strong="H05704"\w* \w he has finished|strong="H03615"\w* \w eating|strong="H00398"\w* \w and drinking|strong="H08354"\w*. \v 4 \w -|strong="H01961"\w* \w When he lies down|strong="H07901"\w*, \w note|strong="H03045"\w* \w -|strong="H00853"\w* \w the place|strong="H04725"\w* \w where|strong="H00834"\w* \w he lies|strong="H07901"\w*. \w . . .|strong="H08033"\w* \w Then go in|strong="H00935"\w* \w and uncover|strong="H01540"\w* \w his feet|strong="H04772"\w*, \w and lie down|strong="H07901"\w*, \w and he|strong="H01931"\w* \w will explain|strong="H05046"\w* to you \w -|strong="H00853"\w* \w what|strong="H00834"\w* \w you should do|strong="H06213"\w*.”
\p \v 5 “\w I will do|strong="H06213"\w* \w everything|strong="H03605"\w* \w -|strong="H00834"\w* \w you say|strong="H00559"\w*,” \w [Ruth] answered|strong="H00559"\w* \w -|strong="H00413"\w*. \v 6 \w So she went down|strong="H03381"\w* \w to the threshing floor|strong="H01637"\w* \w and did|strong="H06213"\w* \w everything|strong="H03605"\w* \w -|strong="H00834"\w* \w her mother-in-law|strong="H02545"\w* \w had instructed her [to do]|strong="H06680"\w*.
\p \v 7 \w After Boaz|strong="H01162"\w* \w had finished eating|strong="H00398"\w* \w and drinking|strong="H08354"\w* \w and was in good spirits|strong="H03190"\w* \w . . .|strong="H03820"\w*, \w he went|strong="H00935"\w* \w to lie down|strong="H07901"\w* \w at the end|strong="H07097"\w* \w of the heap of grain|strong="H06194"\w*. \w Then [Ruth] went in secretly|strong="H00935"\w* \w . . .|strong="H03909"\w*, \w uncovered|strong="H01540"\w* \w his feet|strong="H04772"\w*, \w and lay down|strong="H07901"\w*.
\p \v 8 \w -|strong="H01961"\w* \w At midnight|strong="H02677"\w* \w . . .|strong="H03915"\w*, \w Boaz|strong="H00376"\w* \w was startled|strong="H02729"\w*, \w turned over|strong="H03943"\w*, \w and there|strong="H02009"\w* \w lying|strong="H07901"\w* \w at his feet|strong="H04772"\w* \w was a woman|strong="H00802"\w*!
\p \v 9 “\w Who|strong="H04310"\w* \w are you|strong="H00859"\w*?” \w he asked|strong="H00559"\w*.
\p “\w I [am]|strong="H00595"\w* \w your servant|strong="H00519"\w* \w Ruth|strong="H07327"\w*,” \w she replied|strong="H00559"\w*. “\w Spread|strong="H06566"\w* \w the corner of your garment|strong="H03671"\w*\f + \fr 3:9 \ft Or \fqa Spread your wing\ft ; the word for \fqa wing \ft can also mean \fqa corner of a garment\ft ; see Ruth 2:12.\f* \w over|strong="H05921"\w* \w me|strong="H00519"\w*, \w for|strong="H03588"\w* \w you|strong="H00859"\w* \w are a kinsman-redeemer|strong="H01350"\w*.\f + \fr 3:9 \ft The Hebrew word for \fqa kinsman-redeemer \ft or \fqa guardian-redeemer\ft is a legal term for the kinsman who redeems or vindicates a relative; similarly in verses 12 and 13; see Leviticus 25:25–55.\f*”
\p \v 10 \w Then [Boaz] said|strong="H00559"\w*, “\w May the LORD|strong="H03068"\w* \w bless|strong="H01288"\w* \w you|strong="H00859"\w*, \w my daughter|strong="H01323"\w*. \w You have shown|strong="H03190"\w* \w more kindness|strong="H02617"\w* \w now|strong="H00314"\w* \w than|strong="H04480"\w* \w before|strong="H07223"\w*, \w because you have not|strong="H01115"\w* \w run|strong="H01980"\w* \w after|strong="H00310"\w* \w the younger men|strong="H00970"\w*, \w whether|strong="H00518"\w* \w rich|strong="H06223"\w* \w or|strong="H00518"\w* \w poor|strong="H01800"\w*. \v 11 \w And now|strong="H06258"\w* \w do not|strong="H00408"\w* \w be afraid|strong="H03372"\w*, \w my daughter|strong="H01323"\w*. \w I will do|strong="H06213"\w* for you \w whatever|strong="H03605"\w* \w -|strong="H00834"\w* \w you request|strong="H00559"\w*, \w since|strong="H03588"\w* \w all|strong="H03605"\w* \w my fellow townspeople|strong="H05971"\w* \w . . .|strong="H08179"\w* \w know|strong="H03045"\w* \w that|strong="H03588"\w* \w you|strong="H00859"\w* \w are a woman|strong="H00802"\w* \w of noble character|strong="H02428"\w*. \v 12 \w -|strong="H06258"\w* \w Yes|strong="H03588"\w*, \w it is true|strong="H00551"\w* \w that|strong="H03588"\w* \w I [am]|strong="H00595"\w*\w . . .|strong="H00518"\w* \w a kinsman-redeemer|strong="H01350"\w*, \w but|strong="H01571"\w* \w there is|strong="H03426"\w* \w a redeemer|strong="H01350"\w* \w nearer|strong="H07138"\w* \w than I|strong="H04480"\w*.\f + \fr 3:12 \ft That is, more closely related\f* \v 13 \w Stay here tonight|strong="H03885"\w* \w . . .|strong="H03915"\w*, \w . . .|strong="H01961"\w* \w and in the morning|strong="H01242"\w*, \w if|strong="H00518"\w* \w he wants to redeem you|strong="H01350"\w*, \w good|strong="H02896"\w*. \w Let him redeem you|strong="H01350"\w*. \w But if|strong="H00518"\w* \w he does not|strong="H03808"\w* \w want|strong="H02654"\w* \w to redeem you|strong="H01350"\w*, \w as surely as the LORD|strong="H03068"\w* \w live