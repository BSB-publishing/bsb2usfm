\s1 The Fiery Furnace
\p \v 19 \w At this|strong="H00116"\w*, \w Nebuchadnezzar|strong="H05020"\w* \w was filled|strong="H04391"\w* \w with rage|strong="H02528"\w*, \w and the expression|strong="H06755"\w* \w on his face|strong="H00600"\w* \w changed|strong="H08133"\w* \w toward|strong="H05922"\w* \w Shadrach|strong="H07715"\w*, \w Meshach|strong="H04336"\w*, \w vvv|strong="H05665"\w* \w and Abednego|strong="H05665"\w*. \w He gave orders|strong="H06032"\w* \w . . .|strong="H00560"\w* \w to heat|strong="H00228"\w* \w the furnace|strong="H00861"\w* \w . . .|strong="H02298"\w* \w seven times|strong="H07655"\w* \w hotter|strong="H05922"\w* \w than|strong="H01768"\w* \w usual|strong="H02370"\w* \w . . .|strong="H00228"\w*, \v 20 \w -|strong="H01400"\w* \w and he commanded|strong="H00560"\w* \w [some] mighty men|strong="H01401"\w* \w of valor|strong="H02429"\w* \w -|strong="H01768"\w* \w in his army|strong="H02429"\w* \w to tie up|strong="H03729"\w* \w Shadrach|strong="H07715"\w*, \w Meshach|strong="H04336"\w*, \w vvv|strong="H05665"\w* \w and Abednego|strong="H05665"\w* \w and throw them|strong="H07412"\w* \w into the blazing|strong="H03345"\w* \w fiery|strong="H05135"\w* \w furnace|strong="H00861"\w*.
