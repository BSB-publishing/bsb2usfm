Meshach|strong="H04336"\w*, \w vvv|strong="H05665"\w* \w and Abednego|strong="H05665"\w* — \w . . .|strong="H01400"\w* \w [who]|strong="H00479"\w* \w have ignored|strong="H03809"\w* \w . . .|strong="H07761"\w* \w . . .|strong="H05922"\w* \w you|strong="H02942"\w*, \w O king|strong="H04430"\w*, \w and have refused to|strong="H03809"\w* \w serve|strong="H06399"\w* \w your gods|strong="H00426"\w* \w or worship|strong="H05457"\w* \w the golden|strong="H01722"\w* \w statue|strong="H06755"\w* \w -|strong="H01768"\w* \w you have set up|strong="H06966"\w* \w -|strong="H03809"\w*.”
