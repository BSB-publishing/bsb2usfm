\p \v 18 \w Then|strong="H00116"\w* \w the king|strong="H04430"\w* \w went|strong="H00236"\w* \w to his palace|strong="H01965"\w* \w and spent the night|strong="H00956"\w* \w fasting|strong="H02908"\w*. \w No|strong="H03809"\w* \w entertainment|strong="H01761"\w* \w was brought|strong="H05954"\w* \w before him|strong="H06925"\w*, \w and sleep|strong="H08139"\w* \w fled|strong="H05075"\w* \w from him|strong="H05922"\w*.
\p \v 19 \w -|strong="H00116"\w* \w At the first light|strong="H05053"\w* \w of dawn|strong="H08238"\w*, \w the king|strong="H04430"\w* \w got up|strong="H06966"\w* \w and hurried|strong="H00927"\w* \w . . .|strong="H00236"\w* \w to the den|strong="H01358"\w* \w of|strong="H01768"\w* \w lions|strong="H00744"\w*. \v 20 \w When he reached|strong="H07127"\w* \w the den|strong="H01358"\w*, \w he cried out|strong="H02200"\w* \w -|strong="H01841"\w* \w in a voice|strong="H07032"\w* \w of anguish|strong="H06088"\w* \w -|strong="H04430"\w* \w -|strong="H00560"\w* \w -|strong="H06032"\w* \w vvv|strong="H01841"\w*, “\w O Daniel|strong="H01841"\w*, \w servant|strong="H05649"\w* \w of the living|strong="H02417"\w* \w God|strong="H00426"\w*, \w has your God|strong="H00426"\w*, \w whom|strong="H01768"\w* \w you|strong="H00607"\w* \w serve|strong="H06399"\w* \w continually|strong="H08411"\w*, \w been able|strong="H03202"\w* \w to deliver you|strong="H07804"\w* \w from|strong="H04481"\w* \w the lions|strong="H00744"\w*?”
\p \v 21 \w Then|strong="H00116"\w* \w Daniel|strong="H01841"\w* \w replied|strong="H04449"\w* \w -|strong="H05974"\w* \w -|strong="H04430"\w*, “\w O king|strong="H04430"\w*, \w may you live|strong="H02418"\w* \w forever|strong="H05957"\w*! \v 22 \w My God|strong="H00426"\w* \w sent|strong="H07972"\w* \w His angel|strong="H04398"\w* \w and shut|strong="H05463"\w* \w the mouths|strong="H06433"\w* \w of the lions|strong="H00744"\w*. \w They have not|strong="H03809"\w* \w hurt me|strong="H02255"\w*, \w . . .|strong="H03606"\w* \w for|strong="H06903"\w* \w . . .|strong="H01768"\w* \w I was found|strong="H07912"\w* \w innocent|strong="H02136"\w* \w in His sight|strong="H06925"\w*, \w and|strong="H00638"\w* \w I have done|strong="H05648"\w* \w no|strong="H03809"\w* \w wrong|strong="H02248"\w* \w against you|strong="H06925"\w*, \w O king|strong="H04430"\w*.”
