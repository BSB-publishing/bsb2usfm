\s1 Daniel Interprets the Dream
\p \v 24 \w -|strong="H03606"\w* \w Therefore|strong="H06903"\w* \w . . .|strong="H01836"\w* \w Daniel|strong="H01841"\w* \w went|strong="H05954"\w* \w to|strong="H05922"\w* \w Arioch|strong="H00746"\w*, \w whom|strong="H01768"\w* \w the king|strong="H04430"\w* \w had appointed|strong="H04483"\w* \w to destroy|strong="H00007"\w* \w the wise men|strong="H02445"\w* \w of Babylon|strong="H00895"\w*, \w vvv|strong="H00236"\w* \w vvv|strong="H03652"\w* \w and said|strong="H00560"\w* to him, “\w Do not|strong="H00409"\w* \w execute|strong="H00007"\w* \w the wise men|strong="H02445"\w* \w of Babylon|strong="H00895"\w*! \w Bring me|strong="H05954"\w* \w before|strong="H06925"\w* \w the king|strong="H04430"\w*, \w and I will give|strong="H02324"\w* \w him|strong="H04430"\w* \w the interpretation|strong="H06591"\w*.”
\p \v 25 \w Arioch|strong="H00746"\w* \w hastily|strong="H00927"\w* \w . . .|strong="H00116"\w* \w brought|strong="H05954"\w* \w Daniel|strong="H01841"\w* \w before|strong="H06925"\w* \w the king|strong="H04430"\w* \w . . .|strong="H03652"\w* \w and said|strong="H00560"\w* to him, “\w I have found|strong="H07912"\w* \w a man|strong="H01400"\w* \w among|strong="H04481"\w* \w -|strong="H01768"\w* \w the exiles|strong="H01123"\w* \w . . .|strong="H01547"\w*\w . . .|strong="H01768"\w* \w from Judah|strong="H03061"\w* \w who|strong="H01768"\w* \w will tell|strong="H03046"\w* \w the king|strong="H04430"\w* \w the interpretation|strong="H06591"\w*.”
\p \v 26 \w The king|strong="H04430"\w* \w responded|strong="H06032"\w* \w . . .|strong="H00560"\w* \w to Daniel|strong="H01841"\w*, \w whose|strong="H01768"\w* \w name|strong="H08036"\w* \w was Belteshazzar|strong="H01096"\w*, \w . . .|strong="H00383"\w* “\w Are you able|strong="H03546"\w* \w to tell me|strong="H03046"\w* \w what|strong="H01768"\w* \w I saw|strong="H02370"\w* \w in the dream|strong="H02493"\w*, \w as well as its interpretation|strong="H06591"\w*?”
\p \v 27 \w Daniel|strong="H01841"\w* \w . . .|strong="H06925"\w* \w answered|strong="H06032"\w* \w the king|strong="H04430"\w* \w . . .|strong="H00560"\w*, “\w No|strong="H03809"\w* \w wise man|strong="H02445"\w*, \w enchanter|strong="H00826"\w*, \w medium|strong="H02749"\w*, \w or magician|strong="H01505"\w* \w can|strong="H03202"\w* \w explain|strong="H02324"\w* \w to the king|strong="H04430"\w* \w the mystery|strong="H07328"\w* \w of which|strong="H01768"\w* \w [he]|strong="H04430"\w* \w inquires|strong="H07593"\w*. \v 28 \w But|strong="H01297"\w* \w there is|strong="H00383"\w* \w a God|strong="H00426"\w* \w in heaven|strong="H08065"\w* \w who reveals|strong="H01541"\w* \w mysteries|strong="H07328"\w*, \w and He has made known|strong="H03046"\w* \w to King|strong="H04430"\w* \w Nebuchadnezzar|strong="H05020"\w* \w what|strong="H04101"\w* \w . . .|strong="H01768"\w* \w will happen|strong="H01934"\w* \w in the latter|strong="H00320"\w* \w days|strong="H03118"\w*. \w Your dream|strong="H02493"\w* \w and the visions|strong="H02376"\w* \w that came into your mind|strong="H07217"\w* \w as you lay on|strong="H05922"\w* \w your bed|strong="H04903"\w* \w were these|strong="H01836"\w* \w . . .|strong="H01932"\w*:
\p \v 29 \w As you|strong="H00607"\w* \w lay on|strong="H05922"\w* \w your bed|strong="H04903"\w*, \w O king|strong="H04430"\w*, \w your thoughts|strong="H07476"\w* \w turned|strong="H05559"\w* \w to|strong="H04101"\w* \w . . .|strong="H01768"\w* \w vvv|strong="H01934"\w* \w the future|strong="H00311"\w* \w . . .|strong="H01836"\w*, \w and the Revealer|strong="H01541"\w* \w of Mysteries|strong="H07328"\w* \w made known to you|strong="H03046"\w* \w what|strong="H04101"\w* \w . . .|strong="H01768"\w* \w will happen|strong="H01934"\w*. \v 30 \w And to me|strong="H00576"\w* \w this|strong="H01836"\w* \w mystery|strong="H07328"\w* \w has been revealed|strong="H01541"\w*, \w not|strong="H03809"\w* \w because|strong="H01768"\w* \w I have|strong="H00383"\w* \w more wisdom|strong="H02452"\w* \w than|strong="H04481"\w* \w any man|strong="H03606"\w* \w alive|strong="H02417"\w*, \w but|strong="H03861"\w* \w in order that|strong="H05922"\w* \w . . .|strong="H01701"\w* \w . . .|strong="H01768"\w* \w the interpretation|strong="H06591"\w* \w might be made known|strong="H03046"\w* \w to the king|strong="H04430"\w*, \w and that you may understand|strong="H03046"\w* \w the thoughts|strong="H07476"\w* \w of your mind|strong="H03825"\w*.
\p \v 31 \w As you|strong="H00607"\w*, \w O king|strong="H04430"\w*, \w were watching|strong="H02370"\w*, \w . . .|strong="H01934"\w* \w a|strong="H02298"\w* \w great|strong="H07690"\w* \w statue|strong="H06755"\w*\f + \fr 2:31 \ft Or \fqa image\ft ; here and through the rest of Daniel 2\f* \w appeared|strong="H00431"\w*.\w . . .|strong="H01797"\w* \w A great|strong="H07229"\w* \w and dazzling|strong="H02122"\w* \w statue|strong="H06755"\w* \w . . .|strong="H03493"\w* \w stood|strong="H06966"\w* \w before you|strong="H06903"\w*, \w and its form|strong="H07299"\w* \w [was] awesome|strong="H01763"\w*. \v 32 \w -|strong="H01932"\w* \w The head|strong="H07217"\w* \w . . .|strong="H01768"\w* \w of the statue|strong="H06755"\w* \w was pure|strong="H02869"\w* \w gold|strong="H01722"\w*, \w its chest|strong="H02306"\w* \w and arms|strong="H01872"\w* \w . . .|strong="H01768"\w* \w were silver|strong="H03702"\w*, \w its belly|strong="H04577"\w* \w and thighs|strong="H03410"\w* \w . . .|strong="H01768"\w* \w were bronze|strong="H05174"\w*, \v 33 \w its legs|strong="H08243"\w* \w . . .|strong="H01768"\w* \w were iron|strong="H06523"\w*, \w and its feet|strong="H07271"\w* \w were part|strong="H04481"\w* \w . . .|strong="H01768"\w* \w iron|strong="H06523"\w* \w and part|strong="H04481"\w* \w . . .|strong="H01768"\w* \w clay|strong="H02635"\w*.
\p \v 34 \w As you|strong="H01934"\w* \w -|strong="H05705"\w* \w watched|strong="H02370"\w*,\w . . .|strong="H01768"\w* \w a stone|strong="H00069"\w* \w . . .|strong="H01768"\w* \w was cut out|strong="H01505"\w*,\f + \fr 2:34 \ft LXX \fqa cut out from a mountain\f* \w but not|strong="H03809"\w* \w by human hands|strong="H03028"\w*. \w It struck|strong="H04223"\w* \w the statue|strong="H06755"\w* \w on|strong="H05922"\w* \w its feet|strong="H07271"\w* \w of|strong="H01768"\w* \w iron|strong="H06523"\w* \w and clay|strong="H02635"\w*, \w and crushed|strong="H01855"\w* \w them|strong="H01994"\w*. \v 35 \w Then|strong="H00116"\w* \w the iron|strong="H06523"\w*, \w clay|strong="H02635"\w*, \w bronze|strong="H05174"\w*, \w silver|strong="H03702"\w*, \w and gold|strong="H01722"\w* \w were shattered|strong="H01855"\w* \w . . .|strong="H02298"\w* \w and became|strong="H01934"\w* \w like chaff|strong="H05784"\w* \w on|strong="H04481"\w* \w the threshing floor|strong="H00147"\w* \w in summer|strong="H07007"\w*. \w The wind|strong="H07308"\w* \w carried them|strong="H01994"\w* \w away|strong="H05376"\w*, \w and|strong="H03606"\w* \w not|strong="H03809"\w* \w a trace|strong="H00870"\w* of them \w could be found|strong="H07912"\w*. \w But the stone|strong="H00069"\w* \w that|strong="H01768"\w* \w had struck|strong="H04223"\w* \w the statue|strong="H06755"\w* \w became|strong="H01934"\w* \w a great|strong="H07229"\w* \w mountain|strong="H02906"\w* \w and filled|strong="H04391"\w* \w the whole|strong="H03606"\w* \w earth|strong="H00772"\w*.
\p \v 36 \w This|strong="H01836"\w* \w was the dream|strong="H02493"\w*; \w now we will tell|strong="H00560"\w* \w . . .|strong="H06925"\w* \w the king|strong="H04430"\w* \w its interpretation|strong="H06591"\w*.
\p \v 37 \w You|strong="H00607"\w*, \w O king|strong="H04430"\w*, \w are the king|strong="H04430"\w* \w of kings|strong="H04430"\w*, \w to whom|strong="H01768"\w* \w the God|strong="H00426"\w* \w of heaven|strong="H08065"\w* \w has given|strong="H03052"\w* - \w sovereignty|strong="H04437"\w*, \w power|strong="H02632"\w*, \w strength|strong="H08632"\w*, \w and glory|strong="H03367"\w*. \v 38 \w Wherever|strong="H03606"\w* \w . . .|strong="H01768"\w* \w the sons|strong="H01123"\w* \w of men|strong="H00606"\w* \w or beasts|strong="H02423"\w* \w of the field|strong="H01251"\w* \w or birds|strong="H05776"\w* \w of the air|strong="H08065"\w* \w dwell|strong="H01753"\w*, \w He has given [them]|strong="H03052"\w* \w into your hand|strong="H03028"\w* \w and has made you ruler|strong="H07981"\w* \w over them all|strong="H03606"\w*. \w You [are]|strong="H00607"\w* \w that|strong="H01932"\w* \w head|strong="H07217"\w* \w of|strong="H01768"\w* \w gold|strong="H01722"\w*.
\p \v 39 \w But after you|strong="H00870"\w*, \w there will arise|strong="H06966"\w* \w another|strong="H00317"\w* \w kingdom|strong="H04437"\w*, \w inferior|strong="H00772"\w* \w to yours|strong="H04481"\w*.
\p \w Next, a|strong="H00317"\w* \w third|strong="H08523"\w* \w kingdom|strong="H04437"\w*, \w one of|strong="H01768"\w* \w bronze|strong="H05174"\w*, \w -|strong="H01768"\w* \w will rule|strong="H07981"\w* \w the whole|strong="H03606"\w* \w earth|strong="H00772"\w*.
\p \v 40 \w Finally, there will be|strong="H01934"\w* \w a fourth|strong="H07244"\w* \w kingdom|strong="H04437"\w* \w as strong|strong="H08624"\w* \w as iron|strong="H06523"\w*;\w . . .|strong="H03606"\w* \w for|strong="H06903"\w* \w . . .|strong="H01768"\w* \w iron|strong="H06523"\w* \w shatters|strong="H01855"\w* \w and crushes|strong="H02827"\w* \w all things|strong="H03606"\w*, \w and like iron|strong="H06523"\w* \w that|strong="H01768"\w* \w crushes|strong="H07490"\w* \w all things|strong="H03606"\w*, \w it will shatter|strong="H01855"\w* \w and crush|strong="H07490"\w* \w all the others|strong="H00459"\w*. \v 41 \w And just as|strong="H01768"\w* \w you saw that|strong="H02370"\w* \w the feet|strong="H07271"\w* \w and toes|strong="H00677"\w* \w were made|strong="H04481"\w* \w . . .|strong="H06353"\w* \w partly of|strong="H01768"\w* \w fired clay|strong="H02635"\w* \w and partly of|strong="H04481"\w* \w iron|strong="H06523"\w*, \w so this will be|strong="H01934"\w* \w a divided|strong="H06386"\w* \w kingdom|strong="H04437"\w*, \w yet|strong="H04481"\w* \w some of the strength|strong="H05326"\w* \w of|strong="H01768"\w* \w iron|strong="H06523"\w* \w will be in it|strong="H01934"\w* — \w -|strong="H03606"\w* \w just as|strong="H06903"\w* \w . . .|strong="H01768"\w* \w you saw|strong="H02370"\w* \w the iron|strong="H06523"\w* \w mixed|strong="H06151"\w* \w with clay|strong="H02635"\w* \w . . .|strong="H02917"\w*. \v 42 \w And as the toes|strong="H00677"\w* \w of the feet|strong="H07271"\w* \w were partly|strong="H04481"\w* \w iron|strong="H06523"\w* \w . . .|strong="H04481"\w* \w and partly|strong="H04481"\w* \w clay|strong="H02635"\w*, \w so this kingdom|strong="H04437"\w* \w will be|strong="H01934"\w* \w partly|strong="H07118"\w* \w strong|strong="H08624"\w* \w and partly|strong="H04481"\w* \w -|strong="H01934"\w* \w brittle|strong="H08406"\w*. \v 43 \w As|strong="H01768"\w* \w you saw|strong="H02370"\w* \w the iron|strong="H06523"\w* \w mixed|strong="H06151"\w* \w with clay|strong="H02635"\w* \w . . .|strong="H02917"\w*, \w so the peoples|strong="H02234"\w* \w . . .|strong="H00606"\w*\f + \fr 2:43 \ft Aramaic \fqa the seed of men\f* \w will mix with one another|strong="H06151"\w* \w . . .|strong="H01934"\w* \w but will not|strong="H03809"\w* \w . . .|strong="H01934"\w* \w hold together|strong="H01693"\w* \w . . .|strong="H01836"\w* \w . . .|strong="H05974"\w* \w . . .|strong="H01836"\w* \w any more|strong="H01888"\w* \w than|strong="H01768"\w* \w iron|strong="H06523"\w* \w -|strong="H03809"\w* \w mixes|strong="H06151"\w* \w with|strong="H05974"\w* \w clay|strong="H02635"\w*.
\p \v 44 \w In the days|strong="H03118"\w*\w . . .|strong="H01768"\w* \w of those|strong="H00581"\w* \w kings|strong="H04430"\w*, \w the God|strong="H00426"\w* \w of heaven|strong="H08065"\w* \w will set up|strong="H06966"\w* \w a kingdom|strong="H04437"\w* \w that|strong="H01768"\w* \w will never|strong="H05957"\w* \w . . .|strong="H03809"\w* \w be destroyed|strong="H02255"\w*, \w nor will|strong="H03809"\w* \w [it]|strong="H04437"\w* \w be left|strong="H07662"\w* \w to another|strong="H00321"\w* \w people|strong="H05972"\w*. \w It will shatter|strong="H01855"\w* \w all|strong="H03606"\w* \w these|strong="H00459"\w* \w kingdoms|strong="H04437"\w* \w . . .|strong="H01932"\w* \w and bring them to an end|strong="H05487"\w*, \w but will itself stand|strong="H06966"\w* \w forever|strong="H05957"\w*. \v 45 \w And just as|strong="H03606"\w* \w . . .|strong="H06903"\w* \w . . .|strong="H01768"\w* \w you saw|strong="H02370"\w* \w . . .|strong="H01768"\w* \w a stone|strong="H00069"\w* \w . . .|strong="H01768"\w* \w being cut out|strong="H01505"\w* \w of the mountain|strong="H02906"\w* \w without|strong="H03809"\w* \w human hands|strong="H03028"\w*, \w and it shattered|strong="H01855"\w* \w the iron|strong="H06523"\w*, \w bronze|strong="H05174"\w*, \w clay|strong="H02635"\w*, \w silver|strong="H03702"\w*, \w and gold|strong="H01722"\w*, \w so the great|strong="H07229"\w* \w God|strong="H00426"\w* \w has told|strong="H03046"\w* \w the king|strong="H04430"\w* \w what|strong="H04101"\w* \w . . .|strong="H01768"\w* \w will happen|strong="H01934"\w* \w in the future|strong="H00311"\w* \w . . .|strong="H01836"\w*.
\p \w The dream|strong="H02493"\w* \w is true|strong="H03330"\w*, \w and its interpretation|strong="H06591"\w* \w is trustworthy|strong="H00540"\w*.”
\s1 Nebuchadnezzar Promotes Daniel
\p \v 46 \w At this|strong="H00116"\w*, \w King|strong="H04430"\w* \w Nebuchadnezzar|strong="H05020"\w* \w fell|strong="H05308"\w* \w on|strong="H05922"\w* \w his face|strong="H00600"\w*, \w paid homage|strong="H05457"\w* \w to Daniel|strong="H01841"\w*, \w and ordered|strong="H00560"\w* \w that an offering|strong="H04504"\w* \w and incense|strong="H05208"\w* \w be presented|strong="H05260"\w* to him. \v 47 \w The king|strong="H04430"\w* \w said|strong="H06032"\w* \w to Daniel|strong="H01841"\w*, \w . . .|strong="H00560"\w*\w . . .|strong="H01768"\w* “\w Your God|strong="H00426"\w* \w . . .|strong="H01932"\w* \w is truly|strong="H04481"\w* \w . . .|strong="H07187"\w* \w the God|strong="H00426"\w* \w of gods|strong="H00426"\w* \w and Lord|strong="H04756"\w* \w of kings|strong="H04430"\w*, \w the Revealer|strong="H01541"\w* \w of Mysteries|strong="H07328"\w*, \w since|strong="H01768"\w* \w you were able|strong="H03202"\w* \w to reveal|strong="H01541"\w* \w this|strong="H01836"\w* \w mystery|strong="H07328"\w*.”
