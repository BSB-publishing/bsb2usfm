\p \v 7 \w vvv|strong="H03606"\w* \w vvv|strong="H06903"\w* \w Therefore|strong="H01836"\w*, \w vvv|strong="H02166"\w* \w as soon as|strong="H01768"\w* \w all|strong="H03606"\w* \w the people|strong="H05972"\w* \w heard|strong="H08086"\w* \w the sound|strong="H07032"\w* \w of the horn|strong="H07162"\w*, \w flute|strong="H04953"\w*, \w zither|strong="H07030"\w*, \w lyre|strong="H05443"\w*, \w harp|strong="H06460"\w*, \w and all|strong="H03606"\w* \w kinds|strong="H02178"\w* \w of music|strong="H02170"\w*, \w the people|strong="H05972"\w* \w of every|strong="H03606"\w* \w nation|strong="H00524"\w* \w and language|strong="H03961"\w* \w would fall down|strong="H05308"\w* \w and worship|strong="H05457"\w* \w the golden|strong="H01722"\w* \w statue|strong="H06755"\w* \w that|strong="H01768"\w* \w King|strong="H04430"\w* \w Nebuchadnezzar|strong="H05020"\w* \w had set up|strong="H06966"\w*.
