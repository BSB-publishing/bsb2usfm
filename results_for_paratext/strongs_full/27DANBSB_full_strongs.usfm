\p \v 22 \w -|strong="H03606"\w* \w -|strong="H06903"\w* \w . . .|strong="H01836"\w* \w -|strong="H04481"\w* \w -|strong="H01768"\w* \w The king’s|strong="H04430"\w* \w command|strong="H04406"\w* \w was so urgent|strong="H02685"\w* \w and the furnace|strong="H00861"\w* \w so|strong="H03493"\w* \w hot|strong="H00228"\w* \w that the fiery|strong="H05135"\w* \w flames|strong="H07631"\w*\w . . .|strong="H01768"\w* \w killed|strong="H06992"\w* \w . . .|strong="H01994"\w* \w the|strong="H00479"\w* \w men|strong="H01400"\w* \w who|strong="H01768"\w* \w carried up|strong="H05559"\w* \w Shadrach|strong="H07715"\w*, \w Meshach|strong="H04336"\w*, \w vvv|strong="H05665"\w* \w and Abednego|strong="H05665"\w*. \v 23 \w And these|strong="H00479"\w* \w three|strong="H08532"\w* \w men|strong="H01400"\w*, \w Shadrach|strong="H07715"\w*, \w Meshach|strong="H04336"\w*, \w vvv|strong="H05665"\w* \w and Abednego|strong="H05665"\w*, \w firmly bound|strong="H03729"\w*, \w fell|strong="H05308"\w* \w into|strong="H01459"\w* \w the blazing|strong="H03345"\w* \w fiery|strong="H05135"\w* \w furnace|strong="H00861"\w*.
