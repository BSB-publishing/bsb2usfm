\p \v 19 \w During|strong="H00116"\w*\w . . .|strong="H01768"\w* \w the night|strong="H03916"\w*, \w the mystery|strong="H07328"\w* \w was revealed|strong="H01541"\w* \w . . .|strong="H00116"\w* \w to Daniel|strong="H01841"\w* \w in a vision|strong="H02376"\w*, \w and [he]|strong="H01841"\w* \w blessed|strong="H01289"\w* \w the God|strong="H00426"\w* \w of heaven|strong="H08065"\w* \v 20 \w -|strong="H06032"\w* \w -|strong="H01841"\w* \w and declared|strong="H00560"\w*:
