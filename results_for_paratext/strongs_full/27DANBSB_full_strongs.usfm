\p \v 28 \w So Daniel|strong="H01841"\w* \w . . .|strong="H01836"\w* \w prospered|strong="H06744"\w* \w during the reign|strong="H04437"\w* \w of Darius|strong="H01868"\w* \w and the reign|strong="H04437"\w* \w of Cyrus|strong="H03567"\w*\f + \fr 6:28 \ft Or \fqa prospered during the reign of Darius, that is, the reign of Cyrus\f* \w the Persian|strong="H06543"\w*.
\c 7
\s1 Daniel’s Vision of the Four Beasts
\p \v 1 \w In the first|strong="H02298"\w* \w year|strong="H08140"\w* \w of the reign|strong="H04430"\w* \w of Belshazzar|strong="H01113"\w* \w over Babylon|strong="H00895"\w*, \w Daniel|strong="H01841"\w* \w had|strong="H02370"\w* \w a dream|strong="H02493"\w*, \w and visions|strong="H02376"\w* \w passed through his mind|strong="H07217"\w* \w as he lay|strong="H05922"\w* \w on his bed|strong="H04903"\w*. \w . . .|strong="H00116"\w* \w He wrote down|strong="H03790"\w* \w the dream|strong="H02493"\w*, \w and this is the summary|strong="H07217"\w* \w of his account|strong="H04406"\w* \w . . .|strong="H00560"\w*.
\p \v 2 \w Daniel|strong="H01841"\w* \w . . .|strong="H00560"\w* \w declared|strong="H06032"\w*: “\w In my vision|strong="H02376"\w* \w in|strong="H05974"\w* \w the night|strong="H03916"\w* \w I|strong="H01934"\w* \w looked|strong="H02370"\w*, \w and suddenly|strong="H00718"\w* \w the four|strong="H00703"\w* \w winds|strong="H07308"\w* \w of heaven|strong="H08065"\w* \w were churning up|strong="H01519"\w* \w the great|strong="H07229"\w* \w sea|strong="H03221"\w*.\f + \fr 7:2 \ft Perhaps \fqa the Great Sea\ft , that is, the Mediterranean Sea\f* \v 3 \w Then four|strong="H00703"\w* \w great|strong="H07260"\w* \w beasts|strong="H02423"\w* \w came up|strong="H05559"\w* \w out of|strong="H04481"\w* \w the sea|strong="H03221"\w*, \w each one|strong="H01668"\w* \w different|strong="H08133"\w* \w from|strong="H04481"\w* \w the others|strong="H01668"\w*:
\b 
\li1 \v 4 \w The first [beast]|strong="H06933"\w* \w was like a lion|strong="H00744"\w*, and it had \w [the] wings|strong="H01611"\w* \w -|strong="H01768"\w* \w of an eagle|strong="H05403"\w*. \w I|strong="H01934"\w* \w watched|strong="H02370"\w* \w until|strong="H05705"\w* \w . . .|strong="H01768"\w* \w its wings|strong="H01611"\w* \w were torn off|strong="H04804"\w* \w and it was lifted up|strong="H05191"\w* \w from|strong="H04481"\w* \w the ground|strong="H00772"\w* \w and made to stand|strong="H06966"\w* \w on|strong="H05922"\w* \w two feet|strong="H07271"\w* \w like a man|strong="H00606"\w* \w and given|strong="H03052"\w* \w the mind|strong="H03825"\w* \w of a man|strong="H00606"\w*.
\li1 \v 5 \w Suddenly|strong="H00718"\w* \w another|strong="H00317"\w* \w beast {appeared}|strong="H02423"\w*, \w which|strong="H08578"\w* \w looked like|strong="H01821"\w* \w a bear|strong="H01678"\w*. \w It was raised up|strong="H06966"\w* \w on one|strong="H02298"\w* \w of its sides|strong="H07859"\w*, \w and it had three|strong="H08532"\w* \w ribs|strong="H05967"\w* \w in its mouth|strong="H06433"\w* \w between|strong="H00997"\w* \w its teeth|strong="H08128"\w*. \w So|strong="H03652"\w* \w it was told|strong="H00560"\w*, ‘\w Get up|strong="H06966"\w* \w [and] gorge yourself|strong="H00399"\w* \w on flesh|strong="H01321"\w* \w . . .|strong="H07690"\w*!’
\li1 \v 6 \w Next|strong="H00870"\w* \w . . .|strong="H01836"\w*, \w as I|strong="H01934"\w* \w watched|strong="H02370"\w*, \w suddenly|strong="H00718"\w* \w another beast {appeared}|strong="H00317"\w*. \w It was like a leopard|strong="H05245"\w*, \w and on|strong="H05922"\w* \w its back|strong="H01355"\w* it had \w four|strong="H00703"\w* \w wings|strong="H01611"\w* \w like those of|strong="H01768"\w* \w a bird|strong="H05776"\w*. \w The beast also|strong="H02423"\w* \w had four|strong="H00703"\w* \w heads|strong="H07217"\w*, \w and it was given|strong="H03052"\w* \w authority to rule|strong="H07985"\w*.
\li1 \v 7 \w After|strong="H00870"\w* \w this|strong="H01836"\w*, \w as I|strong="H01934"\w* \w watched|strong="H02370"\w* \w in my vision|strong="H02376"\w* \w in the night|strong="H03916"\w*, \w suddenly|strong="H00718"\w* \w a fourth|strong="H07244"\w* \w beast {appeared}|strong="H02423"\w*, \w [and it was] terrifying|strong="H01763"\w* — \w dreadful|strong="H00574"\w* \w and extremely|strong="H03493"\w* \w strong|strong="H08624"\w* — with \w large|strong="H07260"\w* \w iron|strong="H06523"\w* \w teeth|strong="H08128"\w*. \w . . .|strong="H01768"\w* \w It devoured|strong="H00399"\w* \w and crushed|strong="H01855"\w*; \w then it trampled|strong="H07512"\w* \w . . .|strong="H01932"\w* \w underfoot|strong="H07271"\w* \w whatever was left|strong="H07606"\w*. \w It was different|strong="H08133"\w* \w from|strong="H04481"\w* \w all|strong="H03606"\w* \w the beasts|strong="H02423"\w* \w . . .|strong="H01768"\w* \w before it|strong="H06925"\w*, \w and it had ten|strong="H06236"\w* \w horns|strong="H07162"\w*. \v 8 \w While I was|strong="H01934"\w* \w contemplating|strong="H07920"\w* \w the horns|strong="H07162"\w*, \w . . .|strong="H00431"\w* \w suddenly another|strong="H00317"\w* \w horn|strong="H07162"\w*, \w a little one|strong="H02192"\w*, \w came up|strong="H05559"\w* \w among them|strong="H00997"\w*, \w and three|strong="H08532"\w* \w of|strong="H04481"\w* \w the first|strong="H06933"\w* \w horns|strong="H07162"\w* \w were uprooted|strong="H06132"\w* \w before|strong="H04481"\w* \w it|strong="H06925"\w*. \w . . .|strong="H00431"\w* \w This|strong="H01668"\w* \w horn|strong="H07162"\w* \w had eyes|strong="H05870"\w* \w like those|strong="H05870"\w* \w of a man|strong="H00606"\w* \w and a mouth|strong="H06433"\w* \w that spoke|strong="H04449"\w* \w words of arrogance|strong="H07260"\w*.
\s1 Daniel’s Vision of the Ancient of Days
\p \v 9 \w As|strong="H05705"\w* \w . . .|strong="H01768"\w* \w I continued|strong="H01934"\w* \w to watch|strong="H02370"\w*,
\b 
\q1 \w thrones|strong="H03764"\w* \w were set in place|strong="H07412"\w*,
\q2 \w and the Ancient|strong="H06268"\w* \w of Days|strong="H03118"\w* \w took His seat|strong="H03488"\w*.
