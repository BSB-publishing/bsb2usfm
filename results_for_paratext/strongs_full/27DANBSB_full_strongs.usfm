\p “\w Certainly|strong="H03330"\w*, \w O king|strong="H04430"\w*,” \w they replied|strong="H06032"\w* \w . . .|strong="H00560"\w*\w . . .|strong="H04430"\w*.
\p \v 25 “\w Look|strong="H01888"\w*!” \w . . .|strong="H06032"\w* \w he exclaimed|strong="H00560"\w*. “\w I|strong="H00576"\w* \w see|strong="H02370"\w* \w four|strong="H00703"\w* \w men|strong="H01400"\w*, \w unbound|strong="H08271"\w* \w and unharmed|strong="H02257"\w* \w . . .|strong="H03809"\w* \w . . .|strong="H00383"\w*, \w walking around|strong="H01981"\w* \w in|strong="H01459"\w* \w the fire|strong="H05135"\w* — \w and the fourth|strong="H07244"\w* \w looks|strong="H07299"\w* \w . . .|strong="H01768"\w* \w like|strong="H01821"\w* \w a son|strong="H01247"\w* \w of the gods|strong="H00426"\w*!\f + \fr 3:25 \ft Or \fqa like the Son of God\f*”
\p \v 26 \w Then|strong="H00116"\w* \w Nebuchadnezzar|strong="H05020"\w* \w approached|strong="H07127"\w* \w the door|strong="H08651"\w* \w of the blazing|strong="H03345"\w* \w fiery|strong="H05135"\w* \w furnace|strong="H00861"\w* \w . . .|strong="H06032"\w* \w and called out|strong="H00560"\w*, “\w Shadrach|strong="H07715"\w*, \w Meshach|strong="H04336"\w*, \w vvv|strong="H05665"\w* \w and Abednego|strong="H05665"\w*, \w servants|strong="H05649"\w* \w . . .|strong="H01768"\w* \w of the Most High|strong="H05943"\w* \w God|strong="H00426"\w*, \w come out|strong="H05312"\w*!” \w . . .|strong="H00858"\w*
\p \w So|strong="H00116"\w* \w Shadrach|strong="H07715"\w*, \w Meshach|strong="H04336"\w*, \w vvv|strong="H05665"\w* \w and Abednego|strong="H05665"\w* \w came out|strong="H05312"\w* \w of|strong="H04481"\w* \w . . .|strong="H01459"\w* \w the fire|strong="H05135"\w*, \v 27 \w and when the satraps|strong="H00324"\w*, \w prefects|strong="H05460"\w*, \w governors|strong="H06347"\w*, \w and royal|strong="H04430"\w* \w advisers|strong="H01907"\w* \w had gathered around|strong="H03673"\w*, \w they saw|strong="H02370"\w* \w that the fire|strong="H05135"\w* \w had no|strong="H03809"\w* \w effect|strong="H07981"\w* \w on the bodies|strong="H01655"\w* \w of these|strong="H00479"\w* \w . . .|strong="H01768"\w* \w men|strong="H01400"\w*. \w Not|strong="H03809"\w* \w a hair|strong="H08177"\w* \w of their heads|strong="H07217"\w* \w was singed|strong="H02761"\w*, \w their robes|strong="H05622"\w* \w were unaffected|strong="H03809"\w* \w . . .|strong="H08133"\w*, \w and there was no|strong="H03809"\w* \w . . .|strong="H05709"\w* \w smell|strong="H07382"\w* \w of fire|strong="H05135"\w* on them.
\p \v 28 \w Nebuchadnezzar|strong="H05020"\w* \w . . .|strong="H00560"\w* \w declared|strong="H06032"\w*, “\w Blessed|strong="H01289"\w* \w be the God|strong="H00426"\w* \w of|strong="H01768"\w* \w Shadrach|strong="H07715"\w*, \w Meshach|strong="H04336"\w*, \w vvv|strong="H05665"\w* \w and Abednego|strong="H05665"\w*, \w who has sent|strong="H07972"\w* \w His angel|strong="H04398"\w*\f + \fr 3:28 \ft Or \fqa Angel\f* \w and delivered|strong="H07804"\w* \w His servants|strong="H05649"\w* \w . . .|strong="H01768"\w* \w who|strong="H01768"\w* \w trusted|strong="H07365"\w* \w in Him|strong="H05922"\w*. \w They violated|strong="H08133"\w* \w . . .|strong="H03052"\w* \w the king’s|strong="H04430"\w* \w command|strong="H04406"\w* \w and risked their lives|strong="H01655"\w* \w . . .|strong="H01768"\w* \w . . .|strong="H03809"\w* \w rather than serve|strong="H06399"\w* \w . . .|strong="H03809"\w* \w or worship|strong="H05457"\w* \w any|strong="H03606"\w* \w god|strong="H00426"\w* \w except|strong="H03861"\w* \w their own God|strong="H00426"\w*. \v 29 Therefore I \w decree|strong="H07761"\w* \w . . .|strong="H02942"\w* \w that|strong="H01768"\w* \w the people|strong="H05972"\w* \w of any|strong="H03606"\w* \w nation|strong="H00524"\w* \w or language|strong="H03961"\w* \w who|strong="H01768"\w* \w say|strong="H00560"\w* \w anything offensive|strong="H07955"\w* \w against|strong="H05922"\w* \w the God|strong="H00426"\w* \w of|strong="H01768"\w* \w Shadrach|strong="H07715"\w*, \w Meshach|strong="H04336"\w*, \w vvv|strong="H05665"\w* \w and Abednego|strong="H05665"\w* \w will be cut|strong="H05648"\w* \w into pieces|strong="H01917"\w* \w and their houses|strong="H01005"\w* \w reduced|strong="H07739"\w* \w . . .|strong="H03606"\w* \w to rubble|strong="H05122"\w*. \w For|strong="H06903"\w* \w . . .|strong="H01768"\w* \w there is|strong="H00383"\w* \w no|strong="H03809"\w* \w other|strong="H00321"\w* \w god|strong="H00426"\w* \w who|strong="H01768"\w* \w can|strong="H03202"\w* \w deliver|strong="H05338"\w* \w in this way|strong="H01836"\w*.”
\p \v 30 \w Then|strong="H00116"\w* \w the king|strong="H04430"\w* \w promoted|strong="H06744"\w* \w Shadrach|strong="H07715"\w*, \w Meshach|strong="H04336"\w*, \w vvv|strong="H05665"\w* \w and Abednego|strong="H05665"\w* \w in the province|strong="H04083"\w* \w of Babylon|strong="H00895"\w*.
\c 4
\s1 Nebuchadnezzar Confesses God’s Kingdom
\p \v 1 \w King|strong="H04430"\w* \w Nebuchadnezzar|strong="H05020"\w*,
\p \w To the people|strong="H05972"\w* \w of every|strong="H03606"\w* \w nation|strong="H00524"\w* \w and language|strong="H03961"\w* \w who|strong="H01768"\w* \w dwell|strong="H01753"\w* \w in all|strong="H03606"\w* \w the earth|strong="H00772"\w*:
\p \w May your prosperity|strong="H08001"\w* \w be multiplied|strong="H07680"\w*. \v 2 \w I am pleased|strong="H08232"\w* \w . . .|strong="H06925"\w* \w to declare|strong="H02324"\w* \w the signs|strong="H00852"\w* \w and wonders|strong="H08540"\w* \w that|strong="H01768"\w* \w the Most High|strong="H05943"\w* \w God|strong="H00426"\w* \w has performed|strong="H05648"\w* \w for me|strong="H05974"\w*.
\b 
\q1 \v 3 \w How|strong="H04101"\w* \w great|strong="H07260"\w* \w [are] His signs|strong="H00852"\w*,
\q2 \w how|strong="H04101"\w* \w mighty|strong="H08624"\w* \w His wonders|strong="H08540"\w*!
\q1 \w His kingdom|strong="H04437"\w* \w is an eternal|strong="H05957"\w* \w kingdom|strong="H04437"\w*;
\q2 \w His dominion endures|strong="H07985"\w* \w from|strong="H05974"\w* \w generation|strong="H01859"\w* \w to generation|strong="H01859"\w*.
\s1 Nebuchadnezzar’s Dream of a Great Tree
\p \v 4 \w I|strong="H00576"\w*, \w Nebuchadnezzar|strong="H05020"\w*, \w was|strong="H01934"\w* \w at ease|strong="H07954"\w* \w in my house|strong="H01005"\w* \w and flourishing|strong="H07487"\w* \w in my palace|strong="H01965"\w*. \v 5 \w I had|strong="H02370"\w* \w a dream|strong="H02493"\w*, \w and it frightened me|strong="H01763"\w*; \w while [I was] in|strong="H05922"\w* \w my bed|strong="H04903"\w*, \w the images|strong="H02031"\w* \w and visions|strong="H02376"\w* \w in my mind|strong="H07217"\w* \w alarmed me|strong="H00927"\w*. \v 6 \w So|strong="H04481"\w* \w I issued|strong="H07761"\w* \w a decree|strong="H02942"\w* \w that all|strong="H03606"\w* \w the wise men|strong="H02445"\w* \w of Babylon|strong="H00895"\w* \w be brought|strong="H05954"\w* \w before me|strong="H06925"\w* \w to|strong="H01768"\w* \w interpret|strong="H06591"\w* \w the dream|strong="H02493"\w* \w for me|strong="H03046"\w*. \v 7 \w When|strong="H00116"\w* \w the magicians|strong="H02749"\w*, \w enchanters|strong="H00826"\w*, \w astrologers|strong="H03779"\w*,\f + \fr 4:7 \ft Or \fqa Chaldeans\f* \w and diviners|strong="H01505"\w* \w came in|strong="H05954"\w*, \w I|strong="H00576"\w* \w . . .|strong="H06925"\w* \w told them|strong="H00560"\w* \w the dream|strong="H02493"\w*, \w but they could not|strong="H03809"\w* \w interpret it|strong="H06591"\w*\w . . .|strong="H03046"\w* for me.
\p \v 8 \w But at|strong="H05705"\w* \w last|strong="H00318"\w*, \w into my presence|strong="H06925"\w* \w came|strong="H05954"\w* \w Daniel|strong="H01841"\w* (\w whose|strong="H01768"\w* \w name is|strong="H08036"\w* \w Belteshazzar|strong="H01096"\w* \w after the name|strong="H08036"\w* \w of my god|strong="H00426"\w*, \w and in whom|strong="H01768"\w* \w [is] the spirit|strong="H07308"\w* \w of the holy|strong="H06922"\w* \w gods|strong="H00426"\w* -). \w And I told him|strong="H00560"\w* \w the dream|strong="H02493"\w* \w . . .|strong="H06925"\w*: \v 9 “\w O Belteshazzar|strong="H01096"\w*, \w chief|strong="H07229"\w* \w of the magicians|strong="H02749"\w*, \w -|strong="H01768"\w* \w I|strong="H00576"\w* \w know|strong="H03046"\w* \w that|strong="H01768"\w* \w the spirit|strong="H07308"\w* \w of the holy|strong="H06922"\w* \w gods|strong="H00426"\w* [is] in you \w and that|strong="H03606"\w* \w no|strong="H03809"\w* \w mystery|strong="H07328"\w* \w baffles|strong="H00598"\w* you. \w [So] explain to me|strong="H00560"\w* \w the visions|strong="H02376"\w* \w -|strong="H01768"\w* \w I saw|strong="H02370"\w* \w in my dream|strong="H02493"\w*, \w and their interpretation|strong="H06591"\w*. \v 10 \w In these visions|strong="H02376"\w* \w of my mind|strong="H07217"\w* \w as I was lying|strong="H05922"\w* \w in bed|strong="H04903"\w*, \w I saw this|strong="H02370"\w* \w come to pass|strong="H01934"\w*:
\b 
\q1 \w There was|strong="H00431"\w* \w a tree|strong="H00363"\w* \w in the midst|strong="H01459"\w* \w of the land|strong="H00772"\w*,
\q2 \w and its height|strong="H07314"\w* \w was great|strong="H07690"\w*.
\q1 \v 11 \w The tree|strong="H00363"\w* \w grew large|strong="H07236"\w* \w and strong|strong="H08631"\w*;
\q2 \w its top|strong="H07314"\w* \w reached|strong="H04291"\w* \w the sky|strong="H08065"\w*,
\q1 \w and it was visible|strong="H02379"\w*
\q2 \w to the ends|strong="H05491"\w* \w . . .|strong="H03606"\w* \w of the earth|strong="H00772"\w*.
\q1 \v 12 \w Its leaves|strong="H06074"\w* \w were beautiful|strong="H08209"\w*,
\q2 \w its fruit|strong="H00004"\w* \w was abundant|strong="H07690"\w*,
\q2 and upon it \w was food|strong="H04203"\w* \w for all|strong="H03606"\w*.
\q1 \w Under it|strong="H08460"\w* \w the beasts|strong="H02423"\w* \w of the field|strong="H01251"\w* \w found shelter|strong="H02927"\w*,
\q2 \w in its branches|strong="H06056"\w* \w the birds|strong="H06853"\w* \w of the air|strong="H08065"\w* \w nested|strong="H01753"\w*,
\q2 \w and from it|strong="H04481"\w* \w every|strong="H03606"\w* \w creature|strong="H01321"\w* \w was fed|strong="H02110"\w*.
\p \v 13 \w As I lay|strong="H05922"\w* \w on my bed|strong="H04903"\w*, \w . . .|strong="H00431"\w* \w I also saw|strong="H02370"\w* \w . . .|strong="H01934"\w* \w in the visions|strong="H02376"\w* \w of my mind|strong="H07217"\w* \w a watcher|strong="H05894"\w*,\f + \fr 4:13 \ft Or \fqa an angelic watcher \ft or \fqa a messenger\ft ; also in verses 17 and 23\f* \w a holy one|strong="H06922"\w*, \w coming down|strong="H05182"\w* \w from|strong="H04481"\w* \w heaven|strong="H08065"\w*. \v 14 \w He called out|strong="H07123"\w* \w in a loud voice|strong="H02429"\w* \w . . .|strong="H03652"\w* \w . . .|strong="H00560"\w*:
\b 
\q1 ‘\w Cut down|strong="H01414"\w* \w the tree|strong="H00363"\w* \w and chop off|strong="H07113"\w* \w its branches|strong="H06056"\w*;
\q2 \w strip off|strong="H05426"\w* \w its leaves|strong="H06074"\w* \w and scatter|strong="H00921"\w* \w its fruit|strong="H00004"\w*.
\q1 \w Let the beasts|strong="H02423"\w* \w flee|strong="H05111"\w* \w from|strong="H04481"\w* \w under it|strong="H08460"\w*,
\q2 \w and the birds|strong="H06853"\w* \w from|strong="H04481"\w* \w its branches|strong="H06056"\w*.
\q1 \v 15 \w But|strong="H01297"\w* \w leave|strong="H07662"\w* \w the stump|strong="H06136"\w* \w with its roots|strong="H08330"\w* \w in the ground|strong="H00772"\w*,
