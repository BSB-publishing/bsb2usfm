\q2 \w in the tender grass|strong="H01883"\w* \w of|strong="H01768"\w* \w the field|strong="H01251"\w*.
\b 
\q1 \w Let him be drenched|strong="H06647"\w* \w with the dew|strong="H02920"\w* \w of heaven|strong="H08065"\w*
\q2 \w and graze|strong="H02508"\w* \w with|strong="H05974"\w* \w the beasts|strong="H02423"\w* \w on the grass|strong="H06211"\w* \w of the earth|strong="H00772"\w*.
\q1 \v 16 \w Let his mind|strong="H03825"\w* \w be changed|strong="H08133"\w* \w from|strong="H04481"\w* \w that of a man|strong="H00606"\w*,
\q2 \w and let him be given|strong="H03052"\w* \w the mind|strong="H03825"\w* \w of a beast|strong="H02423"\w*
\q2 \w till seven|strong="H07655"\w* \w times|strong="H05732"\w* \w pass him|strong="H02499"\w* \w by|strong="H05922"\w*.
\q1 \v 17 \w This decision|strong="H06600"\w* \w is the decree|strong="H01510"\w* \w of the watchers|strong="H05894"\w*,
\q2 \w the verdict|strong="H07595"\w* \w declared|strong="H03983"\w* \w by the holy ones|strong="H06922"\w*,
\q2 \w so that|strong="H05705"\w* \w . . .|strong="H01701"\w* \w . . .|strong="H01768"\w* \w the living|strong="H02417"\w* \w will know|strong="H03046"\w*
\q1 \w that|strong="H01768"\w* \w the Most High|strong="H05943"\w* \w rules|strong="H07990"\w* \w over the kingdom|strong="H04437"\w* \w of mankind|strong="H00606"\w*
\q2 \w and gives it|strong="H05415"\w* \w to whom|strong="H04479"\w* \w . . .|strong="H01768"\w* \w He wishes|strong="H06634"\w*,
\q2 \w setting|strong="H06966"\w* \w over it|strong="H05922"\w* \w the lowliest|strong="H08215"\w* \w of men|strong="H00606"\w*.’
\p \v 18 \w This|strong="H01836"\w* \w is the dream|strong="H02493"\w* \w that I|strong="H00576"\w*, \w King|strong="H04430"\w* \w Nebuchadnezzar|strong="H05020"\w*, \w saw|strong="H02370"\w*. \w Now|strong="H00607"\w*, \w Belteshazzar|strong="H01096"\w*, \w tell me|strong="H00560"\w* \w the interpretation|strong="H06591"\w*, \w because|strong="H06903"\w* \w . . .|strong="H01768"\w*\w . . .|strong="H03606"\w*\w . . .|strong="H03606"\w* \w none|strong="H03809"\w* \w of the wise men|strong="H02445"\w* \w of my kingdom|strong="H04437"\w* \w can|strong="H03202"\w* \w interpret it|strong="H06591"\w* \w for me|strong="H03046"\w*. \w But you|strong="H00607"\w* \w [are] able|strong="H03546"\w*, \w because|strong="H01768"\w* \w the spirit|strong="H07308"\w* \w of the holy|strong="H06922"\w* \w gods|strong="H00426"\w* [is] in you.”
\s1 Daniel Interprets the Second Dream
\p \v 19 \w For|strong="H00116"\w* \w a|strong="H02298"\w* \w time|strong="H08160"\w*, \w Daniel|strong="H01841"\w*, \w who|strong="H01768"\w* \w was also known as|strong="H08036"\w* \w Belteshazzar|strong="H01096"\w*, \w was perplexed|strong="H08075"\w*, \w and his thoughts|strong="H07476"\w* \w alarmed him|strong="H00927"\w*.
\p \w So the king|strong="H04430"\w* \w . . .|strong="H00560"\w* \w said|strong="H06032"\w*, “\w Belteshazzar|strong="H01096"\w*, \w do not|strong="H00409"\w* \w let the dream|strong="H02493"\w* \w or its interpretation|strong="H06591"\w* \w alarm you|strong="H00927"\w*.”
\p “\w My lord|strong="H04756"\w*,” \w . . .|strong="H00560"\w* \w replied|strong="H06032"\w* \w Belteshazzar|strong="H01096"\w*, “\w may the dream|strong="H02493"\w* \w apply to those who hate you|strong="H08131"\w*, \w and its interpretation|strong="H06591"\w* \w to your enemies|strong="H06146"\w*!
\p \v 20 \w The tree|strong="H00363"\w*\w . . .|strong="H01768"\w* \w you saw|strong="H02370"\w* \w that|strong="H01768"\w* \w grew large|strong="H07236"\w* \w and strong|strong="H08631"\w*, \w whose top|strong="H07314"\w* \w reached|strong="H04291"\w* \w the sky|strong="H08065"\w* \w and was visible|strong="H02379"\w* \w to all|strong="H03606"\w* \w the earth|strong="H00772"\w*, \v 21 \w whose foliage|strong="H06074"\w* \w was beautiful|strong="H08209"\w* \w and whose fruit|strong="H00004"\w* \w [was] abundant|strong="H07690"\w*, \w providing food|strong="H04203"\w* \w for all|strong="H03606"\w*, \w under which|strong="H08460"\w* \w the beasts|strong="H02423"\w* \w of the field|strong="H01251"\w* \w lived|strong="H01753"\w*, \w and in whose branches|strong="H06056"\w* \w the birds|strong="H06853"\w* \w of the air|strong="H08065"\w* \w nested|strong="H07932"\w*— \v 22 \w you|strong="H00607"\w*, \w O king|strong="H04430"\w*, \w are [that tree]|strong="H01932"\w*! \w . . .|strong="H01768"\w* \w For you have become great|strong="H07236"\w* \w and strong|strong="H08631"\w*; \w your greatness|strong="H07238"\w* \w has grown|strong="H07236"\w* \w to reach|strong="H04291"\w* \w the sky|strong="H08065"\w*, \w and your dominion|strong="H07985"\w* \w extends to the ends|strong="H05491"\w* \w of the earth|strong="H00772"\w*.
\p \v 23 \w And|strong="H01768"\w* \w you, O king|strong="H04430"\w*, \w saw|strong="H02370"\w* \w a watcher|strong="H05894"\w*, \w a holy one|strong="H06922"\w*, \w coming down|strong="H05182"\w* \w from|strong="H04481"\w* \w heaven|strong="H08065"\w* \w and saying|strong="H00560"\w*:
\b 
\q1 ‘\w Cut down|strong="H01414"\w* \w the tree|strong="H00363"\w* \w and destroy it|strong="H02255"\w*,
\q2 \w but|strong="H01297"\w* \w leave|strong="H07662"\w* \w the stump|strong="H06136"\w* \w with its roots|strong="H08330"\w* \w in the ground|strong="H00772"\w*,
\q1 \w with a band|strong="H00613"\w* \w of|strong="H01768"\w* \w iron|strong="H06523"\w* \w and bronze [around it]|strong="H05174"\w*,
\q2 \w in the tender grass|strong="H01883"\w* \w of|strong="H01768"\w* \w the field|strong="H01251"\w*.
\b 
\q1 \w Let him be drenched|strong="H06647"\w* \w with the dew|strong="H02920"\w* \w of heaven|strong="H08065"\w*,
\q2 \w and graze|strong="H02508"\w* \w with|strong="H05974"\w* \w the beasts|strong="H02423"\w* \w of the field|strong="H01251"\w*
\q2 \w till|strong="H05705"\w* \w . . .|strong="H01768"\w* \w seven|strong="H07655"\w* \w times|strong="H05732"\w* \w pass him|strong="H02499"\w* \w by|strong="H05922"\w*.’
\p \v 24 \w This|strong="H01836"\w* \w is the interpretation|strong="H06591"\w*, \w O king|strong="H04430"\w*, \w and this is the decree|strong="H01510"\w* \w that the Most High|strong="H05943"\w* \w . . .|strong="H01932"\w* \w -|strong="H01768"\w* \w has issued|strong="H04291"\w* \w against|strong="H05922"\w* \w my lord|strong="H04756"\w* \w the king|strong="H04430"\w*:
\p \v 25 \w You will be driven away|strong="H02957"\w* \w from|strong="H04481"\w* \w mankind|strong="H00606"\w*, \w and your dwelling|strong="H04070"\w* \w will be|strong="H01934"\w* \w with|strong="H05974"\w* \w the beasts|strong="H02423"\w* \w of the field|strong="H01251"\w*. \w You will feed on|strong="H02939"\w* \w grass|strong="H06211"\w* \w like an ox|strong="H08450"\w* \w and be drenched|strong="H06647"\w* \w with the dew|strong="H02920"\w* \w of heaven|strong="H08065"\w*, \w and seven|strong="H07655"\w* \w times|strong="H05732"\w* \w shall pass|strong="H02499"\w* \w you by|strong="H05922"\w*, \w until|strong="H05705"\w* \w . . .|strong="H01768"\w* \w you acknowledge|strong="H03046"\w* \w that|strong="H01768"\w* \w the Most High|strong="H05943"\w* \w rules|strong="H07990"\w* \w over the kingdom|strong="H04437"\w* \w of mankind|strong="H00606"\w* \w and gives it|strong="H05415"\w* \w to whom|strong="H04479"\w* \w . . .|strong="H01768"\w* \w He wishes|strong="H06634"\w*.
\p \v 26 \w As for|strong="H01768"\w* \w the command|strong="H00560"\w* \w to leave|strong="H07662"\w* \w the stump|strong="H06136"\w* \w of|strong="H01768"\w* \w the tree|strong="H00363"\w* \w with its roots|strong="H08330"\w*, \w your kingdom|strong="H04437"\w* \w will be restored|strong="H07011"\w* \w to you|strong="H04481"\w* \w as soon as|strong="H01768"\w* \w you acknowledge|strong="H03046"\w* \w that|strong="H01768"\w* \w Heaven|strong="H08065"\w* \w rules|strong="H07990"\w*. \v 27 \w Therefore|strong="H02006"\w*, \w may my advice|strong="H04431"\w* \w be pleasing|strong="H08232"\w* \w to you|strong="H05922"\w*, \w O king|strong="H04430"\w*. \w Break away|strong="H06562"\w* \w from your sins|strong="H02408"\w* \w by doing what is right|strong="H06665"\w*, \w and from your iniquities|strong="H05758"\w* \w by showing mercy|strong="H02604"\w* \w to the oppressed|strong="H06033"\w*. \w Perhaps|strong="H02006"\w* \w there will be|strong="H01934"\w* \w an extension|strong="H00754"\w* \w of your prosperity|strong="H07963"\w*.”
\s1 The Second Dream Fulfilled
\p \v 28 \w All|strong="H03606"\w* \w this happened|strong="H04291"\w* \w to|strong="H05922"\w* \w King|strong="H04430"\w* \w Nebuchadnezzar|strong="H05020"\w*. \v 29 \w Twelve|strong="H08648"\w* \w . . .|strong="H06236"\w* \w months|strong="H03393"\w* \w later|strong="H07118"\w*, \w as he was|strong="H01934"\w* \w walking|strong="H01981"\w* \w on|strong="H05922"\w* \w the roof of the royal palace|strong="H01965"\w* \w . . .|strong="H04437"\w* \w of|strong="H01768"\w* \w Babylon|strong="H00895"\w*, \v 30 \w the king|strong="H04430"\w* \w . . .|strong="H00560"\w* \w exclaimed|strong="H06032"\w*, “\w Is this|strong="H01668"\w* \w . . .|strong="H01932"\w* \w not|strong="H03809"\w* \w Babylon|strong="H00895"\w* \w the Great|strong="H07229"\w*, \w which|strong="H01768"\w* \w I myself|strong="H00576"\w* \w have built|strong="H01124"\w* \w as a royal|strong="H04437"\w* \w residence|strong="H01005"\w* \w by the might|strong="H08632"\w* \w of my power|strong="H02632"\w* \w and for the glory|strong="H03367"\w* \w of my majesty|strong="H01923"\w*?”
\p \v 31 \w While the words|strong="H04406"\w* \w were still|strong="H05751"\w* \w in the king’s|strong="H04430"\w* \w mouth|strong="H06433"\w*, \w a voice|strong="H07032"\w* \w came|strong="H05308"\w* \w from|strong="H04481"\w* \w heaven|strong="H08065"\w*: “\w It is decreed|strong="H00560"\w* to you, \w King|strong="H04430"\w* \w Nebuchadnezzar|strong="H05020"\w*, \w that the kingdom|strong="H04437"\w* \w has departed|strong="H05709"\w* \w from you|strong="H04481"\w*. \v 32 \w You will be driven away|strong="H02957"\w* \w from|strong="H04481"\w* \w mankind|strong="H00606"\w* \w to live|strong="H04070"\w* \w with|strong="H05974"\w* \w the beasts|strong="H02423"\w* \w of the field|strong="H01251"\w*, \w and you will feed on|strong="H02939"\w* \w grass|strong="H06211"\w* \w like an ox|strong="H08450"\w*. \w And seven|strong="H07655"\w* \w times|strong="H05732"\w* \w will pass|strong="H02499"\w* \w you by|strong="H05922"\w*, \w until|strong="H05705"\w* \w . . .|strong="H01768"\w* \w you acknowledge|strong="H03046"\w* \w that|strong="H01768"\w* \w the Most High|strong="H05943"\w* \w rules|strong="H07990"\w* \w over the kingdom|strong="H04437"\w* \w of mankind|strong="H00606"\w* \w and gives it|strong="H05415"\w* \w to whom|strong="H04479"\w* \w . . .|strong="H01768"\w* \w He wishes|strong="H06634"\w*.”
\p \v 33 At that \w moment|strong="H08160"\w* \w the sentence|strong="H04406"\w* \w against|strong="H05922"\w* \w Nebuchadnezzar|strong="H05020"\w* \w was fulfilled|strong="H05487"\w*. \w He was driven away|strong="H02957"\w* \w from|strong="H04481"\w* \w mankind|strong="H00606"\w*. \w He ate|strong="H00399"\w* \w grass|strong="H06211"\w* \w like an ox|strong="H08450"\w*, \w and his body|strong="H01655"\w* \w was drenched|strong="H06647"\w* \w with the dew|strong="H02920"\w* \w of heaven|strong="H08065"\w*, \w until|strong="H05705"\w* \w . . .|strong="H01768"\w* \w his hair|strong="H08177"\w* \w grew|strong="H07236"\w* \w like [the feathers of] an eagle|strong="H05403"\w* \w and his nails|strong="H02953"\w* \w like [the claws of] a bird|strong="H06853"\w*.
\s1 Nebuchadnezzar Restored
\p \v 34 \w But at the end|strong="H07118"\w* \w of those days|strong="H03118"\w* \w I|strong="H00576"\w*, \w Nebuchadnezzar|strong="H05020"\w*, \w looked up|strong="H05870"\w* \w . . .|strong="H05191"\w* \w to heaven|strong="H08065"\w*, \w and my sanity|strong="H04486"\w* \w was restored|strong="H08421"\w* \w to me|strong="H05922"\w*. \w Then I praised|strong="H01289"\w* \w the Most High|strong="H05943"\w*, \w and I honored|strong="H07624"\w* \w and glorified|strong="H01922"\w* \w . . .|strong="H01768"\w* \w Him who lives|strong="H02417"\w* \w forever|strong="H05957"\w*:
\b 
\q1 “\w For His dominion|strong="H07985"\w* \w is an everlasting|strong="H05957"\w* \w dominion|strong="H07985"\w*,
\q2 \w and His kingdom|strong="H04437"\w* \w endures from|strong="H05974"\w* \w generation|strong="H01859"\w* \w to generation|strong="H01859"\w*.
\q1 \v 35 \w All|strong="H03606"\w* \w the peoples|strong="H01753"\w* \w of the earth|strong="H00772"\w*
\q2 \w are counted|strong="H02804"\w* \w as nothing|strong="H03809"\w*,
\q1 \w and He does|strong="H05648"\w* \w as He pleases|strong="H06634"\w*
\q2 \w with the army|strong="H02429"\w* \w of heaven|strong="H08065"\w*
\q2 \w and the peoples|strong="H01753"\w* \w of the earth|strong="H00772"\w*.
\q1 \w There is|strong="H00383"\w* \w no|strong="H03809"\w* \w one who|strong="H01768"\w* \w can restrain|strong="H04223"\w* \w His hand|strong="H03028"\w*
\q2 \w or say|strong="H00560"\w* to Him, ‘\w What|strong="H04101"\w* \w have You done|strong="H05648"\w*?’”
\p \v 36 At \w the same time|strong="H02166"\w* \w my sanity|strong="H04486"\w* \w was restored|strong="H08421"\w* \w -|strong="H05922"\w*, \w my honor|strong="H01923"\w* \w and splendor|strong="H02122"\w* \w returned|strong="H08421"\w* \w to me|strong="H05922"\w* \w for the glory|strong="H03367"\w* \w of my kingdom|strong="H04437"\w*. \w My advisers|strong="H01907"\w* \w and nobles|strong="H07261"\w* \w sought me out|strong="H01156"\w*, \w and I was restored|strong="H08627"\w* \w to|strong="H05922"\w* \w my throne|strong="H04437"\w*, \w and surpassing|strong="H03493"\w* \w greatness|strong="H07238"\w* \w was added|strong="H03255"\w* to me. \v 37 \w Now|strong="H03705"\w* \w I|strong="H00576"\w*, \w Nebuchadnezzar|strong="H05020"\w*, \w praise|strong="H07624"\w* \w and exalt|strong="H07313"\w* \w and glorify|strong="H01922"\w* \w the King|strong="H04430"\w* \w of heaven|strong="H08065"\w*, \w for|strong="H01768"\w* \w all|strong="H03606"\w* \w His works|strong="H04567"\w* \w are true|strong="H07187"\w* \w and all His ways|strong="H00735"\w* \w are just|strong="H01780"\w*. \w And He is able|strong="H03202"\w* \w to humble|strong="H08214"\w* \w those|strong="H01768"\w* \w who walk|strong="H01981"\w* \w in pride|strong="H01467"\w*.
\c 5
\s1 Belshazzar’s Feast
\p \v 1 \w [Later,]|strong="H04430"\w*\f + \fr 5:1 \ft Aramaic does not include \fqa Later\ft . Some translators include \fqa Many years later \ft to account for the time elapsed, probably about 30 years, since the previous chapter.\f* \w King Belshazzar|strong="H01113"\w* \w held|strong="H05648"\w* \w a great|strong="H07229"\w* \w feast|strong="H03900"\w* \w for a thousand|strong="H00506"\w* \w of his nobles|strong="H07261"\w*, \w and he drank|strong="H08355"\w* \w wine|strong="H02562"\w* \w with|strong="H06903"\w* \w them|strong="H00506"\w*. \v 2 \w Under the influence of the wine|strong="H02562"\w*, \w Belshazzar|strong="H01113"\w* \w gave orders|strong="H00560"\w* \w . . .|strong="H02942"\w* \w to bring|strong="H00858"\w* \w in the gold|strong="H01722"\w* \w and silver|strong="H03702"\w* \w vessels|strong="H03984"\w* \w that|strong="H01768"\w* \w Nebuchadnezzar|strong="H05020"\w* \w his father|strong="H00002"\w*\f + \fr 5:2 \ft Or \fqa predecessor \ft or \fqa grandfather\ft ; also in verses 11, 13, and 18\f* \w had taken|strong="H05312"\w* \w from|strong="H04481"\w* \w the temple|strong="H01965"\w* \w . . .|strong="H01768"\w* \w in Jerusalem|strong="H03390"\w*, \w so that the king|strong="H04430"\w* \w could drink|strong="H08355"\w* from them, \w along with his nobles|strong="H07261"\w*, \w his wives|strong="H07695"\w*, \w and his concubines|strong="H03904"\w*.
\p \v 3 \w Thus|strong="H00116"\w* \w they brought in|strong="H00858"\w* \w the gold|strong="H01722"\w* \w vessels|strong="H03984"\w* \w that|strong="H01768"\w* \w had been taken|strong="H05312"\w* \w from|strong="H04481"\w* \w the temple|strong="H01965"\w*, \w . . .|strong="H01768"\w* \w the house|strong="H01005"\w* \w of God|strong="H00426"\w* \w . . .|strong="H01768"\w* \w in Jerusalem|strong="H03390"\w*, \w and the king|strong="H04430"\w* \w drank|strong="H08355"\w* from them, \w along with his nobles|strong="H07261"\w*, \w his wives|strong="H07695"\w*, \w and his concubines|strong="H03904"\w*. \v 4 \w As they drank|strong="H08355"\w* \w the wine|strong="H02562"\w*, \w they praised|strong="H07624"\w* \w [their] gods|strong="H00426"\w* \w of gold|strong="H01722"\w* \w and silver|strong="H03702"\w*, \w bronze|strong="H05174"\w* \w and iron|strong="H06523"\w*, \w wood|strong="H00636"\w* \w and stone|strong="H00069"\w*.
\s1 The Handwriting on the Wall
\p \v 5 At \w that moment|strong="H08160"\w* \w the fingers|strong="H00677"\w* \w of|strong="H01768"\w* \w a human|strong="H00606"\w* \w hand|strong="H03028"\w* \w appeared|strong="H05312"\w* \w and wrote|strong="H03790"\w* \w on|strong="H05922"\w* \w the plaster|strong="H01528"\w* \w of|strong="H01768"\w* \w the wall|strong="H03797"\w*, \w near|strong="H06903"\w* \w the lampstand|strong="H05043"\w* \w in|strong="H01768"\w* \w the royal|strong="H04430"\w* \w palace|strong="H01965"\w*. \w As the king|strong="H04430"\w* \w watched|strong="H02370"\w* \w the hand|strong="H06447"\w* \w . . .|strong="H03028"\w* \w that|strong="H01768"\w* \w was writing|strong="H03790"\w*, \v 6 \w -|strong="H00116"\w* \w -|strong="H04430"\w* \w his face|strong="H02122"\w* \w grew pale|strong="H08133"\w* \w and his thoughts|strong="H07476"\w* \w so alarmed him|strong="H00927"\w* \w that his hips|strong="H02783"\w* \w . . .|strong="H07001"\w* \w gave way|strong="H08271"\w* \w and his knees|strong="H00755"\w* \w knocked together|strong="H01668"\w* \w . . .|strong="H01668"\w* \w . . .|strong="H05368"\w*.
\p \v 7 \w The king|strong="H04430"\w* \w . . .|strong="H02429"\w* \w called out for|strong="H07123"\w* \w the enchanters|strong="H00826"\w*, \w astrologers|strong="H03779"\w*,\f + \fr 5:7 \ft Or \fqa Chaldeans\ft ; also in verse 11\f* \w and diviners|strong="H01505"\w* \w to be brought in|strong="H05954"\w*, \w . . .|strong="H06032"\w* \w and he|strong="H04430"\w* \w said|strong="H00560"\w* \w to these wise men|strong="H02445"\w* \w of Babylon|strong="H00895"\w*, “\w Whoever|strong="H01768"\w* \w . . .|strong="H03606"\w* \w . . .|strong="H00606"\w* \w . . .|strong="H01768"\w* \w reads|strong="H07123"\w* \w this|strong="H01836"\w* \w inscription|strong="H03792"\w* \w and tells me|strong="H02324"\w* \w its interpretation|strong="H06591"\w* \w will be clothed|strong="H03848"\w* \w in purple|strong="H00711"\w* \w and have a gold|strong="H01722"\w* \w chain|strong="H02002"\w* \w . . .|strong="H01768"\w* \w placed around|strong="H05922"\w* \w his neck|strong="H06676"\w*, \w and he will be made the third|strong="H08523"\w* \w highest ruler|strong="H07981"\w* \w in the kingdom|strong="H04437"\w*.”
\p \v 8 \w So|strong="H00116"\w* \w all|strong="H03606"\w* \w the king’s|strong="H04430"\w* \w wise men|strong="H02445"\w* \w came in|strong="H05954"\w*, \w but they could|strong="H03546"\w* \w not|strong="H03809"\w* \w read|strong="H07123"\w* \w the inscription|strong="H03792"\w* \w or interpret it|strong="H06591"\w* \w . . .|strong="H03046"\w* \w for [him]|strong="H04430"\w*. \v 9 \w Then|strong="H00116"\w* \w King|strong="H04430"\w* \w Belshazzar|strong="H01113"\w* \w became even more|strong="H07690"\w* \w terrified|strong="H00927"\w*, \w his face|strong="H02122"\w* \w grew even more pale|strong="H08133"\w*, \w . . .|strong="H05922"\w* \w and his nobles|strong="H07261"\w* \w were bewildered|strong="H07672"\w*.
\p \v 10 \w Hearing|strong="H06903"\w* \w the outcry|strong="H04406"\w* \w of the king|strong="H04430"\w* \w and his nobles|strong="H07261"\w*, \w the queen|strong="H04433"\w*\f + \fr 5:10 \ft Or \fqa queen mother\f* \w entered|strong="H05954"\w* \w the banquet|strong="H04961"\w* \w hall|strong="H01005"\w*. “\w O king|strong="H04430"\w*, \w may you live|strong="H02418"\w* \w forever|strong="H05957"\w*!” \w -|strong="H06032"\w* \w [she]|strong="H04433"\w* \w said|strong="H00560"\w*. “\w Do not|strong="H00409"\w* \w let your thoughts|strong="H07476"\w* \w terrify you|strong="H00927"\w*, \w or your face|strong="H02122"\w* \w . . .|strong="H00409"\w* \w grow pale|strong="H08133"\w*. \v 11 \w There is|strong="H00383"\w* \w a man|strong="H01400"\w* \w in your kingdom|strong="H04437"\w* \w who|strong="H01768"\w* \w has the spirit|strong="H07308"\w* \w of the holy|strong="H06922"\w* \w gods|strong="H00426"\w* in him. \w In the days|strong="H03118"\w* \w of your father|strong="H00002"\w* \w he was found|strong="H07912"\w* \w to have insight|strong="H05094"\w*, \w intelligence|strong="H07924"\w*, \w and wisdom|strong="H02452"\w* \w like [that]|strong="H02452"\w* \w of the gods|strong="H00426"\w*.
\p \w Your father|strong="H00002"\w*, \w King|strong="H04430"\w* \w Nebuchadnezzar|strong="H05020"\w*, \w appointed him|strong="H06966"\w* \w chief|strong="H07229"\w* \w of the magicians|strong="H02749"\w*, \w enchanters|strong="H00826"\w*, \w astrologers|strong="H03779"\w*, \w [and] diviners|strong="H01505"\w*. \w Your own father|strong="H00002"\w*, \w the king|strong="H04430"\w*, \v 12 \w did this|strong="H03606"\w* \w because|strong="H06903"\w* \w . . .|strong="H01768"\w* \w Daniel|strong="H01841"\w*, \w the one|strong="H01768"\w* \w [he]|strong="H04430"\w* \w named|strong="H07761"\w* \w . . .|strong="H08036"\w* \w Belteshazzar|strong="H01096"\w*, \w was found|strong="H07912"\w* \w to have an extraordinary|strong="H03493"\w* \w spirit|strong="H07308"\w*, \w as well as knowledge|strong="H04486"\w*, \w understanding|strong="H07924"\w*, \w and the ability to interpret|strong="H06590"\w* \w dreams|strong="H02493"\w*, \w explain|strong="H00263"\w* \w riddles|strong="H00280"\w*, \w and solve|strong="H08271"\w* \w difficult problems|strong="H07001"\w*. \w Summon|strong="H07123"\w* \w Daniel|strong="H01841"\w*, \w therefore|strong="H03705"\w*, \w and he will give you|strong="H02324"\w* \w the interpretation|strong="H06591"\w*.”
\s1 Daniel Interprets the Handwriting
\p \v 13 \w So|strong="H00116"\w* \w Daniel|strong="H01841"\w* \w was brought|strong="H05954"\w* \w before|strong="H06925"\w* \w the king|strong="H04430"\w*, \w . . .|strong="H06032"\w* \w [who]|strong="H04430"\w* \w asked|strong="H00560"\w* \w him|strong="H01841"\w*, “\w Are you|strong="H00607"\w* \w . . .|strong="H01932"\w* \w Daniel|strong="H01841"\w*, \w one|strong="H01768"\w* \w of|strong="H04481"\w* \w -|strong="H01768"\w* \w -|strong="H03061"\w* \w the exiles|strong="H01123"\w* \w . . .|strong="H01547"\w* \w -|strong="H01768"\w* \w my father|strong="H00002"\w* \w the king|strong="H04430"\w* \w brought|strong="H00858"\w* \w from|strong="H04481"\w* \w Judah|strong="H03061"\w*? \v 14 \w I have heard|strong="H08086"\w* \w . . .|strong="H05922"\w* \w that|strong="H01768"\w* \w the spirit|strong="H07308"\w* \w of the gods|strong="H00426"\w* is in you, \w and that you have insight|strong="H05094"\w*, \w intelligence|strong="H07924"\w*, \w and extraordinary|strong="H03493"\w*\w . . .|strong="H07912"\w* \w wisdom|strong="H02452"\w*.
\p \v 15 \w Now|strong="H03705"\w* \w the wise men|strong="H02445"\w* \w and enchanters|strong="H00826"\w* \w . . .|strong="H01768"\w* \w were brought|strong="H05954"\w* \w before me|strong="H06925"\w* \w to read|strong="H07123"\w* \w this|strong="H01836"\w* \w inscription|strong="H03792"\w* \w and interpret it|strong="H06591"\w* \w for me|strong="H03046"\w*, \w but they could|strong="H03546"\w* \w not|strong="H03809"\w* \w give|strong="H02324"\w* \w its|strong="H04406"\w* \w interpretation|strong="H06591"\w*. \v 16 \w But|strong="H00576"\w* \w I have heard|strong="H08086"\w* \w about you|strong="H05922"\w*, \w that|strong="H01768"\w* \w you are able|strong="H03202"\w* \w to give interpretations|strong="H06591"\w* \w . . .|strong="H06590"\w* \w and solve|strong="H08271"\w* \w difficult problems|strong="H07001"\w*. \w Therefore|strong="H03705"\w*, \w if|strong="H02006"\w* \w you can|strong="H03202"\w* \w read|strong="H07123"\w* \w this inscription|strong="H03792"\w* \w and give me|strong="H03046"\w* \w its interpretation|strong="H06591"\w*, \w you will be clothed|strong="H03848"\w* \w in purple|strong="H00711"\w* \w and have a gold|strong="H01722"\w* \w chain|strong="H02002"\w*\w . . .|strong="H01768"\w* \w placed around|strong="H05922"\w* \w your neck|strong="H06676"\w*, \w and you will be made the third|strong="H08531"\w* \w highest ruler|strong="H07981"\w* \w in the kingdom|strong="H04437"\w*.”
\p \v 17 \w In response|strong="H00116"\w*, \w Daniel|strong="H01841"\w* \w said|strong="H00560"\w* \w . . .|strong="H06925"\w* \w . . .|strong="H06032"\w* \w to the king|strong="H04430"\w*, “\w You may keep|strong="H01934"\w* \w your gifts|strong="H04978"\w* for yourself \w and give|strong="H03052"\w* \w your rewards|strong="H05023"\w* \w to someone else|strong="H00321"\w*. \w Nevertheless|strong="H01297"\w*, \w I will read|strong="H07123"\w* \w the inscription|strong="H03792"\w* \w for the king|strong="H04430"\w* \w and interpret it|strong="H06591"\w* \w for him|strong="H03046"\w*. \v 18 \w As for you|strong="H00607"\w*, \w O king|strong="H04430"\w*, \w the Most High|strong="H05943"\w* \w God|strong="H00426"\w* \w gave|strong="H03052"\w* \w your father|strong="H00002"\w* \w Nebuchadnezzar|strong="H05020"\w* \w sovereignty|strong="H04437"\w* \w and greatness|strong="H07238"\w*, \w glory|strong="H03367"\w* \w and honor|strong="H01923"\w*. \v 19 \w Because of|strong="H04481"\w* \w the greatness|strong="H07238"\w* \w that|strong="H01768"\w* \w He bestowed|strong="H03052"\w* on him, \w the people|strong="H05972"\w* \w of every|strong="H03606"\w* \w nation|strong="H00524"\w* \w and language|strong="H03961"\w* \w vvv|strong="H01934"\w* \w trembled|strong="H02112"\w* \w in fear|strong="H01763"\w* \w before|strong="H04481"\w* \w him|strong="H06925"\w*. \w He|strong="H01934"\w* \w killed|strong="H06992"\w* \w whom|strong="H01768"\w* \w he|strong="H01934"\w* \w wished|strong="H06634"\w* \w and kept alive|strong="H02418"\w* \w whom|strong="H01768"\w* \w he|strong="H01934"\w* \w wished|strong="H06634"\w*; \w . . .|strong="H01934"\w* \w he exalted|strong="H07313"\w* \w whom|strong="H01768"\w* \w he|strong="H01934"\w* \w wished|strong="H06634"\w* \w . . .|strong="H01934"\w* \w and humbled|strong="H08214"\w* \w whom|strong="H01768"\w* \w he|strong="H01934"\w* \w wished|strong="H06634"\w*. \w . . .|strong="H01934"\w*
\p \v 20 \w But when|strong="H01768"\w* \w his heart|strong="H03825"\w* \w became arrogant|strong="H07313"\w* \w and his spirit|strong="H07308"\w* \w was hardened|strong="H08631"\w* \w with pride|strong="H02103"\w*, \w he was deposed|strong="H05182"\w* \w from|strong="H04481"\w* \w his royal|strong="H04437"\w* \w throne|strong="H03764"\w*, \w and his glory|strong="H03367"\w* \w was taken|strong="H05709"\w* \w from him|strong="H04481"\w*. \v 21 \w He was driven away|strong="H02957"\w* \w from|strong="H04481"\w* \w mankind|strong="H01123"\w* \w . . .|strong="H00606"\w*, \w and his mind|strong="H03825"\w* \w was like|strong="H05974"\w* \w [that of] a beast|strong="H02423"\w*. \w . . .|strong="H07739"\w* \w He lived|strong="H04070"\w* \w with|strong="H05974"\w* \w the wild donkeys|strong="H06167"\w* \w and ate|strong="H02939"\w* \w grass|strong="H06211"\w* \w like an ox|strong="H08450"\w*, \w and his body|strong="H01655"\w* \w was drenched|strong="H06647"\w* \w with the dew|strong="H02920"\w* \w of heaven|strong="H08065"\w* \w until|strong="H05705"\w* \w . . .|strong="H01768"\w* \w he acknowledged|strong="H03046"\w* \w that|strong="H01768"\w* \w the Most High|strong="H05943"\w* \w God|strong="H00426"\w* \w rules|strong="H07990"\w* \w over the kingdom|strong="H04437"\w* \w of mankind|strong="H00606"\w*, \w setting|strong="H06966"\w* \w over it|strong="H05922"\w* \w whom|strong="H04479"\w* \w . . .|strong="H01768"\w* \w He wishes|strong="H06634"\w*.
\p \v 22 \w But you|strong="H00607"\w* \w his son|strong="H01247"\w*,\f + \fr 5:22 \ft Or \fqa descendant \ft or \fqa successor \ft or \fqa grandson\f* \w O Belshazzar|strong="H01113"\w*, \w have not|strong="H03809"\w* \w humbled|strong="H08214"\w* \w your heart|strong="H03825"\w*, \w even though|strong="H06903"\w* \w . . .|strong="H01768"\w* \w . . .|strong="H03606"\w* \w you knew|strong="H03046"\w* \w all|strong="H03606"\w* \w this|strong="H01836"\w*. \v 23 \w Instead, you have exalted|strong="H07313"\w* \w yourself against|strong="H05922"\w* \w the Lord|strong="H04756"\w* \w of heaven|strong="H08065"\w*. \w The vessels|strong="H03984"\w* \w from|strong="H01768"\w* \w His house|strong="H01005"\w* \w were brought|strong="H00858"\w* \w to you|strong="H06925"\w*, \w and as you|strong="H00607"\w* \w drank|strong="H08355"\w* \w wine|strong="H02562"\w* from them \w with your nobles|strong="H07261"\w*, \w wives|strong="H07695"\w*, \w and concubines|strong="H03904"\w*, \w you praised|strong="H07624"\w* \w [your] gods|strong="H00426"\w* \w of silver|strong="H03702"\w* \w and gold|strong="H01722"\w*, \w bronze|strong="H05174"\w* \w and iron|strong="H06523"\w*, \w wood|strong="H00636"\w* \w and stone|strong="H00069"\w*, \w which|strong="H01768"\w* \w cannot|strong="H03809"\w* \w see|strong="H02370"\w* \w or|strong="H03809"\w* \w hear|strong="H08086"\w* \w or|strong="H03809"\w* \w understand|strong="H03046"\w*. \w But you have failed to|strong="H03809"\w* \w glorify|strong="H01922"\w* \w the God|strong="H00426"\w* \w who|strong="H01768"\w* holds \w in His hand|strong="H03028"\w* \w your very breath|strong="H05396"\w* \w and all|strong="H03606"\w* \w your ways|strong="H00735"\w*. \v 24 \w Therefore|strong="H00116"\w* \w . . .|strong="H04481"\w* \w . . .|strong="H06925"\w* \w He sent|strong="H07972"\w* \w . . .|strong="H06447"\w* \w . . .|strong="H01768"\w* \w the hand|strong="H03028"\w* \w that wrote|strong="H07560"\w* \w the|strong="H01836"\w* \w inscription|strong="H03792"\w*.
\p \v 25 \w Now this|strong="H01836"\w* \w is the inscription|strong="H03792"\w* \w that|strong="H01768"\w* \w was written|strong="H07560"\w*:
\pc \w MENE|strong="H04484"\w*, \w MENE|strong="H04484"\w*, \w TEKEL|strong="H08625"\w*, \w PARSIN|strong="H06537"\w*.
\p \v 26 \w [And] this|strong="H01836"\w* \w is the interpretation|strong="H06591"\w* \w of the message|strong="H04406"\w*:
\b 
\li1 \w MENE|strong="H04484"\w*\f + \fr 5:26 \fqa Mene \ft sounds like the Aramaic for \fqa numbered\ft .\f* \w means that God|strong="H00426"\w* \w has numbered|strong="H04483"\w* \w the days of your reign|strong="H04437"\w* \w and brought it to an end|strong="H08000"\w*.
\li1 \v 27 \w TEKEL|strong="H08625"\w*\f + \fr 5:27 \fqa Tekel \ft sounds like the Aramaic for \fqa weighed\ft .\f* \w means that you have been weighed|strong="H08625"\w* \w on the scales|strong="H03977"\w* \w and found|strong="H07912"\w* \w deficient|strong="H02627"\w*.
\li1 \v 28 \w PERES|strong="H06537"\w*\f + \fr 5:28 \fqa Peres \ft (the singular of \fqa Parsin\ft ) sounds like the Aramaic for \fqa divided \ft and for \fqa Persia\ft .\f* \w means that your kingdom|strong="H04437"\w* \w has been divided|strong="H06537"\w* \w and given over|strong="H03052"\w* \w to the Medes|strong="H04076"\w* \w and Persians|strong="H06540"\w*.”
\p \v 29 \w Then|strong="H00116"\w* \w Belshazzar|strong="H01113"\w* \w gave the command|strong="H00560"\w*, \w and they clothed|strong="H03848"\w* \w Daniel|strong="H01841"\w* \w in purple|strong="H00711"\w*,\w . . .|strong="H01768"\w* \w placed a gold|strong="H01722"\w* \w chain|strong="H02002"\w* \w around|strong="H05922"\w* \w his neck|strong="H06676"\w*, \w and proclaimed|strong="H03745"\w* \w him|strong="H05922"\w* \w . . .|strong="H01768"\w* \w -|strong="H01934"\w* \w the third highest|strong="H08531"\w* \w ruler|strong="H07990"\w* \w in the kingdom|strong="H04437"\w*.
\p \v 30 That \w very night|strong="H03916"\w* \w Belshazzar|strong="H01113"\w* \w king|strong="H04430"\w* \w of the Chaldeans|strong="H03779"\w*\f + \fr 5:30 \ft That is, the Babylonians\f* \w was slain|strong="H06992"\w*, \v 31 \w and Darius|strong="H01868"\w* \w the Mede|strong="H04076"\w* \w received|strong="H06902"\w* \w the kingdom|strong="H04437"\w* \w at the age|strong="H01247"\w* \w . . .|strong="H08140"\w* \w of sixty-two|strong="H08361"\w* \w . . .|strong="H08648"\w*.
\c 6
\s1 The Plot against Daniel
\p \v 1 \w Now it|strong="H08232"\w* \w pleased|strong="H06925"\w* \w Darius|strong="H01868"\w* \w to appoint|strong="H06966"\w* \w 120|strong="H03969"\w* \w . . .|strong="H06243"\w* \w . . .|strong="H01768"\w* \w satraps|strong="H00324"\w* \w -|strong="H05922"\w* \w -|strong="H04437"\w* \w to rule|strong="H01934"\w* \w throughout|strong="H03606"\w* \w the kingdom|strong="H04437"\w*, \v 2 \w and over them|strong="H05924"\w* \w . . .|strong="H04481"\w* \w three|strong="H08532"\w* \w . . .|strong="H01768"\w* \w administrators|strong="H05632"\w*, \w including Daniel|strong="H01841"\w*, \w . . .|strong="H02298"\w* \w . . .|strong="H04481"\w* \w . . .|strong="H01768"\w*\w . . .|strong="H01934"\w* to whom \w these|strong="H00459"\w* \w satraps|strong="H00324"\w* \w . . .|strong="H03052"\w* \w were accountable|strong="H02941"\w* \w so that the king|strong="H04430"\w* \w would|strong="H01934"\w* \w not|strong="H03809"\w* \w suffer loss|strong="H05142"\w*. \v 3 \w Soon|strong="H00116"\w*, \w by|strong="H06903"\w* \w . . .|strong="H01768"\w* \w his extraordinary|strong="H03493"\w* \w spirit|strong="H07308"\w*, \w Daniel|strong="H01841"\w* \w . . .|strong="H01836"\w* \w . . .|strong="H01934"\w* \w distinguished himself|strong="H05330"\w* \w among|strong="H05922"\w* \w the administrators|strong="H05632"\w* \w and satraps|strong="H00324"\w*\w . . .|strong="H03606"\w*. \w So the king|strong="H04430"\w* \w planned|strong="H06246"\w* \w to set him|strong="H06966"\w* \w over|strong="H05922"\w* \w the whole|strong="H03606"\w* \w kingdom|strong="H04437"\w*.
\p \v 4 \w Thus|strong="H00116"\w* \w the administrators|strong="H05632"\w* \w and satraps|strong="H00324"\w* \w sought|strong="H01934"\w* \w . . .|strong="H01156"\w* \w . . .|strong="H07912"\w* \w a charge|strong="H05931"\w* \w against Daniel|strong="H01841"\w* \w concerning|strong="H06655"\w* \w the kingdom|strong="H04437"\w*, \w but they could|strong="H03202"\w* \w find|strong="H07912"\w* \w no|strong="H03606"\w* \w . . .|strong="H03809"\w* \w charge|strong="H05931"\w* \w or corruption|strong="H07844"\w*,\w . . .|strong="H03606"\w* \w because|strong="H06903"\w* \w . . .|strong="H01768"\w* \w he|strong="H01932"\w* \w . . .|strong="H03606"\w* \w was trustworthy|strong="H00540"\w*, \w and no|strong="H03809"\w* \w negligence|strong="H07960"\w* \w or corruption|strong="H07844"\w* \w was found|strong="H07912"\w* \w in him|strong="H05922"\w*. \v 5 \w Finally|strong="H00116"\w* \w these|strong="H00479"\w* \w men|strong="H01400"\w* \w said|strong="H00560"\w*, \w . . .|strong="H01768"\w* “\w We will never|strong="H03809"\w* \w find|strong="H07912"\w* \w any|strong="H03606"\w* \w charge|strong="H05931"\w* \w against this|strong="H01836"\w* \w Daniel|strong="H01841"\w* \w unless|strong="H03861"\w* \w we find [something]|strong="H07912"\w* \w against him|strong="H05922"\w* \w concerning the law|strong="H01882"\w* \w of his God|strong="H00426"\w*.”
\p \v 6 \w So|strong="H00116"\w* \w the administrators|strong="H05632"\w* \w and satraps|strong="H00324"\w* \w . . .|strong="H00459"\w* \w went together|strong="H07284"\w* \w to|strong="H05922"\w* \w the king|strong="H04430"\w* \w . . .|strong="H03652"\w* \w and said|strong="H00560"\w*, “\w O King|strong="H04430"\w* \w Darius|strong="H01868"\w*, \w may you live|strong="H02418"\w* \w forever|strong="H05957"\w*! \v 7 \w All|strong="H03606"\w* \w the royal|strong="H04437"\w* \w administrators|strong="H05632"\w*, \w prefects|strong="H05460"\w*, \w satraps|strong="H00324"\w*, \w advisers|strong="H01907"\w*, \w and governors|strong="H06347"\w* \w have agreed|strong="H03272"\w* \w that the king|strong="H04430"\w* \w should establish|strong="H06966"\w* \w an ordinance|strong="H07010"\w* \w and enforce|strong="H08631"\w* \w a decree|strong="H00633"\w* \w that|strong="H01768"\w* \w for|strong="H05705"\w* \w thirty|strong="H08533"\w* \w days|strong="H03118"\w* \w anyone|strong="H03606"\w* \w who|strong="H01768"\w* \w petitions|strong="H01156"\w* \w . . .|strong="H01159"\w* \w . . .|strong="H04481"\w* \w any|strong="H03606"\w* \w god|strong="H00426"\w* \w or man|strong="H00606"\w* \w except you|strong="H03861"\w*, \w . . .|strong="H04481"\w* \w O king|strong="H04430"\w*, \w will be thrown|strong="H07412"\w* \w into the den|strong="H01358"\w* \w of lions|strong="H00744"\w*. \v 8 \w Therefore|strong="H03705"\w*, \w O king|strong="H04430"\w*, \w establish|strong="H06966"\w* \w the decree|strong="H00633"\w* \w and sign|strong="H07560"\w* \w the document|strong="H03792"\w* \w so that|strong="H01768"\w* \w it cannot|strong="H03809"\w* \w be changed|strong="H08133"\w* — \w in accordance with the law|strong="H01882"\w* \w of the Medes|strong="H04076"\w* \w and Persians|strong="H06540"\w*, \w which|strong="H01768"\w* \w cannot|strong="H03809"\w* \w be repealed|strong="H05709"\w*.”
\p \v 9 \w Therefore|strong="H03606"\w* \w . . .|strong="H06903"\w* \w . . .|strong="H01836"\w* \w King|strong="H04430"\w* \w Darius|strong="H01868"\w* \w signed|strong="H07560"\w* \w the written|strong="H03792"\w* \w decree|strong="H00633"\w*.
\s1 Daniel in the Lions’ Den
\p \v 10 \w Now when|strong="H01768"\w* \w Daniel|strong="H01841"\w* \w learned|strong="H03046"\w* \w that|strong="H01768"\w* \w the document|strong="H03792"\w* \w had been signed|strong="H07560"\w*, \w he went|strong="H05954"\w* \w into his house|strong="H01005"\w*, \w where the windows|strong="H03551"\w* of his \w upper room|strong="H05952"\w* \w opened|strong="H06606"\w* \w toward|strong="H05049"\w* \w Jerusalem|strong="H03390"\w*, \w and three|strong="H08532"\w* \w times|strong="H02166"\w* \w a day|strong="H03118"\w* \w he|strong="H01932"\w* \w got down|strong="H01289"\w* \w on|strong="H05922"\w* \w his knees|strong="H01291"\w*, \w prayed|strong="H06739"\w*, \w and gave thanks|strong="H03029"\w* \w to|strong="H06925"\w* \w his God|strong="H00426"\w*, \w . . .|strong="H03606"\w* \w just as|strong="H06903"\w* \w . . .|strong="H01768"\w* \w . . .|strong="H01934"\w* \w he had done|strong="H05648"\w* \w before|strong="H04481"\w* \w . . .|strong="H06928"\w* \w . . .|strong="H01836"\w*. \v 11 \w Then|strong="H00116"\w* \w these|strong="H00479"\w* \w men|strong="H01400"\w* \w went as a group|strong="H07284"\w* \w and found|strong="H07912"\w* \w Daniel|strong="H01841"\w* \w petitioning|strong="H01156"\w* \w and imploring|strong="H02604"\w* \w . . .|strong="H06925"\w* \w his God|strong="H00426"\w*. \v 12 \w So|strong="H00116"\w* \w they approached|strong="H07127"\w* \w the king|strong="H04430"\w* \w and asked|strong="H00560"\w* \w . . .|strong="H06925"\w* \w about|strong="H05922"\w* \w his royal|strong="H04430"\w* \w decree|strong="H00633"\w*: “\w Did you not|strong="H03809"\w* \w sign|strong="H07560"\w* \w a decree|strong="H00633"\w* \w that|strong="H01768"\w* \w for|strong="H05705"\w* \w thirty|strong="H08533"\w* \w days|strong="H03118"\w* \w any|strong="H03606"\w* \w man|strong="H00606"\w* \w who|strong="H01768"\w* \w petitions|strong="H01156"\w* \w . . .|strong="H04481"\w* \w any|strong="H03606"\w* \w god|strong="H00426"\w* \w or man|strong="H00606"\w* \w except you|strong="H03861"\w*, \w . . .|strong="H04481"\w* \w O king|strong="H04430"\w*, \w will be thrown|strong="H07412"\w* \w into the den|strong="H01358"\w* \w of lions|strong="H00744"\w*?”
\p \w The king|strong="H04430"\w* \w . . .|strong="H00560"\w* \w replied|strong="H06032"\w*, “\w According to the law|strong="H01882"\w* \w of the Medes|strong="H04076"\w* \w and Persians|strong="H06540"\w* \w . . .|strong="H01768"\w* \w the order|strong="H04406"\w* \w stands|strong="H03330"\w*, \w and it cannot|strong="H03809"\w* \w be repealed|strong="H05709"\w*.”
\p \v 13 \w Then|strong="H00116"\w* \w they told|strong="H06032"\w* \w . . .|strong="H00560"\w* \w . . .|strong="H06925"\w* \w the king|strong="H04430"\w*, “\w Daniel|strong="H01841"\w*, \w one|strong="H01768"\w* \w of|strong="H04481"\w* \w vvv|strong="H01768"\w* \w the exiles|strong="H01123"\w* \w . . .|strong="H01547"\w* \w from|strong="H01768"\w* \w Judah|strong="H03061"\w*, \w shows no|strong="H03809"\w* \w regard|strong="H07761"\w* \w for you|strong="H05922"\w*, \w O king|strong="H04430"\w*,\w . . .|strong="H02942"\w* \w or for|strong="H05922"\w* \w the decree|strong="H00633"\w* \w that|strong="H01768"\w* \w you have signed|strong="H07560"\w*. \w He still makes|strong="H01156"\w* \w his petition|strong="H01159"\w* \w three|strong="H08532"\w* \w times|strong="H02166"\w* \w a day|strong="H03118"\w*.”
\p \v 14 \w -|strong="H00116"\w* \w As soon as|strong="H01768"\w* \w the king|strong="H04430"\w* \w heard|strong="H08086"\w* \w this|strong="H04406"\w*, \w he was deeply|strong="H07690"\w* \w distressed|strong="H00888"\w* \w . . .|strong="H05922"\w* \w and|strong="H05922"\w* \w set|strong="H07761"\w* \w [his] mind|strong="H01079"\w* \w on delivering|strong="H07804"\w* \w Daniel|strong="H01841"\w*, \w and he labored|strong="H07712"\w* \w until|strong="H05705"\w* \w sundown|strong="H04606"\w* \w . . .|strong="H08122"\w* \w . . .|strong="H01934"\w* \w to rescue him|strong="H05338"\w*.
\p \v 15 \w Then|strong="H00116"\w* \w the|strong="H00479"\w* \w men|strong="H01400"\w* \w approached|strong="H07284"\w* \w . . .|strong="H05922"\w* \w the king {together}|strong="H04430"\w* \w and said|strong="H00560"\w* \w to him|strong="H04430"\w*, “\w Remember|strong="H03046"\w*, \w O king|strong="H04430"\w*, \w that|strong="H01768"\w* \w by the law|strong="H01882"\w* \w of the Medes|strong="H04076"\w* \w and Persians|strong="H06540"\w* \w . . .|strong="H01768"\w* \w no|strong="H03606"\w* \w decree|strong="H00633"\w* \w or ordinance|strong="H07010"\w* \w . . .|strong="H01768"\w* \w established|strong="H06966"\w* \w by the king|strong="H04430"\w*\w . . .|strong="H03809"\w* \w can be changed|strong="H08133"\w*.”
\p \v 16 \w So|strong="H00116"\w* \w the king|strong="H04430"\w* \w gave the order|strong="H00560"\w*, \w and they brought|strong="H00858"\w* \w Daniel|strong="H01841"\w* \w and threw him|strong="H07412"\w* \w into the den|strong="H01358"\w* \w of|strong="H01768"\w* \w lions|strong="H00744"\w*.
