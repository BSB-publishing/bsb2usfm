\p \v 2 \w So I bought her|strong="H03739"\w* - \w for fifteen [shekels]|strong="H02568"\w* \w . . .|strong="H06240"\w* \w of silver|strong="H03701"\w*\f + \fr 3:2 \fqa 15 shekels \ft is approximately 6 ounces or 171 grams of silver.\f* \w and a homer|strong="H02563"\w* \w and a lethech|strong="H03963"\w* \w . . .|strong="H08184"\w* \w of barley|strong="H08184"\w*.\f + \fr 3:2 \ft Or \fqa a homer and a half of barley\ft ; that is, a total of approximately 9.36 bushels or 330 liters (probably about 436 pounds or 198 kilograms of barley); LXX \fqa a homer of barley and a wineskin full of wine\f* \v 3 \w Then I said|strong="H00559"\w* \w to her|strong="H00413"\w*, “\w You must live|strong="H03427"\w* with me \w for many|strong="H07227"\w* \w days|strong="H03117"\w*; \w you must not|strong="H03808"\w* \w be promiscuous|strong="H02181"\w* \w . . .|strong="H03808"\w* \w or belong to|strong="H01961"\w* \w another|strong="H00376"\w*, \w and|strong="H01571"\w* \w I|strong="H00589"\w* \w will do the same for you|strong="H00413"\w*.”
\p \v 4 \w For|strong="H03588"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w must live|strong="H03427"\w* \w many|strong="H07227"\w* \w days|strong="H03117"\w* \w without|strong="H00369"\w* \w king|strong="H04428"\w* \w or prince|strong="H08269"\w*, \w without|strong="H00369"\w* \w sacrifice|strong="H02077"\w* \w or|strong="H00369"\w* \w sacred pillar|strong="H04676"\w*, \w . . .|strong="H00369"\w* \w and without|strong="H00369"\w* \w ephod|strong="H00646"\w* \w or idol|strong="H08655"\w*. \v 5 \w Afterward|strong="H00310"\w*, \w the people|strong="H01121"\w* \w of Israel|strong="H03478"\w* \w will return|strong="H07725"\w* \w and seek|strong="H01245"\w* \w -|strong="H00853"\w* \w the LORD|strong="H03068"\w* \w their God|strong="H00430"\w* \w -|strong="H00853"\w* \w and David|strong="H01732"\w* \w their king|strong="H04428"\w*. \w They will come trembling|strong="H06342"\w* \w to|strong="H00413"\w* \w the LORD|strong="H03068"\w* \w and to|strong="H00413"\w* \w His goodness|strong="H02898"\w* \w in the last|strong="H00319"\w* \w days|strong="H03117"\w*.
