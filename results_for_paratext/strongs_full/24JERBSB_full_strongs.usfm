\p \v 16 \w Then I said|strong="H01696"\w* \w to|strong="H00413"\w* \w the priests|strong="H03548"\w* \w and to|strong="H00413"\w* \w all|strong="H03605"\w* \w this|strong="H02088"\w* \w people|strong="H05971"\w* \w -|strong="H00559"\w*, “\w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: \w Do not|strong="H00408"\w* \w listen|strong="H08085"\w* \w to|strong="H00413"\w* \w the words|strong="H01697"\w* \w of your prophets|strong="H05030"\w* \w who prophesy|strong="H05012"\w* to you, \w saying|strong="H00559"\w*, ‘\w Look|strong="H02009"\w*, \w very soon|strong="H04120"\w* \w . . .|strong="H03588"\w* \w now|strong="H06258"\w* \w the articles|strong="H03627"\w* \w from the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w* \w will be brought back|strong="H07725"\w* \w from Babylon|strong="H00894"\w*.’ \w They|strong="H01992"\w* \w are prophesying|strong="H05012"\w* to you \w a lie|strong="H08267"\w*. \v 17 \w Do not|strong="H00408"\w* \w listen|strong="H08085"\w* \w to them|strong="H00413"\w*. \w Serve|strong="H05647"\w* \w -|strong="H00853"\w* \w the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w and live|strong="H02421"\w*! \w Why|strong="H04100"\w* \w should this|strong="H02063"\w* \w city|strong="H05892"\w* \w become|strong="H01961"\w* \w a ruin|strong="H02723"\w*?
\p \v 18 \w If|strong="H00518"\w* \w they|strong="H01992"\w* \w are indeed prophets|strong="H05030"\w* \w and|strong="H00518"\w* \w the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w is|strong="H03426"\w* \w with them|strong="H00854"\w*, \w let them now|strong="H04994"\w* \w plead with|strong="H06293"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w* \w that the articles|strong="H03627"\w* \w remaining|strong="H03498"\w* \w in the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*, \w in the palace|strong="H01004"\w* \w of the king|strong="H04428"\w* \w of Judah|strong="H03063"\w*, \w and in Jerusalem|strong="H03389"\w*, \w not|strong="H01115"\w* \w be taken|strong="H00935"\w* \w to Babylon|strong="H00894"\w*.
