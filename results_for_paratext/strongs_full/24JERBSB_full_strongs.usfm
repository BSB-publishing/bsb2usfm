\q2 \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*.
\q1 \v 21 \w I will deliver you|strong="H05337"\w* \w from the hand|strong="H03027"\w* \w of the wicked|strong="H07451"\w*
\q2 \w and redeem you|strong="H06299"\w* \w from the grasp|strong="H03709"\w* \w of the ruthless|strong="H06184"\w*.”
\c 16
\s1 Disaster Predicted
\p \v 1 \w Then the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w came|strong="H01961"\w* \w to me|strong="H00413"\w*, \w saying|strong="H00559"\w*, \v 2 “\w You must not|strong="H03808"\w* \w marry|strong="H03947"\w* \w -|strong="H00802"\w* \w [or]|strong="H03808"\w* \w have|strong="H01961"\w* \w sons|strong="H01121"\w* \w or daughters|strong="H01323"\w* \w in this|strong="H02088"\w* \w place|strong="H04725"\w*.”
\p \v 3 \w For|strong="H03588"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w* \w concerning|strong="H05921"\w* \w the sons|strong="H01121"\w* \w and|strong="H05921"\w* \w daughters|strong="H01323"\w* \w born in this|strong="H02088"\w* \w place|strong="H04725"\w*, \w and|strong="H05921"\w* \w the mothers|strong="H00517"\w* \w who bore them|strong="H03209"\w*, \w and the fathers|strong="H00001"\w* \w . . .|strong="H03205"\w* \w -|strong="H00853"\w* \w who fathered|strong="H03205"\w* \w them|strong="H00853"\w*\w . . .|strong="H05921"\w* \w in this|strong="H02063"\w* \w land|strong="H00776"\w*: \v 4 “\w They will die|strong="H04191"\w* \w from deadly|strong="H04463"\w* \w diseases|strong="H08463"\w*. \w They will not|strong="H03808"\w* \w be mourned|strong="H05594"\w* \w . . .|strong="H03808"\w* \w or buried|strong="H06912"\w*, \w but will lie|strong="H01961"\w* \w like dung|strong="H01828"\w* \w on|strong="H05921"\w* \w vvv|strong="H06440"\w* \w the ground|strong="H00127"\w*. \w They will be finished off|strong="H03615"\w* \w by sword|strong="H02719"\w* \w and famine|strong="H07458"\w*, \w and their corpses|strong="H05038"\w* \w will become|strong="H01961"\w* \w food|strong="H03978"\w* \w for the birds|strong="H05775"\w* \w of the air|strong="H08064"\w* \w and beasts|strong="H00929"\w* \w of the earth|strong="H00776"\w*.”
\p \v 5 \w Indeed|strong="H03588"\w*, \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: “\w Do not|strong="H00408"\w* \w enter|strong="H00935"\w* \w a house|strong="H01004"\w* \w [where there is] a funeral meal|strong="H04798"\w*. \w Do not|strong="H00408"\w* \w go|strong="H01980"\w* \w to mourn|strong="H05594"\w* \w . . .|strong="H00408"\w* \w or show sympathy|strong="H05110"\w*, \w for|strong="H03588"\w* \w I have removed|strong="H00622"\w* \w -|strong="H00853"\w* \w from|strong="H00854"\w* \w this|strong="H02088"\w* \w people|strong="H05971"\w* \w My peace|strong="H07965"\w*, \w My loving devotion|strong="H02617"\w*, \w and|strong="H00853"\w* \w My compassion|strong="H07356"\w*,” \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*\w . . .|strong="H00853"\w*.
\p \v 6 “\w Both great|strong="H01419"\w* \w and small|strong="H06996"\w* \w will die|strong="H04191"\w* \w in this|strong="H02063"\w* \w land|strong="H00776"\w*. \w They will not|strong="H03808"\w* \w be buried|strong="H06912"\w* \w [or]|strong="H03808"\w* \w mourned|strong="H05594"\w*, . . . \w nor|strong="H03808"\w* \w will anyone cut himself|strong="H01413"\w* \w . . .|strong="H03808"\w* \w or shave his head|strong="H07139"\w* for them. \v 7 \w No food|strong="H03808"\w* \w will be offered|strong="H06536"\w*\w . . .|strong="H05921"\w* \w to comfort|strong="H05162"\w* \w those who mourn|strong="H00060"\w* \w . . .|strong="H05921"\w* \w the dead|strong="H04191"\w*; \w not even|strong="H03808"\w* \w a cup|strong="H03563"\w* \w of consolation|strong="H08575"\w* \w will be given|strong="H08248"\w* \w -|strong="H00853"\w* \w for|strong="H05921"\w* \w the loss of a father|strong="H00001"\w* \w . . .|strong="H05921"\w* \w or mother|strong="H00517"\w*.
\p \v 8 \w You must not|strong="H03808"\w* \w enter|strong="H00935"\w* \w a house|strong="H01004"\w* \w where there is feasting|strong="H04960"\w* \w and sit down|strong="H03427"\w* \w with them|strong="H00854"\w* \w to eat|strong="H00398"\w* \w and drink|strong="H08354"\w*. \v 9 \w For|strong="H03588"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w . . .|strong="H02005"\w* \w says|strong="H00559"\w*: \w I am going to remove|strong="H07673"\w* \w from|strong="H04480"\w* \w this|strong="H02088"\w* \w place|strong="H04725"\w*, \w before your very eyes|strong="H05869"\w* \w and in your days|strong="H03117"\w*, \w the sounds|strong="H06963"\w* \w of joy|strong="H08342"\w* \w and gladness|strong="H08057"\w*, \w . . .|strong="H06963"\w* \w the voices|strong="H06963"\w* \w . . .|strong="H06963"\w* \w of the bride|strong="H03618"\w* \w and bridegroom|strong="H02860"\w*.
\p \v 10 \w -|strong="H01961"\w* \w When|strong="H03588"\w* \w you tell|strong="H05046"\w* \w these|strong="H02088"\w* \w -|strong="H00853"\w* \w people|strong="H05971"\w* \w all|strong="H03605"\w* \w these|strong="H00428"\w* \w things|strong="H01697"\w*, \w they will ask|strong="H00559"\w* \w you|strong="H00413"\w*, ‘\w Why|strong="H05921"\w* \w . . .|strong="H04100"\w* \w has the LORD|strong="H03068"\w* \w pronounced|strong="H01696"\w* \w all|strong="H03605"\w* \w this|strong="H02063"\w* \w great|strong="H01419"\w* \w disaster|strong="H07451"\w* \w against us|strong="H05921"\w*? \w -|strong="H00853"\w* \w What|strong="H04100"\w* \w [is] our iniquity|strong="H05771"\w*? \w What|strong="H04100"\w* \w is the sin|strong="H02403"\w* \w that|strong="H00834"\w* \w we have committed|strong="H02398"\w* \w against the LORD|strong="H03068"\w* \w our God|strong="H00430"\w*?’
\p \v 11 \w Then you are to answer them|strong="H00559"\w*: \w . . .|strong="H00413"\w* ‘\w [It is] because|strong="H05921"\w* \w -|strong="H00834"\w* \w your fathers|strong="H00001"\w* \w have forsaken|strong="H05800"\w* \w Me|strong="H00853"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, \w and followed|strong="H01980"\w* \w . . .|strong="H00310"\w* \w other|strong="H00312"\w* \w gods|strong="H00430"\w*, \w and served|strong="H05647"\w* \w and worshiped|strong="H07812"\w* them. \w -|strong="H00853"\w* \w They abandoned Me|strong="H05800"\w* \w -|strong="H00853"\w* \w and did not|strong="H03808"\w* \w keep|strong="H08104"\w* \w My instruction|strong="H08451"\w*. \v 12 \w And you|strong="H00859"\w* \w have done|strong="H06213"\w* \w more evil|strong="H07489"\w* \w than your fathers|strong="H00001"\w*. \w See how|strong="H02005"\w* \w each of you|strong="H00376"\w* \w follows|strong="H01980"\w* \w . . .|strong="H00310"\w* \w the stubbornness|strong="H08307"\w* \w of his evil|strong="H07451"\w* \w heart|strong="H03820"\w* \w instead of|strong="H01115"\w* \w obeying|strong="H08085"\w* \w Me|strong="H00413"\w*. \v 13 \w So I will cast|strong="H02904"\w* \w you|strong="H00853"\w* \w out of|strong="H05921"\w* \w this|strong="H02063"\w* \w land|strong="H00776"\w* \w into|strong="H05921"\w* \w a land|strong="H00776"\w* \w that|strong="H00834"\w* \w neither|strong="H03808"\w* \w you|strong="H00859"\w* \w nor your fathers|strong="H00001"\w* \w have known|strong="H03045"\w*. \w There|strong="H08033"\w* \w -|strong="H00853"\w* \w you will serve|strong="H05647"\w* \w other|strong="H00312"\w* \w gods|strong="H00430"\w* \w day|strong="H03119"\w* \w and night|strong="H03915"\w*, \w for|strong="H00834"\w* \w I will show|strong="H05414"\w* you \w no|strong="H03808"\w* \w favor|strong="H02594"\w*.’
\s1 God Will Restore Israel
