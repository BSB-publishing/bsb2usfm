\p \v 33 \w Those slain|strong="H02491"\w* \w by the LORD|strong="H03068"\w* \w on that|strong="H01931"\w* \w day|strong="H03117"\w* \w will be spread|strong="H01961"\w* \w from [one] end|strong="H07097"\w* \w of the earth|strong="H00776"\w* \w to|strong="H05704"\w* \w the other|strong="H07097"\w* \w . . .|strong="H00776"\w*. \w They will not|strong="H03808"\w* \w be mourned|strong="H05594"\w*, \w . . .|strong="H03808"\w* \w gathered|strong="H00622"\w*, \w . . .|strong="H03808"\w* \w or buried|strong="H06912"\w*. \w They will be|strong="H01961"\w* \w like dung|strong="H01828"\w* \w lying|strong="H05921"\w* \w on|strong="H06440"\w* \w the ground|strong="H00127"\w*.
