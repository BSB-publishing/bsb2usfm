\s1 Jeremiah’s Message to Seraiah
\p \v 59 \w [This is] the message|strong="H01697"\w* \w that|strong="H00834"\w* \w Jeremiah|strong="H03414"\w* \w the prophet|strong="H05030"\w* \w -|strong="H00853"\w* \w gave|strong="H06680"\w* \w -|strong="H08304"\w* \w vvv|strong="H08269"\w* \w to the quartermaster|strong="H04496"\w* \w Seraiah|strong="H08304"\w* \w son|strong="H01121"\w* \w of Neriah|strong="H05374"\w*, \w the son|strong="H01121"\w* \w of Mahseiah|strong="H04271"\w*, \w when he went|strong="H01980"\w* \w to Babylon|strong="H00894"\w* \w with|strong="H00854"\w* \w King|strong="H04428"\w* \w Zedekiah|strong="H06667"\w* \w of Judah|strong="H03063"\w* \w in the fourth|strong="H07243"\w* \w year|strong="H08141"\w* \w of Zedekiah’s reign|strong="H04427"\w*. \v 60 \w Jeremiah|strong="H03414"\w* \w -|strong="H00853"\w* \w had written|strong="H03789"\w* \w on|strong="H00413"\w* \w a single|strong="H00259"\w* \w -|strong="H00853"\w* \w scroll|strong="H05612"\w* \w about all|strong="H03605"\w* \w the disaster|strong="H07451"\w* \w that|strong="H00834"\w* \w would come|strong="H00935"\w* \w upon|strong="H00413"\w* \w Babylon|strong="H00894"\w* — \w all|strong="H03605"\w* \w these|strong="H00428"\w* \w words|strong="H01697"\w* \w that had been written|strong="H03789"\w* \w concerning|strong="H00413"\w* \w Babylon|strong="H00894"\w*.
