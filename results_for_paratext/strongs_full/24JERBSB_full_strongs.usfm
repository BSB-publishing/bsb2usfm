\p \v 11 \w Then the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to me|strong="H00413"\w*, “\w Do not|strong="H00408"\w* \w pray|strong="H06419"\w* \w for|strong="H01157"\w* \w the well-being|strong="H02896"\w* \w of this|strong="H02088"\w* \w people|strong="H05971"\w*. \v 12 \w Although|strong="H03588"\w* \w they may fast|strong="H06684"\w*, \w I will not|strong="H00369"\w* \w listen to|strong="H08085"\w* \w . . .|strong="H00413"\w* \w their cry|strong="H07440"\w*; \w although|strong="H03588"\w* \w they may offer|strong="H05927"\w* \w burnt offerings|strong="H05930"\w* \w and grain offerings|strong="H04503"\w*, \w I will not|strong="H00369"\w* \w accept them|strong="H07521"\w*. \w Instead|strong="H03588"\w*, \w I|strong="H00595"\w* \w will finish them off|strong="H03615"\w* \w -|strong="H00853"\w* \w by sword|strong="H02719"\w* \w and famine|strong="H07458"\w* \w and plague|strong="H01698"\w*.”
