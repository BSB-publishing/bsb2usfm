17"\w* \w I attend to them again|strong="H06485"\w* \w -|strong="H00853"\w*,’ \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*. ‘\w Then I will bring them back|strong="H05927"\w* \w and restore them|strong="H07725"\w* \w to|strong="H00413"\w* \w this|strong="H02088"\w* \w place|strong="H04725"\w*.’”
\c 28
\s1 Hananiah’s False Prophecy
\p \v 1 \w In the fifth|strong="H02549"\w* \w month|strong="H02320"\w* \w -|strong="H01961"\w* \w of that same|strong="H01931"\w* \w year|strong="H08141"\w*, \w the fourth|strong="H07243"\w* \w year|strong="H08141"\w*, \w near the beginning|strong="H07225"\w* \w of the reign|strong="H04467"\w* \w of King|strong="H04428"\w* \w Zedekiah|strong="H06667"\w* \w of Judah|strong="H03063"\w*, \w the prophet|strong="H05030"\w* \w -|strong="H00834"\w* \w Hananiah|strong="H02608"\w* \w son|strong="H01121"\w* \w of Azzur|strong="H05809"\w*, \w who was from Gibeon|strong="H01391"\w*, \w said|strong="H00559"\w* \w to me|strong="H00413"\w* \w in the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w* \w in the presence|strong="H05869"\w* \w of the priests|strong="H03548"\w* \w and all|strong="H03605"\w* \w the people|strong="H05971"\w* \w -|strong="H00559"\w*: \v 2 “\w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w . . .|strong="H00559"\w* \w says|strong="H00559"\w*: ‘\w I have broken|strong="H07665"\w* \w -|strong="H00853"\w* \w the yoke|strong="H05923"\w* \w of the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*. \v 3 \w -|strong="H05750"\w* \w Within two years|strong="H08141"\w* \w . . .|strong="H03117"\w* \w I|strong="H00589"\w* \w will restore|strong="H07725"\w* \w to|strong="H00413"\w* \w this|strong="H02088"\w* \w -|strong="H00853"\w* \w place|strong="H04725"\w* \w all|strong="H03605"\w* \w the articles|strong="H03627"\w* \w of the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w* \w that|strong="H00834"\w* \w Nebuchadnezzar|strong="H05019"\w* \w king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w removed|strong="H03947"\w* \w from|strong="H04480"\w* \w . . .|strong="H04725"\w* \w here|strong="H02088"\w* \w and carried|strong="H00935"\w* \w to Babylon|strong="H00894"\w*. \v 4 \w And|strong="H00853"\w* \w I|strong="H00589"\w* \w will restore|strong="H07725"\w* \w to|strong="H00413"\w* \w this|strong="H02088"\w* \w place|strong="H04725"\w* \w Jeconiah|strong="H03204"\w*\f + \fr 28:4 \fqa Jeconiah \ft is a variant of \fqa Jehoiachin\ft ; see 2 Kings 24:12.\f* \w son|strong="H01121"\w* \w of Jehoiakim|strong="H03079"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w*, \w along with|strong="H00853"\w* \w all|strong="H03605"\w* \w the exiles|strong="H01546"\w* \w from Judah|strong="H03063"\w* \w who went|strong="H00935"\w* \w to Babylon|strong="H00894"\w*,’ \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, ‘\w for|strong="H03588"\w* \w I will break|strong="H07665"\w* \w -|strong="H00853"\w* \w the yoke|strong="H05923"\w* \w of the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*.’”
\p \v 5 \w Then the prophet|strong="H05030"\w* \w Jeremiah|strong="H03414"\w* \w replied|strong="H00559"\w* \w to|strong="H00413"\w* \w the prophet|strong="H05030"\w* \w Hananiah|strong="H02608"\w* \w in the presence|strong="H05869"\w* \w of the priests|strong="H03548"\w* \w . . .|strong="H05869"\w* \w and all|strong="H03605"\w* \w the people|strong="H05971"\w* \w who were standing|strong="H05975"\w* \w in the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*. \v 6 “\w Amen|strong="H00543"\w*!” \w -|strong="H05030"\w* \w Jeremiah|strong="H03414"\w* \w said|strong="H00559"\w*. “\w May the LORD|strong="H03068"\w* \w do|strong="H06213"\w* \w so|strong="H03651"\w*! \w May the LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w fulfill|strong="H06965"\w* \w the words|strong="H01697"\w* \w -|strong="H00834"\w* \w you have prophesied|strong="H05012"\w*, \w and may He restore|strong="H07725"\w* \w the articles|strong="H03627"\w* \w of [His]|strong="H03068"\w* \w house|strong="H01004"\w* \w and all|strong="H03605"\w* \w the exiles|strong="H01473"\w* \w back|strong="H00413"\w* \w to this|strong="H02088"\w* \w place|strong="H04725"\w* \w from Babylon|strong="H00894"\w*.
\p \v 7 \w Nevertheless|strong="H00389"\w*, \w listen|strong="H08085"\w* \w now|strong="H04994"\w* \w to this|strong="H02088"\w* \w -|strong="H00834"\w* \w message|strong="H01697"\w* \w I|strong="H00595"\w* \w am speaking|strong="H01696"\w* \w in your hearing|strong="H00241"\w* \w and in the hearing|strong="H00241"\w* \w of all|strong="H03605"\w* \w the people|strong="H05971"\w*. \v 8 \w The prophets|strong="H05030"\w* \w of old|strong="H05769"\w* \w who|strong="H00834"\w* \w preceded|strong="H01961"\w* \w . . .|strong="H06440"\w* \w you|strong="H04480"\w* \w and me|strong="H06440"\w* \w prophesied|strong="H05012"\w* \w war|strong="H04421"\w*, \w disaster|strong="H07451"\w*, \w and plague|strong="H01698"\w* \w against|strong="H00413"\w* \w many|strong="H07227"\w* \w . . .|strong="H05921"\w* \w lands|strong="H00776"\w* \w and great|strong="H01419"\w* \w kingdoms|strong="H04467"\w*. \v 9 \w As for the prophet|strong="H05030"\w* \w who|strong="H00834"\w* \w prophesies|strong="H05012"\w* \w peace|strong="H07965"\w*, \w only if the word|strong="H01697"\w* \w of the prophet|strong="H05030"\w* \w comes true|strong="H00935"\w* \w will the prophet|strong="H05030"\w* \w -|strong="H00834"\w* \w be recognized|strong="H03045"\w* \w as one the LORD|strong="H03068"\w* \w has truly|strong="H00571"\w* \w sent|strong="H07971"\w*.”
\p \v 10 \w Then the prophet|strong="H05030"\w* \w -|strong="H00853"\w* \w Hananiah|strong="H02608"\w* \w took|strong="H03947"\w* \w the yoke|strong="H04133"\w* \w off|strong="H05921"\w* \w the neck|strong="H06677"\w* \w of Jeremiah|strong="H03414"\w* \w the prophet|strong="H05030"\w* \w and broke it|strong="H07665"\w*. \v 11 \w And in the presence|strong="H05869"\w* \w of all|strong="H03605"\w* \w the people|strong="H05971"\w* \w Hananiah|strong="H02608"\w* \w proclaimed|strong="H00559"\w*, “\w This is what|strong="H03541"\w* \w -|strong="H00559"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: ‘\w In this way|strong="H03602"\w*, \w within two years|strong="H08141"\w* \w . . .|strong="H03117"\w* \w I will break|strong="H07665"\w* \w -|strong="H00853"\w* \w the yoke|strong="H05923"\w* \w of Nebuchadnezzar|strong="H05019"\w* \w king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w -|strong="H05750"\w* \w off|strong="H05921"\w* \w the neck|strong="H06677"\w* \w of all|strong="H03605"\w* \w the nations|strong="H01471"\w*.’”
\p \w At this, Jeremiah|strong="H03414"\w* \w the prophet|strong="H05030"\w* \w went|strong="H01980"\w* \w on his way|strong="H01870"\w*. \v 12 \w But shortly after|strong="H00310"\w* \w Hananiah|strong="H02608"\w* \w the prophet|strong="H05030"\w* \w -|strong="H00853"\w* \w had broken|strong="H07665"\w* \w the yoke|strong="H04133"\w* \w off|strong="H05921"\w* \w [his] neck|strong="H06677"\w* \w . . .|strong="H03414"\w* \w . . .|strong="H05030"\w* \w . . .|strong="H00559"\w*, \w the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w came|strong="H01961"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w*: \v 13 “\w Go|strong="H01980"\w* \w and tell|strong="H00559"\w* \w . . .|strong="H00413"\w* \w Hananiah|strong="H02608"\w* \w that this is what|strong="H03541"\w* \w . . .|strong="H00559"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: ‘\w You have broken|strong="H07665"\w* \w a yoke|strong="H04133"\w* \w of wood|strong="H06086"\w*, \w but in its place|strong="H08478"\w* \w you have fashioned|strong="H06213"\w* \w a yoke|strong="H04133"\w* \w of iron|strong="H01270"\w*.’
\p \v 14 \w For|strong="H03588"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w says|strong="H00559"\w*: ‘\w I have put|strong="H05414"\w* \w a yoke|strong="H05923"\w* \w of iron|strong="H01270"\w* \w on|strong="H05921"\w* \w the neck|strong="H06677"\w* \w of all|strong="H03605"\w* \w these|strong="H00428"\w* \w nations|strong="H01471"\w* \w to make them serve|strong="H05647"\w* \w -|strong="H00853"\w* \w Nebuchadnezzar|strong="H05019"\w* \w king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*, \w and they will serve him|strong="H05647"\w*. \w I have even|strong="H01571"\w* \w -|strong="H00853"\w* \w given him control|strong="H05414"\w* \w of the beasts|strong="H02416"\w* \w of the field|strong="H07704"\w*.’”
\p \v 15 \w Then the prophet|strong="H05030"\w* \w Jeremiah|strong="H03414"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w the prophet|strong="H05030"\w* \w Hananiah|strong="H02608"\w*, “\w Listen|strong="H08085"\w*, \w . . .|strong="H04994"\w* \w Hananiah|strong="H02608"\w*! \w The LORD|strong="H03068"\w* \w did not|strong="H03808"\w* \w send you|strong="H07971"\w*, \w but you|strong="H00859"\w* \w have persuaded|strong="H02088"\w* \w this people|strong="H05971"\w* \w to trust|strong="H00982"\w* \w -|strong="H00853"\w* \w in|strong="H05921"\w* \w a lie|strong="H08267"\w*. \v 16 \w Therefore|strong="H03651"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w . . .|strong="H02005"\w* \w says|strong="H00559"\w*: ‘\w I am about to remove you|strong="H07971"\w* \w from|strong="H05921"\w* \w the face|strong="H06440"\w* \w of the earth|strong="H00127"\w*. \w You|strong="H00859"\w* \w will die|strong="H04191"\w* \w this year|strong="H08141"\w* \w because|strong="H03588"\w* \w you have preached|strong="H01696"\w* \w rebellion|strong="H05627"\w* \w against|strong="H00413"\w* \w the LORD|strong="H03068"\w*.’”
\p \v 17 \w And in the seventh|strong="H07637"\w* \w month|strong="H02320"\w* \w of that very|strong="H01931"\w* \w year|strong="H08141"\w*, \w the prophet|strong="H05030"\w* \w Hananiah|strong="H02608"\w* \w died|strong="H04191"\w*.
\c 29
\s1 Jeremiah’s Letter to the Exiles
\p \v 1 \w This|strong="H00428"\w* \w is the text|strong="H01697"\w* \w of the letter|strong="H05612"\w* \w that|strong="H00834"\w* \w Jeremiah|strong="H03414"\w* \w the prophet|strong="H05030"\w* \w sent|strong="H07971"\w* \w from Jerusalem|strong="H03389"\w* \w to|strong="H00413"\w* \w the surviving|strong="H03499"\w* \w elders|strong="H02205"\w* \w among the exiles|strong="H01473"\w* \w and to|strong="H00413"\w* \w the priests|strong="H03548"\w*, \w . . .|strong="H00413"\w* \w the prophets|strong="H05030"\w*, \w . . .|strong="H00413"\w* \w and all|strong="H03605"\w* \w the others|strong="H05971"\w* \w -|strong="H00834"\w* \w Nebuchadnezzar|strong="H05019"\w* \w had carried into exile|strong="H01540"\w* \w from Jerusalem|strong="H03389"\w* \w to Babylon|strong="H00894"\w*. \v 2 (\w This was after|strong="H00310"\w* \w King|strong="H04428"\w* \w Jeconiah|strong="H03204"\w*,\f + \fr 29:2 \fqa Jeconiah \ft is a variant of \fqa Jehoiachin\ft ; see 2 Kings 24:12.\f* \w the queen mother|strong="H01377"\w*, \w the court officials|strong="H05631"\w*, \w the officials|strong="H08269"\w* \w of Judah|strong="H03063"\w* \w and Jerusalem|strong="H03389"\w*, \w the craftsmen|strong="H02796"\w*, \w and the metalsmiths|strong="H04525"\w* \w had been exiled|strong="H03318"\w* \w from Jerusalem|strong="H03389"\w*.) \v 3 \w The letter was entrusted to|strong="H03027"\w* \w Elasah|strong="H00501"\w* \w son|strong="H01121"\w* \w of Shaphan|strong="H08227"\w* \w and Gemariah|strong="H01587"\w* \w son|strong="H01121"\w* \w of Hilkiah|strong="H02518"\w*, \w whom|strong="H00834"\w* \w Zedekiah|strong="H06667"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w sent|strong="H07971"\w* \w to|strong="H00413"\w* \w King|strong="H04428"\w* \w Nebuchadnezzar|strong="H05019"\w* \w in Babylon|strong="H00894"\w* \w . . .|strong="H00894"\w*. \w It stated|strong="H00559"\w*:
\pmo \v 4 \w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w says|strong="H00559"\w* \w to all|strong="H03605"\w* \w the exiles|strong="H01473"\w* \w -|strong="H00834"\w* \w who were carried away|strong="H01540"\w* \w from Jerusalem|strong="H03389"\w* \w to Babylon|strong="H00894"\w*: \v 5 “\w Build|strong="H01129"\w* \w houses|strong="H01004"\w* \w and settle down|strong="H03427"\w*. \w Plant|strong="H05193"\w* \w gardens|strong="H01593"\w* \w and eat|strong="H00398"\w* \w -|strong="H00853"\w* \w their produce|strong="H06529"\w*. \v 6 \w Take|strong="H03947"\w* \w wives|strong="H00802"\w* \w and have|strong="H03205"\w* \w sons|strong="H01121"\w* \w and daughters|strong="H01323"\w*. \w Take|strong="H03947"\w* \w wives|strong="H00802"\w* \w -|strong="H00853"\w* \w for your sons|strong="H01121"\w* \w and give|strong="H05414"\w* \w your daughters|strong="H01323"\w* \w in marriage|strong="H00582"\w*, \w so that they too may have|strong="H03205"\w* \w sons|strong="H01121"\w* \w and daughters|strong="H01323"\w*. \w Multiply|strong="H07235"\w* \w there|strong="H08033"\w*; \w do not|strong="H00408"\w* \w decrease|strong="H04591"\w*. \v 7 \w Seek|strong="H01875"\w* \w -|strong="H00853"\w* \w the prosperity|strong="H07965"\w* \w of the city|strong="H05892"\w* \w to which|strong="H00834"\w* \w I have sent you as exiles|strong="H01540"\w*. \w -|strong="H00853"\w* \w -|strong="H08033"\w* \w Pray|strong="H06419"\w* \w to|strong="H00413"\w* \w the LORD|strong="H03068"\w* \w on its behalf|strong="H01157"\w*, \w for|strong="H03588"\w* \w if it prospers|strong="H07965"\w*, \w . . .|strong="H01961"\w* you too \w will prosper|strong="H07965"\w*.”
\pmo \v 8 \w For|strong="H03588"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w says|strong="H00559"\w*: “\w Do not|strong="H00408"\w* \w be deceived|strong="H05377"\w* \w by the prophets|strong="H05030"\w* \w and diviners|strong="H07080"\w* \w -|strong="H00834"\w* \w among you|strong="H07130"\w*, \w and do not|strong="H00408"\w* \w listen|strong="H08085"\w* \w to|strong="H00413"\w* \w the dreams|strong="H02472"\w* \w -|strong="H00834"\w* \w you elicit from them|strong="H00859"\w* \w . . .|strong="H02492"\w*. \v 9 \w For|strong="H03588"\w* \w they|strong="H01992"\w* \w are falsely prophesying|strong="H05012"\w* \w . . .|strong="H08267"\w* to you \w in My name|strong="H08034"\w*; \w I have not|strong="H03808"\w* \w sent them|strong="H07971"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*.”\f + \fr 29:9 \ft Some translators close the written portion of this letter later in the chapter.\f*
\p \v 10 \w For|strong="H03588"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: “\w When|strong="H03588"\w* \w . . .|strong="H06310"\w* \w Babylon’s|strong="H00894"\w* \w seventy|strong="H07657"\w* \w years|strong="H08141"\w* \w are complete|strong="H04390"\w*, \w I will attend to|strong="H06485"\w* \w you|strong="H00853"\w* \w and confirm|strong="H06965"\w* \w My promise|strong="H01697"\w* \w . . .|strong="H02896"\w* \w -|strong="H05921"\w* \w -|strong="H00853"\w* \w to restore|strong="H07725"\w* \w you|strong="H00853"\w* \w to|strong="H00413"\w* \w this|strong="H02088"\w* \w place|strong="H04725"\w*. \v 11 \w For|strong="H03588"\w* \w I|strong="H00595"\w* \w know|strong="H03045"\w* \w -|strong="H00853"\w* \w the plans|strong="H04284"\w* \w -|strong="H00834"\w* \w I|strong="H00595"\w* \w have|strong="H02803"\w* \w for you|strong="H05921"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, \w plans|strong="H04284"\w* \w to prosper you|strong="H07965"\w* \w and not|strong="H03808"\w* \w to harm you|strong="H07451"\w*, \w to give|strong="H05414"\w* you \w a future|strong="H00319"\w* \w and a hope|strong="H08615"\w*. \v 12 \w Then you will call|strong="H07121"\w* \w upon Me|strong="H00853"\w* \w and come|strong="H01980"\w* \w and pray|strong="H06419"\w* \w to Me|strong="H00413"\w*, \w and I will listen|strong="H08085"\w* \w to you|strong="H00413"\w*. \v 13 \w You will seek|strong="H01245"\w* \w Me|strong="H00853"\w* \w and find Me|strong="H04672"\w* \w when|strong="H03588"\w* \w you search for Me|strong="H01875"\w* \w with all|strong="H03605"\w* \w your heart|strong="H03824"\w*. \v 14 \w I will be found|strong="H04672"\w* by you, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, \w and I will restore you|strong="H07725"\w* \w -|strong="H00853"\w* \w from captivity|strong="H07622"\w*\f + \fr 29:14 \ft Or \fqa restore your fortunes\f* \w and gather|strong="H06908"\w* \w you|strong="H00853"\w* \w from all|strong="H03605"\w* \w the nations|strong="H01471"\w* \w . . .|strong="H03605"\w* \w and places|strong="H04725"\w* \w to which|strong="H00834"\w* \w I have banished you|strong="H05080"\w*, \w -|strong="H00853"\w* \w -|strong="H08033"\w* \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*. \w I will restore|strong="H07725"\w* \w -|strong="H00853"\w* \w you to|strong="H00413"\w* \w the place|strong="H04725"\w* \w from which|strong="H00834"\w* \w I sent|strong="H01540"\w* \w you|strong="H00853"\w* \w into exile|strong="H08033"\w*.”
\p \v 15 \w Because|strong="H03588"\w* \w you may say|strong="H00559"\w*, “\w The LORD|strong="H03068"\w* \w has raised up|strong="H06965"\w* for us \w prophets|strong="H05030"\w* \w in Babylon|strong="H00894"\w*,” \v 16 \w -|strong="H03588"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w* \w about|strong="H00413"\w* \w the king|strong="H04428"\w* \w who sits|strong="H03427"\w* \w on|strong="H00413"\w* \w David’s|strong="H01732"\w* \w throne|strong="H03678"\w* \w and|strong="H00413"\w* \w all|strong="H03605"\w* \w the people|strong="H05971"\w* \w who remain|strong="H03427"\w* \w in this|strong="H02063"\w* \w city|strong="H05892"\w*, \w your brothers|strong="H00251"\w* \w who|strong="H00834"\w* \w did not|strong="H03808"\w* \w go|strong="H03318"\w* \w with you|strong="H00854"\w* \w into exile|strong="H01473"\w*— \v 17 \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w* \w . . .|strong="H02005"\w* \w says|strong="H00559"\w*:
\p “\w I will send|strong="H07971"\w* against them\w . . .|strong="H00853"\w* \w sword|strong="H02719"\w* \w -|strong="H00853"\w* \w and famine|strong="H07458"\w* \w -|strong="H00853"\w* \w and plague|strong="H01698"\w*, \w and I will make|strong="H05414"\w* \w them|strong="H00853"\w* \w like rotten|strong="H08182"\w* \w figs|strong="H08384"\w*, \w so bad|strong="H07455"\w* \w -|strong="H00834"\w* \w they cannot|strong="H03808"\w* \w be eaten|strong="H00398"\w*. \v 18 \w I will pursue|strong="H07291"\w* \w them|strong="H00310"\w* \w with sword|strong="H02719"\w* \w and famine|strong="H07458"\w* \w and plague|strong="H01698"\w*. \w I will make them|strong="H05414"\w* \w a horror|strong="H02113"\w* \w to all|strong="H03605"\w* \w the kingdoms|strong="H04467"\w* \w of the earth|strong="H00776"\w*— \w a curse|strong="H00423"\w*, \w a desolation|strong="H08047"\w*, \w and an object of scorn|strong="H08322"\w* \w and reproach|strong="H02781"\w* \w among all|strong="H03605"\w* \w the nations|strong="H01471"\w* \w to which|strong="H00834"\w* \w I banish them|strong="H05080"\w* \w . . .|strong="H08033"\w*. \v 19 \w I will do this because|strong="H08478"\w* \w -|strong="H00834"\w* \w they have not|strong="H03808"\w* \w listened|strong="H08085"\w* \w to|strong="H00413"\w* \w My words|strong="H01697"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*,\w which|strong="H00834"\w* \w I sent|strong="H07971"\w* \w to|strong="H00413"\w* \w them|strong="H00853"\w* \w again and again|strong="H07925"\w* \w . . .|strong="H07971"\w*\f + \fr 29:19 \ft Literally \fqa I sent to them, rising up early and sending (to them)\f* \w through My servants|strong="H05650"\w* \w the prophets|strong="H05030"\w*. \w And neither have you [exiles]|strong="H03808"\w* \w listened|strong="H08085"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*.”
\p \v 20 \w -|strong="H00859"\w* \w So hear|strong="H08085"\w* \w the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w*, \w all|strong="H03605"\w* \w you exiles|strong="H01473"\w* \w -|strong="H00834"\w* \w I have sent away|strong="H07971"\w* \w from Jerusalem|strong="H03389"\w* \w to Babylon|strong="H00894"\w*. \v 21 \w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w says|strong="H00559"\w* \w about|strong="H00413"\w* \w Ahab|strong="H00256"\w* \w son|strong="H01121"\w* \w of Kolaiah|strong="H06964"\w* \w and|strong="H00413"\w* \w Zedekiah|strong="H06667"\w* \w son|strong="H01121"\w* \w of Maaseiah|strong="H04641"\w*, \w who are prophesying|strong="H05012"\w* to you \w lies|strong="H08267"\w* \w . . .|strong="H02005"\w* \w in My name|strong="H08034"\w*: “\w I will deliver|strong="H05414"\w* \w them|strong="H00853"\w* \w to|strong="H03027"\w* \w Nebuchadnezzar|strong="H05019"\w* \w king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*, \w and he will kill them|strong="H05221"\w* \w before your very eyes|strong="H05869"\w*. \v 22 \w Because|strong="H03947"\w* of them, \w all|strong="H03605"\w* \w the exiles|strong="H01546"\w* \w of Judah|strong="H03063"\w* \w who|strong="H00834"\w* \w are in Babylon|strong="H00894"\w* \w will use this curse|strong="H07045"\w* \w . . .|strong="H00559"\w*: ‘\w May the LORD|strong="H03068"\w* \w make|strong="H07760"\w* \w you like Zedekiah|strong="H06667"\w* \w and Ahab|strong="H00256"\w*, \w whom|strong="H00834"\w* \w the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w roasted|strong="H07033"\w* \w in the fire|strong="H00784"\w*!’ \v 23 \w For|strong="H03282"\w* \w -|strong="H00834"\w* \w they have committed|strong="H06213"\w* \w an outrage|strong="H05039"\w* \w in Israel|strong="H03478"\w* \w by committing adultery|strong="H05003"\w* \w with|strong="H00853"\w* \w the wives|strong="H00802"\w* \w of their neighbors|strong="H07453"\w* \w and speaking|strong="H01696"\w* \w . . .|strong="H01697"\w* \w lies|strong="H08267"\w* \w in My name|strong="H08034"\w*, \w which|strong="H00834"\w* \w I did not|strong="H03808"\w* \w command them [to do]|strong="H06680"\w*. \w I|strong="H00595"\w* \w am He who knows|strong="H01931"\w*, \w and I am a witness|strong="H05707"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*.”
\s1 The Message to Shemaiah
\p \v 24 \w You are to tell|strong="H00559"\w* \w -|strong="H00413"\w* \w Shemaiah|strong="H08098"\w* \w the Nehelamite|strong="H05161"\w* \w that|strong="H00559"\w* \v 25 \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w says|strong="H00559"\w* \w -|strong="H00559"\w* \w -|strong="H03282"\w* \w -|strong="H00834"\w*: “\w In your own name|strong="H08034"\w* \w you|strong="H00859"\w* \w have sent out|strong="H07971"\w* \w letters|strong="H05612"\w* \w to|strong="H00413"\w* \w all|strong="H03605"\w* \w the people|strong="H05971"\w* \w -|strong="H00834"\w* \w of Jerusalem|strong="H03389"\w*, \w to|strong="H00413"\w* \w the priest|strong="H03548"\w* \w Zephaniah|strong="H06846"\w* \w son|strong="H01121"\w* \w of Maaseiah|strong="H04641"\w*, \w and to|strong="H00413"\w* \w all|strong="H03605"\w* \w the priests|strong="H03548"\w*. \w You said [to Zephaniah]|strong="H00559"\w*:\f + \fr 29:25 \ft Hebrew \fqa You said\ft ; the addressee \fqa Zephaniah \ft is added for clarity.\f*
\pmo \v 26 ‘\w The LORD|strong="H03068"\w* \w has appointed|strong="H05414"\w* \w you priest|strong="H03548"\w* \w in place of|strong="H08478"\w* \w Jehoiada|strong="H03077"\w*, \w -|strong="H03548"\w* \w to be|strong="H01961"\w* \w the chief officer|strong="H06496"\w* \w in the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*, \w responsible for any|strong="H03605"\w* \w madman|strong="H00376"\w* \w . . .|strong="H07696"\w* \w who acts like a prophet|strong="H05012"\w* — \w you must put|strong="H05414"\w* \w him|strong="H00853"\w* \w in|strong="H00413"\w* \w stocks|strong="H04115"\w* \w . . .|strong="H00413"\w* \w and neck irons|strong="H06729"\w*. \v 27 \w So now|strong="H06258"\w*, \w why|strong="H04100"\w* \w have you not|strong="H03808"\w* \w rebuked|strong="H01605"\w* \w Jeremiah|strong="H03414"\w* \w of Anathoth|strong="H06069"\w*, \w who poses as a prophet|strong="H05012"\w* among you? \v 28 \w For|strong="H03588"\w* \w . . .|strong="H05921"\w* \w . . .|strong="H03651"\w* \w he has sent|strong="H07971"\w* \w to us|strong="H00413"\w* \w [in] Babylon|strong="H00894"\w*, \w claiming|strong="H00559"\w*: \w Since the exile|strong="H01931"\w* \w will be lengthy|strong="H00752"\w*, \w build|strong="H01129"\w* \w houses|strong="H01004"\w* \w and settle down|strong="H03427"\w*; \w plant|strong="H05193"\w* \w gardens|strong="H01593"\w* \w and eat|strong="H00398"\w*\w . . .|strong="H00853"\w* \w their produce|strong="H06529"\w*.’”
\p \v 29 (\w Zephaniah|strong="H06846"\w* \w the priest|strong="H03548"\w* \w -|strong="H00853"\w*, \w however, had read|strong="H07121"\w* \w this|strong="H02088"\w* \w letter|strong="H05612"\w* \w [to]|strong="H00241"\w* \w Jeremiah|strong="H03414"\w* \w the prophet|strong="H05030"\w*.)
\p \v 30 \w Then the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w came|strong="H01961"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w*: \w . . .|strong="H00559"\w* \v 31 “\w Send|strong="H07971"\w* \w a message|strong="H05921"\w* \w telling|strong="H00559"\w* \w all|strong="H03605"\w* \w the exiles|strong="H01473"\w* \w what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w* \w concerning|strong="H00413"\w* \w Shemaiah|strong="H08098"\w* \w the Nehelamite|strong="H05161"\w*. \w Because|strong="H03282"\w* \w -|strong="H00834"\w* \w Shemaiah|strong="H08098"\w* \w has prophesied|strong="H05012"\w* to you— \w though I|strong="H00589"\w* \w did not|strong="H03808"\w* \w send him|strong="H07971"\w*— \w and has made you trust|strong="H00982"\w* \w -|strong="H00853"\w* \w in|strong="H05921"\w* \w a lie|strong="H08267"\w*, \v 32 \w -|strong="H03651"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: ‘\w vvv|strong="H02005"\w* \w I will surely punish|strong="H06485"\w*\w . . .|strong="H05921"\w* \w Shemaiah|strong="H08098"\w* \w the Nehelamite|strong="H05161"\w* \w . . .|strong="H05921"\w* \w and his descendants|strong="H02233"\w*. \w He will have|strong="H01961"\w* \w no|strong="H03808"\w* \w one|strong="H00376"\w* \w left|strong="H03427"\w* \w among|strong="H08432"\w* \w this|strong="H02088"\w* \w people|strong="H05971"\w*, \w nor|strong="H03808"\w* \w will he see|strong="H07200"\w* \w the good|strong="H02896"\w* \w that|strong="H00834"\w* \w I|strong="H00589"\w* \w will bring|strong="H06213"\w* \w to My people|strong="H05971"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, \w for|strong="H03588"\w* \w he has preached|strong="H01696"\w* \w rebellion|strong="H05627"\w* \w against|strong="H05921"\w* \w the LORD|strong="H03068"\w*.’”
\c 30
\s1 The Restoration of Israel and Judah
\r (Ezekiel 28:25–26)
\p \v 1 \w This is the word|strong="H01697"\w* \w that|strong="H00834"\w* \w came|strong="H01961"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w from|strong="H00854"\w* \w the LORD|strong="H03068"\w* \w . . .|strong="H00559"\w*: \v 2 “\w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w . . .|strong="H00559"\w* \w says|strong="H00559"\w*: ‘\w Write|strong="H03789"\w* \w -|strong="H00853"\w* \w in|strong="H00413"\w* \w a book|strong="H05612"\w* \w all|strong="H03605"\w* \w the words|strong="H01697"\w* \w that|strong="H00834"\w* \w I have spoken|strong="H01696"\w* \w to you|strong="H00413"\w*. \v 3 \w For|strong="H03588"\w* \w behold|strong="H02009"\w*, \w the days|strong="H03117"\w* \w are coming|strong="H00935"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, \w when I will restore|strong="H07725"\w* \w -|strong="H00853"\w* \w from captivity|strong="H07622"\w*\f + \fr 30:3 \ft Or \fqa restore the fortunes of\f* \w My people|strong="H05971"\w* \w Israel|strong="H03478"\w* \w and Judah|strong="H03063"\w*, \w declares|strong="H00559"\w* \w the LORD|strong="H03068"\w*. \w I will restore them|strong="H07725"\w* \w to|strong="H00413"\w* \w the land|strong="H00776"\w* \w that|strong="H00834"\w* \w I gave|strong="H05414"\w* \w to their fathers|strong="H00001"\w*, \w and they will possess it|strong="H03423"\w*.’”
\p \v 4 \w These|strong="H00428"\w* \w are the words|strong="H01697"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w spoke|strong="H01696"\w* \w concerning|strong="H00413"\w* \w Israel|strong="H03478"\w* \w . . .|strong="H00413"\w* \w and Judah|strong="H03063"\w*. \v 5 \w Yes|strong="H03588"\w*, \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*:
\b 
\q1 “\w A cry|strong="H06963"\w* \w of panic|strong="H02731"\w* \w is heard|strong="H08085"\w* —
\q2 \w [a cry] of terror|strong="H06343"\w*, \w not|strong="H00369"\w* \w of peace|strong="H07965"\w*.
\q1 \v 6 \w Ask|strong="H07592"\w* \w now|strong="H04994"\w*, \w and see|strong="H07200"\w*:
\q2 \w Can|strong="H00518"\w* \w a male|strong="H02145"\w* \w give birth|strong="H03205"\w*?
\q1 \w Why then|strong="H04069"\w* \w do I see|strong="H07200"\w* \w every|strong="H03605"\w* \w man|strong="H01397"\w*
\q2 \w with his hands|strong="H03027"\w* \w on|strong="H05921"\w* \w his stomach|strong="H02504"\w* \w like a woman in labor|strong="H03205"\w*
\q2 \w and every|strong="H03605"\w* \w face|strong="H06440"\w* \w turned|strong="H02015"\w* \w pale|strong="H03420"\w*?
\q1 \v 7 \w How|strong="H03588"\w* \w . . .|strong="H01419"\w* \w awful|strong="H01945"\w* \w that|strong="H01931"\w* \w day will be|strong="H03117"\w*!
\q2 \w None will be|strong="H00369"\w* \w like it|strong="H03644"\w*!
\q1 \w It is|strong="H01931"\w* \w the time|strong="H06256"\w* \w of Jacob’s|strong="H03290"\w* \w distress|strong="H06869"\w*,
\q2 \w but he will be saved|strong="H03467"\w* \w out of it|strong="H04480"\w*.
\b 
\q1 \v 8 \w -|strong="H01961"\w* \w On that|strong="H01931"\w* \w day|strong="H03117"\w*,
\q2 \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*,
\q1 \w I will break|strong="H07665"\w* \w the yoke|strong="H05923"\w* \w off|strong="H05921"\w* \w their necks|strong="H06677"\w*
\q2 \w and tear off|strong="H05423"\w* \w their bonds|strong="H04147"\w*,
\q2 \w and no|strong="H03808"\w* \w longer|strong="H05750"\w* \w will strangers|strong="H02114"\w* \w enslave|strong="H05647"\w* them.
\q1 \v 9 \w Instead, they will serve|strong="H05647"\w* \w -|strong="H00853"\w* \w the LORD|strong="H03068"\w* \w their God|strong="H00430"\w*
\q2 \w and|strong="H00853"\w* \w David|strong="H01732"\w* \w their king|strong="H04428"\w*,
\q2 \w whom|strong="H00834"\w* \w I will raise up|strong="H06965"\w* for them.
\b 
\q1 \v 10 \w As for you|strong="H00859"\w*, \w O Jacob|strong="H03290"\w* \w My servant|strong="H05650"\w*, \w do not|strong="H00408"\w* \w be afraid|strong="H03372"\w*,
\q2 \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*,
\q1 \w and do not|strong="H00408"\w* \w be dismayed|strong="H02865"\w*,
\q2 \w O Israel|strong="H03478"\w*.
\q1 \w For|strong="H03588"\w* \w vvv|strong="H02005"\w* \w I will surely save you|strong="H03467"\w* \w out of a distant place|strong="H07350"\w*,
\q2 \w -|strong="H00853"\w* \w your descendants|strong="H02233"\w* \w from the land|strong="H00776"\w* \w of their captivity|strong="H07628"\w*!
\q1 \w Jacob|strong="H03290"\w* \w will return|strong="H07725"\w* \w to quiet|strong="H08252"\w* \w and ease|strong="H07599"\w*,
\q2 \w with no one|strong="H00369"\w* \w to make him afraid|strong="H02729"\w*.
