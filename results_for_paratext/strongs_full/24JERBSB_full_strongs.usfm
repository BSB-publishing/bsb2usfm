\c 51
\s1 Judgment on Babylon
\p \v 1 \w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*:
\b 
\q1 “\w Behold|strong="H02005"\w*, \w I will stir up|strong="H05782"\w* \w against|strong="H05921"\w* \w Babylon|strong="H00894"\w*
\q2 \w and against|strong="H00413"\w* \w the people|strong="H03427"\w* \w of Leb-kamai|strong="H03820"\w* \w . . .|strong="H06965"\w*\f + \fr 51:1 \fqa Leb-kamai \ft is a code name for Chaldea, that is, Babylonia.\f*
\q2 \w the spirit|strong="H07307"\w* \w of a destroyer|strong="H07843"\w*.
