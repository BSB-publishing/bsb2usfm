\p \v 1 \w In the ninth|strong="H08671"\w* \w year|strong="H08141"\w* \w of Zedekiah|strong="H06667"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w*, \w in the tenth|strong="H06224"\w* \w month|strong="H02320"\w*, \w Nebuchadnezzar|strong="H05019"\w* \w king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w marched|strong="H00935"\w* \w against|strong="H00413"\w* \w Jerusalem|strong="H03389"\w* \w with his entire|strong="H03605"\w* \w army|strong="H02428"\w* \w and laid siege|strong="H06696"\w* \w to [the city]|strong="H05921"\w*. \v 2 \w And on the ninth|strong="H08672"\w* \w day|strong="H02320"\w* \w of the fourth|strong="H07243"\w* \w month|strong="H02320"\w* \w of Zedekiah’s|strong="H06667"\w* \w eleventh|strong="H06249"\w* \w . . .|strong="H06240"\w* \w year|strong="H08141"\w*, \w the city|strong="H05892"\w* \w was breached|strong="H01234"\w*.
