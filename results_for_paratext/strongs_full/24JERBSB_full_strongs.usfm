\q1 \w They enter|strong="H00935"\w* \w the thickets|strong="H05645"\w*
\q2 \w and climb|strong="H05927"\w* \w among the rocks|strong="H03710"\w*.
\q1 \w Every|strong="H03605"\w* \w city|strong="H05892"\w* \w is abandoned|strong="H05800"\w*;
\q2 \w no|strong="H00369"\w* \w inhabitant is left|strong="H03427"\w*. . . . \w . . .|strong="H00376"\w*
\b 
\q1 \v 30 \w And you|strong="H00859"\w*, \w O devastated|strong="H07703"\w* \w one|strong="H04100"\w*, \w what will you do|strong="H06213"\w*,
