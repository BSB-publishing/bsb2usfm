\c 50
\s1 A Prophecy against Babylon
\p \v 1 \w [This is] the word|strong="H01697"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w spoke|strong="H01696"\w* \w through|strong="H03027"\w* \w Jeremiah|strong="H03414"\w* \w the prophet|strong="H05030"\w* \w concerning|strong="H00413"\w* \w Babylon|strong="H00894"\w* \w and|strong="H00413"\w* \w the land|strong="H00776"\w* \w of the Chaldeans|strong="H03778"\w*:\f + \fr 50:1 \ft That is, the Babylonians; also in verses 8, 25, 35, and 45\f*
\b 
