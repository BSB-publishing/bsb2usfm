\p \v 25 \w The LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w says|strong="H00559"\w*: “\w Behold|strong="H02005"\w*, \w I am about to punish|strong="H06485"\w* \w . . .|strong="H00413"\w* \w Amon|strong="H00528"\w* \w [god] of Thebes|strong="H04996"\w*,\f + \fr 46:25 \ft Hebrew \fqa Amon of No\f* \w . . .|strong="H05921"\w* \w along with Pharaoh|strong="H06547"\w*, \w -|strong="H05921"\w* \w Egypt|strong="H04714"\w* \w with|strong="H05921"\w* \w her gods|strong="H00430"\w* \w . . .|strong="H05921"\w* \w and kings|strong="H04428"\w* \w . . .|strong="H05921"\w*, \w . . .|strong="H05921"\w* \w and those who trust|strong="H00982"\w* \w in Pharaoh|strong="H06547"\w*. \v 26 \w I will deliver them|strong="H05414"\w* \w into the hands|strong="H03027"\w* \w of those who seek|strong="H01245"\w* \w their lives|strong="H05315"\w* \w . . .|strong="H03027"\w*— \w of Nebuchadnezzar|strong="H05019"\w* \w king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w . . .|strong="H03027"\w* \w and his officers|strong="H05650"\w*. \w But after|strong="H00310"\w* \w this|strong="H03651"\w*, \w [Egypt] will be inhabited|strong="H07931"\w* \w as in days|strong="H03117"\w* \w of old|strong="H06924"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*.
\b 
\q1 \v 27 \w But you|strong="H00859"\w*, \w O Jacob|strong="H03290"\w* \w My servant|strong="H05650"\w*, \w do not|strong="H00408"\w* \w be afraid|strong="H03372"\w*,
\q2 \w and do not|strong="H00408"\w* \w be dismayed|strong="H02865"\w*, \w O Israel|strong="H03478"\w*.
\q1 \w For|strong="H03588"\w* \w vvv|strong="H02005"\w* \w I will surely save you|strong="H03467"\w* \w out of a distant place|strong="H07350"\w*,
