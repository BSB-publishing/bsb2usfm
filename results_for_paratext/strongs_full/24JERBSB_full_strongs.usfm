\q1 \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*,
\q2 \w before|strong="H06440"\w* \w His fierce|strong="H02740"\w* \w anger|strong="H00639"\w*.
\b 
\q1 
\p \v 27 \w For|strong="H03588"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*:
\b 
\q1 “\w The whole|strong="H03605"\w* \w land|strong="H00776"\w* \w will be|strong="H01961"\w* \w desolate|strong="H08077"\w*,
\q2 \w but I will not|strong="H03808"\w* \w finish its destruction|strong="H03617"\w* \w . . .|strong="H06213"\w*.
