\q1 \w I have spoken|strong="H01696"\w*, \w I have planned|strong="H02161"\w*,
\q2 \w and I will not|strong="H03808"\w* \w relent|strong="H05162"\w* \w . . .|strong="H03808"\w* \w or turn back|strong="H07725"\w* \w . . .|strong="H04480"\w*.”
\b 
\q1 \v 29 \w Every|strong="H03605"\w* \w city|strong="H05892"\w* \w flees|strong="H01272"\w*
