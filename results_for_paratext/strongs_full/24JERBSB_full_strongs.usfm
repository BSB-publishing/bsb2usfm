\q2 \w the temple|strong="H01964"\w* \w of the LORD|strong="H03068"\w*.’
\p \v 5 \w For|strong="H03588"\w* \w if|strong="H00518"\w* \w you really correct|strong="H03190"\w* \w . . .|strong="H03190"\w* \w -|strong="H00853"\w* \w your ways|strong="H01870"\w* \w -|strong="H00853"\w* \w and deeds|strong="H04611"\w*, \w if|strong="H00518"\w* \w you act|strong="H06213"\w* \w . . .|strong="H06213"\w* \w justly|strong="H04941"\w* \w . . .|strong="H00996"\w* \w toward one|strong="H00376"\w* \w . . .|strong="H00996"\w* \w another|strong="H07453"\w*, \v 6 \w if you no|strong="H03808"\w* \w longer oppress|strong="H06231"\w* \w the foreigner|strong="H01616"\w* \w [and] the fatherless|strong="H03490"\w* \w and the widow|strong="H00490"\w*, \w and [if you] no|strong="H00408"\w* \w longer shed|strong="H08210"\w* \w innocent|strong="H05355"\w* \w blood|strong="H01818"\w* \w in this|strong="H02088"\w* \w place|strong="H04725"\w* \w or follow|strong="H00310"\w* \w . . .|strong="H01980"\w* \w other|strong="H00312"\w* \w . . .|strong="H03808"\w* \w gods|strong="H00430"\w* \w to your own harm|strong="H07451"\w*, \v 7 \w then I will let you live|strong="H07931"\w* \w -|strong="H00853"\w* \w in this|strong="H02088"\w* \w place|strong="H04725"\w*, \w in the land|strong="H00776"\w* \w that|strong="H00834"\w* \w I gave|strong="H05414"\w* \w to your fathers|strong="H00001"\w* \w forever|strong="H04480"\w* \w . . .|strong="H05769"\w* \w and|strong="H05704"\w* \w ever|strong="H05769"\w*.
\p \v 8 \w But look|strong="H02009"\w*, \w you|strong="H00859"\w* \w keep trusting|strong="H00982"\w* \w in|strong="H05921"\w* \w deceptive|strong="H08267"\w* \w words|strong="H01697"\w* \w to no|strong="H01115"\w* \w avail|strong="H03276"\w*. \v 9 \w Will you steal|strong="H01589"\w* \w and murder|strong="H07523"\w*, \w commit adultery|strong="H05003"\w* \w and perjury|strong="H07650"\w* \w . . .|strong="H08267"\w*, \w burn incense|strong="H06999"\w* \w to Baal|strong="H01168"\w*, \w and follow|strong="H01980"\w* \w . . .|strong="H00310"\w* \w other|strong="H00312"\w* \w gods|strong="H00430"\w* \w that|strong="H00834"\w* \w you have not|strong="H03808"\w* \w known|strong="H03045"\w*, \v 10 \w and then come|strong="H00935"\w* \w and stand|strong="H05975"\w* \w before Me|strong="H06440"\w* \w in this|strong="H02088"\w* \w -|strong="H00834"\w* \w house|strong="H01004"\w*, \w which bears|strong="H07121"\w* \w My Name|strong="H08034"\w* \w . . .|strong="H05921"\w*, \w and say|strong="H00559"\w*, ‘\w We are delivered|strong="H05337"\w*, \w so|strong="H04616"\w* \w we can continue with|strong="H06213"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w these|strong="H00428"\w* \w abominations|strong="H08441"\w*’? \v 11 \w Has this|strong="H02088"\w* \w house|strong="H01004"\w*, \w which|strong="H00834"\w* \w bears|strong="H07121"\w* \w My Name|strong="H08034"\w*, \w become|strong="H01961"\w* \w a den|strong="H04631"\w* \w of robbers|strong="H06530"\w*\f + \fr 7:11 \ft Cited in Matthew 21:13, Mark 11:17, and Luke 19:46\f* \w in|strong="H05921"\w* \w your sight|strong="H05869"\w*? \w Yes|strong="H02009"\w*, \w I|strong="H00595"\w* \w too|strong="H01571"\w* \w have seen it|strong="H07200"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*.
\p \v 12 \w But|strong="H03588"\w* \w go|strong="H01980"\w* \w now|strong="H04994"\w* \w to|strong="H00413"\w* \w the place|strong="H04725"\w* \w -|strong="H00834"\w* \w in Shiloh|strong="H07887"\w* \w where|strong="H00834"\w* \w I first|strong="H07223"\w* \w made a dwelling|strong="H07931"\w* \w for My Name|strong="H08034"\w* \w . . .|strong="H08033"\w*, \w and see|strong="H07200"\w* \w -|strong="H00853"\w* \w what|strong="H00834"\w* \w I did|strong="H06213"\w* to it \w because of|strong="H06440"\w* \w the wickedness|strong="H07451"\w* \w of My people|strong="H05971"\w* \w Israel|strong="H03478"\w*. \v 13 \w And now|strong="H06258"\w*, \w because|strong="H03282"\w* \w you have done|strong="H06213"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w these|strong="H00428"\w* \w things|strong="H04639"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, \w and because I have spoken|strong="H01696"\w* \w to you|strong="H00413"\w* \w again and again|strong="H07925"\w* \w . . .|strong="H01696"\w*\f + \fr 7:13 \ft Literally \fqa I have spoken to you, rising up early and speaking,\f* \w but you would not|strong="H03808"\w* \w listen|strong="H08085"\w*, \w and I have called|strong="H07121"\w* \w to you|strong="H00853"\w* \w but you would not|strong="H03808"\w* \w answer|strong="H06030"\w*, \v 14 \w therefore what I did|strong="H06213"\w* \w to Shiloh|strong="H07887"\w* \w I will now do|strong="H06213"\w* \w to the house|strong="H01004"\w* \w that|strong="H00834"\w* \w bears|strong="H07121"\w* \w My Name|strong="H08034"\w* \w . . .|strong="H05921"\w*, \w [the house] in which|strong="H00834"\w* \w you|strong="H00859"\w* \w trust|strong="H00982"\w*, \w the place|strong="H04725"\w* \w that|strong="H00834"\w* \w I gave|strong="H05414"\w* to you \w and your fathers|strong="H00001"\w*\w . . .|strong="H00834"\w*. \v 15 \w And I will cast|strong="H07993"\w* \w you|strong="H00853"\w* \w out of|strong="H05921"\w* \w My presence|strong="H06440"\w*, \w just as|strong="