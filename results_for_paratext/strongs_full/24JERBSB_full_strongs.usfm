\p \v 11 \w Do not|strong="H00408"\w* \w be afraid|strong="H03372"\w* \w of|strong="H06440"\w* \w the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*, \w whom|strong="H00834"\w* \w you|strong="H00859"\w* \w now fear|strong="H03373"\w*;\w . . .|strong="H06440"\w* \w do not|strong="H00408"\w* \w be afraid|strong="H03372"\w* \w of him|strong="H04480"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, \w for|strong="H03588"\w* \w I|strong="H00589"\w* \w am with|strong="H00854"\w* \w you to save|strong="H03467"\w* \w you|strong="H00853"\w* \w and deliver|strong="H05337"\w* \w you|strong="H00853"\w* \w from him|strong="H03027"\w*. \v 12 \w And I will show|strong="H05414"\w* you \w compassion|strong="H07356"\w*, \w and he will have compassion|strong="H07355"\w* \w on you|strong="H00853"\w* \w and restore|strong="H07725"\w* \w you|strong="H00853"\w* \w to|strong="H00413"\w* \w your own land|strong="H00127"\w*.’
