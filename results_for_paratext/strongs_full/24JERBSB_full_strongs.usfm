\p \v 27 \w But if|strong="H00518"\w* \w you do not|strong="H03808"\w* \w listen|strong="H08085"\w* \w to Me|strong="H00413"\w* \w to keep|strong="H06942"\w* \w -|strong="H00853"\w* \w the Sabbath|strong="H07676"\w* \w day {holy}|strong="H03117"\w* \w by not|strong="H01115"\w* \w carrying|strong="H05375"\w* \w a load|strong="H04853"\w* \w while entering|strong="H00935"\w* \w the gates|strong="H08179"\w* \w of Jerusalem|strong="H03389"\w* \w on the Sabbath|strong="H07676"\w* \w day|strong="H03117"\w*, \w then I will kindle|strong="H03341"\w* \w vvv|strong="H03808"\w* \w an unquenchable|strong="H03518"\w* \w fire|strong="H00784"\w* \w in its gates|strong="H08179"\w* \w to consume|strong="H00398"\w* \w the citadels|strong="H00759"\w* \w of Jerusalem|strong="H03389"\w*.’”
\c 18
\s1 The Potter and the Clay
\p \v 1 \w This is the word|strong="H01697"\w* \w that|strong="H00834"\w* \w came|strong="H01961"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w . . .|strong="H00854"\w* \w from the LORD|strong="H03068"\w*: \w . . .|strong="H00559"\w* \v 2 “\w Go down|strong="H03381"\w* \w at once|strong="H06965"\w* \w to the potter’s|strong="H03335"\w* \w house|strong="H01004"\w*, \w and there|strong="H08033"\w* \w I will give you|strong="H08085"\w* \w -|strong="H00853"\w* \w My message|strong="H01697"\w*.”
\p \v 3 \w So I went down|strong="H03381"\w* \w to the potter’s|strong="H03335"\w* \w house|strong="H01004"\w* \w and saw him|strong="H02009"\w* \w working|strong="H06213"\w* \w . . .|strong="H04399"\w* \w at|strong="H05921"\w* \w the wheel|strong="H00070"\w*. \v 4 \w But the vessel|strong="H03627"\w* \w that|strong="H00834"\w* \w he|strong="H01931"\w* \w was shaping|strong="H06213"\w* \w from the clay|strong="H02563"\w* \w became flawed|strong="H07843"\w* \w in [his]|strong="H03335"\w* \w . . .|strong="H07725"\w* \w hand|strong="H03027"\w*; \w so he formed|strong="H06213"\w* \w it into another|strong="H00312"\w* \w vessel|strong="H03627"\w*, \w as|strong="H00834"\w* \w it seemed|strong="H05869"\w* \w best|strong="H03474"\w* \w for him|strong="H03335"\w* \w to do|strong="H06213"\w*.
\p \v 5 \w Then the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w came|strong="H01961"\w* \w to me|strong="H00413"\w*, \w saying|strong="H00559"\w*, \v 6 “\w O house|strong="H01004"\w* \w of Israel|strong="H03478"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, \w can|strong="H03201"\w* \w I not|strong="H03808"\w* \w treat|strong="H06213"\w* you \w as this|strong="H02088"\w* \w potter [treats his clay]|strong="H03335"\w*? \w Just|strong="H02009"\w* \w like clay|strong="H02563"\w* \w in the potter’s|strong="H03335"\w* \w hand|strong="H03027"\w*, \w so|strong="H03651"\w* \w are you|strong="H00859"\w* \w in My hand|strong="H03027"\w*, \w O house|strong="H01004"\w* \w of Israel|strong="H03478"\w*.
\p \v 7 \w At any time|strong="H07281"\w* \w I might announce|strong="H01696"\w* \w that|strong="H05921"\w* \w a nation|strong="H01471"\w* \w . . .|strong="H05921"\w* \w or kingdom|strong="H04467"\w* \w will be uprooted|strong="H05428"\w*, \w torn down|strong="H05422"\w*, \w and destroyed|strong="H00006"\w*. \v 8 \w But if that|strong="H01931"\w* \w nation|strong="H01471"\w* \w I warned|strong="H01696"\w*\w . . .|strong="H05921"\w* \w turns|strong="H07725"\w* \w from its evil|strong="H07451"\w*, \w -|strong="H00834"\w* \w then I will relent|strong="H05162"\w* \w of|strong="H05921"\w* \w the disaster|strong="H07451"\w* \w -|strong="H00834"\w* \w I had planned|strong="H02803"\w* \w to bring|strong="H06213"\w*.
\p \v 9 \w And if at another time|strong="H07281"\w* \w I announce|strong="H01696"\w* \w . . .|strong="H05921"\w* \w that I will build up|strong="H01129"\w* \w and establish|strong="H05193"\w* \w a nation|strong="H01471"\w* \w . . .|strong="H05921"\w* \w or kingdom|strong="H04467"\w*, \v 10 \w and if it does|strong="H06213"\w* \w evil|strong="H07451"\w* \w in My sight|strong="H05869"\w* \w and does not|strong="H01115"\w* \w listen|strong="H08085"\w* \w to My voice|strong="H06963"\w*, \w then I will relent|strong="H05162"\w* \w of|strong="H05921"\w* \w the good|strong="H02896"\w* \w -|strong="H00834"\w* \w I had intended for it|strong="H00559"\w* \w . . .|strong="H03190"\w* \w -|strong="H00853"\w*.
