\s1 Jeremiah’s Message to Baruch
\p \v 1 \w This is the word|strong="H01697"\w* \w that|strong="H00834"\w* \w Jeremiah|strong="H03414"\w* \w the prophet|strong="H05030"\w* \w spoke|strong="H01696"\w* \w to|strong="H00413"\w* \w Baruch|strong="H01263"\w* \w son|strong="H01121"\w* \w of Neriah|strong="H05374"\w* \w when he wrote|strong="H03789"\w* \w -|strong="H00853"\w* \w these|strong="H00428"\w* \w words|strong="H01697"\w* \w on|strong="H05921"\w* \w a scroll|strong="H05612"\w* \w at the dictation|strong="H06310"\w* \w of Jeremiah|strong="H03414"\w* \w in the fourth|strong="H07243"\w* \w year|strong="H08141"\w* \w of Jehoiakim|strong="H03079"\w* \w son|strong="H01121"\w* \w of Josiah|strong="H02977"\w*, \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w . . .|strong="H00559"\w*:
\p \v 2 “\w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w says|strong="H00559"\w* \w to you|strong="H05921"\w*, \w Baruch|strong="H01263"\w*: \v 3 \w You have said|strong="H00559"\w*, ‘\w Woe is|strong="H00188"\w* \w . . .|strong="H04994"\w* me \w because|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w has added|strong="H03254"\w* \w sorrow|strong="H03015"\w* \w to|strong="H05921"\w* \w my pain|strong="H04341"\w*! \w I am worn out|strong="H03021"\w* \w with groaning|strong="H00585"\w* \w and have found|strong="H04672"\w* \w no|strong="H03808"\w* \w rest|strong="H04496"\w*.’”
\p \v 4 \w Thus|strong="H03541"\w* \w [Jeremiah] was to say|strong="H00559"\w* \w to [Baruch}|strong="H00413"\w*:\f + \fr 45:4 \ft Literally \fqa Thus you shall say to him:\f* “\w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w . . .|strong="H02009"\w* \w says|strong="H00559"\w*: \w Throughout|strong="H03605"\w* \w the land|strong="H00776"\w* \w . . .|strong="H01931"\w* \w I|strong="H00589"\w* \w will demolish|strong="H02040"\w* \w what|strong="H00834"\w* \w I have built|strong="H01129"\w* \w and uproot|strong="H05428"\w* \w -|strong="H00853"\w* \w what|strong="H00834"\w* \w I have planted|strong="H05193"\w* \w -|strong="H00589"\w* \w -|strong="H00853"\w*. \v 5 \w But as for you|strong="H00859"\w*, \w do you seek|strong="H01245"\w* \w great things|strong="H01419"\w* for yourself? \w Stop|strong="H00408"\w* \w seeking|strong="H01245"\w*! \w For|strong="H03588"\w* \w . . .|strong="H02005"\w* \w I will bring|strong="H00935"\w* \w disaster|strong="H07451"\w* \w on|strong="H05921"\w* \w every|strong="H03605"\w* \w living creature|strong="H01320"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, \w but wherever|strong="H03605"\w* \w . . .|strong="H04725"\w* \w -|strong="H00834"\w* \w you go|strong="H01980"\w*, \w I will grant|strong="H05414"\w* - \w -|strong="H00853"\w* \w your life|strong="H05315"\w* \w as a spoil of war|strong="H07998"\w* \w . . .|strong="H05921"\w* \w . . .|strong="H08033"\w*.”
\c 46
\s1 Judgment on Egypt
\p \v 1 \w [This is] the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w about|strong="H05921"\w* \w the nations|strong="H01471"\w*— \w [the word] that|strong="H00834"\w* \w came|strong="H01961"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w the prophet|strong="H05030"\w* \v 2 \w concerning|strong="H05921"\w* \w Egypt|strong="H04714"\w* \w [and] the army|strong="H02428"\w* \w of Pharaoh|strong="H06547"\w* \w Neco|strong="H05224"\w* \w king|strong="H04428"\w* \w of Egypt|strong="H04714"\w*, \w which|strong="H00834"\w* \w . . .|strong="H01961"\w* \w . . .|strong="H05921"\w* \w was defeated|strong="H05221"\w* \w at Carchemish|strong="H03751"\w* \w -|strong="H00834"\w* \w on the Euphrates|strong="H06578"\w* \w River|strong="H05104"\w* \w by Nebuchadnezzar|strong="H05019"\w* \w king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w in the fourth|strong="H07243"\w* \w year|strong="H08141"\w* \w of Jehoiakim|strong="H03079"\w* \w the son|strong="H01121"\w* \w of Josiah|strong="H02977"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w*:
\b 
\q1 \v 3 “\w Deploy|strong="H06186"\w* \w your shields, small|strong="H04043"\w* \w and large|strong="H06793"\w*;
