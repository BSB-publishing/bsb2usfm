\c 19
\s1 The Broken Jar
\p \v 1 \w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: “\w Go|strong="H01980"\w* \w and buy|strong="H07069"\w* \w a clay|strong="H02789"\w* \w jar|strong="H01228"\w* \w from a potter|strong="H03335"\w*. \w Take some of the elders|strong="H02205"\w* \w of the people|strong="H05971"\w* \w and leaders|strong="H02205"\w* \w of the priests|strong="H03548"\w*, \v 2 \w and go|strong="H03318"\w* \w out to|strong="H00413"\w* \w the Valley|strong="H01516"\w* \w of Ben-hinnom|strong="H01121"\w* \w . . .|strong="H02011"\w* \w -|strong="H00834"\w* \w near the entrance|strong="H06607"\w* \w of the Potsherd|strong="H02777"\w* \w Gate|strong="H08179"\w*.
\p \w Proclaim|strong="H07121"\w* \w there|strong="H08033"\w* \w -|strong="H00853"\w* \w the words|strong="H01697"\w* \w -|strong="H00834"\w* \w I speak|strong="H01696"\w* \w to you|strong="H00413"\w*, \v 3 \w saying|strong="H00559"\w*, ‘\w Hear|strong="H08085"\w* \w the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w*, \w O kings|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w and residents|strong="H03427"\w* \w of Jerusalem|strong="H03389"\w*. \w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w . . .|strong="H02005"\w* \w says|strong="H00559"\w*: \w I am going to bring|strong="H00935"\w* \w such disaster|strong="H07451"\w* \w on|strong="H05921"\w* \w this|strong="H02088"\w* \w place|strong="H04725"\w* \w that|strong="H00834"\w* \w the ears|strong="H00241"\w* \w of all|strong="H03605"\w* \w who hear of it|strong="H08085"\w* \w will ring|strong="H06750"\w*, \v 4 \w because|strong="H03282"\w* \w -|strong="H00834"\w* \w they have abandoned Me|strong="H05800"\w* \w and made this|strong="H02088"\w* \w a foreign|strong="H05234"\w* \w -|strong="H00853"\w* \w place|strong="H04725"\w*. \w They have burned incense|strong="H06999"\w* in [this place] \w to other|strong="H00312"\w* \w gods|strong="H00430"\w* \w that|strong="H00834"\w* \w [neither] they|strong="H01992"\w* \w nor their fathers|strong="H00001"\w* \w nor the kings|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w have [ever]|strong="H03808"\w* \w known|strong="H03045"\w*. \w They have filled|strong="H04390"\w* \w -|strong="H00853"\w* \w this|strong="H02088"\w* \w place|strong="H04725"\w* \w with the blood|strong="H01818"\w* \w of the innocent|strong="H05355"\w*. \v 5 \w They have built|strong="H01129"\w* \w -|strong="H00853"\w* \w high places|strong="H01116"\w* \w to Baal|strong="H01168"\w* \w on which to burn|strong="H08313"\w* \w -|strong="H00853"\w* \w their children|strong="H01121"\w*