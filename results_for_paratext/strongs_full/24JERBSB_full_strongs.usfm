\p \v 9 \w So [this city] will bring|strong="H01961"\w* Me \w renown|strong="H08034"\w*, \w joy|strong="H08342"\w*, \w praise|strong="H08416"\w*, \w and glory|strong="H08597"\w* \w before all|strong="H03605"\w* \w the nations|strong="H01471"\w* \w of the earth|strong="H00776"\w*, \w who|strong="H00834"\w* \w will hear|strong="H08085"\w* \w -|strong="H00853"\w* \w of all|strong="H03605"\w* \w the good|strong="H02896"\w* \w -|strong="H00834"\w* \w I|strong="H00595"\w* \w do|strong="H06213"\w* \w for it|strong="H00853"\w*. \w They will tremble|strong="H07264"\w* \w in awe|strong="H06342"\w* \w because of|strong="H05921"\w* \w all|strong="H03605"\w* \w the goodness|strong="H02896"\w* \w . . .|strong="H05921"\w* \w and|strong="H03605"\w* \w prosperity|strong="H07965"\w* \w that|strong="H00834"\w* \w I|strong="H00595"\w* \w will provide|strong="H06213"\w* for it.
