\p \v 3 \w Then I Myself|strong="H00589"\w* \w will gather|strong="H06908"\w* \w -|strong="H00853"\w* \w the remnant|strong="H07611"\w* \w of My flock|strong="H06629"\w* \w from all|strong="H03605"\w* \w the lands|strong="H00776"\w* \w to which|strong="H00834"\w* \w I have banished them|strong="H05080"\w*, \w -|strong="H00853"\w* \w -|strong="H08033"\w* \w and I will return them|strong="H07725"\w* \w -|strong="H00853"\w* \w to|strong="H05921"\w* \w their pasture|strong="H05116"\w*, \w where they will be fruitful|strong="H06509"\w* \w and multiply|strong="H07235"\w*. \v 4 \w I will raise up|strong="H06965"\w* \w shepherds|strong="H07462"\w* \w over them|strong="H05921"\w* \w who will tend them|strong="H07462"\w*, \w and they will no|strong="H03808"\w* \w longer|strong="H05750"\w* \w be afraid|strong="H03372"\w* \w or dismayed|strong="H02865"\w*, \w . . .|strong="H03808"\w* \w nor|strong="H03808"\w* \w will any go missing|strong="H06485"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*.
