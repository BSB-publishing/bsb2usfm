\p \v 7 \w So|strong="H03651"\w* \w behold|strong="H02009"\w*, \w [the] days|strong="H03117"\w* \w are coming|strong="H00935"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, \w when they will no|strong="H03808"\w* \w longer|strong="H05750"\w* \w say|strong="H00559"\w*, ‘\w As surely as the LORD|strong="H03068"\w* \w lives|strong="H02416"\w*, \w who|strong="H00834"\w* \w brought|strong="H05927"\w* \w -|strong="H00853"\w* \w the Israelites {up}|strong="H01121"\w* \w . . .|strong="H03478"\w* \w out of the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w*.’ \v 8 \w Instead|strong="H03588"\w* \w [they will say]|strong="H00518"\w*, ‘\w As surely as the LORD|strong="H03068"\w* \w lives|strong="H02416"\w*, \w who|strong="H00834"\w* \w brought|strong="H05927"\w*\w . . .|strong="H00834"\w* \w and led|strong="H00935"\w* \w -|strong="H00853"\w* \w the descendants|strong="H02233"\w* \w of the house|strong="H01004"\w* \w of Israel|strong="H03478"\w* \w up out of the land|strong="H00776"\w* \w of the north|strong="H06828"\w* \w and all|strong="H03605"\w* \w the other lands|strong="H00776"\w* \w to which|strong="H00834"\w* \w He had banished them|strong="H05080"\w* \w . . .|strong="H08033"\w*.’ \w Then they will dwell|strong="H03427"\w* \w once more in|strong="H05921"\w* \w their own land|strong="H00127"\w*.”
\s1 Lying Prophets
\p \v 9 \w As for the prophets|strong="H05030"\w*:
\b 
\q1 \w My heart|strong="H03820"\w* \w is broken|strong="H07665"\w* \w within me|strong="H07130"\w*,
