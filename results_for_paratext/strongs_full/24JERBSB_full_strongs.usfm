\c 43
\s1 Jeremiah Taken to Egypt
\p \v 1 \w -|strong="H01961"\w* \w When Jeremiah|strong="H03414"\w* \w had finished|strong="H03615"\w* \w telling|strong="H01696"\w* \w . . .|strong="H00413"\w* \w all|strong="H03605"\w* \w the people|strong="H05971"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the words|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w their God|strong="H00430"\w*— \w -|strong="H00834"\w* \w everything that|strong="H03605"\w* \w . . .|strong="H00428"\w* \w . . .|strong="H01697"\w* \w the LORD|strong="H03068"\w* \w . . .|strong="H00430"\w* \w had sent him|strong="H07971"\w* \w to [say]|strong="H00413"\w*— \w -|strong="H00853"\w* \v 2 \w Azariah|strong="H05838"\w* \w son|strong="H01121"\w* \w of Hoshaiah|strong="H01955"\w*, \w Johanan|strong="H03110"\w* \w son|strong="H01121"\w* \w of Kareah|strong="H07143"\w*, \w and all|strong="H03605"\w* \w the arrogant|strong="H02086"\w* \w men|strong="H00582"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w*,\w . . .|strong="H00559"\w* “\w You|strong="H00859"\w* \w vvv|strong="H01696"\w* \w are lying|strong="H08267"\w*! \w The LORD|strong="H03068"\w* \w our God|strong="H00430"\w* \w has not|strong="H03808"\w* \w sent you|strong="H07971"\w* \w to say|strong="H00559"\w*, ‘\w You must not|strong="H03808"\w* \w go|strong="H00935"\w* \w to Egypt|strong="H04714"\w* \w to reside there|strong="H08033"\w* \w . . .|strong="H01481"\w*.’ \v 3 \w Rather|strong="H03588"\w*, \w Baruch|strong="H01263"\w* \w son|strong="H01121"\w* \w of Neriah|strong="H05374"\w* \w is inciting|strong="H05496"\w* \w you|strong="H00853"\w* against us \w to|strong="H04616"\w* \w deliver|strong="H05414"\w* \w us|strong="H00853"\w* \w into the hands|strong="H03027"\w* \w of the Chaldeans|strong="H03778"\w*,\f + \fr 43:3 \ft That is, the Babylonians\f* \w so that they may put us to death|strong="H04191"\w* \w -|strong="H00853"\w* \w or exile|strong="H01540"\w* \w us|strong="H00853"\w* \w to Babylon|strong="H00894"\w*!”
