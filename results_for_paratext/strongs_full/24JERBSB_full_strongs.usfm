\c 7
\s1 Jeremiah’s Message at the Temple Gate
\p \v 1 \w This is the word|strong="H01697"\w* \w that|strong="H00834"\w* \w came|strong="H01961"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w . . .|strong="H00854"\w* \w from the LORD|strong="H03068"\w*, \w saying|strong="H00559"\w*, \v 2 “\w Stand|strong="H05975"\w* \w in the gate|strong="H08179"\w* \w of the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w* \w -|strong="H08033"\w* \w -|strong="H00853"\w* \w and proclaim|strong="H07121"\w* \w this|strong="H02088"\w* \w . . .|strong="H00559"\w* \w message|strong="H01697"\w*: \w Hear|strong="H08085"\w* \w the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w*, \w all|strong="H03605"\w* \w you people of Judah|strong="H03063"\w* \w who enter|strong="H00935"\w* \w through these|strong="H00428"\w* \w gates|strong="H08179"\w* \w to worship|strong="H07812"\w* \w the LORD|strong="H03068"\w*. \v 3 \w Thus|strong="H03541"\w* \w says|strong="H00559"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*: \w Correct|strong="H03190"\w* \w your ways|strong="H01870"\w* \w and deeds|strong="H04611"\w*, \w and I will let you live|strong="H07931"\w* \w -|strong="H00853"\w* \w in this|strong="H02088"\w* \w place|strong="H04725"\w*. \v 4 \w Do not|strong="H00408"\w* \w trust|strong="H00982"\w* \w in|strong="H00413"\w* \w deceptive|strong="H08267"\w* \w words|strong="H01697"\w*, \w saying|strong="H00559"\w*:
