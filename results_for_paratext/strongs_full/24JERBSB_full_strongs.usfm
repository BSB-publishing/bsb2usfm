\p \v 24 \w Then Jeremiah|strong="H03414"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w all|strong="H03605"\w* \w the people|strong="H05971"\w*, \w . . .|strong="H00413"\w* \w including all|strong="H03605"\w* \w the women|strong="H00802"\w*, “\w Hear|strong="H08085"\w* \w the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w*, \w all those|strong="H03605"\w* \w of Judah|strong="H03063"\w* \w who|strong="H00834"\w* \w are in the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w*. \v 25 \w This is what|strong="H03541"\w* \w -|strong="H00559"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w says|strong="H00559"\w*: \w As for you|strong="H00859"\w* \w and your wives|strong="H00802"\w*, \w you have spoken|strong="H01696"\w* \w with your mouths|strong="H06310"\w* \w and fulfilled|strong="H04390"\w* \w with your hands|strong="H03027"\w* \w your words|strong="H00559"\w*: ‘\w We will surely perform|strong="H06213"\w* \w . . .|strong="H06213"\w* \w -|strong="H00853"\w* \w our vows|strong="H05088"\w* \w that|strong="H00834"\w* \w we have made|strong="H05087"\w* \w to burn incense|strong="H06999"\w* \w to the Queen|strong="H04446"\w* \w of Heaven|strong="H08064"\w* \w and to pour out|strong="H05258"\w* \w drink offerings|strong="H05262"\w* to her.’ \w Go ahead, then|strong="H06965"\w*, \w do|strong="H06965"\w* \w -|strong="H00853"\w* \w what you have promised|strong="H05088"\w*! \w . . .|strong="H06213"\w* \w Keep|strong="H06213"\w* \w -|strong="H00853"\w* \w your vows|strong="H05088"\w*!
