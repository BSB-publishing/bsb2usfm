\p \v 16 \w So|strong="H03588"\w* \w Jeremiah|strong="H03414"\w* \w went|strong="H00935"\w* \w into|strong="H00413"\w* \w a cell|strong="H01004"\w* \w . . .|strong="H00953"\w* \w in|strong="H00413"\w* \w the dungeon|strong="H02588"\w* \w and remained|strong="H03427"\w* \w there|strong="H08033"\w* \w . . .|strong="H03414"\w* \w a long time|strong="H07227"\w* \w . . .|strong="H03117"\w*.
\p \v 17 \w Later, King|strong="H04428"\w* \w Zedekiah|strong="H06667"\w* \w sent for [Jeremiah]|strong="H07971"\w* \w and received him|strong="H03947"\w*\w . . .|strong="H04428"\w* \w in his palace|strong="H01004"\w*, \w where he asked him|strong="H07592"\w* \w privately|strong="H05643"\w*, “\w Is there|strong="H03426"\w* \w a word|strong="H01697"\w* \w -|strong="H00854"\w* \w from the LORD|strong="H03068"\w*?”
\p “\w There is|strong="H03426"\w*,” \w . . .|strong="H00559"\w* \w Jeremiah|strong="H03414"\w* \w replied|strong="H00559"\w* \w . . .|strong="H00559"\w*. “\w You will be delivered|strong="H05414"\w* \w into the hand|strong="H03027"\w* \w of the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*.”
\p \v 18 \w Then Jeremiah|strong="H03414"\w* \w asked|strong="H00559"\w* \w . . .|strong="H00413"\w* \w King|strong="H04428"\w* \w Zedekiah|strong="H06667"\w*, “\w How|strong="H04100"\w* \w have I sinned|strong="H02398"\w* against you \w or your servants|strong="H05650"\w* \w or these|strong="H02088"\w* \w people|strong="H05971"\w*, \w that|strong="H03588"\w* \w you have put|strong="H05414"\w* \w me|strong="H00853"\w* \w in|strong="H00413"\w* \w prison|strong="H01004"\w* \w . . .|strong="H03608"\w*? \v 19 \w Where|strong="H00335"\w* \w are your prophets|strong="H05030"\w* \w who|strong="H00834"\w* \w prophesied|strong="H05012"\w* to you, \w claiming|strong="H00559"\w*, ‘\w The king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w will not|strong="H03808"\w* \w come|strong="H00935"\w* \w against you|strong="H05921"\w* \w . . .|strong="H05921"\w* \w or this|strong="H02063"\w* \w land|strong="H00776"\w*’ ? \v 20 \w But now|strong="H06258"\w* \w please|strong="H04994"\w* \w listen|strong="H08085"\w*, \w O my lord|strong="H00113"\w* \w the king|strong="H04428"\w*. \w May my petition|strong="H08467"\w* \w come|strong="H05307"\w* \w . . .|strong="H04994"\w* \w before you|strong="H06440"\w*. \w Do not|strong="H00408"\w* \w send me back|strong="H07725"\w* \w to the house|strong="H01004"\w* \w of Jonathan|strong="H03083"\w* \w the scribe|strong="H05608"\w*, \w or|strong="H03808"\w* \w I will die|strong="H04191"\w* \w there|strong="H08033"\w*.”
\p \v 21 \w So King|strong="H04428"\w* \w Zedekiah|strong="H06667"\w* \w gave orders|strong="H06680"\w* \w for Jeremiah|strong="H03414"\w* \w to be placed|strong="H06485"\w* \w -|strong="H00853"\w* \w in the courtyard|strong="H02691"\w* \w of the guard|strong="H04307"\w* \w and given|strong="H05414"\w* \w a loaf|strong="H03603"\w* \w of bread|strong="H03899"\w* \w daily|strong="H03117"\w* \w from|strong="H04480"\w* \w the street|strong="H02351"\w* \w of the bakers|strong="H00644"\w*, \w until|strong="H05704"\w* \w all|strong="H03605"\w* \w the bread|strong="H03899"\w* \w in the city|strong="H05892"\w* \w was gone|strong="H08552"\w*. \w So Jeremiah|strong="H03414"\w* \w remained|strong="H03427"\w* \w in the courtyard|strong="H02691"\w* \w of the guard|strong="H04307"\w*.
\c 38
\s1 Jeremiah Cast into the Cistern
\p \v 1 \w Now Shephatiah|strong="H08203"\w* \w son|strong="H01121"\w* \w of Mattan|strong="H04977"\w*, \w Gedaliah|strong="H01436"\w* \w son|strong="H01121"\w* \w of Pashhur|strong="H06583"\w*, \w Jucal|strong="H03116"\w*\f + \fr 38:1 \fqa Jucal \ft is a variant of \fqa Jehucal\ft ; see Jeremiah 37:3.\f* \w son|strong="H01121"\w* \w of Shelemiah|strong="H08018"\w*, \w and Pashhur|strong="H06583"\w* \w son|strong="H01121"\w* \w of Malchijah|strong="H04441"\w* \w -|strong="H00853"\w* \w heard|strong="H08085"\w* \w -|strong="H01697"\w* \w that|strong="H00834"\w* \w Jeremiah|strong="H03414"\w* \w had been telling|strong="H01696"\w* \w . . .|strong="H00413"\w* \w all|strong="H03605"\w* \w the people|strong="H05971"\w* \w -|strong="H00559"\w*: \v 2 “\w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: \w Whoever stays|strong="H03427"\w* \w in this|strong="H02063"\w* \w city|strong="H05892"\w* \w will die|strong="H04191"\w* \w by sword|strong="H02719"\w* \w and famine|strong="H07458"\w* \w and plague|strong="H01698"\w*, \w but whoever surrenders|strong="H03318"\w* \w to|strong="H00413"\w* \w the Chaldeans|strong="H03778"\w*\f + \fr 38:2 \ft That is, the Babylonians; also in verses 18, 19, and 23\f* \w will live|strong="H02421"\w*; \w he will retain|strong="H01961"\w* \w his life|strong="H05315"\w* \w like a spoil of war|strong="H07998"\w*, \w and he will live|strong="H02421"\w*. \v 3 \w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: \w This|strong="H02063"\w* \w city|strong="H05892"\w* \w will surely be delivered|strong="H05414"\w* \w . . .|strong="H05414"\w* \w into the hands|strong="H03027"\w* \w of the army|strong="H02428"\w* \w of the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*, \w and he will capture it|strong="H03920"\w*.”
\p \v 4 \w Then the officials|strong="H08269"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w the king|strong="H04428"\w*, “\w This|strong="H02088"\w* \w man|strong="H00376"\w* \w ought to die|strong="H04191"\w*, \w . . .|strong="H04994"\w* \w -|strong="H00853"\w* \w for|strong="H03588"\w* \w . . .|strong="H05921"\w* \w . . .|strong="H03651"\w* \w he|strong="H01931"\w* \w is discouraging|strong="H07503"\w* \w -|strong="H00853"\w* \w -|strong="H03027"\w* \w the warriors|strong="H00582"\w* \w . . .|strong="H04421"\w* \w who remain|strong="H07604"\w* \w in this|strong="H02063"\w* \w -|strong="H00853"\w* \w -|strong="H03027"\w* \w city|strong="H05892"\w*, \w as well as all|strong="H03605"\w* \w the people|strong="H05971"\w*, \w by speaking|strong="H01696"\w* \w such|strong="H00428"\w* \w words|strong="H01697"\w* \w to them|strong="H00413"\w*;\w . . .|strong="H03588"\w* \w this|strong="H02088"\w* \w man|strong="H00376"\w* \w is not|strong="H00369"\w* \w seeking|strong="H01875"\w* \w the well-being|strong="H07965"\w* \w of these|strong="H02088"\w* \w people|strong="H05971"\w*, \w but|strong="H03588"\w* \w . . .|strong="H00518"\w* \w their ruin|strong="H07451"\w*.”
\p \v 5 “\w Here|strong="H02009"\w* \w he is|strong="H01931"\w*,” \w replied|strong="H00559"\w* \w King|strong="H04428"\w* \w Zedekiah|strong="H06667"\w*. “\w He is in your hands|strong="H03027"\w*, \w since|strong="H03588"\w* \w the king|strong="H04428"\w* \w can do nothing|strong="H00369"\w* \w . . .|strong="H03201"\w* \w -|strong="H00853"\w* \w to stop you|strong="H01697"\w*.”
\p \v 6 \w So they took|strong="H03947"\w* \w -|strong="H00853"\w* \w Jeremiah|strong="H03414"\w* \w and dropped|strong="H07993"\w* \w him|strong="H00853"\w* \w into|strong="H00413"\w* \w the cistern|strong="H00953"\w* \w of Malchiah|strong="H04441"\w*, \w the king’s|strong="H04428"\w* \w son|strong="H01121"\w*, \w which|strong="H00834"\w* \w was in the courtyard|strong="H02691"\w* \w of the guard|strong="H04307"\w*. \w They lowered|strong="H07971"\w* \w -|strong="H00853"\w* \w Jeremiah|strong="H03414"\w* \w with ropes|strong="H02256"\w* \w into the cistern|strong="H00953"\w*, \w which had no|strong="H00369"\w* \w water|strong="H04325"\w* \w but only|strong="H03588"\w* \w . . .|strong="H00518"\w* \w mud|strong="H02916"\w*, \w and Jeremiah|strong="H03414"\w* \w sank down|strong="H02883"\w* \w into the mud|strong="H02916"\w*.
\p \v 7 \w vvv|strong="H05663"\w* \w Now Ebed-melech|strong="H05663"\w* \w the Cushite|strong="H03569"\w*,\f + \fr 38:7 \ft Probably from the upper Nile region\f* \w . . .|strong="H00376"\w* \w a court official|strong="H05631"\w*\f + \fr 38:7 \ft Or \fqa eunuch\f* \w . . .|strong="H01931"\w* \w in the royal|strong="H04428"\w* \w . . .|strong="H03588"\w* \w palace|strong="H01004"\w*, \w heard|strong="H08085"\w* \w that Jeremiah|strong="H03414"\w* \w had been put|strong="H05414"\w* \w -|strong="H00853"\w* \w into|strong="H00413"\w* \w the cistern|strong="H00953"\w*. \w While the king|strong="H04428"\w* \w was sitting|strong="H03427"\w* \w at the Gate|strong="H08179"\w* \w of Benjamin|strong="H01144"\w*, \v 8 \w vvv|strong="H05663"\w* \w Ebed-melech|strong="H05663"\w* \w went out|strong="H03318"\w* \w from the king’s|strong="H04428"\w* \w palace|strong="H01004"\w* \w and said|strong="H01696"\w* \w to|strong="H00413"\w* \w the king|strong="H04428"\w* \w . . .|strong="H00559"\w*, \v 9 “\w My lord|strong="H00113"\w* \w the king|strong="H04428"\w*, \w these|strong="H00428"\w* \w -|strong="H00853"\w* \w men|strong="H00582"\w* \w have acted wickedly|strong="H07489"\w* \w in all|strong="H03605"\w* \w that|strong="H00834"\w* \w they have done|strong="H06213"\w* \w to Jeremiah|strong="H03414"\w* \w the prophet|strong="H05030"\w*. \w -|strong="H00853"\w* \w -|strong="H00834"\w* \w They have dropped him|strong="H07993"\w* \w into|strong="H00413"\w* \w the cistern|strong="H00953"\w*, \w where|strong="H08478"\w* \w he will starve to death|strong="H04191"\w* \w . . .|strong="H06440"\w* \w . . .|strong="H07458"\w*, \w for|strong="H03588"\w* \w there is no|strong="H00369"\w* \w more|strong="H05750"\w* \w bread|strong="H03899"\w* \w in the city|strong="H05892"\w*.”
\p \v 10 \w So the king|strong="H04428"\w* \w -|strong="H00853"\w* \w commanded|strong="H06680"\w* \w vvv|strong="H05663"\w* \w Ebed-melech|strong="H05663"\w* \w the Cushite|strong="H03569"\w*, \w . . .|strong="H00559"\w* “\w Take|strong="H03947"\w* \w thirty|strong="H07970"\w* \w men|strong="H00582"\w* \w from|strong="H04480"\w* \w here|strong="H02088"\w* \w with you|strong="H03027"\w* \w and pull|strong="H05927"\w* \w Jeremiah|strong="H03414"\w* \w the prophet|strong="H05030"\w* \w -|strong="H00853"\w* \w out of the cistern|strong="H00953"\w* \w before|strong="H02962"\w* \w he dies|strong="H04191"\w*.”
\p \v 11 \w vvv|strong="H05663"\w* \w Then Ebed-melech|strong="H05663"\w* \w -|strong="H00853"\w* \w took|strong="H03947"\w* \w the men|strong="H00582"\w* \w with him|strong="H03027"\w* \w and went|strong="H00935"\w* \w to the king’s|strong="H04428"\w* \w palace|strong="H01004"\w*, \w to|strong="H00413"\w* \w a place below|strong="H08478"\w* \w the storehouse|strong="H00214"\w*. \w From there|strong="H08033"\w* \w he took|strong="H03947"\w* \w old|strong="H01094"\w* \w rags|strong="H05499"\w* \w and worn-out|strong="H01094"\w* \w clothes|strong="H04418"\w* \w and lowered them|strong="H07971"\w* \w with ropes|strong="H02256"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w in|strong="H00413"\w* \w the cistern|strong="H00953"\w*.
\p \v 12 \w vvv|strong="H05663"\w* \w Ebed-melech|strong="H05663"\w* \w the Cushite|strong="H03569"\w* \w cried out|strong="H00559"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w*, “\w Put|strong="H07760"\w* \w . . .|strong="H04994"\w* \w these worn-out|strong="H01094"\w* \w rags|strong="H05499"\w* \w and clothes|strong="H04418"\w* \w . . .|strong="H08478"\w* \w under your arms|strong="H00679"\w* \w . . .|strong="H03027"\w* \w . . .|strong="H08478"\w* \w to pad the ropes|strong="H02256"\w*.” \w Jeremiah|strong="H03414"\w* \w did|strong="H06213"\w* \w so|strong="H03651"\w*, \v 13 \w and they pulled him|strong="H03414"\w* \w up|strong="H04900"\w* \w -|strong="H00853"\w* \w with the ropes|strong="H02256"\w* \w and lifted|strong="H05927"\w* \w him|strong="H00853"\w* \w out of|strong="H04480"\w* \w the cistern|strong="H00953"\w*. \w And Jeremiah|strong="H03414"\w* \w remained|strong="H03427"\w* \w in the courtyard|strong="H02691"\w* \w of the guard|strong="H04307"\w*.
\p \v 14 \w Then King|strong="H04428"\w* \w Zedekiah|strong="H06667"\w* \w sent for|strong="H07971"\w* \w Jeremiah|strong="H03414"\w* \w the prophet|strong="H05030"\w* \w and received|strong="H03947"\w* \w him|strong="H00853"\w* \w at|strong="H00413"\w* \w -|strong="H00413"\w* \w the third|strong="H07992"\w* \w -|strong="H00834"\w* \w entrance|strong="H03996"\w* \w to the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*. “\w I|strong="H00589"\w* \w -|strong="H00853"\w* \w am going to ask|strong="H07592"\w* \w you something|strong="H01697"\w*,” \w said|strong="H00559"\w* \w the king|strong="H04428"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w*. “\w Do not|strong="H00408"\w* \w hide|strong="H03582"\w* \w anything|strong="H01697"\w* \w from me|strong="H04480"\w*.”
