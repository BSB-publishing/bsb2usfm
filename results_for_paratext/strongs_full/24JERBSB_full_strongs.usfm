\c 21
\s1 Jerusalem Will Fall to Babylon
\p \v 1 \w This is the word|strong="H01697"\w* \w that|strong="H00834"\w* \w came|strong="H01961"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w from|strong="H00854"\w* \w the LORD|strong="H03068"\w* \w when King|strong="H04428"\w* \w Zedekiah|strong="H06667"\w* \w -|strong="H00853"\w* \w sent|strong="H07971"\w* \w to him|strong="H00413"\w* \w Pashhur|strong="H06583"\w* \w son|strong="H01121"\w* \w of Malchijah|strong="H04441"\w* \w -|strong="H00853"\w* \w and the priest|strong="H03548"\w* \w Zephaniah|strong="H06846"\w* \w son|strong="H01121"\w* \w of Maaseiah|strong="H04641"\w*. \w They said|strong="H00559"\w*, \v 2 “\w Please|strong="H04994"\w* \w inquire|strong="H01875"\w* \w of the LORD|strong="H03068"\w* \w on our behalf|strong="H01157"\w*, \w -|strong="H00853"\w* \w since|strong="H03588"\w* \w Nebuchadnezzar|strong="H05019"\w*\f + \fr 21:2 \ft Hebrew \fqa Nebuchadrezzar\ft , a variant of \fqa Nebuchadnezzar \ft (king of Babylon), which occurs frequently in Jeremiah. The latter spelling is used throughout Jeremiah for consistency.\f* \w king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w is waging war|strong="H03898"\w* \w against us|strong="H05921"\w*. \w Perhaps|strong="H00194"\w* \w the LORD|strong="H03068"\w* \w will perform|strong="H06213"\w* \w for us|strong="H00854"\w* \w something like all|strong="H03605"\w* \w His past wonders|strong="H06381"\w*, \w so that [Nebuchadnezzar] will withdraw|strong="H05927"\w* \w from us|strong="H05921"\w*.”
\p \v 3 \w But Jeremiah|strong="H03414"\w* \w answered|strong="H00559"\w* \w -|strong="H00413"\w*, “\w You are to tell|strong="H00559"\w* \w . . .|strong="H00413"\w* \w Zedekiah|strong="H06667"\w* \w that|strong="H03541"\w* \v 4 \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w . . .|strong="H02005"\w* \w says|strong="H00559"\w*: ‘\w I will turn|strong="H05437"\w* \w against you|strong="H00853"\w* \w the weapons|strong="H03627"\w* \w of war|strong="H04421"\w*\w . . .|strong="H00834"\w* \w in your hands|strong="H03027"\w*, \w with which|strong="H00834"\w* \w you|strong="H00859"\w* \w are fighting|strong="H03898"\w* \w -|strong="H00854"\w* \w the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w . . .|strong="H00854"\w* \w and the Chaldeans|strong="H03778"\w*\f + \fr 21:4 \ft That is, the Babylonians; also in verse 9\f* \w who besiege|strong="H06696"\w* \w you|strong="H05921"\w* \w outside|strong="H02351"\w* \w the wall|strong="H02346"\w*, \w and I will assemble|strong="H00622"\w* \w [their forces]|strong="H00853"\w* \w in|strong="H00413"\w* \w the center|strong="H08432"\w* \w of this|strong="H02063"\w* \w city|strong="H05892"\w*. \v 5 \w And I Myself|strong="H00589"\w* \w will fight|strong="H03898"\w* \w against you|strong="H00854"\w* \w with an outstretched|strong="H05186"\w* \w hand|strong="H03027"\w* \w and a mighty|strong="H02389"\w* \w arm|strong="H02220"\w*, \w with anger|strong="H00639"\w*, \w fury|strong="H02534"\w*, \w and great|strong="H01419"\w* \w wrath|strong="H07110"\w*. \v 6 \w I will strike down|strong="H05221"\w* \w -|strong="H00853"\w* \w the residents|strong="H03427"\w* \w of this|strong="H02063"\w* \w -|strong="H00853"\w* \w city|strong="H05892"\w*, \w both man|strong="H00120"\w* \w -|strong="H00853"\w* \w and beast|strong="H00929"\w*. \w They will die|strong="H04191"\w* \w in a terrible|strong="H01419"\w* \w plague|strong="H01698"\w*.’
\p \v 7 ‘\w After that|strong="H00310"\w* \w . . .|strong="H03651"\w*,’ \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, ‘\w I will hand over|strong="H05414"\w* \w -|strong="H00853"\w* \w Zedekiah|strong="H06667"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w*, \w -|strong="H00853"\w* \w his officers|strong="H05650"\w*, \w -|strong="H00853"\w* \w and the people|strong="H05971"\w* \w -|strong="H00853"\w* \w in this|strong="H02063"\w* \w . . .|strong="H04480"\w* \w city|strong="H05892"\w* \w who survive|strong="H07604"\w* \w the plague|strong="H01698"\w* \w . . .|strong="H04480"\w* \w and sword|strong="H02719"\w* \w . . .|strong="H04480"\w* \w and famine|strong="H07458"\w*, \w to|strong="H03027"\w* \w Nebuchadnezzar|strong="H05019"\w* \w king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w and to|strong="H03027"\w* \w their enemies|strong="H00341"\w* \w . . .|strong="H03027"\w* \w who seek|strong="H01245"\w* \w their lives|strong="H05315"\w*. \w He will put them|strong="H05221"\w* \w vvv|strong="H06310"\w* \w to the sword|strong="H02719"\w*; \w he will not|strong="H03808"\w* \w spare|strong="H02347"\w* \w them|strong="H05921"\w* \w [or]|strong="H03808"\w* \w show pity|strong="H02550"\w* \w [or]|strong="H03808"\w* \w compassion|strong="H07355"\w*.’
\p \v 8 \w Furthermore, you are to tell|strong="H00559"\w* \w . . .|strong="H00413"\w* \w this|strong="H02088"\w* \w people|strong="H05971"\w* \w that this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: ‘\w Behold|strong="H02005"\w*, \w I set|strong="H05414"\w* \w before|strong="H06440"\w* \w you|strong="H00853"\w* \w the way|strong="H01870"\w* \w of life|strong="H02416"\w* \w -|strong="H00853"\w* \w and the way|strong="H01870"\w* \w of death|strong="H04194"\w*. \v 9 \w Whoever stays|strong="H03427"\w* \w in this|strong="H02063"\w* \w city|strong="H05892"\w* \w will die|strong="H04191"\w* \w by sword|strong="H02719"\w* \w and famine|strong="H07458"\w* \w and plague|strong="H01698"\w*, \w but whoever goes out|strong="H03318"\w* \w and surrenders|strong="H05307"\w* \w to|strong="H05921"\w* \w the Chaldeans|strong="H03778"\w* \w who besiege|strong="H06696"\w* \w you|strong="H05921"\w* \w will live|strong="H02421"\w*; \w he will retain|strong="H01961"\w* his \w life|strong="H05315"\w* \w like a spoil of war|strong="H07998"\w*. \v 10 \w For|strong="H03588"\w* \w I have set|strong="H07760"\w* \w My face|strong="H06440"\w* \w against this|strong="H02063"\w* \w city|strong="H05892"\w* \w to bring disaster|strong="H07451"\w* \w and not|strong="H03808"\w* \w good|strong="H02896"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*. \w It will be delivered|strong="H05414"\w* \w into the hand|strong="H03027"\w* \w of the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*, \w who will destroy it|strong="H08313"\w* \w with fire|strong="H00784"\w*.’
\s1 A Message to the House of David
\p \v 11 \w Moreover, [tell] the house|strong="H01004"\w* \w of the king|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w to hear|strong="H08085"\w* \w the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w*. \v 12 \w O house|strong="H01004"\w* \w of David|strong="H01732"\w*, \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*:
\b 
\q1 ‘\w Administer|strong="H01777"\w* \w justice every morning|strong="H04941"\w* \w . . .|strong="H01242"\w*,
\q2 \w and rescue|strong="H05337"\w* \w the victim of robbery|strong="H01497"\w*
\q1 \w from the hand|strong="H03027"\w* \w of his oppressor|strong="H06231"\w*,
\q2 \w or|strong="H06435"\w* \w My wrath|strong="H02534"\w* \w will go forth|strong="H03318"\w* \w like fire|strong="H00784"\w*
\q1 \w and burn|strong="H01197"\w* \w with no one|strong="H00369"\w* \w to extinguish it|strong="H03518"\w*
\q2 \w because of|strong="H06440"\w* \w their evil|strong="H07455"\w* \w deeds|strong="H04611"\w*.
\b 
\q1 \v 13 \w Behold|strong="H02005"\w*, \w I am against you|strong="H00413"\w* \w who dwell|strong="H03427"\w* \w above the valley|strong="H06010"\w*,
\q2 \w atop the rocky|strong="H06697"\w* \w plateau|strong="H04334"\w* —
\q2 \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w* —
\q1 \w you who say|strong="H00559"\w*, “\w Who|strong="H04310"\w* \w can come|strong="H05181"\w* \w against us|strong="H05921"\w*?
\q2 \w Who|strong="H04310"\w* \w can enter|strong="H00935"\w* \w our dwellings|strong="H04585"\w*?”
\q1 \v 14 \w I will punish|strong="H06485"\w* \w you|strong="H05921"\w* \w as your deeds deserve|strong="H06529"\w* \w . . .|strong="H04611"\w*,
\q2 \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*.
\q1 \w I will kindle|strong="H03341"\w* \w a fire|strong="H00784"\w* \w in your forest|strong="H03293"\w*
\q2 \w that will consume|strong="H00398"\w* \w everything|strong="H03605"\w* \w around you|strong="H05439"\w*.’”
\c 22
\s1 A Warning to Judah’s Kings
\p \v 1 \w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: “\w Go down|strong="H03381"\w* \w to the palace|strong="H01004"\w* \w of the king|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w and proclaim|strong="H01696"\w* \w this|strong="H02088"\w* \w message|strong="H01697"\w* \w there|strong="H08033"\w* \w -|strong="H00853"\w*, \v 2 \w saying|strong="H00559"\w*, ‘\w Hear|strong="H08085"\w* \w the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w*, \w O king|strong="H04428"\w* \w of Judah|strong="H03063"\w*, \w who sits|strong="H03427"\w* \w on|strong="H05921"\w* \w the throne|strong="H03678"\w* \w of David|strong="H01732"\w*— \w you|strong="H00859"\w* \w and your officials|strong="H05650"\w* \w and your people|strong="H05971"\w* \w who enter|strong="H00935"\w* \w these|strong="H00428"\w* \w gates|strong="H08179"\w*. \v 3 \w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: \w Administer|strong="H06213"\w* \w justice|strong="H04941"\w* \w and righteousness|strong="H06666"\w*. \w Rescue|strong="H05337"\w* \w the victim of robbery|strong="H01497"\w* \w from the hand|strong="H03027"\w* \w of his oppressor|strong="H06216"\w*. \w Do no|strong="H00408"\w* \w wrong|strong="H03238"\w*\w . . .|strong="H00408"\w* \w or violence|strong="H02554"\w* \w to the foreigner|strong="H01616"\w*, \w the fatherless|strong="H03490"\w*, \w or the widow|strong="H00490"\w*. \w Do not|strong="H00408"\w* \w shed|strong="H08210"\w* \w innocent|strong="H05355"\w* \w blood|strong="H01818"\w* \w in this|strong="H02088"\w* \w place|strong="H04725"\w*.
\p \v 4 \w For|strong="H03588"\w* \w if|strong="H00518"\w* \w you will indeed carry out|strong="H06213"\w* \w . . .|strong="H06213"\w* \w -|strong="H00853"\w* \w these|strong="H02088"\w* \w commands|strong="H01697"\w*, \w then kings|strong="H04428"\w* \w who sit|strong="H03427"\w* \w on|strong="H05921"\w* \w David’s|strong="H01732"\w* \w throne|strong="H03678"\w* \w will enter|strong="H00935"\w* \w through the gates|strong="H08179"\w* \w of this|strong="H02088"\w* \w palace|strong="H01004"\w* \w riding|strong="H07392"\w* \w on chariots|strong="H07393"\w* \w and horses|strong="H05483"\w* — \w they|strong="H01931"\w* \w and their officials|strong="H05650"\w* \w and their people|strong="H05971"\w*. \v 5 \w But if|strong="H00518"\w* \w you do not|strong="H03808"\w* \w obey|strong="H08085"\w* \w -|strong="H00853"\w* \w these|strong="H00428"\w* \w words|strong="H01697"\w*, \w then I swear|strong="H07650"\w* by Myself, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, \w that|strong="H03588"\w* \w this|strong="H02088"\w* \w house|strong="H01004"\w* \w will become|strong="H01961"\w* \w a pile of rubble|strong="H02723"\w*.’”
\s1 A Warning about the Palace
\p \v 6 \w For|strong="H03588"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w* \w concerning|strong="H05921"\w* \w the house|strong="H01004"\w* \w of the king|strong="H04428"\w* \w of Judah|strong="H03063"\w*:
\b 
\q1 “\w You|strong="H00859"\w* \w are like Gilead|strong="H01568"\w* to Me,
\q2 \w like the summit|strong="H07218"\w* \w of Lebanon|strong="H03844"\w*;
\q1 \w but I will surely|strong="H00518"\w* \w . . .|strong="H03808"\w* \w turn you|strong="H07896"\w* \w into a desert|strong="H04057"\w*,
\q2 \w like cities|strong="H05892"\w* \w that are uninhabited|strong="H03808"\w* \w . . .|strong="H03427"\w*.
\q1 \v 7 \w I will appoint|strong="H06942"\w* \w destroyers|strong="H07843"\w* \w against you|strong="H05921"\w*,
\q2 \w each man|strong="H00376"\w* \w with his weapons|strong="H03627"\w*,
\q1 \w and they will cut down|strong="H03772"\w* \w the choicest|strong="H04005"\w* \w of your cedars|strong="H00730"\w*
\q2 \w and throw them|strong="H05307"\w* \w into|strong="H05921"\w* \w the fire|strong="H00784"\w*.
\p \v 8 \w And many|strong="H07227"\w* \w nations|strong="H01471"\w* \w will pass|strong="H05674"\w* \w by|strong="H05921"\w* \w this|strong="H02063"\w* \w city|strong="H05892"\w* \w and ask|strong="H00559"\w* \w one|strong="H00376"\w* \w . . .|strong="H00413"\w* \w another|strong="H07453"\w*, ‘\w Why|strong="H05921"\w* \w . . .|strong="H04100"\w* \w has the LORD|strong="H03068"\w* \w done|strong="H06213"\w* \w such a thing|strong="H03602"\w* \w to this|strong="H02063"\w* \w great|strong="H01419"\w* \w city|strong="H05892"\w*?’
\p \v 9 \w Then [people] will reply|strong="H00559"\w*, ‘\w Because|strong="H05921"\w* \w -|strong="H00834"\w* \w they have forsaken|strong="H05800"\w* \w -|strong="H00853"\w* \w the covenant|strong="H01285"\w* \w of the LORD|strong="H03068"\w* \w their God|strong="H00430"\w* \w and have worshiped|strong="H07812"\w* \w and served|strong="H05647"\w* \w other|strong="H00312"\w* \w gods|strong="H00430"\w*.’”
\s1 A Warning about Shallum
\q1 \v 10 \w Do not|strong="H00408"\w* \w weep|strong="H01058"\w* \w for him who is dead|strong="H04191"\w*;
\q2 \w do not|strong="H00408"\w* \w mourn his loss|strong="H05110"\w*.
\q1 \w Weep bitterly|strong="H01058"\w* \w . . .|strong="H01058"\w* \w for him who is exiled|strong="H01980"\w*,
\q2 \w for|strong="H03588"\w* \w he will never|strong="H03808"\w* \w return|strong="H07725"\w* \w -|strong="H05750"\w*
\q2 \w to see|strong="H07200"\w* \w -|strong="H00853"\w* \w his native|strong="H04138"\w* \w land|strong="H00776"\w*.
\p \v 11 \w For|strong="H03588"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w* \w concerning|strong="H00413"\w* \w Shallum|strong="H07967"\w*\f + \fr 22:11 \fqa Shallum \ft was also called \fqa Jehoahaz\ft .\f* \w son|strong="H01121"\w* \w of Josiah|strong="H02977"\w*, \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w*, \w who succeeded|strong="H04427"\w* \w . . .|strong="H08478"\w* \w his father|strong="H00001"\w* \w Josiah|strong="H02977"\w* \w -|strong="H00834"\w* \w [but] has gone forth|strong="H03318"\w* \w from|strong="H04480"\w* \w this|strong="H02088"\w* \w place|strong="H04725"\w*: “\w He will never|strong="H03808"\w* \w return|strong="H07725"\w* \w . . .|strong="H08033"\w* \w . . .|strong="H05750"\w*, \v 12 \w but|strong="H03588"\w* \w he will die|strong="H04191"\w* \w -|strong="H00853"\w* \w in the place|strong="H04725"\w* \w to which|strong="H00834"\w* \w he was exiled|strong="H01540"\w*; \w -|strong="H00853"\w* \w -|strong="H08033"\w* \w he will never|strong="H03808"\w* \w see|strong="H07200"\w* \w this|strong="H02063"\w* \w land|strong="H00776"\w* \w again|strong="H05750"\w*.”
\s1 A Warning about Jehoiakim
\q1 \v 13 “\w Woe|strong="H01945"\w* \w to him who builds|strong="H01129"\w* \w his palace|strong="H01004"\w* \w by|strong="H03808"\w* \w unrighteousness|strong="H06664"\w*,
\q2 \w and his upper rooms|strong="H05944"\w* \w without|strong="H03808"\w* \w justice|strong="H04639"\w*,
\q1 \w who makes his countrymen|strong="H07453"\w* \w serve|strong="H05647"\w* \w without pay|strong="H02600"\w*,
\q2 \w and fails|strong="H03808"\w* \w to pay|strong="H05414"\w* their \w wages|strong="H06467"\w*,
\q1 \v 14 \w who says|strong="H00559"\w*, ‘\w I will build|strong="H01129"\w* myself \w a great|strong="H04060"\w* \w palace|strong="H01004"\w*,
\q2 \w with spacious|strong="H07304"\w* \w upper rooms|strong="H05944"\w*.’
\q1 \w So he cuts|strong="H07167"\w* \w windows|strong="H02474"\w* in it,
\q2 \w panels it|strong="H05603"\w* \w with cedar|strong="H00730"\w*,
\q2 \w and paints it|strong="H04886"\w* \w with vermilion|strong="H08350"\w*.
\b 
\q1 \v 15 \w Does it make you a king|strong="H04427"\w* \w . . .|strong="H03588"\w* \w to excel|strong="H08474"\w* \w -|strong="H00859"\w*\f + \fr 22:15 \ft Or \fqa because you enclose yourself\f* \w in cedar|strong="H00730"\w*?
\q2 \w Did not|strong="H03808"\w* \w your father|strong="H00001"\w* \w have food|strong="H00398"\w* \w and drink|strong="H08354"\w*?
\q1 \w He administered|strong="H06213"\w* \w justice|strong="H04941"\w* \w and righteousness|strong="H06666"\w*,
\q2 \w and so|strong="H00227"\w* \w it went well|strong="H02896"\w* with him.
\q1 \v 16 \w He took up|strong="H01777"\w* \w the cause|strong="H01779"\w* \w of the poor|strong="H06041"\w* \w and needy|strong="H00034"\w*,
\q2 \w and so|strong="H00227"\w* \w it went well [with him]|strong="H02896"\w*.
\q1 \w Is this|strong="H01931"\w* \w not|strong="H03808"\w* \w what it means to know|strong="H01847"\w* \w Me|strong="H00853"\w*?”
\q2 \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*.
\q1 \v 17 “\w But|strong="H03588"\w* \w your eyes|strong="H05869"\w* \w and heart|strong="H03820"\w* \w [are set on] nothing|strong="H00369"\w*
\q2 \w except|strong="H03588"\w* \w . . .|strong="H00518"\w* \w . . .|strong="H05921"\w* \w your own dishonest gain|strong="H01215"\w*, \w -|strong="H05921"\w*
\q1 \w on shedding|strong="H08210"\w* \w . . .|strong="H05921"\w* \w innocent|strong="H05355"\w* \w blood|strong="H01818"\w*,
\q2 \w on practicing|strong="H06213"\w* \w extortion|strong="H06233"\w* \w and|strong="H05921"\w* \w oppression|strong="H04835"\w*.”
\p \v 18 \w Therefore|strong="H03651"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w* \w concerning|strong="H00413"\w* \w Jehoiakim|strong="H03079"\w* \w son|strong="H01121"\w* \w of Josiah|strong="H02977"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w*:
\b 
\q1 “\w They will not|strong="H03808"\w* \w mourn|strong="H05594"\w* for him:
\q2 ‘\w Alas|strong="H01945"\w*, \w my brother|strong="H00251"\w*! \w Alas|strong="H01945"\w*, \w my sister|strong="H00269"\w*!’
\q1 \w They will not|strong="H03808"\w* \w mourn|strong="H05594"\w* for him:
\q2 ‘\w Alas|strong="H01945"\w*, \w my master|strong="H00113"\w*! \w Alas|strong="H01945"\w*, \w his splendor|strong="H01935"\w*!’
\q1 \v 19 \w vvv|strong="H06900"\w* \w He will be buried|strong="H06912"\w* \w like a donkey|strong="H02543"\w*,
\q2 \w dragged away|strong="H05498"\w* \w and thrown|strong="H07993"\w* \w outside|strong="H01973"\w* \w the gates|strong="H08179"\w* \w of Jerusalem|strong="H03389"\w*.
\q1 \v 20 \w Go up|strong="H05927"\w* \w to Lebanon|strong="H03844"\w* \w and cry out|strong="H06817"\w*;
\q2 \w raise|strong="H05414"\w* \w your voice|strong="H06963"\w* \w in Bashan|strong="H01316"\w*;
\q1 \w cry out|strong="H06817"\w* \w from Abarim|strong="H05682"\w*,
\q2 \w for|strong="H03588"\w* \w all|strong="H03605"\w* \w your lovers|strong="H00157"\w* \w have been crushed|strong="H07665"\w*.
\b 
\q1 \v 21 \w I warned|strong="H01696"\w* \w you|strong="H00413"\w* \w when you were secure|strong="H07962"\w*.
\q2 \w You said|strong="H00559"\w*, ‘\w I will not|strong="H03808"\w* \w listen|strong="H08085"\w*.’
