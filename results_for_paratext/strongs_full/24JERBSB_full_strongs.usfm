\p \v 36 \w Now|strong="H06258"\w* \w therefore|strong="H03651"\w*, \w about|strong="H00413"\w* \w this|strong="H02063"\w* \w city|strong="H05892"\w* \w of which|strong="H00834"\w* \w you|strong="H00859"\w* \w say|strong="H00559"\w*, ‘\w It will be delivered|strong="H05414"\w* \w into the hand|strong="H03027"\w* \w of the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w by sword|strong="H02719"\w* \w and famine|strong="H07458"\w* \w and plague|strong="H01698"\w*,’ \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w says|strong="H00559"\w*: \v 37 \w vvv|strong="H02005"\w* \w I will surely gather [My people]|strong="H06908"\w* \w from all|strong="H03605"\w* \w the lands|strong="H00776"\w* \w to which|strong="H00834"\w* \w I have banished them|strong="H05080"\w* \w . . .|strong="H08033"\w* \w in My furious anger|strong="H00639"\w* \w . . .|strong="H02534"\w* \w and great|strong="H01419"\w* \w wrath|strong="H07110"\w*, \w and I will return them|strong="H07725"\w* \w to|strong="H00413"\w* \w this|strong="H02088"\w* \w place|strong="H04725"\w* \w and make them dwell|strong="H03427"\w* \w in safety|strong="H00983"\w*. \v 38 \w They will be|strong="H01961"\w* My \w people|strong="H05971"\w*, \w and I|strong="H00589"\w* \w will be|strong="H01961"\w* their \w God|strong="H00430"\w*.\f + \fr 32:38 \ft Cited in 2 Corinthians 6:16\f* \v 39 \w I will give|strong="H05414"\w* them \w one|strong="H00259"\w* \w heart|strong="H03820"\w* \w and one|strong="H00259"\w* \w way|strong="H01870"\w*, \w so that they will always fear Me|strong="H03372"\w* \w -|strong="H00853"\w* \w -|strong="H03605"\w* \w . . .|strong="H03117"\w* \w for their own good|strong="H02896"\w* \w and for the good of their children|strong="H01121"\w* \w after them|strong="H00310"\w*.
\p \v 40 \w I will make|strong="H03772"\w* \w an everlasting|strong="H05769"\w* \w -|strong="H00834"\w* \w covenant|strong="H01285"\w* with them: \w I will never|strong="H03808"\w* \w turn away|strong="H07725"\w* \w from|strong="H00310"\w* \w doing good to them|strong="H03190"\w*, \w -|strong="H00853"\w* \w -|strong="H00853"\w* \w and I will put|strong="H05414"\w* \w My fear|strong="H03374"\w* \w in their hearts|strong="H03824"\w*, \w so that they will never|strong="H01115"\w* \w turn away|strong="H05493"\w* \w from Me|strong="H05921"\w*. \v 41 \w Yes , I will rejoice|strong="H07797"\w* \w in|strong="H05921"\w* \w doing them good|strong="H03190"\w* \w -|strong="H00853"\w*, \w and I will faithfully|strong="H00571"\w* \w plant them|strong="H05193"\w* \w in this|strong="H02063"\w* \w land|strong="H00776"\w* \w with all|strong="H03605"\w* \w My heart|strong="H03820"\w* \w and with all|strong="H03605"\w* \w My soul|strong="H05315"\w*.
