\q2 \w has not|strong="H03808"\w* \w turned away|strong="H07725"\w* \w from us|strong="H04480"\w*.”
\b 
\q1 \v 9 \w -|strong="H01961"\w* “\w In that|strong="H01931"\w* \w day|strong="H03117"\w*,” \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*,
\q2 “\w the king|strong="H04428"\w* \w . . .|strong="H03820"\w* \w and officials|strong="H08269"\w* \w will lose|strong="H00006"\w* \w their courage|strong="H03820"\w*.
