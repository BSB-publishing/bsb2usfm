\q2 \w a sound|strong="H06963"\w* \w of celebration|strong="H07832"\w*.
\q1 \w I will multiply them|strong="H07235"\w*, \w and they will not|strong="H03808"\w* \w be decreased|strong="H04591"\w*;
\q2 \w I will honor them|strong="H03513"\w*, \w and they will not|strong="H03808"\w* \w be belittled|strong="H06819"\w*.
\q1 \v 20 \w Their children|strong="H01121"\w* \w will be|strong="H01961"\w* \w as in days of old|strong="H06924"\w*,
\q2 \w and their congregation|strong="H05712"\w* \w will be established|strong="H03559"\w* \w before Me|strong="H06440"\w*;
