\p \v 18 \w Then [some] said|strong="H00559"\w*, “\w Come|strong="H01980"\w*, \w let us make plans|strong="H02803"\w* \w . . .|strong="H04284"\w* \w against|strong="H05921"\w* \w Jeremiah|strong="H03414"\w*, \w for|strong="H03588"\w* \w the law|strong="H08451"\w* \w will never|strong="H03808"\w* \w be lost|strong="H00006"\w* \w to the priest|strong="H03548"\w*, \w nor counsel|strong="H06098"\w* \w to the wise|strong="H02450"\w*, \w nor an oracle|strong="H01697"\w* \w to the prophet|strong="H05030"\w*. \w Come|strong="H01980"\w*, \w let us denounce him|strong="H05221"\w* \w . . .|strong="H03956"\w* \w and pay no|strong="H00408"\w* \w heed|strong="H07181"\w* \w to|strong="H00413"\w* \w any|strong="H03605"\w* \w of his words|strong="H01697"\w*.”
