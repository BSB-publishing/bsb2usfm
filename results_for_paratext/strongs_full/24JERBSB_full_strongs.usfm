\p \v 10 \w Then I said|strong="H00559"\w*, “\w Ah|strong="H00162"\w*, \w Lord|strong="H00136"\w* \w GOD|strong="H03069"\w*, \w how completely|strong="H00403"\w* \w You have deceived|strong="H05377"\w* \w . . .|strong="H05377"\w* \w this|strong="H02088"\w* \w people|strong="H05971"\w* \w and Jerusalem|strong="H03389"\w* \w by saying|strong="H00559"\w*, ‘\w You will have|strong="H01961"\w* \w -|strong="H05060"\w* \w peace|strong="H07965"\w*,’ \w while a sword|strong="H02719"\w* \w is at|strong="H05704"\w* \w our throats|strong="H05315"\w*.”
\q1 
\p \v 11 \w At that|strong="H01931"\w* \w time|strong="H06256"\w* \w it will be said|strong="H00559"\w* \w to this|strong="H02088"\w* \w people|strong="H05971"\w* \w and to Jerusalem|strong="H03389"\w*, “\w A searing|strong="H06703"\w* \w wind|strong="H07307"\w* \w from the barren heights|strong="H08205"\w* \w in the desert|strong="H04057"\w* \w blows toward|strong="H01870"\w* \w the daughter|strong="H01323"\w* \w of My people|strong="H05971"\w*, \w but not|strong="H03808"\w* \w to winnow|strong="H02219"\w* \w . . .|strong="H03808"\w* \w or to sift|strong="H01305"\w*; \v 12 \w a wind|strong="H07307"\w* \w too strong|strong="H04392"\w* \w for that|strong="H00428"\w* \w comes|strong="H00935"\w* from Me. \w Now|strong="H06258"\w* \w I|strong="H00589"\w* \w also|strong="H01571"\w* \w pronounce|strong="H01696"\w* \w judgments|strong="H04941"\w* \w against them|strong="H00854"\w*.”
\b 
\q1 \v 13 \w Behold|strong="H02009"\w*, \w he advances|strong="H05927"\w* \w like the clouds|strong="H06051"\w*,
\q2 \w his chariots|strong="H04818"\w* \w like the whirlwind|strong="H05492"\w*.
