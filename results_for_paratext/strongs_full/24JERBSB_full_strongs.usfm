\p \v 18 “\w Yet even|strong="H01571"\w* \w in those|strong="H01992"\w* \w days|strong="H03117"\w*,” \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, “\w I will not|strong="H03808"\w* \w make|strong="H06213"\w* \w a full end|strong="H03617"\w* \w of you|strong="H00854"\w*. \v 19 \w And|strong="H01961"\w* \w when|strong="H03588"\w* \w the people ask|strong="H00559"\w*, ‘\w For|strong="H08478"\w* \w what|strong="H04100"\w* \w offense has the LORD|strong="H03068"\w* \w our God|strong="H00430"\w* \w -|strong="H00853"\w* \w done|strong="H06213"\w* \w all|strong="H03605"\w* \w these things to us|strong="H00428"\w*?’ \w You are to tell|strong="H00559"\w* \w them|strong="H00413"\w*, ‘\w Just as|strong="H00834"\w* \w you have forsaken|strong="H05800"\w* \w Me|strong="H00853"\w* \w and served|strong="H05647"\w* \w foreign|strong="H05236"\w* \w gods|strong="H00430"\w* \w in your land|strong="H00776"\w*, \w so|strong="H03651"\w* \w will you serve|strong="H05647"\w* \w foreigners|strong="H02114"\w* \w in a land|strong="H00776"\w* \w that is not|strong="H03808"\w* your own.’”
