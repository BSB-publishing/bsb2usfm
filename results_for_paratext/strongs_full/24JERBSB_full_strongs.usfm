\p \v 18 \w For|strong="H03588"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w says|strong="H00559"\w*: ‘\w Just as|strong="H00834"\w* \w My anger|strong="H00639"\w* \w and wrath|strong="H02534"\w* \w were poured out|strong="H05413"\w* \w on|strong="H05921"\w* \w the residents|strong="H03427"\w* \w of Jerusalem|strong="H03389"\w*, \w so|strong="H03651"\w* \w will My wrath|strong="H02534"\w* \w be poured out|strong="H05413"\w* \w on you|strong="H05921"\w* \w if you go|strong="H00935"\w* \w to Egypt|strong="H04714"\w*. \w You will become|strong="H01961"\w* \w an object of cursing|strong="H00423"\w* \w and horror|strong="H08047"\w*, \w of vilification|strong="H07045"\w* \w and disgrace|strong="H02781"\w*, \w and you will never|strong="H03808"\w* \w see|strong="H07200"\w* \w this|strong="H02088"\w* \w place|strong="H04725"\w* \w again|strong="H05750"\w* \w -|strong="H00853"\w*.’
\p \v 19 \w The LORD|strong="H03068"\w* \w has told|strong="H01696"\w* \w you|strong="H05921"\w*, \w O remnant|strong="H07611"\w* \w of Judah|strong="H03063"\w*, ‘\w Do not|strong="H00408"\w* \w go|strong="H00935"\w* \w to Egypt|strong="H04714"\w*.’ \w Know for sure|strong="H03045"\w* \w . . .|strong="H03045"\w* \w that|strong="H03588"\w* \w I have warned|strong="H05749"\w* you \w today|strong="H03117"\w*! \v 20 \w For|strong="H03588"\w* \w you|strong="H05315"\w* \w . . .|strong="H03588"\w* \w have deceived|strong="H08582"\w* \w yourselves|strong="H00859"\w* \w by sending|strong="H07971"\w* \w me|strong="H00853"\w* \w to|strong="H00413"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*, \w saying|strong="H00559"\w*, ‘\w Pray|strong="H06419"\w* \w to|strong="H00413"\w* \w the LORD|strong="H03068"\w* \w our God|strong="H00430"\w* \w on our behalf|strong="H01157"\w*, \w and as for all|strong="H03605"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w our God|strong="H00430"\w* \w . . .|strong="H03651"\w* \w says|strong="H00559"\w*, \w tell it|strong="H05046"\w* to us \w and we will do it|strong="H06213"\w*.’
