\p \v 12 \w And to|strong="H00413"\w* \w Zedekiah|strong="H06667"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w I spoke|strong="H01696"\w* \w the same|strong="H03605"\w* \w message|strong="H01697"\w* \w . . .|strong="H00428"\w* \w . . .|strong="H00559"\w*: “\w Put|strong="H00935"\w* \w -|strong="H00853"\w* \w your necks|strong="H06677"\w* \w under the yoke|strong="H05923"\w* \w of the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*; \w serve|strong="H05647"\w* \w him|strong="H00853"\w* \w and his people|strong="H05971"\w*, \w and live|strong="H02421"\w*! \v 13 \w Why|strong="H04100"\w* \w should you|strong="H00859"\w* \w and your people|strong="H05971"\w* \w die|strong="H04191"\w* \w by sword|strong="H02719"\w* \w and famine|strong="H07458"\w* \w and plague|strong="H01698"\w*, \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w has decreed|strong="H01696"\w* \w against|strong="H00413"\w* \w any nation|strong="H01471"\w* \w that|strong="H00834"\w* \w does not|strong="H03808"\w* \w serve|strong="H05647"\w* \w -|strong="H00853"\w* \w the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*?
