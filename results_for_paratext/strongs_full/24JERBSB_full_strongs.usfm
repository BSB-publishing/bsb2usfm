\c 42
\s1 A Warning against Going to Egypt
\p \v 1 \w Then all|strong="H03605"\w* \w the commanders|strong="H08269"\w* \w of the forces|strong="H02428"\w*, \w along with Johanan|strong="H03110"\w* \w son|strong="H01121"\w* \w of Kareah|strong="H07143"\w*, \w Jezaniah|strong="H03153"\w*\f + \fr 42:1 \ft Hebrew; LXX \fqa Azariah\ft ; see Jeremiah 43:2.\f* \w son|strong="H01121"\w* \w of Hoshaiah|strong="H01955"\w*, \w and all|strong="H03605"\w* \w the people|strong="H05971"\w* \w from the least|strong="H06996"\w* \w to|strong="H05704"\w* \w the greatest|strong="H01419"\w*, \w approached|strong="H05066"\w* \v 2 \w Jeremiah|strong="H03414"\w* \w the prophet|strong="H05030"\w* \w and said|strong="H00559"\w*\w . . .|strong="H00413"\w*, “\w May our petition|strong="H08467"\w* \w come|strong="H05307"\w* \w . . .|strong="H04994"\w* \w before you|strong="H06440"\w*; \w pray|strong="H06419"\w* \w . . .|strong="H01157"\w* \w to|strong="H00413"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w on behalf of|strong="H01157"\w* \w this|strong="H02063"\w* \w entire|strong="H03605"\w* \w remnant|strong="H07611"\w*. \w For|strong="H03588"\w* \w few|strong="H04592"\w* \w of us remain|strong="H07604"\w* \w of the many|strong="H07235"\w*, \w as|strong="H00834"\w* \w you can see|strong="H07200"\w* \w -|strong="H00853"\w* \w with your own eyes|strong="H05869"\w*. \v 3 \w [Pray] that the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w -|strong="H00853"\w* \w will tell|strong="H05046"\w* us \w the way|strong="H01870"\w* \w -|strong="H00834"\w* \w we should walk|strong="H01980"\w* \w -|strong="H00853"\w* \w and the thing|strong="H01697"\w* \w -|strong="H00834"\w* \w we should do|strong="H06213"\w*.”
\p \v 4 “\w I have heard you|strong="H08085"\w*,” \w replied|strong="H00559"\w* \w -|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w the prophet|strong="H05030"\w*. “\w I will surely|strong="H02005"\w* \w pray|strong="H06419"\w* \w to|strong="H00413"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w as you request|strong="H01697"\w*, \w . . .|strong="H01961"\w* \w and I will tell you|strong="H05046"\w* \w everything|strong="H03605"\w* \w . . .|strong="H01697"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w answers|strong="H06030"\w*. \w I will not|strong="H03808"\w* \w withhold|strong="H04513"\w* \w a word|strong="H01697"\w* from you.”
