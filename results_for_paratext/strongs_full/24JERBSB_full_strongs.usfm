\q2 \w because|strong="H03588"\w* \w it pierces|strong="H05060"\w* \w to the|strong="H05704"\w* \w heart|strong="H03820"\w*!”
\s1 Lamentation for Judah
\q1 \v 19 \w My anguish|strong="H04578"\w*, \w my anguish|strong="H04578"\w*! \w I writhe in pain|strong="H02342"\w*!
\q2 \w Oh, the pain|strong="H07023"\w* \w in my chest|strong="H03820"\w*!
\q1 \w My heart|strong="H03820"\w* \w pounds|strong="H01993"\w* within me;
\q2 \w I cannot|strong="H03808"\w* \w be silent|strong="H02790"\w*.
\q1 \w For|strong="H03588"\w* \w I|strong="H05315"\w* \w have heard|strong="H08085"\w* \w the sound|strong="H06963"\w* \w of the horn|strong="H07782"\w*,
\q2 \w the alarm|strong="H08643"\w* \w of battle|strong="H04421"\w*.
