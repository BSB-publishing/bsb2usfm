\p \v 1 \w Zedekiah|strong="H06667"\w* \w was twenty-one|strong="H06242"\w* \w . . .|strong="H00259"\w* \w years|strong="H08141"\w* \w old|strong="H01121"\w* \w when he became king|strong="H04427"\w*, \w and he reigned|strong="H04427"\w* \w in Jerusalem|strong="H03389"\w* \w eleven|strong="H00259"\w* \w . . .|strong="H06240"\w* \w years|strong="H08141"\w*. \w His mother’s|strong="H00517"\w* \w name|strong="H08034"\w* \w was Hamutal|strong="H02537"\w* \w daughter|strong="H01323"\w* \w of Jeremiah|strong="H03414"\w*; \w she was from Libnah|strong="H03841"\w*.
\p \v 2 \w And [Zedekiah] did|strong="H06213"\w* \w evil|strong="H07451"\w* \w in the sight|strong="H05869"\w* \w of the LORD|strong="H03068"\w*, \w just as|strong="H03605"\w* \w -|strong="H00834"\w* \w Jehoiakim|strong="H03079"\w* \w had done|strong="H06213"\w*. \v 3 \w For|strong="H03588"\w* \w because|strong="H05921"\w* \w of the anger|strong="H00639"\w* \w of the LORD|strong="H03068"\w*, \w [all this] happened|strong="H01961"\w* \w in Jerusalem|strong="H03389"\w* \w and Judah|strong="H03063"\w*, \w until|strong="H05704"\w* \w He finally banished|strong="H07993"\w* \w them|strong="H00853"\w* \w from|strong="H05921"\w* \w His presence|strong="H06440"\w*.
