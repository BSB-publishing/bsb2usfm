\p \v 13 \w -|strong="H07971"\w* \w So Nebuzaradan|strong="H05018"\w* \w captain|strong="H07227"\w* \w of the guard|strong="H02876"\w*, \w Nebushazban|strong="H05021"\w*\f + \fr 39:13 \fqa Nebushazban \ft is possibly a variant of \fqa Nebo-sarsekim\ft ; see verse 3.\f* \w vvv|strong="H07249"\w* \w the Rabsaris|strong="H07249"\w*, \w vvv|strong="H05371"\w* \w vvv|strong="H05371"\w* \w Nergal-sharezer|strong="H05371"\w* \w vvv|strong="H07248"\w* \w the Rabmag|strong="H07248"\w*, \w and all|strong="H03605"\w* \w the captains|strong="H07227"\w* \w of the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \v 14 \w had Jeremiah|strong="H03414"\w* \w brought|strong="H07971"\w* \w . . .|strong="H03947"\w* \w -|strong="H00853"\w* \w from the courtyard|strong="H02691"\w* \w of the guard|strong="H04307"\w*, \w and they turned him over|strong="H05414"\w* \w -|strong="H00853"\w* \w to|strong="H00413"\w* \w Gedaliah|strong="H01436"\w* \w son|strong="H01121"\w* \w of Ahikam|strong="H00296"\w*, \w the son|strong="H01121"\w* \w of Shaphan|strong="H08227"\w*, \w to take|strong="H03318"\w* \w him|strong="H00413"\w* \w home|strong="H01004"\w*. \w So [Jeremiah] remained|strong="H03427"\w* \w among|strong="H08432"\w* \w his own people|strong="H05971"\w*.
\p \v 15 \w And while [Jeremiah] had been|strong="H01961"\w* \w confined|strong="H06113"\w* \w in the courtyard|strong="H02691"\w* \w of the guard|strong="H04307"\w*, \w the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w had come|strong="H01961"\w* \w to|strong="H00413"\w* \w [him]|strong="H03414"\w* \w -|strong="H00559"\w*: \v 16 “\w Go|strong="H01980"\w* \w and tell|strong="H00559"\w* \w vvv|strong="H05663"\w* \w Ebed-melech|strong="H05663"\w* \w the Cushite that|strong="H03569"\w* \w this is what|strong="H03541"\w* \w . . .|strong="H00559"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w . . .|strong="H02005"\w* \w says|strong="H00559"\w*: ‘\w I am about to fulfill|strong="H00935"\w* \w -|strong="H00853"\w* \w My words|strong="H01697"\w* \w against|strong="H00413"\w* \w this|strong="H02063"\w* \w city|strong="H05892"\w* \w for harm|strong="H07451"\w* \w and not|strong="H03808"\w* \w for good|strong="H02896"\w*, \w and on that|strong="H01931"\w* \w day|strong="H03117"\w* \w they will be fulfilled|strong="H01961"\w* \w before your eyes|strong="H06440"\w*. \v 17 \w But I will deliver you|strong="H05337"\w* \w on that|strong="H01931"\w* \w day|strong="H03117"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, \w and you will not|strong="H03808"\w* \w be delivered|strong="H05414"\w* \w into the hands|strong="H03027"\w* \w of the men|strong="H00582"\w* \w whom|strong="H00834"\w* \w you|strong="H00859"\w* \w fear|strong="H03016"\w* \w . . .|strong="H06440"\w*. \v 18 \w For|strong="H03588"\w* \w I will surely rescue you|strong="H04422"\w* \w . . .|strong="H04422"\w* \w so that you do not|strong="H03808"\w* \w fall|strong="H05307"\w* \w by the sword|strong="H02719"\w*. \w Because|strong="H03588"\w* \w you have trusted|strong="H00982"\w* in Me, \w you will escape|strong="H01961"\w* with \w your life|strong="H05315"\w* \w like a spoil of war|strong="H07998"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*.’”
\c 40
\s1 Jeremiah Remains in Judah
\p \v 1 \w This is the word|strong="H01697"\w* \w that|strong="H00834"\w* \w came|strong="H01961"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w from|strong="H00854"\w* \w the LORD|strong="H03068"\w* \w after|strong="H00310"\w* \w Nebuzaradan|strong="H05018"\w* \w captain|strong="H07227"\w* \w of the guard|strong="H02876"\w* \w had released|strong="H07971"\w* \w him|strong="H00853"\w* \w at|strong="H04480"\w* \w Ramah|strong="H07414"\w*, \w having found|strong="H03947"\w* \w -|strong="H00853"\w* \w him|strong="H01931"\w* \w bound|strong="H00631"\w* \w in chains|strong="H00246"\w* \w among|strong="H08432"\w* \w all|strong="H03605"\w* \w the captives|strong="H01546"\w* \w of Jerusalem|strong="H03389"\w* \w and Judah|strong="H03063"\w* \w who were being exiled|strong="H01540"\w* \w to Babylon|strong="H00894"\w*.
\p \v 2 \w The captain|strong="H07227"\w* \w of the guard|strong="H02876"\w* \w found|strong="H03947"\w* \w Jeremiah|strong="H03414"\w* \w and said|strong="H00559"\w* \w to him|strong="H00413"\w*, “\w The LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w decreed|strong="H01696"\w* \w -|strong="H00853"\w* \w this|strong="H02063"\w* \w disaster|strong="H07451"\w* \w on|strong="H00413"\w* \w this|strong="H02088"\w* \w place|strong="H04725"\w*, \v 3 \w and now the LORD|strong="H03068"\w* \w has fulfilled it|strong="H00935"\w*; \w He has done|strong="H06213"\w* \w just as|strong="H00834"\w* \w He said|strong="H01696"\w*. \w Because|strong="H03588"\w* \w you [people] have sinned|strong="H02398"\w* \w against the LORD|strong="H03068"\w* \w and have not|strong="H03808"\w* \w obeyed|strong="H08085"\w* \w His voice|strong="H06963"\w*, \w this|strong="H02088"\w* \w thing|strong="H01697"\w* \w has happened|strong="H01961"\w* to you. \v 4 \w But now|strong="H06258"\w*, \w behold|strong="H02009"\w*, \w I am freeing|strong="H06605"\w* \w you today|strong="H03117"\w* \w from|strong="H04480"\w* \w the chains|strong="H00246"\w* \w that|strong="H00834"\w* \w were on|strong="H05921"\w* \w your wrists|strong="H03027"\w*. \w If|strong="H00518"\w* \w it pleases|strong="H02896"\w* \w . . .|strong="H05869"\w* \w you to come|strong="H00935"\w* \w with me|strong="H00854"\w* \w to Babylon|strong="H00894"\w*, \w then come|strong="H00935"\w*, \w and I will take care of|strong="H07760"\w* \w -|strong="H00853"\w* \w -|strong="H05869"\w* \w you|strong="H05921"\w*. \w But if|strong="H00518"\w* \w it seems wrong|strong="H07489"\w* \w . . .|strong="H05869"\w* \w to you to come|strong="H00935"\w* \w with me|strong="H00854"\w* \w to Babylon|strong="H00894"\w*, \w go no farther|strong="H02308"\w*. \w Look|strong="H07200"\w*, \w the whole|strong="H03605"\w* \w land|strong="H00776"\w* \w is before you|strong="H06440"\w*. \w . . .|strong="H00413"\w* \w Wherever it seems|strong="H05869"\w* \w good|strong="H02896"\w* \w . . .|strong="H00413"\w* \w and right to you|strong="H03477"\w* \w -|strong="H01980"\w*, \w go|strong="H01980"\w* \w there|strong="H08033"\w*.”
\p \v 5 \w But before Jeremiah|strong="H03808"\w* \w . . .|strong="H05750"\w* \w turned to go|strong="H07725"\w*, \w Nebuzaradan|strong="H07725"\w* \w added|strong="H00413"\w*, “\w Return to Gedaliah|strong="H01436"\w* \w son|strong="H01121"\w* \w of Ahikam|strong="H00296"\w*, \w the son|strong="H01121"\w* \w of Shaphan|strong="H08227"\w*, \w whom|strong="H00834"\w* \w the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w has appointed|strong="H06485"\w* \w over the cities|strong="H05892"\w* \w of Judah|strong="H03063"\w*, \w and stay|strong="H03427"\w* \w with him|strong="H00854"\w* \w among|strong="H08432"\w* \w the people|strong="H05971"\w*, \w or|strong="H00176"\w* \w go|strong="H01980"\w* \w anywhere else|strong="H00413"\w* \w . . .|strong="H03605"\w* \w that seems right|strong="H03477"\w* \w . . .|strong="H05869"\w* \w . . .|strong="H01980"\w*.” \w Then the captain|strong="H07227"\w* \w of the guard|strong="H02876"\w* \w gave|strong="H05414"\w* him \w a ration|strong="H00737"\w* \w and a gift|strong="H04864"\w* \w and released him|strong="H07971"\w*.
\p \v 6 \w So Jeremiah|strong="H03414"\w* \w went|strong="H00935"\w* \w to|strong="H00413"\w* \w Gedaliah|strong="H01436"\w* \w son|strong="H01121"\w* \w of Ahikam|strong="H00296"\w* \w at Mizpah|strong="H04709"\w* \w and stayed|strong="H03427"\w* \w with him|strong="H00854"\w* \w among|strong="H08432"\w* \w the people|strong="H05971"\w* \w who were left|strong="H07604"\w* \w in the land|strong="H00776"\w*.
\s1 Gedaliah Governs in Judah
\r (2 Kings 25:22–24)
\p \v 7 \w When all|strong="H03605"\w* \w the commanders|strong="H08269"\w* \w -|strong="H01992"\w* \w and men|strong="H00582"\w* \w of the armies|strong="H02428"\w*\w . . .|strong="H00834"\w* \w in the field|strong="H07704"\w* \w heard|strong="H08085"\w* \w that|strong="H03588"\w* \w the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w -|strong="H00853"\w* \w had appointed|strong="H06485"\w* \w Gedaliah|strong="H01436"\w* \w son|strong="H01121"\w* \w of Ahikam|strong="H00296"\w* \w over the land|strong="H00776"\w* \w and that|strong="H03588"\w* \w he had put him in charge|strong="H06485"\w* \w . . .|strong="H00854"\w* \w of the men|strong="H00582"\w*, \w women|strong="H00802"\w*, \w and children|strong="H02945"\w* \w [who were] the poorest|strong="H01803"\w* \w of the land|strong="H00776"\w* \w [and]|strong="H00834"\w* \w had not|strong="H03808"\w* \w been exiled|strong="H01540"\w* \w to Babylon|strong="H00894"\w*, \v 8 \w they came|strong="H00935"\w* \w to|strong="H00413"\w* \w Gedaliah|strong="H01436"\w* \w at Mizpah|strong="H04709"\w* — \w Ishmael|strong="H03458"\w* \w son|strong="H01121"\w* \w of Nethaniah|strong="H05418"\w*, \w Johanan|strong="H03110"\w* \w and Jonathan|strong="H03129"\w* \w the sons|strong="H01121"\w* \w of Kareah|strong="H07143"\w*, \w Seraiah|strong="H08304"\w* \w son|strong="H01121"\w* \w of Tanhumeth|strong="H08576"\w*, \w the sons|strong="H01121"\w* \w of Ephai|strong="H05778"\w* \w the Netophathite|strong="H05200"\w*, \w and Jezaniah|strong="H02970"\w*\f + \fr 40:8 \fqa Jezaniah \ft is a variant of \fqa Jaazaniah\ft ; see 2 Kings 25:23.\f* \w son|strong="H01121"\w* \w of the Maacathite|strong="H04602"\w* — \w they|strong="H01992"\w* \w and their men|strong="H00582"\w*.
\p \v 9 \w Gedaliah|strong="H01436"\w* \w son|strong="H01121"\w* \w of Ahikam|strong="H00296"\w*, \w the son|strong="H01121"\w* \w of Shaphan|strong="H08227"\w*, \w swore an oath|strong="H07650"\w* to them \w and their men|strong="H00582"\w*, \w assuring them|strong="H00559"\w*, “\w Do not|strong="H00408"\w* \w be afraid|strong="H03372"\w* \w to serve|strong="H05647"\w* \w the Chaldeans|strong="H03778"\w*.\f + \fr 40:9 \ft That is, the Babylonians; also in verse 10\f* \w Live|strong="H03427"\w* \w in the land|strong="H00776"\w* \w and serve|strong="H05647"\w* \w -|strong="H00853"\w* \w the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*, \w and it will go well|strong="H03190"\w* with you. \v 10 \w As for me|strong="H00589"\w*, \w I will|strong="H02005"\w* \w stay|strong="H03427"\w* \w in Mizpah|strong="H04709"\w* \w to represent|strong="H05975"\w* \w you before|strong="H06440"\w* \w the Chaldeans|strong="H03778"\w* \w who|strong="H00834"\w* \w come|strong="H00935"\w* \w to us|strong="H00413"\w*. \w As for you|strong="H00859"\w*, \w gather|strong="H00622"\w* \w wine [grapes]|strong="H03196"\w*, \w summer fruit|strong="H07019"\w*, \w and oil|strong="H08081"\w*, \w place them|strong="H07760"\w* \w in your storage jars|strong="H03627"\w*, \w and live|strong="H03427"\w* \w in the cities|strong="H05892"\w* \w -|strong="H00834"\w* \w you have taken|strong="H08610"\w*.”
\p \v 11 \w When|strong="H01571"\w* \w all|strong="H03605"\w* \w the Jews|strong="H03064"\w* \w -|strong="H00834"\w* \w in Moab|strong="H04124"\w*, \w Ammon|strong="H01121"\w*, \w . . .|strong="H05983"\w* \w Edom|strong="H00123"\w*, \w -|strong="H00834"\w* \w and all|strong="H03605"\w* \w the other lands|strong="H00776"\w* \w heard|strong="H08085"\w* \w that|strong="H03588"\w* \w the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w had left|strong="H05414"\w* \w a remnant|strong="H07611"\w* \w in Judah|strong="H03063"\w* \w . . .|strong="H03588"\w* \w and had appointed|strong="H06485"\w* \w Gedaliah|strong="H01436"\w* \w son|strong="H01121"\w* \w of Ahikam|strong="H00296"\w*, \w the son|strong="H01121"\w* \w of Shaphan|strong="H08227"\w*, \w over them|strong="H05921"\w*, \w -|strong="H00853"\w* \v 12 \w they|strong="H03064"\w* \w all|strong="H03605"\w* \w returned|strong="H07725"\w* \w from all|strong="H03605"\w* \w the places|strong="H04725"\w* \w to which|strong="H00834"\w* \w they had been banished|strong="H05080"\w* \w . . .|strong="H08033"\w* \w and came|strong="H00935"\w* \w to the land|strong="H00776"\w* \w of Judah|strong="H03063"\w*, \w to|strong="H00413"\w* \w Gedaliah|strong="H01436"\w* \w at Mizpah|strong="H04709"\w*. \w And they gathered|strong="H00622"\w* \w an abundance|strong="H07235"\w* \w . . .|strong="H03966"\w* \w of wine [grapes]|strong="H03196"\w* \w and summer fruit|strong="H07019"\w*.
\s1 The Plot against Gedaliah
\p \v 13 \w Meanwhile, Johanan|strong="H03110"\w* \w son|strong="H01121"\w* \w of Kareah|strong="H07143"\w* \w and all|strong="H03605"\w* \w the commanders|strong="H08269"\w* \w of the armies|strong="H02428"\w* \w -|strong="H00834"\w* \w in the field|strong="H07704"\w* \w came|strong="H00935"\w* \w to|strong="H00413"\w* \w Gedaliah|strong="H01436"\w* \w at Mizpah|strong="H04709"\w* \v 14 \w and said to him|strong="H00559"\w*, \w . . .|strong="H00413"\w* “\w Are you aware|strong="H03045"\w* \w . . .|strong="H03045"\w* \w that|strong="H03588"\w* \w Baalis|strong="H01185"\w* \w king|strong="H04428"\w* \w of the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w* \w has sent|strong="H07971"\w* \w -|strong="H00853"\w* \w Ishmael|strong="H03458"\w* \w son|strong="H01121"\w* \w of Nethaniah|strong="H05418"\w* \w to take|strong="H05221"\w* \w your life|strong="H05315"\w*?”
\p \w But Gedaliah|strong="H01436"\w* \w son|strong="H01121"\w* \w of Ahikam|strong="H00296"\w* \w did not|strong="H03808"\w* \w believe|strong="H00539"\w* them.
\p \v 15 \w Then Johanan|strong="H03110"\w* \w son|strong="H01121"\w* \w of Kareah|strong="H07143"\w* \w spoke|strong="H00559"\w* \w privately|strong="H05643"\w* \w to|strong="H00413"\w* \w Gedaliah|strong="H01436"\w* \w at Mizpah|strong="H04709"\w*. “\w Let me go|strong="H01980"\w* \w . . .|strong="H04994"\w* \w and kill|strong="H05221"\w* \w -|strong="H00853"\w* \w Ishmael|strong="H03458"\w* \w son|strong="H01121"\w* \w of Nethaniah|strong="H05418"\w*,” \w he said|strong="H00559"\w*. “\w No|strong="H03808"\w* \w one|strong="H00376"\w* \w will know it|strong="H03045"\w*. \w Why|strong="H04100"\w* \w should he take|strong="H05221"\w* \w your life|strong="H05315"\w* \w and scatter|strong="H06327"\w* \w all|strong="H03605"\w* \w the [people] of Judah|strong="H03063"\w* \w who have gathered|strong="H06908"\w* \w to you|strong="H00413"\w*, \w so that the remnant|strong="H07611"\w* \w of Judah|strong="H03063"\w* \w would perish|strong="H00006"\w*?”
\p \v 16 \w But Gedaliah|strong="H01436"\w* \w son|strong="H01121"\w* \w of Ahikam|strong="H00296"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Johanan|strong="H03110"\w* \w son|strong="H01121"\w* \w of Kareah|strong="H07143"\w*, “\w Do not|strong="H00408"\w* \w do|strong="H06213"\w* \w -|strong="H00853"\w* \w such a thing|strong="H01697"\w* \w . . .|strong="H02088"\w*! \w . . .|strong="H03588"\w* \w What you are|strong="H00859"\w* \w saying|strong="H01696"\w* \w about|strong="H00413"\w* \w Ishmael|strong="H03458"\w* \w is a lie|strong="H08267"\w*.”
\c 41
\s1 The Murder of Gedaliah
\r (2 Kings 25:25–26)
\p \v 1 \w -|strong="H01961"\w* \w In the seventh|strong="H07637"\w* \w month|strong="H02320"\w*, \w Ishmael|strong="H03458"\w* \w son|strong="H01121"\w* \w of Nethaniah|strong="H05418"\w*, \w the son|strong="H01121"\w* \w of Elishama|strong="H00476"\w*, \w [who was a member] of the royal|strong="H04410"\w* \w family|strong="H02233"\w* \w and one of the king’s|strong="H04428"\w* \w chief officers|strong="H07227"\w*, \w came|strong="H00935"\w* \w with|strong="H00854"\w* \w ten|strong="H06235"\w* \w men|strong="H00582"\w* \w to|strong="H00413"\w* \w Gedaliah|strong="H01436"\w* \w son|strong="H01121"\w* \w of Ahikam|strong="H00296"\w* \w at Mizpah|strong="H04709"\w*, \w and they ate|strong="H00398"\w* \w a meal|strong="H03899"\w* \w together|strong="H03162"\w* \w there|strong="H08033"\w* \w -|strong="H04709"\w*. \v 2 \w Then Ishmael|strong="H03458"\w* \w son|strong="H01121"\w* \w of Nethaniah|strong="H05418"\w* \w and the ten|strong="H06235"\w* \w men|strong="H00582"\w* \w who|strong="H00834"\w* \w were|strong="H01961"\w* \w with him|strong="H00854"\w* \w got up|strong="H06965"\w* \w and struck down|strong="H05221"\w* \w -|strong="H00853"\w* \w Gedaliah|strong="H01436"\w* \w son|strong="H01121"\w* \w of Ahikam|strong="H00296"\w*, \w the son|strong="H01121"\w* \w of Shaphan|strong="H08227"\w*, \w with the sword|strong="H02719"\w*, \w killing|strong="H04191"\w* \w the one|strong="H00853"\w* \w whom|strong="H00834"\w* \w the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w had appointed to govern|strong="H06485"\w* \w the land|strong="H00776"\w*. \v 3 \w Ishmael|strong="H03458"\w* \w also|strong="H00853"\w* \w killed|strong="H05221"\w* \w all|strong="H03605"\w* \w the Jews|strong="H03064"\w* \w who|strong="H00834"\w* \w were|strong="H01961"\w* \w with|strong="H00854"\w* \w . . .|strong="H00854"\w* \w Gedaliah|strong="H01436"\w* \w at Mizpah|strong="H04709"\w*, \w -|strong="H00853"\w* \w as well as the Chaldean|strong="H03778"\w*\f + \fr 41:3 \ft Or \fqa Babylonian\f* \w soldiers|strong="H04421"\w* \w who|strong="H00834"\w* \w . . .|strong="H04672"\w* \w were there|strong="H08033"\w*. \w -|strong="H00853"\w* \w -|strong="H00582"\w*
\p \v 4 \w -|strong="H01961"\w* \w On the second|strong="H08145"\w* \w day|strong="H03117"\w* \w after the murder|strong="H04191"\w* \w -|strong="H00853"\w* \w of Gedaliah|strong="H01436"\w*, \w when no|strong="H03808"\w* \w one|strong="H00376"\w* \w yet knew about it|strong="H03045"\w*, \v 5 \w eighty|strong="H08084"\w* \w . . .|strong="H00376"\w* \w men|strong="H00582"\w* \w who had shaved off|strong="H01548"\w* \w their beards|strong="H02206"\w*, \w torn|strong="H07167"\w* \w their garments|strong="H00899"\w*, \w and cut themselves|strong="H01413"\w* \w came|strong="H00935"\w* \w from Shechem|strong="H07927"\w*, \w Shiloh|strong="H07887"\w*, \w and Samaria|strong="H08111"\w*, \w vvv|strong="H03027"\w* \w carrying|strong="H00935"\w* \w grain offerings|strong="H04503"\w* \w and frankincense|strong="H03828"\w* \w for the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*. \v 6 \w And Ishmael|strong="H03458"\w* \w son|strong="H01121"\w* \w of Nethaniah|strong="H05418"\w* \w went out|strong="H03318"\w* \w from|strong="H04480"\w* \w Mizpah|strong="H04709"\w* \w to meet them|strong="H07122"\w*, \w weeping|strong="H01058"\w* \w . . .|strong="H01961"\w* \w as he went|strong="H01980"\w* \w . . .|strong="H01980"\w*.
