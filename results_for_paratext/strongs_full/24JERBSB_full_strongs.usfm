\q2 \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*.
\q1 \w Though|strong="H03588"\w* \w I will completely|strong="H06213"\w* \w destroy|strong="H03617"\w* \w all|strong="H03605"\w* \w the nations|strong="H01471"\w* \w to which|strong="H00834"\w* \w I have scattered you|strong="H06327"\w*, \w . . .|strong="H08033"\w*
\q2 \w -|strong="H00389"\w* \w -|strong="H00853"\w* \w I will not|strong="H03808"\w* \w completely destroy you|strong="H06213"\w* \w . . .|strong="H03617"\w*.
\q1 \w Yet I will discipline you|strong="H03256"\w* \w justly|strong="H04941"\w*,
\q2 \w and will by no means|strong="H03808"\w* \w leave you unpunished|strong="H05352"\w* \w . . .|strong="H05352"\w*.”
\p \v 12 \w For|strong="H03588"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*:
\b 
\q1 “\w Your injury|strong="H07667"\w* \w is incurable|strong="H00605"\w*;
\q2 \w your wound|strong="H04347"\w* \w [is] grievous|strong="H02470"\w*.
\q1 \v 13 \w [There is] no one|strong="H00369"\w* \w to plead your cause|strong="H01777"\w*,
