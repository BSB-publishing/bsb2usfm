\p \v 12 \w On the tenth|strong="H06218"\w* \w . . .|strong="H02320"\w* \w day of the fifth|strong="H02549"\w* \w month|strong="H02320"\w*, \w -|strong="H01931"\w* \w in the nineteenth|strong="H08672"\w* \w . . .|strong="H06240"\w* \w . . .|strong="H08141"\w* \w year|strong="H08141"\w* \w -|strong="H04428"\w* \w of Nebuchadnezzar’s|strong="H05019"\w* \w reign|strong="H04428"\w* \w over Babylon|strong="H00894"\w*, \w Nebuzaradan|strong="H05018"\w* \w captain|strong="H07227"\w* \w of the guard|strong="H02876"\w*, \w a servant|strong="H05975"\w* \w . . .|strong="H06440"\w* \w of the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*, \w entered|strong="H00935"\w* \w Jerusalem|strong="H03389"\w*. \v 13 \w He burned down|strong="H08313"\w* \w -|strong="H00853"\w* \w -|strong="H00853"\w* \w the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*, \w the royal|strong="H04428"\w* \w -|strong="H00853"\w* \w palace|strong="H01004"\w*, \w and all|strong="H03605"\w* \w the houses|strong="H01004"\w* \w of Jerusalem|strong="H03389"\w* — \w -|strong="H08313"\w* \w -|strong="H00784"\w* \w -|strong="H00853"\w* \w every|strong="H03605"\w* \w significant|strong="H01419"\w* \w building|strong="H01004"\w*. \v 14 \w And|strong="H00853"\w* \w the whole|strong="H03605"\w* \w army|strong="H02428"\w* \w of the Chaldeans|strong="H03778"\w* \w -|strong="H00834"\w* \w under|strong="H00854"\w* \w the captain|strong="H07227"\w* \w of the guard|strong="H02876"\w* \w broke down|strong="H05422"\w* \w all|strong="H03605"\w* \w the walls|strong="H02346"\w* \w around|strong="H05439"\w* \w Jerusalem|strong="H03389"\w*.
\p \v 15 \w Then Nebuzaradan|strong="H05018"\w* \w captain|strong="H07227"\w* \w of the guard|strong="H02876"\w* \w carried into exile|strong="H01540"\w* \w [some of] the poorest|strong="H01803"\w* \w people|strong="H05971"\w* \w and|strong="H00853"\w* \w those who remained|strong="H03499"\w* \w . . .|strong="H05971"\w* \w . . .|strong="H07604"\w* \w in the city|strong="H05892"\w*, \w along with|strong="H00853"\w* \w the deserters|strong="H05307"\w* \w who|strong="H00834"\w* \w had defected|strong="H05307"\w* \w to|strong="H00413"\w* \w the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w -|strong="H00853"\w* \w and the rest|strong="H03499"\w* \w of the craftsmen|strong="H00525"\w*. \v 16 \w But Nebuzaradan|strong="H05018"\w* \w captain|strong="H07227"\w* \w of the guard|strong="H02876"\w* \w left behind|strong="H07604"\w* \w some of the poorest|strong="H01803"\w* \w of the land|strong="H00776"\w* \w to tend the vineyards|strong="H03755"\w* \w and fields|strong="H03009"\w*.
