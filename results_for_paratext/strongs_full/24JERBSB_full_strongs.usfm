\p \v 15 \w Therefore|strong="H03651"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w* \w says|strong="H00559"\w* \w concerning|strong="H05921"\w* \w the prophets|strong="H05030"\w*: \w . . .|strong="H02005"\w*
