\p \v 13 \w This is the word|strong="H01697"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w spoke|strong="H01696"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w the prophet|strong="H05030"\w* \w about the coming|strong="H00935"\w* \w of Nebuchadnezzar|strong="H05019"\w* \w king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w to strike|strong="H05221"\w* \w -|strong="H00853"\w* \w the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w*:
