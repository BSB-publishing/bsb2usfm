\p \v 20 \w Say|strong="H00559"\w* \w to them|strong="H00413"\w*, ‘\w Hear|strong="H08085"\w* \w the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w*, \w O kings|strong="H04428"\w* \w of Judah|strong="H03063"\w*, \w all [people]|strong="H03605"\w* \w of Judah|strong="H03063"\w* \w [and]|strong="H03605"\w* \w . . .|strong="H03427"\w* \w Jerusalem|strong="H03389"\w* \w who enter|strong="H00935"\w* \w through these|strong="H00428"\w* \w gates|strong="H08179"\w*. \v 21 \w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: \w Take heed|strong="H08104"\w* \w for yourselves|strong="H05315"\w*; \w do not|strong="H00408"\w* \w carry|strong="H05375"\w* \w a load|strong="H04853"\w* \w [or] bring it|strong="H00935"\w* \w through the gates|strong="H08179"\w* \w of Jerusalem|strong="H03389"\w* \w on the Sabbath|strong="H07676"\w* \w day|strong="H03117"\w*. \v 22 \w You must not|strong="H03808"\w* \w carry a load|strong="H04853"\w* \w out|strong="H03318"\w* \w of your houses|strong="H01004"\w* \w or do|strong="H06213"\w* \w any|strong="H03605"\w* \w work|strong="H04399"\w* \w on the Sabbath|strong="H07676"\w* \w day|strong="H03117"\w*, \w . . .|strong="H03808"\w* \w but you must keep|strong="H06942"\w* \w -|strong="H00853"\w* \w the Sabbath|strong="H07676"\w* \w day {holy}|strong="H03117"\w*, \w just as|strong="H00834"\w* \w I commanded|strong="H06680"\w* \w -|strong="H00853"\w* \w your forefathers|strong="H00001"\w*. \v 23 \w Yet they would not|strong="H03808"\w* \w listen|strong="H08085"\w* \w . . .|strong="H03808"\w* \w or incline|strong="H05186"\w* \w -|strong="H00853"\w* \w their ear|strong="H00241"\w*, \w but they stiffened|strong="H07185"\w* \w -|strong="H00853"\w* \w their necks|strong="H06203"\w* \w and would not|strong="H01115"\w* \w listen|strong="H08085"\w* \w . . .|strong="H01115"\w* \w or receive|strong="H03947"\w* \w My discipline|strong="H04148"\w*.
\p \v 24 \w If|strong="H00518"\w*, \w however|strong="H01961"\w*, \w you listen carefully|strong="H08085"\w* \w . . .|strong="H08085"\w* \w to Me|strong="H00413"\w*, \w says|strong="H05002"\w* \w the LORD|strong="H03068"\w*, \w and bring|strong="H00935"\w* \w no|strong="H01115"\w* \w load|strong="H04853"\w* \w through the gates|strong="H08179"\w* \w of this|strong="H02063"\w* \w city|strong="H05892"\w* \w on the Sabbath|strong="H07676"\w* \w day|strong="H03117"\w*, \w and keep|strong="H06942"\w* \w -|strong="H00853"\w* \w the Sabbath|strong="H07676"\w* \w day {holy}|strong="H03117"\w*, \w and do|strong="H06213"\w* \w -|strong="H03605"\w* \w no|strong="H01115"\w* \w work|strong="H04399"\w* on it, \v 25 \w then kings|strong="H04428"\w* \w and princes|strong="H08269"\w* \w will enter|strong="H00935"\w* \w through the gates|strong="H08179"\w* \w of this|strong="H02063"\w* \w city|strong="H05892"\w*. \w They will sit|strong="H03427"\w* \w on|strong="H05921"\w* \w the throne|strong="H03678"\w* \w of David|strong="H01732"\w*, \w riding|strong="H07392"\w* \w in chariots|strong="H07393"\w* \w and on horses|strong="H05483"\w* \w with their|strong="H01992"\w* \w officials|strong="H08269"\w*, \w along with the men|strong="H00376"\w* \w of Judah|strong="H03063"\w* \w and the residents|strong="H03427"\w* \w of Jerusalem|strong="H03389"\w*, \w and this|strong="H02063"\w* \w city|strong="H05892"\w* \w will be inhabited|strong="H03427"\w* \w forever|strong="H05769"\w*. \v 26 \w And people will come|strong="H00935"\w* \w from the cities|strong="H05892"\w* \w of Judah|strong="H03063"\w* \w and the places around|strong="H05439"\w* \w Jerusalem|strong="H03389"\w*, \w from the land|strong="H00776"\w* \w of Benjamin|strong="H01144"\w*, \w and from|strong="H04480"\w* \w the foothills|strong="H08219"\w*,\f + \fr 17:26 \ft Hebrew \fqa Shephelah \ft or \fqa lowlands\ft ; that is, the western foothills of Judea\f*\w . . .|strong="H04480"\w* \w the hill country|strong="H02022"\w*, \w and|strong