\c 11
\s1 The Broken Covenant
\p \v 1 \w [This is] the word|strong="H01697"\w* \w that|strong="H00834"\w* \w came|strong="H01961"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w -|strong="H00854"\w* \w from the LORD|strong="H03068"\w* \w . . .|strong="H00559"\w*: \v 2 “\w Listen|strong="H08085"\w* \w -|strong="H00853"\w* \w to the words|strong="H01697"\w* \w of this|strong="H02063"\w* \w covenant|strong="H01285"\w* \w and tell them|strong="H01696"\w* \w to|strong="H00413"\w* \w the men|strong="H00376"\w* \w of Judah|strong="H03063"\w* \w . . .|strong="H05921"\w* \w and the residents|strong="H03427"\w* \w of Jerusalem|strong="H03389"\w*. \v 3 \w You must tell them that|strong="H00559"\w* \w . . .|strong="H00413"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w says|strong="H00559"\w*: \w Cursed is|strong="H00779"\w* \w the man|strong="H00376"\w* \w who|strong="H00834"\w* \w does not|strong="H03808"\w* \w obey|strong="H08085"\w* \w -|strong="H00853"\w* \w the words|strong="H01697"\w* \w of this|strong="H02063"\w* \w covenant|strong="H01285"\w*, \v 4 \w which|strong="H00834"\w* \w I commanded|strong="H06680"\w* \w -|strong="H00853"\w* \w your forefathers|strong="H00001"\w* \w when|strong="H03117"\w* \w I brought them out|strong="H03318"\w* \w -|strong="H00853"\w* \w of the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w*, \w out of the iron|strong="H01270"\w* \w furnace|strong="H03564"\w*, \w saying|strong="H00559"\w*, ‘\w Obey Me|strong="H08085"\w*, \w . . .|strong="H06963"\w* \w and do|strong="H06213"\w* \w -|strong="H00853"\w* \w everything|strong="H03605"\w* \w -|strong="H00834"\w* \w I command you|strong="H06680"\w*, \w -|strong="H00853"\w* \w and you will be|strong="H01961"\w* My \w people|strong="H05971"\w*, \w and I|strong="H00595"\w* \w will be|strong="H01961"\w* your \w God|strong="H00430"\w*.’ \v 5 \w [This was] in order to|strong="H04616"\w* \w establish|strong="H06965"\w* \w -|strong="H00853"\w* \w the oath|strong="H07621"\w* \w -|strong="H00834"\w* \w I swore|strong="H07650"\w* \w to your forefathers|strong="H00001"\w*, \w to give them|strong="H05414"\w* . . . \w a land|strong="H00776"\w* \w flowing|strong="H02100"\w* \w with milk|strong="H02461"\w* \w and honey|strong="H01706"\w*, \w as it is to this day|strong="H03117"\w* \w . . .|strong="H02088"\w*.”
\p “\w Amen|strong="H00543"\w*, \w LORD|strong="H03068"\w*,” \w I answered|strong="H06030"\w*. \w . . .|strong="H00559"\w*
\p \v 6 \w Then the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to me|strong="H00413"\w*, “\w Proclaim|strong="H07121"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w these|strong="H00428"\w* \w words|strong="H01697"\w* \w in the cities|strong="H05892"\w* \w of Judah|strong="H03063"\w* \w and in the streets|strong="H02351"\w* \w of Jerusalem|strong="H03389"\w*, \w saying|strong="H00559"\w*: \w Hear|strong="H08085"\w* \w -|strong="H00853"\w* \w the words|strong="H01697"\w* \w of this|strong="H02063"\w* \w covenant|strong="H01285"\w* \w and carry them out|strong="H06213"\w*. \w -|strong="H00853"\w* \v 7 \w For|strong="H03588"\w* \w from the time|strong="H03117"\w* \w I brought|strong="H05927"\w* \w your fathers|strong="H00001"\w* \w -|strong="H00853"\w* \w out of the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w* \w until|strong="H05704"\w* \w today|strong="H03117"\w* \w . . .|strong="H02088"\w*, \w I strongly warned them|strong="H05749"\w* \w . . .|strong="H05749"\w* \w again and again|strong="H07925"\w* \w . . .|strong="H05749"\w*,\f + \fr 11:7 \ft Literally \fqa I earnestly warned them, rising up early and warning (them),\f* \w saying|strong="H00559"\w*, ‘\w Obey|strong="H08085"\w* \w My voice|strong="H06963"\w*.’ \v 8 \w Yet they would|strong="H03808"\w* \w not|strong="H03808"\w* \w obey|strong="H08085"\w* \w or incline|strong="H05186"\w*\w . . .|strong="H00853"\w* \w their ears|strong="H00241"\w*, \w but each one|strong="H00376"\w* \w followed|strong="H01980"\w* \w the stubbornness|strong="H08307"\w* \w of his evil|strong="H07451"\w* \w heart|strong="H03820"\w*. \w So I brought|strong="H00935"\w* \w on|strong="H05921"\w* \w them|strong="H00853"\w* \w all|strong="H03605"\w* \w the curses|strong="H01697"\w* \w of this|strong="H02063"\w* \w covenant|strong="H01285"\w* \w -|strong="H00834"\w* \w I had commanded them|strong="H06680"\w* \w to follow|strong="H06213"\w* \w but they did not keep|strong="H06213"\w* \w . . .|strong="H03808"\w*.”
\p \v 9 \w And the LORD|strong="H03068"\w* \w told|strong="H00559"\w* \w me|strong="H00413"\w*, “\w There is|strong="H04672"\w* \w a conspiracy|strong="H07195"\w* \w among the men|strong="H00376"\w* \w of Judah|strong="H03063"\w* \w and the residents|strong="H03427"\w* \w of Jerusalem|strong="H03389"\w*. \v 10 \w They have returned|strong="H07725"\w* \w to|strong="H05921"\w* \w the sins|strong="H05771"\w* \w of their forefathers|strong="H00001"\w* \w . . .|strong="H07223"\w* \w who|strong="H00834"\w* \w refused|strong="H03985"\w* \w to obey|strong="H08085"\w* \w -|strong="H00853"\w* \w My words|strong="H01697"\w*. \w They|strong="H01992"\w* \w have followed|strong="H01980"\w* \w . . .|strong="H00310"\w* \w other|strong="H00312"\w* \w gods|strong="H00430"\w* \w to serve them|strong="H05647"\w*. \w The house|strong="H01004"\w* \w of Israel|strong="H03478"\w* \w and the house|strong="H01004"\w* \w of Judah|strong="H03063"\w* \w -|strong="H00853"\w* \w have broken|strong="H06565"\w* \w the covenant|strong="H01285"\w* \w -|strong="H00834"\w* \w I made|strong="H03772"\w* \w with|strong="H00854"\w* \w their fathers|strong="H00001"\w*.
\p \v 11 \w Therefore|strong="H03651"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w . . .|strong="H02005"\w* \w says|strong="H00559"\w*: ‘\w I am about to bring|strong="H00935"\w* \w upon them|strong="H00413"\w* \w a disaster|strong="H07451"\w* \w that|strong="H00834"\w* \w they cannot|strong="H03808"\w* \w . . .|strong="H03201"\w* \w escape|strong="H03318"\w*. \w . . .|strong="H04480"\w* \w They will cry out|strong="H02199"\w* \w to Me|strong="H00413"\w*, \w but I will not|strong="H03808"\w* \w listen|strong="H08085"\w* \w to them|strong="H00413"\w*. \v 12 \w Then the cities|strong="H05892"\w* \w of Judah|strong="H03063"\w* \w and the residents|strong="H03427"\w* \w of Jerusalem|strong="H03389"\w* \w will go|strong="H01980"\w* \w and cry out|strong="H02199"\w* \w to|strong="H00413"\w* \w the gods|strong="H00430"\w* \w to which|strong="H00834"\w* \w they|strong="H01992"\w* \w have been burning incense|strong="H06999"\w*, \w but [these gods] certainly will not|strong="H03808"\w* \w save|strong="H03467"\w* \w . . .|strong="H03467"\w* them \w in their time|strong="H06256"\w* \w of disaster|strong="H07451"\w*. \v 13 \w Your gods|strong="H00430"\w* \w are|strong="H01961"\w* \w indeed|strong="H03588"\w* \w as numerous|strong="H04557"\w* \w as your cities|strong="H05892"\w*, \w O Judah|strong="H03063"\w*; \w the altars|strong="H04196"\w* \w of shame|strong="H01322"\w* \w you have set up|strong="H07760"\w*— \w the altars|strong="H04196"\w* \w to burn incense|strong="H06999"\w* \w to Baal|strong="H01168"\w*— \w are as many|strong="H04557"\w* \w as the streets|strong="H02351"\w* \w of Jerusalem|strong="H03389"\w*.’
\p \v 14 \w As for you|strong="H00859"\w*, \w do not|strong="H00408"\w* \w pray|strong="H06419"\w* \w for|strong="H01157"\w* \w these|strong="H02088"\w* \w people|strong="H05971"\w*. \w Do not|strong="H00408"\w* \w raise up|strong="H05375"\w* \w a cry|strong="H07440"\w* \w or a prayer|strong="H08605"\w* \w on their behalf|strong="H01157"\w*, \w for|strong="H03588"\w* \w I will not|strong="H00369"\w* \w be listening|strong="H08085"\w* \w when they call out|strong="H07121"\w* \w to Me|strong="H00413"\w* \w . . .|strong="H01157"\w* \w in their time|strong="H06256"\w* \w of disaster|strong="H07451"\w*.
\b 
