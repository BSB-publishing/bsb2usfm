\s1 Pashhur Persecutes Jeremiah
\p \v 1 \w When Pashhur|strong="H06583"\w* \w the priest|strong="H03548"\w*, \w . . .|strong="H01931"\w* \w the son|strong="H01121"\w* \w of Immer|strong="H00564"\w* \w and the chief|strong="H05057"\w* \w official|strong="H06496"\w* \w in the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*, \w -|strong="H00853"\w* \w heard|strong="H08085"\w* \w Jeremiah|strong="H03414"\w* \w prophesying|strong="H05012"\w* \w -|strong="H00853"\w* \w these|strong="H00428"\w* \w things|strong="H01697"\w*, \v 2 \w [he]|strong="H06583"\w* \w -|strong="H00853"\w* \w had Jeremiah|strong="H03414"\w* \w the prophet|strong="H05030"\w* \w beaten|strong="H05221"\w* \w and put|strong="H05414"\w* \w -|strong="H00853"\w* \w in|strong="H05921"\w* \w the stocks|strong="H04115"\w* \w -|strong="H00834"\w* \w at the Upper|strong="H05945"\w* \w Gate|strong="H08179"\w* \w of Benjamin|strong="H01144"\w*, \w which [was]|strong="H00834"\w* \w by the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*.
\p \v 3 \w -|strong="H01961"\w* \w The next day|strong="H04283"\w*, \w when Pashhur|strong="H06583"\w* \w -|strong="H00853"\w* \w released|strong="H03318"\w* \w Jeremiah|strong="H03414"\w* \w from|strong="H04480"\w* \w the stocks|strong="H04115"\w*, \w Jeremiah|strong="H03414"\w* \w said|strong="H00559"\w* \w to him|strong="H00413"\w*, “\w The LORD|strong="H03068"\w* \w does not|strong="H03808"\w* \w call|strong="H07121"\w* \w . . .|strong="H08034"\w* \w you Pashhur|strong="H06583"\w*, \w but|strong="H03588"\w* \w . . .|strong="H00518"\w* \w vvv|strong="H04036"\w* \w Magor-missabib|strong="H04036"\w*.\f + \fr 20:3 \fqa Magor-missabib \ft means \fqa terror on every side \ft or \fqa the man who lives in terror\ft .\f* \v 4 \w For|strong="H03588"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w . . .|strong="H02005"\w* \w says|strong="H00559"\w*: ‘\w I will make you|strong="H05414"\w* \w a terror|strong="H04032"\w* to yourself \w and to all|strong="H03605"\w* \w your friends|strong="H00157"\w*. \w They will fall|strong="H05307"\w* \w by the sword|strong="H02719"\w* \w of their enemies|strong="H00341"\w* \w before your very eyes|strong="H05869"\w* \w . . .|strong="H07200"\w*. \w -|strong="H00853"\w* \w -|strong="H03605"\w* \w And I will hand Judah|strong="H03063"\w* \w over to|strong="H05414"\w* \w . . .|strong="H03027"\w* \w the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*, \w and he will carry them away|strong="H01540"\w* \w to Babylon|strong="H00894"\w* \w and put them|strong="H05221"\w* \w to the sword|strong="H02719"\w*. \v 5 \w I will give away|strong="H05414"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the wealth|strong="H02633"\w* \w of this|strong="H02063"\w* \w -|strong="H00853"\w* \w city|strong="H05892"\w* — \w all|strong="H03605"\w* \w its products|strong="H03018"\w* \w -|strong="H00853"\w* \w and valuables|strong="H03366"\w*, \w and|strong="H00853"\w* \w all|strong="H03605"\w* \w -|strong="H03605"\w* \w the tr