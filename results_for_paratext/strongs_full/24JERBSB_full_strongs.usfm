\s1 Judah’s Idolatry Persists
\p \v 16 \w As for you|strong="H00859"\w*, \w do not|strong="H00408"\w* \w pray|strong="H06419"\w* \w for|strong="H01157"\w* \w these|strong="H02088"\w* \w people|strong="H05971"\w*, \w do not|strong="H00408"\w* \w offer|strong="H05375"\w* \w a plea|strong="H07440"\w* \w or petition|strong="H08605"\w* \w on their behalf|strong="H01157"\w*, \w and do not|strong="H00408"\w* \w beg|strong="H06293"\w* Me, \w for|strong="H03588"\w* \w I will not|strong="H00369"\w* \w listen|strong="H08085"\w* \w to you|strong="H00853"\w*. \v 17 \w Do you not|strong="H00369"\w* \w see|strong="H07200"\w* \w what|strong="H04100"\w* \w they|strong="H01992"\w* \w are doing|strong="H06213"\w* \w in the cities|strong="H05892"\w* \w of Judah|strong="H03063"\w* \w and in the streets|strong="H02351"\w* \w of Jerusalem|strong="H03389"\w*? \v 18 \w The sons|strong="H01121"\w* \w gather|strong="H03950"\w* \w wood|strong="H06086"\w*, \w the fathers|strong="H00001"\w* \w light|strong="H01197"\w* \w -|strong="H00853"\w* \w the fire|strong="H00784"\w*, \w and the women|strong="H00802"\w* \w knead|strong="H03888"\w* \w the dough|strong="H01217"\w* \w to make|strong="H06213"\w* \w cakes|strong="H03561"\w* \w for the Queen|strong="H04446"\w* \w of Heaven|strong="H08064"\w*; \w they pour out|strong="H05258"\w* \w drink offerings|strong="H05262"\w* \w to other|strong="H00312"\w* \w gods|strong="H00430"\w* \w to|strong="H04616"\w* \w provoke Me to anger|strong="H03707"\w*. \v 19 \w -|strong="H00853"\w* \w But am I the One|strong="H01992"\w* \w they are provoking|strong="H03707"\w*? \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*. \w Is it not|strong="H03808"\w* \w themselves|strong="H00853"\w* \w they spite|strong="H04616"\w*, \w to their own shame|strong="H01322"\w* \w . . .|strong="H06440"\w*?
\p \v 20 \w Therefore|strong="H03651"\w* \w this is what|strong="H03541"\w* \w the Lord|strong="H00136"\w* \w GOD|strong="H03069"\w* \w says|strong="H00559"\w*: \w Behold|strong="H02009"\w*, \w My anger|strong="H00639"\w* \w and My fury|strong="H02534"\w* \w will|strong="H05413"\w* \w be poured out on|strong="H00413"\w* \w this|strong="H02088"\w* \w place|strong="H04725"\w*, \w on|strong="H05921"\w* \w man|strong="H00120"\w* \w and beast|strong="H00929"\w*, \w on|strong="H05921"\w* \w the trees|strong="H06086"\w* \w of the field|strong="H07704"\w* \w . . .|strong="H05921"\w* \w and|strong="H05921"\w* \w the produce|strong="H06529"\w* \w of the land|strong="H00127"\w*, \w and it will burn|strong="H01197"\w* \w and not|strong="H03808"\w* \w be extinguished|strong="H03518"\w*.
\p \v 21 \w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w says|strong="H00559"\w*: \w Add your burnt offerings|strong="H05930"\w* \w . . .|strong="H03254"\w* \w to|strong="H05921"\w* \w your other sacrifices|strong="H02077"\w* \w and eat|strong="H00398"\w* \w the meat yourselves|strong="H01320"\w*! \v 22 \w For|strong="H03588"\w* \w when|strong="H03117"\w* \w . . .|strong="H03808"\w* \w I brought|strong="H03318"\w* \w your fathers|strong="H00001"\w* \w -|strong="H00853"\w* \w out of the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w*, \w I did not merely|strong="H03808"\w* \w vvv|strong="H01696"\w* \w vvv|strong="H00854"\w* \w command them|strong="H06680"\w* \w about|strong="H05921"\w* \w . . .|strong="H01697"\w* \w burnt offerings|strong="H05930"\w* \w and sacrifices|strong="H02077"\w*, \v 23 \w but|strong="H03588"\w* \w . . .|strong="H00518"\w* \w -|strong="H00853"\w* \w -|strong="H01697"\w* \w this is what|strong="H02088"\w* \w I commanded them|strong="H06680"\w*: \w -|strong="H00853"\w* \w -|strong="H00559"\w* \w Obey Me|strong="H08085"\w*, \w . . .|strong="H06963"\w* \w and I will be|strong="H01961"\w* your \w God|strong="H00430"\w*, \w and you|strong="H00859"\w* \w will be|strong="H01961"\w* My \w people|strong="H05971"\w*. \w You must walk|strong="H01980"\w* \w in all|strong="H03605"\w* \w the ways|strong="H01870"\w* \w -|strong="H00834"\w* \w I have commanded|strong="H06680"\w* \w you|strong="H00853"\w*, \w so that|strong="H04616"\w* \w it may go well|strong="H03190"\w* with you.
\p \v 24 \w Yet they did not|strong="H03808"\w* \w listen|strong="H08085"\w* \w or|strong="H03808"\w* \w incline|strong="H05186"\w* \w -|strong="H00853"\w* \w their ear|strong="H00241"\w*, \w but they followed|strong="H01980"\w* \w the stubborn|strong="H08307"\w* \w inclinations|strong="H04156"\w* \w of their own evil|strong="H07451"\w* \w hearts|strong="H03820"\w*. \w They went|strong="H01961"\w* \w backward|strong="H00268"\w* \w and not|strong="H03808"\w* \w forward|strong="H06440"\w*. \v 25 \w From|strong="H04480"\w* \w the day|strong="H03117"\w* \w -|strong="H00834"\w* \w your fathers|strong="H00001"\w* \w came out|strong="H03318"\w* \w of the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w* \w until|strong="H05704"\w* \w this|strong="H02088"\w* \w day|strong="H03117"\w*, \w I have sent|strong="H07971"\w* \w you|strong="H00413"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w My servants|strong="H05650"\w* \w the prophets|strong="H05030"\w* \w . . .|strong="H03117"\w* \w again and again|strong="H07925"\w* \w . . .|strong="H07971"\w*.\f + \fr 7:25 \ft Literally \fqa I have sent you all My servants the prophets daily, rising up early and sending (them).\f* \v 26 \w Yet they would not|strong="H03808"\w* \w listen|strong="H08085"\w* \w to Me|strong="H00413"\w* \w [or]|strong="H03808"\w* \w incline|strong="H05186"\w* \w -|strong="H00853"\w* \w their ear|strong="H00241"\w*, \w but they stiffened|strong="H07185"\w*\w . . .|strong="H00853"\w* \w their necks|strong="H06203"\w* \w [and] did more evil|strong="H07489"\w* \w than their fathers|strong="H00001"\w*.
\p \v 27 \w When you tell|strong="H01696"\w* \w them|strong="H00413"\w* \w all|strong="H03605"\w* \w these|strong="H00428"\w* \w things|strong="H01697"\w*, \w -|strong="H00853"\w* \w they will not|strong="H03808"\w* \w listen|strong="H08085"\w* \w to you|strong="H00413"\w*. \w When you call|strong="H07121"\w* \w to them|strong="H00413"\w*, \w they will not|strong="H03808"\w* \w answer|strong="H06030"\w*. \v 28 \w Therefore you must say|strong="H00559"\w* \w to them|strong="H00413"\w*, ‘\w This|strong="H02088"\w* \w is the nation|strong="H01471"\w* \w that|strong="H00834"\w* \w would not|strong="H03808"\w* \w listen|strong="H08085"\w* \w to the voice|strong="H06963"\w* \w of the LORD|strong="H03068"\w* \w their God|strong="H00430"\w* \w and would not|strong="H03808"\w* \w receive|strong="H03947"\w* \w correction|strong="H04148"\w*. \w Truth|strong="H00530"\w* \w has perished|strong="H00006"\w*; \w it has disappeared|strong="H03772"\w* \w from their lips|strong="H06310"\w*. \v 29 \w Cut off|strong="H01494"\w* \w your hair|strong="H05145"\w* \w and throw it away|strong="H07993"\w*. \w Raise up|strong="H05375"\w* \w a lamentation|strong="H07015"\w* \w on|strong="H05921"\w* \w the barren heights|strong="H08205"\w*, \w for|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w has rejected|strong="H03988"\w* \w and forsaken|strong="H05203"\w* \w -|strong="H00853"\w* \w the generation|strong="H01755"\w* \w of His wrath|strong="H05678"\w*.’
\s1 The Valley of Slaughter
\p \v 30 \w For|strong="H03588"\w* \w the people|strong="H01121"\w* \w of Judah|strong="H03063"\w* \w have done|strong="H06213"\w* \w evil|strong="H07451"\w* \w in My sight|strong="H05869"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*. \w They have set up|strong="H07760"\w* \w their abominations|strong="H08251"\w* \w in the house|strong="H01004"\w* \w that|strong="H00834"\w* \w bears|strong="H07121"\w* \w My Name|strong="H08034"\w* \w . . .|strong="H05921"\w*, \w and so have defiled it|strong="H02930"\w*. \v 31 \w They have built|strong="H01129"\w* \w the high places|strong="H01116"\w* \w of Topheth|strong="H08612"\w* \w -|strong="H00834"\w* \w in the Valley of Ben-hinnom|strong="H01516"\w* \w so they could burn|strong="H08313"\w* \w -|strong="H00853"\w* \w their sons|strong="H01121"\w* \w . . .|strong="H02011"\w* \w . . .|strong="H01121"\w* \w . . .|strong="H00853"\w* \w and daughters|strong="H01323"\w* \w in the fire|strong="H00784"\w* — \w -|strong="H00834"\w* \w something I never|strong="H03808"\w* \w commanded|strong="H06680"\w*, \w nor|strong="H03808"\w* \w did it [even] enter|strong="H05927"\w* \w . . .|strong="H05921"\w* \w My mind|strong="H03820"\w*.
\p \v 32 \w So|strong="H03651"\w* \w behold|strong="H02009"\w*, \w the days|strong="H03117"\w* \w are coming|strong="H00935"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, \w when this place will no|strong="H03808"\w* \w longer|strong="H05750"\w* \w be called|strong="H00559"\w* \w Topheth|strong="H08612"\w* \w and the Valley of Ben-hinnom|strong="H01516"\w*, \w . . .|strong="H01121"\w* \w . . .|strong="H02011"\w* \w but|strong="H03588"\w* \w . . .|strong="H00518"\w* \w the Valley|strong="H01516"\w* \w of Slaughter|strong="H02028"\w*. \w For they will bury [the dead]|strong="H06912"\w* \w in Topheth|strong="H08612"\w* \w until there is no|strong="H00369"\w* \w more room|strong="H04725"\w*. \v 33 \w The corpses|strong="H05038"\w* \w of this|strong="H02088"\w* \w people|strong="H05971"\w* \w will become|strong="H01961"\w* \w food|strong="H03978"\w* \w for the birds|strong="H05775"\w* \w of the air|strong="H08064"\w* \w and the beasts|strong="H00929"\w* \w of the earth|strong="H00776"\w*, \w and there will be no one|strong="H00369"\w* \w to scare them away|strong="H02729"\w*.
\p \v 34 \w I will remove|strong="H07673"\w* \w from the cities|strong="H05892"\w* \w of Judah|strong="H03063"\w* \w and the streets|strong="H02351"\w* \w of Jerusalem|strong="H03389"\w* \w the sounds|strong="H06963"\w* \w of joy|strong="H08342"\w* \w and gladness|strong="H08057"\w* \w . . .|strong="H06963"\w* \w and the voices|strong="H06963"\w* \w of the bride|strong="H03618"\w* \w and|strong="H06963"\w* \w bridegroom|strong="H02860"\w*, \w for|strong="H03588"\w* \w the land|strong="H00776"\w* \w will become|strong="H01961"\w* \w a wasteland|strong="H02723"\w*.”
\c 8
\s1 Judah’s Sin and Punishment
\p \v 1 “\w At that|strong="H01931"\w* \w time|strong="H06256"\w*,” \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, “\w the bones|strong="H06106"\w* \w of the kings|strong="H04428"\w* \w of Judah|strong="H03063"\w*, \w -|strong="H00853"\w* \w the bones|strong="H06106"\w* \w of the officials|strong="H08269"\w*, \w -|strong="H00853"\w* \w the bones|strong="H06106"\w* \w of the priests|strong="H03548"\w*, \w -|strong="H00853"\w* \w the bones|strong="H06106"\w* \w of the prophets|strong="H05030"\w*, \w -|strong="H00853"\w* \w and the bones|strong="H06106"\w* \w of the people|strong="H03427"\w* \w of Jerusalem|strong="H03389"\w* \w will be removed|strong="H03318"\w* \w -|strong="H00853"\w* \w from their graves|strong="H06913"\w*. \v 2 \w They will be exposed|strong="H07849"\w* \w to the sun|strong="H08121"\w* \w and moon|strong="H03394"\w*, \w and to all|strong="H03605"\w* \w the host|strong="H06635"\w* \w of heaven|strong="H08064"\w* \w which|strong="H00834"\w* \w they have loved|strong="H00157"\w*, \w -|strong="H00834"\w* \w served|strong="H05647"\w*, \w -|strong="H00834"\w* \w followed|strong="H01980"\w* \w . . .|strong="H00310"\w*, \w -|strong="H00834"\w* \w consulted|strong="H01875"\w*, \w -|strong="H00834"\w* \w and worshiped|strong="H07812"\w*. \w Their bones will not|strong="H03808"\w* \w be gathered up|strong="H00622"\w* \w [or]|strong="H03808"\w* \w buried|strong="H06912"\w*, \w but will become|strong="H01961"\w* \w like dung|strong="H01828"\w* \w lying on|strong="H05921"\w* \w . . .|strong="H06440"\w* \w the ground|strong="H00127"\w*. \v 3 \w And wherever|strong="H03605"\w* \w . . .|strong="H04725"\w* \w . . .|strong="H07604"\w* \w -|strong="H00834"\w* \w I have banished them|strong="H05080"\w* \w . . .|strong="H08033"\w*, \w -|strong="H03605"\w* \w the remnant|strong="H07611"\w* \w -|strong="H07604"\w* \w of this|strong="H02063"\w* \w evil|strong="H07451"\w* \w family|strong="H04940"\w* \w will choose|strong="H00977"\w* \w death|strong="H04194"\w* \w over|strong="H04480"\w* \w life|strong="H02416"\w*,” \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*.
\p \v 4 \w So you are to tell|strong="H00559"\w* \w them|strong="H00413"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*:
