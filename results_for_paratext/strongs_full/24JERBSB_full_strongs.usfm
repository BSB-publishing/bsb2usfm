\q2 \w for|strong="H03588"\w* \w who|strong="H04310"\w* \w . . .|strong="H01931"\w* \w . . .|strong="H02088"\w* \w would dare|strong="H06148"\w* \w -|strong="H00853"\w* \w on his own|strong="H03820"\w* \w to approach|strong="H05066"\w* \w Me|strong="H00413"\w*?”
\qr \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*.
\q1 \v 22 “\w And you will be|strong="H01961"\w* My \w people|strong="H05971"\w*,
\q2 \w and I|strong="H00595"\w* \w will be|strong="H01961"\w* your \w God|strong="H00430"\w*.”
\b 
