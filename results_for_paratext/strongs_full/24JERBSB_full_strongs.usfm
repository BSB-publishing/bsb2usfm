\q2 \w and because|strong="H06440"\w* \w of the fierce|strong="H02740"\w* \w anger [of the LORD]|strong="H00639"\w*.
\c 26
\s1 A Warning to the Cities of Judah
\p \v 1 \w At the beginning|strong="H07225"\w* \w of the reign|strong="H04468"\w* \w of Jehoiakim|strong="H03079"\w* \w son|strong="H01121"\w* \w of Josiah|strong="H02977"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w*, \w this|strong="H02088"\w* \w . . .|strong="H00854"\w* \w word|strong="H01697"\w* \w came|strong="H01961"\w* \w from the LORD|strong="H03068"\w* \w -|strong="H00559"\w*: \v 2 “\w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: \w Stand|strong="H05975"\w* \w in the courtyard|strong="H02691"\w* \w of the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w* \w and speak|strong="H01696"\w* \w . . .|strong="H05921"\w* \w all|strong="H03605"\w* \w the words|strong="H01697"\w* \w -|strong="H00834"\w* \w I have commanded|strong="H06680"\w* \w you to speak|strong="H01696"\w*\w . . .|strong="H00413"\w* \w to all|strong="H03605"\w* \w the cities|strong="H05892"\w* \w of Judah|strong="H03063"\w* \w who come|strong="H00935"\w* \w to worship|strong="H07812"\w* \w there|strong="H01004"\w* \w . . .|strong="H03068"\w*. \w -|strong="H00853"\w* \w Do not|strong="H00408"\w* \w omit|strong="H01639"\w* \w a word|strong="H01697"\w*. \v 3 \w Perhaps|strong="H00194"\w* \w they will listen|strong="H08085"\w* \w and turn|strong="H07725"\w*— \w each|strong="H00376"\w* \w from his evil|strong="H07451"\w* \w way of life|strong="H01870"\w*— \w so that I may relent|strong="H05162"\w* \w of|strong="H00413"\w* \w the disaster|strong="H07451"\w* \w -|strong="H00834"\w* \w I|strong="H00595"\w* \w am planning|strong="H02803"\w* \w to bring|strong="H06213"\w* upon them \w because of|strong="H06440"\w* \w the evil|strong="H07455"\w* \w of their deeds|strong="H04611"\w*.
\p \v 4 \w And you are to tell them|strong="H00559"\w* \w that|strong="H00413"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: ‘\w If|strong="H00518"\w* \w you do not|strong="H03808"\w* \w listen|strong="H08085"\w* \w to Me|strong="H00413"\w* \w and walk|strong="H01980"\w* \w in My law|strong="H08451"\w*, \w which|strong="H00834"\w* \w I have set|strong="H05414"\w* \w before you|strong="H06440"\w*, \v 5 \w and [if you do not] listen|strong="H08085"\w* \w to|strong="H05921"\w* \w the words|strong="H01697"\w* \w of My servants|strong="H05650"\w* \w the prophets|strong="H05030"\w*, \w whom|strong="H00834"\w* \w I|strong="H00595"\w* \w have sent|strong="H07971"\w* \w you|strong="H00413"\w* \w again|strong="H07925"\w* \w and again|strong="H07971"\w*\f + \fr 26:5 \ft Literally \fqa I have sent you, rising up early and sending (them),\f* \w even though you did not|strong="H03808"\w* \w listen|strong="H08085"\w*, \v 6 \w then I will make|strong="H05414"\w* \w -|strong="H00853"\w* \w this|strong="H02088"\w* \w house|strong="H01004"\w* \w like Shiloh|strong="H07887"\w*, \w and|strong="H00853"\w* \w I will make|strong="H05414"\w* \w this|strong="H02063"\w* \w city|strong="H05892"\w* \w an object of cursing|strong="H07045"\w* \w among all|strong="H03605"\w* \w the nations|strong="H01471"\w* \w of the earth|strong="H00776"\w*.’”
\s1 Jeremiah Threatened with Death
\p \v 7 \w Now the priests|strong="H03548"\w* \w and prophets|strong="H05030"\w* \w and all|strong="H03605"\w* \w the people|strong="H05971"\w* \w -|strong="H00853"\w* \w heard|strong="H08085"\w* \w Jeremiah|strong="H03414"\w* \w speaking|strong="H01696"\w* \w -|strong="H00853"\w* \w these|strong="H00428"\w* \w words|strong="H01697"\w* \w in the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*, \v 8 \w and as soon as|strong="H01961"\w* \w [he]|strong="H03414"\w* \w had finished|strong="H03615"\w* \w telling|strong="H01696"\w*\w . . .|strong="H00853"\w* \w all|strong="H03605"\w* \w the people|strong="H05971"\w* \w everything|strong="H03605"\w* \w -|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had commanded him|strong="H06680"\w* \w to say|strong="H01696"\w*\w . . .|strong="H00413"\w*, \w the priests|strong="H03548"\w* \w and prophets|strong="H05030"\w* \w and all|strong="H03605"\w* \w the people|strong="H05971"\w* \w seized him|strong="H08610"\w*, \w -|strong="H00853"\w* \w shouting|strong="H00559"\w*, “\w You must surely die|strong="H04191"\w* \w . . .|strong="H04191"\w*! \v 9 \w How|strong="H04069"\w* \w dare you prophesy|strong="H05012"\w* \w in the name|strong="H08034"\w* \w of the LORD|strong="H03068"\w* \w that|strong="H00559"\w* \w this|strong="H02088"\w* \w house|strong="H01004"\w* \w will become|strong="H01961"\w* \w like Shiloh|strong="H07887"\w* \w and this|strong="H02063"\w* \w city|strong="H05892"\w* \w vvv|strong="H00369"\w* \w will be desolate|strong="H03427"\w* \w and deserted|strong="H02717"\w*!”
\p \w And all|strong="H03605"\w* \w the people|strong="H05971"\w* \w assembled|strong="H06950"\w* \w against|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w in the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*.
\p \v 10 \w When the officials|strong="H08269"\w* \w of Judah|strong="H03063"\w* \w -|strong="H00853"\w* \w heard|strong="H08085"\w* \w these|strong="H00428"\w* \w things|strong="H01697"\w*, \w they went up|strong="H05927"\w* \w from the king’s|strong="H04428"\w* \w palace|strong="H01004"\w* \w to the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w* \w and sat|strong="H03427"\w* \w [there]|strong="H03068"\w* \w at the entrance|strong="H06607"\w* \w of the New|strong="H02319"\w* \w Gate|strong="H08179"\w*.
\p \v 11 \w Then the priests|strong="H03548"\w* \w and prophets|strong="H05030"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w the officials|strong="H08269"\w* \w and|strong="H00413"\w* \w all|strong="H03605"\w* \w the people|strong="H05971"\w* \w . . .|strong="H00559"\w*, “\w This|strong="H02088"\w* \w man|strong="H00376"\w* \w [is] worthy|strong="H04941"\w* \w of death|strong="H04194"\w*, \w for|strong="H03588"\w* \w he has prophesied|strong="H05012"\w* \w against|strong="H00413"\w* \w this|strong="H02063"\w* \w city|strong="H05892"\w*, \w as|strong="H00834"\w* \w you have heard|strong="H08085"\w* \w with your own ears|strong="H00241"\w*!”
\p \v 12 \w But Jeremiah|strong="H03414"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w all|strong="H03605"\w* \w the officials|strong="H08269"\w* \w and|strong="H00413"\w* \w all|strong="H03605"\w* \w the people|strong="H05971"\w* \w . . .|strong="H00559"\w*, “\w The LORD|strong="H03068"\w* \w sent me|strong="H07971"\w* \w to prophesy|strong="H05012"\w* \w against|strong="H00413"\w* \w this|strong="H02088"\w* \w house|strong="H01004"\w* \w and against|strong="H00413"\w* \w this|strong="H02063"\w* \w city|strong="H05892"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the words|strong="H01697"\w* \w that|strong="H00834"\w* \w you have heard|strong="H08085"\w*. \v 13 \w So now|strong="H06258"\w*, \w correct|strong="H03190"\w* \w your ways|strong="H01870"\w* \w and deeds|strong="H04611"\w*, \w and obey|strong="H08085"\w* \w the voice|strong="H06963"\w* \w of the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*, \w so that He|strong="H03068"\w* \w might relent|strong="H05162"\w* \w of|strong="H00413"\w* \w the disaster|strong="H07451"\w* \w -|strong="H00834"\w* \w He has pronounced|strong="H01696"\w* \w against you|strong="H05921"\w*. \v 14 \w As for me|strong="H00589"\w*, \w here|strong="H02005"\w* \w I am in your hands|strong="H03027"\w*; \w do|strong="H06213"\w* to me \w what you think|strong="H05869"\w* \w is good|strong="H02896"\w* \w and right|strong="H03477"\w*. \v 15 \w But|strong="H00389"\w* \w know for certain|strong="H03045"\w* \w . . .|strong="H03045"\w* \w that|strong="H03588"\w* \w if|strong="H00518"\w* \w you|strong="H00859"\w* \w put me to death|strong="H04191"\w*\w . . .|strong="H00853"\w*\w . . .|strong="H03588"\w*, \w you|strong="H00859"\w* \w will bring|strong="H05414"\w* \w innocent|strong="H05355"\w* \w blood|strong="H01818"\w* \w upon yourselves|strong="H05921"\w*, \w upon|strong="H00413"\w* \w this|strong="H02063"\w* \w city|strong="H05892"\w*, \w and upon|strong="H00413"\w* \w its residents|strong="H03427"\w*; \w for|strong="H03588"\w* \w truly|strong="H00571"\w* \w the LORD|strong="H03068"\w* \w has sent me|strong="H07971"\w* \w to speak|strong="H01696"\w* \w all|strong="H03605"\w* \w these|strong="H00428"\w* \w words|strong="H01697"\w* \w in your hearing|strong="H00241"\w* \w -|strong="H00853"\w* \w -|strong="H05921"\w*.”
\s1 Jeremiah Spared from Death
\p \v 16 \w Then the officials|strong="H08269"\w* \w and all|strong="H03605"\w* \w the people|strong="H05971"\w* \w told|strong="H00559"\w*\w . . .|strong="H00413"\w* \w the priests|strong="H03548"\w* \w . . .|strong="H00413"\w* \w and prophets|strong="H05030"\w*, “\w This|strong="H02088"\w* \w man|strong="H00376"\w* \w [is] not|strong="H00369"\w* \w worthy|strong="H04941"\w* \w of death|strong="H04194"\w*, \w for|strong="H03588"\w* \w he has spoken|strong="H01696"\w* \w to us|strong="H00413"\w* \w in the name|strong="H08034"\w* \w of the LORD|strong="H03068"\w* \w our God|strong="H00430"\w*!”
\p \v 17 \w Some of the elders|strong="H02205"\w* \w of the land|strong="H00776"\w* \w stood up|strong="H06965"\w* \w . . .|strong="H00582"\w* \w and said|strong="H00559"\w* \w to|strong="H00413"\w* \w the whole|strong="H03605"\w* \w assembly|strong="H06951"\w* \w of the people|strong="H05971"\w* \w . . .|strong="H00559"\w*, \v 18 “\w Micah|strong="H04320"\w* \w the Moreshite|strong="H04183"\w* \w -|strong="H01961"\w* \w prophesied|strong="H05012"\w* \w in the days|strong="H03117"\w* \w of Hezekiah|strong="H02396"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w and told|strong="H00559"\w* \w . . .|strong="H00413"\w* \w all|strong="H03605"\w* \w the people|strong="H05971"\w* \w of Judah|strong="H03063"\w* \w that this is what|strong="H03541"\w* \w . . .|strong="H00559"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w* \w says|strong="H00559"\w*:
\b 
\q1 ‘\w Zion|strong="H06726"\w* \w will be plowed|strong="H02790"\w* \w like a field|strong="H07704"\w*,
\q2 \w Jerusalem|strong="H03389"\w* \w will become|strong="H01961"\w* \w a heap of rubble|strong="H05856"\w*,
\q2 \w and the temple|strong="H01004"\w* \w mount|strong="H02022"\w* \w a wooded|strong="H03293"\w* \w ridge|strong="H01116"\w*.’\f + \fr 26:18 \ft Micah 3:12\f*
\p \v 19 \w Did Hezekiah|strong="H02396"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w [or] anyone else|strong="H03605"\w* \w in Judah|strong="H03063"\w* \w put him to death|strong="H04191"\w* \w . . .|strong="H04191"\w*? \w Did [Hezekiah] not|strong="H03808"\w* \w fear|strong="H03373"\w* \w -|strong="H00853"\w* \w the LORD|strong="H03068"\w* \w and seek|strong="H02470"\w*\w . . .|strong="H00853"\w* \w [His]|strong="H03068"\w* \w favor|strong="H06440"\w*, \w and did not the LORD|strong="H03068"\w* \w relent|strong="H05162"\w* \w of|strong="H00413"\w* \w the disaster|strong="H07451"\w* \w -|strong="H00834"\w* \w He had pronounced|strong="H01696"\w* \w against them|strong="H05921"\w*? \w But we|strong="H00587"\w* \w are about to bring|strong="H06213"\w* \w great|strong="H01419"\w* \w harm|strong="H07451"\w* \w on|strong="H05921"\w* \w ourselves|strong="H05315"\w*!”
\s1 The Prophet Uriah
\p \v 20 \w Now there was|strong="H01961"\w* \w another man|strong="H00376"\w* \w . . .|strong="H01571"\w* \w prophesying|strong="H05012"\w* \w in the name|strong="H08034"\w* \w of the LORD|strong="H03068"\w*, \w Uriah|strong="H00223"\w* \w son|strong="H01121"\w* \w of Shemaiah|strong="H08098"\w* \w from|strong="H07157"\w* \w Kiriath-jearim|strong="H07157"\w*. \w He prophesied|strong="H05012"\w* \w against|strong="H05921"\w* \w this|strong="H02063"\w* \w city|strong="H05892"\w* \w and against|strong="H05921"\w* \w this|strong="H02063"\w* \w land|strong="H00776"\w* \w the same things|strong="H03605"\w* \w . . .|strong="H01697"\w* \w that Jeremiah [did]|strong="H03414"\w*.\f + \fr 26:20 \ft Literally \fqa according to all the words of Jeremiah\f* \v 21 \w King|strong="H04428"\w* \w Jehoiakim|strong="H03079"\w* \w and all|strong="H03605"\w* \w his mighty men|strong="H01368"\w* \w and|strong="H03605"\w* \w officials|strong="H08269"\w* \w -|strong="H00853"\w* \w heard|strong="H08085"\w* \w his words|strong="H01697"\w*, \w and the king|strong="H04428"\w* \w sought|strong="H01245"\w* \w to put him to death|strong="H04191"\w*. \w But when Uriah|strong="H00223"\w* \w found out about it|strong="H08085"\w*, \w he fled|strong="H01272"\w* \w in fear|strong="H03372"\w* \w and went|strong="H00935"\w* \w to Egypt|strong="H04714"\w*.
\p \v 22 \w Then King|strong="H04428"\w* \w Jehoiakim|strong="H03079"\w* \w sent|strong="H07971"\w* \w men|strong="H00582"\w* \w to Egypt|strong="H04714"\w*: \w -|strong="H00853"\w* \w Elnathan|strong="H00494"\w* \w son|strong="H01121"\w* \w of Achbor|strong="H05907"\w* \w along with|strong="H00854"\w* \w . . .|strong="H00413"\w* \w some other men|strong="H00582"\w* \w -|strong="H04714"\w*. \v 23 \w They brought|strong="H03318"\w* \w Uriah|strong="H00223"\w* \w -|strong="H00853"\w* \w out of Egypt|strong="H04714"\w* \w and took him|strong="H00935"\w* \w to|strong="H00413"\w* \w King|strong="H04428"\w* \w Jehoiakim|strong="H03079"\w*, \w who had him put|strong="H05221"\w* \w to the sword|strong="H02719"\w* \w and his body|strong="H05038"\w* \w thrown|strong="H07993"\w* \w -|strong="H00853"\w* \w into|strong="H00413"\w* \w the burial place|strong="H06913"\w* \w of the common|strong="H01121"\w* \w people|strong="H05971"\w*.
\p \v 24 \w Nevertheless|strong="H00389"\w*, \w Ahikam|strong="H00296"\w* \w son|strong="H01121"\w* \w of Shaphan|strong="H08227"\w* \w supported|strong="H03027"\w* \w . . .|strong="H01961"\w* \w . . .|strong="H00854"\w* \w Jeremiah|strong="H03414"\w*, \w so he was not|strong="H01115"\w* \w handed over to|strong="H05414"\w* \w -|strong="H00853"\w* \w -|strong="H03027"\w* \w the people|strong="H05971"\w* \w to be put to death|strong="H04191"\w*.
\c 27
\s1 The Yoke of Nebuchadnezzar
\p \v 1 \w At the beginning|strong="H07225"\w* \w of the reign|strong="H04467"\w* \w of Zedekiah|strong="H03079"\w*\f + \fr 27:1 \ft A few Hebrew manuscripts and Syriac (see also verses 3 and 12, and Jeremiah 28:1); most Hebrew manuscripts \fqa Jehoiakim\f* \w son|strong="H01121"\w* \w of Josiah|strong="H02977"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w*, \w this|strong="H02088"\w* \w word|strong="H01697"\w* \w came|strong="H01961"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w . . .|strong="H00854"\w* \w from the LORD|strong="H03068"\w* \w . . .|strong="H00559"\w*.\f + \fr 27:1 \ft Most LXX manuscripts do not include this verse.\f* \v 2 \w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to me|strong="H00413"\w*:
\p “\w Make|strong="H06213"\w* for yourself \w a yoke|strong="H04133"\w* \w out of leather straps|strong="H04147"\w* \w and put it|strong="H05414"\w* \w on|strong="H05921"\w* \w your neck|strong="H06677"\w*. \v 3 \w Send|strong="H07971"\w* \w word to|strong="H00413"\w* \w the kings|strong="H04428"\w* \w of Edom|strong="H00123"\w*,\w . . .|strong="H00413"\w* \w -|strong="H04428"\w* \w Moab|strong="H04124"\w*, \w . . .|strong="H00413"\w* \w -|strong="H04428"\w* \w Ammon|strong="H01121"\w* \w . . .|strong="H05983"\w*, \w . . .|strong="H00413"\w* \w -|strong="H04428"\w* \w Tyre|strong="H06865"\w*, \w . . .|strong="H00413"\w* \w and|strong="H04428"\w* \w Sidon|strong="H06721"\w* \w through|strong="H03027"\w* \w the envoys|strong="H04397"\w* \w who have come|strong="H00935"\w* \w to Jerusalem|strong="H03389"\w* \w to|strong="H00413"\w* \w Zedekiah|strong="H06667"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w*. \v 4 \w Give them a message|strong="H06680"\w* \w -|strong="H00853"\w* \w from the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w to relay|strong="H00559"\w* \w to|strong="H00413"\w* \w their masters|strong="H00113"\w* \w -|strong="H00559"\w* \w -|strong="H03541"\w* \w -|strong="H03541"\w* \w -|strong="H00559"\w* \w -|strong="H00413"\w* \w -|strong="H00113"\w*:
\p \v 5 \w By My great|strong="H01419"\w* \w power|strong="H03581"\w* \w and outstretched|strong="H05186"\w* \w arm|strong="H02220"\w*, \w I|strong="H00595"\w* \w made|strong="H06213"\w* \w -|strong="H00853"\w* \w the earth|strong="H00776"\w* \w -|strong="H00853"\w* \w and the men|strong="H00120"\w* \w and|strong="H00853"\w* \w beasts|strong="H00929"\w* \w -|strong="H00834"\w* \w on|strong="H05921"\w* \w the face|strong="H06440"\w* \w of [it]|strong="H00776"\w*, \w and I give it|strong="H05414"\w* \w to whom|strong="H00834"\w* \w I please|strong="H03474"\w* \w . . .|strong="H05869"\w*. \v 6 \w So now|strong="H06258"\w* \w I|strong="H00595"\w* \w have placed|strong="H05414"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w these|strong="H00428"\w* \w lands|strong="H00776"\w* \w under the authority|strong="H03027"\w* \w of My servant|strong="H05650"\w* \w Nebuchadnezzar|strong="H05019"\w* \w king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*. \w I have even|strong="H01571"\w* \w -|strong="H00853"\w* \w made|strong="H05414"\w* \w the beasts|strong="H02416"\w* \w of the field|strong="H07704"\w* \w subject|strong="H05647"\w* to him. \v 7 \w All|strong="H03605"\w* \w nations|strong="H01471"\w* \w -|strong="H00853"\w* \w will serve him|strong="H05647"\w* \w and|strong="H00853"\w* \w his son|strong="H01121"\w* \w -|strong="H00853"\w* \w and grandson|strong="H01121"\w* \w . . .|strong="H01121"\w*, \w until|strong="H05704"\w* \w the time|strong="H06256"\w* \w of his own land|strong="H00776"\w* \w . . .|strong="H01571"\w* \w . . .|strong="H01931"\w* \w comes|strong="H00935"\w*; \w then many|strong="H07227"\w* \w nations|strong="H01471"\w* \w and great|strong="H01419"\w* \w kings|strong="H04428"\w* \w will enslave|strong="H05647"\w* him.
\p \v 8 \w -|strong="H01961"\w* \w As for the nation|strong="H01471"\w* \w or kingdom|strong="H04467"\w* \w that|strong="H00834"\w* \w does not|strong="H03808"\w* \w serve|strong="H05647"\w* \w -|strong="H00853"\w* \w -|strong="H00853"\w* \w Nebuchadnezzar|strong="H05019"\w* \w king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w -|strong="H00853"\w* \w -|strong="H00834"\w* \w and does not|strong="H03808"\w* \w place|strong="H05414"\w* \w -|strong="H00853"\w* \w its neck|strong="H06677"\w* \w under [his] yoke|strong="H05923"\w* \w . . .|strong="H04428"\w* \w . . .|strong="H00894"\w*, \w I will punish|strong="H06485"\w* \w . . .|strong="H05921"\w* \w that|strong="H01931"\w* \w nation|strong="H01471"\w* \w by sword|strong="H02719"\w* \w and famine|strong="H07458"\w* \w and plague|strong="H01698"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, \w until|strong="H05704"\w* \w I have destroyed|strong="H08552"\w* \w it|strong="H00853"\w* \w by his hand|strong="H03027"\w*.
