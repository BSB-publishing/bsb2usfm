\c 5
\s1 No One Is Just
\q1 \v 1 “\w Go up and down|strong="H07751"\w* \w the streets|strong="H02351"\w* \w of Jerusalem|strong="H03389"\w*.
\q2 \w Look|strong="H07200"\w* \w now|strong="H04994"\w* \w and take note|strong="H03045"\w*; \w search|strong="H01245"\w* \w her squares|strong="H07339"\w*.
\q1 \w If|strong="H00518"\w* \w you can find|strong="H04672"\w* \w a single person|strong="H00376"\w*, \w . . .|strong="H00518"\w* \w . . .|strong="H03426"\w*
\q2 \w [anyone] who acts|strong="H06213"\w* \w justly|strong="H04941"\w*,
\q1 \w [anyone] who seeks|strong="H01245"\w* \w the truth|strong="H00530"\w*,
