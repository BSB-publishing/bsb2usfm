\p \v 38 “\w The days|strong="H03117"\w* \w are coming|strong="H02009"\w*,”\f + \fr 31:38 \ft Literally \fqa Behold, the days\ft ; alternate MT reading \fqa Behold, the days are coming\f* \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, “\w when this city|strong="H05892"\w* \w will be rebuilt|strong="H01129"\w* \w for [Me]|strong="H03068"\w*, \w from the tower|strong="H04026"\w* \w of Hananel|strong="H02606"\w* \w to the Corner|strong="H06438"\w* \w Gate|strong="H08179"\w*. \v 39 \w The measuring|strong="H04060"\w* \w line|strong="H06961"\w* \w will once again|strong="H05750"\w* \w stretch out|strong="H03318"\w* \w straight|strong="H05048"\w* \w to|strong="H05921"\w* \w the hill|strong="H01389"\w* \w of Gareb|strong="H01619"\w* \w and then turn|strong="H05437"\w* \w toward Goah|strong="H01601"\w*. \v 40 \w The whole|strong="H03605"\w* \w valley|strong="H06010"\w* \w of the dead bodies|strong="H06297"\w* \w and ashes|strong="H01880"\w*, \w and all|strong="H03605"\w* \w the fields|strong="H08309"\w* \w as|strong="H05704"\w* \w far as the Kidron|strong="H06939"\w* \w Valley|strong="H05158"\w*, \w to|strong="H05704"\w* \w the corner|strong="H06438"\w* \w of the Horse|strong="H05483"\w* \w Gate|strong="H08179"\w* \w to the east|strong="H04217"\w*, \w will be holy|strong="H06944"\w* \w to the LORD|strong="H03068"\w*. \w It will never|strong="H03808"\w* \w . . .|strong="H05769"\w* \w again|strong="H05750"\w* \w be uprooted|strong="H05428"\w* \w . . .|strong="H03808"\w* \w or demolished|strong="H02040"\w*.”
\c 32
\s1 Jeremiah Buys Hanamel’s Field
\p \v 1 \w This is the word|strong="H01697"\w* \w that|strong="H00834"\w* \w came|strong="H01961"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w -|strong="H00854"\w* \w from the LORD|strong="H03068"\w* \w in the tenth|strong="H06224"\w* \w year|strong="H08141"\w* \w of Zedekiah|strong="H06667"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w*, \w which|strong="H01931"\w* \w was the eighteenth|strong="H08083"\w* \w . . .|strong="H06240"\w* \w . . .|strong="H08141"\w* \w year|strong="H08141"\w* \w of Nebuchadnezzar|strong="H05019"\w*. \v 2 \w At that time|strong="H00227"\w* \w the army|strong="H02428"\w* \w of the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w was besieging|strong="H06696"\w* \w . . .|strong="H05921"\w* \w Jerusalem|strong="H03389"\w*, \w and Jeremiah|strong="H03414"\w* \w the prophet|strong="H05030"\w* \w was|strong="H01961"\w* \w imprisoned|strong="H03607"\w* \w in the courtyard|strong="H02691"\w* \w of the guard|strong="H04307"\w*, \w which was|strong="H00834"\w* \w in the palace|strong="H01004"\w* \w of the king|strong="H04428"\w* \w of Judah|strong="H03063"\w*.
\p \v 3 \w For|strong="H00834"\w* \w Zedekiah|strong="H06667"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w had imprisoned him|strong="H03607"\w*, \w saying|strong="H00559"\w*: “\w Why|strong="H04069"\w* \w are you|strong="H00859"\w* \w prophesying|strong="H05012"\w* \w like this|strong="H03541"\w*? \w You claim that|strong="H00559"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*, ‘\w Behold|strong="H02005"\w*, \w I am about to deliver|strong="H05414"\w* \w this|strong="H02063"\w* \w city|strong="H05892"\w* \w -|strong="H00853"\w* \w into the hand|strong="H03027"\w* \w of the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*, \w and he will capture it|strong="H03920"\w*. \v 4 \w Zedekiah|strong="H06667"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w will not|strong="H03808"\w* \w escape|strong="H04422"\w* \w from the hands|strong="H03027"\w* \w of the Chaldeans|strong="H03778"\w*,\f + \fr 32:4 \ft That is, the Babylonians; also in verses 5, 24, 25, 28, 29, and 43\f* \w but|strong="H03588"\w* \w he will surely be delivered|strong="H05414"\w* \w . . .|strong="H05414"\w* \w into the hand|strong="H03027"\w* \w of the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*, \w and will speak with him|strong="H01696"\w* \w face|strong="H06310"\w* \w to|strong="H05973"\w* \w face|strong="H06310"\w* \w and see him|strong="H07200"\w* \w eye|strong="H05869"\w*\w . . .|strong="H00853"\w* \w to eye|strong="H05869"\w*. \v 5 \w He will take|strong="H01980"\w* \w -|strong="H00853"\w* \w Zedekiah|strong="H06667"\w* \w to Babylon|strong="H00894"\w*, \w where|strong="H08033"\w* \w he will stay|strong="H01961"\w* \w until|strong="H05704"\w* \w I attend to|strong="H06485"\w* \w him|strong="H00853"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*. \w If|strong="H03588"\w* \w you fight|strong="H03898"\w* \w against|strong="H00854"\w* \w the Chaldeans|strong="H03778"\w*, \w you will not|strong="H03808"\w* \w succeed|strong="H06743"\w*.’”
\p \v 6 \w Jeremiah|strong="H03414"\w* \w replied|strong="H00559"\w*, “\w The word|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w came|strong="H01961"\w* \w to me|strong="H00413"\w*, \w saying|strong="H00559"\w*: \v 7 \w Behold|strong="H02009"\w*! \w Hanamel|strong="H02601"\w*, \w the son|strong="H01121"\w* \w of your uncle|strong="H01730"\w* \w Shallum|strong="H07967"\w*, \w is coming|strong="H00935"\w* \w to|strong="H00413"\w* \w you to say|strong="H00559"\w*, ‘\w Buy|strong="H07069"\w* for yourself \w -|strong="H00853"\w* \w my field|strong="H07704"\w* \w -|strong="H00834"\w* \w in Anathoth|strong="H06068"\w*, \w for|strong="H03588"\w* you have \w the right|strong="H04941"\w* \w of redemption|strong="H01353"\w* \w to buy it|strong="H07069"\w*.’ \v 8 \w Then, as the LORD|strong="H03068"\w* \w . . .|strong="H00413"\w* \w had said|strong="H01697"\w*, \w my cousin|strong="H01121"\w* \w . . .|strong="H01730"\w* \w Hanamel|strong="H02601"\w* \w came|strong="H00935"\w* \w to me|strong="H00413"\w* \w in the courtyard|strong="H02691"\w* \w of the guard|strong="H04307"\w* \w and urged me|strong="H00559"\w*, \w . . .|strong="H00413"\w* ‘\w Please|strong="H04994"\w* \w -|strong="H00853"\w* \w buy|strong="H07069"\w* \w my field|strong="H07704"\w* \w -|strong="H00834"\w* \w in Anathoth|strong="H06068"\w* \w -|strong="H00834"\w* \w in the land|strong="H00776"\w* \w of Benjamin|strong="H01144"\w*, \w for|strong="H03588"\w* you own \w the right|strong="H04941"\w* \w of inheritance|strong="H03425"\w* and \w redemption|strong="H01353"\w*. \w Buy it|strong="H07069"\w* for yourself.’”
\p \w Then I knew|strong="H03045"\w* \w that|strong="H03588"\w* \w this|strong="H01931"\w* \w was the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w*.
\p \v 9 \w So I bought|strong="H07069"\w* \w -|strong="H00853"\w* \w the field|strong="H07704"\w* \w . . .|strong="H00854"\w* \w in Anathoth|strong="H06068"\w* \w from my cousin|strong="H01121"\w* \w . . .|strong="H01730"\w* \w -|strong="H00834"\w* \w Hanamel|strong="H02601"\w*, \w and I weighed out|strong="H08254"\w* \w -|strong="H00853"\w* \w vvv|strong="H03701"\w* \w seventeen|strong="H07651"\w* \w . . .|strong="H06235"\w* \w shekels|strong="H08255"\w* \w of silver|strong="H03701"\w*.\f + \fr 32:9 \fqa 17 shekels \ft is approximately 6.8 ounces or 193.8 grams of silver.\f* \v 10 \w I signed|strong="H03789"\w* \w and sealed|strong="H02856"\w* \w the deed|strong="H05612"\w*, \w called in witnesses|strong="H05749"\w* \w . . .|strong="H05707"\w*, \w and weighed out|strong="H08254"\w* \w the silver|strong="H03701"\w* \w on the scales|strong="H03976"\w*. \v 11 \w Then I took|strong="H03947"\w* \w -|strong="H00853"\w* \w the deed|strong="H05612"\w* \w of purchase|strong="H04736"\w*—\w . . .|strong="H00853"\w* \w the sealed|strong="H02856"\w* \w copy with its terms|strong="H04687"\w* \w and conditions|strong="H02706"\w*, \w as well as|strong="H00853"\w* \w the open copy|strong="H01540"\w*— \v 12 \w and I gave|strong="H05414"\w* \w -|strong="H00853"\w* \w this deed|strong="H05612"\w* \w . . .|strong="H04736"\w* \w to|strong="H00413"\w* \w Baruch|strong="H01263"\w* \w son|strong="H01121"\w* \w of Neriah|strong="H05374"\w*, \w the son|strong="H01121"\w* \w of Mahseiah|strong="H04271"\w*, \w in the sight|strong="H05869"\w* \w of my cousin|strong="H01730"\w* \w . . .|strong="H05869"\w* \w Hanamel|strong="H02601"\w* \w and the witnesses|strong="H05707"\w* \w who were signing|strong="H03789"\w* \w the purchase|strong="H04736"\w* \w . . .|strong="H05869"\w* \w agreement|strong="H05612"\w* \w and all|strong="H03605"\w* \w the Jews|strong="H03064"\w* \w sitting|strong="H03427"\w* \w in the courtyard|strong="H02691"\w* \w of the guard|strong="H04307"\w*.
\p \v 13 \w In their sight|strong="H05869"\w* \w . . .|strong="H00559"\w* \w I instructed|strong="H06680"\w* \w -|strong="H00853"\w* \w Baruch|strong="H01263"\w*, \v 14 “\w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w says|strong="H00559"\w*: \w Take|strong="H03947"\w* \w -|strong="H00853"\w* \w these|strong="H00428"\w* \w -|strong="H00853"\w* \w deeds|strong="H05612"\w*— \w both the sealed copy|strong="H02856"\w* \w -|strong="H00853"\w* \w and the|strong="H02088"\w* \w open|strong="H01540"\w* \w copy|strong="H05612"\w* \w of the|strong="H02088"\w* \w -|strong="H00853"\w* \w deed|strong="H05612"\w* \w of purchase|strong="H04736"\w*— \w and put them|strong="H05414"\w* \w in a clay|strong="H02789"\w* \w jar|strong="H03627"\w* \w to|strong="H04616"\w* \w preserve them|strong="H05975"\w* \w for a long|strong="H07227"\w* \w time|strong="H03117"\w*. \v 15 \w For|strong="H03588"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w says|strong="H00559"\w*: \w Houses|strong="H01004"\w*, \w fields|strong="H07704"\w*, \w and vineyards|strong="H03754"\w* \w will again|strong="H05750"\w* \w be bought|strong="H07069"\w* \w in this|strong="H02063"\w* \w land|strong="H00776"\w*.”
\s1 Jeremiah Prays for Understanding
\p \v 16 \w After|strong="H00310"\w* \w I had given|strong="H05414"\w* \w -|strong="H00853"\w* \w the deed|strong="H05612"\w* \w of purchase|strong="H04736"\w* \w to|strong="H00413"\w* \w Baruch|strong="H01263"\w* \w son|strong="H01121"\w* \w of Neriah|strong="H05374"\w*, \w . . .|strong="H00559"\w* \w I prayed|strong="H06419"\w* \w to|strong="H00413"\w* \w the LORD|strong="H03068"\w*: \v 17 “\w Oh|strong="H00162"\w*, \w Lord|strong="H00136"\w* \w GOD|strong="H03069"\w*! \w . . .|strong="H02009"\w* \w You|strong="H00859"\w* \w have made|strong="H06213"\w* \w -|strong="H00853"\w* \w the heavens|strong="H08064"\w* \w -|strong="H00853"\w* \w and the earth|strong="H00776"\w* \w by Your great|strong="H01419"\w* \w power|strong="H03581"\w* \w and outstretched|strong="H05186"\w* \w arm|strong="H02220"\w*. \w Nothing|strong="H03808"\w* \w . . .|strong="H03605"\w* \w . . .|strong="H01697"\w* \w is too difficult|strong="H06381"\w* \w for You|strong="H04480"\w*!
\p \v 18 \w You show|strong="H06213"\w* \w loving devotion|strong="H02617"\w* \w to thousands|strong="H00505"\w* \w but lay|strong="H07999"\w* \w the iniquity|strong="H05771"\w* \w of the fathers|strong="H00001"\w* \w into|strong="H00413"\w* \w the laps|strong="H02436"\w*\f + \fr 32:18 \ft Hebrew \fqa into the bosom\f* \w of their children|strong="H01121"\w* \w after them|strong="H00310"\w*, \w O great|strong="H01419"\w* \w and mighty|strong="H01368"\w* \w God|strong="H00410"\w* \w whose name|strong="H08034"\w* \w is the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \v 19 \w the One great|strong="H01419"\w* \w in counsel|strong="H06098"\w* \w and mighty|strong="H07227"\w* \w in deed|strong="H05950"\w*, \w whose|strong="H00834"\w* \w eyes|strong="H05869"\w* \w . . .|strong="H06491"\w* \w are on|strong="H05921"\w* \w all|strong="H03605"\w* \w the ways|strong="H01870"\w* \w of the sons|strong="H01121"\w* \w of men|strong="H00120"\w*, \w to reward|strong="H05414"\w* \w each one|strong="H00376"\w* \w according to his ways|strong="H01870"\w* \w and according to the fruit|strong="H06529"\w* \w of his deeds|strong="H04611"\w*.
\p \v 20 \w -|strong="H00834"\w* \w You performed|strong="H07760"\w* \w signs|strong="H00226"\w* \w and wonders|strong="H04159"\w* \w in the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w*, \w and You do so to|strong="H05704"\w* \w this very|strong="H02088"\w* \w day|strong="H03117"\w*, \w both in Israel|strong="H03478"\w* \w and among all mankind|strong="H00120"\w*. \w And You have made|strong="H06213"\w* \w a name|strong="H08034"\w* for Yourself, \w as is the case|strong="H02088"\w* \w to this day|strong="H03117"\w*.
\p \v 21 \w You brought|strong="H03318"\w* \w -|strong="H00853"\w* \w Your people|strong="H05971"\w* \w -|strong="H00853"\w* \w Israel|strong="H03478"\w* \w out of the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w* \w with signs|strong="H00226"\w* \w and wonders|strong="H04159"\w*, \w with a strong|strong="H02389"\w* \w hand|strong="H03027"\w* \w and an outstretched|strong="H05186"\w* \w arm|strong="H00248"\w*, \w and with great|strong="H01419"\w* \w terror|strong="H04172"\w*. \v 22 \w You gave|strong="H05414"\w* them \w -|strong="H00853"\w* \w this|strong="H02063"\w* \w land|strong="H00776"\w* \w that|strong="H00834"\w* \w You had sworn|strong="H07650"\w* \w to give|strong="H05414"\w* \w their fathers|strong="H00001"\w*, \w a land|strong="H00776"\w* \w flowing|strong="H02100"\w* \w with milk|strong="H02461"\w* \w and honey|strong="H01706"\w*.
\p \v 23 \w They came in|strong="H00935"\w* \w and possessed it|strong="H03423"\w*, \w -|strong="H00853"\w* \w but they did not|strong="H03808"\w* \w obey|strong="H08085"\w* \w Your voice|strong="H06963"\w* \w or walk|strong="H01980"\w* \w -|strong="H00853"\w* \w in Your law|strong="H08451"\w*. \w They failed|strong="H03808"\w* \w to perform|strong="H06213"\w* \w . . .|strong="H03808"\w* \w all|strong="H03605"\w* \w that|strong="H00834"\w* \w You commanded|strong="H06680"\w* them \w to do|strong="H06213"\w*, \w and so You have brought|strong="H07122"\w* \w upon them|strong="H00853"\w*\w . . .|strong="H00853"\w* \w all|strong="H03605"\w* \w this|strong="H02063"\w* \w disaster|strong="H07451"\w*. \v 24 \w See how|strong="H02009"\w* \w the siege ramps|strong="H05550"\w* \w are mounted|strong="H00935"\w* \w against the city|strong="H05892"\w* \w to capture it|strong="H03920"\w*. \w And by|strong="H06440"\w* \w sword|strong="H02719"\w* \w and famine|strong="H07458"\w* \w and plague|strong="H01698"\w*, \w the city|strong="H05892"\w* \w has been given|strong="H05414"\w* \w into the hands|strong="H03027"\w* \w of the Chaldeans|strong="H03778"\w* \w who are fighting|strong="H03898"\w* \w against it|strong="H05921"\w*. \w What|strong="H00834"\w* \w You have spoken|strong="H01696"\w* \w has happened|strong="H01961"\w*, \w as You|strong="H02005"\w* \w now see|strong="H07200"\w*!
\p \v 25 \w Yet You|strong="H00859"\w*, \w O Lord|strong="H00136"\w* \w GOD|strong="H03069"\w*, \w have said|strong="H00559"\w* \w to me|strong="H00413"\w*, ‘\w Buy|strong="H07069"\w* for yourself \w the field|strong="H07704"\w* \w with silver|strong="H03701"\w* \w and call in|strong="H05749"\w* \w witnesses|strong="H05707"\w*, \w even though the city|strong="H05892"\w* \w has been delivered|strong="H05414"\w* \w into the hands|strong="H03027"\w* \w of the Chaldeans|strong="H03778"\w*!’”
\s1 The LORD Answers Jeremiah
\p \v 26 \w Then the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w came|strong="H01961"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w . . .|strong="H00559"\w*: \v 27 “\w Behold|strong="H02009"\w*, \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of all|strong="H03605"\w* \w flesh|strong="H01320"\w*. \w Is anything|strong="H03605"\w* \w . . .|strong="H01697"\w* \w too difficult|strong="H06381"\w* \w for Me|strong="H04480"\w*?
\p \v 28 \w Therefore|strong="H03651"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: \w Behold|strong="H02005"\w*, \w I am about to deliver|strong="H05414"\w* \w this|strong="H02063"\w* \w city|strong="H05892"\w* \w -|strong="H00853"\w* \w into the hands|strong="H03027"\w* \w of the Chaldeans|strong="H03778"\w* \w and|strong="H03027"\w* \w of Nebuchadnezzar|strong="H05019"\w* \w king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*, \w who will capture it|strong="H03920"\w*. \v 29 \w And the Chaldeans|strong="H03778"\w* \w who are fighting|strong="H03898"\w* \w against|strong="H05921"\w* \w this|strong="H02063"\w* \w city|strong="H05892"\w* \w will come in|strong="H00935"\w*, \w set|strong="H02063"\w* \w [it]|strong="H05892"\w* \w on fire|strong="H03341"\w* \w -|strong="H00853"\w* \w -|strong="H00784"\w*, \w and burn it|strong="H08313"\w*, \w along with|strong="H00853"\w* \w the houses|strong="H01004"\w* \w of those who|strong="H00834"\w* \w provoked Me to anger|strong="H03707"\w* \w by burning incense|strong="H06999"\w* \w to Baal|strong="H01168"\w* \w on|strong="H05921"\w* \w their rooftops|strong="H01406"\w* \w and by pouring out|strong="H05258"\w* \w drink offerings|strong="H05262"\w* \w to other|strong="H00312"\w* \w gods|strong="H00430"\w* \w -|strong="H04616"\w*.
\p \v 30 \w For|strong="H03588"\w* \w . . .|strong="H01961"\w* \w the children|strong="H01121"\w* \w of Israel|strong="H03478"\w* \w and|strong="H01121"\w* \w of Judah|strong="H03063"\w* \w have done|strong="H06213"\w* \w nothing but|strong="H00389"\w* \w evil|strong="H07451"\w* \w in My sight|strong="H05869"\w* \w from their youth|strong="H05271"\w*; \w indeed|strong="H03588"\w*, \w [they]|strong="H01121"\w* \w . . .|strong="H03478"\w* \w have done nothing but|strong="H00389"\w* \w provoke Me to anger|strong="H03707"\w* \w -|strong="H00853"\w* \w by the work|strong="H04639"\w* \w of their hands|strong="H03027"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*.
