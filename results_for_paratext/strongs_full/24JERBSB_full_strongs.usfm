\b 
\q1 
\p \v 23 “\w Am I [only]|strong="H00589"\w* \w a God|strong="H00430"\w* \w nearby|strong="H07138"\w*,” \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, “\w and not|strong="H03808"\w* \w a God|strong="H00430"\w* \w far away|strong="H07350"\w*?”
\p \v 24 “\w Can|strong="H00518"\w* \w a man|strong="H00376"\w* \w hide|strong="H05641"\w* \w in secret places|strong="H04565"\w* \w where I|strong="H00589"\w* \w cannot|strong="H03808"\w* \w see him|strong="H07200"\w*?” \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*.
\p “\w Do I|strong="H00589"\w* \w not|strong="H03808"\w* \w -|strong="H00853"\w* \w fill|strong="H04390"\w* \w the heavens|strong="H08064"\w* \w and|strong="H00853"\w* \w the earth|strong="H00776"\w*?” \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*.
\q1 
\p \v 25 “\w I have heard|strong="H08085"\w* \w -|strong="H00853"\w* \w the sayings|strong="H00559"\w* \w -|strong="H00834"\w* \w of the prophets|strong="H05030"\w* \w who prophesy|strong="H05012"\w* \w lies|strong="H08267"\w* \w . . .|strong="H00559"\w* \w in My name|strong="H08034"\w*: ‘\w I had a dream|strong="H02492"\w*! \w I had a dream|strong="H02492"\w*!’ \v 26 \w How long|strong="H05704"\w* \w . . .|strong="H04970"\w* \w will this continue|strong="H03426"\w* \w in the hearts|strong="H03820"\w* \w of these prophets|strong="H05030"\w* \w who prophesy|strong="H05012"\w* \w falsehood|strong="H08267"\w*, \w these prophets|strong="H05030"\w* \w of the delusion|strong="H08649"\w* \w of their own minds|strong="H03820"\w*? \v 27 \w They suppose|strong="H02803"\w* \w the dreams|strong="H02472"\w* \w that|strong="H00834"\w* \w they tell|strong="H05608"\w* \w one|strong="H00376"\w* \w another|strong="H07453"\w* \w {will make} My people|strong="H05971"\w* \w forget|strong="H07911"\w* \w -|strong="H00853"\w* \w My name|strong="H08034"\w*, \w just as|strong="H00834"\w* \w their fathers|strong="H00001"\w* \w -|strong="H00853"\w* \w forgot|strong="H07911"\w* \w My name|strong="H08034"\w* \w through the worship of Baal|strong="H01168"\w*.
\p \v 28 \w Let the prophet|strong="H05030"\w* \w who|strong="H00834"\w* \w has|strong="H00854"\w* \w a dream|strong="H02472"\w* \w retell|strong="H05608"\w* \w [it]|strong="H02472"\w*, \w but let him who|strong="H00834"\w* \w has|strong="H00854"\w* \w My word|strong="H01697"\w* \w speak|strong="H01696"\w* \w [it]|strong="H01697"\w* \w truthfully|strong="H00571"\w*. \w For what|strong="H04100"\w* \w is straw|strong="H08401"\w* \w compared to|strong="H00854"\w* \w grain|strong="H01250"\w*?” \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*. \v 29 “\w Is not|strong="H03808"\w* \w . . .|strong="H03541"\w* \w My word|strong="H01697"\w* \w like fire|strong="H00784"\w*,” \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, “\w and like a hammer|strong="H06360"\w* \w that smashes|strong="H06327"\w* \w a rock|strong="H05553"\w*?”
\p \v 30 “\w Therefore|strong="H03651"\w* \w behold|strong="H02005"\w*,” \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, “\w I am against|strong="H05921"\w* \w the prophets|strong="H05030"\w* \w who steal|strong="H01589"\w* \w from one|strong="H00376"\w* \w . . .|strong="H00854"\w* \w another|strong="H07453"\w* \w words [they attribute] to Me|strong="H01697"\w*.”
\p \v 31 “\w Yes|strong="H02005"\w*,” \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, “\w I am against|strong="H05921"\w* \w the prophets|strong="H05030"\w* \w who wag|strong="H03947"\w* \w their own tongues|strong="H03956"\w* \w and proclaim|strong="H05001"\w*, ‘\w [The LORD] declares [it]|strong="H05002"\w*.’”
\p \v 32 “\w Indeed|strong="H02005"\w*,” \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, “\w I am against|strong="H05921"\w* \w those who prophesy|strong="H05012"\w* \w false|strong="H08267"\w* \w dreams|strong="H02472"\w* \w and retell them|strong="H05608"\w* \w to lead My people|strong="H05971"\w* \w astray|strong="H08582"\w* \w -|strong="H00853"\w* \w with their reckless|strong="H06350"\w* \w lies|strong="H08267"\w*. \w It was not|strong="H03808"\w* \w I|strong="H00595"\w* \w who sent them|strong="H07971"\w* \w or commanded them|strong="H06680"\w*, \w and they are of no|strong="H03808"\w* \w benefit|strong="H03276"\w* \w . . .|strong="H03808"\w* \w at all|strong="H03276"\w* \w to these|strong="H02088"\w* \w people|strong="H05971"\w*,” \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*.
\s1 False Prophecies
\p \v 33 “\w Now when|strong="H03588"\w* \w this|strong="H02088"\w* \w people|strong="H05971"\w* \w or|strong="H00176"\w* \w a prophet|strong="H05030"\w* \w or|strong="H00176"\w* \w priest|strong="H03548"\w* \w asks you|strong="H07592"\w*, ‘\w What|strong="H04100"\w* \w is the burden|strong="H04853"\w* \w of the LORD|strong="H03068"\w*?’ \w . . .|strong="H00559"\w* \w you are to say|strong="H00559"\w* \w to them|strong="H00413"\w* \w -|strong="H00853"\w*, ‘\w What|strong="H04100"\w* \w burden|strong="H04853"\w*? \w I will forsake|strong="H05203"\w* \w you|strong="H00853"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*.’
\p \v 34 \w As for the prophet|strong="H05030"\w* \w [or] priest|strong="H03548"\w* \w [or] anyone|strong="H05971"\w* \w who|strong="H00834"\w* \w claims|strong="H00559"\w*, ‘\w This is the burden|strong="H04853"\w* \w of the LORD|strong="H03068"\w*,’ \w I will punish|strong="H06485"\w* \w . . .|strong="H05921"\w* \w that|strong="H01931"\w* \w . . .|strong="H05921"\w* \w man|strong="H00376"\w* \w and his household|strong="H01004"\w*.
\p \v 35 \w This is what|strong="H03541"\w* \w each man|strong="H00376"\w* \w is to say|strong="H00559"\w* \w to|strong="H05921"\w* \w his friend|strong="H07453"\w* \w . . .|strong="H00376"\w* \w and to|strong="H00413"\w* \w his brother|strong="H00251"\w*: ‘\w What|strong="H04100"\w* \w has the LORD|strong="H03068"\w* \w answered|strong="H06030"\w*?’ \w or ‘What|strong="H04100"\w* \w has the LORD|strong="H03068"\w* \w spoken|strong="H01696"\w*?’ \v 36 \w But refer|strong="H02142"\w* \w no|strong="H03808"\w* \w more|strong="H05750"\w* \w to the burden|strong="H04853"\w* \w of the LORD|strong="H03068"\w*, \w for|strong="H03588"\w* \w each|strong="H00376"\w* \w man’s word|strong="H01697"\w* \w becomes|strong="H01961"\w* \w the burden|strong="H04853"\w*, \w so that you pervert|strong="H02015"\w* \w -|strong="H00853"\w* \w the words|strong="H01697"\w* \w of the living|strong="H02416"\w* \w God|strong="H00430"\w*, \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w our God|strong="H00430"\w*.
\p \v 37 \w Thus|strong="H03541"\w* \w you are to say|strong="H00559"\w* \w to|strong="H00413"\w* \w the prophet|strong="H05030"\w*: ‘\w What|strong="H04100"\w* \w has the LORD|strong="H03068"\w* \w answered you|strong="H06030"\w*?’ \w and ‘What|strong="H04100"\w* \w has the LORD|strong="H03068"\w* \w spoken|strong="H01696"\w*?’
\p \v 38 \w But if|strong="H00518"\w* \w you claim|strong="H00559"\w*, ‘\w This is the burden|strong="H04853"\w* \w of the LORD|strong="H03068"\w*,’ \w then|strong="H03651"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: \w Because|strong="H03282"\w* \w you have said|strong="H00559"\w*, \w -|strong="H00853"\w* \w -|strong="H01697"\w* \w . . .|strong="H02088"\w* ‘\w This is the burden|strong="H04853"\w* \w of the LORD|strong="H03068"\w*,’ \w and I specifically told|strong="H07971"\w* \w . . .|strong="H00413"\w* \w . . .|strong="H00559"\w* \w you not|strong="H03808"\w* \w to make this claim|strong="H00559"\w* \w -|strong="H04853"\w* \w -|strong="H03068"\w*, \v 39 \w therefore|strong="H03651"\w* \w I will surely|strong="H02005"\w* \w forget|strong="H05382"\w* \w you|strong="H00853"\w* \w vvv|strong="H05377"\w* \w and will cast you|strong="H05203"\w* \w out of|strong="H05921"\w* \w My presence|strong="H06440"\w*, \w both you|strong="H00853"\w* \w and|strong="H00853"\w* \w the city|strong="H05892"\w* \w that|strong="H00834"\w* \w I gave|strong="H05414"\w* to you \w and your fathers|strong="H00001"\w*. \v 40 \w And I will bring|strong="H05414"\w* \w upon you|strong="H05921"\w* \w everlasting|strong="H05769"\w* \w shame|strong="H02781"\w* \w and perpetual|strong="H05769"\w* \w humiliation|strong="H03640"\w* \w that|strong="H00834"\w* \w will never|strong="H03808"\w* \w be forgotten|strong="H07911"\w*.”
\c 24
\s1 The Good and Bad Figs
\p \v 1 \w After|strong="H00310"\w* \w Nebuchadnezzar|strong="H05019"\w* \w king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w -|strong="H00853"\w* \w had carried away|strong="H01540"\w* \w Jeconiah|strong="H03204"\w*\f + \fr 24:1 \fqa Jeconiah \ft is a variant of \fqa Jehoiachin\ft ; see 2 Kings 24:12.\f* \w son|strong="H01121"\w* \w of Jehoiakim|strong="H03079"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w*, \w as well as|strong="H00853"\w* \w the officials|strong="H08269"\w* \w of Judah|strong="H03063"\w* \w -|strong="H00853"\w* \w and the craftsmen|strong="H02796"\w* \w -|strong="H00853"\w* \w and metalsmiths|strong="H04525"\w* \w from Jerusalem|strong="H03389"\w*, \w and had brought them|strong="H00935"\w* \w to Babylon|strong="H00894"\w*,\f + \fr 24:1 \ft Or \fqa metalsmiths, and had brought them from Jerusalem to Babylon\f* \w the LORD|strong="H03068"\w* \w -|strong="H02009"\w* \w showed me|strong="H07200"\w* \w two|strong="H08147"\w* \w baskets|strong="H01731"\w* \w of figs|strong="H08384"\w* \w placed|strong="H03259"\w* \w in front of|strong="H06440"\w* \w the temple|strong="H01964"\w* \w of the LORD|strong="H03068"\w*. \v 2 \w One|strong="H00259"\w* \w basket|strong="H01731"\w* \w [had] very|strong="H03966"\w* \w good|strong="H02896"\w* \w figs|strong="H08384"\w*, \w like those that ripen early|strong="H08384"\w* \w . . .|strong="H01063"\w*, \w but the other|strong="H00259"\w* \w basket|strong="H01731"\w* \w contained very|strong="H03966"\w* \w -|strong="H00834"\w* \w poor|strong="H07451"\w* \w figs|strong="H08384"\w*, \w so bad|strong="H07455"\w* \w they could not|strong="H03808"\w* \w be eaten|strong="H00398"\w*.
\p \v 3 “\w Jeremiah|strong="H03414"\w*,” \w the LORD|strong="H03068"\w* \w asked|strong="H00559"\w* \w -|strong="H00413"\w*, “\w what|strong="H04100"\w* \w do you|strong="H00859"\w* \w see|strong="H07200"\w*?”
\p “\w Figs|strong="H08384"\w*!” \w I replied|strong="H00559"\w*. “\w The good|strong="H02896"\w* \w figs|strong="H08384"\w* \w are very|strong="H03966"\w* \w good|strong="H02896"\w*, \w but the bad figs|strong="H07451"\w* \w are very|strong="H03966"\w* \w -|strong="H00834"\w* \w bad|strong="H07451"\w*, \w so bad|strong="H07455"\w* \w they cannot|strong="H03808"\w* \w be eaten|strong="H00398"\w*.”
\p \v 4 \w Then the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w came|strong="H01961"\w* \w to me|strong="H00413"\w*, \w saying|strong="H00559"\w*, \v 5 “\w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w says|strong="H00559"\w*: ‘\w Like these|strong="H00428"\w* \w good|strong="H02896"\w* \w figs|strong="H08384"\w*, \w so|strong="H03651"\w* \w I regard|strong="H05234"\w* \w -|strong="H00853"\w* \w as good|strong="H02896"\w* \w the exiles|strong="H01546"\w* \w from Judah|strong="H03063"\w*, \w whom|strong="H00834"\w* \w I have sent away|strong="H07971"\w* \w from|strong="H04480"\w* \w this|strong="H02088"\w* \w place|strong="H04725"\w* \w to the land|strong="H00776"\w* \w of the Chaldeans|strong="H03778"\w*.\f + \fr 24:5 \ft That is, the Babylonians\f* \v 6 \w I will keep|strong="H07760"\w* \w My eyes|strong="H05869"\w* \w on them|strong="H05921"\w* \w for good|strong="H02896"\w* \w and will return them|strong="H07725"\w* \w to|strong="H05921"\w* \w this|strong="H02063"\w* \w land|strong="H00776"\w*. \w I will build them up|strong="H01129"\w* \w and not|strong="H03808"\w* \w tear [them] down|strong="H02040"\w*; \w I will plant them|strong="H05193"\w* \w and not|strong="H03808"\w* \w uproot them|strong="H05428"\w*. \v 7 \w I will give|strong="H05414"\w* them \w a heart|strong="H03820"\w* \w to know Me|strong="H03045"\w*, \w -|strong="H00853"\w* \w that|strong="H03588"\w* \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w*. \w They will be|strong="H01961"\w* My \w people|strong="H05971"\w*, \w and I|strong="H00595"\w* \w will be|strong="H01961"\w* their \w God|strong="H00430"\w*, \w for|strong="H03588"\w* \w they will return|strong="H07725"\w* \w to Me|strong="H00413"\w* \w with all|strong="H03605"\w* \w their heart|strong="H03820"\w*.
\p \v 8 \w But like the bad|strong="H07451"\w* \w -|strong="H00834"\w* \w figs|strong="H08384"\w*, \w so bad|strong="H07455"\w* \w . . .|strong="H03588"\w* \w they cannot|strong="H03808"\w* \w be eaten|strong="H00398"\w*,’ \w -|strong="H03541"\w* \w says|strong="H00559"\w* \w the LORD|strong="H03068"\w*, ‘\w so|strong="H03651"\w* \w will I deal with|strong="H05414"\w* \w -|strong="H00853"\w* \w Zedekiah|strong="H06667"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w*, \w -|strong="H00853"\w* \w his officials|strong="H08269"\w*, \w -|strong="H00853"\w* \w and the remnant|strong="H07611"\w* \w of Jerusalem|strong="H03389"\w*— \w those remaining|strong="H07604"\w* \w in this|strong="H02063"\w* \w land|strong="H00776"\w* \w and those living|strong="H03427"\w* \w in the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w*. \v 9 \w I will make them|strong="H05414"\w* \w a horror|strong="H02113"\w* \w and an offense|strong="H07451"\w* \w to all|strong="H03605"\w* \w the kingdoms|strong="H04467"\w* \w of the earth|strong="H00776"\w*, \w a disgrace|strong="H02781"\w* \w and an object of scorn|strong="H04912"\w*, \w ridicule|strong="H08148"\w*, \w and cursing|strong="H07045"\w* \w wherever|strong="H03605"\w* \w . . .|strong="H04725"\w* \w -|strong="H00834"\w* \w I have banished them|strong="H05080"\w*. \w . . .|strong="H08033"\w* \v 10 \w And I will send|strong="H07971"\w* \w -|strong="H00853"\w* against them \w sword|strong="H02719"\w* \w -|strong="H00853"\w* \w and famine|strong="H07458"\w* \w -|strong="H00853"\w* \w and plague|strong="H01698"\w*, \w until|strong="H05704"\w* \w they have perished|strong="H08552"\w* \w from|strong="H05921"\w* \w the land|strong="H00127"\w* \w that|strong="H00834"\w* \w I gave|strong="H05414"\w* to them \w and their fathers|strong="H00001"\w*.’”
\c 25
\s1 Seventy Years of Captivity
\p \v 1 \w This is the word|strong="H01697"\w* \w that|strong="H00834"\w* \w came|strong="H01961"\w* \w to|strong="H05921"\w* \w Jeremiah|strong="H03414"\w* \w concerning|strong="H05921"\w* \w all|strong="H03605"\w* \w the people|strong="H05971"\w* \w of Judah|strong="H03063"\w* \w in the fourth|strong="H07243"\w* \w year|strong="H08141"\w* \w of Jehoiakim|strong="H03079"\w* \w son|strong="H01121"\w* \w of Josiah|strong="H02977"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w*, \w which|strong="H01931"\w* \w was the first|strong="H07224"\w* \w year|strong="H08141"\w* \w of Nebuchadnezzar|strong="H05019"\w* \w king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*. \v 2 \w So|strong="H00834"\w* \w the prophet|strong="H05030"\w* \w Jeremiah|strong="H03414"\w* \w spoke|strong="H01696"\w* \w to|strong="H05921"\w* \w all|strong="H03605"\w* \w the people|strong="H05971"\w* \w of Judah|strong="H03063"\w* \w . . .|strong="H00413"\w* \w and all|strong="H03605"\w* \w the residents|strong="H03427"\w* \w of Jerusalem|strong="H03389"\w* \w as follows|strong="H00559"\w*:
\p \v 3 “\w From|strong="H04480"\w* \w the thirteenth|strong="H07969"\w* \w . . .|strong="H06240"\w* \w year|strong="H08141"\w* \w of Josiah|strong="H02977"\w* \w son|strong="H01121"\w* \w of Amon|strong="H00526"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w until|strong="H05704"\w* \w this very|strong="H02088"\w* \w . . .|strong="H02088"\w* \w day|strong="H03117"\w*— \w twenty-three|strong="H07969"\w* \w . . .|strong="H06242"\w* \w years|strong="H08141"\w*— \w the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w has come|strong="H01961"\w* \w to me|strong="H00413"\w*, \w and I have spoken|strong="H01696"\w* \w to you|strong="H00413"\w* \w again|strong="H07925"\w* \w and again|strong="H01696"\w*,\f + \fr 25:3 \ft Literally \fqa I have spoken to you, rising up early and speaking,\f* \w but you have not|strong="H03808"\w* \w listened|strong="H08085"\w*. \v 4 \w And the LORD|strong="H03068"\w* \w has sent|strong="H07971"\w* \w all|strong="H03605"\w* \w His servants|strong="H05650"\w* \w the prophets|strong="H05030"\w* \w to|strong="H00413"\w* \w you|strong="H00853"\w* \w again|strong="H07925"\w* \w and again|strong="H07971"\w*,\f + \fr 25:4 \ft Literally \fqa to you, rising up early and sending (them),\f* \w but you have not|strong="H03808"\w* \w listened|strong="H08085"\w* \w [or]|strong="H03808"\w* \w inclined|strong="H05186"\w*\w . . .|strong="H00853"\w* \w your ear|strong="H00241"\w* \w to hear|strong="H08085"\w*.
\p \v 5 \w [The prophets] told [you]|strong="H00559"\w*, ‘\w Turn|strong="H07725"\w* \w now|strong="H04994"\w*, \w each of you|strong="H00376"\w*, \w from your evil|strong="H07451"\w* \w ways|strong="H01870"\w* \w and|strong="H07455"\w* \w deeds|strong="H04611"\w*, \w and you can dwell|strong="H03427"\w* \w in|strong="H05921"\w* \w the land|strong="H00127"\w* \w that|strong="H00834"\w* \w the LORD has given|strong="H05414"\w* \w . . .|strong="H03068"\w* to you \w and your fathers|strong="H00001"\w* \w vvv|strong="H04480"\w* \w forever|strong="H05769"\w* \w and|strong="H05704"\w* \w ever|strong="H05769"\w*. \v 6 \w Do not|strong="H00408"\w* \w follow|strong="H01980"\w* \w . . .|strong="H00310"\w* \w other|strong="H00312"\w* \w gods|strong="H00430"\w* \w to serve|strong="H05647"\w* \w and worship|strong="H07812"\w* them, \w and do not|strong="H03808"\w* \w provoke Me to anger|strong="H03707"\w* \w -|strong="H00853"\w* \w with the works|strong="H04639"\w* \w of your hands|strong="H03027"\w*. \w Then I will do you no|strong="H03808"\w* \w harm|strong="H07489"\w*.’
\p \v 7 ‘\w But to your own harm|strong="H07451"\w*, \w you have not|strong="H03808"\w* \w listened|strong="H08085"\w* \w to Me|strong="H00413"\w*,’ \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, ‘\w so|strong="H04616"\w* \w you have provoked Me to anger|strong="H03707"\w* \w with the works|strong="H04639"\w* \w of your hands|strong="H03027"\w*.’
\p \v 8 \w Therefore|strong="H03651"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w* \w says|strong="H00559"\w*: ‘\w Because|strong="H03282"\w* \w -|strong="H00834"\w* \w you have not|strong="H03808"\w* \w obeyed|strong="H08085"\w* \w -|strong="H00853"\w* \w My words|strong="H01697"\w*, \v 9 \w behold|strong="H02005"\w*, \w I will summon|strong="H07971"\w* \w . . .|strong="H03947"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the families|strong="H04940"\w* \w of the north|strong="H06828"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, \w and [I will send for]|strong="H00413"\w* \w My servant|strong="H05650"\w* \w Nebuchadnezzar|strong="H05019"\w* \w king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*, \w whom I will bring|strong="H00935"\w* \w against|strong="H05921"\w* \w this|strong="H02063"\w* \w land|strong="H00776"\w*, \w against|strong="H05921"\w* \w its residents|strong="H03427"\w*, \w and against|strong="H05921"\w* \w all|strong="H03605"\w* \w the|strong="H00428"\w* \w surrounding|strong="H05439"\w* \w nations|strong="H01471"\w*. \w So I will devote them to destruction|strong="H02763"\w*\f + \fr 25:9 \ft Forms of the Hebrew \fqa cherem \ft refer to the giving over of things or persons, either by destroying them or by giving them as an offering.\f* \w and make them|strong="H07760"\w* \w an object of horror|strong="H08047"\w* \w and contempt|strong="H08322"\w*, \w an everlasting|strong="H05769"\w* \w desolation|strong="H02723"\w*.
\p \v 10 \w Moreover, I will banish|strong="H00006"\w* from them \w the sounds|strong="H06963"\w* \w of joy|strong="H08342"\w* \w and gladness|strong="H08057"\w*, \w the voices|strong="H06963"\w* \w of the bride|strong="H03618"\w* \w and|strong="H06963"\w* \w bridegroom|strong="H02860"\w*, \w . . .|strong="H06963"\w* \w the sound|strong="H06963"\w* \w of the millstones|strong="H07347"\w*, \w and the light|strong="H00216"\w* \w of the lamp|strong="H05216"\w*. \v 11 \w And this|strong="H02063"\w* \w whole|strong="H03605"\w* \w land|strong="H00776"\w* \w will become|strong="H01961"\w* \w a desolate|strong="H02723"\w* \w wasteland|strong="H08047"\w*, \w and these|strong="H00428"\w* \w -|strong="H00853"\w* \w nations|strong="H01471"\w* \w will serve|strong="H05647"\w* \w the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w for seventy|strong="H07657"\w* \w years|strong="H08141"\w*.
\p \v 12 \w But when|strong="H01961"\w* \w seventy|strong="H07657"\w* \w years|strong="H08141"\w* \w are complete|strong="H04390"\w*, \w I will punish|strong="H06485"\w* \w . . .|strong="H05921"\w* \w the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w . . .|strong="H05921"\w* \w and that|strong="H01931"\w* \w nation|strong="H01471"\w*, \w the land|strong="H00776"\w* \w of the Chaldeans|strong="H03778"\w*,\f + \fr 25:12 \ft That is, the Babylonians\f* \w for their guilt|strong="H05771"\w* \w . . .|strong="H05921"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*,\w . . .|strong="H00853"\w* \w and I will make|strong="H07760"\w* \w it|strong="H00853"\w* \w an everlasting|strong="H05769"\w* \w desolation|strong="H08077"\w*.
\p \v 13 \w I will bring|strong="H00935"\w* \w upon|strong="H05921"\w* \w that|strong="H01931"\w* \w -|strong="H00853"\w* \w land|strong="H00776"\w* \w all|strong="H03605"\w* \w the words|strong="H01697"\w*\w . . .|strong="H00834"\w* \w I have pronounced|strong="H01696"\w* \w against it|strong="H05921"\w*, \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w that is written|strong="H03789"\w* \w in this|strong="H02088"\w* \w book|strong="H05612"\w*, \w which|strong="H00834"\w* \w Jeremiah|strong="H03414"\w* \w has prophesied|strong="H05012"\w* \w against|strong="H05921"\w* \w all|strong="H03605"\w* \w the nations|strong="H01471"\w*. \v 14 \w For|strong="H03588"\w* \w many|strong="H07227"\w* \w nations|strong="H01471"\w* \w and great|strong="H01419"\w* \w kings|strong="H04428"\w* \w will enslave|strong="H05647"\w*\w . . .|strong="H01571"\w* \w them|strong="H01992"\w*, \w and I will repay|strong="H07999"\w* them \w according to their deeds|strong="H06467"\w* \w and according to the work|strong="H04639"\w* \w of their hands|strong="H03027"\w*.’”
\s1 The Cup of God’s Wrath
\p \v 15 \w -|strong="H03588"\w* \w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w said|strong="H00559"\w* \w to me|strong="H00413"\w*: “\w Take|strong="H03947"\w* \w -|strong="H00853"\w* \w from My hand|strong="H03027"\w* \w this|strong="H02063"\w* \w cup|strong="H03563"\w* \w of the wine|strong="H03196"\w* \w of wrath|strong="H02534"\w*, \w and make all|strong="H03605"\w* \w the nations|strong="H01471"\w* \w to whom|strong="H00834"\w* \w I|strong="H00595"\w* \w send|strong="H07971"\w* \w -|strong="H00853"\w* \w you|strong="H00413"\w* \w drink|strong="H08248"\w* \w from it|strong="H00853"\w* \w -|strong="H00853"\w*. \v 16 \w And they will drink|strong="H08354"\w* \w and stagger|strong="H01607"\w* \w and go out of their minds|strong="H01984"\w*, \w because of|strong="H06440"\w* \w the sword|strong="H02719"\w* \w that|strong="H00834"\w* \w I|strong="H00595"\w* \w will send|strong="H07971"\w* \w among them|strong="H00996"\w*.”
\p \v 17 \w So I took|strong="H03947"\w* \w -|strong="H00853"\w* \w the cup|strong="H03563"\w* \w from the LORD’s|strong="H03068"\w* \w hand|strong="H03027"\w* \w and made all|strong="H03605"\w* \w the nations|strong="H01471"\w* \w drink|strong="H08248"\w* \w from it|strong="H00853"\w*, \w -|strong="H00834"\w* \w each one to whom|strong="H00413"\w* \w the LORD|strong="H03068"\w* \w had sent me|strong="H07971"\w*, \v 18 \w to make|strong="H05414"\w* \w them|strong="H00853"\w* \w a ruin|strong="H02723"\w*, \w an object of horror|strong="H08047"\w* \w and contempt|strong="H08322"\w* \w and cursing|strong="H07045"\w*, \w as they are to this|strong="H02088"\w* \w day|strong="H03117"\w* — \w -|strong="H00853"\w* \w Jerusalem|strong="H03389"\w* \w -|strong="H00853"\w* \w and the cities|strong="H05892"\w* \w of Judah|strong="H03063"\w*, \w -|strong="H00853"\w* \w its kings|strong="H04428"\w* \w -|strong="H00853"\w* \w and officials|strong="H08269"\w*; \v 19 \w -|strong="H00853"\w* \w Pharaoh|strong="H06547"\w* \w king|strong="H04428"\w* \w of Egypt|strong="H04714"\w*, \w -|strong="H00853"\w* \w his officials|strong="H05650"\w*, \w -|strong="H00853"\w* \w his leaders|strong="H08269"\w*, \w and|strong="H00853"\w* \w all|strong="H03605"\w* \w his people|strong="H05971"\w*; \v 20 \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the mixed tribes|strong="H06154"\w*; \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the kings|strong="H04428"\w* \w vvv|strong="H00776"\w* \w of Uz|strong="H05780"\w*; \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the kings|strong="H04428"\w* \w vvv|strong="H00776"\w* \w of the Philistines|strong="H06430"\w*: \w -|strong="H00853"\w* \w Ashkelon|strong="H00831"\w*, \w -|strong="H00853"\w* \w Gaza|strong="H05804"\w*, \w -|strong="H00853"\w* \w Ekron|strong="H06138"\w*, \w -|strong="H00853"\w* \w and the remnant|strong="H07611"\w* \w of Ashdod|strong="H00795"\w*; \v 21 \w -|strong="H00853"\w* \w Edom|strong="H00123"\w*, \w -|strong="H00853"\w* \w Moab|strong="H04124"\w*, \w -|strong="H00853"\w* \w and the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w*; \v 22 \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the kings|strong="H04428"\w* \w of Tyre|strong="H06865"\w* \w and|strong="H00853"\w* \w -|strong="H03605"\w* \w -|strong="H04428"\w* \w Sidon|strong="H06721"\w*; \w -|strong="H00853"\w* \w the kings|strong="H04428"\w* \w of the coastlands|strong="H00339"\w* \w -|strong="H00834"\w* \w across|strong="H05676"\w* \w the sea|strong="H03220"\w*; \v 23 \w -|strong="H00853"\w* \w Dedan|strong="H01719"\w*, \w -|strong="H00853"\w* \w Tema|strong="H08485"\w*, \w -|strong="H00853"\w* \w Buz|strong="H00938"\w*, \w -|strong="H00853"\w* \w and all|strong="H03605"\w* \w who cut|strong="H07112"\w* \w the corners [of their hair]|strong="H06285"\w*; \v 24 \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the kings|strong="H04428"\w* \w of Arabia|strong="H06152"\w*, \w -|strong="H00853"\w* \w and all|strong="H03605"\w* \w the kings|strong="H04428"\w* \w of the mixed tribes|strong="H06154"\w* \w who dwell|strong="H07931"\w* \w in the desert|strong="H04057"\w*; \v 25 \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the kings|strong="H04428"\w* \w of Zimri|strong="H02174"\w*, \w -|strong="H00853"\w* \w -|strong="H03605"\w* \w -|strong="H04428"\w* \w Elam|strong="H05867"\w*, \w and|strong="H00853"\w* \w -|strong="H03605"\w* \w -|strong="H04428"\w* \w Media|strong="H04074"\w*; \v 26 \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the kings|strong="H04428"\w* \w of the north|strong="H06828"\w*, \w both near|strong="H07138"\w* \w and far|strong="H07350"\w*, \w one|strong="H00376"\w* \w after|strong="H00413"\w* \w another|strong="H00251"\w* — \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the kingdoms|strong="H04467"\w* \w -|strong="H00776"\w* \w -|strong="H00834"\w* \w on|strong="H05921"\w* \w the face|strong="H06440"\w* \w of the earth|strong="H00127"\w*. \w And after all of them|strong="H00310"\w*, \w the king|strong="H04428"\w* \w of Sheshach|strong="H08347"\w*\f + \fr 25:26 \fqa Sheshach \ft is a code name for Babylon.\f* \w will drink [it too]|strong="H08354"\w*.
\p \v 27 “\w Then you are to tell them|strong="H00559"\w* \w that|strong="H00413"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w says|strong="H00559"\w*: ‘\w Drink|strong="H08354"\w*, \w get drunk|strong="H07937"\w*, \w and vomit|strong="H07006"\w*. \w Fall down|strong="H05307"\w* \w and never|strong="H03808"\w* \w get up again|strong="H06965"\w*, \w because of|strong="H06440"\w* \w the sword|strong="H02719"\w* \w -|strong="H00834"\w* \w I|strong="H00595"\w* \w will send|strong="H07971"\w* \w among you|strong="H00996"\w*.’
\p \v 28 \w -|strong="H01961"\w* \w If|strong="H03588"\w* \w they refuse|strong="H03985"\w* \w to take|strong="H03947"\w* \w the cup|strong="H03563"\w* \w from your hand|strong="H03027"\w* \w [and] drink it|strong="H08354"\w*, \w you are to tell them|strong="H00559"\w* \w that|strong="H00413"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w* \w says|strong="H00559"\w*: ‘\w You most certainly must drink it|strong="H08354"\w* \w . . .|strong="H08354"\w*! \v 29 \w For|strong="H03588"\w* \w behold|strong="H02009"\w*, \w I|strong="H00595"\w* \w am beginning|strong="H02490"\w* \w to bring disaster|strong="H07489"\w* \w on the city|strong="H05892"\w* \w that|strong="H00834"\w* \w bears|strong="H07121"\w* \w My Name|strong="H08034"\w*,\w . . .|strong="H05921"\w* \w so how could you|strong="H00859"\w* \w possibly go unpunished|strong="H05352"\w* \w . . .|strong="H05352"\w*? \w You will not|strong="H03808"\w* \w go unpunished|strong="H05352"\w*, \w for|strong="H03588"\w* \w I|strong="H00589"\w* \w am calling down|strong="H07121"\w* \w a sword|strong="H02719"\w* \w upon|strong="H05921"\w* \w all|strong="H03605"\w* \w the inhabitants|strong="H03427"\w* \w of the earth|strong="H00776"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*.’
\p \v 30 \w So you|strong="H00859"\w* \w are to prophesy|strong="H05012"\w* \w all|strong="H03605"\w* \w these|strong="H00428"\w* \w words|strong="H01697"\w* \w against|strong="H00413"\w* \w them|strong="H00853"\w* \w and say|strong="H00559"\w* \w to them|strong="H00413"\w*:
\b 
\q1 ‘\w The LORD|strong="H03068"\w* \w will roar|strong="H07580"\w* \w from on high|strong="H04791"\w*;
\q2 \w He will raise|strong="H05414"\w* \w His voice|strong="H06963"\w* \w from His holy|strong="H06944"\w* \w habitation|strong="H04583"\w*.
