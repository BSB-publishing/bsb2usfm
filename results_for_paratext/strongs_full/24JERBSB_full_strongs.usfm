\q1 \w and this|strong="H02088"\w* \w is the name|strong="H00834"\w* \w by which it will be called|strong="H07121"\w*:
\q2 \w The LORD|strong="H03068"\w* \w Our Righteousness|strong="H06664"\w*.\f + \fr 33:16 \ft Hebrew \fqa YHWH Tsidqenu\f*
\p \v 17 \w For|strong="H03588"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: \w David|strong="H01732"\w* \w will never|strong="H03808"\w* \w lack|strong="H03772"\w* \w a man|strong="H00376"\w* \w to sit|strong="H03427"\w* \w on|strong="H05921"\w* \w the throne|strong="H03678"\w* \w of the house|strong="H01004"\w* \w of Israel|strong="H03478"\w*, \v 18 \w nor|strong="H03808"\w* \w will the priests|strong="H03548"\w* \w who are Levites|strong="H03881"\w* \w ever|strong="H03605"\w* \w . . .|strong="H03117"\w* \w fail|strong="H03772"\w* \w to have a man|strong="H00376"\w* \w before Me|strong="H06440"\w* \w to offer|strong="H05927"\w* \w burnt offerings|strong="H05930"\w*, \w to burn|strong="H06999"\w* \w grain offerings|strong="H04503"\w*, \w and to present|strong="H06213"\w* \w sacrifices|strong="H02077"\w*.”
\p \v 19 \w And the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w came|strong="H01961"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w . . .|strong="H00559"\w*: \v 20 “\w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: \w If|strong="H00518"\w* \w you can break|strong="H06565"\w* \w -|strong="H00853"\w* \w My covenant|strong="H01285"\w* \w with the day|strong="H03117"\w* \w -|strong="H00853"\w* \w and My covenant|strong="H01285"\w* \w with the night|strong="H03915"\w*, \w so that day|strong="H03119"\w* \w and night|strong="H03915"\w* \w cease|strong="H01115"\w* \w to occupy|strong="H01961"\w* \w their appointed time|strong="H06256"\w*, \v 21 \w then My covenant|strong="H01285"\w* \w may also|strong="H01571"\w* \w be broken|strong="H06565"\w* \w with|strong="H00854"\w* \w David|strong="H01732"\w* \w My servant|strong="H05650"\w* \w and with|strong="H00854"\w* \w My ministers|strong="H08334"\w* \w the Levites|strong="H03881"\w* \w who are priests|strong="H03548"\w*, \w so that [David] will not have|strong="H01961"\w* \w a son|strong="H01121"\w* \w to reign|strong="H04427"\w* \w on|strong="H05921"\w* \w his throne|strong="H03678"\w*. \v 22 \w As|strong="H00834"\w* \w the hosts|strong="H06635"\w* \w of heaven|strong="H08064"\w* \w cannot|strong="H03808"\w* \w be counted|strong="H05608"\w* \w [and as] the sand|strong="H02344"\w* \w on the seashore|strong="H03220"\w* \w cannot|strong="H03808"\w* \w be measured|strong="H04058"\w*, \w so too|strong="H03651"\w* \w will I multiply|strong="H07235"\w* \w -|strong="H00853"\w* \w the descendants|strong="H02233"\w* \w of My servant|strong="H05650"\w* \w -|strong="H00853"\w* \w David|strong="H01732"\w* \w and the Levites|strong="H03881"\w* \w who minister|strong="H08334"\w* \w before Me|strong="H00853"\w*.”
\p \v 23 \w Moreover, the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w came|strong="H01961"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w . . .|strong="H00559"\w*: \v 24 “\w Have you not|strong="H03808"\w* \w noticed|strong="H07200"\w* \w what|strong="H04100"\w* \w these|strong="H02088"\w* \w people|strong="H05971"\w* \w are saying|strong="H01696"\w* \w . . .|strong="H00559"\w*: ‘\w The LORD|strong="H03068"\w* \w has rejected|strong="H03988"\w* \w -|strong="H00853"\w* \w the two|strong="H08147"\w* \w families|strong="H04940"\w* \w -|strong="H00834"\w* \w He had chosen|strong="H00977"\w*’? \w So they despise|strong="H05006"\w* \w My people|strong="H05971"\w* \w and no longer|strong="H05750"\w* \w regard them|strong="H01961"\w* \w as a nation|strong="H01471"\w* \w -|strong="H06440"\w*. \v 25 \w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: \w If|strong="H00518"\w*\w . . .|strong="H03808"\w* \w I have not|strong="H03808"\w* \w established|strong="H07760"\w* \w My covenant|strong="H01285"\w* \w with the day|strong="H03119"\w* \w and the night|strong="H03915"\w* \w and the fixed order|strong="H02708"\w* \w of heaven|strong="H08064"\w* \w and earth|strong="H00776"\w*, \v 26 \w then I would also|strong="H01571"\w* \w reject|strong="H03988"\w* \w the descendants|strong="H02233"\w* \w of Jacob|strong="H03290"\w* \w and of My servant|strong="H05650"\w* \w David|strong="H01732"\w*, \w so as not to take|strong="H03947"\w* \w from his descendants|strong="H02233"\w* \w rulers|strong="H04910"\w* \w over|strong="H00413"\w* \w the descendants|strong="H02233"\w* \w of Abraham|strong="H00085"\w*, \w Isaac|strong="H03446"\w*, \w and Jacob|strong="H03290"\w*. \w For|strong="H03588"\w* \w I will restore them|strong="H07725"\w* \w -|strong="H00853"\w* \w from captivity|strong="H07622"\w*\f + \fr 33:26 \ft Or \fqa restore their fortunes\f* \w and will have compassion on them|strong="H07355"\w*.”
\c 34
\s1 A Prophecy against Zedekiah
\p \v 1 \w This is the word|strong="H01697"\w* \w that|strong="H00834"\w* \w came|strong="H01961"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w -|strong="H00854"\w* \w from the LORD|strong="H03068"\w* \w when Nebuchadnezzar|strong="H05019"\w* \w king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*, \w all|strong="H03605"\w* \w his army|strong="H02428"\w*, \w all|strong="H03605"\w* \w the earthly|strong="H00776"\w* \w kingdoms|strong="H04467"\w* \w under his control|strong="H04475"\w* \w . . .|strong="H03027"\w*, \w and all|strong="H03605"\w* \w the other nations|strong="H05971"\w* \w were fighting|strong="H03898"\w* \w against|strong="H05921"\w* \w Jerusalem|strong="H03389"\w* \w . . .|strong="H05921"\w* \w and all|strong="H03605"\w* \w its surrounding cities|strong="H05892"\w* \w . . .|strong="H00559"\w*. \v 2 \w -|strong="H03541"\w* \w The LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w told [Jeremiah]|strong="H00559"\w* \w to go|strong="H01980"\w* \w and speak|strong="H00559"\w* \w to|strong="H00413"\w* \w Zedekiah|strong="H06667"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w and tell|strong="H00559"\w* \w him|strong="H00413"\w* \w that this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: “\w Behold|strong="H02005"\w*, \w I am about to deliver|strong="H05414"\w* \w this|strong="H02063"\w* \w city|strong="H05892"\w* \w -|strong="H00853"\w* \w into the hand|strong="H03027"\w* \w of the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*, \w and he will burn it down|strong="H08313"\w* \w . . .|strong="H00784"\w*. \v 3 \w And you yourself|strong="H00859"\w* \w will not|strong="H03808"\w* \w escape|strong="H04422"\w* \w his grasp|strong="H03027"\w*, \w but|strong="H03588"\w* \w will surely be captured|strong="H08610"\w* \w . . .|strong="H08610"\w* \w and delivered|strong="H05414"\w* \w into his hand|strong="H03027"\w*. \w You will see|strong="H07200"\w* \w the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w eye|strong="H05869"\w* \w -|strong="H00853"\w* \w to eye|strong="H05869"\w* \w and speak with him|strong="H01696"\w* \w face|strong="H06310"\w* \w to|strong="H00854"\w* \w face|strong="H06310"\w*; \w and you will go|strong="H00935"\w* \w to Babylon|strong="H00894"\w*.
\p \v 4 \w Yet|strong="H00389"\w* \w hear|strong="H08085"\w* \w the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w*, \w O Zedekiah|strong="H06667"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w*. \w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w* \w concerning you|strong="H05921"\w*: \w You will not|strong="H03808"\w* \w die|strong="H04191"\w* \w by the sword|strong="H02719"\w*; \v 5 \w you will die|strong="H04191"\w* \w in peace|strong="H07965"\w*. \w As [spices] were burned|strong="H04955"\w* \w for your fathers|strong="H00001"\w*, \w the former|strong="H07223"\w* \w kings|strong="H04428"\w* \w who|strong="H00834"\w* \w preceded|strong="H01961"\w* \w you|strong="H06440"\w*, \w so|strong="H03651"\w* \w [people] will burn [spices]|strong="H08313"\w* for you \w and lament|strong="H05594"\w*, ‘\w Alas|strong="H01945"\w*, \w O master|strong="H00113"\w*!’ \w For|strong="H03588"\w* \w I Myself|strong="H00589"\w* \w have spoken|strong="H01696"\w* \w this word|strong="H01697"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*.”
\p \v 6 \w In Jerusalem, then|strong="H03389"\w*, \w Jeremiah|strong="H03414"\w* \w the prophet|strong="H05030"\w* \w relayed|strong="H01696"\w* \w all|strong="H03605"\w* \w these|strong="H00428"\w* \w words|strong="H01697"\w* \w to|strong="H00413"\w* \w Zedekiah|strong="H06667"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w -|strong="H00853"\w* \v 7 \w as the army|strong="H02428"\w* \w of the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w was fighting|strong="H03898"\w* \w against|strong="H05921"\w* \w Jerusalem|strong="H03389"\w* \w . . .|strong="H05921"\w* \w vvv|strong="H03605"\w* \w and the remaining|strong="H03498"\w* \w cities|strong="H05892"\w* \w of Judah|strong="H03063"\w*— \w against|strong="H00413"\w* \w Lachish|strong="H03923"\w* \w . . .|strong="H00413"\w* \w and Azekah|strong="H05825"\w*. \w For|strong="H03588"\w* \w these were the only|strong="H02007"\w* \w fortified|strong="H04013"\w* \w cities|strong="H05892"\w* \w -|strong="H05892"\w* \w remaining|strong="H07604"\w* \w in Judah|strong="H03063"\w*.
\s1 Freedom for Hebrew Slaves
\p \v 8 \w After|strong="H00310"\w* \w King|strong="H04428"\w* \w Zedekiah|strong="H06667"\w* \w had made|strong="H03772"\w* \w a covenant|strong="H01285"\w* \w with|strong="H00854"\w* \w all|strong="H03605"\w* \w the people|strong="H05971"\w* \w -|strong="H00834"\w* \w in Jerusalem|strong="H03389"\w* \w to proclaim|strong="H07121"\w* . . . \w liberty|strong="H01865"\w*, \w the word|strong="H01697"\w* \w -|strong="H00834"\w* \w came|strong="H01961"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w from|strong="H00854"\w* \w the LORD|strong="H03068"\w* \v 9 \w that each man|strong="H00376"\w* \w -|strong="H00853"\w* \w should free|strong="H07971"\w* \w . . .|strong="H02670"\w* \w his Hebrew|strong="H05680"\w* \w slaves|strong="H05650"\w*, \w [both male] and female|strong="H05680"\w* \w . . .|strong="H08198"\w*, \w and no|strong="H01115"\w* \w one|strong="H00376"\w* \w -|strong="H00853"\w* \w should hold|strong="H05647"\w* \w his fellow|strong="H00251"\w* \w Jew {in bondage}|strong="H03064"\w* \w -|strong="H00376"\w*. \v 10 \w So all|strong="H03605"\w* \w the officials|strong="H08269"\w* \w and all|strong="H03605"\w* \w the people|strong="H05971"\w* \w who|strong="H00834"\w* \w entered|strong="H00935"\w* \w into this covenant|strong="H01285"\w* \w agreed|strong="H08085"\w* \w that they would free|strong="H07971"\w* \w . . .|strong="H00376"\w* \w -|strong="H00853"\w* \w -|strong="H02670"\w* \w their menservants|strong="H05650"\w* \w . . .|strong="H00376"\w* \w -|strong="H00853"\w* \w and maidservants|strong="H08198"\w* \w and no longer|strong="H01115"\w* \w hold them in bondage|strong="H05647"\w* \w -|strong="H05750"\w*. \w They obeyed|strong="H08085"\w* \w and released them|strong="H07971"\w*, \v 11 \w but later|strong="H00310"\w* \w -|strong="H03651"\w* \w they changed their minds|strong="H07725"\w* \w and took back|strong="H07725"\w* \w -|strong="H00853"\w* \w the menservants|strong="H05650"\w* \w and|strong="H00853"\w* \w maidservants|strong="H08198"\w* \w -|strong="H00834"\w* \w they had freed|strong="H07971"\w* \w . . .|strong="H02670"\w*, \w and they forced them|strong="H03533"\w* \w to become slaves|strong="H05650"\w* \w again|strong="H08198"\w*.
\p \v 12 \w Then the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w came|strong="H01961"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w -|strong="H00854"\w* \w from the LORD|strong="H03068"\w*, \w saying|strong="H00559"\w*, \v 13 “\w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w says|strong="H00559"\w*: \w I|strong="H00595"\w* \w made|strong="H03772"\w* \w a covenant|strong="H01285"\w* \w with|strong="H00854"\w* \w your forefathers|strong="H00001"\w* \w when|strong="H03117"\w* \w I brought them out|strong="H03318"\w* \w -|strong="H00853"\w* \w of the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w*, \w out of the house|strong="H01004"\w* \w of slavery|strong="H05650"\w*, \w saying|strong="H00559"\w*: \v 14 \w Every|strong="H07093"\w* \w seventh|strong="H07651"\w* \w year|strong="H08141"\w*, \w each|strong="H00376"\w* \w -|strong="H00853"\w* \w of you must free|strong="H07971"\w* \w his Hebrew|strong="H05680"\w* \w brother|strong="H00251"\w* \w who|strong="H00834"\w* \w has sold himself|strong="H04376"\w* to you. \w He may serve|strong="H05647"\w* \w you six|strong="H08337"\w* \w years|strong="H08141"\w*, \w but then you must let him go|strong="H07971"\w* \w free|strong="H02670"\w* \w -|strong="H05973"\w*. \w But your fathers|strong="H00001"\w* \w . . .|strong="H00413"\w* \w . . .|strong="H03808"\w* \w did not|strong="H03808"\w* \w listen|strong="H08085"\w* \w or incline|strong="H05186"\w* \w -|strong="H00853"\w* \w their ear|strong="H00241"\w*.
\p \v 15 \w Recently|strong="H03117"\w* \w you|strong="H00859"\w* \w repented|strong="H07725"\w* \w and did|strong="H06213"\w* \w -|strong="H00853"\w* \w what pleased|strong="H03477"\w* \w Me|strong="H05869"\w*; \w each|strong="H00376"\w* \w of you proclaimed|strong="H07121"\w* \w freedom|strong="H01865"\w* \w for his neighbor|strong="H07453"\w*. \w You made|strong="H03772"\w* \w a covenant|strong="H01285"\w* \w before Me|strong="H06440"\w* \w in the house|strong="H01004"\w* \w that|strong="H00834"\w* \w bears|strong="H07121"\w* \w My Name|strong="H08034"\w* \w . . .|strong="H05921"\w*. \v 16 \w But now you have changed your minds|strong="H07725"\w* \w and profaned|strong="H02490"\w* \w -|strong="H00853"\w* \w My name|strong="H08034"\w*. \w Each of you|strong="H00376"\w* \w -|strong="H00853"\w* \w has taken back|strong="H07725"\w* \w the menservants and maidservants|strong="H05650"\w* \w . . .|strong="H00376"\w* \w -|strong="H00853"\w* \w -|strong="H08198"\w* \w whom|strong="H00834"\w* \w you had set|strong="H07971"\w* \w at liberty|strong="H02670"\w* \w to go wherever they wanted|strong="H05315"\w*, \w and you have again forced|strong="H03533"\w* \w them|strong="H00853"\w* \w to be|strong="H01961"\w* your \w slaves|strong="H05650"\w* \w . . .|strong="H08198"\w*.
\p \v 17 \w Therefore|strong="H03651"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: \w You|strong="H00859"\w* \w have not|strong="H03808"\w* \w obeyed|strong="H08085"\w* \w Me|strong="H00413"\w*; \w you have not proclaimed|strong="H07121"\w* \w freedom|strong="H01865"\w*, \w each man|strong="H00376"\w* \w for his brother|strong="H00251"\w* \w . . .|strong="H00376"\w* \w and for his neighbor|strong="H07453"\w*. \w So now|strong="H02005"\w* \w I proclaim|strong="H07121"\w* \w freedom|strong="H01865"\w* for you, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w* — \w [freedom] to [fall]|strong="H00413"\w* \w by sword|strong="H02719"\w*, \w by|strong="H00413"\w* \w plague|strong="H01698"\w*, \w and by|strong="H00413"\w* \w famine|strong="H07458"\w*! \w I will make you|strong="H05414"\w* \w -|strong="H00853"\w* \w a horror|strong="H02113"\w* \w to all|strong="H03605"\w* \w the kingdoms|strong="H04467"\w* \w of the earth|strong="H00776"\w*.
\p \v 18 \w And those who have transgressed|strong="H05674"\w* \w -|strong="H00853"\w* \w My covenant|strong="H01285"\w* \w -|strong="H00834"\w* \w and have not|strong="H03808"\w* \w fulfilled|strong="H06965"\w* \w -|strong="H00853"\w* \w the terms|strong="H01697"\w* \w of the covenant|strong="H01285"\w* \w -|strong="H00834"\w* \w they made|strong="H03772"\w* \w before Me|strong="H06440"\w*, \w I will treat|strong="H05414"\w* \w -|strong="H00853"\w* \w -|strong="H00582"\w* \w like the calf|strong="H05695"\w* \w -|strong="H00834"\w* \w they cut|strong="H03772"\w* \w in two|strong="H08147"\w* \w in order to pass|strong="H05674"\w* \w between|strong="H00996"\w* \w its pieces|strong="H01335"\w*. \v 19 \w The officials|strong="H08269"\w* \w of Judah|strong="H03063"\w* \w . . .|strong="H08269"\w* \w and Jerusalem|strong="H03389"\w*, \w the court officials|strong="H05631"\w*, \w the priests|strong="H03548"\w*, \w and all|strong="H03605"\w* \w the people|strong="H05971"\w* \w of the land|strong="H00776"\w* \w who passed|strong="H05674"\w* \w between|strong="H00996"\w* \w the pieces|strong="H01335"\w* \w of the calf|strong="H05695"\w*, \v 20 \w I will deliver|strong="H05414"\w* \w -|strong="H00853"\w* \w into the hands|strong="H03027"\w* \w of their enemies|strong="H00341"\w* \w . . .|strong="H03027"\w* \w who seek|strong="H01245"\w* \w their lives|strong="H05315"\w*. \w Their corpses|strong="H05038"\w* \w will become|strong="H01961"\w* \w food|strong="H03978"\w* \w for the birds|strong="H05775"\w* \w of the air|strong="H08064"\w* \w and the beasts|strong="H00929"\w* \w of the earth|strong="H00776"\w*. \v 21 \w And|strong="H00853"\w* \w I will deliver|strong="H05414"\w* \w Zedekiah|strong="H06667"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w -|strong="H00853"\w* \w and his officials|strong="H08269"\w* \w into the hands|strong="H03027"\w* \w of their enemies|strong="H00341"\w* \w -|strong="H03027"\w* \w who seek|strong="H01245"\w* \w their lives|strong="H05315"\w*, \w . . .|strong="H03027"\w* \w to the army|strong="H02428"\w* \w of the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w that had withdrawn|strong="H05927"\w* \w from you|strong="H05921"\w*.
\p \v 22 \w Behold|strong="H02005"\w*, \w I am going to give the command|strong="H06680"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*, \w and I will bring them back|strong="H07725"\w* \w to|strong="H00413"\w* \w this|strong="H02063"\w* \w city|strong="H05892"\w*. \w They will fight|strong="H03898"\w* \w against it|strong="H05921"\w*, \w capture it|strong="H03920"\w*, \w and burn it down|strong="H08313"\w* \w . . .|strong="H00784"\w*. \w And|strong="H00853"\w* \w I will make|strong="H05414"\w* \w the cities|strong="H05892"\w* \w of Judah|strong="H03063"\w* \w a desolation|strong="H08077"\w*, \w without|strong="H00369"\w* \w inhabitant|strong="H03427"\w*.”
\c 35
\s1 The Obedience of the Rechabites
\p \v 1 \w This is the word|strong="H01697"\w* \w that|strong="H00834"\w* \w came|strong="H01961"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w -|strong="H00854"\w* \w from the LORD|strong="H03068"\w* \w in the days|strong="H03117"\w* \w of Jehoiakim|strong="H03079"\w* \w son|strong="H01121"\w* \w of Josiah|strong="H02977"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w . . .|strong="H00559"\w*: \v 2 “\w Go|strong="H01980"\w* \w to|strong="H00413"\w* \w the house|strong="H01004"\w* \w of the Rechabites|strong="H07397"\w*, \w speak|strong="H01696"\w* \w to them|strong="H00853"\w*, \w and bring them|strong="H00935"\w* \w to|strong="H00413"\w* \w one|strong="H00259"\w* \w of the chambers|strong="H03957"\w* \w of the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w* \w to offer them a drink|strong="H08248"\w* \w -|strong="H00853"\w* \w of wine|strong="H03196"\w*.”
\p \v 3 \w So I took|strong="H03947"\w* \w -|strong="H00853"\w* \w Jaazaniah|strong="H02970"\w* \w son|strong="H01121"\w* \w of Jeremiah|strong="H03414"\w*, \w the son|strong="H01121"\w* \w of Habazziniah|strong="H02262"\w*, \w -|strong="H00853"\w* \w and his brothers|strong="H00251"\w* \w -|strong="H00853"\w* \w and all|strong="H03605"\w* \w his sons|strong="H01121"\w*— \w -|strong="H00853"\w* \w the entire|strong="H03605"\w* \w house|strong="H01004"\w* \w of the Rechabites|strong="H07397"\w*— \v 4 \w and I brought|strong="H00935"\w* \w them|strong="H00853"\w* \w into the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*, \w to|strong="H00413"\w* \w a chamber|strong="H03957"\w* \w occupied by the sons|strong="H01121"\w* \w of Hanan|strong="H02605"\w* \w son|strong="H01121"\w* \w of Igdaliah|strong="H03012"\w*, \w a man|strong="H00376"\w* \w of God|strong="H00430"\w*. \w This [room was]|strong="H00834"\w* \w near|strong="H00681"\w* \w the chamber|strong="H03957"\w* \w of the officials|strong="H08269"\w*, \w which|strong="H00834"\w* \w was above|strong="H04605"\w* \w the chamber|strong="H03957"\w* \w of Maaseiah|strong="H04641"\w* \w son|strong="H01121"\w* \w of Shallum|strong="H07967"\w* \w the doorkeeper|strong="H08104"\w* \w . . .|strong="H05592"\w*.
\p \v 5 \w Then I set|strong="H05414"\w* \w pitchers|strong="H01375"\w* \w full|strong="H04392"\w* \w of wine|strong="H03196"\w* \w and [some] cups|strong="H03563"\w* \w before|strong="H06440"\w* \w the men|strong="H01121"\w* \w of the house|strong="H01004"\w* \w of the Rechabites|strong="H07397"\w*, \w and I said|strong="H00559"\w* \w to them|strong="H00413"\w*, “\w Drink|strong="H08354"\w* \w some wine|strong="H03196"\w*.”
\p \v 6 “\w We do not|strong="H03808"\w* \w drink|strong="H08354"\w* \w wine|strong="H03196"\w*,” \w they replied|strong="H00559"\w*, “\w for|strong="H03588"\w* \w our forefather|strong="H00001"\w* \w Jonadab|strong="H03122"\w*\f + \fr 35:6 \fqa Jonadab \ft is a variant of \fqa Jehonadab\ft ; here and throughout this chapter; see 2 Kings 10:15.\f* \w son|strong="H01121"\w* \w of Rechab|strong="H07394"\w* \w commanded|strong="H06680"\w* \w us|strong="H05921"\w* \w . . .|strong="H00559"\w*, ‘\w Neither you|strong="H00859"\w* \w nor your descendants|strong="H01121"\w* \w are ever to|strong="H03808"\w* \w . . .|strong="H05704"\w* \w . . .|strong="H05769"\w* \w drink|strong="H08354"\w* \w wine|strong="H03196"\w*. \v 7 \w Nor are you ever|strong="H03808"\w* \w to build|strong="H01129"\w* \w a house|strong="H01004"\w* \w [or]|strong="H03808"\w* \w sow|strong="H02232"\w* \w seed|strong="H02233"\w* \w [or]|strong="H03808"\w* \w plant|strong="H05193"\w* \w a vineyard|strong="H03754"\w*. \w Those things are|strong="H01961"\w* \w not|strong="H03808"\w* for you. \w Instead|strong="H03588"\w*, \w you must live|strong="H03427"\w* \w in tents|strong="H00168"\w* \w all|strong="H03605"\w* \w your lives|strong="H03117"\w*, \w so that|strong="H04616"\w* \w you may live|strong="H02421"\w* \w a long|strong="H07227"\w* \w time|strong="H03117"\w* \w in|strong="H05921"\w* \w . . .|strong="H06440"\w* \w the land|strong="H00127"\w* \w where|strong="H00834"\w* \w you|strong="H00859"\w* \w wander|strong="H01481"\w* \w . . .|strong="H08033"\w*.’
\p \v 8 \w And we have obeyed|strong="H08085"\w* \w the voice|strong="H06963"\w* \w of our forefather|strong="H00001"\w* \w Jonadab|strong="H03082"\w* \w son|strong="H01121"\w* \w of Rechab|strong="H07394"\w* \w in all|strong="H03605"\w* \w -|strong="H00834"\w* \w he commanded us|strong="H06680"\w*. \w So we have not|strong="H01115"\w* \w drunk|strong="H08354"\w* \w wine|strong="H03196"\w* \w all|strong="H03605"\w* \w our lives|strong="H03117"\w*— \w neither we|strong="H00587"\w* \w [nor] our wives|strong="H00802"\w* \w [nor] our sons|strong="H01121"\w* \w and daughters|strong="H01323"\w*. \v 9 \w Nor have we|strong="H01115"\w* \w built|strong="H01129"\w* \w houses|strong="H01004"\w* \w in which to live|strong="H03427"\w*, \w vvv|strong="H03808"\w* \w and we have not owned|strong="H01961"\w* \w any vineyards|strong="H03754"\w* \w or fields|strong="H07704"\w* \w or crops|strong="H02233"\w*. \v 10 \w But we have lived|strong="H03427"\w* \w in tents|strong="H00168"\w* \w and have obeyed|strong="H08085"\w* \w and done|strong="H06213"\w* \w exactly as|strong="H03605"\w* \w -|strong="H00834"\w* \w our forefather|strong="H00001"\w* \w Jonadab|strong="H03122"\w* \w commanded us|strong="H06680"\w*.
\p \v 11 \w So when|strong="H01961"\w* \w Nebuchadnezzar|strong="H05019"\w* \w king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w marched|strong="H05927"\w* \w into|strong="H00413"\w* \w the land|strong="H00776"\w*, \w we said|strong="H00559"\w*: ‘\w Come|strong="H00935"\w*, \w let us go into|strong="H00935"\w* \w Jerusalem|strong="H03389"\w* \w to escape|strong="H06440"\w* \w the armies|strong="H02428"\w* \w of the Chaldeans|strong="H03778"\w*\f + \fr 35:11 \ft That is, the Babylonians\f* \w . . .|strong="H06440"\w* \w . . .|strong="H02428"\w* \w and the Arameans|strong="H00758"\w*.’ \w So we have remained|strong="H03427"\w* \w in Jerusalem|strong="H03389"\w*.”
\s1 Judah Rebuked
\p \v 12 \w Then the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w came|strong="H01961"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w . . .|strong="H00559"\w*: \v 13 “\w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w says|strong="H00559"\w*: \w Go|strong="H01980"\w* \w and tell|strong="H00559"\w* \w the men|strong="H00376"\w* \w of Judah|strong="H03063"\w* \w and the residents|strong="H03427"\w* \w of Jerusalem|strong="H03389"\w*: ‘\w Will you not|strong="H03808"\w* \w accept|strong="H03947"\w* \w discipline|strong="H04148"\w* \w and obey|strong="H08085"\w* \w . . .|strong="H00413"\w* \w My words|strong="H01697"\w*?’ \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w*.
\p \v 14 \w The words|strong="H01697"\w* \w of Jonadab|strong="H03082"\w* \w son|strong="H01121"\w* \w of Rechab|strong="H07394"\w* \w have been carried out|strong="H06965"\w*. \w -|strong="H00853"\w* \w He|strong="H00834"\w* \w commanded|strong="H06680"\w* \w -|strong="H00853"\w* \w his sons|strong="H01121"\w* \w not|strong="H01115"\w* \w to drink|strong="H08354"\w* \w wine|strong="H03196"\w*, \w and they have not|strong="H03808"\w* \w drunk [it]|strong="H08354"\w* \w to|strong="H05704"\w* \w this very|strong="H02088"\w* \w day|strong="H03117"\w* \w because|strong="H03588"\w* \w they have obeyed|strong="H08085"\w* \w -|strong="H00853"\w* \w the command|strong="H04687"\w* \w of their forefather|strong="H00001"\w*. \w But I|strong="H00595"\w* \w have spoken|strong="H01696"\w* \w to you|strong="H00413"\w* \w again and again|strong="H07925"\w* \w . . .|strong="H01696"\w*,\f + \fr 35:14 \ft Literally \fqa But I have spoken to you, rising up early and speaking,\f* \w and you have not|strong="H03808"\w* \w obeyed Me|strong="H08085"\w* \w . . .|strong="H00413"\w*!
\p \v 15 \w Again|strong="H07925"\w* \w and again|strong="H07971"\w* \w I have sent|strong="H07971"\w* \w you|strong="H00413"\w*\f + \fr 35:15 \ft Literally \fqa Rising up early and sending (you), I have sent you\f* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w My servants|strong="H05650"\w* \w the prophets|strong="H05030"\w*, \w proclaiming|strong="H00559"\w*: ‘\w Turn|strong="H07725"\w* \w now|strong="H04994"\w*, \w each of you|strong="H00376"\w*, \w from your wicked|strong="H07451"\w* \w ways|strong="H01870"\w*, \w and correct|strong="H03190"\w* \w your actions|strong="H04611"\w*. \w Do not|strong="H00408"\w* \w go after|strong="H01980"\w* \w . . .|strong="H00310"\w* \w other|strong="H00312"\w* \w gods|strong="H00430"\w* \w to serve them|strong="H05647"\w*. \w Live|strong="H03427"\w* \w in|strong="H00413"\w* \w the land|strong="H00127"\w* \w that|strong="H00834"\w* \w I have given|strong="H05414"\w* to you \w and your fathers|strong="H00001"\w*.’ \w But you have not|strong="H03808"\w* \w inclined|strong="H05186"\w*\w . . .|strong="H00853"\w* \w your ear|strong="H00241"\w* \w [or]|strong="H03808"\w* \w listened|strong="H08085"\w* \w to Me|strong="H00413"\w*. \v 16 \w Yes|strong="H03588"\w*, \w the sons|strong="H01121"\w* \w of Jonadab|strong="H03082"\w* \w son|strong="H01121"\w* \w of Rechab|strong="H07394"\w* \w -|strong="H00853"\w* \w carried out|strong="H06965"\w* \w the command|strong="H04687"\w* \w their forefather|strong="H00001"\w*\w . . .|strong="H00834"\w* \w gave them|strong="H06680"\w*, \w but these|strong="H02088"\w* \w people|strong="H05971"\w* \w have not|strong="H03808"\w* \w listened|strong="H08085"\w* \w to Me|strong="H00413"\w*.
\p \v 17 \w Therefore|strong="H03651"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w God|strong="H00430"\w* \w of Hosts|strong="H06635"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w says|strong="H00559"\w*: ‘\w Behold|strong="H02005"\w*, \w I will bring|strong="H00935"\w* \w to|strong="H00413"\w* \w Judah|strong="H03063"\w* \w and to|strong="H00413"\w* \w all|strong="H03605"\w* \w the residents|strong="H03427"\w* \w of Jerusalem|strong="H03389"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the disaster|strong="H07451"\w* \w -|strong="H00834"\w* \w I have pronounced|strong="H01696"\w* \w against them|strong="H05921"\w*, \w because|strong="H03282"\w* \w I have spoken|strong="H01696"\w* \w to them|strong="H00413"\w* \w but they have not|strong="H03808"\w* \w obeyed|strong="H08085"\w*, \w and I have called|strong="H07121"\w* to them \w but they have not|strong="H03808"\w* \w answered|strong="H06030"\w*.’”
\p \v 18 \w Then Jeremiah|strong="H03414"\w* \w said|strong="H00559"\w* \w to the house|strong="H01004"\w* \w of the Rechabites|strong="H07397"\w*: “\w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w says|strong="H00559"\w*: ‘\w Because|strong="H03282"\w* \w -|strong="H00834"\w* \w you have obeyed|strong="H08085"\w* \w . . .|strong="H05921"\w* \w the command|strong="H04687"\w* \w of your forefather|strong="H00001"\w* \w Jonadab|strong="H03082"\w* \w and have kept|strong="H08104"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w his commandments|strong="H04687"\w* \w and have done|strong="H06213"\w* \w all|strong="H03605"\w* \w that|strong="H00834"\w* \w he charged you to do|strong="H06680"\w*, \w -|strong="H00853"\w* \v 19 \w -|strong="H03651"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w says|strong="H00559"\w*: \w Jonadab|strong="H03122"\w* \w son|strong="H01121"\w* \w of Rechab|strong="H07394"\w* \w will never|strong="H03808"\w* \w . . .|strong="H03605"\w* \w fail to have|strong="H03772"\w* \w a man|strong="H00376"\w* \w . . .|strong="H03117"\w* \w to stand|strong="H05975"\w* \w before Me|strong="H06440"\w*.’”
\c 36
\s1 Jeremiah’s Scroll Read in the Temple
\p \v 1 \w In the fourth|strong="H07243"\w* \w year|strong="H08141"\w* \w of Jehoiakim|strong="H03079"\w* \w son|strong="H01121"\w* \w of Josiah|strong="H02977"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w*, \w . . .|strong="H01961"\w* \w this|strong="H02088"\w* \w word|strong="H01697"\w* \w came|strong="H01961"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w -|strong="H00854"\w* \w from the LORD|strong="H03068"\w*\w . . .|strong="H00559"\w*: \v 2 “\w Take|strong="H03947"\w* \w a scroll|strong="H04039"\w* \w . . .|strong="H05612"\w* \w and write|strong="H03789"\w* \w on|strong="H00413"\w* \w -|strong="H00853"\w* \w it all|strong="H03605"\w* \w the words|strong="H01697"\w* \w -|strong="H00834"\w* \w I have spoken|strong="H01696"\w* \w to|strong="H00413"\w* \w you concerning|strong="H05921"\w* \w Israel|strong="H03478"\w*, \w . . .|strong="H05921"\w* \w Judah|strong="H03063"\w*, \w . . .|strong="H05921"\w* \w and all|strong="H03605"\w* \w the nations|strong="H01471"\w*, \w from the day|strong="H03117"\w* \w I first spoke|strong="H01696"\w* \w to you|strong="H00413"\w* \w during the reign|strong="H03117"\w* \w of Josiah|strong="H02977"\w* \w until today|strong="H05704"\w* \w . . .|strong="H03117"\w* \w . . .|strong="H02088"\w*. \v 3 \w Perhaps|strong="H00194"\w* \w when the people|strong="H01004"\w* \w of Judah|strong="H03063"\w* \w -|strong="H00853"\w* \w hear|strong="H08085"\w* \w about all|strong="H03605"\w* \w the calamity|strong="H07451"\w* \w -|strong="H00834"\w* \w I|strong="H00595"\w* \w plan|strong="H02803"\w* \w to bring|strong="H06213"\w* upon them, \w . . .|strong="H04616"\w* \w each of them|strong="H00376"\w* \w will turn|strong="H07725"\w* \w from his wicked|strong="H07451"\w* \w way|strong="H01870"\w*. \w Then I will forgive|strong="H05545"\w* \w their iniquity|strong="H05771"\w* \w and their sin|strong="H02403"\w*.”
\p \v 4 \w So Jeremiah|strong="H03414"\w* \w -|strong="H00853"\w* \w called|strong="H07121"\w* \w Baruch|strong="H01263"\w* \w son|strong="H01121"\w* \w of Neriah|strong="H05374"\w*, \w -|strong="H00853"\w* \w and at the dictation|strong="H06310"\w* \w of Jeremiah|strong="H03414"\w*, \w Baruch|strong="H01263"\w* \w wrote|strong="H03789"\w* \w on|strong="H05921"\w* \w a scroll|strong="H04039"\w* \w . . .|strong="H05612"\w* \w all|strong="H03605"\w* \w the words|strong="H01697"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had spoken|strong="H01696"\w* \w to Jeremiah|strong="H00413"\w*.
\p \v 5 \w Then Jeremiah|strong="H03414"\w* \w -|strong="H00853"\w* \w commanded|strong="H06680"\w* \w Baruch|strong="H01263"\w*, \w . . .|strong="H00559"\w* “\w I|strong="H00589"\w* \w am restricted|strong="H06113"\w*; \w I cannot|strong="H03808"\w* \w . . .|strong="H03201"\w* \w enter|strong="H00935"\w* \w the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*; \v 6 \w so you|strong="H00859"\w* \w are to go|strong="H00935"\w* \w to the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w* \w on a day|strong="H03117"\w* \w of fasting|strong="H06685"\w*, \w -|strong="H00853"\w* \w and in the hearing|strong="H00241"\w* \w of the people|strong="H05971"\w* \w you are to read|strong="H07121"\w* \w the words|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w from the scroll|strong="H04039"\w* \w -|strong="H00834"\w* \w you have written|strong="H03789"\w* \w at my dictation|strong="H06310"\w*. \w -|strong="H01571"\w* \w Read them|strong="H07121"\w* \w in the hearing|strong="H00241"\w* \w of all|strong="H03605"\w* \w [the people of] Judah|strong="H03063"\w* \w who are coming|strong="H00935"\w* \w from their cities|strong="H05892"\w*.
\p \v 7 \w Perhaps|strong="H00194"\w* \w they will bring|strong="H05307"\w* \w their petition|strong="H08467"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*, \w and each|strong="H00376"\w* \w one will turn|strong="H07725"\w* \w from his wicked|strong="H07451"\w* \w way|strong="H01870"\w*; \w for|strong="H03588"\w* \w great are|strong="H01419"\w* \w the anger|strong="H00639"\w* \w and fury|strong="H02534"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w has pronounced|strong="H01696"\w* \w against|strong="H00413"\w* \w this|strong="H02088"\w* \w people|strong="H05971"\w*.”
\p \v 8 \w So Baruch|strong="H01263"\w* \w son|strong="H01121"\w* \w of Neriah|strong="H05374"\w* \w did|strong="H06213"\w* \w everything|strong="H03605"\w* \w that|strong="H00834"\w* \w Jeremiah|strong="H03414"\w* \w the prophet|strong="H05030"\w* \w had commanded him|strong="H06680"\w*. \w In the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w* \w he read|strong="H07121"\w* \w the words|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w from the scroll|strong="H05612"\w*.
\p \v 9 \w Now|strong="H01961"\w* \w in the ninth|strong="H08671"\w* \w month|strong="H02320"\w* \w of the fifth|strong="H02549"\w* \w year|strong="H08141"\w* \w of Jehoiakim|strong="H03079"\w* \w son|strong="H01121"\w* \w of Josiah|strong="H02977"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w*, \w a fast|strong="H06685"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w was proclaimed|strong="H07121"\w* \w to all|strong="H03605"\w* \w the people|strong="H05971"\w* \w of Jerusalem|strong="H03389"\w* \w and all|strong="H03605"\w* \w . . .|strong="H05971"\w* \w who had come|strong="H00935"\w* \w [there]|strong="H03389"\w* \w from the cities|strong="H05892"\w* \w of Judah|strong="H03063"\w*. \v 10 \w -|strong="H03068"\w* \w -|strong="H01004"\w* \w From the chamber|strong="H03957"\w* \w of Gemariah|strong="H01587"\w* \w son|strong="H01121"\w* \w of Shaphan|strong="H08227"\w* \w the scribe|strong="H05608"\w*, \w which was in the upper|strong="H05945"\w* \w courtyard|strong="H02691"\w* \w at the opening|strong="H06607"\w* \w of the New|strong="H02319"\w* \w Gate|strong="H08179"\w* \w of the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w*, \w Baruch|strong="H01263"\w* \w read|strong="H07121"\w* \w from the scroll|strong="H05612"\w* \w -|strong="H00853"\w* \w the words|strong="H01697"\w* \w of Jeremiah|strong="H03414"\w* \w in the hearing|strong="H00241"\w* \w of all|strong="H03605"\w* \w the people|strong="H05971"\w*.
\s1 Jeremiah’s Scroll Read in the Palace
\p \v 11 \w When Micaiah|strong="H04321"\w* \w son|strong="H01121"\w* \w of Gemariah|strong="H01587"\w*, \w the son|strong="H01121"\w* \w of Shaphan|strong="H08227"\w*, \w -|strong="H00853"\w* \w heard|strong="H08085"\w* \w all|strong="H03605"\w* \w the words|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w from|strong="H05921"\w* \w the scroll|strong="H05612"\w*, \v 12 \w he went down|strong="H03381"\w* \w to|strong="H05921"\w* \w the scribe’s|strong="H05608"\w* \w . . .|strong="H02009"\w* \w chamber|strong="H03957"\w* \w in the king’s|strong="H04428"\w* \w palace|strong="H01004"\w*, \w where|strong="H08033"\w* \w all|strong="H03605"\w* \w the officials|strong="H08269"\w* \w were sitting|strong="H03427"\w*: \w Elishama|strong="H00476"\w* \w the scribe|strong="H05608"\w*, \w Delaiah|strong="H01806"\w* \w son|strong="H01121"\w* \w of Shemaiah|strong="H08098"\w*, \w Elnathan|strong="H00494"\w* \w son|strong="H01121"\w* \w of Achbor|strong="H05907"\w*, \w Gemariah|strong="H01587"\w* \w son|strong="H01121"\w* \w of Shaphan|strong="H08227"\w*, \w Zedekiah|strong="H06667"\w* \w son|strong="H01121"\w* \w of Hananiah|strong="H02608"\w*, \w and all|strong="H03605"\w* \w the other officials|strong="H08269"\w*. \v 13 \w And Micaiah|strong="H04321"\w* \w -|strong="H00853"\w* \w reported|strong="H05046"\w* to them \w all|strong="H03605"\w* \w the words|strong="H01697"\w* \w -|strong="H00834"\w* \w he had heard|strong="H08085"\w* \w Baruch|strong="H01263"\w* \w read|strong="H07121"\w* \w from the scroll|strong="H05612"\w* \w in the hearing|strong="H00241"\w* \w of the people|strong="H05971"\w*.
\p \v 14 \w Then all|strong="H03605"\w* \w the officials|strong="H08269"\w* \w sent|strong="H07971"\w* \w word to|strong="H00413"\w* \w Baruch|strong="H01263"\w* \w -|strong="H00853"\w* \w through Jehudi|strong="H03065"\w* \w son|strong="H01121"\w* \w of Nethaniah|strong="H05418"\w*, \w the son|strong="H01121"\w* \w of Shelemiah|strong="H08018"\w*, \w the son|strong="H01121"\w* \w of Cushi|strong="H03570"\w*, \w saying|strong="H00559"\w*, “\w Bring|strong="H03947"\w* \w . . .|strong="H03027"\w* \w the scroll|strong="H04039"\w* \w that|strong="H00834"\w* \w you read|strong="H07121"\w* in \w the hearing|strong="H00241"\w* \w of the people|strong="H05971"\w*, \w and come [here]|strong="H01980"\w*.”
\p \w So Baruch|strong="H01263"\w* \w son|strong="H01121"\w* \w of Neriah|strong="H05374"\w* \w -|strong="H00853"\w* \w took|strong="H03947"\w* \w . . .|strong="H03027"\w* \w the scroll|strong="H04039"\w* \w and went|strong="H00935"\w* \w to them|strong="H00413"\w*.
\p \v 15 “\w Please|strong="H04994"\w* \w sit down|strong="H03427"\w*,” \w they said|strong="H00559"\w* \w -|strong="H00413"\w*, “\w and read|strong="H07121"\w* \w it in our hearing|strong="H00241"\w*.”
\p \w So Baruch|strong="H01263"\w* \w read|strong="H07121"\w* \w it in their hearing|strong="H00241"\w*.
\p \v 16 \w -|strong="H01961"\w* \w When they had heard|strong="H08085"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w these words|strong="H01697"\w*, \w they turned to|strong="H00413"\w* \w one|strong="H00376"\w* \w another|strong="H07453"\w* \w in fear|strong="H06342"\w* \w and said|strong="H00559"\w* \w to|strong="H00413"\w* \w Baruch|strong="H01263"\w*, “\w Surely we must report|strong="H05046"\w* \w . . .|strong="H05046"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w these|strong="H00428"\w* \w words|strong="H01697"\w* \w to the king|strong="H04428"\w*.”
\p \v 17 “\w Tell|strong="H05046"\w* us \w now|strong="H04994"\w*,” \w -|strong="H00853"\w* \w they asked|strong="H07592"\w* \w . . .|strong="H00559"\w* \w Baruch|strong="H01263"\w*, “\w how|strong="H00349"\w* \w did you write|strong="H03789"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w these|strong="H00428"\w* \w words|strong="H01697"\w*? \w [Was it] at [Jeremiah’s] dictation|strong="H06310"\w*?”
\p \v 18 “[It was] at \w his dictation|strong="H06310"\w*,” \w Baruch|strong="H01263"\w* \w replied|strong="H00559"\w*. “\w He recited|strong="H07121"\w* \w all|strong="H03605"\w* \w these|strong="H00428"\w* \w words|strong="H01697"\w* \w to me|strong="H00413"\w* \w -|strong="H00853"\w* \w and I|strong="H00589"\w* \w wrote [them]|strong="H03789"\w* \w in ink|strong="H01773"\w* \w on|strong="H05921"\w* \w the scroll|strong="H05612"\w*.”
\p \v 19 \w Then the officials|strong="H08269"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Baruch|strong="H01263"\w*, \w . . .|strong="H01980"\w* “\w You|strong="H00859"\w* \w and Jeremiah|strong="H03414"\w* \w must hide yourselves|strong="H05641"\w* \w and tell|strong="H03045"\w* \w no|strong="H00408"\w* \w one|strong="H00376"\w* \w where|strong="H00375"\w* \w you are|strong="H00859"\w*.”
\s1 Jehoiakim Burns the Scroll
\p \v 20 \w So [the officials] went|strong="H00935"\w* \w to|strong="H00413"\w* \w the king|strong="H04428"\w* \w in the courtyard|strong="H02691"\w*. \w And|strong="H00853"\w* \w having stored|strong="H06485"\w* \w the scroll|strong="H04039"\w* \w in the chamber|strong="H03957"\w* \w of Elishama|strong="H00476"\w* \w the scribe|strong="H05608"\w*, \w they reported|strong="H05046"\w* \w everything|strong="H03605"\w* \w . . .|strong="H01697"\w* \w to|strong="H00241"\w* \w the king|strong="H04428"\w*. \w -|strong="H00853"\w*
\p \v 21 \w Then the king|strong="H04428"\w* \w -|strong="H00853"\w* \w sent|strong="H07971"\w* \w Jehudi|strong="H03065"\w* \w to get|strong="H03947"\w* \w -|strong="H00853"\w* \w the scroll|strong="H04039"\w*, \w and he took it|strong="H03947"\w* \w from the chamber|strong="H03957"\w* \w of Elishama|strong="H00476"\w* \w the scribe|strong="H05608"\w*. \w And Jehudi|strong="H03065"\w* \w read it|strong="H07121"\w* \w in the hearing|strong="H00241"\w* \w of the king|strong="H04428"\w* \w . . .|strong="H00241"\w* \w and all|strong="H03605"\w* \w the officials|strong="H08269"\w* \w who were standing|strong="H05975"\w* \w beside|strong="H05921"\w* \w [him]|strong="H04428"\w*.
\p \v 22 \w Since it was the ninth|strong="H08671"\w* \w -|strong="H00853"\w* \w month|strong="H02320"\w*, \w the king|strong="H04428"\w* \w was sitting|strong="H03427"\w* \w in his winter|strong="H02779"\w* \w quarters|strong="H01004"\w* \w with a fire|strong="H00254"\w* \w burning|strong="H01197"\w* \w before him|strong="H06440"\w*. \v 23 \w And|strong="H01961"\w* \w as soon as Jehudi|strong="H03065"\w* \w had read|strong="H07121"\w* \w three|strong="H07969"\w* \w or four|strong="H00702"\w* \w columns|strong="H01817"\w*, \w Jehoiakim would cut [them off]|strong="H07167"\w* \w with a scribe’s|strong="H05608"\w* \w knife|strong="H08593"\w* \w and throw [them]|strong="H07993"\w* \w into|strong="H00413"\w* \w the firepot|strong="H00254"\w* \w . . .|strong="H00784"\w* \w -|strong="H00834"\w* \w -|strong="H00413"\w*, \w until|strong="H05704"\w* \w the entire|strong="H03605"\w* \w scroll|strong="H04039"\w* \w had been consumed|strong="H08552"\w* \w by|strong="H05921"\w* \w the fire|strong="H00784"\w* \w -|strong="H00834"\w* \w -|strong="H05921"\w* \w -|strong="H00254"\w*.
\p \v 24 \w Yet in hearing|strong="H08085"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w these|strong="H00428"\w* \w words|strong="H01697"\w*, \w the king|strong="H04428"\w* \w and|strong="H03605"\w* \w his servants|strong="H05650"\w* \w did not|strong="H03808"\w* \w become frightened|strong="H06342"\w* \w . . .|strong="H03808"\w* \w or tear|strong="H07167"\w* \w -|strong="H00853"\w* \w their garments|strong="H00899"\w*. \v 25 \w Even though|strong="H01571"\w* \w Elnathan|strong="H00494"\w*, \w Delaiah|strong="H01806"\w*, \w and Gemariah|strong="H01587"\w* \w urged|strong="H06293"\w* \w the king|strong="H04428"\w* \w not|strong="H01115"\w* \w to burn|strong="H08313"\w* \w -|strong="H00853"\w* \w the scroll|strong="H04039"\w*, \w he would not|strong="H03808"\w* \w listen|strong="H08085"\w* \w to them|strong="H00413"\w*. \v 26 \w Instead, the king|strong="H04428"\w* \w -|strong="H00853"\w* \w commanded|strong="H06680"\w* \w Jerahmeel|strong="H03396"\w*, \w a son|strong="H01121"\w* \w of the king|strong="H04428"\w*, \w as well as|strong="H00853"\w* \w Seraiah|strong="H08304"\w* \w son|strong="H01121"\w* \w of Azriel|strong="H05837"\w* \w -|strong="H00853"\w* \w and Shelemiah|strong="H08018"\w* \w son|strong="H01121"\w* \w of Abdeel|strong="H05655"\w*, \w to seize|strong="H03947"\w* \w -|strong="H00853"\w* \w Baruch|strong="H01263"\w* \w the scribe|strong="H05608"\w* \w -|strong="H00853"\w* \w and Jeremiah|strong="H03414"\w* \w the prophet|strong="H05030"\w*. \w But the LORD|strong="H03068"\w* \w had hidden them|strong="H05641"\w*.
\s1 Jeremiah Rewrites the Scroll
\p \v 27 \w After|strong="H00310"\w* \w the king|strong="H04428"\w* \w -|strong="H00853"\w* \w had burned|strong="H08313"\w* \w the scroll|strong="H04039"\w* \w -|strong="H00853"\w* \w containing the words|strong="H01697"\w* \w that|strong="H00834"\w* \w Baruch|strong="H01263"\w* \w had written|strong="H03789"\w* \w at Jeremiah’s|strong="H03414"\w* \w dictation|strong="H06310"\w*, \w the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w came|strong="H01961"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w -|strong="H00559"\w*: \v 28 “\w Take|strong="H03947"\w* \w another|strong="H00312"\w* \w scroll|strong="H04039"\w* \w and|strong="H07725"\w* \w rewrite|strong="H03789"\w* \w on it|strong="H05921"\w* \w -|strong="H00853"\w* \w vvv|strong="H03605"\w* \w the very words|strong="H01697"\w*\w . . .|strong="H07223"\w* \w that|strong="H00834"\w* \w were|strong="H01961"\w* \w on|strong="H05921"\w* \w the original|strong="H07223"\w* \w scroll|strong="H04039"\w*, \w which|strong="H00834"\w* \w Jehoiakim|strong="H03079"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w has burned|strong="H08313"\w*.
\p \v 29 \w You are to proclaim|strong="H00559"\w* \w concerning|strong="H05921"\w* \w Jehoiakim|strong="H03079"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w that this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: \w You|strong="H00859"\w* \w have burned|strong="H08313"\w* \w -|strong="H00853"\w* \w the|strong="H02063"\w* \w scroll|strong="H04039"\w* \w and said|strong="H00559"\w*, ‘\w Why|strong="H04069"\w* \w have you written|strong="H03789"\w* \w on it|strong="H05921"\w* \w that|strong="H00559"\w* \w the king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w would surely come|strong="H00935"\w* \w . . .|strong="H00935"\w* \w and destroy|strong="H07843"\w* \w -|strong="H00853"\w* \w this|strong="H02063"\w* \w land|strong="H00776"\w* \w and deprive it|strong="H07673"\w* \w of|strong="H04480"\w* \w man|strong="H00120"\w* \w and beast|strong="H00929"\w*?’
\p \v 30 \w Therefore|strong="H03651"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w* \w about|strong="H05921"\w* \w Jehoiakim|strong="H03079"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w*: \w He will have|strong="H01961"\w* \w no|strong="H03808"\w* \w one to sit|strong="H03427"\w* \w on|strong="H05921"\w* \w David’s|strong="H01732"\w* \w throne|strong="H03678"\w*, \w and his body|strong="H05038"\w* \w will be|strong="H01961"\w* \w thrown out|strong="H07993"\w* \w [and] exposed to heat|strong="H02721"\w* \w by day|strong="H03117"\w* \w and frost|strong="H07140"\w* \w by night|strong="H03915"\w*. \v 31 \w I will punish|strong="H06485"\w* \w him|strong="H05921"\w* \w and|strong="H05921"\w* \w his descendants|strong="H02233"\w* \w . . .|strong="H05921"\w* \w and servants|strong="H05650"\w* \w -|strong="H00853"\w* \w for their iniquity|strong="H05771"\w*. \w I will bring|strong="H00935"\w* \w on them|strong="H05921"\w*, \w on|strong="H05921"\w* \w the residents|strong="H03427"\w* \w of Jerusalem|strong="H03389"\w*, \w and on|strong="H00413"\w* \w the men|strong="H00376"\w* \w of Judah|strong="H03063"\w*, \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the calamity|strong="H07451"\w* \w about which|strong="H00834"\w* \w I warned them|strong="H01696"\w* \w . . .|strong="H00413"\w* \w but they did not|strong="H03808"\w* \w listen|strong="H08085"\w*.”
\p \v 32 \w Then Jeremiah|strong="H03414"\w* \w took|strong="H03947"\w* \w another|strong="H00312"\w* \w scroll|strong="H04039"\w* \w and gave|strong="H05414"\w* \w it to|strong="H00413"\w* \w the scribe|strong="H05608"\w* \w Baruch|strong="H01263"\w* \w son|strong="H01121"\w* \w of Neriah|strong="H05374"\w*, \w and at Jeremiah’s|strong="H03414"\w* \w -|strong="H00853"\w* \w dictation|strong="H06310"\w* \w he wrote|strong="H03789"\w* \w on it|strong="H05921"\w* \w all|strong="H03605"\w* \w the words|strong="H01697"\w* \w of the scroll|strong="H05612"\w* \w that|strong="H00834"\w* \w Jehoiakim|strong="H03079"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w* \w had burned|strong="H08313"\w* \w in the fire|strong="H00784"\w*. \w And many|strong="H07227"\w* . . . \w similar|strong="H05750"\w* \w words|strong="H01697"\w* \w were added|strong="H03254"\w* \w to them|strong="H05921"\w*.
\c 37
\s1 Jeremiah Warns Zedekiah
\p \v 1 \w Nebuchadnezzar|strong="H05019"\w* \w king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*\w . . .|strong="H00834"\w* \w {made} Zedekiah|strong="H06667"\w* \w son|strong="H01121"\w* \w of Josiah|strong="H02977"\w* \w the king|strong="H04427"\w* \w -|strong="H00776"\w* \w of Judah|strong="H03063"\w*, \w and he reigned|strong="H04427"\w* \w . . .|strong="H04428"\w* \w in place|strong="H08478"\w* \w of Coniah|strong="H03659"\w*\f + \fr 37:1 \fqa Coniah \ft is a variant of \fqa Jehoiachin\ft .\f* \w son|strong="H01121"\w* \w of Jehoiakim|strong="H03079"\w*. \v 2 \w But he|strong="H01931"\w* \w and his officers|strong="H05650"\w* \w and the people|strong="H05971"\w* \w of the land|strong="H00776"\w* \w -|strong="H00413"\w* \w refused|strong="H03808"\w* \w to obey|strong="H08085"\w* \w the words|strong="H01697"\w* \w that the LORD|strong="H03068"\w* \w -|strong="H00834"\w* \w had spoken|strong="H01696"\w* \w through|strong="H03027"\w* \w Jeremiah|strong="H03414"\w* \w the prophet|strong="H05030"\w*.
\p \v 3 \w Yet King|strong="H04428"\w* \w Zedekiah|strong="H06667"\w* \w -|strong="H00853"\w* \w sent|strong="H07971"\w* \w Jehucal|strong="H03081"\w*\f + \fr 37:3 \fqa Jehucal \ft is a variant of \fqa Jucal\ft ; see Jeremiah 38:1.\f* \w son|strong="H01121"\w* \w of Shelemiah|strong="H08018"\w* \w -|strong="H00853"\w* \w and Zephaniah|strong="H06846"\w* \w the priest|strong="H03548"\w*, \w the son|strong="H01121"\w* \w of Maaseiah|strong="H04641"\w*, \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w the prophet|strong="H05030"\w* \w with the message|strong="H00559"\w*, “\w Please|strong="H04994"\w* \w pray|strong="H06419"\w* \w to|strong="H00413"\w* \w the LORD|strong="H03068"\w* \w our God|strong="H00430"\w* \w for us|strong="H01157"\w*!”
\p \v 4 \w Now Jeremiah|strong="H03414"\w* \w was free to come|strong="H00935"\w* \w and go|strong="H03318"\w* \w among|strong="H08432"\w* \w the people|strong="H05971"\w*, \w for they had not|strong="H03808"\w* \w yet put|strong="H05414"\w* \w him|strong="H00853"\w* \w in prison|strong="H01004"\w* \w . . .|strong="H03628"\w*. \v 5 \w Pharaoh’s|strong="H06547"\w* \w army|strong="H02428"\w* \w had left|strong="H03318"\w* \w Egypt|strong="H04714"\w*, \w and when the Chaldeans|strong="H03778"\w*\f + \fr 37:5 \ft That is, the Babylonians; also in verses 8, 9, 13, and 14\f* \w who were besieging|strong="H06696"\w* \w Jerusalem|strong="H03389"\w* \w -|strong="H00853"\w* \w heard|strong="H08085"\w* \w the report|strong="H08088"\w*, \w they withdrew|strong="H05927"\w* \w from|strong="H05921"\w* \w . . .|strong="H05921"\w* \w Jerusalem|strong="H03389"\w*.
\p \v 6 \w Then the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w came|strong="H01961"\w* \w to|strong="H00413"\w* \w Jeremiah|strong="H03414"\w* \w the prophet|strong="H05030"\w* \w -|strong="H00559"\w*: \v 7 “\w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w says|strong="H00559"\w* \w that|strong="H03541"\w* \w you are to tell|strong="H00559"\w* \w . . .|strong="H00413"\w* \w the king|strong="H04428"\w* \w of Judah|strong="H03063"\w*, \w who sent|strong="H07971"\w* \w you|strong="H00853"\w* \w to|strong="H01875"\w* \w Me|strong="H00413"\w*: \w Behold|strong="H02009"\w*, \w Pharaoh’s|strong="H06547"\w* \w army|strong="H02428"\w*, \w which has marched out|strong="H03318"\w* \w to help|strong="H05833"\w* you, \w will go back|strong="H07725"\w* \w to its own land|strong="H00776"\w* \w of Egypt|strong="H04714"\w*. \v 8 \w Then the Chaldeans|strong="H03778"\w* \w will return|strong="H07725"\w* \w and fight|strong="H03898"\w* \w against|strong="H05921"\w* \w this|strong="H02063"\w* \w city|strong="H05892"\w*. \w They will capture|strong="H03920"\w* \w it and burn it down|strong="H08313"\w* \w . . .|strong="H00784"\w*.
\p \v 9 \w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: \w Do not|strong="H00408"\w* \w deceive|strong="H05377"\w* \w yourselves|strong="H05315"\w* \w by saying|strong="H00559"\w*, ‘\w The Chaldeans|strong="H03778"\w* \w will go away for good|strong="H01980"\w* \w . . .|strong="H01980"\w* \w . . .|strong="H05921"\w*,’ \w for|strong="H03588"\w* \w they will not|strong="H03808"\w* \w -|strong="H01980"\w*! \v 10 \w Indeed|strong="H03588"\w*, \w if|strong="H00518"\w* \w you were to strike down|strong="H05221"\w* \w the entire|strong="H03605"\w* \w army|strong="H02428"\w* \w of the Chaldeans|strong="H03778"\w* \w that is fighting|strong="H03898"\w* \w against you|strong="H00854"\w*, \w and only wounded|strong="H01856"\w* \w men|strong="H00582"\w* \w remained|strong="H07604"\w* . . . \w vvv|strong="H00376"\w* \w in their tents|strong="H00168"\w*, \w they would still get up|strong="H06965"\w* \w and burn this|strong="H02063"\w* \w city|strong="H05892"\w* \w down|strong="H08313"\w* \w -|strong="H00853"\w* \w -|strong="H00784"\w*.”
\s1 Jeremiah Imprisoned
\p \v 11 \w -|strong="H01961"\w* \w When the Chaldean|strong="H03778"\w* \w army|strong="H02428"\w* \w withdrew|strong="H05927"\w* \w from|strong="H05921"\w* \w Jerusalem|strong="H03389"\w* \w for fear|strong="H06440"\w* \w of Pharaoh’s|strong="H06547"\w* \w army|strong="H02428"\w*, \v 12 \w Jeremiah|strong="H03414"\w* \w started to leave|strong="H03318"\w* \w Jerusalem|strong="H03389"\w* \w to go|strong="H01980"\w* \w to the land|strong="H00776"\w* \w of Benjamin|strong="H01144"\w* \w to claim his portion|strong="H02505"\w* \w there|strong="H08033"\w*\f + \fr 37:12 \ft Literally \fqa to divide from there\f* \w among|strong="H08432"\w* \w the people|strong="H05971"\w*. \v 13 \w But when he|strong="H01931"\w* \w reached|strong="H01961"\w* \w the Gate|strong="H08179"\w* \w of Benjamin|strong="H01144"\w*, \w the captain|strong="H01167"\w* \w of the guard|strong="H06488"\w* \w -|strong="H08033"\w*, \w whose name|strong="H08034"\w* \w was Irijah|strong="H03376"\w* \w son|strong="H01121"\w* \w of Shelemiah|strong="H08018"\w*, \w the son|strong="H01121"\w* \w of Hananiah|strong="H02608"\w*, \w seized|strong="H08610"\w* \w -|strong="H00853"\w* \w [him]|strong="H03414"\w* \w . . .|strong="H05030"\w* \w and said|strong="H00559"\w*, “\w You|strong="H00859"\w* \w are deserting|strong="H05307"\w* \w to|strong="H00413"\w* \w the Chaldeans|strong="H03778"\w*!”
\p \v 14 “\w That is a lie|strong="H08267"\w*,” \w Jeremiah|strong="H03414"\w* \w replied|strong="H00559"\w*. “\w I am not|strong="H00369"\w* \w deserting|strong="H05307"\w* \w to|strong="H05921"\w* \w the Chaldeans|strong="H03778"\w*!”
\p \w But Irijah|strong="H03376"\w* \w would not|strong="H03808"\w* \w listen|strong="H08085"\w* \w to him|strong="H00413"\w*; \w instead, he arrested|strong="H08610"\w* \w Jeremiah|strong="H03414"\w* \w and took him|strong="H00935"\w* \w to|strong="H00413"\w* \w the officials|strong="H08269"\w*.
