\p \v 36 \w Your servant|strong="H05650"\w* \w -|strong="H00853"\w* \w will go with|strong="H00854"\w* \w the king|strong="H04428"\w* \w only a short distance|strong="H04592"\w* \w past|strong="H05674"\w* \w the Jordan|strong="H03383"\w*; \w why|strong="H04100"\w* \w should the king|strong="H04428"\w* \w repay me|strong="H01580"\w* \w with such|strong="H02063"\w* \w a reward|strong="H01578"\w*? \v 37 \w Please|strong="H04994"\w* \w let your servant|strong="H05650"\w* \w return|strong="H07725"\w*, \w that I may die|strong="H04191"\w* \w in my own city|strong="H05892"\w* \w near|strong="H05973"\w* \w the tomb|strong="H06913"\w* \w of my father|strong="H00001"\w* \w and mother|strong="H00517"\w*. \w But here|strong="H02009"\w* \w is your servant|strong="H05650"\w* \w Chimham|strong="H03643"\w*. \w Let him cross over|strong="H05674"\w* \w with|strong="H05973"\w* \w my lord|strong="H00113"\w* \w the king|strong="H04428"\w*, \w and do|strong="H06213"\w* for him \w -|strong="H00853"\w* \w what|strong="H00834"\w* \w is good|strong="H02895"\w* \w in your sight|strong="H05869"\w*.”
