\p \v 2 \w So all|strong="H03605"\w* \w the men|strong="H00376"\w* \w of Israel|strong="H03478"\w* \w deserted|strong="H05927"\w* \w . . .|strong="H00310"\w* \w David|strong="H01732"\w* \w to follow|strong="H00310"\w* \w Sheba|strong="H07652"\w* \w son|strong="H01121"\w* \w of Bichri|strong="H01075"\w*. \w But the men|strong="H00376"\w* \w of Judah|strong="H03063"\w* \w stayed by|strong="H01692"\w* \w their king|strong="H04428"\w* \w all the way|strong="H05704"\w* \w from|strong="H04480"\w* \w the Jordan|strong="H03383"\w* \w to Jerusalem|strong="H03389"\w*.
