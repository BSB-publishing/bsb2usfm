\s1 David and Bathsheba
\p \v 1 \w -|strong="H01961"\w* \w In the spring|strong="H08666"\w* \w . . .|strong="H08141"\w*,\f + \fr 11:1 \ft Literally \fqa At the turn of the year\f* \w at the time when|strong="H06256"\w* \w kings|strong="H04397"\w* \w march out to war|strong="H03318"\w*, \w David|strong="H01732"\w* \w -|strong="H00853"\w* \w sent out|strong="H07971"\w* \w Joab|strong="H03097"\w* \w and|strong="H00853"\w* \w his servants|strong="H05650"\w* \w . . .|strong="H05973"\w* \w with|strong="H00853"\w* \w the whole [army]|strong="H03605"\w* \w of Israel|strong="H03478"\w*. \w They destroyed|strong="H07843"\w* \w -|strong="H00853"\w* \w the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w* \w and besieged|strong="H06696"\w* \w . . .|strong="H05921"\w* \w Rabbah|strong="H07237"\w*, \w but David|strong="H01732"\w* \w remained|strong="H03427"\w* \w in Jerusalem|strong="H03389"\w*.
\p \v 2 \w -|strong="H01961"\w* \w -|strong="H06256"\w* \w One evening|strong="H06153"\w* \w David|strong="H01732"\w* \w got up|strong="H06965"\w* \w from|strong="H05921"\w* \w his bed|strong="H04904"\w* \w and strolled around|strong="H01980"\w* \w on|strong="H05921"\w* \w the roof|strong="H01406"\w* \w of the palace|strong="H01004"\w* \w . . .|strong="H04428"\w*. \w And from|strong="H05921"\w* \w the roof|strong="H01406"\w* \w he saw|strong="H07200"\w* \w a woman|strong="H00802"\w* \w bathing|strong="H07364"\w*— \w a very|strong="H03966"\w* \w beautiful|strong="H02896"\w* \w . . .|strong="H04758"\w* \w woman|strong="H00802"\w*. \v 3 \w So David|strong="H01732"\w* \w sent|strong="H07971"\w* \w and inquired|strong="H01875"\w* \w about the woman|strong="H00802"\w*, \w and he was told|strong="H00559"\w*, \w . . .|strong="H03808"\w* “\w This|strong="H02063"\w* \w vvv|strong="H01339"\w* \w is Bathsheba|strong="H01339"\w*, \w the daughter|strong="H01323"\w* \w of Eliam|strong="H00463"\w*\f + \fr 11:3 \fqa Eliam \ft is a variant of \fqa Ammiel\ft ; see 1 Chronicles 3:5.\f* \w and the wife|strong="H00802"\w* \w of Uriah|strong="H00223"\w* \w the Hittite|strong="H02850"\w*.”
\p \v 4 \w Then David|strong="H01732"\w* \w sent|strong="H07971"\w* \w messengers|strong="H04397"\w* \w to get her|strong="H03947"\w*, \w and when she came|strong="H00935"\w* \w to him|strong="H00413"\w*, \w he slept|strong="H07901"\w* \w with her|strong="H05973"\w*. (\w Now she|strong="H01931"\w* \w had just purified herself|strong="H06942"\w* \w from her uncleanness|strong="H02932"\w*.) \w Then she returned|strong="H07725"\w* \w . . .|strong="H00413"\w* \w home|strong="H01004"\w*. \v 5 \w And the woman|strong="H00802"\w* \w conceived|strong="H02029"\w* \w and sent word|strong="H07971"\w* \w . . .|strong="H05046"\w* \w to David|strong="H01732"\w*, \w saying|strong="H00559"\w*, “\w I|strong="H00595"\w* \w am pregnant|strong="H02030"\w*.”
\p \v 6 \w At this, David|strong="H01732"\w* \w sent orders|strong="H07971"\w* \w to|strong="H00413"\w* \w Joab|strong="H03097"\w*: “\w Send|strong="H07971"\w* \w me|strong="H00413"\w* \w -|strong="H00853"\w* \w Uriah|strong="H00223"\w* \w the Hittite|strong="H02850"\w*.” \w So Joab|strong="H03097"\w* \w -|strong="H00853"\w* \w sent|strong="H07971"\w* \w [him]|strong="H00223"\w* \w to|strong="H00413"\w* \w David|strong="H01732"\w*.
