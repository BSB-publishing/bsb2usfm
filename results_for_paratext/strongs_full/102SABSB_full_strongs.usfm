\s1 Absalom’s Revenge on Amnon
\p \v 23 \w Two years later|strong="H08141"\w* \w . . .|strong="H03117"\w*, \w . . .|strong="H01961"\w* \w when Absalom’s|strong="H00053"\w* \w vvv|strong="H01178"\w* \w sheepshearers|strong="H01494"\w* \w were|strong="H01961"\w* \w at Baal-hazor|strong="H01178"\w* \w -|strong="H00834"\w* \w near|strong="H05973"\w* \w Ephraim|strong="H00669"\w*, \w [he]|strong="H00053"\w* \w invited|strong="H07121"\w* \w all|strong="H03605"\w* \w the sons|strong="H01121"\w* \w of the king|strong="H04428"\w*. \v 24 \w And he|strong="H00053"\w* \w went|strong="H00935"\w* \w to|strong="H00413"\w* \w the king|strong="H04428"\w* \w and said|strong="H00559"\w*, “\w Your servant|strong="H05650"\w* \w has just|strong="H02009"\w*\w . . .|strong="H04994"\w* \w hired shearers|strong="H01494"\w*. \w Will the king|strong="H04428"\w* \w and his servants|strong="H05650"\w* \w please|strong="H04994"\w* \w come|strong="H01980"\w* \w with|strong="H05973"\w* \w [me]|strong="H05650"\w*?”
\p \v 25 “\w No|strong="H00408"\w*, \w my son|strong="H01121"\w*,” \w the king|strong="H04428"\w* \w replied|strong="H00559"\w* \w -|strong="H00413"\w* \w -|strong="H00053"\w*, “\w we should not|strong="H00408"\w* \w . . .|strong="H04994"\w* \w all|strong="H03605"\w* \w go|strong="H01980"\w*, \w or|strong="H03808"\w* \w we would be a burden|strong="H03513"\w* \w to you|strong="H05921"\w*.” \w Although Absalom urged|strong="H06555"\w* him, \w he was not|strong="H03808"\w* \w willing|strong="H00014"\w* \w to go|strong="H01980"\w*, \w but gave him his blessing|strong="H01288"\w*.
\p \v 26 “\w If not|strong="H03808"\w*,” \w said|strong="H00559"\w* \w Absalom|strong="H00053"\w*, “\w please|strong="H04994"\w* \w let my brother|strong="H00251"\w* \w Amnon|strong="H00550"\w* \w go|strong="H01980"\w* \w with us|strong="H00854"\w*.”
\p “\w Why|strong="H04100"\w* \w should he go|strong="H01980"\w* \w with you|strong="H05973"\w*?” \w the king|strong="H04428"\w* \w asked|strong="H00559"\w*.
\p \v 27 \w But Absalom|strong="H00053"\w* \w urged|strong="H06555"\w* him, \w so [the king] sent|strong="H07971"\w* \w . . .|strong="H00854"\w* \w -|strong="H00853"\w* \w Amnon|strong="H00550"\w* \w -|strong="H00853"\w* \w and the rest|strong="H03605"\w* \w of [his]|strong="H04428"\w* \w sons|strong="H01121"\w*.\f + \fr 13:27 \ft LXX and Vulgate include \fqa And Absalom prepared a feast fit for a king.\f*
\p \v 28 \w Now Absalom|strong="H00053"\w* \w -|strong="H00853"\w* \w had ordered|strong="H06680"\w* \w his young men|strong="H05288"\w*\w . . .|strong="H00559"\w*, “\w Watch|strong="H07200"\w* \w Amnon|strong="H00550"\w* \w until|strong="H04994"\w* \w his heart|strong="H03820"\w* \w is merry|strong="H02895"\w* \w with wine|strong="H03196"\w*, \w and when I order|strong="H00559"\w* \w you|strong="H00413"\w* \w to strike|strong="H05221"\w* \w -|strong="H00853"\w* \w Amnon {down}|strong="H00550"\w*, \w you are to kill him|strong="H04191"\w*. \w -|strong="H00853"\w* \w Do not|strong="H00408"\w* \w be afraid|strong="H03372"\w*. \w Have|strong="H03588"\w* \w I|strong="H00595"\w* \w not|strong="H03808"\w* \w commanded|strong="H06680"\w* \w you|strong="H00853"\w*? \w Be courageous|strong="H02388"\w* \w and|strong="H01961"\w*\w . . .|strong="H01121"\w* \w valiant|strong="H02428"\w*!”
\p \v 29 \w So Absalom’s|strong="H00053"\w* \w young men|strong="H05288"\w* \w did|strong="H06213"\w* \w to Amnon|strong="H00550"\w* \w just as|strong="H00834"\w* \w Absalom|strong="H00053"\w* \w had ordered|strong="H06680"\w*. \w Then all [the other]|strong="H03605"\w* \w sons|strong="H01121"\w* \w of the king|strong="H04428"\w* \w . . .|strong="H07392"\w* \w got up|strong="H06965"\w*, \w and each one|strong="H00376"\w* \w fled|strong="H05127"\w* \w on|strong="H05921"\w* \w his mule|strong="H06505"\w*.
\p \v 30 \w While they|strong="H01992"\w* \w were|strong="H01961"\w* \w on the way|strong="H01870"\w*, \w a report|strong="H08052"\w* \w reached|strong="H00935"\w* \w . . .|strong="H00413"\w* \w David|strong="H01732"\w*: \w . . .|strong="H00559"\w* “\w Absalom|strong="H00053"\w* \w -|strong="H00853"\w* \w has struck down|strong="H05221"\w* \w all|strong="H03605"\w* \w the sons|strong="H01121"\w* \w of the king|strong="H04428"\w*; \w not|strong="H03808"\w* \w one|strong="H00259"\w* of them \w is left|strong="H03498"\w*!”
\p \v 31 \w Then the king|strong="H04428"\w* \w stood up|strong="H06965"\w*, \w tore|strong="H07167"\w* \w -|strong="H00853"\w* \w his clothes|strong="H00899"\w*, \w and lay down|strong="H07901"\w* \w on the ground|strong="H00776"\w*. \w And all|strong="H03605"\w* \w his servants|strong="H05650"\w* \w stood|strong="H05324"\w* \w by with their clothes|strong="H00899"\w* \w torn|strong="H07167"\w*.
\p \v 32 \w But Jonadab|strong="H03122"\w*, \w the son|strong="H01121"\w* \w of David’s|strong="H01732"\w* \w brother|strong="H00251"\w* \w Shimeah|strong="H08093"\w*, \w spoke up|strong="H06030"\w*: “\w My lord|strong="H00113"\w* \w -|strong="H00853"\w* \w must not|strong="H00408"\w* \w . . .|strong="H00559"\w* \w think|strong="H00559"\w* \w they have killed|strong="H04191"\w* \w all|strong="H03605"\w* \w -|strong="H05288"\w* \w the sons|strong="H01121"\w* \w of the king|strong="H04428"\w*, \w for|strong="H03588"\w* \w only|strong="H00905"\w* \w Amnon|strong="H00550"\w* \w is dead|strong="H04191"\w*. \w In fact|strong="H03588"\w*, \w Absalom|strong="H00053"\w*\w . . .|strong="H05921"\w* \w -|strong="H06310"\w* \w -|strong="H01961"\w* \w has planned this|strong="H07760"\w* \w since the day|strong="H03117"\w* \w Amnon violated|strong="H06031"\w* \w -|strong="H00853"\w* \w his sister|strong="H00269"\w* \w Tamar|strong="H08559"\w*. \v 33 \w So now|strong="H06258"\w*, \w my lord|strong="H00113"\w* \w the king|strong="H04428"\w*, \w do not|strong="H00408"\w* \w take|strong="H07760"\w* \w to|strong="H00413"\w* \w heart|strong="H03820"\w* \w the report that|strong="H01697"\w* \w . . .|strong="H00559"\w* \w all|strong="H03605"\w* \w the sons|strong="H01121"\w* \w of the king|strong="H04428"\w* \w are dead|strong="H04191"\w*. \w . . .|strong="H03588"\w* \w . . .|strong="H00518"\w* \w Only|strong="H00905"\w* \w Amnon|strong="H00550"\w* \w is dead|strong="H04191"\w*.”
\s1 Absalom Flees to Geshur
\p \v 34 \w Meanwhile, Absalom|strong="H00053"\w* \w had fled|strong="H01272"\w*. \w When the young man|strong="H05288"\w* \w standing watch|strong="H06822"\w* \w -|strong="H00853"\w* \w looked up|strong="H05375"\w* \w . . .|strong="H05869"\w*, \w he saw|strong="H07200"\w* \w -|strong="H02009"\w* \w many|strong="H07227"\w* \w people|strong="H05971"\w* \w coming|strong="H01980"\w* \w down the road|strong="H01870"\w* \w west of him|strong="H00310"\w*,\f + \fr 13:34 \ft Or \fqa behind him\f* \w along the side|strong="H06654"\w* \w of the hill. And the watchman went and reported to the king, “I see men coming from the direction of Horonaim, along the side of the hill|strong="H02022"\w*.”\f + \fr 13:34 \ft LXX; Hebrew does not include \fqa And the watchman...\ft .\f*
