\c 20
\s1 Sheba’s Rebellion
\p \v 1 \w Now a worthless|strong="H01100"\w* \w man|strong="H00376"\w* \w named|strong="H08034"\w* \w Sheba|strong="H07652"\w* \w son|strong="H01121"\w* \w of Bichri|strong="H01075"\w*, \w vvv|strong="H00376"\w* \w a Benjamite|strong="H03228"\w*, \w happened|strong="H07122"\w* \w to be there|strong="H08033"\w*, \w and he blew|strong="H08628"\w* \w the ram’s horn|strong="H07782"\w* \w and shouted|strong="H00559"\w*:
