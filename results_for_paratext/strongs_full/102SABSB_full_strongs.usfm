\c 14
\s1 Absalom’s Return to Jerusalem
\p \v 1 \w Now Joab|strong="H03097"\w* \w son|strong="H01121"\w* \w of Zeruiah|strong="H06870"\w* \w perceived|strong="H03045"\w* \w that|strong="H03588"\w* \w the king’s|strong="H04428"\w* \w heart|strong="H03820"\w* \w longed for|strong="H05921"\w* \w Absalom|strong="H00053"\w*. \v 2 \w So Joab|strong="H03097"\w* \w sent|strong="H07971"\w* \w to Tekoa|strong="H08620"\w* \w to bring|strong="H03947"\w* \w a wise|strong="H02450"\w* \w woman|strong="H00802"\w* \w from there|strong="H08033"\w*. \w He told her|strong="H00559"\w*, \w . . .|strong="H00413"\w* “\w Please|strong="H04994"\w* \w pretend to be a mourner|strong="H00056"\w*; \w put on|strong="H03847"\w* \w . . .|strong="H04994"\w* \w clothes|strong="H00899"\w* \w for mourning|strong="H00060"\w* \w and do not|strong="H00408"\w* \w anoint yourself|strong="H05480"\w* \w with oil|strong="H08081"\w*. \w Act|strong="H01961"\w* \w like a woman|strong="H00802"\w* \w . . .|strong="H02088"\w* \w who has mourned|strong="H00056"\w* \w for|strong="H05921"\w* \w the dead|strong="H04191"\w* \w a long|strong="H07227"\w* \w time|strong="H03117"\w*. \v 3 \w Then go|strong="H00935"\w* \w to|strong="H00413"\w* \w the king|strong="H04428"\w* \w and speak|strong="H01696"\w* \w these|strong="H02088"\w* \w words|strong="H01697"\w* \w to him|strong="H00413"\w*.” \w And Joab|strong="H03097"\w* \w -|strong="H00853"\w* \w put|strong="H07760"\w* \w the words|strong="H01697"\w* \w in her mouth|strong="H06310"\w*.
