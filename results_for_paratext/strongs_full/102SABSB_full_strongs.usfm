\p \v 7 \w After|strong="H07093"\w* \w four|strong="H00705"\w*\f + \fr 15:7 \ft Syriac and some LXX manuscripts; Hebrew \fqa forty\f* \w years|strong="H08141"\w* \w had passed|strong="H01961"\w*, \w Absalom|strong="H00053"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w the king|strong="H04428"\w*, “\w Please|strong="H04994"\w* \w let me go|strong="H01980"\w* \w to Hebron|strong="H02275"\w* \w to fulfill|strong="H07999"\w* \w -|strong="H00853"\w* \w a vow|strong="H05088"\w* \w -|strong="H00834"\w* \w I have made|strong="H05087"\w* \w to the LORD|strong="H03068"\w*. \v 8 \w For|strong="H03588"\w* \w your servant|strong="H05650"\w* \w made|strong="H05087"\w* \w a vow|strong="H05088"\w* \w while dwelling|strong="H03427"\w* \w in Geshur|strong="H01650"\w* \w of Aram|strong="H00758"\w*, \w saying|strong="H00559"\w*: ‘\w If|strong="H00518"\w* \w indeed|strong="H07725"\w* \w the LORD|strong="H03068"\w* \w brings me back|strong="H07725"\w* \w to Jerusalem|strong="H03389"\w*, \w I will worship|strong="H05647"\w* \w -|strong="H00853"\w* \w the LORD [in Hebron]|strong="H03068"\w*.’\f + \fr 15:8 \ft Some LXX manuscripts; Hebrew does not include \fqa in Hebron\ft .\f*”
\p \v 9 “\w Go|strong="H01980"\w* \w in peace|strong="H07965"\w*,” \w said|strong="H00559"\w* \w the king|strong="H04428"\w*. \w So [Absalom] got up|strong="H06965"\w* \w and went|strong="H01980"\w* \w to Hebron|strong="H02275"\w*.
