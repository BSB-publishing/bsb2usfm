\c 18
\s1 Absalom Killed
\p \v 1 \w Then David|strong="H01732"\w* \w -|strong="H00853"\w* \w reviewed|strong="H06485"\w* \w his troops|strong="H05971"\w* \w -|strong="H00834"\w* \w -|strong="H00854"\w* \w and appointed|strong="H07760"\w* \w over them|strong="H05921"\w* \w commanders|strong="H08269"\w* \w of thousands|strong="H00505"\w* \w and of hundreds|strong="H03967"\w* \w . . .|strong="H08269"\w*. \v 2 \w He|strong="H01732"\w* \w -|strong="H00853"\w* \w sent out|strong="H07971"\w* \w the troops|strong="H05971"\w*, \w a third|strong="H07992"\w* \w . . .|strong="H03027"\w* \w under Joab|strong="H03097"\w*, \w a third|strong="H07992"\w* \w . . .|strong="H03027"\w* \w under Joab’s|strong="H03097"\w* \w brother|strong="H00251"\w* \w Abishai|strong="H00052"\w* \w son|strong="H01121"\w* \w of Zeruiah|strong="H06870"\w*, \w and a third|strong="H07992"\w* \w . . .|strong="H03027"\w* \w under Ittai|strong="H00863"\w* \w the Gittite|strong="H01663"\w*. \w And the king|strong="H04428"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w the troops|strong="H05971"\w*, “\w I|strong="H00589"\w* \w will surely march out|strong="H03318"\w* \w . . .|strong="H03318"\w* \w with you|strong="H05973"\w* \w as well|strong="H01571"\w*.”
\p \v 3 \w But the people|strong="H05971"\w* \w pleaded|strong="H00559"\w*, “\w You must not|strong="H03808"\w* \w go out|strong="H03318"\w*! \w For|strong="H03588"\w* \w if|strong="H00518"\w* \w we have to flee|strong="H05127"\w* \w . . .|strong="H05127"\w*, \w vvv|strong="H03808"\w* \w they will not care|strong="H07760"\w* \w . . .|strong="H03820"\w* \w about us|strong="H00413"\w*. \w Even if|strong="H00518"\w* \w half of us|strong="H02677"\w* \w die|strong="H04191"\w*, \w they will not|strong="H03808"\w* \w care|strong="H07760"\w* \w . . .|strong="H03820"\w* \w -|strong="H00413"\w*. \w But|strong="H03588"\w* \w -|strong="H06258"\w* \w [you are] worth|strong="H03644"\w* \w ten|strong="H06235"\w* \w thousand of us|strong="H00505"\w*.\f + \fr 18:3 \ft Two Hebrew manuscripts, some LXX manuscripts, and Vulgate; most Hebrew manuscripts \fqa care; for now there are ten thousand like us\f* \w It is better|strong="H02896"\w* \w now|strong="H06258"\w* \w if|strong="H03588"\w* \w you|strong="H01961"\w* \w support|strong="H05826"\w* us \w from the city|strong="H05892"\w*.”
\p \v 4 “\w I will do|strong="H06213"\w* \w whatever|strong="H00834"\w* \w seems best|strong="H03190"\w* \w to you|strong="H05869"\w*,” \w the king|strong="H04428"\w* \w replied|strong="H00559"\w* \w -|strong="H00413"\w*. \w So he|strong="H04428"\w* \w stood|strong="H05975"\w* \w beside|strong="H00413"\w* \w . . .|strong="H03027"\w* \w the gate|strong="H08179"\w*, \w while all|strong="H03605"\w* \w the troops|strong="H05971"\w* \w marched out|strong="H03318"\w* \w by hundreds|strong="H03967"\w* \w and by thousands|strong="H00505"\w*.
\p \v 5 \w Now the king|strong="H04428"\w* \w -|strong="H00853"\w* \w had commanded|strong="H06680"\w* \w Joab|strong="H03097"\w*, \w -|strong="H00853"\w* \w Abishai|strong="H00052"\w*, \w -|strong="H00853"\w* \w and Ittai|strong="H00863"\w*, \w . . .|strong="H00559"\w* “\w Treat the young man|strong="H05288"\w* \w Absalom|strong="H00053"\w* \w gently|strong="H00328"\w* for my sake.” \w And all|strong="H03605"\w* \w the people|strong="H05971"\w* \w heard|strong="H08085"\w* \w the king’s|strong="H04428"\w* \w -|strong="H00853"\w* \w orders|strong="H06680"\w* \w to each|strong="H03605"\w* \w of the commanders|strong="H08269"\w* \w regarding|strong="H05921"\w* \w . . .|strong="H01697"\w* \w Absalom|strong="H00053"\w*.
\p \v 6 \w So David’s army|strong="H05971"\w* \w marched|strong="H03318"\w* \w into the field|strong="H07704"\w* \w to engage|strong="H07122"\w* \w Israel|strong="H03478"\w*, \w and the battle|strong="H04421"\w* \w took place|strong="H01961"\w* \w in the forest|strong="H03293"\w* \w of Ephraim|strong="H00669"\w*. \v 7 \w There|strong="H08033"\w* \w the people|strong="H05971"\w* \w of Israel|strong="H03478"\w* \w were defeated|strong="H05062"\w* \w by|strong="H06440"\w* \w David’s|strong="H01732"\w* \w servants|strong="H05650"\w*, \w and the slaughter|strong="H04046"\w* \w was|strong="H01961"\w* \w . . .|strong="H08033"\w* \w great|strong="H01419"\w* \w that|strong="H01931"\w* \w day|strong="H03117"\w*— \w twenty|strong="H06242"\w* \w thousand [men]|strong="H00505"\w*. \v 8 \w -|strong="H01961"\w* \w -|strong="H08033"\w* \w The battle|strong="H04421"\w* \w spread|strong="H06327"\w* \w over|strong="H05921"\w* \w . . .|strong="H06440"\w* \w the whole|strong="H03605"\w* \w countryside|strong="H00776"\w*, \w and that|strong="H01931"\w* \w day|strong="H03117"\w* \w the forest|strong="H03293"\w* \w devoured|strong="H00398"\w* \w more|strong="H07235"\w* \w people|strong="H05971"\w* \w than|strong="H00834"\w* \w . . .|strong="H00398"\w* \w the sword|strong="H02719"\w*.
\p \v 9 \w Now Absalom|strong="H00053"\w* \w . . .|strong="H06440"\w* \w was riding|strong="H07392"\w* \w on|strong="H05921"\w* \w his mule|strong="H06505"\w* \w when he|strong="H00053"\w* \w met|strong="H07122"\w* \w the servants|strong="H05650"\w* \w of David|strong="H01732"\w*, \w and as the mule|strong="H06505"\w* \w went|strong="H00935"\w* \w under|strong="H08478"\w* \w the thick branches|strong="H07730"\w* \w of a large|strong="H01419"\w* \w oak|strong="H00424"\w*,\f + \fr 18:9 \ft Or \fqa large terebinth \ft or \fqa very great tree\ft ; similarly in verses 10 and 14\f* \w Absalom’s head|strong="H07218"\w* \w was caught fast|strong="H02388"\w* \w in the tree|strong="H00424"\w*. \w The mule|strong="H06505"\w* \w -|strong="H00834"\w* \w under him|strong="H08478"\w* \w kept going|strong="H05674"\w*, \w so that he was suspended|strong="H05414"\w* \w in midair|strong="H00996"\w* \w . . .|strong="H08064"\w* \w . . .|strong="H00996"\w* \w . . .|strong="H00776"\w*. \v 10 \w When one|strong="H00259"\w* \w of the men|strong="H00376"\w* \w saw this|strong="H07200"\w*, \w he told|strong="H05046"\w* \w Joab|strong="H03097"\w* \w -|strong="H00559"\w*, “\w I just|strong="H02009"\w* \w saw|strong="H07200"\w* \w -|strong="H00853"\w* \w Absalom|strong="H00053"\w* \w hanging|strong="H08518"\w* \w in an oak tree|strong="H00424"\w*!”
\p \v 11 “\w You just|strong="H02009"\w* \w saw him|strong="H07200"\w*!” \w Joab|strong="H03097"\w* \w -|strong="H00376"\w* \w -|strong="H05046"\w* - \w exclaimed|strong="H00559"\w*. “\w Why|strong="H04069"\w* \w did you not|strong="H03808"\w* \w strike him|strong="H05221"\w* \w to the ground|strong="H00776"\w* \w . . .|strong="H05921"\w* \w right there|strong="H08033"\w*? \w I would have given|strong="H05414"\w* you \w ten [shekels]|strong="H06235"\w* \w of silver|strong="H03701"\w*\f + \fr 18:11 \fqa 10 shekels \ft is approximately 4 ounces or 114 grams of silver.\f* \w and a|strong="H00259"\w* \w warrior’s belt|strong="H02290"\w*!”
\p \v 12 \w The man|strong="H00376"\w* \w replied|strong="H00559"\w* \w -|strong="H00413"\w* \w -|strong="H03097"\w*, “\w Even if|strong="H03863"\w* \w -|strong="H00595"\w* \w a thousand [shekels]|strong="H00505"\w* \w of silver|strong="H03701"\w*\f + \fr 18:12 \fqa 1,000 shekels \ft is approximately 25.1 pounds or 11.4 kilograms of silver.\f* \w were weighed out|strong="H08254"\w* \w into|strong="H05921"\w* \w my hands|strong="H03709"\w*, \w I would not|strong="H03808"\w* \w raise|strong="H07971"\w* \w my hand|strong="H03027"\w* \w against|strong="H00413"\w* \w the son|strong="H01121"\w* \w of the king|strong="H04428"\w*. \w For|strong="H03588"\w* \w we heard|strong="H00241"\w* \w the king|strong="H04428"\w* \w -|strong="H00853"\w* \w -|strong="H00853"\w* \w command you|strong="H06680"\w* \w and Abishai|strong="H00052"\w* \w -|strong="H00853"\w* \w and Ittai|strong="H00863"\w*, \w . . .|strong="H00559"\w* ‘\w Protect|strong="H08104"\w* \w the young man|strong="H05288"\w* \w Absalom|strong="H00053"\w* \w [for my sake]|strong="H04310"\w*.\f + \fr 18:12 \ft A few Hebrew manuscripts, LXX, Vulgate, and Syriac; most Hebrew manuscripts \fqa Whoever you may be, protect the young man Absalom. \ft or \fqa Let no one touch the young man Absalom.\f*’ \v 13 \w If|strong="H00176"\w* \w I had jeopardized|strong="H06213"\w* \w . . .|strong="H08267"\w* \w . . .|strong="H03605"\w* \w . . .|strong="H01697"\w* \w my own life|strong="H05315"\w*\f + \fr 18:13 \ft Or \fqa If I had dealt treacherously against his life\f*— \w and nothing|strong="H03808"\w* \w is hidden|strong="H03582"\w* \w from|strong="H04480"\w* \w the king|strong="H04428"\w*— \w you|strong="H00859"\w* \w would have abandoned|strong="H03320"\w* \w me|strong="H05048"\w*.”
\p \v 14 \w But Joab|strong="H03097"\w* \w declared|strong="H00559"\w*, “\w I am not|strong="H03808"\w* \w going to wait|strong="H03176"\w* \w like this|strong="H03651"\w* \w with you|strong="H06440"\w*!” \w And he took|strong="H03947"\w* \w three|strong="H07969"\w* \w spears|strong="H07626"\w* \w in his hand|strong="H03709"\w* \w and thrust them|strong="H08628"\w* \w through the heart|strong="H03820"\w* \w of Absalom|strong="H00053"\w* \w while he was still|strong="H05750"\w* \w alive|strong="H02416"\w* \w . . .|strong="H03820"\w* \w in the oak tree|strong="H00424"\w*. \v 15 \w And ten|strong="H06235"\w* \w young men|strong="H05288"\w* \w who carried|strong="H05375"\w* \w Joab’s|strong="H03097"\w* \w armor|strong="H03627"\w* \w surrounded|strong="H05437"\w* \w Absalom|strong="H00053"\w*, \w struck|strong="H05221"\w* \w him|strong="H00853"\w*, \w and killed him|strong="H04191"\w*.
\p \v 16 \w Then Joab|strong="H03097"\w* \w blew|strong="H08628"\w* \w the ram’s horn|strong="H07782"\w*, \w and the troops|strong="H05971"\w* \w broke off|strong="H07725"\w* \w their pursuit|strong="H07291"\w* \w . . .|strong="H00310"\w* \w of Israel|strong="H03478"\w* \w because|strong="H03588"\w* \w Joab|strong="H03097"\w* \w -|strong="H00853"\w* \w had restrained them|strong="H02820"\w* \w . . .|strong="H05971"\w*. \v 17 \w They took|strong="H03947"\w* \w -|strong="H00853"\w* \w Absalom|strong="H00053"\w*, \w cast|strong="H07993"\w* \w him|strong="H00853"\w* \w into|strong="H00413"\w* \w a large|strong="H01419"\w* \w pit|strong="H06354"\w* \w in the forest|strong="H03293"\w*, \w and piled|strong="H05324"\w* \w a huge|strong="H01419"\w* \w . . .|strong="H03966"\w* \w mound|strong="H01530"\w* \w of stones|strong="H00068"\w* \w over him|strong="H05921"\w*. \w Meanwhile, all|strong="H03605"\w* \w the Israelites|strong="H03478"\w* \w fled|strong="H05127"\w*, \w each|strong="H00376"\w* \w to his home|strong="H00168"\w*.
\p \v 18 \w During his lifetime|strong="H02416"\w* \w -|strong="H00853"\w*, \w Absalom|strong="H00053"\w* \w . . .|strong="H03947"\w* \w had set up|strong="H05324"\w* for himself \w a pillar|strong="H04678"\w* \w -|strong="H00834"\w* \w in the King’s|strong="H04428"\w* \w Valley|strong="H06010"\w*, \w for|strong="H03588"\w* \w he had said|strong="H00559"\w*, “\w I have no|strong="H00369"\w* . . . \w son|strong="H01121"\w* \w to|strong="H05668"\w* \w preserve the memory|strong="H02142"\w* \w of my name|strong="H08034"\w*.” \w So he gave|strong="H07121"\w* \w the pillar|strong="H04678"\w* \w . . .|strong="H05921"\w* \w his name|strong="H08034"\w*, \w and to|strong="H05704"\w* \w this|strong="H02088"\w* \w day|strong="H03117"\w* \w it is called|strong="H07121"\w* . . . \w Absalom’s|strong="H00053"\w* \w Monument|strong="H03027"\w*.
\s1 David Mourns for Absalom
\p \v 19 \w Then Ahimaaz|strong="H00290"\w* \w son|strong="H01121"\w* \w of Zadok|strong="H06659"\w* \w said|strong="H00559"\w*, “\w Please|strong="H04994"\w* \w let me run|strong="H07323"\w* \w and tell the king|strong="H04428"\w* \w the good news|strong="H01319"\w* \w -|strong="H00853"\w* \w that|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w has avenged him|strong="H08199"\w* \w of|strong="H03027"\w* \w his enemies|strong="H00341"\w*.”
\p \v 20 \w But Joab|strong="H03097"\w* \w replied|strong="H00559"\w*, “\w You|strong="H00859"\w* \w are not|strong="H03808"\w* \w the man|strong="H00376"\w* \w to take good news|strong="H01309"\w* \w today|strong="H03117"\w* \w . . .|strong="H02088"\w*. \w You may do|strong="H01319"\w* \w it another|strong="H00312"\w* \w day|strong="H03117"\w*, \w but you must not|strong="H03808"\w* \w [do so]|strong="H01319"\w* \w today|strong="H03117"\w* \w . . .|strong="H02088"\w*, \w because|strong="H03588"\w* \w . . .|strong="H05921"\w* \w the king’s|strong="H04428"\w* \w son|strong="H01121"\w* \w is dead|strong="H04191"\w*.”
\p \v 21 \w So Joab|strong="H03097"\w* \w said|strong="H00559"\w* \w to a Cushite|strong="H03569"\w*, “\w Go|strong="H01980"\w*, \w tell|strong="H05046"\w* \w the king|strong="H04428"\w* \w what|strong="H00834"\w* \w you have seen|strong="H07200"\w*.” \w The Cushite|strong="H03569"\w* \w bowed|strong="H07812"\w* \w to Joab|strong="H03097"\w* \w and took off running|strong="H07323"\w*.
\p \v 22 \w Ahimaaz|strong="H00290"\w* \w son|strong="H01121"\w* \w of Zadok|strong="H06659"\w*, \w however, persisted|strong="H03254"\w* \w . . .|strong="H05750"\w* \w and said|strong="H00559"\w* \w to|strong="H00413"\w* \w Joab|strong="H03097"\w*, \w . . .|strong="H01961"\w* “\w No matter what|strong="H04100"\w*, \w please|strong="H04994"\w* \w let me|strong="H00589"\w* \w also|strong="H01571"\w* \w run|strong="H07323"\w* \w behind|strong="H00310"\w* \w the Cushite|strong="H03569"\w*!”
\p “\w My son|strong="H01121"\w*,” \w Joab|strong="H03097"\w* \w replied|strong="H00559"\w*, “\w why|strong="H04100"\w* \w . . .|strong="H02088"\w* \w do you|strong="H00859"\w* \w want to run|strong="H07323"\w*, since you will \w not|strong="H00369"\w* \w receive|strong="H04672"\w* \w a reward|strong="H01309"\w*?”
\p \v 23 “\w No matter what|strong="H04100"\w*, \w I want to run|strong="H07323"\w*!” \w he replied|strong="H01961"\w*.
\p “\w Then run|strong="H07323"\w*!” \w Joab told|strong="H00559"\w* him.
\p \w So Ahimaaz|strong="H00290"\w* \w ran|strong="H07323"\w* \w by way|strong="H01870"\w* \w of the plain|strong="H03603"\w*\f + \fr 18:23 \ft That is, the plain of the Jordan\f* \w and outran|strong="H05674"\w* \w -|strong="H00853"\w* \w the Cushite|strong="H03569"\w*.
\p \v 24 \w Now David|strong="H01732"\w* \w was sitting|strong="H03427"\w* \w between|strong="H00996"\w* \w the two|strong="H08147"\w* \w gates|strong="H08179"\w* \w when the watchman|strong="H06822"\w* \w went up|strong="H01980"\w* \w to|strong="H00413"\w* \w the roof|strong="H01406"\w* \w of the gateway|strong="H08179"\w* \w by|strong="H00413"\w* \w the wall|strong="H02346"\w*, \w looked out|strong="H05375"\w*, \w -|strong="H00853"\w* \w -|strong="H05869"\w* \w and saw|strong="H07200"\w* \w . . .|strong="H02009"\w* \w a man|strong="H00376"\w* \w running alone|strong="H07323"\w* \w . . .|strong="H00905"\w*. \v 25 \w So [he]|strong="H06822"\w* \w called out|strong="H07121"\w* \w and told|strong="H05046"\w* \w the king|strong="H04428"\w*.
\p “\w If he is alone|strong="H00518"\w* \w . . .|strong="H00905"\w*,” \w the king|strong="H04428"\w* \w replied|strong="H00559"\w*, “\w he bears|strong="H06310"\w* \w good news|strong="H01309"\w*.”
\p \w As the first runner drew|strong="H01980"\w* \w . . .|strong="H01980"\w* \w near|strong="H07131"\w*, \v 26 \w the watchman|strong="H06822"\w* \w saw|strong="H07200"\w* \w another|strong="H00312"\w* \w man|strong="H00376"\w* \w running|strong="H07323"\w*, \w and he called out|strong="H07121"\w* \w . . .|strong="H06822"\w* \w to|strong="H00413"\w* \w the gatekeeper|strong="H07778"\w*,\w . . .|strong="H00559"\w* “\w Look|strong="H02009"\w*! \w Another man|strong="H00376"\w* \w is running alone|strong="H07323"\w* \w . . .|strong="H00905"\w*!”
\p “\w This [one]|strong="H02088"\w* \w also|strong="H01571"\w* \w brings good news|strong="H01319"\w*,” \w said|strong="H00559"\w* \w the king|strong="H04428"\w*.
\p \v 27 \w The watchman|strong="H06822"\w* \w said|strong="H00559"\w*, “\w The first man|strong="H07223"\w* \w appears|strong="H07200"\w* \w -|strong="H00853"\w* \w to me|strong="H00589"\w* \w to be running|strong="H04794"\w* \w like Ahimaaz|strong="H00290"\w* \w son|strong="H01121"\w* \w of Zadok|strong="H06659"\w* \w -|strong="H04794"\w*.”
\p “\w This|strong="H02088"\w* \w is a good|strong="H02896"\w* \w man|strong="H00376"\w*,” \w said|strong="H00559"\w* \w the king|strong="H04428"\w*. “\w He comes|strong="H00935"\w* \w with|strong="H00413"\w* \w good|strong="H02896"\w* \w news|strong="H01309"\w*.”
\p \v 28 \w Then Ahimaaz|strong="H00290"\w* \w called out|strong="H07121"\w*\w . . .|strong="H00559"\w* \w to|strong="H00413"\w* \w the king|strong="H04428"\w*, “\w All is well|strong="H07965"\w*!” \w And he bowed|strong="H07812"\w* \w facedown|strong="H00639"\w* \w . . .|strong="H00776"\w* \w before the king|strong="H04428"\w*.
\p \w He continued|strong="H00559"\w*, “\w Blessed [be]|strong="H01288"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*! \w -|strong="H00834"\w* \w He has delivered up|strong="H05462"\w* \w -|strong="H00853"\w* \w the men|strong="H00582"\w* \w who|strong="H00834"\w* \w raised|strong="H05375"\w* \w -|strong="H00853"\w* \w their hands|strong="H03027"\w* \w against my lord|strong="H00113"\w* \w the king|strong="H04428"\w*.”
\p \v 29 \w The king|strong="H04428"\w* \w asked|strong="H00559"\w*, “\w Is the young man|strong="H05288"\w* \w Absalom|strong="H00053"\w* \w all right|strong="H07965"\w*?”
\p \w And Ahimaaz|strong="H00290"\w* \w replied|strong="H00559"\w*, “\w When Joab|strong="H03097"\w* \w -|strong="H00853"\w* \w sent|strong="H07971"\w* \w -|strong="H00853"\w* \w the king’s|strong="H04428"\w* \w servant|strong="H05650"\w* \w and your servant|strong="H05650"\w*, \w I saw|strong="H07200"\w* \w a great|strong="H01419"\w* \w tumult|strong="H01995"\w*, \w but I do not|strong="H03808"\w* \w know|strong="H03045"\w* \w what it was|strong="H04100"\w*.”
\p \v 30 “\w Move aside|strong="H05437"\w*,” \w said|strong="H00559"\w* \w the king|strong="H04428"\w*, “\w and stand|strong="H03320"\w* \w here|strong="H03541"\w*.”
\p \w So he stepped|strong="H05975"\w* \w aside|strong="H05437"\w*.
\p \v 31 \w Just then|strong="H02009"\w* \w the Cushite|strong="H03569"\w* \w came|strong="H00935"\w* \w and said|strong="H00559"\w* \w . . .|strong="H03569"\w*, “\w May my lord|strong="H00113"\w* \w the king|strong="H04428"\w* \w . . .|strong="H03588"\w* \w hear the good news|strong="H01319"\w*: \w Today|strong="H03117"\w* \w the LORD|strong="H03068"\w* \w has avenged you|strong="H08199"\w* \w of|strong="H03027"\w* \w all|strong="H03605"\w* \w who rose up|strong="H06965"\w* \w against you|strong="H05921"\w*!”
\p \v 32 \w The king|strong="H04428"\w* \w . . .|strong="H00413"\w* \w asked|strong="H00559"\w* \w the Cushite|strong="H03569"\w*, “\w Is the young man|strong="H05288"\w* \w Absalom|strong="H00053"\w* \w all right|strong="H07965"\w*?”
