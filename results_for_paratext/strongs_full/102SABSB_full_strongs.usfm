\p \v 11 \w One|strong="H00376"\w* \w of Joab’s|strong="H03097"\w* \w young men|strong="H05288"\w* \w stood|strong="H05975"\w* \w near Amasa|strong="H05921"\w* \w and said|strong="H00559"\w*, “\w Whoever|strong="H04310"\w* \w -|strong="H00834"\w* \w favors|strong="H02654"\w* \w Joab|strong="H03097"\w*, \w and whoever|strong="H04310"\w* \w -|strong="H00834"\w* \w is for David|strong="H01732"\w*, \w [let him] follow|strong="H00310"\w* \w Joab|strong="H03097"\w*!” \v 12 \w But Amasa|strong="H06021"\w* \w wallowed|strong="H01556"\w* \w in his blood|strong="H01818"\w* \w in the middle|strong="H08432"\w* \w of the road|strong="H04546"\w*, \w and when the man|strong="H00376"\w* \w saw|strong="H07200"\w* \w that|strong="H03588"\w* \w all|strong="H03605"\w* \w the troops|strong="H05971"\w* \w were stopping there|strong="H05975"\w*, \w he dragged|strong="H05437"\w* \w -|strong="H00853"\w* \w [the body]|strong="H06021"\w* \w off|strong="H04480"\w* \w the road|strong="H04546"\w* \w into a field|strong="H07704"\w* \w and threw|strong="H07993"\w* \w a garment|strong="H00899"\w* \w over it|strong="H05921"\w* \w -|strong="H00834"\w* \w -|strong="H07200"\w* \w -|strong="H03605"\w* \w -|strong="H00935"\w* \w -|strong="H05921"\w* \w -|strong="H05975"\w*. \v 13 \w As soon as|strong="H00834"\w* \w [Amasa’s body] was removed|strong="H03014"\w* \w from|strong="H04480"\w* \w the road|strong="H04546"\w*, \w all|strong="H03605"\w* \w the men|strong="H00376"\w* \w went on|strong="H05674"\w* \w with|strong="H00310"\w* \w Joab|strong="H03097"\w* \w to pursue|strong="H07291"\w* \w . . .|strong="H00310"\w* \w Sheba|strong="H07652"\w* \w son|strong="H01121"\w* \w of Bichri|strong="H01075"\w*.
