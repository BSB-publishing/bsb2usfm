\p \v 1 \w -|strong="H01961"\w* \w Some time later|strong="H00310"\w*, \w . . .|strong="H03651"\w* \w the king|strong="H04428"\w* \w of the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w* \w died|strong="H04191"\w* \w and was succeeded by|strong="H04427"\w* \w -|strong="H08478"\w* \w his son|strong="H01121"\w* \w Hanun|strong="H02586"\w*. \v 2 \w And David|strong="H01732"\w* \w said|strong="H00559"\w*, “\w I will show|strong="H06213"\w* \w kindness|strong="H02617"\w* \w to|strong="H05973"\w* \w Hanun|strong="H02586"\w* \w son|strong="H01121"\w* \w of Nahash|strong="H05176"\w*, \w just as|strong="H00834"\w* \w his father|strong="H00001"\w* \w showed|strong="H06213"\w* \w kindness|strong="H02617"\w* \w to me|strong="H05978"\w*.”
\p \w So David|strong="H01732"\w* \w sent|strong="H07971"\w* \w some of his servants|strong="H05650"\w* \w to console [Hanun]|strong="H05162"\w* \w . . .|strong="H03027"\w* \w concerning|strong="H00413"\w* \w his father|strong="H00001"\w*. \w But when they|strong="H05650"\w* \w . . .|strong="H01732"\w* \w arrived|strong="H00935"\w* \w in the land|strong="H00776"\w* \w of the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w*, \v 3 \w the princes|strong="H08269"\w* \w of the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Hanun|strong="H02586"\w* \w their lord|strong="H00113"\w*, “\w Just because|strong="H03588"\w* \w David has sent|strong="H07971"\w* you \w comforters|strong="H05162"\w*, \w do you really believe|strong="H05869"\w* \w he is|strong="H01732"\w* \w -|strong="H00853"\w* \w showing respect|strong="H03513"\w* \w for your father|strong="H00001"\w*? \w Has not|strong="H03808"\w* \w David|strong="H01732"\w* \w -|strong="H00853"\w* \w [instead] sent|strong="H07971"\w* \w his servants|strong="H05650"\w* \w . . .|strong="H00413"\w* \w -|strong="H05668"\w* \w to explore|strong="H02713"\w* \w -|strong="H00853"\w* \w the city|strong="H05892"\w*, \w spy it out|strong="H07270"\w*, \w and overthrow it|strong="H02015"\w*?”
