\p “\w Let my lord|strong="H00113"\w* \w the king|strong="H04428"\w* \w speak|strong="H01696"\w*,” \w . . .|strong="H04994"\w* \w she|strong="H00802"\w* \w replied|strong="H00559"\w*.
\p \v 19 \w So the king|strong="H04428"\w* \w asked|strong="H00559"\w*, “\w Is the hand|strong="H03027"\w* \w of Joab|strong="H03097"\w* \w behind|strong="H00854"\w* \w all|strong="H03605"\w* \w this|strong="H02063"\w*?”
