\p \v 1 \w Then it was reported|strong="H05046"\w* \w to Joab|strong="H03097"\w*, \w . . .|strong="H02009"\w* “\w The king|strong="H04428"\w* \w is weeping|strong="H01058"\w* \w and mourning|strong="H00056"\w* \w over|strong="H05921"\w* \w Absalom|strong="H00053"\w*.” \v 2 \w And that|strong="H01931"\w* \w day’s|strong="H03117"\w* \w victory|strong="H08668"\w* \w was turned|strong="H01961"\w* \w into mourning|strong="H00060"\w* \w for all|strong="H03605"\w* \w the people|strong="H05971"\w*, \w because|strong="H03588"\w* \w on that|strong="H01931"\w* \w . . .|strong="H00559"\w* \w day|strong="H03117"\w* \w [they]|strong="H05971"\w* \w were told|strong="H08085"\w*, “\w The king|strong="H04428"\w* \w is grieving|strong="H06087"\w* \w over|strong="H05921"\w* \w his son|strong="H01121"\w*.”
