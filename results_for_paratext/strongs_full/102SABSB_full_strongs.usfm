\c 23
\s1 David’s Last Song
\p \v 1 \w These|strong="H00428"\w* \w are the last|strong="H00314"\w* \w words|strong="H01697"\w* \w of David|strong="H01732"\w*:
\b 
\q1 “\w The oracle|strong="H05002"\w* \w of David|strong="H01732"\w* \w son|strong="H01121"\w* \w of Jesse|strong="H03448"\w*,
\q2 \w the oracle|strong="H05002"\w* \w of the man|strong="H01397"\w* \w raised|strong="H06965"\w* \w on high|strong="H05920"\w*,
\q1 \w the one anointed|strong="H04899"\w* \w by the God|strong="H00430"\w* \w of Jacob|strong="H03290"\w*,
\q2 \w and the sweet|strong="H05273"\w* \w psalmist|strong="H02158"\w* \w of Israel|strong="H03478"\w*:\f + \fr 23:1 \ft Or \fqa the hero of the songs of Israel \ft or \fqa the favorite of the Strong One of Israel\f*
\b 
\q1 \v 2 \w The Spirit|strong="H07307"\w* \w of the LORD|strong="H03068"\w* \w spoke through|strong="H01696"\w* me;
\q2 \w His word|strong="H04405"\w* \w was on|strong="H05921"\w* \w my tongue|strong="H03956"\w*.
