\q1 \v 13 \w From the brightness|strong="H05051"\w* \w of His presence|strong="H05048"\w*
\q2 \w coals|strong="H01513"\w* \w of fire|strong="H00784"\w*\f + \fr 22:13 \ft Or \fqa bolts of lightning\f* \w blazed forth|strong="H01197"\w*.
\b 
\q1 \v 14 \w The LORD|strong="H03068"\w* \w thundered|strong="H07481"\w* \w from|strong="H04480"\w* \w heaven|strong="H08064"\w*;
