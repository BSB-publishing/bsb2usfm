\p \v 9 \w When Joab|strong="H03097"\w* \w saw|strong="H07200"\w* \w vvv|strong="H03588"\w* \w vvv|strong="H01961"\w* \w vvv|strong="H00413"\w* \w the battle lines|strong="H04421"\w* \w before him|strong="H06440"\w* \w -|strong="H06440"\w* \w and behind him|strong="H00268"\w*, \w he selected|strong="H00977"\w* \w some of|strong="H03605"\w* \w the best|strong="H00977"\w* \w men of Israel|strong="H03478"\w* \w and arrayed them|strong="H06186"\w* \w against|strong="H07122"\w* \w the Arameans|strong="H00758"\w*. \v 10 \w And|strong="H00853"\w* \w he placed|strong="H05414"\w* \w the rest|strong="H03499"\w* \w of the troops|strong="H05971"\w* \w under the command|strong="H03027"\w* \w of his brother|strong="H00251"\w* \w Abishai|strong="H00052"\w*, \w who arrayed them|strong="H06186"\w* \w against|strong="H07122"\w* \w the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w*.
\p \v 11 “\w If|strong="H00518"\w* \w the Arameans|strong="H00758"\w* \w are too strong|strong="H02388"\w* \w for me|strong="H04480"\w*,” \w said Joab|strong="H00559"\w*, “\w then you will come|strong="H01961"\w* \w to my rescue|strong="H03444"\w* . . .. \w And if|strong="H00518"\w* \w the Ammonites|strong="H01121"\w* \w . . .|strong="H05983"\w* \w are too strong|strong="H02388"\w* \w for you|strong="H04480"\w*, \w then I will come|strong="H01980"\w* \w to your rescue|strong="H03467"\w* . . .. \v 12 \w Be strong|strong="H02388"\w* \w and let us fight bravely|strong="H02388"\w* \w for|strong="H01157"\w* \w our people|strong="H05971"\w* \w and for|strong="H01157"\w* \w the cities|strong="H05892"\w* \w of our God|strong="H00430"\w*. \w May the LORD|strong="H03068"\w* \w do|strong="H06213"\w* \w what is good|strong="H02896"\w* \w in His sight|strong="H05869"\w*.”
