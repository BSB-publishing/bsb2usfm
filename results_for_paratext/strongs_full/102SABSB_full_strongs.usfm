\p \v 15 \w Once again|strong="H05750"\w* \w . . .|strong="H01961"\w* \w the Philistines|strong="H06430"\w* \w waged war|strong="H04421"\w* \w against|strong="H00854"\w* \w Israel|strong="H03478"\w*, \w and David|strong="H01732"\w* \w and his servants|strong="H05650"\w* \w . . .|strong="H05973"\w* \w went down|strong="H03381"\w* \w and fought|strong="H03898"\w* \w against|strong="H00854"\w* \w the Philistines|strong="H06430"\w*. \w But David|strong="H01732"\w* \w became exhausted|strong="H05888"\w*.
