\p \v 7 \w So Joab’s|strong="H03097"\w* \w men|strong="H00582"\w* \w -|strong="H03318"\w* \w -|strong="H00310"\w*, \w along with the Cherethites|strong="H03774"\w*, \w the Pelethites|strong="H06432"\w*, \w and all|strong="H03605"\w* \w the mighty men|strong="H01368"\w*, \w marched out of|strong="H03318"\w* \w Jerusalem|strong="H03389"\w* \w in pursuit|strong="H07291"\w* \w . . .|strong="H00310"\w* \w of Sheba|strong="H07652"\w* \w son|strong="H01121"\w* \w of Bichri|strong="H01075"\w*. \v 8 \w [And while] they|strong="H01992"\w* \w were at|strong="H05973"\w* \w the great|strong="H01419"\w* \w -|strong="H00834"\w* \w stone|strong="H00068"\w* \w in Gibeon|strong="H01391"\w*, \w Amasa|strong="H06021"\w* \w joined|strong="H00935"\w* \w them|strong="H06440"\w*.
\p \w Now Joab|strong="H03097"\w* \w was dressed|strong="H02296"\w* \w in military attire|strong="H04055"\w* \w . . .|strong="H03830"\w*, \w with a dagger|strong="H02719"\w* \w strapped|strong="H06775"\w* \w -|strong="H05921"\w* \w to his belt|strong="H02290"\w* \w . . .|strong="H05921"\w* \w . . .|strong="H04975"\w*. \w And as he|strong="H01931"\w* \w stepped forward|strong="H03318"\w*, \w he slipped the dagger|strong="H05307"\w* \w from its sheath|strong="H08593"\w*.\f + \fr 20:8 \ft Literally \fqa Now Joab was dressed in military attire, and over it was a belt around his waist with a dagger in its sheath. And as he stepped forward, it fell out.\f* \v 9 “\w Are you|strong="H00859"\w* \w well|strong="H07965"\w*, \w my brother|strong="H00251"\w*?” \w Joab|strong="H03097"\w* \w asked|strong="H00559"\w* \w Amasa|strong="H06021"\w*. \w And with his right|strong="H03225"\w* \w hand|strong="H03027"\w* \w Joab|strong="H03097"\w* \w grabbed|strong="H00270"\w* \w Amasa|strong="H06021"\w* \w by the beard|strong="H02206"\w* \w to kiss|strong="H05401"\w* him.
