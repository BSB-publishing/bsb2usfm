\p \v 19 \w Once again|strong="H05750"\w* \w there was|strong="H01961"\w* \w a battle|strong="H04421"\w* \w with|strong="H05973"\w* \w the Philistines|strong="H06430"\w* \w at Gob|strong="H01359"\w*, \w and Elhanan|strong="H00445"\w* \w son|strong="H01121"\w* \w vvv|strong="H03296"\w* \w of Jair|strong="H03296"\w*\f + \fr 21:19 \ft See 1 Chronicles 20:5; Hebrew \fqa Jaare-oregim\f* \w vvv|strong="H01022"\w* \w the Bethlehemite|strong="H01022"\w* \w -|strong="H00853"\w* \w killed|strong="H05221"\w* \w [the brother of] Goliath|strong="H01555"\w*\f + \fr 21:19 \ft See 1 Chronicles 20:5; Hebrew does not include \fqa the brother of\ft .\f* \w the Gittite|strong="H01663"\w*, \w the shaft|strong="H06086"\w* \w of whose spear|strong="H02595"\w* \w was like a weaver’s|strong="H00707"\w* \w beam|strong="H04500"\w*.
\p \v 20 \w And there was|strong="H01961"\w* \w also|strong="H05750"\w* \w a battle|strong="H04421"\w* \w at Gath|strong="H01661"\w*, \w where there was a man|strong="H00376"\w* \w of [great] stature|strong="H04060"\w* \w with|strong="H01961"\w* \w six|strong="H08337"\w* \w fingers|strong="H00676"\w* \w on each hand|strong="H03027"\w* \w and six|strong="H08337"\w* \w toes|strong="H00676"\w* \w on each foot|strong="H07272"\w*— \w twenty-four|strong="H06242"\w* \w . . .|strong="H00702"\w* \w in all|strong="H04557"\w*. \w He|strong="H01931"\w* \w too|strong="H01571"\w* \w was descended|strong="H03205"\w* \w from Rapha|strong="H07497"\w*, \v 21 \w and when he taunted|strong="H02778"\w* \w -|strong="H00853"\w* \w Israel|strong="H03478"\w*, \w Jonathan|strong="H03083"\w* \w the son|strong="H01121"\w* \w of David’s|strong="H01732"\w* \w brother|strong="H00251"\w* \w Shimei|strong="H08096"\w*\f + \fr 21:21 \fqa Shimei \ft is a variant of \fqa Shammah\ft , \fqa Shimeah\ft , and \fqa Shimea\ft ; see 1 Samuel 16:9, 2 Samuel 13:3, and 1 Chronicles 2:13.\f* \w killed him|strong="H05221"\w*.
\p \v 22 \w -|strong="H00853"\w* \w So these|strong="H00428"\w* \w four|strong="H00702"\w* \w descendants|strong="H03205"\w* \w of Rapha|strong="H07497"\w* \w in Gath|strong="H01661"\w* \w fell|strong="H05307"\w* \w at the hands|strong="H03027"\w* \w of David|strong="H01732"\w* \w . . .|strong="H03027"\w* \w and his servants|strong="H05650"\w*.
\c 22
\s1 David’s Song of Deliverance
\r (Psalm 18:1–50)
\p \v 1 \w And David|strong="H01732"\w* \w sang|strong="H01696"\w* \w . . .|strong="H01697"\w* \w this|strong="H02063"\w* \w song|strong="H07892"\w* \w to the LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w on the day|strong="H03117"\w* \w the LORD|strong="H03068"\w* \w had delivered|strong="H05337"\w* \w him|strong="H00853"\w* \w from the hand|strong="H03709"\w* \w of all|strong="H03605"\w* \w his enemies|strong="H00341"\w* \w and from the hand|strong="H03709"\w* \w of Saul|strong="H07586"\w*. \v 2 \w He said|strong="H00559"\w*:
