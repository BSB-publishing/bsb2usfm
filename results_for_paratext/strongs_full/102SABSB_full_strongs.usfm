\p \v 31 \w Now Barzillai|strong="H01271"\w* \w the Gileadite|strong="H01569"\w* \w had come down|strong="H03381"\w* \w from Rogelim|strong="H07274"\w* \w to cross|strong="H05674"\w* \w the Jordan|strong="H03383"\w* \w with|strong="H00854"\w* \w the king|strong="H04428"\w* \w and send him on his way|strong="H07971"\w* \w -|strong="H00853"\w* \w [from there]|strong="H03383"\w*. \v 32 \w Barzillai|strong="H01271"\w* \w was quite|strong="H03966"\w* \w old|strong="H02204"\w*, \w eighty|strong="H08084"\w* \w years|strong="H08141"\w* \w of age|strong="H01121"\w*, \w and since|strong="H03588"\w* \w he was a very|strong="H03966"\w* \w wealthy|strong="H01419"\w* \w man|strong="H00376"\w*, \w . . .|strong="H01931"\w* \w he|strong="H01931"\w* \w had provided|strong="H03557"\w* \w -|strong="H00853"\w* \w for the king|strong="H04428"\w* \w while he stayed|strong="H07871"\w* \w in Mahanaim|strong="H04266"\w*.
