\c 15
\s1 Absalom’s Conspiracy
\p \v 1 \w Some time later|strong="H01961"\w* \w . . .|strong="H00310"\w* \w . . .|strong="H03651"\w*, \w Absalom|strong="H00053"\w* \w provided for|strong="H06213"\w* himself \w a chariot|strong="H04818"\w* \w with horses|strong="H05483"\w* \w and fifty|strong="H02572"\w* \w men|strong="H00376"\w* \w to run|strong="H07323"\w* \w ahead of him|strong="H06440"\w*. \v 2 \w He|strong="H00053"\w* \w would get up early|strong="H07925"\w* \w and stand|strong="H05975"\w* \w beside|strong="H05921"\w* \w . . .|strong="H03027"\w* \w the road|strong="H01870"\w* \w leading to the city gate|strong="H08179"\w*.
