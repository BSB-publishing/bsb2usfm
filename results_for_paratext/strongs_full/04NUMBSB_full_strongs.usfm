\p \v 1 \w On the first|strong="H00259"\w* \w day of the second|strong="H08145"\w* \w month|strong="H02320"\w* \w of the second|strong="H08145"\w* \w year|strong="H08141"\w* \w after [the Israelites] had come out|strong="H03318"\w* \w of the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w*, \w the LORD|strong="H03068"\w* \w spoke|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w in the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w* \w in the Wilderness|strong="H04057"\w* \w of Sinai|strong="H05514"\w*. \w He said|strong="H00559"\w*: \v 2 “\w Take a census|strong="H05375"\w* \w -|strong="H00853"\w* \w -|strong="H07218"\w* \w of the whole|strong="H03605"\w* \w congregation|strong="H05712"\w* \w . . .|strong="H01121"\w* \w of Israel|strong="H03478"\w* \w by their clans|strong="H04940"\w* \w and families|strong="H00001"\w* \w . . .|strong="H01004"\w*, \w listing|strong="H04557"\w* \w every|strong="H03605"\w* \w man|strong="H02145"\w* \w by name|strong="H08034"\w*, \w one by one|strong="H01538"\w*.
