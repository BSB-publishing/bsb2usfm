\p \v 1 \w In the first|strong="H07223"\w* \w . . .|strong="H00559"\w* \w month|strong="H02320"\w* \w of the second|strong="H08145"\w* \w year|strong="H08141"\w* \w after [Israel] had come out|strong="H03318"\w* \w of the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w*, \w the LORD|strong="H03068"\w* \w . . .|strong="H00413"\w* \w spoke|strong="H01696"\w* \w to Moses|strong="H04872"\w* \w in the Wilderness|strong="H04057"\w* \w of Sinai|strong="H05514"\w*: \v 2 “\w The Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w -|strong="H00853"\w* \w are to observe|strong="H06213"\w* \w the Passover|strong="H06453"\w* \w at its appointed time|strong="H04150"\w*. \v 3 \w You are to observe|strong="H06213"\w* \w it|strong="H00853"\w* \w at the appointed time|strong="H04150"\w*, \w at|strong="H00996"\w* \w twilight|strong="H06153"\w* \w on the fourteenth|strong="H00702"\w* \w . . .|strong="H06240"\w*\f + \fr 9:3 \ft Hebrew \fqa between the two evenings of the fourteenth\ft ; also in verses 5 and 11\f* \w day|strong="H03117"\w* \w of this|strong="H02088"\w* \w month|strong="H02320"\w*, \w -|strong="H06213"\w* \w -|strong="H00853"\w* \w in accordance with|strong="H03605"\w* \w its statutes|strong="H02708"\w* \w . . .|strong="H03605"\w* \w and ordinances|strong="H04941"\w*.”
