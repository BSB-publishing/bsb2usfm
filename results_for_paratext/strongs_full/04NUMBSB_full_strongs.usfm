\p \v 1 \w Now the family|strong="H00001"\w* \w heads|strong="H07218"\w* \w of the clan|strong="H04940"\w* \w . . .|strong="H01121"\w* \w of Gilead|strong="H01568"\w* \w son|strong="H01121"\w* \w of Machir|strong="H04353"\w* \w son|strong="H01121"\w* \w of Manasseh|strong="H04519"\w*, \w one of the clans|strong="H04940"\w* \w . . .|strong="H01121"\w* \w of Joseph|strong="H03130"\w*, \w approached|strong="H07126"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H06440"\w* \w and the leaders|strong="H05387"\w* \w who were the heads|strong="H07218"\w* \w . . .|strong="H00001"\w* \w of the Israelite|strong="H01121"\w* \w families|strong="H03478"\w* \w and addressed them|strong="H01696"\w* \w . . .|strong="H06440"\w*, \v 2 \w saying|strong="H00559"\w*, \w -|strong="H00853"\w* “\w When the LORD|strong="H03068"\w* \w commanded|strong="H06680"\w* \w my lord|strong="H00113"\w* \w to give|strong="H05414"\w* \w -|strong="H00853"\w* \w the land|strong="H00776"\w* \w as an inheritance|strong="H05159"\w* \w to the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w by lot|strong="H01486"\w*, \w [He]|strong="H03068"\w* \w also commanded|strong="H06680"\w* \w [him]|strong="H00113"\w* \w to give|strong="H05414"\w* \w -|strong="H00853"\w* \w the inheritance|strong="H05159"\w* \w of our brother|strong="H00251"\w* \w Zelophehad|strong="H06765"\w* \w to his daughters|strong="H01323"\w*. \v 3 \w But if they marry|strong="H01961"\w* \w any of the men|strong="H00259"\w* \w from the [other] tribes|strong="H07626"\w* \w vvv|strong="H01121"\w* \w of Israel|strong="H03478"\w* \w . . .|strong="H01121"\w*, \w -|strong="H00802"\w* \w their inheritance|strong="H05159"\w* \w will be withdrawn|strong="H01639"\w* \w from the portion|strong="H05159"\w* \w of our fathers|strong="H00001"\w* \w and added|strong="H03254"\w* \w to|strong="H05921"\w* \w -|strong="H05159"\w* \w the tribe|strong="H04294"\w* \w into which|strong="H00834"\w* \w they marry|strong="H01961"\w*. So our \w allotted|strong="H01486"\w* \w inheritance|strong="H05159"\w* \w would be taken away|strong="H01639"\w*. \v 4 \w And when|strong="H00518"\w* \w the Jubilee|strong="H03104"\w* \w for the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w comes|strong="H01961"\w*, \w their inheritance|strong="H05159"\w* \w will be added|strong="H03254"\w* \w to|strong="H05921"\w* \w -|strong="H05159"\w* \w the tribe|strong="H04294"\w* \w into which|strong="H00834"\w* \w they marry|strong="H01961"\w* \w [and]|strong="H05159"\w* \w taken away|strong="H01639"\w* \w -|strong="H05159"\w* \w from the tribe|strong="H04294"\w* \w of our fathers|strong="H00001"\w*.”
\p \v 5 \w So at|strong="H05921"\w* \w the word|strong="H06310"\w* \w of the LORD|strong="H03068"\w*, \w Moses|strong="H04872"\w* \w -|strong="H00853"\w* \w commanded|strong="H06680"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w . . .|strong="H00559"\w*: “\w The tribe|strong="H04294"\w* \w of the sons|strong="H01121"\w* \w of Joseph|strong="H03130"\w* \w speaks|strong="H01696"\w* \w correctly|strong="H03651"\w*. \v 6 \w This|strong="H02088"\w* \w . . .|strong="H01697"\w* \w is what|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w has commanded|strong="H06680"\w* \w concerning the daughters|strong="H01323"\w* \w of Zelophehad|strong="H06765"\w* \w -|strong="H00559"\w*: \w They may marry|strong="H01961"\w* \w . . .|strong="H00802"\w* \w anyone they please|strong="H02896"\w* \w . . .|strong="H05869"\w*, \w provided|strong="H00389"\w* \w they marry|strong="H01961"\w* \w . . .|strong="H00802"\w* \w within a clan|strong="H04940"\w* \w of the tribe|strong="H04294"\w* \w of their father|strong="H00001"\w*. \v 7 \w No|strong="H03808"\w* \w inheritance|strong="H05159"\w* \w in Israel|strong="H01121"\w* \w . . .|strong="H03478"\w* \w may be transferred|strong="H05437"\w* \w from tribe|strong="H04294"\w* \w to|strong="H00413"\w* \w tribe|strong="H04294"\w*, \w because|strong="H03588"\w* \w each|strong="H00376"\w* \w vvv|strong="H01121"\w* \w of the Israelites|strong="H03478"\w* \w is to retain|strong="H01692"\w* \w the inheritance|strong="H05159"\w* \w of the tribe|strong="H04294"\w* \w of his fathers|strong="H00001"\w*. \v 8 \w Every|strong="H03605"\w* \w daughter|strong="H01323"\w* \w who possesses|strong="H03423"\w* \w an inheritance|strong="H05159"\w* \w vvv|strong="H01121"\w* \w from any Israelite|strong="H03478"\w* \w . . .|strong="H00259"\w* \w tribe|strong="H04294"\w* \w must marry|strong="H01961"\w* \w . . .|strong="H00802"\w* \w within a clan|strong="H04940"\w* \w of the tribe|strong="H04294"\w* \w of her father|strong="H00001"\w*, \w so that|strong="H04616"\w* \w every|strong="H00376"\w* \w Israelite|strong="H01121"\w* \w . . .|strong="H03478"\w* \w will possess|strong="H03423"\w* \w the inheritance|strong="H05159"\w* \w of his fathers|strong="H00001"\w*. \v 9 \w No|strong="H03808"\w* \w inheritance|strong="H05159"\w* \w may be transferred|strong="H05437"\w* \w from one tribe|strong="H04294"\w* \w to|strong="H04294"\w* \w another|strong="H00312"\w*, \w for|strong="H03588"\w* \w each|strong="H00376"\w* \w tribe|strong="H04294"\w* \w vvv|strong="H01121"\w* \w of Israel|strong="H03478"\w* \w must retain|strong="H01692"\w* \w its inheritance|strong="H05159"\w*.”
\p \v 10 \w So the daughters|strong="H01323"\w* \w of Zelophehad|strong="H06765"\w* \w did|strong="H06213"\w* \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had commanded|strong="H06680"\w* \w -|strong="H00853"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H03651"\w*. \v 11 \w -|strong="H01961"\w* \w Mahlah|strong="H04244"\w*, \w Tirzah|strong="H08656"\w*, \w Hoglah|strong="H02295"\w*, \w Milcah|strong="H04435"\w*, \w and Noah|strong="H05270"\w*, \w the daughters|strong="H01323"\w* \w of Zelophehad|strong="H06765"\w*, \w were married|strong="H00802"\w* \w to cousins on their|strong="H01121"\w* \w father’s side|strong="H01730"\w*. \v 12 \w They married|strong="H01961"\w* \w . . .|strong="H00802"\w* \w within the clans|strong="H04940"\w* \w of the descendants|strong="H01121"\w* \w of Manasseh|strong="H04519"\w* \w son|strong="H01121"\w* \w of Joseph|strong="H03130"\w*, \w and their inheritance|strong="H05159"\w* \w remained|strong="H01961"\w* \w within|strong="H05921"\w* \w the tribe|strong="H04294"\w* \w of their father’s|strong="H00001"\w* \w clan|strong="H04940"\w*.
\p \v 13 \w These|strong="H00428"\w* \w are the commandments|strong="H04687"\w* \w and ordinances|strong="H04941"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w gave|strong="H06680"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w through|strong="H03027"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00413"\w* \w on the plains|strong="H06160"\w* \w of Moab|strong="H04124"\w* \w by|strong="H05921"\w* \w the Jordan|strong="H03383"\w* \w across from Jericho|strong="H03405"\w*.
