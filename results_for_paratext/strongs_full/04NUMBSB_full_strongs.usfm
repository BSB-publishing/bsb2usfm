\s1 Offerings for Unintentional Sins
\p \v 22 \w Now if|strong="H03588"\w* \w you stray unintentionally|strong="H07686"\w* \w and do not|strong="H03808"\w* \w obey|strong="H06213"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w these|strong="H00428"\w* \w commandments|strong="H04687"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w has spoken|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*— \v 23 \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w . . .|strong="H00413"\w* \w has commanded|strong="H06680"\w* \w you through|strong="H03027"\w* \w Moses|strong="H04872"\w* \w from|strong="H04480"\w* \w the day|strong="H03117"\w* \w -|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w gave them|strong="H06680"\w* \w and continuing through|strong="H01973"\w* \w the generations to come|strong="H01755"\w*— \v 24 \w -|strong="H01961"\w* \w and if|strong="H00518"\w* \w it was done|strong="H06213"\w* \w unintentionally|strong="H07684"\w* \w without the knowledge|strong="H05869"\w* \w of the congregation|strong="H05712"\w*, \w then the whole|strong="H03605"\w* \w congregation|strong="H05712"\w* \w is to prepare|strong="H06213"\w* \w one|strong="H00259"\w* \w young bull|strong="H06499"\w* \w . . .|strong="H01121"\w* \w . . .|strong="H01241"\w* \w as a burnt offering|strong="H05930"\w*, \w a pleasing|strong="H05207"\w* \w aroma|strong="H07381"\w* \w to the LORD|strong="H03068"\w*, \w with its grain offering|strong="H04503"\w* \w and drink offering|strong="H05262"\w* \w according to the regulation|strong="H04941"\w*, \w and one|strong="H00259"\w* \w male goat|strong="H08163"\w* \w . . .|strong="H05795"\w* \w as a sin offering|strong="H02403"\w*.
\p \v 25 \w The priest|strong="H03548"\w* \w is to make atonement|strong="H03722"\w* \w for|strong="H05921"\w* \w the whole|strong="H03605"\w* \w congregation|strong="H05712"\w* \w . . .|strong="H01121"\w* \w of Israel|strong="H03478"\w*, \w so that they may be forgiven|strong="H05545"\w*; \w for|strong="H03588"\w* \w [the sin]|strong="H01931"\w* \w was unintentional|strong="H07684"\w* \w and they|strong="H01992"\w* \w have brought|strong="H00935"\w* \w -|strong="H00853"\w* \w to the LORD|strong="H03068"\w* \w vvv|strong="H07133"\w* \w a food offering|strong="H00801"\w* \w and a sin offering|strong="H02403"\w*, \w [presented] before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w for|strong="H05921"\w* \w their unintentional sin|strong="H07684"\w*. \v 26 \w Then the whole|strong="H03605"\w* \w congregation|strong="H05712"\w* \w . . .|strong="H01121"\w* \w of Israel|strong="H03478"\w* \w and the foreigners|strong="H01616"\w* \w residing|strong="H01481"\w* \w among them|strong="H08432"\w* \w will be forgiven|strong="H05545"\w*, \w since|strong="H03588"\w* \w it happened to all|strong="H03605"\w* \w the people|strong="H05971"\w* \w unintentionally|strong="H07684"\w*.
\p \v 27 \w Also, if|strong="H00518"\w* \w one|strong="H00259"\w* \w person|strong="H05315"\w* \w sins|strong="H02398"\w* \w unintentionally|strong="H07684"\w*, \w he is to present|strong="H07126"\w* \w a year-old|strong="H01323"\w* \w . . .|strong="H08141"\w* \w female goat|strong="H05795"\w* \w as a sin offering|strong="H02403"\w*. \v 28 \w And the priest|strong="H03548"\w* \w shall make atonement|strong="H03722"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w on behalf of|strong="H05921"\w* \w the person|strong="H05315"\w* \w who erred|strong="H07684"\w* \w by sinning unintentionally|strong="H07683"\w* \w . . .|strong="H02398"\w*; \w and when atonement has been made|strong="H03722"\w* \w for him|strong="H05921"\w*, \w he will be forgiven|strong="H05545"\w*. \v 29 You \w shall have|strong="H01961"\w* \w the same|strong="H00259"\w* \w law|strong="H08451"\w* \w for the one who acts|strong="H06213"\w* \w in error|strong="H07684"\w*, \w whether he is a native-born|strong="H00249"\w* \w Israelite|strong="H01121"\w* \w . . .|strong="H03478"\w* \w or a foreigner|strong="H01616"\w* \w residing|strong="H01481"\w* \w among you|strong="H08432"\w*.
\p \v 30 \w But the person|strong="H05315"\w* \w who|strong="H00834"\w* \w vvv|strong="H06213"\w* \w sins defiantly|strong="H03027"\w* \w . . .|strong="H07311"\w*, \w whether|strong="H04480"\w* \w a native|strong="H00249"\w* \w or|strong="H04480"\w* \w foreigner|strong="H01616"\w*, \w -|strong="H00853"\w* \w blasphemes|strong="H01442"\w* \w the LORD|strong="H03068"\w*. \w That|strong="H01931"\w* \w person|strong="H05315"\w* \w . . .|strong="H01931"\w* \w shall be cut off|strong="H03772"\w* \w from among|strong="H07130"\w* \w his people|strong="H05971"\w*. \v 31 \w He|strong="H05315"\w* \w . . .|strong="H01931"\w* \w shall certainly be cut off|strong="H03772"\w* \w . . .|strong="H03772"\w*, \w because|strong="H03588"\w* \w he has despised|strong="H00959"\w* \w the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w and|strong="H00853"\w* \w broken|strong="H06565"\w* \w His commandment|strong="H04687"\w*; \w his guilt [remains]|strong="H05771"\w* on him.”
\s1 A Sabbath-Breaker Stoned
\r (Exodus 31:12–17)
\p \v 32 \w While the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w were|strong="H01961"\w* \w in the wilderness|strong="H04057"\w*, \w a man|strong="H00376"\w* \w was found|strong="H04672"\w* \w gathering|strong="H07197"\w* \w wood|strong="H06086"\w* \w on the Sabbath|strong="H07676"\w* \w day|strong="H03117"\w*. \v 33 \w Those who found|strong="H04672"\w* \w [the man]|strong="H00853"\w* \w gathering|strong="H07197"\w* \w wood|strong="H06086"\w* \w brought|strong="H07126"\w* \w him|strong="H00853"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*, \w . . .|strong="H00413"\w* \w Aaron|strong="H00175"\w*, \w . . .|strong="H00413"\w* \w and the whole|strong="H03605"\w* \w congregation|strong="H05712"\w*, \v 34 \w and because|strong="H03588"\w* \w it had not been|strong="H03808"\w* \w declared|strong="H06567"\w* \w what|strong="H04100"\w* \w should be done|strong="H06213"\w* to him, \w they placed|strong="H05117"\w* \w him|strong="H00853"\w* \w in custody|strong="H04929"\w*.
