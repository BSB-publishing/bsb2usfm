\p \w It|strong="H01931"\w* \w was Dathan|strong="H01885"\w* \w and Abiram|strong="H00048"\w*, \w chosen|strong="H07121"\w* \w by the congregation|strong="H05712"\w*, \w who|strong="H00834"\w* \w rebelled|strong="H05327"\w* \w against|strong="H05921"\w* \w Moses|strong="H04872"\w* \w and|strong="H05921"\w* \w Aaron|strong="H00175"\w* \w with the followers|strong="H05712"\w* \w of Korah|strong="H07141"\w* \w who rebelled|strong="H05327"\w* \w against|strong="H05921"\w* \w the LORD|strong="H03068"\w*. \v 10 \w And the earth|strong="H00776"\w* \w -|strong="H00853"\w* \w opened|strong="H06605"\w* \w its mouth|strong="H06310"\w* \w and swallowed|strong="H01104"\w* \w them|strong="H00853"\w* \w -|strong="H00853"\w* \w along with Korah|strong="H07141"\w*, \w whose followers|strong="H05712"\w* \w died|strong="H04191"\w* \w when the fire|strong="H00784"\w* \w -|strong="H00853"\w* \w consumed|strong="H00398"\w* \w 250|strong="H02572"\w* \w . . .|strong="H03967"\w* \w men|strong="H00376"\w*. \w They serve|strong="H01961"\w* \w as a warning sign|strong="H05251"\w*. \v 11 \w However, the line|strong="H01121"\w* \w of Korah|strong="H07141"\w* \w did not|strong="H03808"\w* \w die out|strong="H04191"\w*.
