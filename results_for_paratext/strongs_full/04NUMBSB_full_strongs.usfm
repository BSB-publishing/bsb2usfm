\p \v 1 \w Now the daughters|strong="H01323"\w* \w of Zelophehad|strong="H06765"\w* \w son|strong="H01121"\w* \w of Hepher|strong="H02660"\w*, \w the son|strong="H01121"\w* \w of Gilead|strong="H01568"\w*, \w the son|strong="H01121"\w* \w of Machir|strong="H04353"\w*, \w the son|strong="H01121"\w* \w of Manasseh|strong="H04519"\w*, \w belonged to the clans|strong="H04940"\w* \w of Manasseh|strong="H04519"\w* \w son|strong="H01121"\w* \w of Joseph|strong="H03130"\w*. \w These|strong="H00428"\w* \w were the names|strong="H08034"\w* \w of his daughters|strong="H01323"\w*: \w Mahlah|strong="H04244"\w*, \w Noah|strong="H05270"\w*, \w Hoglah|strong="H02295"\w*, \w Milcah|strong="H04435"\w*, \w and Tirzah|strong="H08656"\w*. \w They approached|strong="H07126"\w* \v 2 \w the entrance|strong="H06607"\w* \w to the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*, \w stood|strong="H05975"\w* \w before|strong="H06440"\w* \w Moses|strong="H04872"\w*, \w . . .|strong="H06440"\w* \w Eleazar|strong="H00499"\w* \w the priest|strong="H03548"\w*, \w . . .|strong="H06440"\w* \w the leaders|strong="H05387"\w*, \w and the whole|strong="H03605"\w* \w congregation|strong="H05712"\w*, \w and said|strong="H00559"\w*, \v 3 “\w Our father|strong="H00001"\w* \w died|strong="H04191"\w* \w in the wilderness|strong="H04057"\w*, \w but he|strong="H01931"\w* \w was|strong="H01961"\w* \w not|strong="H03808"\w* \w among|strong="H08432"\w* \w the followers|strong="H05712"\w* \w of Korah|strong="H07141"\w* \w who gathered together|strong="H03259"\w* \w against|strong="H05921"\w* \w the LORD|strong="H03068"\w*. \w . . .|strong="H05712"\w* \w Instead|strong="H03588"\w*, \w he died|strong="H04191"\w* \w because of his own sin|strong="H02399"\w*, \w and he had|strong="H01961"\w* \w no|strong="H03808"\w* \w sons|strong="H01121"\w*. \v 4 \w Why|strong="H04100"\w* \w should the name|strong="H08034"\w* \w of our father|strong="H00001"\w* \w disappear|strong="H01639"\w* \w from|strong="H08432"\w* \w his 