\p \v 1 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00559"\w*, \v 2 “\w Command|strong="H06680"\w* \w -|strong="H00853"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w to send away|strong="H07971"\w* \w from|strong="H04480"\w* \w the camp|strong="H04264"\w* \w anyone|strong="H03605"\w* \w with a skin disease|strong="H06879"\w*,\f + \fr 5:2 \ft Forms of the Hebrew \fqa tzaraath\ft , traditionally translated as \fqa leprosy\ft , were used for various skin diseases; see Leviticus 13.\f* \w anyone|strong="H03605"\w* \w who has a bodily discharge|strong="H02100"\w*, \w and anyone|strong="H03605"\w* \w who is defiled|strong="H02931"\w* \w by a dead body|strong="H05315"\w*. \v 3 \w You must send away|strong="H07971"\w* \w . . .|strong="H00413"\w* \w male|strong="H02145"\w* \w and|strong="H05704"\w* \w female alike|strong="H05347"\w*; \w send them|strong="H07971"\w* \w outside|strong="H02351"\w* \w the camp|strong="H04264"\w* \w so they will not|strong="H03808"\w* \w defile|strong="H02930"\w* \w -|strong="H00853"\w* \w their camp|strong="H04264"\w*, \w where|strong="H00834"\w* \w I|strong="H00589"\w* \w dwell|strong="H07931"\w* \w among them|strong="H08432"\w*.”
