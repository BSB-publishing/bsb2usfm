\p \v 37 \w And the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00559"\w*, \v 38 “\w Speak|strong="H01696"\w* \w to|strong="H00413"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w and tell them|strong="H00559"\w* \w that|strong="H00413"\w* \w throughout the generations to come|strong="H01755"\w* \w they are to make|strong="H06213"\w* for themselves \w tassels|strong="H06734"\w* \w for|strong="H05921"\w* \w the corners|strong="H03671"\w* \w of their garments|strong="H00899"\w*, \w with|strong="H05414"\w* \w a blue|strong="H08504"\w* \w cord|strong="H06616"\w* \w on|strong="H05921"\w* \w each tassel|strong="H06734"\w* \w . . .|strong="H03671"\w*. \v 39 \w These will serve|strong="H01961"\w* \w as tassels|strong="H06734"\w* \w for you to look at|strong="H07200"\w*, \w -|strong="H00853"\w* \w so that you may remember|strong="H02142"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the commandments|strong="H04687"\w* \w of the LORD|strong="H03068"\w*, \w that you may obey|strong="H06213"\w* \w them|strong="H00853"\w* \w and not|strong="H03808"\w* \w prostitute yourselves|strong="H02181"\w* \w . . .|strong="H00310"\w* \w by following|strong="H08446"\w* \w . . .|strong="H00310"\w* \w your own heart|strong="H03824"\w* \w . . .|strong="H00310"\w* \w and your own eyes|strong="H05869"\w* \w -|strong="H00834"\w* \w -|strong="H00859"\w*.
