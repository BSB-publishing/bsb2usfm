\p \v 1 \w Again the LORD|strong="H03068"\w* \w spoke|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w on the plains|strong="H06160"\w* \w of Moab|strong="H04124"\w* \w by|strong="H05921"\w* \w the Jordan|strong="H03383"\w* \w across from Jericho|strong="H03405"\w* \w . . .|strong="H00559"\w*: \v 2 “\w Command|strong="H06680"\w* \w -|strong="H00853"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w to give|strong="H05414"\w*, \w from the inheritance|strong="H05159"\w* \w they will possess|strong="H00272"\w*, \w cities|strong="H05892"\w* \w for the Levites|strong="H03881"\w* \w to live in|strong="H03427"\w* \w and pasturelands|strong="H04054"\w* \w around|strong="H05439"\w* \w . . .|strong="H05414"\w* \w . . .|strong="H03881"\w* \w the cities|strong="H05892"\w*. \v 3 \w The cities|strong="H05892"\w* \w will be|strong="H01961"\w* for them \w to live in|strong="H03427"\w*, \w and the pasturelands|strong="H04054"\w* \w will be|strong="H01961"\w* \w for their herds|strong="H00929"\w*, \w their flocks|strong="H07399"\w*, \w and all|strong="H03605"\w* \w their other livestock|strong="H02416"\w*.
