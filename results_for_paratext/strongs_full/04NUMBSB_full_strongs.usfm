\p \v 6 \w Throughout|strong="H03605"\w* \w the days|strong="H03117"\w* \w of his separation|strong="H05144"\w* \w to the LORD|strong="H03068"\w*, \w he must not|strong="H03808"\w* \w go|strong="H00935"\w* \w near|strong="H05921"\w* \w a dead|strong="H04191"\w* \w body|strong="H05315"\w*. \v 7 \w Even if his father|strong="H00001"\w* \w or mother|strong="H00517"\w* \w or brother|strong="H00251"\w* \w or sister|strong="H00269"\w* \w should die|strong="H04194"\w*, \w he is not|strong="H03808"\w* \w to defile himself|strong="H02930"\w*, \w because|strong="H03588"\w* \w the symbol of consecration|strong="H05145"\w* \w to his God|strong="H00430"\w* \w is upon|strong="H05921"\w* \w his head|strong="H07218"\w*. \v 8 \w Throughout the time|strong="H03605"\w* \w . . .|strong="H03117"\w* \w of his separation|strong="H05145"\w*, \w he|strong="H01931"\w* \w is holy|strong="H06918"\w* \w to the LORD|strong="H03068"\w*.
