\p \v 29 \w This|strong="H02063"\w* \w is the law|strong="H08451"\w* \w of jealousy|strong="H07068"\w* \w when|strong="H00834"\w* \w a wife|strong="H00802"\w* \w goes astray|strong="H07847"\w* \w and defiles herself|strong="H02930"\w* \w while under|strong="H08478"\w* \w her husband’s authority|strong="H00376"\w*, \v 30 \w or|strong="H00176"\w* \w when|strong="H00834"\w* \w a feeling|strong="H07307"\w* \w of jealousy|strong="H07068"\w* \w comes over|strong="H05674"\w* \w . . .|strong="H05921"\w* \w a husband|strong="H00376"\w* \w and he suspects|strong="H07065"\w* \w -|strong="H00853"\w* \w his wife|strong="H00802"\w*. \w He is to have the woman|strong="H00802"\w* \w stand|strong="H05975"\w* \w -|strong="H00853"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*, \w and the priest|strong="H03548"\w* \w -|strong="H00853"\w* \w is to apply|strong="H06213"\w* to her \w this|strong="H02063"\w* \w entire|strong="H03605"\w* \w law|strong="H08451"\w*. \v 31 \w The husband|strong="H00376"\w* \w will be free|strong="H05352"\w* \w from guilt|strong="H05771"\w*, \w but the|strong="H01931"\w* \w woman|strong="H00802"\w* \w shall bear|strong="H05375"\w* \w her|strong="H00853"\w* \w iniquity|strong="H05771"\w*.”
