\p \v 17 \w When Moses|strong="H04872"\w* \w sent|strong="H07971"\w* \w them|strong="H00853"\w* \w to spy out|strong="H08446"\w* \w -|strong="H00853"\w* \w the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*, \w he told|strong="H00559"\w* \w them|strong="H00413"\w*, “\w Go up|strong="H05927"\w* \w -|strong="H02088"\w* \w through the Negev|strong="H05045"\w* \w and|strong="H05927"\w* \w -|strong="H00853"\w* \w into the hill country|strong="H02022"\w*. \v 18 \w See|strong="H07200"\w* \w -|strong="H00853"\w* \w what|strong="H04100"\w* \w the land|strong="H00776"\w* \w is like|strong="H01931"\w* \w and|strong="H00853"\w* \w whether its people|strong="H05971"\w*\w . . .|strong="H03427"\w*\w . . .|strong="H05921"\w* \w are strong|strong="H02389"\w* \w . . .|strong="H01931"\w* \w or weak|strong="H07504"\w*, \w few|strong="H04592"\w* \w . . .|strong="H01931"\w* \w or|strong="H00518"\w* \w many|strong="H07227"\w*. \v 19 \w -|strong="H04100"\w* \w Is the land|strong="H00776"\w* \w where|strong="H00834"\w* \w they|strong="H01931"\w* \w live|strong="H03427"\w* \w good|strong="H02896"\w*\w . . .|strong="H01931"\w* \w or|strong="H00518"\w* \w bad|strong="H07451"\w*? \w . . .|strong="H04100"\w* \w Are the cities|strong="H05892"\w* \w where|strong="H00834"\w* \w they|strong="H01931"\w* \w dwell|strong="H03427"\w* . . . \w open camps|strong="H04264"\w* \w or|strong="H00518"\w* \w fortifications|strong="H04013"\w*? \v 20 \w -|strong="H04100"\w* \w Is the soil|strong="H00776"\w* \w fertile|strong="H08082"\w* \w . . .|strong="H01931"\w* \w or|strong="H00518"\w* \w unproductive|strong="H07330"\w*? \w Are there|strong="H03426"\w* \w trees|strong="H06086"\w* in it \w or|strong="H00518"\w* \w not|strong="H00369"\w*? \w Be courageous|strong="H02388"\w* \w and bring back|strong="H03947"\w* \w some of the fruit|strong="H06529"\w* \w of the land|strong="H00776"\w*.” (\w It was the season|strong="H03117"\w* \w . . .|strong="H03117"\w* \w for the first ripe|strong="H01061"\w* \w grapes|s