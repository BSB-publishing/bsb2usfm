\c 30
\s1 Laws about Vows
\r (Matthew 5:33–37)
\p \v 1 \w Then Moses|strong="H04872"\w* \w . . .|strong="H00413"\w* \w said|strong="H01696"\w* \w to the heads|strong="H07218"\w* \w of the tribes|strong="H04294"\w* \w . . .|strong="H01121"\w* \w of Israel|strong="H03478"\w*, \w . . .|strong="H00559"\w* “\w This|strong="H02088"\w* \w . . .|strong="H01697"\w* \w is what|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w has commanded|strong="H06680"\w*: \v 2 \w If|strong="H03588"\w* \w a man|strong="H00376"\w* \w makes|strong="H05087"\w* \w a vow|strong="H05088"\w* \w to the LORD|strong="H03068"\w* \w or|strong="H00176"\w* \w swears|strong="H07650"\w* \w an oath|strong="H07621"\w* \w to obligate|strong="H00631"\w* \w himself|strong="H05315"\w* \w -|strong="H05921"\w* \w by a pledge|strong="H00632"\w*, \w he must not|strong="H03808"\w* \w break|strong="H02490"\w* \w his word|strong="H01697"\w*; \w he must do|strong="H06213"\w* \w everything|strong="H03605"\w* \w he has promised|strong="H03318"\w* \w . . .|strong="H06310"\w*.\f + \fr 30:2 \ft Cited in Matthew 5:33\f*
\p \v 3 \w And if|strong="H03588"\w* \w a woman|strong="H00802"\w* \w in her father’s|strong="H00001"\w* \w house|strong="H01004"\w* \w during her youth|strong="H05271"\w* \w makes|strong="H05087"\w* \w a vow|strong="H05088"\w* \w to the LORD|strong="H03068"\w* \w or obligates herself|strong="H00631"\w* \w by a pledge|strong="H00632"\w*, \v 4 \w and her father|strong="H00001"\w* \w -|strong="H00853"\w* \w hears about|strong="H08085"\w* \w her vow|strong="H05088"\w* \w or pledge|strong="H00632"\w* \w -|strong="H00834"\w* \w -|strong="H00631"\w* \w -|strong="H05315"\w* \w -|strong="H05921"\w* \w [but]|strong="H00001"\w* \w says nothing|strong="H02790"\w* to her, \w then all|strong="H03605"\w* \w the vows|strong="H05088"\w* \w or|strong="H03605"\w* \w pledges|strong="H00632"\w* \w by which|strong="H00834"\w* \w she has bound|strong="H00631"\w* \w herself|strong="H05315"\w* \w . . .|strong="H06965"\w* \w . . .|strong="H05921"\w* \w shall stand|strong="H06965"\w*. \v 5 \w But if|strong="H00518"\w* \w her father|strong="H00001"\w* \w -|strong="H00853"\w* \w prohibits her|strong="H05106"\w* \w on the day|strong="H03117"\w* \w he hears|strong="H08085"\w* \w about it|strong="H03605"\w*, \w then none|strong="H03808"\w* \w of the vows|strong="H05088"\w* \w or pledges|strong="H00632"\w* \w by which|strong="H00834"\w* \w she has bound|strong="H00631"\w* \w herself|strong="H05315"\w* \w -|strong="H05921"\w* \w shall stand|strong="H06965"\w*. \w The LORD|strong="H03068"\w* \w will absolve|strong="H05545"\w* her \w because|strong="H03588"\w* \w her father|strong="H00001"\w* \w -|strong="H00853"\w* \w has prohibited her|strong="H05106"\w*.
\p \v 6 \w If|strong="H00518"\w* \w a woman marries|strong="H01961"\w* \w . . .|strong="H01961"\w* \w . . .|strong="H00376"\w* \w while under a vow|strong="H05088"\w* \w . . .|strong="H05921"\w* \w or|strong="H00176"\w* \w rash promise|strong="H04008"\w* \w . . .|strong="H08193"\w* \w by which|strong="H00834"\w* \w she|strong="H05315"\w* \w has bound|strong="H00631"\w* \w herself|strong="H05921"\w*, \v 7 \w and her husband|strong="H00376"\w* \w hears of it|strong="H08085"\w* \w but says nothing|strong="H02790"\w* to her \w on that day|strong="H03117"\w* \w -|strong="H08085"\w*, \w then the vows|strong="H05088"\w* \w -|strong="H06965"\w* \w or pledges|strong="H00632"\w* \w by which|strong="H00834"\w* \w she|strong="H05315"\w* \w has bound|strong="H00631"\w* \w herself|strong="H05921"\w* \w shall stand|strong="H06965"\w*. \v 8 \w But if|strong="H00518"\w* \w her husband|strong="H00376"\w* \w prohibits|strong="H05106"\w* \w her|strong="H00853"\w* \w when|strong="H03117"\w* \w he hears of it|strong="H08085"\w*, \w he nullifies|strong="H06565"\w* \w -|strong="H00853"\w* \w the vow|strong="H05088"\w* \w that|strong="H00834"\w* \w binds her|strong="H05921"\w* \w -|strong="H00853"\w* \w or the rash promise|strong="H04008"\w* \w . . .|strong="H08193"\w* \w -|strong="H00834"\w* \w she|strong="H05315"\w* \w has made|strong="H00631"\w*, \w . . .|strong="H05921"\w* \w and the LORD|strong="H03068"\w* \w will absolve|strong="H05545"\w* her.
