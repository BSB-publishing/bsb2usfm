\c 26
\s1 The Second Census of Israel
\r (Numbers 1:1–4)
\p \v 1 \w -|strong="H01961"\w* \w After|strong="H00310"\w* \w the plague [had ended]|strong="H04046"\w*, \w the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00413"\w* \w and Eleazar|strong="H00499"\w* \w son|strong="H01121"\w* \w of Aaron|strong="H00175"\w* \w the priest|strong="H03548"\w* \w . . .|strong="H00559"\w*, \v 2 “\w Take a census|strong="H05375"\w* \w -|strong="H00853"\w* \w -|strong="H07218"\w* \w of the whole|strong="H03605"\w* \w congregation|strong="H05712"\w* \w . . .|strong="H01121"\w* \w of Israel|strong="H03478"\w* \w by the houses|strong="H01004"\w* \w of their fathers|strong="H00001"\w* — \w all [those]|strong="H03605"\w* \w twenty|strong="H06242"\w* \w years of age|strong="H01121"\w* \w . . .|strong="H08141"\w* \w or older|strong="H04605"\w* \w who can serve|strong="H03318"\w* \w in the army|strong="H06635"\w* \w of Israel|strong="H03478"\w*.”
