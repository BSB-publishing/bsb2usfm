\p \v 18 \w So each man|strong="H00376"\w* \w took|strong="H03947"\w* \w his censer|strong="H04289"\w*, \w put|strong="H05414"\w* \w fire|strong="H00784"\w* \w -|strong="H05921"\w* \w -|strong="H07760"\w* \w and incense|strong="H07004"\w* \w in it|strong="H05921"\w*, \w and stood|strong="H05975"\w* \w with Moses|strong="H04872"\w* \w and Aaron|strong="H00175"\w* \w at the entrance|strong="H06607"\w* \w to the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*. \v 19 \w When Korah|strong="H07141"\w* \w -|strong="H00853"\w* \w had gathered|strong="H06950"\w* \w his whole|strong="H03605"\w* \w assembly|strong="H05712"\w* \w against them|strong="H05921"\w* \w at|strong="H00413"\w* \w the entrance|strong="H06607"\w* \w to the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*, \w the glory|strong="H03519"\w* \w of the LORD|strong="H03068"\w* \w appeared|strong="H07200"\w* \w to|strong="H00413"\w* \w the whole|strong="H03605"\w* \w congregation|strong="H05712"\w*.
