\p \v 6 \w But there were|strong="H01961"\w* \w some men|strong="H00582"\w* \w who|strong="H00834"\w* \w were|strong="H01961"\w* \w unclean|strong="H02931"\w* \w due to a dead body|strong="H00120"\w* \w . . .|strong="H05315"\w*, \w so they could|strong="H03201"\w* \w not|strong="H03808"\w* \w observe|strong="H06213"\w* \w the Passover|strong="H06453"\w* \w on that|strong="H01931"\w* \w day|strong="H03117"\w*. \w And they came|strong="H07126"\w* \w before|strong="H06440"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H06440"\w* \w and Aaron|strong="H00175"\w* \w that same|strong="H01931"\w* \w day|strong="H03117"\w* \v 7 \w and said|strong="H00559"\w* \w . . .|strong="H00582"\w* \w . . .|strong="H01992"\w* \w to [Moses]|strong="H00413"\w*, “\w We|strong="H00587"\w* \w are unclean|strong="H02931"\w* \w because of a dead body|strong="H00120"\w* \w . . .|strong="H05315"\w*, \w but why|strong="H04100"\w* \w should we be excluded|strong="H01639"\w* \w from|strong="H01115"\w* \w presenting|strong="H07126"\w* \w -|strong="H00853"\w* \w the LORD’s|strong="H03068"\w* \w offering|strong="H07133"\w* \w with|strong="H08432"\w* \w the other Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w at the appointed time|strong="H04150"\w*?”
\p \v 8 “\w Wait here|strong="H05975"\w* \w until I find out|strong="H08085"\w* \w what|strong="H04100"\w* \w the LORD|strong="H03068"\w* \w commands|strong="H06680"\w* concerning you,” \w Moses|strong="H04872"\w* \w replied|strong="H00559"\w* \w -|strong="H00413"\w*.
\p \v 9 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w -|strong="H00559"\w*, \v 10 “\w Tell|strong="H01696"\w* \w . . .|strong="H00413"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*: \w . . .|strong="H00559"\w* ‘\w When|strong="H03588"\w* \w any one|strong="H00376"\w* \w . . .|strong="H00376"\w* \w of you or|strong="H00176"\w* \w your descendants|strong="H01755"\w* \w is|strong="H01961"\w* \w unclean|strong="H02931"\w* \w because of a dead body|strong="H05315"\w*, \w or|strong="H00176"\w* \w is away|strong="H07350"\w* \w on a journey|strong="H01870"\w*, \w he may still observe|strong="H06213"\w* \w the Passover|strong="H06453"\w* \w to the LORD|strong="H03068"\w*. \v 11 \w Such people are to observe|strong="H06213"\w* \w it|strong="H00853"\w* \w at|strong="H00996"\w* \w twilight|strong="H06153"\w* \w on the fourteenth|strong="H00702"\w* \w . . .|strong="H06240"\w* \w day|strong="H03117"\w* \w of the second|strong="H08145"\w* \w month|strong="H02320"\w*. \w They are to eat [the lamb]|strong="H00398"\w*, \w together with|strong="H05921"\w* \w unleavened bread|strong="H04682"\w* \w and bitter herbs|strong="H04844"\w*; \v 12 \w they may not|strong="H03808"\w* \w leave|strong="H07604"\w* \w any of|strong="H04480"\w* \w it until|strong="H05704"\w* \w morning|strong="H01242"\w* \w or break|strong="H07665"\w* any of its \w bones|strong="H06106"\w*. \w . . .|strong="H03808"\w* \w They must observe|strong="H06213"\w* \w -|strong="H00853"\w* \w the Passover|strong="H06453"\w* \w according to all|strong="H03605"\w* \w its statutes|strong="H02708"\w*.
\p \v 13 \w But [if] a man|strong="H00376"\w* \w who|strong="H00834"\w* \w is|strong="H01931"\w* \w ceremonially clean|strong="H02889"\w* \w [and] is|strong="H01961"\w* \w not|strong="H03808"\w* \w on a journey|strong="H01870"\w* \w still fails|strong="H02308"\w* \w to observe|strong="H06213"\w* \w the Passover|strong="H06453"\w*, \w he must be cut off|strong="H03772"\w* \w . . .|strong="H05315"\w* \w . . .|strong="H01931"\w* \w from his people|strong="H05971"\w*, \w because|strong="H03588"\w* \w he did not|strong="H03808"\w* \w present|strong="H07126"\w* \w the LORD’s|strong="H03068"\w* \w offering|strong="H07133"\w* \w at its appointed time|strong="H04150"\w*. \w That|strong="H01931"\w* \w man|strong="H00376"\w* \w will bear|strong="H05375"\w* \w the consequences of his sin|strong="H02399"\w*.
\p \v 14 \w If|strong="H03588"\w* \w a foreigner|strong="H01616"\w* \w dwelling|strong="H01481"\w* \w among you|strong="H00854"\w* \w wants to observe|strong="H06213"\w* \w the Passover|strong="H06453"\w* \w to the LORD|strong="H03068"\w*, \w he is to do|strong="H06213"\w* \w so|strong="H03651"\w* \w according to the Passover|strong="H06453"\w* \w statute|strong="H02708"\w* \w and its ordinances|strong="H04941"\w*. \w You are to apply|strong="H01961"\w* \w the same|strong="H00259"\w* \w statute|strong="H02708"\w* \w to both the foreigner|strong="H01616"\w* \w and the native|strong="H00249"\w* \w of the land|strong="H00776"\w*.’”
\s1 The Cloud above the Tabernacle
\r (Exodus 40:34–38)
\p \v 15 \w On the day that|strong="H03117"\w* \w the tabernacle|strong="H04908"\w*, \w the Tent|strong="H00168"\w* \w of the Testimony|strong="H05715"\w*, \w was set up|strong="H06965"\w*, \w -|strong="H00853"\w* \w the cloud|strong="H06051"\w* \w -|strong="H00853"\w* \w covered|strong="H03680"\w* \w [it]|strong="H04908"\w* \w and appeared|strong="H04758"\w* \w like fire|strong="H00784"\w* \w above|strong="H05921"\w* \w the tabernacle|strong="H04908"\w* \w from evening|strong="H06153"\w* \w . . .|strong="H01961"\w* \w until|strong="H05704"\w* \w morning|strong="H01242"\w*. \v 16 \w It remained|strong="H01961"\w* \w that way|strong="H03651"\w* \w continually|strong="H08548"\w*; \w the cloud|strong="H06051"\w* \w would cover [the tabernacle] [by day]|strong="H03680"\w*,\f + \fr 9:16 \ft LXX, Syriac, and Vulgate; Hebrew does not include \fqa by day\f* \w and at night|strong="H03915"\w* \w it would appear|strong="H04758"\w* \w like fire|strong="H00784"\w*. \v 17 \w Whenever|strong="H06310"\w* \w the cloud|strong="H06051"\w* \w was lifted|strong="H05927"\w* \w from above|strong="H05921"\w* \w the Tent|strong="H00168"\w*, \w . . .|strong="H00310"\w* \w . . .|strong="H03651"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w would set out|strong="H05265"\w*, \w and wherever|strong="H04725"\w* \w -|strong="H00834"\w* \w the cloud|strong="H06051"\w* \w . . .|strong="H08033"\w* \w settled|strong="H07931"\w*, \w there|strong="H08033"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w would camp|strong="H02583"\w*. \v 18 \w At|strong="H05921"\w* \w the LORD’s|strong="H03068"\w* \w command|strong="H06310"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w set out|strong="H05265"\w*, \w and at|strong="H05921"\w* \w the LORD’s|strong="H03068"\w* \w command|strong="H06310"\w* \w they camped|strong="H02583"\w*. \w As long as|strong="H03605"\w* \w . . .|strong="H03117"\w* \w -|strong="H00834"\w* \w the cloud|strong="H06051"\w* \w remained|strong="H07931"\w* \w over|strong="H05921"\w* \w the tabernacle|strong="H04908"\w*, \w they remained encamped|strong="H02583"\w*.
\p \v 19 \w Even when the cloud|strong="H06051"\w* \w lingered|strong="H00748"\w* \w over|strong="H05921"\w* \w the tabernacle|strong="H04908"\w* \w for many|strong="H07227"\w* \w days|strong="H03117"\w*, \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w -|strong="H00853"\w* \w kept|strong="H08104"\w* \w the LORD’s|strong="H03068"\w* \w charge|strong="H04931"\w* \w and did not|strong="H03808"\w* \w set out|strong="H05265"\w*. \v 20 \w Sometimes|strong="H03426"\w* \w -|strong="H00834"\w* \w the cloud|strong="H06051"\w* \w remained|strong="H01961"\w* \w over|strong="H05921"\w* \w the tabernacle|strong="H04908"\w* \w for only a few|strong="H04557"\w* \w days|strong="H03117"\w*, \w and they would camp|strong="H02583"\w* \w at|strong="H05921"\w* \w the LORD’s|strong="H03068"\w* \w command|strong="H06310"\w* \w and set out|strong="H05265"\w* \w at|strong="H05921"\w* \w the LORD’s|strong="H03068"\w* \w command|strong="H06310"\w*. \v 21 \w Sometimes|strong="H03426"\w* \w -|strong="H00834"\w* \w the cloud|strong="H06051"\w* \w remained|strong="H01961"\w* \w only from evening|strong="H06153"\w* \w until|strong="H05704"\w* \w morning|strong="H01242"\w*, \w and when [it]|strong="H06051"\w* \w lifted|strong="H05927"\w* \w in the morning|strong="H01242"\w*, \w they would set out|strong="H05265"\w*. \w Whether|strong="H00176"\w* \w [it was] by day|strong="H03119"\w* \w or by night|strong="H03915"\w*, \w when the cloud|strong="H06051"\w* \w was taken up|strong="H05927"\w*, \w they would set out|strong="H05265"\w*.
\p \v 22 \w Whether|strong="H00176"\w* \w . . .|strong="H00176"\w* \w . . .|strong="H03117"\w* \w [the cloud] lingered|strong="H00748"\w* \w for two days|strong="H03117"\w*, \w a month|strong="H02320"\w*, \w or longer|strong="H00176"\w*, \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w camped|strong="H02583"\w* \w and did not|strong="H03808"\w* \w set out|strong="H05265"\w* \w as long as the cloud|strong="H06051"\w* \w remained|strong="H07931"\w* \w . . .|strong="H05921"\w* \w over|strong="H05921"\w* \w the tabernacle|strong="H04908"\w*; \w but when it was lifted|strong="H05927"\w*, \w they would set out|strong="H05265"\w*. \v 23 \w They camped|strong="H02583"\w* \w at|strong="H05921"\w* \w the LORD’s|strong="H03068"\w* \w command|strong="H06310"\w*, \w and they set out|strong="H05265"\w* \w -|strong="H00853"\w* \w at|strong="H05921"\w* \w the LORD’s|strong="H03068"\w* \w command|strong="H06310"\w*; \w they carried out|strong="H08104"\w* \w the LORD’s|strong="H03068"\w* \w charge|strong="H04931"\w* \w according to|strong="H05921"\w* \w His|strong="H03068"\w* \w command|strong="H06310"\w* \w through|strong="H03027"\w* \w Moses|strong="H04872"\w*.
\c 10
\s1 The Two Silver Trumpets
\p \v 1 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w -|strong="H00559"\w*, \v 2 “\w Make|strong="H06213"\w* \w two|strong="H08147"\w* \w trumpets|strong="H02689"\w* \w of hammered|strong="H04749"\w* \w silver|strong="H03701"\w* \w . . .|strong="H06213"\w* \w -|strong="H00853"\w* \w to be used|strong="H01961"\w* \w for calling|strong="H04744"\w* \w the congregation|strong="H05712"\w* \w and for having the camps|strong="H04264"\w* \w set out|strong="H04550"\w*. \w -|strong="H00853"\w* \v 3 \w When both are sounded|strong="H08628"\w*, \w the whole|strong="H03605"\w* \w congregation|strong="H05712"\w* \w is to assemble|strong="H03259"\w* \w before|strong="H00413"\w* \w you at|strong="H00413"\w* \w the entrance|strong="H06607"\w* \w to the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*. \v 4 \w But if|strong="H00518"\w* \w [only] one|strong="H00259"\w* \w is sounded|strong="H08628"\w*, \w then the leaders|strong="H05387"\w*, \w the heads|strong="H07218"\w* \w of the clans|strong="H00505"\w* \w of Israel|strong="H03478"\w*, \w are to gather|strong="H03259"\w* \w before you|strong="H00413"\w*.
\p \v 5 \w When you sound|strong="H08628"\w* \w short blasts|strong="H08643"\w*, \w the camps|strong="H04264"\w* \w that lie|strong="H02583"\w* \w on the east side|strong="H06924"\w* \w are to set out|strong="H05265"\w*. \v 6 \w When you sound|strong="H08628"\w* \w the short blasts|strong="H08643"\w* \w a second time|strong="H08145"\w*, \w the camps|strong="H04264"\w* \w that lie|strong="H02583"\w* \w on the south side|strong="H08486"\w* \w are to set out|strong="H05265"\w*. \w The blasts|strong="H08643"\w* \w are to signal them|strong="H08628"\w* \w to set out|strong="H04550"\w*. \v 7 \w To convene|strong="H06950"\w* \w -|strong="H00853"\w* \w the assembly|strong="H06951"\w*, \w you are to sound long blasts|strong="H08628"\w*, \w not|strong="H03808"\w* \w short ones|strong="H07321"\w*. \v 8 \w The sons|strong="H01121"\w* \w of Aaron|strong="H00175"\w*, \w the priests|strong="H03548"\w*, \w are to sound|strong="H08628"\w* \w the trumpets|strong="H02689"\w*. \w This shall be|strong="H01961"\w* \w a permanent|strong="H05769"\w* \w statute|strong="H02708"\w* for you \w [and] the generations to come|strong="H01755"\w*.
\p \v 9 \w When|strong="H03588"\w* \w you enter|strong="H00935"\w* \w into battle|strong="H04421"\w* \w in your land|strong="H00776"\w* \w against|strong="H05921"\w* \w an adversary|strong="H06862"\w* \w who attacks|strong="H06887"\w* \w you|strong="H00853"\w*, \w sound short blasts|strong="H07321"\w* \w on the trumpets|strong="H02689"\w*, \w and you will be remembered|strong="H02142"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w and saved|strong="H03467"\w* \w from your enemies|strong="H00341"\w*. \v 10 \w And on your joyous|strong="H08057"\w* \w occasions|strong="H03117"\w*, \w your appointed feasts|strong="H04150"\w*, \w and the beginning|strong="H07218"\w* \w of each month|strong="H02320"\w*, \w you are to blow|strong="H08628"\w* \w the trumpets|strong="H02689"\w* \w over|strong="H05921"\w* \w your burnt offerings|strong="H05930"\w* \w . . .|strong="H05921"\w* \w and peace|strong="H08002"\w* \w offerings|strong="H02077"\w* \w to serve|strong="H01961"\w* \w as a reminder|strong="H02146"\w* for you \w before|strong="H06440"\w* \w your God|strong="H00430"\w*. \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*.”
\s1 From Sinai to Paran
\p \v 11 \w -|strong="H01961"\w* \w On the twentieth|strong="H06242"\w* \w day|strong="H02320"\w* \w of the second|strong="H08145"\w* \w month|strong="H02320"\w* \w of the second|strong="H08145"\w* \w year|strong="H08141"\w*, \w the cloud|strong="H06051"\w* \w was lifted|strong="H05927"\w* \w from above|strong="H05921"\w* \w the tabernacle|strong="H04908"\w* \w of the Testimony|strong="H05715"\w*, \v 12 \w and the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w set out|strong="H05265"\w* \w from the Wilderness|strong="H04057"\w* \w of Sinai|strong="H05514"\w*, \w traveling from place to place|strong="H04550"\w* \w until the cloud|strong="H06051"\w* \w settled|strong="H07931"\w* \w in the Wilderness|strong="H04057"\w* \w of Paran|strong="H06290"\w*. \v 13 \w They set out|strong="H05265"\w* \w this first time|strong="H07223"\w* \w according to|strong="H05921"\w* \w the LORD’s|strong="H03068"\w* \w command|strong="H06310"\w* \w through|strong="H03027"\w* \w Moses|strong="H04872"\w*.
\p \v 14 \w First|strong="H07223"\w*, \w the divisions|strong="H06635"\w* \w of the camp|strong="H04264"\w* \w of Judah|strong="H01121"\w* \w . . .|strong="H03063"\w* \w set out|strong="H05265"\w* \w under their standard|strong="H01714"\w*, \w with Nahshon|strong="H05177"\w* \w son|strong="H01121"\w* \w of Amminadab|strong="H05992"\w* \w in command|strong="H05921"\w* \w . . .|strong="H06635"\w*. \v 15 \w Nethanel|strong="H05417"\w* \w son|strong="H01121"\w* \w of Zuar|strong="H06686"\w* \w was over|strong="H05921"\w* \w the division|strong="H06635"\w* \w of the tribe|strong="H04294"\w* \w vvv|strong="H01121"\w* \w of Issachar|strong="H03485"\w*, \v 16 \w and Eliab|strong="H00446"\w* \w son|strong="H01121"\w* \w of Helon|strong="H02497"\w* \w was over|strong="H05921"\w* \w the division|strong="H06635"\w* \w of the tribe|strong="H04294"\w* \w vvv|strong="H01121"\w* \w of Zebulun|strong="H02074"\w*. \v 17 \w Then the tabernacle|strong="H04908"\w* \w was taken down|strong="H03381"\w*, \w and the Gershonites|strong="H01121"\w* \w . . .|strong="H01648"\w* \w and the Merarites|strong="H01121"\w* \w . . .|strong="H04847"\w* \w set out|strong="H05265"\w*, \w transporting|strong="H05375"\w* \w [it]|strong="H04908"\w*.
\p \v 18 \w Then the divisions|strong="H06635"\w* \w of the camp|strong="H04264"\w* \w of Reuben|strong="H07205"\w* \w set out|strong="H05265"\w* \w under their standard|strong="H01714"\w*, \w with Elizur|strong="H00468"\w* \w son|strong="H01121"\w* \w of Shedeur|strong="H07707"\w* \w in command|strong="H05921"\w* \w . . .|strong="H06635"\w*. \v 19 \w Shelumiel|strong="H08017"\w* \w son|strong="H01121"\w* \w of Zurishaddai|strong="H06701"\w* \w was over|strong="H05921"\w* \w the division|strong="H06635"\w* \w of the tribe|strong="H04294"\w* \w vvv|strong="H01121"\w* \w vvv|strong="H06701"\w* \w of Simeon|strong="H08095"\w*, \v 20 \w and Eliasaph|strong="H00460"\w* \w son|strong="H01121"\w* \w of Deuel|strong="H01845"\w* \w was over|strong="H05921"\w* \w the division|strong="H06635"\w* \w of the tribe|strong="H04294"\w* \w of Gad|strong="H01121"\w* \w . . .|strong="H01410"\w*. \v 21 \w Then the Kohathites|strong="H06956"\w* \w set out|strong="H05265"\w*, \w transporting|strong="H05375"\w* \w the holy objects|strong="H04720"\w*; \w the tabernacle|strong="H04908"\w* \w was to be set up|strong="H06965"\w* \w -|strong="H00853"\w* \w before|strong="H05704"\w* \w their arrival|strong="H00935"\w*.
\p \v 22 \w Next, the divisions|strong="H06635"\w* \w of the camp|strong="H04264"\w* \w of Ephraim|strong="H01121"\w* \w . . .|strong="H00669"\w* \w set out|strong="H05265"\w* \w under their standard|strong="H01714"\w*, \w with Elishama|strong="H00476"\w* \w son|strong="H01121"\w* \w of Ammihud|strong="H05989"\w* \w in command|strong="H05921"\w* \w . . .|strong="H06635"\w*. \v 23 \w Gamaliel|strong="H01583"\w* \w son|strong="H01121"\w* \w of Pedahzur|strong="H06301"\w* \w . . .|strong="H06301"\w* \w was over|strong="H05921"\w* \w the division|strong="H06635"\w* \w of the tribe|strong="H04294"\w* \w of Manasseh|strong="H01121"\w* \w . . .|strong="H04519"\w*, \v 24 \w and Abidan|strong="H00027"\w* \w . . .|strong="H01121"\w* \w son|strong="H01121"\w* \w of Gideoni|strong="H01441"\w* \w was over|strong="H05921"\w* \w the division|strong="H06635"\w* \w of the tribe|strong="H04294"\w* \w of Benjamin|strong="H01144"\w*.
\p \v 25 \w Finally, the divisions|strong="H06635"\w* \w of the camp|strong="H04264"\w* \w of Dan|strong="H01121"\w* \w . . .|strong="H01835"\w* \w set out|strong="H05265"\w* \w under their standard|strong="H01714"\w*, \w serving as the rear guard|strong="H00622"\w* \w for all|strong="H03605"\w* \w units|strong="H04264"\w*, \w with Ahiezer|strong="H00295"\w* \w son|strong="H01121"\w* \w of Ammishaddai|strong="H05996"\w* \w in command|strong="H05921"\w* \w . . .|strong="H06635"\w*. \v 26 \w Pagiel|strong="H06295"\w* \w son|strong="H01121"\w* \w of Ocran|strong="H05918"\w* \w was over|strong="H05921"\w* \w the division|strong="H06635"\w* \w of the tribe|strong="H04294"\w* \w of Asher|strong="H01121"\w* \w . . .|strong="H00836"\w*, \v 27 \w and Ahira|strong="H00299"\w* \w son|strong="H01121"\w* \w of Enan|strong="H05881"\w* \w was over|strong="H05921"\w* \w the division|strong="H06635"\w* \w of the tribe|strong="H04294"\w* \w of Naphtali|strong="H01121"\w* \w . . .|strong="H05321"\w*.
\p \v 28 \w This|strong="H00428"\w* \w was the order of march|strong="H04550"\w* \w for the Israelite|strong="H01121"\w* \w . . .|strong="H03478"\w* \w divisions|strong="H06635"\w* \w as they set out|strong="H05265"\w*.
\p \v 29 \w Then Moses|strong="H04872"\w* \w said|strong="H00559"\w* \w to Hobab|strong="H02246"\w*, \w the son|strong="H01121"\w* \w of Moses’|strong="H04872"\w* \w father-in-law|strong="H02859"\w* \w Reuel|strong="H07467"\w*\f + \fr 10:29 \fqa Reuel \ft was also called \fqa Jethro\ft ; see Exodus 3:1.\f* \w the Midianite|strong="H04084"\w*, “\w We are|strong="H00587"\w* \w setting out|strong="H05265"\w* \w for|strong="H00413"\w* \w the place|strong="H04725"\w* \w of which|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w said|strong="H00559"\w*: ‘\w I will give it|strong="H05414"\w* to you.’ \w Come|strong="H01980"\w* \w with us|strong="H00854"\w*, \w and we will treat you well|strong="H03190"\w*, \w for|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w has promised|strong="H01696"\w* \w good|strong="H02896"\w* \w things to|strong="H05921"\w* \w Israel|strong="H03478"\w*.”
\p \v 30 “\w I will not|strong="H03808"\w* \w go|strong="H01980"\w*,” \w [Hobab] replied|strong="H00559"\w* \w -|strong="H00413"\w*. “\w Instead|strong="H03588"\w* \w . . .|strong="H00518"\w*, \w I am going back|strong="H01980"\w* \w to|strong="H00413"\w* \w my own land|strong="H00776"\w* \w . . .|strong="H00413"\w* \w and my own people|strong="H04138"\w*.”
\p \v 31 “\w Please|strong="H04994"\w* \w do not|strong="H00408"\w* \w leave us|strong="H05800"\w*,” \w -|strong="H00853"\w* \w Moses said|strong="H00559"\w*, “\w since|strong="H03588"\w* \w . . .|strong="H05921"\w* \w . . .|strong="H03651"\w* \w you know|strong="H03045"\w* \w where we should camp|strong="H02583"\w* \w in the wilderness|strong="H04057"\w*, \w and you can serve|strong="H01961"\w* as our \w eyes|strong="H05869"\w*. \v 32 \w -|strong="H01961"\w* \w If|strong="H03588"\w* \w you come|strong="H01980"\w* \w with us|strong="H05973"\w*, \w -|strong="H01961"\w* \w we will share|strong="H03190"\w* with you \w whatever|strong="H00834"\w* \w . . .|strong="H03190"\w* \w good things|strong="H02896"\w* \w . . .|strong="H01931"\w* \w the LORD|strong="H03068"\w* \w gives us|strong="H05973"\w*.”
\p \v 33 \w So they set out|strong="H05265"\w* \w on a three-day|strong="H07969"\w* \w . . .|strong="H03117"\w* \w journey|strong="H01870"\w* \w from the mountain|strong="H02022"\w* \w of the LORD|strong="H03068"\w*, \w with the ark|strong="H00727"\w* \w of the covenant|strong="H01285"\w* \w of the LORD|strong="H03068"\w* \w traveling|strong="H05265"\w* \w ahead of them|strong="H06440"\w* \w . . .|strong="H01870"\w* \w for those three|strong="H07969"\w* \w days|strong="H03117"\w* \w to seek|strong="H08446"\w* \w a resting place|strong="H04496"\w* for them. \v 34 \w And the cloud|strong="H06051"\w* \w of the LORD|strong="H03068"\w* \w was over them|strong="H05921"\w* \w by day|strong="H03119"\w* \w when they set out|strong="H05265"\w* \w from|strong="H04480"\w* \w the camp|strong="H04264"\w*.
\p \v 35 \w Whenever|strong="H01961"\w* \w the ark|strong="H00727"\w* \w set out|strong="H05265"\w*, \w Moses|strong="H04872"\w* \w would say|strong="H00559"\w*,
\b 
\q1 “\w Rise up|strong="H06965"\w*, \w O LORD|strong="H03068"\w*!
\q2 \w May Your enemies|strong="H00341"\w* \w be scattered|strong="H06327"\w*;
\q2 \w may those who hate You|strong="H08130"\w* \w flee|strong="H05127"\w* \w before You|strong="H06440"\w*.”
\p \v 36 \w And when it came to rest|strong="H05117"\w*, \w he would say|strong="H00559"\w*:
\b 
\q1 “\w Return|strong="H07725"\w*, \w O LORD|strong="H03068"\w*,
\q2 \w to the countless|strong="H07233"\w* \w thousands|strong="H00505"\w* \w of Israel|strong="H03478"\w*.”
\c 11
\s1 The Complaints of the People
\p \v 1 \w Soon|strong="H01961"\w* \w the people|strong="H05971"\w* \w began to complain|strong="H00596"\w* \w about their hardship|strong="H07451"\w* \w in the hearing|strong="H00241"\w* \w of the LORD|strong="H03068"\w*, \w and when He|strong="H03068"\w* \w heard [them]|strong="H08085"\w*, \w His anger|strong="H00639"\w* \w was kindled|strong="H02734"\w*, \w and fire|strong="H00784"\w* \w from the LORD|strong="H03068"\w* \w blazed|strong="H01197"\w* among them \w and consumed|strong="H00398"\w* \w the outskirts|strong="H07097"\w* \w of the camp|strong="H04264"\w*. \v 2 \w And the people|strong="H05971"\w* \w cried out|strong="H06817"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*, \w and he|strong="H04872"\w* \w prayed|strong="H06419"\w* \w to|strong="H00413"\w* \w the LORD|strong="H03068"\w*, \w and the fire|strong="H00784"\w* \w died down|strong="H08257"\w*. \v 3 \w So that|strong="H01931"\w* \w place|strong="H04725"\w* \w was called|strong="H07121"\w* \w . . .|strong="H08034"\w* \w Taberah|strong="H08404"\w*,\f + \fr 11:3 \fqa Taberah \ft means \fqa burning\ft .\f* \w because|strong="H03588"\w* \w the fire|strong="H00784"\w* \w of the LORD|strong="H03068"\w* \w had burned|strong="H01197"\w* among them.
\p \v 4 \w Meanwhile, the rabble|strong="H00628"\w* \w -|strong="H00834"\w* \w among them|strong="H07130"\w* \w had a strong craving for other food|strong="H00183"\w* \w . . .|strong="H08378"\w*, \w and|strong="H01571"\w* \w again|strong="H07725"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w wept|strong="H01058"\w* \w and said|strong="H00559"\w*, “\w Who|strong="H04310"\w* \w will feed us|strong="H00398"\w* \w meat|strong="H01320"\w*? \v 5 \w We remember|strong="H02142"\w* \w -|strong="H00853"\w* \w the fish|strong="H01710"\w* \w -|strong="H00834"\w* \w we ate|strong="H00398"\w* \w freely|strong="H02600"\w* \w -|strong="H00853"\w* \w in Egypt|strong="H04714"\w*, \w along with the cucumbers|strong="H07180"\w*, \w -|strong="H00853"\w* \w melons|strong="H00020"\w*, \w -|strong="H00853"\w* \w leeks|strong="H02682"\w*, \w -|strong="H00853"\w* \w onions|strong="H01211"\w*, \w -|strong="H00853"\w* \w and garlic|strong="H07762"\w*. \v 6 \w But now|strong="H06258"\w* \w our appetite|strong="H05315"\w* \w is gone|strong="H03002"\w*; \w there is nothing|strong="H00369"\w* \w . . .|strong="H03605"\w* \w to see|strong="H05869"\w* \w but|strong="H01115"\w* \w . . .|strong="H00413"\w* \w this manna|strong="H04478"\w*!”
\p \v 7 \w Now the manna|strong="H04478"\w* \w resembled coriander|strong="H01407"\w* \w . . .|strong="H01931"\w* \w seed|strong="H02233"\w*, \w and its appearance|strong="H05869"\w* \w was like that|strong="H05869"\w* \w of gum resin|strong="H00916"\w*. \v 8 \w The people|strong="H05971"\w* \w walked around|strong="H07751"\w* \w and gathered it|strong="H03950"\w*, \w ground it|strong="H02912"\w* \w on a handmill|strong="H07347"\w* \w or|strong="H00176"\w* \w crushed it|strong="H01743"\w* \w in a mortar|strong="H04085"\w*, \w then boiled|strong="H01310"\w* \w it in a cooking pot|strong="H06517"\w* \w or shaped it into|strong="H06213"\w* \w -|strong="H00853"\w* \w cakes|strong="H05692"\w*. \w . . .|strong="H01961"\w* \w It tasted|strong="H02940"\w* \w . . .|strong="H02940"\w* \w like pastry|strong="H03955"\w* \w baked with fine oil|strong="H08081"\w*. \v 9 \w When the dew|strong="H02919"\w* \w fell|strong="H03381"\w* \w on|strong="H05921"\w* \w the camp|strong="H04264"\w* \w at night|strong="H03915"\w*, \w the manna|strong="H04478"\w* \w would fall|strong="H03381"\w* \w with it|strong="H05921"\w*.
\s1 The Complaint of Moses
\p \v 10 \w Then Moses|strong="H04872"\w* \w -|strong="H00853"\w* \w heard|strong="H08085"\w* \w the people|strong="H05971"\w* \w of family|strong="H04940"\w* \w after family|strong="H00376"\w* \w weeping|strong="H01058"\w* \w at the entrances|strong="H06607"\w* \w to their tents|strong="H00168"\w*, \w and the anger|strong="H00639"\w* \w of the LORD|strong="H03068"\w* \w was kindled|strong="H02734"\w* \w greatly|strong="H03966"\w*, \w and Moses|strong="H04872"\w* \w was also displeased|strong="H05869"\w* \w . . .|strong="H07489"\w*.
\p \v 11 \w So Moses|strong="H04872"\w* \w . . .|strong="H00413"\w* \w asked|strong="H00559"\w* \w the LORD|strong="H03068"\w*, “\w Why|strong="H04100"\w* \w have You brought this trouble|strong="H07489"\w* \w on Your servant|strong="H05650"\w*? \w Why|strong="H04100"\w* \w have I not|strong="H03808"\w* \w found|strong="H04672"\w* \w favor|strong="H02580"\w* \w in Your sight|strong="H05869"\w*, \w that You have laid|strong="H07760"\w*\w . . .|strong="H00853"\w* \w upon me|strong="H05921"\w* \w the burden|strong="H04853"\w* \w of all|strong="H03605"\w* \w these|strong="H02088"\w* \w people|strong="H05971"\w*? \v 12 \w Did I|strong="H00595"\w* \w conceive|strong="H02029"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w these|strong="H02088"\w* \w . . .|strong="H00518"\w* \w people|strong="H05971"\w*? \w Did I|strong="H00595"\w* \w give them birth|strong="H03205"\w*, \w so that|strong="H03588"\w* \w You should tell|strong="H00559"\w* \w me|strong="H00413"\w*, ‘\w Carry them|strong="H05375"\w* \w in your bosom|strong="H02436"\w*, \w as|strong="H00834"\w* \w a nurse|strong="H00539"\w* \w carries|strong="H05375"\w* \w -|strong="H00853"\w* \w an infant|strong="H03243"\w*,’ \w to|strong="H05921"\w* \w the land|strong="H00127"\w* \w that|strong="H00834"\w* \w You swore to give|strong="H07650"\w* \w their fathers|strong="H00001"\w*?
\p \v 13 \w Where|strong="H00370"\w* \w can I get meat|strong="H01320"\w* \w for|strong="H05414"\w* \w all|strong="H03605"\w* \w these|strong="H02088"\w* \w people|strong="H05971"\w*? \w For|strong="H03588"\w* \w they keep crying out|strong="H01058"\w* \w to me|strong="H05921"\w* \w . . .|strong="H00559"\w*, ‘\w Give|strong="H05414"\w* us \w meat|strong="H01320"\w* \w to eat|strong="H00398"\w*!’
\p \v 14 \w I|strong="H00595"\w* \w cannot|strong="H03808"\w* \w . . .|strong="H03201"\w* \w carry|strong="H05375"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w these|strong="H02088"\w* \w people|strong="H05971"\w* \w by myself|strong="H00905"\w*; \w [it is]|strong="H03588"\w* \w too burdensome|strong="H03515"\w* \w for me|strong="H04480"\w*. \v 15 \w If|strong="H00518"\w* \w this is how|strong="H03602"\w* \w You|strong="H00859"\w* \w are going to treat|strong="H06213"\w* me, \w please|strong="H04994"\w* \w kill me right now|strong="H02026"\w*\w . . .|strong="H02026"\w* — \w if|strong="H00518"\w* \w I have found|strong="H04672"\w* \w favor|strong="H02580"\w* \w in Your eyes|strong="H05869"\w* — \w and let me not|strong="H00408"\w* \w see|strong="H07200"\w* \w my own wretchedness|strong="H07451"\w*.”
\s1 Seventy Elders Anointed
\p \v 16 \w Then the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*, “\w Bring|strong="H00622"\w* Me \w seventy|strong="H07657"\w* \w vvv|strong="H00376"\w* \w of the elders|strong="H02205"\w* \w of Israel|strong="H03478"\w* \w -|strong="H00834"\w* \w known to you|strong="H03045"\w* \w . . .|strong="H03588"\w* \w . . .|strong="H01992"\w* \w as leaders|strong="H02205"\w* \w and officers|strong="H07860"\w* \w of the people|strong="H05971"\w*. \w Bring|strong="H03947"\w* \w them|strong="H00853"\w* \w to|strong="H00413"\w* \w the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w* \w and have them stand|strong="H03320"\w* \w there|strong="H08033"\w* \w with you|strong="H05973"\w*.
\p \v 17 \w And I will come down|strong="H03381"\w* \w and speak|strong="H01696"\w* \w with you|strong="H05973"\w* \w there|strong="H08033"\w*, \w and I will take|strong="H00680"\w* \w some of|strong="H04480"\w* \w the Spirit|strong="H07307"\w* \w that [is]|strong="H00834"\w* \w on you|strong="H05921"\w* \w and put|strong="H07760"\w* \w [that Spirit] on them|strong="H05921"\w*. \w They will help you bear|strong="H05375"\w* \w . . .|strong="H00854"\w* \w the burden|strong="H04853"\w* \w of the people|strong="H05971"\w*, \w so that you|strong="H00859"\w* \w do not|strong="H03808"\w* \w have to bear it|strong="H05375"\w* \w by yourself|strong="H00905"\w*.
\p \v 18 \w And|strong="H00413"\w* \w say|strong="H00559"\w* \w to the people|strong="H05971"\w*: \w Consecrate yourselves|strong="H06942"\w* \w for tomorrow|strong="H04279"\w*, \w and you will eat|strong="H00398"\w* \w meat|strong="H01320"\w*, \w because|strong="H03588"\w* \w you have cried out|strong="H01058"\w* \w in the hearing|strong="H00241"\w* \w of the LORD|strong="H03068"\w*, \w saying|strong="H00559"\w*: ‘\w Who|strong="H04310"\w* \w will feed us|strong="H00398"\w* \w meat|strong="H01320"\w*? \w For|strong="H03588"\w* \w we were better off|strong="H02895"\w* \w in Egypt|strong="H04714"\w*!’ \w Therefore the LORD|strong="H03068"\w* \w will give|strong="H05414"\w* you \w meat|strong="H01320"\w*, \w and you will eat|strong="H00398"\w*. \v 19 \w You will eat it|strong="H00398"\w* \w . . .|strong="H03808"\w* \w not|strong="H03808"\w* \w for one|strong="H00259"\w* \w -|strong="H03117"\w* \w or two days|strong="H03117"\w*, \w nor|strong="H03808"\w* \w for five|strong="H02568"\w* \w -|strong="H03117"\w* \w -|strong="H03808"\w* \w or ten|strong="H06235"\w* \w -|strong="H03117"\w* \w -|strong="H03808"\w* \w or twenty|strong="H06242"\w* \w days|strong="H03117"\w*, \v 20 \w but for|strong="H05704"\w* \w a whole month|strong="H02320"\w* \w . . .|strong="H03117"\w*— \w until|strong="H05704"\w* \w -|strong="H00834"\w* \w it comes out|strong="H03318"\w* \w of your nostrils|strong="H00639"\w* \w and makes|strong="H01961"\w* you \w nauseous|strong="H02214"\w*— \w because|strong="H03282"\w* \w . . .|strong="H03588"\w* \w you have rejected|strong="H03988"\w* \w -|strong="H00853"\w* \w the LORD|strong="H03068"\w*, \w who|strong="H00834"\w* \w is among you|strong="H07130"\w*, \w and have cried out|strong="H01058"\w* \w before Him|strong="H06440"\w*, \w saying|strong="H00559"\w*, ‘\w Why|strong="H04100"\w* \w did we ever|strong="H02088"\w* \w leave|strong="H03318"\w* \w Egypt|strong="H04714"\w*?’”
\p \v 21 \w But Moses|strong="H04872"\w* \w replied|strong="H00559"\w*, “\w Here I am|strong="H00595"\w* \w among|strong="H07130"\w* \w -|strong="H00834"\w* \w 600,000 {}|strong="H08337"\w* \w . . .|strong="H03967"\w* \w . . .|strong="H00505"\w* \w men|strong="H05971"\w* \w on foot|strong="H07273"\w*, \w yet You|strong="H00859"\w* \w say|strong="H00559"\w*, ‘\w I will give|strong="H05414"\w* them \w meat|strong="H01320"\w*, \w and they will eat|strong="H00398"\w* \w for a month|strong="H02320"\w* \w . . .|strong="H03117"\w*.’ \v 22 \w If [all our] flocks|strong="H06629"\w* \w and herds|strong="H01241"\w* \w were slaughtered|strong="H07819"\w* for them, \w would they have enough|strong="H04672"\w*? \w Or if|strong="H00518"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the fish|strong="H01709"\w* \w in the sea|strong="H03220"\w* \w were caught|strong="H00622"\w* for them, \w would they have enough|strong="H04672"\w*?”
\p \v 23 \w The LORD|strong="H03068"\w* \w . . .|strong="H00413"\w* \w answered|strong="H00559"\w* \w Moses|strong="H04872"\w*, “\w Is the LORD’s|strong="H03068"\w* \w arm|strong="H03027"\w* \w too short|strong="H07114"\w*? \w Now|strong="H06258"\w* \w you will see|strong="H07200"\w* \w whether or|strong="H00518"\w* \w not|strong="H03808"\w* \w My word|strong="H01697"\w* \w will come to pass|strong="H07136"\w*.”
\p \v 24 \w So Moses|strong="H04872"\w* \w went out|strong="H03318"\w* \w and relayed|strong="H01696"\w* \w to|strong="H00413"\w* \w the people|strong="H05971"\w* \w -|strong="H00853"\w* \w the words|strong="H01697"\w* \w of the LORD|strong="H03068"\w*, \w and he gathered|strong="H00622"\w* \w seventy|strong="H07657"\w* \w . . .|strong="H00376"\w* \w of the elders|strong="H02205"\w* \w of the people|strong="H05971"\w* \w and had them stand|strong="H05975"\w* \w -|strong="H00853"\w* \w around|strong="H05439"\w* \w the tent|strong="H00168"\w*. \v 25 \w Then the LORD|strong="H03068"\w* \w came down|strong="H03381"\w* \w in the cloud|strong="H06051"\w* \w and spoke|strong="H01696"\w* \w to him|strong="H00413"\w*, \w and He took|strong="H00680"\w* \w some of|strong="H04480"\w* \w the Spirit|strong="H07307"\w* \w that|strong="H00834"\w* \w was on [Moses]|strong="H05921"\w* \w and placed|strong="H05414"\w* \w that Spirit on|strong="H05921"\w* \w the seventy|strong="H07657"\w* \w . . .|strong="H00376"\w* \w elders|strong="H02205"\w*. \w . . .|strong="H01961"\w* \w As the Spirit|strong="H07307"\w* \w rested|strong="H05117"\w* \w on them|strong="H05921"\w*, \w they prophesied|strong="H05012"\w* — \w but they never|strong="H03808"\w* \w did so again|strong="H03254"\w*.
\p \v 26 \w Two|strong="H08147"\w* \w men|strong="H00582"\w*, \w however, had remained|strong="H07604"\w* \w in the camp|strong="H04264"\w* — \w one|strong="H00259"\w* \w named|strong="H08034"\w* \w Eldad|strong="H00419"\w* \w . . .|strong="H08034"\w* \w and the other|strong="H08145"\w* \w Medad|strong="H04312"\w* — \w and the Spirit|strong="H07307"\w* \w rested|strong="H05117"\w* \w on them|strong="H05921"\w*. \w They|strong="H01992"\w* \w were among those listed|strong="H03789"\w*, \w but they had not|strong="H03808"\w* \w gone out|strong="H03318"\w* \w to the tent|strong="H00168"\w*, \w and they prophesied|strong="H05012"\w* \w in the camp|strong="H04264"\w*. \v 27 \w A young man|strong="H05288"\w* \w ran|strong="H07323"\w* \w and reported|strong="H05046"\w* \w to Moses|strong="H04872"\w*, \w . . .|strong="H00559"\w* “\w Eldad|strong="H00419"\w* \w and Medad|strong="H04312"\w* \w are prophesying|strong="H05012"\w* \w in the camp|strong="H04264"\w*.”
\p \v 28 \w Joshua|strong="H03091"\w* \w son|strong="H01121"\w* \w of Nun|strong="H05126"\w*, \w the attendant|strong="H08334"\w* \w to Moses|strong="H04872"\w* \w since youth|strong="H00979"\w*, \w spoke up|strong="H06030"\w* \w and said|strong="H00559"\w*, “\w Moses|strong="H04872"\w*, \w my lord|strong="H00113"\w*, \w stop them|strong="H03607"\w*!”
\p \v 29 \w But Moses|strong="H04872"\w* \w replied|strong="H00559"\w*, “\w Are you|strong="H00859"\w* \w jealous|strong="H07065"\w* on my \w account|strong="H04310"\w*? \w I wish that|strong="H05414"\w* \w all|strong="H03605"\w* \w the LORD’s|strong="H03068"\w* \w people|strong="H05971"\w* \w were prophets|strong="H05030"\w* \w and that|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w would place|strong="H05414"\w* \w His Spirit|strong="H07307"\w* \w on them|strong="H05921"\w*!”
\p \v 30 \w Then Moses|strong="H04872"\w* \w returned|strong="H00622"\w* \w to|strong="H00413"\w* \w the camp|strong="H04264"\w*, \w . . .|strong="H01931"\w* \w along with the elders|strong="H02205"\w* \w of Israel|strong="H03478"\w*.
\s1 The Quail and the Plague
\p \v 31 \w Now a wind|strong="H07307"\w* \w sent by|strong="H04480"\w* \w the LORD|strong="H03068"\w* \w came up|strong="H05265"\w*, \w drove in|strong="H01468"\w* \w quail|strong="H07958"\w* \w from|strong="H00854"\w* \w the sea|strong="H03220"\w*, \w and brought them|strong="H05203"\w* \w near|strong="H05921"\w* \w the camp|strong="H04264"\w*, \w about two cubits|strong="H00520"\w* \w above|strong="H05921"\w* \w the surface|strong="H06440"\w* \w of the ground|strong="H00776"\w*,\f + \fr 11:31 \ft Or \fqa up to two cubits deep\ft ; that is, approximately 3 feet or 91.4 centimeters\f* \w for a day’s|strong="H03117"\w* \w journey|strong="H01870"\w* \w in every direction|strong="H03541"\w* \w . . .|strong="H01870"\w* \w . . .|strong="H03117"\w* \w . . .|strong="H03541"\w* \w around|strong="H05439"\w* \w the camp|strong="H04264"\w*. \v 32 \w All|strong="H03605"\w* \w that|strong="H01931"\w* \w day|strong="H03117"\w* \w and night|strong="H03915"\w* \w . . .|strong="H03605"\w*, \w and all|strong="H03605"\w* \w the next|strong="H04283"\w* \w day|strong="H03117"\w*, \w the people|strong="H05971"\w* \w stayed up|strong="H06965"\w* \w gathering|strong="H00622"\w* \w -|strong="H00853"\w* \w the quail|strong="H07958"\w*. \w No one gathered|strong="H00622"\w* \w less than|strong="H04591"\w* \w ten|strong="H06235"\w* \w homers|strong="H02563"\w*,\f + \fr 11:32 \fqa 10 homers \ft is approximately 62.4 bushels or 2,200 liters.\f* \w and they spread them out|strong="H07849"\w* \w -|strong="H07849"\w* \w all around|strong="H05439"\w* \w the camp|strong="H04264"\w*.
\p \v 33 \w But while|strong="H05750"\w* \w the meat|strong="H01320"\w* \w was still between|strong="H00996"\w* \w their teeth|strong="H08127"\w*, \w before|strong="H02962"\w* \w it was chewed|strong="H03772"\w*, \w the anger|strong="H00639"\w* \w of the LORD|strong="H03068"\w* \w burned|strong="H02734"\w* \w against the people|strong="H05971"\w*, \w and the LORD|strong="H03068"\w* \w struck|strong="H05221"\w* \w them|strong="H05971"\w* \w with a severe|strong="H07227"\w*\w . . .|strong="H03966"\w* \w plague|strong="H04347"\w*. \v 34 \w So they called|strong="H07121"\w* \w -|strong="H00853"\w* \w -|strong="H08034"\w* \w that|strong="H01931"\w* \w place|strong="H04725"\w* \w vvv|strong="H06914"\w* \w Kibroth-hattaavah|strong="H06914"\w*,\f + \fr 11:34 \fqa Kibroth-hattaavah \ft means \fqa graves of craving\ft .\f* \w because|strong="H03588"\w* \w there|strong="H08033"\w* \w they buried|strong="H06912"\w* \w -|strong="H00853"\w* \w the people|strong="H05971"\w* \w who had craved other food|strong="H00183"\w*.
