\c 16
\s1 Korah’s Rebellion
\p \v 1 \w Now Korah|strong="H07141"\w* \w son|strong="H01121"\w* \w of Izhar|strong="H03324"\w*, \w the son|strong="H01121"\w* \w of Kohath|strong="H06955"\w* \w son|strong="H01121"\w* \w of Levi|strong="H03881"\w*, \w vvv|strong="H01121"\w* \w along with some Reubenites|strong="H07205"\w* — \w Dathan|strong="H01885"\w* \w and Abiram|strong="H00048"\w*, \w sons|strong="H01121"\w* \w of Eliab|strong="H00446"\w*, \w and On|strong="H00203"\w* \w son|strong="H01121"\w* \w of Peleth|strong="H06431"\w* — \w conducted|strong="H03947"\w* \v 2 \w a rebellion|strong="H06965"\w* \w against|strong="H06440"\w* \w Moses|strong="H04872"\w*, \w along with 250|strong="H02572"\w* \w . . .|strong="H03967"\w* \w men|strong="H00582"\w* \w . . .|strong="H00582"\w* \w vvv|strong="H01121"\w* \w of Israel|strong="H03478"\w* \w renowned|strong="H08034"\w* \w as leaders|strong="H05387"\w* \w of the congregation|strong="H05712"\w* \w and representatives|strong="H07148"\w* \w in the assembly|strong="H04150"\w*. \v 3 \w They came together|strong="H06950"\w* \w against|strong="H05921"\w* \w Moses|strong="H04872"\w* \w and|strong="H05921"\w* \w Aaron|strong="H00175"\w* \w and told them|strong="H00559"\w*, \w . . .|strong="H00413"\w* “\w [You have taken] too much|strong="H07227"\w* upon yourselves!\f + \fr 16:3 \ft Figuratively \fqa You have gone too far \ft or \fqa You have appropriated too much authority to yourselves\ft ; similarly in verse 7\f* \w For|strong="H03588"\w* \w everyone|strong="H03605"\w* \w in the entire|strong="H03605"\w* \w congregation|strong="H05712"\w* \w is holy|strong="H06918"\w*, \w and the LORD|strong="H03068"\w* \w is in their midst|strong="H08432"\w*. \w Why|strong="H04069"\w* \w then do you exalt|strong="H05375"\w* \w yourselves above|strong="H05921"\w* \w the assembly|strong="H06951"\w* \w of the LORD|strong="H03068"\w*?”
\p \v 4 \w When Moses|strong="H04872"\w* \w heard this|strong="H08085"\w*, \w he fell|strong="H05307"\w* \w facedown|strong="H05921"\w* \w . . .|strong="H06440"\w*. \v 5 \w Then he said|strong="H01696"\w* \w to|strong="H00413"\w* \w Korah|strong="H07141"\w* \w . . .|strong="H00413"\w* \w and all|strong="H03605"\w* \w his followers|strong="H05712"\w*, \w . . .|strong="H00559"\w* “\w Tomorrow morning|strong="H01242"\w* \w the LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w will reveal|strong="H03045"\w* \w who belongs|strong="H00834"\w* to Him\f + \fr 16:5 \ft LXX \fqa God has visited and knows those who are His\ft ; cited in 2 Timothy 2:19\f* \w and|strong="H00853"\w* \w who is holy|strong="H06918"\w*, \w and He will bring that person near|strong="H07126"\w* \w to Himself|strong="H00413"\w*. \w -|strong="H00853"\w* \w The one|strong="H00834"\w* \w He chooses|strong="H00977"\w* \w He will bring near|strong="H07126"\w* \w to Himself|strong="H00413"\w*. \v 6 \w [You,] Korah|strong="H07141"\w*, \w and all|strong="H03605"\w* \w your followers|strong="H05712"\w* \w are to do|strong="H06213"\w* \w as follows|strong="H02063"\w*: \w Take|strong="H03947"\w* \w censers|strong="H04289"\w*, \v 7 \w and tomorrow|strong="H04279"\w* \w you are to place|strong="H05414"\w* \w fire|strong="H00784"\w* \w and incense|strong="H07004"\w* \w -|strong="H05921"\w* in them \w -|strong="H07760"\w* \w in the presence|strong="H06440"\w* \w of the LORD|strong="H03068"\w*. \w Then the man|strong="H00376"\w* \w -|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w chooses|strong="H00977"\w* \w will be|strong="H01961"\w* \w the one|strong="H01931"\w* \w who is holy|strong="H06918"\w*. \w It is you sons|strong="H01121"\w* \w of Levi|strong="H03878"\w* \w who have taken too much|strong="H07227"\w* upon yourselves!”
\p \v 8 \w Moses|strong="H04872"\w* \w also said|strong="H00559"\w* \w to|strong="H00413"\w* \w Korah|strong="H07141"\w*, “\w Now|strong="H04994"\w* \w listen|strong="H08085"\w*, \w you sons|strong="H01121"\w* \w of Levi|strong="H03878"\w*! \v 9 \w Is it not enough|strong="H04592"\w* for \w you that|strong="H03588"\w* \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w* \w -|strong="H00853"\w* \w has separated you|strong="H00914"\w* \w from the congregation|strong="H05712"\w* \w of Israel|strong="H03478"\w* \w and brought you near|strong="H07126"\w* \w -|strong="H00853"\w* \w to Himself|strong="H00413"\w* \w to perform|strong="H05647"\w* \w -|strong="H00853"\w* \w the work|strong="H05656"\w* \w at the LORD’s|strong="H03068"\w* \w tabernacle|strong="H04908"\w*, \w and to stand|strong="H05975"\w* \w before|strong="H06440"\w* \w the congregation|strong="H05712"\w* \w to minister to them|strong="H08334"\w*? \v 10 \w He has brought you near|strong="H07126"\w*, \w -|strong="H00853"\w* \w -|strong="H00853"\w* \w [you] and all|strong="H03605"\w* \w your fellow|strong="H00251"\w* \w -|strong="H00854"\w* \w Levites|strong="H01121"\w* \w . . .|strong="H03878"\w*, \w but you are seeking|strong="H01245"\w* \w the priesthood|strong="H03550"\w* \w as well|strong="H01571"\w*. \v 11 \w Therefore|strong="H03651"\w*, \w it is you|strong="H00859"\w* \w and all|strong="H03605"\w* \w your followers|strong="H05712"\w* \w who have conspired|strong="H03259"\w* \w against|strong="H05921"\w* \w the LORD|strong="H03068"\w*! \w As for Aaron|strong="H00175"\w*, \w who|strong="H04100"\w* \w is he|strong="H01931"\w* \w that|strong="H03588"\w* \w you should grumble|strong="H03885"\w* \w against him|strong="H05921"\w*?”
