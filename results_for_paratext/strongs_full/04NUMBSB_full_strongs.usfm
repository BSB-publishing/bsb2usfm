\p \v 14 \w But the LORD|strong="H03068"\w* \w . . .|strong="H00413"\w* \w answered|strong="H00559"\w* \w Moses|strong="H04872"\w*, “\w If her father|strong="H00001"\w* \w had but spit|strong="H03417"\w* \w . . .|strong="H03417"\w* \w in her face|strong="H06440"\w*, \w would she not|strong="H03808"\w* \w have been in disgrace|strong="H03637"\w* \w for seven|strong="H07651"\w* \w days|strong="H03117"\w*? \w Let her be confined|strong="H05462"\w* \w outside|strong="H02351"\w* \w the camp|strong="H04264"\w* \w for seven|strong="H07651"\w* \w days|strong="H03117"\w*; \w after that|strong="H00310"\w* \w she may be brought back in|strong="H00622"\w*.”
\p \v 15 \w So Miriam|strong="H04813"\w* \w was confined|strong="H05462"\w* \w outside|strong="H02351"\w* \w the camp|strong="H04264"\w* \w for seven|strong="H07651"\w* \w days|strong="H03117"\w*, \w and the people|strong="H05971"\w* \w did not|strong="H03808"\w* \w move on|strong="H05265"\w* \w until|strong="H05704"\w* \w [she]|strong="H04813"\w* \w was brought in again|strong="H00622"\w*. \v 16 \w After that|strong="H00310"\w*, \w the people|strong="H05971"\w* \w set out|strong="H05265"\w* \w from Hazeroth|strong="H02698"\w* \w and camped|strong="H02583"\w* \w in the Wilderness|strong="H04057"\w* \w of Paran|strong="H06290"\w*.
\c 13
\s1 The Spies Explore Canaan
