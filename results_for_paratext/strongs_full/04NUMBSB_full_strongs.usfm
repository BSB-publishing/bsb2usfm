\p \v 16 \w From there|strong="H08033"\w* \w [they went on] to Beer|strong="H00876"\w*,\f + \fr 21:16 \fqa Beer \ft means \fqa well\ft .\f* \w . . .|strong="H01931"\w* \w the well|strong="H00875"\w* \w where|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to Moses|strong="H04872"\w*, “\w Gather|strong="H00622"\w* \w -|strong="H00853"\w* \w the people|strong="H05971"\w* \w so that I may give|strong="H05414"\w* them \w water|strong="H04325"\w*.” \v 17 \w Then|strong="H00227"\w* \w Israel|strong="H03478"\w* \w -|strong="H00853"\w* \w sang|strong="H07891"\w* \w this|strong="H02063"\w* \w song|strong="H07892"\w*:
