\li1 \v 40 \w Now the Canaanite|strong="H03669"\w* \w king|strong="H04428"\w* \w of Arad|strong="H06166"\w*, \w . . .|strong="H01931"\w* \w who lived|strong="H03427"\w* \w in the Negev|strong="H05045"\w* \w in the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*, \w heard|strong="H08085"\w* \w that the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w were coming|strong="H00935"\w*. \v 41 \w And [the Israelites] set out|strong="H05265"\w* \w from Mount|strong="H02022"\w* \w Hor|strong="H02023"\w* \w and camped|strong="H02583"\w* \w at Zalmonah|strong="H06758"\w*.
\li1 \v 42 \w They set out|strong="H05265"\w* \w from Zalmonah|strong="H06758"\w* \w and camped|strong="H02583"\w* \w at Punon|strong="H06325"\w*.
\li1 \v 43 \w They set out|strong="H05265"\w* \w from Punon|strong="H06325"\w* \w and camped|strong="H02583"\w* \w at Oboth|strong="H00088"\w*.
\li1 \v 44 \w They set out|strong="H05265"\w* \w from Oboth|strong="H00088"\w* \w and camped|strong="H02583"\w* \w vvv|strong="H05863"\w* \w at Iye-abarim|strong="H05863"\w* \w on the border|strong="H01366"\w* \w of Moab|strong="H04124"\w*.
