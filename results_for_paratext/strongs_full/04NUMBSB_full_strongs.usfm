\p \v 14 \w The name|strong="H08034"\w* \w vvv|strong="H00376"\w* \w of the Israelite|strong="H03478"\w* \w who was slain|strong="H05221"\w* \w -|strong="H00834"\w* \w -|strong="H05221"\w* \w with|strong="H00854"\w* \w the Midianite woman|strong="H04084"\w* \w was Zimri|strong="H02174"\w* \w son|strong="H01121"\w* \w of Salu|strong="H05543"\w*, \w the leader|strong="H05387"\w* \w of a Simeonite|strong="H08099"\w* \w family|strong="H00001"\w* \w . . .|strong="H01004"\w*. \v 15 \w And the name|strong="H08034"\w* \w of the slain|strong="H05221"\w* \w Midianite|strong="H04084"\w* \w woman|strong="H00802"\w* \w was Cozbi|strong="H03579"\w*, \w the daughter|strong="H01323"\w* \w of Zur|strong="H06698"\w*, \w a tribal|strong="H00523"\w* \w chief|strong="H07218"\w* \w of a Midianite|strong="H04080"\w* \w . . .|strong="H01931"\w* \w family|strong="H00001"\w* \w . . .|strong="H01004"\w*.
