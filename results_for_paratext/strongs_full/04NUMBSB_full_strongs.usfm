\li1 \v 20 \w The tribe|strong="H04294"\w* \w of Manasseh|strong="H04519"\w* \w will be next to it|strong="H05921"\w*. \w The leader|strong="H05387"\w* \w of the Manassites|strong="H01121"\w* \w . . .|strong="H04519"\w* \w is Gamaliel|strong="H01583"\w* \w son|strong="H01121"\w* \w of Pedahzur|strong="H06301"\w*, \v 21 \w and his division|strong="H06635"\w* \w numbers|strong="H06485"\w* \w 32,200|strong="H08147"\w* \w . . .|strong="H07970"\w* \w . . .|strong="H00505"\w* \w . . .|strong="H03967"\w*.
\li1 \v 22 \w [Next will be] the tribe|strong="H04294"\w* \w of Benjamin|strong="H01144"\w*. \w The leader|strong="H05387"\w* \w of the Benjamites|strong="H01121"\w* \w . . .|strong="H01144"\w* \w is Abidan|strong="H00027"\w* \w son|strong="H01121"\w* \w of Gideoni|strong="H01441"\w*, \v 23 \w and his division|strong="H06635"\w* \w numbers|strong="H06485"\w* \w 35,400|strong="H02568"\w* \w . . .|strong="H07970"\w* \w . . .|strong="H00505"\w* \w . . .|strong="H00702"\w* \w . . .|strong="H03967"\w*.
\pmo \v 24 \w The total|strong="H03605"\w* \w number of men|strong="H06485"\w* \w in the divisions|strong="H06635"\w* \w of the camp|strong="H04264"\w* \w of Ephraim|strong="H00669"\w* \w [is] 108,100|strong="H03967"\w* \w . . .|strong="H00505"\w*; \w . . .|strong="H08083"\w* \w . . .|strong="H00505"\w* \w . . .|strong="H03967"\w* \w they shall set out|strong="H05265"\w* \w third|strong="H07992"\w*.
\p \v 25 \w On the north side|strong="H06828"\w*, \w the divisions|strong="H06635"\w* \w of Dan|strong="H01835"\w* \w are to camp|strong="H04264"\w* \w under their standard|strong="H01714"\w*:
\li1 \w The leader|strong="H05387"\w* \w of the Danites|strong="H01121"\w* \w . . .|strong="H01835"\w* \w is Ahiezer|strong="H00295"\w* \w son|strong="H01121"\w* \w of Ammishaddai|strong="H05996"\w*, \v 26 \w and his division|strong="H06635"\w* \w numbers|strong="H06485"\w* \w 62,700|strong="H08147"\w* \w . . .|strong="H08346"\w* \w . . .|strong="H00505"\w* \w . . .|strong="H07651"\w* \w . . .|strong="H03967"\w*.
\li1 \v 27 \w The tribe|strong="H04294"\w* \w of Asher|strong="H00836"\w* \w will camp|strong="H02583"\w* \w next to it|strong="H05921"\w*. \w The leader|strong="H05387"\w* \w of the Asherites|strong="H01121"\w* \w . . .|strong="H00836"\w* \w is Pagiel|strong="H06295"\w* \w son|strong="H01121"\w* \w of Ocran|strong="H05918"\w*, \v 28 \w and his division|strong="H06635"\w* \w numbers|strong="H06485"\w* \w 41,500|strong="H00259"\w* \w . . .|strong="H00705"\w* \w . . .|strong="H00505"\w* \w . . .|strong="H02568"\w* \w . . .|strong="H03967"\w*.
\li1 \v 29 \w [Next will be] the tribe|strong="H04294"\w* \w of Naphtali|strong="H05321"\w*. \w The leader|strong="H05387"\w* \w of the Naphtalites|strong="H01121"\w* \w . . .|strong="H05321"\w* \w is Ahira|strong="H00299"\w* \w son|strong="H01121"\w* \w of Enan|strong="H05881"\w*, \v 30 \w and his division|strong="H06635"\w* \w numbers|strong="H06485"\w* \w 53,400|strong="H07969"\w* \w . . .|strong="H02572"\w* \w . . .|strong="H00505"\w* \w . . .|strong="H00702"\w* \w . . .|strong="H03967"\w*.
\pmo \v 31 \w The total|strong="H03605"\w* \w number of men|strong="H06485"\w* \w in the camp|strong="H04264"\w* \w of Dan|strong="H01835"\w* \w is 157,600|strong="H03967"\w* \w . . .|strong="H00505"\w* \w . . .|strong="H07651"\w* \w . . .|strong="H02572"\w* \w . . .|strong="H00505"\w* \w . . .|strong="H08337"\w* \w . . .|strong="H03967"\w*; \w they shall set out|strong="H05265"\w* \w last|strong="H00314"\w*, \w under their standards|strong="H01714"\w*.”
\p \v 32 \w These|strong="H00428"\w* \w are the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*, \w numbered|strong="H06485"\w* \w according to their families|strong="H00001"\w* \w . . .|strong="H01004"\w*. \w The total|strong="H03605"\w* \w of those counted|strong="H06485"\w* \w in the camps|strong="H04264"\w*, \w by their divisions|strong="H06635"\w*, \w was 603,550|strong="H08337"\w* \w . . .|strong="H03967"\w* \w . . .|strong="H00505"\w* \w . . .|strong="H07969"\w* \w . . .|strong="H00505"\w* \w . . .|strong="H02568"\w* \w . . .|strong="H03967"\w* \w . . .|strong="H02572"\w*. \v 33 \w But the Levites|strong="H03881"\w* \w were not|strong="H03808"\w* \w counted|strong="H06485"\w* \w among|strong="H08432"\w* \w the other Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*, \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had commanded|strong="H06680"\w* \w -|strong="H00853"\w* \w Moses|strong="H04872"\w*.
\p \v 34 \w So the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w did|strong="H06213"\w* \w everything|strong="H03605"\w* \w -|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w commanded|strong="H06680"\w* \w Moses|strong="H04872"\w*; \w they camped|strong="H02583"\w* \w under their standards|strong="H01714"\w* \w in this way|strong="H03651"\w* \w and set out|strong="H05265"\w* \w in the same way|strong="H03651"\w*, \w each man|strong="H00376"\w* \w with his clan|strong="H04940"\w* \w and|strong="H05921"\w* \w his family|strong="H00001"\w* \w . . .|strong="H01004"\w*.
\c 3
\s1 The Sons of Aaron
\r (Leviticus 10:1–7)
\p \v 1 \w This|strong="H00428"\w* \w is the account|strong="H08435"\w* \w of Aaron|strong="H00175"\w* \w and Moses|strong="H04872"\w* \w at the time|strong="H03117"\w* \w the LORD|strong="H03068"\w* \w spoke|strong="H01696"\w* \w with|strong="H00854"\w* \w Moses|strong="H04872"\w* \w on Mount|strong="H02022"\w* \w Sinai|strong="H05514"\w*.
\p \v 2 \w These|strong="H00428"\w* \w are the names|strong="H08034"\w* \w of the sons|strong="H01121"\w* \w of Aaron|strong="H00175"\w*: \w Nadab|strong="H05070"\w* \w the firstborn|strong="H01060"\w*, \w then Abihu|strong="H00030"\w*, \w Eleazar|strong="H00499"\w*, \w and Ithamar|strong="H00385"\w*. \v 3 \w These|strong="H00428"\w* \w [were] Aaron’s|strong="H00175"\w* \w -|strong="H08034"\w* \w sons|strong="H01121"\w*, \w the anointed|strong="H04886"\w* \w priests|strong="H03548"\w*, \w who|strong="H00834"\w* \w were ordained|strong="H04390"\w* \w . . .|strong="H03027"\w* \w to serve as priests|strong="H03547"\w*.
\p \v 4 \w Nadab|strong="H05070"\w* \w and Abihu, however|strong="H00030"\w*, \w died|strong="H04191"\w* \w in the presence of|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w when they offered|strong="H07126"\w* \w unauthorized|strong="H02114"\w*\f + \fr 3:4 \ft Or \fqa strange\f* \w fire|strong="H00784"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w in the Wilderness|strong="H04057"\w* \w of Sinai|strong="H05514"\w*. \w And since they had|strong="H01961"\w* \w no|strong="H03808"\w* \w sons|strong="H01121"\w*, \w only Eleazar|strong="H00499"\w* \w and Ithamar|strong="H00385"\w* \w served as priests|strong="H03547"\w* \w during|strong="H05921"\w* \w the lifetime|strong="H06440"\w* \w of their father|strong="H00001"\w* \w Aaron|strong="H00175"\w*.
\s1 The Duties of the Levites
\p \v 5 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00559"\w*, \v 6 “\w Bring|strong="H07126"\w* \w the tribe|strong="H04294"\w* \w of Levi|strong="H03881"\w* \w -|strong="H00853"\w* \w and present|strong="H05975"\w* \w them|strong="H00853"\w* \w to|strong="H06440"\w* \w Aaron|strong="H00175"\w* \w the priest|strong="H03548"\w* \w to assist him|strong="H08334"\w* \w -|strong="H00853"\w*. \v 7 \w They are to perform|strong="H08104"\w* \w -|strong="H00853"\w* \w duties for him|strong="H04931"\w* \w -|strong="H00853"\w* \w -|strong="H04931"\w* \w and for the whole|strong="H03605"\w* \w congregation|strong="H05712"\w* \w before|strong="H06440"\w* \w the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*, \w attending|strong="H05647"\w* \w -|strong="H00853"\w* \w to the service|strong="H05656"\w* \w of the tabernacle|strong="H04908"\w*. \v 8 \w They shall take care of|strong="H08104"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the furnishings|strong="H03627"\w* \w of the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w* \w and|strong="H00853"\w* \w fulfill obligations|strong="H04931"\w* \w for the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w by attending|strong="H05647"\w* \w -|strong="H00853"\w* \w to the service|strong="H05656"\w* \w of the tabernacle|strong="H04908"\w*.
\p \v 9 \w Assign|strong="H05414"\w* \w -|strong="H00853"\w* \w the Levites|strong="H03881"\w* \w to Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w*; \w they|strong="H01992"\w* \w have been given exclusively|strong="H05414"\w* \w . . .|strong="H05414"\w* to him\f + \fr 3:9 \ft Most MT manuscripts; some MT manuscripts, SP, and LXX (see also Numbers 8:16) \fqa to Me\f* \w from among|strong="H00854"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*. \v 10 \w So|strong="H00853"\w* \w you shall appoint|strong="H06485"\w* \w Aaron|strong="H00175"\w* \w -|strong="H00853"\w* \w and his sons|strong="H01121"\w* \w to carry out|strong="H08104"\w* \w -|strong="H00853"\w* \w the duties of the priesthood|strong="H03550"\w*; \w but any outsider|strong="H02114"\w* \w who approaches [the tabernacle]|strong="H07131"\w* \w must be put to death|strong="H04191"\w*.”
