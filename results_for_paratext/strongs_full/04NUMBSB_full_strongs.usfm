\p \v 1 \w -|strong="H01961"\w* \w On the day|strong="H03117"\w* \w Moses|strong="H04872"\w* \w finished|strong="H03615"\w* \w setting up|strong="H06965"\w* \w -|strong="H00853"\w* \w the tabernacle|strong="H04908"\w*, \w he anointed|strong="H04886"\w* \w -|strong="H00853"\w* \w and consecrated|strong="H06942"\w* \w it|strong="H00853"\w* \w -|strong="H00853"\w* \w and all|strong="H03605"\w* \w its furnishings|strong="H03627"\w*, \w along with|strong="H00853"\w* \w the altar|strong="H04196"\w* \w and|strong="H00853"\w* \w all|strong="H03605"\w* \w its utensils|strong="H03627"\w* \w -|strong="H04886"\w* \w -|strong="H06942"\w* \w -|strong="H00853"\w*. \v 2 \w And the leaders|strong="H05387"\w* \w of Israel|strong="H03478"\w*, \w the heads|strong="H07218"\w* \w of their families|strong="H00001"\w* \w . . .|strong="H01004"\w*, \w presented an offering|strong="H07126"\w*. \w These [men]|strong="H01992"\w* \w were the tribal|strong="H04294"\w* \w . . .|strong="H01992"\w* \w leaders|strong="H05387"\w* \w who had supervised|strong="H05975"\w* \w . . .|strong="H05921"\w* \w the registration|strong="H06485"\w*. \v 3 \w They brought|strong="H00935"\w* \w -|strong="H00853"\w* \w as their offering|strong="H07133"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w six|strong="H08337"\w* \w covered|strong="H06632"\w* \w carts|strong="H05699"\w* \w and twelve|strong="H08147"\w* \w . . .|strong="H06240"\w* \w oxen|strong="H01241"\w* — \w an ox|strong="H07794"\w* \w from each [leader]|strong="H00259"\w* \w and a cart|strong="H05699"\w* \w from|strong="H05921"\w* \w every two|strong="H08147"\w* \w leaders|strong="H05387"\w* — \w and presented|strong="H07126"\w* \w them|strong="H00853"\w* \w before|strong="H06440"\w* \w the tabernacle|strong="H04908"\w*.
