\s1 The Duties of the Kohathites
\r (Numbers 3:27–32; 1 Chronicles 23:12–20)
\p \v 1 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00413"\w* \w and Aaron|strong="H00175"\w* \w . . .|strong="H00559"\w*, \v 2 “\w Take|strong="H05375"\w* \w -|strong="H00853"\w* \w a census|strong="H07218"\w* \w vvv|strong="H01121"\w* \w of the Kohathites|strong="H06955"\w* \w among|strong="H08432"\w* \w vvv|strong="H01121"\w* \w the Levites|strong="H03878"\w* \w by their clans|strong="H04940"\w* \w and families|strong="H00001"\w* \w . . .|strong="H01004"\w*, \v 3 \w men from thirty|strong="H07970"\w* \w . . .|strong="H01121"\w* \w . . .|strong="H08141"\w* \w . . .|strong="H04605"\w* \w to|strong="H05704"\w* \w fifty|strong="H02572"\w* \w years old|strong="H01121"\w* \w . . .|strong="H08141"\w*— \w everyone|strong="H03605"\w* \w who is qualified|strong="H00935"\w* \w to serve|strong="H06635"\w* \w vvv|strong="H06213"\w* \w in the work|strong="H04399"\w* \w at the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*.
\p \v 4 \w This|strong="H02063"\w* \w service|strong="H05656"\w* \w of the Kohathites|strong="H01121"\w* \w . . .|strong="H06955"\w* \w at the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w* \w regards the most|strong="H06944"\w* \w holy things|strong="H06944"\w*. \v 5 \w Whenever the camp|strong="H04264"\w* \w sets out|strong="H05265"\w*, \w Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w* \w are to go in|strong="H00935"\w*, \w take down|strong="H03381"\w* \w -|strong="H00853"\w* \w the veil|strong="H06532"\w* \w of the curtain|strong="H04539"\w*, \w and cover|strong="H03680"\w* \w the ark|strong="H00727"\w* \w of the Testimony|strong="H05715"\w*\f + \fr 4:5 \ft That is, \fqa the ark of the covenant\f* with it \w -|strong="H00853"\w*. \v 6 \w They are to place|strong="H05414"\w* \w over|strong="H05921"\w* \w this a covering|strong="H03681"\w* \w vvv|strong="H05785"\w* \w of fine leather|strong="H08476"\w*,\f + \fr 4:6 \ft Possibly the hides of large aquatic mammals; also in verses 8, 10, 11, 12, 14, and 25; see Exodus 25:5.\f* \w spread|strong="H06566"\w* \w a solid|strong="H03632"\w* \w blue|strong="H08504"\w* \w cloth|strong="H00899"\w* \w over it|strong="H04605"\w*, \w and insert|strong="H07760"\w* \w its poles|strong="H00905"\w*.
\p \v 7 \w Over|strong="H05921"\w* \w the table|strong="H07979"\w* \w of the Presence|strong="H06440"\w* \w they are to spread|strong="H06566"\w* \w a blue|strong="H08504"\w* \w cloth|strong="H00899"\w* \w and place|strong="H05414"\w* \w the plates|strong="H07086"\w* \w -|strong="H00853"\w* \w and cups|strong="H03709"\w* \w -|strong="H00853"\w* \w on it|strong="H05921"\w*, \w along with|strong="H00853"\w* \w the bowls|strong="H04518"\w* \w -|strong="H00853"\w* \w and pitchers|strong="H07184"\w* \w for the drink offering|strong="H05262"\w*. \w The regular|strong="H08548"\w* \w bread|strong="H03899"\w* \w offering is to remain|strong="H01961"\w* \w on it|strong="H05921"\w*. \v 8 \w And they shall spread|strong="H06566"\w* \w a scarlet|strong="H08438"\w* \w . . .|strong="H08144"\w* \w cloth|strong="H00899"\w* \w over them|strong="H05921"\w*, \w cover|strong="H03680"\w* \w them|strong="H00853"\w* \w with|strong="H04372"\w* \w fine leather|strong="H08476"\w* \w . . .|strong="H05785"\w*, \w and insert|strong="H07760"\w* \w -|strong="H00853"\w* \w the poles|strong="H00905"\w*.
\p \v 9 \w They are to take|strong="H03947"\w* \w a blue|strong="H08504"\w* \w cloth|strong="H00899"\w* \w and cover|strong="H03680"\w* \w -|strong="H00853"\w* \w the lampstand|strong="H04501"\w* \w used for light|strong="H03974"\w*, \w together|strong="H00853"\w* \w with its lamps|strong="H05216"\w*, \w -|strong="H00853"\w* \w wick trimmers|strong="H04457"\w*, \w -|strong="H00853"\w* \w and trays|strong="H04289"\w*, \w -|strong="H00853"\w* \w -|strong="H03605"\w* \w as well as the jars|strong="H03627"\w* \w of oil|strong="H08081"\w* \w with which|strong="H00834"\w* \w to supply|strong="H08334"\w* it -. \v 10 \w Then they shall wrap|strong="H05414"\w* \w -|strong="H00853"\w* \w it|strong="H00853"\w* \w and all|strong="H03605"\w* \w its utensils|strong="H03627"\w* \w inside|strong="H00413"\w* \w a covering|strong="H04372"\w* \w of fine leather|strong="H08476"\w* \w . . .|strong="H05785"\w* \w and put|strong="H05414"\w* \w [it] on|strong="H05921"\w* \w the carrying frame|strong="H04132"\w*.
\p \v 11 \w Over|strong="H05921"\w* \w the gold|strong="H02091"\w* \w altar|strong="H04196"\w* \w they are to spread|strong="H06566"\w* \w a blue|strong="H08504"\w* \w cloth|strong="H00899"\w*, \w cover|strong="H03680"\w* \w it|strong="H00853"\w* \w with|strong="H04372"\w* \w fine leather|strong="H08476"\w* \w . . .|strong="H05785"\w*, \w and insert|strong="H07760"\w* \w -|strong="H00853"\w* \w the poles|strong="H00905"\w*. \v 12 \w They are to take|strong="H03947"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the utensils|strong="H03627"\w* \w for serving|strong="H08335"\w* \w -|strong="H00834"\w* \w -|strong="H08334"\w* in \w the sanctuary|strong="H06944"\w*, \w place them|strong="H05414"\w* \w in|strong="H00413"\w* \w a blue|strong="H08504"\w* \w cloth|strong="H00899"\w*, \w cover|strong="H03680"\w* \w them|strong="H00853"\w* \w with|strong="H04372"\w* \w fine leather|strong="H08476"\w* \w . . .|strong="H05785"\w*, \w and put them|strong="H05414"\w* \w on|strong="H05921"\w* \w the carrying frame|strong="H04132"\w*.
\p \v 13 \w Then they shall remove the ashes|strong="H01878"\w* \w -|strong="H00853"\w* \w from the bronze altar|strong="H04196"\w*, \w spread|strong="H06566"\w* \w a purple|strong="H00713"\w* \w cloth|strong="H00899"\w* \w over it|strong="H05921"\w*, \v 14 \w and place|strong="H05414"\w* \w on it|strong="H05921"\w* \w all|strong="H03605"\w* \w the vessels|strong="H03627"\w* \w -|strong="H00853"\w* \w -|strong="H00834"\w* \w used to serve|strong="H08334"\w* \w there|strong="H05921"\w*: \w -|strong="H00853"\w* \w the firepans|strong="H04289"\w*, \w -|strong="H00853"\w* \w meat forks|strong="H04207"\w*, \w -|strong="H00853"\w* \w shovels|strong="H03257"\w*, \w -|strong="H00853"\w* \w and sprinkling bowls|strong="H04219"\w*— \w all|strong="H03605"\w* \w the equipment|strong="H03627"\w* \w of the altar|strong="H04196"\w*. \w They are to spread|strong="H06566"\w* \w over it|strong="H05921"\w* \w a covering|strong="H03681"\w* \w of fine leather|strong="H08476"\w* \w . . .|strong="H05785"\w* \w and insert|strong="H07760"\w* \w the poles|strong="H00905"\w*.
\p \v 15 \w When Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w* \w have finished|strong="H03615"\w* \w covering|strong="H03680"\w* \w -|strong="H00853"\w* \w the holy objects|strong="H06944"\w* \w -|strong="H00853"\w* \w and all|strong="H03605"\w* \w their equipment|strong="H03627"\w*\w . . .|strong="H06944"\w*, \w as soon as the camp|strong="H04264"\w* \w . . .|strong="H00310"\w* \w . . .|strong="H03651"\w* \w is ready to move|strong="H05265"\w*, \w the Kohathites|strong="H01121"\w* \w . . .|strong="H06955"\w* \w shall come|strong="H00935"\w* \w and do the carrying|strong="H05375"\w*. \w But they must not|strong="H03808"\w* \w touch|strong="H05060"\w* \w . . .|strong="H00413"\w* \w the holy objects|strong="H06944"\w*, \w or they will die|strong="H04191"\w*. \w These|strong="H00428"\w* \w are the transportation duties|strong="H04853"\w* \w of the Kohathites|strong="H01121"\w* \w . . .|strong="H06955"\w* \w regarding the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*.
\p \v 16 \w Eleazar|strong="H00499"\w* \w son|strong="H01121"\w* \w of Aaron|strong="H00175"\w* \w the priest|strong="H03548"\w* \w shall oversee|strong="H06486"\w* \w the oil|strong="H08081"\w* \w for the light|strong="H03974"\w*, \w the fragrant|strong="H05561"\w* \w incense|strong="H07004"\w*, \w the daily|strong="H08548"\w* \w grain offering|strong="H04503"\w*, \w and the anointing|strong="H04888"\w* \w oil|strong="H08081"\w*. \w He has oversight|strong="H06486"\w* \w of the entire|strong="H03605"\w* \w tabernacle|strong="H04908"\w* \w and everything|strong="H03605"\w* \w -|strong="H00834"\w* in it, \w including the holy objects|strong="H06944"\w* \w and their utensils|strong="H03627"\w*.”
\p \v 17 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00413"\w* \w and Aaron|strong="H00175"\w* \w . . .|strong="H00559"\w*, \v 18 “\w Do not|strong="H00408"\w* \w allow the Kohathite|strong="H06956"\w* \w tribal|strong="H07626"\w* \w clans|strong="H04940"\w* \w to be cut off|strong="H03772"\w* \w -|strong="H00853"\w* \w from among|strong="H08432"\w* \w the Levites|strong="H03881"\w*. \v 19 \w In order that they may live|strong="H02421"\w* \w and not|strong="H03808"\w* \w die|strong="H04191"\w* \w when they come near|strong="H05066"\w* \w -|strong="H00853"\w* \w the most|strong="H06944"\w* \w holy things|strong="H06944"\w*, \w do|strong="H06213"\w* \w this|strong="H02063"\w* for them: \w Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w* \w are to go in|strong="H00935"\w* \w and assign|strong="H07760"\w* \w -|strong="H00853"\w* \w each man|strong="H00376"\w* \w . . .|strong="H00376"\w* \w . . .|strong="H05921"\w* \w his task|strong="H05656"\w* \w . . .|strong="H00413"\w* \w and what he is to carry|strong="H04853"\w*. \v 20 \w But [the Kohathites] are not|strong="H03808"\w* \w to go in|strong="H00935"\w* \w and look|strong="H07200"\w* \w at the holy objects|strong="H06944"\w*, \w even for a moment|strong="H01104"\w*, \w -|strong="H00853"\w* \w or they will die|strong="H04191"\w*.”
\s1 The Duties of the Gershonites
\r (Numbers 3:21–26; 1 Chronicles 23:7–11)
\p \v 21 \w And the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00559"\w*, \v 22 “\w Take a census|strong="H05375"\w* \w -|strong="H00853"\w* \w -|strong="H07218"\w* \w of the Gershonites|strong="H01121"\w* \w . . .|strong="H01648"\w* \w as well|strong="H01571"\w*, \w . . .|strong="H01992"\w* \w by their families|strong="H00001"\w* \w . . .|strong="H01004"\w* \w and clans|strong="H04940"\w*, \v 23 \w from thirty|strong="H07970"\w* \w -|strong="H01121"\w* \w -|strong="H08141"\w* \w -|strong="H04605"\w* \w to|strong="H05704"\w* \w fifty|strong="H02572"\w* \w years old|strong="H01121"\w* \w . . .|strong="H08141"\w*, \w counting|strong="H06485"\w* \w -|strong="H00853"\w* \w everyone|strong="H03605"\w* \w who comes|strong="H00935"\w* \w to serve|strong="H06633"\w*\w . . .|strong="H06635"\w*\w . . .|strong="H05647"\w* \w in the work|strong="H05656"\w* \w at the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*.
\p \v 24 \w This|strong="H02063"\w* \w is the service|strong="H05656"\w* \w of the Gershonite|strong="H01649"\w* \w clans|strong="H04940"\w* \w regarding work|strong="H05647"\w* \w and transport|strong="H04853"\w*: \v 25 \w They are to carry|strong="H05375"\w* \w -|strong="H00853"\w* \w the curtains|strong="H03407"\w* \w of the tabernacle|strong="H04908"\w*, \w -|strong="H00853"\w* \w the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w* \w with the covering|strong="H04372"\w* \w . . .|strong="H04372"\w* \w of fine leather|strong="H08476"\w* \w -|strong="H00834"\w* \w over|strong="H05921"\w* \w it|strong="H04605"\w*, \w -|strong="H00853"\w* \w the curtains|strong="H04539"\w* \w for the entrance|strong="H06607"\w* \w to the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*, \v 26 \w -|strong="H00853"\w* \w the curtains|strong="H07050"\w* \w of the courtyard|strong="H02691"\w*, \w and|strong="H00853"\w* \w the curtains|strong="H04539"\w* \w for the entrance|strong="H06607"\w* \w at the gate|strong="H08179"\w* \w of the courtyard|strong="H02691"\w* \w that|strong="H00834"\w* \w surrounds|strong="H05921"\w* \w the tabernacle|strong="H04908"\w* \w . . .|strong="H05921"\w* \w and altar|strong="H04196"\w*, \w . . .|strong="H05439"\w* \w -|strong="H00853"\w* \w along with their ropes|strong="H04340"\w* \w -|strong="H00853"\w* \w and all|strong="H03605"\w* \w the equipment|strong="H03627"\w* \w for their service|strong="H05656"\w*. \w -|strong="H00853"\w* \w [The Gershonites] will do|strong="H05647"\w* \w all|strong="H03605"\w* \w that|strong="H00834"\w* \w needs to be done|strong="H06213"\w* with these items.
\p \v 27 \w All|strong="H03605"\w* \w the service|strong="H05656"\w* \w of the Gershonites|strong="H01121"\w* \w . . .|strong="H01961"\w* \w . . .|strong="H01649"\w* — \w all|strong="H03605"\w* \w their transport duties|strong="H04853"\w* \w and|strong="H03605"\w* \w other work|strong="H05656"\w* — \w is to be done at|strong="H05921"\w* \w the direction|strong="H06310"\w* \w of Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w*; \w you are to assign|strong="H06485"\w* \w to them|strong="H05921"\w* \w all|strong="H03605"\w* \w that they are responsible|strong="H04931"\w* \w -|strong="H00853"\w* \w to carry|strong="H04853"\w*. \v 28 \w This|strong="H02063"\w* \w is the service|strong="H05656"\w* \w of the Gershonite|strong="H01121"\w* \w . . .|strong="H01649"\w* \w clans|strong="H04940"\w* \w at the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*, \w and their duties|strong="H04931"\w* \w shall be under the direction|strong="H03027"\w* \w of Ithamar|strong="H00385"\w* \w son|strong="H01121"\w* \w of Aaron|strong="H00175"\w* \w the priest|strong="H03548"\w*.
\s1 The Duties of the Merarites
\r (Numbers 3:33–37; 1 Chronicles 23:21–23)
\p \v 29 \w As for the sons|strong="H01121"\w* \w of Merari|strong="H04847"\w*, \w you are to number|strong="H06485"\w* \w them|strong="H00853"\w* \w by their clans|strong="H04940"\w* \w and families|strong="H00001"\w* \w . . .|strong="H01004"\w*, \v 30 \w from thirty|strong="H07970"\w* \w . . .|strong="H08141"\w* \w . . .|strong="H01121"\w* \w . . .|strong="H04605"\w* \w to|strong="H05704"\w* \w fifty|strong="H02572"\w* \w years old|strong="H01121"\w* \w . . .|strong="H08141"\w*, \w counting|strong="H06485"\w* \w everyone|strong="H03605"\w* \w who comes|strong="H00935"\w* \w to serve|strong="H06635"\w* \w . . .|strong="H05647"\w* \w -|strong="H00853"\w* \w in the work|strong="H05656"\w* \w of the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*.
\p \v 31 \w This|strong="H02063"\w* \w is the duty|strong="H04931"\w* \w for all|strong="H03605"\w* \w their service|strong="H05656"\w* \w at the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*: \w to carry|strong="H04853"\w* \w the frames|strong="H07175"\w* \w of the tabernacle|strong="H04908"\w* \w with its crossbars|strong="H01280"\w*, \w posts|strong="H05982"\w*, \w and bases|strong="H00134"\w*, \v 32 \w and the posts|strong="H05982"\w* \w of the surrounding|strong="H05439"\w* \w courtyard|strong="H02691"\w* \w with their bases|strong="H00134"\w*, \w tent pegs|strong="H03489"\w*, \w and ropes|strong="H04340"\w*, \w including all|strong="H03605"\w* \w their equipment|strong="H03627"\w* \w and everything|strong="H03605"\w* \w related to their use|strong="H05656"\w*. \w You shall assign|strong="H06485"\w* \w -|strong="H00853"\w* \w by name|strong="H08034"\w* \w the items|strong="H03627"\w* \w that they are responsible|strong="H04931"\w* \w to carry|strong="H04853"\w*.
\p \v 33 \w This|strong="H02063"\w* \w is the service|strong="H05656"\w* \w of the Merarite|strong="H01121"\w* \w . . .|strong="H04847"\w* \w clans|strong="H04940"\w* \w according to all|strong="H03605"\w* \w their work|strong="H05656"\w* \w at the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*, \w under the direction|strong="H03027"\w* \w of Ithamar|strong="H00385"\w* \w son|strong="H01121"\w* \w of Aaron|strong="H00175"\w* \w the priest|strong="H03548"\w*.”
\s1 The Numbering of the Levite Clans
\p \v 34 \w So Moses|strong="H04872"\w*, \w Aaron|strong="H00175"\w*, \w and the leaders|strong="H05387"\w* \w of the congregation|strong="H05712"\w* \w -|strong="H00853"\w* \w numbered|strong="H06485"\w* \w the Kohathites|strong="H01121"\w* \w . . .|strong="H06956"\w* \w by their clans|strong="H04940"\w* \w and families|strong="H00001"\w* \w . . .|strong="H01004"\w*, \v 35 \w everyone|strong="H03605"\w* \w from thirty|strong="H07970"\w* \w -|strong="H08141"\w* \w -|strong="H01121"\w* \w -|strong="H04605"\w* \w to|strong="H05704"\w* \w fifty|strong="H02572"\w* \w years old|strong="H01121"\w* \w . . .|strong="H08141"\w* \w who came|strong="H00935"\w* \w to serve|strong="H06635"\w* \w in the work|strong="H05656"\w* \w at the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*. \v 36 \w And those|strong="H01961"\w* \w numbered|strong="H06485"\w* \w by their clans|strong="H04940"\w* \w totaled 2,750|strong="H00505"\w* \w . . .|strong="H07651"\w* \w . . .|strong="H03967"\w* \w . . .|strong="H02572"\w*. \v 37 \w These|strong="H00428"\w* \w were counted|strong="H06485"\w* \w from the Kohathite|strong="H06956"\w* \w clans|strong="H04940"\w*, \w everyone|strong="H03605"\w* \w who could serve|strong="H05647"\w* \w at the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*. \w Moses|strong="H04872"\w* \w and Aaron|strong="H00175"\w* \w numbered|strong="H06485"\w* \w them|strong="H00834"\w* \w according to|strong="H05921"\w* \w the command|strong="H06310"\w* \w of the LORD|strong="H03068"\w* \w through|strong="H03027"\w* \w Moses|strong="H04872"\w*.
\p \v 38 \w Then the Gershonites|strong="H01121"\w* \w . . .|strong="H01648"\w* \w were numbered|strong="H06485"\w* \w by their clans|strong="H04940"\w* \w and families|strong="H00001"\w* \w . . .|strong="H01004"\w*, \v 39 \w everyone|strong="H03605"\w* \w from thirty|strong="H07970"\w* \w -|strong="H01121"\w* \w -|strong="H08141"\w* \w -|strong="H04605"\w* \w to|strong="H05704"\w* \w fifty|strong="H02572"\w* \w years old|strong="H01121"\w* \w . . .|strong="H08141"\w* \w who came|strong="H00935"\w* \w to serve|strong="H06635"\w* \w in the work|strong="H05656"\w* \w at the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*. \v 40 \w And those|strong="H01961"\w* \w numbered|strong="H06485"\w* \w by their clans|strong="H04940"\w* \w and families|strong="H00001"\w* \w . . .|strong="H01004"\w* \w totaled 2,630|strong="H00505"\w* \w . . .|strong="H08337"\w* \w . . .|strong="H03967"\w* \w . . .|strong="H07970"\w*. \v 41 \w These|strong="H00428"\w* \w were counted|strong="H06485"\w* \w vvv|strong="H01121"\w* \w from the Gershonite|strong="H01648"\w* \w clans|strong="H04940"\w* \w . . .|strong="H03605"\w* \w who served|strong="H05647"\w* \w at the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*, \w whom|strong="H00834"\w* \w Moses|strong="H04872"\w* \w and Aaron|strong="H00175"\w* \w counted|strong="H06485"\w* \w at|strong="H05921"\w* \w the LORD’s|strong="H03068"\w* \w command|strong="H06310"\w*.
