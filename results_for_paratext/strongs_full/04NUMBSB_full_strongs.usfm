\p \v 8 \w Then the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*, “\w Make|strong="H06213"\w* \w a fiery serpent|strong="H08314"\w* \w and mount|strong="H07760"\w* \w it|strong="H00853"\w* \w on|strong="H05921"\w* \w a pole|strong="H05251"\w*. \w . . .|strong="H01961"\w* \w When anyone|strong="H03605"\w* \w who is bitten|strong="H05391"\w* \w looks at it|strong="H07200"\w*, \w -|strong="H00853"\w* \w he will live|strong="H02421"\w*.” \v 9 \w So Moses|strong="H04872"\w* \w made|strong="H06213"\w* \w a bronze|strong="H05178"\w* \w snake|strong="H05175"\w* \w and mounted|strong="H07760"\w* \w it on|strong="H05921"\w* \w a pole|strong="H05251"\w*. \w . . .|strong="H01961"\w* \w If|strong="H00518"\w* \w anyone who|strong="H00376"\w* \w was bitten|strong="H05391"\w* \w looked|strong="H05027"\w* \w at|strong="H00413"\w* \w . . .|strong="H05175"\w* \w the bronze|strong="H05178"\w* \w snake|strong="H05175"\w* \w -|strong="H00853"\w*, \w he would live|strong="H02421"\w*.
\s1 The Journey to Moab
\p \v 10 \w Then the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w set out|strong="H05265"\w* \w and camped|strong="H02583"\w* \w at Oboth|strong="H00088"\w*. \v 11 \w They journeyed|strong="H05265"\w* \w from Oboth|strong="H00088"\w* \w and camped|strong="H02583"\w* \w vvv|strong="H05863"\w* \w at Iye-abarim|strong="H05863"\w* \w in the wilderness|strong="H04057"\w* \w -|strong="H00834"\w* \w opposite|strong="H05921"\w*\w . . .|strong="H06440"\w* \w Moab|strong="H04124"\w* \w to the east|strong="H04217"\w* \w . . .|strong="H08121"\w*. \v 12 \w From there|strong="H08033"\w* \w they set|strong="H05265"\w* \w out and camped|strong="H02583"\w* \w in the Valley|strong="H05158"\w* \w of Zered|strong="H02218"\w*. \v 13 \w From there|strong="H08033"\w* \w they moved on|strong="H05265"\w* \w and camped|strong="H02583"\w* \w on the other side|strong="H05676"\w* \w of the Arnon|strong="H00769"\w*, \w -|strong="H00834"\w* \w in the wilderness|strong="H04057"\w* \w that extends|strong="H03318"\w* \w into the Amorite|strong="H00567"\w* \w territory|strong="H01366"\w*.
\p \w Now|strong="H03588"\w* \w the Arnon|strong="H00769"\w* \w is the border|strong="H01366"\w* \w -|strong="H04124"\w* \w between|strong="H00996"\w* \w the Moabites|strong="H04124"\w* \w and|strong="H00996"\w* \w the Amorites|strong="H00567"\w*. \v 14 \w Therefore|strong="H05921"\w* \w . . .|strong="H03651"\w* \w it is stated|strong="H00559"\w* \w in the Book|strong="H05612"\w* \w of the Wars|strong="H04421"\w* \w of the LORD|strong="H03068"\w*\w . . .|strong="H00853"\w*:
