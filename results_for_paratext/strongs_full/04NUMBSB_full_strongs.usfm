\p \v 16 \w Then [the Gadites and Reubenites] approached|strong="H05066"\w* \w [Moses]|strong="H00413"\w* \w and said|strong="H00559"\w*, “\w We want to build|strong="H01129"\w* \w sheepfolds|strong="H01448"\w* \w . . .|strong="H06629"\w* \w here|strong="H06311"\w* \w for our livestock|strong="H04735"\w* \w and cities|strong="H05892"\w* \w for our little ones|strong="H02945"\w*. \v 17 \w But we|strong="H00587"\w* \w will arm ourselves|strong="H02502"\w* \w and be ready|strong="H02363"\w*\f + \fr 32:17 \ft LXX \fqa we will arm ourselves for battle\f* \w to go ahead of|strong="H06440"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w until|strong="H05704"\w* \w -|strong="H00834"\w* \w -|strong="H00518"\w* \w we have brought them|strong="H00935"\w* \w into|strong="H00413"\w* \w their place|strong="H04725"\w*. \w Meanwhile, our little ones|strong="H02945"\w* \w will remain|strong="H03427"\w* \w in the fortified|strong="H04013"\w* \w cities|strong="H05892"\w* \w for protection from|strong="H06440"\w* \w the inhabitants|strong="H03427"\w* \w of the land|strong="H00776"\w*. \v 18 \w We will not|strong="H03808"\w* \w return|strong="H07725"\w* \w to|strong="H00413"\w* \w our homes|strong="H01004"\w* \w until|strong="H05704"\w* \w every|strong="H00376"\w* \w Israelite|strong="H01121"\w* \w . . .|strong="H03478"\w* \w has taken possession of|strong="H05157"\w* \w his inheritance|strong="H05159"\w*. \v 19 \w Yet|strong="H03588"\w* \w we will not|strong="H03808"\w* \w have an inheritance|strong="H05157"\w* \w with them|strong="H00854"\w* \w across|strong="H05676"\w* \w the Jordan|strong="H03383"\w* \w and beyond|strong="H01973"\w*, \w because|strong="H03588"\w* \w . . .|strong="H00935"\w* \w our inheritance|strong="H05159"\w* \w has come to us|strong="H00413"\w* \w on the east|strong="H04217"\w* \w side|strong="H05676"\w* \w of the Jordan|strong="H03383"\w*.”
\p \v 20 \w Moses|strong="H04872"\w* \w replied|strong="H00559"\w* \w -|strong="H00413"\w*, “\w If|strong="H00518"\w* \w you will do|strong="H06213"\w* \w -|strong="H00853"\w* \w -|strong="H01697"\w* \w this|strong="H02088"\w*— \w if|strong="H00518"\w* \w you will arm yourselves|strong="H02502"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w for battle|strong="H04421"\w*, \v 21 \w and if every one|strong="H03605"\w* \w of your armed men|strong="H02502"\w* \w -|strong="H00853"\w* \w crosses|strong="H05674"\w* \w the Jordan|strong="H03383"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*, \w until|strong="H05704"\w* \w He has driven|strong="H03423"\w* \w -|strong="H00853"\w* \w His enemies|strong="H00341"\w* \w out before Him|strong="H06440"\w*, \v 22 \w then when the land|strong="H00776"\w* \w is subdued|strong="H03533"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*, \w -|strong="H00310"\w* \w you may return|strong="H07725"\w* \w and be|strong="H01961"\w* \w free|strong="H05355"\w* \w of obligation to the LORD|strong="H03068"\w* \w and to Israel|strong="H03478"\w*. \w And this|strong="H02063"\w* \w land|strong="H00776"\w* \w will belong|strong="H01961"\w* to you \w as a possession|strong="H00272"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*. \v 23 \w But if|strong="H00518"\w* \w you do not|strong="H03808"\w* \w do|strong="H06213"\w* \w this|strong="H03651"\w*, \w you will certainly|strong="H02009"\w* \w sin|strong="H02398"\w* \w against the LORD|strong="H03068"\w* — \w and be assured that|strong="H03045"\w* \w your sin|strong="H02403"\w* \w -|strong="H00834"\w* \w will find you out|strong="H04672"\w*. \w -|strong="H00853"\w* \v 24 \w Build|strong="H01129"\w* \w cities|strong="H05892"\w* for your \w little ones|strong="H02945"\w* \w and folds|strong="H01448"\w* \w for your flocks|strong="H06792"\w*, \w but do|strong="H06213"\w* \w what you have promised|strong="H03318"\w* \w . . .|strong="H06310"\w*.”
\p \v 25 \w The Gadites|strong="H01121"\w* \w . . .|strong="H01410"\w* \w and Reubenites|strong="H01121"\w* \w . . .|strong="H07205"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*, \w . . .|strong="H00559"\w* “\w Your servants|strong="H05650"\w* \w will do|strong="H06213"\w* \w just as|strong="H00834"\w* \w our lord|strong="H00113"\w* \w commands|strong="H06680"\w*. \v 26 \w Our children|strong="H02945"\w*, \w our wives|strong="H00802"\w*, \w our livestock|strong="H04735"\w*, \w and all|strong="H03605"\w* \w our animals|strong="H00929"\w* \w will remain|strong="H01961"\w* \w here|strong="H08033"\w* \w in the cities|strong="H05892"\w* \w of Gilead|strong="H01568"\w*. \v 27 \w But your servants|strong="H05650"\w* \w are equipped|strong="H02502"\w* \w for war|strong="H06635"\w*, \w and every man|strong="H03605"\w* \w will cross over|strong="H05674"\w* \w to the battle|strong="H04421"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*, \w just as|strong="H00834"\w* \w our lord|strong="H00113"\w* \w says|strong="H01696"\w*.”
\p \v 28 \w So Moses|strong="H04872"\w* \w gave orders|strong="H06680"\w* about them \w -|strong="H00853"\w* \w to Eleazar|strong="H00499"\w* \w the priest|strong="H03548"\w*, \w -|strong="H00853"\w* \w to Joshua|strong="H03091"\w* \w son|strong="H01121"\w* \w of Nun|strong="H05126"\w*, \w -|strong="H00853"\w* \w and to the family|strong="H00001"\w* \w leaders|strong="H07218"\w* \w of the tribes|strong="H04294"\w* \w vvv|strong="H01121"\w* \w of Israel|strong="H03478"\w*. \v 29 \w And Moses|strong="H04872"\w* \w said|strong="H00559"\w* \w to them|strong="H00413"\w*, “\w If|strong="H00518"\w* \w the Gadites|strong="H01121"\w* \w . . .|strong="H01410"\w* \w and Reubenites|strong="H01121"\w* \w . . .|strong="H07205"\w* \w cross|strong="H05674"\w* \w the Jordan|strong="H03383"\w* \w with you|strong="H00854"\w* \w -|strong="H00853"\w*, \w with every|strong="H03605"\w* \w man armed|strong="H02502"\w* \w for battle|strong="H04421"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*, \w and the land|strong="H00776"\w* \w is subdued|strong="H03533"\w* \w before you|strong="H06440"\w*, \w then you are to give|strong="H05414"\w* them \w -|strong="H00853"\w* \w the land|strong="H00776"\w* \w of Gilead|strong="H01568"\w* \w as a possession|strong="H00272"\w*. \v 30 \w But if|strong="H00518"\w* \w they do not|strong="H03808"\w* \w arm themselves|strong="H02502"\w* \w [and] go across|strong="H05674"\w* \w with you|strong="H00854"\w*, \w then they must accept their possession|strong="H00270"\w* \w among you|strong="H08432"\w* \w in the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*.”
\p \v 31 \w The Gadites|strong="H01121"\w* \w . . .|strong="H01410"\w* \w and Reubenites|strong="H01121"\w* \w . . .|strong="H07205"\w* \w . . .|strong="H00559"\w* \w -|strong="H00853"\w* \w replied|strong="H06030"\w*, “\w As|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w has spoken|strong="H01696"\w* \w to|strong="H00413"\w* \w your servants|strong="H05650"\w*, \w so|strong="H03651"\w* \w we will do|strong="H06213"\w*. \v 32 \w We|strong="H05168"\w* \w will cross over|strong="H05674"\w* \w into the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w* \w armed|strong="H02502"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*, \w that|strong="H00854"\w* \w we may have our inheritance|strong="H05159"\w* \w . . .|strong="H00272"\w* \w on this side|strong="H05676"\w* \w of the Jordan|strong="H03383"\w*.”
\p \v 33 \w So Moses|strong="H04872"\w* \w gave|strong="H05414"\w* to \w the Gadites|strong="H01121"\w* \w . . .|strong="H01410"\w*, \w to the Reubenites|strong="H01121"\w* \w . . .|strong="H07205"\w*, \w and to the half-tribe|strong="H02677"\w* \w . . .|strong="H07626"\w* \w of Manasseh|strong="H04519"\w* \w son|strong="H01121"\w* \w of Joseph|strong="H03130"\w* \w -|strong="H00853"\w* \w the kingdom|strong="H04467"\w* \w of Sihon|strong="H05511"\w* \w king|strong="H04428"\w* \w of the Amorites|strong="H00567"\w* \w -|strong="H00853"\w* \w and the kingdom|strong="H04467"\w* \w of Og|strong="H05747"\w* \w king|strong="H04428"\w* \w of Bashan|strong="H01316"\w* — \w the land|strong="H00776"\w* \w including its cities|strong="H05892"\w* \w and the territory|strong="H01367"\w* \w surrounding|strong="H05439"\w* \w them|strong="H05892"\w* \w . . .|strong="H00776"\w*.
\p \v 34 \w And the Gadites|strong="H01121"\w* \w . . .|strong="H01410"\w* \w -|strong="H00853"\w* \w built up|strong="H01129"\w* \w Dibon|strong="H01769"\w*, \w -|strong="H00853"\w* \w Ataroth|strong="H05852"\w*, \w -|strong="H00853"\w* \w Aroer|strong="H06177"\w*, \v 35 \w -|strong="H00853"\w* \w vvv|strong="H05855"\w* \w Atroth-shophan|strong="H05855"\w*, \w -|strong="H00853"\w* \w Jazer|strong="H03270"\w*, \w Jogbehah|strong="H03011"\w*, \v 36 \w -|strong="H00853"\w* \w vvv|strong="H01039"\w* \w Beth-nimrah|strong="H01039"\w*, \w -|strong="H00853"\w* \w vvv|strong="H01028"\w* \w and Beth-haran|strong="H01028"\w* \w as fortified|strong="H04013"\w* \w cities|strong="H05892"\w*, \w and they built folds|strong="H01448"\w* \w for their flocks|strong="H06629"\w*.
\p \v 37 \w The Reubenites|strong="H01121"\w* \w . . .|strong="H07205"\w* \w built up|strong="H01129"\w* \w -|strong="H00853"\w* \w Heshbon|strong="H02809"\w*, \w -|strong="H00853"\w* \w Elealeh|strong="H00500"\w*, \w -|strong="H00853"\w* \w Kiriathaim|strong="H07156"\w*, \v 38 \w -|strong="H00853"\w* \w as well as Nebo|strong="H05015"\w* \w -|strong="H00853"\w* \w vvv|strong="H01186"\w* \w and Baal-meon|strong="H01186"\w* \w (whose names|strong="H08034"\w* \w -|strong="H00853"\w* \w were changed|strong="H05437"\w*), \w and Sibmah|strong="H07643"\w*. \w And they renamed|strong="H07121"\w* \w . . .|strong="H08034"\w* \w -|strong="H00853"\w* \w -|strong="H08034"\w* \w the cities|strong="H05892"\w* \w -|strong="H00834"\w* \w they rebuilt|strong="H01129"\w*.
\p \v 39 \w The descendants|strong="H01121"\w* \w of Machir|strong="H04353"\w* \w son|strong="H01121"\w* \w of Manasseh|strong="H04519"\w* \w went|strong="H01980"\w* \w to Gilead|strong="H01568"\w*, \w captured it|strong="H03920"\w*, \w and drove out|strong="H03423"\w* \w -|strong="H00853"\w* \w the Amorites|strong="H00567"\w* \w who were|strong="H00834"\w* there. \v 40 \w So Moses|strong="H04872"\w* \w -|strong="H00853"\w* \w gave|strong="H05414"\w* \w Gilead|strong="H01568"\w* \w to the clan of Machir|strong="H04353"\w* \w son|strong="H01121"\w* \w of Manasseh|strong="H04519"\w*, \w and they settled|strong="H03427"\w* there. \v 41 \w Jair|strong="H02971"\w*, \w a descendant|strong="H01121"\w* \w of Manasseh|strong="H04519"\w*, \w went|strong="H01980"\w* \w and captured|strong="H03920"\w* \w -|strong="H00853"\w* \w their villages|strong="H02333"\w* \w and called|strong="H07121"\w* \w -|strong="H00853"\w* \w them|strong="H02334"\w* \w Havvoth-jair|strong="H02334"\w*.\f + \fr 32:41 \fqa Havvoth-jair \ft means \fqa the villages of Jair\ft .\f* \v 42 \w And Nobah|strong="H05025"\w* \w went|strong="H01980"\w* \w and captured|strong="H03920"\w* \w -|strong="H00853"\w* \w Kenath|strong="H07079"\w* \w -|strong="H00853"\w* \w and its villages|strong="H01323"\w* \w and called|strong="H07121"\w* it \w Nobah|strong="H05025"\w*, \w after his own name|strong="H08034"\w*.
\c 33
\s1 Forty-Two Journeys of the Israelites
\p \v 1 \w These|strong="H00428"\w* \w [are] the journeys|strong="H04550"\w* \w vvv|strong="H01121"\w* \w of the Israelites|strong="H03478"\w* \w when|strong="H00834"\w* \w they came out|strong="H03318"\w* \w of the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w* \w by their divisions|strong="H06635"\w* \w under the leadership|strong="H03027"\w* \w of Moses|strong="H04872"\w* \w and Aaron|strong="H00175"\w*. \v 2 \w At|strong="H05921"\w* \w the LORD’s|strong="H03068"\w* \w command|strong="H06310"\w*, \w Moses|strong="H04872"\w* \w -|strong="H00853"\w* \w recorded|strong="H03789"\w* \w the stages|strong="H04161"\w* \w of their journey|strong="H04550"\w*. \w These|strong="H00428"\w* \w are the stages|strong="H04550"\w* \w listed by their starting points|strong="H04161"\w*:
\b 
\li1 \v 3 \w On the fifteenth|strong="H02568"\w* \w . . .|strong="H06240"\w* \w day|strong="H03117"\w* \w -|strong="H02320"\w* \w of the first|strong="H07223"\w* \w month|strong="H02320"\w*, \w on|strong="H07223"\w* \w the day after|strong="H04283"\w* \w the Passover|strong="H06453"\w*, \w [the Israelites] set out|strong="H05265"\w* \w from Rameses|strong="H07486"\w*. \w [They]|strong="H01121"\w* \w . . .|strong="H03478"\w* \w marched out|strong="H03318"\w* \w defiantly|strong="H03027"\w* \w . . .|strong="H07311"\w*\f + \fr 33:3 \ft Or \fqa marched out boldly\ft ; literally \fqa marched out with an upraised hand\f* \w in full view|strong="H05869"\w* \w of all|strong="H03605"\w* \w the Egyptians|strong="H04713"\w*, \v 4 \w [who]|strong="H04713"\w* \w were burying|strong="H06912"\w* \w -|strong="H00853"\w* \w -|strong="H00834"\w* \w all|strong="H03605"\w* \w [their] firstborn|strong="H01060"\w*, \w whom the LORD|strong="H03068"\w* \w had struck down|strong="H05221"\w* among them; \w for the LORD|strong="H03068"\w* \w had executed|strong="H06213"\w* \w judgment|strong="H08201"\w* \w against their gods|strong="H00430"\w*. \v 5 \w The Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w set out|strong="H05265"\w* \w from Rameses|strong="H07486"\w* \w and camped|strong="H02583"\w* \w at Succoth|strong="H05523"\w*.
\li1 \v 6 \w They set out|strong="H05265"\w* \w from Succoth|strong="H05523"\w* \w and camped|strong="H02583"\w* \w at Etham|strong="H00864"\w*, \w -|strong="H00834"\w* \w on the edge|strong="H07097"\w* \w of the wilderness|strong="H04057"\w*.
\li1 \v 7 \w They set out|strong="H05265"\w* \w from Etham|strong="H00864"\w* \w and turned back|strong="H07725"\w* \w to|strong="H05921"\w* \w vvv|strong="H06367"\w* \w Pi-hahiroth|strong="H06367"\w*, \w -|strong="H00834"\w* \w opposite|strong="H05921"\w* \w . . .|strong="H06440"\w* \w vvv|strong="H01189"\w* \w Baal-zephon|strong="H01189"\w*, \w and they camped|strong="H02583"\w* \w near|strong="H06440"\w* \w Migdol|strong="H04024"\w*.
\li1 \v 8 \w They set out|strong="H05265"\w* \w from|strong="H06440"\w* \w Pi-hahiroth|strong="H06367"\w*\f + \fr 33:8 \ft Some Hebrew manuscripts, SP, and Vulgate; see verse 7; most MT manuscripts \fqa Hahiroth\f* \w and crossed|strong="H05674"\w* \w through|strong="H08432"\w* \w the sea|strong="H03220"\w*, \w into the wilderness|strong="H04057"\w*, \w and they journeyed three days|strong="H07969"\w* \w . . .|strong="H03117"\w* \w . . .|strong="H01980"\w* \w . . .|strong="H01870"\w* \w into the Wilderness|strong="H04057"\w* \w of Etham|strong="H00864"\w* \w and camped|strong="H02583"\w* \w at Marah|strong="H04785"\w*.
\li1 \v 9 \w They set out|strong="H05265"\w* \w from Marah|strong="H04785"\w* \w and came|strong="H00935"\w* \w to Elim|strong="H00362"\w* \w . . .|strong="H00362"\w*, \w where there were twelve|strong="H08147"\w* \w . . .|strong="H06240"\w* \w springs|strong="H05869"\w* \w . . .|strong="H04325"\w* \w and seventy|strong="H07657"\w* \w palm trees|strong="H08558"\w*, \w and they camped|strong="H02583"\w* \w there|strong="H08033"\w*.
\li1 \v 10 \w They set out|strong="H05265"\w* \w from Elim|strong="H00362"\w* \w and camped|strong="H02583"\w* \w by|strong="H05921"\w* \w the Red|strong="H05488"\w* \w Sea|strong="H03220"\w*.\f + \fr 33:10 \ft Or \fqa the Sea of Reeds\ft ; also in verse 11\f*
\li1 \v 11 \w They set out|strong="H05265"\w* \w from the Red|strong="H05488"\w* \w Sea|strong="H03220"\w* \w and camped|strong="H02583"\w* \w in the Desert|strong="H04057"\w* \w of Sin|strong="H05512"\w*.\f + \fr 33:11 \ft The geographical name \fqa Sin \ft is related to \fqa Sinai \ft and should not be mistaken for the English word \fqa sin\ft ; also in verse 12.\f*
\li1 \v 12 \w They set out|strong="H05265"\w* \w from the Desert|strong="H04057"\w* \w of Sin|strong="H05512"\w* \w and camped|strong="H02583"\w* \w at Dophkah|strong="H01850"\w*.
\li1 \v 13 \w They set out|strong="H05265"\w* \w from Dophkah|strong="H01850"\w* \w and camped|strong="H02583"\w* \w at Alush|strong="H00442"\w*.
\li1 \v 14 \w They set out|strong="H05265"\w* \w from Alush|strong="H00442"\w* \w and camped|strong="H02583"\w* \w at Rephidim|strong="H07508"\w*, \w where|strong="H08033"\w* \w there was|strong="H01961"\w* \w no|strong="H03808"\w* \w water|strong="H04325"\w* \w for the people|strong="H05971"\w* \w to drink|strong="H08354"\w*.
\li1 \v 15 \w They set out|strong="H05265"\w* \w from Rephidim|strong="H07508"\w* \w and camped|strong="H02583"\w* \w in the Wilderness|strong="H04057"\w* \w of Sinai|strong="H05514"\w*.
\li1 \v 16 \w They set out|strong="H05265"\w* \w from the Wilderness|strong="H04057"\w* \w of Sinai|strong="H05514"\w* \w and camped|strong="H02583"\w* \w vvv|strong="H06914"\w* \w at Kibroth-hattaavah|strong="H06914"\w*.
\li1 \v 17 \w They set out|strong="H05265"\w* \w from|strong="H06914"\w* \w Kibroth-hattaavah|strong="H06914"\w* \w and camped|strong="H02583"\w* \w at Hazeroth|strong="H02698"\w*.
\li1 \v 18 \w They set out|strong="H05265"\w* \w from Hazeroth|strong="H02698"\w* \w and camped|strong="H02583"\w* \w at Rithmah|strong="H07575"\w*.
\b 
\li1 \v 19 \w They set out|strong="H05265"\w* \w from Rithmah|strong="H07575"\w* \w and camped|strong="H02583"\w* \w vvv|strong="H07428"\w* \w at Rimmon-perez|strong="H07428"\w*.
\li1 \v 20 \w They set out|strong="H05265"\w* \w from|strong="H07428"\w* \w Rimmon-perez|strong="H07428"\w* \w and camped|strong="H02583"\w* \w at Libnah|strong="H03841"\w*.
\li1 \v 21 \w They set out|strong="H05265"\w* \w from Libnah|strong="H03841"\w* \w and camped|strong="H02583"\w* \w at Rissah|strong="H07446"\w*.
\li1 \v 22 \w They set out|strong="H05265"\w* \w from Rissah|strong="H07446"\w* \w and camped|strong="H02583"\w* \w at Kehelathah|strong="H06954"\w*.
\li1 \v 23 \w They set out|strong="H05265"\w* \w from Kehelathah|strong="H06954"\w* \w and camped|strong="H02583"\w* \w at Mount|strong="H02022"\w* \w Shepher|strong="H08234"\w*.
\li1 \v 24 \w They set out|strong="H05265"\w* \w from Mount|strong="H02022"\w* \w Shepher|strong="H08234"\w* \w and camped|strong="H02583"\w* \w at Haradah|strong="H02732"\w*.
\li1 \v 25 \w They set out|strong="H05265"\w* \w from Haradah|strong="H02732"\w* \w and camped|strong="H02583"\w* \w at Makheloth|strong="H04722"\w*.
\li1 \v 26 \w They set out|strong="H05265"\w* \w from Makheloth|strong="H04722"\w* \w and camped|strong="H02583"\w* \w at Tahath|strong="H08480"\w*.
\li1 \v 27 \w They set out|strong="H05265"\w* \w from Tahath|strong="H08480"\w* \w and camped|strong="H02583"\w* \w at Terah|strong="H08646"\w*.
\li1 \v 28 \w They set out|strong="H05265"\w* \w from Terah|strong="H08646"\w* \w and camped|strong="H02583"\w* \w at Mithkah|strong="H04989"\w*.
\li1 \v 29 \w They set out|strong="H05265"\w* \w from Mithkah|strong="H04989"\w* \w and camped|strong="H02583"\w* \w at Hashmonah|strong="H02832"\w*.
\li1 \v 30 \w They set out|strong="H05265"\w* \w from Hashmonah|strong="H02832"\w* \w and camped|strong="H02583"\w* \w at Moseroth|strong="H04149"\w*.
\li1 \v 31 \w They set out|strong="H05265"\w* \w from Moseroth|strong="H04149"\w* \w and camped|strong="H02583"\w* \w vvv|strong="H01142"\w* \w at Bene-jaakan|strong="H01142"\w*.
\li1 \v 32 \w They set out|strong="H05265"\w* \w from|strong="H01142"\w* \w Bene-jaakan|strong="H01142"\w* \w and camped|strong="H02583"\w* \w vvv|strong="H02735"\w* \w at Hor-haggidgad|strong="H02735"\w*.
\b 
\li1 \v 33 \w They set out|strong="H05265"\w* \w from|strong="H02735"\w* \w Hor-haggidgad|strong="H02735"\w* \w and camped|strong="H02583"\w* \w at Jotbathah|strong="H03193"\w*.
\li1 \v 34 \w They set out|strong="H05265"\w* \w from Jotbathah|strong="H03193"\w* \w and camped|strong="H02583"\w* \w at Abronah|strong="H05684"\w*.
\li1 \v 35 \w They set out|strong="H05265"\w* \w from Abronah|strong="H05684"\w* \w and camped|strong="H02583"\w* \w vvv|strong="H06100"\w* \w at Ezion-geber|strong="H06100"\w*.
\li1 \v 36 \w They set out|strong="H05265"\w* \w from|strong="H06100"\w* \w Ezion-geber|strong="H06100"\w* \w and camped|strong="H02583"\w* \w -|strong="H01931"\w* \w at Kadesh|strong="H06946"\w* \w in the Wilderness|strong="H04057"\w* \w of Zin|strong="H06790"\w*.
