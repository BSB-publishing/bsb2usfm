\p \v 12 \w Then the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*, “\w Go up|strong="H05927"\w* \w . . .|strong="H00413"\w* \w this|strong="H02088"\w* \w mountain|strong="H02022"\w* \w of the Abarim range|strong="H05682"\w*\f + \fr 27:12 \ft LXX \fqa Go up Mount Nebo beyond the Jordan\f* \w and see|strong="H07200"\w* \w -|strong="H00853"\w* \w the land|strong="H00776"\w* \w that|strong="H00834"\w* \w I have given|strong="H05414"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*. \v 13 \w After you have seen it|strong="H07200"\w*, \w -|strong="H00853"\w* \w you|strong="H00859"\w* \w too will|strong="H01571"\w* \w be gathered|strong="H00622"\w* \w to|strong="H00413"\w* \w your people|strong="H05971"\w*, \w as|strong="H00834"\w* \w your brother|strong="H00251"\w* \w Aaron|strong="H00175"\w* \w was|strong="H00622"\w*; \v 14 \w for|strong="H00834"\w* \w when the congregation|strong="H05712"\w* \w contended|strong="H04808"\w* \w in the Wilderness|strong="H04057"\w* \w of Zin|strong="H06790"\w*, \w both of you rebelled|strong="H04784"\w* \w against My command|strong="H06310"\w* \w to show My holiness|strong="H06942"\w* \w in their sight|strong="H05869"\w* \w regarding the waters|strong="H04325"\w*.” \w Those|strong="H01992"\w* \w were the waters|strong="H04325"\w* \w of Meribah|strong="H04809"\w*\f + \fr 27:14 \fqa Meribah \ft means \fqa quarreling\ft ; see Exodus 17:7.\f* \w in Kadesh|strong="H06946"\w*, \w in the Wilderness|strong="H04057"\w* \w of Zin|strong="H06790"\w*.
\p \v 15 \w So Moses|strong="H04872"\w* \w appealed|strong="H01696"\w* \w to|strong="H00413"\w* \w the LORD|strong="H03068"\w* \w . . .|strong="H00559"\w*, \v 16 “\w May the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of the spirits|strong="H07307"\w* \w of all|strong="H03605"\w* \w flesh|strong="H01320"\w*, \w appoint|strong="H06485"\w* \w a man|strong="H00376"\w* \w over|strong="H05921"\w* \w the congregation|strong="H05712"\w* \v 17 \w who|strong="H00834"\w* \w will go out|strong="H03318"\w* \w -|strong="H06440"\w* \w and come in|strong="H00935"\w* \w before them|strong="H06440"\w*, \w -|strong="H00834"\w* \w and who|strong="H00834"\w* \w will lead them out|strong="H03318"\w* \w -|strong="H00834"\w* \w and bring them in|strong="H00935"\w*, \w so that the congregation|strong="H05712"\w* \w of the LORD|strong="H03068"\w* \w will not|strong="H03808"\w* \w be|strong="H01961"\w* \w like sheep|strong="H06629"\w* \w -|strong="H00834"\w* \w without|strong="H00369"\w* \w a shepherd|strong="H07462"\w*.”
\s1 Joshua to Succeed Moses
\r (Deuteronomy 31:1–8)
\p \v 18 \w And the LORD|strong="H03068"\w* \w replied|strong="H00559"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*, “\w Take|strong="H03947"\w* \w -|strong="H00853"\w* \w Joshua|strong="H03091"\w* \w son|strong="H01121"\w* \w of Nun|strong="H05126"\w*, \w a man with|strong="H00376"\w* \w vvv|strong="H00834"\w* \w the Spirit|strong="H07307"\w* in him, \w and lay|strong="H05564"\w* \w -|strong="H00853"\w* \w your hands|strong="H03027"\w* \w on him|strong="H05921"\w*. \v 19 \w Have him stand|strong="H05975"\w* \w -|strong="H00853"\w* \w before|strong="H06440"\w* \w Eleazar|strong="H00499"\w* \w the priest|strong="H03548"\w* \w . . .|strong="H06440"\w* \w and the whole|strong="H03605"\w* \w congregation|strong="H05712"\w*, \w and commission|strong="H06680"\w* \w him|strong="H00853"\w* \w in their sight|strong="H05869"\w*. \v 20 \w Confer|strong="H05414"\w* \w on him|strong="H05921"\w* \w [some of] your authority|strong="H01935"\w*, \w so that|strong="H04616"\w* \w the whole|strong="H03605"\w* \w congregation|strong="H05712"\w* \w . . .|strong="H01121"\w* \w of Israel|strong="H03478"\w* \w will obey him|strong="H08085"\w*. \v 21 \w He shall stand|strong="H05975"\w* \w before|strong="H06440"\w* \w Eleazar|strong="H00499"\w* \w the priest|strong="H03548"\w*, \w who will seek counsel|strong="H07592"\w* for him \w before the LORD|strong="H03068"\w* \w by the judgment|strong="H04941"\w* \w of the Urim|strong="H00224"\w*.\f + \fr 27:21 \ft Literally \fqa the Lights\f* \w At|strong="H05921"\w* \w his command|strong="H06310"\w* \w . . .|strong="H06440"\w*, \w he|strong="H01931"\w* \w and all|strong="H03605"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w with him|strong="H00854"\w*— \w the entire|strong="H03605"\w* \w congregation|strong="H05712"\w*— \w will go out|strong="H03318"\w* \w . . .|strong="H05921"\w* \w . . .|strong="H06310"\w* \w and come in|strong="H00935"\w*.”
\p \v 22 \w Moses|strong="H04872"\w* \w did|strong="H06213"\w* \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w had commanded him|strong="H06680"\w*. \w He took|strong="H03947"\w* \w -|strong="H00853"\w* \w Joshua|strong="H03091"\w*, \w had him stand|strong="H05975"\w* \w before|strong="H06440"\w* \w Eleazar|strong="H00499"\w* \w the priest|strong="H03548"\w* \w . . .|strong="H06440"\w* \w and the whole|strong="H03605"\w* \w congregation|strong="H05712"\w*, \v 23 \w and laid|strong="H05564"\w* \w -|strong="H00853"\w* \w his hands|strong="H03027"\w* \w on him|strong="H05921"\w* \w and commissioned him|strong="H06680"\w*, \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had instructed|strong="H01696"\w* \w through|strong="H03027"\w* \w Moses|strong="H04872"\w*.
\c 28
\s1 The Daily Offerings
\r (Exodus 29:38–44)
\p \v 1 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00559"\w*, \v 2 “\w Command|strong="H06680"\w* \w -|strong="H00853"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w and say|strong="H00559"\w* \w to them|strong="H00413"\w* \w -|strong="H00853"\w*: \w See|strong="H08104"\w* \w that you present|strong="H07126"\w* to Me \w at its appointed time|strong="H04150"\w* \w the food|strong="H03899"\w* \w vvv|strong="H07133"\w* \w for My food offerings|strong="H00801"\w*, \w as a pleasing|strong="H05207"\w* \w aroma to Me|strong="H07381"\w*.
\p \v 3 \w And tell them|strong="H00559"\w* [that] \w this [is]|strong="H02088"\w* \w the food offering|strong="H00801"\w* \w -|strong="H00834"\w* \w you are to present|strong="H07126"\w* \w to the LORD|strong="H03068"\w* \w as a regular|strong="H08548"\w* \w burnt offering|strong="H05930"\w* \w each day|strong="H03117"\w*: \w two|strong="H08147"\w* \w unblemished|strong="H08549"\w* \w year-old|strong="H01121"\w* \w . . .|strong="H08141"\w* \w male lambs|strong="H03532"\w*. \v 4 \w -|strong="H00853"\w* \w Offer|strong="H06213"\w* \w one|strong="H00259"\w* \w lamb|strong="H03532"\w* \w in the morning|strong="H01242"\w* \w -|strong="H00853"\w* \w and the other|strong="H08145"\w* \w . . .|strong="H06213"\w* \w -|strong="H03532"\w* \w at|strong="H00996"\w* \w twilight|strong="H06153"\w*,\f + \fr 28:4 \ft Hebrew \fqa between the two evenings\ft ; also in verse 8\f* \v 5 \w along with a tenth|strong="H06224"\w* \w of an ephah|strong="H00374"\w* \w of fine flour|strong="H05560"\w*\f + \fr 28:5 \fqa A tenth of an ephah \ft is approximately 2 dry quarts or 2.2 liters (probably about 2.6 pounds or 1.2 kilograms of flour); also in verses 13, 21, and 29.\f* \w as a grain offering|strong="H04503"\w*, \w mixed|strong="H01101"\w* \w with a quarter|strong="H07243"\w* \w hin|strong="H01969"\w* \w of oil|strong="H08081"\w* \w from pressed [olives]|strong="H03795"\w*.\f + \fr 28:5 \ft Or \fqa a quarter hin of pure olive oil\ft ; Hebrew \fqa a quarter hin of pressed oil\ft ; that is, approximately 0.97 quarts or 0.92 liters; similarly in verses 7 and 14\f*
\p \v 6 \w This is a regular|strong="H08548"\w* \w burnt offering|strong="H05930"\w* \w established|strong="H06213"\w* \w at Mount|strong="H02022"\w* \w Sinai|strong="H05514"\w* \w as a pleasing|strong="H05207"\w* \w aroma|strong="H07381"\w*, \w a food offering|strong="H00801"\w* \w to the LORD|strong="H03068"\w*. \v 7 \w The drink offering|strong="H05262"\w* \w accompanying each|strong="H00259"\w* \w lamb|strong="H03532"\w* \w [shall be] a quarter|strong="H07243"\w* \w hin|strong="H01969"\w*. \w Pour out|strong="H05258"\w* \w the offering|strong="H05262"\w* \w of fermented drink|strong="H07941"\w* \w to the LORD|strong="H03068"\w* \w in the sanctuary area|strong="H06944"\w*. \v 8 \w And|strong="H00853"\w* \w offer|strong="H06213"\w* \w the second|strong="H08145"\w* \w lamb|strong="H03532"\w* \w at|strong="H00996"\w* \w twilight|strong="H06153"\w*, \w with the same grain offering|strong="H04503"\w* \w and drink offering|strong="H05262"\w* \w . . .|strong="H06213"\w* \w as in the morning|strong="H01242"\w*. \w It is a food offering|strong="H00801"\w*, \w a pleasing|strong="H05207"\w* \w aroma|strong="H07381"\w* \w to the LORD|strong="H03068"\w*.
\s1 The Sabbath Offerings
\p \v 9 \w On the Sabbath|strong="H07676"\w* \w day|strong="H03117"\w*, \w present two|strong="H08147"\w* \w unblemished|strong="H08549"\w* \w year-old|strong="H01121"\w* \w . . .|strong="H08141"\w* \w male lambs|strong="H03532"\w*, \w accompanied by a grain offering|strong="H04503"\w* \w of two-tenths of an ephah|strong="H08147"\w* \w . . .|strong="H06241"\w* \w of fine flour|strong="H05560"\w*\f + \fr 28:9 \fqa Two-tenths of an ephah \ft is approximately 4 dry quarts or 4.4 liters (probably about 5.1 pounds or 2.3 kilograms of flour); also in verses 12, 20, and 28.\f* \w mixed|strong="H01101"\w* \w with oil|strong="H08081"\w*, \w as well as a drink offering|strong="H05262"\w*.
\p \v 10 \w This is the burnt offering|strong="H05930"\w* \w for every Sabbath|strong="H07676"\w*, \w . . .|strong="H07676"\w* \w in addition to|strong="H05921"\w* \w the regular|strong="H08548"\w* \w burnt offering|strong="H05930"\w* \w and its drink offering|strong="H05262"\w*.
\s1 The Monthly Offerings
\p \v 11 \w At the beginning|strong="H07218"\w* \w of every month|strong="H02320"\w*, \w you are to present|strong="H07126"\w* \w to the LORD|strong="H03068"\w* \w a burnt offering|strong="H05930"\w* \w of two|strong="H08147"\w* \w young|strong="H01121"\w* \w . . .|strong="H01241"\w* \w bulls|strong="H06499"\w*, \w one|strong="H00259"\w* \w ram|strong="H00352"\w*, \w and seven|strong="H07651"\w* \w male lambs|strong="H03532"\w* \w a year old|strong="H01121"\w* \w . . .|strong="H08141"\w*, \w all unblemished|strong="H08549"\w*, \v 12 \w along with three-tenths [of an ephah]|strong="H07969"\w* \w . . .|strong="H06241"\w* \w of fine flour|strong="H05560"\w*\f + \fr 28:12 \fqa Three-tenths of an ephah \ft is approximately 6 dry quarts or 6.6 liters (probably about 7.6 pounds or 3.5 kilograms of flour); also in verses 20 and 28.\f* \w mixed|strong="H01101"\w* \w with oil|strong="H08081"\w* \w as a grain offering|strong="H04503"\w* \w with each|strong="H00259"\w* \w bull|strong="H06499"\w*, \w two-tenths [of an ephah]|strong="H08147"\w* \w . . .|strong="H06241"\w* \w of fine flour|strong="H05560"\w* \w mixed|strong="H01101"\w* \w with oil|strong="H08081"\w* \w as a grain offering|strong="H04503"\w* \w with the ram|strong="H00352"\w* \w . . .|strong="H00259"\w*, \v 13 \w and a tenth [of an ephah]|strong="H06241"\w* \w . . .|strong="H06241"\w* \w of fine flour|strong="H05560"\w* \w mixed|strong="H01101"\w* \w with oil|strong="H08081"\w* \w as a grain offering|strong="H04503"\w* \w with each|strong="H00259"\w* \w lamb|strong="H03532"\w*. \w This is a burnt offering|strong="H05930"\w*, \w a pleasing|strong="H05207"\w* \w aroma|strong="H07381"\w*, \w a food offering|strong="H00801"\w* \w to the LORD|strong="H03068"\w*.
\p \v 14 \w Their drink offerings|strong="H05262"\w* \w shall be|strong="H01961"\w* \w half|strong="H02677"\w* \w a hin|strong="H01969"\w* \w of wine|strong="H03196"\w*\f + \fr 28:14 \fqa Half a hin \ft is approximately 1.9 quarts or 1.8 liters of wine.\f* \w with each bull|strong="H06499"\w*, \w a third|strong="H07992"\w* \w of a hin|strong="H01969"\w*\f + \fr 28:14 \fqa A third of a hin \ft is approximately 1.3 quarts or 1.2 liters of wine.\f* \w with the ram|strong="H00352"\w*, \w and a quarter|strong="H07243"\w* \w hin|strong="H01969"\w* \w with each lamb|strong="H03532"\w*. \w This|strong="H02063"\w* \w is the monthly|strong="H02320"\w* \w burnt offering|strong="H05930"\w* \w to be made at each new moon|strong="H02320"\w* \w . . .|strong="H02320"\w* \w throughout the year|strong="H08141"\w*.
\p \v 15 \w In addition to|strong="H05921"\w* \w the regular|strong="H08548"\w* \w burnt offering|strong="H05930"\w* \w with its drink offering|strong="H05262"\w*, \w one|strong="H00259"\w* \w male goat|strong="H08163"\w* \w . . .|strong="H05795"\w* \w is to be presented|strong="H06213"\w* \w to the LORD|strong="H03068"\w* \w as a sin offering|strong="H02403"\w*.
\s1 Passover and the Feast of Unleavened Bread
\r (Exodus 12:14–28; Leviticus 23:4–8; Deuteronomy 16:1–8)
\p \v 16 \w The fourteenth|strong="H00702"\w* \w . . .|strong="H06240"\w* \w day|strong="H03117"\w* \w -|strong="H02320"\w* \w of the first|strong="H07223"\w* \w month|strong="H02320"\w* \w is the LORD’s|strong="H03068"\w* \w Passover|strong="H06453"\w*. \v 17 \w On the fifteenth|strong="H02568"\w* \w . . .|strong="H06240"\w* \w day|strong="H03117"\w* \w of this|strong="H02088"\w* \w month|strong="H02320"\w*, \w there shall be a feast|strong="H02282"\w*; \w for seven|strong="H07651"\w* \w days|strong="H03117"\w* \w unleavened bread|strong="H04682"\w* \w is to be eaten|strong="H00398"\w*.
\p \v 18 \w On the first|strong="H07223"\w* \w day|strong="H03117"\w* \w there is to be a sacred|strong="H06944"\w* \w assembly|strong="H04744"\w*; \w you must not|strong="H03808"\w* \w do|strong="H06213"\w* \w any|strong="H03605"\w* \w regular work|strong="H04399"\w* \w . . .|strong="H05656"\w*. \v 19 \w Present|strong="H07126"\w* \w to the LORD|strong="H03068"\w* \w a food offering|strong="H00801"\w*, \w a burnt offering|strong="H05930"\w* \w of two|strong="H08147"\w* \w young|strong="H01121"\w* \w . . .|strong="H01241"\w* \w bulls|strong="H06499"\w*, \w one|strong="H00259"\w* \w ram|strong="H00352"\w*, \w and seven|strong="H07651"\w* \w male lambs|strong="H03532"\w* \w a year old|strong="H01121"\w* \w . . .|strong="H08141"\w*, \w all|strong="H01961"\w* \w unblemished|strong="H08549"\w*. \v 20 \w The grain offering|strong="H04503"\w* \w shall consist of fine flour|strong="H05560"\w* \w mixed|strong="H01101"\w* \w with oil|strong="H08081"\w*; \w offer|strong="H06213"\w* \w three-tenths [of an ephah]|strong="H07969"\w* \w . . .|strong="H06241"\w* \w with each bull|strong="H06499"\w*, \w two-tenths [of an ephah]|strong="H08147"\w* \w . . .|strong="H06241"\w* \w with the ram|strong="H00352"\w*, \v 21 \w and|strong="H06213"\w* \w a tenth [of an ephah]|strong="H06241"\w* \w . . .|strong="H06241"\w* \w with each|strong="H00259"\w* \w of the seven|strong="H07651"\w* \w . . .|strong="H03532"\w* \w lambs|strong="H03532"\w*. \v 22 \w Include one|strong="H00259"\w* \w male goat|strong="H08163"\w* \w as a sin offering|strong="H02403"\w* \w to make atonement|strong="H03722"\w* \w for you|strong="H05921"\w*.
\p \v 23 \w You are to present|strong="H06213"\w* \w -|strong="H00853"\w* \w these|strong="H00428"\w* \w in addition to|strong="H00905"\w* \w the|strong="H00834"\w* \w regular|strong="H08548"\w* \w -|strong="H05930"\w* \w morning|strong="H01242"\w* \w burnt offering|strong="H05930"\w*. \v 24 \w Offer|strong="H06213"\w* \w the same|strong="H00428"\w* \w food|strong="H03899"\w* \w each day|strong="H03117"\w* \w for seven|strong="H07651"\w* \w days|strong="H03117"\w* \w as a food offering|strong="H00801"\w*, \w a pleasing|strong="H05207"\w* \w aroma|strong="H07381"\w* \w to the LORD|strong="H03068"\w*. \w It is to be offered|strong="H06213"\w* \w with|strong="H05921"\w* \w its drink offering|strong="H05262"\w* \w and the regular|strong="H08548"\w* \w burnt offering|strong="H05930"\w*.
\p \v 25 \w On the seventh|strong="H07637"\w* \w day|strong="H03117"\w* \w you shall hold|strong="H01961"\w* \w a sacred|strong="H06944"\w* \w assembly|strong="H04744"\w*; \w you must not|strong="H03808"\w* \w do|strong="H06213"\w* \w any|strong="H03605"\w* \w regular work|strong="H04399"\w* \w . . .|strong="H05656"\w*.
\s1 The Feast of Weeks
\r (Deuteronomy 16:9–12)
\p \v 26 \w On the day|strong="H03117"\w* \w of firstfruits|strong="H01061"\w*, \w when you present|strong="H07126"\w* \w an offering of new|strong="H02319"\w* \w grain|strong="H04503"\w* \w to the LORD|strong="H03068"\w* \w during the Feast of Weeks|strong="H07620"\w*,\f + \fr 28:26 \ft That is, Shavuot, the late spring feast of pilgrimage to Jerusalem; it is also known as \fqa the Feast of Harvest\ft (see Exodus 23:16) or \fqa the Feast of Pentecost\ft (see Acts 2:1).\f* \w you are to hold|strong="H01961"\w* \w a sacred|strong="H06944"\w* \w assembly|strong="H04744"\w*; \w you must not|strong="H03808"\w* \w do|strong="H06213"\w* \w any|strong="H03605"\w* \w regular work|strong="H04399"\w* \w . . .|strong="H05656"\w*.
\p \v 27 \w Present|strong="H07126"\w* \w a burnt offering|strong="H05930"\w* \w of two|strong="H08147"\w* \w young|strong="H01121"\w* \w . . .|strong="H01241"\w* \w bulls|strong="H06499"\w*, \w one|strong="H00259"\w* \w ram|strong="H00352"\w*, \w and seven|strong="H07651"\w* \w male lambs|strong="H03532"\w* \w a year old|strong="H01121"\w* \w . . .|strong="H08141"\w* \w as a pleasing|strong="H05207"\w* \w aroma|strong="H07381"\w* \w to the LORD|strong="H03068"\w*, \v 28 \w together with their grain offerings|strong="H04503"\w* \w of fine flour|strong="H05560"\w* \w mixed|strong="H01101"\w* \w with oil|strong="H08081"\w*— \w three-tenths [of an ephah]|strong="H07969"\w* \w . . .|strong="H06241"\w* \w with each|strong="H00259"\w* \w bull|strong="H06499"\w*, \w two-tenths [of an ephah]|strong="H08147"\w* \w . . .|strong="H06241"\w* \w with the ram|strong="H00352"\w*, \w . . .|strong="H00259"\w* \v 29 \w and a tenth [of an ephah]|strong="H06241"\w* \w . . .|strong="H06241"\w* \w with each|strong="H00259"\w* \w of the seven|strong="H07651"\w* \w . . .|strong="H03532"\w* \w lambs|strong="H03532"\w*.
\p \v 30 \w Include one|strong="H00259"\w* \w male goat|strong="H08163"\w* \w . . .|strong="H05795"\w* \w to make atonement|strong="H03722"\w* \w for you|strong="H05921"\w*. \v 31 \w Offer them|strong="H06213"\w* \w with their drink offerings|strong="H05262"\w* \w in addition to|strong="H00905"\w* \w the regular|strong="H08548"\w* \w burnt offering|strong="H05930"\w* \w and its grain offering|strong="H04503"\w*. \w The animals must be|strong="H01961"\w* \w unblemished|strong="H08549"\w*.[’’]
\c 29
\s1 The Feast of Trumpets
\r (Leviticus 23:23–25)
\p \v 1 “\w On the first|strong="H00259"\w* \w day|strong="H02320"\w* \w of the seventh|strong="H07637"\w* \w month|strong="H02320"\w*, \w you are to hold|strong="H01961"\w* \w a sacred|strong="H06944"\w* \w assembly|strong="H04744"\w*, \w and you must not|strong="H03808"\w* \w do|strong="H06213"\w* \w any|strong="H03605"\w* \w regular work|strong="H04399"\w* \w . . .|strong="H05656"\w*. \w This will be|strong="H01961"\w* \w a day|strong="H03117"\w* for you \w to sound the trumpets|strong="H08643"\w*.
\p \v 2 \w As a pleasing|strong="H05207"\w* \w aroma|strong="H07381"\w* \w to the LORD|strong="H03068"\w*, \w you are to present|strong="H06213"\w* \w a burnt offering|strong="H05930"\w* \w of one|strong="H00259"\w* \w young|strong="H01121"\w* \w . . .|strong="H01241"\w* \w bull|strong="H06499"\w*, \w one|strong="H00259"\w* \w ram|strong="H00352"\w*, \w and seven|strong="H07651"\w* \w male lambs|strong="H03532"\w* \w a year old|strong="H01121"\w*, \w . . .|strong="H08141"\w* \w all unblemished|strong="H08549"\w*, \v 3 \w together with their grain offerings|strong="H04503"\w* \w of fine flour|strong="H05560"\w* \w mixed|strong="H01101"\w* \w with oil|strong="H08081"\w*— \w three-tenths [of an ephah]|strong="H07969"\w*\f + \fr 29:3 \fqa Three-tenths of an ephah \ft is approximately 6 dry quarts or 6.6 liters (probably about 7.6 pounds or 3.5 kilograms of flour); also in verses 9 and 14.\f* \w . . .|strong="H06241"\w* \w with the bull|strong="H06499"\w*, \w two-tenths [of an ephah]|strong="H08147"\w*\f + \fr 29:3 \fqa Two-tenths of an ephah \ft is approximately 4 dry quarts or 4.4 liters (probably about 5.1 pounds or 2.3 kilograms of flour); also in verses 9 and 14.\f* \w . . .|strong="H06241"\w* \w with the ram|strong="H00352"\w*, \v 4 \w and a tenth [of an ephah]|strong="H06241"\w*\f + \fr 29:4 \fqa A tenth of an ephah \ft is approximately 2 dry quarts or 2.2 liters (probably about 2.6 pounds or 1.2 kilograms of flour); also in verses 10 and 15.\f* \w . . .|strong="H00259"\w* \w with each|strong="H00259"\w* \w of the seven|strong="H07651"\w* \w . . .|strong="H03532"\w* \w male lambs|strong="H03532"\w*.
\p \v 5 \w Include one|strong="H00259"\w* \w male goat|strong="H08163"\w* \w . . .|strong="H05795"\w* \w as a sin offering|strong="H02403"\w* \w to make atonement|strong="H03722"\w* \w for you|strong="H05921"\w*. \v 6 \w These are in addition to|strong="H00905"\w* \w the monthly|strong="H02320"\w* \w and daily|strong="H08548"\w* \w . . .|strong="H04503"\w* \w burnt offerings|strong="H05930"\w* \w with their prescribed|strong="H04941"\w* \w grain offerings|strong="H04503"\w* \w . . .|strong="H05930"\w* \w and drink offerings|strong="H05262"\w*. \w They are a pleasing|strong="H05207"\w* \w aroma|strong="H07381"\w*, \w a food offering|strong="H00801"\w* \w to the LORD|strong="H03068"\w*.
\s1 The Day of Atonement
\r (Leviticus 16:1–34; Leviticus 23:26–32)
\p \v 7 \w On the tenth|strong="H06218"\w* \w day of this|strong="H02088"\w* \w seventh|strong="H07637"\w* \w month|strong="H02320"\w*, \w you are to hold|strong="H01961"\w* \w a sacred|strong="H06944"\w* \w assembly|strong="H04744"\w*, \w and you shall humble|strong="H06031"\w*\w . . .|strong="H00853"\w* \w yourselves|strong="H05315"\w*;\f + \fr 29:7 \ft Or \fqa afflict your souls \ft or \fqa deny yourselves\f* \w you must not|strong="H03808"\w* \w do|strong="H06213"\w* \w any|strong="H03605"\w* \w work|strong="H04399"\w*.
