\p \v 1 \w And the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w -|strong="H00559"\w*, \v 2 “\w Send out|strong="H07971"\w* for yourself \w men|strong="H00582"\w* \w to spy out|strong="H08446"\w* \w -|strong="H00853"\w* \w the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*, \w which|strong="H00834"\w* \w I|strong="H00589"\w* \w am giving|strong="H05414"\w* \w to the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*.\w . . .|strong="H00376"\w* \w From each|strong="H03605"\w* \w of their fathers’|strong="H00001"\w* \w tribes|strong="H04294"\w* \w send|strong="H07971"\w* \w one|strong="H00259"\w* \w man|strong="H00376"\w* \w . . .|strong="H00259"\w* \w who is a leader|strong="H05387"\w* among them.”
