\p \v 8 \w Furthermore|strong="H00413"\w*, \w you shall say|strong="H01696"\w* \w . . .|strong="H00559"\w* \w to the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*, ‘\w If|strong="H03588"\w* \w a man|strong="H00376"\w* \w dies|strong="H04191"\w* \w and leaves no|strong="H00369"\w* \w son|strong="H01121"\w*, \w you are to transfer|strong="H05674"\w* \w -|strong="H00853"\w* \w his inheritance|strong="H05159"\w* \w to his daughter|strong="H01323"\w*. \v 9 \w If|strong="H00518"\w* \w he has no|strong="H00369"\w* \w daughter|strong="H01323"\w*, \w give|strong="H05414"\w* \w -|strong="H00853"\w* \w his inheritance|strong="H05159"\w* \w to his brothers|strong="H00251"\w*. \v 10 \w If|strong="H00518"\w* \w he has no|strong="H00369"\w* \w brothers|strong="H00251"\w*, \w give|strong="H05414"\w* \w -|strong="H00853"\w* \w his inheritance|strong="H05159"\w* \w to his father’s|strong="H00001"\w* \w brothers|strong="H00251"\w*. \v 11 \w And if|strong="H00518"\w* \w his father|strong="H00001"\w* \w has no|strong="H00369"\w* \w brothers|strong="H00251"\w*, \w give|strong="H05414"\w* \w -|strong="H00853"\w* \w his inheritance|strong="H05159"\w* \w to the next|strong="H07138"\w* \w . . .|strong="H00413"\w* \w of kin|strong="H07607"\w* \w from his clan|strong="H04940"\w*, \w that he may take possession of it|strong="H03423"\w*. \w -|strong="H00853"\w* \w This is to be|strong="H01961"\w* \w a statutory|strong="H02708"\w* \w ordinance|strong="H04941"\w* \w for the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*, \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w has commanded|strong="H06680"\w* \w -|strong="H00853"\w* \w Moses|strong="H04872"\w*.’”
\s1 Moses Requests a Successor
