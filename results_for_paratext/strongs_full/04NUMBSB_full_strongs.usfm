\s1 The Adultery Test
\p \v 11 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00559"\w*, \v 12 “\w Speak|strong="H01696"\w* \w to|strong="H00413"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w and tell them that|strong="H00559"\w* \w . . .|strong="H00413"\w* \w if|strong="H03588"\w* \w any man’s|strong="H00376"\w* \w . . .|strong="H00376"\w* \w wife|strong="H00802"\w* \w goes astray|strong="H07847"\w* \w and is unfaithful|strong="H04603"\w* to him\w . . .|strong="H04604"\w* \v 13 \w by sleeping with|strong="H07901"\w* \w another man|strong="H00376"\w* \w . . .|strong="H00854"\w* \w . . .|strong="H07902"\w* \w . . .|strong="H02233"\w*, \w and it is concealed|strong="H05956"\w* \w from|strong="H05869"\w* \w her husband|strong="H00376"\w* \w and her|strong="H01931"\w* \w impurity|strong="H02930"\w* \w is undetected|strong="H05641"\w* (\w since there is no|strong="H00369"\w* \w witness against her|strong="H05707"\w* - \w and she|strong="H01931"\w* \w was not|strong="H03808"\w* \w caught in the act|strong="H08610"\w*), \v 14 \w and if a feeling|strong="H07307"\w* \w of jealousy|strong="H07068"\w* \w comes over|strong="H05674"\w* \w [her husband]|strong="H05921"\w* \w and he suspects|strong="H07065"\w* \w -|strong="H00853"\w* \w his wife|strong="H00802"\w* \w who|strong="H01931"\w* \w has defiled herself|strong="H02930"\w*— \w or|strong="H00176"\w* \w if a feeling|strong="H07307"\w* \w of jealousy|strong="H07068"\w* \w comes over|strong="H05674"\w* \w him|strong="H05921"\w* \w and he suspects|strong="H07065"\w* \w -|strong="H00853"\w* \w her|strong="H00802"\w* \w even though she|strong="H01931"\w* \w has not|strong="H03808"\w* \w defiled herself|strong="H02930"\w*— \v 15 \w then [he]|strong="H00376"\w* \w -|strong="H00853"\w* \w is to bring|strong="H00935"\w* \w his wife|strong="H00802"\w* \w to|strong="H00413"\w* \w the priest|strong="H03548"\w*.
\p \w He must also bring|strong="H00935"\w* \w -|strong="H00853"\w* \w for her|strong="H05921"\w* \w an offering|strong="H07133"\w* \w of a tenth|strong="H06224"\w* \w of an ephah|strong="H00374"\w* \w of barley|strong="H08184"\w* \w flour|strong="H07058"\w*.\f + \fr 5:15 \fqa A tenth of an ephah \ft is approximately 2 dry quarts or 2.2 liters (probably about 3.5 pounds or 1.6 kilograms of barley flour).\f* \w He is not|strong="H03808"\w* \w to pour|strong="H03332"\w* \w oil|strong="H08081"\w* \w . . .|strong="H03808"\w* \w over|strong="H05921"\w* \w it or put|strong="H05414"\w* \w frankincense|strong="H03828"\w* \w on it|strong="H05921"\w*, \w because|strong="H03588"\w* \w it|strong="H01931"\w* \w is a grain offering|strong="H04503"\w* \w for jealousy|strong="H07068"\w*, \w an offering|strong="H04503"\w* \w of memorial|strong="H02146"\w* \w as a reminder|strong="H02142"\w* \w of iniquity|strong="H05771"\w*.
\p \v 16 \w The priest|strong="H03548"\w* \w is to bring [the wife] forward|strong="H07126"\w* \w -|strong="H00853"\w* \w and have her stand|strong="H05975"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*. \v 17 \w Then [he]|strong="H03548"\w* \w is to take|strong="H03947"\w* \w [some] holy|strong="H06918"\w* \w water|strong="H04325"\w* \w in a clay|strong="H02789"\w* \w jar|strong="H03627"\w* \w -|strong="H03947"\w* \w -|strong="H03548"\w* \w and put|strong="H05414"\w* \w some of|strong="H04480"\w* \w the dust|strong="H06083"\w* \w -|strong="H00834"\w* \w -|strong="H01961"\w* \w from the tabernacle|strong="H04908"\w* \w floor|strong="H07172"\w* \w into|strong="H00413"\w* \w the water|strong="H04325"\w*.
\p \v 18 \w After the priest|strong="H03548"\w* \w -|strong="H00853"\w* \w has the woman|strong="H00802"\w* \w stand|strong="H05975"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*, \w he is to let down|strong="H06544"\w* \w -|strong="H00853"\w* \w her|strong="H00802"\w* \w hair|strong="H07218"\w* \w and place|strong="H05414"\w* \w in|strong="H05921"\w* \w her hands|strong="H03709"\w* \w -|strong="H00853"\w* \w the grain offering|strong="H04503"\w* \w of memorial|strong="H02146"\w*, \w which|strong="H01931"\w* \w is the grain offering|strong="H04503"\w* \w for jealousy|strong="H07068"\w*. \w The priest|strong="H03548"\w* \w is|strong="H01961"\w* \w to hold|strong="H03027"\w* \w the bitter|strong="H04751"\w* \w water|strong="H04325"\w* \w that brings a curse|strong="H00779"\w*. \v 19 \w And [he]|strong="H03548"\w* \w is to put the woman under oath|strong="H07650"\w* \w -|strong="H00853"\w* \w and say|strong="H00559"\w* \w to|strong="H00413"\w* \w her|strong="H00802"\w*, ‘\w If|strong="H00518"\w* \w no other|strong="H03808"\w* \w man|strong="H00376"\w* \w . . .|strong="H00854"\w* \w has slept with you|strong="H07901"\w* \w and|strong="H00518"\w* \w you have not|strong="H03808"\w* \w gone astray|strong="H07847"\w* \w and become defiled|strong="H02932"\w* \w while under|strong="H08478"\w* \w your husband’s authority|strong="H00376"\w*, \w may you be immune|strong="H05352"\w* \w to this|strong="H00428"\w* \w bitter|strong="H04751"\w* \w water|strong="H04325"\w* \w that brings a curse|strong="H00779"\w*. \v 20 \w But if|strong="H03588"\w* \w you|strong="H00859"\w* \w have gone astray|strong="H07847"\w* \w while under|strong="H08478"\w* \w your husband’s authority|strong="H00376"\w* \w and|strong="H03588"\w* \w have defiled yourself|strong="H02930"\w* \w and lain|strong="H05414"\w* \w carnally|strong="H07903"\w* \w with a man|strong="H00376"\w* \w -|strong="H00853"\w* \w other than|strong="H01107"\w* \w your husband|strong="H00376"\w*’— \v 21 \w and the prie