\p \v 44 \w These|strong="H00428"\w* \w were the men|strong="H00834"\w* \w numbered|strong="H06485"\w* \w by Moses|strong="H04872"\w* \w and Aaron|strong="H00175"\w* \w -|strong="H06485"\w*, \w with the assistance of the twelve|strong="H08147"\w* \w . . .|strong="H06240"\w* \w . . .|strong="H00376"\w* \w . . .|strong="H00376"\w* \w leaders|strong="H05387"\w* \w of Israel|strong="H03478"\w*, \w each one|strong="H00259"\w* \w representing his family|strong="H00001"\w* \w . . .|strong="H01961"\w* \w . . .|strong="H01004"\w*. \v 45 \w So all|strong="H03605"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w twenty|strong="H06242"\w* \w years of age|strong="H01121"\w* \w . . .|strong="H08141"\w* \w or older|strong="H04605"\w* \w -|strong="H03605"\w* \w who could serve|strong="H03318"\w* \w in Israel’s|strong="H03478"\w* \w army|strong="H06635"\w* \w were|strong="H01961"\w* \w counted|strong="H06485"\w* \w according to their families|strong="H00001"\w* \w . . .|strong="H01004"\w*. \v 46 \w And|strong="H01961"\w* \w all|strong="H03605"\w* \w those counted|strong="H06485"\w* \w totaled 603,550|strong="H08337"\w* \w . . .|strong="H03967"\w* \w . . .|strong="H00505"\w* \w . . .|strong="H07969"\w* \w . . .|strong="H00505"\w* \w . . .|strong="H02568"\w* \w . . .|strong="H03967"\w* \w . . .|strong="H02572"\w*.
\s1 The Exemption of the Levites
\p \v 47 \w The Levites, however|strong="H03881"\w*, \w were not|strong="H03808"\w* \w numbered|strong="H06485"\w* \w along with them|strong="H08432"\w* \w by the tribe|strong="H04294"\w* \w of their fathers|strong="H00001"\w*. \v 48 \w For the LORD|strong="H03068"\w* \w . . .|strong="H00413"\w* \w had said to|strong="H01696"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00559"\w*: \v 49 “\w -|strong="H00389"\w* \w -|strong="H00853"\w* \w Do not|strong="H03808"\w* \w number|strong="H06485"\w* \w the tribe|strong="H04294"\w* \w of Levi|strong="H03878"\w* \w -|strong="H00853"\w* \w in the census|strong="H07218"\w* \w . . .|strong="H03808"\w* \w . . .|strong="H05375"\w* \w with|strong="H08432"\w* \w the other Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*. \v 50 \w Instead|strong="H00859"\w*, \w you are to appoint|strong="H06485"\w* \w -|strong="H00853"\w* \w the Levites|strong="H03881"\w* \w over|strong="H05921"\w* \w the tabernacle|strong="H04908"\w* \w of the Testimony|strong="H05715"\w*, \w . . .|strong="H05921"\w* \w all|strong="H03605"\w* \w its furnishings|strong="H03627"\w*, \w . . .|strong="H05921"\w* \w and everything|strong="H03605"\w* \w -|strong="H00834"\w* in it. \w They|strong="H01992"\w* \w shall carry|strong="H05375"\w* \w -|strong="H00853"\w* \w the tabernacle|strong="H04908"\w* \w -|strong="H00853"\w* \w and all|strong="H03605"\w* \w its articles|strong="H03627"\w*, \w . . .|strong="H01992"\w* \w care for it|strong="H08334"\w*, \w and camp|strong="H02583"\w* \w around|strong="H05439"\w* \w it|strong="H04908"\w*.
\p \v 51 \w Whenever the tabernacle|strong="H04908"\w* \w is to move|strong="H05265"\w*, \w the Levites|strong="H03881"\w* \w are to take it down|strong="H03381"\w*, \w -|strong="H00853"\w* \w and whenever it|strong="H04908"\w* \w is to be pitched|strong="H02583"\w*, \w the Levites|strong="H03881"\w* \w are to set it up|strong="H06965"\w*. \w -|strong="H00853"\w* \w Any outsider|strong="H02114"\w* \w who goes near it|strong="H07131"\w* \w must be put to death|strong="H04191"\w*.
\p \v 52 \w The Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w are to camp|strong="H02583"\w* \w by their divisions|strong="H06635"\w*, \w each man|strong="H00376"\w* \w in|strong="H05921"\w* \w his own camp|strong="H04264"\w* \w . . .|strong="H00376"\w* \w and under|strong="H05921"\w* \w his own standard|strong="H01714"\w*. \v 53 \w But the Levites|strong="H03881"\w* \w are to camp|strong="H02583"\w* \w around|strong="H05439"\w* \w the tabernacle|strong="H04908"\w* \w of the Testimony|strong="H05715"\w* \w and watch over it|strong="H08104"\w*, \w so that no|strong="H03808"\w* \w wrath|strong="H07110"\w* \w will fall|strong="H01961"\w* \w on|strong="H05921"\w* \w the congregation|strong="H05712"\w* \w vvv|strong="H01121"\w* \w of Israel|strong="H03478"\w*. \w So the Levites|strong="H03881"\w*\w . . .|strong="H00853"\w* \w are responsible|strong="H04931"\w* \w for the tabernacle|strong="H04908"\w* \w of the Testimony|strong="H05715"\w*.”
\p \v 54 \w Thus the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w did|strong="H06213"\w* \w everything|strong="H03605"\w* \w just as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w had commanded|strong="H06680"\w* \w Moses|strong="H04872"\w*. \w . . .|strong="H03651"\w* \w . . .|strong="H06213"\w*
\c 2
\s1 The Order of the Camps
\p \v 1 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00413"\w* \w and Aaron|strong="H00175"\w* \w . . .|strong="H00559"\w*: \v 2 “\w The Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w are to camp|strong="H02583"\w* \w around|strong="H05439"\w* \w the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w* \w at a distance from it|strong="H05048"\w* \w -|strong="H02583"\w*, \w each [man]|strong="H00376"\w* \w under|strong="H05921"\w* \w his standard|strong="H01714"\w*, \w with the banners|strong="H00226"\w* \w of his family|strong="H00001"\w* \w . . .|strong="H01004"\w*.
\p \v 3 \w On the east side|strong="H06924"\w*, \w toward the sunrise|strong="H04217"\w*, \w the divisions|strong="H06635"\w* \w of Judah|strong="H03063"\w* \w are to camp|strong="H02583"\w* \w under their standard|strong="H01714"\w* \w . . .|strong="H04264"\w*:
