\c 18
\s1 Duties of Priests and Levites
\p \v 1 \w So the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Aaron|strong="H00175"\w*, “\w You|strong="H00859"\w* \w and your sons|strong="H01121"\w* \w and your father’s|strong="H00001"\w* \w . . .|strong="H00854"\w* \w house|strong="H01004"\w* \w must bear|strong="H05375"\w* \w -|strong="H00853"\w* \w the iniquity [involving]|strong="H05771"\w* \w the sanctuary|strong="H04720"\w*. \w And you|strong="H00859"\w* \w and your sons|strong="H01121"\w* \w [alone]|strong="H00854"\w* \w must bear|strong="H05375"\w* \w -|strong="H00853"\w* \w the iniquity [involving]|strong="H05771"\w* \w your priesthood|strong="H03550"\w*. \v 2 \w But bring|strong="H07126"\w* \w with you|strong="H00854"\w* \w also|strong="H01571"\w*\w . . .|strong="H00853"\w* \w your brothers|strong="H00251"\w* \w from the tribe|strong="H04294"\w* \w of Levi|strong="H03878"\w*, \w the tribe|strong="H07626"\w* \w of your father|strong="H00001"\w*, \w that they may join|strong="H03867"\w* \w you|strong="H05921"\w* \w and assist|strong="H08334"\w* \w you|strong="H00859"\w* \w and your sons|strong="H01121"\w* \w . . .|strong="H00854"\w* \w before|strong="H06440"\w* \w the Tent|strong="H00168"\w* \w of the Testimony|strong="H05715"\w*. \v 3 \w And they shall attend|strong="H08104"\w* \w to your duties|strong="H04931"\w* \w and to all the duties|strong="H04931"\w* \w . . .|strong="H03605"\w* \w of the Tent|strong="H00168"\w*; \w . . .|strong="H00389"\w* \w but|strong="H00413"\w* \w they must not|strong="H03808"\w* \w come near|strong="H07126"\w* \w to the furnishings|strong="H03627"\w* \w of the sanctuary|strong="H06944"\w* \w or|strong="H00413"\w* \w the altar|strong="H04196"\w*, \w or|strong="H03808"\w* \w both|strong="H01571"\w* \w they|strong="H01992"\w* \w and|strong="H01571"\w* \w you|strong="H00859"\w* \w will die|strong="H04191"\w*. \v 4 \w They are to join|strong="H03867"\w* \w you|strong="H05921"\w* \w and attend|strong="H08104"\w*\w . . .|strong="H00853"\w* \w to the duties|strong="H04931"\w* \w of the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*, \w doing all|strong="H03605"\w* \w the work|strong="H05656"\w* \w at the Tent|strong="H00168"\w*; \w but no|strong="H03808"\w* \w outsider|strong="H02114"\w* \w may come near|strong="H07126"\w* \w you|strong="H00413"\w*.
\p \v 5 \w And you shall attend|strong="H08104"\w*\w . . .|strong="H00853"\w* \w to the duties|strong="H04931"\w* \w of the sanctuary|strong="H06944"\w* \w [and]|strong="H00853"\w*\w . . .|strong="H04931"\w* \w of the altar|strong="H04196"\w*, \w so that wrath|strong="H07110"\w* \w may not|strong="H03808"\w* \w fall|strong="H01961"\w* \w on|strong="H05921"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w again|strong="H05750"\w*. \v 6 \w Behold|strong="H02009"\w*, \w I Myself|strong="H00589"\w* \w have selected|strong="H03947"\w* \w -|strong="H00853"\w* \w your fellow|strong="H00251"\w* \w Levites|strong="H03881"\w* \w from|strong="H08432"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w as a gift|strong="H04979"\w* to you, \w dedicated|strong="H05414"\w* \w to the LORD|strong="H03068"\w* \w to perform|strong="H05647"\w*\w . . .|strong="H00853"\w* \w the service|strong="H05656"\w* \w for the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*. \v 7 \w But only you|strong="H00859"\w* \w and your sons|strong="H01121"\w* \w . . .|strong="H00854"\w* \w shall attend|strong="H08104"\w* \w -|strong="H00853"\w* \w to your priesthood|strong="H03550"\w* \w for everything|strong="H03605"\w* \w concerning|strong="H01697"\w* \w the altar|strong="H04196"\w* \w and what is inside|strong="H01004"\w* \w the veil|strong="H06532"\w*, \w and you are to perform that service|strong="H05647"\w*. \w I am giving|strong="H05414"\w* \w -|strong="H00853"\w* \w you the work|strong="H05656"\w* \w of the priesthood|strong="H03550"\w* \w as a gift|strong="H04979"\w*, \w but any outsider|strong="H02114"\w* \w who comes near [the sanctuary]|strong="H07131"\w* \w must be put to death|strong="H04191"\w*.”
\s1 Offerings for Priests and Levites
\p \v 8 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Aaron|strong="H00175"\w*, “\w Behold|strong="H02009"\w*, \w I|strong="H00589"\w* \w have put|strong="H05414"\w* you \w -|strong="H00853"\w* \w in charge|strong="H04931"\w* \w of My offerings|strong="H08641"\w*. \w As for all|strong="H03605"\w* \w the sacred offerings|strong="H06944"\w* \w vvv|strong="H01121"\w* \w of the Israelites|strong="H03478"\w*, \w I have given them|strong="H05414"\w* to you \w and your sons|strong="H01121"\w* \w as a portion|strong="H04888"\w* \w and a permanent|strong="H05769"\w* \w statute|strong="H02706"\w*. \v 9 \w -|strong="H02088"\w* \w A portion of|strong="H04480"\w* \w the most holy offerings|strong="H06944"\w* \w . . .|strong="H06944"\w* \w [reserved] from the fire|strong="H00784"\w* \w will be|strong="H01961"\w* yours. \w From all|strong="H03605"\w* \w the offerings|strong="H07133"\w* \w . . .|strong="H03605"\w* \w -|strong="H00834"\w* \w they render|strong="H07725"\w* to Me \w as most holy [offerings]|strong="H06944"\w* \w . . .|strong="H06944"\w*, \w whether grain offerings|strong="H04503"\w* \w . . .|strong="H03605"\w* \w or sin offerings|strong="H02403"\w* \w . . .|strong="H03605"\w* \w or guilt offerings|strong="H00817"\w*, \w [that part] belongs|strong="H01931"\w* to you \w and your sons|strong="H01121"\w*. \v 10 \w You are to eat it|strong="H00398"\w* \w as a most holy [offering]|strong="H06944"\w* \w . . .|strong="H06944"\w*,\f + \fr 18:10 \ft Or \fqa You are to eat it in a most holy place\f* \w [and] every|strong="H03605"\w* \w male|strong="H02145"\w* \w may eat|strong="H00398"\w* \w it|strong="H00853"\w*. \w You shall regard it|strong="H01961"\w* \w as holy|strong="H06944"\w* -.
\p \v 11 \w And this|strong="H02088"\w* is yours as well: \w the offering|strong="H08641"\w* \w of their gifts|strong="H04976"\w*, \w along with all|strong="H03605"\w* \w the wave offerings|strong="H08573"\w* \w vvv|strong="H01121"\w* \w of the Israelites|strong="H03478"\w*. \w I have given this|strong="H05414"\w* to you \w and your sons|strong="H01121"\w* \w and daughters|strong="H01323"\w* \w . . .|strong="H00854"\w* \w as a permanent|strong="H05769"\w* \w statute|strong="H02706"\w*. \w Every|strong="H03605"\w* \w ceremonially clean person|strong="H02889"\w* \w in your household|strong="H01004"\w* \w may eat it|strong="H00398"\w* \w -|strong="H00853"\w*. \v 12 \w I give you|strong="H05414"\w* \w all|strong="H03605"\w* \w the freshest|strong="H02459"\w* \w olive oil|strong="H03323"\w* \w and all|strong="H03605"\w* \w the finest|strong="H02459"\w* \w new wine|strong="H08492"\w* \w and grain|strong="H01715"\w* \w that|strong="H00834"\w* \w the Israelites give|strong="H05414"\w* \w to the LORD|strong="H03068"\w* \w as their firstfruits|strong="H07225"\w*. \v 13 \w The firstfruits|strong="H01061"\w* \w of everything|strong="H03605"\w* \w -|strong="H00834"\w* \w in their land|strong="H00776"\w* \w that|strong="H00834"\w* \w they bring|strong="H00935"\w* \w to the LORD|strong="H03068"\w* \w will belong|strong="H01961"\w* to you. \w Every|strong="H03605"\w* \w ceremonially clean person|strong="H02889"\w* \w in your household|strong="H01004"\w* \w may eat them|strong="H00398"\w*.
\p \v 14 \w Every|strong="H03605"\w* \w devoted thing|strong="H02764"\w* \w in Israel|strong="H03478"\w* \w belongs to you|strong="H01961"\w*. \v 15 \w The firstborn|strong="H06363"\w* \w . . .|strong="H07358"\w* \w . . .|strong="H03605"\w* \w of every|strong="H03605"\w* \w womb|strong="H01320"\w*, \w whether|strong="H00834"\w* \w man|strong="H00120"\w* \w or beast|strong="H00929"\w*, \w that is offered|strong="H07126"\w* \w to the LORD|strong="H03068"\w* \w belongs|strong="H01961"\w* to you. \w But|strong="H00389"\w* \w you must surely redeem|strong="H06299"\w* \w . . .|strong="H06299"\w* \w -|strong="H00853"\w* \w every firstborn|strong="H01060"\w* \w son|strong="H00120"\w* \w -|strong="H00853"\w* \w [and]|strong="H06299"\w* \w every firstborn male|strong="H01060"\w* \w of unclean|strong="H02931"\w* \w animals|strong="H00929"\w*. \v 16 \w You are to pay the redemption price|strong="H06299"\w* \w for a month-old male|strong="H01121"\w* \w . . .|strong="H02320"\w* \w . . .|strong="H06299"\w* \w according to your valuation|strong="H06187"\w*: \w five|strong="H02568"\w* \w shekels|strong="H08255"\w* \w of silver|strong="H03701"\w*,\f + \fr 18:16 \fqa 5 shekels \ft is approximately 2 ounces or 57 grams of silver.\f* \w according to the sanctuary|strong="H06944"\w* \w shekel|strong="H08255"\w*, \w which|strong="H01931"\w* \w is twenty|strong="H06242"\w* \w gerahs|strong="H01626"\w*.\f + \fr 18:16 \fqa 20 gerahs \ft is equivalent to one shekel (approximately 0.4 ounces or 11.4 grams).\f*
\p \v 17 \w But|strong="H00389"\w* \w you must not|strong="H03808"\w* \w redeem|strong="H06299"\w* \w the firstborn|strong="H01060"\w* \w of an ox|strong="H07794"\w*, \w a sheep|strong="H03775"\w*, \w . . .|strong="H00176"\w* \w . . .|strong="H01060"\w* \w or|strong="H00176"\w* \w . . .|strong="H01060"\w* \w a goat|strong="H05795"\w*; \w they|strong="H01992"\w* \w -|strong="H00853"\w* \w are holy|strong="H06944"\w*. \w You are to splatter|strong="H02236"\w* \w their blood|strong="H01818"\w* \w on|strong="H05921"\w* \w the altar|strong="H04196"\w* \w -|strong="H00853"\w* \w and burn|strong="H06999"\w* \w their fat|strong="H02459"\w* \w as a food offering|strong="H00801"\w*, \w a pleasing|strong="H05207"\w* \w aroma|strong="H07381"\w* \w to the LORD|strong="H03068"\w*. \v 18 \w And their meat|strong="H01320"\w* \w belongs|strong="H01961"\w* to you, \w just as the breast|strong="H02373"\w* \w and right|strong="H03225"\w* \w thigh|strong="H07785"\w* \w of the wave offering|strong="H08573"\w* \w belong|strong="H01961"\w* to you.
\p \v 19 \w All|strong="H03605"\w* \w the holy|strong="H06944"\w* \w offerings|strong="H08641"\w* \w that|strong="H00834"\w* \w vvv|strong="H01121"\w* \w the Israelites|strong="H03478"\w* \w present|strong="H07311"\w* \w to the LORD|strong="H03068"\w* \w I give|strong="H05414"\w* to you \w and to your sons|strong="H01121"\w* \w and daughters|strong="H01323"\w* \w . . .|strong="H00854"\w* \w as a permanent|strong="H05769"\w* \w statute|strong="H02706"\w*. \w It|strong="H01931"\w* \w is a permanent|strong="H05769"\w* \w covenant|strong="H01285"\w* \w of salt|strong="H04417"\w*\f + \fr 18:19 \ft That is, a perpetual covenant\f* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* for you \w and your offspring|strong="H02233"\w* \w . . .|strong="H00854"\w*.”
\p \v 20 \w Then the LORD|strong="H03068"\w* \w . . .|strong="H00413"\w* \w said|strong="H00559"\w* \w to Aaron|strong="H00175"\w*, “\w You will have no|strong="H03808"\w* \w inheritance|strong="H05157"\w* \w in their land|strong="H00776"\w*, \w nor|strong="H03808"\w* \w will you have|strong="H01961"\w* \w any portion|strong="H02506"\w* \w among them|strong="H08432"\w*. \w I|strong="H00589"\w* \w am your portion|strong="H02506"\w* \w and your inheritance|strong="H05159"\w* \w among|strong="H08432"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*.
\p \v 21 \w Behold|strong="H02009"\w*, \w I have given|strong="H05414"\w* \w to the Levites|strong="H01121"\w* \w . . .|strong="H03878"\w* \w all|strong="H03605"\w* \w the tithes|strong="H04643"\w* \w in Israel|strong="H03478"\w* \w as an inheritance|strong="H05159"\w* \w in return for|strong="H02500"\w* \w the work|strong="H05656"\w* \w -|strong="H00834"\w* \w they|strong="H01992"\w* \w do|strong="H05647"\w*, \w -|strong="H00853"\w* \w the service|strong="H05656"\w* \w of the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*. \v 22 \w No|strong="H03808"\w* \w longer|strong="H05750"\w* \w may the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w come|strong="H00413"\w* \w near|strong="H07126"\w* \w to the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*, \w or they will incur|strong="H05375"\w* \w guilt|strong="H02399"\w* \w and die|strong="H04191"\w*.
\p \v 23 \w The Levites|strong="H03881"\w* \w . . .|strong="H01931"\w* \w -|strong="H00853"\w* \w are to perform|strong="H05647"\w* \w the work|strong="H05656"\w* \w of the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*, \w and they|strong="H01992"\w* \w must bear|strong="H05375"\w* \w their iniquity|strong="H05771"\w*. \w This is a permanent|strong="H05769"\w* \w statute|strong="H02708"\w* \w for the generations to come|strong="H01755"\w*. \w The Levites will not|strong="H03808"\w* \w receive an inheritance|strong="H05157"\w* \w . . .|strong="H05159"\w* \w among|strong="H08432"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*. \v 24 \w For|strong="H03588"\w* \w -|strong="H00853"\w* \w I have given|strong="H05414"\w* \w to the Levites|strong="H03881"\w* \w as their inheritance|strong="H05159"\w* \w the tithe|strong="H04643"\w* \w that|strong="H00834"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w present|strong="H07311"\w* \w to the LORD|strong="H03068"\w* \w as a contribution|strong="H08641"\w*. \w That is why|strong="H05921"\w* \w . . .|strong="H03651"\w* \w I told them|strong="H00559"\w* . . . \w that they would not|strong="H03808"\w* \w receive an inheritance|strong="H05157"\w* \w . . .|strong="H05159"\w* \w among|strong="H08432"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*.”
\p \v 25 \w And the LORD|strong="H03068"\w* \w . . .|strong="H00413"\w* \w instructed|strong="H01696"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00559"\w*, \v 26 “\w Speak|strong="H01696"\w* \w to|strong="H00413"\w* \w the Levites|strong="H03881"\w* \w and tell them|strong="H00559"\w* \w . . .|strong="H00413"\w*: ‘\w When|strong="H03588"\w* \w you receive|strong="H03947"\w* \w from|strong="H00854"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w -|strong="H00853"\w* \w the tithe|strong="H04643"\w* \w that|strong="H00834"\w* \w I have given|strong="H05414"\w* you \w . . .|strong="H00854"\w* \w as your inheritance|strong="H05159"\w*, \w you must present|strong="H07311"\w* \w part|strong="H04480"\w* \w of it|strong="H04480"\w* \w as an offering|strong="H08641"\w* \w to the LORD|strong="H03068"\w*— \w a tithe|strong="H04643"\w* \w of the tithe|strong="H04643"\w*. \v 27 \w Your offering|strong="H08641"\w* \w will be reckoned|strong="H02803"\w* to you \w as grain|strong="H01715"\w* \w from|strong="H04480"\w* \w the threshing floor|strong="H01637"\w* \w or juice|strong="H04395"\w* \w from|strong="H04480"\w* \w the winepress|strong="H03342"\w*. \v 28 \w So|strong="H03651"\w* \w you|strong="H00859"\w* \w are to present|strong="H07311"\w* \w . . .|strong="H01571"\w* \w an offering|strong="H08641"\w* \w to the LORD|strong="H03068"\w* \w from all|strong="H03605"\w* \w the tithes|strong="H04643"\w* \w -|strong="H00834"\w* \w you receive|strong="H03947"\w* \w . . .|strong="H00854"\w* \w from the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*, \w and from [these]|strong="H04480"\w* \w -|strong="H00853"\w* \w you are to give|strong="H05414"\w* \w the LORD’s|strong="H03068"\w* \w offering|strong="H08641"\w* \w to Aaron|strong="H00175"\w* \w the priest|strong="H03548"\w*. \v 29 \w You must present|strong="H07311"\w* \w -|strong="H00853"\w* \w the offering|strong="H08641"\w* \w due the LORD|strong="H03068"\w* \w from|strong="H03605"\w* \w all|strong="H03605"\w* \w the best|strong="H02459"\w* \w of every|strong="H03605"\w* \w gift|strong="H04979"\w*, \w -|strong="H00853"\w* \w the holiest part|strong="H04720"\w* \w of it|strong="H04480"\w*.’
\p \v 30 \w Therefore say|strong="H00559"\w* \w to [the Levites]|strong="H00413"\w*, ‘\w When you have presented|strong="H07311"\w* \w -|strong="H00853"\w* \w the best part|strong="H02459"\w* \w -|strong="H04480"\w*, \w it will be reckoned|strong="H02803"\w* \w [to you]|strong="H03881"\w* \w as the produce|strong="H08393"\w* \w of the threshing floor|strong="H01637"\w* \w vvv|strong="H08393"\w* \w or winepress|strong="H03342"\w*. \v 31 \w And you|strong="H00859"\w* \w and your households|strong="H01004"\w* \w . . .|strong="H03588"\w* \w may eat [the rest of it] anywhere|strong="H00398"\w* \w -|strong="H00853"\w* \w -|strong="H03605"\w* \w . . .|strong="H04725"\w*; \w it|strong="H01931"\w* \w is the compensation|strong="H07939"\w* \w for|strong="H02500"\w* \w your work|strong="H05656"\w* \w at the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*. \v 32 \w Once you have presented|strong="H07311"\w* \w -|strong="H00853"\w* \w the best part|strong="H02459"\w* \w of it|strong="H04480"\w*, \w you will not|strong="H03808"\w* \w incur|strong="H05375"\w* \w guilt|strong="H02399"\w* \w because of it|strong="H05921"\w*. \w But|strong="H00853"\w* \w you must not|strong="H03808"\w* \w defile|strong="H02490"\w* \w the sacred offerings|strong="H06944"\w* \w vvv|strong="H01121"\w* \w of the Israelites|strong="H03478"\w*, \w or else|strong="H03808"\w* \w you will die|strong="H04191"\w*.’”
\c 19
\s1 The Red Heifer
\p \v 1 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00413"\w* \w and Aaron|strong="H00175"\w* \w . . .|strong="H00559"\w*, \v 2 “\w This|strong="H02063"\w* \w is the statute|strong="H02708"\w* \w of the law|strong="H08451"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w . . .|strong="H00559"\w* \w has commanded|strong="H06680"\w*: \w Instruct|strong="H01696"\w* \w . . .|strong="H00413"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w to bring|strong="H03947"\w* \w you|strong="H00413"\w* \w an unblemished|strong="H08549"\w* \w red|strong="H00122"\w* \w heifer|strong="H06510"\w* \w that|strong="H00834"\w* \w has no|strong="H00369"\w* \w defect|strong="H03971"\w* \w -|strong="H00834"\w* \w and has never|strong="H03808"\w* \w been placed|strong="H05927"\w*\w . . .|strong="H05921"\w* \w under a yoke|strong="H05923"\w*. \v 3 \w Give|strong="H05414"\w* \w -|strong="H00853"\w* \w it to|strong="H00413"\w* \w Eleazar|strong="H00499"\w* \w the priest|strong="H03548"\w*, \w and he will have it brought|strong="H03318"\w* \w -|strong="H00853"\w* \w -|strong="H00413"\w* \w outside|strong="H02351"\w* \w the camp|strong="H04264"\w* \w and slaughtered|strong="H07819"\w* \w -|strong="H00853"\w* \w in his presence|strong="H06440"\w*.
\p \v 4 \w Eleazar|strong="H00499"\w* \w the priest|strong="H03548"\w* \w is to take|strong="H03947"\w* \w some of its blood|strong="H01818"\w* \w on his finger|strong="H00676"\w* \w and sprinkle|strong="H05137"\w* \w [it]|strong="H01818"\w* \w seven|strong="H07651"\w* \w times|strong="H06471"\w* \w toward|strong="H00413"\w* \w . . .|strong="H05227"\w* \w the front|strong="H06440"\w* \w of the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*. \v 5 \w Then the heifer|strong="H06510"\w* \w must be burned|strong="H08313"\w* \w -|strong="H00853"\w* \w in his sight|strong="H05869"\w*. \w -|strong="H00853"\w* \w Its hide|strong="H05785"\w*, \w -|strong="H00853"\w* \w its flesh|strong="H01320"\w*, \w -|strong="H00853"\w* \w and its blood|strong="H01818"\w* \w are to be burned|strong="H08313"\w*, \w along with|strong="H05921"\w* \w its dung|strong="H06569"\w*. \v 6 \w The priest|strong="H03548"\w* \w is to take|strong="H03947"\w* \w cedar|strong="H00730"\w* \w wood|strong="H06086"\w*, \w hyssop|strong="H00231"\w*, \w and scarlet wool|strong="H08144"\w* \w . . .|strong="H08438"\w* \w and throw|strong="H07993"\w* \w them|strong="H00413"\w* \w onto|strong="H08432"\w* \w the burning|strong="H08316"\w* \w heifer|strong="H06510"\w*.
\p \v 7 \w Then the priest|strong="H03548"\w* \w must wash|strong="H03526"\w* \w his clothes|strong="H00899"\w* \w and bathe|strong="H07364"\w* \w his body|strong="H01320"\w* \w in water|strong="H04325"\w*; \w after that|strong="H00310"\w* \w he may enter|strong="H00935"\w* \w . . .|strong="H00413"\w* \w the camp|strong="H04264"\w*, \w but he|strong="H03548"\w* \w will be ceremonially unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*. \v 8 \w The one who burned|strong="H08313"\w* \w [the heifer]|strong="H00853"\w* \w must also wash|strong="H03526"\w* \w his clothes|strong="H00899"\w* \w and bathe|strong="H07364"\w* \w his body|strong="H01320"\w* \w . . .|strong="H04325"\w* \w in water|strong="H04325"\w*, \w and he too will be ceremonially unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*.
\p \v 9 \w Then a man|strong="H00376"\w* \w who is ceremonially clean|strong="H02889"\w* \w -|strong="H00853"\w* \w is to gather up|strong="H00622"\w* \w the ashes|strong="H00665"\w* \w of the heifer|strong="H06510"\w* \w and store [them]|strong="H05117"\w* \w in a ceremonially clean|strong="H02889"\w* \w place|strong="H04725"\w* \w outside|strong="H02351"\w* \w the camp|strong="H04264"\w*. \w They must be|strong="H01961"\w* \w kept|strong="H04931"\w* \w by the congregation|strong="H05712"\w* \w . . .|strong="H01121"\w* \w of Israel|strong="H03478"\w* \w for preparing the water|strong="H04325"\w* \w of purification|strong="H05079"\w*; \w this [is]|strong="H01931"\w* \w for purification from sin|strong="H02403"\w*. \v 10 \w The man who has gathered up|strong="H00622"\w* \w -|strong="H00853"\w* \w the ashes|strong="H00665"\w* \w of the heifer|strong="H06510"\w* \w -|strong="H00853"\w* \w must also wash|strong="H03526"\w* \w his clothes|strong="H00899"\w*, \w and he will be ceremonially unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*. \w This|strong="H01961"\w* \w is a permanent|strong="H05769"\w* \w statute|strong="H02708"\w* \w for the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w and for the foreigner|strong="H01616"\w* \w residing|strong="H01481"\w* \w among them|strong="H08432"\w*.
\s1 Purification of the Unclean
\p \v 11 \w Whoever touches|strong="H05060"\w* \w any|strong="H03605"\w* \w dead|strong="H04191"\w* \w vvv|strong="H00120"\w* \w body|strong="H05315"\w* \w will be unclean|strong="H02930"\w* \w for seven|strong="H07651"\w* \w days|strong="H03117"\w*. \v 12 \w He|strong="H01931"\w* \w must purify himself|strong="H02398"\w* with [the water] \w on the third|strong="H07992"\w* \w day|strong="H03117"\w* \w and on the seventh|strong="H07637"\w* \w day|strong="H03117"\w*; \w then he will be clean|strong="H02891"\w*. \w But if|strong="H00518"\w* \w he does not|strong="H03808"\w* \w purify himself|strong="H02398"\w* \w on the third|strong="H07992"\w* \w . . .|strong="H03117"\w* \w and seventh|strong="H07637"\w* \w days|strong="H03117"\w*, \w he will not|strong="H03808"\w* \w be clean|strong="H02891"\w*. \v 13 \w Anyone|strong="H03605"\w* \w who touches|strong="H05060"\w* \w a human|strong="H00120"\w* \w -|strong="H00834"\w* \w -|strong="H04191"\w* \w corpse|strong="H04191"\w* \w . . .|strong="H05315"\w* \w and fails|strong="H03808"\w* \w to purify|strong="H02398"\w* \w himself|strong="H00853"\w* \w defiles|strong="H02930"\w* \w the tabernacle|strong="H04908"\w* \w of the LORD|strong="H03068"\w*. \w That|strong="H01931"\w* \w person|strong="H05315"\w* \w must be cut off|strong="H03772"\w* \w from Israel|strong="H03478"\w*. \w He remains|strong="H01961"\w* \w unclean|strong="H02931"\w*, \w because|strong="H03588"\w* \w the water|strong="H04325"\w* \w of purification|strong="H05079"\w* \w has not|strong="H03808"\w* \w been sprinkled|strong="H02236"\w* \w on him|strong="H05921"\w*, \w and his uncleanness|strong="H02932"\w* \w is still on him|strong="H05750"\w*.
\p \v 14 \w This|strong="H02063"\w* \w is the law|strong="H08451"\w* \w when|strong="H03588"\w* \w a person|strong="H00120"\w* \w dies|strong="H04191"\w* \w in a tent|strong="H00168"\w*: \w Everyone|strong="H03605"\w* \w who enters|strong="H00935"\w* \w . . .|strong="H00413"\w* \w the tent|strong="H00168"\w* \w and everyone|strong="H03605"\w* \w -|strong="H00834"\w* \w already in the tent|strong="H00168"\w* \w will be unclean|strong="H02930"\w* \w for seven|strong="H07651"\w* \w days|strong="H03117"\w*, \v 15 \w and any|strong="H03605"\w* \w open|strong="H06605"\w* \w -|strong="H00834"\w* \w container|strong="H03627"\w* \w without|strong="H00369"\w* \w a lid|strong="H06781"\w* \w fastened|strong="H06616"\w* \w on it|strong="H05921"\w* \w is unclean|strong="H02931"\w* \w . . .|strong="H01931"\w*.
\p \v 16 \w Anyone|strong="H03605"\w* \w in|strong="H05921"\w* \w the open field|strong="H06440"\w* \w . . .|strong="H07704"\w* \w who|strong="H00834"\w* \w touches|strong="H05060"\w* \w someone who has been killed|strong="H02491"\w* \w by the sword|strong="H02719"\w* \w or|strong="H00176"\w* \w has died of natural causes|strong="H04191"\w*, \w or|strong="H00176"\w* \w anyone who touches a human|strong="H00120"\w* \w bone|strong="H06106"\w* \w or|strong="H00176"\w* \w a grave|strong="H06913"\w*, \w will be unclean|strong="H02930"\w* \w for seven|strong="H07651"\w* \w days|strong="H03117"\w*.
\p \v 17 \w [For the purification] of the unclean person,|strong="H02931"\w* \w take|strong="H03947"\w* \w some of the ashes|strong="H06083"\w* \w of the burnt|strong="H08316"\w* \w sin offering|strong="H02403"\w*, \w put them|strong="H05414"\w* \w in|strong="H00413"\w* \w a jar|strong="H03627"\w*, \w and pour fresh|strong="H02416"\w* \w water|strong="H04325"\w*\f + \fr 19:17 \ft Or \fqa flowing water \ft or \fqa living water\f* \w over them|strong="H05921"\w*. \v 18 \w Then a man|strong="H00376"\w* \w who is ceremonially clean|strong="H02889"\w* \w is to take|strong="H03947"\w* \w some hyssop|strong="H00231"\w*, \w dip|strong="H02881"\w* \w it in the water|strong="H04325"\w*, \w and sprinkle|strong="H05137"\w* \w . . .|strong="H05921"\w* \w the tent|strong="H00168"\w*, \w . . .|strong="H05921"\w* \w all|strong="H03605"\w* \w the furnishings|strong="H03627"\w*, \w . . .|strong="H05921"\w* \w and the people|strong="H05315"\w* \w who|strong="H00834"\w* \w were|strong="H01961"\w* \w there|strong="H08033"\w* \w . . .|strong="H05921"\w*. \w He is also to sprinkle the one who touched|strong="H05060"\w* \w a bone|strong="H06106"\w*, \w a grave|strong="H06913"\w*, \w or a person who has died|strong="H04191"\w* \w . . .|strong="H00176"\w* \w or|strong="H00176"\w* \w been slain|strong="H02491"\w* \w . . .|strong="H00176"\w*.
\p \v 19 \w The man who is ceremonially clean|strong="H02889"\w* \w . . .|strong="H05921"\w* \w is to sprinkle|strong="H05137"\w* \w the unclean person|strong="H02931"\w* \w on the third|strong="H07992"\w* \w day|strong="H03117"\w* \w and on the seventh|strong="H07637"\w* \w day|strong="H03117"\w*. \w After he purifies|strong="H02398"\w* \w the unclean person on the seventh|strong="H07637"\w* \w day|strong="H03117"\w*, \w [the one being cleansed] must wash|strong="H03526"\w* \w his clothes|strong="H00899"\w* \w and bathe|strong="H07364"\w* \w in water|strong="H04325"\w*, \w and that evening|strong="H06153"\w* \w he will be clean|strong="H02891"\w*. \v 20 \w But if a person|strong="H00376"\w* \w who|strong="H00834"\w* \w is unclean|strong="H02930"\w* \w does not|strong="H03808"\w* \w purify|strong="H02398"\w* \w himself|strong="H01931"\w*, \w [he]|strong="H05315"\w* \w will be cut off|strong="H03772"\w* \w from|strong="H08432"\w* \w the assembly|strong="H06951"\w*, \w because|strong="H03588"\w* \w -|strong="H00853"\w* \w he has defiled|strong="H02930"\w* \w the sanctuary|strong="H04720"\w* \w of the LORD|strong="H03068"\w*. \w The water|strong="H04325"\w* \w of [purification]|strong="H05079"\w* \w has not|strong="H03808"\w* \w been sprinkled|strong="H02236"\w* \w on him|strong="H05921"\w*; \w he|strong="H01931"\w* \w is unclean|strong="H02931"\w*.
\p \v 21 \w This|strong="H01961"\w* \w is a permanent|strong="H05769"\w* \w statute|strong="H02708"\w* for [the people]: \w The one who sprinkles|strong="H05137"\w* \w the water|strong="H04325"\w* \w of [purification]|strong="H05079"\w* \w must wash|strong="H03526"\w* \w his clothes|strong="H00899"\w*, \w and whoever touches|strong="H05060"\w* \w the water|strong="H04325"\w* \w of [purification]|strong="H05079"\w* \w will be unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*. \v 22 \w Anything|strong="H03605"\w* \w -|strong="H00834"\w* \w the unclean|strong="H02931"\w* \w person touches|strong="H05060"\w* \w will become unclean|strong="H02930"\w*, \w and anyone|strong="H05315"\w* \w who touches it|strong="H05060"\w* \w will be unclean|strong="H02930"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*.”
\c 20
\s1 Water from the Rock
\r (Exodus 17:1–7)
\p \v 1 \w In the first|strong="H07223"\w* \w month|strong="H02320"\w*, \w the whole|strong="H03605"\w* \w congregation|strong="H05712"\w* \w . . .|strong="H01121"\w* \w of Israel|strong="H03478"\w* \w entered|strong="H00935"\w* \w the Wilderness|strong="H04057"\w* \w of Zin|strong="H06790"\w* \w [and]|strong="H05971"\w* \w stayed|strong="H03427"\w* \w in Kadesh|strong="H06946"\w*. \w There|strong="H08033"\w* \w Miriam|strong="H04813"\w* \w died|strong="H04191"\w* \w and was buried|strong="H06912"\w* \w . . .|strong="H08033"\w*.
\p \v 2 \w Now there was|strong="H01961"\w* \w no|strong="H03808"\w* \w water|strong="H04325"\w* \w for the congregation|strong="H05712"\w*, \w so they gathered|strong="H06950"\w* \w against|strong="H05921"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H05921"\w* \w and Aaron|strong="H00175"\w*. \v 3 \w The people|strong="H05971"\w* \w quarreled|strong="H07378"\w* \w with|strong="H05973"\w* \w Moses|strong="H04872"\w* \w and said|strong="H00559"\w* \w . . .|strong="H00559"\w*, “\w If only|strong="H03863"\w* \w we had perished|strong="H01478"\w* \w . . .|strong="H01478"\w* \w with our brothers|strong="H00251"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*! \v 4 \w Why|strong="H04100"\w* \w have you brought|strong="H00935"\w* \w -|strong="H00853"\w* \w the LORD’s|strong="H03068"\w* \w assembly|strong="H06951"\w* \w into|strong="H00413"\w* \w this|strong="H02088"\w* \w wilderness|strong="H04057"\w* \w for us|strong="H00587"\w* \w and our livestock|strong="H01165"\w* \w to die|strong="H04191"\w* \w here|strong="H08033"\w*? \v 5 \w Why|strong="H04100"\w* \w have you led us up|strong="H05927"\w* \w out of Egypt|strong="H04714"\w* \w to bring|strong="H00935"\w* \w us|strong="H00853"\w* \w to|strong="H00413"\w* \w this|strong="H02088"\w* \w wretched|strong="H07451"\w* \w place|strong="H04725"\w*? \w It is not|strong="H03808"\w* \w a place|strong="H04725"\w* \w of grain|strong="H02233"\w*, \w figs|strong="H08384"\w*, \w vines|strong="H01612"\w*, \w or pomegranates|strong="H07416"\w* — \w and there is no|strong="H00369"\w* \w water|strong="H04325"\w* \w to drink|strong="H08354"\w*!”
\p \v 6 \w Then Moses|strong="H04872"\w* \w and Aaron|strong="H00175"\w* \w went|strong="H00935"\w* \w from the presence|strong="H06440"\w* \w of the assembly|strong="H06951"\w* \w to|strong="H00413"\w* \w the entrance|strong="H06607"\w* \w to the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*. \w They fell facedown|strong="H05307"\w* \w . . .|strong="H05921"\w* \w . . .|strong="H06440"\w*, \w and the glory|strong="H03519"\w* \w of the LORD|strong="H03068"\w* \w appeared|strong="H07200"\w* \w to them|strong="H00413"\w*. \v 7 \w And the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00559"\w*, \v 8 “\w Take|strong="H03947"\w* \w -|strong="H00853"\w* \w the staff|strong="H04294"\w* \w and assemble|strong="H06950"\w* \w -|strong="H00853"\w* \w the congregation|strong="H05712"\w*. \w You|strong="H00859"\w* \w and your brother|strong="H00251"\w* \w Aaron|strong="H00175"\w* \w are to speak|strong="H01696"\w* \w to|strong="H00413"\w* \w the rock|strong="H05553"\w* \w while they watch|strong="H05869"\w*, \w and it will pour out|strong="H05414"\w* \w its water|strong="H04325"\w*. \w You will bring out|strong="H03318"\w* \w water|strong="H04325"\w* \w from|strong="H04480"\w* \w the rock|strong="H05553"\w* \w and provide drink|strong="H08248"\w* \w -|strong="H00853"\w* \w for the congregation|strong="H05712"\w* \w -|strong="H00853"\w* \w and their livestock|strong="H01165"\w*.”
\p \v 9 \w So Moses|strong="H04872"\w* \w -|strong="H00853"\w* \w took|strong="H03947"\w* \w the staff|strong="H04294"\w* \w from the LORD’s|strong="H03068"\w* \w presence|strong="H06440"\w*, \w just as|strong="H00834"\w* \w he had been commanded|strong="H06680"\w*. \v 10 \w Then Moses|strong="H04872"\w* \w and Aaron|strong="H00175"\w* \w -|strong="H00853"\w* \w gathered|strong="H06950"\w* \w the assembly|strong="H06951"\w* \w in|strong="H00413"\w* \w front|strong="H06440"\w* \w of the rock|strong="H05553"\w*, \w and [Moses] said|strong="H00559"\w* to them, “\w Listen|strong="H08085"\w* \w now|strong="H04994"\w*, \w you rebels|strong="H04784"\w*, \w must we bring you water|strong="H04325"\w* \w out|strong="H03318"\w* \w of|strong="H04480"\w* \w this|strong="H02088"\w* \w rock|strong="H05553"\w*?” \v 11 \w Then Moses|strong="H04872"\w* \w -|strong="H00853"\w* \w raised|strong="H07311"\w* \w his hand|strong="H03027"\w* \w and struck|strong="H05221"\w* \w -|strong="H00853"\w* \w the rock|strong="H05553"\w* \w twice|strong="H06471"\w* \w with his staff|strong="H04294"\w*, \w so that a great amount of|strong="H07227"\w* \w water|strong="H04325"\w* \w gushed out|strong="H03318"\w*, \w and the congregation|strong="H05712"\w* \w and their livestock|strong="H01165"\w* \w were able to drink|strong="H08354"\w*.
\p \v 12 \w But the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w and|strong="H00413"\w* \w Aaron|strong="H00175"\w*, “\w Because|strong="H03282"\w* \w you did not|strong="H03808"\w* \w trust|strong="H00539"\w* Me \w to show My holiness|strong="H06942"\w* \w in the sight|strong="H05869"\w* \w vvv|strong="H01121"\w* \w of the Israelites|strong="H03478"\w*, \w . . .|strong="H03651"\w* \w you will not|strong="H03808"\w* \w bring|strong="H00935"\w* \w -|strong="H00853"\w* \w this|strong="H02088"\w* \w . . .|strong="H00413"\w* \w assembly|strong="H06951"\w* \w into the land|strong="H00776"\w* \w that|strong="H00834"\w* \w I have given|strong="H05414"\w* them.”
\p \v 13 \w These|strong="H01992"\w* \w were the waters|strong="H04325"\w* \w of Meribah|strong="H04809"\w*,\f + \fr 20:13 \fqa Meribah \ft means \fqa quarreling\ft ; also in verse 24; see Exodus 17:7.\f* \w where|strong="H00834"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w quarreled|strong="H07378"\w* \w with|strong="H00854"\w* \w the LORD|strong="H03068"\w*, \w and He showed His holiness|strong="H06942"\w* among them.
\s1 Edom Refuses Passage
\p \v 14 \w From Kadesh|strong="H06946"\w*, \w Moses|strong="H04872"\w* \w sent|strong="H07971"\w* \w messengers|strong="H04397"\w* \w to [tell]|strong="H00413"\w* \w the king|strong="H04428"\w* \w of Edom|strong="H00123"\w*, “\w This is what|strong="H03541"\w* \w your brother|strong="H00251"\w* \w Israel|strong="H03478"\w* \w says|strong="H00559"\w*: \w You|strong="H00859"\w* \w know|strong="H03045"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the hardship|strong="H08513"\w* \w that|strong="H00834"\w* \w has befallen us|strong="H04672"\w*, \v 15 \w how our fathers|strong="H00001"\w* \w went down|strong="H03381"\w* \w to Egypt|strong="H04714"\w*, \w where we lived|strong="H03427"\w* \w -|strong="H04714"\w* \w many|strong="H07227"\w* \w years|strong="H03117"\w*. \w The Egyptians|strong="H04713"\w* \w mistreated|strong="H07489"\w* us \w and our fathers|strong="H00001"\w*, \v 16 \w and when we cried out|strong="H06817"\w* \w to|strong="H00413"\w* \w the LORD|strong="H03068"\w*, \w He heard|strong="H08085"\w* \w our voice|strong="H06963"\w*, \w sent|strong="H07971"\w* \w an angel|strong="H04397"\w*, \w and brought us|strong="H03318"\w* \w out of Egypt|strong="H04714"\w*.
\p \w Now look|strong="H02009"\w*, \w we|strong="H00587"\w* \w are in Kadesh|strong="H06946"\w*, \w a city|strong="H05892"\w* \w on the edge|strong="H07097"\w* \w of your territory|strong="H01366"\w*. \v 17 \w Please|strong="H04994"\w* \w let us pass|strong="H05674"\w* \w through your land|strong="H00776"\w*. \w We will not|strong="H03808"\w* \w go through|strong="H05674"\w* \w any field|strong="H07704"\w* \w or vineyard|strong="H03754"\w*, \w [or]|strong="H03808"\w* \w drink|strong="H08354"\w* \w water|strong="H04325"\w* \w from any well|strong="H00875"\w*. \w We will stay on|strong="H01980"\w* \w the King’s|strong="H04428"\w* \w Highway|strong="H01870"\w*; \w we will not|strong="H03808"\w* \w turn|strong="H05186"\w* \w to the right|strong="H03225"\w* \w or to the left|strong="H08040"\w* \w until|strong="H05704"\w* \w -|strong="H00834"\w* \w we have passed through|strong="H05674"\w* \w your territory|strong="H01366"\w*.”
\p \v 18 \w But Edom|strong="H00123"\w* \w answered|strong="H00559"\w*, \w . . .|strong="H00413"\w* “\w You may not|strong="H03808"\w*\w . . .|strong="H06435"\w* \w travel|strong="H05674"\w* through our land, \w or we will come out|strong="H03318"\w* \w and confront you|strong="H07122"\w* \w with the sword|strong="H02719"\w*.”
\p \v 19 “\w We will stay|strong="H05927"\w* \w on the main road|strong="H04546"\w*,” \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w replied|strong="H00559"\w* \w -|strong="H00413"\w*, “\w and if|strong="H00518"\w* \w we|strong="H00589"\w* \w or our herds|strong="H04735"\w* \w drink|strong="H08354"\w* \w your water|strong="H04325"\w*, \w we will pay|strong="H05414"\w* \w for it|strong="H04377"\w*. \w There will be no|strong="H00369"\w* \w problem|strong="H01697"\w*; \w only|strong="H07535"\w* \w let us pass through|strong="H05674"\w* \w on foot|strong="H07272"\w*.”
\p \v 20 \w But Edom|strong="H00123"\w* \w insisted|strong="H00559"\w*, “\w You may not|strong="H03808"\w* \w pass through|strong="H05674"\w*.” \w And they came out|strong="H03318"\w* \w to confront [the Israelites]|strong="H07122"\w* \w with a large|strong="H03515"\w* \w army|strong="H05971"\w* \w and a strong|strong="H02389"\w* \w hand|strong="H03027"\w*. \v 21 \w So Edom|strong="H00123"\w* \w refused|strong="H03985"\w* \w to allow|strong="H05414"\w* \w -|strong="H00853"\w* \w Israel|strong="H03478"\w* \w to pass|strong="H05674"\w* \w through their territory|strong="H01366"\w*, \w and Israel|strong="H03478"\w* \w turned away|strong="H05186"\w* \w from them|strong="H05921"\w*.
\s1 The Death of Aaron
\p \v 22 \w After they had set out|strong="H05265"\w* \w from Kadesh|strong="H06946"\w*, \w the whole|strong="H03605"\w* \w congregation|strong="H05712"\w* \w . . .|strong="H01121"\w* \w of Israel|strong="H03478"\w* \w came|strong="H00935"\w* \w to Mount|strong="H02022"\w* \w Hor|strong="H02023"\w*. \v 23 \w And at Mount|strong="H02022"\w* \w Hor|strong="H02023"\w*, \w near|strong="H05921"\w* \w the border|strong="H01366"\w* \w of the land|strong="H00776"\w* \w of Edom|strong="H00123"\w*, \w the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00413"\w* \w and Aaron|strong="H00175"\w*, \w -|strong="H00559"\w* \v 24 “\w Aaron|strong="H00175"\w* \w will be gathered|strong="H00622"\w* \w to|strong="H00413"\w* \w his people|strong="H05971"\w*; \w . . .|strong="H03588"\w* \w he will not|strong="H03808"\w* \w enter|strong="H00935"\w* \w . . .|strong="H00413"\w* \w the land|strong="H00776"\w* \w that|strong="H00834"\w* \w I have given|strong="H05414"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w*, \w because|strong="H05921"\w* \w -|strong="H00834"\w* \w both of you rebelled|strong="H04784"\w* \w -|strong="H00853"\w* \w against My command|strong="H06310"\w* \w at the waters|strong="H04325"\w* \w of Meribah|strong="H04809"\w*. \v 25 \w Take|strong="H03947"\w* \w -|strong="H00853"\w* \w Aaron|strong="H00175"\w* \w -|strong="H00853"\w* \w and his son|strong="H01121"\w* \w Eleazar|strong="H00499"\w* \w and bring them up|strong="H05927"\w* \w -|strong="H00853"\w* \w Mount|strong="H02022"\w* \w Hor|strong="H02023"\w*. \v 26 \w Remove|strong="H06584"\w* \w -|strong="H00853"\w* \w Aaron’s|strong="H00175"\w* \w -|strong="H00853"\w* \w priestly garments|strong="H00899"\w* \w and put them on|strong="H03847"\w* \w -|strong="H00853"\w* \w his son|strong="H01121"\w* \w Eleazar|strong="H00499"\w*. \w Aaron|strong="H00175"\w* \w will be gathered [to his people]|strong="H00622"\w* \w and will die|strong="H04191"\w* \w there|strong="H08033"\w*.”
\p \v 27 \w So Moses|strong="H04872"\w* \w did|strong="H06213"\w* \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had commanded|strong="H06680"\w*, \w and they climbed|strong="H05927"\w* \w . . .|strong="H00413"\w* \w Mount|strong="H02022"\w* \w Hor|strong="H02023"\w* \w in the sight|strong="H05869"\w* \w of the whole|strong="H03605"\w* \w congregation|strong="H05712"\w*. \v 28 \w After Moses|strong="H04872"\w* \w -|strong="H00853"\w* \w had removed|strong="H06584"\w* \w Aaron’s|strong="H00175"\w* \w -|strong="H00853"\w* \w garments|strong="H00899"\w* \w and put them on|strong="H03847"\w* \w . . .|strong="H00854"\w* \w -|strong="H00853"\w* \w his son|strong="H01121"\w* \w Eleazar|strong="H00499"\w*, \w Aaron|strong="H00175"\w* \w died|strong="H04191"\w* \w there|strong="H08033"\w* \w on top|strong="H07218"\w* \w of the mountain|strong="H02022"\w*. \w Then Moses|strong="H04872"\w* \w and Eleazar|strong="H00499"\w* \w came down|strong="H03381"\w* \w from|strong="H04480"\w* \w the mountain|strong="H02022"\w*. \v 29 \w When the whole|strong="H03605"\w* \w congregation|strong="H05712"\w* \w saw|strong="H07200"\w* \w that|strong="H03588"\w* \w Aaron|strong="H00175"\w* \w had died|strong="H01478"\w*, \w the entire|strong="H03605"\w* \w house|strong="H01004"\w* \w of Israel|strong="H03478"\w* \w mourned|strong="H01058"\w* \w -|strong="H00853"\w* \w for him|strong="H00175"\w* \w thirty|strong="H07970"\w* \w days|strong="H03117"\w*.
\c 21
\s1 The Defeat of Arad
\p \v 1 \w When the Canaanite|strong="H03669"\w* \w king|strong="H04428"\w* \w of Arad|strong="H06166"\w*, \w who lived|strong="H03427"\w* \w in the Negev|strong="H05045"\w*, \w heard|strong="H08085"\w* \w that|strong="H03588"\w* \w Israel|strong="H03478"\w* \w was coming|strong="H00935"\w* \w along the road|strong="H01870"\w* \w to Atharim|strong="H00871"\w*, \w he attacked|strong="H03898"\w* \w Israel|strong="H03478"\w* \w and captured|strong="H07617"\w* \w some|strong="H04480"\w* \w prisoners|strong="H07628"\w*. \v 2 \w So Israel|strong="H03478"\w* \w made|strong="H05087"\w* \w a vow|strong="H05088"\w* \w to the LORD|strong="H03068"\w* \w . . .|strong="H00559"\w*: “\w If|strong="H00518"\w* \w You will deliver|strong="H05414"\w* \w . . .|strong="H05414"\w* \w -|strong="H00853"\w* \w this|strong="H02088"\w* \w people|strong="H05971"\w* \w into our hands|strong="H03027"\w*, \w we will devote|strong="H02763"\w* \w -|strong="H00853"\w* \w their cities {to destruction}|strong="H05892"\w*.\f + \fr 21:2 \ft Forms of the Hebrew \fqa cherem \ft refer to the giving over of things or persons to the LORD, either by destroying them or by giving them as an offering; also in verse 3.\f*”
\p \v 3 \w And the LORD|strong="H03068"\w* \w heard|strong="H08085"\w* \w Israel’s|strong="H03478"\w* \w plea|strong="H06963"\w* \w and delivered up|strong="H05414"\w* \w -|strong="H00853"\w* \w the Canaanites|strong="H03669"\w*. \w [Israel] devoted|strong="H02763"\w* \w them|strong="H00853"\w* \w and|strong="H00853"\w* \w their cities {to destruction}|strong="H05892"\w*; \w so they named|strong="H07121"\w* \w . . .|strong="H08034"\w* \w the place|strong="H04725"\w* \w Hormah|strong="H02767"\w*.\f + \fr 21:3 \fqa Hormah \ft means \fqa destruction\ft .\f*
\s1 The Bronze Serpent
\p \v 4 \w Then they set out|strong="H05265"\w* \w from Mount|strong="H02022"\w* \w Hor|strong="H02023"\w* \w along the route|strong="H01870"\w* \w to the Red|strong="H05488"\w* \w Sea|strong="H03220"\w*,\f + \fr 21:4 \ft Or \fqa the Sea of Reeds\f* \w in order to bypass|strong="H05437"\w* \w -|strong="H00853"\w* \w the land|strong="H00776"\w* \w of Edom|strong="H00123"\w*. \w But the people|strong="H05971"\w* \w grew impatient|strong="H07114"\w* \w . . .|strong="H05315"\w* \w on the journey|strong="H01870"\w* \v 5 \w -|strong="H05971"\w* \w and spoke|strong="H01696"\w* \w against God|strong="H00430"\w* \w and against Moses|strong="H04872"\w*: “\w Why|strong="H04100"\w* \w have you led us up|strong="H05927"\w* \w out of Egypt|strong="H04714"\w* \w to die|strong="H04191"\w* \w in the wilderness|strong="H04057"\w*? \w . . .|strong="H03588"\w* \w There is no|strong="H00369"\w* \w bread|strong="H03899"\w* \w . . .|strong="H00369"\w* \w or water|strong="H04325"\w*, \w and we|strong="H05315"\w* \w detest|strong="H06973"\w* \w this wretched|strong="H07052"\w* \w food|strong="H03899"\w*!”
\p \v 6 \w So the LORD|strong="H03068"\w* \w sent|strong="H07971"\w* \w venomous|strong="H08314"\w* \w snakes|strong="H05175"\w* \w among [the people]|strong="H05971"\w*, \w -|strong="H00853"\w* \w and many|strong="H07227"\w* \w vvv|strong="H05971"\w* \w of the Israelites|strong="H03478"\w* \w were bitten|strong="H05391"\w* \w -|strong="H00853"\w* \w -|strong="H05971"\w* \w and died|strong="H04191"\w*.
