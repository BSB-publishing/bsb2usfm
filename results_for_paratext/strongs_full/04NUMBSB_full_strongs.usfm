\p \v 18 \w Then at the entrance|strong="H06607"\w* \w to the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*, \w the Nazirite|strong="H05139"\w* \w is to shave|strong="H01548"\w* \w his consecrated|strong="H05145"\w* \w head|strong="H07218"\w* \w -|strong="H00853"\w*, \w take|strong="H03947"\w* \w -|strong="H00853"\w* \w the hair|strong="H08181"\w* \w -|strong="H07218"\w*, \w -|strong="H05145"\w* \w and put|strong="H05414"\w* \w it on|strong="H05921"\w* \w the fire|strong="H00784"\w* \w -|strong="H00834"\w* \w under|strong="H08478"\w* \w vvv|strong="H02077"\w* \w the peace offering|strong="H08002"\w*. \v 19 \w And the priest|strong="H03548"\w* \w -|strong="H00853"\w* \w is to take|strong="H03947"\w* \w the boiled|strong="H01311"\w* \w shoulder|strong="H02220"\w* \w from|strong="H04480"\w* \w the ram|strong="H00352"\w*, \w one|strong="H00259"\w* \w unleavened|strong="H04682"\w* \w cake|strong="H02471"\w* \w from|strong="H04480"\w* \w the basket|strong="H05536"\w*, \w and one|strong="H00259"\w* \w unleavened|strong="H04682"\w* \w wafer|strong="H07550"\w*, \w and put them|strong="H05414"\w* \w into|strong="H05921"\w* \w the hands|strong="H03709"\w* \w of the Nazirite|strong="H05139"\w* \w who has just|strong="H00310"\w* \w shaved|strong="H01548"\w* \w -|strong="H00853"\w* \w [the hair of] his consecration|strong="H05145"\w*. \v 20 \w The priest|strong="H03548"\w* \w shall then wave|strong="H05130"\w* \w them|strong="H00853"\w* \w as a wave offering|strong="H08573"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*. \w This|strong="H01931"\w* \w is a holy|strong="H06944"\w* \w portion for the priest|strong="H03548"\w*, \w in addition to|strong="H05921"\w* \w the breast|strong="H02373"\w* \w of the wave offering|strong="H08573"\w* \w . . .|strong="H05921"\w* \w and the thigh|strong="H07785"\w* \w that was presented|strong="H08641"\w*. \w After that|strong="H00310"\w*, \w the Nazirite|strong="H05139"\w* \w may drink|strong="H08354"\w* \w wine|strong=