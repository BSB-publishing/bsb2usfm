\p \w Then the woman|strong="H00802"\w* \w is to say|strong="H00559"\w*, ‘\w Amen|strong="H00543"\w*, \w Amen|strong="H00543"\w*.’
\p \v 23 \w And the priest|strong="H03548"\w* \w shall write|strong="H03789"\w* \w -|strong="H00853"\w* \w these|strong="H00428"\w* \w curses|strong="H00423"\w* \w on a scroll|strong="H05612"\w* \w and wash them off|strong="H04229"\w* \w into|strong="H00413"\w* \w the bitter|strong="H04751"\w* \w water|strong="H04325"\w*. \v 24 \w He is to have the woman|strong="H00802"\w* \w -|strong="H00853"\w* \w drink|strong="H08248"\w* \w -|strong="H00853"\w* \w the bitter|strong="H04751"\w* \w water|strong="H04325"\w* \w that brings a curse|strong="H00779"\w*, \w and it|strong="H04325"\w* \w will enter|strong="H00935"\w* her \w and may cause her bitter|strong="H04751"\w* \w suffering|strong="H00779"\w*. \v 25 \w The priest|strong="H03548"\w* \w shall take|strong="H03947"\w* \w from [her]|strong="H00802"\w* \w -|strong="H00853"\w* \w hand|strong="H03027"\w* \w the grain offering|strong="H04503"\w* \w for jealousy|strong="H07068"\w*, \w wave|strong="H05130"\w* \w -|strong="H00853"\w* \w [it]|strong="H04503"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*, \w and bring|strong="H07126"\w* \w -|strong="H00853"\w* \w it to|strong="H00413"\w* \w the altar|strong="H04196"\w*. \v 26 \w Then the priest|strong="H03548"\w* \w is to take a handful|strong="H07061"\w* \w of|strong="H04480"\w* \w the grain offering|strong="H04503"\w* \w -|strong="H00853"\w* \w as a memorial portion|strong="H00234"\w* \w and burn|strong="H06999"\w* \w it on the altar|strong="H04196"\w*; \w after that|strong="H00310"\w* \w he is to have the woman|strong="H00802"\w* \w -|strong="H00853"\w* \w drink|strong="H08248"\w* \w -|strong="H00853"\w* \w the water|strong="H04325"\w*.
