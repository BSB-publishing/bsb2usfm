\li1 \v 5 \w The tribe|strong="H04294"\w* \w of Issachar|strong="H03485"\w* \w will camp|strong="H02583"\w* \w next to it|strong="H05921"\w*. \w The leader|strong="H05387"\w* \w of the Issacharites|strong="H01121"\w* \w . . .|strong="H03485"\w* \w is Nethanel|strong="H05417"\w* \w son|strong="H01121"\w* \w of Zuar|strong="H06686"\w*, \v 6 \w and his division|strong="H06635"\w* \w numbers|strong="H06485"\w* \w 54,400|strong="H00702"\w* \w . . .|strong="H02572"\w* \w . . .|strong="H00505"\w* \w . . .|strong="H00702"\w* \w . . .|strong="H03967"\w*.
\li1 \v 7 \w [Next will be] the tribe|strong="H04294"\w* \w of Zebulun|strong="H02074"\w*. \w The leader|strong="H05387"\w* \w of the Zebulunites|strong="H01121"\w* \w . . .|strong="H02074"\w* \w is Eliab|strong="H00446"\w* \w son|strong="H01121"\w* \w of Helon|strong="H02497"\w*, \v 8 \w and his division|strong="H06635"\w* \w numbers|strong="H06485"\w* \w 57,400|strong="H07651"\w* \w . . .|strong="H02572"\w* \w . . .|strong="H00505"\w* \w . . .|strong="H00702"\w* \w . . .|strong="H03967"\w*.
\pmo \v 9 \w The total|strong="H03605"\w* \w number of men|strong="H06485"\w* \w in the divisions|strong="H06635"\w* \w of the camp|strong="H04264"\w* \w of Judah|strong="H03063"\w* \w is 186,400|strong="H03967"\w* \w . . .|strong="H00505"\w* \w . . .|strong="H08084"\w* \w . . .|strong="H00505"\w* \w . . .|strong="H08337"\w* \w . . .|strong="H00505"\w* \w . . .|strong="H00702"\w* \w . . .|strong="H03967"\w*; \w they shall set out|strong="H05265"\w* \w first|strong="H07223"\w*.
