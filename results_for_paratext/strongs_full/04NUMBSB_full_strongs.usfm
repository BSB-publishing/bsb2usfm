\li1 \v 49 \w And there on the plains|strong="H06160"\w* \w of Moab|strong="H04124"\w* \w they camped|strong="H02583"\w* \w by|strong="H05921"\w* \w the Jordan|strong="H03383"\w*, \w vvv|strong="H01020"\w* \w from Beth-jeshimoth|strong="H01020"\w* \w to|strong="H05704"\w* \w vvv|strong="H00063"\w* \w Abel-shittim|strong="H00063"\w*.\f + \fr 33:49 \ft Or \fqa the Meadow of the Acacias\ft ; that is, an area in the lowlands of Moab\f*
\s1 Instructions for Occupying Canaan
\p \v 50 \w On the plains|strong="H06160"\w* \w of Moab|strong="H04124"\w* \w by|strong="H05921"\w* \w the Jordan|strong="H03383"\w* \w across from Jericho|strong="H03405"\w* \w . . .|strong="H00559"\w*, \w the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*, \v 51 “\w Speak|strong="H01696"\w* \w to|strong="H00413"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w and tell|strong="H00559"\w* \w them|strong="H00413"\w*: \w When|strong="H03588"\w* \w you|strong="H00859"\w* \w cross|strong="H05674"\w* \w -|strong="H00853"\w* \w the Jordan|strong="H03383"\w* \w into|strong="H00413"\w* \w the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*, \v 52 \w you must drive out|strong="H03423"\w* \w -|strong="H00853"\w* \w before you|strong="H06440"\w* \w all|strong="H03605"\w* \w the inhabitants|strong="H03427"\w* \w of the land|strong="H00776"\w*, \w destroy|strong="H00006"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w their carved images|strong="H04906"\w* \w -|strong="H00853"\w* \w -|strong="H03605"\w* \w and cast|strong="H04541"\w* \w idols|strong="H06754"\w*, \w -|strong="H00006"\w* \w and|strong="H00853"\w* \w demolish|strong="H08045"\w* \w all|strong="H03605"\w* \w their high places|strong="H01116"\w*.
\p \v 53 \w You are to take possession of|strong="H03423"\w* \w -|strong="H00853"\w* \w the land|strong="H00776"\w* \w and settle|strong="H03427"\w* in it, \w for|strong="H03588"\w* \w I have given|strong="H05414"\w* you \w -|strong="H00853"\w* \w the land|strong="H00776"\w* \w to possess|strong="H03423"\w* \w -|strong="H00853"\w*. \v 54 \w And you are to divide|strong="H05157"\w* \w the land|strong="H00776"\w* \w -|strong="H00853"\w* \w by lot|strong="H01486"\w* \w according to your clans|strong="H04940"\w*. \w Give a larger|strong="H07235"\w* \w -|strong="H00853"\w* \w inheritance|strong="H05159"\w* \w to a larger clan|strong="H07227"\w* \w and a smaller|strong="H04591"\w* \w -|strong="H00853"\w* \w inheritance|strong="H05159"\w* \w . . .|strong="H00413"\w* \w to a smaller one|strong="H04592"\w*. \w Whatever|strong="H00834"\w* \w falls|strong="H03318"\w* to each one \w by lot|strong="H01486"\w* \w . . .|strong="H08033"\w* \w will be|strong="H01961"\w* his. \w You will receive an inheritance|strong="H05157"\w* \w according to the tribes|strong="H04294"\w* \w of your fathers|strong="H00001"\w*.
\p \v 55 \w But if|strong="H00518"\w* \w you do not|strong="H03808"\w* \w drive out|strong="H03423"\w* \w -|strong="H00853"\w* \w the inhabitants|strong="H03427"\w* \w of the land|strong="H00776"\w* \w before you|strong="H06440"\w*, \w those|strong="H00834"\w* \w you allow to remain|strong="H03498"\w* . . . \w will become|strong="H01961"\w* \w barbs|strong="H07899"\w* \w in your eyes|strong="H05869"\w* \w and thorns|strong="H06796"\w* \w in your sides|strong="H06654"\w*; \w they will harass|strong="H06887"\w* \w -|strong="H00853"\w* \w you in|strong="H05921"\w* \w the land|strong="H00776"\w* \w where|strong="H00834"\w* \w you|strong="H00859"\w* \w settle|strong="H03427"\w*. \v 56 \w And then|strong="H01961"\w* \w I will do|strong="H06213"\w* to you \w what|strong="H00834"\w* \w I had planned|strong="H01819"\w* \w to do|strong="H06213"\w* to them.”
\c 34
\s1 The Boundaries of Canaan
\r (Genesis 15:8–21)
\p \v 1 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00559"\w*, \v 2 “\w Command|strong="H06680"\w* \w -|strong="H00853"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w and say|strong="H00559"\w* \w to them|strong="H00413"\w*: \w When|strong="H03588"\w* \w you|strong="H00859"\w* \w enter|strong="H00935"\w* \w . . .|strong="H00413"\w* \w the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*, \w . . .|strong="H02063"\w* \w it|strong="H00776"\w* \w -|strong="H00834"\w* \w will be allotted|strong="H05307"\w* to you \w as an inheritance|strong="H05159"\w* \w . . .|strong="H00776"\w* \w . . .|strong="H03667"\w* \w with these boundaries|strong="H01367"\w*:
\li1 \v 3 Your \w southern|strong="H05045"\w* \w border|strong="H06285"\w* \w will extend|strong="H01961"\w* \w from the Wilderness|strong="H04057"\w* \w of Zin|strong="H06790"\w* \w along|strong="H05921"\w* \w the border|strong="H03027"\w* \w of Edom|strong="H00123"\w*. \w On the east|strong="H06924"\w*, \w your southern|strong="H05045"\w* \w border|strong="H01366"\w* \w will run|strong="H01961"\w* \w from the end|strong="H07097"\w* \w of the Salt|strong="H04417"\w* \w Sea|strong="H03220"\w*,\f + \fr 34:3 \ft That is, the Dead Sea; also in verse 12\f* \v 4 \w -|strong="H01366"\w* \w cross|strong="H05437"\w* - \w south|strong="H05045"\w* \w of the Ascent|strong="H04610"\w* \w of Akrabbim|strong="H04610"\w*,\f + \fr 34:4 \ft Or \fqa the Ascent of Scorpions \ft or \fqa Scorpion Pass\f* \w continue|strong="H05674"\w* \w to Zin|strong="H06790"\w*, \w and go|strong="H01961"\w* \w . . .|strong="H08444"\w* \w south|strong="H05045"\w* \w vvv|strong="H06947"\w* \w of Kadesh-barnea|strong="H06947"\w*. \w Then it will go on|strong="H03318"\w* \w vvv|strong="H02692"\w* \w to Hazar-addar|strong="H02692"\w* \w and proceed|strong="H05674"\w* \w to Azmon|strong="H06111"\w*, \v 5 \w where [it]|strong="H01366"\w* \w will turn|strong="H05437"\w* \w from Azmon|strong="H06111"\w*, \w join the Brook|strong="H05158"\w* \w of Egypt|strong="H04714"\w*, \w and end|strong="H01961"\w* \w . . .|strong="H08444"\w* \w at the Sea|strong="H03220"\w*.\f + \fr 34:5 \ft That is, the Mediterranean Sea, also called the Great Sea; also in verses 6 and 7\f*
\li1 \v 6 Your \w western|strong="H03220"\w* \w border|strong="H01366"\w* \w will be|strong="H01961"\w* \w the coastline|strong="H01366"\w* \w of the Great|strong="H01419"\w* \w Sea|strong="H03220"\w*; \w this|strong="H02088"\w* \w will be|strong="H01961"\w* your \w boundary|strong="H01366"\w* \w on the west|strong="H03220"\w*.
\li1 \v 7 \w -|strong="H02088"\w* Your \w northern|strong="H06828"\w* \w border|strong="H01366"\w* \w will run|strong="H01961"\w* \w from|strong="H04480"\w* \w the Great|strong="H01419"\w* \w Sea|strong="H03220"\w* \w directly|strong="H08376"\w* \w to Mount|strong="H02022"\w* \w Hor|strong="H02023"\w*, \v 8 \w and from Mount|strong="H02022"\w* \w Hor|strong="H02023"\w*\w . . .|strong="H08376"\w* \w vvv|strong="H00935"\w* \w to Lebo-hamath|strong="H02574"\w*, \w [then]|strong="H01366"\w* \w extend|strong="H01961"\w* \w . . .|strong="H08444"\w* \w to Zedad|strong="H06657"\w*, \v 9 \w -|strong="H01366"\w* \w continue|strong="H03318"\w* \w to Ziphron|strong="H02202"\w*, \w and end|strong="H01961"\w* \w . . .|strong="H08444"\w* \w vvv|strong="H02704"\w* \w at Hazar-enan|strong="H02704"\w*. \w This|strong="H02088"\w* \w will be|strong="H01961"\w* your \w boundary|strong="H01366"\w* \w on the north|strong="H06828"\w*.
\li1 \v 10 \w And your eastern|strong="H06924"\w*\w . . .|strong="H02704"\w* \w border|strong="H01366"\w* \w will run straight|strong="H00183"\w* from \w Hazar-enan|strong="H02704"\w* \w to Shepham|strong="H08221"\w*, \v 11 \w [then]|strong="H01366"\w* \w go down|strong="H03381"\w* \w from Shepham|strong="H08221"\w* \w to Riblah|strong="H07247"\w* \w on the east side|strong="H06924"\w* \w of Ain|strong="H05871"\w* \w -|strong="H01366"\w* \w and continue along|strong="H03381"\w* \w -|strong="H04229"\w* \w -|strong="H05921"\w* \w the slopes|strong="H03802"\w* \w east|strong="H06924"\w* \w of the Sea|strong="H03220"\w* \w of Chinnereth|strong="H03672"\w*.\f + \fr 34:11 \ft That is, the Sea of Galilee\f* \v 12 \w Then the border|strong="H01366"\w* \w will go down|strong="H03381"\w* \w along the Jordan|strong="H03383"\w* \w and end|strong="H01961"\w* \w . . .|strong="H08444"\w* \w at the Salt|strong="H04417"\w* \w Sea|strong="H03220"\w*.
\p \w This|strong="H02063"\w* \w will be|strong="H01961"\w* your \w land|strong="H00776"\w*, \w defined by its borders|strong="H01367"\w* \w on all sides|strong="H05439"\w*.”
\p \v 13 \w So Moses|strong="H04872"\w* \w -|strong="H00853"\w* \w commanded|strong="H06680"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w . . .|strong="H00559"\w*, “\w {Apportion} this|strong="H02063"\w* \w land|strong="H00776"\w* \w by lot|strong="H01486"\w*\w . . .|strong="H00834"\w* \w as an inheritance|strong="H05157"\w*. \w -|strong="H00853"\w* \w -|strong="H00834"\w* \w The LORD|strong="H03068"\w* \w has commanded that|strong="H06680"\w* \w it be given|strong="H05414"\w* \w to the nine|strong="H08672"\w* \w and a half|strong="H02677"\w* \w . . .|strong="H04294"\w* \w tribes|strong="H04294"\w*. \v 14 \w For|strong="H03588"\w* \w -|strong="H03947"\w* \w the tribes|strong="H04294"\w* \w of the Reubenites|strong="H01121"\w* \w . . .|strong="H07206"\w* \w -|strong="H01004"\w* \w -|strong="H00001"\w* \w [and]|strong="H04294"\w* \w Gadites|strong="H01121"\w*, \w . . .|strong="H01425"\w* \w . . .|strong="H01004"\w* \w . . .|strong="H00001"\w* \w along with the half-tribe|strong="H02677"\w* \w . . .|strong="H04294"\w* \w of Manasseh|strong="H04519"\w*, \w have already received|strong="H03947"\w* \w their inheritance|strong="H05159"\w*. \v 15 \w These two|strong="H08147"\w* \w and a half|strong="H02677"\w* \w . . .|strong="H04294"\w* \w tribes|strong="H04294"\w* \w have received|strong="H03947"\w* \w their inheritance|strong="H05159"\w* \w across|strong="H05676"\w* \w the Jordan|strong="H03383"\w* \w from Jericho|strong="H03405"\w*, \w vvv|strong="H06924"\w* \w toward the sunrise|strong="H04217"\w*.”
\s1 Leaders to Divide the Land
\p \v 16 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w . . .|strong="H00559"\w*, \v 17 “\w These|strong="H00428"\w* \w are the names|strong="H08034"\w* \w of the men|strong="H00582"\w* \w who|strong="H00834"\w* \w are to assign the land|strong="H00776"\w* \w as an inheritance|strong="H05157"\w* for you: \w -|strong="H00853"\w* \w Eleazar|strong="H00499"\w* \w the priest|strong="H03548"\w* \w and Joshua|strong="H03091"\w* \w son|strong="H01121"\w* \w of Nun|strong="H05126"\w*. \v 18 \w Appoint|strong="H03947"\w* \w one|strong="H00259"\w* \w . . .|strong="H05387"\w* \w leader|strong="H05387"\w* \w from each|strong="H00259"\w* \w tribe|strong="H04294"\w* \w to distribute|strong="H05157"\w* \w -|strong="H00853"\w* \w the land|strong="H00776"\w*. \v 19 \w These|strong="H00428"\w* \w are their names|strong="H08034"\w* \w . . .|strong="H00582"\w*:
\b 
\li1 \w Caleb|strong="H03612"\w* \w son|strong="H01121"\w* \w of Jephunneh|strong="H03312"\w* \w from the tribe|strong="H04294"\w* \w of Judah|strong="H03063"\w*;
\li1 \v 20 \w Shemuel|strong="H08050"\w* \w son|strong="H01121"\w* \w of Ammihud|strong="H05989"\w* \w from the tribe|strong="H04294"\w*\w . . .|strong="H01121"\w* \w of Simeon|strong="H08095"\w*;
\li1 \v 21 \w Elidad|strong="H00449"\w* \w son|strong="H01121"\w* \w of Chislon|strong="H03692"\w* \w from the tribe|strong="H04294"\w* \w of Benjamin|strong="H01144"\w*;
\li1 \v 22 \w Bukki|strong="H01231"\w* \w son|strong="H01121"\w* \w of Jogli|strong="H03020"\w*, \w a leader|strong="H05387"\w* \w from the tribe|strong="H04294"\w*\w . . .|strong="H01121"\w* \w of Dan|strong="H01835"\w*;
\li1 \v 23 \w Hanniel|strong="H02592"\w* \w son|strong="H01121"\w* \w of Ephod|strong="H00641"\w*, \w a leader|strong="H05387"\w* \w from the tribe|strong="H04294"\w* \w of Manasseh|strong="H01121"\w* \w . . .|strong="H04519"\w* \w son|strong="H01121"\w* \w of Joseph|strong="H03130"\w*;
\li1 \v 24 \w Kemuel|strong="H07055"\w* \w son|strong="H01121"\w* \w of Shiphtan|strong="H08204"\w*, \w a leader|strong="H05387"\w* \w from the tribe|strong="H04294"\w*\w . . .|strong="H01121"\w* \w of Ephraim|strong="H00669"\w*;
\li1 \v 25 \w Eli-zaphan|strong="H00469"\w* \w son|strong="H01121"\w* \w of Parnach|strong="H06535"\w*, \w a leader|strong="H05387"\w* \w from the tribe|strong="H04294"\w*\w . . .|strong="H01121"\w* \w of Zebulun|strong="H02074"\w*;
\li1 \v 26 \w Paltiel|strong="H06409"\w* \w son|strong="H01121"\w* \w of Azzan|strong="H05821"\w*, \w a leader|strong="H05387"\w* \w from the tribe|strong="H04294"\w*\w . . .|strong="H01121"\w* \w of Issachar|strong="H03485"\w*;
\li1 \v 27 \w Ahihud|strong="H00282"\w* \w son|strong="H01121"\w* \w of Shelomi|strong="H08015"\w*, \w a leader|strong="H05387"\w* \w from the tribe|strong="H04294"\w*\w . . .|strong="H01121"\w* \w of Asher|strong="H00836"\w*;
\li1 \v 28 \w and Pedahel|strong="H06300"\w* \w son|strong="H01121"\w* \w of Ammihud|strong="H05989"\w*, \w a leader|strong="H05387"\w* \w from the tribe|strong="H04294"\w*\w . . .|strong="H01121"\w* \w of Naphtali|strong="H05321"\w*.”
\p \v 29 \w These|strong="H00428"\w* \w are the ones whom|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w commanded|strong="H06680"\w* \w to apportion the inheritance|strong="H05157"\w* \w -|strong="H00853"\w* \w to the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w in the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*.
\c 35
\s1 Forty-Eight Cities for the Levites
