\p \v 1 \w And the LORD|strong="H03068"\w* \w . . .|strong="H00413"\w* \w said|strong="H01696"\w* \w to Moses|strong="H04872"\w* \w . . .|strong="H00559"\w*, \v 2 “\w Speak|strong="H01696"\w* \w to|strong="H00413"\w* \w the Israelites|strong="H01121"\w* \w . . .|strong="H03478"\w* \w and tell|strong="H00559"\w* \w them that|strong="H00413"\w* \w if|strong="H03588"\w* \w a man|strong="H00376"\w* \w or|strong="H00176"\w* \w woman|strong="H00802"\w* \w makes a special|strong="H06381"\w* \w vow|strong="H05087"\w*, \w the vow|strong="H05088"\w* \w of a Nazirite|strong="H05139"\w*,\f + \fr 6:2 \fqa Nazirite \ft means \fqa one separated \ft or \fqa one consecrated\ft .\f* \w to separate himself|strong="H05144"\w* \w to the LORD|strong="H03068"\w*, \v 3 \w he is to abstain|strong="H05144"\w* \w from wine|strong="H03196"\w* \w and strong drink|strong="H07941"\w*. \w He must not|strong="H03808"\w* \w drink|strong="H08354"\w* \w vinegar|strong="H02558"\w* \w made from wine|strong="H03196"\w* \w . . .|strong="H02558"\w* \w [or] strong drink|strong="H07941"\w*, \w and he must not|strong="H03808"\w* \w drink|strong="H08354"\w* \w any|strong="H03605"\w* \w grape|strong="H06025"\w* \w juice|strong="H04952"\w* \w or eat|strong="H00398"\w* \w fresh|strong="H03892"\w* \w grapes|strong="H06025"\w* \w or raisins|strong="H03002"\w* \w . . .|strong="H03808"\w*. \v 4 \w All|strong="H03605"\w*\w . . .|strong="H03605"\w*\w . . .|strong="H00834"\w* \w the days|strong="H03117"\w* \w of his separation|strong="H05145"\w*, \w he is not|strong="H03808"\w* \w to eat|strong="H00398"\w* \w anything that comes from|strong="H06213"\w* \w the grapevine|strong="H01612"\w* \w . . .|strong="H03196"\w*, \w not even the seeds|strong="H02785"\w* \w or|strong="H05704"\w* \w skins|strong="H02085"\w*.
