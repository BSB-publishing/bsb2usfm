\p \v 12 \w And this|strong="H02063"\w* \w will be|strong="H01961"\w* \w the plague|strong="H04046"\w* \w with which|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w strikes|strong="H05062"\w* \w all|strong="H03605"\w* \w the peoples|strong="H05971"\w* \w who|strong="H00834"\w* \w have warred|strong="H06633"\w* \w against|strong="H05921"\w* \w Jerusalem|strong="H03389"\w*: \w Their flesh|strong="H01320"\w* \w will rot|strong="H04743"\w* \w while they|strong="H01931"\w* \w stand|strong="H05975"\w* \w on|strong="H05921"\w* \w their feet|strong="H07272"\w*, \w their eyes|strong="H05869"\w* \w will rot|strong="H04743"\w* \w in their sockets|strong="H02356"\w*, \w and their tongues|strong="H03956"\w* \w will rot|strong="H04743"\w* \w in their mouths|strong="H06310"\w*.
\p \v 13 \w On that|strong="H01931"\w* \w . . .|strong="H01961"\w* \w day|strong="H03117"\w* \w a great|strong="H07227"\w* \w panic|strong="H04103"\w* \w from the LORD|strong="H03068"\w* \w will come|strong="H01961"\w* upon them, \w so that each|strong="H00376"\w* \w will seize|strong="H02388"\w* \w the hand|strong="H03027"\w* \w of another|strong="H07453"\w*, \w and the hand|strong="H03027"\w* \w of one will rise|strong="H05927"\w* \w against|strong="H05921"\w* \w . . .|strong="H03027"\w* \w the other|strong="H07453"\w*. \v 14 \w Judah|strong="H03063"\w* \w will also|strong="H01571"\w* \w fight|strong="H03898"\w* \w at Jerusalem|strong="H03389"\w*, \w and the wealth|strong="H02428"\w* \w of all|strong="H03605"\w* \w the surrounding|strong="H05439"\w* \w nations|strong="H01471"\w* \w will be collected|strong="H00622"\w* — \w gold|strong="H02091"\w*, \w silver|strong="H03701"\w*, \w and apparel|strong="H00899"\w* \w in great abundance|strong="H07230"\w* \w . . .|strong="H03966"\w*. \v 15 \w And a similar|strong="H03651"\w* \w plague|strong="H04046"\w* \w will strike|strong="H01961"\w* \w the horses|strong="H05483"\w* \w and mules|strong="H06505"\w*, \w camels|strong="H01581"\w* \w and donkeys|strong="H02543"\w*, \w and all|strong="H03605"\w* \w the animals|strong="H00929"\w* \w -|strong="H00834"\w* \w -|strong="H01961"\w* \w in those|strong="H01992"\w* \w camps|strong="H04264"\w*. \w -|strong="H04046"\w* \w -|strong="H02063"\w*
\s1 All Nations Will Worship the King
