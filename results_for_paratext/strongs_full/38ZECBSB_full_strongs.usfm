\p \v 6 \w Then the angel|strong="H04397"\w* \w of the LORD|strong="H03068"\w* \w gave this charge|strong="H05749"\w* \w to Joshua|strong="H03091"\w* \w . . .|strong="H00559"\w*: \v 7 “\w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w* \w says|strong="H00559"\w*: ‘\w If|strong="H00518"\w* \w you walk|strong="H01980"\w* \w . . .|strong="H00518"\w* \w -|strong="H00853"\w* \w in My ways|strong="H01870"\w* \w and keep|strong="H08104"\w* \w My instructions|strong="H04931"\w*, \w then you|strong="H00859"\w* \w -|strong="H01571"\w* \w will govern|strong="H01777"\w* \w -|strong="H00853"\w* \w My house|strong="H01004"\w* \w and will also|strong="H01571"\w* \w have charge|strong="H08104"\w* \w of|strong="H00853"\w* \w My courts|strong="H02691"\w*; \w and I will give|strong="H05414"\w* you \w a place|strong="H04109"\w* \w among|strong="H00996"\w* \w these|strong="H00428"\w* \w who are standing here|strong="H05975"\w*.
\p \v 8 \w Hear|strong="H08085"\w* \w now|strong="H04994"\w*, \w O high|strong="H01419"\w* \w priest|strong="H03548"\w* \w Joshua|strong="H03091"\w*, \w you|strong="H00859"\w* \w and your companions|strong="H07453"\w* \w seated|strong="H03427"\w* \w before you|strong="H06440"\w*, \w who are indeed|strong="H03588"\w* \w . . .|strong="H00582"\w* \w a sign|strong="H04159"\w*. \w . . .|strong="H01992"\w* \w For|strong="H03588"\w* \w behold|strong="H02005"\w*, \w I am going to bring|strong="H00935"\w* \w -|strong="H00853"\w* \w My servant|strong="H05650"\w*, \w the Branch|strong="H06780"\w*. \v 9 \w -|strong="H03588"\w* \w See|strong="H02009"\w* \w the stone|strong="H00068"\w* \w -|strong="H00834"\w* \w I have set|strong="H05414"\w* \w before|strong="H06440"\w* \w Joshua|strong="H03091"\w*; \w on|strong="H05921"\w* \w that one|strong="H00259"\w* \w stone|strong="H00068"\w* \w are seven|strong="H07651"\w* \w eyes|strong="H05869"\w*.\f + \fr 3:9 \ft Or \fqa facets\f* \w Behold|strong="H02005"\w*, \w I will engrave on it|strong="H06605"\w* \w an inscription|strong="H06603"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w and I will remove|strong="H04185"\w* \w -|strong="H00853"\w* \w the iniquity|strong="H05771"\w* \w of this|strong="H01931"\w* \w land|strong="H00776"\w* \w in a single|strong="H00259"\w* \w day|strong="H03117"\w*. \v 10 \w On that|strong="H01931"\w* \w day|strong="H03117"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w you will each invite|strong="H07121"\w* \w . . .|strong="H00376"\w* \w [your] neighbor|strong="H07453"\w* \w to|strong="H00413"\w* \w sit under|strong="H08478"\w* \w [your own] vine|strong="H01612"\w* \w and|strong="H00413"\w* \w -|strong="H08478"\w* \w fig tree|strong="H08384"\w*.’”
\c 4
\s1 The Vision of the Lampstand and Olive Trees
\p \v 1 \w Then the angel|strong="H04397"\w* \w who was speaking|strong="H01696"\w* with me \w returned|strong="H07725"\w* \w and woke me|strong="H05782"\w*, \w as a man|strong="H00376"\w* \w -|strong="H00834"\w* \w is awakened|strong="H05782"\w* \w from his sleep|strong="H08142"\w*.
\p \v 2 “\w What|strong="H04100"\w* \w do you|strong="H00859"\w* \w see|strong="H07200"\w*?” \w he asked|strong="H00559"\w* \w . . .|strong="H00413"\w*.
\p “\w I see|strong="H07200"\w* \w a solid gold|strong="H02091"\w* \w . . .|strong="H03605"\w* \w lampstand|strong="H04501"\w*,” \w I replied|strong="H00559"\w*, “\w with|strong="H02009"\w* \w a bowl|strong="H01543"\w* \w at|strong="H05921"\w* \w the top|strong="H07218"\w* \w and seven|strong="H07651"\w* \w lamps|strong="H05216"\w* \w on it|strong="H05921"\w* \w -|strong="H07651"\w*, \w with seven|strong="H07651"\w* \w spouts|strong="H04166"\w* \w to the lamps|strong="H05216"\w* \w -|strong="H00834"\w*\w . . .|strong="H05921"\w* \w -|strong="H07218"\w*. \v 3 \w There are also two|strong="H08147"\w* \w olive trees|strong="H02132"\w* \w beside it|strong="H05921"\w*, \w one|strong="H00259"\w* \w on the right [side]|strong="H03225"\w* \w of the bowl|strong="H01543"\w* \w and the other|strong="H00259"\w* \w on|strong="H05921"\w* \w its left|strong="H08040"\w*.”
\p \v 4 “\w What|strong="H04100"\w* \w are these|strong="H00428"\w*, \w my lord|strong="H00113"\w*?” \w I asked|strong="H06030"\w* \w . . .|strong="H00559"\w* \w . . .|strong="H00413"\w* \w the angel|strong="H04397"\w* \w who was speaking|strong="H01696"\w* with me \w -|strong="H00559"\w*.
\p \v 5 “\w Do you not|strong="H03808"\w* \w know|strong="H03045"\w* \w what|strong="H04100"\w* \w they are|strong="H01992"\w*?” \w replied|strong="H06030"\w* \w the angel|strong="H04397"\w* \w -|strong="H01696"\w*\w . . .|strong="H00559"\w*\w . . .|strong="H00413"\w*.
\p “\w No|strong="H03808"\w*, \w my lord|strong="H00113"\w*,” \w I answered|strong="H00428"\w* \w . . .|strong="H00559"\w*.
\p \v 6 \w So he said to me|strong="H06030"\w*\w . . .|strong="H00559"\w*, “\w This|strong="H02088"\w* \w is the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w . . .|strong="H00413"\w* \w to|strong="H00413"\w* \w . . .|strong="H00559"\w* \w Zerubbabel|strong="H02216"\w*: \w . . .|strong="H00559"\w* \w Not|strong="H03808"\w* \w by might|strong="H02428"\w* \w nor|strong="H03808"\w* \w by power|strong="H03581"\w*, \w but|strong="H03588"\w* \w . . .|strong="H00518"\w* \w by My Spirit|strong="H07307"\w*, \w says|strong="H00559"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*. \v 7 \w What|strong="H04310"\w* \w are you|strong="H00859"\w*, \w O great|strong="H01419"\w* \w mountain|strong="H02022"\w*? \w Before|strong="H06440"\w* \w Zerubbabel|strong="H02216"\w* \w you will become a plain|strong="H04334"\w*. \w Then he will bring forth|strong="H03318"\w* \w -|strong="H00853"\w* \w the capstone|strong="H00068"\w* \w . . .|strong="H07222"\w* \w accompanied by shouts of|strong="H08663"\w* ‘\w Grace|strong="H02580"\w*, \w grace|strong="H02580"\w* to it!’”
\p \v 8 \w Then the word|strong="H01697"\w* \w of the LORD|strong="H03068"\w* \w came|strong="H01961"\w* \w to me|strong="H00413"\w*, \w saying|strong="H00559"\w*, \v 9 “\w The hands|strong="H03027"\w* \w of Zerubbabel|strong="H02216"\w* \w have laid the foundation|strong="H03245"\w* \w of this|strong="H02088"\w* \w house|strong="H01004"\w*, \w and his hands|strong="H03027"\w* \w will complete it|strong="H01214"\w*. \w Then you will know|strong="H03045"\w* \w that|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w* \w has sent me|strong="H07971"\w* \w to you|strong="H00413"\w*. \v 10 \w For|strong="H03588"\w* \w who|strong="H04310"\w* \w has despised|strong="H00936"\w* \w the day|strong="H03117"\w* \w of small things|strong="H06996"\w*? \w But these|strong="H00428"\w* \w seven|strong="H07651"\w* \w eyes|strong="H05869"\w*\f + \fr 4:10 \ft Or \fqa facets\f* \w of the LORD|strong="H03068"\w*, \w which|strong="H01992"\w* \w scan|strong="H07751"\w* \w the whole|strong="H03605"\w* \w earth|strong="H00776"\w*, \w will rejoice|strong="H08055"\w* \w when they see|strong="H07200"\w* \w -|strong="H00853"\w* \w the plumb line|strong="H00068"\w*\f + \fr 4:10 \ft Or \fqa the chosen capstone\f* \w . . .|strong="H00913"\w* \w in the hand|strong="H03027"\w* \w of Zerubbabel|strong="H02216"\w*.”
\p \v 11 \w Then I asked|strong="H06030"\w*\w . . .|strong="H00559"\w* \w [the angel]|strong="H00413"\w*, “\w What|strong="H04100"\w* \w are the|strong="H00428"\w* \w two|strong="H08147"\w* \w olive trees|strong="H02132"\w* \w on|strong="H05921"\w* \w the right|strong="H03225"\w* \w and left|strong="H08040"\w* \w of the lampstand|strong="H04501"\w* \w . . .|strong="H05921"\w*?” \v 12 \w And I questioned him|strong="H06030"\w* \w further|strong="H08145"\w* \w . . .|strong="H00559"\w* \w . . .|strong="H00413"\w*, “\w What|strong="H04100"\w* \w are the two|strong="H08147"\w* \w olive|strong="H02132"\w* \w -|strong="H00834"\w* \w branches|strong="H07641"\w* \w beside|strong="H03027"\w* \w the two|strong="H08147"\w* \w gold|strong="H02091"\w* \w pipes|strong="H06804"\w* \w from which|strong="H05921"\w* \w the golden [oil]|strong="H02091"\w*\f + \fr 4:12 \ft Hebrew \fqa from which the gold\f* \w pours|strong="H07324"\w*?”
\p \v 13 “\w Do you not|strong="H03808"\w* \w know|strong="H03045"\w* \w what|strong="H04100"\w* \w these are|strong="H00428"\w*?” \w he inquired|strong="H00559"\w*\w . . .|strong="H00559"\w* \w -|strong="H00413"\w*.
