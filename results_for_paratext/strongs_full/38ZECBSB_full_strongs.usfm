\p \v 1 “\w On that|strong="H01931"\w* \w day|strong="H03117"\w* \w a fountain|strong="H04726"\w* \w will be|strong="H01961"\w* \w opened|strong="H06605"\w* \w to the house|strong="H01004"\w* \w of David|strong="H01732"\w* \w and the people|strong="H03427"\w* \w of Jerusalem|strong="H03389"\w*, \w to cleanse them from sin|strong="H02403"\w* \w and impurity|strong="H05079"\w*. \v 2 \w And|strong="H01961"\w* \w on that|strong="H01931"\w* \w day|strong="H03117"\w*, \w declares|strong="H05002"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w I will erase|strong="H03772"\w* \w -|strong="H00853"\w* \w the names|strong="H08034"\w* \w of the idols|strong="H06091"\w* \w from|strong="H04480"\w* \w the land|strong="H00776"\w*, \w and they will no|strong="H03808"\w* \w longer|strong="H05750"\w* \w . . .|strong="H01571"\w* \w -|strong="H00853"\w* \w be remembered|strong="H02142"\w*. \w I will also remove|strong="H05674"\w* \w the prophets|strong="H05030"\w* \w and|strong="H00853"\w* \w the spirit|strong="H07307"\w* \w of impurity|strong="H02932"\w*\f + \fr 13:2 \ft Or \fqa the unclean spirit\f* \w from|strong="H04480"\w* \w the land|strong="H00776"\w*.
\p \v 3 \w And|strong="H01961"\w* \w if|strong="H03588"\w* \w anyone|strong="H00376"\w* \w still|strong="H05750"\w* \w prophesies|strong="H05012"\w*, \w his father|strong="H00001"\w* \w and mother|strong="H00517"\w* \w who bore him|strong="H03205"\w* \w will say|strong="H00559"\w* \w to him|strong="H00413"\w*, ‘\w You shall not|strong="H03808"\w* \w remain alive|strong="H02421"\w*, \w because|strong="H03588"\w* \w you have spoken|strong="H01696"\w* \w falsely|strong="H08267"\w* \w in the name|strong="H08034"\w* \w of the LORD|strong="H03068"\w*.’ \w When he prophesies|strong="H05012"\w*, \w his father|strong="H00001"\w* \w and mother|strong="H00517"\w* \w who bore him|strong="H03205"\w* \w will pierce him through|strong="H01856"\w*.
\p \v 4 \w And|strong="H01961"\w* \w on that|strong="H01931"\w* \w day|strong="H03117"\w* \w every|strong="H00376"\w* \w prophet|strong="H05030"\w* \w who prophesies|strong="H05012"\w* \w will be ashamed|strong="H00954"\w* \w of his vision|strong="H02384"\w*, \w and he will not|strong="H03808"\w* \w put on|strong="H03847"\w* \w a hairy|strong="H08181"\w* \w cloak|strong="H00155"\w* \w in order to|strong="H04616"\w* \w deceive|strong="H03584"\w*. \v 5 \w He will say|strong="H00559"\w*, ‘\w I|strong="H00595"\w* \w . . .|strong="H00376"\w* \w am not|strong="H03808"\w* \w a prophet|strong="H05030"\w*; \w I|strong="H00595"\w* \w work|strong="H05647"\w* \w the land|strong="H00127"\w*, \w for|strong="H03588"\w* \w vvv|strong="H00120"\w* \w I was purchased as a servant|strong="H07069"\w* \w in my youth|strong="H05271"\w*.\f + \fr 13:5 \ft Or \fqa I am a farmer, for the land has been my livelihood since my youth.\f*’ \v 6 \w If someone asks|strong="H00559"\w* \w him|strong="H00413"\w*, ‘\w What|strong="H04100"\w* \w are these|strong="H00428"\w* \w wounds|strong="H04347"\w* \w on your chest|strong="H00996"\w* \w . . .|strong="H03027"\w*\f + \fr 13:6 \ft Literally \fqa between your hands\f*?’ \w he will answer|strong="H00559"\w*, ‘\w These are|strong="H00834"\w* \w the wounds I received|strong="H05221"\w* \w in the house|strong="H01004"\w* \w of my friends|strong="H00157"\w*.’
