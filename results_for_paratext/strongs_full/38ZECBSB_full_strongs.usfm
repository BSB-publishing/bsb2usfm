\p \v 16 \w -|strong="H01961"\w* \w Then all|strong="H03605"\w* \w the survivors|strong="H03498"\w* \w from|strong="H03605"\w* \w the nations|strong="H01471"\w* \w that came|strong="H00935"\w* \w against|strong="H05921"\w* \w Jerusalem|strong="H03389"\w* \w will go up|strong="H05927"\w* \w . . .|strong="H01767"\w* \w year|strong="H08141"\w* \w after year|strong="H08141"\w* \w to worship|strong="H07812"\w* \w the King|strong="H04428"\w*, \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w and to celebrate|strong="H02287"\w* \w -|strong="H00853"\w* \w the Feast|strong="H02282"\w* \w of Tabernacles|strong="H05521"\w*.\f + \fr 14:16 \ft That is, Sukkot, the autumn feast of pilgrimage to Jerusalem; also translated as \fqa the Feast of Booths \ft or \fqa the Feast of Shelters \ft and originally called \fqa the Feast of Ingathering\ft (see Exodus 23:16 and Exodus 34:22).\f* \v 17 \w And should|strong="H01961"\w* \w any|strong="H00834"\w* \w of the families|strong="H04940"\w* \w of the earth|strong="H00776"\w* \w not|strong="H03808"\w* \w go up|strong="H05927"\w* \w . . .|strong="H00854"\w* \w to|strong="H00413"\w* \w Jerusalem|strong="H03389"\w* \w to worship|strong="H07812"\w* \w the King|strong="H04428"\w*, \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*, \w then the rain|strong="H01653"\w* \w will not|strong="H03808"\w* \w fall|strong="H01961"\w* \w on them|strong="H05921"\w*. \v 18 \w And if|strong="H00518"\w* \w the people|strong="H04940"\w* \w of Egypt|strong="H04714"\w* \w will not|strong="H03808"\w* \w go up|strong="H05927"\w* \w and|strong="H03808"\w* \w enter in|strong="H00935"\w*, \w [then the rain] will not|strong="H03808"\w* \w fall on them|strong="H05921"\w*; \w this will be|strong="H01961"\w* \w the plague|strong="H04046"\w* \w with which|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w -|strong="H00853"\w* \w strikes|strong="H05062"\w* \w the nations|strong="H01471"\w* \w who|strong="H00834"\w* \w do not|strong="H03808"\w* \w