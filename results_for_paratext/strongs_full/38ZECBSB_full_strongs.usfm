\c 14
\s1 The Destroyers of Jerusalem Destroyed
\p \v 1 \w Behold|strong="H02009"\w*, \w a day|strong="H03117"\w* \w of the LORD|strong="H03068"\w* \w is coming|strong="H00935"\w* \w when your plunder|strong="H07998"\w* \w will be divided|strong="H02505"\w* \w in your presence|strong="H07130"\w*. \v 2 \w For I will gather|strong="H00622"\w* \w -|strong="H00853"\w* \w all|strong="H03605"\w* \w the nations|strong="H01471"\w* \w for battle|strong="H04421"\w* \w against|strong="H00413"\w* \w Jerusalem|strong="H03389"\w*, \w and the city|strong="H05892"\w* \w will be captured|strong="H03920"\w*, \w the houses|strong="H01004"\w* \w looted|strong="H08155"\w*, \w and the women|strong="H00802"\w* \w ravished|strong="H07693"\w*. \w Half|strong="H02677"\w* \w of the city|strong="H05892"\w* \w will go|strong="H03318"\w* \w into exile|strong="H01473"\w*, \w but the rest|strong="H03499"\w* \w of the people|strong="H05971"\w* \w will not|strong="H03808"\w* \w be removed|strong="H03772"\w* \w from|strong="H04480"\w* \w the city|strong="H05892"\w*.
\p \v 3 \w Then the LORD|strong="H03068"\w* \w will go out|strong="H03318"\w* \w to fight|strong="H03898"\w* \w against those|strong="H01992"\w* \w nations|strong="H01471"\w*, \w as He fights|strong="H03898"\w* \w in the day|strong="H03117"\w* \w . . .|strong="H03117"\w* \w of battle|strong="H07128"\w*. \v 4 \w On that|strong="H01931"\w* \w day|strong="H03117"\w* \w His feet|strong="H07272"\w* \w will stand|strong="H05975"\w* \w on|strong="H05921"\w* \w the Mount|strong="H02022"\w* \w of Olives|strong="H02132"\w*, \w -|strong="H00834"\w*\w . . .|strong="H05921"\w* \w -|strong="H06440"\w* \w east|strong="H06924"\w* \w of Jerusalem|strong="H03389"\w*, \w and the Mount|strong="H02022"\w* \w of Olives|strong="H02132"\w* \w will be split|strong="H01234"\w* \w in two|strong="H02677"\w* \w from east|strong="H04217"\w* \w to west|strong="H03220"\w*, \w forming a great|strong="H01419"\w* \w . . .|strong="H03966"\w* \w valley|strong="H01516"\w*, \w with half|strong="H02677"\w* \w the mountain|strong="H02022"\w* \w moving|strong="H04185"\w* \w to the north|strong="H06828"\w* \w and half|strong="H02677"\w* \w to the south|strong="H05045"\w*. \v 5 \w You will flee|strong="H05127"\w* \w by My mountain|strong="H02022"\w* \w valley|strong="H01516"\w*, \w for|strong="H03588"\w* \w [it]|strong="H01516"\w* \w . . .|strong="H02022"\w* \w will extend|strong="H05060"\w* \w to|strong="H00413"\w* \w Azal|strong="H00682"\w*. \w You will flee|strong="H05127"\w* \w as|strong="H00834"\w* \w you fled|strong="H05127"\w* \w from|strong="H06440"\w* \w the earthquake|strong="H07494"\w* \w in the days|strong="H03117"\w* \w of Uzziah|strong="H05818"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w*. \w Then the LORD|strong="H03068"\w* \w my God|strong="H00430"\w* \w will come|strong="H00935"\w*, \w and all|strong="H03605"\w* \w the holy ones|strong="H06918"\w* \w with Him|strong="H05973"\w*.\f + \fr 14:5 \ft LXX; Hebrew \fqa with You\f*
\p \v 6 \w -|strong="H01961"\w* \w On that|strong="H01931"\w* \w day|strong="H03117"\w* \w there will be|strong="H01961"\w* \w no|strong="H03808"\w* \w light|strong="H00216"\w*, \w no cold|strong="H03368"\w* \w or frost|strong="H07087"\w*. \v 7 \w It will be|strong="H01961"\w* \w a unique day|strong="H03117"\w* \w known|strong="H03045"\w* \w only|strong="H00259"\w* \w . . .|strong="H01931"\w* \w to the LORD|strong="H03068"\w*, \w without|strong="H03808"\w* \w day|strong="H03117"\w* \w . . .|strong="H03808"\w* \w or night|strong="H03915"\w*; \w but when evening|strong="H06153"\w* \w comes|strong="H01961"\w*, \w there will be|strong="H01961"\w* \w . . .|strong="H06256"\w* \w light|strong="H00216"\w*.
\p \v 8 \w And|strong="H01961"\w* \w on that|strong="H01931"\w* \w day|strong="H03117"\w* \w living|strong="H02416"\w* \w water|strong="H04325"\w* \w will flow out|strong="H03318"\w* \w from Jerusalem|strong="H03389"\w*, \w half|strong="H02677"\w* \w of it toward|strong="H00413"\w* \w the Eastern|strong="H06931"\w* \w Sea|strong="H03220"\w*\f + \fr 14:8 \ft That is, the Dead Sea\f* \w and the other half|strong="H02677"\w* \w toward|strong="H00413"\w* \w the Western|strong="H00314"\w* \w Sea|strong="H03220"\w*,\f + \fr 14:8 \ft That is, the Mediterranean Sea, also called the Great Sea\f* \w in summer|strong="H07019"\w* \w and winter alike|strong="H02779"\w* \w . . .|strong="H01961"\w*. \v 9 \w On that|strong="H01931"\w* \w . . .|strong="H01961"\w* \w day|strong="H03117"\w* \w the LORD|strong="H03068"\w* \w will become|strong="H01961"\w* \w King|strong="H04428"\w* \w over|strong="H05921"\w* \w all|strong="H03605"\w* \w the earth|strong="H00776"\w*— \w the LORD|strong="H03068"\w* \w alone|strong="H00259"\w*, \w and His name|strong="H08034"\w* \w alone|strong="H00259"\w*.
\p \v 10 \w All|strong="H03605"\w* \w the land|strong="H00776"\w* \w from Geba|strong="H01387"\w* \w to Rimmon|strong="H07417"\w* \w south|strong="H05045"\w* \w of Jerusalem|strong="H03389"\w* \w will be turned|strong="H05437"\w* \w into a plain|strong="H06160"\w*, \w but Jerusalem will be raised up|strong="H07213"\w* \w and will remain|strong="H03427"\w* \w in her place|strong="H08478"\w*, \w from the Benjamin|strong="H01144"\w* \w Gate|strong="H08179"\w* \w to|strong="H05704"\w* \w the site|strong="H04725"\w* \w of the First|strong="H07223"\w* \w Gate|strong="H08179"\w* \w to|strong="H05704"\w* \w the Corner|strong="H06434"\w* \w Gate|strong="H08179"\w*, \w and from the Tower|strong="H04026"\w* \w of Hananel|strong="H02606"\w* \w to|strong="H05704"\w* \w the royal|strong="H04428"\w* \w winepresses|strong="H03342"\w*. \v 11 \w People will live|strong="H03427"\w* there, \w and never|strong="H03808"\w* \w again|strong="H05750"\w* \w will there be|strong="H01961"\w* \w an [utter] destruction|strong="H02764"\w*. \w So Jerusalem|strong="H03389"\w* \w will dwell|strong="H03427"\w* \w securely|strong="H00983"\w*.
