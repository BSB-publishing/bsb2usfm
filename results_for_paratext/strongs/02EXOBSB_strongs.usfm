\s1 Bricks and Straw
\p \v 6 \w That same|strong="H01931"\w* \w day|strong="H03117"\w* \w Pharaoh|strong="H06547"\w* \w commanded|strong="H06680"\w* \w the taskmasters|strong="H05065"\w* \w of the people|strong="H05971"\w* \w and their foremen|strong="H07860"\w*: \v 7 “\w You shall no|strong="H03808"\w* \w longer|strong="H03254"\w* \w supply|strong="H05414"\w* \w the people|strong="H05971"\w* \w with straw|strong="H08401"\w* \w for making|strong="H03835"\w* \w bricks|strong="H03843"\w*. \w They|strong="H01992"\w* \w must go|strong="H01980"\w* \w and gather|strong="H07197"\w* their own \w straw|strong="H08401"\w*. \v 8 \w But require|strong="H07760"\w* \w of them|strong="H05921"\w* \w the same quota|strong="H04971"\w* \w of bricks|strong="H03843"\w* \w as|strong="H01992"\w* \w before|strong="H08543"\w*; \w do not|strong="H03808"\w* \w reduce it|strong="H01639"\w*. \w For|strong="H03588"\w* \w they|strong="H01992"\w* \w are lazy|strong="H07503"\w*; \w that is why|strong="H05921"\w* \w they|strong="H01992"\w* \w are crying out|strong="H06817"\w*, ‘\w Let us go|strong="H01980"\w* \w and sacrifice|strong="H02076"\w* \w to our God|strong="H00430"\w*.’ \v 9 \w Make the work harder|strong="H03513"\w* \w on|strong="H05921"\w* \w the men|strong="H00582"\w* \w so they will be occupied|strong="H06213"\w* \w and pay no attention|strong="H08159"\w* \w to these lies|strong="H08267"\w*.”
