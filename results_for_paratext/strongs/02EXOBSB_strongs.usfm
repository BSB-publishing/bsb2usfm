\li1 \v 11 \w the tabernacle|strong="H04908"\w* \w with its tent|strong="H00168"\w* \w and covering|strong="H04372"\w*, \w its clasps|strong="H07165"\w* \w and frames|strong="H07175"\w*, \w its crossbars|strong="H01280"\w*, \w posts|strong="H05982"\w*, \w and bases|strong="H00134"\w*;
\li1 \v 12 \w the ark|strong="H00727"\w* \w with its poles|strong="H00905"\w* \w and mercy seat|strong="H03727"\w*, \w and the veil|strong="H06532"\w* \w to shield it|strong="H04539"\w*;
\li1 \v 13 \w the table|strong="H07979"\w* \w with its poles|strong="H00905"\w*, \w all|strong="H03605"\w* \w its utensils|strong="H03627"\w*, \w and the Bread|strong="H03899"\w* \w of the Presence|strong="H06440"\w*;
\li1 \v 14 \w the lampstand|strong="H04501"\w* \w for light|strong="H03974"\w* \w with its accessories|strong="H03627"\w* \w and lamps|strong="H05216"\w* \w and oil|strong="H08081"\w* \w for the light|strong="H03974"\w*;
