\li1 \w the basin|strong="H03595"\w* \w with its stand|strong="H03653"\w*;
\li1 \v 17 \w the curtains|strong="H07050"\w* \w of the courtyard|strong="H02691"\w* \w with its posts|strong="H05982"\w* \w and bases|strong="H00134"\w*, \w and the curtain|strong="H04539"\w* \w for the gate|strong="H08179"\w* \w of the courtyard|strong="H02691"\w*;
\li1 \v 18 \w the tent pegs|strong="H03489"\w* \w for the tabernacle|strong="H04908"\w* \w and|strong="H03489"\w* \w for the courtyard|strong="H02691"\w*, \w along with their ropes|strong="H04340"\w*;
\li1 \v 19 \w and the woven|strong="H08278"\w* \w garments|strong="H00899"\w* \w for ministering|strong="H08334"\w* \w in the holy place|strong="H06944"\w*— \w both the holy|strong="H06944"\w* \w garments|strong="H00899"\w* \w for Aaron|strong="H00175"\w* \w the priest|strong="H03548"\w* \w and the garments|strong="H00899"\w* \w for his sons|strong="H01121"\w* \w to serve as priests|strong="H03547"\w*.”
\s1 The People Offer Gifts
\p \v 20 \w Then the whole|strong="H03605"\w* \w congregation|strong="H05712"\w* \w of Israel|strong="H03478"\w* \w withdrew|strong="H03318"\w* \w from the presence|strong="H06440"\w* \w of Moses|strong="H04872"\w*. \v 21 \w And everyone|strong="H03605"\w* \w whose|strong="H00834"\w* \w heart|strong="H03820"\w* \w stirred him|strong="H05375"\w* \w and|strong="H03605"\w* \w whose|strong="H00834"\w* \w spirit|strong="H07307"\w* \w prompted|strong="H05068"\w* \w him|strong="H00853"\w* \w came|strong="H00935"\w* \w and brought|strong="H00935"\w* \w an offering|strong="H08641"\w* \w to the LORD|strong="H03068"\w* \w for the work|strong="H04399"\w* \w on the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*, \w for all|strong="H03605"\w* \w its services|strong="H05656"\w*, \w and for the holy|strong="H06944"\w* \w garments|strong="H00899"\w*.
\p \v 22 \w So all|strong="H03605"\w* \w who had willing|strong="H05081"\w* \w hearts|strong="H03820"\w*, \w both men|strong="H00582"\w* \w and|strong="H05921"\w* \w women|strong="H00802"\w*, \w came|strong="H00935"\w* \w and brought|strong="H00935"\w* \w brooches|strong="H02397"\w* \w and earrings|strong="H05141"\w*, \w rings|strong="H02885"\w* \w and necklaces|strong="H03558"\w*, \w and all kinds|strong="H03605"\w* \w of gold|strong="H02091"\w* \w jewelry|strong="H03627"\w*. \w And they all|strong="H03605"\w* \w presented|strong="H05130"\w* \w their gold|strong="H02091"\w* \w as a wave offering|strong="H08573"\w* \w to the LORD|strong="H03068"\w*.
\p \v 23 \w Everyone|strong="H03605"\w* \w who|strong="H00834"\w* \w had|strong="H00854"\w* \w blue|strong="H08504"\w*, \w purple|strong="H00713"\w*, \w or scarlet yarn|strong="H08438"\w*, \w or fine linen|strong="H08336"\w*, \w goat hair|strong="H05795"\w*, \w ram|strong="H00352"\w* \w skins|strong="H05785"\w* \w dyed red|strong="H00119"\w*, \w or articles of fine leather|strong="H08476"\w*, \w brought them|strong="H00935"\w*. \v 24 \w And all|strong="H03605"\w* \w who could present|strong="H07311"\w* \w an offering|strong="H08641"\w* \w of silver|strong="H03701"\w* \w or bronze|strong="H05178"\w* \w brought|strong="H00935"\w* \w it|strong="H00853"\w* \w as a contribution|strong="H08641"\w* \w to the LORD|strong="H03068"\w*. \w Also, everyone|strong="H03605"\w* \w who|strong="H00834"\w* \w had|strong="H04672"\w* \w acacia|strong="H07848"\w* \w wood|strong="H06086"\w* \w for any|strong="H03605"\w* \w part|strong="H04399"\w* \w of the service|strong="H05656"\w* \w brought it|strong="H00935"\w*.
\p \v 25 \w Every|strong="H03605"\w* \w skilled|strong="H02450"\w* \w woman|strong="H00802"\w* \w spun|strong="H02901"\w* \w with her hands|strong="H03027"\w* \w and brought|strong="H00935"\w* \w what she had spun|strong="H04299"\w*: \w blue|strong="H08504"\w*, \w purple|strong="H00713"\w*, \w or scarlet yarn|strong="H08438"\w*, \w or fine linen|strong="H08336"\w*. \v 26 \w And all|strong="H03605"\w* \w the skilled women|strong="H00802"\w* \w whose|strong="H00834"\w* \w hearts|strong="H03820"\w* \w were stirred|strong="H05375"\w* \w spun|strong="H02901"\w* \w the goat hair|strong="H05795"\w*.
\p \v 27 \w The leaders|strong="H05387"\w* \w brought|strong="H00935"\w* \w onyx|strong="H07718"\w* \w stones|strong="H00068"\w* \w and gemstones|strong="H00068"\w* \w to mount|strong="H04394"\w* \w on the ephod|strong="H00646"\w* \w and breastpiece|strong="H02833"\w*, \v 28 \w as well as spices|strong="H01314"\w* \w and olive oil|strong="H08081"\w* \w for the light|strong="H03974"\w*, \w for the anointing|strong="H04888"\w* \w oil|strong="H08081"\w*, \w and for the fragrant|strong="H05561"\w* \w incense|strong="H07004"\w*.
\p \v 29 \w So all|strong="H03605"\w* \w the men|strong="H00376"\w* \w and women|strong="H00802"\w* \w of the Israelites|strong="H03478"\w* \w whose|strong="H00834"\w* \w hearts|strong="H03820"\w* \w prompted|strong="H05068"\w* \w them|strong="H00853"\w* \w brought|strong="H00935"\w* \w a freewill offering|strong="H05071"\w* \w to the LORD|strong="H03068"\w* \w for all|strong="H03605"\w* \w the work|strong="H04399"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w through|strong="H03027"\w* \w Moses|strong="H04872"\w* \w had commanded them|strong="H06680"\w* \w to do|strong="H06213"\w*.
\s1 Bezalel and Oholiab
\r (Exodus 31:1–11)
\p \v 30 \w Then Moses|strong="H04872"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w the Israelites|strong="H01121"\w*, “\w See|strong="H07200"\w*, \w the LORD|strong="H03068"\w* \w has called|strong="H07121"\w* \w by name|strong="H08034"\w* \w Bezalel|strong="H01212"\w* \w son|strong="H01121"\w* \w of Uri|strong="H00221"\w*, \w the son|strong="H01121"\w* \w of Hur|strong="H02354"\w*, \w of the tribe|strong="H04294"\w* \w of Judah|strong="H03063"\w*. \v 31 \w And He has filled|strong="H04390"\w* \w him|strong="H00853"\w* \w with the Spirit|strong="H07307"\w* \w of God|strong="H00430"\w*, \w with skill|strong="H02451"\w*, \w ability|strong="H08394"\w*, \w and knowledge|strong="H01847"\w* \w in all kinds|strong="H03605"\w* \w of craftsmanship|strong="H04399"\w*, \v 32 \w to design|strong="H02803"\w* \w artistic|strong="H04284"\w* \w works|strong="H06213"\w* \w in gold|strong="H02091"\w*, \w silver|strong="H03701"\w*, \w and bronze|strong="H05178"\w*, \v 33 \w to cut|strong="H02799"\w* \w gemstones|strong="H00068"\w* \w for settings|strong="H04390"\w*, \w and to carve|strong="H02799"\w* \w wood|strong="H06086"\w*, \w so that he may be a master|strong="H06213"\w* \w of every|strong="H03605"\w* \w artistic|strong="H04284"\w* \w craft|strong="H04399"\w*.
\p \v 34 \w And the LORD|strong="H03820"\w* \w has given|strong="H05414"\w* \w both him|strong="H01931"\w* \w and Oholiab|strong="H00171"\w* \w son|strong="H01121"\w* \w of Ahisamach|strong="H00294"\w*, \w of the tribe|strong="H04294"\w* \w of Dan|strong="H01835"\w*, \w the ability to teach others|strong="H03384"\w*. \v 35 \w He has filled|strong="H04390"\w* \w them|strong="H00853"\w* \w with skill|strong="H02451"\w* \w to do|strong="H06213"\w* \w all kinds|strong="H03605"\w* \w of work|strong="H04399"\w* \w as engravers|strong="H02796"\w*, \w designers|strong="H02803"\w*, \w embroiderers|strong="H07551"\w* \w in blue|strong="H08504"\w*, \w purple|strong="H00713"\w*, \w and scarlet yarn|strong="H08438"\w* \w and fine linen|strong="H08336"\w*, \w and as weavers|strong="H00707"\w* — \w as artistic designers|strong="H06213"\w* \w of every kind|strong="H03605"\w* \w of craft|strong="H04399"\w*.[’’]
\c 36
\s1 The People Bring More than Enough
\p \v 1 “\w So Bezalel|strong="H01212"\w*, \w Oholiab|strong="H00171"\w*, \w and every|strong="H03605"\w* \w skilled|strong="H02450"\w* \w person|strong="H00376"\w* \w are to carry out|strong="H06213"\w* \w everything|strong="H03605"\w* \w commanded|strong="H06680"\w* \w by the LORD|strong="H03068"\w*, \w who|strong="H03068"\w* \w has given|strong="H05414"\w* them \w skill|strong="H02451"\w* \w and ability|strong="H08394"\w* \w to know|strong="H03045"\w* \w how to perform|strong="H06213"\w* \w all|strong="H03605"\w* \w the work|strong="H04399"\w* \w of constructing|strong="H05656"\w* \w the sanctuary|strong="H06944"\w*.”
\p \v 2 \w Then Moses|strong="H04872"\w* \w summoned|strong="H07121"\w* \w Bezalel|strong="H01212"\w*, \w Oholiab|strong="H00171"\w*, \w and every|strong="H03605"\w* \w skilled|strong="H02450"\w* \w person|strong="H00376"\w* \w whom|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had gifted|strong="H05414"\w* — \w everyone|strong="H03605"\w* \w whose|strong="H00834"\w* \w heart|strong="H03820"\w* \w stirred him|strong="H05375"\w* \w to come|strong="H07126"\w* \w and do|strong="H06213"\w* \w the work|strong="H04399"\w*. \v 3 \w They received|strong="H03947"\w* \w from|strong="H06440"\w* \w Moses|strong="H04872"\w* \w all|strong="H03605"\w* \w the contributions|strong="H08641"\w* \w that|strong="H00834"\w* \w the Israelites|strong="H01121"\w* \w had brought|strong="H00935"\w* \w to carry out|strong="H04399"\w* \w the service|strong="H05656"\w* \w of constructing|strong="H06213"\w* \w the sanctuary|strong="H06944"\w*.
\p \w Meanwhile, the people|strong="H01992"\w* \w continued to bring|strong="H00935"\w* \w freewill offerings|strong="H05071"\w* \w morning|strong="H01242"\w* \w after morning|strong="H01242"\w*, \v 4 \w so that all|strong="H03605"\w* \w the skilled craftsmen|strong="H02450"\w* \w who were doing|strong="H06213"\w* \w all|strong="H03605"\w* \w the work|strong="H04399"\w* \w on the sanctuary|strong="H06944"\w* \w left|strong="H00935"\w* \w their work|strong="H04399"\w* \v 5 \w and said|strong="H00559"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*, “\w The people|strong="H05971"\w* \w are bringing|strong="H00935"\w* \w more|strong="H07235"\w* \w than enough|strong="H01767"\w* \w for doing|strong="H05656"\w* \w the work|strong="H04399"\w* \w the LORD|strong="H03068"\w* \w has commanded|strong="H06680"\w* \w us|strong="H00853"\w* \w to do|strong="H06213"\w*.”
\p \v 6 \w After Moses|strong="H04872"\w* \w had given an order|strong="H06680"\w*, \w they sent|strong="H05674"\w* \w a proclamation|strong="H06963"\w* \w throughout the camp|strong="H04264"\w*: “\w No|strong="H00408"\w* \w man|strong="H00376"\w* \w or woman|strong="H00802"\w* \w should make|strong="H06213"\w* \w anything|strong="H04399"\w* \w else|strong="H05750"\w* \w as an offering|strong="H08641"\w* \w for the sanctuary|strong="H06944"\w*.” \w So the people|strong="H05971"\w* \w were restrained|strong="H03607"\w* \w from bringing more|strong="H00935"\w*, \v 7 \w since what they already had|strong="H01961"\w* \w was more|strong="H03498"\w* \w than enough|strong="H01767"\w* \w to perform|strong="H06213"\w* \w all|strong="H03605"\w* \w the work|strong="H04399"\w*.
\s1 The Ten Curtains for the Tabernacle
\r (Exodus 26:1–6)
\p \v 8 \w All|strong="H03605"\w* \w the skilled craftsmen|strong="H02450"\w* \w among the workmen|strong="H06213"\w* \w made|strong="H06213"\w* \w the ten|strong="H06235"\w* \w curtains|strong="H03407"\w* \w for the tabernacle|strong="H04908"\w*. \w They were made|strong="H06213"\w* \w of finely spun|strong="H07806"\w* \w linen|strong="H08336"\w*, \w as well as blue|strong="H08504"\w*, \w purple|strong="H00713"\w*, \w and scarlet yarn|strong="H08438"\w*, \w with cherubim|strong="H03742"\w* \w skillfully|strong="H02803"\w* \w worked into them|strong="H04639"\w*. \v 9 \w Each|strong="H00259"\w* \w curtain|strong="H03407"\w* \w was twenty-eight|strong="H08083"\w* \w cubits|strong="H00520"\w* \w long|strong="H00753"\w* \w and four|strong="H00702"\w* \w cubits|strong="H00520"\w* \w wide|strong="H07341"\w*;\f + \fr 36:9 \ft Each of the ten curtains was approximately 42 feet long and 6 feet wide (12.8 meters long and 1.8 meters wide).\f* \w all|strong="H03605"\w* \w the curtains|strong="H03407"\w* \w were the same|strong="H00259"\w* \w size|strong="H04060"\w*. \v 10 \w And he joined|strong="H02266"\w* \w five|strong="H02568"\w* \w of the curtains|strong="H03407"\w* \w together|strong="H00413"\w*, \w and the other five|strong="H02568"\w* \w he joined|strong="H02266"\w* \w as well|strong="H00413"\w*.
\p \v 11 \w He made|strong="H06213"\w* \w loops|strong="H03924"\w* \w of blue material|strong="H08504"\w* \w on|strong="H05921"\w* \w the edge|strong="H08193"\w* \w of the end|strong="H07098"\w* \w curtain|strong="H03407"\w* \w in the first|strong="H00259"\w* \w set|strong="H04225"\w*, \w and also|strong="H06213"\w* \w on the end|strong="H07020"\w* \w curtain|strong="H03407"\w* \w in the second|strong="H08145"\w* \w set|strong="H04225"\w*. \v 12 \w He made|strong="H06213"\w* \w fifty|strong="H02572"\w* \w loops|strong="H03924"\w* \w on one|strong="H00259"\w* \w curtain|strong="H03407"\w* \w and fifty|strong="H02572"\w* \w loops|strong="H03924"\w* \w on the end|strong="H07097"\w* \w curtain|strong="H03407"\w* \w of the second|strong="H08145"\w* \w set|strong="H04225"\w*, \w so that the loops|strong="H03924"\w* \w lined up|strong="H06901"\w* \w opposite|strong="H00413"\w* \w one|strong="H00259"\w* \w another|strong="H00259"\w*. \v 13 \w He also made|strong="H06213"\w* \w fifty|strong="H02572"\w* \w gold|strong="H02091"\w* \w clasps|strong="H07165"\w* \w to join|strong="H02266"\w* \w the curtains|strong="H03407"\w* \w together|strong="H00413"\w*, \w so that the tabernacle|strong="H04908"\w* \w was|strong="H01961"\w* \w a unit|strong="H00259"\w*.
\s1 The Eleven Curtains of Goat Hair
\r (Exodus 26:7–14)
\p \v 14 \w He then made|strong="H06213"\w* \w curtains|strong="H03407"\w* \w of goat hair|strong="H05795"\w* \w for the tent|strong="H00168"\w* \w over|strong="H05921"\w* \w the tabernacle|strong="H04908"\w* — \w eleven|strong="H06249"\w* \w curtains|strong="H03407"\w* \w in all|strong="H06213"\w*. \v 15 \w Each|strong="H00259"\w* \w of the eleven|strong="H06249"\w* \w curtains|strong="H03407"\w* \w was the same|strong="H00259"\w* \w size|strong="H04060"\w* — \w thirty|strong="H07970"\w* \w cubits|strong="H00520"\w* \w long|strong="H00753"\w* \w and four|strong="H00702"\w* \w cubits|strong="H00520"\w* \w wide|strong="H07341"\w*.\f + \fr 36:15 \ft Each of the eleven curtains was approximately 45 feet long and 6 feet wide (13.7 meters long and 1.8 meters wide).\f* \v 16 \w He joined|strong="H02266"\w* \w five|strong="H02568"\w* \w of the curtains|strong="H03407"\w* \w into one set|strong="H00905"\w* \w and the other|strong="H03407"\w* \w six|strong="H08337"\w* \w into another|strong="H00905"\w*. \v 17 \w He made|strong="H06213"\w* \w fifty|strong="H02572"\w* \w loops|strong="H03924"\w* \w along|strong="H05921"\w* \w the edge|strong="H08193"\w* \w of the end|strong="H07020"\w* \w curtain|strong="H03407"\w* \w in the first set|strong="H04225"\w*, \w and fifty|strong="H02572"\w* \w loops|strong="H03924"\w* \w along|strong="H05921"\w* \w the edge|strong="H08193"\w* \w of the corresponding curtain|strong="H03407"\w* \w in the second|strong="H08145"\w* \w set|strong="H02279"\w*. \v 18 \w He also made|strong="H06213"\w* \w fifty|strong="H02572"\w* \w bronze|strong="H05178"\w* \w clasps|strong="H07165"\w* \w to join the tent|strong="H00168"\w* \w together|strong="H02266"\w* \w as a unit|strong="H00259"\w*.
\p \v 19 \w Additionally, he made|strong="H06213"\w* \w for the tent|strong="H00168"\w* \w a covering|strong="H04372"\w* \w of ram|strong="H00352"\w* \w skins|strong="H05785"\w* \w dyed red|strong="H00119"\w*, \w and over that|strong="H04605"\w* \w a covering|strong="H04372"\w* \w of fine leather|strong="H08476"\w*.\f + \fr 36:19 \ft Possibly the hides of large aquatic mammals\f*
\s1 The Frames and Bases
\r (Exodus 26:15–30)
\p \v 20 \w Next, he constructed|strong="H06213"\w* \w upright|strong="H05975"\w* \w frames|strong="H07175"\w* \w of acacia|strong="H07848"\w* \w wood|strong="H06086"\w* \w for the tabernacle|strong="H04908"\w*. \v 21 \w Each frame|strong="H07175"\w* \w was ten|strong="H06235"\w* \w cubits|strong="H00520"\w* \w long|strong="H00753"\w* \w and a cubit|strong="H00520"\w* \w and a half|strong="H02677"\w* \w wide|strong="H07341"\w*.\f + \fr 36:21 \ft Each frame was approximately 15 feet long and 2.25 feet wide (4.6 meters long and 68.6 centimeters wide).\f* \v 22 \w Two|strong="H08147"\w* \w tenons|strong="H03027"\w*\f + \fr 36:22 \ft That is, projecting pieces of wood made for insertion into another piece; similarly in verse 24.\f* \w were connected|strong="H07947"\w* \w to|strong="H00413"\w* \w each|strong="H00259"\w* \w other|strong="H00259"\w* \w for each|strong="H00259"\w* \w frame|strong="H07175"\w*. \w He made|strong="H06213"\w* \w all|strong="H03605"\w* \w the frames|strong="H07175"\w* \w of the tabernacle|strong="H04908"\w* \w in this way|strong="H03651"\w*.
\p \v 23 \w He constructed|strong="H06213"\w* \w twenty|strong="H06242"\w* \w frames|strong="H07175"\w* \w for the south|strong="H05045"\w* \w side|strong="H06285"\w* \w of the tabernacle|strong="H04908"\w*, \v 24 \w with|strong="H06213"\w* \w forty|strong="H00705"\w* \w silver|strong="H03701"\w* \w bases|strong="H00134"\w* \w to put under|strong="H08478"\w* \w the twenty|strong="H06242"\w* \w frames|strong="H07175"\w* — \w two|strong="H08147"\w* \w bases|strong="H00134"\w* \w for each frame|strong="H07175"\w*, \w one|strong="H00259"\w* \w under|strong="H08478"\w* \w each|strong="H00259"\w* \w tenon|strong="H03027"\w*.
\p \v 25 \w For the second|strong="H08145"\w* \w side|strong="H06763"\w* \w of the tabernacle|strong="H04908"\w*, \w the north|strong="H06828"\w* \w side|strong="H06285"\w*, \w he made|strong="H06213"\w* \w twenty|strong="H06242"\w* \w frames|strong="H07175"\w* \v 26 \w and forty|strong="H00705"\w* \w silver|strong="H03701"\w* \w bases|strong="H00134"\w* — \w two|strong="H08147"\w* \w bases|strong="H00134"\w* \w under|strong="H08478"\w* \w each|strong="H00259"\w* \w frame|strong="H07175"\w*.
\p \v 27 \w He made|strong="H06213"\w* \w six|strong="H08337"\w* \w frames|strong="H07175"\w* \w for the rear|strong="H03411"\w* \w of the tabernacle|strong="H04908"\w*, \w the west side|strong="H03220"\w*, \v 28 \w and|strong="H06213"\w* \w two|strong="H08147"\w* \w frames|strong="H07175"\w* \w for the two back|strong="H03411"\w* \w corners|strong="H04742"\w* \w of the tabernacle|strong="H04908"\w*, \v 29 \w coupled together|strong="H08380"\w* \w from bottom|strong="H04295"\w* \w to|strong="H00413"\w* \w top|strong="H07218"\w* \w and fitted into|strong="H00413"\w* \w a single|strong="H00259"\w* \w ring|strong="H02885"\w*. \w He made|strong="H06213"\w* \w both|strong="H08147"\w* \w corners|strong="H04740"\w* \w in this way|strong="H03651"\w*. \v 30 \w So there were|strong="H01961"\w* \w eight|strong="H08083"\w* \w frames|strong="H07175"\w* \w and sixteen|strong="H08337"\w* \w silver|strong="H03701"\w* \w bases|strong="H00134"\w* — \w two|strong="H08147"\w* \w under|strong="H08478"\w* \w each|strong="H00259"\w* \w frame|strong="H07175"\w*.
\p \v 31 \w He also made|strong="H06213"\w* \w five|strong="H02568"\w* \w crossbars|strong="H01280"\w* \w of acacia|strong="H07848"\w* \w wood|strong="H06086"\w* \w for the frames|strong="H07175"\w* \w on one|strong="H00259"\w* \w side|strong="H06763"\w* \w of the tabernacle|strong="H04908"\w*, \v 32 \w five|strong="H02568"\w* \w for those|strong="H07175"\w* \w on the other|strong="H08145"\w* \w side|strong="H06763"\w*, \w and five|strong="H02568"\w* \w for those|strong="H07175"\w* \w on the rear side|strong="H03411"\w* \w of the tabernacle|strong="H04908"\w*, \w to the west|strong="H03220"\w*.
\p \v 33 \w He made|strong="H06213"\w* \w the central|strong="H08484"\w* \w crossbar|strong="H01280"\w* \w to run through|strong="H01272"\w* \w the center|strong="H08432"\w* \w of the frames|strong="H07175"\w*, \w from|strong="H04480"\w* \w one end|strong="H07097"\w* \w to|strong="H00413"\w* \w the other|strong="H07097"\w*. \v 34 \w And|strong="H00853"\w* \w he overlaid|strong="H06823"\w* \w the frames|strong="H07175"\w* \w with gold|strong="H02091"\w* \w and made|strong="H06213"\w* \w gold|strong="H02091"\w* \w rings|strong="H02885"\w* \w to hold|strong="H01004"\w* \w the crossbars|strong="H01280"\w*. \w He also overlaid|strong="H06823"\w* \w the crossbars|strong="H01280"\w* \w with gold|strong="H02091"\w*.
\s1 The Veil
\r (Exodus 26:31–35)
\p \v 35 \w Next, he made|strong="H06213"\w* \w the veil|strong="H06532"\w* \w of blue|strong="H08504"\w*, \w purple|strong="H00713"\w*, \w and scarlet yarn|strong="H08438"\w*, \w and finely spun|strong="H07806"\w* \w linen|strong="H08336"\w*, \w with cherubim|strong="H03742"\w* \w skillfully|strong="H02803"\w* \w worked into it|strong="H04639"\w*.
\p \v 36 \w He also made|strong="H06213"\w* \w four|strong="H00702"\w* \w posts|strong="H05982"\w* \w of acacia wood|strong="H07848"\w* for it \w and overlaid them|strong="H06823"\w* \w with gold|strong="H02091"\w*, \w along with gold|strong="H02091"\w* \w hooks|strong="H02053"\w*; \w and he cast|strong="H03332"\w* \w four|strong="H00702"\w* \w silver|strong="H03701"\w* \w bases|strong="H00134"\w* for the posts.
\s1 The Curtain for the Entrance
\r (Exodus 26:36–37)
\p \v 37 \w For the entrance|strong="H06607"\w* \w to the tent|strong="H00168"\w*, \w he made|strong="H06213"\w* \w a curtain|strong="H04539"\w* \w embroidered|strong="H07551"\w* \w with blue|strong="H08504"\w*, \w purple|strong="H00713"\w*, \w and scarlet yarn|strong="H08438"\w*, \w and finely spun|strong="H07806"\w* \w linen|strong="H08336"\w*, \v 38 \w together with|strong="H00853"\w* \w five|strong="H02568"\w* \w posts|strong="H05982"\w* \w and their hooks|strong="H02053"\w*.
\p \w He overlaid|strong="H06823"\w* \w the tops|strong="H07218"\w* \w of the posts and their bands|strong="H02838"\w* \w with gold|strong="H02091"\w*, \w and their five|strong="H02568"\w* \w bases|strong="H00134"\w* \w were bronze|strong="H05178"\w*.
\c 37
\s1 Constructing the Ark
\r (Exodus 25:10–16)
\p \v 1 \w Bezalel went on|strong="H01212"\w* \w to construct|strong="H06213"\w* \w the ark|strong="H00727"\w* \w of acacia|strong="H07848"\w* \w wood|strong="H06086"\w*, \w two|strong="H00520"\w* \w and a half cubits|strong="H02677"\w* \w long|strong="H00753"\w*, \w a cubit|strong="H00520"\w* \w and a half|strong="H02677"\w* \w wide|strong="H07341"\w*, \w and a cubit|strong="H00520"\w* \w and a half|strong="H02677"\w* \w high|strong="H06967"\w*.\f + \fr 37:1 \ft The ark was approximately 3.75 feet long, 2.25 feet wide, and 2.25 feet high (114.3 centimeters long, 68.6 centimeters wide, and 68.6 centimeters high).\f* \v 2 \w He overlaid|strong="H06823"\w* \w it with pure|strong="H02889"\w* \w gold|strong="H02091"\w*, \w both inside|strong="H01004"\w* \w and out|strong="H02351"\w*, \w and made|strong="H06213"\w* \w a gold|strong="H02091"\w* \w molding|strong="H02213"\w* \w around it|strong="H05439"\w*. \v 3 \w And he cast|strong="H03332"\w* \w four|strong="H00702"\w* \w gold|strong="H02091"\w* \w rings|strong="H02885"\w* \w for|strong="H05921"\w* \w its four|strong="H00702"\w* \w feet|strong="H06471"\w*, \w two|strong="H08147"\w* \w rings|strong="H02885"\w* \w on|strong="H05921"\w* \w one|strong="H00259"\w* \w side|strong="H06763"\w* \w and two|strong="H08147"\w* \w on|strong="H05921"\w* \w the other|strong="H08145"\w*. \v 4 \w Then he made|strong="H06213"\w* \w poles|strong="H00905"\w* \w of acacia|strong="H07848"\w* \w wood|strong="H06086"\w* \w and overlaid|strong="H06823"\w* \w them|strong="H00853"\w* \w with gold|strong="H02091"\w*. \v 5 \w He inserted|strong="H00935"\w* \w the poles|strong="H00905"\w* \w into the rings|strong="H02885"\w* \w on|strong="H05921"\w* \w the sides|strong="H06763"\w* \w of the ark|strong="H00727"\w* \w in order to carry|strong="H05375"\w* \w it|strong="H00727"\w*.
\s1 The Mercy Seat
\r (Exodus 25:17–22)
\p \v 6 \w He constructed|strong="H06213"\w* \w a mercy seat|strong="H03727"\w* \w of pure|strong="H02889"\w* \w gold|strong="H02091"\w*, \w two|strong="H00520"\w* \w and a half cubits|strong="H02677"\w* \w long|strong="H00753"\w* \w and a cubit|strong="H00520"\w* \w and a half|strong="H02677"\w* \w wide|strong="H07341"\w*.\f + \fr 37:6 \ft The mercy seat was approximately 3.75 feet long and 2.25 feet wide (114.3 centimeters long and 68.6 centimeters wide).\f* \v 7 \w He made|strong="H06213"\w* \w two|strong="H08147"\w* \w cherubim|strong="H03742"\w* \w of hammered|strong="H04749"\w* \w gold|strong="H02091"\w* \w at the|strong="H08147"\w* \w ends|strong="H07098"\w* \w of the mercy seat|strong="H03727"\w*, \v 8 \w one|strong="H00259"\w* \w cherub|strong="H03742"\w* \w on one|strong="H02088"\w* \w end|strong="H07098"\w* \w and one|strong="H00259"\w* \w on the other|strong="H02088"\w*, \w all made|strong="H06213"\w* \w from one piece of gold|strong="H07117"\w*. \v 9 \w And the cherubim|strong="H03742"\w* \w had wings|strong="H03671"\w* \w that spread|strong="H06566"\w* \w upward|strong="H04605"\w*, \w overshadowing|strong="H05526"\w* \w the mercy seat|strong="H03727"\w*. \w The cherubim faced|strong="H06440"\w* \w each|strong="H00376"\w* \w other|strong="H00251"\w*, \w looking toward|strong="H00413"\w* \w the mercy seat|strong="H03727"\w*.
\s1 The Table of Showbread
\r (Exodus 25:23–30; Leviticus 24:5–9)
\p \v 10 \w He also made|strong="H06213"\w* \w the table|strong="H07979"\w* \w of acacia|strong="H07848"\w* \w wood|strong="H06086"\w* \w two cubits|strong="H00520"\w* \w long|strong="H00753"\w*, \w a cubit|strong="H00520"\w* \w wide|strong="H07341"\w*, \w and a cubit|strong="H00520"\w* \w and a half|strong="H02677"\w* \w high|strong="H06967"\w*.\f + \fr 37:10 \ft The table was approximately 3 feet long, 1.5 feet wide, and 2.25 feet high (91.4 centimeters long, 45.7 centimeters wide, and 68.6 centimeters high).\f* \v 11 \w He overlaid|strong="H06823"\w* \w it|strong="H00853"\w* \w with pure|strong="H02889"\w* \w gold|strong="H02091"\w* \w and made|strong="H06213"\w* \w a gold|strong="H02091"\w* \w molding|strong="H02213"\w* \w around it|strong="H05439"\w*. \v 12 \w And he made|strong="H06213"\w* \w a rim|strong="H04526"\w* \w around|strong="H05439"\w* it \w a handbreadth wide|strong="H02948"\w*\f + \fr 37:12 \fqa A handbreadth \ft is approximately 2.9 inches or 7.4 centimeters.\f* \w and put|strong="H06213"\w* \w a gold|strong="H02091"\w* \w molding|strong="H02213"\w* \w on|strong="H05439"\w* \w the rim|strong="H04526"\w*.
\p \v 13 \w He cast|strong="H03332"\w* \w four|strong="H00702"\w* \w gold|strong="H02091"\w* \w rings|strong="H02885"\w* for the table \w and fastened|strong="H05414"\w* \w them|strong="H02885"\w* \w to|strong="H05921"\w* \w the four|strong="H00702"\w* \w corners|strong="H06285"\w* \w at its four|strong="H00702"\w* \w legs|strong="H07272"\w*. \v 14 \w The rings|strong="H02885"\w* \w were placed|strong="H01961"\w* \w close|strong="H05980"\w* \w to the rim|strong="H04526"\w*, \w to serve as holders|strong="H01004"\w* \w for the poles|strong="H00905"\w* \w used to carry|strong="H05375"\w* \w the table|strong="H07979"\w*. \v 15 \w He made|strong="H06213"\w* \w the poles|strong="H00905"\w* \w of acacia|strong="H07848"\w* \w wood|strong="H06086"\w* \w for carrying|strong="H05375"\w* \w the table|strong="H07979"\w* \w and overlaid|strong="H06823"\w* \w them|strong="H00853"\w* \w with gold|strong="H02091"\w*.
\p \v 16 \w He also made|strong="H06213"\w* \w the utensils|strong="H03627"\w* \w for|strong="H05921"\w* \w the table|strong="H07979"\w* \w out of pure|strong="H02889"\w* \w gold|strong="H02091"\w*: \w its plates|strong="H07086"\w* \w and dishes|strong="H03709"\w*, \w as well as its bowls|strong="H04518"\w* \w and pitchers|strong="H07184"\w* \w for pouring drink offerings|strong="H05258"\w*.
\s1 The Lampstand
\r (Exodus 25:31–40; Numbers 8:1–4)
\p \v 17 \w Then he made|strong="H06213"\w* \w the lampstand|strong="H04501"\w* \w out of pure|strong="H02889"\w* \w hammered|strong="H04749"\w* \w gold|strong="H02091"\w*, \w all of one piece|strong="H04480"\w*: \w its base|strong="H03409"\w* \w and shaft|strong="H07070"\w*, \w its cups|strong="H01375"\w*, \w and its buds|strong="H03730"\w* \w and petals|strong="H06525"\w*. \v 18 \w Six|strong="H08337"\w* \w branches|strong="H07070"\w* \w extended|strong="H03318"\w* \w from the sides|strong="H06654"\w*, \w three|strong="H07969"\w* \w on one|strong="H00259"\w* \w side|strong="H06654"\w* \w and three|strong="H07969"\w* \w on the other|strong="H08145"\w*. \v 19 \w There were three|strong="H07969"\w* \w cups|strong="H01375"\w* \w shaped like almond blossoms|strong="H08246"\w* \w on the first|strong="H00259"\w* \w branch|strong="H07070"\w*, \w each with buds|strong="H03730"\w* \w and petals|strong="H06525"\w*, \w three|strong="H07969"\w* \w on the next|strong="H00259"\w* \w branch|strong="H07070"\w*, \w and the same|strong="H03651"\w* \w for all six|strong="H08337"\w* \w branches|strong="H07070"\w* \w that extended|strong="H03318"\w* \w from|strong="H04480"\w* \w the lampstand|strong="H04501"\w*.
\p \v 20 \w And on the lampstand|strong="H04501"\w* \w were four|strong="H00702"\w* \w cups|strong="H01375"\w* \w shaped like almond blossoms|strong="H08246"\w* \w with buds|strong="H03730"\w* \w and petals|strong="H06525"\w*. \v 21 \w A bud|strong="H03730"\w* \w was under|strong="H08478"\w* \w the first pair|strong="H08147"\w* \w of branches|strong="H07070"\w* \w that extended|strong="H03318"\w* \w from the lampstand|strong="H04480"\w*, \w a bud|strong="H03730"\w* \w under|strong="H08478"\w* \w the second pair|strong="H08147"\w*, \w and a bud|strong="H03730"\w* \w under|strong="H08478"\w* \w the third pair|strong="H08147"\w*. \v 22 \w The buds|strong="H03730"\w* \w and branches|strong="H07070"\w* \w were|strong="H01961"\w* \w all|strong="H03605"\w* \w of one piece with the lampstand|strong="H04480"\w*, \w hammered|strong="H04749"\w* \w out of pure|strong="H02889"\w* \w gold|strong="H02091"\w*.
\p \v 23 \w He also made|strong="H06213"\w* \w its seven|strong="H07651"\w* \w lamps|strong="H05216"\w*, \w its wick trimmers|strong="H04457"\w*, \w and trays|strong="H04289"\w* \w of pure|strong="H02889"\w* \w gold|strong="H02091"\w*. \v 24 \w He made|strong="H06213"\w* \w the lampstand|strong="H00853"\w* \w and all|strong="H03605"\w* \w its utensils|strong="H03627"\w* \w from a talent|strong="H03603"\w* \w of pure|strong="H02889"\w* \w gold|strong="H02091"\w*.\f + \fr 37:24 \fqa A talent \ft is approximately 75.4 pounds or 34.2 kilograms of gold.\f*
\s1 The Altar of Incense
\r (Exodus 30:1–10)
\p \v 25 \w He made|strong="H06213"\w* \w the altar|strong="H04196"\w* \w of incense|strong="H07004"\w* \w out of acacia|strong="H07848"\w* \w wood|strong="H06086"\w*. \w It was square|strong="H07251"\w*, \w a cubit|strong="H00520"\w* \w long|strong="H00753"\w*, \w a cubit|strong="H00520"\w* \w wide|strong="H07341"\w*, \w and two cubits|strong="H00520"\w* \w high|strong="H06967"\w*.\f + \fr 37:25 \ft The altar was approximately 1.5 feet in length and width, and 3 feet high (45.7 centimeters in length and width, and 91.4 centimeters high).\f* \w Its horns|strong="H07161"\w* \w were|strong="H01961"\w* \w of one piece|strong="H04480"\w*. \v 26 \w And he overlaid|strong="H06823"\w* \w with pure|strong="H02889"\w* \w gold|strong="H02091"\w* \w the top|strong="H01406"\w* \w and|strong="H00853"\w* \w all|strong="H05439"\w* \w the sides|strong="H07023"\w* \w and horns|strong="H07161"\w*. \w Then he made|strong="H06213"\w* \w a molding|strong="H02213"\w* \w of gold|strong="H02091"\w* \w around it|strong="H05439"\w*.
\p \v 27 \w He made|strong="H06213"\w* \w two|strong="H08147"\w* \w gold|strong="H02091"\w* \w rings|strong="H02885"\w* \w below|strong="H08478"\w* \w the molding|strong="H02213"\w* \w on|strong="H05921"\w* \w opposite sides|strong="H06654"\w* \w to hold|strong="H01004"\w* \w the poles|strong="H00905"\w* \w used to carry|strong="H05375"\w* \w it|strong="H00853"\w*. \v 28 \w And he made|strong="H06213"\w* \w the poles|strong="H00905"\w* \w of acacia|strong="H07848"\w* \w wood|strong="H06086"\w* \w and overlaid|strong="H06823"\w* \w them|strong="H00853"\w* \w with gold|strong="H02091"\w*.
\p \v 29 \w He also made|strong="H06213"\w* \w the sacred|strong="H06944"\w* \w anointing|strong="H04888"\w* \w oil|strong="H08081"\w* \w and the pure|strong="H02889"\w*, \w fragrant|strong="H05561"\w* \w incense|strong="H07004"\w*, \w the work of a perfumer|strong="H07543"\w*.
\c 38
\s1 The Bronze Altar
\r (Exodus 27:1–8)
\p \v 1 \w Bezalel constructed|strong="H06213"\w*\f + \fr 38:1 \ft Literally \fqa He constructed\f* \w the altar|strong="H04196"\w* \w of burnt offering|strong="H05930"\w* \w from acacia|strong="H07848"\w* \w wood|strong="H06086"\w*. \w It was square|strong="H07251"\w*, \w five|strong="H02568"\w* \w cubits|strong="H00520"\w* \w long|strong="H00753"\w*, \w five|strong="H02568"\w* \w cubits|strong="H00520"\w* \w wide|strong="H07341"\w*, \w and three|strong="H07969"\w* \w cubits|strong="H00520"\w* \w high|strong="H06967"\w*.\f + \fr 38:1 \ft The altar was approximately 7.5 feet in length and width, and 4.5 feet high (2.3 meters in length and width, and 1.4 meters high).\f* \v 2 \w He made|strong="H06213"\w* \w a horn|strong="H07161"\w* \w at each of|strong="H05921"\w* \w its four|strong="H00702"\w* \w corners|strong="H06438"\w*, \w so that the horns and altar|strong="H07161"\w* \w were|strong="H01961"\w* \w of one piece|strong="H04480"\w*, \w and he overlaid|strong="H06823"\w* \w the altar with bronze|strong="H05178"\w*.
\p \v 3 \w He made|strong="H06213"\w* \w all|strong="H03605"\w* \w the altar’s|strong="H04196"\w* \w utensils|strong="H03627"\w* \w of bronze|strong="H05178"\w* — \w its pots|strong="H05518"\w*, \w shovels|strong="H03257"\w*, \w sprinkling bowls|strong="H04219"\w*, \w meat forks|strong="H04207"\w*, \w and firepans|strong="H04289"\w*. \v 4 \w He made|strong="H06213"\w* \w a grate|strong="H04345"\w* \w of bronze|strong="H05178"\w* \w mesh|strong="H07568"\w* \w for the altar|strong="H04196"\w* \w under|strong="H08478"\w* \w its ledge|strong="H03749"\w*, \w halfway|strong="H02677"\w* \w up from the bottom|strong="H04295"\w*.
\p \v 5 \w At the four|strong="H00702"\w* \w corners|strong="H07117"\w* \w of the bronze|strong="H05178"\w* \w grate|strong="H04345"\w* \w he cast|strong="H03332"\w* \w four|strong="H00702"\w* \w rings|strong="H02885"\w* \w as holders|strong="H01004"\w* \w for the poles|strong="H00905"\w*. \v 6 \w And he made|strong="H06213"\w* \w the poles|strong="H00905"\w* \w of acacia|strong="H07848"\w* \w wood|strong="H06086"\w* \w and overlaid|strong="H06823"\w* \w them|strong="H00853"\w* \w with bronze|strong="H05178"\w*. \v 7 \w Then he inserted|strong="H00935"\w* \w the poles|strong="H00905"\w* \w into the rings|strong="H02885"\w* \w on|strong="H05921"\w* \w the sides|strong="H06763"\w* \w of the altar|strong="H04196"\w* \w for carrying|strong="H05375"\w* \w it|strong="H00853"\w*. \w He made|strong="H06213"\w* \w the altar|strong="H00853"\w* \w with boards|strong="H03871"\w* \w so that it was hollow|strong="H05014"\w*.
\s1 The Bronze Basin
\r (Exodus 30:17–21)
\p \v 8 \w Next he made|strong="H06213"\w* \w the bronze|strong="H05178"\w* \w basin|strong="H03595"\w* \w and its stand|strong="H03653"\w* \w from the mirrors|strong="H04759"\w* \w of the women who|strong="H00834"\w* \w served|strong="H06633"\w* \w at the entrance|strong="H06607"\w* \w to the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*.
\s1 The Courtyard
\r (Exodus 27:9–19)
\p \v 9 \w Then he constructed|strong="H06213"\w* \w the courtyard|strong="H02691"\w*. \w The south|strong="H05045"\w* \w side|strong="H06285"\w* \w of the courtyard|strong="H02691"\w* \w was a hundred|strong="H03967"\w* \w cubits long|strong="H00520"\w*\f + \fr 38:9 \fqa 100 cubits \ft is approximately 150 feet or 45.7 meters.\f* \w and had curtains|strong="H07050"\w* \w of finely spun|strong="H07806"\w* \w linen|strong="H08336"\w*, \v 10 \w with twenty|strong="H06242"\w* \w posts|strong="H05982"\w* \w and twenty|strong="H06242"\w* \w bronze|strong="H05178"\w* \w bases|strong="H00134"\w*, \w and with silver|strong="H03701"\w* \w hooks|strong="H02053"\w* \w and bands|strong="H02838"\w* \w on the posts|strong="H05982"\w*. \v 11 \w The north|strong="H06828"\w* \w side|strong="H06285"\w* \w was also a hundred|strong="H03967"\w* \w cubits long|strong="H00520"\w*, \w with twenty|strong="H06242"\w* \w posts|strong="H05982"\w* \w and twenty|strong="H06242"\w* \w bronze|strong="H05178"\w* \w bases|strong="H00134"\w*. \w The hooks|strong="H02053"\w* \w and bands|strong="H02838"\w* \w of the posts|strong="H05982"\w* \w were silver|strong="H03701"\w*. \v 12 \w The west|strong="H03220"\w* \w side|strong="H06285"\w* \w was fifty|strong="H02572"\w* \w cubits long|strong="H00520"\w*\f + \fr 38:12 \fqa 50 cubits \ft is approximately 75 feet or 22.9 meters.\f* \w and had curtains|strong="H07050"\w*, \w with ten|strong="H06235"\w* \w posts|strong="H05982"\w* \w and ten|strong="H06235"\w* \w bases|strong="H00134"\w*. \w The hooks|strong="H02053"\w* \w and bands|strong="H02838"\w* \w of the posts|strong="H05982"\w* \w were silver|strong="H03701"\w*. \v 13 \w And the east|strong="H06924"\w* \w side|strong="H06285"\w*, \w toward the sunrise|strong="H04217"\w*, \w was also fifty|strong="H02572"\w* \w cubits long|strong="H00520"\w*.
\p \v 14 \w The curtains|strong="H07050"\w* \w on|strong="H00413"\w* \w one side|strong="H03802"\w* \w of the entrance were fifteen|strong="H02568"\w* \w cubits long|strong="H00520"\w*,\f + \fr 38:14 \fqa 15 cubits \ft is approximately 22.5 feet or 6.9 meters.\f* \w with three|strong="H07969"\w* \w posts|strong="H05982"\w* \w and three|strong="H07969"\w* \w bases|strong="H00134"\w*. \v 15 \w And the curtains|strong="H07050"\w* \w on the other|strong="H08145"\w* \w side|strong="H03802"\w* \w were also fifteen|strong="H02568"\w* \w cubits long|strong="H00520"\w*, \w with three|strong="H07969"\w* \w posts|strong="H05982"\w* \w and three|strong="H07969"\w* \w bases|strong="H00134"\w* \w as well|strong="H02088"\w*. \v 16 \w All|strong="H03605"\w* \w the curtains|strong="H07050"\w* \w around|strong="H05439"\w* \w the courtyard|strong="H02691"\w* \w were made of finely spun|strong="H07806"\w* \w linen|strong="H08336"\w*. \v 17 \w The bases|strong="H00134"\w* \w for the posts|strong="H05982"\w* \w were bronze|strong="H05178"\w*, \w the hooks|strong="H02053"\w* \w and bands|strong="H02838"\w* \w were silver|strong="H03701"\w*, \w and the plating|strong="H06826"\w* \w for the tops|strong="H07218"\w* \w of the posts was silver|strong="H03701"\w*. \w So all|strong="H03605"\w* \w the posts|strong="H05982"\w* \w of the courtyard|strong="H02691"\w* \w were banded|strong="H02836"\w* \w with silver|strong="H03701"\w*.
\p \v 18 \w The curtain|strong="H04539"\w* \w for the entrance|strong="H08179"\w* \w to the courtyard|strong="H02691"\w* \w was embroidered|strong="H07551"\w* \w with blue|strong="H08504"\w*, \w purple|strong="H00713"\w*, \w and scarlet yarn|strong="H08438"\w*, \w and finely spun|strong="H07806"\w* \w linen|strong="H08336"\w*. \w It was twenty|strong="H06242"\w* \w cubits|strong="H00520"\w* \w long|strong="H00753"\w*\f + \fr 38:18 \fqa 20 cubits \ft is approximately 30 feet or 9.1 meters.\f* \w and, like|strong="H05980"\w* \w the curtains|strong="H07050"\w* \w of the courtyard|strong="H02691"\w*, \w five|strong="H02568"\w* \w cubits|strong="H00520"\w* \w high|strong="H06967"\w*,\f + \fr 38:18 \fqa 5 cubits \ft is approximately 7.5 feet or 2.3 meters.\f* \v 19 \w with four|strong="H00702"\w* \w posts|strong="H05982"\w* \w and four|strong="H00702"\w* \w bronze|strong="H05178"\w* \w bases|strong="H00134"\w*. \w Their hooks|strong="H02053"\w* \w were silver|strong="H03701"\w*, \w as well as the bands|strong="H02838"\w* \w and the plating|strong="H06826"\w* \w of their tops|strong="H07218"\w*. \v 20 \w All|strong="H03605"\w* \w the tent pegs|strong="H03489"\w* \w for the tabernacle|strong="H04908"\w* \w and for the surrounding|strong="H05439"\w* \w courtyard|strong="H02691"\w* \w were bronze|strong="H05178"\w*.
\s1 An Inventory of Materials
\r (Ezra 2:68–70; Nehemiah 7:70–73)
\p \v 21 \w This|strong="H00428"\w* \w is the inventory|strong="H06485"\w* \w for the tabernacle|strong="H04908"\w*, \w the tabernacle|strong="H04908"\w* \w of the Testimony|strong="H05715"\w*, \w as|strong="H00834"\w* \w recorded|strong="H06485"\w* \w at|strong="H05921"\w* \w Moses’|strong="H04872"\w* \w command|strong="H06310"\w* \w by|strong="H05656"\w* \w the Levites|strong="H03881"\w* \w under the direction|strong="H03027"\w* \w of Ithamar|strong="H00385"\w* \w son|strong="H01121"\w* \w of Aaron|strong="H00175"\w* \w the priest|strong="H03548"\w*. \v 22 \w Bezalel|strong="H01212"\w* \w son|strong="H01121"\w* \w of Uri|strong="H00221"\w*, \w the son|strong="H01121"\w* \w of Hur|strong="H02354"\w*, \w of the tribe|strong="H04294"\w* \w of Judah|strong="H03063"\w*, \w made|strong="H06213"\w* \w everything|strong="H03605"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had commanded|strong="H06680"\w* \w Moses|strong="H04872"\w*. \v 23 \w With him was|strong="H00854"\w* \w Oholiab|strong="H00171"\w* \w son|strong="H01121"\w* \w of Ahisamach|strong="H00294"\w*, \w of the tribe|strong="H04294"\w* \w of Dan|strong="H01835"\w*, \w an engraver|strong="H02796"\w*, \w designer|strong="H02803"\w*, \w and embroiderer|strong="H07551"\w* \w in blue|strong="H08504"\w*, \w purple|strong="H00713"\w*, \w and scarlet yarn|strong="H08438"\w* \w and fine linen|strong="H08336"\w*.
\p \v 24 \w All|strong="H03605"\w* \w the gold|strong="H02091"\w* \w from the wave offering|strong="H08573"\w* \w used|strong="H06213"\w* \w for the work|strong="H04399"\w* \w on the sanctuary|strong="H06944"\w* \w totaled|strong="H01961"\w* \w 29|strong="H08672"\w* \w talents|strong="H03603"\w* \w and 730|strong="H07651"\w* \w shekels|strong="H08255"\w*,\f + \fr 38:24 \ft The total weight of the gold was approximately 1.1 tons or 1 metric ton.\f* \w according to the sanctuary|strong="H06944"\w* \w shekel|strong="H08255"\w*.
\p \v 25 \w The silver|strong="H03701"\w* \w from those numbered|strong="H06485"\w* \w among the congregation|strong="H05712"\w* \w totaled 100|strong="H03967"\w* \w talents|strong="H03603"\w* \w and 1,775|strong="H00505"\w* \w shekels|strong="H08255"\w*,\f + \fr 38:25 \ft The total weight of the silver was approximately 3.79 tons or 3.44 metric tons.\f* \w according to the sanctuary|strong="H06944"\w* \w shekel|strong="H08255"\w*— \v 26 \w a beka|strong="H01235"\w* \w per person|strong="H01538"\w*, \w that is, half|strong="H04276"\w* \w a shekel|strong="H08255"\w*,\f + \fr 38:26 \fqa A beka \ft is half a shekel, or approximately 0.2 ounces or 5.7 grams.\f* \w according to the sanctuary|strong="H06944"\w* \w shekel|strong="H08255"\w*, \w from everyone|strong="H03605"\w* \w twenty|strong="H06242"\w* \w years|strong="H08141"\w* \w of age|strong="H01121"\w* \w or older|strong="H04605"\w* \w who had crossed over|strong="H05674"\w* \w to|strong="H05921"\w* \w be numbered|strong="H06485"\w*, \w a total of 603,550|strong="H08337"\w* \w men|strong="H02572"\w*.
\p \v 27 \w The hundred|strong="H03967"\w* \w talents|strong="H03603"\w* \w of silver|strong="H03701"\w*\f + \fr 38:27 \fqa 100 talents \ft is approximately 3.77 tons or 3.42 metric tons of silver.\f* \w were|strong="H01961"\w* \w used to cast|strong="H03332"\w* \w the bases|strong="H00134"\w* \w of the sanctuary|strong="H06944"\w* \w and the bases|strong="H00134"\w* \w of the veil|strong="H06532"\w*— \w 100|strong="H03967"\w* \w bases|strong="H00134"\w* \w from the 100|strong="H03967"\w* \w talents|strong="H03603"\w*, \w one talent|strong="H03603"\w* \w per base|strong="H00134"\w*.
\p \v 28 \w With the 1,775 shekels|strong="H00505"\w* [of silver]\f + \fr 38:28 \fqa 1,775 shekels \ft is approximately 44.6 pounds or 20.2 kilograms of silver.\f* \w he made|strong="H06213"\w* \w the hooks|strong="H02053"\w* \w for the posts|strong="H05982"\w*, \w overlaid|strong="H06823"\w* \w their tops|strong="H07218"\w*, \w and supplied bands|strong="H02836"\w* \w for them|strong="H00853"\w*.
\p \v 29 \w The bronze|strong="H05178"\w* \w from the wave offering|strong="H08573"\w* \w totaled 70|strong="H07657"\w* \w talents|strong="H03603"\w* \w and 2,400|strong="H00505"\w* \w shekels|strong="H08255"\w*.\f + \fr 38:29 \ft The total weight of the bronze was approximately 2.67 tons or 2.42 metric tons.\f* \v 30 \w He used it to make|strong="H06213"\w* \w the bases|strong="H00134"\w* \w for the entrance|strong="H06607"\w* \w to the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*, \w the bronze|strong="H05178"\w* \w altar|strong="H04196"\w* \w and its bronze|strong="H05178"\w* \w grating|strong="H04345"\w*, \w all|strong="H03605"\w* \w the utensils|strong="H03627"\w* \w for the altar|strong="H04196"\w*, \v 31 \w the bases|strong="H00134"\w* \w for the surrounding|strong="H05439"\w* \w courtyard|strong="H02691"\w* \w and|strong="H00134"\w* \w its gate|strong="H08179"\w*, \w and|strong="H00853"\w* \w all|strong="H03605"\w* \w the tent pegs|strong="H03489"\w* \w for the tabernacle|strong="H04908"\w* \w and|strong="H03605"\w* \w its surrounding|strong="H05439"\w* \w courtyard|strong="H02691"\w*.
\c 39
\s1 The Ephod
\r (Exodus 28:6–14)
\p \v 1 \w From|strong="H04480"\w* \w the blue|strong="H08504"\w*, \w purple|strong="H00713"\w*, \w and scarlet yarn|strong="H08438"\w* \w they made|strong="H06213"\w* \w specially woven|strong="H08278"\w* \w garments|strong="H00899"\w* \w for ministry|strong="H08334"\w* \w in the sanctuary|strong="H06944"\w*, \w as well as the holy|strong="H06944"\w* \w garments|strong="H00899"\w* \w for Aaron|strong="H00175"\w*, \w just as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had commanded|strong="H06680"\w* \w Moses|strong="H04872"\w*.
\p \v 2 \w Bezalel made|strong="H06213"\w*\f + \fr 39:2 \ft Literally \fqa He made\f* \w the ephod|strong="H00646"\w* \w of finely spun|strong="H07806"\w* \w linen|strong="H08336"\w* \w embroidered with gold|strong="H02091"\w*, \w and with blue|strong="H08504"\w*, \w purple|strong="H00713"\w*, \w and scarlet yarn|strong="H08438"\w*. \v 3 \w They hammered out|strong="H07554"\w* \w thin sheets|strong="H06341"\w* \w of gold|strong="H02091"\w* \w and cut|strong="H07112"\w* \w threads from them|strong="H06616"\w* \w to interweave|strong="H06213"\w* \w with the blue|strong="H08504"\w*, \w purple|strong="H00713"\w*, \w and scarlet yarn|strong="H08438"\w*, \w and fine linen|strong="H08336"\w* — \w the work|strong="H04639"\w* \w of a skilled craftsman|strong="H02803"\w*. \v 4 \w They made|strong="H06213"\w* \w shoulder pieces|strong="H03802"\w* for the ephod, \w which were attached|strong="H02266"\w* \w at|strong="H05921"\w* \w two|strong="H08147"\w* \w of its corners|strong="H07098"\w*, \w so it could be fastened|strong="H02266"\w*. \v 5 \w And the skillfully woven waistband|strong="H02805"\w* \w of|strong="H05921"\w* \w the ephod|strong="H00642"\w* \w was of one piece with the ephod|strong="H04480"\w*, \w of the same|strong="H01931"\w* \w workmanship|strong="H04639"\w* — \w with gold|strong="H02091"\w*, \w with blue|strong="H08504"\w*, \w purple|strong="H00713"\w*, \w and scarlet yarn|strong="H08438"\w*, \w and with finely spun|strong="H07806"\w* \w linen|strong="H08336"\w*, \w just as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had commanded|strong="H06680"\w* \w Moses|strong="H04872"\w*.
\p \v 6 \w They mounted|strong="H06213"\w* \w the onyx|strong="H07718"\w* \w stones|strong="H00068"\w* \w in gold|strong="H02091"\w* \w filigree settings|strong="H04865"\w*, \w engraved|strong="H06605"\w* \w like a seal|strong="H02368"\w* \w with|strong="H05921"\w* \w the names|strong="H08034"\w* \w of the sons|strong="H01121"\w* \w of Israel|strong="H03478"\w*. \v 7 \w Then they fastened|strong="H07760"\w* \w them|strong="H00853"\w* \w on|strong="H05921"\w* \w the shoulder pieces|strong="H03802"\w* \w of the ephod|strong="H00646"\w* \w as memorial|strong="H02146"\w* \w stones|strong="H00068"\w* \w for the sons|strong="H01121"\w* \w of Israel|strong="H03478"\w*, \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had commanded|strong="H06680"\w* \w Moses|strong="H04872"\w*.
\s1 The Breastpiece
\r (Exodus 28:15–30)
\p \v 8 \w He made|strong="H06213"\w* \w the breastpiece|strong="H02833"\w* \w with the same workmanship|strong="H04639"\w* \w as the ephod|strong="H00646"\w*, \w with gold|strong="H02091"\w*, \w with blue|strong="H08504"\w*, \w purple|strong="H00713"\w*, \w and scarlet yarn|strong="H08438"\w*, \w and with finely spun|strong="H07806"\w* \w linen|strong="H08336"\w*. \v 9 \w It|strong="H06213"\w* \w was square|strong="H07251"\w* \w when folded over double|strong="H03717"\w*, \w a span|strong="H02239"\w* \w long|strong="H00753"\w* \w and a span|strong="H02239"\w* \w wide|strong="H07341"\w*.\f + \fr 39:9 \ft The breastpiece, when folded over, was approximately 9 inches or 22.9 centimeters in both length and width.\f*
\p \v 10 \w And they mounted|strong="H04390"\w* on it \w four|strong="H00702"\w* \w rows|strong="H02905"\w* \w of gemstones|strong="H00068"\w*:\f + \fr 39:10 \ft The precise identification of some of these gemstones is uncertain.\f*
\b 
\li1 \w The first|strong="H00259"\w* \w row had|strong="H02905"\w* \w a ruby|strong="H00124"\w*, \w a topaz|strong="H06357"\w*, \w and an emerald|strong="H01304"\w*;
\li1 \v 11 \w the second|strong="H08145"\w* \w row had|strong="H02905"\w* \w a turquoise|strong="H05306"\w*, \w a sapphire|strong="H05601"\w*, \w and a diamond|strong="H03095"\w*;
\li1 \v 12 \w the third|strong="H07992"\w* \w row had|strong="H02905"\w* \w a jacinth|strong="H03958"\w*, \w an agate|strong="H07618"\w*, \w and an amethyst|strong="H00306"\w*;
\li1 \v 13 \w and the fourth|strong="H07243"\w* \w row had|strong="H02905"\w* \w a beryl|strong="H08658"\w*, \w an onyx|strong="H07718"\w*, \w and a jasper|strong="H03471"\w*.
\p \w These stones were mounted|strong="H05437"\w* \w in gold|strong="H02091"\w* \w filigree|strong="H04865"\w* \w settings|strong="H04396"\w*.
\p \v 14 \w The twelve|strong="H08147"\w* \w stones|strong="H00068"\w* \w corresponded to|strong="H05921"\w* \w the names|strong="H08034"\w* \w of the sons|strong="H01121"\w* \w of Israel|strong="H03478"\w*. \w Each|strong="H00376"\w* \w stone was engraved|strong="H06603"\w* \w like a seal|strong="H02368"\w* \w with|strong="H05921"\w* \w the name|strong="H08034"\w* \w of one of the twelve|strong="H08147"\w* \w tribes|strong="H07626"\w*.
\p \v 15 \w For|strong="H05921"\w* \w the breastpiece|strong="H02833"\w* \w they made|strong="H06213"\w* \w braided|strong="H04639"\w* \w chains|strong="H05688"\w* \w like cords|strong="H01383"\w* \w of pure|strong="H02889"\w* \w gold|strong="H02091"\w*. \v 16 \w They also made|strong="H06213"\w* \w two|strong="H08147"\w* \w gold|strong="H02091"\w* \w filigree settings|strong="H04865"\w* \w and two|strong="H08147"\w* \w gold|strong="H02091"\w* \w rings|strong="H02885"\w*, \w and fastened|strong="H05414"\w* \w the two|strong="H08147"\w* \w rings|strong="H02885"\w* \w to|strong="H05921"\w* \w the two|strong="H08147"\w* \w corners|strong="H07098"\w* \w of the breastpiece|strong="H02833"\w*. \v 17 \w Then they fastened|strong="H05414"\w* \w the two|strong="H08147"\w* \w gold|strong="H02091"\w* \w chains|strong="H05688"\w* \w to|strong="H05921"\w* \w the two|strong="H08147"\w* \w gold rings|strong="H02885"\w* \w at|strong="H05921"\w* \w the corners|strong="H07098"\w* \w of the breastpiece|strong="H02833"\w*, \v 18 \w and|strong="H00853"\w* \w they fastened|strong="H05414"\w* \w the other|strong="H08147"\w* \w ends|strong="H07098"\w* \w of the two|strong="H08147"\w* \w chains|strong="H05688"\w* \w to|strong="H05921"\w* \w the two|strong="H08147"\w* \w filigree settings|strong="H04865"\w*, \w attaching them|strong="H05414"\w* \w to|strong="H05921"\w* \w the shoulder pieces|strong="H03802"\w* \w of the ephod|strong="H00646"\w* \w at|strong="H00413"\w* \w the front|strong="H04136"\w*.
\p \v 19 \w They made|strong="H06213"\w* \w two more|strong="H08147"\w* \w gold|strong="H02091"\w* \w rings|strong="H02885"\w* \w and attached them|strong="H07760"\w* \w to|strong="H05921"\w* \w the other two|strong="H08147"\w* \w corners|strong="H07098"\w* \w of the breastpiece|strong="H02833"\w*, \w on|strong="H05921"\w* \w the inside|strong="H01004"\w* \w edge|strong="H08193"\w* \w next to|strong="H00413"\w* \w the ephod|strong="H00646"\w*.
\p \v 20 \w They made|strong="H06213"\w* \w two additional|strong="H08147"\w* \w gold|strong="H02091"\w* \w rings|strong="H02885"\w* \w and attached them|strong="H05414"\w* \w to|strong="H05921"\w* \w the bottom|strong="H04295"\w* \w of the two|strong="H08147"\w* \w shoulder pieces|strong="H03802"\w* \w of the ephod|strong="H00646"\w*, \w on its front|strong="H04136"\w*, \w near|strong="H05980"\w* \w the seam|strong="H04225"\w* \w just above|strong="H04605"\w* \w its woven waistband|strong="H02805"\w*. \v 21 \w Then they tied|strong="H07405"\w* \w the rings|strong="H02885"\w* \w of the breastpiece|strong="H02833"\w* \w to|strong="H00413"\w* \w the rings|strong="H02885"\w* \w of the ephod|strong="H00646"\w* \w with a cord|strong="H06616"\w* \w of blue yarn|strong="H08504"\w*, \w so that the breastpiece|strong="H02833"\w* \w was|strong="H01961"\w* \w above|strong="H05921"\w* \w the waistband|strong="H02805"\w* \w of the ephod|strong="H00646"\w* \w and would not|strong="H03808"\w* \w swing out|strong="H02118"\w* \w from|strong="H05921"\w* \w the ephod|strong="H00646"\w*, \w just as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had commanded|strong="H06680"\w* \w Moses|strong="H04872"\w*.
\s1 Additional Priestly Garments
\r (Exodus 28:31–43)
\p \v 22 \w They made|strong="H06213"\w* \w the robe|strong="H04598"\w* \w of the ephod|strong="H00646"\w* \w entirely|strong="H03632"\w* \w of blue cloth|strong="H08504"\w*, \w the work|strong="H04639"\w* \w of a weaver|strong="H00707"\w*, \v 23 \w with an opening|strong="H06310"\w* \w in the center|strong="H08432"\w* \w of the robe|strong="H04598"\w* \w like that|strong="H06310"\w* \w of a garment|strong="H08473"\w*,\f + \fr 39:23 \ft The meaning of the Hebrew word is uncertain; possibly \fqa a coat of mail\ft .\f* \w with a collar|strong="H08193"\w* \w around|strong="H05439"\w* \w the opening|strong="H06310"\w* \w so that it would not|strong="H03808"\w* \w tear|strong="H07167"\w*.
\p \v 24 \w They made|strong="H06213"\w* \w pomegranates|strong="H07416"\w* \w of blue|strong="H08504"\w*, \w purple|strong="H00713"\w*, \w and scarlet yarn|strong="H08438"\w* \w and finely spun linen|strong="H07806"\w* \w on|strong="H05921"\w* \w the lower hem|strong="H07757"\w* \w of the robe|strong="H04598"\w*. \v 25 \w They also made|strong="H06213"\w* \w bells|strong="H06472"\w* \w of pure|strong="H02889"\w* \w gold|strong="H02091"\w* \w and attached|strong="H05414"\w* \w them|strong="H06472"\w* \w around|strong="H05439"\w* \w the hem|strong="H07757"\w* \w between|strong="H08432"\w* \w the pomegranates|strong="H07416"\w*, \v 26 \w alternating|strong="H05439"\w* \w the bells|strong="H06472"\w* \w and pomegranates|strong="H07416"\w* \w around the lower hem|strong="H07757"\w* \w of the robe|strong="H04598"\w* \w to be worn for ministry|strong="H08334"\w*, \w just as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had commanded|strong="H06680"\w* \w Moses|strong="H04872"\w*.
