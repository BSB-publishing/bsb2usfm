\p \v 4 \w Moses also|strong="H04872"\w* \w told|strong="H00559"\w* \w the whole|strong="H03605"\w* \w congregation|strong="H05712"\w* \w of Israel|strong="H03478"\w*, “\w This|strong="H02088"\w* \w is what|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w has commanded|strong="H06680"\w*: \v 5 \w Take|strong="H03947"\w* \w from among you|strong="H00854"\w* \w an offering|strong="H08641"\w* \w to the LORD|strong="H03068"\w*. \w Let everyone|strong="H03605"\w* \w whose heart|strong="H03820"\w* \w is willing|strong="H05081"\w* \w bring|strong="H00935"\w* \w an offering|strong="H08641"\w* \w to the LORD|strong="H03068"\w*:
