\p \v 37 \w Fasten|strong="H07760"\w* \w to it|strong="H05921"\w* \w a blue|strong="H08504"\w* \w cord|strong="H06616"\w* \w to mount it on|strong="H05921"\w* \w the turban|strong="H04701"\w*; \w it shall be|strong="H01961"\w* \w on|strong="H00413"\w* \w the front|strong="H04136"\w* \w of the turban|strong="H04701"\w*. \v 38 \w And it will be worn|strong="H01961"\w* \w on|strong="H05921"\w* \w Aaron’s|strong="H00175"\w* \w forehead|strong="H04696"\w*, \w so that he|strong="H00175"\w* \w may bear|strong="H05375"\w* \w the iniquity|strong="H05771"\w* \w of the holy things|strong="H06944"\w* \w that|strong="H00834"\w* \w the sons|strong="H01121"\w* \w of Israel|strong="H03478"\w* \w consecrate|strong="H06942"\w* \w with regard to all|strong="H03605"\w* \w their holy|strong="H06944"\w* \w gifts|strong="H04979"\w*. \w It shall always|strong="H08548"\w* \w be|strong="H01961"\w* \w on|strong="H05921"\w* \w his forehead|strong="H04696"\w*, \w so that they may be acceptable|strong="H07522"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*.
\p \v 39 \w You are to weave|strong="H07660"\w* \w the tunic|strong="H03801"\w* \w with fine linen|strong="H08336"\w*, \w make|strong="H06213"\w* \w the turban|strong="H04701"\w* \w of fine linen|strong="H08336"\w*, \w and fashion|strong="H06213"\w* \w an embroidered|strong="H07551"\w* \w sash|strong="H00073"\w*. \v 40 \w Make|strong="H06213"\w* \w tunics|strong="H03801"\w*, \w sashes|strong="H00073"\w*, \w and headbands|strong="H04021"\w* \w for Aaron’s|strong="H00175"\w* \w sons|strong="H01121"\w*, \w to give|strong="H06213"\w* them \w glory|strong="H03519"\w* \w and splendor|strong="H08597"\w*.
\p \v 41 \w After you put|strong="H03847"\w* \w these garments|strong="H00853"\w* \w on your brother|strong="H00251"\w* \w Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w*, \w anoint|strong="H04886"\w* \w them|strong="H00853"\w*, \w ordain|strong="H04390"\w* \w them|strong="H00853"\w*, \w and consecrate|strong="H06942"\w* \w them|strong="H00853"\w* \w so that they may serve Me as priests|strong="H03547"\w*.
\p \v 42 \w Make|strong="H06213"\w* \w linen|strong="H00906"\w* \w undergarments|strong="H04370"\w* \w to cover|strong="H03680"\w* their \w bare|strong="H06172"\w* \w flesh|strong="H01320"\w*, \w extending|strong="H01961"\w* \w from waist|strong="H04975"\w* \w to|strong="H05704"\w* \w thigh|strong="H03409"\w*. \v 43 \w Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w* \w must wear them|strong="H01961"\w* \w whenever they enter|strong="H00935"\w* \w the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w* \w or|strong="H00176"\w* \w approach|strong="H05066"\w* \w the altar|strong="H04196"\w* \w to minister|strong="H08334"\w* \w in the Holy Place|strong="H06944"\w*, \w so that they will not|strong="H03808"\w* \w incur|strong="H05375"\w* \w guilt|strong="H05771"\w* \w and die|strong="H04191"\w*. \w This is to be a permanent|strong="H05769"\w* \w statute|strong="H02708"\w* \w for Aaron|strong="H00310"\w* \w and his descendants|strong="H02233"\w*.[’’]
\c 29
\s1 Consecration of the Priests
\r (Leviticus 8:1–13)
\p \v 1 “\w Now this|strong="H02088"\w* \w is what|strong="H00834"\w* \w you are to do|strong="H06213"\w* \w to consecrate|strong="H06942"\w* \w Aaron and his sons|strong="H00853"\w* \w to serve Me as priests|strong="H03547"\w*: \w Take|strong="H03947"\w* \w a|strong="H00259"\w* \w young|strong="H01121"\w* \w bull|strong="H06499"\w* \w and two|strong="H08147"\w* \w rams|strong="H00352"\w* \w without blemish|strong="H08549"\w*, \v 2 \w along with unleavened|strong="H04682"\w* \w bread|strong="H03899"\w*, \w unleavened|strong="H04682"\w* \w cakes|strong="H02471"\w* \w mixed|strong="H01101"\w* \w with oil|strong="H08081"\w*, \w and unleavened|strong="H04682"\w* \w wafers|strong="H07550"\w* \w anointed|strong="H04886"\w* \w with oil|strong="H08081"\w*. \w Make|strong="H06213"\w* \w them|strong="H00853"\w* \w out of fine wheat|strong="H02406"\w* \w flour|strong="H05560"\w*, \v 3 \w put|strong="H05414"\w* \w them|strong="H00853"\w* \w in|strong="H05921"\w* \w a|strong="H00259"\w* \w basket|strong="H05536"\w*, \w and present|strong="H07126"\w* \w them|strong="H00853"\w* \w in the basket|strong="H05536"\w*, \w along with the bull|strong="H06499"\w* \w and the two|strong="H08147"\w* \w rams|strong="H00352"\w*.
\p \v 4 \w Then|strong="H00853"\w* \w present|strong="H07126"\w* \w Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w* \w at|strong="H00413"\w* \w the entrance|strong="H06607"\w* \w to the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w* \w and wash|strong="H07364"\w* \w them|strong="H00853"\w* \w with water|strong="H04325"\w*. \v 5 \w Take|strong="H03947"\w* \w the garments|strong="H00899"\w* \w and clothe|strong="H03847"\w* \w Aaron|strong="H00175"\w* \w with the tunic|strong="H03801"\w*, \w the robe|strong="H04598"\w* \w of the ephod|strong="H00646"\w*, \w the ephod itself|strong="H00646"\w*, \w and the breastplate|strong="H02833"\w*. \w Fasten|strong="H00640"\w* \w the ephod|strong="H00646"\w* on him \w with its woven waistband|strong="H02805"\w*. \v 6 \w Put|strong="H07760"\w* \w the turban|strong="H04701"\w* \w on|strong="H05921"\w* \w his head|strong="H07218"\w* \w and attach|strong="H05414"\w* \w the holy|strong="H06944"\w* \w diadem|strong="H05145"\w* \w to|strong="H05921"\w* \w the turban|strong="H04701"\w*. \v 7 \w Then take|strong="H03947"\w* \w the anointing|strong="H04888"\w* \w oil|strong="H08081"\w* \w and anoint him|strong="H04886"\w* \w by pouring|strong="H03332"\w* \w it on|strong="H05921"\w* \w his head|strong="H07218"\w*.
\p \v 8 \w Present|strong="H07126"\w* \w his sons|strong="H01121"\w* \w as well|strong="H00853"\w* \w and clothe them|strong="H03847"\w* \w with tunics|strong="H03801"\w*. \v 9 \w Wrap|strong="H02296"\w* \w the sashes|strong="H00073"\w* \w around Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w* \w and tie|strong="H02280"\w* \w headbands|strong="H04021"\w* on them. \w The priesthood|strong="H03550"\w* \w shall be|strong="H01961"\w* theirs \w by a permanent|strong="H05769"\w* \w statute|strong="H02708"\w*. \w In this way you are to ordain|strong="H04390"\w* \w Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w*.
\s1 The Order of the Sacrifices
\r (Leviticus 8:22–36)
\p \v 10 \w You are to present|strong="H07126"\w* \w the bull|strong="H06499"\w* \w at the front|strong="H06440"\w* \w of the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*, \w and Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w* \w are to lay|strong="H05564"\w* \w their hands|strong="H03027"\w* \w on|strong="H05921"\w* \w its|strong="H06499"\w* \w head|strong="H07218"\w*. \v 11 \w And you shall slaughter|strong="H07819"\w* \w the bull|strong="H06499"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w at the entrance|strong="H06607"\w* \w to the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*. \v 12 \w Take some|strong="H03947"\w* \w of the blood|strong="H01818"\w* \w of the bull|strong="H06499"\w* \w and put|strong="H05414"\w* \w it on|strong="H05921"\w* \w the horns|strong="H07161"\w* \w of the altar|strong="H04196"\w* \w with your finger|strong="H00676"\w*; \w then pour out|strong="H08210"\w* \w the rest|strong="H03605"\w* \w of the blood|strong="H01818"\w* \w at|strong="H00413"\w* \w the base|strong="H03247"\w* \w of the altar|strong="H04196"\w*. \v 13 \w Take|strong="H03947"\w* \w all|strong="H03605"\w* \w the fat|strong="H02459"\w* \w that covers|strong="H03680"\w* \w the entrails|strong="H07130"\w* \w and|strong="H00853"\w* \w the lobe|strong="H03508"\w* \w of|strong="H05921"\w* \w the liver|strong="H03516"\w*, \w and both|strong="H08147"\w* \w kidneys|strong="H03629"\w* \w with the fat|strong="H02459"\w* \w on them|strong="H05921"\w*, \w and burn them|strong="H06999"\w* \w on the altar|strong="H04196"\w*. \v 14 \w But|strong="H00853"\w* \w burn|strong="H08313"\w* \w the flesh|strong="H01320"\w* \w of the bull|strong="H06499"\w* \w and|strong="H00853"\w* \w its hide|strong="H05785"\w* \w and dung|strong="H06569"\w* \w outside|strong="H02351"\w* \w the camp|strong="H04264"\w*; \w it is|strong="H01931"\w* \w a sin offering|strong="H02403"\w*.\f + \fr 29:14 \ft Or \fqa purification offering\ft ; also in verse 36\f*
\p \v 15 \w Take|strong="H03947"\w* \w one|strong="H00259"\w* \w of the rams|strong="H00352"\w*, \w and Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w* \w shall lay|strong="H05564"\w* \w their hands|strong="H03027"\w* \w on|strong="H05921"\w* \w its|strong="H00352"\w* \w head|strong="H07218"\w*. \v 16 \w You are to slaughter|strong="H07819"\w* \w the ram|strong="H00352"\w*, \w take|strong="H03947"\w* \w its blood|strong="H01818"\w*, \w and splatter|strong="H02236"\w* \w it on|strong="H05921"\w* \w all sides|strong="H05439"\w* \w of the altar|strong="H04196"\w*. \v 17 \w Cut|strong="H05408"\w* \w the ram|strong="H00352"\w* \w into pieces|strong="H05409"\w*, \w wash|strong="H07364"\w* \w the entrails|strong="H07130"\w* \w and legs|strong="H03767"\w*, \w and place them|strong="H05414"\w* \w with|strong="H05921"\w* \w its head|strong="H07218"\w* \w and other pieces|strong="H05409"\w*. \v 18 \w Then burn|strong="H06999"\w* \w the entire|strong="H03605"\w* \w ram|strong="H00352"\w* \w on the altar|strong="H04196"\w*; \w it|strong="H01931"\w* \w is a burnt offering|strong="H05930"\w* \w to the LORD|strong="H03068"\w*, \w a pleasing|strong="H05207"\w* \w aroma|strong="H07381"\w*, \w a food offering|strong="H00801"\w* \w to the LORD|strong="H03068"\w*.
\p \v 19 \w Take|strong="H03947"\w* \w the second|strong="H08145"\w* \w ram|strong="H00352"\w*, \w and Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w* \w are to lay|strong="H05564"\w* \w their hands|strong="H03027"\w* \w on|strong="H05921"\w* \w its|strong="H00352"\w* \w head|strong="H07218"\w*. \v 20 \w Slaughter|strong="H07819"\w* \w the ram|strong="H00352"\w*, \w take|strong="H03947"\w* \w some of its blood|strong="H01818"\w*, \w and put|strong="H05414"\w* \w it on|strong="H05921"\w* \w the right earlobes|strong="H08571"\w* \w of Aaron|strong="H00175"\w* \w and|strong="H05921"\w* \w his sons|strong="H01121"\w*, \w on|strong="H05921"\w* \w the thumbs|strong="H00931"\w* \w of their right|strong="H03233"\w* \w hands|strong="H03027"\w*, \w and on|strong="H05921"\w* \w the big toes|strong="H00931"\w* \w of their right|strong="H03233"\w* \w feet|strong="H07272"\w*. \w Splatter|strong="H02236"\w* \w the remaining blood|strong="H01818"\w* \w on|strong="H05921"\w* \w all sides|strong="H05439"\w* \w of the altar|strong="H04196"\w*. \v 21 \w And take|strong="H03947"\w* \w some of|strong="H04480"\w* \w the blood|strong="H01818"\w* \w on|strong="H05921"\w* \w the altar|strong="H04196"\w* \w and some of the anointing|strong="H04888"\w* \w oil|strong="H08081"\w* \w and sprinkle|strong="H05137"\w* \w it on|strong="H05921"\w* \w Aaron|strong="H00175"\w* \w and his garments|strong="H00899"\w*, \w as well as on|strong="H05921"\w* \w his sons|strong="H01121"\w* \w and their garments|strong="H00899"\w*. \w Then he|strong="H01931"\w* \w and his garments|strong="H00899"\w* \w will be consecrated|strong="H06942"\w*, \w as well as his sons|strong="H01121"\w* \w and their|strong="H01121"\w* \w garments|strong="H00899"\w*.
\p \v 22 \w Take|strong="H03947"\w* \w the fat|strong="H02459"\w* \w from|strong="H04480"\w* \w the ram|strong="H00352"\w*, \w the fat tail|strong="H00451"\w*, \w the fat|strong="H02459"\w* \w covering|strong="H03680"\w* \w the entrails|strong="H07130"\w*, \w the lobe|strong="H03508"\w* \w of the liver|strong="H03516"\w*, \w both|strong="H08147"\w* \w kidneys|strong="H03629"\w* \w with the fat|strong="H02459"\w* \w on them|strong="H05921"\w*, \w and the right|strong="H03225"\w* \w thigh|strong="H07785"\w* \w (since|strong="H03588"\w* \w this|strong="H01931"\w* \w is a ram|strong="H00352"\w* \w for ordination)|strong="H04394"\w*, \v 23 \w along with one|strong="H00259"\w* \w loaf|strong="H03603"\w* \w of bread|strong="H03899"\w*, \w one|strong="H00259"\w* \w cake|strong="H02471"\w* \w of bread|strong="H03899"\w* \w made with oil|strong="H08081"\w*, \w and one|strong="H00259"\w* \w wafer|strong="H07550"\w* \w from the basket|strong="H05536"\w* \w of unleavened bread|strong="H04682"\w* \w that|strong="H00834"\w* \w is before|strong="H06440"\w* \w the LORD|strong="H03068"\w*. \v 24 \w Put|strong="H07760"\w* \w all these|strong="H03605"\w* \w in|strong="H05921"\w* \w the hands|strong="H03709"\w* \w of Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w* \w and wave|strong="H05130"\w* \w them|strong="H00853"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w as a wave offering|strong="H08573"\w*. \v 25 \w Then take|strong="H03947"\w* \w them|strong="H00853"\w* \w from their hands|strong="H03027"\w* \w and burn them|strong="H06999"\w* \w on the altar|strong="H04196"\w* \w atop|strong="H05921"\w* \w the burnt offering|strong="H05930"\w* \w as a pleasing|strong="H05207"\w* \w aroma|strong="H07381"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*; \w it|strong="H01931"\w* \w is a food offering|strong="H00801"\w* \w to the LORD|strong="H03068"\w*.
\p \v 26 \w Take|strong="H03947"\w* \w the breast|strong="H02373"\w* \w of the ram|strong="H00352"\w* \w of Aaron’s|strong="H00175"\w* \w ordination|strong="H04394"\w* \w and wave|strong="H05130"\w* \w it|strong="H00853"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w as a wave offering|strong="H08573"\w*, \w and it will be|strong="H01961"\w* your \w portion|strong="H04490"\w*. \v 27 \w Consecrate|strong="H06942"\w* \w for Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w* \w the breast|strong="H02373"\w* \w of the wave offering|strong="H08573"\w* \w that|strong="H00834"\w* \w is waved|strong="H05130"\w* \w and the thigh|strong="H07785"\w* \w of the heave offering|strong="H08641"\w* \w that|strong="H00834"\w* \w is lifted up|strong="H07311"\w* \w from the ram|strong="H00352"\w* \w of ordination|strong="H04394"\w*. \v 28 \w This will belong to|strong="H01961"\w* \w Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w* \w as a regular|strong="H05769"\w* \w portion|strong="H02706"\w* \w from the Israelites|strong="H01121"\w*, \w for|strong="H03588"\w* \w it|strong="H01931"\w* \w is the heave offering|strong="H08641"\w* \w the Israelites|strong="H01121"\w* \w will make|strong="H08641"\w* \w to the LORD|strong="H03068"\w* \w from their peace offerings|strong="H08002"\w*.
\p \v 29 \w The holy|strong="H06944"\w* \w garments|strong="H00899"\w* \w that|strong="H00834"\w* \w belong to Aaron|strong="H00175"\w* \w will belong|strong="H01961"\w* \w to his sons|strong="H01121"\w* \w after him|strong="H00310"\w*, \w so they can be anointed|strong="H04888"\w* \w and ordained|strong="H04390"\w* \w in them|strong="H03027"\w*. \v 30 \w The son|strong="H01121"\w* \w who|strong="H00834"\w* \w succeeds him|strong="H08478"\w* \w as priest|strong="H03548"\w* \w and enters|strong="H00935"\w* \w the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w* \w to minister|strong="H08334"\w* \w in the Holy Place|strong="H06944"\w* \w must wear them|strong="H03847"\w* \w for seven|strong="H07651"\w* \w days|strong="H03117"\w*.
\s1 Food for the Priests
\p \v 31 \w You are to take|strong="H03947"\w* \w the ram|strong="H00352"\w* \w of ordination|strong="H04394"\w* \w and boil|strong="H01310"\w* \w its flesh|strong="H01320"\w* \w in a holy|strong="H06918"\w* \w place|strong="H04725"\w*. \v 32 \w At the entrance|strong="H06607"\w* \w to the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*, \w Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w* \w are to eat|strong="H00398"\w* \w the meat|strong="H01320"\w* \w of the ram|strong="H00352"\w* \w and the bread|strong="H03899"\w* \w that is|strong="H00834"\w* \w in the basket|strong="H05536"\w*. \v 33 \w They must eat|strong="H00398"\w* \w those things by which|strong="H00834"\w* \w atonement was made|strong="H03722"\w* \w for their ordination|strong="H04390"\w* \w and consecration|strong="H06942"\w*. \w But no|strong="H03808"\w* \w outsider|strong="H02114"\w* \w may eat them|strong="H00398"\w*, \w because|strong="H03588"\w* \w these|strong="H01992"\w* \w things are sacred|strong="H06944"\w*. \v 34 \w And if|strong="H00518"\w* \w any of|strong="H04480"\w* \w the meat|strong="H01320"\w* \w of ordination|strong="H04394"\w* \w or any bread|strong="H03899"\w* \w is left|strong="H03498"\w* \w until|strong="H05704"\w* \w the morning|strong="H01242"\w*, \w you are to burn up|strong="H08313"\w* \w the remainder|strong="H03498"\w*. \w It must not|strong="H03808"\w* \w be eaten|strong="H00398"\w*, \w because|strong="H03588"\w* \w it|strong="H01931"\w* \w is sacred|strong="H06944"\w*.
\p \v 35 \w This is what|strong="H03602"\w* \w you are to do|strong="H06213"\w* \w for Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w* \w based on all|strong="H03605"\w* \w that|strong="H00834"\w* \w I have commanded|strong="H06680"\w* \w you|strong="H00853"\w*, \w taking seven|strong="H07651"\w* \w days|strong="H03117"\w* \w to ordain|strong="H04390"\w* \w them|strong="H03027"\w*. \v 36 \w Sacrifice|strong="H06213"\w* \w a bull|strong="H06499"\w* \w as a sin offering|strong="H02403"\w* \w each day|strong="H03117"\w* \w for|strong="H05921"\w* \w atonement|strong="H03725"\w*. \w Purify|strong="H02398"\w* \w the altar|strong="H04196"\w* \w by making atonement|strong="H03722"\w* \w for it|strong="H05921"\w*, \w and anoint|strong="H04886"\w* \w it|strong="H00853"\w* \w to consecrate it|strong="H06942"\w*. \v 37 \w For seven|strong="H07651"\w* \w days|strong="H03117"\w* \w you shall make atonement|strong="H03722"\w* \w for|strong="H05921"\w* \w the altar|strong="H04196"\w* \w and consecrate|strong="H06942"\w* \w it|strong="H00853"\w*. \w Then the altar|strong="H04196"\w* \w will become|strong="H01961"\w* \w most holy|strong="H06944"\w*; \w whatever|strong="H03605"\w* \w touches|strong="H05060"\w* \w the altar|strong="H04196"\w* \w will be holy|strong="H06942"\w*.
\s1 The Daily Offerings
\r (Numbers 28:1–8)
\p \v 38 \w This|strong="H02088"\w* \w is what|strong="H00834"\w* \w you are to offer|strong="H06213"\w* \w regularly|strong="H08548"\w* \w on|strong="H05921"\w* \w the altar|strong="H04196"\w*, \w each day|strong="H03117"\w*: \w two|strong="H08147"\w* \w lambs|strong="H03532"\w* \w that are a year old|strong="H01121"\w*. \v 39 \w Offer|strong="H06213"\w* \w one|strong="H00259"\w* \w lamb|strong="H03532"\w* \w in the morning|strong="H01242"\w* \w and the other|strong="H08145"\w* \w at|strong="H00996"\w* \w twilight|strong="H06153"\w*.\f + \fr 29:39 \ft Hebrew \fqa between the two evenings\ft ; also in verse 41\f* \v 40 \w With the first|strong="H00259"\w* \w lamb|strong="H03532"\w* \w offer a tenth of an ephah|strong="H06241"\w* \w of fine flour|strong="H05560"\w*,\f + \fr 29:40 \fqa A tenth of an ephah \ft is approximately 2 dry quarts or 2.2 liters (probably about 2.6 pounds or 1.2 kilograms of flour).\f* \w mixed|strong="H01101"\w* \w with a quarter|strong="H07253"\w* \w hin|strong="H01969"\w* \w of oil|strong="H08081"\w* \w from pressed olives|strong="H03795"\w*,\f + \fr 29:40 \ft Hebrew \fqa a quarter hin of pressed oil\ft ; that is, approximately 0.97 quarts or 0.92 liters\f* \w and a drink offering|strong="H05262"\w* \w of a quarter|strong="H07243"\w* \w hin|strong="H01969"\w* \w of wine|strong="H03196"\w*. \v 41 \w And|strong="H00853"\w* \w offer|strong="H06213"\w* \w the second|strong="H08145"\w* \w lamb|strong="H03532"\w* \w at|strong="H00996"\w* \w twilight|strong="H06153"\w* \w with|strong="H06213"\w* the same \w grain offering|strong="H04503"\w* \w and drink offering|strong="H05262"\w* \w as in the morning|strong="H01242"\w*, \w as a pleasing|strong="H05207"\w* \w aroma|strong="H07381"\w*, \w a food offering|strong="H00801"\w* \w to the LORD|strong="H03068"\w*.
\p \v 42 \w For the generations to come|strong="H01755"\w*, \w this burnt offering|strong="H05930"\w* \w shall be made regularly|strong="H08548"\w* \w at the entrance|strong="H06607"\w* \w to the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*, \w where|strong="H00834"\w* \w I will meet|strong="H03259"\w* you \w to speak|strong="H01696"\w* \w with you|strong="H00413"\w*. \v 43 \w I will also meet|strong="H03259"\w* \w with the Israelites|strong="H01121"\w* \w there|strong="H08033"\w*, \w and that place will be consecrated|strong="H06942"\w* \w by My glory|strong="H03519"\w*. \v 44 \w So I will consecrate|strong="H06942"\w* \w the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w* \w and the altar|strong="H04196"\w*, \w and I will consecrate|strong="H06942"\w* \w Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w* \w to serve Me as priests|strong="H03547"\w*.
\s1 God Will Dwell among the People
\p \v 45 \w Then I will dwell|strong="H07931"\w* \w among|strong="H08432"\w* \w the Israelites|strong="H01121"\w* \w and be|strong="H01961"\w* their \w God|strong="H00430"\w*. \v 46 \w And they will know|strong="H03045"\w* \w that|strong="H03588"\w* \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w* \w their God|strong="H00430"\w*, \w who|strong="H00834"\w* \w brought them out|strong="H03318"\w* \w of the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w* \w so that I might dwell|strong="H07931"\w* \w among them|strong="H08432"\w*.
\p \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w* \w their God|strong="H00430"\w*.[’’]
\c 30
\s1 The Altar of Incense
\r (Exodus 37:25–29)
\p \v 1 “\w You are also to make|strong="H06213"\w* \w an altar|strong="H04196"\w* \w of acacia|strong="H07848"\w* \w wood|strong="H06086"\w* \w for the burning|strong="H04729"\w* \w of incense|strong="H07004"\w*. \v 2 \w It is to be|strong="H01961"\w* \w square|strong="H07251"\w*, \w a cubit|strong="H00520"\w* \w long|strong="H00753"\w*, \w a cubit|strong="H00520"\w* \w wide|strong="H07341"\w*, \w and two cubits|strong="H00520"\w* \w high|strong="H06967"\w*.\f + \fr 30:2 \ft The altar was approximately 1.5 feet in length and width, and 3 feet high (45.7 centimeters in length and width, and 91.4 centimeters high).\f* \w Its horns|strong="H07161"\w* \w must be of one piece|strong="H04480"\w*. \v 3 \w Overlay|strong="H06823"\w* \w with pure|strong="H02889"\w* \w gold|strong="H02091"\w* \w the top|strong="H01406"\w* \w and all|strong="H05439"\w* \w the sides|strong="H07023"\w* \w and horns|strong="H07161"\w*, \w and make|strong="H06213"\w* \w a molding|strong="H02213"\w* \w of gold|strong="H02091"\w* \w around it|strong="H05439"\w*. \v 4 \w And make|strong="H06213"\w* \w two|strong="H08147"\w* \w gold|strong="H02091"\w* \w rings|strong="H02885"\w* \w below|strong="H08478"\w* \w the molding|strong="H02213"\w* \w on|strong="H05921"\w* \w opposite sides|strong="H06654"\w* \w to|strong="H01961"\w* \w hold|strong="H01004"\w* \w the poles|strong="H00905"\w* \w used to carry it|strong="H05375"\w*. \v 5 \w Make|strong="H06213"\w* \w the poles|strong="H00905"\w* \w of acacia|strong="H07848"\w* \w wood|strong="H06086"\w* \w and overlay|strong="H06823"\w* \w them|strong="H00853"\w* \w with gold|strong="H02091"\w*.
\p \v 6 \w Place|strong="H05414"\w* \w the altar|strong="H00853"\w* \w in front|strong="H06440"\w* \w of the veil|strong="H06532"\w* \w that|strong="H00834"\w* \w is before|strong="H05921"\w* \w the ark|strong="H00727"\w* \w of the Testimony|strong="H05715"\w*\f + \fr 30:6 \ft That is, \fqa the ark of the covenant\ft ; also in verse 26\f*— \w before|strong="H06440"\w* \w the mercy seat|strong="H03727"\w* \w that|strong="H00834"\w* \w is over|strong="H05921"\w* \w the Testimony|strong="H05715"\w*— \w where|strong="H00834"\w* \w I will meet|strong="H03259"\w* with you. \v 7 \w And Aaron|strong="H00175"\w* \w is to burn|strong="H06999"\w* \w fragrant|strong="H05561"\w* \w incense|strong="H07004"\w* \w on it|strong="H05921"\w* \w every morning|strong="H01242"\w* \w when he tends|strong="H03190"\w* \w the lamps|strong="H05216"\w*. \v 8 \w When Aaron|strong="H00175"\w* \w sets up|strong="H05927"\w* \w the lamps|strong="H05216"\w* \w at|strong="H00996"\w* \w twilight|strong="H06153"\w*,\f + \fr 30:8 \ft Hebrew \fqa between the two evenings\f* \w he must burn|strong="H06999"\w* \w the incense|strong="H07004"\w* \w perpetually|strong="H08548"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w for the generations to come|strong="H01755"\w*. \v 9 \w On this altar|strong="H05921"\w* \w you must not|strong="H03808"\w* \w offer|strong="H05927"\w* \w unauthorized|strong="H02114"\w*\f + \fr 30:9 \ft Or \fqa strange\f* \w incense|strong="H07004"\w* \w or a burnt offering|strong="H05930"\w* \w or grain offering|strong="H04503"\w*; \w nor are you|strong="H03808"\w* \w to pour|strong="H05258"\w* \w a drink offering|strong="H05262"\w* \w on it|strong="H05921"\w*.
\p \v 10 \w Once|strong="H00259"\w* \w a year|strong="H08141"\w* \w Aaron|strong="H00175"\w* \w shall make atonement|strong="H03722"\w* \w on|strong="H05921"\w* \w the horns of the altar|strong="H07161"\w*. \w Throughout your generations|strong="H01755"\w* \w he shall make atonement|strong="H03722"\w* \w on it|strong="H05921"\w* \w annually|strong="H00259"\w* \w with the blood|strong="H01818"\w* \w of the sin offering|strong="H02403"\w*\f + \fr 30:10 \ft Or \fqa purification offering\f* \w of atonement|strong="H03725"\w*. \w The altar is|strong="H01931"\w* \w most|strong="H06944"\w* \w holy|strong="H06944"\w* \w to the LORD|strong="H03068"\w*.”
\s1 The Census Offering
\r (2 Samuel 24:1–9; 1 Chronicles 21:1–6)
\p \v 11 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*, \v 12 “\w When|strong="H03588"\w* \w you take a census|strong="H05375"\w* \w of the Israelites|strong="H03478"\w* \w to number them|strong="H06485"\w*, \w each man|strong="H00376"\w* \w must pay|strong="H05414"\w* \w the LORD|strong="H03068"\w* \w a ransom|strong="H03724"\w* \w for his life|strong="H05315"\w* \w when he is counted|strong="H06485"\w*. \w Then no|strong="H03808"\w* \w plague|strong="H05063"\w* \w will come|strong="H01961"\w* upon them \w when they are numbered|strong="H06485"\w*. \v 13 \w Everyone|strong="H03605"\w* \w who crosses|strong="H05674"\w* \w over|strong="H05921"\w* \w to those counted|strong="H06485"\w* \w must pay|strong="H05414"\w* \w a half|strong="H04276"\w* \w shekel|strong="H08255"\w*,\f + \fr 30:13 \fqa A half shekel \ft is approximately 0.2 ounces or 5.7 grams; also in verse 15.\f* \w according to the sanctuary|strong="H06944"\w* \w shekel|strong="H08255"\w*, \w which weighs|strong="H08255"\w* \w twenty|strong="H06242"\w* \w gerahs|strong="H01626"\w*.\f + \fr 30:13 \fqa 20 gerahs \ft is equivalent to one shekel (approximately 0.4 ounces or 11.4 grams).\f* \w This half|strong="H04276"\w* \w shekel|strong="H08255"\w* \w is an offering|strong="H08641"\w* \w to the LORD|strong="H03068"\w*.
\p \v 14 \w Everyone|strong="H03605"\w* \w twenty years|strong="H06242"\w* \w of age|strong="H01121"\w* \w or older|strong="H04605"\w* \w who crosses|strong="H05674"\w* \w over|strong="H05921"\w* \w must give|strong="H05414"\w* \w this offering|strong="H08641"\w* \w to the LORD|strong="H03068"\w*. \v 15 \w In making|strong="H05414"\w* \w the offering|strong="H08641"\w* \w to the LORD|strong="H03068"\w* \w to atone|strong="H03722"\w* \w for|strong="H05921"\w* \w your lives|strong="H05315"\w*, \w the rich|strong="H06223"\w* \w shall not|strong="H03808"\w* \w give more|strong="H07235"\w* \w than a half|strong="H04276"\w* \w shekel|strong="H08255"\w*, \w nor shall|strong="H03808"\w* \w the poor|strong="H01800"\w* \w give less|strong="H04591"\w*. \v 16 \w Take|strong="H03947"\w* \w the atonement|strong="H03725"\w* \w money|strong="H03701"\w* \w from the Israelites|strong="H01121"\w* \w and use|strong="H05414"\w* \w it for|strong="H05921"\w* \w the service|strong="H05656"\w* \w of the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*. \w It will serve as|strong="H01961"\w* \w a memorial|strong="H02146"\w* \w for the Israelites|strong="H01121"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w to make atonement|strong="H03722"\w* \w for|strong="H05921"\w* \w your lives|strong="H05315"\w*.”
\s1 The Bronze Basin
\r (Exodus 38:8)
\p \v 17 \w And the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*, \v 18 “\w You are to make|strong="H06213"\w* \w a bronze|strong="H05178"\w* \w basin|strong="H03595"\w* \w with a bronze|strong="H05178"\w* \w stand|strong="H03653"\w* \w for washing|strong="H07364"\w*. \w Set|strong="H05414"\w* \w it between|strong="H00996"\w* \w the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w* \w and the altar|strong="H04196"\w*, \w and put|strong="H05414"\w* \w water|strong="H04325"\w* \w in it|strong="H08033"\w*, \v 19 \w with which|strong="H04480"\w* \w Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w* \w are to wash|strong="H07364"\w* \w their hands|strong="H03027"\w* \w and feet|strong="H07272"\w*. \v 20 \w Whenever they enter|strong="H00935"\w* \w the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w* \w or|strong="H00176"\w* \w approach|strong="H05066"\w* \w the altar|strong="H04196"\w* \w to minister|strong="H08334"\w* \w by presenting|strong="H06999"\w* \w a food offering|strong="H00801"\w* \w to the LORD|strong="H03068"\w*, \w they must wash|strong="H07364"\w* \w with water|strong="H04325"\w* \w so that they will not|strong="H03808"\w* \w die|strong="H04191"\w*. \v 21 \w Thus they are to wash|strong="H07364"\w* \w their hands|strong="H03027"\w* \w and feet|strong="H07272"\w* \w so that they will not|strong="H03808"\w* \w die|strong="H04191"\w*; \w this shall be|strong="H01961"\w* \w a permanent|strong="H05769"\w* \w statute|strong="H02706"\w* \w for Aaron and his descendants|strong="H02233"\w* \w for the generations to come|strong="H01755"\w*.”
\s1 The Anointing Oil
\p \v 22 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*, \v 23 “\w Take|strong="H03947"\w* \w the finest|strong="H07218"\w* \w spices|strong="H01314"\w*: \w 500 shekels|strong="H02568"\w* \w of liquid|strong="H01865"\w* \w myrrh|strong="H04753"\w*,\f + \fr 30:23 \fqa 500 shekels \ft is approximately 12.6 pounds or 5.7 kilograms of myrrh.\f* \w half that amount|strong="H04276"\w* \w (250 shekels)|strong="H02572"\w* \w of fragrant|strong="H01314"\w* \w cinnamon|strong="H07076"\w*,\f + \fr 30:23 \fqa 250 shekels \ft is approximately 6.3 pounds or 2.9 kilograms of cinnamon.\f* \w 250 shekels|strong="H02572"\w* \w of fragrant|strong="H01314"\w* \w cane|strong="H07070"\w*,\f + \fr 30:23 \fqa 250 shekels \ft is approximately 6.3 pounds or 2.9 kilograms of cane.\f* \v 24 \w 500 shekels|strong="H02568"\w* \w of cassia|strong="H06916"\w*\f + \fr 30:24 \fqa 500 shekels \ft is approximately 12.6 pounds or 5.7 kilograms of cassia.\f* — \w all according to the sanctuary|strong="H06944"\w* \w shekel|strong="H08255"\w* — \w and a hin|strong="H01969"\w* \w of olive|strong="H02132"\w* \w oil|strong="H08081"\w*.\f + \fr 30:24 \fqa A hin \ft is approximately 0.97 gallons or 3.67 liters of olive oil.\f* \v 25 \w Prepare|strong="H06213"\w* \w from these a sacred|strong="H06944"\w* \w anointing|strong="H04888"\w* \w oil|strong="H08081"\w*, \w a fragrant blend|strong="H07545"\w*, \w the work|strong="H04639"\w* \w of a perfumer|strong="H07543"\w*; \w it will be|strong="H01961"\w* \w a sacred|strong="H06944"\w* \w anointing|strong="H04888"\w* \w oil|strong="H08081"\w*.
\p \v 26 \w Use this oil to anoint|strong="H04886"\w* \w the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*, \w the ark|strong="H00727"\w* \w of the Testimony|strong="H05715"\w*, \v 27 \w the table|strong="H07979"\w* \w and|strong="H00853"\w* \w all|strong="H03605"\w* \w its utensils|strong="H03627"\w*, \w the lampstand|strong="H04501"\w* \w and|strong="H00853"\w* \w its utensils|strong="H03627"\w*, \w the altar|strong="H04196"\w* \w of incense|strong="H07004"\w*, \v 28 \w the altar|strong="H04196"\w* \w of burnt offering|strong="H05930"\w* \w and|strong="H00853"\w* \w all|strong="H03605"\w* \w its utensils|strong="H03627"\w*, \w and the basin|strong="H03595"\w* \w with its stand|strong="H03653"\w*. \v 29 \w You are to consecrate|strong="H06942"\w* \w them|strong="H00853"\w* \w so that they will be|strong="H01961"\w* \w most|strong="H06944"\w* \w holy|strong="H06944"\w*. \w Whatever|strong="H03605"\w* \w touches|strong="H05060"\w* them \w shall be holy|strong="H06942"\w*. \v 30 \w Anoint|strong="H04886"\w* \w Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w* \w and consecrate|strong="H06942"\w* \w them|strong="H00853"\w* \w to serve Me as priests|strong="H03547"\w*.
\p \v 31 \w And you are to tell|strong="H01696"\w* \w the Israelites|strong="H01121"\w*, ‘\w This|strong="H02088"\w* \w will be|strong="H01961"\w* My \w sacred|strong="H06944"\w* \w anointing|strong="H04888"\w* \w oil|strong="H08081"\w* \w for the generations to come|strong="H01755"\w*. \v 32 \w It must not|strong="H03808"\w* \w be used to anoint|strong="H05480"\w* \w an ordinary man|strong="H00120"\w*, \w and you must not|strong="H03808"\w* \w make|strong="H06213"\w* \w anything like it|strong="H03644"\w* \w with the same formula|strong="H04971"\w*. \w It|strong="H01931"\w* \w is holy|strong="H06944"\w*, \w and it must be|strong="H01961"\w* \w holy|strong="H06944"\w* to you. \v 33 \w Anyone|strong="H00376"\w* \w who|strong="H00834"\w* \w mixes perfume|strong="H07543"\w* \w like it|strong="H03644"\w* \w or puts|strong="H05414"\w* \w it on|strong="H05921"\w* \w an outsider|strong="H02114"\w* \w shall be cut off|strong="H03772"\w* \w from his people|strong="H05971"\w*.’”
\s1 The Incense
