\p \v 8 \w Moses|strong="H04872"\w* \w immediately|strong="H04116"\w* \w bowed down|strong="H06915"\w* \w to the ground|strong="H00776"\w* \w and worshiped|strong="H07812"\w*. \v 9 “\w O Lord|strong="H00136"\w*,” \w he said|strong="H00559"\w*, “\w if|strong="H00518"\w* \w I have indeed found|strong="H04672"\w* \w favor|strong="H02580"\w* \w in Your sight|strong="H05869"\w*, \w my Lord|strong="H00136"\w*, \w please|strong="H04994"\w* \w go|strong="H01980"\w* \w with us|strong="H07130"\w*. \w Although|strong="H03588"\w* \w this|strong="H01931"\w* \w is a stiff-necked|strong="H07186"\w* \w people|strong="H05971"\w*, \w forgive|strong="H05545"\w* \w our iniquity|strong="H05771"\w* \w and sin|strong="H02403"\w*, \w and take us as Your inheritance|strong="H05157"\w*.”
\s1 The LORD Renews the Covenant
\r (2 Corinthians 3:7–18)
\p \v 10 \w And the LORD said|strong="H00559"\w*, “\w Behold|strong="H02009"\w*, \w I|strong="H00595"\w* \w am making|strong="H03772"\w* \w a covenant|strong="H01285"\w*. \w Before|strong="H05048"\w* \w all|strong="H03605"\w* \w your people|strong="H05971"\w* \w I will perform|strong="H06213"\w* \w wonders|strong="H06381"\w* \w that|strong="H00834"\w* \w have never|strong="H03808"\w* \w been done|strong="H01254"\w* \w in any|strong="H03605"\w* \w nation|strong="H01471"\w* \w in all|strong="H03605"\w* \w the world|strong="H00776"\w*. \w All|strong="H03605"\w* \w the people|strong="H05971"\w* \w among whom you live|strong="H07130"\w* \w will see|strong="H07200"\w* \w the LORD’s|strong="H03068"\w* \w work|strong="H04639"\w*, \w for|strong="H03588"\w* \w it is|strong="H01931"\w* \w an awesome thing|strong="H03372"\w* \w that|strong="H00834"\w* \w I|strong="H00589"\w* \w am doing|strong="H06213"\w* \w with you|strong="H05973"\w*.
\p \v 11 \w Observe|strong="H08104"\w* \w what|strong="H00834"\w* \w I|strong="H00595"\w* \w command you|strong="H06680"\w* \w this day|strong="H03117"\w*. \w I will drive out|strong="H01644"\w* \w before you|strong="H06440"\w* \w the Amorites|strong="H00567"\w*, \w Canaanites|strong="H03669"\w*, \w Hittites|strong="H02850"\w*, \w Perizzites|strong="H06522"\w*, \w Hivites|strong="H02340"\w*, \w and Jebusites|strong="H02983"\w*. \v 12 \w Be careful|strong="H08104"\w* \w not|strong="H06435"\w* \w to make|strong="H03772"\w* \w a treaty|strong="H01285"\w*\f + \fr 34:12 \ft Forms of the Hebrew \fqa berit \ft are translated in most passages as \fqa covenant\ft .\f* \w with the inhabitants|strong="H03427"\w* \w of the land|strong="H00776"\w* \w you|strong="H00859"\w* \w are entering|strong="H00935"\w*, \w lest|strong="H06435"\w* \w they become|strong="H01961"\w* \w a snare|strong="H04170"\w* \w in your midst|strong="H07130"\w*. \v 13 \w Rather|strong="H03588"\w*, \w you must tear down|strong="H05422"\w* \w their altars|strong="H04196"\w*, \w smash|strong="H07665"\w* \w their sacred stones|strong="H04676"\w*, \w and chop down|strong="H03772"\w* \w their Asherah poles|strong="H00842"\w*. \v 14 \w For|strong="H03588"\w* \w you must not|strong="H03808"\w* \w worship|strong="H07812"\w* \w any other|strong="H00312"\w* \w god|strong="H00410"\w*, \w for|strong="H03588"\w* \w the LORD|strong="H03068"\w*, \w whose name is|strong="H08034"\w* \w Jealous|strong="H07067"\w*, \w is a jealous|strong="H07067"\w* \w God|strong="H00410"\w*.
\p \v 15 \w Do not|strong="H06435"\w* \w make|strong="H03772"\w* \w a covenant|strong="H01285"\w* \w with the inhabitants|strong="H03427"\w* \w of the land|strong="H00776"\w*, \w for when they prostitute themselves|strong="H02181"\w* \w to|strong="H00310"\w* \w their gods|strong="H00430"\w* \w and sacrifice|strong="H02076"\w* \w to them|strong="H00430"\w*, \w they will invite|strong="H07121"\w* you, \w and you will eat|strong="H00398"\w* \w their sacrifices|strong="H02077"\w*. \v 16 \w And when you take|strong="H03947"\w* \w some of their daughters|strong="H01323"\w* \w as brides for your sons|strong="H01121"\w*, \w their daughters|strong="H01323"\w* \w will prostitute themselves|strong="H02181"\w* \w to|strong="H00310"\w* \w their gods|strong="H00430"\w* \w and cause your sons|strong="H01121"\w* \w to do the same|strong="H02181"\w*.
\p \v 17 \w You shall make|strong="H06213"\w* \w no|strong="H03808"\w* \w molten|strong="H04541"\w* \w gods|strong="H00430"\w* for yourselves.
\p \v 18 \w You are to keep|strong="H08104"\w* \w the Feast|strong="H02282"\w* \w of Unleavened Bread|strong="H04682"\w*.\f + \fr 34:18 \ft That is, the seven-day period after the Passover during which no leaven may be eaten; see Exodus 12:14–20.\f* \w For seven|strong="H07651"\w* \w days|strong="H03117"\w* \w at the appointed time|strong="H04150"\w* \w in the month|strong="H02320"\w* \w of Abib|strong="H00024"\w*,\f + \fr 34:18 \fqa Abib \ft was the first month of the ancient Hebrew lunar calendar, usually occurring within the months of March and April; twice in this verse.\f* \w you are to eat|strong="H00398"\w* \w unleavened bread|strong="H04682"\w* \w as|strong="H00834"\w* \w I commanded you|strong="H06680"\w*. \w For|strong="H03588"\w* \w in the month|strong="H02320"\w* \w of Abib|strong="H00024"\w* \w you came out|strong="H03318"\w* \w of Egypt|strong="H04714"\w*.
\p \v 19 \w The first offspring|strong="H06363"\w* \w of every|strong="H03605"\w* \w womb|strong="H07358"\w* belongs to Me, \w including all|strong="H03605"\w* \w the firstborn|strong="H06363"\w* \w males|strong="H02142"\w* \w among your livestock|strong="H04735"\w*, \w whether cattle|strong="H07794"\w* \w or sheep|strong="H07716"\w*. \v 20 \w You must redeem|strong="H06299"\w* \w the firstborn|strong="H06363"\w* \w of a donkey|strong="H02543"\w* \w with a lamb|strong="H07716"\w*; \w but if|strong="H00518"\w* \w you do not|strong="H03808"\w* \w redeem it|strong="H06299"\w*, \w you are to break its neck|strong="H06202"\w*. \w You must redeem|strong="H06299"\w* \w all|strong="H03605"\w* \w the firstborn|strong="H01060"\w* \w of your sons|strong="H01121"\w*. \w No|strong="H03808"\w* \w one shall appear|strong="H07200"\w* \w before Me|strong="H06440"\w* \w empty-handed|strong="H07387"\w*.
\p \v 21 \w Six|strong="H08337"\w* \w days|strong="H03117"\w* \w you shall labor|strong="H05647"\w*, \w but on the seventh|strong="H07637"\w* \w day|strong="H03117"\w* \w you shall rest|strong="H07673"\w*; \w even in the seasons of plowing|strong="H02758"\w* \w and harvesting|strong="H07105"\w*, \w you must rest|strong="H07673"\w*.
\p \v 22 And you \w are to celebrate|strong="H06213"\w* \w the Feast|strong="H02282"\w* \w of Weeks|strong="H07620"\w*\f + \fr 34:22 \ft That is, Shavuot, the late spring feast of pilgrimage to Jerusalem; it is also known as \fqa the Feast of Harvest\ft (see Exodus 23:16) or \fqa the Feast of Pentecost\ft (see Acts 2:1).\f* \w with the firstfruits|strong="H01061"\w* \w of the wheat|strong="H02406"\w* \w harvest|strong="H07105"\w*, \w and the Feast|strong="H02282"\w* \w of Ingathering|strong="H00614"\w*\f + \fr 34:22 \ft That is, Sukkot, the autumn feast of pilgrimage to Jerusalem; it is later called \fqa the Feast of Tabernacles \ft (or \fqa Booths \ft or \fqa Shelters\ft ).\f* \w at the turn|strong="H08622"\w* \w of the year|strong="H08141"\w*. \v 23 \w Three|strong="H07969"\w* \w times|strong="H06471"\w* \w a year|strong="H08141"\w* \w all|strong="H03605"\w* \w your males|strong="H02138"\w* \w are to appear|strong="H07200"\w* \w before|strong="H06440"\w* \w the Lord|strong="H00113"\w* \w GOD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*. \v 24 \w For|strong="H03588"\w* \w I will drive out|strong="H03423"\w* \w the nations|strong="H01471"\w* \w before you|strong="H06440"\w* \w and enlarge|strong="H07337"\w* \w your borders|strong="H01366"\w*, \w and no|strong="H03808"\w* \w one|strong="H00376"\w* \w will covet|strong="H02530"\w* \w your land|strong="H00776"\w* \w when you go up|strong="H05927"\w* \w three|strong="H07969"\w* \w times|strong="H06471"\w* \w a year|strong="H08141"\w* \w to appear|strong="H07200"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*.
\p \v 25 \w Do not|strong="H03808"\w* \w offer|strong="H07819"\w* \w the blood|strong="H01818"\w* \w of a sacrifice to Me|strong="H02077"\w* \w along with|strong="H05921"\w* \w anything leavened|strong="H02557"\w*, \w and do not let|strong="H03808"\w* \w any of the sacrifice|strong="H02077"\w* \w from the Passover|strong="H06453"\w* \w Feast|strong="H02282"\w* \w remain|strong="H03885"\w* \w until morning|strong="H01242"\w*.
\p \v 26 \w Bring|strong="H00935"\w* \w the best|strong="H07225"\w* \w of the firstfruits|strong="H01061"\w* \w of your soil|strong="H00127"\w* \w to the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*.
\p \w You must not|strong="H03808"\w* \w cook|strong="H01310"\w* \w a young goat|strong="H01423"\w* \w in its mother’s|strong="H00517"\w* \w milk|strong="H02461"\w*.”
\p \v 27 \w The LORD|strong="H03068"\w* \w also said|strong="H00559"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*, “\w Write down|strong="H03789"\w* \w these|strong="H00428"\w* \w words|strong="H01697"\w*, \w for|strong="H03588"\w* \w in accordance with|strong="H05921"\w* \w these|strong="H00428"\w* \w words|strong="H01697"\w* \w I have made|strong="H03772"\w* \w a covenant|strong="H01285"\w* \w with|strong="H00854"\w* \w you and with|strong="H00854"\w* \w Israel|strong="H03478"\w*.”
\p \v 28 \w So Moses was|strong="H01961"\w* \w there|strong="H08033"\w* \w with|strong="H05973"\w* \w the LORD|strong="H03068"\w* \w forty|strong="H00705"\w* \w days|strong="H03117"\w* \w and forty|strong="H00705"\w* \w nights|strong="H03915"\w* \w without|strong="H03808"\w* \w eating|strong="H00398"\w* \w bread|strong="H03899"\w* \w or drinking|strong="H08354"\w* \w water|strong="H04325"\w*. \w He wrote on|strong="H05921"\w* \w the tablets|strong="H03871"\w* \w the words|strong="H01697"\w* \w of the covenant|strong="H01285"\w* — \w the Ten|strong="H06235"\w* \w Commandments|strong="H01697"\w*.\f + \fr 34:28 \ft Hebrew \fqa the Ten Words\f*
\p \v 29 \w And|strong="H01961"\w* \w when Moses|strong="H04872"\w* \w came down|strong="H03381"\w* \w from Mount|strong="H02022"\w* \w Sinai|strong="H05514"\w* \w with the two|strong="H08147"\w* \w tablets|strong="H03871"\w* \w of the Testimony|strong="H05715"\w* \w in his|strong="H04872"\w* \w hands|strong="H03027"\w*, \w he|strong="H04872"\w* \w was unaware|strong="H03045"\w* \w that|strong="H03588"\w* \w his face|strong="H06440"\w* \w had become radiant|strong="H07160"\w* \w from speaking|strong="H01696"\w* \w with the LORD|strong="H00854"\w*. \v 30 \w Aaron|strong="H00175"\w* \w and all|strong="H03605"\w* \w the Israelites|strong="H01121"\w* \w looked at|strong="H07200"\w* \w Moses|strong="H04872"\w*, \w and behold|strong="H02009"\w*, \w his face|strong="H06440"\w* \w was radiant|strong="H07160"\w*. \w And they were afraid|strong="H03372"\w* \w to approach|strong="H05066"\w* \w him|strong="H00413"\w*.
\p \v 31 \w But Moses|strong="H04872"\w* \w called out|strong="H07121"\w* \w to them|strong="H00413"\w*; \w so Aaron|strong="H00175"\w* \w and all|strong="H03605"\w* \w the leaders|strong="H05387"\w* \w of the congregation|strong="H05712"\w* \w returned|strong="H07725"\w* \w to him|strong="H00413"\w*, \w and Moses|strong="H04872"\w* \w spoke|strong="H01696"\w* \w to them|strong="H00413"\w*. \v 32 \w And after|strong="H00310"\w* \w this|strong="H03651"\w* \w all|strong="H03605"\w* \w the Israelites|strong="H01121"\w* \w came near|strong="H05066"\w*, \w and Moses commanded|strong="H06680"\w* \w them|strong="H00853"\w* \w to do everything|strong="H03605"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had told him|strong="H01696"\w* \w on Mount|strong="H02022"\w* \w Sinai|strong="H05514"\w*.
\p \v 33 \w When Moses|strong="H04872"\w* \w had finished|strong="H03615"\w* \w speaking|strong="H01696"\w* \w with them|strong="H00854"\w*, \w he put|strong="H05414"\w* \w a veil|strong="H04533"\w* \w over|strong="H05921"\w* \w his face|strong="H06440"\w*. \v 34 \w But whenever Moses|strong="H04872"\w* \w went in|strong="H00935"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w to speak|strong="H01696"\w* \w with Him|strong="H00854"\w*, \w he would remove|strong="H05493"\w* \w the veil|strong="H04533"\w* \w until|strong="H05704"\w* \w he came out|strong="H03318"\w*. \w And when he came out|strong="H03318"\w*, \w he would tell|strong="H01696"\w* \w the Israelites|strong="H01121"\w* \w what|strong="H00834"\w* \w he had been commanded|strong="H06680"\w*, \v 35 \w and the Israelites|strong="H01121"\w* \w would see|strong="H07200"\w* \w that|strong="H03588"\w* \w the face|strong="H06440"\w* \w of Moses|strong="H04872"\w* \w was radiant|strong="H07160"\w*. \w So Moses|strong="H04872"\w* \w would put the veil|strong="H04533"\w* \w back|strong="H07725"\w* \w over|strong="H05921"\w* \w his face|strong="H06440"\w* \w until|strong="H05704"\w* \w he went in|strong="H00935"\w* \w to speak|strong="H01696"\w* \w with the LORD|strong="H00854"\w*.
\c 35
\s1 The Sabbath
\p \v 1 \w Then Moses|strong="H04872"\w* \w assembled|strong="H06950"\w* \w the whole|strong="H03605"\w* \w congregation|strong="H05712"\w* \w of Israel|strong="H03478"\w* \w and said|strong="H00559"\w* \w to them|strong="H00413"\w*, “\w These|strong="H00428"\w* \w are the things|strong="H01697"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w has commanded|strong="H06680"\w* \w you to do|strong="H06213"\w*: \v 2 \w For six|strong="H08337"\w* \w days|strong="H03117"\w* \w work|strong="H04399"\w* \w may be done|strong="H06213"\w*, \w but the seventh|strong="H07637"\w* \w day|strong="H03117"\w* \w shall be|strong="H01961"\w* your \w holy day|strong="H06944"\w*, \w a Sabbath|strong="H07676"\w* \w of complete rest|strong="H07677"\w* \w to the LORD|strong="H03068"\w*. \w Whoever|strong="H03605"\w* \w does|strong="H06213"\w* \w any work|strong="H04399"\w* on that day \w must be put to death|strong="H04191"\w*. \v 3 \w Do not|strong="H03808"\w* \w light|strong="H01197"\w* \w a fire|strong="H00784"\w* \w in any|strong="H03605"\w* \w of your dwellings|strong="H04186"\w* \w on the Sabbath|strong="H07676"\w* \w day|strong="H03117"\w*.”
