\p \v 20 \w Behold|strong="H02009"\w*, \w I|strong="H00595"\w* \w am sending|strong="H07971"\w* \w an angel|strong="H04397"\w* \w before you|strong="H06440"\w* \w to protect you|strong="H08104"\w* \w along the way|strong="H01870"\w* \w and to bring you|strong="H00935"\w* \w to|strong="H00413"\w* \w the place|strong="H04725"\w* \w I have prepared|strong="H03559"\w*. \v 21 \w Pay attention|strong="H08104"\w* \w to him|strong="H06440"\w* \w and listen|strong="H08085"\w* \w to his voice|strong="H06963"\w*; \w do not|strong="H00408"\w* \w defy|strong="H04843"\w* him, \w for|strong="H03588"\w* \w he will not|strong="H03808"\w* \w forgive|strong="H05375"\w* \w rebellion|strong="H06588"\w*, \w since|strong="H03588"\w* \w My Name|strong="H08034"\w* \w is in him|strong="H07130"\w*.
\p \v 22 \w But|strong="H03588"\w* \w if|strong="H00518"\w* \w you will listen carefully|strong="H08085"\w* \w to his voice|strong="H06963"\w* \w and do|strong="H06213"\w* \w everything|strong="H03605"\w* \w I say|strong="H01696"\w*, \w I will be an enemy|strong="H00341"\w* \w to your enemies|strong="H00340"\w* \w and a foe|strong="H06696"\w* \w to your foes|strong="H06887"\w*. \v 23 \w For|strong="H03588"\w* \w My angel|strong="H04397"\w* \w will go|strong="H01980"\w* \w before you|strong="H06440"\w* \w and bring you|strong="H00935"\w* \w into|strong="H00413"\w* \w the land of the Amorites|strong="H00567"\w*, \w Hittites|strong="H02850"\w*, \w Perizzites|strong="H06522"\w*, \w Canaanites|strong="H03669"\w*, \w Hivites|strong="H02340"\w*, \w and Jebusites|strong="H02983"\w*, \w and I will annihilate them|strong="H03582"\w*.
