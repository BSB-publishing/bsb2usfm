\s1 The Table of Showbread
\r (Exodus 37:10–16; Leviticus 24:5–9)
\p \v 23 \w You are also to make|strong="H06213"\w* \w a table|strong="H07979"\w* \w of acacia|strong="H07848"\w* \w wood|strong="H06086"\w* \w two cubits|strong="H00520"\w* \w long|strong="H00753"\w*, \w a cubit|strong="H00520"\w* \w wide|strong="H07341"\w*, \w and a cubit|strong="H00520"\w* \w and a half|strong="H02677"\w* \w high|strong="H06967"\w*.\f + \fr 25:23 \ft The table was approximately 3 feet long, 1.5 feet wide, and 2.25 feet high (91.4 centimeters long, 45.7 centimeters wide, and 68.6 centimeters high).\f* \v 24 \w Overlay|strong="H06823"\w* \w it|strong="H00853"\w* \w with pure|strong="H02889"\w* \w gold|strong="H02091"\w* \w and make|strong="H06213"\w* \w a gold|strong="H02091"\w* \w molding|strong="H02213"\w* \w around it|strong="H05439"\w*. \v 25 \w And make|strong="H06213"\w* \w a rim|strong="H04526"\w* \w around it|strong="H05439"\w* \w a handbreadth wide|strong="H02948"\w*\f + \fr 25:25 \fqa A handbreadth \ft is approximately 2.9 inches or 7.4 centimeters.\f* \w and put|strong="H06213"\w* \w a gold|strong="H02091"\w* \w molding|strong="H02213"\w* \w on|strong="H05439"\w* \w the rim|strong="H04526"\w*.
\p \v 26 \w Make|strong="H06213"\w* \w four|strong="H00702"\w* \w gold|strong="H02091"\w* \w rings|strong="H02885"\w* for the table \w and fasten|strong="H05414"\w* \w them|strong="H02885"\w* \w to|strong="H05921"\w* \w the four|strong="H00702"\w* \w corners|strong="H06285"\w* \w at its four|strong="H00702"\w* \w legs|strong="H07272"\w*. \v 27 \w The rings|strong="H02885"\w* \w are to be|strong="H01961"\w* \w close|strong="H05980"\w* \w to the rim|strong="H04526"\w*, \w to serve as holders|strong="H01004"\w* \w for the poles|strong="H00905"\w* \w used to carry|strong="H05375"\w* \w the table|strong="H07979"\w*. \v 28 \w Make|strong="H06213"\w* \w the poles|strong="H00905"\w* \w of acacia|strong="H07848"\w* \w wood|strong="H06086"\w* \w and overlay|strong="H06823"\w* \w them|strong="H00853"\w* \w with gold|strong="H02091"\w*, \w so that the table|strong="H07979"\w* \w may be carried|strong="H05375"\w* with them.
\p \v 29 \w You are also to make|strong="H06213"\w* \w the plates|strong="H07086"\w* \w and dishes|strong="H03709"\w*, \w as well as the pitchers|strong="H07184"\w* \w and bowls|strong="H04518"\w* \w for pouring drink offerings|strong="H05258"\w*. \w Make|strong="H06213"\w* \w them|strong="H00853"\w* \w out of pure|strong="H02889"\w* \w gold|strong="H02091"\w*.
\p \v 30 \w And place|strong="H05414"\w* \w the Bread|strong="H03899"\w* \w of the Presence|strong="H06440"\w* \w on|strong="H05921"\w* \w the table|strong="H07979"\w* \w before Me|strong="H06440"\w* \w at all times|strong="H08548"\w*.
\s1 The Lampstand
\r (Exodus 37:17–24; Numbers 8:1–4)
\p \v 31 \w Then you are to make|strong="H06213"\w* \w a lampstand|strong="H04501"\w* \w of pure|strong="H02889"\w*, \w hammered|strong="H04749"\w* \w gold|strong="H02091"\w*. \w It|strong="H04501"\w* \w shall be made|strong="H06213"\w* \w of one piece|strong="H04480"\w*, \w including|strong="H01961"\w* \w its base|strong="H03409"\w* \w and shaft|strong="H07070"\w*, \w its cups|strong="H01375"\w*, \w and its buds|strong="H03730"\w* \w and petals|strong="H06525"\w*.
\p \v 32 \w Six|strong="H08337"\w* \w branches|strong="H07070"\w* \w are to extend|strong="H03318"\w* \w from the sides|strong="H06654"\w* \w of the lampstand|strong="H04501"\w* — \w three|strong="H07969"\w* \w on one|strong="H00259"\w* \w side|strong="H06654"\w* \w and three|strong="H07969"\w* \w on the other|strong="H08145"\w*. \v 33 \w There are to be three|strong="H07969"\w* \w cups|strong="H01375"\w* \w shaped like almond blossoms|strong="H08246"\w* \w on the first|strong="H00259"\w* \w branch|strong="H07070"\w*, \w each with buds|strong="H03730"\w* \w and petals|strong="H06525"\w*, \w three|strong="H07969"\w* \w on the next|strong="H00259"\w* \w branch|strong="H07070"\w*, \w and the same|strong="H03651"\w* \w for all six|strong="H08337"\w* \w branches|strong="H07070"\w* \w that extend|strong="H03318"\w* \w from|strong="H04480"\w* \w the lampstand|strong="H04501"\w*.
\p \v 34 \w And on the lampstand|strong="H04501"\w* \w there shall be four|strong="H00702"\w* \w cups|strong="H01375"\w* \w shaped like almond blossoms|strong="H08246"\w* \w with buds|strong="H03730"\w* \w and petals|strong="H06525"\w*. \v 35 \w For the six|strong="H08337"\w* \w branches|strong="H07070"\w* \w that extend|strong="H03318"\w* \w from|strong="H04480"\w* \w the lampstand|strong="H04501"\w*, \w a bud|strong="H03730"\w* \w must be under|strong="H08478"\w* \w the first pair|strong="H08147"\w* \w of branches|strong="H07070"\w*, \w a bud|strong="H03730"\w* \w under|strong="H08478"\w* \w the second pair|strong="H08147"\w*, \w and a bud|strong="H03730"\w* \w under|strong="H08478"\w* \w the third pair|strong="H08147"\w*. \v 36 \w The buds|strong="H03730"\w* \w and branches|strong="H07070"\w* \w are to be|strong="H01961"\w* \w all|strong="H03605"\w* \w of one piece with the lampstand|strong="H00259"\w*, \w hammered|strong="H04749"\w* \w out of pure|strong="H02889"\w* \w gold|strong="H02091"\w*.
\p \v 37 \w Make|strong="H06213"\w* \w seven|strong="H07651"\w* \w lamps|strong="H05216"\w* \w and set them up|strong="H05927"\w* \w on the lampstand|strong="H00853"\w* \w so that they|strong="H05216"\w* \w illuminate|strong="H00215"\w* \w the area|strong="H05676"\w* \w in|strong="H05921"\w* \w front of it|strong="H06440"\w*. \v 38 \w The wick trimmers|strong="H04457"\w* \w and their trays|strong="H04289"\w* \w must be of pure|strong="H02889"\w* \w gold|strong="H02091"\w*. \v 39 \w The lampstand|strong="H00853"\w* \w and all|strong="H03605"\w* \w these|strong="H00428"\w* \w utensils|strong="H03627"\w* \w shall be made|strong="H06213"\w* \w from|strong="H00853"\w* \w a talent|strong="H03603"\w* \w of pure|strong="H02889"\w* \w gold|strong="H02091"\w*.\f + \fr 25:39 \fqa A talent \ft is approximately 75.4 pounds or 34.2 kilograms of gold.\f*
\p \v 40 \w See to it that|strong="H07200"\w* \w you make everything|strong="H06213"\w* \w according to the pattern|strong="H08403"\w* \w shown|strong="H07200"\w* \w you|strong="H00859"\w* \w on the mountain|strong="H02022"\w*.\f + \fr 25:40 \ft Cited in Hebrews 8:5\f*[’’]
\c 26
\s1 The Ten Curtains for the Tabernacle
\r (Exodus 36:8–13)
\p \v 1 “\w You are to construct|strong="H06213"\w* \w the tabernacle itself|strong="H04908"\w* \w with ten|strong="H06235"\w* \w curtains|strong="H03407"\w* \w of finely spun|strong="H07806"\w* \w linen|strong="H08336"\w*, \w each with blue|strong="H08504"\w*, \w purple|strong="H00713"\w*, \w and scarlet yarn|strong="H08438"\w*, \w and cherubim|strong="H03742"\w* \w skillfully|strong="H02803"\w* \w worked|strong="H04639"\w* \w into them|strong="H00853"\w*. \v 2 \w Each|strong="H00259"\w* \w curtain|strong="H03407"\w* \w shall be twenty-eight|strong="H08083"\w* \w cubits|strong="H00520"\w* \w long|strong="H00753"\w* \w and four|strong="H00702"\w* \w cubits|strong="H00520"\w* \w wide|strong="H07341"\w*\f + \fr 26:2 \ft Each of the ten curtains was approximately 42 feet long and 6 feet wide (12.8 meters long and 1.8 meters wide).\f* — \w all|strong="H03605"\w* \w curtains|strong="H03407"\w* \w the same|strong="H00259"\w* \w size|strong="H04060"\w*.
\p \v 3 \w Five|strong="H02568"\w* \w of the curtains|strong="H03407"\w* \w are to be|strong="H01961"\w* \w joined|strong="H02266"\w* \w together|strong="H00802"\w*, \w and the other five|strong="H02568"\w* \w joined|strong="H02266"\w* \w as well|strong="H00802"\w*. \v 4 \w Make|strong="H06213"\w* \w loops|strong="H03924"\w* \w of blue material|strong="H08504"\w* \w on|strong="H05921"\w* \w the edge|strong="H08193"\w* \w of the end|strong="H07098"\w* \w curtain|strong="H03407"\w* \w in the first|strong="H00259"\w* \w set|strong="H02279"\w*, \w and do|strong="H06213"\w* \w the same|strong="H03651"\w* \w for the end|strong="H07020"\w* \w curtain|strong="H03407"\w* \w in the second|strong="H08145"\w* \w set|strong="H04225"\w*.
\p \v 5 \w Make|strong="H06213"\w* \w fifty|strong="H02572"\w* \w loops|strong="H03924"\w* \w on one|strong="H00259"\w* \w curtain|strong="H03407"\w* \w and fifty|strong="H02572"\w* \w loops|strong="H03924"\w* \w on the end|strong="H07097"\w* \w curtain|strong="H03407"\w* \w of the second|strong="H08145"\w* \w set|strong="H04225"\w*, \w so that the loops|strong="H03924"\w* \w line up|strong="H06901"\w* \w opposite|strong="H00802"\w* \w one another|strong="H00269"\w*. \v 6 \w Make|strong="H06213"\w* \w fifty|strong="H02572"\w* \w gold|strong="H02091"\w* \w clasps as well|strong="H07165"\w*, \w and join|strong="H02266"\w* \w the curtains|strong="H03407"\w* \w together|strong="H00802"\w* \w with the clasps|strong="H07165"\w*, \w so that the tabernacle|strong="H04908"\w* \w will be|strong="H01961"\w* \w a unit|strong="H00259"\w*.
\s1 The Eleven Curtains of Goat Hair
\r (Exodus 36:14–19)
\p \v 7 \w You are to make|strong="H06213"\w* \w curtains|strong="H03407"\w* \w of goat hair|strong="H05795"\w* \w for the tent|strong="H00168"\w* \w over|strong="H05921"\w* \w the tabernacle|strong="H04908"\w* — \w eleven|strong="H06249"\w* \w curtains in all|strong="H03407"\w*. \v 8 \w Each|strong="H00259"\w* \w of the eleven|strong="H06249"\w* \w curtains|strong="H03407"\w* \w is to be the same|strong="H00259"\w* \w size|strong="H04060"\w* — \w thirty|strong="H07970"\w* \w cubits|strong="H00520"\w* \w long|strong="H00753"\w* \w and four|strong="H00702"\w* \w cubits|strong="H00520"\w* \w wide|strong="H07341"\w*.\f + \fr 26:8 \ft Each of the eleven curtains was approximately 45 feet long and 6 feet wide (13.7 meters long and 1.8 meters wide).\f*
\p \v 9 \w Join|strong="H02266"\w* \w five|strong="H02568"\w* \w of the curtains|strong="H03407"\w* \w into one set|strong="H00905"\w* \w and the other six|strong="H08337"\w* \w into another|strong="H03407"\w*. \w Then fold the sixth|strong="H08345"\w* \w curtain over|strong="H03407"\w* \w double|strong="H03717"\w* \w at|strong="H00413"\w* \w the front|strong="H04136"\w* \w of the tent|strong="H00168"\w*.
\p \v 10 \w Make|strong="H06213"\w* \w fifty|strong="H02572"\w* \w loops|strong="H03924"\w* \w along|strong="H05921"\w* \w the edge|strong="H08193"\w* \w of the|strong="H00259"\w* \w end|strong="H07020"\w* \w curtain|strong="H03407"\w* \w in the first set|strong="H02279"\w*, \w and fifty|strong="H02572"\w* \w loops|strong="H03924"\w* \w along|strong="H05921"\w* \w the edge|strong="H08193"\w* \w of the corresponding curtain|strong="H03407"\w* \w in the second|strong="H08145"\w* \w set|strong="H02279"\w*. \v 11 \w Make|strong="H06213"\w* \w fifty|strong="H02572"\w* \w bronze|strong="H05178"\w* \w clasps|strong="H07165"\w* \w and put|strong="H00935"\w* \w them|strong="H07165"\w* \w through the loops|strong="H03924"\w* \w to join|strong="H02266"\w* \w the tent|strong="H00168"\w* \w together|strong="H01961"\w* \w as a unit|strong="H00259"\w*.
\p \v 12 \w As for the overlap|strong="H05629"\w* \w that remains|strong="H05736"\w* \w of the tent|strong="H00168"\w* \w curtains|strong="H03407"\w*, \w the half|strong="H02677"\w* \w curtain|strong="H03407"\w* \w that is left over|strong="H05736"\w* \w shall hang down|strong="H05628"\w* \w over|strong="H05921"\w* \w the back|strong="H00268"\w* \w of the tabernacle|strong="H04908"\w*. \v 13 \w And the tent|strong="H00168"\w* \w curtains will be|strong="H03407"\w* \w a cubit|strong="H00520"\w*\f + \fr 26:13 \fqa A cubit \ft is approximately 18 inches or 45.7 centimeters.\f* \w longer|strong="H00753"\w* \w on either side|strong="H02088"\w*, \w and the excess|strong="H05736"\w* \w will|strong="H01961"\w* \w hang|strong="H05628"\w* \w over|strong="H05921"\w* \w the sides|strong="H06654"\w* \w of the tabernacle|strong="H04908"\w* \w to cover it|strong="H03680"\w*.
\p \v 14 \w Also make|strong="H06213"\w* \w a covering|strong="H04372"\w* \w for the tent|strong="H00168"\w* \w out of ram|strong="H00352"\w* \w skins|strong="H05785"\w* \w dyed red|strong="H00119"\w*, \w and over that|strong="H04605"\w* \w a covering|strong="H04372"\w* \w of fine leather|strong="H08476"\w*.\f + \fr 26:14 \ft Possibly the hides of large aquatic mammals\f*
\s1 The Frames and Bases
\r (Exodus 36:20–34)
\p \v 15 \w You are to construct|strong="H06213"\w* \w upright|strong="H05975"\w* \w frames|strong="H07175"\w* \w of acacia|strong="H07848"\w* \w wood|strong="H06086"\w* \w for the tabernacle|strong="H04908"\w*. \v 16 \w Each frame|strong="H07175"\w* \w is to be ten|strong="H06235"\w* \w cubits|strong="H00520"\w* \w long|strong="H00753"\w* \w and a cubit|strong="H00520"\w* \w and a half|strong="H02677"\w* \w wide|strong="H07341"\w*.\f + \fr 26:16 \ft Each frame was approximately 15 feet long and 2.25 feet wide (4.6 meters long and 68.6 centimeters wide).\f* \v 17 \w Two|strong="H08147"\w* \w tenons|strong="H03027"\w*\f + \fr 26:17 \ft That is, projecting pieces of wood made for insertion into another piece; similarly in verse 19.\f* \w must be connected|strong="H07947"\w* \w to|strong="H00413"\w* \w each|strong="H00802"\w* \w other|strong="H00269"\w* \w for each|strong="H00259"\w* \w frame|strong="H07175"\w*. \w Make|strong="H06213"\w* \w all|strong="H03605"\w* \w the frames|strong="H07175"\w* \w of the tabernacle|strong="H04908"\w* \w in this way|strong="H03651"\w*.
\p \v 18 \w Construct|strong="H06213"\w* \w twenty|strong="H06242"\w* \w frames|strong="H07175"\w* \w for the south|strong="H05045"\w* \w side|strong="H06285"\w* \w of the tabernacle|strong="H04908"\w*, \v 19 \w with|strong="H06213"\w* \w forty|strong="H00705"\w* \w silver|strong="H03701"\w* \w bases|strong="H00134"\w* \w under|strong="H08478"\w* \w the twenty|strong="H06242"\w* \w frames|strong="H07175"\w* — \w two|strong="H08147"\w* \w bases|strong="H00134"\w* \w for each|strong="H00259"\w* \w frame|strong="H07175"\w*, \w one under each|strong="H08147"\w* \w tenon|strong="H03027"\w*.
\p \v 20 \w For the second|strong="H08145"\w* \w side|strong="H06763"\w* \w of the tabernacle|strong="H04908"\w*, \w the north|strong="H06828"\w* \w side|strong="H06285"\w*, \w make twenty|strong="H06242"\w* \w frames|strong="H07175"\w* \v 21 \w and forty|strong="H00705"\w* \w silver|strong="H03701"\w* \w bases|strong="H00134"\w* — \w two|strong="H08147"\w* \w bases|strong="H00134"\w* \w under|strong="H08478"\w* \w each|strong="H00259"\w* \w frame|strong="H07175"\w*.
\p \v 22 \w Make|strong="H06213"\w* \w six|strong="H08337"\w* \w frames|strong="H07175"\w* \w for the rear|strong="H03411"\w* \w of the tabernacle|strong="H04908"\w*, \w the west side|strong="H03220"\w*, \v 23 \w and|strong="H06213"\w* \w two|strong="H08147"\w* \w frames|strong="H07175"\w* \w for the two back|strong="H03411"\w* \w corners|strong="H04742"\w* \w of the tabernacle|strong="H04908"\w*, \v 24 \w coupled|strong="H08380"\w* \w together|strong="H03162"\w* \w from|strong="H05921"\w* \w bottom|strong="H04295"\w* \w to top|strong="H07218"\w* \w and fitted into|strong="H00413"\w* \w a single|strong="H00259"\w* \w ring|strong="H02885"\w*. \w These|strong="H08147"\w* \w will serve as|strong="H01961"\w* \w the two|strong="H08147"\w* \w corners|strong="H04740"\w*. \v 25 \w So there are to be|strong="H01961"\w* \w eight|strong="H08083"\w* \w frames|strong="H07175"\w* \w and sixteen|strong="H08337"\w* \w silver|strong="H03701"\w* \w bases|strong="H00134"\w* — \w two|strong="H08147"\w* \w under|strong="H08478"\w* \w each|strong="H00259"\w* \w frame|strong="H07175"\w*.
\p \v 26 \w You are also to make|strong="H06213"\w* \w five|strong="H02568"\w* \w crossbars|strong="H01280"\w* \w of acacia|strong="H07848"\w* \w wood|strong="H06086"\w* \w for the frames|strong="H07175"\w* \w on one|strong="H00259"\w* \w side|strong="H06763"\w* \w of the tabernacle|strong="H04908"\w*, \v 27 \w five|strong="H02568"\w* \w for those|strong="H07175"\w* \w on the other|strong="H08145"\w* \w side|strong="H06763"\w*, \w and five|strong="H02568"\w* \w for those|strong="H07175"\w* \w on the rear|strong="H03411"\w* \w side|strong="H06763"\w* \w of the tabernacle|strong="H04908"\w*, \w to the west|strong="H03220"\w*.
\p \v 28 \w The central|strong="H08484"\w* \w crossbar|strong="H01280"\w* \w in the middle|strong="H08432"\w* \w of the frames|strong="H07175"\w* \w shall extend|strong="H01272"\w* \w from|strong="H04480"\w* \w one end|strong="H07097"\w* \w to the other|strong="H00413"\w*. \v 29 \w Overlay|strong="H06823"\w* \w the frames|strong="H07175"\w* \w with gold|strong="H02091"\w* \w and make|strong="H06213"\w* \w gold|strong="H02091"\w* \w rings|strong="H02885"\w* \w to hold|strong="H01004"\w* \w the crossbars|strong="H01280"\w*. \w Also overlay|strong="H06823"\w* \w the crossbars|strong="H01280"\w* \w with gold|strong="H02091"\w*.
\p \v 30 \w So you are to set up|strong="H06965"\w* \w the tabernacle|strong="H04908"\w* \w according to the pattern|strong="H04941"\w* \w shown you|strong="H07200"\w* \w on the mountain|strong="H02022"\w*.
\s1 The Veil
\r (Exodus 36:35–36)
\p \v 31 \w Make|strong="H06213"\w* \w a veil|strong="H06532"\w* \w of blue|strong="H08504"\w*, \w purple|strong="H00713"\w*, \w and scarlet yarn|strong="H08438"\w*, \w and finely spun|strong="H07806"\w* \w linen|strong="H08336"\w*, \w with cherubim|strong="H03742"\w* \w skillfully|strong="H02803"\w* \w worked|strong="H04639"\w* \w into it|strong="H06213"\w*. \v 32 \w Hang|strong="H05414"\w* \w it|strong="H00853"\w* \w with gold|strong="H02091"\w* \w hooks|strong="H02053"\w* \w on|strong="H05921"\w* \w four|strong="H00702"\w* \w posts|strong="H05982"\w* \w of acacia wood|strong="H07848"\w*, \w overlaid|strong="H06823"\w* \w with gold|strong="H02091"\w* \w and standing on|strong="H05921"\w* \w four|strong="H00702"\w* \w silver|strong="H03701"\w* \w bases|strong="H00134"\w*. \v 33 \w And hang|strong="H05414"\w* \w the veil|strong="H06532"\w* \w from|strong="H08478"\w* \w the clasps|strong="H07165"\w* \w and place|strong="H00935"\w* \w the ark|strong="H00727"\w* \w of the Testimony|strong="H05715"\w*\f + \fr 26:33 \ft That is, \fqa the ark of the covenant\ft ; also in verse 34\f* \w behind|strong="H01004"\w* \w the veil|strong="H06532"\w*. \w So the veil|strong="H06532"\w* \w will separate|strong="H00914"\w* \w the Holy Place|strong="H06944"\w* \w from the Most Holy Place|strong="H06944"\w*.\f + \fr 26:33 \ft Or \fqa the Holy of Holies\ft ; also in verse 34\f*
\p \v 34 \w Put|strong="H05414"\w* \w the mercy seat|strong="H03727"\w* \w on|strong="H05921"\w* \w the ark|strong="H00727"\w* \w of the Testimony|strong="H05715"\w* \w in the Most Holy Place|strong="H06944"\w*. \v 35 \w And place|strong="H07760"\w* \w the table|strong="H07979"\w* \w outside|strong="H02351"\w* \w the veil|strong="H06532"\w* \w on|strong="H05921"\w* \w the north|strong="H06828"\w* \w side|strong="H06763"\w* \w of the tabernacle|strong="H04908"\w*, \w and|strong="H00853"\w* \w put|strong="H05414"\w* \w the lampstand|strong="H04501"\w* \w opposite|strong="H05227"\w* \w the table|strong="H07979"\w*, \w on|strong="H05921"\w* \w the south|strong="H08486"\w* \w side|strong="H06763"\w*.
\s1 The Curtain for the Entrance
\r (Exodus 36:37–38)
\p \v 36 \w For the entrance|strong="H06607"\w* \w to the tent|strong="H00168"\w*, \w you are to make|strong="H06213"\w* \w a curtain|strong="H04539"\w* \w embroidered|strong="H07551"\w* \w with blue|strong="H08504"\w*, \w purple|strong="H00713"\w*, \w and scarlet yarn|strong="H08438"\w*, \w and finely spun|strong="H07806"\w* \w linen|strong="H08336"\w*. \v 37 \w Make|strong="H06213"\w* \w five|strong="H02568"\w* \w posts|strong="H05982"\w* \w of acacia wood|strong="H07848"\w* \w for the curtain|strong="H04539"\w*, \w overlay|strong="H06823"\w* \w them|strong="H00853"\w* \w with gold|strong="H02091"\w*, \w use hooks|strong="H02053"\w* \w of gold|strong="H02091"\w*, \w and cast|strong="H03332"\w* \w five|strong="H02568"\w* \w bronze|strong="H05178"\w* \w bases|strong="H00134"\w* for them.[’’]
\c 27
\s1 The Bronze Altar
\r (Exodus 38:1–7)
\p \v 1 “\w You are to build|strong="H06213"\w* \w an altar|strong="H04196"\w* \w of acacia|strong="H07848"\w* \w wood|strong="H06086"\w*. \w The altar|strong="H04196"\w* \w must be|strong="H01961"\w* \w square|strong="H07251"\w*, \w five|strong="H02568"\w* \w cubits|strong="H00520"\w* \w long|strong="H00753"\w*, \w five|strong="H02568"\w* \w cubits|strong="H00520"\w* \w wide|strong="H07341"\w*, \w and three|strong="H07969"\w* \w cubits|strong="H00520"\w* \w high|strong="H06967"\w*.\f + \fr 27:1 \ft The altar was approximately 7.5 feet in length and width, and 4.5 feet high (2.3 meters in length and width, and 1.4 meters high).\f* \v 2 \w Make|strong="H06213"\w* \w a horn|strong="H07161"\w* \w on each of|strong="H05921"\w* \w its four|strong="H00702"\w* \w corners|strong="H06438"\w*, \w so that the horns|strong="H07161"\w* \w are|strong="H01961"\w* \w of one piece|strong="H04480"\w*, \w and overlay|strong="H06823"\w* \w it with bronze|strong="H05178"\w*.
\p \v 3 \w Make|strong="H06213"\w* \w all|strong="H03605"\w* \w its utensils|strong="H03627"\w* \w of bronze|strong="H05178"\w* — \w its pots|strong="H05518"\w* \w for removing ashes|strong="H01878"\w*, \w its shovels|strong="H03257"\w*, \w its sprinkling bowls|strong="H04219"\w*, \w its meat forks|strong="H04207"\w*, \w and its firepans|strong="H04289"\w*. \v 4 \w Construct|strong="H06213"\w* for it \w a grate|strong="H04345"\w* \w of bronze|strong="H05178"\w* \w mesh|strong="H07568"\w*, \w and make a|strong="H06213"\w* \w bronze|strong="H05178"\w* \w ring|strong="H02885"\w* \w at|strong="H05921"\w* \w each of the four|strong="H00702"\w* \w corners|strong="H07098"\w* \w of|strong="H05921"\w* \w the mesh|strong="H07568"\w*. \v 5 \w Set|strong="H05414"\w* \w the grate|strong="H00853"\w* \w beneath|strong="H04295"\w* \w the ledge|strong="H03749"\w* \w of the altar|strong="H04196"\w*, \w so that the mesh|strong="H07568"\w* \w comes|strong="H01961"\w* \w halfway|strong="H02677"\w* \w up|strong="H05704"\w* \w the altar|strong="H04196"\w*.
\p \v 6 \w Additionally, make|strong="H06213"\w* \w poles|strong="H00905"\w* \w of acacia|strong="H07848"\w* \w wood|strong="H06086"\w* \w for the altar|strong="H04196"\w* \w and overlay|strong="H06823"\w* \w them|strong="H00853"\w* \w with bronze|strong="H05178"\w*. \v 7 \w The poles|strong="H00905"\w* \w are to be inserted|strong="H00935"\w* \w into the rings|strong="H02885"\w* \w so that the poles|strong="H00905"\w* \w are|strong="H01961"\w* \w on|strong="H05921"\w* \w two|strong="H08147"\w* \w sides|strong="H06763"\w* \w of the altar|strong="H04196"\w* \w when it is carried|strong="H05375"\w*.
\p \v 8 \w Construct|strong="H06213"\w* \w the altar|strong="H00853"\w* \w with boards|strong="H03871"\w* \w so that it is hollow|strong="H05014"\w*. \w It is to be made|strong="H06213"\w* \w just as|strong="H00834"\w* \w you were shown|strong="H07200"\w* \w on the mountain|strong="H02022"\w*.
\s1 The Courtyard
\r (Exodus 38:9–20)
\p \v 9 \w You are also to make|strong="H06213"\w* \w a courtyard|strong="H02691"\w* \w for the tabernacle|strong="H04908"\w*. \w On the south|strong="H05045"\w* \w side|strong="H06285"\w* \w of the courtyard|strong="H02691"\w* \w make curtains|strong="H07050"\w* \w of finely spun|strong="H07806"\w* \w linen|strong="H08336"\w*, \w a hundred|strong="H03967"\w* \w cubits|strong="H00520"\w* \w long|strong="H00753"\w*\f + \fr 27:9 \fqa 100 cubits \ft is approximately 150 feet or 45.7 meters; also in verse 11.\f* \w on one|strong="H00259"\w* \w side|strong="H06285"\w*, \v 10 \w with twenty|strong="H06242"\w* \w posts|strong="H05982"\w* \w and twenty|strong="H06242"\w* \w bronze|strong="H05178"\w* \w bases|strong="H00134"\w*, \w and silver|strong="H03701"\w* \w hooks|strong="H02053"\w* \w and bands|strong="H02838"\w* \w on the posts|strong="H05982"\w*.
\p \v 11 \w Likewise|strong="H03651"\w* \w there are to be curtains|strong="H07050"\w* \w on the north|strong="H06828"\w* \w side|strong="H06285"\w*, \w a hundred|strong="H03967"\w* \w cubits|strong="H00753"\w* \w long|strong="H00753"\w*, \w with twenty|strong="H06242"\w* \w posts|strong="H05982"\w* \w and twenty|strong="H06242"\w* \w bronze|strong="H05178"\w* \w bases|strong="H00134"\w*, \w and with silver|strong="H03701"\w* \w hooks|strong="H02053"\w* \w and bands|strong="H02838"\w* \w on the posts|strong="H05982"\w*. \v 12 \w The curtains|strong="H07050"\w* \w on the west|strong="H03220"\w* \w side|strong="H06285"\w* \w of the courtyard|strong="H02691"\w* \w shall be fifty|strong="H02572"\w* \w cubits|strong="H00520"\w* \w wide|strong="H07341"\w*,\f + \fr 27:12 \fqa 50 cubits \ft is approximately 75 feet or 22.9 meters; also in verse 13.\f* \w with ten|strong="H06235"\w* \w posts|strong="H05982"\w* \w and ten|strong="H06235"\w* \w bases|strong="H00134"\w*.
\p \v 13 \w The east|strong="H06924"\w* \w side|strong="H06285"\w* \w of the courtyard|strong="H02691"\w*, \w toward the sunrise|strong="H04217"\w*, \w is to be fifty|strong="H02572"\w* \w cubits|strong="H00520"\w* \w wide|strong="H07341"\w*. \v 14 \w Make the curtains|strong="H07050"\w* \w on one side|strong="H03802"\w* \w fifteen|strong="H02568"\w* \w cubits long|strong="H00520"\w*,\f + \fr 27:14 \fqa 15 cubits \ft is approximately 22.5 feet or 6.9 meters; also in verse 15.\f* \w with three|strong="H07969"\w* \w posts|strong="H05982"\w* \w and three|strong="H07969"\w* \w bases|strong="H00134"\w*, \v 15 \w and the curtains|strong="H07050"\w* \w on the other|strong="H08145"\w* \w side|strong="H03802"\w* \w fifteen cubits long|strong="H02568"\w*, \w with three|strong="H07969"\w* \w posts|strong="H05982"\w* \w and three|strong="H07969"\w* \w bases|strong="H00134"\w*.
\p \v 16 \w The gate|strong="H08179"\w* \w of the courtyard|strong="H02691"\w* \w shall be twenty|strong="H06242"\w* \w cubits long|strong="H00520"\w*,\f + \fr 27:16 \fqa 20 cubits \ft is approximately 30 feet or 9.1 meters.\f* \w with a curtain|strong="H04539"\w* \w embroidered|strong="H07551"\w* \w with blue|strong="H08504"\w*, \w purple|strong="H00713"\w*, \w and scarlet yarn|strong="H08438"\w*, \w and finely spun|strong="H07806"\w* \w linen|strong="H08336"\w*. \w It shall have four|strong="H00702"\w* \w posts|strong="H05982"\w* \w and four|strong="H00702"\w* \w bases|strong="H00134"\w*.
\p \v 17 \w All|strong="H03605"\w* \w the posts|strong="H05982"\w* \w around|strong="H05439"\w* \w the courtyard|strong="H02691"\w* \w shall have silver bands|strong="H02836"\w*, \w silver|strong="H03701"\w* \w hooks|strong="H02053"\w*, \w and bronze|strong="H05178"\w* \w bases|strong="H00134"\w*. \v 18 \w The entire|strong="H02572"\w* \w courtyard|strong="H02691"\w* \w shall be a hundred|strong="H03967"\w* \w cubits|strong="H00520"\w* \w long|strong="H00753"\w* \w and fifty cubits|strong="H02572"\w* \w wide|strong="H07341"\w*,\f + \fr 27:18 \ft The courtyard was approximately 150 feet long and 75 feet wide (45.7 meters long and 22.9 meters wide).\f* \w with curtains of finely spun|strong="H07806"\w* \w linen|strong="H08336"\w* \w five|strong="H02568"\w* \w cubits|strong="H00520"\w* \w high|strong="H06967"\w*,\f + \fr 27:18 \fqa 5 cubits \ft is approximately 7.5 feet or 2.3 meters.\f* \w and with bronze|strong="H05178"\w* \w bases|strong="H00134"\w*. \v 19 \w All|strong="H03605"\w* \w the utensils|strong="H03627"\w* \w of the tabernacle|strong="H04908"\w* \w for every|strong="H03605"\w* \w use|strong="H05656"\w*, \w including all|strong="H03605"\w* \w its tent pegs|strong="H03489"\w* \w and|strong="H03605"\w* \w the tent pegs|strong="H03489"\w* \w of the courtyard|strong="H02691"\w*, \w shall be made of bronze|strong="H05178"\w*.
\s1 The Oil for the Lamps
\r (Leviticus 24:1–4)
\p \v 20 \w And you|strong="H00859"\w* \w are to command|strong="H06680"\w* \w the Israelites|strong="H01121"\w* \w to bring|strong="H03947"\w* \w you|strong="H00413"\w* \w pure|strong="H02134"\w* \w oil|strong="H08081"\w* \w of pressed|strong="H03795"\w* \w olives|strong="H02132"\w* \w for the light|strong="H03974"\w*, \w to keep the lamps|strong="H05216"\w* \w burning|strong="H05927"\w* \w continually|strong="H08548"\w*.
\p \v 21 \w In the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*, \w outside|strong="H02351"\w* \w the veil|strong="H06532"\w* \w that is|strong="H00834"\w* \w in front of|strong="H05921"\w* \w the Testimony|strong="H05715"\w*,\f + \fr 27:21 \fqa The Testimony \ft refers to the stone tablets in the ark of the covenant inscribed with the Ten Commandments.\f* \w Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w* \w are to tend|strong="H06186"\w* \w the lamps|strong="H00853"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w from evening|strong="H06153"\w* \w until|strong="H05704"\w* \w morning|strong="H01242"\w*. \w This is to be a permanent|strong="H05769"\w* \w statute|strong="H02708"\w* \w for the Israelites|strong="H01121"\w* \w for the generations to come|strong="H01755"\w*.[’’]
\c 28
\s1 Garments for the Priests
\p \v 1 “\w Next|strong="H00859"\w*, \w have your brother|strong="H00251"\w* \w Aaron|strong="H00175"\w* \w brought|strong="H07126"\w* \w to you|strong="H00413"\w* \w from among|strong="H08432"\w* \w the Israelites|strong="H01121"\w*, \w along with|strong="H00854"\w* \w his sons|strong="H01121"\w* \w Nadab|strong="H05070"\w*, \w Abihu|strong="H00030"\w*, \w Eleazar|strong="H00499"\w*, \w and Ithamar|strong="H00385"\w*, \w to serve Me as priests|strong="H03547"\w*. \v 2 \w Make|strong="H06213"\w* \w holy|strong="H06944"\w* \w garments|strong="H00899"\w* \w for your brother|strong="H00251"\w* \w Aaron|strong="H00175"\w*, \w to give him glory|strong="H03519"\w* \w and splendor|strong="H08597"\w*.
\p \v 3 \w You|strong="H00859"\w* \w are to instruct|strong="H01696"\w* \w all|strong="H03605"\w* \w the skilled craftsmen|strong="H02450"\w*, \w whom|strong="H00834"\w* \w I have filled|strong="H04390"\w* \w with a spirit|strong="H07307"\w* \w of wisdom|strong="H02451"\w*, \w to make|strong="H06213"\w* \w garments|strong="H00899"\w* \w for Aaron’s|strong="H00175"\w* \w consecration|strong="H06942"\w*, \w so that he may serve Me as priest|strong="H03547"\w*. \v 4 \w These|strong="H00428"\w* \w are the garments|strong="H00899"\w* \w that|strong="H00834"\w* \w they shall make|strong="H06213"\w*: \w a breastpiece|strong="H02833"\w*, \w an ephod|strong="H00646"\w*, \w a robe|strong="H04598"\w*, \w a woven|strong="H08665"\w* \w tunic|strong="H03801"\w*, \w a turban|strong="H04701"\w*, \w and a sash|strong="H00073"\w*. \w They are to make|strong="H06213"\w* \w these holy|strong="H06944"\w* \w garments|strong="H00899"\w* \w for your brother|strong="H00251"\w* \w Aaron|strong="H00175"\w* \w and his sons|strong="H01121"\w*, \w so that they may serve Me as priests|strong="H03547"\w*. \v 5 \w They|strong="H01992"\w* \w shall use|strong="H03947"\w* \w gold|strong="H02091"\w*, \w along with|strong="H00853"\w* \w blue|strong="H08504"\w*, \w purple|strong="H00713"\w*, \w and scarlet yarn|strong="H08438"\w*, \w and fine linen|strong="H08336"\w*.
\s1 The Ephod
\r (Exodus 39:1–7)
\p \v 6 \w They are to make|strong="H06213"\w* \w the ephod|strong="H00646"\w* \w of finely spun|strong="H07806"\w* \w linen|strong="H08336"\w* \w embroidered|strong="H04639"\w* \w with gold|strong="H02091"\w*, \w and with blue|strong="H08504"\w*, \w purple|strong="H00713"\w*, \w and scarlet yarn|strong="H08438"\w*. \v 7 \w It shall have|strong="H01961"\w* \w two|strong="H08147"\w* \w shoulder pieces|strong="H03802"\w* \w attached|strong="H02266"\w* \w at|strong="H00413"\w* \w two|strong="H08147"\w* \w of its corners|strong="H07098"\w*, \w so it can be fastened|strong="H02266"\w*. \v 8 \w And the skillfully woven waistband|strong="H02805"\w* \w of|strong="H05921"\w* \w the ephod|strong="H00642"\w* \w must be|strong="H01961"\w* \w of one piece|strong="H04480"\w*, \w of the same workmanship|strong="H04639"\w* — \w with gold|strong="H02091"\w*, \w with blue|strong="H08504"\w*, \w purple|strong="H00713"\w*, \w and scarlet yarn|strong="H08438"\w*, \w and with finely spun|strong="H07806"\w* \w linen|strong="H08336"\w*.
\p \v 9 \w Take|strong="H03947"\w* \w two|strong="H08147"\w* \w onyx|strong="H07718"\w* \w stones|strong="H00068"\w* \w and engrave|strong="H06605"\w* \w on them|strong="H05921"\w* \w the names|strong="H08034"\w* \w of the sons|strong="H01121"\w* \w of Israel|strong="H03478"\w*: \v 10 \w six|strong="H08337"\w* \w of their names|strong="H08034"\w* \w on|strong="H05921"\w* \w one|strong="H00259"\w* \w stone|strong="H00068"\w* \w and the remaining|strong="H03498"\w* \w six|strong="H08337"\w* \w on|strong="H05921"\w* \w the other|strong="H08145"\w*, \w in the order of their birth|strong="H08435"\w*. \v 11 \w Engrave|strong="H06605"\w* \w the names|strong="H08034"\w* \w of the sons|strong="H01121"\w* \w of Israel|strong="H03478"\w* \w on the two|strong="H08147"\w* \w stones|strong="H00068"\w* \w the way a gem|strong="H00068"\w* \w cutter|strong="H02796"\w* \w engraves|strong="H06603"\w* \w a seal|strong="H02368"\w*. \w Then mount|strong="H05437"\w* \w the stones|strong="H00853"\w* \w in gold|strong="H02091"\w* \w filigree settings|strong="H04865"\w*. \v 12 \w Fasten|strong="H07760"\w* \w both|strong="H08147"\w* \w stones|strong="H00068"\w* \w on|strong="H05921"\w* \w the shoulder pieces|strong="H03802"\w* \w of the ephod|strong="H00646"\w* \w as memorial|strong="H02146"\w* \w stones|strong="H00068"\w* \w for the sons|strong="H01121"\w* \w of Israel|strong="H03478"\w*. \w Aaron|strong="H00175"\w* \w is to bear|strong="H05375"\w* \w their names|strong="H08034"\w* \w on|strong="H05921"\w* \w his two|strong="H08147"\w* \w shoulders|strong="H03802"\w* \w as a memorial|strong="H02146"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*.
\p \v 13 \w Fashion|strong="H06213"\w* \w gold|strong="H02091"\w* \w filigree settings|strong="H04865"\w* \v 14 \w and two|strong="H08147"\w* \w chains|strong="H08333"\w* \w of pure|strong="H02889"\w* \w gold|strong="H02091"\w*, \w made|strong="H06213"\w* \w of braided|strong="H04020"\w* \w cord|strong="H05688"\w* \w work|strong="H04639"\w*; \w and attach|strong="H05414"\w* \w these|strong="H05688"\w* \w chains|strong="H08333"\w* \w to|strong="H05921"\w* \w the settings|strong="H04865"\w*.
\s1 The Breastpiece
\r (Exodus 39:8–21)
\p \v 15 \w You are also to make|strong="H06213"\w* \w a breastpiece|strong="H02833"\w* \w of judgment|strong="H04941"\w* \w with the same workmanship|strong="H04639"\w* \w as the ephod|strong="H00646"\w*. \w Construct|strong="H06213"\w* \w it|strong="H00853"\w* \w with gold|strong="H02091"\w*, \w with blue|strong="H08504"\w*, \w purple|strong="H00713"\w*, \w and scarlet yarn|strong="H08438"\w*, \w and with finely spun|strong="H07806"\w* \w linen|strong="H08336"\w*. \v 16 \w It must be|strong="H01961"\w* \w square|strong="H07251"\w* \w when folded over double|strong="H03717"\w*, \w a span|strong="H02239"\w* \w long|strong="H00753"\w* \w and a span|strong="H02239"\w* \w wide|strong="H07341"\w*.\f + \fr 28:16 \ft The breastpiece, when folded over, was approximately 9 inches or 22.9 centimeters in both length and width.\f*
\p \v 17 \w And mount|strong="H04390"\w* on it \w a setting|strong="H04396"\w* \w of gemstones|strong="H00068"\w*, \w four|strong="H00702"\w* \w rows|strong="H02905"\w* \w of stones|strong="H00068"\w*:\f + \fr 28:17 \ft The precise identification of some of these gemstones is uncertain.\f*
\b 
\li1 \w In the first|strong="H00259"\w* \w row there shall be|strong="H02905"\w* \w a ruby|strong="H00124"\w*, \w a topaz|strong="H06357"\w*, \w and an emerald|strong="H01304"\w*;
\li1 \v 18 \w in the second|strong="H08145"\w* \w row|strong="H02905"\w* \w a turquoise|strong="H05306"\w*, \w a sapphire|strong="H05601"\w*, \w and a diamond|strong="H03095"\w*;
\li1 \v 19 \w in the third|strong="H07992"\w* \w row|strong="H02905"\w* \w a jacinth|strong="H03958"\w*, \w an agate|strong="H07618"\w*, \w and an amethyst|strong="H00306"\w*;
\li1 \v 20 \w and in the fourth|strong="H07243"\w* \w row|strong="H02905"\w* \w a beryl|strong="H08658"\w*, \w an onyx|strong="H07718"\w*, \w and a jasper|strong="H03471"\w*.
\p \w Mount these stones|strong="H01961"\w* \w in gold|strong="H02091"\w* \w filigree settings|strong="H04396"\w*. \v 21 \w The twelve|strong="H08147"\w* \w stones|strong="H00068"\w* \w are|strong="H01961"\w* \w to|strong="H05921"\w* \w correspond to the names|strong="H08034"\w* \w of the sons|strong="H01121"\w* \w of Israel|strong="H03478"\w*, \w each|strong="H00376"\w* \w engraved|strong="H06603"\w* \w like a seal|strong="H02368"\w* \w with|strong="H05921"\w* \w the name|strong="H08034"\w* \w of one of the twelve|strong="H08147"\w* \w tribes|strong="H07626"\w*.
\p \v 22 \w For the breastpiece|strong="H02833"\w*, \w make|strong="H06213"\w* \w braided chains|strong="H01383"\w* \w like cords|strong="H04639"\w* \w of pure|strong="H02889"\w* \w gold|strong="H02091"\w*. \v 23 \w You are also to make|strong="H06213"\w* \w two|strong="H08147"\w* \w gold|strong="H02091"\w* \w rings|strong="H02885"\w* \w and fasten|strong="H05414"\w* \w them|strong="H08147"\w* \w to|strong="H05921"\w* \w the two|strong="H08147"\w* \w corners|strong="H07098"\w* \w of the breastpiece|strong="H02833"\w*. \v 24 \w Then fasten|strong="H05414"\w* \w the two|strong="H08147"\w* \w gold|strong="H02091"\w* \w chains|strong="H05688"\w* \w to|strong="H05921"\w* \w the two|strong="H08147"\w* \w gold rings|strong="H02885"\w* \w at|strong="H00413"\w* \w the corners|strong="H07098"\w* \w of the breastpiece|strong="H02833"\w*, \v 25 \w and fasten|strong="H05414"\w* \w the other|strong="H08147"\w* \w ends|strong="H07098"\w* \w of the two|strong="H08147"\w* \w chains|strong="H05688"\w* \w to|strong="H05921"\w* \w the two|strong="H08147"\w* \w filigree settings|strong="H04865"\w*, \w attaching them|strong="H05414"\w* \w to|strong="H05921"\w* \w the shoulder pieces|strong="H03802"\w* \w of the ephod|strong="H00646"\w* \w at|strong="H00413"\w* \w the front|strong="H04136"\w*.
\p \v 26 \w Make|strong="H06213"\w* \w two more|strong="H08147"\w* \w gold|strong="H02091"\w* \w rings|strong="H02885"\w* \w and attach|strong="H07760"\w* \w them|strong="H00853"\w* \w to|strong="H05921"\w* \w the other two|strong="H08147"\w* \w corners|strong="H07098"\w* \w of the breastpiece|strong="H02833"\w*, \w on|strong="H05921"\w* \w the inside|strong="H01004"\w* \w edge|strong="H08193"\w* \w next to|strong="H00413"\w* \w the ephod|strong="H00646"\w*.
\p \v 27 \w Make|strong="H06213"\w* \w two additional|strong="H08147"\w* \w gold|strong="H02091"\w* \w rings|strong="H02885"\w* \w and attach|strong="H05414"\w* \w them|strong="H00853"\w* \w to|strong="H05921"\w* \w the bottom|strong="H04295"\w* \w of the two|strong="H08147"\w* \w shoulder pieces|strong="H03802"\w* \w of the ephod|strong="H00646"\w*, \w on its front|strong="H04136"\w*, \w near|strong="H05980"\w* \w its seam|strong="H04225"\w* \w just above|strong="H04605"\w* \w its woven waistband|strong="H02805"\w*. \v 28 \w The rings|strong="H02885"\w* \w of the breastpiece|strong="H02833"\w* \w shall be tied|strong="H07405"\w* \w to|strong="H00413"\w* \w the rings|strong="H02885"\w* \w of the ephod|strong="H00646"\w* \w with a cord|strong="H06616"\w* \w of blue yarn|strong="H08504"\w*, \w so that the breastpiece|strong="H02833"\w* \w is|strong="H01961"\w* \w above|strong="H05921"\w* \w the waistband|strong="H02805"\w* \w of the ephod|strong="H00646"\w* \w and does not|strong="H03808"\w* \w swing out|strong="H02118"\w* \w from|strong="H05921"\w* \w the ephod|strong="H00646"\w*.
\p \v 29 \w Whenever Aaron enters|strong="H00935"\w* \w the Holy Place|strong="H06944"\w*, \w he|strong="H00175"\w* \w shall bear|strong="H05375"\w* \w the names|strong="H08034"\w* \w of the sons|strong="H01121"\w* \w of Israel|strong="H03478"\w* \w over|strong="H05921"\w* \w his heart|strong="H03820"\w* \w on the breastpiece|strong="H02833"\w* \w of judgment|strong="H04941"\w*, \w as a continual|strong="H08548"\w* \w reminder|strong="H02146"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*.
