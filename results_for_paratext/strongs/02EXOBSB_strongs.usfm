\p \v 17 \w Three|strong="H07969"\w* \w times|strong="H06471"\w* \w a year|strong="H08141"\w* \w all|strong="H03605"\w* \w your males|strong="H02138"\w* \w are to appear|strong="H07200"\w* \w before|strong="H00413"\w* \w the Lord|strong="H00113"\w* \w GOD|strong="H03068"\w*.
\p \v 18 \w You must not|strong="H03808"\w* \w offer|strong="H02076"\w* \w the blood|strong="H01818"\w* \w of My sacrifices|strong="H02077"\w* \w with|strong="H05921"\w* \w anything leavened|strong="H02557"\w*, \w nor may|strong="H03808"\w* \w the fat|strong="H02459"\w* \w of My feast|strong="H02282"\w* \w remain|strong="H03885"\w* \w until|strong="H05704"\w* \w morning|strong="H01242"\w*.
