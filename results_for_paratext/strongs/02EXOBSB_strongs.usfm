\p \v 20 \w Moses|strong="H04872"\w* \w and Aaron|strong="H00175"\w* \w did|strong="H06213"\w* \w just as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had commanded|strong="H06680"\w*; \w in the presence|strong="H05869"\w* \w of Pharaoh|strong="H06547"\w* \w and his officials|strong="H05650"\w*, \w Aaron raised|strong="H07311"\w* \w the staff|strong="H04294"\w*\f + \fr 7:20 \ft Hebrew \fqa he raised the staff\ft ; see verse 19; some translators \fqa Moses raised the staff\ft .\f* \w and struck|strong="H05221"\w* \w the water|strong="H04325"\w* \w of the Nile|strong="H02975"\w*, \w and all|strong="H03605"\w* \w the water|strong="H04325"\w* \w was turned|strong="H02015"\w* \w to blood|strong="H01818"\w*. \v 21 \w The fish|strong="H01710"\w* \w in the Nile|strong="H02975"\w* \w died|strong="H04191"\w*, \w and the river|strong="H02975"\w* \w smelled so bad|strong="H00887"\w* \w that the Egyptians|strong="H04713"\w* \w could|strong="H03201"\w* \w not|strong="H03808"\w* \w drink|strong="H08354"\w* \w its|strong="H02975"\w* \w water|strong="H04325"\w*. \w And there was|strong="H01961"\w* \w blood|strong="H01818"\w* \w throughout|strong="H03605"\w* \w the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w*.
