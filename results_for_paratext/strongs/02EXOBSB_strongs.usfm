\s1 Idolatry Forbidden
\r (1 Corinthians 10:14–22)
\p \v 22 \w Then the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*, “\w This is what|strong="H03541"\w* \w you are to tell|strong="H00559"\w* \w the Israelites|strong="H01121"\w*: ‘\w You|strong="H00859"\w* \w have seen for yourselves|strong="H07200"\w* \w that|strong="H03588"\w* \w I have spoken|strong="H01696"\w* \w to|strong="H05973"\w* \w you from|strong="H04480"\w* \w heaven|strong="H08064"\w*. \v 23 \w You are not|strong="H03808"\w* \w to make|strong="H06213"\w* \w any gods|strong="H00430"\w* \w alongside Me|strong="H00854"\w*; \w you are not|strong="H03808"\w* \w to make|strong="H06213"\w* for yourselves \w gods|strong="H00430"\w* \w of silver|strong="H03701"\w* \w or gold|strong="H02091"\w*.
\p \v 24 \w You are to make|strong="H06213"\w* for Me \w an altar|strong="H04196"\w* \w of earth|strong="H00127"\w*, \w and sacrifice|strong="H02076"\w* \w on it|strong="H05921"\w* \w your burnt offerings|strong="H05930"\w* \w and peace offerings|strong="H08002"\w*, \w your sheep and goats|strong="H06629"\w* \w and cattle|strong="H01241"\w*. \w In every|strong="H03605"\w* \w place|strong="H04725"\w* \w where|strong="H00834"\w* \w I cause My name|strong="H08034"\w* \w to be remembered|strong="H02142"\w*, \w I will come|strong="H00935"\w* \w to you|strong="H00413"\w* \w and bless you|strong="H01288"\w*.
\p \v 25 \w Now if|strong="H00518"\w* \w you make|strong="H06213"\w* \w an altar|strong="H04196"\w* \w of stones|strong="H00068"\w* for Me, \w you must not|strong="H03808"\w* \w build|strong="H01129"\w* \w it|strong="H00853"\w* \w with stones shaped by tools|strong="H01496"\w*; \w for if|strong="H03588"\w* \w you use|strong="H05130"\w* \w a chisel|strong="H02719"\w* \w on it|strong="H05921"\w*, \w you will defile it|strong="H02490"\w*. \v 26 \w And you must not|strong="H03808"\w* \w go up|strong="H05927"\w* \w to|strong="H05921"\w* \w My altar|strong="H04196"\w* \w on steps|strong="H04609"\w*, \w lest|strong="H00834"\w* \w your nakedness|strong="H06172"\w* \w be exposed|strong="H01540"\w* \w on it|strong="H05921"\w*.’[’’]
\c 21
\s1 Hebrew Servants
\r (Deuteronomy 15:12–18)
\p \v 1 “\w These|strong="H00428"\w* \w are the ordinances|strong="H04941"\w* \w that|strong="H00834"\w* \w you are to set|strong="H07760"\w* \w before them|strong="H06440"\w*:
\p \v 2 \w If|strong="H03588"\w* \w you buy|strong="H07069"\w* \w a Hebrew|strong="H05680"\w* \w servant|strong="H05650"\w*, \w he is to serve you|strong="H05647"\w* \w for six|strong="H08337"\w* \w years|strong="H08141"\w*. \w But in the seventh year|strong="H07637"\w*, \w he shall go|strong="H03318"\w* \w free|strong="H02670"\w* \w without paying anything|strong="H02600"\w*. \v 3 \w If|strong="H00518"\w* \w he arrived alone|strong="H00935"\w*, \w he is to leave alone|strong="H03318"\w*; \w if|strong="H00518"\w* \w he|strong="H01931"\w* \w arrived with a wife|strong="H00802"\w*, \w she|strong="H00802"\w* \w is to leave|strong="H03318"\w* \w with him|strong="H05973"\w*. \v 4 \w If|strong="H00518"\w* \w his master|strong="H00113"\w* \w gives|strong="H05414"\w* him \w a wife|strong="H00802"\w* \w and she bears|strong="H03205"\w* him \w sons|strong="H01121"\w* \w or|strong="H00176"\w* \w daughters|strong="H01323"\w*, \w the woman|strong="H00802"\w* \w and her children|strong="H03206"\w* \w shall belong to|strong="H01961"\w* \w her master|strong="H00113"\w*, \w and only the man|strong="H01931"\w* \w shall go free|strong="H03318"\w*.
\p \v 5 \w But if|strong="H00518"\w* \w the servant|strong="H05650"\w* \w declares|strong="H00559"\w*, ‘\w I love|strong="H00157"\w* \w my master|strong="H00113"\w* \w and my wife|strong="H00802"\w* \w and children|strong="H01121"\w*; \w I do not|strong="H03808"\w* \w want to go|strong="H03318"\w* \w free|strong="H02670"\w*,’ \v 6 \w then his master|strong="H00113"\w* \w is to bring him|strong="H05066"\w* \w before|strong="H00413"\w* \w the judges|strong="H00430"\w*.\f + \fr 21:6 \ft Or \fqa before God\f* \w And he shall take him|strong="H05066"\w* \w to|strong="H00413"\w* \w the door|strong="H01817"\w* \w or|strong="H00176"\w* \w doorpost|strong="H04201"\w* \w and pierce|strong="H07527"\w* \w his ear|strong="H00241"\w* \w with an awl|strong="H04836"\w*. \w Then he shall serve his master|strong="H05647"\w* \w for life|strong="H05769"\w*.
\p \v 7 \w And if|strong="H03588"\w* \w a man|strong="H00376"\w* \w sells|strong="H04376"\w* \w his daughter|strong="H01323"\w* \w as a servant|strong="H00519"\w*, \w she is not|strong="H03808"\w* \w to go free|strong="H03318"\w* \w as the menservants do|strong="H05650"\w*. \v 8 \w If|strong="H00518"\w* \w she is displeasing|strong="H07451"\w* \w in the eyes|strong="H05869"\w* \w of her master|strong="H00113"\w* \w who|strong="H00834"\w* \w had designated her for himself|strong="H03259"\w*,\f + \fr 21:8 \ft Or \fqa so that he does not designate her for himself\f* \w he must allow her to be redeemed|strong="H06299"\w*. \w He has no|strong="H03808"\w* \w right|strong="H04910"\w* \w to sell her|strong="H04376"\w* \w to foreigners|strong="H05971"\w*, \w since he has broken faith|strong="H00898"\w* with her. \v 9 \w And if|strong="H00518"\w* \w he chooses her|strong="H03259"\w* \w for his son|strong="H01121"\w*, \w he must deal|strong="H06213"\w* with her \w as with|strong="H04941"\w* \w a daughter|strong="H01323"\w*. \v 10 \w If|strong="H00518"\w* \w he takes|strong="H03947"\w* \w another wife|strong="H00312"\w*, \w he must not|strong="H03808"\w* \w reduce|strong="H01639"\w* \w the food|strong="H07607"\w*, \w clothing|strong="H03682"\w*, \w or marital rights of his first wife|strong="H05772"\w*. \v 11 \w If, however|strong="H00518"\w*, \w he does not|strong="H03808"\w* \w provide|strong="H06213"\w* her \w with these|strong="H00428"\w* \w three things|strong="H07969"\w*, \w she is free to go|strong="H03318"\w* \w without|strong="H00369"\w* \w monetary payment|strong="H03701"\w*.
\s1 Personal Injury Laws
\p \v 12 \w Whoever strikes|strong="H05221"\w* \w and kills|strong="H04191"\w* \w a man|strong="H00376"\w* \w must surely be put to death|strong="H04191"\w*. \v 13 \w If, however|strong="H00834"\w*, \w he did not|strong="H03808"\w* \w lie in wait|strong="H06658"\w*, \w but God|strong="H00430"\w* \w allowed it to happen|strong="H00579"\w*, \w then I will appoint|strong="H07760"\w* for you \w a place|strong="H04725"\w* \w where|strong="H00834"\w* \w he may flee|strong="H05127"\w*.
\p \v 14 \w But if|strong="H03588"\w* \w a man|strong="H00376"\w* \w schemes|strong="H06195"\w* \w and acts willfully|strong="H02102"\w* \w against|strong="H05921"\w* \w his neighbor|strong="H07453"\w* \w to kill him|strong="H02026"\w*, \w you must take him|strong="H03947"\w* \w away from|strong="H05973"\w* \w My altar|strong="H04196"\w* \w to be put to death|strong="H04191"\w*.
\p \v 15 \w Whoever strikes|strong="H05221"\w* \w his father|strong="H00001"\w* \w or mother|strong="H00517"\w* \w must surely be put to death|strong="H04191"\w*.
\p \v 16 \w Whoever kidnaps|strong="H01589"\w* \w another man|strong="H00376"\w* \w must be put to death|strong="H04191"\w*, \w whether he sells him|strong="H04376"\w* \w or the man is found|strong="H04672"\w* \w in his possession|strong="H03027"\w*.
\p \v 17 \w Anyone who curses|strong="H07043"\w*\f + \fr 21:17 \ft Or \fqa dishonors \ft or \fqa reviles\f* \w his father|strong="H00001"\w* \w or mother|strong="H00517"\w* \w must surely be put to death|strong="H04191"\w*.\f + \fr 21:17 \ft Cited in Matthew 15:4 and Mark 7:10\f*
\p \v 18 \w If|strong="H03588"\w* \w men|strong="H00582"\w* \w are quarreling|strong="H07378"\w* \w and one|strong="H00376"\w* \w strikes|strong="H05221"\w* \w the other|strong="H07453"\w* \w with a stone|strong="H00068"\w* \w or|strong="H00176"\w* \w a fist|strong="H00106"\w*, \w and he does not|strong="H03808"\w* \w die|strong="H04191"\w* \w but is confined|strong="H05307"\w* \w to bed|strong="H04904"\w*, \v 19 \w then the one who struck him|strong="H05221"\w* \w shall go unpunished|strong="H05352"\w*, \w as long as|strong="H00518"\w* \w the other can get up|strong="H06965"\w* \w and walk around|strong="H01980"\w* \w outside|strong="H02351"\w* \w with|strong="H05921"\w* \w his staff|strong="H04938"\w*. \w Nevertheless|strong="H07535"\w*, \w he must compensate|strong="H05414"\w* \w the man for his lost work|strong="H07674"\w* \w and see that he is completely healed|strong="H07495"\w*.
\p \v 20 \w If|strong="H03588"\w* \w a man|strong="H00376"\w* \w strikes|strong="H05221"\w* \w his manservant|strong="H05650"\w* \w or|strong="H00176"\w* \w maidservant|strong="H00519"\w* \w with a rod|strong="H07626"\w*, \w and the servant dies|strong="H04191"\w* \w by|strong="H08478"\w* \w his hand|strong="H03027"\w*, \w he shall surely be punished|strong="H05358"\w*. \v 21 \w However|strong="H00389"\w*, \w if|strong="H00518"\w* \w the servant gets up|strong="H05975"\w* \w after a day|strong="H03117"\w* \w or|strong="H00176"\w* \w two|strong="H03117"\w*, \w the owner shall not|strong="H03808"\w* \w be punished|strong="H05358"\w*, \w since|strong="H03588"\w* \w the servant is|strong="H01931"\w* \w his property|strong="H03701"\w*.
\p \v 22 \w If|strong="H03588"\w* \w men|strong="H00582"\w* \w who are fighting|strong="H05327"\w* \w strike|strong="H05062"\w* \w a pregnant|strong="H02030"\w* \w woman|strong="H00802"\w* \w and her child|strong="H03206"\w* \w is born prematurely|strong="H03318"\w*,\f + \fr 21:22 \ft Literally \fqa and her children come out\f* \w but there is|strong="H01961"\w* \w no further|strong="H03808"\w* \w injury|strong="H00611"\w*, \w he shall surely be fined|strong="H06064"\w* \w as|strong="H00834"\w* \w the woman’s|strong="H00802"\w* \w husband|strong="H01167"\w* \w demands|strong="H07896"\w* \w and as the court allows|strong="H05414"\w*. \v 23 \w But if|strong="H00518"\w* \w a serious injury|strong="H00611"\w* \w results|strong="H01961"\w*, \w then you must require|strong="H05414"\w* \w a life|strong="H05315"\w* \w for|strong="H08478"\w* \w a life|strong="H05315"\w* — \v 24 \w eye|strong="H05869"\w* \w for|strong="H08478"\w* \w eye|strong="H05869"\w*, \w tooth|strong="H08127"\w* \w for|strong="H08478"\w* \w tooth|strong="H08127"\w*,\f + \fr 21:24 \ft Cited in Matthew 5:38\f* \w hand|strong="H03027"\w* \w for|strong="H08478"\w* \w hand|strong="H03027"\w*, \w foot|strong="H07272"\w* \w for|strong="H08478"\w* \w foot|strong="H07272"\w*, \v 25 \w burn|strong="H03555"\w* \w for|strong="H08478"\w* \w burn|strong="H03555"\w*, \w wound|strong="H06482"\w* \w for|strong="H08478"\w* \w wound|strong="H06482"\w*, \w and stripe|strong="H02250"\w* \w for|strong="H08478"\w* \w stripe|strong="H02250"\w*.
\p \v 26 \w If|strong="H03588"\w* \w a man|strong="H00376"\w* \w strikes|strong="H05221"\w* \w and blinds|strong="H07843"\w* \w the eye|strong="H05869"\w* \w of his manservant|strong="H05650"\w* \w or|strong="H00176"\w* \w maidservant|strong="H00519"\w*, \w he must let the servant go|strong="H07971"\w* \w free|strong="H02670"\w* \w as compensation for|strong="H08478"\w* \w the eye|strong="H05869"\w*. \v 27 \w And if|strong="H00518"\w* \w he knocks out|strong="H05307"\w* \w the tooth|strong="H08127"\w* \w of his manservant|strong="H05650"\w* \w or|strong="H00176"\w* \w maidservant|strong="H00519"\w*, \w he must let the servant go|strong="H07971"\w* \w free|strong="H02670"\w* \w as compensation for|strong="H08478"\w* \w the tooth|strong="H08127"\w*.
\p \v 28 \w If|strong="H03588"\w* \w an ox|strong="H07794"\w*\f + \fr 21:28 \ft Or \fqa a bull\ft ; also in verses 29–36\f* \w gores|strong="H05055"\w* \w a man|strong="H00376"\w* \w or|strong="H00176"\w* \w woman|strong="H00802"\w* \w to death|strong="H04191"\w*, \w the ox|strong="H07794"\w* \w must surely be stoned|strong="H05619"\w*, \w and its meat|strong="H01320"\w* \w must not|strong="H03808"\w* \w be eaten|strong="H00398"\w*. \w But the owner|strong="H01167"\w* \w of the ox|strong="H07794"\w* \w shall not be held responsible|strong="H05355"\w*.
\p \v 29 \w But if|strong="H00518"\w* \w the ox|strong="H07794"\w* \w has a habit|strong="H08543"\w* \w of goring|strong="H05056"\w*, \w and its owner|strong="H01167"\w* \w has been warned|strong="H05749"\w* \w yet does not|strong="H03808"\w* \w restrain it|strong="H08104"\w*, \w and it kills|strong="H04191"\w* \w a man|strong="H00376"\w* \w or|strong="H00176"\w* \w woman|strong="H00802"\w*, \w then the ox|strong="H07794"\w* \w must be stoned|strong="H05619"\w* \w and its owner|strong="H01167"\w* \w must also|strong="H01571"\w* \w be put to death|strong="H04191"\w*. \v 30 \w If|strong="H00518"\w* \w payment|strong="H03724"\w* \w is demanded|strong="H07896"\w* \w of him instead|strong="H05921"\w*, \w he may redeem|strong="H06306"\w* \w his life|strong="H05315"\w* \w by paying|strong="H05414"\w* \w the full|strong="H03605"\w* \w amount demanded|strong="H07896"\w* \w of him|strong="H05921"\w*.
\p \v 31 \w If|strong="H00176"\w* \w the ox gores|strong="H05055"\w* \w a son|strong="H01121"\w* \w or|strong="H00176"\w* \w a daughter|strong="H01323"\w*, \w it shall be done|strong="H06213"\w* to him \w according to the same|strong="H02088"\w* \w rule|strong="H04941"\w*.
\p \v 32 \w If|strong="H00518"\w* \w the ox|strong="H07794"\w* \w gores|strong="H05055"\w* \w a manservant|strong="H05650"\w* \w or|strong="H00176"\w* \w maidservant|strong="H00519"\w*, \w the owner must pay|strong="H05414"\w* \w thirty|strong="H07970"\w* \w shekels|strong="H08255"\w* \w of silver|strong="H03701"\w*\f + \fr 21:32 \fqa 30 shekels \ft is approximately 12 ounces or 342 grams of silver.\f* \w to the master of that servant|strong="H00113"\w*, \w and the ox|strong="H07794"\w* \w must be stoned|strong="H05619"\w*.
\p \v 33 \w If|strong="H03588"\w* \w a man|strong="H00376"\w* \w opens|strong="H06605"\w* \w or|strong="H00176"\w* \w digs|strong="H03738"\w* \w a pit|strong="H00953"\w* \w and fails|strong="H03808"\w* \w to cover it|strong="H03680"\w*, \w and an ox|strong="H07794"\w* \w or|strong="H00176"\w* \w a donkey|strong="H02543"\w* \w falls|strong="H05307"\w* \w into it|strong="H08033"\w*, \v 34 \w the owner|strong="H01167"\w* \w of the pit|strong="H00953"\w* \w shall make restitution|strong="H07999"\w*; \w he must pay|strong="H07725"\w* \w its owner|strong="H01167"\w*, \w and the dead animal|strong="H04191"\w* \w will be|strong="H01961"\w* his.
\p \v 35 \w If|strong="H03588"\w* \w a man’s|strong="H00376"\w* \w ox|strong="H07794"\w* \w injures|strong="H05062"\w* \w his neighbor’s|strong="H07453"\w* \w ox|strong="H07794"\w* \w and it dies|strong="H04191"\w*, \w they must sell|strong="H04376"\w* \w the live|strong="H02416"\w* \w one|strong="H07794"\w* \w and divide|strong="H02673"\w* \w the proceeds|strong="H03701"\w*; \w they also must|strong="H01571"\w* \w divide|strong="H02673"\w* \w the dead animal|strong="H04191"\w*. \v 36 \w But if|strong="H00176"\w* \w it was known|strong="H03045"\w* \w that|strong="H03588"\w* \w the ox|strong="H07794"\w* \w had a habit|strong="H08543"\w* \w of goring|strong="H05056"\w*, \w yet its owner|strong="H01167"\w* \w failed|strong="H03808"\w* \w to restrain it|strong="H08104"\w*, \w he shall pay full compensation|strong="H07999"\w*, \w ox|strong="H07794"\w* \w for|strong="H08478"\w* \w ox|strong="H07794"\w*, \w and the dead animal|strong="H04191"\w* \w will be|strong="H01961"\w* his.[’’]
\c 22
\s1 Property Laws
\p \v 1 “\w If|strong="H03588"\w* \w a man|strong="H00376"\w* \w steals|strong="H01589"\w* \w an ox|strong="H07794"\w*\f + \fr 22:1 \ft Or \fqa a bull \ft or \fqa a cow\ft ; also in verses 4, 9, and 10\f* \w or|strong="H00176"\w* \w a sheep|strong="H07716"\w* \w and slaughters|strong="H02873"\w* \w or|strong="H00176"\w* \w sells it|strong="H04376"\w*, \w he must repay|strong="H07999"\w* \w five|strong="H02568"\w* \w oxen|strong="H01241"\w* \w for|strong="H08478"\w* \w an ox|strong="H07794"\w* \w and four|strong="H00702"\w* \w sheep|strong="H07716"\w* \w for a sheep|strong="H06629"\w*.
\p \v 2 \w If|strong="H00518"\w* \w a thief|strong="H01590"\w* \w is caught|strong="H04672"\w* \w breaking in|strong="H04290"\w* \w and is beaten|strong="H05221"\w* \w to death|strong="H04191"\w*, \w no one|strong="H00369"\w* \w shall be guilty of bloodshed|strong="H01818"\w*. \v 3 \w But if|strong="H00518"\w* \w it happens after sunrise|strong="H02224"\w*, \w there is guilt for his bloodshed|strong="H01818"\w*.
\p \w A thief must make full restitution|strong="H07999"\w*; \w if|strong="H00518"\w* \w he has nothing|strong="H00369"\w*, \w he himself shall be sold|strong="H04376"\w* \w for his theft|strong="H01591"\w*. \v 4 \w If what was stolen|strong="H00518"\w* \w is actually found|strong="H04672"\w* \w alive|strong="H02416"\w* \w in his possession|strong="H03027"\w*— \w whether ox|strong="H07794"\w* \w or|strong="H05704"\w* \w donkey|strong="H02543"\w* \w or|strong="H05704"\w* \w sheep|strong="H07716"\w*— \w he must pay back|strong="H07999"\w* \w double|strong="H08147"\w*.
\p \v 5 \w If|strong="H03588"\w* \w a man|strong="H00376"\w* \w grazes his livestock|strong="H01197"\w* \w in a field|strong="H07704"\w* \w or|strong="H00176"\w* \w vineyard|strong="H03754"\w* \w and allows them|strong="H01165"\w* \w to stray|strong="H07971"\w* \w so that they graze|strong="H01197"\w* \w in someone else’s|strong="H00312"\w* \w field|strong="H07704"\w*, \w he must make restitution|strong="H07999"\w* \w from the best|strong="H04315"\w* \w of his own field|strong="H07704"\w* \w or vineyard|strong="H03754"\w*.
\p \v 6 \w If|strong="H03588"\w* \w a fire|strong="H00784"\w* \w breaks out|strong="H03318"\w* \w and spreads|strong="H04672"\w* \w to thornbushes|strong="H06975"\w* \w so that it consumes|strong="H00398"\w* \w stacked|strong="H01430"\w* \w or|strong="H00176"\w* \w standing grain|strong="H07054"\w*, \w or|strong="H00176"\w* \w the whole field|strong="H07704"\w*, \w the one who started|strong="H01197"\w* \w the fire|strong="H01200"\w* \w must make full restitution|strong="H07999"\w*.
\p \v 7 \w If|strong="H03588"\w* \w a man|strong="H00376"\w* \w gives|strong="H05414"\w* \w his neighbor|strong="H07453"\w* \w money|strong="H03701"\w* \w or|strong="H00176"\w* \w goods|strong="H03627"\w* \w for safekeeping|strong="H08104"\w* \w and they are stolen|strong="H01589"\w* \w from the neighbor’s|strong="H00376"\w* \w house|strong="H01004"\w*, \w the thief|strong="H01590"\w*, \w if|strong="H00518"\w* \w caught|strong="H04672"\w*, \w must pay back|strong="H07999"\w* \w double|strong="H08147"\w*. \v 8 \w If|strong="H00518"\w* \w the thief|strong="H01590"\w* \w is not|strong="H03808"\w* \w found|strong="H04672"\w*, \w the owner|strong="H01167"\w* \w of the house|strong="H01004"\w* \w must appear|strong="H07126"\w* \w before|strong="H00413"\w* \w the judges|strong="H00430"\w*\f + \fr 22:8 \ft Or \fqa before God\ft ; also in verse 9\f* \w to determine whether|strong="H00518"\w* \w he has taken|strong="H07971"\w* \w his neighbor’s|strong="H07453"\w* \w property|strong="H04399"\w*.
\p \v 9 \w In|strong="H05921"\w* \w all|strong="H03605"\w* \w cases|strong="H01697"\w* \w of illegal possession|strong="H06588"\w* \w of|strong="H05921"\w* \w an ox|strong="H07794"\w*, \w a donkey|strong="H02543"\w*, \w a sheep|strong="H07716"\w*, \w a garment|strong="H08008"\w*, \w or any|strong="H03605"\w* \w lost item|strong="H00009"\w* \w that|strong="H00834"\w* \w someone claims|strong="H00559"\w*, ‘\w This|strong="H02088"\w* \w is mine|strong="H01931"\w*,’ \w both parties|strong="H08147"\w* \w shall bring|strong="H00935"\w* \w their cases|strong="H01697"\w* \w before|strong="H05704"\w* \w the judges|strong="H00430"\w*. \w The one whom the judges|strong="H00430"\w* \w find guilty|strong="H07561"\w*\f + \fr 22:9 \ft Or \fqa whom God condemns\f* \w must pay back|strong="H07999"\w* \w double|strong="H08147"\w* \w to his neighbor|strong="H07453"\w*.
