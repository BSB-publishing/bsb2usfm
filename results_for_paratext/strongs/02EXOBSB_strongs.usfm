\c 23
\s1 Justice and Mercy
\p \v 1 “\w You shall not|strong="H03808"\w* \w spread|strong="H05375"\w* \w a false|strong="H07723"\w* \w report|strong="H08088"\w*. \w Do not|strong="H00408"\w* \w join|strong="H07896"\w* \w the wicked|strong="H07563"\w* \w by being|strong="H01961"\w* \w a malicious|strong="H02555"\w* \w witness|strong="H05707"\w*.
