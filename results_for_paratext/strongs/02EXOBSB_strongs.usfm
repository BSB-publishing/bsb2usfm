\p \v 1 \w Then the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*, “\w Chisel out|strong="H06458"\w* \w two|strong="H08147"\w* \w stone|strong="H00068"\w* \w tablets|strong="H03871"\w* \w like the originals|strong="H07223"\w*, \w and I will write|strong="H03789"\w* \w on|strong="H05921"\w* \w them|strong="H03871"\w* \w the words|strong="H01697"\w* \w that|strong="H00834"\w* \w were|strong="H01961"\w* \w on|strong="H05921"\w* \w the first|strong="H07223"\w* \w tablets|strong="H03871"\w*, \w which|strong="H00834"\w* \w you broke|strong="H07665"\w*. \v 2 \w Be|strong="H01961"\w* \w ready|strong="H03559"\w* \w in the morning|strong="H01242"\w*, \w and come up|strong="H05927"\w* \w on Mount|strong="H02022"\w* \w Sinai|strong="H05514"\w* \w to present yourself|strong="H05324"\w* before Me \w on|strong="H05921"\w* \w the mountaintop|strong="H07218"\w*. \v 3 \w No|strong="H03808"\w* \w one|strong="H00376"\w* \w may go up|strong="H05927"\w* \w with you|strong="H05973"\w*; \w in fact|strong="H01571"\w*, \w no|strong="H00408"\w* \w one|strong="H00376"\w* \w may be seen|strong="H07200"\w* \w anywhere|strong="H03605"\w* \w on the mountain|strong="H02022"\w* — \w not|strong="H00408"\w* \w even|strong="H01571"\w* \w the flocks|strong="H06629"\w* \w or herds|strong="H01241"\w* \w may graze|strong="H07462"\w* \w in front of|strong="H00413"\w* \w the|strong="H01931"\w* \w mountain|strong="H02022"\w*.”
\p \v 4 \w So Moses|strong="H04872"\w* \w chiseled out|strong="H06458"\w* \w two|strong="H08147"\w* \w stone|strong="H00068"\w* \w tablets|strong="H03871"\w* \w like the originals|strong="H07223"\w*. \w He rose early|strong="H07925"\w* \w in the morning|strong="H01242"\w*, \w and taking|strong="H03947"\w* \w the two|strong="H08147"\w* \w stone|strong="H00068"\w* \w tablets|strong="H03871"\w* \w in his hands|strong="H03027"\w*, \w he went up|strong="H05927"\w* \w Mount|strong="H02022"\w* \w Sinai|strong="H05514"\w* \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had commanded him|strong="H06680"\w*.
