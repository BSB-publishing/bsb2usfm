\p \v 1 \w After that|strong="H00310"\w*, \w Moses|strong="H04872"\w* \w and Aaron|strong="H00175"\w* \w went|strong="H00935"\w* \w to|strong="H00413"\w* \w Pharaoh|strong="H06547"\w* \w and said|strong="H00559"\w*, “\w This is what|strong="H03541"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w says|strong="H00559"\w*: ‘\w Let My people|strong="H05971"\w* \w go|strong="H07971"\w*, \w so that they may hold a feast|strong="H02287"\w* to Me \w in the wilderness|strong="H04057"\w*.’”
\p \v 2 \w But Pharaoh|strong="H06547"\w* \w replied|strong="H00559"\w*, “\w Who|strong="H04310"\w* \w is the LORD|strong="H03068"\w* \w that|strong="H00834"\w* \w I should obey|strong="H08085"\w* \w His voice|strong="H06963"\w* \w and let Israel|strong="H03478"\w* \w go|strong="H07971"\w*? \w I do not|strong="H03808"\w* \w know|strong="H03045"\w* \w the LORD|strong="H03068"\w*, \w and|strong="H01571"\w* \w I will not|strong="H03808"\w* \w let Israel|strong="H03478"\w* \w go|strong="H07971"\w*.”
