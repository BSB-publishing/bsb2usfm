\p \v 6 \w Moreover, I|strong="H00589"\w* \w have selected|strong="H05414"\w* \w Oholiab|strong="H00171"\w* \w son|strong="H01121"\w* \w of Ahisamach|strong="H00294"\w*, \w of the tribe|strong="H04294"\w* \w of Dan|strong="H01835"\w*, \w as his assistant|strong="H00854"\w*.
\p \w I have also given|strong="H05414"\w* \w skill|strong="H02451"\w* \w to all|strong="H03605"\w* \w the craftsmen|strong="H02450"\w*, \w that they may fashion|strong="H06213"\w* \w all|strong="H03605"\w* \w that|strong="H00834"\w* \w I have commanded you|strong="H06680"\w*: \v 7 \w the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*, \w the ark|strong="H00727"\w* \w of the Testimony|strong="H05715"\w*\f + \fr 31:7 \ft That is, \fqa the ark of the covenant\f* \w and|strong="H00853"\w* \w the mercy seat|strong="H03727"\w* \w upon it|strong="H05921"\w*, \w and all|strong="H03605"\w* \w the other furnishings|strong="H03627"\w* \w of the tent|strong="H00168"\w*— \v 8 \w the table|strong="H07979"\w* \w with its utensils|strong="H03627"\w*, \w the pure|strong="H02889"\w* \w gold lampstand|strong="H04501"\w* \w with all|strong="H03605"\w* \w its utensils|strong="H03627"\w*, \w the altar|strong="H04196"\w* \w of incense|strong="H07004"\w*, \v 9 \w the altar|strong="H04196"\w* \w of burnt offering|strong="H05930"\w* \w with all|strong="H03605"\w* \w its utensils|strong="H03627"\w*, \w and|strong="H00853"\w* \w the basin|strong="H03595"\w* \w with its stand|strong="H03653"\w*— \v 10 \w as well as|strong="H00853"\w* \w the woven|strong="H08278"\w* \w garments|strong="H00899"\w*, \w both the holy|strong="H06944"\w* \w garments|strong="H00899"\w* \w for Aaron|strong="H00175"\w* \w the priest|strong="H03548"\w* \w and the garments|strong="H00899"\w* \w for his sons|strong="H01121"\w* \w to serve as priests|strong="H03547"\w*, \v 11 \w in addition to|strong="H00853"\w* \w the anointing|strong="H04888"\w* \w oil|strong="H08081"\w* \w and fragrant|strong="H05561"\w* \w incense|strong="H07004"\w* \w for the Holy Place|strong="H06944"\w*. \w They are to make them|strong="H06213"\w* \w according to all|strong="H03605"\w* \w that|strong="H00834"\w* \w I have commanded you|strong="H06680"\w*.”
