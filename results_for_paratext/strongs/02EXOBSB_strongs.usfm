\c 6
\s1 God Promises Deliverance
\p \v 1 \w But the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*, “\w Now|strong="H06258"\w* \w you will see|strong="H07200"\w* \w what|strong="H00834"\w* \w I will do|strong="H06213"\w* \w to Pharaoh|strong="H06547"\w*, \w for|strong="H03588"\w* \w because of My mighty|strong="H02389"\w* \w hand|strong="H03027"\w* \w he will let the people go|strong="H07971"\w*; \w because of My strong|strong="H02389"\w* \w hand|strong="H03027"\w* \w he will drive them out of|strong="H01644"\w* \w his land|strong="H00776"\w*.”
\p \v 2 \w God also|strong="H00430"\w* \w told|strong="H01696"\w* \w Moses|strong="H04872"\w*, “\w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w*. \v 3 \w I appeared|strong="H07200"\w* \w to|strong="H00413"\w* \w Abraham|strong="H00085"\w*, \w to|strong="H00413"\w* \w Isaac|strong="H03327"\w*, \w and to|strong="H00413"\w* \w Jacob|strong="H03290"\w* \w as God|strong="H00410"\w* \w Almighty|strong="H07706"\w*,\f + \fr 6:3 \ft Hebrew \fqa El-Shaddai\f* \w but by My name|strong="H08034"\w* \w the LORD|strong="H03068"\w* \w I did not|strong="H03808"\w* \w make Myself known|strong="H03045"\w* to them. \v 4 \w I also|strong="H01571"\w* \w established|strong="H06965"\w* \w My covenant|strong="H01285"\w* \w with them|strong="H00854"\w* \w to give|strong="H05414"\w* them \w the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*, \w the land|strong="H00776"\w* \w where|strong="H00834"\w* \w they lived as foreigners|strong="H01481"\w*. \v 5 \w Furthermore|strong="H01571"\w*, \w I|strong="H00589"\w* \w have heard|strong="H08085"\w* \w the groaning|strong="H05009"\w* \w of the Israelites|strong="H03478"\w*, \w whom|strong="H00834"\w* \w the Egyptians|strong="H04714"\w* \w are enslaving|strong="H05647"\w*, \w and I have remembered|strong="H02142"\w* \w My covenant|strong="H01285"\w*.
\p \v 6 \w Therefore|strong="H03651"\w* \w tell|strong="H00559"\w* \w the Israelites|strong="H01121"\w*: ‘\w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w*, \w and I will bring|strong="H03318"\w* \w you|strong="H00853"\w* \w out from under|strong="H08478"\w* \w the yoke|strong="H05450"\w* \w of the Egyptians|strong="H04714"\w* \w and deliver|strong="H05337"\w* \w you|strong="H00853"\w* \w from their bondage|strong="H05656"\w*. \w I will redeem|strong="H01350"\w* \w you|strong="H00853"\w* \w with an outstretched|strong="H05186"\w* \w arm|strong="H02220"\w* \w and with mighty|strong="H01419"\w* \w acts of judgment|strong="H08201"\w*. \v 7 \w I will take|strong="H03947"\w* \w you|strong="H00853"\w* as My own \w people|strong="H05971"\w*, \w and I will be|strong="H01961"\w* your \w God|strong="H00430"\w*. \w Then you will know|strong="H03045"\w* \w that|strong="H03588"\w* \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*, \w who brought|strong="H03318"\w* \w you|strong="H00853"\w* \w out from under|strong="H08478"\w* \w the yoke|strong="H05450"\w* \w of the Egyptians|strong="H04714"\w*. \v 8 \w And I will bring|strong="H00935"\w* \w you|strong="H00853"\w* \w into|strong="H00413"\w* \w the land|strong="H00776"\w* \w that|strong="H00834"\w* \w I swore|strong="H05375"\w* \w to give|strong="H05414"\w* \w to Abraham|strong="H00085"\w*, \w Isaac|strong="H03327"\w*, \w and Jacob|strong="H03290"\w*. \w I will give|strong="H05414"\w* \w it|strong="H00853"\w* to you \w as a possession|strong="H04181"\w*. \w I|strong="H00589"\w* \w am the LORD|strong="H03068"\w*!’”
\p \v 9 \w Moses|strong="H04872"\w* \w relayed|strong="H01696"\w* \w this message|strong="H03651"\w* \w to|strong="H00413"\w* \w the Israelites|strong="H01121"\w*, \w but on account of their broken|strong="H07115"\w* \w spirit|strong="H07307"\w* \w and cruel|strong="H07186"\w* \w bondage|strong="H05656"\w*, \w they did not|strong="H03808"\w* \w listen|strong="H08085"\w* \w to|strong="H00413"\w* \w him|strong="H04872"\w*.
\p \v 10 \w So the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*, \v 11 “\w Go|strong="H00935"\w* \w and tell|strong="H01696"\w* \w Pharaoh|strong="H06547"\w* \w king|strong="H04428"\w* \w of Egypt|strong="H04714"\w* \w to let the Israelites|strong="H01121"\w* \w go out|strong="H07971"\w* \w of his land|strong="H00776"\w*.”
\p \v 12 \w But in the LORD’s|strong="H03068"\w* \w presence|strong="H06440"\w* \w Moses|strong="H04872"\w* \w replied|strong="H01696"\w*, “\w If|strong="H02005"\w* \w the Israelites|strong="H01121"\w* \w will not|strong="H03808"\w* \w listen|strong="H08085"\w* \w to me|strong="H00413"\w*, \w then why|strong="H00349"\w* \w would Pharaoh|strong="H06547"\w* \w listen to me|strong="H08085"\w*, \w since I|strong="H00589"\w* \w am unskilled|strong="H06189"\w* \w in speech|strong="H08193"\w*?\f + \fr 6:12 \ft Hebrew \fqa I have uncircumcised lips\ft ; also in verse 30\f*”
\p \v 13 \w Then the LORD|strong="H03068"\w* \w spoke|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w and Aaron|strong="H00175"\w* \w and gave them a charge|strong="H06680"\w* \w concerning|strong="H00413"\w* \w both the Israelites|strong="H01121"\w* \w and Pharaoh|strong="H06547"\w* \w king|strong="H04428"\w* \w of Egypt|strong="H04714"\w*, \w to bring|strong="H03318"\w* \w the Israelites|strong="H01121"\w* \w out of the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w*.
\s1 Genealogies of Moses and Aaron
