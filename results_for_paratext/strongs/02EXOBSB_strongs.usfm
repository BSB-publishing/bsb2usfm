\p \v 36 \w Whenever the cloud|strong="H06051"\w* \w was lifted|strong="H05927"\w* \w from|strong="H05921"\w* \w above the tabernacle|strong="H04908"\w*, \w the Israelites|strong="H01121"\w* \w would set out|strong="H05265"\w* \w through all|strong="H03605"\w* \w the stages of their journey|strong="H04550"\w*. \v 37 \w If|strong="H00518"\w* \w the cloud|strong="H06051"\w* \w was not|strong="H03808"\w* \w lifted|strong="H05927"\w*, \w they would not|strong="H03808"\w* \w set out|strong="H05265"\w* \w until|strong="H05704"\w* \w the day|strong="H03117"\w* \w it was taken up|strong="H05927"\w*. \v 38 \w For|strong="H03588"\w* \w the cloud|strong="H06051"\w* \w of the LORD|strong="H03068"\w* \w was over|strong="H05921"\w* \w the tabernacle|strong="H04908"\w* \w by day|strong="H03119"\w*, \w and fire|strong="H00784"\w* \w was|strong="H01961"\w* in the cloud \w by night|strong="H03915"\w*, \w in the sight|strong="H05869"\w* \w of all|strong="H03605"\w* \w the house|strong="H01004"\w* \w of Israel|strong="H03478"\w* \w through all|strong="H03605"\w* \w their journeys|strong="H04550"\w*.
