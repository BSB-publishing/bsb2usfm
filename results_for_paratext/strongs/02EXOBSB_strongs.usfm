\p \v 27 \w Then they came|strong="H00935"\w* \w to Elim|strong="H00362"\w*, \w where|strong="H08033"\w* \w there were twelve|strong="H08147"\w* \w springs|strong="H05869"\w* \w of water|strong="H04325"\w* \w and seventy|strong="H07657"\w* \w palm trees|strong="H08558"\w*, \w and they camped|strong="H02583"\w* \w there|strong="H08033"\w* \w by|strong="H05921"\w* \w the waters|strong="H04325"\w*.
\c 16
\s1 Manna and Quail from Heaven
