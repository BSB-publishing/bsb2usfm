\p \v 1 \w The LORD|strong="H03068"\w* \w answered|strong="H00559"\w* \w Moses|strong="H04872"\w*, “\w See|strong="H07200"\w*, \w I have made|strong="H05414"\w* \w you like God|strong="H00430"\w* \w to Pharaoh|strong="H06547"\w*, \w and your brother|strong="H00251"\w* \w Aaron|strong="H00175"\w* \w will be|strong="H01961"\w* \w your prophet|strong="H05030"\w*. \v 2 \w You|strong="H00859"\w* \w are to speak|strong="H01696"\w* \w all|strong="H03605"\w* \w that|strong="H00834"\w* \w I command you|strong="H06680"\w*, \w and your brother|strong="H00251"\w* \w Aaron|strong="H00175"\w* \w is to tell|strong="H01696"\w* \w Pharaoh|strong="H06547"\w* \w to let the Israelites|strong="H01121"\w* \w go|strong="H07971"\w* \w out of his land|strong="H00776"\w*.
