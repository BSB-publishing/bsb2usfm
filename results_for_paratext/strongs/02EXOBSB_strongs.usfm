\p \v 24 \w He also placed|strong="H07760"\w* \w the lampstand|strong="H04501"\w* \w in the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w* \w opposite|strong="H05227"\w* \w the table|strong="H07979"\w* \w on|strong="H05921"\w* \w the south|strong="H05045"\w* \w side|strong="H03409"\w* \w of the tabernacle|strong="H04908"\w* \v 25 \w and set up|strong="H05927"\w* \w the lamps|strong="H05216"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*, \w just as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had commanded|strong="H06680"\w* \w him|strong="H04872"\w*.
