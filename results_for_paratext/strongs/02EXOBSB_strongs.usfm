\p \v 7 \w Now Moses|strong="H04872"\w* \w used to take|strong="H03947"\w* \w the tent|strong="H00168"\w* \w and pitch|strong="H05186"\w* it \w at a distance|strong="H07368"\w* \w outside|strong="H04480"\w* \w the camp|strong="H04264"\w*. \w He called|strong="H07121"\w* it \w the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*, \w and|strong="H01961"\w* \w anyone|strong="H03605"\w* \w inquiring of|strong="H01245"\w* \w the LORD|strong="H03068"\w* \w would go|strong="H03318"\w* \w to|strong="H00413"\w* \w the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w* \w outside|strong="H02351"\w* \w the camp|strong="H04264"\w*. \v 8 \w Then|strong="H01961"\w*, \w whenever Moses|strong="H04872"\w* \w went out|strong="H03318"\w* \w to|strong="H00413"\w* \w the tent|strong="H00168"\w*, \w all|strong="H03605"\w* \w the people|strong="H05971"\w* \w would stand|strong="H06965"\w* \w at the entrances|strong="H06607"\w* \w to their own tents|strong="H00168"\w* \w and watch|strong="H05027"\w* \w Moses|strong="H04872"\w* \w until|strong="H05704"\w* \w he entered|strong="H00935"\w* \w the tent|strong="H00168"\w*. \v 9 \w As|strong="H01961"\w* \w Moses|strong="H04872"\w* \w entered|strong="H00935"\w* \w the tent|strong="H00168"\w*, \w the pillar|strong="H05982"\w* \w of cloud|strong="H06051"\w* \w would come down|strong="H03381"\w* \w and remain|strong="H05975"\w* \w at the entrance|strong="H06607"\w*, \w and the LORD would speak|strong="H01696"\w* \w with|strong="H05973"\w* \w Moses|strong="H04872"\w*. \v 10 \w When all|strong="H03605"\w* \w the people|strong="H05971"\w* \w saw|strong="H07200"\w* \w the pillar|strong="H05982"\w* \w of cloud|strong="H06051"\w* \w standing|strong="H05975"\w* \w at the entrance|strong="H06607"\w* \w to the tent|strong="H00168"\w*, \w they|strong="H03605"\w* \w would stand up|strong="H06965"\w* \w and worship|strong="H07812"\w*, \w each one|strong="H00376"\w* \w at the entrance|strong="H06607"\w* \w to his own tent|strong="H00168"\w*.
