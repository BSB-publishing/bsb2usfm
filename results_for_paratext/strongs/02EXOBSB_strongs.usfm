\li1 \w the anointing|strong="H04888"\w* \w oil|strong="H08081"\w* \w and fragrant|strong="H05561"\w* \w incense|strong="H07004"\w*;
\li1 \w the curtain|strong="H04539"\w* \w for the doorway|strong="H06607"\w* \w at the entrance|strong="H06607"\w* \w to the tabernacle|strong="H04908"\w*;
