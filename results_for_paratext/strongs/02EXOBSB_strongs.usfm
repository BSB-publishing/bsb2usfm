\p \v 1 \w Then the LORD said|strong="H00559"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*, “\w Come up|strong="H05927"\w* \w to|strong="H00413"\w* \w the LORD|strong="H03068"\w* — \w you|strong="H00859"\w* \w and Aaron|strong="H00175"\w*, \w Nadab|strong="H05070"\w* \w and Abihu|strong="H00030"\w*, \w and seventy|strong="H07657"\w* \w of Israel’s|strong="H03478"\w* \w elders|strong="H02205"\w* — \w and you are to worship|strong="H07812"\w* \w at a distance|strong="H07350"\w*. \v 2 \w Moses|strong="H04872"\w* \w alone|strong="H00905"\w* \w shall approach|strong="H05066"\w* \w the LORD|strong="H03068"\w*, \w but the others|strong="H01992"\w* \w must not|strong="H03808"\w* \w come near|strong="H05066"\w*. \w And the people|strong="H05971"\w* \w may not|strong="H03808"\w* \w go up|strong="H05927"\w* \w with him|strong="H05973"\w*.”
