\p \v 1 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*, \v 2 “\w On the first|strong="H00259"\w* \w day|strong="H03117"\w* \w of the first|strong="H07223"\w* \w month|strong="H02320"\w* \w you are to set up|strong="H06965"\w* \w the tabernacle|strong="H04908"\w*, \w the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*. \v 3 \w Put|strong="H07760"\w* \w the ark|strong="H00727"\w* \w of the Testimony|strong="H05715"\w*\f + \fr 40:3 \ft That is, \fqa the ark of the covenant\ft ; also in verses 5 and 21\f* \w in it|strong="H08033"\w* \w and screen|strong="H05526"\w* \w off|strong="H05921"\w* \w the ark|strong="H00727"\w* \w with the veil|strong="H06532"\w*. \v 4 \w Then bring in|strong="H00935"\w* \w the table|strong="H07979"\w* \w and set out|strong="H06186"\w* \w its arrangement|strong="H06187"\w*; \w bring in|strong="H00935"\w* \w the lampstand as well|strong="H04501"\w*, \w and set up|strong="H05927"\w* \w its lamps|strong="H05216"\w*.
