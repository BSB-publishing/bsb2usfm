\p \v 1 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*, \v 2 “\w Consecrate|strong="H06942"\w* to Me \w every|strong="H03605"\w* \w firstborn male|strong="H01060"\w*.\f + \fr 13:2 \ft Cited in Luke 2:23\f* \w The firstborn|strong="H06363"\w* \w from every|strong="H03605"\w* \w womb|strong="H07358"\w* \w among the Israelites|strong="H01121"\w* \w belongs|strong="H01931"\w* to Me, \w both of man|strong="H00120"\w* \w and beast|strong="H00929"\w*.”
