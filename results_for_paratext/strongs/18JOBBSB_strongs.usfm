\q1 \v 13 \w For|strong="H03588"\w* \w now|strong="H06258"\w* \w I would be lying down|strong="H07901"\w* \w in peace|strong="H08252"\w*;
\q2 \w I would be asleep|strong="H03462"\w* \w and|strong="H00227"\w* \w at rest|strong="H05117"\w*
\q1 \v 14 \w with|strong="H05973"\w* \w kings|strong="H04428"\w* \w and counselors|strong="H03289"\w* \w of the earth|strong="H00776"\w*,
\q2 \w who built|strong="H01129"\w* for themselves \w cities now in ruins|strong="H02723"\w*,
\q1 \v 15 \w or|strong="H00176"\w* \w with|strong="H05973"\w* \w princes|strong="H08269"\w* \w who had gold|strong="H02091"\w*,
\q2 \w who filled|strong="H04390"\w* \w their houses|strong="H01004"\w* \w with silver|strong="H03701"\w*.
\q1 \v 16 \w Or|strong="H00176"\w* \w why was|strong="H01961"\w* \w I not|strong="H03808"\w* \w hidden|strong="H02934"\w* \w like a stillborn child|strong="H05309"\w*,
\q2 \w like an infant|strong="H05768"\w* \w who never|strong="H03808"\w* \w sees|strong="H07200"\w* \w daylight|strong="H00216"\w*?
\q1 \v 17 \w There|strong="H08033"\w* \w the wicked|strong="H07563"\w* \w cease|strong="H02308"\w* \w from raging|strong="H07267"\w*,
\q2 \w and there|strong="H08033"\w* \w the weary|strong="H03019"\w* \w find rest|strong="H05117"\w*.
\q1 \v 18 \w The captives|strong="H00615"\w* \w enjoy|strong="H03162"\w* \w their ease|strong="H07599"\w*;
\q2 \w they do not|strong="H03808"\w* \w hear|strong="H08085"\w* \w the voice|strong="H06963"\w* \w of the oppressor|strong="H05065"\w*.
\q1 \v 19 \w Both small|strong="H06996"\w* \w and great|strong="H01419"\w* \w are there|strong="H08033"\w*,
\q2 \w and the slave|strong="H05650"\w* \w is freed|strong="H02670"\w* \w from his master|strong="H00113"\w*.
\b 
\q1 \v 20 \w Why|strong="H04100"\w* \w is light|strong="H00216"\w* \w given|strong="H05414"\w* \w to the miserable|strong="H06001"\w*,
\q2 \w and life|strong="H02416"\w* \w to the bitter|strong="H04751"\w* \w of soul|strong="H05315"\w*,
\q1 \v 21 \w who long|strong="H02442"\w* \w for death|strong="H04194"\w* \w that does not come|strong="H00369"\w*,
\q2 \w and search for it|strong="H02658"\w* \w like hidden treasure|strong="H04301"\w*,
\q1 \v 22 \w who rejoice|strong="H08056"\w* \w and greatly|strong="H01524"\w* \w exult|strong="H07797"\w*
\q2 \w when|strong="H03588"\w* \w they reach|strong="H04672"\w* \w the grave|strong="H06913"\w*?
\q1 \v 23 \w Why is life given to a man|strong="H01397"\w* \w whose|strong="H00834"\w* \w way|strong="H01870"\w* \w is hidden|strong="H05641"\w*,
\q2 \w whom God|strong="H00433"\w* \w has hedged in|strong="H05526"\w*?
\q1 \v 24 \w I sigh|strong="H00585"\w* \w when|strong="H03588"\w* \w food|strong="H03899"\w* \w is put|strong="H00935"\w* \w before me|strong="H06440"\w*,
\q2 \w and my groans|strong="H07581"\w* \w pour out|strong="H05413"\w* \w like water|strong="H04325"\w*.
\q1 \v 25 \w For|strong="H03588"\w* \w the thing|strong="H06343"\w* \w I feared|strong="H06342"\w* \w has overtaken me|strong="H00857"\w*,
\q2 \w and what|strong="H00834"\w* \w I dreaded|strong="H03025"\w* \w has befallen|strong="H00935"\w* me.
\q1 \v 26 \w I am not|strong="H03808"\w* \w at ease|strong="H07951"\w* \w or quiet|strong="H08252"\w*;
\q2 \w I have no|strong="H03808"\w* \w rest|strong="H05117"\w*, \w for trouble|strong="H07267"\w* \w has come|strong="H00935"\w*.”
\c 4
\s1 Eliphaz: The Innocent Prosper
\p \v 1 \w Then Eliphaz|strong="H00464"\w* \w the Temanite|strong="H08489"\w* \w replied|strong="H06030"\w*:
\b 
\q1 \v 2 “\w If one ventures|strong="H05254"\w* \w a word|strong="H01697"\w* \w with you|strong="H00413"\w*, \w will you be wearied|strong="H03811"\w*?
\q2 \w Yet who|strong="H04310"\w* \w can|strong="H03201"\w* \w keep|strong="H06113"\w* \w from speaking|strong="H04405"\w*?
\q1 \v 3 \w Surely|strong="H02009"\w* \w you have instructed|strong="H03256"\w* \w many|strong="H07227"\w*,
\q2 \w and have strengthened|strong="H02388"\w* \w their feeble|strong="H07504"\w* \w hands|strong="H03027"\w*.
\q1 \v 4 \w Your words|strong="H04405"\w* \w have steadied|strong="H06965"\w* \w those who stumbled|strong="H03782"\w*;
\q2 \w you have braced|strong="H00553"\w* \w the knees|strong="H01290"\w* \w that were buckling|strong="H03766"\w*.
\q1 \v 5 \w But|strong="H03588"\w* \w now|strong="H06258"\w* \w trouble has come|strong="H00935"\w* \w upon you|strong="H00413"\w*, \w and you are weary|strong="H03811"\w*.
\q2 \w It strikes you|strong="H05060"\w*, \w and you are dismayed|strong="H00926"\w*.
\q1 \v 6 \w Is your reverence|strong="H03374"\w* \w not|strong="H03808"\w* \w your confidence|strong="H03690"\w*,
\q2 \w and the uprightness|strong="H08537"\w* \w of your ways|strong="H01870"\w* \w your hope|strong="H08615"\w*?
\b 
\q1 \v 7 \w Consider|strong="H02142"\w* \w now, I plead|strong="H04994"\w*:
\b 
\q1 \w Who|strong="H04310"\w*, \w being innocent|strong="H05355"\w*, \w has ever perished|strong="H00006"\w*?
\q2 \w Or where|strong="H00375"\w* \w have the upright|strong="H03477"\w* \w been destroyed|strong="H03582"\w*?
\q1 \v 8 \w As|strong="H00834"\w* \w I have observed|strong="H07200"\w*, \w those who plow|strong="H02790"\w* \w iniquity|strong="H00205"\w*
\q2 \w and those who sow|strong="H02232"\w* \w trouble|strong="H05999"\w* \w reap the same|strong="H07114"\w*.
\q1 \v 9 \w By the breath|strong="H05397"\w* \w of God|strong="H00433"\w* \w they perish|strong="H00006"\w*,
\q2 \w and by the blast|strong="H07307"\w* \w of His anger|strong="H00639"\w* \w they are consumed|strong="H03615"\w*.
\q1 \v 10 \w The lion|strong="H00738"\w* \w may roar|strong="H07581"\w*, \w and the fierce lion|strong="H07826"\w* \w may growl|strong="H06963"\w*,
\q2 \w yet the teeth|strong="H08127"\w* \w of the young lions|strong="H03715"\w* \w are broken|strong="H05421"\w*.
\q1 \v 11 \w The old lion|strong="H03918"\w* \w perishes|strong="H00006"\w* \w for lack|strong="H01097"\w* \w of prey|strong="H02964"\w*,
\q2 \w and the cubs|strong="H01121"\w* \w of the lioness|strong="H03833"\w* \w are scattered|strong="H06504"\w*.
\b 
\q1 \v 12 \w Now a word|strong="H01697"\w* \w came to me|strong="H00413"\w* \w secretly|strong="H01589"\w*;
\q2 \w my ears|strong="H00241"\w* \w caught|strong="H03947"\w* \w a whisper|strong="H08102"\w* \w of it|strong="H04480"\w*.
\q1 \v 13 \w In disquieting|strong="H05587"\w* \w visions|strong="H02384"\w* \w in the night|strong="H03915"\w*,
\q2 \w when deep sleep|strong="H08639"\w* \w falls|strong="H05307"\w* \w on|strong="H05921"\w* \w men|strong="H00582"\w*,
\q1 \v 14 \w fear|strong="H06343"\w* \w and trembling|strong="H07461"\w* \w came over me|strong="H07122"\w*
\q2 \w and made all|strong="H07230"\w* \w my bones|strong="H06106"\w* \w shudder|strong="H06342"\w*.
\q1 \v 15 \w Then a spirit|strong="H07307"\w*\f + \fr 4:15 \ft Or \fqa a wind\f* \w glided|strong="H02498"\w* \w past|strong="H05921"\w* \w my face|strong="H06440"\w*,
\q2 \w and the hair|strong="H08185"\w* \w on my body|strong="H01320"\w* \w bristled|strong="H05568"\w*.
\q1 \v 16 \w It stood still|strong="H05975"\w*,
\q2 \w but I could not|strong="H03808"\w* \w discern|strong="H05234"\w* \w its appearance|strong="H04758"\w*;
\q1 \w a form|strong="H08544"\w* \w loomed before|strong="H05048"\w* \w my eyes|strong="H05869"\w*,
\q2 \w and I heard|strong="H08085"\w* \w a whispering|strong="H01827"\w* \w voice|strong="H06963"\w*:
\b 
\q1 \v 17 ‘\w Can a mortal|strong="H00582"\w* \w be more righteous|strong="H06663"\w* \w than God|strong="H00433"\w*,
\q2 \w or|strong="H00518"\w* \w a man|strong="H01397"\w* \w more pure|strong="H02891"\w* \w than his Maker|strong="H06213"\w*?
\q1 \v 18 \w If|strong="H02005"\w* \w God puts no|strong="H03808"\w* \w trust|strong="H00539"\w* \w in His servants|strong="H05650"\w*,
\q2 \w and He charges|strong="H07760"\w* \w His angels|strong="H04397"\w* \w with error|strong="H08417"\w*,
\q1 \v 19 \w how much more|strong="H00637"\w* \w those who dwell|strong="H07931"\w* \w in houses|strong="H01004"\w* \w of clay|strong="H02563"\w*,
\q2 \w whose|strong="H00834"\w* \w foundations|strong="H03247"\w* \w are in the dust|strong="H06083"\w*,
\q2 \w who can be crushed|strong="H01792"\w* \w like a moth|strong="H06211"\w*!
\q1 \v 20 \w They are smashed to pieces|strong="H03807"\w* \w from dawn|strong="H01242"\w* \w to dusk|strong="H06153"\w*;
\q2 \w unnoticed|strong="H01097"\w*, \w they perish|strong="H00006"\w* \w forever|strong="H05331"\w*.
\q1 \v 21 \w Are not their tent cords|strong="H03499"\w* \w pulled up|strong="H05265"\w*,
\q2 \w so that they die|strong="H04191"\w* \w without|strong="H03808"\w* \w wisdom|strong="H02451"\w*?’[’’]
\c 5
\s1 Eliphaz Continues: God Blesses those Who Seek Him
\q1 \v 1 “\w Call out|strong="H07121"\w* \w if you please|strong="H04994"\w*, \w but who will answer|strong="H06030"\w*?
\q2 \w To|strong="H00413"\w* \w which|strong="H04310"\w* \w of the holy ones|strong="H06918"\w* \w will you turn|strong="H06437"\w*?
\q1 \v 2 \w For|strong="H03588"\w* \w resentment|strong="H03708"\w* \w kills|strong="H02026"\w* \w a fool|strong="H00191"\w*,
\q2 \w and envy|strong="H07068"\w* \w slays|strong="H04191"\w* \w the simple|strong="H06601"\w*.
\q1 \v 3 \w I|strong="H00589"\w* \w have seen|strong="H07200"\w* \w a fool|strong="H00191"\w* \w taking root|strong="H08327"\w*,
\q2 \w but suddenly|strong="H06597"\w* \w his house|strong="H05116"\w* \w was cursed|strong="H06895"\w*.
\q1 \v 4 \w His sons|strong="H01121"\w* \w are far|strong="H07368"\w* \w from safety|strong="H03468"\w*,
\q2 \w crushed|strong="H01792"\w* \w in court|strong="H08179"\w* \w without|strong="H00369"\w* \w a defender|strong="H05337"\w*.
\q1 \v 5 \w The hungry|strong="H07457"\w* \w consume|strong="H00398"\w* \w his harvest|strong="H07105"\w*,
\q2 \w taking it even|strong="H03947"\w* \w from the thorns|strong="H06791"\w*,
\q2 \w and the thirsty|strong="H06782"\w* \w pant after|strong="H07602"\w* \w his wealth|strong="H02428"\w*.\f + \fr 5:5 \ft Or \fqa and a snare snatches his wealth\f*
\q1 \v 6 \w For|strong="H03588"\w* \w distress|strong="H00205"\w* \w does not|strong="H03808"\w* \w spring|strong="H03318"\w* \w from the dust|strong="H06083"\w*,
\q2 \w and trouble|strong="H05999"\w* \w does not|strong="H03808"\w* \w sprout|strong="H06779"\w* \w from the ground|strong="H00127"\w*.
\q1 \v 7 \w Yet|strong="H03588"\w* \w man|strong="H00120"\w* \w is born|strong="H03205"\w* \w to trouble|strong="H05999"\w*
\q2 \w as surely as sparks|strong="H01121"\w* \w fly|strong="H05774"\w* \w upward|strong="H01361"\w*.
\b 
\q1 \v 8 \w However|strong="H00199"\w*, \w if I were you|strong="H00589"\w*, \w I would appeal|strong="H01875"\w* \w to|strong="H00413"\w* \w God|strong="H00410"\w*
\q2 \w and lay|strong="H07760"\w* \w my cause|strong="H01700"\w* \w before|strong="H00413"\w* \w Him|strong="H00430"\w*—
\q1 \v 9 \w the One who does|strong="H06213"\w* \w great|strong="H01419"\w* \w and|strong="H00369"\w* \w unsearchable things|strong="H02714"\w*,
\q2 \w wonders|strong="H06381"\w* \w without|strong="H00369"\w* \w number|strong="H04557"\w*.
\q1 \v 10 \w He gives|strong="H05414"\w* \w rain|strong="H04306"\w* \w to|strong="H05921"\w* \w the earth|strong="H00776"\w*
\q2 \w and sends|strong="H07971"\w* \w water|strong="H04325"\w* \w upon|strong="H05921"\w* \w the fields|strong="H02351"\w*.
\q1 \v 11 \w He sets|strong="H07760"\w* \w the lowly|strong="H08217"\w* \w on high|strong="H04791"\w*,
\q2 \w so that mourners|strong="H06937"\w* \w are lifted|strong="H07682"\w* \w to safety|strong="H03468"\w*.
\q1 \v 12 \w He thwarts|strong="H06565"\w* \w the schemes|strong="H04284"\w* \w of the crafty|strong="H06175"\w*,
\q2 \w so that their hands|strong="H03027"\w* \w find|strong="H06213"\w* \w no|strong="H03808"\w* \w success|strong="H08454"\w*.
\q1 \v 13 \w He catches|strong="H03920"\w* \w the wise|strong="H02450"\w* \w in their craftiness|strong="H06191"\w*,\f + \fr 5:13 \ft Cited in 1 Corinthians 3:19\f*
\q2 \w and sweeps away|strong="H04116"\w* \w the plans|strong="H06098"\w* \w of the cunning|strong="H06617"\w*.
\q1 \v 14 \w They encounter|strong="H06298"\w* \w darkness|strong="H02822"\w* \w by day|strong="H03119"\w*
\q2 \w and grope|strong="H04959"\w* \w at noon|strong="H06672"\w* \w as in the night|strong="H03915"\w*.
\q1 \v 15 \w He saves|strong="H03467"\w* \w the needy|strong="H00034"\w* \w from the sword|strong="H02719"\w* \w in their mouth|strong="H06310"\w*
\q2 \w and from the clutches|strong="H03027"\w* \w of the powerful|strong="H02389"\w*.
\q1 \v 16 \w So the poor|strong="H01800"\w* \w have|strong="H01961"\w* \w hope|strong="H08615"\w*,
\q2 \w and injustice|strong="H05766"\w* \w shuts|strong="H07092"\w* \w its mouth|strong="H06310"\w*.
\b 
\q1 \v 17 \w Blessed|strong="H00835"\w* \w indeed|strong="H02009"\w* \w is the man|strong="H00582"\w* \w whom God|strong="H00433"\w* \w corrects|strong="H03198"\w*;
\q2 \w so do not|strong="H00408"\w* \w despise|strong="H03988"\w* \w the discipline|strong="H04148"\w* \w of the Almighty|strong="H07706"\w*.\f + \fr 5:17 \ft Hebrew \fqa Shaddai\ft ; here and throughout Job\f*
\q1 \v 18 \w For|strong="H03588"\w* \w He|strong="H01931"\w* \w wounds|strong="H03510"\w*, \w but He also binds|strong="H02280"\w*;
\q2 \w He strikes|strong="H04272"\w*, \w but His hands|strong="H03027"\w* \w also heal|strong="H07495"\w*.
\q1 \v 19 \w He will rescue|strong="H05337"\w* \w you from six|strong="H08337"\w* \w calamities|strong="H06869"\w*;
\q2 \w no|strong="H03808"\w* \w harm|strong="H07451"\w* \w will touch|strong="H05060"\w* you \w in seven|strong="H07651"\w*.
\q1 \v 20 \w In famine|strong="H07458"\w* \w He will redeem you|strong="H06299"\w* \w from death|strong="H04194"\w*,
\q2 \w and in battle|strong="H04421"\w* \w from the stroke|strong="H03027"\w* \w of the sword|strong="H02719"\w*.
\q1 \v 21 \w You will be hidden|strong="H02244"\w* \w from the scourge|strong="H07752"\w* \w of the tongue|strong="H03956"\w*,
\q2 \w and will not|strong="H03808"\w* \w fear|strong="H03372"\w* \w havoc|strong="H07701"\w* \w when|strong="H03588"\w* \w it comes|strong="H00935"\w*.
\q1 \v 22 \w You will laugh|strong="H07832"\w* \w at destruction|strong="H07701"\w* \w and famine|strong="H03720"\w*,
\q2 \w and need not|strong="H00408"\w* \w fear|strong="H03372"\w* \w the beasts|strong="H02416"\w* \w of the earth|strong="H00776"\w*.
\q1 \v 23 \w For|strong="H03588"\w* \w you will have a covenant|strong="H01285"\w* \w with|strong="H05973"\w* \w the stones|strong="H00068"\w* \w of the field|strong="H07704"\w*,
\q2 \w and the wild|strong="H07704"\w* \w animals|strong="H02416"\w* \w will be at peace|strong="H07999"\w* with you.
\q1 \v 24 \w You will know|strong="H03045"\w* \w that|strong="H03588"\w* \w your tent|strong="H00168"\w* \w is secure|strong="H07965"\w*,
\q2 \w and find nothing|strong="H03808"\w* \w amiss|strong="H02398"\w* \w when inspecting|strong="H06485"\w* \w your home|strong="H05116"\w*.
\q1 \v 25 \w You will know|strong="H03045"\w* \w that|strong="H03588"\w* \w your offspring|strong="H02233"\w* \w will be many|strong="H07227"\w*,
\q2 \w your descendants|strong="H06631"\w* \w like the grass|strong="H06212"\w* \w of the earth|strong="H00776"\w*.
\q1 \v 26 \w You will come|strong="H00935"\w* \w to|strong="H00413"\w* \w the grave|strong="H06913"\w* \w in full vigor|strong="H03624"\w*,
\q2 \w like a sheaf of grain|strong="H01430"\w* \w gathered|strong="H05927"\w* \w in season|strong="H06256"\w*.
\b 
\q1 \v 27 \w Indeed|strong="H02009"\w*, \w we have investigated|strong="H02713"\w*, \w and it|strong="H01931"\w* \w is true|strong="H03651"\w*!
\q2 \w So hear it|strong="H08085"\w* \w and|strong="H00859"\w* \w know|strong="H03045"\w* for yourself.”
\c 6
\s1 Job Replies: My Complaint Is Just
\p \v 1 \w Then Job|strong="H00347"\w* \w replied|strong="H06030"\w*:
\b 
\q1 \v 2 “\w If only|strong="H03863"\w* \w my grief|strong="H03708"\w* \w could be weighed|strong="H08254"\w*
\q2 \w and placed|strong="H05375"\w* \w with|strong="H03162"\w* \w my calamity|strong="H01962"\w* \w on the scales|strong="H03976"\w*.
\q1 \v 3 \w For|strong="H03588"\w* \w then|strong="H06258"\w* \w it would outweigh|strong="H03513"\w* \w the sand|strong="H02344"\w* \w of the seas|strong="H03220"\w* —
\q2 \w no wonder|strong="H05921"\w* \w my words|strong="H01697"\w* \w have been rash|strong="H03886"\w*.
\q1 \v 4 \w For|strong="H03588"\w* \w the arrows|strong="H02671"\w* \w of the Almighty|strong="H07706"\w* \w have pierced me|strong="H05978"\w*;
\q2 \w my spirit|strong="H07307"\w* \w drinks in|strong="H08354"\w* \w their poison|strong="H02534"\w*;
\q2 \w the terrors|strong="H01161"\w* \w of God|strong="H00433"\w* \w are arrayed against me|strong="H06186"\w*.
\q1 \v 5 \w Does a wild donkey|strong="H06501"\w* \w bray|strong="H05101"\w* \w over|strong="H05921"\w* \w fresh grass|strong="H01877"\w*,
\q2 \w or|strong="H00518"\w* \w an ox|strong="H07794"\w* \w low|strong="H01600"\w* \w over|strong="H05921"\w* \w its fodder|strong="H01098"\w*?
\q1 \v 6 \w Is tasteless food|strong="H08602"\w* \w eaten|strong="H00398"\w* \w without|strong="H01097"\w* \w salt|strong="H04417"\w*,
\q2 \w or|strong="H00518"\w* \w is there|strong="H03426"\w* \w flavor|strong="H02940"\w* \w in the white|strong="H07388"\w* \w of an egg|strong="H02495"\w*\f + \fr 6:6 \ft Or \fqa in the sap of the mallow plant\f*?
\q1 \v 7 \w My soul|strong="H05315"\w* \w refuses|strong="H03985"\w* \w to touch them|strong="H05060"\w*;
\q2 \w they are|strong="H01992"\w* \w loathsome|strong="H01741"\w* \w food to me|strong="H03899"\w*.
\b 
\q1 \v 8 \w If only|strong="H04310"\w* \w my request|strong="H07596"\w* \w were granted|strong="H00935"\w*
\q2 \w and God|strong="H00433"\w* \w would fulfill|strong="H05414"\w* \w my hope|strong="H08615"\w*:
\q1 \v 9 \w that God|strong="H00433"\w* \w would be willing|strong="H02974"\w* \w to crush me|strong="H01792"\w*,
\q2 \w to unleash|strong="H05425"\w* \w His hand|strong="H03027"\w* \w and cut me off|strong="H01214"\w*!
\q1 \v 10 \w It still|strong="H05750"\w* \w brings me|strong="H01961"\w* \w comfort|strong="H05165"\w*,
\q2 \w and joy|strong="H05539"\w* \w through unrelenting|strong="H03808"\w* \w pain|strong="H02427"\w*,
\q1 \w that|strong="H03588"\w* \w I have not|strong="H03808"\w* \w denied|strong="H03582"\w*
\q2 \w the words|strong="H00561"\w* \w of the Holy One|strong="H06918"\w*.
\b 
\q1 \v 11 \w What|strong="H04100"\w* \w strength do I have|strong="H03581"\w*, \w that|strong="H03588"\w* \w I should still hope|strong="H03176"\w*?
\q2 \w What|strong="H04100"\w* \w is my future|strong="H07093"\w*, \w that|strong="H03588"\w* \w I|strong="H05315"\w* \w should be patient|strong="H00748"\w*?
