\q2 \w even|strong="H03588"\w* \w now|strong="H06258"\w* \w He will rouse Himself|strong="H05782"\w* \w on your behalf|strong="H05921"\w*
\q2 \w and restore|strong="H07999"\w* \w your righteous|strong="H06664"\w* \w estate|strong="H05116"\w*.
\q1 \v 7 \w Though your beginnings|strong="H07225"\w* \w were|strong="H01961"\w* \w modest|strong="H04705"\w*,
\q2 \w your latter days|strong="H00319"\w* \w will flourish|strong="H07685"\w*.
\b 
\q1 \v 8 \w Please|strong="H04994"\w* \w inquire|strong="H07592"\w* \w of past|strong="H07223"\w* \w generations|strong="H01755"\w*
\q2 \w and consider|strong="H03559"\w* \w the discoveries|strong="H02714"\w* \w of their fathers|strong="H00001"\w*.
\q1 \v 9 \w For|strong="H03588"\w* \w we were born|strong="H00587"\w* \w yesterday|strong="H08543"\w* \w and know|strong="H03045"\w* \w nothing|strong="H03808"\w*;
