\c 16
\s1 Job Decries His Comforters
\p \v 1 \w Then Job|strong="H00347"\w* \w answered|strong="H06030"\w*:
\b 
\q1 \v 2 “\w I have heard|strong="H08085"\w* \w many|strong="H07227"\w* \w things like these|strong="H00428"\w*;
\q2 \w miserable|strong="H05999"\w* \w comforters|strong="H05162"\w* \w are you all|strong="H03605"\w*.
\q1 \v 3 \w Is there no end|strong="H07093"\w* \w to your long-winded|strong="H07307"\w* \w speeches|strong="H01697"\w*?
\q2 \w What|strong="H04100"\w* \w provokes you|strong="H04834"\w* \w to|strong="H03588"\w* \w continue testifying|strong="H06030"\w*?
\q1 \v 4 \w I|strong="H00595"\w* \w could also|strong="H01571"\w* \w speak|strong="H01696"\w* like you
\q2 \w if|strong="H03863"\w* \w you|strong="H05315"\w* \w were|strong="H03426"\w* \w in my|strong="H05315"\w* \w place|strong="H08478"\w*;
\q1 \w I could heap up|strong="H02266"\w* \w words|strong="H04405"\w* \w against you|strong="H05921"\w*
\q2 \w and shake|strong="H05128"\w* \w my head|strong="H07218"\w* \w at you|strong="H05921"\w*.
\q1 \v 5 \w But I would encourage you|strong="H00553"\w* \w with|strong="H01119"\w* \w my mouth|strong="H06310"\w*,
\q2 \w and the consolation|strong="H05205"\w* \w of my lips|strong="H08193"\w* \w would bring relief|strong="H02820"\w*.
\b 
\q1 \v 6 \w Even if|strong="H00518"\w* \w I speak|strong="H01696"\w*, \w my pain|strong="H03511"\w* \w is not|strong="H03808"\w* \w relieved|strong="H02820"\w*,
\q2 \w and if I hold back|strong="H02308"\w*, \w how|strong="H04100"\w* \w will it go away|strong="H01980"\w*?
\q1 \v 7 \w Surely|strong="H00389"\w* \w He has now|strong="H06258"\w* \w exhausted me|strong="H03811"\w*;
\q2 \w You have devastated|strong="H08074"\w* \w all|strong="H03605"\w* \w my family|strong="H05712"\w*.
\q1 \v 8 \w You have bound me|strong="H07059"\w*, \w and it has become|strong="H01961"\w* \w a witness|strong="H05707"\w*;
\q2 \w my frailty|strong="H03585"\w* \w rises up|strong="H06965"\w* \w and testifies|strong="H06030"\w* \w against me|strong="H06440"\w*.
\q1 \v 9 \w His anger|strong="H00639"\w* \w has torn me|strong="H02963"\w* \w and opposed me|strong="H07852"\w*;
\q2 \w He gnashes|strong="H02786"\w* \w His teeth|strong="H08127"\w* \w at me|strong="H05921"\w*.
\q2 \w My adversary|strong="H06862"\w* \w pierces|strong="H03913"\w* me \w with His eyes|strong="H05869"\w*.
\b 
\q1 \v 10 \w They open|strong="H06473"\w* \w their mouths|strong="H06310"\w* \w against me|strong="H05921"\w*
\q2 \w and strike|strong="H05221"\w* \w my cheeks|strong="H03895"\w* \w with contempt|strong="H02781"\w*;
\q2 \w they join|strong="H04390"\w* \w together|strong="H03162"\w* \w against me|strong="H05921"\w*.
\q1 \v 11 \w God|strong="H00410"\w* \w has delivered me|strong="H05462"\w* \w to|strong="H00413"\w* \w unjust men|strong="H05759"\w*;
\q2 \w He has thrown me|strong="H03399"\w* \w to|strong="H05921"\w* \w the clutches|strong="H03027"\w* \w of the wicked|strong="H07563"\w*.
\q1 \v 12 \w I was|strong="H01961"\w* \w at ease|strong="H07961"\w*, \w but He shattered me|strong="H06565"\w*;
\q2 \w He seized me|strong="H00270"\w* \w by the neck|strong="H06203"\w* \w and crushed me|strong="H06327"\w*.
\q1 \w He has set me up|strong="H06965"\w* as His \w target|strong="H04307"\w*;
\q2 \v 13 \w His archers|strong="H07228"\w* \w surround me|strong="H05437"\w*.
\q1 \w He pierces|strong="H06398"\w* \w my kidneys|strong="H03629"\w* \w without|strong="H03808"\w* \w mercy|strong="H02550"\w*
\q2 \w and spills|strong="H08210"\w* \w my gall|strong="H04845"\w* \w on the ground|strong="H00776"\w*.
\q1 \v 14 \w He breaks me|strong="H06555"\w* \w with wound|strong="H06556"\w* \w upon|strong="H05921"\w* \w wound|strong="H06556"\w*;
\q2 \w He rushes|strong="H07323"\w* \w me|strong="H05921"\w* \w like a mighty warrior|strong="H01368"\w*.
\b 
\q1 \v 15 \w I have sewn|strong="H08609"\w* \w sackcloth|strong="H08242"\w* \w over|strong="H05921"\w* \w my skin|strong="H01539"\w*;
\q2 \w I have buried|strong="H05953"\w* \w my horn|strong="H07161"\w* \w in the dust|strong="H06083"\w*.
\q1 \v 16 \w My face|strong="H06440"\w* \w is red|strong="H02560"\w* \w with|strong="H04480"\w* \w weeping|strong="H01065"\w*,
\q2 \w and deep shadows|strong="H06757"\w* \w ring|strong="H05921"\w* \w my eyes|strong="H06079"\w*;
\q1 \v 17 \w yet|strong="H05921"\w* \w my hands|strong="H03709"\w* \w are free of|strong="H03808"\w* \w violence|strong="H02555"\w*
\q2 \w and my prayer|strong="H08605"\w* \w is pure|strong="H02134"\w*.
\b 
\q1 \v 18 \w O earth|strong="H00776"\w*, \w do not|strong="H00408"\w* \w cover|strong="H03680"\w* \w my blood|strong="H01818"\w*;
\q2 \w may my cry for help|strong="H02201"\w* \w never|strong="H00408"\w* \w be|strong="H01961"\w* \w laid to rest|strong="H04725"\w*.
\q1 \v 19 \w Even|strong="H01571"\w* \w now|strong="H06258"\w* \w my witness|strong="H05707"\w* \w is in heaven|strong="H08064"\w*,
\q2 \w and my advocate|strong="H07717"\w* \w is on high|strong="H04791"\w*.
\q1 \v 20 \w My friends|strong="H07453"\w* \w are my scoffers|strong="H03887"\w*
\q2 \w as my eyes|strong="H05869"\w* \w pour out tears|strong="H01811"\w* \w to|strong="H00413"\w* \w God|strong="H00433"\w*.
\q1 \v 21 \w Oh, that a man|strong="H01397"\w* \w might plead|strong="H03198"\w* \w with|strong="H05973"\w* \w God|strong="H00433"\w*
\q2 \w as he pleads|strong="H01121"\w* \w with his neighbor|strong="H07453"\w*!
\q1 \v 22 \w For when|strong="H03588"\w* \w only a few|strong="H04557"\w* \w years|strong="H08141"\w* \w are past|strong="H00857"\w*
\q2 \w I will go|strong="H01980"\w* \w the way|strong="H00734"\w* \w of no|strong="H03808"\w* \w return|strong="H07725"\w*.[’’]
\c 17
\s1 Job Prepares for Death
\q1 \v 1 “\w My spirit|strong="H07307"\w* \w is broken|strong="H02254"\w*; \w my days|strong="H03117"\w* \w are extinguished|strong="H02193"\w*;
\q2 \w the grave|strong="H06913"\w* awaits me.
\q1 \v 2 \w Surely|strong="H00518"\w* \w mockers|strong="H02049"\w* \w surround me|strong="H05978"\w*,
\q2 \w and my eyes|strong="H05869"\w* \w must gaze|strong="H03885"\w* \w at their rebellion|strong="H04784"\w*.
\b 
\q1 \v 3 \w Give me|strong="H07760"\w*, \w I pray|strong="H04994"\w*, \w the pledge|strong="H06148"\w* \w You demand|strong="H05973"\w*.
\q2 \w Who else|strong="H04310"\w* \w will be my guarantor|strong="H03027"\w*?
\q1 \v 4 \w You have closed|strong="H06845"\w* \w their minds|strong="H03820"\w* \w to understanding|strong="H07922"\w*;
\q2 \w therefore|strong="H05921"\w* \w You will not|strong="H03808"\w* \w exalt them|strong="H07311"\w*.
\q1 \v 5 \w If a man denounces|strong="H05046"\w* \w his friends|strong="H07453"\w* \w for a price|strong="H02506"\w*,
\q2 \w the eyes|strong="H05869"\w* \w of his children|strong="H01121"\w* \w will fail|strong="H03615"\w*.
\b 
\q1 \v 6 \w He has made me|strong="H03322"\w* \w a byword|strong="H04911"\w* \w among the people|strong="H05971"\w*,
\q2 \w a man|strong="H01961"\w* \w in whose face|strong="H06440"\w* \w they spit|strong="H08611"\w*.
\q1 \v 7 \w My eyes|strong="H05869"\w* \w have grown dim|strong="H03543"\w* \w with grief|strong="H03708"\w*,
\q2 \w and my whole|strong="H03605"\w* \w body|strong="H03338"\w* \w is but a shadow|strong="H06738"\w*.
\q1 \v 8 \w The upright|strong="H03477"\w* \w are appalled|strong="H08074"\w* \w at|strong="H05921"\w* \w this|strong="H02063"\w*,
\q2 \w and the innocent|strong="H05355"\w* \w are stirred|strong="H05782"\w* \w against|strong="H05921"\w* \w the godless|strong="H02611"\w*.
\q1 \v 9 \w Yet a righteous one|strong="H06662"\w* \w holds|strong="H00270"\w* \w to his way|strong="H01870"\w*,
\q2 \w and the one with clean hands|strong="H03027"\w* \w grows|strong="H03254"\w* \w stronger|strong="H00555"\w*.
\q1 \v 10 \w But|strong="H00199"\w* \w come back|strong="H00935"\w* \w and try again|strong="H07725"\w*, \w all of you|strong="H03605"\w*.
\q2 \w For I will not|strong="H03808"\w* \w find|strong="H04672"\w* \w a wise man|strong="H02450"\w* among you.
\b 
\q1 \v 11 \w My days|strong="H03117"\w* \w have passed|strong="H05674"\w*; \w my plans|strong="H02154"\w* \w are broken off|strong="H05423"\w* —
\q2 \w even the desires|strong="H04180"\w* \w of my heart|strong="H03824"\w*.
\q1 \v 12 \w They have turned|strong="H07760"\w* \w night|strong="H03915"\w* \w into day|strong="H03117"\w*,
\q2 \w making light|strong="H00216"\w* \w seem near|strong="H07138"\w* \w in the face|strong="H06440"\w* \w of darkness|strong="H02822"\w*.
\q1 \v 13 \w If|strong="H00518"\w* \w I look|strong="H06960"\w* \w for Sheol|strong="H07585"\w* \w as my home|strong="H01004"\w*,
\q2 \w if I spread out|strong="H07502"\w* \w my bed|strong="H03326"\w* \w in darkness|strong="H02822"\w*,
\q1 \v 14 \w and say|strong="H07121"\w* \w to corruption|strong="H07845"\w*, ‘\w You are|strong="H00859"\w* \w my father|strong="H00001"\w*,’
\q2 \w and to the worm|strong="H07415"\w*, ‘\w My mother|strong="H00517"\w*,’ \w or ‘My sister|strong="H00269"\w*,’
\q1 \v 15 \w where|strong="H00346"\w* \w then|strong="H00645"\w* \w is my hope|strong="H08615"\w*?
\q2 \w Who|strong="H04310"\w* \w can see|strong="H07789"\w* \w any hope for me|strong="H08615"\w*?
\q1 \v 16 \w Will it go down|strong="H03381"\w* \w to the gates|strong="H00905"\w* \w of Sheol|strong="H07585"\w*?
\q2 \w Will we go down|strong="H05181"\w* \w together|strong="H03162"\w* \w into|strong="H05921"\w* \w the dust|strong="H06083"\w*?”
\c 18
\s1 Bildad: God Punishes the Wicked
\p \v 1 \w Then Bildad|strong="H01085"\w* \w the Shuhite|strong="H07747"\w* \w replied|strong="H06030"\w*:
\b 
\q1 \v 2 “\w How long|strong="H00575"\w* \w until|strong="H05704"\w* \w you end|strong="H07760"\w* \w these speeches|strong="H04405"\w*?
\q2 \w Show some sense|strong="H00995"\w*, \w and then|strong="H00310"\w* \w we can talk|strong="H01696"\w*.
\q1 \v 3 \w Why|strong="H04069"\w* \w are we regarded|strong="H02803"\w* \w as cattle|strong="H00929"\w*,
\q2 \w as stupid|strong="H02933"\w* \w in your sight|strong="H05869"\w*?
\q1 \v 4 \w You who tear|strong="H02963"\w* \w yourself|strong="H05315"\w* \w in anger|strong="H00639"\w*—
\q2 \w should the earth|strong="H00776"\w* \w be forsaken|strong="H05800"\w* \w on your account|strong="H04616"\w*,
\q2 \w or the rocks|strong="H06697"\w* \w be moved|strong="H06275"\w* \w from their place|strong="H04725"\w*?
\b 
\q1 \v 5 \w Indeed|strong="H01571"\w*, \w the lamp|strong="H00216"\w* \w of the wicked|strong="H07563"\w* \w is extinguished|strong="H01846"\w*;
\q2 \w the flame|strong="H07632"\w* \w of his fire|strong="H00784"\w* \w does not|strong="H03808"\w* \w glow|strong="H05050"\w*.
\q1 \v 6 \w The light|strong="H00216"\w* \w in his tent|strong="H00168"\w* \w grows dark|strong="H02821"\w*,
\q2 \w and the lamp|strong="H05216"\w* \w beside him|strong="H05921"\w* \w goes out|strong="H01846"\w*.
\q1 \v 7 \w His vigorous|strong="H00202"\w* \w stride|strong="H06806"\w* \w is shortened|strong="H03334"\w*,
\q2 \w and his own schemes|strong="H06098"\w* \w trip him up|strong="H07993"\w*.
\q1 \v 8 \w For|strong="H03588"\w* \w his own feet|strong="H07272"\w* \w lead him|strong="H07971"\w* \w into a net|strong="H07568"\w*,
\q2 \w and he wanders|strong="H01980"\w* \w into|strong="H05921"\w* \w its mesh|strong="H07639"\w*.
\q1 \v 9 \w A trap|strong="H06341"\w* \w seizes|strong="H00270"\w* \w his heel|strong="H06119"\w*;
\q2 \w a snare|strong="H06782"\w* \w grips him|strong="H02388"\w*.
\q1 \v 10 \w A noose|strong="H02256"\w* \w is hidden|strong="H02934"\w* \w in the ground|strong="H00776"\w*,
\q2 \w and a trap|strong="H04434"\w* \w lies in|strong="H05921"\w* \w his path|strong="H05410"\w*.
\q1 \v 11 \w Terrors|strong="H01091"\w* \w frighten him|strong="H01204"\w* \w on every side|strong="H05439"\w*
\q2 \w and harass|strong="H06327"\w* \w his every step|strong="H07272"\w*.
\q1 \v 12 \w His strength|strong="H00202"\w* \w is|strong="H01961"\w* \w depleted|strong="H07457"\w*,
\q2 \w and calamity|strong="H00343"\w* \w is ready|strong="H03559"\w* \w at his side|strong="H06761"\w*.
\q1 \v 13 \w It devours|strong="H00398"\w* \w patches|strong="H00905"\w* \w of his skin|strong="H05785"\w*;
\q2 \w the firstborn|strong="H01060"\w* \w of death|strong="H04194"\w* \w devours|strong="H00398"\w* \w his limbs|strong="H00905"\w*.
\b 
\q1 \v 14 \w He is torn|strong="H05423"\w* \w from the shelter|strong="H04009"\w* \w of his tent|strong="H00168"\w*
\q2 \w and is marched off|strong="H06805"\w* \w to the king|strong="H04428"\w* \w of terrors|strong="H01091"\w*.
\q1 \v 15 \w Fire|strong="H01097"\w* \w resides|strong="H07931"\w* \w in his tent|strong="H00168"\w*;
\q2 \w burning sulfur|strong="H01614"\w* \w rains down|strong="H02219"\w* \w on|strong="H05921"\w* \w his dwelling|strong="H05116"\w*.
\q1 \v 16 \w The roots|strong="H08328"\w* \w beneath him|strong="H08478"\w* \w dry up|strong="H03001"\w*,
\q2 \w and the branches|strong="H07105"\w* \w above him|strong="H04605"\w* \w wither away|strong="H05243"\w*.
\q1 \v 17 \w The memory of him|strong="H02143"\w* \w perishes|strong="H00006"\w* \w from|strong="H04480"\w* \w the earth|strong="H00776"\w*,
\q2 and he has \w no|strong="H03808"\w* \w name|strong="H08034"\w* \w in|strong="H05921"\w* \w the land|strong="H02351"\w*.
\q1 \v 18 \w He is driven|strong="H01920"\w* \w from light|strong="H00216"\w* \w into|strong="H00413"\w* \w darkness|strong="H02822"\w*
\q2 \w and is chased|strong="H05074"\w* \w from the inhabited world|strong="H08398"\w*.
\q1 \v 19 \w He has no|strong="H03808"\w* \w offspring|strong="H05209"\w* \w or posterity|strong="H05220"\w* \w among his people|strong="H05971"\w*,
\q2 \w no|strong="H00369"\w* \w survivor|strong="H08300"\w* \w where he once lived|strong="H04033"\w*.
\b 
\q1 \v 20 \w Those in the west|strong="H00314"\w* \w are appalled|strong="H08074"\w* \w at|strong="H05921"\w* \w his fate|strong="H03117"\w*,
\q2 \w while those in the east|strong="H06931"\w* \w tremble in horror|strong="H08178"\w*.
\q1 \v 21 \w Surely|strong="H00389"\w* \w such|strong="H00428"\w* \w is the dwelling|strong="H04908"\w* \w of the wicked|strong="H05767"\w*
\q2 \w and|strong="H02088"\w* \w the place|strong="H04725"\w* \w of one who does not|strong="H03808"\w* \w know|strong="H03045"\w* \w God|strong="H00410"\w*.”
\c 19
\s1 Job: My Redeemer Lives
\p \v 1 \w Then Job|strong="H00347"\w* \w answered|strong="H06030"\w*:
\b 
\q1 \v 2 “\w How long|strong="H05704"\w* \w will you torment|strong="H03013"\w* \w me|strong="H05315"\w*
\q2 \w and crush me|strong="H01792"\w* \w with your words|strong="H04405"\w*?
\q1 \v 3 \w Ten|strong="H06235"\w* \w times|strong="H06471"\w* \w now|strong="H02088"\w* \w you have reproached me|strong="H03637"\w*;
\q2 \w you shamelessly|strong="H00954"\w* \w mistreat|strong="H01970"\w* me.
\q1 \v 4 \w Even if|strong="H00637"\w* \w I have truly gone astray|strong="H07686"\w*,
\q2 \w my error|strong="H04879"\w* \w concerns me|strong="H03885"\w* \w alone|strong="H00854"\w*.
\q1 \v 5 \w If|strong="H00518"\w* \w indeed|strong="H00551"\w* \w you would exalt yourselves|strong="H01431"\w* \w above me|strong="H05921"\w*
\q2 \w and use my disgrace|strong="H02781"\w* \w against me|strong="H05921"\w*,
\q1 \v 6 \w then|strong="H00645"\w* \w understand|strong="H03045"\w* \w that|strong="H03588"\w* \w it is God|strong="H00433"\w* \w who has wronged me|strong="H05791"\w*
\q2 \w and drawn His net|strong="H04685"\w* \w around|strong="H05362"\w* \w me|strong="H05921"\w*.
\b 
\q1 \v 7 \w Though|strong="H02005"\w* \w I cry out|strong="H06817"\w*, ‘\w Violence|strong="H02555"\w*!’ \w I get no|strong="H03808"\w* \w response|strong="H06030"\w*;
\q2 \w though I call for help|strong="H07768"\w*, \w there is no|strong="H00369"\w* \w justice|strong="H04941"\w*.
\q1 \v 8 \w He has blocked|strong="H01443"\w* \w my way|strong="H00734"\w* \w so I cannot|strong="H03808"\w* \w pass|strong="H05674"\w*;
\q2 \w He has veiled|strong="H05921"\w* \w my paths|strong="H05410"\w* \w with darkness|strong="H02822"\w*.
\q1 \v 9 \w He has stripped me|strong="H06584"\w* \w of my honor|strong="H03519"\w*
\q2 \w and removed|strong="H05493"\w* \w the crown|strong="H05850"\w* \w from my head|strong="H07218"\w*.
\q1 \v 10 \w He tears me down|strong="H05422"\w* \w on every side|strong="H05439"\w* \w until I am gone|strong="H01980"\w*;
\q2 \w He uproots|strong="H05265"\w* \w my hope|strong="H08615"\w* \w like a tree|strong="H06086"\w*.
\q1 \v 11 \w His anger|strong="H00639"\w* \w burns|strong="H02734"\w* \w against me|strong="H05921"\w*,
\q2 \w and He counts me|strong="H02803"\w* \w among His enemies|strong="H06862"\w*.
\q1 \v 12 \w His troops|strong="H01416"\w* \w advance|strong="H00935"\w* \w together|strong="H03162"\w*;
\q2 \w they construct|strong="H05549"\w* \w a ramp|strong="H01870"\w* \w against me|strong="H05921"\w*
\q2 \w and encamp|strong="H02583"\w* \w around|strong="H05439"\w* \w my tent|strong="H00168"\w*.
\b 
\q1 \v 13 \w He has removed|strong="H07368"\w* \w my brothers|strong="H00251"\w* \w from me|strong="H05921"\w*;
\q2 \w my acquaintances|strong="H03045"\w* \w have abandoned|strong="H02114"\w* \w me|strong="H04480"\w*.
\q1 \v 14 \w My kinsmen|strong="H07138"\w* \w have failed me|strong="H02308"\w*,
\q2 \w and my friends|strong="H03045"\w* \w have forgotten me|strong="H07911"\w*.
\q1 \v 15 \w My guests|strong="H01004"\w* \w and maidservants|strong="H00519"\w* \w count me|strong="H02803"\w* \w as a stranger|strong="H02114"\w*;
\q2 \w I am|strong="H01961"\w* \w a foreigner|strong="H05237"\w* \w in their sight|strong="H05869"\w*.
\q1 \v 16 \w I call|strong="H07121"\w* \w for my servant|strong="H05650"\w*, \w but he does not|strong="H03808"\w* \w answer|strong="H06030"\w*,
\q2 \w though I implore|strong="H02603"\w* him \w with|strong="H01119"\w* \w my own mouth|strong="H06310"\w*.
\q1 \v 17 \w My breath|strong="H07307"\w* \w is repulsive|strong="H02114"\w* \w to my wife|strong="H00802"\w*,
\q2 \w and I am loathsome|strong="H02603"\w* \w to my own family|strong="H01121"\w*.
\q1 \v 18 \w Even|strong="H01571"\w* \w little boys|strong="H05759"\w* \w scorn|strong="H03988"\w* me;
\q2 \w when I appear|strong="H06965"\w*, \w they deride|strong="H01696"\w* me.
\q1 \v 19 \w All|strong="H03605"\w* \w my best friends|strong="H04962"\w* \w despise me|strong="H08581"\w*,
\q2 \w and those|strong="H02088"\w* \w I love|strong="H00157"\w* \w have turned|strong="H02015"\w* against me.
\q1 \v 20 \w My skin|strong="H05785"\w* \w and flesh|strong="H01320"\w* \w cling|strong="H01692"\w* \w to my bones|strong="H06106"\w*;
\q2 \w I have escaped|strong="H04422"\w* \w by the skin|strong="H05785"\w* \w of my teeth|strong="H08127"\w*.
\b 
\q1 \v 21 \w Have pity on me|strong="H02603"\w*, \w my friends|strong="H07453"\w*, \w have pity|strong="H02603"\w*,
\q2 \w for|strong="H03588"\w* \w the hand|strong="H03027"\w* \w of God|strong="H00433"\w* \w has struck|strong="H05060"\w* me.
\q1 \v 22 \w Why|strong="H04100"\w* \w do you persecute me|strong="H07291"\w* \w as|strong="H03644"\w* \w God does|strong="H00410"\w*?
\q2 \w Will you never|strong="H03808"\w* \w get enough|strong="H07646"\w* \w of my flesh|strong="H01320"\w*?
\b 
\q1 \v 23 \w I wish|strong="H04310"\w* \w that my words|strong="H04405"\w* \w were recorded|strong="H03789"\w*
\q2 \w and inscribed|strong="H02710"\w* \w in a book|strong="H05612"\w*,
\q1 \v 24 \w by an iron|strong="H01270"\w* \w stylus|strong="H05842"\w* \w on lead|strong="H05777"\w*,
\q2 \w or chiseled|strong="H02672"\w* \w in stone|strong="H06697"\w* \w forever|strong="H05703"\w*.
\q1 \v 25 \w But I|strong="H00589"\w* \w know|strong="H03045"\w* \w that my Redeemer|strong="H01350"\w*\f + \fr 19:25 \ft Or \fqa Vindicator\f* \w lives|strong="H02416"\w*,
\q2 \w and in the end|strong="H00314"\w* \w He will stand|strong="H06965"\w* \w upon|strong="H05921"\w* \w the earth|strong="H06083"\w*.\f + \fr 19:25 \ft Or \fqa on my grave\f*
\q1 \v 26 \w Even after|strong="H00310"\w* \w my skin|strong="H05785"\w* \w has been destroyed|strong="H05362"\w*,
\q2 \w yet in my flesh|strong="H01320"\w*\f + \fr 19:26 \ft Or \fqa without my flesh\f* \w I will see|strong="H02372"\w* \w God|strong="H00433"\w*.
\q1 \v 27 \w I|strong="H00589"\w* \w will see|strong="H02372"\w* \w Him|strong="H00834"\w* for myself;
\q2 \w my eyes|strong="H05869"\w* \w will behold Him|strong="H07200"\w*, \w and not|strong="H03808"\w* \w as a stranger|strong="H02114"\w*.
\q2 \w How my heart|strong="H03629"\w* \w yearns|strong="H03615"\w*\f + \fr 19:27 \ft Hebrew \fqa my kidneys yearn\f* \w within me|strong="H02436"\w*!
\b 
\q1 \v 28 \w If|strong="H03588"\w* \w you say|strong="H00559"\w*, ‘\w Let us|strong="H04100"\w* \w persecute|strong="H07291"\w* him,
\q2 \w since the root|strong="H08328"\w* \w of the matter|strong="H01697"\w* \w lies|strong="H04672"\w* with him,\f + \fr 19:28 \ft Many Hebrew manuscripts, LXX, and Vulgate; most Hebrew manuscripts \fqa with me\f*’
\q1 \v 29 \w then you should fear|strong="H01481"\w* \w the sword|strong="H02719"\w* yourselves,
\q2 \w because|strong="H03588"\w* \w wrath|strong="H02534"\w* \w brings punishment|strong="H05771"\w* \w by the sword|strong="H02719"\w*,
\q2 \w so that|strong="H04616"\w* \w you may know|strong="H03045"\w* \w there is a judgment|strong="H01779"\w*.”
\c 20
\s1 Zophar: Destruction Awaits the Wicked
\p \v 1 \w Then Zophar|strong="H06691"\w* \w the Naamathite|strong="H05284"\w* \w replied|strong="H06030"\w*:
\b 
\q1 \v 2 “\w So|strong="H03651"\w* \w my anxious thoughts|strong="H05587"\w* \w compel me to answer|strong="H07725"\w*,
\q2 \w because|strong="H05668"\w* \w of the turmoil|strong="H02363"\w* within me.
\q1 \v 3 \w I have heard|strong="H08085"\w* \w a rebuke|strong="H04148"\w* \w that insults me|strong="H03639"\w*,
\q2 \w and my understanding|strong="H00998"\w* \w prompts a reply|strong="H06030"\w*.
\b 
\q1 \v 4 \w Do you not know|strong="H03045"\w* \w that|strong="H02063"\w* \w from|strong="H04480"\w* \w antiquity|strong="H05703"\w*,
\q2 \w since|strong="H04480"\w* \w man|strong="H00120"\w* \w was placed|strong="H07760"\w* \w on|strong="H05921"\w* \w the earth|strong="H00776"\w*,
\q1 \v 5 \w the triumph|strong="H07445"\w* \w of the wicked|strong="H07563"\w* \w has been brief|strong="H07138"\w*
\q2 \w and the joy|strong="H08057"\w* \w of the godless|strong="H02611"\w* \w momentary|strong="H07281"\w*?
\q1 \v 6 \w Though|strong="H00518"\w* \w his arrogance|strong="H07863"\w* \w reaches|strong="H05927"\w* \w the heavens|strong="H08064"\w*,
\q2 \w and his head|strong="H07218"\w* \w touches|strong="H05060"\w* \w the clouds|strong="H05645"\w*,
\q1 \v 7 \w he will perish|strong="H00006"\w* \w forever|strong="H05331"\w*, \w like his own dung|strong="H01561"\w*;
\q2 \w those who had seen him|strong="H07200"\w* \w will ask|strong="H00559"\w*, ‘\w Where is he|strong="H00335"\w*?’
\q1 \v 8 \w He will fly away|strong="H05774"\w* \w like a dream|strong="H02472"\w*, \w never|strong="H03808"\w* \w to be found|strong="H04672"\w*;
\q2 \w he will be chased away|strong="H05074"\w* \w like a vision|strong="H02384"\w* \w in the night|strong="H03915"\w*.
\q1 \v 9 \w The eye|strong="H05869"\w* \w that saw him|strong="H07805"\w* \w will see him no|strong="H03808"\w* \w more|strong="H03254"\w*,
\q2 \w and his place|strong="H04725"\w* \w will no|strong="H03808"\w* \w longer|strong="H05750"\w* \w behold him|strong="H07789"\w*.
\q1 \v 10 \w His sons|strong="H01121"\w* \w will seek the favor|strong="H07521"\w* \w of the poor|strong="H01800"\w*,
\q2 \w for his own hands|strong="H03027"\w* \w must return|strong="H07725"\w* \w his wealth|strong="H00202"\w*.
\q1 \v 11 \w The youthful vigor|strong="H05934"\w* \w that fills|strong="H04390"\w* \w his bones|strong="H06106"\w*
\q2 \w will lie down|strong="H07901"\w* \w with him|strong="H05973"\w* \w in|strong="H05921"\w* \w the dust|strong="H06083"\w*.
\b 
\q1 \v 12 \w Though|strong="H00518"\w* \w evil|strong="H07451"\w* \w is sweet|strong="H04985"\w* \w in his mouth|strong="H06310"\w*
\q2 \w and he conceals|strong="H03582"\w* \w it under|strong="H08478"\w* \w his tongue|strong="H03956"\w*,
\q1 \v 13 \w though he cannot bear|strong="H02550"\w* \w to let it go|strong="H05800"\w*
\q2 \w and keeps|strong="H04513"\w* \w it in|strong="H08432"\w* \w his mouth|strong="H02441"\w*,
\q1 \v 14 \w yet in his stomach|strong="H04578"\w* \w his food|strong="H03899"\w* \w sours|strong="H02015"\w*
\q2 \w into the venom|strong="H04846"\w* \w of cobras|strong="H06620"\w* \w within him|strong="H07130"\w*.
\q1 \v 15 \w He swallows|strong="H01104"\w* \w wealth|strong="H02428"\w* \w but vomits it out|strong="H06958"\w*;
\q2 \w God|strong="H00410"\w* \w will force it|strong="H03423"\w* \w from his stomach|strong="H00990"\w*.
\q1 \v 16 \w He will suck|strong="H03243"\w* \w the poison|strong="H07219"\w* \w of cobras|strong="H06620"\w*;
\q2 \w the fangs|strong="H03956"\w* \w of a viper|strong="H00660"\w* \w will kill him|strong="H02026"\w*.
\q1 \v 17 \w He will not|strong="H00408"\w* \w enjoy|strong="H07200"\w* \w the streams|strong="H06390"\w*,
\q2 \w the rivers|strong="H05104"\w* \w flowing with|strong="H05158"\w* \w honey|strong="H01706"\w* \w and cream|strong="H02529"\w*.
\q1 \v 18 \w He must return|strong="H07725"\w* \w the fruit of his labor|strong="H03022"\w* \w without|strong="H03808"\w* \w consuming it|strong="H01104"\w*;
\q2 \w he cannot|strong="H03808"\w* \w enjoy|strong="H05965"\w* \w the profits|strong="H02428"\w* \w of his trading|strong="H08545"\w*.
\q1 \v 19 \w For|strong="H03588"\w* \w he has oppressed|strong="H07533"\w* \w and forsaken|strong="H05800"\w* \w the poor|strong="H01800"\w*;
\q2 \w he has seized|strong="H01497"\w* \w houses|strong="H01004"\w* \w he did not|strong="H03808"\w* \w build|strong="H01129"\w*.
\b 
\q1 \v 20 \w Because|strong="H03588"\w* \w his appetite|strong="H00990"\w* \w is never|strong="H03808"\w* \w satisfied|strong="H03045"\w*,
\q2 \w he cannot|strong="H03808"\w* \w escape|strong="H04422"\w* \w with his treasure|strong="H02530"\w*.
\q1 \v 21 \w Nothing|strong="H00369"\w* \w is left|strong="H08300"\w* \w for him to consume|strong="H00398"\w*;
\q2 \w thus|strong="H05921"\w* \w his prosperity|strong="H02898"\w* \w will not|strong="H03808"\w* \w endure|strong="H02342"\w*.
\q1 \v 22 \w In the midst|strong="H04390"\w* \w of his plenty|strong="H05607"\w*, \w he will be distressed|strong="H03334"\w*;
\q2 \w the full|strong="H03605"\w* \w force|strong="H03027"\w* \w of misery|strong="H06001"\w* \w will come upon him|strong="H00935"\w*.
\q1 \v 23 \w When he|strong="H01961"\w* \w has filled|strong="H04390"\w* \w his stomach|strong="H00990"\w*,
\q2 \w God will vent|strong="H07971"\w* \w His fury|strong="H02740"\w* upon him,
\q2 \w raining it down|strong="H04305"\w* \w on him|strong="H05921"\w* \w as he eats|strong="H03894"\w*.
\q1 \v 24 \w Though he flees|strong="H01272"\w* \w from an iron|strong="H01270"\w* \w weapon|strong="H05402"\w*,
\q2 \w a bronze-tipped|strong="H05154"\w* \w arrow|strong="H07198"\w* \w will pierce him|strong="H02498"\w*.
\q1 \v 25 \w It is drawn|strong="H08025"\w* \w out of|strong="H03318"\w* \w his back|strong="H01465"\w*,
\q2 \w the gleaming point|strong="H01300"\w* \w from his liver|strong="H04846"\w*.\f + \fr 20:25 \ft Literally \fqa from his gall\f*
\q2 \w Terrors|strong="H00367"\w* \w come|strong="H01980"\w* \w over him|strong="H05921"\w*.
\q1 \v 26 \w Total|strong="H03605"\w* \w darkness|strong="H02822"\w* \w is reserved|strong="H02934"\w* \w for his treasures|strong="H06845"\w*.
\q2 \w A fire|strong="H00784"\w* \w unfanned|strong="H03808"\w* \w will consume him|strong="H00398"\w*
\q2 \w and devour what is left|strong="H08300"\w* \w in his tent|strong="H00168"\w*.
\q1 \v 27 \w The heavens|strong="H08064"\w* \w will expose|strong="H01540"\w* \w his iniquity|strong="H05771"\w*,
\q2 \w and the earth|strong="H00776"\w* \w will rise up|strong="H06965"\w* against him.
\q1 \v 28 \w The possessions|strong="H02981"\w* \w of his house|strong="H01004"\w* \w will be removed|strong="H01540"\w*,
\q2 \w flowing away|strong="H05064"\w* \w on the day|strong="H03117"\w* \w of God’s wrath|strong="H00639"\w*.
\b 
\q1 \v 29 \w This|strong="H02088"\w* \w is the wicked|strong="H07563"\w* \w man’s|strong="H00120"\w* \w portion|strong="H02506"\w* \w from God|strong="H00430"\w*,
\q2 \w the inheritance|strong="H05159"\w* \w God|strong="H00410"\w* \w has appointed him|strong="H00561"\w*.”
\c 21
\s1 Job: God Will Punish the Wicked
\p \v 1 \w Then Job|strong="H00347"\w* \w answered|strong="H06030"\w*:
\b 
\q1 \v 2 “\w Listen carefully|strong="H08085"\w* \w to my words|strong="H04405"\w*;
\q2 \w let this|strong="H02063"\w* \w be|strong="H01961"\w* \w your consolation to me|strong="H08575"\w*.
\q1 \v 3 \w Bear with me|strong="H05375"\w* \w while I|strong="H00595"\w* \w speak|strong="H01696"\w*;
\q2 \w then, after|strong="H00310"\w* \w I have spoken|strong="H01696"\w*, \w you may go on mocking|strong="H03932"\w*.
\b 
\q1 \v 4 \w Is my|strong="H00595"\w* \w complaint|strong="H07879"\w* \w against a man|strong="H00120"\w*?
\q2 \w Then why|strong="H04069"\w* \w should I not|strong="H03808"\w* \w be impatient|strong="H07114"\w*?
\q1 \v 5 \w Look|strong="H06437"\w* \w at me|strong="H00413"\w* \w and be appalled|strong="H08074"\w*;
\q2 \w put|strong="H07760"\w* \w your hand|strong="H03027"\w* \w over|strong="H05921"\w* \w your mouth|strong="H06310"\w*.
\q1 \v 6 \w When|strong="H00518"\w* \w I remember|strong="H02142"\w*, \w terror|strong="H00926"\w* \w takes hold|strong="H00270"\w*,
\q2 \w and my body|strong="H01320"\w* \w trembles in horror|strong="H06427"\w*.
\q1 \v 7 \w Why|strong="H04069"\w* \w do the wicked|strong="H07563"\w* \w live on|strong="H02421"\w*,
\q2 \w growing old|strong="H06275"\w* \w and|strong="H01571"\w* \w increasing|strong="H01396"\w* \w in power|strong="H02428"\w*?
\q1 \v 8 \w Their descendants|strong="H02233"\w* \w are established|strong="H03559"\w* \w around them|strong="H05973"\w*,
\q2 \w and their offspring|strong="H06631"\w* \w before their eyes|strong="H05869"\w*.
\q1 \v 9 \w Their homes|strong="H01004"\w* \w are safe|strong="H07965"\w* \w from fear|strong="H06343"\w*;
\q2 \w no|strong="H03808"\w* \w rod of punishment|strong="H07626"\w* \w from God|strong="H00433"\w* \w is upon them|strong="H05921"\w*.
\q1 \v 10 \w Their bulls|strong="H07794"\w* \w breed|strong="H05674"\w* \w without|strong="H03808"\w* \w fail|strong="H01602"\w*;
\q2 \w their cows|strong="H06510"\w* \w bear calves|strong="H06403"\w* \w and do not|strong="H03808"\w* \w miscarry|strong="H07921"\w*.
\q1 \v 11 \w They send forth|strong="H07971"\w* \w their little ones|strong="H05759"\w* \w like a flock|strong="H06629"\w*;
\q2 \w their children|strong="H03206"\w* \w skip about|strong="H07540"\w*,
\q1 \v 12 \w singing|strong="H05375"\w* \w to the tambourine|strong="H08596"\w* \w and lyre|strong="H03658"\w*
\q2 \w and making merry|strong="H08055"\w* \w at the sound|strong="H06963"\w* \w of the flute|strong="H05748"\w*.
\q1 \v 13 \w They spend|strong="H01086"\w* \w their days|strong="H03117"\w* \w in prosperity|strong="H02896"\w*
\q2 \w and go down|strong="H05181"\w* \w to Sheol|strong="H07585"\w* \w in peace|strong="H07281"\w*.\f + \fr 21:13 \ft Or \fqa in an instant\f*
\q1 \v 14 \w Yet they say|strong="H00559"\w* \w to God|strong="H00410"\w*: ‘\w Leave us alone|strong="H05493"\w*!
\q2 \w For we have no|strong="H03808"\w* \w desire|strong="H02654"\w* \w to know|strong="H01847"\w* \w Your ways|strong="H01870"\w*.
\q1 \v 15 \w Who|strong="H04100"\w* \w is the Almighty|strong="H07706"\w*, \w that|strong="H03588"\w* \w we should serve Him|strong="H05647"\w*,
\q2 \w and what|strong="H04100"\w* \w would we gain|strong="H03276"\w* \w if|strong="H03588"\w* \w we pray|strong="H06293"\w* to Him?’
\q1 \v 16 \w Still|strong="H02005"\w*, \w their prosperity is|strong="H02898"\w* \w not|strong="H03808"\w* \w in their own hands|strong="H03027"\w*,
\q2 \w so I stay far|strong="H07368"\w* \w from the counsel|strong="H06098"\w* \w of the wicked|strong="H07563"\w*.
\b 
\q1 \v 17 \w How often|strong="H04100"\w* \w is the lamp|strong="H05216"\w* \w of the wicked|strong="H07563"\w* \w put out|strong="H01846"\w*?
\q2 \w Does disaster|strong="H00343"\w* \w come|strong="H00935"\w* \w upon them|strong="H05921"\w*?
\q2 \w Does God, in His anger|strong="H00639"\w*, \w apportion|strong="H02505"\w* \w destruction|strong="H02256"\w*?
\q1 \v 18 \w Are|strong="H01961"\w* \w they like straw|strong="H08401"\w* \w before|strong="H06440"\w* \w the wind|strong="H07307"\w*,
\q2 \w like chaff|strong="H04671"\w* \w swept away|strong="H01589"\w* \w by a storm|strong="H05492"\w*?
\q1 \v 19 \w It is said that God|strong="H00433"\w* \w lays up|strong="H06845"\w* \w one’s punishment|strong="H00205"\w* \w for his children|strong="H01121"\w*.
\q2 \w Let God repay the man|strong="H07999"\w* \w himself|strong="H00413"\w*, \w so he will know it|strong="H03045"\w*.
\q1 \v 20 \w Let his eyes|strong="H05869"\w* \w see|strong="H07200"\w* \w his own destruction|strong="H03589"\w*;
\q2 \w let him drink for himself|strong="H08354"\w* \w the wrath|strong="H02534"\w* \w of the Almighty|strong="H07706"\w*.
\q1 \v 21 \w For|strong="H03588"\w* \w what|strong="H04100"\w* \w does he care|strong="H02656"\w* \w about his household|strong="H01004"\w* \w after him|strong="H00310"\w*,
\q2 \w when the number|strong="H04557"\w* \w of his months|strong="H02320"\w* \w has run out|strong="H02686"\w*?
\b 
\q1 \v 22 \w Can anyone teach|strong="H03925"\w* \w knowledge|strong="H01847"\w* \w to God|strong="H00410"\w*,
\q2 \w since He|strong="H01931"\w* \w judges|strong="H08199"\w* \w those on high|strong="H07311"\w*?
\q1 \v 23 \w One man|strong="H02088"\w* \w dies|strong="H04191"\w* \w full of vigor|strong="H06106"\w*,
\q2 \w completely|strong="H03605"\w* \w secure|strong="H07946"\w* \w and at ease|strong="H07961"\w*.
\q1 \v 24 \w His body|strong="H05845"\w* \w is well nourished|strong="H04390"\w*,\f + \fr 21:24 \ft Literally \fqa His pails are full of milk\f*
\q2 \w and his bones|strong="H06106"\w* \w are rich|strong="H08248"\w* \w with marrow|strong="H04221"\w*.
\q1 \v 25 \w Yet another man|strong="H02088"\w* \w dies|strong="H04191"\w* \w in the bitterness|strong="H04751"\w* \w of his soul|strong="H05315"\w*,
\q2 \w having never|strong="H03808"\w* \w tasted|strong="H00398"\w* \w prosperity|strong="H02896"\w*.
\q1 \v 26 \w But together|strong="H03162"\w* \w they lie down|strong="H07901"\w* \w in|strong="H05921"\w* \w the dust|strong="H06083"\w*,
\q2 \w and worms|strong="H07415"\w* \w cover them|strong="H03680"\w* \w both|strong="H05921"\w*.
\b 
\q1 \v 27 \w Behold|strong="H02005"\w*, \w I know|strong="H03045"\w* \w your thoughts full well|strong="H04284"\w*,
\q2 \w the schemes by which|strong="H04209"\w* \w you would wrong|strong="H02554"\w* \w me|strong="H05921"\w*.
\q1 \v 28 \w For|strong="H03588"\w* \w you say|strong="H00559"\w*, ‘\w Where|strong="H00346"\w* \w now is the nobleman’s|strong="H05081"\w* \w house|strong="H01004"\w*,
\q2 \w and where|strong="H00346"\w* \w are the tents|strong="H00168"\w* \w in which the wicked|strong="H07563"\w* \w dwell|strong="H04908"\w*?’
\q1 \v 29 \w Have you never|strong="H03808"\w* \w asked|strong="H07592"\w* \w those who travel|strong="H05674"\w* \w the roads|strong="H01870"\w*?
\q2 \w Do you not|strong="H03808"\w* \w accept|strong="H05234"\w* \w their reports|strong="H00226"\w*?
\q1 \v 30 \w Indeed|strong="H03588"\w*, \w the evil|strong="H07451"\w* \w man is spared|strong="H02820"\w* \w from the day|strong="H03117"\w* \w of calamity|strong="H00343"\w*,
\q2 \w delivered|strong="H02986"\w* \w from the day|strong="H03117"\w* \w of wrath|strong="H05678"\w*.
\q1 \v 31 \w Who|strong="H04310"\w* \w denounces|strong="H05046"\w* \w his behavior|strong="H01870"\w* \w to|strong="H05921"\w* \w his face|strong="H06440"\w*?
\q2 \w Who|strong="H04310"\w* \w repays|strong="H07999"\w* him \w for what he|strong="H01931"\w* \w has done|strong="H06213"\w*?
\q1 \v 32 \w He|strong="H01931"\w* \w is carried|strong="H02986"\w* \w to the grave|strong="H06913"\w*,
\q2 \w and watch is kept|strong="H08245"\w* \w over|strong="H05921"\w* \w his tomb|strong="H01430"\w*.
\q1 \v 33 \w The clods|strong="H07263"\w* \w of the valley|strong="H05158"\w* \w are sweet|strong="H04985"\w* to him;
\q2 \w everyone|strong="H03605"\w* \w follows|strong="H04900"\w* \w behind him|strong="H00310"\w*,
\q2 \w and those before him|strong="H06440"\w* \w are without|strong="H00369"\w* \w number|strong="H04557"\w*.
\b 
\q1 \v 34 \w So how|strong="H00349"\w* \w can you comfort me|strong="H05162"\w* \w with empty words|strong="H01892"\w*?
\q2 \w For your answers|strong="H08666"\w* \w remain|strong="H07604"\w* \w full of falsehood|strong="H04604"\w*.”
\c 22
\s1 Eliphaz: Can a Man Be of Use to God?
\p \v 1 \w Then Eliphaz|strong="H00464"\w* \w the Temanite|strong="H08489"\w* \w replied|strong="H06030"\w*:
\b 
\q1 \v 2 “\w Can a man|strong="H01397"\w* \w be of use|strong="H05532"\w* \w to God|strong="H00410"\w*?
\q2 \w Can even|strong="H03588"\w* \w a wise man|strong="H07919"\w* \w benefit|strong="H05532"\w* \w Him|strong="H05921"\w*?
\q1 \v 3 \w Does it delight|strong="H02656"\w* \w the Almighty|strong="H07706"\w* \w that|strong="H03588"\w* \w you are righteous|strong="H06663"\w*?
\q2 \w Does He profit|strong="H01215"\w* \w if|strong="H03588"\w* \w your ways|strong="H01870"\w* \w are blameless|strong="H08552"\w*?
\b 
\q1 \v 4 \w Is it for your reverence|strong="H03374"\w* \w that He rebukes you|strong="H03198"\w*
\q2 \w and enters|strong="H00935"\w* \w into judgment|strong="H04941"\w* \w against you|strong="H05973"\w*?
\q1 \v 5 \w Is not|strong="H03808"\w* \w your wickedness|strong="H07451"\w* \w great|strong="H07227"\w*?
\q2 \w Are not your iniquities|strong="H05771"\w* \w endless|strong="H00369"\w*?
\q1 \v 6 \w For|strong="H03588"\w* \w you needlessly|strong="H02600"\w* \w demanded security|strong="H02254"\w* \w from your brothers|strong="H00251"\w*
\q2 \w and deprived|strong="H06584"\w* \w the naked|strong="H06174"\w* \w of their clothing|strong="H00899"\w*.
\q1 \v 7 \w You gave|strong="H08248"\w* \w no|strong="H03808"\w* \w water|strong="H04325"\w* \w to the weary|strong="H05889"\w*
\q2 \w and withheld|strong="H04513"\w* \w food|strong="H03899"\w* \w from the famished|strong="H07457"\w*,
\q1 \v 8 \w while the land|strong="H00776"\w* \w belonged to a mighty|strong="H02220"\w* \w man|strong="H00376"\w*,
\q2 \w and a man|strong="H05375"\w* \w of honor|strong="H06440"\w* \w lived|strong="H03427"\w* on it.
\q1 \v 9 \w You sent widows|strong="H00490"\w* \w away|strong="H07971"\w* \w empty-handed|strong="H07387"\w*,
\q2 \w and the strength|strong="H02220"\w* \w of the fatherless|strong="H03490"\w* \w was crushed|strong="H01792"\w*.
\q1 \v 10 \w Therefore|strong="H05921"\w* \w snares|strong="H06341"\w* \w surround you|strong="H05439"\w*,
\q2 \w and sudden|strong="H06597"\w* \w peril|strong="H06343"\w* \w terrifies you|strong="H00926"\w*;
\q1 \v 11 \w it is so dark|strong="H02822"\w* \w you cannot|strong="H03808"\w* \w see|strong="H07200"\w*,
\q2 \w and a flood|strong="H08229"\w* \w of water|strong="H04325"\w* \w covers you|strong="H03680"\w*.
\b 
\q1 \v 12 \w Is not|strong="H03808"\w* \w God|strong="H00433"\w* \w as high|strong="H01363"\w* \w as the heavens|strong="H08064"\w*?
\q2 \w Look at|strong="H07200"\w* \w the highest|strong="H07218"\w* \w stars|strong="H03556"\w*, \w how|strong="H03588"\w* \w lofty they are|strong="H07311"\w*!
\q1 \v 13 \w Yet you say|strong="H00559"\w*: ‘\w What|strong="H04100"\w* \w does God|strong="H00410"\w* \w know|strong="H03045"\w*?
\q2 \w Does He judge|strong="H08199"\w* \w through|strong="H01157"\w* \w thick darkness|strong="H06205"\w*?
\q1 \v 14 \w Thick clouds|strong="H05645"\w* \w veil|strong="H05643"\w* Him \w so He does not|strong="H03808"\w* \w see us|strong="H07200"\w*
\q2 \w as He traverses|strong="H01980"\w* \w the vault|strong="H02329"\w* \w of heaven|strong="H08064"\w*.\f + \fr 22:14 \ft Or \fqa heaven’s horizon \ft or \fqa the circle of the sky\f*’
\b 
\q1 \v 15 \w Will you stay|strong="H08104"\w* \w on the ancient|strong="H05769"\w* \w path|strong="H00734"\w*
\q2 \w that|strong="H00834"\w* \w wicked|strong="H00205"\w* \w men|strong="H04962"\w* \w have trod|strong="H01869"\w*?
\q1 \v 16 \w They|strong="H00834"\w* \w were snatched away|strong="H07059"\w* \w before|strong="H03808"\w* \w their time|strong="H06256"\w*,
\q2 \w and their foundations|strong="H03247"\w* \w were swept away|strong="H03332"\w* \w by a flood|strong="H05104"\w*.
\q1 \v 17 \w They said|strong="H00559"\w* \w to God|strong="H00410"\w*, ‘\w Depart|strong="H05493"\w* \w from us|strong="H04480"\w*.
\q2 \w What|strong="H04100"\w* \w can the Almighty|strong="H07706"\w* \w do|strong="H06466"\w* to us?’
\q1 \v 18 \w But it was He|strong="H01931"\w* \w who filled|strong="H04390"\w* \w their houses|strong="H01004"\w* \w with good things|strong="H02896"\w*;
\q2 \w so I stay far|strong="H07368"\w* \w from the counsel|strong="H06098"\w* \w of the wicked|strong="H07563"\w*.
\q1 \v 19 \w The righteous|strong="H06662"\w* \w see it|strong="H07200"\w* \w and are glad|strong="H08055"\w*;
\q2 \w the innocent|strong="H05355"\w* \w mock|strong="H03932"\w* them:
\q1 \v 20 ‘\w Surely|strong="H00518"\w* \w our foes|strong="H07009"\w* \w are destroyed|strong="H03582"\w*,
\q2 \w and fire|strong="H00784"\w* \w has consumed|strong="H00398"\w* \w their excess|strong="H03499"\w*.’
\b 
\q1 \v 21 \w Reconcile|strong="H05532"\w* \w now|strong="H04994"\w* \w and be at peace|strong="H07999"\w* \w with Him|strong="H05973"\w*;
\q2 thereby \w good|strong="H02896"\w* \w will come to you|strong="H00935"\w*.
\q1 \v 22 \w Receive|strong="H03947"\w* \w instruction|strong="H08451"\w* \w from His mouth|strong="H06310"\w*,
\q2 \w and lay up|strong="H07760"\w* \w His words|strong="H00561"\w* \w in your heart|strong="H03824"\w*.
\q1 \v 23 \w If|strong="H00518"\w* \w you return|strong="H07725"\w* \w to|strong="H05704"\w* \w the Almighty|strong="H07706"\w*, \w you will be restored|strong="H01129"\w*.
\q2 \w If you remove|strong="H07368"\w* \w injustice|strong="H05766"\w* \w from your tents|strong="H00168"\w*
\q1 \v 24 \w and consign|strong="H07896"\w* \w your gold|strong="H01220"\w* \w to|strong="H05921"\w* \w the dust|strong="H06083"\w*
\q2 \w and the gold of Ophir|strong="H00211"\w* \w to the stones|strong="H06697"\w* \w of the ravines|strong="H05158"\w*,
\q1 \v 25 \w then the Almighty|strong="H07706"\w* \w will be|strong="H01961"\w* \w your gold|strong="H01220"\w*
\q2 \w and the finest|strong="H08443"\w* \w silver|strong="H03701"\w* for you.
\q1 \v 26 \w Surely|strong="H03588"\w* \w then|strong="H00227"\w* \w you will delight|strong="H06026"\w* \w in|strong="H05921"\w* \w the Almighty|strong="H07706"\w*
\q2 \w and lift up|strong="H05375"\w* \w your face|strong="H06440"\w* \w to|strong="H00413"\w* \w God|strong="H00433"\w*.
\q1 \v 27 \w You will pray|strong="H06279"\w* \w to Him|strong="H00413"\w*, \w and He will hear you|strong="H08085"\w*,
\q2 \w and you will fulfill|strong="H07999"\w* \w your vows|strong="H05088"\w*.
\q1 \v 28 \w Your decisions|strong="H01504"\w* \w will be carried out|strong="H06965"\w*,
\q2 \w and light|strong="H00216"\w* \w will shine|strong="H05050"\w* \w on|strong="H05921"\w* \w your ways|strong="H01870"\w*.
\q1 \v 29 \w When|strong="H03588"\w* \w men are brought low|strong="H08213"\w* \w and you say|strong="H00559"\w*, ‘\w Lift them up|strong="H01466"\w*!’
\q2 \w then He will save|strong="H03467"\w* \w the lowly|strong="H07807"\w*.
\q1 \v 30 \w He will deliver even|strong="H04422"\w* \w one who is not|strong="H00336"\w* \w innocent|strong="H05355"\w*,
\q2 \w rescuing him|strong="H04422"\w* \w through the cleanness|strong="H01252"\w* \w of your hands|strong="H03709"\w*.”
\c 23
\s1 Job Longs for God
\p \v 1 \w Then Job|strong="H00347"\w* \w answered|strong="H06030"\w*:
\b 
\q1 \v 2 “\w Even|strong="H01571"\w* \w today|strong="H03117"\w* \w my complaint|strong="H07879"\w* \w is bitter|strong="H04805"\w*.
\q2 \w His hand|strong="H03027"\w* \w is heavy|strong="H03513"\w* \w despite|strong="H05921"\w* \w my groaning|strong="H00585"\w*.
\q1 \v 3 \w If only|strong="H04310"\w* \w I knew|strong="H03045"\w* \w where to find Him|strong="H04672"\w*,
\q2 \w so that I could go|strong="H00935"\w* \w to|strong="H05704"\w* \w His seat|strong="H08499"\w*.
\q1 \v 4 \w I would plead|strong="H06186"\w* \w my case|strong="H04941"\w* \w before Him|strong="H06440"\w*
\q2 \w and fill my mouth|strong="H06310"\w* \w with|strong="H04390"\w* \w arguments|strong="H08433"\w*.
\q1 \v 5 \w I would learn|strong="H03045"\w* \w how|strong="H04405"\w* \w He would answer|strong="H06030"\w*,
\q2 \w and consider|strong="H00995"\w* \w what|strong="H04100"\w* \w He would say|strong="H00559"\w*.
\q1 \v 6 \w Would He contend|strong="H07378"\w* \w with me|strong="H05978"\w* \w in His great|strong="H07230"\w* \w power|strong="H03581"\w*?
\q2 \w No|strong="H03808"\w*, \w He|strong="H01931"\w* \w would certainly|strong="H00389"\w* \w take note|strong="H07760"\w* of me.
\q1 \v 7 \w Then|strong="H08033"\w* \w an upright man|strong="H03477"\w* \w could reason|strong="H03198"\w* \w with Him|strong="H05973"\w*,
\q2 \w and I would be delivered|strong="H06403"\w* \w forever|strong="H05331"\w* \w from my Judge|strong="H08199"\w*.
\b 
\q1 \v 8 \w If|strong="H02005"\w* \w I go|strong="H01980"\w* \w east|strong="H06924"\w*, \w He is not there|strong="H00369"\w*,
\q2 \w and if I go west|strong="H00268"\w*, \w I cannot|strong="H03808"\w* \w find|strong="H00995"\w* Him.
\q1 \v 9 \w When He is at work|strong="H06213"\w* \w in the north|strong="H08040"\w*, \w I cannot|strong="H03808"\w* \w behold Him|strong="H02372"\w*;
\q2 \w when He turns|strong="H05848"\w* \w to the south|strong="H03225"\w*, \w I cannot|strong="H03808"\w* \w see Him|strong="H07200"\w*.
\q1 \v 10 \w Yet|strong="H03588"\w* \w He knows|strong="H03045"\w* \w the way I have taken|strong="H01870"\w*;
\q2 \w when He has tested me|strong="H00974"\w*, \w I will come forth|strong="H03318"\w* \w as gold|strong="H02091"\w*.
\q1 \v 11 \w My feet|strong="H07272"\w* \w have followed|strong="H00270"\w* \w in His tracks|strong="H00838"\w*;
\q2 \w I have kept|strong="H08104"\w* \w His way|strong="H01870"\w* \w without|strong="H03808"\w* \w turning aside|strong="H05186"\w*.
\q1 \v 12 \w I have not|strong="H03808"\w* \w departed|strong="H04185"\w* \w from the command|strong="H04687"\w* \w of His lips|strong="H08193"\w*;
\q2 \w I have treasured|strong="H06845"\w* \w the words|strong="H00561"\w* \w of His mouth|strong="H06310"\w*
\q2 \w more than my daily bread|strong="H02706"\w*.
\b 
\q1 \v 13 \w But He is unchangeable|strong="H01931"\w*, \w and who|strong="H04310"\w* \w can oppose Him|strong="H07725"\w*?
\q2 \w He does|strong="H06213"\w* \w what He|strong="H05315"\w* \w desires|strong="H00183"\w*.
\q1 \v 14 \w For|strong="H03588"\w* \w He carries out|strong="H07999"\w* \w His decree against me|strong="H02706"\w*,
\q2 \w and He has|strong="H05973"\w* \w many|strong="H07227"\w* such plans.
\q1 \v 15 \w Therefore|strong="H05921"\w* \w I am terrified|strong="H00926"\w* \w in His presence|strong="H06440"\w*;
\q2 \w when I consider this|strong="H00995"\w*, \w I fear|strong="H06342"\w* \w Him|strong="H04480"\w*.
\q1 \v 16 \w God|strong="H00410"\w* \w has made my heart|strong="H03820"\w* \w faint|strong="H07401"\w*;
\q2 \w the Almighty|strong="H07706"\w* \w has terrified me|strong="H00926"\w*.
\q1 \v 17 \w Yet|strong="H03588"\w* \w I am not|strong="H03808"\w* \w silenced|strong="H06789"\w* \w by|strong="H06440"\w* \w the darkness|strong="H02822"\w*,
\q2 \w by the thick darkness|strong="H00652"\w* \w that covers|strong="H03680"\w* \w my face|strong="H06440"\w*.[’’]
\c 24
\s1 Job: Judgment for the Wicked
\q1 \v 1 “\w Why|strong="H04069"\w* \w does the Almighty|strong="H07706"\w* \w not|strong="H03808"\w* \w reserve|strong="H06845"\w* \w times for judgment|strong="H06256"\w*?
\q2 \w Why may those who know Him|strong="H03045"\w* \w never|strong="H03808"\w* \w see|strong="H02372"\w* \w His days|strong="H03117"\w*?
\q1 \v 2 \w Men move|strong="H05381"\w* \w boundary stones|strong="H01367"\w*;
\q2 \w they pasture|strong="H07462"\w* \w stolen|strong="H01497"\w* \w flocks|strong="H05739"\w*.
\q1 \v 3 \w They drive away|strong="H05090"\w* \w the donkey|strong="H02543"\w* \w of the fatherless|strong="H03490"\w*
\q2 \w and take the widow’s|strong="H00490"\w* \w ox|strong="H07794"\w* \w in pledge|strong="H02254"\w*.
\q1 \v 4 \w They push|strong="H05186"\w* \w the needy|strong="H00034"\w* \w off the road|strong="H01870"\w*
\q2 \w and force all|strong="H03162"\w* \w the poor|strong="H06035"\w* \w of the land|strong="H00776"\w* \w into hiding|strong="H02244"\w*.
\b 
\q1 \v 5 \w Indeed|strong="H02005"\w*, \w like wild donkeys|strong="H06501"\w* \w in the desert|strong="H04057"\w*,
\q2 \w the poor go|strong="H03318"\w* \w to work|strong="H06467"\w* \w foraging|strong="H07836"\w* \w for food|strong="H02964"\w*;
\q2 \w the wasteland|strong="H06160"\w* \w is food|strong="H03899"\w* \w for their children|strong="H05288"\w*.
\q1 \v 6 \w They gather|strong="H07114"\w* \w fodder|strong="H01098"\w* \w in the fields|strong="H07704"\w*
\q2 \w and glean|strong="H03953"\w* \w the vineyards|strong="H03754"\w* \w of the wicked|strong="H07563"\w*.
\q1 \v 7 \w Without|strong="H01097"\w* \w clothing|strong="H03830"\w*, \w they spend the night|strong="H03885"\w* \w naked|strong="H06174"\w*;
\q2 \w they have no|strong="H00369"\w* \w covering|strong="H03682"\w* \w against the cold|strong="H07135"\w*.
\q1 \v 8 \w Drenched|strong="H07372"\w* \w by mountain|strong="H02022"\w* \w rains|strong="H02230"\w*,
\q2 \w they huddle|strong="H02263"\w* \w against the rocks|strong="H06697"\w* \w for want|strong="H01097"\w* \w of shelter|strong="H04268"\w*.
\b 
\q1 \v 9 \w The fatherless infant|strong="H03490"\w* \w is snatched|strong="H01497"\w* \w from the breast|strong="H07699"\w*;
\q2 \w the nursing child|strong="H05921"\w* \w of the poor|strong="H06041"\w* \w is seized for a debt|strong="H02254"\w*.
\q1 \v 10 \w Without|strong="H01097"\w* \w clothing|strong="H03830"\w*, \w they wander about|strong="H01980"\w* \w naked|strong="H06174"\w*.
\q2 \w They carry|strong="H05375"\w* \w the sheaves|strong="H06016"\w*, \w but still go hungry|strong="H07457"\w*.
\q1 \v 11 \w They crush olives|strong="H06671"\w* \w within|strong="H00996"\w* \w their walls|strong="H07791"\w*;
\q2 \w they tread|strong="H01869"\w* \w the winepresses|strong="H03342"\w*, \w but go thirsty|strong="H06770"\w*.
\q1 \v 12 \w From the city|strong="H05892"\w*, \w men|strong="H04962"\w* \w groan|strong="H05008"\w*,
\q2 \w and the souls|strong="H05315"\w* \w of the wounded|strong="H02491"\w* \w cry out|strong="H07768"\w*,
\q2 \w yet God|strong="H00433"\w* \w charges|strong="H07760"\w* \w no one|strong="H03808"\w* \w with wrongdoing|strong="H08604"\w*.
\b 
\q1 \v 13 \w Then there|strong="H01992"\w* \w are|strong="H01961"\w* \w those who rebel|strong="H04775"\w* \w against the light|strong="H00216"\w*,
\q2 \w not|strong="H03808"\w* \w knowing|strong="H05234"\w* \w its ways|strong="H01870"\w* \w or staying|strong="H03427"\w* \w on its paths|strong="H05410"\w*.
\q1 \v 14 \w When daylight is gone|strong="H00216"\w*, \w the murderer|strong="H07523"\w* \w rises|strong="H06965"\w*
\q2 \w to kill|strong="H06991"\w* \w the poor|strong="H06041"\w* \w and needy|strong="H00034"\w*;
\q2 \w in the night|strong="H03915"\w* \w he is|strong="H01961"\w* \w like a thief|strong="H01590"\w*.
\q1 \v 15 \w The eye|strong="H05869"\w* \w of the adulterer|strong="H05003"\w* \w watches|strong="H08104"\w* \w for twilight|strong="H05399"\w*.
\q2 \w Thinking|strong="H00559"\w*, ‘\w No|strong="H03808"\w* \w eye|strong="H05869"\w* \w will see me|strong="H07789"\w*,’ \w he covers|strong="H05643"\w* \w his face|strong="H06440"\w*.
\q1 \v 16 \w In the dark|strong="H02822"\w* \w they dig through|strong="H02864"\w* \w houses|strong="H01004"\w*;
\q2 \w by day|strong="H03119"\w* \w they shut themselves in|strong="H02856"\w*,
\q2 \w never|strong="H03808"\w* \w to experience|strong="H03045"\w* \w the light|strong="H00216"\w*.
\q1 \v 17 \w For|strong="H03588"\w* to them, \w deep darkness|strong="H06757"\w* \w is their|strong="H03162"\w* \w morning|strong="H01242"\w*;
\q2 \w surely|strong="H03588"\w* \w they are friends with|strong="H05234"\w* \w the terrors|strong="H01091"\w* \w of darkness|strong="H06757"\w*!
\b 
\q1 \v 18 \w They|strong="H01931"\w* \w are but foam|strong="H07031"\w* \w on|strong="H05921"\w* \w the surface|strong="H06440"\w* \w of the water|strong="H04325"\w*;
\q2 \w their portion|strong="H02513"\w* \w of the land|strong="H00776"\w* \w is cursed|strong="H07043"\w*,
\q2 \w so that no one|strong="H03808"\w* \w turns|strong="H06437"\w* \w toward|strong="H01870"\w* \w their vineyards|strong="H03754"\w*.
\q1 \v 19 \w As drought|strong="H06723"\w* \w and|strong="H01571"\w* \w heat|strong="H02527"\w* \w consume|strong="H01497"\w* \w the melting snow|strong="H07950"\w*,
\q2 \w so Sheol|strong="H07585"\w* \w steals those who have sinned|strong="H02398"\w*.
\q1 \v 20 \w The womb|strong="H07358"\w* \w forgets them|strong="H07911"\w*;
\q2 \w the worm|strong="H07415"\w* \w feeds on them|strong="H04985"\w*;
\q1 \w they are remembered|strong="H02142"\w* \w no|strong="H03808"\w* \w more|strong="H05750"\w*.
\q2 \w So injustice|strong="H05766"\w* \w is broken|strong="H07665"\w* \w like a tree|strong="H06086"\w*.
\q1 \v 21 \w They prey|strong="H07462"\w* \w on the barren|strong="H06135"\w* \w and childless|strong="H03808"\w*,
\q2 \w and show no|strong="H03808"\w* \w kindness|strong="H03190"\w* \w to the widow|strong="H00490"\w*.
\b 
\q1 \v 22 \w Yet by His power|strong="H03581"\w*, \w God drags away|strong="H04900"\w* \w the mighty|strong="H00047"\w*;
\q2 \w though rising up|strong="H06965"\w*, \w they have no|strong="H03808"\w* \w assurance|strong="H00539"\w* \w of life|strong="H02416"\w*.
\q1 \v 23 \w He gives|strong="H05414"\w* them \w a sense of security|strong="H00983"\w*,
\q2 \w but His eyes|strong="H05869"\w* \w are on|strong="H05921"\w* \w their ways|strong="H01870"\w*.
\q1 \v 24 \w They are exalted|strong="H07426"\w* \w for a moment|strong="H04592"\w*,
\q2 \w then they are gone|strong="H00369"\w*;
\q1 \w they are brought low|strong="H04355"\w* \w and gathered up|strong="H07092"\w* \w like all others|strong="H03605"\w*;
\q2 \w they are cut off|strong="H05243"\w* \w like heads|strong="H07218"\w* \w of grain|strong="H07641"\w*.
\q1 \v 25 \w If|strong="H00518"\w* \w this is not so|strong="H03808"\w*, \w then|strong="H00645"\w* \w who|strong="H04310"\w* \w can prove me a liar|strong="H03576"\w*
\q2 \w and reduce|strong="H07760"\w* \w my words|strong="H04405"\w* \w to nothing|strong="H00408"\w*?”
\c 25
\s1 Bildad: Man Cannot Be Righteous
\p \v 1 \w Then Bildad|strong="H01085"\w* \w the Shuhite|strong="H07747"\w* \w replied|strong="H06030"\w*:
\b 
\q1 \v 2 “\w Dominion|strong="H04910"\w* \w and awe|strong="H06343"\w* \w belong to God|strong="H05973"\w*;
\q2 \w He establishes|strong="H06213"\w* \w harmony|strong="H07965"\w* \w in the heights of heaven|strong="H04791"\w*.
\q1 \v 3 \w Can His troops|strong="H01416"\w* \w be numbered|strong="H04557"\w*?
\q2 \w On|strong="H05921"\w* \w whom|strong="H04310"\w* \w does His light|strong="H00216"\w* \w not|strong="H03808"\w* \w rise|strong="H06965"\w*?
\q1 \v 4 \w How|strong="H04100"\w* \w then can a man|strong="H00582"\w* \w be just|strong="H06663"\w* \w before|strong="H05973"\w* \w God|strong="H00410"\w*?
\q2 \w How|strong="H04100"\w* \w can one born|strong="H03205"\w* \w of woman|strong="H00802"\w* \w be pure|strong="H02135"\w*?
\q1 \v 5 \w If|strong="H02005"\w* \w even|strong="H05704"\w* \w the moon|strong="H03394"\w* \w does not|strong="H03808"\w* \w shine|strong="H00166"\w*,
\q2 \w and the stars|strong="H03556"\w* \w are not|strong="H03808"\w* \w pure|strong="H02141"\w* \w in His sight|strong="H05869"\w*,
\q1 \v 6 \w how much less|strong="H00637"\w* \w man|strong="H00582"\w*, \w who is but a maggot|strong="H07415"\w*,
\q2 \w and the son|strong="H01121"\w* \w of man|strong="H00120"\w*, \w who is but a worm|strong="H08438"\w*!”
\c 26
\s1 Job: Who Can Understand God’s Majesty?
\p \v 1 \w Then Job|strong="H00347"\w* \w answered|strong="H06030"\w*:
\b 
\q1 \v 2 “\w How|strong="H04100"\w* \w you have helped|strong="H05826"\w* \w the powerless|strong="H03808"\w*
\q2 \w and saved|strong="H03467"\w* \w the arm|strong="H02220"\w* \w that is feeble|strong="H03808"\w*!
\q1 \v 3 \w How|strong="H04100"\w* \w you have counseled|strong="H03289"\w* \w the unwise|strong="H03808"\w*
\q2 \w and provided|strong="H03045"\w* \w fully sound|strong="H07230"\w* \w insight|strong="H08454"\w*!
\q1 \v 4 \w To|strong="H00853"\w* \w whom|strong="H04310"\w* \w have you uttered|strong="H05046"\w* \w these words|strong="H04405"\w*?
\q2 \w And whose|strong="H04310"\w* \w spirit|strong="H05397"\w* \w spoke|strong="H03318"\w* \w through you|strong="H04480"\w*?
\b 
\q1 \v 5 \w The dead|strong="H07496"\w* \w tremble|strong="H02342"\w* —
\q2 \w those beneath|strong="H08478"\w* \w the waters|strong="H04325"\w* \w and those who dwell in them|strong="H07931"\w*.
\q1 \v 6 \w Sheol|strong="H07585"\w* \w is naked|strong="H06174"\w* \w before God|strong="H05048"\w*,
\q2 \w and Abaddon|strong="H00011"\w*\f + \fr 26:6 \fqa Abaddon \ft means \fqa Destruction\ft .\f* \w has no|strong="H00369"\w* \w covering|strong="H03682"\w*.
\q1 \v 7 \w He stretches out|strong="H05186"\w* \w the north|strong="H06828"\w* \w over|strong="H05921"\w* \w empty space|strong="H08414"\w*;
\q2 \w He hangs|strong="H08518"\w* \w the earth|strong="H00776"\w* \w upon|strong="H05921"\w* \w nothing|strong="H01097"\w*.
\q1 \v 8 \w He wraps up|strong="H06887"\w* \w the waters|strong="H04325"\w* \w in His clouds|strong="H05645"\w*,
\q2 \w yet the clouds|strong="H06051"\w* \w do not|strong="H03808"\w* \w burst|strong="H01234"\w* \w under their own weight|strong="H08478"\w*.
\q1 \v 9 \w He covers|strong="H00270"\w* \w the face|strong="H06440"\w* \w of the full moon|strong="H03678"\w*,\f + \fr 26:9 \ft Or \fqa of His throne\f*
\q2 \w spreading|strong="H06576"\w* \w over it|strong="H05921"\w* \w His cloud|strong="H06051"\w*.
\q1 \v 10 \w He has inscribed|strong="H02328"\w* \w a horizon|strong="H02706"\w* \w on|strong="H05921"\w* \w the face|strong="H06440"\w* \w of the waters|strong="H04325"\w*
\q2 \w at|strong="H05704"\w* \w the boundary|strong="H08503"\w* \w between|strong="H05973"\w* \w light|strong="H00216"\w* \w and darkness|strong="H02822"\w*.
\q1 \v 11 \w The foundations|strong="H05982"\w* \w of heaven|strong="H08064"\w* \w quake|strong="H07322"\w*,
\q2 \w astounded|strong="H08539"\w* \w at His rebuke|strong="H01606"\w*.
\q1 \v 12 \w By His power|strong="H03581"\w* \w He stirred|strong="H07280"\w*\f + \fr 26:12 \ft Or \fqa stilled\f* \w the sea|strong="H03220"\w*;
\q2 \w by His understanding|strong="H08394"\w* \w He shattered|strong="H04272"\w* \w Rahab|strong="H07294"\w*.
\q1 \v 13 \w By His breath|strong="H07307"\w* \w the skies|strong="H08064"\w* \w were cleared|strong="H08235"\w*;
\q2 \w His hand|strong="H03027"\w* \w pierced|strong="H02490"\w* \w the fleeing|strong="H01281"\w* \w serpent|strong="H05175"\w*.\f + \fr 26:13 \ft Hebrew \fqa nachash\ft ; translated in most cases as \fqa snake\f*
\q1 \v 14 \w Indeed|strong="H02005"\w*, \w these are|strong="H00428"\w* \w but the fringes|strong="H07098"\w* \w of His ways|strong="H01870"\w*;
\q2 \w how|strong="H04100"\w* \w faint|strong="H08102"\w* \w is the whisper|strong="H01697"\w* \w we hear|strong="H08085"\w* of Him!
\q1 \w Who then|strong="H04310"\w* \w can understand|strong="H00995"\w*
\q2 \w the thunder|strong="H07482"\w* \w of His power|strong="H01369"\w*?”
\c 27
\s1 Job Affirms His Integrity
\p \v 1 \w Job|strong="H00347"\w* \w continued|strong="H03254"\w* \w his discourse|strong="H04912"\w*:
\b 
\q1 \v 2 “\w As surely as God|strong="H00410"\w* \w lives|strong="H02416"\w*, \w who has deprived me of|strong="H05493"\w* \w justice|strong="H04941"\w* —
\q2 \w the Almighty|strong="H07706"\w*, \w who has embittered|strong="H04843"\w* \w my soul|strong="H05315"\w* —
\q1 \v 3 \w as long as|strong="H05750"\w* \w my breath|strong="H05397"\w* \w is still|strong="H03605"\w* within me
\q2 \w and the breath|strong="H07307"\w* \w of God|strong="H00433"\w* \w remains in my nostrils|strong="H00639"\w*,
\q1 \v 4 \w my lips|strong="H08193"\w* \w will not|strong="H00518"\w* \w speak|strong="H01696"\w* \w wickedness|strong="H05766"\w*,
\q2 \w and my tongue|strong="H03956"\w* \w will not|strong="H00518"\w* \w utter|strong="H01897"\w* \w deceit|strong="H07423"\w*.
\q1 \v 5 \w I will never|strong="H02486"\w* \w say that you are right|strong="H06663"\w*;
\q2 \w I will maintain|strong="H03808"\w* \w my integrity|strong="H08538"\w* \w until|strong="H05704"\w* \w I die|strong="H01478"\w*.
\q1 \v 6 \w I will cling to|strong="H02388"\w* \w my righteousness|strong="H06666"\w* \w and never|strong="H03808"\w* \w let go|strong="H07503"\w*.
\q2 \w As long as I live|strong="H03117"\w*, \w my conscience|strong="H03824"\w* \w will not|strong="H03808"\w* \w accuse me|strong="H02778"\w*.
\s1 The Wicked Man’s Portion
\q1 \v 7 \w May my enemy|strong="H00341"\w* \w be|strong="H01961"\w* \w like the wicked|strong="H07563"\w*
\q2 \w and my opponent|strong="H06965"\w* \w like the unjust|strong="H05767"\w*.
\q1 \v 8 \w For|strong="H03588"\w* \w what is|strong="H04100"\w* \w the hope|strong="H08615"\w* \w of the godless|strong="H02611"\w* \w when|strong="H03588"\w* \w he is cut off|strong="H01214"\w*,
\q2 \w when|strong="H03588"\w* \w God|strong="H00433"\w* \w takes away|strong="H07953"\w* \w his life|strong="H05315"\w*?
\q1 \v 9 \w Will God|strong="H00410"\w* \w hear|strong="H08085"\w* \w his cry|strong="H06818"\w*
\q2 \w when|strong="H03588"\w* \w distress|strong="H06869"\w* \w comes|strong="H00935"\w* \w upon him|strong="H05921"\w*?
\q1 \v 10 \w Will he delight|strong="H06026"\w* \w in|strong="H05921"\w* \w the Almighty|strong="H07706"\w*?
\q2 \w Will he call upon|strong="H07121"\w* \w God|strong="H00433"\w* \w at all|strong="H03605"\w* \w times|strong="H06256"\w*?
\q1 \v 11 \w I will instruct|strong="H03384"\w* \w you|strong="H00853"\w* \w in the power|strong="H03027"\w* \w of God|strong="H00410"\w*.
\q2 \w I will not|strong="H03808"\w* \w conceal|strong="H03582"\w* \w the ways of|strong="H00834"\w* \w the Almighty|strong="H07706"\w*.
\q1 \v 12 \w Surely|strong="H02005"\w* \w all of you|strong="H03605"\w* \w have seen it|strong="H02372"\w* \w for yourselves|strong="H00859"\w*.
\q2 \w Why then|strong="H04100"\w* \w do you keep up this|strong="H02088"\w* \w empty talk|strong="H01892"\w*?
\b 
\q1 \v 13 \w This is|strong="H02088"\w* \w the wicked|strong="H07563"\w* \w man’s|strong="H00120"\w* \w portion|strong="H02506"\w* \w from|strong="H05973"\w* \w God|strong="H00410"\w* —
\q2 \w the heritage|strong="H05159"\w* \w the ruthless|strong="H06184"\w* \w receive|strong="H03947"\w* \w from the Almighty|strong="H07706"\w*.
\q1 \v 14 \w Though|strong="H00518"\w* \w his sons|strong="H01121"\w* \w are many|strong="H07235"\w*, \w they are destined for|strong="H03926"\w* \w the sword|strong="H02719"\w*;
\q2 \w and his offspring|strong="H06631"\w* \w will never|strong="H03808"\w* \w have enough|strong="H07646"\w* \w food|strong="H03899"\w*.
\q1 \v 15 \w His survivors|strong="H08300"\w* \w will be buried|strong="H06912"\w* \w by the plague|strong="H04194"\w*,
\q2 \w and their widows|strong="H00490"\w* \w will not|strong="H03808"\w* \w weep for them|strong="H01058"\w*.
\q1 \v 16 \w Though|strong="H00518"\w* \w he heaps up|strong="H06651"\w* \w silver|strong="H03701"\w* \w like dust|strong="H06083"\w*
\q2 \w and piles up|strong="H03559"\w* \w a wardrobe|strong="H04403"\w* \w like clay|strong="H02563"\w*,
\q1 \v 17 \w what he lays up|strong="H03559"\w*, \w the righteous|strong="H06662"\w* \w will wear|strong="H03847"\w*,
\q2 \w and his silver|strong="H03701"\w* \w will be divided|strong="H02505"\w* \w by the innocent|strong="H05355"\w*.
\q1 \v 18 \w The house|strong="H01004"\w* \w he built|strong="H01129"\w* \w is like a moth’s cocoon|strong="H06211"\w*,
\q2 \w like a hut|strong="H05521"\w* \w set up|strong="H06213"\w* \w by a watchman|strong="H05341"\w*.
\q1 \v 19 \w He lies down|strong="H07901"\w* \w wealthy|strong="H06223"\w*, \w but will do so no more|strong="H03808"\w*;
\q2 \w when he opens|strong="H06491"\w* \w his eyes|strong="H05869"\w*, \w all is gone|strong="H00369"\w*.
\q1 \v 20 \w Terrors|strong="H01091"\w* \w overtake him|strong="H05381"\w* \w like a flood|strong="H04325"\w*;
\q2 \w a tempest|strong="H05492"\w* \w sweeps him away|strong="H01589"\w* \w in the night|strong="H03915"\w*.
\q1 \v 21 \w The east wind|strong="H06921"\w* \w carries him away|strong="H05375"\w*, \w and he is gone|strong="H01980"\w*;
\q2 \w it sweeps him|strong="H08175"\w* \w out of his place|strong="H04725"\w*.
\q1 \v 22 \w It hurls itself|strong="H07993"\w* \w against him|strong="H05921"\w* \w without|strong="H03808"\w* \w mercy|strong="H02550"\w*
\q2 \w as he flees headlong|strong="H01272"\w* \w from its power|strong="H03027"\w*.
\q1 \v 23 \w It claps|strong="H05606"\w* \w its hands|strong="H03709"\w* \w at him|strong="H05921"\w*
\q2 \w and hisses|strong="H08319"\w* \w him|strong="H05921"\w* \w out of his place|strong="H04725"\w*.[’’]
\c 28
\s1 Where Can Wisdom Be Found?
\q1 \v 1 “\w Surely|strong="H03588"\w* \w there is|strong="H03426"\w* \w a mine|strong="H04161"\w* \w for silver|strong="H03701"\w*
\q2 \w and a place|strong="H04725"\w* \w where gold|strong="H02091"\w* \w is refined|strong="H02212"\w*.
\q1 \v 2 \w Iron|strong="H01270"\w* \w is taken|strong="H03947"\w* \w from the earth|strong="H06083"\w*,
\q2 \w and copper|strong="H05154"\w* \w is smelted|strong="H06694"\w* \w from ore|strong="H00068"\w*.
\q1 \v 3 \w Man puts|strong="H07760"\w* \w an end|strong="H07093"\w* \w to the darkness|strong="H02822"\w*;
\q2 \w he|strong="H01931"\w* \w probes|strong="H02713"\w* \w the farthest recesses|strong="H03605"\w*
\q2 \w for ore|strong="H00068"\w* \w in deepest darkness|strong="H00652"\w*.
\q1 \v 4 \w Far from|strong="H04480"\w* \w human habitation|strong="H01481"\w* \w he cuts|strong="H06555"\w* \w a shaft|strong="H05158"\w*
\q2 \w in places forgotten|strong="H07911"\w* \w by the foot of man|strong="H07272"\w*.
\q2 \w Far from men|strong="H00582"\w* \w he dangles|strong="H01809"\w* \w and sways|strong="H05128"\w*.
\q1 \v 5 \w Food|strong="H03899"\w* \w may come|strong="H03318"\w* \w from|strong="H04480"\w* \w the earth|strong="H00776"\w*,
\q2 \w but from below|strong="H08478"\w* \w it is transformed|strong="H02015"\w* \w as|strong="H03644"\w* \w by fire|strong="H00784"\w*.
\q1 \v 6 \w Its rocks|strong="H00068"\w* \w are the source|strong="H04725"\w* \w of sapphires|strong="H05601"\w*,
\q2 \w containing flecks|strong="H06083"\w* \w of gold|strong="H02091"\w*.
\q1 \v 7 \w No|strong="H03808"\w* \w bird of prey|strong="H05861"\w* \w knows|strong="H03045"\w* \w that path|strong="H05410"\w*;
\q2 \w no|strong="H03808"\w* \w falcon’s|strong="H00344"\w* \w eye|strong="H05869"\w* \w has seen it|strong="H07805"\w*.
\q1 \v 8 \w Proud beasts|strong="H01121"\w* \w have never|strong="H03808"\w* \w trodden it|strong="H01869"\w*;
\q2 \w no|strong="H03808"\w* \w lion|strong="H07826"\w* \w has ever prowled|strong="H05710"\w* \w over it|strong="H05921"\w*.
\q1 \v 9 \w The miner strikes|strong="H07971"\w* \w the flint|strong="H02496"\w*;
\q2 \w he overturns|strong="H02015"\w* \w mountains|strong="H02022"\w* \w at their base|strong="H08328"\w*.
\q1 \v 10 \w He hews out|strong="H01234"\w* \w channels|strong="H02975"\w* \w in the rocks|strong="H06697"\w*,
\q2 \w and his eyes|strong="H05869"\w* \w spot|strong="H07200"\w* \w every|strong="H03605"\w* \w treasure|strong="H03366"\w*.
\q1 \v 11 \w He stops up|strong="H02280"\w*\f + \fr 28:11 \ft Hebrew; LXX and Vulgate \fqa He searches\f* \w the sources|strong="H01065"\w* \w of the streams|strong="H05104"\w*
\q2 \w to bring|strong="H03318"\w* \w what is hidden|strong="H08587"\w* \w to light|strong="H00216"\w*.
\b 
\q1 \v 12 \w But where|strong="H00370"\w* \w can wisdom|strong="H02451"\w* \w be found|strong="H04672"\w*,
\q2 \w and where|strong="H00335"\w* \w does understanding|strong="H00998"\w* \w dwell|strong="H04725"\w*?
\q1 \v 13 \w No|strong="H03808"\w* \w man|strong="H00582"\w* \w can know|strong="H03045"\w* \w its value|strong="H06187"\w*,
\q2 \w nor|strong="H03808"\w* \w is it found|strong="H04672"\w* \w in the land|strong="H00776"\w* \w of the living|strong="H02416"\w*.
\q1 \v 14 \w The ocean depths|strong="H08415"\w* \w say|strong="H00559"\w*, ‘\w It is|strong="H01931"\w* \w not|strong="H03808"\w* in me,’
\q2 \w while the sea|strong="H03220"\w* \w declares|strong="H00559"\w*, ‘\w It is not|strong="H00369"\w* \w with me|strong="H05978"\w*.’
\q1 \v 15 \w It cannot|strong="H03808"\w* \w be bought|strong="H05414"\w* \w with|strong="H08478"\w* \w gold|strong="H05458"\w*,
\q2 \w nor can|strong="H03808"\w* \w its price|strong="H04242"\w* \w be weighed out|strong="H08254"\w* \w in silver|strong="H03701"\w*.
\q1 \v 16 \w It cannot|strong="H03808"\w* \w be valued|strong="H05541"\w* \w in the gold|strong="H03800"\w* \w of Ophir|strong="H00211"\w*,
\q2 \w in precious|strong="H03368"\w* \w onyx|strong="H07718"\w* \w or sapphire|strong="H05601"\w*.
\q1 \v 17 \w Neither|strong="H03808"\w* \w gold|strong="H02091"\w* \w nor crystal|strong="H02137"\w* \w can compare to it|strong="H06186"\w*,
\q2 \w nor jewels|strong="H03627"\w* \w of fine gold|strong="H06337"\w* \w be exchanged for it|strong="H08545"\w*.
\q1 \v 18 \w Coral|strong="H07215"\w* \w and quartz|strong="H01378"\w* \w are unworthy|strong="H03808"\w* \w of mention|strong="H02142"\w*;
\q2 \w the price|strong="H04901"\w* \w of wisdom is|strong="H02451"\w* \w beyond rubies|strong="H06443"\w*.
\q1 \v 19 \w Topaz|strong="H06357"\w* \w from Cush|strong="H03568"\w*\f + \fr 28:19 \ft That is, the upper Nile region\f* \w cannot|strong="H03808"\w* \w compare to it|strong="H06186"\w*,
\q2 \w nor can it|strong="H03808"\w* \w be valued|strong="H05541"\w* \w in pure|strong="H02889"\w* \w gold|strong="H03800"\w*.
\b 
\q1 \v 20 \w From where|strong="H00370"\w*, \w then, does wisdom|strong="H02451"\w* \w come|strong="H00935"\w*,
\q2 \w and where|strong="H00335"\w* \w does understanding|strong="H00998"\w* \w dwell|strong="H04725"\w*?
\q1 \v 21 \w It is hidden|strong="H05956"\w* \w from the eyes|strong="H05869"\w* \w of every|strong="H03605"\w* \w living thing|strong="H02416"\w*
\q2 \w and concealed|strong="H05641"\w* \w from the birds|strong="H05775"\w* \w of the air|strong="H08064"\w*.
\q1 \v 22 \w Abaddon|strong="H00011"\w*\f + \fr 28:22 \fqa Abaddon \ft means \fqa Destruction\ft .\f* \w and Death|strong="H04194"\w* \w say|strong="H00559"\w*,
\q2 ‘\w We have heard|strong="H08085"\w* \w a rumor about it|strong="H08088"\w*.’
\q1 \v 23 \w But God|strong="H00430"\w* \w understands|strong="H00995"\w* \w its way|strong="H01870"\w*,
\q2 \w and He|strong="H01931"\w* \w knows|strong="H03045"\w* \w its place|strong="H04725"\w*.
\q1 \v 24 \w For|strong="H03588"\w* \w He|strong="H01931"\w* \w looks|strong="H05027"\w* \w to the ends|strong="H07098"\w* \w of the earth|strong="H00776"\w*
\q2 \w and sees|strong="H07200"\w* \w everything|strong="H03605"\w* \w under|strong="H08478"\w* \w the heavens|strong="H08064"\w*.
\q1 \v 25 \w When God fixed|strong="H06213"\w* \w the weight|strong="H04948"\w* \w of the wind|strong="H07307"\w*
\q2 \w and measured out|strong="H04060"\w* \w the waters|strong="H04325"\w*,
\q1 \v 26 \w when He set|strong="H06213"\w* \w a limit|strong="H02706"\w* \w for the rain|strong="H04306"\w*
\q2 \w and a path|strong="H01870"\w* \w for the thunderbolt|strong="H02385"\w*,
\q1 \v 27 \w then|strong="H00227"\w* \w He looked at wisdom|strong="H07200"\w* \w and appraised it|strong="H05608"\w*;
\q2 \w He established it|strong="H03559"\w* \w and searched it out|strong="H02713"\w*.
\q1 \v 28 \w And He said|strong="H00559"\w* \w to man|strong="H00120"\w*, ‘\w Behold|strong="H02005"\w*,
\q2 \w the fear|strong="H03374"\w* \w of the Lord|strong="H00136"\w*, \w that is|strong="H01931"\w* \w wisdom|strong="H02451"\w*,
\q2 \w and to turn away|strong="H05493"\w* \w from evil|strong="H07451"\w* \w is understanding|strong="H00998"\w*.’”
\c 29
\s1 Job’s Former Blessings
\p \v 1 \w And Job|strong="H00347"\w* \w continued|strong="H03254"\w* \w his discourse|strong="H04912"\w*:
\b 
\q1 \v 2 “\w How I long|strong="H04310"\w* \w for the months|strong="H03391"\w* \w gone by|strong="H06924"\w*,
\q2 \w for the days|strong="H03117"\w* \w when God|strong="H00433"\w* \w watched over me|strong="H08104"\w*,
\q1 \v 3 \w when His lamp|strong="H05216"\w* \w shone|strong="H01984"\w* \w above|strong="H05921"\w* \w my head|strong="H07218"\w*,
\q2 \w and by His light|strong="H00216"\w* \w I walked|strong="H01980"\w* \w through the darkness|strong="H02822"\w*,
\q1 \v 4 \w when|strong="H00834"\w* \w I was|strong="H01961"\w* \w in my prime|strong="H02779"\w*,\f + \fr 29:4 \ft Hebrew \fqa in the time of my harvest\f*
\q2 \w when the friendship|strong="H05475"\w* \w of God|strong="H00433"\w* \w rested on|strong="H05921"\w* \w my tent|strong="H00168"\w*,
\q1 \v 5 \w when the Almighty|strong="H07706"\w* \w was still|strong="H05750"\w* \w with me|strong="H05978"\w*
\q2 \w and my children|strong="H05288"\w* \w were around me|strong="H05439"\w*,
\q1 \v 6 \w when my steps|strong="H01978"\w* \w were bathed|strong="H07364"\w* \w in cream|strong="H02529"\w*
\q2 \w and the rock|strong="H06697"\w* \w poured out|strong="H06694"\w* \w for me|strong="H05978"\w* \w streams|strong="H06388"\w* \w of oil|strong="H08081"\w*!
\b 
\q1 \v 7 \w When I went out|strong="H03318"\w* \w to the city|strong="H07176"\w* \w gate|strong="H08179"\w*
\q2 \w and took|strong="H03559"\w* \w my seat|strong="H04186"\w* \w in the public square|strong="H07339"\w*,
\q1 \v 8 \w the young men|strong="H05288"\w* \w saw me|strong="H07200"\w* \w and withdrew|strong="H02244"\w*,
\q2 \w and the old men|strong="H03453"\w* \w rose|strong="H06965"\w* \w to their feet|strong="H05975"\w*.
\q1 \v 9 \w The princes|strong="H08269"\w* \w refrained|strong="H06113"\w* \w from speaking|strong="H04405"\w*
\q2 \w and covered|strong="H07760"\w* \w their mouths|strong="H06310"\w* \w with their hands|strong="H03709"\w*.
\q1 \v 10 \w The voices|strong="H06963"\w* \w of the nobles|strong="H05057"\w* \w were hushed|strong="H02244"\w*,
\q2 \w and their tongues|strong="H03956"\w* \w stuck|strong="H01692"\w* \w to the roofs of their mouths|strong="H02441"\w*.
\q1 \v 11 \w For|strong="H03588"\w* \w those|strong="H00241"\w* \w who heard me|strong="H08085"\w* \w called me blessed|strong="H00833"\w*,
\q2 \w and those who|strong="H05869"\w* \w saw me|strong="H07200"\w* \w commended me|strong="H05749"\w*,
\q1 \v 12 \w because|strong="H03588"\w* \w I rescued|strong="H04422"\w* \w the poor|strong="H06041"\w* \w who cried out|strong="H07768"\w*
\q2 \w and the fatherless|strong="H03490"\w* \w who had no|strong="H03808"\w* \w helper|strong="H05826"\w*.
\q1 \v 13 \w The dying man|strong="H00006"\w* \w blessed me|strong="H01293"\w*,
\q2 \w and I made the widow’s|strong="H00490"\w* \w heart|strong="H03820"\w* \w sing for joy|strong="H07442"\w*.
\q1 \v 14 \w I put on|strong="H03847"\w* \w righteousness|strong="H06664"\w*, \w and it clothed me|strong="H03847"\w*;
\q2 \w justice|strong="H04941"\w* \w was my robe|strong="H04598"\w* \w and my turban|strong="H06797"\w*.
\q1 \v 15 \w I served as|strong="H01961"\w* \w eyes|strong="H05869"\w* \w to the blind|strong="H05787"\w*
\q2 \w and|strong="H00589"\w* \w as feet|strong="H07272"\w* \w to the lame|strong="H06455"\w*.
\q1 \v 16 \w I|strong="H00595"\w* \w was a father|strong="H00001"\w* \w to the needy|strong="H00034"\w*,
\q2 \w and I took up|strong="H02713"\w* \w the case|strong="H07379"\w* \w of the stranger|strong="H03808"\w*.
\q1 \v 17 \w I shattered|strong="H07665"\w* \w the fangs|strong="H04973"\w* \w of the unjust|strong="H05767"\w*
\q2 \w and snatched|strong="H07993"\w* \w the prey|strong="H02964"\w* \w from his teeth|strong="H08127"\w*.
\b 
\q1 \v 18 \w So I thought|strong="H00559"\w*: ‘\w I will die|strong="H01478"\w* \w in|strong="H05973"\w* \w my nest|strong="H07064"\w*
\q2 \w and multiply|strong="H07235"\w* \w my days|strong="H03117"\w* \w as the sand|strong="H02344"\w*.
\q1 \v 19 \w My roots|strong="H08328"\w* \w will spread out|strong="H06605"\w* \w to|strong="H00413"\w* \w the waters|strong="H04325"\w*,
\q2 \w and the dew|strong="H02919"\w* \w will rest nightly|strong="H03885"\w* \w on my branches|strong="H07105"\w*.
\q1 \v 20 \w My glory|strong="H03519"\w* \w is ever new|strong="H02319"\w* \w within me|strong="H05978"\w*,
\q2 \w and my bow|strong="H07198"\w* \w is renewed|strong="H02498"\w* \w in my hand|strong="H03027"\w*.’
\b 
\q1 \v 21 \w Men listened|strong="H08085"\w* to me \w with expectation|strong="H03176"\w*,
\q2 \w waiting silently|strong="H01826"\w* \w for|strong="H03926"\w* \w my counsel|strong="H06098"\w*.
\q1 \v 22 \w After|strong="H00310"\w* \w my words|strong="H01697"\w*, \w they spoke|strong="H08138"\w* \w no more|strong="H03808"\w*;
\q2 \w my speech|strong="H04405"\w* \w settled|strong="H05197"\w* \w on them like dew|strong="H05921"\w*.
\q1 \v 23 \w They waited|strong="H03176"\w* \w for me as for rain|strong="H04306"\w*
\q2 \w and drank in my words|strong="H06473"\w* \w like spring showers|strong="H04456"\w*.
\q1 \v 24 \w If I smiled|strong="H07832"\w* \w at them|strong="H00413"\w*, \w they did not|strong="H03808"\w* \w believe it|strong="H00539"\w*;
\q2 \w the light|strong="H00216"\w* \w of my countenance|strong="H06440"\w* \w was precious|strong="H05307"\w*.
\q1 \v 25 \w I chose|strong="H00977"\w* \w their course|strong="H01870"\w* \w and presided|strong="H03427"\w* \w as chief|strong="H07218"\w*.
\q2 \w So I dwelt|strong="H07931"\w* \w as a king|strong="H04428"\w* \w among his troops|strong="H01416"\w*,
\q2 \w as a comforter|strong="H00834"\w* \w of the mourners|strong="H00057"\w*.[’’]
\c 30
\s1 Job’s Honor Turned to Contempt
\q1 \v 1 “\w But now|strong="H06258"\w* \w they mock me|strong="H07832"\w*,
\q2 \w men younger|strong="H06810"\w* \w than I am|strong="H04480"\w*,
\q1 \w whose|strong="H00834"\w* \w fathers|strong="H00001"\w* \w I would have refused|strong="H03988"\w*
\q2 \w to put|strong="H07896"\w* \w with|strong="H05973"\w* \w my sheep|strong="H06629"\w* \w dogs|strong="H03611"\w*.
\q1 \v 2 \w What use|strong="H04100"\w* to me \w was the strength|strong="H03581"\w* \w of their hands|strong="H03027"\w*,
\q2 \w since their vigor|strong="H03624"\w* \w had left them|strong="H00006"\w*?
\q1 \v 3 \w Gaunt|strong="H01565"\w* \w from poverty|strong="H02639"\w* \w and hunger|strong="H03720"\w*,
\q2 \w they gnawed|strong="H06207"\w* \w the dry land|strong="H06723"\w*,
\q2 \w and the desolate|strong="H07722"\w* \w wasteland|strong="H04875"\w* \w by night|strong="H00570"\w*.
\q1 \v 4 \w They plucked|strong="H06998"\w* \w mallow|strong="H04408"\w* \w among|strong="H05921"\w* \w the shrubs|strong="H07880"\w*,
\q2 \w and the roots|strong="H08328"\w* \w of the broom tree|strong="H07574"\w* \w were their food|strong="H03899"\w*.\f + \fr 30:4 \ft Or \fqa their fuel\f*
\q1 \v 5 \w They were banished|strong="H01644"\w* \w from|strong="H04480"\w* \w among men|strong="H01460"\w*,
\q2 \w shouted|strong="H07321"\w* \w at|strong="H05921"\w* \w like thieves|strong="H01590"\w*,
\q1 \v 6 \w so that they lived|strong="H07931"\w* \w on the slopes|strong="H06178"\w* \w of the wadis|strong="H05158"\w*,
\q2 \w among the rocks|strong="H03710"\w* \w and in holes|strong="H02356"\w* \w in the ground|strong="H06083"\w*.
\q1 \v 7 \w They cried out|strong="H05101"\w* \w among|strong="H00996"\w* \w the shrubs|strong="H07880"\w*
\q2 \w and huddled|strong="H05596"\w* \w beneath|strong="H08478"\w* \w the nettles|strong="H02738"\w*.
\q1 \v 8 \w A senseless|strong="H05036"\w* \w and|strong="H01571"\w* \w nameless|strong="H08034"\w* \w brood|strong="H01121"\w*,
\q2 \w they were driven|strong="H05217"\w* \w off|strong="H04480"\w* \w the land|strong="H00776"\w*.
\b 
\q1 \v 9 \w And now|strong="H06258"\w* \w they mock me in song|strong="H05058"\w*;
\q2 \w I have become|strong="H01961"\w* \w a byword|strong="H04405"\w* among them.
\q1 \v 10 \w They abhor me|strong="H08581"\w* \w and keep far|strong="H07368"\w* \w from me|strong="H04480"\w*;
\q2 \w they do not|strong="H03808"\w* \w hesitate|strong="H02820"\w* \w to spit|strong="H07536"\w* \w in my face|strong="H06440"\w*.
\q1 \v 11 \w Because|strong="H03588"\w* \w God has unstrung|strong="H06605"\w* \w my bow|strong="H03499"\w* \w and afflicted me|strong="H06031"\w*,
\q2 \w they have cast off|strong="H07971"\w* \w restraint|strong="H07448"\w*\f + \fr 30:11 \ft Hebrew \fqa the bridle\f* \w in my presence|strong="H06440"\w*.
\q1 \v 12 \w The rabble|strong="H06526"\w* \w arises|strong="H06965"\w* \w at|strong="H05921"\w* \w my right|strong="H03225"\w*;
\q2 \w they lay snares|strong="H07971"\w* \w for my feet|strong="H07272"\w*
\q2 \w and build|strong="H05549"\w* \w siege ramps|strong="H00734"\w* \w against me|strong="H05921"\w*.
\q1 \v 13 \w They tear up|strong="H05420"\w* \w my path|strong="H05410"\w*;
\q2 \w they profit|strong="H03276"\w* \w from my destruction|strong="H01942"\w*,
\q2 \w with no one|strong="H03808"\w* \w to restrain|strong="H05826"\w* them.\f + \fr 30:13 \ft Or \fqa with no one to assist them\f*
\q1 \v 14 \w They advance|strong="H00857"\w* \w as through a wide|strong="H07342"\w* \w breach|strong="H06556"\w*;
\q2 \w through|strong="H08478"\w* \w the ruins|strong="H07722"\w* \w they keep rolling in|strong="H01556"\w*.
\s1 Job’s Prosperity Becomes Calamity
\q1 \v 15 \w Terrors|strong="H01091"\w* \w are turned loose|strong="H02015"\w* \w against me|strong="H05921"\w*;
\q2 \w they drive away|strong="H07291"\w* \w my dignity|strong="H05082"\w* \w as by the wind|strong="H07307"\w*,
\q2 \w and my prosperity|strong="H03444"\w* \w has passed|strong="H05674"\w* \w like a cloud|strong="H05645"\w*.
\q1 \v 16 \w And now|strong="H06258"\w* \w my soul|strong="H05315"\w* \w is poured out|strong="H08210"\w* \w within me|strong="H05921"\w*;
\q2 \w days|strong="H03117"\w* \w of affliction|strong="H06040"\w* \w grip me|strong="H00270"\w*.
\q1 \v 17 \w Night|strong="H03915"\w* \w pierces|strong="H05365"\w* \w my bones|strong="H06106"\w*,
\q2 \w and my gnawing pains|strong="H06207"\w* \w never|strong="H03808"\w* \w rest|strong="H07901"\w*.
\q1 \v 18 \w With great|strong="H07227"\w* \w force|strong="H03581"\w* \w He grasps|strong="H02664"\w* \w my garment|strong="H03830"\w*;\f + \fr 30:18 \ft LXX; Hebrew \fqa He becomes like a garment to me \ft or \fqa my garment is disfigured\f*
\q2 \w He seizes me|strong="H00247"\w* \w by the collar|strong="H06310"\w* \w of my tunic|strong="H03801"\w*.
\q1 \v 19 \w He throws me|strong="H03384"\w* \w into the mud|strong="H02563"\w*,
\q2 \w and I have become|strong="H04911"\w* \w like dust|strong="H06083"\w* \w and ashes|strong="H00665"\w*.
\b 
\q1 \v 20 \w I cry out to You|strong="H00413"\w* \w for help|strong="H07768"\w*, \w but You do not|strong="H03808"\w* \w answer|strong="H06030"\w*;
\q2 \w when I stand up|strong="H05975"\w*, \w You merely look|strong="H00995"\w* at me.
\q1 \v 21 \w You have ruthlessly turned|strong="H02015"\w* on me;
\q2 \w You oppose me|strong="H07852"\w* \w with Your strong|strong="H06108"\w* \w hand|strong="H03027"\w*.
\q1 \v 22 \w You snatch me up|strong="H05375"\w* \w into|strong="H00413"\w* \w the wind|strong="H07307"\w*
\q2 \w and drive me before it|strong="H07392"\w*;
\q2 \w You toss me about|strong="H04127"\w*\f + \fr 30:22 \ft Or \fqa You dissolve me\f* \w in the storm|strong="H07737"\w*.
\q1 \v 23 \w Yes|strong="H03588"\w*, \w I know that|strong="H03045"\w* \w You will bring me down|strong="H07725"\w* \w to death|strong="H04194"\w*,
\q2 \w to the place|strong="H01004"\w* \w appointed|strong="H04150"\w* \w for all|strong="H03605"\w* \w the living|strong="H02416"\w*.
\b 
\q1 \v 24 \w Yet|strong="H00389"\w* \w no one|strong="H03808"\w* \w stretches out|strong="H07971"\w* \w his hand|strong="H03027"\w* \w against a ruined man|strong="H05856"\w*
\q2 \w when|strong="H00518"\w* \w he cries for help|strong="H07769"\w* \w in his distress|strong="H06365"\w*.
\q1 \v 25 \w Have I not|strong="H03808"\w* \w wept|strong="H01058"\w* \w for those in trouble|strong="H07186"\w*?
\q2 \w Has my soul|strong="H05315"\w* \w not grieved|strong="H05701"\w* \w for the needy|strong="H00034"\w*?
\q1 \v 26 \w But when|strong="H03588"\w* \w I hoped for|strong="H06960"\w* \w good|strong="H02896"\w*, \w evil|strong="H07451"\w* \w came|strong="H00935"\w*;
\q2 \w when I looked|strong="H03176"\w* \w for light|strong="H00216"\w*, \w darkness|strong="H00652"\w* \w fell|strong="H00935"\w*.
\q1 \v 27 \w I am churning|strong="H07570"\w* \w within|strong="H04578"\w* \w and cannot|strong="H03808"\w* \w rest|strong="H01826"\w*;
\q2 \w days|strong="H03117"\w* \w of affliction|strong="H06040"\w* \w confront me|strong="H06923"\w*.
\q1 \v 28 \w I go about|strong="H01980"\w* \w blackened|strong="H06937"\w*, \w but not|strong="H03808"\w* \w by the sun|strong="H02535"\w*.
\q2 \w I stand up|strong="H06965"\w* \w in the assembly|strong="H06951"\w* \w and cry for help|strong="H07768"\w*.
\q1 \v 29 \w I have become|strong="H01961"\w* \w a brother|strong="H00251"\w* \w of jackals|strong="H08577"\w*,\f + \fr 30:29 \ft Or \fqa serpents \ft or \fqa dragons\f*
\q2 \w a companion|strong="H07453"\w* \w of ostriches|strong="H03284"\w*.\f + \fr 30:29 \ft Literally \fqa of daughters of an ostrich \ft or \fqa of daughters of an owl\f*
\q1 \v 30 \w My skin|strong="H05785"\w* \w grows black|strong="H07835"\w* \w and peels|strong="H04480"\w*,
\q2 \w and my bones|strong="H06106"\w* \w burn|strong="H02787"\w* \w with fever|strong="H02721"\w*.
\q1 \v 31 \w My harp|strong="H03658"\w* \w is tuned|strong="H01961"\w* \w to mourning|strong="H00060"\w*
\q2 \w and my flute|strong="H05748"\w* \w to the sound|strong="H06963"\w* \w of weeping|strong="H01058"\w*.[’’]
\c 31
\s1 Job’s Final Appeal
\q1 \v 1 “\w I have made|strong="H03772"\w* \w a covenant|strong="H01285"\w* \w with my eyes|strong="H05869"\w*.
