\q1 \v 29 \w He will no|strong="H03808"\w* \w longer be rich|strong="H06238"\w*; \w his wealth|strong="H02428"\w* \w will not|strong="H03808"\w* \w endure|strong="H06965"\w*.
\q2 \w His possessions|strong="H04512"\w* \w will not|strong="H03808"\w* \w overspread|strong="H05186"\w* \w the land|strong="H00776"\w*.
\q1 \v 30 \w He will not|strong="H03808"\w* \w escape|strong="H05493"\w* \w from|strong="H04480"\w* \w the darkness|strong="H02822"\w*;
