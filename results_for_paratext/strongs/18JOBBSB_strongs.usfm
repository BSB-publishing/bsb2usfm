\p \v 1 \w So these|strong="H00428"\w* \w three|strong="H07969"\w* \w men|strong="H00582"\w* \w stopped|strong="H07673"\w* \w answering|strong="H06030"\w* \w Job|strong="H00347"\w*, \w because|strong="H03588"\w* \w he|strong="H01931"\w* \w was righteous|strong="H06662"\w* \w in his own eyes|strong="H05869"\w*.
