\b 
\q1 \v 13 \w Such|strong="H03651"\w* \w is the destiny|strong="H00734"\w* \w of all|strong="H03605"\w* \w who forget|strong="H07911"\w* \w God|strong="H00410"\w*;
\q2 \w so the hope|strong="H08615"\w* \w of the godless|strong="H02611"\w* \w will perish|strong="H00006"\w*.
\q1 \v 14 \w His|strong="H00834"\w* \w confidence|strong="H03689"\w* \w is fragile|strong="H06990"\w*;
\q2 \w his security|strong="H04009"\w* \w is in a spider’s|strong="H05908"\w* \w web|strong="H01004"\w*.
\q1 \v 15 \w He leans|strong="H08172"\w* \w on|strong="H05921"\w* \w his web|strong="H01004"\w*, \w but it gives way|strong="H05975"\w*;
\q2 \w he holds fast|strong="H02388"\w*, \w but it does not|strong="H03808"\w* \w endure|strong="H06965"\w*.
\q1 \v 16 \w He|strong="H01931"\w* \w is a well-watered plant|strong="H07373"\w* \w in|strong="H06440"\w* \w the sunshine|strong="H08121"\w*,
\q2 \w spreading|strong="H03318"\w* \w its shoots|strong="H03127"\w* \w over|strong="H05921"\w* \w the garden|strong="H01593"\w*.
\q1 \v 17 \w His roots|strong="H08328"\w* \w wrap|strong="H05440"\w* \w around|strong="H05921"\w* \w the rock heap|strong="H01530"\w*;
\q2 \w he looks for|strong="H02372"\w* \w a home among|strong="H01004"\w* \w the stones|strong="H00068"\w*.
\q1 \v 18 \w If|strong="H00518"\w* \w he is uprooted|strong="H01104"\w* \w from his place|strong="H04725"\w*,
\q2 \w it will disown|strong="H03584"\w* him, \w saying, ‘ I never|strong="H03808"\w* \w saw you|strong="H07200"\w*.’
