\b 
\q1 \v 27 \w Though|strong="H03588"\w* \w his face|strong="H06440"\w* \w is covered|strong="H03680"\w* \w with fat|strong="H02459"\w*
\q2 \w and his waistline|strong="H03689"\w* \w bulges|strong="H06213"\w* \w with flesh|strong="H06371"\w*,
\q1 \v 28 \w he will dwell|strong="H07931"\w* \w in ruined|strong="H03582"\w* \w cities|strong="H05892"\w*,
