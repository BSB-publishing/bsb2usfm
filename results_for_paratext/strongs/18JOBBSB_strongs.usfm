\c 40
\s1 Job Humbles Himself before the LORD
\p \v 1 \w And the LORD|strong="H03068"\w* \w said|strong="H06030"\w* \w to Job|strong="H00347"\w*:
\b 
\q1 \v 2 “\w Will the faultfinder|strong="H03250"\w* \w contend|strong="H07378"\w* \w with|strong="H05973"\w* \w the Almighty|strong="H07706"\w*?
\q2 \w Let him who argues|strong="H03198"\w* \w with God|strong="H00433"\w* \w give an answer|strong="H06030"\w*.”
\b 
\q1 
\p \v 3 \w Then Job|strong="H00347"\w* \w answered|strong="H06030"\w* \w the LORD|strong="H03068"\w*:
\b 
\q1 \v 4 “\w Behold|strong="H02005"\w*, \w I am insignificant|strong="H07043"\w*. \w How|strong="H04100"\w* \w can I reply to You|strong="H07725"\w*?
