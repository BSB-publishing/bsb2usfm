\q1 \v 8 \w Surely|strong="H00389"\w* \w you have spoken|strong="H00559"\w* \w in my hearing|strong="H00241"\w*,
\q2 \w and I have heard|strong="H08085"\w* \w these very words|strong="H04405"\w*:
\q1 \v 9 ‘\w I|strong="H00589"\w* \w am pure|strong="H02134"\w*, \w without|strong="H01097"\w* \w transgression|strong="H06588"\w*;
\q2 \w I|strong="H00595"\w* \w am clean|strong="H02643"\w*, \w with no|strong="H03808"\w* \w iniquity|strong="H05771"\w* in me.
\q1 \v 10 \w Yet|strong="H02005"\w* \w God finds|strong="H04672"\w* \w occasions|strong="H08569"\w* \w against me|strong="H05921"\w*;
\q2 \w He counts me|strong="H02803"\w* as His \w enemy|strong="H00341"\w*.
\q1 \v 11 \w He puts|strong="H07760"\w* \w my feet|strong="H07272"\w* \w in the stocks|strong="H05465"\w*;
\q2 \w He watches over|strong="H08104"\w* \w all|strong="H03605"\w* \w my paths|strong="H00734"\w*.’
\b 
\q1 \v 12 \w Behold|strong="H02005"\w*, \w you are not|strong="H03808"\w* \w right|strong="H06663"\w* \w in this matter|strong="H02063"\w*.
\q2 \w I will answer you|strong="H06030"\w*, \w for|strong="H03588"\w* \w God|strong="H00433"\w* \w is greater|strong="H07235"\w* \w than man|strong="H00582"\w*.
\q1 \v 13 \w Why|strong="H04069"\w* \w do you complain|strong="H07378"\w* \w to Him|strong="H00413"\w*
\q2 \w that|strong="H03588"\w* \w He answers|strong="H06030"\w* \w nothing|strong="H03808"\w* \w a man asks|strong="H01697"\w*?\f + \fr 33:13 \ft Or \fqa that He answers for none of His actions\f*
\q1 \v 14 \w For|strong="H03588"\w* \w God|strong="H00410"\w* \w speaks|strong="H01696"\w* \w in one way|strong="H00259"\w* \w and in another|strong="H08147"\w*,
\q2 \w yet no one|strong="H03808"\w* \w notices|strong="H07789"\w*.
\q1 \v 15 \w In a dream|strong="H02472"\w*,
\q2 \w in a vision|strong="H02384"\w* \w in the night|strong="H03915"\w*,
\q1 \w when deep sleep|strong="H08639"\w* \w falls|strong="H05307"\w* \w upon|strong="H05921"\w* \w men|strong="H00582"\w*
\q2 \w as they slumber|strong="H08572"\w* \w on|strong="H05921"\w* \w their beds|strong="H04904"\w*,
\q1 \v 16 \w He opens|strong="H01540"\w* \w their ears|strong="H00241"\w*
\q2 \w and terrifies them|strong="H02856"\w* \w with warnings|strong="H04561"\w*
\q1 \v 17 \w to turn|strong="H05493"\w* \w a man|strong="H00120"\w* \w from wrongdoing|strong="H04639"\w*
\q2 \w and keep him|strong="H03680"\w* \w from|strong="H01397"\w* \w pride|strong="H01466"\w*,
\q1 \v 18 \w to preserve|strong="H02820"\w* \w his soul|strong="H05315"\w* \w from|strong="H04480"\w* \w the Pit|strong="H07845"\w*
\q2 \w and his life|strong="H02416"\w* \w from perishing|strong="H05674"\w* \w by the sword|strong="H07973"\w*.
\b 
\q1 \v 19 \w A man is also chastened|strong="H03198"\w* \w on|strong="H05921"\w* \w his bed|strong="H04904"\w*
\q2 \w with pain|strong="H04341"\w* \w and constant|strong="H00386"\w* \w distress|strong="H07379"\w* \w in his bones|strong="H06106"\w*,
\q1 \v 20 \w so that he|strong="H02416"\w* \w detests|strong="H02092"\w* \w his bread|strong="H03899"\w*,
\q2 \w and his soul|strong="H05315"\w* \w loathes his favorite|strong="H08378"\w* \w food|strong="H03978"\w*.
\q1 \v 21 \w His flesh|strong="H01320"\w* \w wastes away|strong="H03615"\w* \w from sight|strong="H07210"\w*,
\q2 \w and his hidden|strong="H03808"\w* \w bones|strong="H06106"\w* \w protrude|strong="H08205"\w*.
\q1 \v 22 \w He|strong="H05315"\w* \w draws near|strong="H07126"\w* \w to the Pit|strong="H07845"\w*,
\q2 \w and his life|strong="H02416"\w* \w to the messengers of death|strong="H04191"\w*.
\b 
\q1 \v 23 \w Yet if|strong="H00518"\w* \w there is|strong="H03426"\w* \w a messenger|strong="H04397"\w* \w on his side|strong="H05921"\w*,
\q2 \w one|strong="H00259"\w* \w mediator|strong="H03887"\w* \w in|strong="H04480"\w* \w a thousand|strong="H00505"\w*,
\q1 \w to tell|strong="H05046"\w* \w a man|strong="H00120"\w* \w what is right for him|strong="H03476"\w*,
\q2 \v 24 \w to be gracious|strong="H02603"\w* \w to him and say|strong="H00559"\w*,
\q1 ‘\w Spare him|strong="H06308"\w* \w from going down|strong="H03381"\w* \w to the Pit|strong="H07845"\w*;
\q2 \w I have found|strong="H04672"\w* \w his ransom|strong="H03724"\w*,’
\q1 \v 25 \w then his flesh|strong="H01320"\w* \w is refreshed|strong="H07375"\w* \w like a child’s|strong="H05290"\w*;
\q2 \w he returns|strong="H07725"\w* \w to the days|strong="H03117"\w* \w of his youth|strong="H05934"\w*.
\q1 \v 26 \w He prays|strong="H06279"\w* \w to|strong="H00413"\w* \w God|strong="H00433"\w* \w and finds favor|strong="H07521"\w*;
\q2 \w he sees|strong="H07200"\w* \w God’s face|strong="H06440"\w* \w and shouts for joy|strong="H08643"\w*,
\q1 \w and God restores|strong="H07725"\w* \w His righteousness|strong="H06666"\w*
\q2 \w to that man|strong="H00582"\w*.
\q1 \v 27 \w Then he sings|strong="H07789"\w* \w before|strong="H05921"\w*\f + \fr 33:27 \ft Or \fqa Then he looks upon\f* \w men|strong="H00582"\w*
\q2 \w with these words|strong="H00559"\w*:
\q1 ‘\w I have sinned|strong="H02398"\w* \w and perverted|strong="H05753"\w* \w what was right|strong="H03477"\w*;
\q2 \w yet I did not|strong="H03808"\w* \w get what I deserved|strong="H07737"\w*.
\q1 \v 28 \w He redeemed|strong="H06299"\w* \w my soul|strong="H05315"\w* \w from going down|strong="H05674"\w* \w to the Pit|strong="H07845"\w*,
\q2 \w and I will live|strong="H02416"\w* \w to see|strong="H07200"\w* \w the light|strong="H00216"\w*.’
\b 
\q1 \v 29 \w Behold|strong="H02005"\w*, \w all|strong="H03605"\w* \w these things|strong="H00428"\w* \w God|strong="H00410"\w* \w does|strong="H06466"\w* \w to|strong="H05973"\w* \w a man|strong="H01397"\w*,
\q2 \w two|strong="H06471"\w* \w or even three times|strong="H07969"\w*,
\q1 \v 30 \w to bring back|strong="H07725"\w* \w his soul|strong="H05315"\w* \w from|strong="H04480"\w* \w the Pit|strong="H07845"\w*,
\q2 \w that he may be enlightened|strong="H00215"\w* \w with the light|strong="H00216"\w* \w of life|strong="H02416"\w*.
\q1 \v 31 \w Pay attention|strong="H07181"\w*, \w Job|strong="H00347"\w*, \w and listen|strong="H08085"\w* to me;
\q2 \w be silent|strong="H02790"\w*, \w and I|strong="H00595"\w* \w will speak|strong="H01696"\w*.
\q1 \v 32 \w But if|strong="H00518"\w* \w you have|strong="H03426"\w* \w something to say|strong="H04405"\w*, \w answer me|strong="H07725"\w*;
\q2 \w speak up|strong="H01696"\w*, \w for|strong="H03588"\w* \w I would like|strong="H02654"\w* \w to vindicate you|strong="H06663"\w*.
\q1 \v 33 \w But if|strong="H00518"\w* \w not|strong="H00369"\w*, \w then listen|strong="H08085"\w* to me;
\q2 \w be quiet|strong="H02790"\w*, \w and I will teach|strong="H00502"\w* \w you wisdom|strong="H02451"\w*.”
\c 34
\s1 Elihu Confirms God’s Justice
\p \v 1 \w Then Elihu|strong="H00453"\w* \w continued|strong="H06030"\w*:
\b 
\q1 \v 2 “\w Hear|strong="H08085"\w* \w my words|strong="H04405"\w*, \w O wise men|strong="H02450"\w*;
\q2 \w give ear|strong="H00238"\w* to me, \w O men of learning|strong="H03045"\w*.
\q1 \v 3 \w For|strong="H03588"\w* \w the ear|strong="H00241"\w* \w tests|strong="H00974"\w* \w words|strong="H04405"\w*
\q2 \w as the mouth|strong="H02441"\w* \w tastes|strong="H02938"\w* \w food|strong="H00398"\w*.
\q1 \v 4 \w Let us choose|strong="H00977"\w* for ourselves \w what is right|strong="H04941"\w*;
\q2 \w let us learn|strong="H03045"\w* \w together|strong="H00996"\w* \w what|strong="H04100"\w* \w is good|strong="H02896"\w*.
\q1 \v 5 \w For|strong="H03588"\w* \w Job|strong="H00347"\w* \w has declared|strong="H00559"\w*, ‘\w I am righteous|strong="H06663"\w*,
\q2 \w yet God|strong="H00410"\w* \w has deprived me of|strong="H05493"\w* \w justice|strong="H04941"\w*.
\q1 \v 6 \w Would I lie|strong="H03576"\w* \w about|strong="H05921"\w* \w my case|strong="H04941"\w*?
\q2 \w My wound|strong="H02671"\w* \w is incurable|strong="H00605"\w*,
\q2 \w though I am without|strong="H01097"\w* \w transgression|strong="H06588"\w*.’
\q1 \v 7 \w What|strong="H04310"\w* \w man|strong="H01397"\w* \w is like Job|strong="H00347"\w*,
\q2 \w who drinks up|strong="H08354"\w* \w derision|strong="H03933"\w* \w like water|strong="H04325"\w*?
\q1 \v 8 \w He keeps|strong="H00732"\w* \w company|strong="H02274"\w* \w with|strong="H05973"\w* \w evildoers|strong="H06466"\w*
\q2 \w and walks|strong="H01980"\w* \w with|strong="H05973"\w* \w wicked|strong="H07562"\w* \w men|strong="H00582"\w*.
\q1 \v 9 \w For|strong="H03588"\w* \w he has said|strong="H00559"\w*, ‘\w It profits|strong="H05532"\w* \w a man|strong="H01397"\w* \w nothing|strong="H03808"\w*
\q2 \w that he should delight|strong="H07521"\w* \w in|strong="H05973"\w* \w God|strong="H00430"\w*.’
\b 
\q1 \v 10 \w Therefore|strong="H03651"\w* \w listen|strong="H08085"\w* to me,
\q2 \w O men|strong="H00582"\w* \w of understanding|strong="H03824"\w*.
\q1 \w Far be it|strong="H02486"\w* \w from God|strong="H00410"\w* \w to do wrong|strong="H07562"\w*,
\q2 \w and from the Almighty|strong="H07706"\w* \w to act unjustly|strong="H05766"\w*.
\q1 \v 11 \w For|strong="H03588"\w* \w according to a man’s deeds|strong="H06467"\w* \w He repays|strong="H07999"\w* him;
\q2 \w according to a man’s|strong="H00376"\w* \w ways|strong="H00734"\w* \w He brings consequences|strong="H04672"\w*.
\q1 \v 12 \w Indeed|strong="H00637"\w*, \w it is true|strong="H00551"\w* \w that God|strong="H00410"\w* \w does not|strong="H03808"\w* \w act wickedly|strong="H07561"\w*,
\q2 \w and the Almighty|strong="H07706"\w* \w does not|strong="H03808"\w* \w pervert|strong="H05791"\w* \w justice|strong="H04941"\w*.
\q1 \v 13 \w Who|strong="H04310"\w* \w gave Him charge|strong="H06485"\w* \w over the earth|strong="H00776"\w*?
\q2 \w Who|strong="H04310"\w* \w appointed Him|strong="H07760"\w* \w over the whole|strong="H03605"\w* \w world|strong="H08398"\w*?
\q1 \v 14 \w If|strong="H00518"\w* \w He were to set|strong="H07760"\w* \w His heart|strong="H03820"\w* \w to it|strong="H00413"\w*
\q2 \w and withdraw|strong="H00622"\w* \w His Spirit|strong="H07307"\w* \w and breath|strong="H05397"\w*,
\q1 \v 15 \w all|strong="H03605"\w* \w flesh|strong="H01320"\w* \w would perish|strong="H01478"\w* \w together|strong="H03162"\w*
\q2 \w and mankind|strong="H00120"\w* \w would return|strong="H07725"\w* \w to|strong="H05921"\w* \w the dust|strong="H06083"\w*.
\b 
\q1 \v 16 \w If|strong="H00518"\w* \w you have understanding|strong="H00998"\w*, \w hear|strong="H08085"\w* \w this|strong="H02063"\w*;
\q2 \w listen to|strong="H00238"\w* \w my words|strong="H04405"\w*.
\q1 \v 17 \w Could|strong="H00637"\w* \w one who hates|strong="H08130"\w* \w justice|strong="H04941"\w* \w govern|strong="H02280"\w*?
\q2 \w Will you condemn|strong="H07561"\w* \w the just|strong="H06662"\w* \w and mighty One|strong="H03524"\w*,
\q1 \v 18 \w who says|strong="H00559"\w* \w to kings|strong="H04428"\w*, ‘\w You are worthless|strong="H01100"\w*!’
\q2 \w and to|strong="H00413"\w* \w nobles|strong="H05081"\w*, ‘\w You are wicked|strong="H07563"\w*,’
\q1 \v 19 \w who|strong="H00834"\w* \w is not|strong="H03808"\w* \w partial|strong="H05375"\w* \w to princes|strong="H08269"\w*
\q2 \w and does not|strong="H03808"\w* \w favor|strong="H05234"\w* \w rich|strong="H07771"\w* \w over|strong="H06440"\w* \w poor|strong="H01800"\w*?
\q2 \w For|strong="H03588"\w* \w they are all|strong="H03605"\w* \w the work|strong="H04639"\w* \w of His hands|strong="H03027"\w*.
\q1 \v 20 \w They die|strong="H04191"\w* \w in an instant|strong="H07281"\w*,
\q2 \w in the middle|strong="H02676"\w* \w of the night|strong="H03915"\w*.
\q1 \w The people|strong="H05971"\w* \w convulse|strong="H01607"\w* \w and pass away|strong="H05674"\w*;
\q2 \w the mighty|strong="H00047"\w* \w are removed|strong="H05493"\w* \w without|strong="H03808"\w* \w human hand|strong="H03027"\w*.
\b 
\q1 \v 21 \w For|strong="H03588"\w* \w His eyes are|strong="H05869"\w* \w on|strong="H05921"\w* \w the ways|strong="H01870"\w* \w of a man|strong="H00376"\w*,
\q2 \w and He sees|strong="H07200"\w* \w his every step|strong="H06806"\w*.
\q1 \v 22 \w There is no|strong="H00369"\w* \w darkness|strong="H02822"\w* \w or|strong="H00369"\w* \w deep shadow|strong="H06757"\w*
\q2 \w where|strong="H08033"\w* \w the workers|strong="H06466"\w* \w of iniquity|strong="H00205"\w* \w can hide|strong="H05641"\w*.
\q1 \v 23 \w For|strong="H03588"\w* \w God|strong="H00410"\w* \w need not|strong="H03808"\w* \w examine|strong="H07760"\w* \w a man|strong="H00376"\w* \w further|strong="H05750"\w*
\q2 \w or have him approach|strong="H01980"\w* \w for judgment|strong="H04941"\w*.
\q1 \v 24 \w He shatters|strong="H07489"\w* \w the mighty|strong="H03524"\w* \w without|strong="H03808"\w* \w inquiry|strong="H02714"\w*
\q2 \w and sets up|strong="H05975"\w* \w others|strong="H00312"\w* \w in their place|strong="H08478"\w*.
\q1 \v 25 \w Therefore|strong="H03651"\w*, \w He recognizes|strong="H05234"\w* \w their deeds|strong="H04566"\w*;
\q2 \w He overthrows them|strong="H02015"\w* \w in the night|strong="H03915"\w* \w and they are crushed|strong="H01792"\w*.
\q1 \v 26 \w He strikes them|strong="H05606"\w* \w for|strong="H08478"\w* \w their wickedness|strong="H07563"\w*
\q2 \w in full|strong="H04725"\w* \w view|strong="H07200"\w*,
\q1 \v 27 \w because|strong="H00834"\w* \w they turned aside|strong="H05493"\w* \w from Him|strong="H00310"\w*
\q2 \w and had no|strong="H03808"\w* \w regard|strong="H07919"\w* \w for any|strong="H03605"\w* \w of His ways|strong="H01870"\w*.
\q1 \v 28 \w They caused the cry|strong="H06818"\w* \w of the poor|strong="H01800"\w* \w to come|strong="H00935"\w* \w before Him|strong="H05921"\w*,
\q2 \w and He heard|strong="H08085"\w* \w the outcry|strong="H06818"\w* \w of the afflicted|strong="H06041"\w*.
\q1 \v 29 \w But when He|strong="H01931"\w* \w remains silent|strong="H08252"\w*, \w who|strong="H04310"\w* \w can condemn Him|strong="H07561"\w*?
\q2 \w When He hides|strong="H05641"\w* \w His face|strong="H06440"\w*, \w who|strong="H04310"\w* \w can see Him|strong="H07789"\w*?
\q1 \w Yet He watches over|strong="H05921"\w* \w both|strong="H03162"\w* \w man|strong="H00120"\w* \w and nation|strong="H01471"\w*,
\q2 \v 30 \w that godless|strong="H02611"\w* \w men|strong="H00120"\w* \w should not rule|strong="H04427"\w*
\q2 \w or lay snares|strong="H04170"\w* \w for the people|strong="H05971"\w*.
\b 
\q1 \v 31 \w Suppose|strong="H03588"\w* \w someone says|strong="H00559"\w* \w to|strong="H00413"\w* \w God|strong="H00410"\w*,
\q2 ‘\w I have endured my punishment|strong="H05375"\w*; \w I will offend|strong="H02254"\w* \w no more|strong="H03808"\w*.
\q1 \v 32 \w Teach me|strong="H03384"\w* \w what I cannot|strong="H01107"\w* \w see|strong="H02372"\w*;
\q2 \w if|strong="H00518"\w* \w I have done|strong="H06466"\w* \w wrong|strong="H05766"\w*, \w I will not|strong="H03808"\w* \w do it again|strong="H03254"\w*.’
\q1 \v 33 \w Should God repay you|strong="H07999"\w* \w on your own terms|strong="H05973"\w*
\q2 \w when|strong="H03588"\w* \w you have disavowed Him|strong="H03988"\w*?
\q1 \w You|strong="H00859"\w* \w must choose|strong="H00977"\w*, \w not|strong="H03808"\w* \w I|strong="H00589"\w*;
\q2 \w so tell me|strong="H01696"\w* \w what|strong="H04100"\w* \w you know|strong="H03045"\w*.
\q1 \v 34 \w Men|strong="H00582"\w* \w of understanding|strong="H03824"\w* \w will declare|strong="H00559"\w* to me,
\q2 \w and the wise|strong="H02450"\w* \w men|strong="H01397"\w* \w who hear me|strong="H08085"\w* will say:
\q1 \v 35 ‘\w Job|strong="H00347"\w* \w speaks|strong="H01696"\w* \w without|strong="H03808"\w* \w knowledge|strong="H01847"\w*;
\q2 \w his words|strong="H01697"\w* \w lack|strong="H03808"\w* \w insight|strong="H07919"\w*.’
\q1 \v 36 \w If only|strong="H00015"\w* \w Job|strong="H00347"\w* \w were tried|strong="H00974"\w* \w to|strong="H05704"\w* \w the utmost|strong="H05331"\w*
\q2 \w for|strong="H05921"\w* \w answering|strong="H08666"\w* \w like a wicked|strong="H00205"\w* \w man|strong="H00582"\w*.
\q1 \v 37 \w For|strong="H03588"\w* \w he adds|strong="H03254"\w* \w rebellion|strong="H06588"\w* \w to|strong="H05921"\w* \w his sin|strong="H02403"\w*;
\q2 \w he claps his hands|strong="H05606"\w* \w among us|strong="H00996"\w*
\q2 \w and multiplies|strong="H07235"\w* \w his words|strong="H00561"\w* \w against God|strong="H00410"\w*.”
\c 35
\s1 Elihu Recalls God’s Justice
\p \v 1 \w And Elihu|strong="H00453"\w* \w went on|strong="H06030"\w* \w to say|strong="H00559"\w*:
\b 
\q1 \v 2 “\w Do you think|strong="H02803"\w* \w this|strong="H02063"\w* \w is just|strong="H04941"\w*?
\q2 \w You say|strong="H00559"\w*, ‘\w I am more righteous|strong="H06664"\w* \w than God|strong="H00410"\w*.’\f + \fr 35:2 \ft Or \fqa ‘I am righteous before God.’\f*
\q1 \v 3 \w For|strong="H03588"\w* \w you ask|strong="H00559"\w*, ‘\w What|strong="H04100"\w* \w does it profit|strong="H05532"\w* me,
\q2 \w and what|strong="H04100"\w* \w benefit do I gain|strong="H03276"\w* \w apart from sin|strong="H02403"\w*?’
\q1 \v 4 \w I|strong="H00589"\w* \w will reply|strong="H07725"\w* \w to you|strong="H04405"\w*
\q2 \w and to your friends|strong="H07453"\w* \w as well|strong="H05973"\w*.
\q1 \v 5 \w Look|strong="H05027"\w* \w to the heavens|strong="H08064"\w* \w and see|strong="H07200"\w*;
\q2 \w gaze|strong="H07789"\w* \w at the clouds|strong="H07834"\w* \w high|strong="H01361"\w* \w above you|strong="H04480"\w*.
\q1 \v 6 \w If|strong="H00518"\w* \w you sin|strong="H02398"\w*, \w what|strong="H04100"\w* \w do you accomplish|strong="H06466"\w* against Him?
\q2 \w If you multiply|strong="H07231"\w* \w your transgressions|strong="H06588"\w*, \w what|strong="H04100"\w* \w do you do|strong="H06213"\w* to Him?
\q1 \v 7 \w If|strong="H00518"\w* \w you are righteous|strong="H06663"\w*, \w what|strong="H04100"\w* \w do you give|strong="H05414"\w* Him,
\q2 \w or|strong="H00176"\w* \w what|strong="H04100"\w* \w does He receive|strong="H03947"\w* \w from your hand|strong="H03027"\w*?
\q1 \v 8 \w Your wickedness|strong="H07562"\w* \w affects only a man|strong="H00376"\w* \w like yourself|strong="H03644"\w*,
\q2 \w and your righteousness|strong="H06666"\w* \w only a son|strong="H01121"\w* \w of man|strong="H00120"\w*.
\b 
\q1 \v 9 \w Men cry out|strong="H02199"\w* \w under great|strong="H07230"\w* \w oppression|strong="H06217"\w*;
\q2 \w they plead for relief|strong="H07768"\w* \w from the arm|strong="H02220"\w* \w of the mighty|strong="H07227"\w*.
\q1 \v 10 \w But no|strong="H03808"\w* \w one asks|strong="H00559"\w*, ‘\w Where is|strong="H00346"\w* \w God|strong="H00433"\w* \w my Maker|strong="H06213"\w*,
\q2 \w who gives us|strong="H05414"\w* \w songs|strong="H02158"\w* \w in the night|strong="H03915"\w*,
\q1 \v 11 \w who teaches us|strong="H00502"\w* \w more than the beasts|strong="H00929"\w* \w of the earth|strong="H00776"\w*
\q2 \w and makes us wiser|strong="H02449"\w* \w than the birds|strong="H05775"\w* \w of the air|strong="H08064"\w*?’
\q1 \v 12 \w There|strong="H08033"\w* \w they cry out|strong="H06817"\w*, \w but He does not|strong="H03808"\w* \w answer|strong="H06030"\w*,
\q2 \w because of|strong="H06440"\w* \w the pride|strong="H01347"\w* \w of evil men|strong="H07451"\w*.
\q1 \v 13 \w Surely|strong="H00389"\w* \w God|strong="H00410"\w* \w does not|strong="H03808"\w* \w listen|strong="H08085"\w* \w to empty pleas|strong="H07723"\w*,
\q2 \w and the Almighty|strong="H07706"\w* \w does not|strong="H03808"\w* \w take note of it|strong="H07789"\w*.
\q1 \v 14 \w How much less|strong="H00637"\w*, \w then, when|strong="H03588"\w* \w you say|strong="H00559"\w* \w that you do not|strong="H03808"\w* \w see Him|strong="H07789"\w*,
\q2 \w that your case|strong="H01779"\w* \w is before Him|strong="H06440"\w* \w and you must wait|strong="H02342"\w* for Him,
\q1 \v 15 \w and further|strong="H06258"\w*, \w that|strong="H03588"\w* \w in His anger|strong="H00639"\w* \w He has not punished|strong="H06485"\w*
\q2 \w or|strong="H03808"\w* \w taken much notice|strong="H03045"\w* \w of folly|strong="H06580"\w*!
\q1 \v 16 \w So Job|strong="H00347"\w* \w opens|strong="H06475"\w* \w his mouth|strong="H06310"\w* \w in vain|strong="H01892"\w*
\q2 \w and multiplies|strong="H03527"\w* \w words|strong="H04405"\w* \w without|strong="H01097"\w* \w knowledge|strong="H01847"\w*.”
\c 36
\s1 Elihu Describes God’s Power
\p \v 1 \w And Elihu|strong="H00453"\w* \w continued|strong="H03254"\w*:
\b 
\q1 \v 2 “\w Bear|strong="H03803"\w* with me \w a little longer|strong="H02191"\w*, \w and I will show you|strong="H02331"\w*
\q2 \w that|strong="H03588"\w* \w there is more|strong="H05750"\w* \w to be said|strong="H04405"\w* \w on God’s behalf|strong="H00433"\w*.
\q1 \v 3 \w I get|strong="H05375"\w* \w my knowledge|strong="H01843"\w* \w from afar|strong="H07350"\w*,
\q2 \w and I will ascribe|strong="H05414"\w* \w justice|strong="H06664"\w* \w to my Maker|strong="H06466"\w*.
\q1 \v 4 \w For|strong="H03588"\w* \w truly|strong="H00551"\w* \w my words|strong="H04405"\w* \w are free of|strong="H03808"\w* \w falsehood|strong="H08267"\w*;
\q2 \w one perfect|strong="H08549"\w* \w in knowledge|strong="H01844"\w* \w is with you|strong="H05973"\w*.
\b 
\q1 \v 5 \w Indeed|strong="H02005"\w*, \w God is|strong="H00410"\w* \w mighty|strong="H03524"\w*, \w but He despises|strong="H03988"\w* \w no one|strong="H03808"\w*;
\q2 \w He is mighty|strong="H03524"\w* \w in strength|strong="H03581"\w* \w of understanding|strong="H03820"\w*.
\q1 \v 6 \w He does not|strong="H03808"\w* \w keep the wicked|strong="H07563"\w* \w alive|strong="H02421"\w*,
\q2 \w but He grants|strong="H05414"\w* \w justice|strong="H04941"\w* \w to the afflicted|strong="H06041"\w*.
\q1 \v 7 \w He does not|strong="H03808"\w* \w take|strong="H01639"\w* \w His eyes|strong="H05869"\w* \w off the righteous|strong="H06662"\w*,
\q2 \w but He enthrones them|strong="H03678"\w* \w with|strong="H00854"\w* \w kings|strong="H04428"\w*
\q2 \w and exalts them|strong="H01361"\w* \w forever|strong="H05331"\w*.
\b 
\q1 \v 8 \w And if|strong="H00518"\w* \w men are bound|strong="H00631"\w* \w with chains|strong="H02131"\w*,
\q2 \w caught|strong="H03920"\w* \w in cords|strong="H02256"\w* \w of affliction|strong="H06040"\w*,
\q1 \v 9 \w then He tells|strong="H05046"\w* them \w their deeds|strong="H06467"\w*
\q2 \w and how|strong="H03588"\w* \w arrogantly|strong="H01396"\w* \w they have transgressed|strong="H06588"\w*.
\q1 \v 10 \w He opens|strong="H01540"\w* \w their ears|strong="H00241"\w* \w to correction|strong="H04148"\w*
\q2 \w and commands|strong="H00559"\w* \w that|strong="H03588"\w* \w they turn|strong="H07725"\w* \w from iniquity|strong="H00205"\w*.
\q1 \v 11 \w If|strong="H00518"\w* \w they obey|strong="H08085"\w* \w and serve Him|strong="H05647"\w*,
\q2 \w then they end|strong="H03615"\w* \w their days|strong="H03117"\w* \w in prosperity|strong="H02896"\w*
\q2 \w and their years|strong="H08141"\w* \w in happiness|strong="H05273"\w*.
\q1 \v 12 \w But if|strong="H00518"\w* \w they do not|strong="H03808"\w* \w obey|strong="H08085"\w*,
\q2 \w then they perish|strong="H05674"\w* \w by the sword|strong="H07973"\w*\f + \fr 36:12 \ft Or \fqa they will cross the river of death\f*
\q2 \w and die|strong="H01478"\w* \w without|strong="H01097"\w* \w knowledge|strong="H01847"\w*.
\b 
\q1 \v 13 \w The godless|strong="H02611"\w* \w in heart|strong="H03820"\w* \w harbor|strong="H07760"\w* \w resentment|strong="H00639"\w*;
\q2 \w even when|strong="H03588"\w* \w He binds them|strong="H00631"\w*, \w they do not|strong="H03808"\w* \w cry for help|strong="H07768"\w*.
\q1 \v 14 \w They|strong="H05315"\w* \w die|strong="H04191"\w* \w in their youth|strong="H05290"\w*,
\q2 \w among the male shrine prostitutes|strong="H06945"\w*.
\q1 \v 15 \w God rescues|strong="H02502"\w* \w the afflicted|strong="H06041"\w* \w by their affliction|strong="H06040"\w*\f + \fr 36:15 \ft Or \fqa in their affliction\f*
\q2 \w and opens|strong="H01540"\w* \w their ears|strong="H00241"\w* \w in oppression|strong="H03906"\w*.
\b 
\q1 \v 16 \w Indeed|strong="H00637"\w*, \w He drew you|strong="H05496"\w* \w from the jaws|strong="H06310"\w* \w of distress|strong="H06862"\w*
\q2 \w to a spacious|strong="H03808"\w* \w and broad place|strong="H07338"\w*,
\q2 \w to a table|strong="H07979"\w* \w full|strong="H04390"\w* \w of richness|strong="H01880"\w*.
\q1 \v 17 \w But now you are laden|strong="H04390"\w* \w with the judgment|strong="H01779"\w* \w due the wicked|strong="H07563"\w*;
\q2 \w judgment|strong="H01779"\w* \w and justice|strong="H04941"\w* \w have seized you|strong="H08551"\w*.
\q1 \v 18 \w Be careful|strong="H02534"\w* \w that no one|strong="H06435"\w* \w lures|strong="H05496"\w* \w you with riches|strong="H05607"\w*;
\q2 \w do not|strong="H00408"\w* \w let a large|strong="H07227"\w* \w bribe|strong="H03724"\w* \w lead you astray|strong="H05186"\w*.
\q1 \v 19 \w Can your wealth|strong="H07769"\w*\f + \fr 36:19 \ft Or \fqa your cry for help\f* \w or all|strong="H03605"\w* \w your mighty effort|strong="H03981"\w*
\q2 \w keep|strong="H06186"\w* \w you from|strong="H03808"\w* \w distress|strong="H06862"\w*?
\q1 \v 20 \w Do not|strong="H00408"\w* \w long for|strong="H07602"\w* \w the night|strong="H03915"\w*,
\q2 \w when people|strong="H05971"\w* \w vanish|strong="H05927"\w* \w from their homes|strong="H08478"\w*.
\q1 \v 21 \w Be careful|strong="H08104"\w* \w not|strong="H00408"\w* \w to turn|strong="H06437"\w* \w to|strong="H00413"\w* \w iniquity|strong="H00205"\w*,
\q2 \w for|strong="H03588"\w* \w this|strong="H02088"\w* \w you have preferred|strong="H00977"\w* \w to affliction|strong="H06040"\w*.
\b 
\q1 \v 22 \w Behold|strong="H02005"\w*, \w God|strong="H00410"\w* \w is exalted|strong="H07682"\w* \w in His power|strong="H03581"\w*.
\q2 \w Who|strong="H04310"\w* \w is a teacher|strong="H04175"\w* \w like Him|strong="H03644"\w*?
\q1 \v 23 \w Who|strong="H04310"\w* \w has appointed|strong="H06485"\w* \w His way|strong="H01870"\w* \w for Him|strong="H05921"\w*,
\q2 \w or|strong="H04310"\w* \w told Him|strong="H00559"\w*, ‘\w You have done|strong="H06466"\w* \w wrong|strong="H05766"\w*’?
\q1 \v 24 \w Remember|strong="H02142"\w* \w to magnify|strong="H07679"\w* \w His work|strong="H06467"\w*,
\q2 \w which|strong="H00834"\w* \w men|strong="H00582"\w* \w have praised in song|strong="H07891"\w*.
\q1 \v 25 \w All|strong="H03605"\w* \w mankind|strong="H00120"\w* \w has seen|strong="H02372"\w* it;
\q2 \w men|strong="H00582"\w* \w behold it|strong="H05027"\w* \w from afar|strong="H07350"\w*.
\q1 \v 26 \w Indeed|strong="H02005"\w*, \w God is|strong="H00410"\w* \w great|strong="H07689"\w* — \w beyond|strong="H03808"\w* \w our knowledge|strong="H03045"\w*;
\q2 \w the number|strong="H04557"\w* \w of His years|strong="H08141"\w* \w is unsearchable|strong="H03808"\w*.
\q1 \v 27 \w For|strong="H03588"\w* \w He draws up|strong="H01639"\w* \w drops|strong="H05198"\w* \w of water|strong="H04325"\w*
\q2 \w which distill|strong="H02212"\w* \w the rain|strong="H04306"\w* \w from the mist|strong="H00108"\w*,
\q1 \v 28 \w which|strong="H00834"\w* \w the clouds|strong="H07834"\w* \w pour out|strong="H05140"\w*
\q2 \w and shower|strong="H07491"\w* \w abundantly|strong="H07227"\w* \w on|strong="H05921"\w* \w mankind|strong="H00120"\w*.
\q1 \v 29 \w Furthermore|strong="H00637"\w*, \w who can understand|strong="H00995"\w* \w how the clouds|strong="H05645"\w* \w spread out|strong="H04666"\w*,
\q2 \w how the thunder roars|strong="H08663"\w* \w from His pavilion|strong="H05521"\w*?
\q1 \v 30 \w See how|strong="H02005"\w* \w He scatters|strong="H06566"\w* \w His lightning|strong="H00216"\w* \w around Him|strong="H05921"\w*
\q2 \w and covers|strong="H03680"\w* \w the depths|strong="H08328"\w* \w of the sea|strong="H03220"\w*.
\q1 \v 31 \w For|strong="H03588"\w* by these \w He judges|strong="H01777"\w*\f + \fr 36:31 \ft Or \fqa governs \ft or \fqa nourishes\f* \w the nations|strong="H05971"\w*
\q2 \w and provides|strong="H05414"\w* \w food|strong="H00400"\w* \w in abundance|strong="H04342"\w*.
\q1 \v 32 \w He fills|strong="H03680"\w* \w His hands|strong="H03709"\w* \w with lightning|strong="H00216"\w*
\q2 \w and commands|strong="H06680"\w* \w it|strong="H05921"\w* \w to strike its mark|strong="H06293"\w*.
\q1 \v 33 \w The thunder|strong="H07452"\w* \w declares|strong="H05046"\w* \w His presence|strong="H05921"\w*;
\q2 \w even the cattle|strong="H04735"\w* \w regard|strong="H05921"\w* \w the rising storm|strong="H05927"\w*.[’’]
\c 37
\s1 Elihu Proclaims God’s Majesty
\q1 \v 1 “\w At this|strong="H02063"\w* \w my heart|strong="H03820"\w* \w also|strong="H00637"\w* \w pounds|strong="H02729"\w*
\q2 \w and leaps|strong="H05425"\w* \w from its place|strong="H04725"\w*.
\q1 \v 2 \w Listen closely|strong="H08085"\w* \w to the thunder|strong="H07267"\w* \w of His voice|strong="H06963"\w*
\q2 \w and the rumbling|strong="H01899"\w* \w that comes|strong="H03318"\w* \w from His mouth|strong="H06310"\w*.
\q1 \v 3 \w He unleashes|strong="H08281"\w* \w His lightning|strong="H00216"\w* \w beneath|strong="H08478"\w* \w the whole|strong="H03605"\w* \w sky|strong="H08064"\w*
\q2 \w and sends it|strong="H05921"\w* \w to the ends|strong="H03671"\w* \w of the earth|strong="H00776"\w*.
\q1 \v 4 \w Then|strong="H00310"\w* \w there comes a roaring|strong="H07580"\w* \w sound|strong="H06963"\w*;
\q2 \w He thunders|strong="H07481"\w* \w with His majestic|strong="H01347"\w* \w voice|strong="H06963"\w*.
\q1 \w He does not|strong="H03808"\w* \w restrain the lightning|strong="H06117"\w*
\q2 \w when|strong="H03588"\w* \w His voice|strong="H06963"\w* \w resounds|strong="H08085"\w*.
\q1 \v 5 \w God|strong="H00410"\w* \w thunders|strong="H07481"\w* \w wondrously|strong="H06381"\w* \w with His voice|strong="H06963"\w*;
\q2 \w He does|strong="H06213"\w* \w great things|strong="H01419"\w* \w we cannot|strong="H03808"\w* \w comprehend|strong="H03045"\w*.
\q1 \v 6 \w For|strong="H03588"\w* \w He says|strong="H00559"\w* \w to the snow|strong="H07950"\w*, ‘\w Fall|strong="H01933"\w* \w on the earth|strong="H00776"\w*,’
\q2 \w and to the gentle rain|strong="H01653"\w*, ‘\w Pour out|strong="H01653"\w* \w a mighty|strong="H05797"\w* \w downpour|strong="H04306"\w*.’
\q1 \v 7 \w He seals up|strong="H02856"\w* \w the hand|strong="H03027"\w* \w of every|strong="H03605"\w* \w man|strong="H00120"\w*,
\q2 \w so that all|strong="H03605"\w* \w men|strong="H00582"\w* \w may know|strong="H03045"\w* \w His work|strong="H04639"\w*.
\q1 \v 8 \w The wild animals|strong="H02416"\w* \w enter|strong="H00935"\w* \w their lairs|strong="H00695"\w*;
\q2 \w they settle down|strong="H07931"\w* \w in their dens|strong="H04585"\w*.
\q1 \v 9 \w The tempest|strong="H05492"\w* \w comes|strong="H00935"\w* \w from|strong="H04480"\w* \w its chamber|strong="H02315"\w*,
\q2 \w and the cold|strong="H07135"\w* \w from the driving north winds|strong="H04215"\w*.
\q1 \v 10 \w By the breath|strong="H05397"\w* \w of God|strong="H00410"\w* \w the ice|strong="H07140"\w* \w is formed|strong="H05414"\w*
\q2 \w and the watery|strong="H04325"\w* \w expanses|strong="H07341"\w* \w are frozen|strong="H04164"\w*.
\q1 \v 11 \w He loads|strong="H02959"\w* \w the clouds|strong="H05645"\w* \w with moisture|strong="H07377"\w*;
\q2 \w He scatters|strong="H06327"\w* \w His lightning|strong="H00216"\w* \w through them|strong="H06051"\w*.
\q1 \v 12 \w They|strong="H01931"\w* \w swirl about|strong="H04524"\w*,
\q2 \w whirling|strong="H02015"\w* \w at His direction|strong="H08458"\w*,
\q1 \w accomplishing|strong="H06466"\w* \w all|strong="H03605"\w* \w that|strong="H00834"\w* \w He commands|strong="H06680"\w*
\q2 \w over|strong="H05921"\w* \w the face|strong="H06440"\w* \w of all|strong="H08398"\w* \w the earth|strong="H00776"\w*.
\q1 \v 13 \w Whether|strong="H00518"\w* \w for punishment|strong="H07626"\w* \w or|strong="H00518"\w* \w for His land|strong="H00776"\w*,
\q2 \w He accomplishes this|strong="H04672"\w* \w in His loving devotion|strong="H02617"\w*.
\b 
\q1 \v 14 \w Listen|strong="H00238"\w* \w to this|strong="H02063"\w*, \w O Job|strong="H00347"\w*;
\q2 \w stand still|strong="H05975"\w* \w and consider|strong="H00995"\w* \w the wonders|strong="H06381"\w* \w of God|strong="H00410"\w*.
\q1 \v 15 \w Do you know|strong="H03045"\w* \w how God|strong="H00433"\w* \w dispatches|strong="H07760"\w* \w the clouds|strong="H06051"\w*
\q2 \w or makes the lightning|strong="H00216"\w* \w flash|strong="H03313"\w*?
\q1 \v 16 \w Do you understand|strong="H03045"\w* \w how|strong="H05921"\w* \w the clouds|strong="H05645"\w* \w float|strong="H04657"\w*,
\q2 \w those wonders|strong="H04652"\w* \w of Him who is perfect|strong="H08549"\w* \w in knowledge|strong="H01843"\w*?
\q1 \v 17 \w You whose|strong="H00834"\w* \w clothes|strong="H00899"\w* \w get hot|strong="H02525"\w*
\q2 \w when the land|strong="H00776"\w* \w lies hushed|strong="H08252"\w* \w under the south wind|strong="H01864"\w*,
\q1 \v 18 \w can you, like Him|strong="H05973"\w*, \w spread out|strong="H07554"\w* \w the skies|strong="H07834"\w*,
\q2 \w as strong|strong="H02389"\w* \w as a mirror|strong="H07209"\w* \w of bronze|strong="H03332"\w*?
\b 
\q1 \v 19 \w Teach us|strong="H03045"\w* \w what|strong="H04100"\w* \w we should say|strong="H00559"\w* to Him;
\q2 \w we cannot|strong="H03808"\w* \w draw up our case|strong="H06186"\w* \w because of|strong="H06440"\w* \w our darkness|strong="H02822"\w*.
\q1 \v 20 \w Should He be told|strong="H05608"\w* \w that|strong="H03588"\w* \w I want to speak|strong="H01696"\w*?
\q2 \w Would a man|strong="H00376"\w* \w ask|strong="H00559"\w* \w to be swallowed up|strong="H01104"\w*\f + \fr 37:20 \ft Or \fqa speak without being swallowed up\f*?
\q1 \v 21 \w Now|strong="H06258"\w* \w no one|strong="H03808"\w* \w can gaze|strong="H07200"\w* \w at the sun|strong="H00216"\w*
\q2 \w when it is|strong="H01931"\w* \w bright|strong="H00925"\w* \w in the skies|strong="H07834"\w*
\q2 \w after the wind|strong="H07307"\w* \w has swept them|strong="H05674"\w* \w clean|strong="H02891"\w*.
\q1 \v 22 \w Out of the north|strong="H06828"\w* \w He comes|strong="H00857"\w* \w in golden splendor|strong="H02091"\w*;
\q2 \w awesome|strong="H03372"\w* \w majesty|strong="H01935"\w* \w surrounds|strong="H05921"\w* \w Him|strong="H00433"\w*.
\q1 \v 23 \w The Almighty|strong="H07706"\w* \w is beyond|strong="H03808"\w* \w our reach|strong="H04672"\w*;
\q2 \w He is exalted|strong="H07689"\w* \w in power|strong="H03581"\w*!
\q1 \w In His justice|strong="H04941"\w* \w and great|strong="H07230"\w* \w righteousness|strong="H06666"\w*
\q2 \w He does not|strong="H03808"\w* \w oppress|strong="H06031"\w*.
\q1 \v 24 \w Therefore|strong="H03651"\w*, \w men|strong="H00582"\w* \w fear Him|strong="H03372"\w*,
\q2 \w for He is not|strong="H03808"\w* \w partial|strong="H07200"\w* \w to the|strong="H03605"\w* \w wise|strong="H02450"\w* \w in heart|strong="H03820"\w*.”
\c 38
\s1 The LORD Challenges Job
\p \v 1 \w Then the LORD|strong="H03068"\w* \w answered|strong="H06030"\w* \w Job|strong="H00347"\w* \w out of|strong="H04480"\w* \w the whirlwind|strong="H05591"\w* \w and said|strong="H00559"\w*:
\b 
\q1 \v 2 “\w Who|strong="H04310"\w* \w is this|strong="H02088"\w* \w who obscures|strong="H02821"\w* \w My counsel|strong="H06098"\w*
\q2 \w by words|strong="H04405"\w* \w without|strong="H01097"\w* \w knowledge|strong="H01847"\w*?\f + \fr 38:2 \ft Cited in Job 42:3\f*
\q1 \v 3 \w Now|strong="H04994"\w* \w brace|strong="H00247"\w* \w yourself|strong="H02504"\w*\f + \fr 38:3 \ft Hebrew \fqa gird up your loins\f* \w like a man|strong="H01397"\w*;
\q2 \w I will question you|strong="H07592"\w*, \w and you shall inform Me|strong="H03045"\w*.\f + \fr 38:3 \ft Cited in Job 42:4\f*
\q1 \v 4 \w Where|strong="H00375"\w* \w were you|strong="H01961"\w* \w when I laid the foundations|strong="H03245"\w* \w of the earth|strong="H00776"\w*?
\q2 \w Tell Me|strong="H05046"\w*, \w if|strong="H00518"\w* \w you have understanding|strong="H03045"\w*.
\q1 \v 5 \w Who|strong="H04310"\w* \w fixed|strong="H07760"\w* \w its measurements|strong="H04461"\w*? \w Surely|strong="H03588"\w* \w you know|strong="H03045"\w*!
\q2 \w Or|strong="H00176"\w* \w who|strong="H04310"\w* \w stretched|strong="H05186"\w* \w a measuring line|strong="H06957"\w* \w across it|strong="H05921"\w*?
\q1 \v 6 \w On what|strong="H04100"\w* \w were its foundations|strong="H00134"\w* \w set|strong="H02883"\w*,
\q2 \w or|strong="H00176"\w* \w who|strong="H04310"\w* \w laid|strong="H03384"\w* \w its cornerstone|strong="H06438"\w*,\f + \fr 38:6 \ft Or \fqa who set its core in place\f*
\q1 \v 7 \w while the morning|strong="H01242"\w* \w stars|strong="H03556"\w* \w sang|strong="H07442"\w* \w together|strong="H03162"\w*
\q2 \w and all|strong="H03605"\w* \w the sons|strong="H01121"\w* \w of God|strong="H00430"\w* \w shouted for joy|strong="H07321"\w*?
\b 
\q1 \v 8 \w Who enclosed|strong="H05526"\w* \w the sea|strong="H03220"\w* \w behind doors|strong="H01817"\w*
\q2 \w when it burst forth|strong="H01518"\w* \w from the womb|strong="H07358"\w*,
\q1 \v 9 \w when I made|strong="H07760"\w* \w the clouds|strong="H06051"\w* \w its garment|strong="H03830"\w*
\q2 \w and thick darkness|strong="H06205"\w* \w its blanket|strong="H02854"\w*,
\q1 \v 10 \w when I fixed|strong="H07665"\w* \w its boundaries|strong="H02706"\w*
