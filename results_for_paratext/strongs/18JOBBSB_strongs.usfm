\q2 \w he|strong="H01931"\w* \w is marked|strong="H06822"\w* \w for|strong="H00413"\w* \w the sword|strong="H02719"\w*.
\q1 \v 23 \w He|strong="H01931"\w* \w wanders about|strong="H05074"\w* \w as food|strong="H03899"\w* \w for vultures|strong="H00346"\w*;
\q2 \w he knows|strong="H03045"\w* \w the day|strong="H03117"\w* \w of darkness|strong="H02822"\w* \w is at hand|strong="H03027"\w*.
\q1 \v 24 \w Distress|strong="H06862"\w* \w and anguish|strong="H04691"\w* \w terrify him|strong="H01204"\w*,
\q2 \w overwhelming him|strong="H08630"\w* \w like a king|strong="H04428"\w* \w poised|strong="H06264"\w* \w to attack|strong="H03593"\w*.
\q1 \v 25 \w For|strong="H03588"\w* \w he has stretched out|strong="H05186"\w* \w his hand|strong="H03027"\w* \w against|strong="H00413"\w* \w God|strong="H00410"\w*
\q2 \w and has vaunted himself|strong="H01396"\w* \w against|strong="H00413"\w* \w the Almighty|strong="H07706"\w*,
\q1 \v 26 \w rushing|strong="H07323"\w* \w headlong|strong="H06677"\w* \w at Him|strong="H00413"\w*
