\q1 \v 21 \w He will yet|strong="H05704"\w* \w fill your mouth|strong="H06310"\w* \w with|strong="H04390"\w* \w laughter|strong="H07814"\w*,
\q2 \w and your lips|strong="H08193"\w* \w with a shout of joy|strong="H08643"\w*.
