\q1 \v 32 \w It will be paid in full|strong="H04390"\w* \w before|strong="H03808"\w* \w his time|strong="H03117"\w*,
\q2 \w and his branch|strong="H03712"\w* \w will not|strong="H03808"\w* \w flourish|strong="H07488"\w*.
\q1 \v 33 \w He will be like a vine|strong="H01612"\w* \w stripped of|strong="H02554"\w* \w its unripe grapes|strong="H01154"\w*,
