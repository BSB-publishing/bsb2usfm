\q2 \w and you choose|strong="H00977"\w* \w the language|strong="H03956"\w* \w of the crafty|strong="H06175"\w*.
\q1 \v 6 \w Your own mouth|strong="H06310"\w*, \w not|strong="H03808"\w* \w mine|strong="H00589"\w*, \w condemns you|strong="H07561"\w*;
\q2 \w your own lips|strong="H08193"\w* \w testify|strong="H06030"\w* against you.
\b 
\q1 \v 7 \w Were you the first|strong="H07223"\w* \w man|strong="H00120"\w* \w ever born|strong="H03205"\w*?
