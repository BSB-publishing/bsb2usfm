\q2 \w and encrusted|strong="H01487"\w* \w with dirt|strong="H06083"\w*;
\q2 \w my skin|strong="H05785"\w* \w is cracked|strong="H07280"\w* \w and festering|strong="H03988"\w*.
\q1 \v 6 \w My days|strong="H03117"\w* \w are swifter|strong="H07043"\w* \w than|strong="H04480"\w* \w a weaver’s shuttle|strong="H00708"\w*;
\q2 \w they come to an end|strong="H03615"\w* \w without|strong="H00657"\w* \w hope|strong="H08615"\w*.
\b 
\q1 \v 7 \w Remember|strong="H02142"\w* \w that|strong="H03588"\w* \w my life|strong="H02416"\w* \w is but a breath|strong="H07307"\w*.
\q2 \w My eyes|strong="H05869"\w* \w will never|strong="H03808"\w* \w again|strong="H07725"\w* \w see|strong="H07200"\w* \w happiness|strong="H02896"\w*.
