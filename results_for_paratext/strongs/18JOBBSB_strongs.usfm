\b 
\q1 \v 11 \w Therefore|strong="H01571"\w* \w I|strong="H00589"\w* \w will not|strong="H03808"\w* \w restrain|strong="H02820"\w* \w my mouth|strong="H06310"\w*;
\q2 \w I will speak|strong="H01696"\w* \w in the anguish|strong="H06862"\w* \w of my spirit|strong="H07307"\w*;
\q2 \w I will complain|strong="H07878"\w* \w in the bitterness|strong="H04751"\w* \w of my soul|strong="H05315"\w*.
