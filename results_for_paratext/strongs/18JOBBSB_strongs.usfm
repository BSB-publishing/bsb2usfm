\p \v 12 \w So the LORD|strong="H03068"\w* \w blessed|strong="H01288"\w* \w Job’s|strong="H00347"\w* \w latter days|strong="H00319"\w* \w more than his first|strong="H07225"\w*. \w He owned|strong="H01961"\w* \w 14,000|strong="H00702"\w* \w sheep|strong="H06629"\w*, \w 6,000|strong="H08337"\w* \w camels|strong="H01581"\w*, \w 1,000|strong="H00505"\w* \w yoke|strong="H06776"\w* \w of oxen|strong="H01241"\w*, \w and 1,000|strong="H00505"\w* \w female donkeys|strong="H00860"\w*. \v 13 \w And he also had|strong="H01961"\w* \w seven|strong="H07658"\w* \w sons|strong="H01121"\w* \w and three|strong="H07969"\w* \w daughters|strong="H01323"\w*. \v 14 \w He named|strong="H07121"\w* \w his first|strong="H00259"\w* \w daughter Jemimah|strong="H03224"\w*, \w his second|strong="H08145"\w* \w Keziah|strong="H07103"\w*, \w and his third|strong="H07992"\w* \w Keren-happuch|strong="H07163"\w*. \v 15 \w No|strong="H03808"\w* \w women|strong="H00802"\w* \w as beautiful|strong="H03303"\w* \w as Job’s|strong="H00347"\w* \w daughters|strong="H01323"\w* \w could be found|strong="H04672"\w* \w in all|strong="H03605"\w* \w the land|strong="H00776"\w*, \w and their father|strong="H00001"\w* \w granted|strong="H05414"\w* them \w an inheritance|strong="H05159"\w* \w among|strong="H08432"\w* \w their brothers|strong="H00251"\w*.
