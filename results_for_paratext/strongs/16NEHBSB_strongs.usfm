\b 
\li1 \w Jeshua|strong="H03442"\w* \w son|strong="H01121"\w* \w of Azaniah|strong="H00245"\w*,
\li1 \w Binnui|strong="H01131"\w* \w of the sons|strong="H01121"\w* \w of Henadad|strong="H02582"\w*, \w Kadmiel|strong="H06934"\w*,
\li1 \v 10 \w and their associates|strong="H00251"\w*: \w Shebaniah|strong="H07645"\w*, \w Hodiah|strong="H01941"\w*, \w Kelita|strong="H07042"\w*, \w Pelaiah|strong="H06411"\w*, \w Hanan|strong="H02605"\w*,
\li1 \v 11 \w Mica|strong="H04316"\w*, \w Rehob|strong="H07340"\w*, \w Hashabiah|strong="H02811"\w*,
\li1 \v 12 \w Zaccur|strong="H02139"\w*, \w Sherebiah|strong="H08274"\w*, \w Shebaniah|strong="H07645"\w*,
\li1 \v 13 \w Hodiah|strong="H01941"\w*, \w Bani|strong="H01137"\w*, \w and Beninu|strong="H01148"\w*.
\p \v 14 \w And the leaders|strong="H07218"\w* \w of the people|strong="H05971"\w*:
\b 
\li1 \w Parosh|strong="H06551"\w*, \w Pahath-moab|strong="H06355"\w*, \w Elam|strong="H05867"\w*, \w Zattu|strong="H02240"\w*, \w Bani|strong="H01137"\w*,
\li1 \v 15 \w Bunni|strong="H01138"\w*, \w Azgad|strong="H05803"\w*, \w Bebai|strong="H00893"\w*,
\li1 \v 16 \w Adonijah|strong="H00138"\w*, \w Bigvai|strong="H00902"\w*, \w Adin|strong="H05720"\w*,
\li1 \v 17 \w Ater|strong="H00333"\w*, \w Hezekiah|strong="H02396"\w*, \w Azzur|strong="H05809"\w*,
\li1 \v 18 \w Hodiah|strong="H01941"\w*, \w Hashum|strong="H02828"\w*, \w Bezai|strong="H01209"\w*,
\li1 \v 19 \w Hariph|strong="H02756"\w*, \w Anathoth|strong="H06068"\w*, \w Nebai|strong="H05109"\w*,
\li1 \v 20 \w Magpiash|strong="H04047"\w*, \w Meshullam|strong="H04918"\w*, \w Hezir|strong="H02387"\w*,
\li1 \v 21 \w Meshezabel|strong="H04898"\w*, \w Zadok|strong="H06659"\w*, \w Jaddua|strong="H03037"\w*,
\li1 \v 22 \w Pelatiah|strong="H06410"\w*, \w Hanan|strong="H02605"\w*, \w Anaiah|strong="H06043"\w*,
\li1 \v 23 \w Hoshea|strong="H01954"\w*, \w Hananiah|strong="H02608"\w*, \w Hasshub|strong="H02815"\w*,
\li1 \v 24 \w Hallohesh|strong="H03873"\w*, \w Pilha|strong="H06401"\w*, \w Shobek|strong="H07733"\w*,
\li1 \v 25 \w Rehum|strong="H07348"\w*, \w Hashabnah|strong="H02812"\w*, \w Maaseiah|strong="H04641"\w*,
\li1 \v 26 \w Ahijah|strong="H00281"\w*, \w Hanan|strong="H02605"\w*, \w Anan|strong="H06052"\w*,
\li1 \v 27 \w Malluch|strong="H04409"\w*, \w Harim|strong="H02766"\w*, \w and Baanah|strong="H01196"\w*.
\s1 The Vows of the Covenant
\p \v 28 “\w The rest|strong="H07605"\w* \w of the people|strong="H05971"\w*— \w the priests|strong="H03548"\w*, \w Levites|strong="H03881"\w*, \w gatekeepers|strong="H07778"\w*, \w singers|strong="H07891"\w*, \w temple servants|strong="H05411"\w*,\f + \fr 10:28 \ft Hebrew \fqa Nethinim\f* \w and all|strong="H03605"\w* \w who had separated themselves|strong="H00914"\w* \w from the people|strong="H05971"\w* \w of the land|strong="H00776"\w* \w to|strong="H00413"\w* \w obey the Law|strong="H08451"\w* \w of God|strong="H00430"\w*— \w along with their wives|strong="H00802"\w* \w and all|strong="H03605"\w* \w their sons|strong="H01121"\w* \w and daughters|strong="H01323"\w* \w who are able to understand|strong="H00995"\w*, \v 29 \w hereby join|strong="H02388"\w* \w with|strong="H05921"\w* \w their noble|strong="H00117"\w* \w brothers|strong="H00251"\w* \w and commit|strong="H00935"\w* \w themselves with a sworn|strong="H07621"\w* \w oath|strong="H00423"\w* \w to follow|strong="H01980"\w* \w the Law|strong="H08451"\w* \w of God|strong="H00430"\w* \w given|strong="H05414"\w* \w through|strong="H03027"\w* \w His|strong="H00430"\w* \w servant|strong="H05650"\w* \w Moses|strong="H04872"\w* \w and to obey|strong="H06213"\w* \w carefully|strong="H08104"\w* \w all|strong="H03605"\w* \w the commandments|strong="H04687"\w*, \w ordinances|strong="H04941"\w*, \w and statutes|strong="H02706"\w* \w of the LORD|strong="H03068"\w* \w our Lord|strong="H00113"\w*.
\p \v 30 \w We will not|strong="H03808"\w* \w give|strong="H05414"\w* \w our daughters in marriage|strong="H01323"\w* \w to the people|strong="H05971"\w* \w of the land|strong="H00776"\w*, \w and we will not|strong="H03808"\w* \w take|strong="H03947"\w* \w their daughters|strong="H01323"\w* \w for our sons|strong="H01121"\w*.
\p \v 31 \w When the people|strong="H05971"\w* \w of the land|strong="H00776"\w* \w bring|strong="H00935"\w* \w merchandise|strong="H04728"\w* \w or any|strong="H03605"\w* \w kind of grain|strong="H07668"\w* \w to sell|strong="H04376"\w* \w on the Sabbath|strong="H07676"\w* \w day|strong="H03117"\w*, \w we will not|strong="H03808"\w* \w buy|strong="H03947"\w* from them \w on a Sabbath|strong="H07676"\w* \w or holy|strong="H06944"\w* \w day|strong="H03117"\w*. \w Every seventh|strong="H07637"\w* \w year|strong="H08141"\w* \w we will let the fields lie fallow|strong="H05203"\w* \w and will cancel every|strong="H03605"\w* \w debt|strong="H04855"\w*.
\p \v 32 \w We also place|strong="H05975"\w* \w ourselves|strong="H05921"\w* \w under|strong="H05921"\w* \w the obligation|strong="H04687"\w* \w to contribute|strong="H05414"\w* \w a third|strong="H07992"\w* \w of a shekel|strong="H08255"\w*\f + \fr 10:32 \fqa A third of a shekel \ft is approximately 0.13 ounces or 3.8 grams, probably of silver.\f* \w yearly|strong="H08141"\w* \w for the service|strong="H05656"\w* \w of the house|strong="H01004"\w* \w of our God|strong="H00430"\w*: \v 33 \w for the showbread|strong="H03899"\w*, \w for the regular|strong="H08548"\w* \w grain offerings|strong="H04503"\w* \w and burnt offerings|strong="H05930"\w*, \w for the Sabbath offerings|strong="H07676"\w*, \w for the New Moons|strong="H02320"\w* \w and appointed feasts|strong="H04150"\w*, \w for the holy offerings|strong="H06944"\w*, \w for the sin offerings|strong="H02403"\w* \w to make atonement|strong="H03722"\w* \w for|strong="H05921"\w* \w Israel|strong="H03478"\w*, \w and for all|strong="H03605"\w* \w the duties|strong="H04399"\w* \w of the house|strong="H01004"\w* \w of our God|strong="H00430"\w*.
\p \v 34 \w We have cast|strong="H05307"\w* \w lots|strong="H01486"\w* \w among the priests|strong="H03548"\w*, \w Levites|strong="H03881"\w*, \w and people|strong="H05971"\w* \w for|strong="H05921"\w* \w the donation|strong="H07133"\w* \w of wood|strong="H06086"\w* \w by our families|strong="H01004"\w* \w at the appointed|strong="H02163"\w* \w times|strong="H06256"\w* \w each year|strong="H08141"\w*. \w They are to bring it|strong="H00935"\w* \w to the house|strong="H01004"\w* \w of our God|strong="H00430"\w* \w to burn|strong="H01197"\w* \w on|strong="H05921"\w* \w the altar|strong="H04196"\w* \w of the LORD|strong="H03068"\w* \w our God|strong="H00430"\w*, \w as it is written|strong="H03789"\w* \w in the Law|strong="H08451"\w*.
\p \v 35 \w We will also bring|strong="H00935"\w* \w the firstfruits|strong="H01061"\w* \w of our land|strong="H00127"\w* \w and of every|strong="H03605"\w* \w fruit|strong="H06529"\w* \w tree|strong="H06086"\w* \w to the house|strong="H01004"\w* \w of the LORD|strong="H03068"\w* \w year|strong="H08141"\w* \w by year|strong="H08141"\w*. \v 36 \w And|strong="H00853"\w* \w we will bring|strong="H00935"\w* \w the firstborn|strong="H01060"\w* \w of our sons|strong="H01121"\w* \w and our livestock|strong="H00929"\w*, \w as it is written|strong="H03789"\w* \w in the Law|strong="H08451"\w*, \w and|strong="H00853"\w* \w will bring the firstborn|strong="H01060"\w* \w of our herds|strong="H01241"\w* \w and flocks|strong="H06629"\w* \w to the house|strong="H01004"\w* \w of our God|strong="H00430"\w*, \w to the priests|strong="H03548"\w* \w who minister|strong="H08334"\w* \w in the house|strong="H01004"\w* \w of our God|strong="H00430"\w*.
\p \v 37 \w Moreover|strong="H00853"\w*, \w we will bring|strong="H00935"\w* \w to the priests|strong="H03548"\w* \w at|strong="H00413"\w* \w the storerooms|strong="H03957"\w* \w of the house|strong="H01004"\w* \w of our God|strong="H00430"\w* \w the firstfruits|strong="H07225"\w* \w of our dough|strong="H06182"\w*, \w of our grain offerings|strong="H08641"\w*, \w of the fruit|strong="H06529"\w* \w of all our|strong="H03605"\w* \w trees|strong="H06086"\w*, \w and of our new wine|strong="H08492"\w* \w and oil|strong="H03323"\w*. \w A tenth|strong="H04643"\w* \w of our produce|strong="H00127"\w* \w belongs to the Levites|strong="H03881"\w*, \w so that they|strong="H01992"\w* \w shall receive tithes|strong="H06237"\w* \w in all|strong="H03605"\w* \w the towns|strong="H05892"\w* \w where we labor|strong="H05656"\w*. \v 38 \w A priest|strong="H03548"\w* \w of Aaron’s|strong="H00175"\w* \w line|strong="H01121"\w* \w is to accompany|strong="H01961"\w* \w the Levites|strong="H03881"\w* \w when they|strong="H03881"\w* \w collect the tenth|strong="H06237"\w*, \w and the Levites|strong="H03881"\w* \w are to bring|strong="H05927"\w* \w a tenth|strong="H04643"\w* \w of these tithes|strong="H04643"\w* \w to|strong="H00413"\w* \w the storerooms|strong="H03957"\w* \w of the treasury|strong="H01004"\w* \w in the house|strong="H01004"\w* \w of our God|strong="H00430"\w*. \v 39 \w For|strong="H03588"\w* \w the Israelites|strong="H01121"\w* \w and the Levites|strong="H01121"\w* \w are to bring|strong="H00935"\w* \w the contributions|strong="H08641"\w* \w of grain|strong="H01715"\w*, \w new wine|strong="H08492"\w*, \w and oil|strong="H03323"\w* \w to|strong="H00413"\w* \w the storerooms|strong="H03957"\w* \w where|strong="H08033"\w* \w the articles|strong="H03627"\w* \w of the sanctuary are kept|strong="H04720"\w* \w and where the ministering|strong="H08334"\w* \w priests|strong="H03548"\w*, \w the gatekeepers|strong="H07778"\w*, \w and the singers stay|strong="H07891"\w*.
\p \w Thus we will not|strong="H03808"\w* \w neglect|strong="H05800"\w* \w the house|strong="H01004"\w* \w of our God|strong="H00430"\w*.”
\c 11
\s1 Jerusalem’s New Settlers
\p \v 1 \w Now the leaders|strong="H08269"\w* \w of the people|strong="H05971"\w* \w settled|strong="H03427"\w* \w in Jerusalem|strong="H03389"\w*, \w and the rest|strong="H07605"\w* \w of the people|strong="H05971"\w* \w cast|strong="H05307"\w* \w lots|strong="H01486"\w* \w to bring|strong="H00935"\w* \w one|strong="H00259"\w* \w out|strong="H04480"\w* \w of ten|strong="H06235"\w* \w to live|strong="H03427"\w* \w in the holy|strong="H06944"\w* \w city|strong="H05892"\w* \w of Jerusalem|strong="H03389"\w*, \w while|strong="H08672"\w* \w the remaining nine|strong="H03027"\w*\f + \fr 11:1 \ft Hebrew \fqa nine hands\f* \w were to dwell in their own towns|strong="H05892"\w*. \v 2 \w And the people|strong="H05971"\w* \w blessed|strong="H01288"\w* \w all|strong="H03605"\w* \w the men|strong="H00582"\w* \w who volunteered|strong="H05068"\w* \w to live|strong="H03427"\w* \w in Jerusalem|strong="H03389"\w*.
\p \v 3 \w These|strong="H00428"\w* \w are the heads|strong="H07218"\w* \w of the provinces|strong="H04082"\w* \w who|strong="H00834"\w* \w settled|strong="H03427"\w* \w in Jerusalem|strong="H03389"\w*. \w (In the villages|strong="H05892"\w* \w of Judah, however|strong="H03063"\w*, \w each|strong="H00376"\w* \w lived|strong="H03427"\w* \w on his own property|strong="H00272"\w* \w in their towns|strong="H05892"\w*— \w the Israelites|strong="H03478"\w*, \w priests|strong="H03548"\w*, \w Levites|strong="H03881"\w*, \w temple servants|strong="H05411"\w*,\f + \fr 11:3 \ft Hebrew \fqa Nethinim\ft ; also in verse 21\f* \w and descendants|strong="H01121"\w* \w of Solomon’s|strong="H08010"\w* \w servants|strong="H05650"\w*— \v 4 \w while some of the descendants|strong="H01121"\w* \w of Judah|strong="H03063"\w* \w and Benjamin|strong="H01144"\w* \w settled|strong="H03427"\w* \w in Jerusalem|strong="H03389"\w*.)
\p \w From the descendants|strong="H01121"\w* \w of Judah|strong="H03063"\w*:
\p \w Athaiah|strong="H06265"\w* \w son|strong="H01121"\w* \w of Uzziah|strong="H05818"\w*, \w the son|strong="H01121"\w* \w of Zechariah|strong="H02148"\w*, \w the son|strong="H01121"\w* \w of Amariah|strong="H00568"\w*, \w the son|strong="H01121"\w* \w of Shephatiah|strong="H08203"\w*, \w the son|strong="H01121"\w* \w of Mahalalel|strong="H04111"\w*, \w a descendant|strong="H01121"\w* \w of Perez|strong="H06557"\w*; \v 5 \w and Maaseiah|strong="H04641"\w* \w son|strong="H01121"\w* \w of Baruch|strong="H01263"\w*, \w the son|strong="H01121"\w* \w of Col-hozeh|strong="H03626"\w*, \w the son|strong="H01121"\w* \w of Hazaiah|strong="H02382"\w*, \w the son|strong="H01121"\w* \w of Adaiah|strong="H05718"\w*, \w the son|strong="H01121"\w* \w of Joiarib|strong="H03114"\w*, \w the son|strong="H01121"\w* \w of Zechariah|strong="H02148"\w*, \w a descendant|strong="H01121"\w* \w of Shelah|strong="H08023"\w*.\f + \fr 11:5 \ft Or \fqa of the Shilonite\f* \v 6 \w The descendants|strong="H01121"\w* \w of Perez|strong="H06557"\w* \w who settled|strong="H03427"\w* \w in Jerusalem|strong="H03389"\w* \w totaled|strong="H03605"\w* \w 468|strong="H00702"\w* \w men|strong="H00582"\w* \w of valor|strong="H02428"\w*.
\p \v 7 \w From|strong="H00428"\w* \w the descendants|strong="H01121"\w* \w of Benjamin|strong="H01144"\w*:
\p \w Sallu|strong="H05543"\w* \w son|strong="H01121"\w* \w of Meshullam|strong="H04918"\w*, \w the son|strong="H01121"\w* \w of Joed|strong="H03133"\w*, \w the son|strong="H01121"\w* \w of Pedaiah|strong="H06305"\w*, \w the son|strong="H01121"\w* \w of Kolaiah|strong="H06964"\w*, \w the son|strong="H01121"\w* \w of Maaseiah|strong="H04641"\w*, \w the son|strong="H01121"\w* \w of Ithiel|strong="H00384"\w*, \w the son|strong="H01121"\w* \w of Jeshaiah|strong="H03470"\w*; \v 8 \w and his followers|strong="H00310"\w* \w Gabbai|strong="H01373"\w* \w and Sallai|strong="H05543"\w* — \w 928 men|strong="H08672"\w*. \v 9 \w Joel|strong="H03100"\w* \w son|strong="H01121"\w* \w of Zichri|strong="H02147"\w* \w was the officer|strong="H06496"\w* \w over them|strong="H05921"\w*, \w and Judah|strong="H03063"\w* \w son|strong="H01121"\w* \w of Hassenuah|strong="H05574"\w* \w was over|strong="H05921"\w* \w the Second District|strong="H04932"\w* \w of the city|strong="H05892"\w*.\f + \fr 11:9 \ft Or \fqa was over the Second Quarter of the city\ft , a newer section of Jerusalem; or \fqa was second in command of the city\f*
\p \v 10 \w From|strong="H04480"\w* \w the priests|strong="H03548"\w*:
\b 
\li1 \w Jedaiah|strong="H03048"\w* \w son|strong="H01121"\w* \w of Joiarib|strong="H03114"\w*;\f + \fr 11:10 \ft Or \fqa Jedaiah; the son of Joiarib;\f* \w Jachin|strong="H03199"\w*; \v 11 \w Seraiah|strong="H08304"\w* \w son|strong="H01121"\w* \w of Hilkiah|strong="H02518"\w*, \w the son|strong="H01121"\w* \w of Meshullam|strong="H04918"\w*, \w the son|strong="H01121"\w* \w of Zadok|strong="H06659"\w*, \w the son|strong="H01121"\w* \w of Meraioth|strong="H04812"\w*, \w the son|strong="H01121"\w* \w of Ahitub|strong="H00285"\w*, \w the chief official|strong="H05057"\w* \w of the house|strong="H01004"\w* \w of God|strong="H00430"\w*; \v 12 \w and their associates|strong="H00251"\w* \w who did|strong="H06213"\w* \w the work|strong="H04399"\w* \w at the temple|strong="H01004"\w* — \w 822 men|strong="H08083"\w*;
\li1 \w Adaiah|strong="H05718"\w* \w son|strong="H01121"\w* \w of Jeroham|strong="H03395"\w*, \w the son|strong="H01121"\w* \w of Pelaliah|strong="H06421"\w*, \w the son|strong="H01121"\w* \w of Amzi|strong="H00557"\w*, \w the son|strong="H01121"\w* \w of Zechariah|strong="H02148"\w*, \w the son|strong="H01121"\w* \w of Pashhur|strong="H06583"\w*, \w the son|strong="H01121"\w* \w of Malchijah|strong="H04441"\w*; \v 13 \w and his associates|strong="H00251"\w*, \w the leaders|strong="H07218"\w* \w of families|strong="H00001"\w* — \w 242 men|strong="H03967"\w*;
\li1 \w Amashai|strong="H06023"\w* \w son|strong="H01121"\w* \w of Azarel|strong="H05832"\w*, \w the son|strong="H01121"\w* \w of Ahzai|strong="H00273"\w*, \w the son|strong="H01121"\w* \w of Meshillemoth|strong="H04919"\w*, \w the son|strong="H01121"\w* \w of Immer|strong="H00564"\w*; \v 14 \w and his associates|strong="H00251"\w*\f + \fr 11:14 \ft Most LXX manuscripts; Hebrew \fqa their associates\f* — \w 128|strong="H03967"\w* \w mighty men|strong="H01368"\w* \w of valor|strong="H02428"\w*. \w Zabdiel|strong="H02068"\w* \w son of|strong="H01121"\w* \w Haggedolim|strong="H01419"\w* \w was their overseer|strong="H06496"\w*.
\p \v 15 \w From|strong="H04480"\w* \w the Levites|strong="H03881"\w*:
\p \w Shemaiah|strong="H08098"\w* \w son|strong="H01121"\w* \w of Hasshub|strong="H02815"\w*, \w the son|strong="H01121"\w* \w of Azrikam|strong="H05840"\w*, \w the son|strong="H01121"\w* \w of Hashabiah|strong="H02811"\w*, \w the son|strong="H01121"\w* \w of Bunni|strong="H01138"\w*; \v 16 \w Shabbethai|strong="H07678"\w* \w and Jozabad|strong="H03107"\w*, \w two leaders|strong="H07218"\w* \w of the Levites|strong="H03881"\w*, \w who supervised|strong="H05921"\w* \w the work|strong="H04399"\w* \w outside|strong="H02435"\w* \w the house|strong="H01004"\w* \w of God|strong="H00430"\w*; \v 17 \w Mattaniah|strong="H04983"\w* \w son|strong="H01121"\w* \w of Mica|strong="H04318"\w*, \w the son|strong="H01121"\w* \w of Zabdi|strong="H02067"\w*, \w the son|strong="H01121"\w* \w of Asaph|strong="H00623"\w*, \w who led|strong="H07218"\w* \w in thanksgiving|strong="H03034"\w* \w and prayer|strong="H08605"\w*; \w Bakbukiah|strong="H01229"\w*, \w second|strong="H04932"\w* \w among his associates|strong="H00251"\w*; \w and Abda|strong="H05653"\w* \w son|strong="H01121"\w* \w of Shammua|strong="H08051"\w*, \w the son|strong="H01121"\w* \w of Galal|strong="H01559"\w*, \w the son|strong="H01121"\w* \w of Jeduthun|strong="H03038"\w*. \v 18 \w The Levites|strong="H03881"\w* \w in the holy|strong="H06944"\w* \w city|strong="H05892"\w* \w totaled|strong="H03605"\w* \w 284|strong="H03967"\w*.
\p \v 19 \w And the gatekeepers|strong="H07778"\w*:
\p \w Akkub|strong="H06126"\w*, \w Talmon|strong="H02929"\w*, \w and their associates|strong="H00251"\w*, \w who kept watch|strong="H08104"\w* \w at the gates|strong="H08179"\w* — \w 172 men|strong="H03967"\w*.
\s1 Residents Outside Jerusalem
\p \v 20 \w The rest|strong="H07605"\w* \w of the Israelites|strong="H03478"\w*, \w with the priests|strong="H03548"\w* \w and Levites|strong="H03881"\w*, \w were in all|strong="H03605"\w* \w the villages|strong="H05892"\w* \w of Judah|strong="H03063"\w*, \w each|strong="H00376"\w* \w on his own inheritance|strong="H05159"\w*. \v 21 \w The temple servants|strong="H05411"\w* \w lived|strong="H03427"\w* \w on the hill of Ophel|strong="H06077"\w*, \w with Ziha|strong="H06727"\w* \w and Gishpa|strong="H01658"\w* \w over|strong="H05921"\w* \w them|strong="H05411"\w*.
\p \v 22 \w Now the overseer|strong="H06496"\w* \w of the Levites|strong="H03881"\w* \w in Jerusalem|strong="H03389"\w* \w was Uzzi|strong="H05813"\w* \w son|strong="H01121"\w* \w of Bani|strong="H01137"\w*, \w the son|strong="H01121"\w* \w of Hashabiah|strong="H02811"\w*, \w the son|strong="H01121"\w* \w of Mattaniah|strong="H04983"\w*, \w the son|strong="H01121"\w* \w of Mica|strong="H04316"\w*.\f + \fr 11:22 \fqa Mica \ft is a variant of \fqa Micaiah\ft ; see Nehemiah 12:35.\f* \w He was one of Asaph’s|strong="H00623"\w* \w descendants|strong="H01121"\w*, \w who were the singers|strong="H07891"\w* \w in charge|strong="H05048"\w* \w of the service|strong="H04399"\w* \w of the house|strong="H01004"\w* \w of God|strong="H00430"\w*. \v 23 \w For|strong="H03588"\w* \w there was a command|strong="H04687"\w* \w from the king|strong="H04428"\w* \w concerning the singers|strong="H05921"\w*, \w an ordinance|strong="H00548"\w* \w regulating|strong="H05921"\w* \w their|strong="H07891"\w* \w daily|strong="H03117"\w* \w activities|strong="H01697"\w*. \v 24 \w Pethahiah|strong="H06611"\w* \w son|strong="H01121"\w* \w of Meshezabel|strong="H04898"\w*, \w a descendant|strong="H01121"\w* \w of Zerah|strong="H02226"\w* \w son|strong="H01121"\w* \w of Judah|strong="H03063"\w*, \w was the king’s|strong="H04428"\w* \w agent|strong="H03027"\w*\f + \fr 11:24 \ft Hebrew \fqa hand\f* \w in every|strong="H03605"\w* \w matter|strong="H01697"\w* \w concerning the people|strong="H05971"\w*.
\p \v 25 \w As for|strong="H00413"\w* \w the villages|strong="H02691"\w* \w with their fields|strong="H07704"\w*, \w some of the people|strong="H01121"\w* \w of Judah|strong="H03063"\w* \w lived|strong="H03427"\w* \w in Kiriath-arba|strong="H07153"\w*, \w Dibon|strong="H01769"\w*, \w Jekabzeel|strong="H03343"\w*, \w and their villages|strong="H02691"\w*; \v 26 \w in Jeshua|strong="H03442"\w*, \w Moladah|strong="H04137"\w*, \w and Beth-pelet|strong="H01046"\w*; \v 27 \w in Hazar-shual|strong="H02705"\w*; \w in Beersheba|strong="H00884"\w* \w and its villages|strong="H01323"\w*; \v 28 \w in Ziklag|strong="H06860"\w*; \w in Meconah|strong="H04368"\w* \w and its villages|strong="H01323"\w*; \v 29 \w in En-rimmon|strong="H05884"\w*, \w Zorah|strong="H06881"\w*, \w Jarmuth|strong="H03412"\w*, \v 30 \w Zanoah|strong="H02182"\w*, \w Adullam|strong="H05725"\w*, \w and their villages|strong="H02691"\w*; \w in Lachish|strong="H03923"\w* \w and its fields|strong="H07704"\w*; \w and in Azekah|strong="H05825"\w* \w and its villages|strong="H01323"\w*. \w So they settled|strong="H02583"\w* \w from Beersheba|strong="H00884"\w* \w all the way to|strong="H05704"\w* \w the Valley|strong="H01516"\w* \w of Hinnom|strong="H02011"\w*.
\p \v 31 \w The descendants|strong="H01121"\w* \w of Benjamin|strong="H01144"\w* \w from Geba|strong="H01387"\w* \w lived in Michmash|strong="H04363"\w*, \w Aija|strong="H05857"\w*, \w and Bethel|strong="H01008"\w* \w with its villages|strong="H01323"\w*; \v 32 \w in Anathoth|strong="H06068"\w*, \w Nob|strong="H05011"\w*, \w Ananiah|strong="H06055"\w*, \v 33 \w Hazor|strong="H02674"\w*, \w Ramah|strong="H07414"\w*, \w Gittaim|strong="H01664"\w*, \v 34 \w Hadid|strong="H02307"\w*, \w Zeboim|strong="H06650"\w*, \w Neballat|strong="H05041"\w*, \v 35 \w Lod|strong="H03850"\w*, \w and Ono|strong="H00207"\w*; \w and in the Valley|strong="H01516"\w* \w of the Craftsmen|strong="H02798"\w*.\f + \fr 11:35 \ft Hebrew \fqa in Ge-harashim\f*
\p \v 36 \w And some|strong="H04480"\w* \w divisions|strong="H04256"\w* \w of the Levites|strong="H03881"\w* \w of Judah|strong="H03063"\w* \w settled in Benjamin|strong="H01144"\w*.
\c 12
\s1 The Priests and Levites Who Returned
\p \v 1 \w Now these|strong="H00428"\w* \w are the priests|strong="H03548"\w* \w and Levites|strong="H03881"\w* \w who|strong="H00834"\w* \w went up|strong="H05927"\w* \w with|strong="H05973"\w* \w Zerubbabel|strong="H02216"\w* \w son|strong="H01121"\w* \w of Shealtiel|strong="H07597"\w* \w and with Jeshua|strong="H03442"\w*:
\b 
\li1 \w Seraiah|strong="H08304"\w*, \w Jeremiah|strong="H03414"\w*, \w Ezra|strong="H05830"\w*,
\li1 \v 2 \w Amariah|strong="H00568"\w*, \w Malluch|strong="H04409"\w*,\f + \fr 12:2 \fqa Malluch \ft is a variant of \fqa Malluchi\ft ; see verse 14.\f* \w Hattush|strong="H02407"\w*,
\li1 \v 3 \w Shecaniah|strong="H07935"\w*, \w Rehum|strong="H07348"\w*,\f + \fr 12:3 \fqa Rehum \ft is a variant of \fqa Harim\ft ; see verse 15, Nehemiah 7:42, and Ezra 2:39.\f* \w Meremoth|strong="H04822"\w*,
\li1 \v 4 \w Iddo|strong="H05714"\w*, \w Ginnethon|strong="H01599"\w*,\f + \fr 12:4 \ft Many Hebrew manuscripts and Vulgate (see also verse 16); most MT manuscripts \fqa Ginnethoi\f* \w Abijah|strong="H00029"\w*,
\li1 \v 5 \w Mijamin|strong="H04326"\w*,\f + \fr 12:5 \fqa Mijamin \ft is a variant of \fqa Miniamin\ft ; see verse 17.\f* \w Maadiah|strong="H04573"\w*,\f + \fr 12:5 \fqa Maadiah \ft is a variant of \fqa Moadiah\ft ; see verse 17.\f* \w Bilgah|strong="H01083"\w*,\f + \fr 12:5 \fqa Bilgah \ft is a variant of \fqa Bilgai\ft ; also in verse 18; see Nehemiah 10:8.\f*
\li1 \v 6 \w Shemaiah|strong="H08098"\w*, \w Joiarib|strong="H03114"\w*, \w Jedaiah|strong="H03048"\w*,
\li1 \v 7 \w Sallu|strong="H05543"\w*, \w Amok|strong="H05987"\w*, \w Hilkiah|strong="H02518"\w*, \w and Jedaiah|strong="H03048"\w*.
\b 
\li1 \w These|strong="H00428"\w* \w were the leaders|strong="H07218"\w* \w of the priests|strong="H03548"\w* \w and their associates|strong="H00251"\w* \w in the days|strong="H03117"\w* \w of Jeshua|strong="H03442"\w*.
\p \v 8 \w The Levites were|strong="H03881"\w* \w Jeshua|strong="H03442"\w*, \w Binnui|strong="H01131"\w*, \w Kadmiel|strong="H06934"\w*, \w Sherebiah|strong="H08274"\w*, \w Judah|strong="H03063"\w*, \w and Mattaniah|strong="H04983"\w*, \w who|strong="H01931"\w*, \w with his associates|strong="H00251"\w*, \w led|strong="H05921"\w* \w the songs of thanksgiving|strong="H01960"\w*. \v 9 \w Bakbukiah|strong="H01229"\w* \w and Unni|strong="H06042"\w*, \w their associates|strong="H00251"\w*, \w stood across from them|strong="H05048"\w* \w in the services|strong="H04931"\w*.
\b 
\li1 \v 10 \w Jeshua|strong="H03442"\w* \w was the father of|strong="H03205"\w* \w Joiakim|strong="H03113"\w*,
\li1 \w Joiakim|strong="H03113"\w* \w was the father of|strong="H03205"\w* \w Eliashib|strong="H00475"\w*,
\li1 \w Eliashib|strong="H00475"\w* \w was the father of Joiada|strong="H03111"\w*,
\li1 \v 11 \w Joiada|strong="H03111"\w* \w was the father of|strong="H03205"\w* \w Jonathan|strong="H03129"\w*,\f + \fr 12:11 \fqa Jonathan \ft is a variant of \fqa Johanan\ft ; see verse 22.\f*
\li1 \w and Jonathan|strong="H03129"\w* \w was the father of|strong="H03205"\w* \w Jaddua|strong="H03037"\w*.
\p \v 12 \w In the days|strong="H03117"\w* \w of Joiakim|strong="H03113"\w*, \w these were|strong="H01961"\w* \w the heads|strong="H07218"\w* \w of the priestly|strong="H03548"\w* \w families|strong="H00001"\w*:
\b 
\li1 \w of the family of Seraiah|strong="H08304"\w*, \w Meraiah|strong="H04811"\w*;
\li1 \w of Jeremiah|strong="H03414"\w*, \w Hananiah|strong="H02608"\w*;
\li1 \v 13 \w of Ezra|strong="H05830"\w*, \w Meshullam|strong="H04918"\w*;
\li1 \w of Amariah|strong="H00568"\w*, \w Jehohanan|strong="H03076"\w*;
\li1 \v 14 \w of Malluchi|strong="H04409"\w*,\f + \fr 12:14 \fqa Malluchi \ft is a variant of \fqa Malluch\ft ; see verse 2.\f* \w Jonathan|strong="H03129"\w*;
\li1 \w of Shebaniah|strong="H07645"\w*,\f + \fr 12:14 \fqa Shebaniah \ft is a variant of \fqa Shecaniah\ft ; see verse 3; see also Syriac and some Hebrew and LXX manuscripts.\f* \w Joseph|strong="H03130"\w*;
\li1 \v 15 \w of Harim|strong="H02766"\w*, \w Adna|strong="H05733"\w*;
\li1 \w of Meraioth|strong="H04812"\w*,\f + \fr 12:15 \fqa Meraioth \ft is a variant of \fqa Meremoth\ft ; see verse 3 and also some LXX manuscripts.\f* \w Helkai|strong="H02517"\w*;
\li1 \v 16 \w of Iddo|strong="H05718"\w*, \w Zechariah|strong="H02148"\w*;
\li1 \w of Ginnethon|strong="H01599"\w*, \w Meshullam|strong="H04918"\w*;
\li1 \v 17 \w of Abijah|strong="H00029"\w*, \w Zichri|strong="H02147"\w*;
\li1 \w of Miniamin|strong="H04509"\w* \w and of Moadiah|strong="H04153"\w*,\f + \fr 12:17 \fqa Moadiah \ft is a variant of \fqa Maadiah\ft ; see verse 5.\f* \w Piltai|strong="H06408"\w*;
\li1 \v 18 \w of Bilgah|strong="H01083"\w*, \w Shammua|strong="H08051"\w*;
\li1 \w of Shemaiah|strong="H08098"\w*, \w Jonathan|strong="H03083"\w*;
\li1 \v 19 \w of Joiarib|strong="H03114"\w*, \w Mattenai|strong="H04982"\w*;
\li1 \w of Jedaiah|strong="H03048"\w*, \w Uzzi|strong="H05813"\w*;
\li1 \v 20 \w of Sallai|strong="H05543"\w*,\f + \fr 12:20 \fqa Sallai \ft is a variant of \fqa Sallu\ft ; see verse 7.\f* \w Kallai|strong="H07040"\w*;
\li1 \w of Amok|strong="H05987"\w*, \w Eber|strong="H05677"\w*;
\li1 \v 21 \w of Hilkiah|strong="H02518"\w*, \w Hashabiah|strong="H02811"\w*;
\li1 \w and of Jedaiah|strong="H03048"\w*, \w Nethanel|strong="H05417"\w*.
\p \v 22 \w In the days|strong="H03117"\w* \w of Eliashib|strong="H00475"\w*, \w Joiada|strong="H03111"\w*, \w Johanan|strong="H03110"\w*,\f + \fr 12:22 \fqa Johanan \ft is a variant of \fqa Jonathan\ft ; see verse 11.\f* \w and Jaddua|strong="H03037"\w*, \w during|strong="H05921"\w* \w the reign of|strong="H04438"\w* \w Darius|strong="H01867"\w* \w the Persian|strong="H06542"\w*, \w the heads|strong="H07218"\w* \w of the families|strong="H00001"\w* \w of the Levites|strong="H03881"\w* \w and priests|strong="H03548"\w* \w were recorded|strong="H03789"\w*.
\p \v 23 \w As for the descendants|strong="H01121"\w* \w of Levi|strong="H03878"\w*, \w the family|strong="H00001"\w* \w heads|strong="H07218"\w* \w up to|strong="H05704"\w* \w the days|strong="H03117"\w* \w of Johanan|strong="H03110"\w* \w son|strong="H01121"\w* \w of Eliashib|strong="H00475"\w* \w were recorded|strong="H03789"\w* \w in|strong="H05921"\w* \w the Book|strong="H05612"\w* \w of the Chronicles|strong="H01697"\w*.\f + \fr 12:23 \ft Or \fqa the Book of the Annals \ft or \fqa the Book of the Historical Events\f* \v 24 \w The leaders|strong="H07218"\w* \w of the Levites|strong="H03881"\w* \w were Hashabiah|strong="H02811"\w*, \w Sherebiah|strong="H08274"\w*, \w and Jeshua|strong="H03442"\w* \w son|strong="H01121"\w* \w of Kadmiel|strong="H06934"\w*,\f + \fr 12:24 \ft Or \fqa Sherebiah, Jeshua, Binnui, and Kadmiel\f* \w along with their associates|strong="H00251"\w*, \w who stood across from them|strong="H05048"\w* \w to give praise|strong="H01984"\w* \w and thanksgiving|strong="H03034"\w* \w as one section|strong="H04929"\w* \w alternated with|strong="H05980"\w* \w the other|strong="H04929"\w*, \w as prescribed|strong="H04687"\w* \w by David|strong="H01732"\w* \w the man|strong="H00376"\w* \w of God|strong="H00430"\w*.
\p \v 25 \w Mattaniah|strong="H04983"\w*, \w Bakbukiah|strong="H01229"\w*, \w Obadiah|strong="H05662"\w*, \w Meshullam|strong="H04918"\w*, \w Talmon|strong="H02929"\w*, \w and Akkub|strong="H06126"\w* \w were gatekeepers|strong="H07778"\w* \w who guarded|strong="H08104"\w* \w the storerooms|strong="H00624"\w* \w at the gates|strong="H08179"\w*. \v 26 \w They served|strong="H00428"\w* \w in the days|strong="H03117"\w* \w of Joiakim|strong="H03113"\w* \w son|strong="H01121"\w* \w of Jeshua|strong="H03442"\w*, \w the son|strong="H01121"\w* \w of Jozadak|strong="H03136"\w*,\f + \fr 12:26 \fqa Jozadak \ft is a variant of \fqa Jehozadak\ft ; see 1 Chronicles 6:14.\f* \w and in the days|strong="H03117"\w* \w of Nehemiah|strong="H05166"\w* \w the governor|strong="H06346"\w* \w and Ezra|strong="H05830"\w* \w the priest|strong="H03548"\w* \w and scribe|strong="H05608"\w*.
\s1 The Dedication of the Wall
\p \v 27 \w At the dedication|strong="H02598"\w* \w of the wall|strong="H02346"\w* \w of Jerusalem|strong="H03389"\w*, \w the Levites|strong="H03881"\w* \w were sought out|strong="H01245"\w* \w from all|strong="H03605"\w* \w their homes|strong="H04725"\w* \w and brought|strong="H00935"\w* \w to Jerusalem|strong="H03389"\w* \w to celebrate|strong="H06213"\w* \w the joyous|strong="H08057"\w* \w dedication|strong="H02598"\w* \w with thanksgiving|strong="H08426"\w* \w and singing|strong="H07892"\w*, \w accompanied by cymbals|strong="H04700"\w*, \w harps|strong="H05035"\w*, \w and lyres|strong="H03658"\w*. \v 28 \w The singers were also|strong="H07891"\w* \w assembled|strong="H00622"\w* \w from|strong="H04480"\w* \w the region|strong="H03603"\w* \w around|strong="H05439"\w* \w Jerusalem|strong="H03389"\w*, \w from|strong="H04480"\w* \w the villages|strong="H02691"\w* \w of the Netophathites|strong="H05200"\w*, \v 29 \w from Beth-gilgal|strong="H01019"\w*, \w and from the fields|strong="H07704"\w* \w of Geba|strong="H01387"\w* \w and Azmaveth|strong="H05820"\w*, \w for|strong="H03588"\w* \w they|strong="H07891"\w* \w had built|strong="H01129"\w* \w villages|strong="H02691"\w* for themselves \w around|strong="H05439"\w* \w Jerusalem|strong="H03389"\w*. \v 30 \w After the priests|strong="H03548"\w* \w and Levites|strong="H03881"\w* \w had purified themselves|strong="H02891"\w*, \w they purified|strong="H02891"\w* \w the people|strong="H05971"\w*, \w the gates|strong="H08179"\w*, \w and the wall|strong="H02346"\w*.
\p \v 31 \w Then I brought the leaders|strong="H08269"\w* \w of Judah|strong="H03063"\w* \w up|strong="H05927"\w* \w on|strong="H05921"\w* \w the wall|strong="H02346"\w*, \w and I appointed|strong="H05975"\w* \w two|strong="H08147"\w* \w great|strong="H01419"\w* \w thanksgiving choirs|strong="H08426"\w*. \w One was to proceed|strong="H08418"\w* \w along the top|strong="H05921"\w* \w of the wall|strong="H02346"\w*\f + \fr 12:31 \ft Or \fqa alongside the wall\ft ; also in verse 38\f* \w to the right|strong="H03225"\w*, \w toward the Dung|strong="H00830"\w* \w Gate|strong="H08179"\w*. \v 32 \w Hoshaiah|strong="H01955"\w* \w and half|strong="H02677"\w* \w the leaders|strong="H08269"\w* \w of Judah|strong="H03063"\w* \w followed|strong="H01980"\w*, \v 33 \w along with Azariah|strong="H05838"\w*, \w Ezra|strong="H05830"\w*, \w Meshullam|strong="H04918"\w*, \v 34 \w Judah|strong="H03063"\w*, \w Benjamin|strong="H01144"\w*, \w Shemaiah|strong="H08098"\w*, \w Jeremiah|strong="H03414"\w*, \v 35 \w and some of the priests|strong="H03548"\w* \w with trumpets|strong="H02689"\w*, \w and also Zechariah|strong="H02148"\w* \w son|strong="H01121"\w* \w of Jonathan|strong="H03129"\w*, \w the son|strong="H01121"\w* \w of Shemaiah|strong="H08098"\w*, \w the son|strong="H01121"\w* \w of Mattaniah|strong="H04983"\w*, \w the son|strong="H01121"\w* \w of Micaiah|strong="H04320"\w*,\f + \fr 12:35 \fqa Micaiah \ft is a variant of \fqa Mica\ft ; see Nehemiah 11:22.\f* \w the son|strong="H01121"\w* \w of Zaccur|strong="H02139"\w*, \w the son|strong="H01121"\w* \w of Asaph|strong="H00623"\w*, \v 36 \w and his associates|strong="H00251"\w*— \w Shemaiah|strong="H08098"\w*, \w Azarel|strong="H05832"\w*, \w Milalai|strong="H04450"\w*, \w Gilalai|strong="H01562"\w*, \w Maai|strong="H04597"\w*, \w Nethanel|strong="H05417"\w*, \w Judah|strong="H03063"\w*, \w and Hanani|strong="H02607"\w*— \w with the musical|strong="H07892"\w* \w instruments|strong="H03627"\w* \w prescribed by David|strong="H01732"\w* \w the man|strong="H00376"\w* \w of God|strong="H00430"\w*. \w Ezra|strong="H05830"\w* \w the scribe|strong="H05608"\w* \w led the procession|strong="H06440"\w*. \v 37 \w At|strong="H05921"\w* \w the Fountain|strong="H05869"\w* \w Gate|strong="H08179"\w* \w they went directly up|strong="H05927"\w* \w the steps|strong="H04609"\w* \w of the City|strong="H05892"\w* \w of David|strong="H01732"\w* \w on the ascent|strong="H04608"\w* \w to the wall|strong="H02346"\w* \w and passed above|strong="H05921"\w* \w the house|strong="H01004"\w* \w of David|strong="H01732"\w* \w to|strong="H05704"\w* \w the Water|strong="H04325"\w* \w Gate|strong="H08179"\w* \w on the east|strong="H04217"\w*.
\p \v 38 \w The second|strong="H08145"\w* \w thanksgiving choir|strong="H08426"\w* \w proceeded|strong="H01980"\w* \w to the left|strong="H04136"\w*, \w and I|strong="H00589"\w* \w followed|strong="H00310"\w* \w it with half|strong="H02677"\w* \w the people|strong="H05971"\w* \w along the top|strong="H05921"\w* \w of the wall|strong="H02346"\w*, \w past|strong="H05921"\w* \w the Tower|strong="H04026"\w* \w of the Ovens|strong="H08574"\w* \w to|strong="H05704"\w* \w the Broad|strong="H07342"\w* \w Wall|strong="H02346"\w*, \v 39 \w over|strong="H05921"\w* \w the Gate|strong="H08179"\w* \w of Ephraim|strong="H00669"\w*, \w the Jeshanah|strong="H03466"\w* \w Gate|strong="H08179"\w*,\f + \fr 12:39 \ft Or \fqa the Old City Gate\f* \w the Fish|strong="H01709"\w* \w Gate|strong="H08179"\w*, \w the Tower|strong="H04026"\w* \w of Hananel|strong="H02606"\w*, \w and the Tower|strong="H04026"\w* \w of the Hundred|strong="H03968"\w*, \w as far|strong="H05704"\w* \w as the Sheep|strong="H06629"\w* \w Gate|strong="H08179"\w*. \w And they stopped|strong="H05975"\w* \w at the Gate|strong="H08179"\w* \w of the Guard|strong="H04307"\w*.
\p \v 40 \w The two|strong="H08147"\w* \w thanksgiving choirs|strong="H08426"\w* \w then stood|strong="H05975"\w* \w in the house|strong="H01004"\w* \w of God|strong="H00430"\w*, \w as did I|strong="H00589"\w*, \w along with the half|strong="H02677"\w* \w of the officials|strong="H05461"\w* \w accompanying me|strong="H05973"\w*, \v 41 \w as well as the priests|strong="H03548"\w* \w with their trumpets|strong="H02689"\w* — \w Eliakim|strong="H00471"\w*, \w Maaseiah|strong="H04641"\w*, \w Miniamin|strong="H04509"\w*, \w Micaiah|strong="H04320"\w*, \w Elioenai|strong="H00454"\w*, \w Zechariah|strong="H02148"\w*, \w and Hananiah|strong="H02608"\w* — \v 42 \w and also Maaseiah|strong="H04641"\w*, \w Shemaiah|strong="H08098"\w*, \w Eleazar|strong="H00499"\w*, \w Uzzi|strong="H05813"\w*, \w Jehohanan|strong="H03076"\w*, \w Malchijah|strong="H04441"\w*, \w Elam|strong="H05867"\w*, \w and Ezer|strong="H05829"\w*. \w Then the choirs|strong="H07891"\w* \w sang out|strong="H08085"\w* \w under the direction|strong="H06496"\w* \w of Jezrahiah|strong="H03156"\w*.
\p \v 43 \w On that|strong="H01931"\w* \w day|strong="H03117"\w* \w they offered|strong="H02076"\w* \w great|strong="H01419"\w* \w sacrifices|strong="H02077"\w*, \w rejoicing|strong="H08055"\w* \w because|strong="H03588"\w* \w God|strong="H00430"\w* \w had given them great|strong="H01419"\w* \w joy|strong="H08055"\w*. \w The women|strong="H00802"\w* \w and children|strong="H03206"\w* \w also|strong="H01571"\w* \w rejoiced|strong="H08055"\w*, \w so that the joy|strong="H08057"\w* \w of Jerusalem|strong="H03389"\w* \w was heard|strong="H08085"\w* \w from afar|strong="H07350"\w*.
\s1 Provisions for Temple Worship
\p \v 44 \w And on that same|strong="H01931"\w* \w day|strong="H03117"\w* \w men|strong="H00582"\w* \w were appointed|strong="H06485"\w* \w over|strong="H05921"\w* \w the rooms|strong="H05393"\w* \w that housed the supplies|strong="H00214"\w*, \w contributions|strong="H08641"\w*, \w firstfruits|strong="H07225"\w*, \w and tithes|strong="H04643"\w*. \w The portions specified by|strong="H04521"\w* \w the Law|strong="H08451"\w* \w for the priests|strong="H03548"\w* \w and Levites|strong="H03881"\w* \w were gathered|strong="H03664"\w* into these storerooms \w from the fields|strong="H07704"\w* \w of the villages|strong="H05892"\w*, \w because|strong="H03588"\w* \w Judah|strong="H03063"\w* \w rejoiced|strong="H08057"\w* \w over|strong="H05921"\w* \w the priests|strong="H03548"\w* \w and Levites|strong="H03881"\w* \w who were serving|strong="H05975"\w*.
\p \v 45 \w They performed|strong="H08104"\w* \w the service|strong="H04931"\w* \w of their God|strong="H00430"\w* \w and the service|strong="H04931"\w* \w of purification|strong="H02893"\w*, \w along with the singers|strong="H07891"\w* \w and gatekeepers|strong="H07778"\w*, \w as David|strong="H01732"\w* \w and his son|strong="H01121"\w* \w Solomon|strong="H08010"\w* \w had prescribed|strong="H04687"\w*. \v 46 \w For|strong="H03588"\w* \w long ago|strong="H06924"\w*, \w in the days|strong="H03117"\w* \w of David|strong="H01732"\w* \w and Asaph|strong="H00623"\w*, \w there were directors|strong="H07218"\w* \w for the singers|strong="H07891"\w* \w and for the songs|strong="H07892"\w* \w of praise|strong="H08416"\w* \w and thanksgiving|strong="H03034"\w* \w to God|strong="H00430"\w*.
\p \v 47 \w So in the days|strong="H03117"\w* \w of Zerubbabel|strong="H02216"\w* \w and|strong="H03117"\w* \w Nehemiah|strong="H05166"\w*, \w all|strong="H03605"\w* \w Israel|strong="H03478"\w* \w contributed|strong="H05414"\w* \w the daily portions|strong="H04521"\w* \w for the singers|strong="H07891"\w* \w and gatekeepers|strong="H07778"\w*. \w They also set aside|strong="H06942"\w* \w daily|strong="H03117"\w* \w portions|strong="H01697"\w* \w for the Levites|strong="H03881"\w*, \w and the Levites|strong="H03881"\w* \w set aside|strong="H06942"\w* \w daily portions for the descendants|strong="H01121"\w* \w of Aaron|strong="H00175"\w*.
\c 13
\s1 Foreigners Excluded
\p \v 1 \w At that|strong="H01931"\w* \w time|strong="H03117"\w* \w the Book|strong="H05612"\w* \w of Moses|strong="H04872"\w* \w was read aloud|strong="H07121"\w* \w in the hearing|strong="H00241"\w* \w of the people|strong="H05971"\w*, and in it \w they found|strong="H04672"\w* \w the passage stating|strong="H03789"\w* \w that|strong="H00834"\w* \w no|strong="H03808"\w* \w Ammonite|strong="H05984"\w* \w or Moabite|strong="H04125"\w* \w should ever|strong="H05704"\w* \w enter|strong="H00935"\w* \w the assembly|strong="H06951"\w* \w of God|strong="H00430"\w*,\f + \fr 13:1 \ft See Deuteronomy 23:3–6.\f* \v 2 \w because|strong="H03588"\w* \w they had not|strong="H03808"\w* \w met|strong="H06923"\w* \w the Israelites|strong="H01121"\w* \w with food|strong="H03899"\w* \w and water|strong="H04325"\w*, \w but had hired|strong="H07936"\w* \w Balaam|strong="H01109"\w* \w to call down a curse|strong="H07043"\w* \w against them|strong="H05921"\w* (\w although our God|strong="H00430"\w* \w had turned|strong="H02015"\w* \w the curse|strong="H07045"\w* \w into a blessing|strong="H01293"\w*).
\p \v 3 \w As soon as|strong="H01961"\w* \w the people heard|strong="H08085"\w* \w this law|strong="H08451"\w*, \w they excluded|strong="H00914"\w* \w from Israel|strong="H03478"\w* \w all|strong="H03605"\w* \w of foreign descent|strong="H06154"\w*.
\s1 The Temple Cleansed
\p \v 4 \w Now before|strong="H06440"\w* \w this|strong="H02088"\w*, \w Eliashib|strong="H00475"\w* \w the priest|strong="H03548"\w*, \w a relative|strong="H07138"\w* \w of Tobiah|strong="H02900"\w*, \w had been put in charge of|strong="H05414"\w* \w the storerooms|strong="H03957"\w* \w of the house|strong="H01004"\w* \w of our God|strong="H00430"\w* \v 5 \w and had prepared|strong="H06213"\w* for Tobiah \w a large|strong="H01419"\w* \w room|strong="H03957"\w* \w where|strong="H08033"\w* \w they had previously|strong="H06440"\w* \w stored|strong="H05414"\w* \w the grain offerings|strong="H04503"\w*, \w the frankincense|strong="H03828"\w*, \w the temple articles|strong="H03627"\w*, \w and the tithes|strong="H04643"\w* \w of grain|strong="H01715"\w*, \w new wine|strong="H08492"\w*, \w and oil|strong="H03323"\w* \w prescribed|strong="H04687"\w* \w for the Levites|strong="H03881"\w*, \w singers|strong="H07891"\w*, \w and gatekeepers|strong="H07778"\w*, \w along with the contributions|strong="H08641"\w* \w for the priests|strong="H03548"\w*.
\p \v 6 \w While all|strong="H03605"\w* \w this|strong="H02088"\w* \w was happening|strong="H01961"\w*, \w I was not|strong="H03808"\w* \w in Jerusalem|strong="H03389"\w*, \w because|strong="H03588"\w* \w I had returned|strong="H00935"\w* \w to|strong="H00413"\w* \w Artaxerxes|strong="H00783"\w* \w king|strong="H04428"\w* \w of Babylon|strong="H00894"\w*\f + \fr 13:6 \ft Artaxerxes king of Persia is identified here as the king of Babylon because Persia had conquered the Babylonian Empire.\f* \w in the thirty-second|strong="H07970"\w* \w year|strong="H08141"\w* \w of his reign|strong="H04428"\w*. \w Some time later|strong="H07093"\w* \w I obtained leave|strong="H07592"\w* \w from|strong="H04480"\w* \w the king|strong="H04428"\w* \v 7 \w to return|strong="H00935"\w* \w to Jerusalem|strong="H03389"\w*. \w Then I discovered|strong="H00995"\w* \w the evil|strong="H07451"\w* \w that|strong="H00834"\w* \w Eliashib|strong="H00475"\w* \w had done|strong="H06213"\w* \w on behalf of Tobiah|strong="H02900"\w* \w by providing|strong="H06213"\w* him \w a room|strong="H05393"\w* \w in the courts|strong="H02691"\w* \w of the house|strong="H01004"\w* \w of God|strong="H00430"\w*.
\p \v 8 \w And I was greatly|strong="H03966"\w* \w displeased|strong="H07489"\w* \w and threw|strong="H07993"\w* \w all|strong="H03605"\w* \w of Tobiah’s|strong="H02900"\w* \w household|strong="H01004"\w* \w goods|strong="H03627"\w* \w out|strong="H02351"\w* \w of|strong="H04480"\w* \w the room|strong="H03957"\w*. \v 9 \w Then I ordered|strong="H00559"\w* \w that the rooms|strong="H03957"\w* \w be purified|strong="H02891"\w*, \w and I had the articles|strong="H03627"\w* \w of the house|strong="H01004"\w* \w of God|strong="H00430"\w* \w restored|strong="H07725"\w* \w to them|strong="H08033"\w*, \w along with the grain offerings|strong="H04503"\w* \w and frankincense|strong="H03828"\w*.
\s1 Tithes Restored
\p \v 10 \w I also learned|strong="H03045"\w* \w that|strong="H03588"\w* \w because the portions|strong="H04521"\w* \w for the Levites|strong="H03881"\w* \w had not|strong="H03808"\w* \w been given to them|strong="H05414"\w*, \w all|strong="H00376"\w* \w the Levites|strong="H03881"\w* \w and singers|strong="H07891"\w* \w responsible for performing|strong="H06213"\w* \w the service|strong="H04399"\w* \w had gone back|strong="H01272"\w* \w to their own fields|strong="H07704"\w*. \v 11 \w So I rebuked|strong="H07378"\w* \w the officials|strong="H05461"\w* \w and asked|strong="H00559"\w*, “\w Why|strong="H04069"\w* \w has the house|strong="H01004"\w* \w of God|strong="H00430"\w* \w been neglected|strong="H05800"\w*?”
\p \w Then I gathered the Levites and singers together|strong="H06908"\w* \w and stationed them|strong="H05975"\w* \w at|strong="H05921"\w* \w their posts|strong="H05977"\w*, \v 12 \w and all|strong="H03605"\w* \w Judah|strong="H03063"\w* \w brought|strong="H00935"\w* \w a tenth|strong="H04643"\w* \w of the grain|strong="H01715"\w*, \w new wine|strong="H08492"\w*, \w and oil|strong="H03323"\w* \w into the storerooms|strong="H00214"\w*. \v 13 \w I appointed as treasurers|strong="H00686"\w* \w over|strong="H05921"\w* \w the storerooms|strong="H00214"\w* \w Shelemiah|strong="H08018"\w* \w the priest|strong="H03548"\w*, \w Zadok|strong="H06659"\w* \w the scribe|strong="H05608"\w*, \w and Pedaiah|strong="H06305"\w* \w of|strong="H04480"\w* \w the Levites|strong="H03881"\w*, \w with Hanan|strong="H02605"\w* \w son|strong="H01121"\w* \w of Zaccur|strong="H02139"\w*, \w the son|strong="H01121"\w* \w of Mattaniah|strong="H04983"\w*, \w to assist|strong="H05921"\w* \w them|strong="H03027"\w*, \w because|strong="H03588"\w* \w they were considered|strong="H02803"\w* \w trustworthy|strong="H00539"\w*. \w They were responsible for|strong="H05921"\w* \w distributing the supplies|strong="H02505"\w* \w to their fellow Levites|strong="H00251"\w*.
\p \v 14 \w Remember|strong="H02142"\w* me \w for|strong="H05921"\w* \w this|strong="H02063"\w*, \w O my God|strong="H00430"\w*, \w and do not|strong="H00408"\w* \w blot out|strong="H04229"\w* \w my deeds of loving devotion|strong="H02617"\w* \w for the house|strong="H01004"\w* \w of my God|strong="H00430"\w* \w and for its services|strong="H04929"\w*.
\s1 The Sabbath Restored
\p \v 15 \w In those|strong="H01992"\w* \w days|strong="H03117"\w* \w I saw|strong="H07200"\w* \w people in Judah|strong="H03063"\w* \w treading|strong="H01869"\w* \w winepresses|strong="H01660"\w* \w on the Sabbath|strong="H07676"\w* \w and bringing in|strong="H00935"\w* \w grain|strong="H06194"\w* \w and loading it|strong="H06006"\w* \w on|strong="H05921"\w* \w donkeys|strong="H02543"\w*, \w along with|strong="H00637"\w* \w wine|strong="H03196"\w*, \w grapes|strong="H06025"\w*, \w and figs|strong="H08384"\w*. \w All kinds|strong="H03605"\w* \w of goods|strong="H04853"\w* \w were being brought|strong="H00935"\w* \w into Jerusalem|strong="H03389"\w* \w on the Sabbath|strong="H07676"\w* \w day|strong="H03117"\w*. \w So I warned them|strong="H05749"\w* \w against selling|strong="H04376"\w* \w food|strong="H06718"\w* \w on that day|strong="H03117"\w*. \v 16 \w Additionally, men of Tyre|strong="H06876"\w* \w who lived|strong="H03427"\w* there \w were importing|strong="H00935"\w* \w fish|strong="H01709"\w* \w and all kinds|strong="H03605"\w* \w of merchandise|strong="H04377"\w* \w and selling them|strong="H04376"\w* \w on the Sabbath|strong="H07676"\w* \w to the people|strong="H01121"\w* \w of Judah|strong="H03063"\w* \w in Jerusalem|strong="H03389"\w*.
\p \v 17 \w Then I rebuked|strong="H07378"\w* \w the nobles|strong="H02715"\w* \w of Judah|strong="H03063"\w* \w and asked|strong="H00559"\w*, “\w What|strong="H04100"\w* \w is this|strong="H02088"\w* \w evil|strong="H07451"\w* \w you|strong="H00859"\w* \w are doing|strong="H06213"\w*— \w profaning|strong="H02490"\w* \w the Sabbath|strong="H07676"\w* \w day|strong="H03117"\w*? \v 18 \w Did not|strong="H03808"\w* \w your forefathers|strong="H00001"\w* \w do|strong="H06213"\w* \w the same things|strong="H03541"\w*, \w so that our God|strong="H00430"\w* \w brought|strong="H00935"\w* \w all|strong="H03605"\w* \w this|strong="H02063"\w* \w disaster|strong="H07451"\w* \w on us|strong="H05921"\w* \w and on|strong="H05921"\w* \w this|strong="H02063"\w* \w city|strong="H05892"\w*? \w And now|strong="H00859"\w* \w you are rekindling|strong="H03254"\w* \w His wrath|strong="H02740"\w* \w against|strong="H05921"\w* \w Israel|strong="H03478"\w* \w by profaning|strong="H02490"\w* \w the Sabbath|strong="H07676"\w*!”
\p \v 19 \w When|strong="H00834"\w* \w the evening shadows|strong="H06751"\w* \w began to fall on the gates|strong="H08179"\w* \w of Jerusalem|strong="H03389"\w*, \w just before|strong="H06440"\w* \w the Sabbath|strong="H07676"\w*, \w I ordered|strong="H00559"\w* \w that the gates|strong="H01817"\w* \w be shut|strong="H05462"\w* \w and not|strong="H03808"\w* \w opened|strong="H06605"\w* \w until|strong="H05704"\w* \w after|strong="H00310"\w* \w the Sabbath|strong="H07676"\w*. \w I posted|strong="H05975"\w* \w some of my servants|strong="H05288"\w* \w at|strong="H05921"\w* \w the gates|strong="H08179"\w* \w so that no|strong="H03808"\w* \w load|strong="H04853"\w* \w could enter|strong="H00935"\w* \w on the Sabbath|strong="H07676"\w* \w day|strong="H03117"\w*.
\p \v 20 \w Once|strong="H06471"\w* \w or twice|strong="H08147"\w*, \w the merchants|strong="H07402"\w* \w and those who sell|strong="H04376"\w* \w all kinds|strong="H03605"\w* \w of goods|strong="H04465"\w* \w camped|strong="H03885"\w* \w outside|strong="H02351"\w* \w Jerusalem|strong="H03389"\w*, \v 21 \w but I warned|strong="H05749"\w* them, “\w Why|strong="H04069"\w* \w are you|strong="H00859"\w* \w camping|strong="H03885"\w* \w in front of|strong="H05048"\w* \w the wall|strong="H02346"\w*? \w If|strong="H00518"\w* \w you do it again|strong="H08138"\w*, \w I will lay|strong="H07971"\w* \w hands|strong="H03027"\w* on you.” \w From|strong="H04480"\w* \w that|strong="H01931"\w* \w time on|strong="H06256"\w*, \w they did not|strong="H03808"\w* \w return|strong="H00935"\w* \w on the Sabbath|strong="H07676"\w*. \v 22 \w Then I instructed|strong="H00559"\w* \w the Levites|strong="H03881"\w* \w to purify themselves|strong="H02891"\w* \w and guard|strong="H08104"\w* \w the gates|strong="H08179"\w* \w in order to keep the Sabbath|strong="H07676"\w* \w day|strong="H03117"\w* \w holy|strong="H06942"\w*.
\p \w Remember|strong="H02142"\w* me \w for this|strong="H02063"\w* \w as well|strong="H01571"\w*, \w O my God|strong="H00430"\w*, \w and show me|strong="H05921"\w* \w mercy|strong="H02347"\w* \w according to Your abundant|strong="H07230"\w* \w loving devotion|strong="H02617"\w*.
\s1 Intermarriage Forbidden
\p \v 23 \w In those|strong="H01992"\w* \w days|strong="H03117"\w* \w I also|strong="H01571"\w* \w saw|strong="H07200"\w* \w Jews|strong="H03064"\w* \w who had married|strong="H03427"\w* \w women|strong="H00802"\w* \w from Ashdod|strong="H00796"\w*, \w Ammon|strong="H05984"\w*, \w and Moab|strong="H04125"\w*. \v 24 \w Half|strong="H02677"\w* \w of their children|strong="H01121"\w* \w spoke|strong="H01696"\w* \w the language of Ashdod|strong="H00797"\w* \w or of|strong="H03956"\w* \w the other peoples|strong="H05971"\w*, \w but could|strong="H05234"\w* \w not|strong="H00369"\w* \w speak|strong="H01696"\w* \w the language of Judah|strong="H03066"\w*. \v 25 \w I rebuked them|strong="H07378"\w* \w and called down curses on them|strong="H07043"\w*. \w I beat|strong="H05221"\w* some of \w these men|strong="H00582"\w* \w and pulled out their hair|strong="H04803"\w*.
\p \w Then I made them take an oath|strong="H07650"\w* \w before God and said|strong="H00430"\w*, “\w You must not|strong="H00518"\w* \w give your daughters|strong="H01323"\w* \w in marriage|strong="H05414"\w* \w to their sons|strong="H01121"\w* \w or take|strong="H05375"\w* \w their daughters|strong="H01323"\w* \w as wives for your sons|strong="H01121"\w* or for yourselves! \v 26 \w Did not|strong="H03808"\w* \w King|strong="H04428"\w* \w Solomon|strong="H08010"\w* \w of Israel|strong="H03478"\w* \w sin|strong="H02398"\w* \w in|strong="H05921"\w* \w matters like this|strong="H00428"\w*? \w There was|strong="H01961"\w* \w not|strong="H03808"\w* \w a king|strong="H04428"\w* \w like him|strong="H03644"\w* \w among many|strong="H07227"\w* \w nations|strong="H01471"\w*, \w and he was|strong="H01961"\w* \w loved|strong="H00157"\w* \w by his God|strong="H00430"\w*, \w who|strong="H00430"\w* \w made him|strong="H05414"\w* \w king|strong="H04428"\w* \w over|strong="H05921"\w* \w all|strong="H03605"\w* \w Israel|strong="H03478"\w*— \w yet|strong="H01571"\w* \w foreign|strong="H05237"\w* \w women|strong="H00802"\w* \w drew him into sin|strong="H02398"\w*. \v 27 \w Must we now hear|strong="H08085"\w* \w that you too are doing|strong="H06213"\w* \w all|strong="H03605"\w* \w this|strong="H02063"\w* \w terrible|strong="H01419"\w* \w evil|strong="H07451"\w* \w and acting unfaithfully|strong="H04603"\w* \w against our God|strong="H00430"\w* \w by marrying|strong="H03427"\w* \w foreign|strong="H05237"\w* \w women|strong="H00802"\w*?”
\p \v 28 \w Even one of the sons|strong="H01121"\w* \w of Jehoiada|strong="H03111"\w* \w son|strong="H01121"\w* \w of Eliashib|strong="H00475"\w* \w the high|strong="H01419"\w* \w priest|strong="H03548"\w* \w had become a son-in-law|strong="H02860"\w* \w to Sanballat|strong="H05571"\w* \w the Horonite|strong="H02772"\w*. \w Therefore I drove him away|strong="H01272"\w* \w from me|strong="H05921"\w*.
\p \v 29 \w Remember|strong="H02142"\w* them, \w O my God|strong="H00430"\w*, \w because|strong="H05921"\w* \w they have defiled|strong="H01352"\w* \w the priesthood|strong="H03550"\w* \w and the covenant|strong="H01285"\w* \w of the priesthood|strong="H03550"\w* \w and of the Levites|strong="H03881"\w*.
\p \v 30 \w Thus I purified the priests and Levites|strong="H02891"\w* \w from everything|strong="H03605"\w* \w foreign|strong="H05236"\w*, \w and I assigned|strong="H05975"\w* \w specific|strong="H04399"\w* \w duties|strong="H04931"\w* \w to each|strong="H00376"\w* \w of the priests|strong="H03548"\w* \w and Levites|strong="H03881"\w*. \v 31 \w I also arranged for contributions|strong="H07133"\w* \w of wood|strong="H06086"\w* \w at the appointed|strong="H02163"\w* \w times|strong="H06256"\w*, \w and for the firstfruits|strong="H01061"\w*.
\p \w Remember|strong="H02142"\w* me, \w O my God|strong="H00430"\w*, \w with favor|strong="H02896"\w*.
