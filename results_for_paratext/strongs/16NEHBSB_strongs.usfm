\p \v 19 \w But when Sanballat|strong="H05571"\w* \w the Horonite|strong="H02772"\w*, \w Tobiah|strong="H02900"\w* \w the Ammonite|strong="H05984"\w* \w official|strong="H05650"\w*, \w and Geshem|strong="H01654"\w* \w the Arab|strong="H06163"\w* \w heard about this|strong="H08085"\w*, \w they mocked|strong="H03932"\w* us \w and ridiculed|strong="H00959"\w* \w us|strong="H05921"\w*, \w saying|strong="H00559"\w*, “\w What|strong="H04100"\w* \w is this|strong="H02088"\w* \w you are|strong="H00859"\w* \w doing|strong="H06213"\w*? \w Are you|strong="H00859"\w* \w rebelling|strong="H04775"\w* \w against|strong="H05921"\w* \w the king|strong="H04428"\w*?”
\p \v 20 \w So I answered|strong="H07725"\w* \w them|strong="H00853"\w* \w and said|strong="H00559"\w*, “\w The God|strong="H00430"\w* \w of heaven|strong="H08064"\w* \w is the One|strong="H01931"\w* \w who will grant us success|strong="H06743"\w*. \w We|strong="H00587"\w*, \w His servants|strong="H05650"\w*, \w will start|strong="H06965"\w* \w rebuilding|strong="H01129"\w*, but you \w have no|strong="H00369"\w* \w portion|strong="H02506"\w*, \w right|strong="H06666"\w*, \w or claim|strong="H02146"\w* \w in Jerusalem|strong="H03389"\w*.”
\c 3
\s1 The Builders of the Walls
\p \v 1 \w At the Sheep|strong="H06629"\w* \w Gate|strong="H08179"\w*, \w Eliashib|strong="H00475"\w* \w the high|strong="H01419"\w* \w priest|strong="H03548"\w* \w and his fellow|strong="H00251"\w* \w priests|strong="H03548"\w* \w began|strong="H06965"\w* \w rebuilding|strong="H01129"\w*. \w They|strong="H01992"\w* \w dedicated it|strong="H06942"\w* \w and installed|strong="H05975"\w* \w its doors|strong="H01817"\w*. \w After building as far as|strong="H05704"\w* \w the Tower|strong="H04026"\w* \w of the Hundred|strong="H03968"\w* \w and the Tower|strong="H04026"\w* \w of Hananel|strong="H02606"\w*, \w they dedicated the wall|strong="H06942"\w*. \v 2 \w The men of Jericho|strong="H03405"\w* \w built|strong="H01129"\w* \w next to|strong="H05921"\w* \w Eliashib|strong="H03027"\w*, \w and Zaccur|strong="H02139"\w* \w son|strong="H01121"\w* \w of Imri|strong="H00566"\w* \w built|strong="H01129"\w* \w next|strong="H05921"\w* \w to them|strong="H03027"\w*.
\p \v 3 \w The Fish|strong="H01709"\w* \w Gate|strong="H08179"\w* \w was rebuilt|strong="H01129"\w* \w by the sons|strong="H01121"\w* \w of Hassenaah|strong="H05570"\w*. \w They|strong="H01992"\w* \w laid its beams|strong="H07136"\w* \w and installed|strong="H05975"\w* \w its doors|strong="H01817"\w*, \w bolts|strong="H04514"\w*, \w and bars|strong="H01280"\w*. \v 4 \w Next|strong="H05921"\w* \w to them|strong="H03027"\w*, \w Meremoth|strong="H04822"\w* \w son|strong="H01121"\w* \w of Uriah|strong="H00223"\w*, \w the son|strong="H01121"\w* \w of Hakkoz|strong="H06976"\w*, \w made repairs|strong="H02388"\w*. \w Next|strong="H05921"\w* \w to him|strong="H03027"\w*, \w Meshullam|strong="H04918"\w* \w son|strong="H01121"\w* \w of Berechiah|strong="H01296"\w*, \w the son|strong="H01121"\w* \w of Meshezabel|strong="H04898"\w*, \w made repairs|strong="H02388"\w*; \w and next|strong="H05921"\w* \w to him|strong="H03027"\w*, \w Zadok|strong="H06659"\w* \w son|strong="H01121"\w* \w of Baana|strong="H01195"\w* \w made repairs as well|strong="H02388"\w*. \v 5 \w Next|strong="H05921"\w* \w to him|strong="H03027"\w*, \w the Tekoites|strong="H08621"\w* \w made repairs|strong="H02388"\w*, \w but their nobles|strong="H00117"\w* \w did not|strong="H03808"\w* \w put|strong="H00935"\w* \w their shoulders|strong="H06677"\w* \w to the work|strong="H05656"\w* \w under their supervisors|strong="H00113"\w*.\f + \fr 3:5 \ft Or \fqa their Lord \ft or \fqa the governor\f*
\p \v 6 \w The Jeshanah|strong="H03465"\w* \w Gate|strong="H08179"\w*\f + \fr 3:6 \ft Or \fqa The Old City Gate\f* \w was repaired|strong="H02388"\w* \w by Joiada|strong="H03111"\w* \w son|strong="H01121"\w* \w of Paseah|strong="H06454"\w* \w and Meshullam|strong="H04918"\w* \w son|strong="H01121"\w* \w of Besodeiah|strong="H01152"\w*. \w They|strong="H01992"\w* \w laid its beams|strong="H07136"\w* \w and installed|strong="H05975"\w* \w its doors|strong="H01817"\w*, \w bolts|strong="H04514"\w*, \w and bars|strong="H01280"\w*. \v 7 \w Next|strong="H05921"\w* \w to them|strong="H03027"\w*, \w repairs were made|strong="H02388"\w* \w by Melatiah|strong="H04424"\w* \w the Gibeonite|strong="H01393"\w*, \w Jadon|strong="H03036"\w* \w the Meronothite|strong="H04824"\w*, \w and the men|strong="H00582"\w* \w of Gibeon|strong="H01391"\w* \w and Mizpah|strong="H04709"\w*, \w who were under the authority|strong="H03678"\w* \w of the governor|strong="H06346"\w* \w of the region west|strong="H05676"\w* \w of the Euphrates|strong="H05104"\w*.\f + \fr 3:7 \ft Hebrew \fqa the governor beyond the River\f* \v 8 \w Next|strong="H05921"\w* \w to them|strong="H03027"\w*, \w Uzziel|strong="H05816"\w* \w son|strong="H01121"\w* \w of Harhaiah|strong="H02736"\w*, \w one of the goldsmiths|strong="H06884"\w*, \w made repairs|strong="H02388"\w*. \w And next|strong="H05921"\w* \w to him|strong="H03027"\w*, \w Hananiah|strong="H02608"\w*, \w one|strong="H01121"\w* \w of the perfumers|strong="H07546"\w*, \w made repairs|strong="H02388"\w*. \w They fortified|strong="H05800"\w* \w Jerusalem|strong="H03389"\w* \w as|strong="H05704"\w* \w far as the Broad|strong="H07342"\w* \w Wall|strong="H02346"\w*.
\p \v 9 \w Next|strong="H05921"\w* \w to them|strong="H03027"\w*, \w Rephaiah|strong="H07509"\w* \w son|strong="H01121"\w* \w of Hur|strong="H02354"\w*, \w ruler|strong="H08269"\w* \w of a half-district|strong="H02677"\w* \w of Jerusalem|strong="H03389"\w*, \w made repairs|strong="H02388"\w*; \v 10 \w next|strong="H05921"\w* \w to him|strong="H03027"\w*, \w Jedaiah|strong="H03042"\w* \w son|strong="H01121"\w* \w of Harumaph|strong="H02739"\w* \w made repairs|strong="H02388"\w* \w across from|strong="H05048"\w* \w his house|strong="H01004"\w*; \w and next|strong="H05921"\w* \w to him|strong="H03027"\w*, \w Hattush|strong="H02407"\w* \w son|strong="H01121"\w* \w of Hashabneiah|strong="H02813"\w* \w made repairs|strong="H02388"\w*. \v 11 \w Malchijah|strong="H04441"\w* \w son|strong="H01121"\w* \w of Harim|strong="H02766"\w* \w and Hasshub|strong="H02815"\w* \w son|strong="H01121"\w* \w of Pahath-moab|strong="H06355"\w* \w repaired|strong="H02388"\w* \w another|strong="H08145"\w* \w section|strong="H04060"\w*, \w as well as the Tower|strong="H04026"\w* \w of the Ovens|strong="H08574"\w*. \v 12 \w And next|strong="H05921"\w* \w to them|strong="H03027"\w*, \w Shallum|strong="H07967"\w* \w son|strong="H01121"\w* \w of Hallohesh|strong="H03873"\w*, \w ruler|strong="H08269"\w* \w of the other half-district|strong="H02677"\w* \w of Jerusalem|strong="H03389"\w*, \w made repairs|strong="H02388"\w*, \w with the help of|strong="H01931"\w* \w his daughters|strong="H01323"\w*.
\p \v 13 \w The Valley|strong="H01516"\w* \w Gate|strong="H08179"\w* \w was repaired|strong="H02388"\w* \w by Hanun|strong="H02586"\w* \w and the residents|strong="H03427"\w* \w of Zanoah|strong="H02182"\w*. \w They|strong="H01992"\w* \w rebuilt it|strong="H01129"\w*, \w installed|strong="H05975"\w* \w its doors|strong="H01817"\w*, \w bolts|strong="H04514"\w*, \w and bars|strong="H01280"\w*, \w and repaired a thousand|strong="H00505"\w* \w cubits|strong="H00520"\w*\f + \fr 3:13 \fqa 1,000 cubits \ft is approximately 1,500 feet or 457.2 meters.\f* \w of the wall|strong="H02346"\w* \w as far as|strong="H05704"\w* \w the Dung|strong="H00830"\w* \w Gate|strong="H08179"\w*.
\p \v 14 \w The Dung|strong="H00830"\w* \w Gate|strong="H08179"\w* \w was repaired|strong="H02388"\w* \w by Malchijah|strong="H04441"\w* \w son|strong="H01121"\w* \w of Rechab|strong="H07394"\w*, \w ruler|strong="H08269"\w* \w of the district|strong="H06418"\w* \w of Beth-haccherem|strong="H01021"\w*. \w He|strong="H01931"\w* \w rebuilt it|strong="H01129"\w* \w and installed|strong="H05975"\w* \w its doors|strong="H01817"\w*, \w bolts|strong="H04514"\w*, \w and bars|strong="H01280"\w*.
\p \v 15 \w The Fountain|strong="H05869"\w* \w Gate|strong="H08179"\w* \w was repaired|strong="H02388"\w* \w by Shallun|strong="H07968"\w*\f + \fr 3:15 \ft Hebrew; Syriac \fqa Shallum\f* \w son|strong="H01121"\w* \w of Col-hozeh|strong="H03626"\w*, \w ruler|strong="H08269"\w* \w of the district|strong="H06418"\w* \w of Mizpah|strong="H04709"\w*. \w He|strong="H01931"\w* \w rebuilt it|strong="H01129"\w*, \w roofed it|strong="H02926"\w*, \w and installed|strong="H05975"\w* \w its doors|strong="H01817"\w*, \w bolts|strong="H04514"\w*, \w and bars|strong="H01280"\w*. \w He also repaired the wall|strong="H02346"\w* \w of the Pool|strong="H01295"\w* \w of Shelah|strong="H07975"\w*\f + \fr 3:15 \fqa Pool of Shelah \ft is another name for the Pool of Siloam.\f* \w near the king’s|strong="H04428"\w* \w garden|strong="H01588"\w*, \w as|strong="H05704"\w* \w far as the stairs|strong="H04609"\w* \w that descend|strong="H03381"\w* \w from the City|strong="H05892"\w* \w of David|strong="H01732"\w*.
\p \v 16 \w Beyond him|strong="H00310"\w*, \w Nehemiah|strong="H05166"\w* \w son|strong="H01121"\w* \w of Azbuk|strong="H05802"\w*, \w ruler|strong="H08269"\w* \w of a half-district|strong="H02677"\w* \w of Beth-zur|strong="H01049"\w*, \w made repairs|strong="H02388"\w* \w up to|strong="H05704"\w* \w a point opposite|strong="H05048"\w* \w the tombs|strong="H06913"\w* \w of David|strong="H01732"\w*, \w as|strong="H05704"\w* \w far as the artificial|strong="H06213"\w* \w pool|strong="H01295"\w* \w and the House|strong="H01004"\w* \w of the Mighty|strong="H01368"\w*.
\p \v 17 \w Next to him|strong="H00310"\w*, \w the Levites|strong="H03881"\w* \w made repairs|strong="H02388"\w* \w under Rehum|strong="H07348"\w* \w son|strong="H01121"\w* \w of Bani|strong="H01137"\w*, \w and next|strong="H05921"\w* \w to him|strong="H03027"\w*, \w Hashabiah|strong="H02811"\w*, \w ruler|strong="H08269"\w* \w of a half-district|strong="H02677"\w* \w of Keilah|strong="H07084"\w*, \w made repairs|strong="H02388"\w* \w for his district|strong="H06418"\w*. \v 18 \w Next to him|strong="H00310"\w*, \w their countrymen|strong="H00251"\w* \w made repairs|strong="H02388"\w* \w under Binnui|strong="H00942"\w*\f + \fr 3:18 \ft Two Hebrew manuscripts and Syriac (see also LXX and Nehemiah 3:24); most Hebrew manuscripts \fqa Bavvai\f* \w son|strong="H01121"\w* \w of Henadad|strong="H02582"\w*, \w ruler|strong="H08269"\w* \w of the other half-district|strong="H02677"\w* \w of Keilah|strong="H07084"\w*. \v 19 \w And next to|strong="H05921"\w* \w him|strong="H03027"\w*, \w Ezer|strong="H05829"\w* \w son|strong="H01121"\w* \w of Jeshua|strong="H03442"\w*, \w ruler|strong="H08269"\w* \w of Mizpah|strong="H04709"\w*, \w repaired|strong="H02388"\w* \w another|strong="H08145"\w* \w section|strong="H04060"\w* \w opposite|strong="H05048"\w* \w the ascent|strong="H05927"\w* \w to the armory|strong="H05402"\w*, \w near the angle in the wall|strong="H04740"\w*.
\p \v 20 \w Next to him|strong="H00310"\w*, \w Baruch|strong="H01263"\w* \w son|strong="H01121"\w* \w of Zabbai|strong="H02079"\w* \w diligently|strong="H02734"\w* \w repaired|strong="H02388"\w* \w another|strong="H08145"\w* \w section|strong="H04060"\w*, \w from|strong="H04480"\w* \w the angle|strong="H04740"\w* \w to|strong="H05704"\w* \w the doorway|strong="H06607"\w* \w of the house|strong="H01004"\w* \w of Eliashib|strong="H00475"\w* \w the high|strong="H01419"\w* \w priest|strong="H03548"\w*. \v 21 \w Next to him|strong="H00310"\w*, \w Meremoth|strong="H04822"\w* \w son|strong="H01121"\w* \w of Uriah|strong="H00223"\w*, \w the son|strong="H01121"\w* \w of Hakkoz|strong="H06976"\w*, \w repaired|strong="H02388"\w* \w another|strong="H08145"\w* \w section|strong="H04060"\w*, \w from the doorway|strong="H06607"\w* \w of the house|strong="H01004"\w* \w of Eliashib|strong="H00475"\w* \w to|strong="H05704"\w* \w the end|strong="H08503"\w* \w of the house|strong="H01004"\w*. \v 22 \w And next to him|strong="H00310"\w*, \w the priests|strong="H03548"\w* \w from the surrounding area|strong="H03603"\w* \w made repairs|strong="H02388"\w*.
\p \v 23 \w Beyond them|strong="H00310"\w*, \w Benjamin|strong="H01144"\w* \w and Hasshub|strong="H02815"\w* \w made repairs|strong="H02388"\w* \w in front|strong="H05048"\w* \w of their house|strong="H01004"\w*, \w and next to them|strong="H00310"\w*, \w Azariah|strong="H05838"\w* \w son|strong="H01121"\w* \w of Maaseiah|strong="H04641"\w*, \w the son|strong="H01121"\w* \w of Ananiah|strong="H06055"\w*, \w made repairs|strong="H02388"\w* \w beside|strong="H00681"\w* \w his house|strong="H01004"\w*. \v 24 \w After him|strong="H00310"\w*, \w Binnui|strong="H01131"\w* \w son|strong="H01121"\w* \w of Henadad|strong="H02582"\w* \w repaired|strong="H02388"\w* \w another|strong="H08145"\w* \w section|strong="H04060"\w*, \w from the house|strong="H01004"\w* \w of Azariah|strong="H05838"\w* \w to|strong="H05704"\w* \w the angle|strong="H04740"\w* \w and the corner|strong="H06438"\w*, \v 25 \w and Palal|strong="H06420"\w* \w son|strong="H01121"\w* \w of Uzai|strong="H00186"\w* \w made repairs opposite|strong="H05048"\w* \w the angle|strong="H04740"\w* \w and the tower|strong="H04026"\w* \w that juts out|strong="H03318"\w* \w from the upper|strong="H05945"\w* \w palace|strong="H01004"\w* \w of the king|strong="H04428"\w* \w near the courtyard|strong="H02691"\w* \w of the guard|strong="H04307"\w*. \w Next to him|strong="H00310"\w*, \w Pedaiah|strong="H06305"\w* \w son|strong="H01121"\w* \w of Parosh|strong="H06551"\w* \v 26 \w and the temple servants|strong="H05411"\w*\f + \fr 3:26 \ft Hebrew \fqa the Nethinim\ft ; also in verse 31\f* \w living|strong="H03427"\w* \w on the hill of Ophel|strong="H06077"\w* \w made repairs opposite|strong="H05048"\w* \w the Water|strong="H04325"\w* \w Gate|strong="H08179"\w* \w toward the east|strong="H04217"\w* \w and the tower|strong="H04026"\w* \w that juts out|strong="H03318"\w*. \v 27 \w And next to them|strong="H00310"\w*, \w the Tekoites|strong="H08621"\w* \w repaired|strong="H02388"\w* \w another|strong="H08145"\w* \w section|strong="H04060"\w*, \w from a point opposite|strong="H05048"\w* \w the great|strong="H01419"\w* \w tower|strong="H04026"\w* \w that juts out|strong="H03318"\w* \w to|strong="H05704"\w* \w the wall|strong="H02346"\w* \w of Ophel|strong="H06077"\w*.
\p \v 28 \w Above|strong="H05921"\w* \w the Horse|strong="H05483"\w* \w Gate|strong="H08179"\w*, \w each|strong="H00376"\w* \w of the priests|strong="H03548"\w* \w made repairs|strong="H02388"\w* \w in front|strong="H05048"\w* \w of his own house|strong="H01004"\w*. \v 29 \w Next to them|strong="H00310"\w*, \w Zadok|strong="H06659"\w* \w son|strong="H01121"\w* \w of Immer|strong="H00564"\w* \w made repairs|strong="H02388"\w* \w opposite|strong="H05048"\w* \w his house|strong="H01004"\w*, \w and next to him|strong="H00310"\w*, \w Shemaiah|strong="H08098"\w* \w son|strong="H01121"\w* \w of Shecaniah|strong="H07935"\w*, \w the guard|strong="H08104"\w* \w of the East|strong="H04217"\w* \w Gate|strong="H08179"\w*, \w made repairs|strong="H02388"\w*.
\p \v 30 \w Next to him|strong="H00310"\w*, \w Hananiah|strong="H02608"\w* \w son|strong="H01121"\w* \w of Shelemiah|strong="H08018"\w*, \w as well as Hanun|strong="H02586"\w* \w the sixth|strong="H08345"\w* \w son|strong="H01121"\w* \w of Zalaph|strong="H06764"\w*, \w repaired|strong="H02388"\w* \w another|strong="H08145"\w* \w section|strong="H04060"\w*. \w Next to them|strong="H00310"\w*, \w Meshullam|strong="H04918"\w* \w son|strong="H01121"\w* \w of Berechiah|strong="H01296"\w* \w made repairs|strong="H02388"\w* \w opposite|strong="H05048"\w* \w his own quarters|strong="H05393"\w*. \v 31 \w Next to him|strong="H00310"\w*, \w Malchijah|strong="H04441"\w*, \w one of the goldsmiths|strong="H01121"\w*, \w made repairs|strong="H02388"\w* \w as far as|strong="H05704"\w* \w the house|strong="H01004"\w* \w of the temple servants|strong="H05411"\w* \w and the merchants|strong="H07402"\w*, \w opposite|strong="H05048"\w* \w the Inspection|strong="H04662"\w* \w Gate|strong="H08179"\w*, \w and as|strong="H05704"\w* \w far as the upper room|strong="H05944"\w* \w above the corner|strong="H06438"\w*. \v 32 \w And between|strong="H00996"\w* \w the upper room|strong="H05944"\w* \w above the corner|strong="H06438"\w* \w and the Sheep|strong="H06629"\w* \w Gate|strong="H08179"\w*, \w the goldsmiths|strong="H06884"\w* \w and merchants|strong="H07402"\w* \w made repairs|strong="H02388"\w*.
\c 4
\s1 The Work Ridiculed
\p \v 1 \w Now|strong="H01961"\w* \w when|strong="H00834"\w* \w Sanballat|strong="H05571"\w* \w heard|strong="H08085"\w* \w that|strong="H03588"\w* \w we|strong="H00587"\w* \w were rebuilding|strong="H01129"\w* \w the wall|strong="H02346"\w*, \w he was furious|strong="H02734"\w* \w and filled with indignation|strong="H03707"\w*. \w He ridiculed|strong="H03932"\w* \w the Jews|strong="H03064"\w* \v 2 \w before|strong="H06440"\w* \w his associates|strong="H00251"\w* \w and the army|strong="H02428"\w* \w of Samaria|strong="H08111"\w*, \w saying|strong="H00559"\w*, “\w What|strong="H04100"\w* \w are these feeble|strong="H00537"\w* \w Jews|strong="H03064"\w* \w doing|strong="H06213"\w*? \w Can they restore the wall|strong="H05800"\w* by themselves?\f + \fr 4:2 \ft Or \fqa Will they commit themselves to God?\f* \w Will they offer sacrifices|strong="H02076"\w*? \w Will they complete it|strong="H03615"\w* \w in a day|strong="H03117"\w*? \w Can they bring these|strong="H01992"\w* \w burnt|strong="H08313"\w* \w stones|strong="H00068"\w* \w back to life|strong="H02421"\w* \w from the mounds|strong="H06194"\w* \w of rubble|strong="H06083"\w*?”
\p \v 3 \w Then Tobiah|strong="H02900"\w* \w the Ammonite|strong="H05984"\w*, \w who was beside him|strong="H00681"\w*, \w said|strong="H00559"\w*, “\w If|strong="H00518"\w* \w even|strong="H01571"\w* \w a fox|strong="H07776"\w* \w were to climb up on|strong="H05927"\w* \w what|strong="H00834"\w* \w they|strong="H01992"\w* \w are building|strong="H01129"\w*, \w it would break down|strong="H06555"\w* \w their wall|strong="H02346"\w* \w of stones|strong="H00068"\w*!”
\p \v 4 \w Hear us|strong="H08085"\w*, \w O God|strong="H00430"\w*, \w for|strong="H03588"\w* \w we are|strong="H01961"\w* \w despised|strong="H00939"\w*. \w Turn|strong="H07725"\w* \w their scorn|strong="H02781"\w* \w back upon|strong="H00413"\w* \w their own heads|strong="H07218"\w*, \w and let them be taken|strong="H05414"\w* \w as plunder|strong="H00961"\w* \w to a land|strong="H00776"\w* \w of captivity|strong="H07633"\w*. \v 5 \w Do not|strong="H00408"\w* \w cover up|strong="H03680"\w* \w their iniquity|strong="H05771"\w* \w or let their sin|strong="H02403"\w* \w be blotted out|strong="H04229"\w* \w from Your sight|strong="H06440"\w*, \w for|strong="H03588"\w* \w they have provoked|strong="H03707"\w* \w the builders|strong="H01129"\w*.\f + \fr 4:5 \ft Or \fqa have provoked You to anger before the builders\f*
\p \v 6 \w So we rebuilt|strong="H01129"\w* \w the wall|strong="H02346"\w* \w until all|strong="H03605"\w* \w of it|strong="H02346"\w* \w was joined together|strong="H07194"\w* \w up to|strong="H05704"\w* \w half its height|strong="H02677"\w*, \w for the people|strong="H05971"\w* \w had|strong="H01961"\w* \w a mind|strong="H03820"\w* \w to work|strong="H06213"\w*.
\p \v 7 \w When|strong="H00834"\w* \w Sanballat|strong="H05571"\w* \w and Tobiah|strong="H02900"\w*, \w together with the Arabs|strong="H06163"\w*, \w Ammonites|strong="H05984"\w*, \w and Ashdodites|strong="H00796"\w*, \w heard|strong="H08085"\w* \w that|strong="H03588"\w* \w the repair|strong="H00724"\w* \w to the walls|strong="H02346"\w* \w of Jerusalem|strong="H03389"\w* \w was progressing|strong="H05927"\w* \w and that|strong="H03588"\w* \w the gaps|strong="H06555"\w* \w were being closed|strong="H05640"\w*, \w they were furious|strong="H02734"\w*, \v 8 \w and all of them|strong="H03605"\w* \w conspired|strong="H07194"\w* \w to come|strong="H00935"\w* \w and fight|strong="H03898"\w* \w against Jerusalem|strong="H03389"\w* \w and create|strong="H06213"\w* \w a hindrance|strong="H08442"\w*.
\s1 Discouragement Overcome
\p \v 9 \w So we prayed|strong="H06419"\w* \w to|strong="H00413"\w* \w our God|strong="H00430"\w* \w and posted|strong="H05975"\w* \w a guard|strong="H04929"\w* \w against them|strong="H05921"\w* \w day|strong="H03119"\w* \w and night|strong="H03915"\w*.
\p \v 10 \w Meanwhile, the people of Judah|strong="H03063"\w* \w said|strong="H00559"\w*:\f + \fr 4:10 \ft Or \fqa Meanwhile, Judah said\f*
\b 
\q1 “\w The strength|strong="H03581"\w* \w of the laborer|strong="H05449"\w* \w fails|strong="H03782"\w*,
\q2 \w and there is so much|strong="H07235"\w* \w rubble|strong="H06083"\w*
\q1 \w that we|strong="H00587"\w* \w will never|strong="H03808"\w* \w be able|strong="H03201"\w*
\q2 \w to rebuild|strong="H01129"\w* \w the wall|strong="H02346"\w*.”
\p \v 11 \w And our enemies|strong="H06862"\w* \w said|strong="H00559"\w*, “\w Before|strong="H05704"\w* \w they know|strong="H03045"\w* \w or|strong="H03808"\w* \w see|strong="H07200"\w* \w a thing|strong="H03808"\w*, \w we will come|strong="H00935"\w* \w into|strong="H00413"\w* \w their midst|strong="H08432"\w*, \w kill them|strong="H02026"\w*, \w and put an end|strong="H07673"\w* \w to the work|strong="H04399"\w*.”
\p \v 12 \w At that time|strong="H01961"\w* \w the Jews|strong="H03064"\w* \w who lived|strong="H03427"\w* \w nearby|strong="H00681"\w* \w came|strong="H00935"\w* \w and told|strong="H00559"\w* us \w ten|strong="H06235"\w* \w times over|strong="H06471"\w*, “\w Wherever|strong="H03605"\w* \w you turn|strong="H07725"\w*, \w they will attack us|strong="H05921"\w*.”
\p \v 13 \w So I stationed men|strong="H05975"\w* \w behind|strong="H00310"\w* \w the lowest|strong="H08482"\w* \w sections|strong="H04725"\w* \w of the wall|strong="H02346"\w*, \w at the vulnerable areas|strong="H06708"\w*. \w I stationed|strong="H05975"\w* \w them|strong="H05971"\w* \w by families|strong="H04940"\w* \w with|strong="H05973"\w* \w their swords|strong="H02719"\w*, \w spears|strong="H07420"\w*, \w and bows|strong="H07198"\w*.
\p \v 14 \w After I had made an inspection|strong="H07200"\w*, \w I stood up|strong="H06965"\w* \w and said|strong="H00559"\w* \w to|strong="H00413"\w* \w the nobles|strong="H02715"\w*, \w the officials|strong="H05461"\w*, \w and the rest|strong="H03499"\w* \w of the people|strong="H05971"\w*, “\w Do not|strong="H00408"\w* \w be afraid|strong="H03372"\w* \w of them|strong="H06440"\w*. \w Remember|strong="H02142"\w* \w the Lord|strong="H00136"\w*, \w who is great|strong="H01419"\w* \w and awesome|strong="H03372"\w*, \w and fight|strong="H03898"\w* \w for|strong="H05921"\w* \w your brothers|strong="H00251"\w*, \w your sons|strong="H01121"\w* \w and your daughters|strong="H01323"\w*, \w your wives|strong="H00802"\w* \w and your homes|strong="H01004"\w*.”
\p \v 15 \w When|strong="H00834"\w* \w our enemies|strong="H00341"\w* \w heard|strong="H08085"\w* \w that|strong="H03588"\w* \w we were aware|strong="H03045"\w* \w of their scheme|strong="H06098"\w* \w and that God|strong="H00430"\w* \w had frustrated it|strong="H06565"\w*, \w each|strong="H03605"\w* \w of us returned|strong="H07725"\w* \w to|strong="H00413"\w* \w his own|strong="H00376"\w* \w work|strong="H04399"\w* \w on|strong="H00413"\w* \w the wall|strong="H02346"\w*. \v 16 \w And|strong="H01961"\w* \w from|strong="H04480"\w* \w that|strong="H01931"\w* \w day on|strong="H03117"\w*, \w half|strong="H02677"\w* \w of my servants|strong="H05288"\w* \w did|strong="H06213"\w* \w the work|strong="H04399"\w* \w while the other half|strong="H02677"\w* \w held|strong="H02388"\w* \w spears|strong="H07420"\w*, \w shields|strong="H04043"\w*, \w bows|strong="H07198"\w*, \w and armor|strong="H08302"\w*.
\p \w The officers|strong="H08269"\w* \w stationed themselves behind|strong="H00310"\w* \w all|strong="H03605"\w* \w the people|strong="H01004"\w* \w of Judah|strong="H03063"\w* \v 17 \w who were rebuilding|strong="H01129"\w* \w the wall|strong="H02346"\w*. \w The laborers who carried|strong="H05375"\w* \w materials|strong="H05447"\w* \w worked|strong="H06213"\w* \w with one|strong="H00259"\w* \w hand|strong="H03027"\w* \w and held|strong="H02388"\w* \w a weapon|strong="H07973"\w* \w with the other|strong="H00259"\w*. \v 18 \w And each|strong="H00376"\w* \w of the builders|strong="H01129"\w* \w worked|strong="H01129"\w* \w with his sword|strong="H02719"\w* \w strapped|strong="H00631"\w* \w at|strong="H05921"\w* \w his side|strong="H04975"\w*. \w But the trumpeter|strong="H08628"\w* \w stayed beside me|strong="H00681"\w*.
\p \v 19 \w Then I said|strong="H00559"\w* \w to|strong="H00413"\w* \w the nobles|strong="H02715"\w*, \w the officials|strong="H05461"\w*, \w and the rest|strong="H03499"\w* \w of the people|strong="H05971"\w*: “\w The work is|strong="H04399"\w* \w great|strong="H07235"\w* \w and extensive|strong="H07342"\w*, \w and we|strong="H00587"\w* \w are spread out|strong="H06504"\w* \w far|strong="H07350"\w* \w from one|strong="H00376"\w* \w another|strong="H00251"\w* \w along|strong="H05921"\w* \w the wall|strong="H02346"\w*. \v 20 \w Wherever|strong="H04725"\w* \w you hear|strong="H08085"\w* \w the sound|strong="H06963"\w* \w of the horn|strong="H07782"\w*, \w rally|strong="H06908"\w* \w to us|strong="H00413"\w* \w there|strong="H08033"\w*. \w Our God|strong="H00430"\w* \w will fight|strong="H03898"\w* for us!”
\p \v 21 \w So we|strong="H00587"\w* \w continued|strong="H06213"\w* \w the work|strong="H04399"\w*, \w while half of the men|strong="H02677"\w* \w held|strong="H02388"\w* \w spears|strong="H07420"\w* \w from the break|strong="H05927"\w* \w of dawn|strong="H07837"\w* \w until|strong="H05704"\w* \w the stars|strong="H03556"\w* \w came out|strong="H03318"\w*. \v 22 \w At that|strong="H01931"\w* \w time|strong="H06256"\w* \w I also|strong="H01571"\w* \w said|strong="H00559"\w* \w to the people|strong="H05971"\w*, “\w Let every man|strong="H00376"\w* \w and his servant|strong="H05288"\w* \w spend the night|strong="H03885"\w* \w inside|strong="H08432"\w* \w Jerusalem|strong="H03389"\w*, \w so that they can stand|strong="H01961"\w* \w guard|strong="H04929"\w* \w by night|strong="H03915"\w* \w and work|strong="H04399"\w* \w by day|strong="H03117"\w*.”
\p \v 23 \w So neither I|strong="H00589"\w* \w nor my brothers|strong="H00251"\w* \w nor my servants|strong="H05288"\w* \w nor the guards|strong="H04929"\w* \w with me|strong="H00310"\w* \w changed out of|strong="H06584"\w* \w our clothes|strong="H00899"\w*; \w each|strong="H00376"\w* \w carried his weapon|strong="H07973"\w*, \w even to go for water|strong="H04325"\w*.\f + \fr 4:23 \ft Or \fqa each carried his weapon in his right hand\f*
\c 5
\s1 Nehemiah Defends the Oppressed
\p \v 1 \w About that time there was|strong="H01961"\w* \w a great|strong="H01419"\w* \w outcry|strong="H06818"\w* \w from the people|strong="H05971"\w* \w and their wives|strong="H00802"\w* \w against|strong="H00413"\w* \w their fellow|strong="H00251"\w* \w Jews|strong="H03064"\w*.
\p \v 2 \w Some|strong="H00834"\w* \w were saying|strong="H00559"\w*, “\w We|strong="H00587"\w* \w and our sons|strong="H01121"\w* \w and daughters|strong="H01323"\w* \w are numerous|strong="H07227"\w*. \w We must get|strong="H03947"\w* \w grain|strong="H01715"\w* \w in order to eat|strong="H00398"\w* \w and stay alive|strong="H02421"\w*.”
\p \v 3 \w Others|strong="H00834"\w* \w were saying|strong="H00559"\w*, “\w We|strong="H00587"\w* \w are mortgaging|strong="H06148"\w* \w our fields|strong="H07704"\w*, \w our vineyards|strong="H03754"\w*, \w and our homes|strong="H01004"\w* \w to get|strong="H03947"\w* \w grain|strong="H01715"\w* \w during the famine|strong="H07458"\w*.”
\p \v 4 \w Still others|strong="H00834"\w* \w were saying|strong="H00559"\w*, “\w We have borrowed|strong="H03867"\w* \w money to pay|strong="H03701"\w* \w the king’s|strong="H04428"\w* \w tax|strong="H04060"\w* \w on our fields|strong="H07704"\w* \w and vineyards|strong="H03754"\w*. \v 5 \w We and our children|strong="H01121"\w* \w are just like our countrymen|strong="H00251"\w* \w and their children|strong="H01121"\w*, \w yet we|strong="H00587"\w* \w are subjecting|strong="H03533"\w* \w our sons|strong="H01121"\w* \w and daughters|strong="H01323"\w* \w to slavery|strong="H05650"\w*. \w Some of|strong="H03426"\w* \w our daughters|strong="H01323"\w* \w are already enslaved|strong="H03533"\w*, \w but we are powerless to redeem them|strong="H00369"\w* \w because our fields|strong="H07704"\w* \w and vineyards|strong="H03754"\w* \w belong to others|strong="H00312"\w*.”
\p \v 6 \w When|strong="H00834"\w* \w I heard|strong="H08085"\w* \w their outcry|strong="H02201"\w* \w and these|strong="H00428"\w* \w complaints|strong="H01697"\w*, \w I became extremely|strong="H03966"\w* \w angry|strong="H02734"\w*, \v 7 \w and after serious|strong="H03820"\w* \w thought|strong="H04427"\w* \w I rebuked|strong="H07378"\w* \w the nobles|strong="H02715"\w* \w and officials|strong="H05461"\w*, \w saying|strong="H00559"\w*, “\w You|strong="H00859"\w* \w are exacting|strong="H05378"\w* \w usury|strong="H04855"\w* \w from your own brothers|strong="H00251"\w*!”
\p \w So I called|strong="H05414"\w* \w a large|strong="H01419"\w* \w assembly|strong="H06952"\w* \w against them|strong="H05921"\w* \v 8 \w and said|strong="H00559"\w*, “\w We|strong="H00587"\w* \w have done our best|strong="H01767"\w* \w to buy back|strong="H07069"\w* \w our Jewish|strong="H03064"\w* \w brothers|strong="H00251"\w* \w who were sold|strong="H04376"\w* \w to foreigners|strong="H01471"\w*, \w but now you|strong="H00859"\w* \w are selling|strong="H04376"\w* \w your own brothers|strong="H00251"\w*, \w that they may be sold back|strong="H04376"\w* to us!”
\p \w But they remained silent|strong="H02790"\w*, \w for they could find|strong="H04672"\w* \w nothing|strong="H03808"\w* \w to say|strong="H01697"\w*.
\p \v 9 \w So I continued|strong="H00559"\w*, “\w What|strong="H00834"\w* \w you|strong="H00859"\w* \w are doing|strong="H06213"\w* \w is not|strong="H03808"\w* \w right|strong="H02896"\w*. \w Shouldn’t|strong="H03808"\w* \w you walk|strong="H01980"\w* \w in the fear|strong="H03374"\w* \w of our God|strong="H00430"\w* \w to avoid the reproach|strong="H02781"\w* \w of our foreign|strong="H01471"\w* \w enemies|strong="H00341"\w*? \v 10 \w I|strong="H00589"\w*, \w as well as|strong="H01571"\w* \w my brothers|strong="H00251"\w* \w and my servants|strong="H05288"\w*, \w have been lending|strong="H05383"\w* the people \w money|strong="H03701"\w* \w and grain|strong="H01715"\w*. \w Please|strong="H04994"\w*, \w let us stop|strong="H05800"\w* \w this|strong="H02088"\w* \w usury|strong="H04855"\w*. \v 11 \w Please|strong="H04994"\w* \w restore|strong="H07725"\w* to them \w immediately|strong="H03117"\w* \w their fields|strong="H07704"\w*, \w vineyards|strong="H03754"\w*, \w olive groves|strong="H02132"\w*, \w and houses|strong="H01004"\w*, \w along with the percentage|strong="H03967"\w* \w of the money|strong="H03701"\w*, \w grain|strong="H01715"\w*, \w new wine|strong="H08492"\w*, \w and oil|strong="H03323"\w* \w that|strong="H00834"\w* \w you|strong="H00859"\w* \w have been assessing|strong="H05383"\w* them.”
\p \v 12 “\w We will restore it|strong="H07725"\w*,” \w they replied|strong="H00559"\w*, “\w and will require|strong="H01245"\w* \w nothing|strong="H03808"\w* more from them. \w We will do|strong="H06213"\w* \w as|strong="H00834"\w* \w you|strong="H00859"\w* \w say|strong="H00559"\w*.”
\p \w So I summoned|strong="H07121"\w* \w the priests|strong="H03548"\w* \w and required of the nobles and officials an oath that they|strong="H07650"\w* \w would do|strong="H06213"\w* \w what they had promised|strong="H01697"\w*. \v 13 \w I also|strong="H01571"\w* \w shook out|strong="H05287"\w* \w the folds of my robe|strong="H02684"\w* \w and said|strong="H00559"\w*, “\w May God|strong="H00430"\w* \w likewise|strong="H03602"\w* \w shake|strong="H05287"\w* \w out of his house|strong="H01004"\w* \w and possessions|strong="H03018"\w* \w every|strong="H03605"\w* \w man|strong="H00376"\w* \w who|strong="H00834"\w* \w does not|strong="H03808"\w* \w keep|strong="H06965"\w* \w this|strong="H02088"\w* \w promise|strong="H01697"\w*. \w May such a man be|strong="H01961"\w* \w shaken out|strong="H05287"\w* \w and have nothing|strong="H07386"\w*!”
\p \w The whole|strong="H03605"\w* \w assembly|strong="H06951"\w* \w said|strong="H00559"\w*, “\w Amen|strong="H00543"\w*,” \w and they praised|strong="H01984"\w* \w the LORD|strong="H03068"\w*. \w And the people|strong="H05971"\w* \w did|strong="H06213"\w* \w as they had promised|strong="H01697"\w*.
\s1 Nehemiah’s Generosity
\p \v 14 \w Furthermore|strong="H01571"\w*, \w from the day|strong="H03117"\w* \w King|strong="H04428"\w* \w Artaxerxes|strong="H00783"\w* \w appointed me|strong="H06680"\w* \w to be|strong="H01961"\w* \w their governor|strong="H06346"\w* \w in the land|strong="H00776"\w* \w of Judah|strong="H03063"\w*, \w from his twentieth|strong="H06242"\w* \w year|strong="H08141"\w* \w until|strong="H05704"\w* \w his thirty-second|strong="H07970"\w* \w year|strong="H08141"\w* (\w twelve|strong="H08147"\w* \w years total|strong="H08141"\w*), \w neither I|strong="H00589"\w* \w nor my brothers|strong="H00251"\w* \w ate|strong="H00398"\w* \w the food|strong="H03899"\w* \w allotted to the governor|strong="H06346"\w*.
\p \v 15 \w The governors|strong="H06346"\w* \w before me|strong="H06440"\w* \w had heavily burdened|strong="H03513"\w* \w the people|strong="H05971"\w*, \w taking|strong="H03947"\w* from them \w bread|strong="H03899"\w* \w and wine|strong="H03196"\w* \w plus|strong="H00310"\w* \w forty|strong="H00705"\w* \w shekels|strong="H08255"\w* \w of silver|strong="H03701"\w*.\f + \fr 5:15 \fqa 40 shekels \ft is approximately 1 pound or 453.6 grams of silver.\f* \w Their servants|strong="H05288"\w* \w also|strong="H01571"\w* \w oppressed|strong="H07980"\w* \w the people|strong="H05971"\w*. \w But I|strong="H00589"\w* \w did not|strong="H03808"\w* \w do|strong="H06213"\w* \w this|strong="H03651"\w*, \w because|strong="H06440"\w* \w of my fear|strong="H03374"\w* \w of God|strong="H00430"\w*. \v 16 \w Instead|strong="H01571"\w*, \w I devoted myself|strong="H02388"\w* \w to the construction|strong="H04399"\w* \w of the|strong="H02063"\w* \w wall|strong="H02346"\w*, \w and all|strong="H03605"\w* \w my servants|strong="H05288"\w* \w were gathered|strong="H06908"\w* \w there|strong="H08033"\w* \w for|strong="H05921"\w* \w the work|strong="H04399"\w*; \w we did not|strong="H03808"\w* \w acquire|strong="H07069"\w* \w any land|strong="H07704"\w*.
\p \v 17 \w There were 150|strong="H03967"\w* \w Jews|strong="H03064"\w* \w and officials|strong="H05461"\w* \w at|strong="H05921"\w* \w my table|strong="H07979"\w*, \w besides the guests|strong="H00935"\w* \w from|strong="H04480"\w* \w the surrounding|strong="H05439"\w* \w nations|strong="H01471"\w*. \v 18 \w Each|strong="H00259"\w* \w day|strong="H03117"\w* \w one|strong="H00259"\w* \w ox|strong="H07794"\w*, \w six|strong="H08337"\w* \w choice|strong="H01305"\w* \w sheep|strong="H06629"\w*, \w and some fowl|strong="H06833"\w* \w were prepared|strong="H06213"\w* for me, \w and once every|strong="H00996"\w* \w ten|strong="H06235"\w* \w days|strong="H03117"\w* \w an abundance|strong="H07235"\w* \w of all kinds|strong="H03605"\w* \w of wine was provided|strong="H03196"\w*. \w But I did not|strong="H03808"\w* \w demand|strong="H01245"\w* \w the food|strong="H03899"\w* \w allotted to the governor|strong="H06346"\w*, \w because|strong="H03588"\w* \w the burden|strong="H05656"\w* \w on|strong="H05921"\w* \w the people|strong="H05971"\w* \w was so heavy|strong="H03513"\w*.
\p \v 19 \w Remember|strong="H02142"\w* me \w favorably|strong="H02896"\w*, \w O my God|strong="H00430"\w*, \w for all|strong="H03605"\w* \w that|strong="H00834"\w* \w I have done|strong="H06213"\w* \w for|strong="H05921"\w* \w this|strong="H02088"\w* \w people|strong="H05971"\w*.
\c 6
\s1 Sanballat’s Conspiracy
\p \v 1 \w When|strong="H00834"\w* \w Sanballat|strong="H05571"\w*, \w Tobiah|strong="H02900"\w*, \w Geshem|strong="H01654"\w* \w the Arab|strong="H06163"\w*, \w and the rest|strong="H03499"\w* \w of our enemies|strong="H00341"\w* \w heard|strong="H08085"\w* \w that|strong="H03588"\w* \w I had rebuilt|strong="H01129"\w* \w the wall|strong="H02346"\w* \w and not|strong="H03808"\w* \w a gap|strong="H06556"\w* \w was left|strong="H03498"\w*— \w though|strong="H01571"\w* \w to|strong="H05704"\w* \w that|strong="H01931"\w* \w time|strong="H06256"\w* \w I had not yet|strong="H03808"\w* \w installed|strong="H05975"\w* \w the doors|strong="H01817"\w* \w in the gates|strong="H08179"\w*— \v 2 \w Sanballat|strong="H05571"\w* \w and Geshem|strong="H01654"\w* \w sent me|strong="H07971"\w* \w this message|strong="H00559"\w*: “\w Come|strong="H01980"\w*, \w let us meet|strong="H03259"\w* \w together|strong="H03162"\w* \w in one of the villages|strong="H03715"\w*\f + \fr 6:2 \ft Or \fqa in Kephirim\f* \w on the plain|strong="H01237"\w*\f + \fr 6:2 \ft Or \fqa in the valley\f* \w of Ono|strong="H00207"\w*.”
\p \w But they|strong="H01992"\w* \w were planning|strong="H02803"\w* \w to harm|strong="H06213"\w* me.
\p \v 3 \w So I sent|strong="H07971"\w* \w messengers|strong="H04397"\w* \w to them|strong="H05921"\w*, \w saying|strong="H00559"\w*, “\w I|strong="H00589"\w* \w am doing|strong="H06213"\w* \w a great|strong="H01419"\w* \w work|strong="H04399"\w* \w and cannot|strong="H03808"\w* \w come down|strong="H03381"\w*. \w Why|strong="H04100"\w* \w should the work|strong="H04399"\w* \w stop|strong="H07673"\w* \w while|strong="H00834"\w* \w I leave it|strong="H07503"\w* \w to go down|strong="H03381"\w* \w to you|strong="H00413"\w*?”
\p \v 4 \w Four|strong="H00702"\w* \w times|strong="H06471"\w* \w they sent me|strong="H07971"\w* \w the same|strong="H02088"\w* \w message|strong="H01697"\w*, \w and each time I gave|strong="H07725"\w* \w the same|strong="H02088"\w* \w reply|strong="H01697"\w*.
\p \v 5 \w The fifth|strong="H02549"\w* \w time|strong="H06471"\w*, \w Sanballat|strong="H05571"\w* \w sent me|strong="H07971"\w* \w this|strong="H02088"\w* \w same message|strong="H01697"\w* \w by his young servant|strong="H05288"\w*, \w who had in his hand|strong="H03027"\w* \w an unsealed|strong="H06605"\w* \w letter|strong="H00107"\w* \v 6 \w that read|strong="H03789"\w*:
\p “\w It is reported|strong="H08085"\w* \w among the nations|strong="H01471"\w*— \w and Geshem|strong="H01654"\w*\f + \fr 6:6 \ft Hebrew \fqa Gashmu\ft , a variant of \fqa Geshem\ft ; see verse 1.\f* \w agrees|strong="H00559"\w*— \w that you|strong="H00859"\w* \w and the Jews|strong="H03064"\w* \w are plotting|strong="H02803"\w* \w to revolt|strong="H04775"\w*, \w and this is why|strong="H05921"\w* \w you|strong="H00859"\w* \w are building|strong="H01129"\w* \w the wall|strong="H02346"\w*. \w According to these|strong="H00428"\w* \w reports|strong="H01697"\w*, \w you|strong="H00859"\w* \w are to become|strong="H01933"\w* their \w king|strong="H04428"\w*, \v 7 \w and you have even|strong="H01571"\w* \w appointed|strong="H05975"\w* \w prophets|strong="H05030"\w* \w in Jerusalem|strong="H03389"\w* \w to proclaim|strong="H07121"\w* \w on your behalf|strong="H05921"\w*: ‘\w There is a king|strong="H04428"\w* \w in Judah|strong="H03063"\w*.’ \w Soon|strong="H06258"\w* \w these|strong="H00428"\w* \w rumors|strong="H01697"\w* \w will reach the ears|strong="H08085"\w* \w of the king|strong="H04428"\w*. \w So|strong="H06258"\w* \w come|strong="H01980"\w*, \w let us confer|strong="H03289"\w* \w together|strong="H03162"\w*.”
\p \v 8 \w Then I sent|strong="H07971"\w* \w him|strong="H00413"\w* \w this reply|strong="H00559"\w*: “\w There is|strong="H01961"\w* \w nothing|strong="H03808"\w* \w to these|strong="H00428"\w* \w rumors|strong="H01697"\w* \w you|strong="H00859"\w* \w are spreading|strong="H00559"\w*; \w you|strong="H00859"\w* \w are inventing them|strong="H00908"\w* \w in your own mind|strong="H03820"\w*.”
\p \v 9 \w For|strong="H03588"\w* \w they were all|strong="H03605"\w* \w trying to frighten|strong="H03372"\w* \w us|strong="H00853"\w*, \w saying|strong="H00559"\w*, “\w Their hands|strong="H03027"\w* \w will be weakened|strong="H07503"\w* \w in|strong="H04480"\w* \w the work|strong="H04399"\w*, \w and it will never|strong="H03808"\w* \w be finished|strong="H06213"\w*.”
\p \w But now, my God|strong="H06258"\w*,\f + \fr 6:9 \ft Hebrew \fqa But now\ft ; for clarity, \fqa my God \ft has been included.\f* \w strengthen|strong="H02388"\w* \w my hands|strong="H03027"\w*.
\p \v 10 \w Later, I|strong="H00589"\w* \w went|strong="H00935"\w* \w to the house|strong="H01004"\w* \w of Shemaiah|strong="H08098"\w* \w son|strong="H01121"\w* \w of Delaiah|strong="H01806"\w*, \w the son|strong="H01121"\w* \w of Mehetabel|strong="H04105"\w*, \w who|strong="H01931"\w* \w was confined|strong="H06113"\w* \w to his house. He said|strong="H00559"\w*:
\b 
\q1 “\w Let us meet|strong="H03259"\w* \w at|strong="H00413"\w* \w the house|strong="H01004"\w* \w of God|strong="H00430"\w*
\q2 \w inside|strong="H00413"\w* \w the temple|strong="H01964"\w*.
\q1 \w Let us shut|strong="H05462"\w* \w the temple|strong="H01964"\w* \w doors|strong="H01817"\w*
\q2 \w because|strong="H03588"\w* \w they are coming|strong="H00935"\w* \w to kill you|strong="H02026"\w* —
\q2 \w by night|strong="H03915"\w* \w they are coming|strong="H00935"\w* \w to kill you|strong="H02026"\w*!”
\p \v 11 \w But I replied|strong="H00559"\w*, “\w Should a man|strong="H00376"\w* \w like me|strong="H03644"\w* \w run away|strong="H01272"\w*? \w Should|strong="H04310"\w* \w one like me|strong="H03644"\w* \w go|strong="H00935"\w* \w into|strong="H00413"\w* \w the temple|strong="H01964"\w* \w to save his own life|strong="H02421"\w*? \w I will not|strong="H03808"\w* \w go|strong="H00935"\w*!”
\p \v 12 \w I realized|strong="H05234"\w* \w that God|strong="H00430"\w* \w had not|strong="H03808"\w* \w sent him|strong="H07971"\w*, \w but that he had uttered|strong="H01696"\w* \w this prophecy|strong="H05016"\w* \w against me|strong="H05921"\w* \w because|strong="H03588"\w* \w Tobiah|strong="H02900"\w* \w and Sanballat|strong="H05571"\w* \w had hired him|strong="H07936"\w*. \v 13 \w He|strong="H01931"\w* \w had been hired|strong="H07936"\w* \w to|strong="H04616"\w* \w intimidate me|strong="H03372"\w* \w so that I would sin|strong="H02398"\w* \w by doing|strong="H06213"\w* \w as he suggested|strong="H03651"\w*, \w so they could give me|strong="H01961"\w* \w a bad|strong="H07451"\w* \w name|strong="H08034"\w* \w in order to|strong="H04616"\w* \w discredit me|strong="H02778"\w*.
\p \v 14 \w O my God|strong="H00430"\w*, \w remember|strong="H02142"\w* \w Tobiah|strong="H02900"\w* \w and Sanballat|strong="H05571"\w* \w for what they have done|strong="H04639"\w*, \w and also|strong="H01571"\w* \w Noadiah|strong="H05129"\w* \w the prophetess|strong="H05031"\w* \w and the other|strong="H03499"\w* \w prophets|strong="H05030"\w* \w who|strong="H00834"\w* \w tried to intimidate me|strong="H03372"\w*.
\s1 Completion of the Wall
\p \v 15 \w So the wall|strong="H02346"\w* \w was completed|strong="H07999"\w* \w in fifty-two|strong="H02572"\w* \w days|strong="H03117"\w*, \w on the twenty-fifth|strong="H06242"\w* \w of Elul|strong="H00435"\w*.\f + \fr 6:15 \fqa Elul \ft is the sixth month of the Hebrew lunar calendar, usually occurring within the months of August and September.\f* \v 16 \w When|strong="H00834"\w* \w all|strong="H03605"\w* \w our enemies|strong="H00341"\w* \w heard about this|strong="H08085"\w*, \w all|strong="H03605"\w* \w the surrounding|strong="H05439"\w* \w nations|strong="H01471"\w* \w were afraid|strong="H00834"\w* \w and disheartened|strong="H05307"\w*, \w for they realized|strong="H03045"\w* \w that|strong="H03588"\w* \w this|strong="H02063"\w* \w task|strong="H04399"\w* \w had been accomplished|strong="H06213"\w* \w by|strong="H00854"\w* \w our God|strong="H00430"\w*.
\p \v 17 \w Also|strong="H01571"\w* \w in those|strong="H01992"\w* \w days|strong="H03117"\w*, \w the nobles|strong="H02715"\w* \w of Judah|strong="H03063"\w* \w sent many|strong="H07235"\w* \w letters|strong="H00107"\w* \w to|strong="H05921"\w* \w Tobiah|strong="H02900"\w*, \w and Tobiah’s|strong="H02900"\w* \w letters|strong="H00834"\w* \w kept coming|strong="H00935"\w* \w to them|strong="H00413"\w*. \v 18 \w For|strong="H03588"\w* \w many|strong="H07227"\w* \w in Judah|strong="H03063"\w* \w were bound|strong="H01167"\w* \w by oath|strong="H07621"\w* to him, \w since|strong="H03588"\w* \w he|strong="H01931"\w* \w was a son-in-law|strong="H02860"\w* \w of Shecaniah|strong="H07935"\w* \w son|strong="H01121"\w* \w of Arah|strong="H00733"\w*, \w and his son|strong="H01121"\w* \w Jehohanan|strong="H03076"\w* \w had married|strong="H03947"\w* \w the daughter|strong="H01323"\w* \w of Meshullam|strong="H04918"\w* \w son|strong="H01121"\w* \w of Berechiah|strong="H01296"\w*.
\p \v 19 \w Moreover|strong="H01571"\w*, \w these nobles kept|strong="H01961"\w* \w reporting|strong="H00559"\w* \w to me|strong="H06440"\w* \w Tobiah’s good deeds|strong="H02896"\w*, \w and they relayed|strong="H03318"\w* \w my words|strong="H01697"\w* to him. \w And Tobiah|strong="H02900"\w* \w sent|strong="H07971"\w* \w letters|strong="H00107"\w* \w to intimidate me|strong="H03372"\w*.
\c 7
\s1 Securing the City
\p \v 1 \w When|strong="H00834"\w* \w the wall|strong="H02346"\w* \w had been rebuilt|strong="H01129"\w* \w and I had set the doors|strong="H01817"\w* \w in place|strong="H05975"\w*, \w the gatekeepers|strong="H07778"\w*, \w singers|strong="H07891"\w*, \w and Levites|strong="H03881"\w* \w were appointed|strong="H06485"\w*.
\p \v 2 \w Then I put my brother|strong="H00251"\w* \w Hanani|strong="H02607"\w* \w in charge|strong="H06680"\w* \w of|strong="H05921"\w* \w Jerusalem|strong="H03389"\w*, \w along with Hananiah|strong="H02608"\w* \w the commander|strong="H08269"\w* \w of the fortress|strong="H01002"\w*, \w because|strong="H03588"\w* \w he|strong="H01931"\w* \w was a faithful|strong="H00571"\w* \w man|strong="H00376"\w* \w who feared|strong="H03372"\w* \w God|strong="H00430"\w* \w more than most|strong="H07227"\w*. \v 3 \w And I told|strong="H00559"\w* them, “\w Do not|strong="H03808"\w* \w open|strong="H06605"\w* \w the gates|strong="H08179"\w* \w of Jerusalem|strong="H03389"\w* \w until|strong="H05704"\w* \w the sun|strong="H08121"\w* \w is hot|strong="H02552"\w*. \w While|strong="H05704"\w* \w the guards|strong="H01992"\w* \w are on duty|strong="H05975"\w*, \w keep the doors|strong="H01817"\w* \w shut|strong="H01479"\w* \w and securely fastened|strong="H00270"\w*. \w And appoint|strong="H05975"\w* \w the residents|strong="H03427"\w* \w of Jerusalem|strong="H03389"\w* \w as guards|strong="H04931"\w*, \w some|strong="H00376"\w* \w at their posts|strong="H04929"\w* \w and some|strong="H00376"\w* \w at|strong="H05048"\w* \w their own homes|strong="H01004"\w*.”
\s1 The List of Returning Exiles
\p \v 4 \w Now the city|strong="H05892"\w* \w was large|strong="H01419"\w* \w and spacious|strong="H07342"\w*, \w but there were few|strong="H04592"\w* \w people|strong="H05971"\w* \w in it|strong="H08432"\w*, \w and the houses|strong="H01004"\w* \w had not yet|strong="H00369"\w* \w been rebuilt|strong="H01129"\w*. \v 5 \w Then my God|strong="H00430"\w* \w put it|strong="H05414"\w* \w into|strong="H00413"\w* \w my heart|strong="H03820"\w* \w to assemble|strong="H06908"\w* \w the nobles|strong="H02715"\w*, \w the officials|strong="H05461"\w*, \w and the people|strong="H05971"\w* \w to be enrolled by genealogy|strong="H03187"\w*. \w I found|strong="H04672"\w* \w the genealogical|strong="H03188"\w* \w register|strong="H05612"\w* \w of those who had first returned|strong="H05927"\w*, \w and I found|strong="H04672"\w* \w the following written|strong="H03789"\w* in it:
\p \v 6 \w These|strong="H00428"\w* \w are the people|strong="H01121"\w* \w of the province|strong="H04082"\w* \w who came up|strong="H05927"\w* \w from the captivity|strong="H07628"\w* \w of the exiles|strong="H01473"\w* \w carried away|strong="H01540"\w* \w to Babylon|strong="H00894"\w* \w by Nebuchadnezzar|strong="H05019"\w* \w its king|strong="H04428"\w*. \w They returned|strong="H07725"\w* \w to Jerusalem|strong="H03389"\w* \w and Judah|strong="H03063"\w*, \w each|strong="H00376"\w* \w to his own town|strong="H05892"\w*, \v 7 \w accompanied|strong="H00935"\w* \w by|strong="H05973"\w* \w Zerubbabel|strong="H02216"\w*, \w Jeshua|strong="H03442"\w*, \w Nehemiah|strong="H05166"\w*, \w Azariah|strong="H05838"\w*, \w Raamiah|strong="H07485"\w*, \w Nahamani|strong="H05167"\w*, \w Mordecai|strong="H04782"\w*, \w Bilshan|strong="H01114"\w*, \w Mispereth|strong="H04559"\w*, \w Bigvai|strong="H00902"\w*, \w Nehum|strong="H05149"\w*, \w and Baanah|strong="H01196"\w*.\f + \fr 7:7 \ft Parallel text at Ezra 2:2 \fqa accompanied by Zerubbabel, Jeshua, Nehemiah, Seraiah, Reelaiah, Mordecai, Bilshan, Mispar, Bigvai, Rehum, and Baanah\f*
