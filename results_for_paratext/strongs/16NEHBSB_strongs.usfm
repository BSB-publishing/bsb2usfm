\li1 \w and the descendants|strong="H01121"\w* \w of Barzillai|strong="H01271"\w* (\w who|strong="H00834"\w* \w had married|strong="H03947"\w* \w a daughter|strong="H01323"\w* \w of Barzillai|strong="H01271"\w* \w the Gileadite|strong="H01569"\w* \w and was called|strong="H07121"\w* \w by|strong="H05921"\w* \w their name|strong="H08034"\w*).
\b 
\li1 \v 64 \w These men|strong="H00428"\w* \w searched for|strong="H01245"\w* \w their family records|strong="H03791"\w*, \w but they could not|strong="H03808"\w* \w find them|strong="H04672"\w* \w and so were excluded|strong="H01351"\w* \w from|strong="H04480"\w* \w the priesthood as unclean|strong="H03550"\w*. \v 65 \w The governor|strong="H08660"\w* \w ordered|strong="H00559"\w* them \w not|strong="H03808"\w* \w to eat|strong="H00398"\w* \w the most holy things|strong="H06944"\w* \w until|strong="H05704"\w* \w there was|strong="H05975"\w* \w a priest|strong="H03548"\w* \w to consult the Urim|strong="H00224"\w* \w and Thummim|strong="H08550"\w*.\f + \fr 7:65 \ft Literally \fqa Lights and Perfections\f*
\p \v 66 \w The whole|strong="H03605"\w* \w assembly|strong="H06951"\w* \w numbered|strong="H00259"\w* \w 42,360|strong="H00702"\w*, \v 67 \w in addition to|strong="H00905"\w* their \w 7,337|strong="H07651"\w* \w menservants|strong="H05650"\w* \w and maidservants|strong="H00519"\w*, \w as well as their 245|strong="H03967"\w* \w male and female singers|strong="H07891"\w*. \v 68 They had 736 horses, 245 mules,\f + \fr 7:68 \ft Some Hebrew manuscripts (see also Ezra 2:66); most Hebrew manuscripts do not include this verse.\f* \v 69 \w 435|strong="H00702"\w* \w camels|strong="H01581"\w*, \w and 6,720|strong="H08337"\w* \w donkeys|strong="H02543"\w*.
\s1 Offerings by the Exiles
\p \v 70 \w Some of|strong="H07117"\w* \w the heads|strong="H07218"\w* \w of the families|strong="H00001"\w* \w contributed|strong="H05414"\w* \w to the project|strong="H04399"\w*. \w The governor|strong="H08660"\w* \w gave|strong="H05414"\w* \w to the treasury|strong="H00214"\w* \w 1,000|strong="H00505"\w* \w darics|strong="H01871"\w* \w of gold|strong="H02091"\w*,\f + \fr 7:70 \ft Or \fqa 1,000 gold drachmas\ft ; that is, approximately 18.5 pounds or 8.4 kilograms of gold coins\f* \w 50|strong="H02572"\w* \w bowls|strong="H04219"\w*, \w and 530|strong="H07970"\w* \w priestly|strong="H03548"\w* \w garments|strong="H03801"\w*. \v 71 \w And some of the heads|strong="H07218"\w* \w of the families|strong="H00001"\w* \w gave|strong="H05414"\w* \w to the treasury|strong="H00214"\w* \w for the project|strong="H04399"\w* \w 20,000|strong="H08147"\w* \w darics|strong="H01871"\w* \w of gold|strong="H02091"\w*\f + \fr 7:71 \ft Or \fqa 20,000 gold drachmas\ft ; that is, approximately 370.4 pounds or 168 kilograms of gold coins; also in verse 72 \f* \w and 2,200|strong="H00505"\w* \w minas|strong="H04488"\w* \w of silver|strong="H03701"\w*.\f + \fr 7:71 \ft Or \fqa 2,200 silver minas\ft ; that is, approximately 1.38 tons or 1.25 metric tons of silver\f* \v 72 \w The rest|strong="H07611"\w* \w of the people|strong="H05971"\w* \w gave a total of|strong="H05414"\w* \w 20,000|strong="H08147"\w* \w darics|strong="H01871"\w* \w of gold|strong="H02091"\w*, \w 2,000|strong="H00505"\w* \w minas|strong="H04488"\w* \w of silver|strong="H03701"\w*,\f + \fr 7:72 \ft Or \fqa 2,000 silver minas\ft ; that is, approximately 1.26 tons or 1.14 metric tons of silver\f* \w and 67|strong="H08346"\w* \w priestly|strong="H03548"\w* \w garments|strong="H03801"\w*.
\p \v 73 \w So the priests|strong="H03548"\w*, \w Levites|strong="H03881"\w*, \w gatekeepers|strong="H07778"\w*, \w singers|strong="H07891"\w*, \w and temple servants|strong="H05411"\w*, \w along with some|strong="H04480"\w* \w of the people|strong="H05971"\w* \w and the rest of|strong="H03605"\w* \w the Israelites|strong="H03478"\w*, \w settled|strong="H03427"\w* \w in their own towns|strong="H05892"\w*. \w And by the seventh|strong="H07637"\w* \w month|strong="H02320"\w* \w the Israelites|strong="H01121"\w* \w had settled in their towns|strong="H05892"\w*.
\c 8
\s1 Ezra Reads the Law
\p \v 1 \w At that time all|strong="H03605"\w* \w the people|strong="H05971"\w* \w gathered|strong="H00622"\w* \w together|strong="H00376"\w* \w in|strong="H00413"\w* \w the square|strong="H07339"\w* \w before|strong="H06440"\w* \w the Water|strong="H04325"\w* \w Gate|strong="H08179"\w*, \w and they asked|strong="H00559"\w* \w Ezra|strong="H05830"\w* \w the scribe|strong="H05608"\w* \w to bring out|strong="H00935"\w* \w the Book|strong="H05612"\w* \w of the Law|strong="H08451"\w* \w of Moses|strong="H04872"\w*, \w which|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had commanded|strong="H06680"\w* \w for|strong="H00853"\w* \w Israel|strong="H03478"\w*.
\p \v 2 \w On the first|strong="H00259"\w* \w day|strong="H03117"\w* \w of the seventh|strong="H07637"\w* \w month|strong="H02320"\w*, \w Ezra|strong="H05830"\w* \w the priest|strong="H03548"\w* \w brought|strong="H00935"\w* \w the Law|strong="H08451"\w* \w before|strong="H06440"\w* \w the assembly|strong="H06951"\w* \w of men|strong="H00376"\w* \w and|strong="H05704"\w* \w women|strong="H00802"\w* \w and all|strong="H03605"\w* \w who could listen|strong="H08085"\w* \w and understand|strong="H00995"\w*. \v 3 \w So Ezra read|strong="H07121"\w* it aloud \w from|strong="H04480"\w* \w daybreak|strong="H00216"\w* \w until|strong="H05704"\w* \w noon|strong="H04276"\w* \w as he faced|strong="H06440"\w* \w the square|strong="H07339"\w* \w before|strong="H06440"\w* \w the Water|strong="H04325"\w* \w Gate|strong="H08179"\w*, \w in front of|strong="H05048"\w* \w the men|strong="H00582"\w* \w and women|strong="H00802"\w* \w and those who could understand|strong="H00995"\w*.
\p \w And all|strong="H03605"\w* \w the people|strong="H05971"\w* \w listened attentively to|strong="H00241"\w* \w the Book|strong="H05612"\w* \w of the Law|strong="H08451"\w*.
\p \v 4 \w Ezra|strong="H05830"\w* \w the scribe|strong="H05608"\w* \w stood|strong="H05975"\w* \w on|strong="H05921"\w* \w a high wooden|strong="H06086"\w* \w platform|strong="H04026"\w* \w built|strong="H06213"\w* \w for this occasion|strong="H01697"\w*. \w At his|strong="H05921"\w* \w right side|strong="H03225"\w* \w stood|strong="H05975"\w* \w Mattithiah|strong="H04993"\w*, \w Shema|strong="H08087"\w*, \w Anaiah|strong="H06043"\w*, \w Uriah|strong="H00223"\w*, \w Hilkiah|strong="H02518"\w*, \w and Maaseiah|strong="H04641"\w*, \w and at his left|strong="H08040"\w* \w were Pedaiah|strong="H06305"\w*, \w Mishael|strong="H04332"\w*, \w Malchijah|strong="H04441"\w*, \w Hashum|strong="H02828"\w*, \w Hash-baddanah|strong="H02806"\w*, \w Zechariah|strong="H02148"\w*, \w and Meshullam|strong="H04918"\w*.
\p \v 5 \w Ezra|strong="H05830"\w* \w opened|strong="H06605"\w* \w the book|strong="H05612"\w* \w in full view|strong="H05869"\w* \w of all|strong="H03605"\w* \w the people|strong="H05971"\w*, \w since|strong="H03588"\w* \w he was|strong="H01961"\w* \w standing above them|strong="H05921"\w* \w all|strong="H03605"\w*, \w and as he opened it|strong="H06605"\w*, \w all|strong="H03605"\w* \w the people|strong="H05971"\w* \w stood up|strong="H05975"\w*. \v 6 \w Then Ezra|strong="H05830"\w* \w blessed|strong="H01288"\w* \w the LORD|strong="H03068"\w*, \w the great|strong="H01419"\w* \w God|strong="H00430"\w*, \w and with their hands|strong="H03027"\w* \w uplifted|strong="H04607"\w*, \w all|strong="H03605"\w* \w the people|strong="H05971"\w* \w said|strong="H06030"\w*, “\w Amen|strong="H00543"\w*, \w Amen|strong="H00543"\w*!” \w Then they bowed down|strong="H06915"\w* \w and worshiped|strong="H07812"\w* \w the LORD|strong="H03068"\w* \w with their faces|strong="H00639"\w* \w to the ground|strong="H00776"\w*.
\p \v 7 \w The Levites|strong="H03881"\w* — \w Jeshua|strong="H03442"\w*, \w Bani|strong="H01137"\w*, \w Sherebiah|strong="H08274"\w*, \w Jamin|strong="H03226"\w*, \w Akkub|strong="H06126"\w*, \w Shabbethai|strong="H07678"\w*, \w Hodiah|strong="H01941"\w*, \w Maaseiah|strong="H04641"\w*, \w Kelita|strong="H07042"\w*, \w Azariah|strong="H05838"\w*, \w Jozabad|strong="H03107"\w*, \w Hanan|strong="H02605"\w*, \w and Pelaiah|strong="H06411"\w* — \w instructed|strong="H00995"\w* \w the people|strong="H05971"\w* \w in the Law|strong="H08451"\w* \w as they|strong="H05971"\w* \w stood in|strong="H05921"\w* \w their places|strong="H05977"\w*. \v 8 \w So they read|strong="H07121"\w* \w from the Book|strong="H05612"\w* \w of the Law|strong="H08451"\w* \w of God|strong="H00430"\w*, \w explaining it|strong="H06567"\w*\f + \fr 8:8 \ft Or \fqa translating it \ft or \fqa paragraph by paragraph\f* \w and giving|strong="H07760"\w* \w insight|strong="H07922"\w*, \w so that the people could understand|strong="H00995"\w* \w what was being read|strong="H04744"\w*.
\p \v 9 \w Nehemiah|strong="H05166"\w* \w the governor|strong="H08660"\w*, \w Ezra|strong="H05830"\w* \w the priest|strong="H03548"\w* \w and scribe|strong="H05608"\w*, \w and the Levites|strong="H03881"\w* \w who were instructing|strong="H00995"\w* \w the people|strong="H05971"\w* \w said|strong="H00559"\w* \w to all|strong="H03605"\w* \w of them|strong="H05971"\w*, “\w This|strong="H01931"\w* \w day|strong="H03117"\w* \w is holy|strong="H06918"\w* \w to the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*. \w Do not|strong="H00408"\w* \w mourn|strong="H00056"\w* \w or weep|strong="H01058"\w*.”
\p \w For|strong="H03588"\w* \w all|strong="H03605"\w* \w the people|strong="H05971"\w* \w were weeping|strong="H01058"\w* \w as they heard|strong="H08085"\w* \w the words|strong="H01697"\w* \w of the Law|strong="H08451"\w*.
\p \v 10 \w Then Nehemiah told|strong="H00559"\w* them, “\w Go|strong="H01980"\w* \w and eat|strong="H00398"\w* \w what is rich|strong="H04924"\w*, \w drink|strong="H08354"\w* \w what is sweet|strong="H04477"\w*, \w and send out|strong="H07971"\w* \w portions|strong="H04490"\w* \w to those who have nothing|strong="H00369"\w* \w prepared|strong="H03559"\w*, \w since|strong="H03588"\w* \w today|strong="H03117"\w* \w is holy|strong="H06918"\w* \w to our Lord|strong="H00113"\w*. \w Do not|strong="H00408"\w* \w grieve|strong="H06087"\w*, \w for|strong="H03588"\w* \w the joy|strong="H02304"\w* \w of the LORD|strong="H03068"\w* \w is|strong="H01931"\w* \w your strength|strong="H04581"\w*.”
\p \v 11 \w And the Levites|strong="H03881"\w* \w calmed|strong="H02814"\w* \w all|strong="H03605"\w* \w the people|strong="H05971"\w*, \w saying|strong="H00559"\w*, “\w Be still|strong="H02013"\w*, \w since|strong="H03588"\w* \w today|strong="H03117"\w* \w is holy|strong="H06918"\w*. \w Do not|strong="H00408"\w* \w grieve|strong="H06087"\w*.”
\p \v 12 \w Then all|strong="H03605"\w* \w the people|strong="H05971"\w* \w began to eat|strong="H00398"\w* \w and drink|strong="H08354"\w*, \w to send out|strong="H07971"\w* \w portions|strong="H04490"\w*, \w and|strong="H06213"\w* \w to rejoice|strong="H08057"\w* \w greatly|strong="H01419"\w*, \w because|strong="H03588"\w* \w they understood|strong="H00995"\w* \w the words|strong="H01697"\w* \w that|strong="H00834"\w* \w had been made known|strong="H03045"\w* to them.
\s1 The Feast of Tabernacles
\p \v 13 \w On the second|strong="H08145"\w* \w day of the month|strong="H03117"\w*, \w the heads|strong="H07218"\w* \w of all|strong="H03605"\w* \w the families|strong="H00001"\w*, \w along with the priests|strong="H03548"\w* \w and Levites|strong="H03881"\w*, \w gathered|strong="H00622"\w* \w around|strong="H00413"\w* \w Ezra|strong="H05830"\w* \w the scribe|strong="H05608"\w* \w to study|strong="H07919"\w* \w the words|strong="H01697"\w* \w of the Law|strong="H08451"\w*. \v 14 \w And they found|strong="H04672"\w* \w written|strong="H03789"\w* \w in the Law|strong="H08451"\w*, \w which|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had commanded|strong="H06680"\w* \w through|strong="H03027"\w* \w Moses|strong="H04872"\w*, \w that|strong="H00834"\w* \w the Israelites|strong="H01121"\w* \w were to dwell|strong="H03427"\w* \w in booths|strong="H05521"\w*\f + \fr 8:14 \ft Or \fqa tabernacles \ft or \fqa shelters\ft ; also in verses 15, 16, and 17\f* \w during the feast|strong="H02282"\w* \w of the seventh|strong="H07637"\w* \w month|strong="H02320"\w*, \v 15 \w and that|strong="H00834"\w* \w they should proclaim|strong="H08085"\w* \w this message|strong="H06963"\w* \w and spread it|strong="H05674"\w* \w throughout|strong="H03605"\w* \w their towns|strong="H05892"\w* \w and in Jerusalem|strong="H03389"\w*, \w saying|strong="H00559"\w*, “\w Go out|strong="H03318"\w* \w to the hill country|strong="H02022"\w* \w and bring back|strong="H00935"\w* \w branches|strong="H05929"\w* \w of olive|strong="H02132"\w*, \w wild olive|strong="H08081"\w*,\f + \fr 8:15 \ft Or \fqa pine\ft ; literally \fqa oil tree\f* \w myrtle|strong="H01918"\w*, \w palm|strong="H08558"\w*, \w and other leafy|strong="H05687"\w* \w trees|strong="H06086"\w*, \w to make|strong="H06213"\w* \w booths|strong="H05521"\w*, \w as it is written|strong="H03789"\w*.”\f + \fr 8:15 \ft See Leviticus 23:37–40.\f*
\p \v 16 \w And the people|strong="H05971"\w* \w went out|strong="H03318"\w*, \w brought back branches|strong="H00935"\w*, \w and made|strong="H06213"\w* \w booths|strong="H05521"\w* \w on|strong="H05921"\w* \w their own|strong="H00376"\w* \w rooftops|strong="H01406"\w*, \w in their courtyards|strong="H02691"\w*, \w in the courts|strong="H02691"\w* \w of the house|strong="H01004"\w* \w of God|strong="H00430"\w*, \w and in the squares|strong="H07339"\w* \w by the Water|strong="H04325"\w* \w Gate|strong="H08179"\w* \w and|strong="H07339"\w* \w by the Gate|strong="H08179"\w* \w of Ephraim|strong="H00669"\w*. \v 17 \w The whole|strong="H03605"\w* \w assembly|strong="H06951"\w* \w that had returned|strong="H07725"\w* \w from|strong="H04480"\w* \w exile|strong="H07628"\w* \w made|strong="H06213"\w* \w booths|strong="H05521"\w* \w and lived|strong="H03427"\w* \w in them|strong="H05521"\w*. \w From the days|strong="H03117"\w* \w of Joshua|strong="H03442"\w*\f + \fr 8:17 \ft Hebrew \fqa Jeshua\ft , a variant of \fqa Joshua\f* \w son|strong="H01121"\w* \w of Nun|strong="H05126"\w* \w until|strong="H05704"\w* \w that|strong="H01931"\w* \w day|strong="H03117"\w*, \w the Israelites|strong="H01121"\w* \w had not|strong="H03808"\w* \w celebrated|strong="H06213"\w* \w like this|strong="H03651"\w*. \w And there was|strong="H01961"\w* \w great|strong="H01419"\w* \w rejoicing|strong="H08057"\w*.
\p \v 18 \w Day|strong="H03117"\w* \w after day|strong="H03117"\w*, \w from|strong="H04480"\w* \w the first|strong="H07223"\w* \w day|strong="H03117"\w* \w to|strong="H05704"\w* \w the last|strong="H00314"\w*, \w Ezra read|strong="H07121"\w* \w from the Book|strong="H05612"\w* \w of the Law|strong="H08451"\w* \w of God|strong="H00430"\w*. \w The Israelites kept|strong="H06213"\w* \w the feast|strong="H02282"\w* \w for seven|strong="H07651"\w* \w days|strong="H03117"\w*, \w and on the eighth|strong="H08066"\w* \w day|strong="H03117"\w* \w they held an assembly|strong="H06116"\w*, \w according to the ordinance|strong="H04941"\w*.
\c 9
\s1 The People Confess Their Sins
\p \v 1 \w On the twenty-fourth|strong="H06242"\w* \w day|strong="H03117"\w* \w of the same|strong="H02088"\w* \w month|strong="H02320"\w*, \w the Israelites|strong="H01121"\w* \w gathered together|strong="H00622"\w*, \w fasting|strong="H06685"\w* \w and wearing sackcloth|strong="H08242"\w*, \w with dust|strong="H00127"\w* \w on their heads|strong="H05921"\w*. \v 2 \w Those of Israelite|strong="H03478"\w* \w descent|strong="H02233"\w* \w separated themselves|strong="H00914"\w* \w from all|strong="H03605"\w* \w the foreigners|strong="H01121"\w*, \w and they stood|strong="H05975"\w* \w and confessed|strong="H03034"\w* \w their sins|strong="H02403"\w* \w and the iniquities|strong="H05771"\w* \w of their fathers|strong="H00001"\w*.
\p \v 3 \w While they stood|strong="H06965"\w* \w in|strong="H05921"\w* \w their places|strong="H05977"\w*, \w they read|strong="H07121"\w* \w from the Book|strong="H05612"\w* \w of the Law|strong="H08451"\w* \w of the LORD|strong="H03068"\w* \w their God|strong="H00430"\w* \w for a quarter|strong="H07243"\w* \w of the day|strong="H03117"\w*, \w and they spent another quarter of the day|strong="H07243"\w* \w in confession|strong="H03034"\w* \w and worship|strong="H07812"\w* \w of the LORD|strong="H03068"\w* \w their God|strong="H00430"\w*.
\p \v 4 \w And the Levites|strong="H03881"\w* — \w Jeshua|strong="H03442"\w*, \w Bani|strong="H01137"\w*, \w Kadmiel|strong="H06934"\w*, \w Shebaniah|strong="H07645"\w*, \w Bunni|strong="H01138"\w*, \w Sherebiah|strong="H08274"\w*, \w Bani|strong="H01137"\w*, \w and Chenani|strong="H03662"\w* — \w stood|strong="H06965"\w* \w on|strong="H05921"\w* \w the raised platform|strong="H04608"\w* \w and cried out|strong="H02199"\w* \w in a loud|strong="H01419"\w* \w voice|strong="H06963"\w* \w to|strong="H00413"\w* \w the LORD|strong="H03068"\w* \w their God|strong="H00430"\w*. \v 5 \w Then the Levites|strong="H03881"\w*— \w Jeshua|strong="H03442"\w*, \w Kadmiel|strong="H06934"\w*, \w Bani|strong="H01137"\w*, \w Hashabneiah|strong="H02813"\w*, \w Sherebiah|strong="H08274"\w*, \w Hodiah|strong="H01941"\w*, \w Shebaniah|strong="H07645"\w*, \w and Pethahiah|strong="H06611"\w*— \w said|strong="H00559"\w*, “\w Stand up|strong="H06965"\w* \w and bless|strong="H01288"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w from|strong="H04480"\w* \w everlasting|strong="H05769"\w* \w to|strong="H05704"\w* \w everlasting|strong="H05769"\w*:
\b 
\q1 \w Blessed be|strong="H01288"\w* \w Your glorious|strong="H03519"\w* \w name|strong="H08034"\w*,
\q2 \w and may it be exalted|strong="H07311"\w*
\q2 \w above|strong="H05921"\w* \w all|strong="H03605"\w* \w blessing|strong="H01293"\w* \w and praise|strong="H08416"\w*.
\q1 \v 6 \w You|strong="H00859"\w* \w alone|strong="H00905"\w* \w are the LORD|strong="H03068"\w*.
\q2 \w You created|strong="H06213"\w* \w the heavens|strong="H08064"\w*,
\q1 \w the highest heavens|strong="H08064"\w* \w with all|strong="H03605"\w* \w their host|strong="H06635"\w*,
\q2 \w the earth|strong="H00776"\w* \w and all|strong="H03605"\w* \w that|strong="H00834"\w* \w is on it|strong="H05921"\w*,
