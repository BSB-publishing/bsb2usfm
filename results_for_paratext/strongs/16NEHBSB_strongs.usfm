\li1 \w the descendants|strong="H01121"\w* \w of Tobiah|strong="H02900"\w*,
\li1 \w and the descendants|strong="H01121"\w* \w of Nekoda|strong="H05353"\w*,
\li2 \w 642 in all|strong="H08337"\w*.
\b 
