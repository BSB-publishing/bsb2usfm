\q1 \v 23 \w As the north|strong="H06828"\w* \w wind|strong="H07307"\w* \w brings forth|strong="H02342"\w* \w rain|strong="H01653"\w*,
\q2 \w so a backbiting|strong="H05643"\w* \w tongue|strong="H03956"\w* \w brings angry|strong="H02194"\w* \w looks|strong="H06440"\w*.
