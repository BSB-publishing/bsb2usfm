\b 
\q1 \v 25 \w The fear|strong="H02731"\w* \w of man|strong="H00120"\w* \w is|strong="H05414"\w* \w a snare|strong="H04170"\w*,
\q2 \w but whoever trusts|strong="H00982"\w* \w in the LORD|strong="H03068"\w* \w is set securely on high|strong="H07682"\w*.
\b 
\q1 \v 26 \w Many|strong="H07227"\w* \w seek|strong="H01245"\w* \w the ruler’s|strong="H04910"\w* \w favor|strong="H06440"\w*,
\q2 \w but a man|strong="H00376"\w* \w receives justice|strong="H04941"\w* \w from the LORD|strong="H03068"\w*.
\b 
\q1 \v 27 \w An unjust|strong="H05766"\w* \w man|strong="H00376"\w* \w is detestable|strong="H08441"\w* \w to the righteous|strong="H06662"\w*,
\q2 \w and one whose way|strong="H01870"\w* \w is upright|strong="H03477"\w* \w is detestable|strong="H08441"\w* \w to the wicked|strong="H07563"\w*.
\c 30
\s1 The Words of Agur
\p \v 1 \w These are the words|strong="H01697"\w* \w of Agur|strong="H00094"\w* \w son|strong="H01121"\w* \w of Jakeh|strong="H03348"\w* — \w the burden|strong="H04853"\w* \w that this man|strong="H01397"\w* \w declared|strong="H05002"\w* \w to Ithiel|strong="H00384"\w*:
\b 
\q1 “\w I am weary, O God,|strong="H00384"\w*
\q2 \w and worn out|strong="H00401"\w*.\f + \fr 30:1 \ft Or \fqa declared to Ithiel: “I am weary, O God, but I can prevail. \ft (revocalizations); Hebrew \fqa declared to Ithiel—to Ithiel and Ucal:\f*
\q1 \v 2 \w Surely|strong="H03588"\w* \w I am|strong="H00595"\w* \w the most ignorant|strong="H01198"\w* \w of men|strong="H00376"\w*,
\q2 \w and I lack|strong="H03808"\w* \w the understanding|strong="H00998"\w* \w of a man|strong="H00120"\w*.
\q1 \v 3 \w I have not|strong="H03808"\w* \w learned|strong="H03925"\w* \w wisdom|strong="H02451"\w*,
\q2 \w and I have no knowledge|strong="H01847"\w* \w of the Holy One|strong="H06918"\w*.
\q1 \v 4 \w Who|strong="H04310"\w* \w has ascended|strong="H05927"\w* \w to heaven|strong="H08064"\w* \w and come down|strong="H03381"\w*?
\q2 \w Who|strong="H04310"\w* \w has gathered|strong="H00622"\w* \w the wind|strong="H07307"\w* \w in His hands|strong="H02651"\w*?
\q1 \w Who|strong="H04310"\w* \w has bound up|strong="H06887"\w* \w the waters|strong="H04325"\w* \w in His cloak|strong="H08071"\w*?
\q2 \w Who|strong="H04310"\w* \w has established|strong="H06965"\w* \w all|strong="H03605"\w* \w the ends|strong="H00657"\w* \w of the earth|strong="H00776"\w*?
\q1 \w What|strong="H04100"\w* \w is His name|strong="H08034"\w*, \w and what|strong="H04100"\w* \w is the name|strong="H08034"\w* \w of His Son|strong="H01121"\w*—
\q2 \w surely|strong="H03588"\w* \w you know|strong="H03045"\w*!
\q1 \v 5 \w Every|strong="H03605"\w* \w word|strong="H00565"\w* \w of God|strong="H00433"\w* \w is flawless|strong="H06884"\w*;
\q2 \w He|strong="H01931"\w* \w is a shield|strong="H04043"\w* \w to those who take refuge|strong="H02620"\w* in Him.
\q1 \v 6 \w Do not|strong="H00408"\w* \w add|strong="H03254"\w* \w to|strong="H05921"\w* \w His words|strong="H01697"\w*,
\q2 \w lest|strong="H06435"\w* \w He rebuke|strong="H03198"\w* you \w and prove you a liar|strong="H03576"\w*.
\b 
\q1 \v 7 \w Two|strong="H08147"\w* \w things I ask|strong="H07592"\w* \w of You|strong="H04480"\w* —
\q2 \w do not|strong="H00408"\w* \w refuse me|strong="H04513"\w* \w before|strong="H02962"\w* \w I die|strong="H04191"\w*:
\q1 \v 8 \w Keep falsehood|strong="H07723"\w* \w and deceitful|strong="H03577"\w* \w words|strong="H01697"\w* \w far|strong="H07368"\w* \w from me|strong="H04480"\w*.
\q2 \w Give|strong="H05414"\w* me \w neither|strong="H00408"\w* \w poverty|strong="H07389"\w* \w nor riches|strong="H06239"\w*;
\q2 \w feed me|strong="H02963"\w* \w with the bread|strong="H03899"\w* \w that is my portion|strong="H02706"\w*.
\q1 \v 9 \w Otherwise|strong="H06435"\w*, \w I may have too much|strong="H07646"\w*
\q2 \w and deny You|strong="H03584"\w*, \w saying|strong="H00559"\w*, ‘\w Who|strong="H04310"\w* \w is the LORD|strong="H03068"\w*?’
\q1 \w Or|strong="H06435"\w* \w I may become poor|strong="H03423"\w* \w and steal|strong="H01589"\w*,
\q2 \w profaning|strong="H08610"\w* \w the name|strong="H08034"\w* \w of my God|strong="H00430"\w*.
\b 
\q1 \v 10 \w Do not|strong="H00408"\w* \w slander|strong="H03960"\w* \w a servant|strong="H05650"\w* \w to|strong="H00413"\w* \w his master|strong="H00113"\w*,
\q2 \w or|strong="H06435"\w* \w he will curse you|strong="H07043"\w*, \w and you will bear the guilt|strong="H00816"\w*.
\b 
\q1 \v 11 \w There is a generation|strong="H01755"\w* \w of those who curse|strong="H07043"\w* \w their fathers|strong="H00001"\w*
\q2 \w and do not|strong="H03808"\w* \w bless|strong="H01288"\w* \w their mothers|strong="H00517"\w*.
\q1 \v 12 \w There is a generation|strong="H01755"\w* \w of those who are pure|strong="H02889"\w* \w in their own eyes|strong="H05869"\w*
\q2 \w and yet unwashed|strong="H07364"\w* \w of their filth|strong="H06675"\w*.
\q1 \v 13 \w There is a generation|strong="H01755"\w*— \w how|strong="H04100"\w* \w haughty|strong="H07311"\w* \w are their eyes|strong="H05869"\w*
\q2 \w and pretentious|strong="H05375"\w* \w are their glances|strong="H06079"\w* —
\q1 \v 14 \w there is a generation|strong="H01755"\w* \w whose teeth|strong="H08127"\w* \w are swords|strong="H02719"\w*
\q2 \w and whose jaws|strong="H04973"\w* \w are knives|strong="H03979"\w*,
\q1 \w devouring|strong="H00398"\w* \w the oppressed|strong="H06041"\w* \w from the earth|strong="H00776"\w*
\q2 \w and the needy|strong="H00034"\w* \w from among men|strong="H00120"\w*.
\b 
\q1 \v 15 \w The leech|strong="H05936"\w* \w has two|strong="H08147"\w* \w daughters|strong="H01323"\w*:
\q2 \w Give|strong="H03051"\w* \w and Give|strong="H03051"\w*.
\p \w There|strong="H02007"\w* \w are three|strong="H07969"\w* \w things that are never|strong="H03808"\w* \w satisfied|strong="H07646"\w*, \w four that|strong="H00702"\w* \w never|strong="H03808"\w* \w say|strong="H00559"\w*, ‘\w Enough|strong="H01952"\w*!’:
\li1 \v 16 \w Sheol|strong="H07585"\w*,
\li1 \w the barren|strong="H06115"\w* \w womb|strong="H07356"\w*,
\li1 \w land|strong="H00776"\w* \w never|strong="H03808"\w* \w satisfied|strong="H07646"\w* \w with water|strong="H04325"\w*,
\li1 \w and fire|strong="H00784"\w* \w that never|strong="H03808"\w* \w says|strong="H00559"\w*, ‘\w Enough|strong="H01952"\w*!’
\b 
\q1 \v 17 \w As for the eye|strong="H05869"\w* \w that mocks|strong="H03932"\w* \w a father|strong="H00001"\w*
\q2 \w and scorns|strong="H00936"\w* \w obedience|strong="H03349"\w* \w to a mother|strong="H00517"\w*,
\q1 \w may the ravens|strong="H06158"\w* \w of the valley|strong="H05158"\w* \w pluck it out|strong="H05365"\w*
\q2 \w and young|strong="H01121"\w* \w vultures|strong="H05404"\w* \w devour it|strong="H00398"\w*.
\p \v 18 \w There|strong="H01992"\w* \w are three things|strong="H07969"\w* \w too wonderful|strong="H06381"\w* \w for me|strong="H04480"\w*, \w four|strong="H00702"\w* \w that I cannot|strong="H03808"\w* \w understand|strong="H03045"\w*:
\li1 \v 19 \w the way|strong="H01870"\w* \w of an eagle|strong="H05404"\w* \w in the sky|strong="H08064"\w*,
\li1 \w the way|strong="H01870"\w* \w of a snake|strong="H05175"\w* \w on|strong="H05921"\w* \w a rock|strong="H06697"\w*,
\li1 \w the way|strong="H01870"\w* \w of a ship|strong="H00591"\w* \w at sea|strong="H03220"\w*,
\li1 \w and the way|strong="H01870"\w* \w of a man|strong="H01397"\w* \w with a maiden|strong="H05959"\w*.
\b 
\q1 \v 20 \w This|strong="H03651"\w* \w is the way|strong="H01870"\w* \w of an adulteress|strong="H00802"\w*:
\q2 \w She eats|strong="H00398"\w* \w and wipes|strong="H04229"\w* \w her mouth|strong="H06310"\w*
\q2 \w and says|strong="H00559"\w*, ‘\w I have done|strong="H06466"\w* \w nothing|strong="H03808"\w* \w wrong|strong="H00205"\w*.’
\p \v 21 \w Under|strong="H08478"\w* \w three things|strong="H07969"\w* \w the earth|strong="H00776"\w* \w trembles|strong="H07264"\w*, \w under|strong="H08478"\w* \w four|strong="H00702"\w* \w it cannot|strong="H03808"\w* \w bear up|strong="H05375"\w*:
\li1 \v 22 \w a servant|strong="H05650"\w* \w who|strong="H03588"\w* \w becomes king|strong="H04427"\w*,
\li1 \w a fool|strong="H05036"\w* \w who|strong="H03588"\w* \w is filled|strong="H07646"\w* \w with food|strong="H03899"\w*,
\li1 \v 23 \w an unloved woman|strong="H08130"\w* \w who|strong="H03588"\w* \w marries|strong="H01166"\w*,
\li1 \w and a maidservant|strong="H08198"\w* \w who|strong="H03588"\w* \w supplants|strong="H03423"\w* \w her mistress|strong="H01404"\w*.
\p \v 24 \w Four|strong="H00702"\w* \w things on earth|strong="H00776"\w* \w are small|strong="H06996"\w*, \w yet they|strong="H01992"\w* \w are exceedingly|strong="H02449"\w* \w wise|strong="H02450"\w*:
\li1 \v 25 \w The ants|strong="H05244"\w* \w are creatures|strong="H05971"\w* \w of little|strong="H03808"\w* \w strength|strong="H05794"\w*, \w yet they store up|strong="H03559"\w* \w their food|strong="H03899"\w* \w in the summer|strong="H07019"\w*;
\li1 \v 26 \w the rock badgers|strong="H08227"\w*\f + \fr 30:26 \ft Or \fqa the coneys \ft or \fqa the hyraxes\f* \w are creatures|strong="H05971"\w* \w of little|strong="H03808"\w* \w power|strong="H06099"\w*, \w yet they make|strong="H07760"\w* \w their homes|strong="H01004"\w* \w in the rocks|strong="H05553"\w*;
\li1 \v 27 \w the locusts|strong="H00697"\w* \w have no|strong="H00369"\w* \w king|strong="H04428"\w*, \w yet they all|strong="H03605"\w* \w advance|strong="H03318"\w* \w in formation|strong="H02686"\w*;
\li1 \v 28 \w and the lizard|strong="H08079"\w* \w can be caught|strong="H08610"\w* \w in one’s hands|strong="H03027"\w*, \w yet it|strong="H01931"\w* \w is found in the palaces|strong="H01964"\w* \w of kings|strong="H04428"\w*.
\p \v 29 \w There|strong="H01992"\w* \w are three things|strong="H07969"\w* \w that are stately|strong="H03190"\w* \w in their stride|strong="H06806"\w*, \w and four that|strong="H00702"\w* \w are impressive|strong="H03190"\w* \w in their walk|strong="H01980"\w*:
\li1 \v 30 \w a lion|strong="H03918"\w*, \w mighty|strong="H01368"\w* \w among beasts|strong="H00929"\w*, \w refusing|strong="H03808"\w* \w to retreat|strong="H07725"\w* \w before|strong="H06440"\w* \w anything|strong="H03605"\w*;
\li1 \v 31 \w a strutting rooster|strong="H02223"\w*;
\li1 \w a he-goat|strong="H08495"\w*;
\li1 \w and a king|strong="H04428"\w* \w with his army|strong="H00510"\w* \w around him|strong="H05973"\w*.\f + \fr 30:31 \ft Or \fqa a king against whom there is no rising up\f*
\b 
\q1 \v 32 \w If|strong="H00518"\w* \w you have foolishly|strong="H05034"\w* \w exalted yourself|strong="H05375"\w*
\q2 \w or if|strong="H00518"\w* \w you have plotted evil|strong="H02161"\w*,
\q2 \w put your hand|strong="H03027"\w* \w over your mouth|strong="H06310"\w*.
\q1 \v 33 \w For|strong="H03588"\w* \w as the churning|strong="H04330"\w* \w of milk|strong="H02461"\w* \w yields|strong="H03318"\w* \w butter|strong="H02529"\w*,
\q2 \w and the twisting|strong="H04330"\w* \w of the nose|strong="H00639"\w* \w draws|strong="H03318"\w* \w blood|strong="H01818"\w*,
\q2 \w so the stirring|strong="H04330"\w* \w of anger|strong="H00639"\w* \w brings forth|strong="H03318"\w* \w strife|strong="H07379"\w*.”
\c 31
\s1 The Sayings for King Lemuel
\p \v 1 \w These are the words|strong="H01697"\w* \w of King|strong="H04428"\w* \w Lemuel|strong="H03927"\w* — \w the burden|strong="H04853"\w* \w that|strong="H00834"\w* \w his mother|strong="H00517"\w* \w taught him|strong="H03256"\w*:
\b 
\q1 \v 2 \w What shall I say|strong="H04100"\w*,\f + \fr 31:2 \ft Or \fqa What \ft or \fqa What are you doing\f* \w O my son|strong="H01248"\w*?
\q2 \w What|strong="H04100"\w*, \w O son|strong="H01248"\w* \w of my womb|strong="H00990"\w*?
\q2 \w What|strong="H04100"\w*, \w O son|strong="H01248"\w* \w of my vows|strong="H05088"\w*?
\q1 \v 3 \w Do not|strong="H00408"\w* \w spend|strong="H05414"\w* \w your strength|strong="H02428"\w* \w on women|strong="H00802"\w*
\q2 \w or your vigor|strong="H01870"\w* \w on those who ruin|strong="H04229"\w* \w kings|strong="H04428"\w*.
\q1 \v 4 \w It is not|strong="H00408"\w* \w for kings|strong="H04428"\w*, \w O Lemuel|strong="H03927"\w*,
\q2 \w it is not|strong="H00408"\w* \w for kings|strong="H04428"\w* \w to drink|strong="H08354"\w* \w wine|strong="H03196"\w*,
\q2 \w or for rulers|strong="H07336"\w* \w to crave|strong="H00176"\w* \w strong drink|strong="H07941"\w*,
\q1 \v 5 \w lest|strong="H06435"\w* \w they drink|strong="H08354"\w* \w and forget|strong="H07911"\w* \w what is decreed|strong="H02710"\w*,
\q2 \w depriving|strong="H08138"\w* \w all|strong="H03605"\w* \w the oppressed|strong="H01121"\w* \w of justice|strong="H01779"\w*.
\b 
\q1 \v 6 \w Give|strong="H05414"\w* \w strong drink|strong="H07941"\w* \w to one who is perishing|strong="H00006"\w*,
\q2 \w and wine|strong="H03196"\w* \w to the bitter|strong="H04751"\w* \w in soul|strong="H05315"\w*.
\q1 \v 7 \w Let him drink|strong="H08354"\w* \w and forget|strong="H07911"\w* \w his poverty|strong="H07389"\w*,
\q2 \w and remember|strong="H02142"\w* \w his misery|strong="H05999"\w* \w no|strong="H03808"\w* \w more|strong="H05750"\w*.
\b 
\q1 \v 8 \w Open|strong="H06605"\w* \w your mouth|strong="H06310"\w* \w for those with no voice|strong="H00483"\w*,
\q2 \w for|strong="H00413"\w* \w the cause|strong="H01779"\w* \w of all|strong="H03605"\w* \w the dispossessed|strong="H01121"\w*.
\q1 \v 9 \w Open|strong="H06605"\w* \w your mouth|strong="H06310"\w*, \w judge|strong="H08199"\w* \w righteously|strong="H06664"\w*,
\q2 \w and defend the cause|strong="H01777"\w* \w of the poor|strong="H06041"\w* \w and needy|strong="H00034"\w*.
\s1 The Virtues of a Noble Woman
\q1 \v 10 \w A wife|strong="H00802"\w*\f + \fr 31:10 \ft Verses 10–31 are an acrostic poem, each verse beginning with the successive letters of the Hebrew alphabet.\f* \w of noble character|strong="H02428"\w*, \w who|strong="H04310"\w* \w can find|strong="H04672"\w*?
\q2 \w She is far|strong="H07350"\w* \w more precious|strong="H04377"\w* \w than rubies|strong="H06443"\w*.
\b 
\q1 \v 11 \w The heart|strong="H03820"\w* \w of her husband|strong="H01167"\w* \w trusts|strong="H00982"\w* in her,
\q2 \w and he lacks|strong="H02637"\w* \w nothing|strong="H03808"\w* \w of value|strong="H07998"\w*.
\q1 \v 12 \w She brings him|strong="H01580"\w* \w good|strong="H02896"\w* \w and not|strong="H03808"\w* \w harm|strong="H07451"\w*
\q2 \w all|strong="H03605"\w* \w the days|strong="H03117"\w* \w of her life|strong="H02416"\w*.
\q1 \v 13 \w She selects|strong="H01875"\w* \w wool|strong="H06785"\w* \w and flax|strong="H06593"\w*
\q2 \w and works|strong="H06213"\w* \w with eager|strong="H02656"\w* \w hands|strong="H03709"\w*.
\q1 \v 14 \w She is|strong="H01961"\w* \w like the merchant|strong="H05503"\w* \w ships|strong="H00591"\w*,
\q2 \w bringing|strong="H00935"\w* \w her food|strong="H03899"\w* \w from afar|strong="H04801"\w*.
\b 
\q1 \v 15 \w She rises|strong="H06965"\w* \w while it is still|strong="H05750"\w* \w night|strong="H03915"\w*
\q2 \w to provide|strong="H05414"\w* \w food|strong="H02964"\w* \w for her household|strong="H01004"\w*
\q2 \w and portions|strong="H02706"\w* \w for her maidservants|strong="H05291"\w*.
\q1 \v 16 \w She appraises|strong="H02161"\w* \w a field|strong="H07704"\w* \w and buys it|strong="H03947"\w*;
\q2 \w from her earnings|strong="H06529"\w* \w she plants|strong="H05193"\w* \w a vineyard|strong="H03754"\w*.
\q1 \v 17 \w She girds herself|strong="H02296"\w*\f + \fr 31:17 \ft Hebrew \fqa She girds her loins\f* \w with strength|strong="H05797"\w*
\q2 \w and shows that her arms|strong="H02220"\w* \w are strong|strong="H00553"\w*.
\q1 \v 18 \w She sees|strong="H02938"\w* \w that|strong="H03588"\w* \w her gain|strong="H05504"\w* \w is good|strong="H02896"\w*,
\q2 \w and her lamp|strong="H05216"\w* \w is not|strong="H03808"\w* \w extinguished|strong="H03518"\w* \w at night|strong="H03915"\w*.
\q1 \v 19 \w She stretches|strong="H07971"\w* \w out her hands|strong="H03027"\w* \w to the distaff|strong="H03601"\w*
\q2 \w and grasps|strong="H08551"\w* \w the spindle|strong="H06418"\w* \w with her fingers|strong="H03709"\w*.
\b 
\q1 \v 20 \w She opens|strong="H06566"\w* \w her arms|strong="H03709"\w* \w to the poor|strong="H06041"\w*
\q2 \w and reaches out|strong="H07971"\w* \w her hands|strong="H03027"\w* \w to the needy|strong="H00034"\w*.
\q1 \v 21 \w When it snows|strong="H07950"\w*, \w she has no|strong="H03808"\w* \w fear|strong="H03372"\w* \w for her household|strong="H01004"\w*,
\q2 \w for|strong="H03588"\w* \w they are all|strong="H03605"\w* \w clothed|strong="H03847"\w* \w in scarlet|strong="H08144"\w*.\f + \fr 31:21 \ft Or \fqa doubly clothed\f*
\q1 \v 22 \w She makes|strong="H06213"\w* \w coverings for her bed|strong="H04765"\w*;
\q2 \w her clothing|strong="H03830"\w* \w is fine linen|strong="H08336"\w* \w and purple|strong="H00713"\w*.
\q1 \v 23 \w Her husband|strong="H01167"\w* \w is known|strong="H03045"\w* \w at the city gates|strong="H08179"\w*,
\q2 \w where he sits|strong="H03427"\w* \w among|strong="H05973"\w* \w the elders|strong="H02205"\w* \w of the land|strong="H00776"\w*.
\q1 \v 24 \w She makes|strong="H06213"\w* \w linen garments|strong="H05466"\w* \w and sells them|strong="H04376"\w*;
\q2 \w she delivers|strong="H05414"\w* \w sashes|strong="H02290"\w* \w to the merchants|strong="H03669"\w*.
\b 
\q1 \v 25 \w Strength|strong="H05797"\w* \w and honor|strong="H01926"\w* \w are her clothing|strong="H03830"\w*,
\q2 \w and she can laugh|strong="H07832"\w* \w at the days|strong="H03117"\w* \w to come|strong="H00314"\w*.
\q1 \v 26 \w She opens|strong="H06605"\w* \w her mouth|strong="H06310"\w* \w with wisdom|strong="H02451"\w*,
\q2 \w and faithful|strong="H02617"\w* \w instruction|strong="H08451"\w* \w is on|strong="H05921"\w* \w her tongue|strong="H03956"\w*.
\q1 \v 27 \w She watches over|strong="H06822"\w* \w the affairs|strong="H01979"\w* \w of her household|strong="H01004"\w*
\q2 \w and does not|strong="H03808"\w* \w eat|strong="H00398"\w* \w the bread|strong="H03899"\w* \w of idleness|strong="H06104"\w*.
\q1 \v 28 \w Her children|strong="H01121"\w* \w rise up|strong="H06965"\w* \w and call her blessed|strong="H00833"\w*;
\q2 \w her husband|strong="H01167"\w* \w praises her as well|strong="H01984"\w*:
\q1 \v 29 “\w Many|strong="H07227"\w* \w daughters|strong="H01323"\w* \w have done|strong="H06213"\w* \w noble things|strong="H02428"\w*,
\q2 \w but you|strong="H00859"\w* \w surpass|strong="H05927"\w* \w them|strong="H05921"\w* \w all|strong="H03605"\w*!”
\b 
\q1 \v 30 \w Charm|strong="H02580"\w* \w is deceptive|strong="H08267"\w* \w and beauty|strong="H03308"\w* \w is fleeting|strong="H01892"\w*,
\q2 \w but a woman|strong="H00802"\w* \w who fears|strong="H03373"\w* \w the LORD|strong="H03068"\w* \w is to be praised|strong="H01984"\w*.
\q1 \v 31 \w Give|strong="H05414"\w* her \w the fruit|strong="H06529"\w* \w of her hands|strong="H03027"\w*,
\q2 \w and let her works|strong="H04639"\w* \w praise her|strong="H01984"\w* \w at the gates|strong="H08179"\w*.
