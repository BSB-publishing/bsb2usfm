\q2 \w so the hearts|strong="H03820"\w* \w of kings|strong="H04428"\w* \w cannot|strong="H00369"\w* \w be searched|strong="H02714"\w*.
\b 
\q1 \v 4 \w Remove|strong="H01898"\w* \w the dross|strong="H05509"\w* \w from the silver|strong="H03701"\w*,
\q2 \w and a vessel|strong="H03627"\w* \w for a silversmith|strong="H06884"\w* \w will come forth|strong="H03318"\w*.
