\s1 Do Not Envy
\q1 
\s2 Saying 20
\q1 \v 1 \w Do not|strong="H00408"\w* \w envy|strong="H07065"\w* \w wicked|strong="H07451"\w* \w men|strong="H00582"\w*
\q2 \w or desire|strong="H00183"\w* \w their company|strong="H01961"\w*;
