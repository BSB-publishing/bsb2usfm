\q2 \w and if|strong="H00518"\w* \w he is thirsty|strong="H06771"\w*, \w give him water|strong="H04325"\w* \w to drink|strong="H08248"\w*.
\q1 \v 22 \w For in so doing|strong="H03588"\w*, \w you|strong="H00859"\w* \w will heap|strong="H02846"\w* \w burning coals|strong="H01513"\w* \w on|strong="H05921"\w* \w his head|strong="H07218"\w*,\f + \fr 25:22 \ft LXX; Hebrew \fqa For you will heap burning coals on his head\ft ; cited in Romans 12:20\f*
\q2 \w and the LORD|strong="H03068"\w* \w will reward|strong="H07999"\w* you.
