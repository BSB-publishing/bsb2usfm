\s1 Further Sayings of the Wise
\p \v 23 \w These|strong="H00428"\w* \w also|strong="H01571"\w* \w are sayings of the wise|strong="H02450"\w*:
\q1 \w To show partiality|strong="H05234"\w* \w in judgment|strong="H04941"\w*
\q2 \w is not|strong="H01077"\w* \w good|strong="H02896"\w*.
\q1 \v 24 \w Whoever tells|strong="H00559"\w* \w the guilty|strong="H07563"\w*, “\w You|strong="H00859"\w* \w are innocent|strong="H06662"\w*”—
\q2 \w peoples|strong="H05971"\w* \w will curse him|strong="H06895"\w*, \w and nations|strong="H03816"\w* \w will denounce him|strong="H02194"\w*;
\q1 \v 25 \w but it will go well|strong="H05276"\w* \w with those who convict the guilty|strong="H03198"\w*,
\q2 \w and rich|strong="H02896"\w* \w blessing|strong="H01293"\w* \w will come|strong="H00935"\w* \w upon them|strong="H05921"\w*.
\b 
\q1 \v 26 \w An honest|strong="H05228"\w* \w answer|strong="H01697"\w* \w given|strong="H07725"\w*
\q2 \w is like a kiss|strong="H05401"\w* \w on the lips|strong="H08193"\w*.
\b 
\q1 \v 27 \w Complete|strong="H03559"\w* \w your outdoor|strong="H02351"\w* \w work|strong="H04399"\w* \w and prepare|strong="H06257"\w* \w your field|strong="H07704"\w*;
\q2 \w after that|strong="H00310"\w*, \w you may build|strong="H01129"\w* \w your house|strong="H01004"\w*.
\b 
\q1 \v 28 \w Do not|strong="H00408"\w* \w testify|strong="H01961"\w* \w against your neighbor|strong="H07453"\w* \w without cause|strong="H02600"\w*,
\q2 \w and do not deceive|strong="H06601"\w* \w with your lips|strong="H08193"\w*.
\q1 \v 29 \w Do not|strong="H00408"\w* \w say|strong="H00559"\w*, “\w I will do|strong="H06213"\w* to him \w as|strong="H00834"\w* \w he has done|strong="H06213"\w* to me;
\q2 \w I will repay|strong="H07725"\w* \w the man|strong="H00376"\w* \w according to his work|strong="H06467"\w*.”
\b 
\q1 \v 30 \w I went|strong="H05674"\w* \w past|strong="H05921"\w* \w the field|strong="H07704"\w* \w of a slacker|strong="H00376"\w*
\q2 \w and by|strong="H05921"\w* \w the vineyard|strong="H03754"\w* \w of a man|strong="H00120"\w* \w lacking|strong="H02638"\w* \w judgment|strong="H03820"\w*.
\q1 \v 31 \w Thorns|strong="H07063"\w* \w had grown up|strong="H05927"\w* \w everywhere|strong="H03605"\w*,
\q2 \w thistles|strong="H02738"\w* \w had covered|strong="H03680"\w* \w the ground|strong="H06440"\w*,
