\q1 \v 32 \w I|strong="H00595"\w* \w observed|strong="H02372"\w* \w and took it|strong="H07896"\w* \w to heart|strong="H03820"\w*;
\q2 \w I looked|strong="H07200"\w* \w and received|strong="H03947"\w* \w instruction|strong="H04148"\w*:
\q1 \v 33 \w A little|strong="H04592"\w* \w sleep|strong="H08142"\w*, \w a little|strong="H04592"\w* \w slumber|strong="H08572"\w*,
