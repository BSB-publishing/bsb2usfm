\q2 \w and need|strong="H04270"\w* \w like a bandit|strong="H00376"\w*.
\c 25
\s1 More Proverbs of Solomon
\p \v 1 \w These are|strong="H00428"\w* \w additional|strong="H01571"\w* \w proverbs|strong="H04912"\w* \w of Solomon|strong="H08010"\w*, \w which|strong="H00834"\w* \w were copied by|strong="H06275"\w* \w the men|strong="H00582"\w* \w of Hezekiah|strong="H02396"\w* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w*:
\b 
\q1 \v 2 \w It is the glory|strong="H03519"\w* \w of God|strong="H00430"\w* \w to conceal|strong="H05641"\w* \w a matter|strong="H01697"\w*
\q2 \w and the glory|strong="H03519"\w* \w of kings|strong="H04428"\w* \w to search it out|strong="H02713"\w*.
