\p \v 9 \w So Joshua|strong="H03091"\w* \w sent them out|strong="H07971"\w*, \w and they went|strong="H01980"\w* \w to|strong="H00413"\w* \w the place of ambush|strong="H03993"\w* \w and lay in wait|strong="H03427"\w* \w between|strong="H00996"\w* \w Bethel|strong="H01008"\w* \w and|strong="H00996"\w* \w Ai|strong="H05857"\w*, \w to the west|strong="H03220"\w* \w of Ai|strong="H05857"\w*. \w But Joshua|strong="H03091"\w* \w spent|strong="H03885"\w* \w that|strong="H01931"\w* \w night|strong="H03915"\w* \w among|strong="H08432"\w* \w the people|strong="H05971"\w*.
\p \v 10 \w Joshua|strong="H03091"\w* \w got up early|strong="H07925"\w* \w the next morning|strong="H01242"\w* \w and mobilized|strong="H06485"\w* \w his men|strong="H05971"\w*, \w and he|strong="H01931"\w* \w and the elders|strong="H02205"\w* \w of Israel|strong="H03478"\w* \w marched|strong="H05927"\w* \w before|strong="H06440"\w* \w them|strong="H05971"\w* \w up to Ai|strong="H05857"\w*. \v 11 \w Then all|strong="H03605"\w* \w the troops|strong="H05971"\w* \w who were|strong="H00834"\w* \w with him|strong="H00854"\w* \w marched up|strong="H05927"\w* \w and approached|strong="H05066"\w* \w the city|strong="H05892"\w*. \w They arrived|strong="H00935"\w* \w in front of Ai|strong="H05048"\w* \w and camped|strong="H02583"\w* \w to the north|strong="H06828"\w* \w of it|strong="H05857"\w*, \w with the valley|strong="H01516"\w* \w between them|strong="H00996"\w* \w and the city|strong="H05857"\w*.
\p \v 12 \w Now Joshua had taken|strong="H03947"\w* \w about five|strong="H02568"\w* \w thousand|strong="H00505"\w* \w men|strong="H00376"\w* \w and set up|strong="H07760"\w* \w an ambush|strong="H00693"\w* \w between|strong="H00996"\w* \w Bethel|strong="H01008"\w* \w and|strong="H00996"\w* \w Ai|strong="H05857"\w*, \w to the west|strong="H03220"\w* \w of the city|strong="H05892"\w*. \v 13 \w So the forces|strong="H05971"\w* \w were stationed|strong="H07760"\w* \w with the main|strong="H03605"\w* \w camp|strong="H04264"\w* \w to the north|strong="H06828"\w* \w of the city|strong="H05892"\w* \w and the rear guard|strong="H06119"\w* \w to the west|strong="H03220"\w* \w of the city|strong="H05892"\w*. \w And that|strong="H01931"\w* \w night|strong="H03915"\w* \w Joshua|strong="H03091"\w* \w went|strong="H01980"\w* \w into|strong="H08432"\w* \w the valley|strong="H06010"\w*.
\p \v 14 \w When the king|strong="H04428"\w* \w of Ai|strong="H05857"\w* \w saw the Israelites|strong="H07200"\w*, \w he hurried|strong="H04116"\w* \w out|strong="H03318"\w* \w early in the morning|strong="H07925"\w* \w with the men|strong="H00582"\w* \w of the city|strong="H05892"\w* \w to engage|strong="H07122"\w* \w them|strong="H03478"\w* \w in battle|strong="H04421"\w* \w at an appointed place|strong="H04150"\w* \w overlooking|strong="H06440"\w* \w the Arabah|strong="H06160"\w*. \w But he|strong="H01931"\w* \w did not|strong="H03808"\w* \w know|strong="H03045"\w* \w that|strong="H03588"\w* \w an ambush|strong="H00693"\w* had been set up against him \w behind|strong="H00310"\w* \w the city|strong="H05892"\w*. \v 15 \w Joshua|strong="H03091"\w* \w and all|strong="H03605"\w* \w Israel|strong="H03478"\w* \w let themselves be beaten back|strong="H05060"\w* \w before them|strong="H06440"\w*, \w and they fled|strong="H05127"\w* \w toward|strong="H01870"\w* \w the wilderness|strong="H04057"\w*. \v 16 \w Then all|strong="H03605"\w* \w the men|strong="H05971"\w* \w of Ai|strong="H05892"\w* \w were summoned|strong="H02199"\w* \w to pursue them|strong="H07291"\w*, \w and they followed|strong="H07291"\w* \w Joshua|strong="H03091"\w* \w and were drawn away|strong="H05423"\w* \w from|strong="H04480"\w* \w the city|strong="H05892"\w*. \v 17 \w Not|strong="H03808"\w* \w a man|strong="H00376"\w* \w was left|strong="H07604"\w* \w in Ai|strong="H05857"\w* \w or Bethel|strong="H01008"\w* \w who|strong="H00834"\w* \w did not|strong="H03808"\w* \w go out|strong="H03318"\w* \w after|strong="H00310"\w* \w Israel|strong="H03478"\w*, \w leaving|strong="H05800"\w* \w the city|strong="H05892"\w* \w wide open|strong="H06605"\w* \w while they pursued|strong="H07291"\w* \w Israel|strong="H03478"\w*.
\p \v 18 \w Then the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Joshua|strong="H03091"\w*, “\w Hold out|strong="H05186"\w* \w your battle lance|strong="H03591"\w*\f + \fr 8:18 \ft Or \fqa javelin\ft ; twice in this verse, and also in verse 26\f* \w toward|strong="H00413"\w* \w Ai|strong="H05857"\w*, \w for|strong="H03588"\w* \w into your hand|strong="H03027"\w* \w I will deliver the city|strong="H05414"\w*.” \w So Joshua|strong="H03091"\w* \w held out|strong="H05186"\w* \w his battle lance|strong="H03591"\w* \w toward|strong="H00413"\w* \w Ai|strong="H05892"\w*, \v 19 \w and as soon as he did so|strong="H05186"\w*, \w the men in ambush|strong="H00693"\w* \w rose|strong="H06965"\w* \w quickly|strong="H04120"\w* \w from their position|strong="H04725"\w*. \w They rushed forward|strong="H07323"\w*, \w entered|strong="H00935"\w* \w the city|strong="H05892"\w*, \w captured it|strong="H03920"\w*, \w and immediately|strong="H04116"\w* \w set it|strong="H05892"\w* \w on fire|strong="H03341"\w*.
\p \v 20 \w When the men|strong="H00582"\w* \w of Ai|strong="H05857"\w* \w turned|strong="H06437"\w* \w and looked|strong="H07200"\w* \w back|strong="H00310"\w*, \w the smoke|strong="H06227"\w* \w of the city|strong="H05892"\w* \w was rising|strong="H05927"\w* \w into the sky|strong="H08064"\w*. \w They could not|strong="H03808"\w* \w escape|strong="H05127"\w* \w in any direction|strong="H02008"\w*, \w and the troops|strong="H05971"\w* \w who had fled|strong="H05127"\w* \w to the wilderness|strong="H04057"\w* \w now turned|strong="H02015"\w* \w against|strong="H00413"\w* \w their pursuers|strong="H07291"\w*. \v 21 \w When Joshua|strong="H03091"\w* \w and all|strong="H03605"\w* \w Israel|strong="H03478"\w* \w saw|strong="H07200"\w* \w that|strong="H03588"\w* \w the men in ambush|strong="H00693"\w* \w had captured|strong="H03920"\w* \w the city|strong="H05892"\w* \w and that|strong="H03588"\w* \w smoke|strong="H06227"\w* \w was rising from|strong="H05927"\w* \w it|strong="H05892"\w*, \w they turned around|strong="H07725"\w* \w and struck down|strong="H05221"\w* \w the men|strong="H00582"\w* \w of Ai|strong="H05857"\w*. \v 22 \w Meanwhile, those in the ambush|strong="H00428"\w* \w came out|strong="H03318"\w* \w of|strong="H04480"\w* \w the city|strong="H05892"\w* \w against them|strong="H07122"\w*, \w and the men of Ai were|strong="H01961"\w* \w trapped between|strong="H08432"\w* \w the Israelite|strong="H03478"\w* \w forces|strong="H00428"\w* \w on|strong="H02088"\w* \w both sides|strong="H00428"\w*. \w So Israel struck them down|strong="H05221"\w* \w until|strong="H05704"\w* \w no|strong="H01115"\w* \w survivor|strong="H08300"\w* \w or fugitive|strong="H06412"\w* \w remained|strong="H07604"\w*. \v 23 \w But|strong="H00853"\w* \w they took|strong="H08610"\w* \w the king|strong="H04428"\w* \w of Ai|strong="H05857"\w* \w alive|strong="H02416"\w* \w and brought|strong="H07126"\w* \w him|strong="H00853"\w* \w to|strong="H00413"\w* \w Joshua|strong="H03091"\w*.
\p \v 24 \w When Israel|strong="H03478"\w* \w had finished|strong="H03615"\w* \w killing|strong="H02026"\w* \w all|strong="H03605"\w* \w the men|strong="H03427"\w* \w of Ai|strong="H05857"\w* \w who had pursued|strong="H07291"\w* them \w into the field|strong="H07704"\w* \w and wilderness|strong="H04057"\w*, \w and when every|strong="H03605"\w* \w last one of them had fallen|strong="H05307"\w* \w by the sword|strong="H02719"\w*, \w all|strong="H03605"\w* \w the Israelites|strong="H03478"\w* \w returned|strong="H07725"\w* \w to Ai|strong="H05857"\w* \w and put|strong="H05221"\w* \w it|strong="H00853"\w* \w to the sword as well|strong="H02719"\w*. \v 25 \w A total|strong="H03605"\w* \w of twelve|strong="H08147"\w* \w thousand|strong="H00505"\w* \w men|strong="H00376"\w* \w and|strong="H05704"\w* \w women|strong="H00802"\w* \w fell|strong="H05307"\w* \w that|strong="H01931"\w* \w day|strong="H03117"\w*— \w all|strong="H03605"\w* \w the people|strong="H00582"\w* \w of Ai|strong="H05857"\w*. \v 26 \w Joshua|strong="H03091"\w* \w did not|strong="H03808"\w* \w draw back|strong="H07725"\w* \w the hand|strong="H03027"\w* \w that|strong="H00834"\w* \w held|strong="H05186"\w* \w his battle lance|strong="H03591"\w* \w until|strong="H05704"\w* \w he had devoted to destruction|strong="H02763"\w*\f + \fr 8:26 \ft Forms of the Hebrew \fqa cherem \ft refer to the giving over of things or persons to the LORD, either by destroying them or by giving them as an offering.\f* \w all|strong="H03605"\w* \w who lived|strong="H03427"\w* \w in Ai|strong="H05857"\w*. \v 27 \w Israel|strong="H03478"\w* \w took|strong="H00962"\w* for themselves \w only|strong="H07535"\w* \w the cattle|strong="H00929"\w* \w and plunder|strong="H07998"\w* \w of that|strong="H01931"\w* \w city|strong="H05892"\w*, \w as the LORD|strong="H03068"\w* \w had commanded|strong="H06680"\w* \w Joshua|strong="H03091"\w*.
\p \v 28 \w So Joshua|strong="H03091"\w* \w burned|strong="H08313"\w* \w Ai|strong="H05857"\w*\f + \fr 8:28 \fqa Ai \ft means \fqa ruin\ft .\f* \w and made it|strong="H07760"\w* \w a permanent|strong="H05769"\w* \w heap of ruins|strong="H08510"\w*, \w a desolation|strong="H08077"\w* \w to|strong="H05704"\w* \w this|strong="H02088"\w* \w day|strong="H03117"\w*. \v 29 \w He hung|strong="H08518"\w* \w the king|strong="H04428"\w* \w of Ai|strong="H05857"\w* \w on|strong="H05921"\w* \w a tree|strong="H06086"\w*\f + \fr 8:29 \ft Or \fqa He impaled the king of Ai on a pole\f* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*, \w and at sunset|strong="H00935"\w* \w Joshua|strong="H03091"\w* \w commanded|strong="H06680"\w* \w that they take down the body|strong="H05038"\w* \w from|strong="H04480"\w* \w the tree|strong="H06086"\w* \w and throw it down|strong="H07993"\w* \w at|strong="H00413"\w* \w the entrance|strong="H06607"\w* \w of the city|strong="H05892"\w* \w gate|strong="H08179"\w*. \w And over it|strong="H05921"\w* \w they raised|strong="H06965"\w* \w a large|strong="H01419"\w* \w pile|strong="H01530"\w* \w of rocks|strong="H00068"\w*, \w which remains to|strong="H05704"\w* \w this|strong="H02088"\w* \w day|strong="H03117"\w*.
\s1 Joshua Renews the Covenant
\p \v 30 \w At that time|strong="H00227"\w* \w Joshua|strong="H03091"\w* \w built|strong="H01129"\w* \w an altar|strong="H04196"\w* \w on Mount|strong="H02022"\w* \w Ebal|strong="H05858"\w* \w to the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \v 31 \w just as|strong="H00834"\w* \w Moses|strong="H04872"\w* \w the servant|strong="H05650"\w* \w of the LORD|strong="H03068"\w* \w had commanded|strong="H06680"\w* \w the Israelites|strong="H01121"\w*. \w He built it according to what is written|strong="H03789"\w* \w in the Book|strong="H05612"\w* \w of the Law|strong="H08451"\w* \w of Moses|strong="H04872"\w*: “\w an altar|strong="H04196"\w* \w of uncut|strong="H08003"\w* \w stones|strong="H00068"\w* \w on|strong="H05921"\w* \w which|strong="H00834"\w* \w no|strong="H03808"\w* \w iron tool|strong="H01270"\w* \w has been used|strong="H05130"\w*.”\f + \fr 8:31 \ft Exodus 20:25; Deuteronomy 27:5\f* \w And on it|strong="H05921"\w* \w they offered|strong="H05927"\w* \w burnt offerings|strong="H05930"\w* \w to the LORD|strong="H03068"\w*, \w and they sacrificed|strong="H02076"\w* \w peace offerings|strong="H08002"\w*.
\p \v 32 \w And there|strong="H08033"\w* \w in the presence|strong="H06440"\w* \w of the Israelites|strong="H03478"\w*, \w Joshua inscribed|strong="H03789"\w* \w on|strong="H05921"\w* \w the stones|strong="H00068"\w* \w a copy|strong="H04932"\w* \w of the law|strong="H08451"\w* \w of Moses|strong="H04872"\w*, \w which|strong="H00834"\w* \w he had written|strong="H03789"\w*. \v 33 \w All|strong="H03605"\w* \w Israel|strong="H03478"\w*, \w foreigners|strong="H01616"\w* \w and citizens alike|strong="H00249"\w*, \w with their elders|strong="H02205"\w*, \w officers|strong="H07860"\w*, \w and judges|strong="H08199"\w*, \w stood|strong="H05975"\w* \w on both sides|strong="H02088"\w* \w of the ark|strong="H00727"\w* \w of the covenant|strong="H01285"\w* \w of the LORD|strong="H03068"\w* \w facing|strong="H05048"\w* \w the Levitical|strong="H03881"\w* \w priests|strong="H03548"\w* \w who carried|strong="H05375"\w* \w it|strong="H00727"\w*. \w Half of the people stood|strong="H02677"\w* \w in|strong="H00413"\w* \w front|strong="H04136"\w* \w of Mount|strong="H02022"\w* \w Gerizim|strong="H01630"\w* \w and half of them|strong="H02677"\w* \w in|strong="H00413"\w* \w front|strong="H04136"\w* \w of Mount|strong="H02022"\w* \w Ebal|strong="H05858"\w*, \w as|strong="H00834"\w* \w Moses|strong="H04872"\w* \w the servant|strong="H05650"\w* \w of the LORD|strong="H03068"\w* \w had commanded|strong="H06680"\w* \w earlier|strong="H07223"\w*, \w to bless|strong="H01288"\w* \w the people|strong="H05971"\w* \w of Israel|strong="H03478"\w*.
\p \v 34 \w Afterward|strong="H00310"\w*, \w Joshua read aloud|strong="H07121"\w* \w all|strong="H03605"\w* \w the words|strong="H01697"\w* \w of the law|strong="H08451"\w*— \w the blessings|strong="H01293"\w* \w and the curses|strong="H07045"\w*— \w according to all|strong="H03605"\w* \w that is written|strong="H03789"\w* \w in the Book|strong="H05612"\w* \w of the Law|strong="H08451"\w*. \v 35 \w There was|strong="H01961"\w* \w not|strong="H03808"\w* \w a word|strong="H01697"\w* \w of all|strong="H03605"\w* \w that|strong="H00834"\w* \w Moses|strong="H04872"\w* \w had commanded|strong="H06680"\w* \w that|strong="H00834"\w* \w Joshua|strong="H03091"\w* \w failed|strong="H03808"\w* \w to read|strong="H07121"\w* \w before|strong="H05048"\w* \w the whole|strong="H03605"\w* \w assembly|strong="H06951"\w* \w of Israel|strong="H03478"\w*, \w including the women|strong="H00802"\w*, \w the little ones|strong="H02945"\w*, \w and the foreigners|strong="H01616"\w* \w who lived|strong="H01980"\w* \w among them|strong="H07130"\w*.
\c 9
\s1 The Deceit of the Gibeonites
\p \v 1 \w Now when|strong="H01961"\w* \w news of this reached|strong="H08085"\w* \w all|strong="H03605"\w* \w the kings|strong="H04428"\w* \w west|strong="H05676"\w* \w of the Jordan|strong="H03383"\w* — \w those|strong="H00834"\w* \w in the hill country|strong="H02022"\w*, \w the foothills|strong="H08219"\w*,\f + \fr 9:1 \ft Hebrew \fqa Shephelah \ft or \fqa lowlands\ft ; that is, the western foothills of Judea\f* \w and all|strong="H03605"\w* \w along the coast|strong="H02348"\w* \w of the Great|strong="H01419"\w* \w Sea|strong="H03220"\w*\f + \fr 9:1 \ft That is, the Mediterranean Sea\f* \w toward|strong="H00413"\w* \w Lebanon|strong="H03844"\w* (\w the Hittites|strong="H02850"\w*, \w Amorites|strong="H00567"\w*, \w Canaanites|strong="H03669"\w*, \w Perizzites|strong="H06522"\w*, \w Hivites|strong="H02340"\w*, \w and Jebusites|strong="H02983"\w*)— \v 2 \w they came|strong="H06908"\w* \w together|strong="H03162"\w* \w to wage war|strong="H03898"\w* \w against|strong="H05973"\w* \w Joshua|strong="H03091"\w* \w and Israel|strong="H03478"\w*.
\p \v 3 \w But the people|strong="H03427"\w* \w of Gibeon|strong="H01391"\w*, \w having heard|strong="H08085"\w* \w what|strong="H00834"\w* \w Joshua|strong="H03091"\w* \w had done|strong="H06213"\w* \w to Jericho|strong="H03405"\w* \w and Ai|strong="H05857"\w*, \v 4 \w acted deceptively|strong="H06213"\w* \w and set out|strong="H01980"\w* \w as envoys|strong="H06737"\w*,\f + \fr 9:4 \ft Or \fqa set out with provisions\f* \w carrying|strong="H03947"\w* \w on their donkeys|strong="H02543"\w* \w worn-out|strong="H01087"\w* \w sacks|strong="H08242"\w* \w and old|strong="H01087"\w* \w wineskins|strong="H04997"\w*, \w cracked|strong="H01234"\w* \w and mended|strong="H06887"\w*. \v 5 \w They put worn|strong="H01087"\w*, \w patched|strong="H02921"\w* \w sandals|strong="H05275"\w* \w on their feet|strong="H07272"\w* \w and threadbare|strong="H01087"\w* \w clothing|strong="H08008"\w* \w on their bodies|strong="H05921"\w*, \w and their whole|strong="H03605"\w* \w supply|strong="H06718"\w* \w of bread|strong="H03899"\w* \w was dry|strong="H03001"\w* \w and moldy|strong="H05350"\w*. \v 6 \w They went|strong="H01980"\w* \w to|strong="H00413"\w* \w Joshua|strong="H03091"\w* \w in|strong="H00413"\w* \w the camp|strong="H04264"\w* \w at Gilgal|strong="H01537"\w* \w and said|strong="H00559"\w* \w to him|strong="H00413"\w* \w and|strong="H00413"\w* \w the men|strong="H00376"\w* \w of Israel|strong="H03478"\w*, “\w We have come|strong="H00935"\w* \w from a distant|strong="H07350"\w* \w land|strong="H00776"\w*; \w please make|strong="H03772"\w* \w a treaty|strong="H01285"\w*\f + \fr 9:6 \ft Forms of the Hebrew \fqa berit \ft are translated in most passages as \fqa covenant\ft ; also in verses 7, 11, 15, and 16.\f* with us.”
\p \v 7 \w But the men|strong="H00376"\w* \w of Israel|strong="H03478"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w the Hivites|strong="H02340"\w*, “\w Perhaps|strong="H00194"\w* \w you|strong="H00859"\w* \w dwell|strong="H03427"\w* \w near us|strong="H07130"\w*. \w How|strong="H00349"\w* \w can we make|strong="H03772"\w* \w a treaty with you|strong="H01285"\w*?”
\p \v 8 “\w We|strong="H00587"\w* \w are your servants|strong="H05650"\w*,” \w they said|strong="H00559"\w* \w to|strong="H00413"\w* \w Joshua|strong="H03091"\w*.
\p \w Then Joshua|strong="H03091"\w* \w asked them|strong="H00559"\w*, “\w Who|strong="H04310"\w* \w are you|strong="H00859"\w* \w and where|strong="H00370"\w* \w have you come from|strong="H00935"\w*?”
\p \v 9 “\w Your servants|strong="H05650"\w* \w have come|strong="H00935"\w* \w from a very|strong="H03966"\w* \w distant|strong="H07350"\w* \w land|strong="H00776"\w*,” \w they replied|strong="H00559"\w*, “\w because of the fame|strong="H08034"\w* \w of the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*. \w For|strong="H03588"\w* \w we have heard|strong="H08085"\w* \w the reports about Him|strong="H08089"\w*: \w all|strong="H03605"\w* \w that|strong="H00834"\w* \w He did|strong="H06213"\w* \w in Egypt|strong="H04714"\w*, \v 10 \w and|strong="H00853"\w* \w all|strong="H03605"\w* \w that|strong="H00834"\w* \w He did|strong="H06213"\w* \w to the two|strong="H08147"\w* \w kings|strong="H04428"\w* \w of the Amorites|strong="H00567"\w* \w beyond|strong="H05676"\w* \w the Jordan|strong="H03383"\w*— \w Sihon|strong="H05511"\w* \w king|strong="H04428"\w* \w of Heshbon|strong="H02809"\w* \w and Og|strong="H05747"\w* \w king|strong="H04428"\w* \w of Bashan|strong="H01316"\w*, \w who|strong="H00834"\w* \w reigned in Ashtaroth|strong="H06252"\w*. \v 11 \w So the elders|strong="H02205"\w* \w and|strong="H03605"\w* \w inhabitants|strong="H03427"\w* \w of our land|strong="H00776"\w* \w told|strong="H00559"\w* \w us|strong="H00413"\w*, ‘\w Take|strong="H03947"\w* \w provisions|strong="H06720"\w* \w for your journey|strong="H01870"\w*; \w go|strong="H01980"\w* \w to meet them|strong="H07122"\w* \w and say|strong="H00559"\w* \w to them|strong="H00413"\w*: \w We|strong="H00587"\w* \w are your servants|strong="H05650"\w*. \w Please make|strong="H03772"\w* \w a treaty|strong="H01285"\w* with us.’
\p \v 12 \w This|strong="H02088"\w* \w bread|strong="H03899"\w* \w of ours was warm|strong="H02525"\w* \w when we packed|strong="H06679"\w* \w it|strong="H00853"\w* \w at home|strong="H01004"\w* \w on the day|strong="H03117"\w* \w we left|strong="H03318"\w* \w to come|strong="H01980"\w* \w to you|strong="H00413"\w*. \w But look|strong="H02009"\w*, \w it is now|strong="H06258"\w* \w dry|strong="H03001"\w* \w and|strong="H01961"\w* \w moldy|strong="H05350"\w*. \v 13 \w These|strong="H00428"\w* \w wineskins|strong="H04997"\w* \w were new|strong="H02319"\w* \w when we filled|strong="H04390"\w* \w them|strong="H00834"\w*, \w but look|strong="H02009"\w*, \w they are cracked|strong="H01234"\w*. \w And these|strong="H00428"\w* \w clothes|strong="H08008"\w* \w and sandals|strong="H05275"\w* \w are worn out|strong="H01086"\w* \w from our very|strong="H03966"\w* \w long|strong="H07230"\w* \w journey|strong="H01870"\w*.”
\p \v 14 \w Then the men of Israel|strong="H00582"\w* \w sampled|strong="H03947"\w* \w their provisions|strong="H06718"\w* \w but did not|strong="H03808"\w* \w seek|strong="H07592"\w* \w the counsel|strong="H06310"\w* \w of the LORD|strong="H03068"\w*. \v 15 \w And Joshua|strong="H03091"\w* \w made|strong="H06213"\w* \w a treaty|strong="H01285"\w* \w of peace|strong="H07965"\w* with them \w to let them live|strong="H02421"\w*, \w and the leaders|strong="H05387"\w* \w of the congregation|strong="H05712"\w* \w swore an oath|strong="H07650"\w* to them.
\p \v 16 \w Three|strong="H07969"\w* \w days|strong="H03117"\w* \w after|strong="H00310"\w* \w they had made|strong="H03772"\w* \w the treaty|strong="H01285"\w* with the Gibeonites, \w the Israelites learned|strong="H08085"\w* \w that|strong="H03588"\w* \w they were|strong="H01992"\w* \w neighbors|strong="H07138"\w*, \w living|strong="H03427"\w* \w among them|strong="H07130"\w*. \v 17 \w So the Israelites|strong="H01121"\w* \w set out|strong="H05265"\w* \w and on the third|strong="H07992"\w* \w day|strong="H03117"\w* \w arrived|strong="H00935"\w* \w at their cities|strong="H05892"\w* — \w Gibeon|strong="H01391"\w*, \w Chephirah|strong="H03716"\w*, \w Beeroth|strong="H00881"\w*, \w and Kiriath-jearim|strong="H07157"\w*. \v 18 \w But the Israelites|strong="H01121"\w* \w did not|strong="H03808"\w* \w attack them|strong="H05221"\w*, \w because|strong="H03588"\w* \w the leaders|strong="H05387"\w* \w of the congregation|strong="H05712"\w* \w had sworn an oath|strong="H07650"\w* to them \w by the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*. \w And the whole|strong="H03605"\w* \w congregation|strong="H05712"\w* \w grumbled|strong="H03885"\w* \w against|strong="H05921"\w* \w the leaders|strong="H05387"\w*.
\p \v 19 \w All|strong="H03605"\w* \w the leaders|strong="H05387"\w* \w answered|strong="H00559"\w*, “\w We|strong="H00587"\w* \w have sworn an oath|strong="H07650"\w* to them \w by the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w and now|strong="H06258"\w* \w we cannot|strong="H03808"\w* \w touch|strong="H05060"\w* them. \v 20 \w This|strong="H02063"\w* \w is how we will treat|strong="H06213"\w* them: \w We will let them live|strong="H02421"\w*, \w so that no|strong="H03808"\w* \w wrath|strong="H07110"\w* \w will fall|strong="H01961"\w* \w on us|strong="H05921"\w* \w because of|strong="H05921"\w* \w the oath|strong="H07621"\w* \w we swore|strong="H07650"\w* to them.” \v 21 \w They|strong="H05387"\w* \w continued|strong="H00559"\w*, “\w Let them live|strong="H02421"\w*, \w but let them be|strong="H01961"\w* \w woodcutters|strong="H02404"\w* \w and water|strong="H04325"\w* \w carriers|strong="H07579"\w* \w for the whole|strong="H03605"\w* \w congregation|strong="H05712"\w*.” \w So|strong="H00834"\w* \w the leaders|strong="H05387"\w* \w kept their promise|strong="H01696"\w*.
\p \v 22 \w Then Joshua|strong="H03091"\w* \w summoned|strong="H07121"\w* the Gibeonites \w and said|strong="H01696"\w*, “\w Why|strong="H04100"\w* \w did you deceive|strong="H07411"\w* \w us|strong="H00853"\w* \w by telling us|strong="H00559"\w* \w you live far away|strong="H07350"\w* from \w us|strong="H00587"\w*, \w when in fact you|strong="H00859"\w* \w live|strong="H03427"\w* \w among us|strong="H07130"\w*? \v 23 \w Now therefore|strong="H06258"\w* \w you|strong="H00859"\w* \w are under a curse|strong="H00779"\w* \w and will perpetually|strong="H03808"\w* \w serve|strong="H05650"\w* \w as woodcutters|strong="H02404"\w* \w and water|strong="H04325"\w* \w carriers|strong="H07579"\w* \w for the house|strong="H01004"\w* \w of my God|strong="H00430"\w*.”
\p \v 24 \w The Gibeonites answered|strong="H06030"\w*, “\w Your servants|strong="H05650"\w* \w were told clearly|strong="H05046"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w had commanded|strong="H06680"\w* \w His servant|strong="H05650"\w* \w Moses|strong="H04872"\w* \w to give|strong="H05414"\w* you \w all|strong="H03605"\w* \w the land|strong="H00776"\w* \w and wipe out|strong="H08045"\w* \w all|strong="H03605"\w* \w its inhabitants|strong="H03427"\w* \w before you|strong="H06440"\w*. \w So we greatly|strong="H03966"\w* \w feared|strong="H03372"\w* \w for our lives|strong="H05315"\w* \w because of you|strong="H06440"\w*, \w and that is why we have done|strong="H06213"\w* \w this|strong="H02088"\w*. \v 25 \w Now|strong="H06258"\w* \w we are in your hands|strong="H03027"\w*. \w Do|strong="H06213"\w* to us \w whatever seems|strong="H05869"\w* \w good|strong="H02896"\w* \w and right|strong="H03477"\w* \w to you|strong="H06213"\w*.”
\p \v 26 \w So|strong="H03651"\w* \w Joshua did this|strong="H06213"\w* \w and delivered|strong="H05337"\w* \w them|strong="H00853"\w* \w from the hands|strong="H03027"\w* \w of the Israelites|strong="H03478"\w*, \w and they did not|strong="H03808"\w* \w kill the Gibeonites|strong="H02026"\w*. \v 27 \w On that|strong="H01931"\w* \w day|strong="H03117"\w* \w he|strong="H03091"\w* \w made them|strong="H05414"\w* \w woodcutters|strong="H02404"\w* \w and water|strong="H04325"\w* \w carriers|strong="H07579"\w*, \w as they are to this day|strong="H05704"\w* \w for the congregation|strong="H05712"\w* \w of the LORD|strong="H03068"\w* \w and for the altar|strong="H04196"\w* \w at|strong="H00413"\w* \w the place|strong="H04725"\w* \w He would choose|strong="H00977"\w*.
\c 10
\s1 The Day the Sun Stood Still
\p \v 1 \w Now|strong="H01961"\w* \w Adoni-zedek|strong="H00139"\w* \w king|strong="H04428"\w* \w of Jerusalem|strong="H03389"\w* \w heard|strong="H08085"\w* \w that|strong="H03588"\w* \w Joshua|strong="H03091"\w* \w had captured|strong="H03920"\w* \w Ai|strong="H05857"\w* \w and devoted it to destruction|strong="H02763"\w*\f + \fr 10:1 \ft Forms of the Hebrew \fqa cherem \ft refer to the giving over of things or persons to the LORD, either by destroying them or by giving them as an offering; also in verses 28, 35, 37, 39, and 40.\f* — \w doing to|strong="H06213"\w* \w Ai|strong="H05857"\w* \w and its king|strong="H04428"\w* \w as|strong="H00834"\w* \w he had done to|strong="H06213"\w* \w Jericho|strong="H03405"\w* \w and its king|strong="H04428"\w* — \w and that|strong="H03588"\w* \w the people|strong="H03427"\w* \w of Gibeon|strong="H01391"\w* \w had made peace|strong="H07999"\w* \w with|strong="H00854"\w* \w Israel|strong="H03478"\w* \w and were living|strong="H01961"\w* \w near them|strong="H07130"\w*. \v 2 \w So Adoni-zedek and his people were greatly|strong="H03966"\w* \w alarmed|strong="H03372"\w*, \w because|strong="H03588"\w* \w Gibeon|strong="H01391"\w* \w was a great|strong="H01419"\w* \w city|strong="H05892"\w*, \w like one|strong="H00259"\w* \w of the royal|strong="H04467"\w* \w cities|strong="H05892"\w*; \w it|strong="H01931"\w* \w was larger|strong="H01419"\w* \w than|strong="H04480"\w* \w Ai|strong="H05857"\w*, \w and all|strong="H03605"\w* \w its men|strong="H00582"\w* \w were mighty|strong="H01368"\w*.
\p \v 3 \w Therefore Adoni-zedek|strong="H00139"\w* \w king|strong="H04428"\w* \w of Jerusalem|strong="H03389"\w* \w sent|strong="H07971"\w* \w word to|strong="H00413"\w* \w Hoham|strong="H01944"\w* \w king|strong="H04428"\w* \w of Hebron|strong="H02275"\w*, \w Piram|strong="H06502"\w* \w king|strong="H04428"\w* \w of Jarmuth|strong="H03412"\w*, \w Japhia|strong="H03309"\w* \w king|strong="H04428"\w* \w of Lachish|strong="H03923"\w*, \w and Debir|strong="H01688"\w* \w king|strong="H04428"\w* \w of Eglon|strong="H05700"\w*, \w saying|strong="H00559"\w*, \v 4 “\w Come up|strong="H05927"\w* \w and help me|strong="H05826"\w*. \w We will attack|strong="H05221"\w* \w Gibeon|strong="H01391"\w*, \w because|strong="H03588"\w* \w they have made peace|strong="H07999"\w* \w with|strong="H00854"\w* \w Joshua|strong="H03091"\w* \w and the Israelites|strong="H01121"\w*.”
\p \v 5 \w So the five|strong="H02568"\w* \w kings|strong="H04428"\w* \w of the Amorites|strong="H00567"\w*— \w the kings|strong="H04428"\w* \w of Jerusalem|strong="H03389"\w*, \w Hebron|strong="H02275"\w*, \w Jarmuth|strong="H03412"\w*, \w Lachish|strong="H03923"\w*, \w and Eglon|strong="H05700"\w*— \w joined forces|strong="H00622"\w* \w and advanced|strong="H05927"\w* \w with all|strong="H03605"\w* \w their armies|strong="H04264"\w*. \w They camped|strong="H02583"\w* \w before|strong="H05921"\w* \w Gibeon|strong="H01391"\w* \w and made war|strong="H03898"\w* \w against it|strong="H05921"\w*.
\p \v 6 \w Then the men|strong="H00582"\w* \w of Gibeon|strong="H01391"\w* \w sent|strong="H07971"\w* \w word to|strong="H00413"\w* \w Joshua|strong="H03091"\w* \w in|strong="H00413"\w* \w the camp|strong="H04264"\w* \w at Gilgal|strong="H01537"\w*: “\w Do not|strong="H00408"\w* \w abandon|strong="H07503"\w* \w your servants|strong="H05650"\w*. \w Come|strong="H05927"\w* \w quickly|strong="H04120"\w* \w and save|strong="H03467"\w* us! \w Help us|strong="H05826"\w*, \w because|strong="H03588"\w* \w all|strong="H03605"\w* \w the kings|strong="H04428"\w* \w of the Amorites|strong="H00567"\w* \w from|strong="H03427"\w* \w the hill country|strong="H02022"\w* \w have joined forces|strong="H06908"\w* \w against us|strong="H00413"\w*.”
\p \v 7 \w So Joshua|strong="H03091"\w* \w and his whole|strong="H03605"\w* \w army|strong="H04421"\w*, \w including all|strong="H03605"\w* \w the mighty men|strong="H01368"\w* \w of valor|strong="H02428"\w*, \w came|strong="H05927"\w* \w from|strong="H04480"\w* \w Gilgal|strong="H01537"\w*.
\p \v 8 \w The LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Joshua|strong="H03091"\w*, “\w Do not|strong="H00408"\w* \w be afraid|strong="H03372"\w* of them, \w for|strong="H03588"\w* \w I have delivered them|strong="H05414"\w* \w into your hand|strong="H03027"\w*. \w Not|strong="H03808"\w* \w one|strong="H00376"\w* of them \w shall stand|strong="H05975"\w* \w against you|strong="H06440"\w*.”
