\s1 Conquest of the Northern Cities
\p \v 1 \w Now when|strong="H01961"\w* \w Jabin|strong="H02985"\w* \w king|strong="H04428"\w* \w of Hazor|strong="H02674"\w* \w heard about these things|strong="H08085"\w*, \w he sent word|strong="H07971"\w* \w to|strong="H00413"\w* \w Jobab|strong="H03103"\w* \w king|strong="H04428"\w* \w of Madon|strong="H04068"\w*; \w to|strong="H00413"\w* \w the kings|strong="H04428"\w* \w of Shimron|strong="H08110"\w* \w and Achshaph|strong="H00407"\w*; \v 2 \w to|strong="H00413"\w* \w the kings|strong="H04428"\w* \w of the north|strong="H06828"\w* \w in the mountains|strong="H02022"\w*, \w in the Arabah|strong="H06160"\w* \w south|strong="H05045"\w* \w of Chinnereth|strong="H03672"\w*, \w in the foothills|strong="H08219"\w*,\f + \fr 11:2 \ft Hebrew \fqa Shephelah \ft or \fqa lowlands\ft ; that is, the western foothills of Judea; also in verse 16\f* \w and in Naphoth-dor|strong="H05316"\w*\f + \fr 11:2 \ft Or \fqa in the heights of Dor\ft ; \fqa Naphoth-dor \ft is a variant of \fqa Naphath-dor\ft ; see Joshua 12:23.\f* \w to the west|strong="H03220"\w*; \v 3 \w to the Canaanites|strong="H03669"\w* \w in the east|strong="H04217"\w* \w and west|strong="H03220"\w*; \w to the Amorites|strong="H00567"\w*, \w Hittites|strong="H02850"\w*, \w Perizzites|strong="H06522"\w*, \w and Jebusites|strong="H02983"\w* \w in the hill country|strong="H02022"\w*; \w and to the Hivites|strong="H02340"\w* \w at the foot of|strong="H08478"\w* \w Hermon|strong="H02768"\w* \w in the land|strong="H00776"\w* \w of Mizpah|strong="H04709"\w*.
\p \v 4 \w So these kings|strong="H01992"\w* \w came out|strong="H03318"\w* \w with|strong="H05973"\w* \w all|strong="H03605"\w* \w their armies|strong="H04264"\w*, \w a multitude|strong="H05971"\w* \w as numerous|strong="H07227"\w* \w as the sand|strong="H02344"\w* \w on|strong="H05921"\w* \w the seashore|strong="H08193"\w*, \w along with a great number|strong="H07227"\w* \w of horses|strong="H05483"\w* \w and chariots|strong="H07393"\w*. \v 5 \w All|strong="H03605"\w* \w these|strong="H00428"\w* \w kings|strong="H04428"\w* \w joined forces|strong="H03259"\w* \w and encamped|strong="H02583"\w* \w at|strong="H00413"\w* \w the waters|strong="H04325"\w* \w of Merom|strong="H04792"\w* \w to fight|strong="H03898"\w* \w against|strong="H05973"\w* \w Israel|strong="H03478"\w*.
\p \v 6 \w Then the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Joshua|strong="H03091"\w*, “\w Do not|strong="H00408"\w* \w be afraid|strong="H03372"\w* \w of them|strong="H06440"\w*, \w for|strong="H03588"\w* \w by this|strong="H02063"\w* \w time|strong="H06256"\w* \w tomorrow|strong="H04279"\w* \w I|strong="H00595"\w* \w will deliver|strong="H05414"\w* \w all of them|strong="H03605"\w* \w slain|strong="H02491"\w* \w before|strong="H06440"\w* \w Israel|strong="H03478"\w*. \w You are to hamstring|strong="H06131"\w* \w their horses|strong="H05483"\w* \w and|strong="H00853"\w* \w burn up|strong="H08313"\w* \w their chariots|strong="H04818"\w*.”
\p \v 7 \w So by|strong="H05921"\w* \w the waters|strong="H04325"\w* \w of Merom|strong="H04792"\w*, \w Joshua|strong="H03091"\w* \w and his whole|strong="H03605"\w* \w army|strong="H04421"\w* \w came|strong="H00935"\w* \w upon them|strong="H05921"\w* \w suddenly|strong="H06597"\w* \w and attacked|strong="H05307"\w* them, \v 8 \w and the LORD|strong="H03068"\w* \w delivered them|strong="H05414"\w* \w into the hand|strong="H03027"\w* \w of Israel|strong="H03478"\w*, \w who struck them down|strong="H05221"\w* \w and pursued them|strong="H07291"\w* \w all the way to|strong="H05704"\w* \w Greater|strong="H07227"\w* \w Sidon|strong="H06721"\w* \w and Misrephoth-maim|strong="H04956"\w*, \w and eastward|strong="H04217"\w* \w as far as|strong="H05704"\w* \w the Valley|strong="H01237"\w* \w of Mizpeh|strong="H04708"\w*. \w They struck them down|strong="H05221"\w*, \w leaving|strong="H07604"\w* \w no|strong="H01115"\w* \w survivors|strong="H08300"\w*. \v 9 \w Joshua|strong="H03091"\w* \w treated|strong="H06213"\w* them \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had told|strong="H00559"\w* him; \w he hamstrung|strong="H06131"\w* \w their horses|strong="H05483"\w* \w and burned up|strong="H08313"\w* \w their chariots|strong="H04818"\w*.
\p \v 10 \w At that|strong="H01931"\w* \w time|strong="H06256"\w* \w Joshua|strong="H03091"\w* \w turned back|strong="H07725"\w* \w and captured|strong="H03920"\w* \w Hazor|strong="H02674"\w* \w and put|strong="H05221"\w* \w its king|strong="H04428"\w* \w to the sword|strong="H02719"\w*, \w because|strong="H03588"\w* \w Hazor|strong="H02674"\w* \w was|strong="H01931"\w* \w formerly|strong="H06440"\w* \w the head|strong="H07218"\w* \w of all|strong="H03605"\w* \w these|strong="H00428"\w* \w kingdoms|strong="H04467"\w*. \v 11 \w The Israelites put|strong="H05221"\w* \w everyone|strong="H03605"\w* in Hazor \w to the sword|strong="H02719"\w*, \w devoting them to destruction|strong="H02763"\w*.\f + \fr 11:11 \ft Forms of the Hebrew \fqa cherem \ft refer to the giving over of things or persons to the LORD, either by destroying them or by giving them as an offering; also in verses 12, 20, and 21.\f* \w Nothing|strong="H03808"\w* \w that breathed|strong="H05397"\w* \w remained|strong="H03498"\w*, \w and|strong="H00853"\w* \w Joshua burned down|strong="H08313"\w* \w Hazor itself|strong="H02674"\w*.
\p \v 12 \w Joshua|strong="H03091"\w* \w captured|strong="H03920"\w* \w all|strong="H03605"\w* \w these|strong="H00428"\w* \w kings|strong="H04428"\w* \w and their cities|strong="H05892"\w* \w and put them|strong="H05221"\w* \w to the sword|strong="H02719"\w*. \w He devoted them to destruction|strong="H02763"\w*, \w as|strong="H00834"\w* \w Moses|strong="H04872"\w* \w the LORD’s|strong="H03068"\w* \w servant|strong="H05650"\w* \w had commanded|strong="H06680"\w*. \v 13 \w Yet|strong="H07535"\w* \w Israel|strong="H03478"\w* \w did not|strong="H03808"\w* \w burn|strong="H08313"\w* \w any|strong="H03605"\w* \w of the cities|strong="H05892"\w* \w built|strong="H05975"\w* \w on|strong="H05921"\w* \w their mounds|strong="H08510"\w*, \w except|strong="H02108"\w* \w Hazor|strong="H02674"\w*, \w which Joshua|strong="H03091"\w* \w burned|strong="H08313"\w*.
\p \v 14 \w The Israelites|strong="H01121"\w* \w took for themselves|strong="H00962"\w* \w all|strong="H03605"\w* \w the plunder|strong="H07998"\w* \w and livestock|strong="H00929"\w* \w of these|strong="H00428"\w* \w cities|strong="H05892"\w*, \w but|strong="H07535"\w* \w they put|strong="H05221"\w* \w all|strong="H03605"\w* \w the people|strong="H00120"\w* \w to the sword|strong="H02719"\w* \w until|strong="H05704"\w* \w they had completely destroyed them|strong="H08045"\w*, \w not sparing anyone|strong="H07604"\w* \w who breathed|strong="H05397"\w*. \v 15 \w As|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had commanded|strong="H06680"\w* \w His servant|strong="H05650"\w* \w Moses|strong="H04872"\w*, \w so|strong="H03651"\w* \w Moses|strong="H04872"\w* \w commanded|strong="H06680"\w* \w Joshua|strong="H03091"\w*. \w That is what|strong="H03651"\w* \w Joshua|strong="H03091"\w* \w did|strong="H06213"\w*, \w leaving nothing|strong="H03808"\w* \w undone|strong="H05493"\w* \w of all|strong="H03605"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had commanded|strong="H06680"\w* \w Moses|strong="H04872"\w*.
\s1 Joshua Takes the Whole Land
\p \v 16 \w So Joshua|strong="H03091"\w* \w took|strong="H03947"\w* \w this|strong="H02063"\w* \w entire|strong="H03605"\w* \w region|strong="H00776"\w*: \w the hill country|strong="H02022"\w*, \w all|strong="H03605"\w* \w the Negev|strong="H05045"\w*, \w all|strong="H03605"\w* \w the land|strong="H00776"\w* \w of Goshen|strong="H01657"\w*, \w the western foothills|strong="H08219"\w*, \w the Arabah|strong="H06160"\w*, \w and the mountains|strong="H02022"\w* \w of Israel|strong="H03478"\w* \w and their foothills|strong="H08219"\w*, \v 17 \w from|strong="H04480"\w* \w Mount|strong="H02022"\w* \w Halak|strong="H02510"\w*, \w which rises|strong="H05927"\w* \w toward Seir|strong="H08165"\w*, \w as far as|strong="H05704"\w* \w Baal-gad|strong="H01171"\w* \w in the Valley|strong="H01237"\w* \w of Lebanon|strong="H03844"\w* \w at the foot of|strong="H08478"\w* \w Mount|strong="H02022"\w* \w Hermon|strong="H02768"\w*. \w He captured|strong="H03920"\w* \w all|strong="H03605"\w* \w their kings|strong="H04428"\w* \w and struck them down|strong="H05221"\w*, \w putting them to death|strong="H04191"\w*.
\p \v 18 \w Joshua|strong="H03091"\w* \w waged|strong="H06213"\w* \w war|strong="H04421"\w* \w against all|strong="H03605"\w* \w these|strong="H00428"\w* \w kings|strong="H04428"\w* \w for a long period|strong="H07227"\w* \w of time|strong="H03117"\w*. \v 19 \w No|strong="H03808"\w* \w city|strong="H05892"\w* \w made peace|strong="H07999"\w* \w with|strong="H00413"\w* \w the Israelites|strong="H01121"\w* \w except|strong="H01115"\w* \w the Hivites|strong="H02340"\w* \w living|strong="H03427"\w* \w in Gibeon|strong="H01391"\w*; \w all|strong="H03605"\w* \w others were taken|strong="H03947"\w* \w in battle|strong="H04421"\w*. \v 20 \w For|strong="H03588"\w* \w it was|strong="H01961"\w* \w of|strong="H00854"\w* \w the LORD|strong="H03068"\w* \w to harden|strong="H02388"\w*\f + \fr 11:20 \ft Or \fqa stiffen \ft or \fqa strengthen\f* \w their hearts|strong="H03820"\w* \w to engage|strong="H07122"\w* \w Israel|strong="H03478"\w* \w in battle|strong="H04421"\w*, \w so that they would be set apart for destruction|strong="H02763"\w* \w and would receive|strong="H01961"\w* \w no|strong="H01115"\w* \w mercy|strong="H08467"\w*, \w being annihilated|strong="H08045"\w* \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had commanded|strong="H06680"\w* \w Moses|strong="H04872"\w*.
\p \v 21 \w At that|strong="H01931"\w* \w time|strong="H06256"\w* \w Joshua|strong="H03091"\w* \w proceeded|strong="H00935"\w* \w to eliminate|strong="H03772"\w* \w the Anakim|strong="H06062"\w* \w from|strong="H04480"\w* \w the hill country|strong="H02022"\w* \w of Hebron|strong="H02275"\w*, \w Debir|strong="H01688"\w*, \w and Anab|strong="H06024"\w*, \w and from all|strong="H03605"\w* \w the hill country|strong="H02022"\w* \w of Judah|strong="H03063"\w* \w and of Israel|strong="H03478"\w*. \w Joshua|strong="H03091"\w* \w devoted them to destruction|strong="H02763"\w*, \w along with|strong="H05973"\w* \w their cities|strong="H05892"\w*. \v 22 \w No|strong="H03808"\w* \w Anakim|strong="H06062"\w* \w were left|strong="H03498"\w* \w in the land|strong="H00776"\w* \w of the Israelites|strong="H03478"\w*; \w only|strong="H07535"\w* \w in Gaza|strong="H05804"\w*, \w Gath|strong="H01661"\w*, \w and Ashdod|strong="H00795"\w* \w did any survive|strong="H07604"\w*.
\p \v 23 \w So Joshua|strong="H03091"\w* \w took|strong="H03947"\w* \w the entire|strong="H03605"\w* \w land|strong="H00776"\w*, \w in keeping with all|strong="H03605"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had spoken|strong="H01696"\w* \w to Moses|strong="H04872"\w*. \w And Joshua|strong="H03091"\w* \w gave|strong="H05414"\w* \w it as an inheritance|strong="H05159"\w* \w to Israel|strong="H03478"\w* \w according to the allotments|strong="H04256"\w* \w to their tribes|strong="H07626"\w*. \w Then the land|strong="H00776"\w* \w had rest|strong="H08252"\w* \w from war|strong="H04421"\w*.
\c 12
\s1 The Kings Defeated East of the Jordan
\p \v 1 \w Now these are|strong="H00428"\w* \w the kings|strong="H04428"\w* \w of the land|strong="H00776"\w* \w whom the Israelites|strong="H01121"\w* \w struck down|strong="H05221"\w* \w and whose|strong="H00834"\w* \w lands|strong="H00776"\w* \w they took|strong="H03423"\w* \w beyond|strong="H05676"\w* \w the Jordan|strong="H03383"\w* \w to the east|strong="H04217"\w*, \w from the Arnon|strong="H00769"\w* \w Valley|strong="H05158"\w* \w to|strong="H05704"\w* \w Mount|strong="H02022"\w* \w Hermon|strong="H02768"\w*, \w including all|strong="H03605"\w* \w the Arabah|strong="H06160"\w* \w eastward|strong="H04217"\w*:
\b 
\li1 \v 2 \w Sihon|strong="H05511"\w* \w king|strong="H04428"\w* \w of the Amorites|strong="H00567"\w*, \w who lived|strong="H03427"\w* \w in Heshbon|strong="H02809"\w*. \w He ruled|strong="H04910"\w* \w from Aroer|strong="H06177"\w* \w on|strong="H05921"\w* \w the rim|strong="H08193"\w* \w of the Arnon|strong="H00769"\w* \w Valley|strong="H05158"\w*, \w along the middle|strong="H08432"\w* \w of the valley|strong="H05158"\w*, \w up to|strong="H05704"\w* \w the Jabbok|strong="H02999"\w* \w River|strong="H05158"\w* (\w the border|strong="H01366"\w* \w of the|strong="H01121"\w* \w Ammonites|strong="H05983"\w*), \w that is, half|strong="H02677"\w* \w of Gilead|strong="H01568"\w*, \v 3 \w as well as the Arabah|strong="H06160"\w* \w east|strong="H04217"\w* \w of the Sea|strong="H03220"\w* \w of Chinnereth|strong="H03672"\w*\f + \fr 12:3 \ft That is, the Sea of Galilee\f* \w to|strong="H05704"\w* \w the Sea|strong="H03220"\w* \w of the Arabah|strong="H06160"\w* \w (the Salt Sea|strong="H03220"\w*\f + \fr 12:3 \ft That is, the Dead Sea\f*), \w eastward|strong="H04217"\w* \w through|strong="H01870"\w* \w Beth-jeshimoth|strong="H01020"\w*, \w and southward|strong="H08486"\w* \w below|strong="H08478"\w* \w the slopes|strong="H00794"\w* \w of Pisgah|strong="H06449"\w*.
\li1 \v 4 \w And|strong="H01366"\w* \w Og|strong="H05747"\w* \w king|strong="H04428"\w* \w of Bashan|strong="H01316"\w*,\f + \fr 12:4 \ft LXX; Hebrew \fqa And the territory of Og king of Bashan\f* \w one of the remnant|strong="H03499"\w* \w of the Rephaim|strong="H07497"\w*, \w who lived|strong="H03427"\w* \w in Ashtaroth|strong="H06252"\w* \w and Edrei|strong="H00154"\w*. \v 5 \w He ruled|strong="H04910"\w* \w over Mount|strong="H02022"\w* \w Hermon|strong="H02768"\w*, \w Salecah|strong="H05548"\w*, \w all|strong="H03605"\w* \w of Bashan|strong="H01316"\w* \w up to|strong="H05704"\w* \w the border|strong="H01366"\w* \w of the Geshurites|strong="H01651"\w* \w and Maacathites|strong="H04602"\w*, \w and half|strong="H02677"\w* \w of Gilead|strong="H01568"\w* \w to the border|strong="H01366"\w* \w of Sihon|strong="H05511"\w* \w king|strong="H04428"\w* \w of Heshbon|strong="H02809"\w*.
\p \v 6 \w Moses|strong="H04872"\w*, \w the servant|strong="H05650"\w* \w of the LORD|strong="H03068"\w*, \w and the Israelites|strong="H01121"\w* \w had struck them down|strong="H05221"\w* \w and|strong="H04872"\w* \w given|strong="H05414"\w* \w their land as an inheritance|strong="H03425"\w* \w to the Reubenites|strong="H07206"\w*, \w the Gadites|strong="H01425"\w*, \w and the half-tribe|strong="H02677"\w* \w of Manasseh|strong="H04519"\w*.
