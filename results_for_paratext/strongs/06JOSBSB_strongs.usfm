\s1 Joshua Takes Charge
\p \v 10 \w Then Joshua|strong="H03091"\w* \w commanded|strong="H06680"\w* \w the officers|strong="H07860"\w* \w of the people|strong="H05971"\w*: \v 11 “\w Go|strong="H05674"\w* \w through|strong="H07130"\w* \w the camp|strong="H04264"\w* \w and tell|strong="H06680"\w* \w the people|strong="H05971"\w*, ‘\w Prepare|strong="H03559"\w* your \w provisions|strong="H06720"\w*, \w for|strong="H03588"\w* \w within|strong="H05750"\w* \w three|strong="H07969"\w* \w days|strong="H03117"\w* \w you|strong="H00859"\w* \w will cross|strong="H05674"\w* \w the|strong="H02088"\w* \w Jordan|strong="H03383"\w* \w to go in|strong="H00935"\w* \w and take possession of|strong="H03423"\w* \w the land|strong="H00776"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w is giving|strong="H05414"\w* you \w to possess|strong="H03423"\w*.’”
\p \v 12 \w But to the Reubenites|strong="H07206"\w*, \w the Gadites|strong="H01425"\w*, \w and the half-tribe|strong="H02677"\w* \w of Manasseh|strong="H04519"\w*, \w Joshua|strong="H03091"\w* \w said|strong="H00559"\w*, \v 13 “\w Remember|strong="H02142"\w* \w what|strong="H00834"\w* \w Moses|strong="H04872"\w* \w the servant|strong="H05650"\w* \w of the LORD|strong="H03068"\w* \w commanded|strong="H06680"\w* \w you|strong="H00853"\w* \w when he said|strong="H00559"\w*, ‘\w The LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w will give you rest|strong="H05117"\w*, \w and He will give|strong="H05414"\w* you \w this|strong="H02063"\w* \w land|strong="H00776"\w*.’ \v 14 \w Your wives|strong="H00802"\w*, \w your young children|strong="H02945"\w*, \w and your livestock|strong="H04735"\w* \w may remain|strong="H03427"\w* \w in the land|strong="H00776"\w* \w that|strong="H00834"\w* \w Moses|strong="H04872"\w* \w gave|strong="H05414"\w* you \w on this side|strong="H05676"\w* \w of the Jordan|strong="H03383"\w*. \w But all|strong="H03605"\w* \w your mighty men|strong="H01368"\w* \w of valor|strong="H02428"\w* \w must be armed for battle|strong="H02571"\w* \w to cross over|strong="H05674"\w* \w ahead of|strong="H06440"\w* \w your brothers|strong="H00251"\w* \w and help them|strong="H05826"\w*, \v 15 \w until|strong="H05704"\w* \w the LORD|strong="H03068"\w* \w gives them rest|strong="H05117"\w* as He has done for you, \w and your brothers|strong="H01992"\w* \w also|strong="H01571"\w* \w possess|strong="H03423"\w* \w the land|strong="H00776"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w is giving|strong="H05414"\w* them. \w Then you may return|strong="H07725"\w* \w to the land|strong="H00776"\w* \w of your inheritance|strong="H03425"\w* \w and take possession of|strong="H03423"\w* \w that which|strong="H00834"\w* \w Moses|strong="H04872"\w* \w the servant|strong="H05650"\w* \w of the LORD|strong="H03068"\w* \w gave|strong="H05414"\w* you \w on the east|strong="H04217"\w* \w side|strong="H05676"\w* \w of the Jordan|strong="H03383"\w*.”
\p \v 16 \w So they answered|strong="H06030"\w* \w Joshua|strong="H03091"\w*, “\w Everything|strong="H03605"\w* \w you have commanded us|strong="H06680"\w* \w we will do|strong="H06213"\w*, \w and everywhere|strong="H00413"\w* \w you send us|strong="H07971"\w* \w we will go|strong="H01980"\w*. \v 17 \w Just as|strong="H00834"\w* \w we obeyed|strong="H08085"\w* \w Moses|strong="H04872"\w* \w in all things|strong="H03605"\w*, \w so we will obey you|strong="H08085"\w*. \w And may the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w be|strong="H01961"\w* \w with you|strong="H05973"\w*, \w as|strong="H00834"\w* \w He was|strong="H01961"\w* \w with|strong="H05973"\w* \w Moses|strong="H04872"\w*. \v 18 \w Anyone|strong="H03605"\w* \w who|strong="H00834"\w* \w rebels|strong="H04784"\w* \w against your order|strong="H06310"\w* \w and does not|strong="H03808"\w* \w obey|strong="H08085"\w* \w your words|strong="H01697"\w*, \w all|strong="H03605"\w* \w that|strong="H00834"\w* \w you command him|strong="H06680"\w*, \w will be put to death|strong="H04191"\w*. \w Above all|strong="H07535"\w*, \w be strong|strong="H02388"\w* \w and courageous|strong="H00553"\w*!”
