\q1 \w at the cost of his firstborn|strong="H01060"\w*
\q2 \w he will lay its foundations|strong="H03245"\w*;
\q1 \w at the cost of his youngest|strong="H06810"\w*
\q2 \w he will set up|strong="H05324"\w* \w its gates|strong="H01817"\w*.”\f + \fr 6:26 \ft See 1 Kings 16:34.\f*
\p \v 27 \w So the LORD|strong="H03068"\w* \w was|strong="H01961"\w* \w with|strong="H00854"\w* \w Joshua|strong="H03091"\w*, \w and his fame|strong="H08089"\w* \w spread|strong="H01961"\w* \w throughout|strong="H03605"\w* \w the land|strong="H00776"\w*.
\c 7
\s1 The Defeat at Ai
\p \v 1 \w The Israelites|strong="H01121"\w*, \w however|strong="H03478"\w*, \w acted|strong="H04603"\w* \w unfaithfully|strong="H04604"\w* \w regarding the things devoted to destruction|strong="H02764"\w*.\f + \fr 7:1 \ft Forms of the Hebrew \fqa cherem \ft refer to the giving over of things or persons to the LORD, either by destroying them or by giving them as an offering; also in verses 11, 12, 13, and 15.\f* \w Achan|strong="H05912"\w*\f + \fr 7:1 \fqa Achan \ft means \fqa troubler\ft ; also called \fqa Achar\ft in 1 Chronicles 2:7.\f* \w son|strong="H01121"\w* \w of Carmi|strong="H03756"\w*, \w the son|strong="H01121"\w* \w of Zabdi|strong="H02067"\w*,\f + \fr 7:1 \fqa Zabdi \ft is a variant of \fqa Zimri\ft ; also in verses 17 and 18; see LXX and 1 Chronicles 2:6.\f* \w the son|strong="H01121"\w* \w of Zerah|strong="H02226"\w*, \w of the tribe|strong="H04294"\w* \w of Judah|strong="H03063"\w*, \w took|strong="H03947"\w* \w some of|strong="H04480"\w* \w what was set apart|strong="H02764"\w*. \w So the anger|strong="H00639"\w* \w of the LORD|strong="H03068"\w* \w burned|strong="H02734"\w* \w against the Israelites|strong="H01121"\w*.
\p \v 2 \w Meanwhile, Joshua|strong="H03091"\w* \w sent|strong="H07971"\w* \w men|strong="H00582"\w* \w from Jericho|strong="H03405"\w* \w to Ai|strong="H05857"\w*, \w which|strong="H00834"\w* \w is near|strong="H05973"\w* \w Beth-aven|strong="H01007"\w* \w to the east|strong="H06924"\w* \w of Bethel|strong="H01008"\w*, \w and told them|strong="H00559"\w*, “\w Go up|strong="H05927"\w* \w and spy out|strong="H07270"\w* \w the land|strong="H00776"\w*.” \w So the men|strong="H00582"\w* \w went up|strong="H05927"\w* \w and spied out|strong="H07270"\w* \w Ai|strong="H05857"\w*.
\p \v 3 \w On returning|strong="H07725"\w* \w to|strong="H00413"\w* \w Joshua|strong="H03091"\w*, \w they reported|strong="H00559"\w*, “\w There is no need|strong="H00408"\w* \w to send all|strong="H03605"\w* \w the people|strong="H05971"\w*; \w two|strong="H00505"\w* \w or|strong="H00176"\w* \w three|strong="H07969"\w* \w thousand|strong="H00505"\w* \w men are enough|strong="H00376"\w* \w to go up|strong="H05927"\w* \w and attack|strong="H05221"\w* \w Ai|strong="H05857"\w*. \w Since|strong="H03588"\w* \w the people of Ai|strong="H01992"\w* \w are so few|strong="H04592"\w*, \w you need not|strong="H00408"\w* \w wear out|strong="H03021"\w* \w all|strong="H03605"\w* \w our people|strong="H05971"\w* \w there|strong="H08033"\w*.”
\p \v 4 \w So about three|strong="H07969"\w* \w thousand|strong="H00505"\w* \w men|strong="H00376"\w* \w went up|strong="H05927"\w*, \w but they fled|strong="H05127"\w* \w before|strong="H06440"\w* \w the men|strong="H00582"\w* \w of Ai|strong="H05857"\w*. \v 5 \w And the men|strong="H00376"\w* \w of Ai|strong="H05857"\w* \w struck down|strong="H05221"\w* \w about thirty-six of them|strong="H07970"\w*, \w chasing them|strong="H07291"\w* \w from|strong="H06440"\w* \w the gate|strong="H08179"\w* \w as far as|strong="H05704"\w* \w the quarries|strong="H07671"\w*\f + \fr 7:5 \ft Or \fqa as far as Shebarim\f* \w and striking them down|strong="H05221"\w* \w on the slopes|strong="H04174"\w*. \w So the hearts|strong="H03824"\w* \w of the people|strong="H05971"\w* \w melted|strong="H04549"\w* \w and became|strong="H01961"\w* \w like water|strong="H04325"\w*.
\p \v 6 \w Then Joshua|strong="H03091"\w* \w tore|strong="H07167"\w* \w his clothes|strong="H08071"\w* \w and fell|strong="H05307"\w* \w facedown|strong="H06440"\w* \w before|strong="H06440"\w* \w the ark|strong="H00727"\w* \w of the LORD|strong="H03068"\w* \w until|strong="H05704"\w* \w evening|strong="H06153"\w*, \w as did the elders|strong="H02205"\w* \w of Israel|strong="H03478"\w*; \w and they all sprinkled|strong="H05927"\w* \w dust|strong="H06083"\w* \w on|strong="H05921"\w* \w their heads|strong="H07218"\w*.
\p \v 7 “\w O|strong="H00162"\w*, \w Lord|strong="H00136"\w* \w GOD|strong="H03069"\w*,” \w Joshua|strong="H03091"\w* \w said|strong="H00559"\w*, “\w why|strong="H04100"\w* \w did You ever bring|strong="H05674"\w* \w this|strong="H02088"\w* \w people|strong="H05971"\w* \w across the Jordan|strong="H03383"\w* \w to deliver|strong="H05414"\w* \w us|strong="H00853"\w* \w into the hand|strong="H03027"\w* \w of the Amorites|strong="H00567"\w* \w to be destroyed|strong="H00006"\w*? \w If only|strong="H03863"\w* \w we had been content|strong="H02974"\w* \w to stay|strong="H03427"\w* \w on the other side|strong="H05676"\w* \w of the Jordan|strong="H03383"\w*! \v 8 \w O|strong="H00994"\w* \w Lord|strong="H00136"\w*, \w what|strong="H04100"\w* \w can I say|strong="H00559"\w*, \w now that|strong="H00310"\w* \w Israel|strong="H03478"\w* \w has turned|strong="H02015"\w* \w its back|strong="H06203"\w* \w and run from|strong="H06440"\w* \w its enemies|strong="H00341"\w*? \v 9 \w When the Canaanites|strong="H03669"\w* \w and all|strong="H03605"\w* \w who live|strong="H03427"\w* \w in the land|strong="H00776"\w* \w hear about this|strong="H08085"\w*, \w they will surround|strong="H05437"\w* \w us|strong="H05921"\w* \w and wipe out|strong="H03772"\w* \w our name|strong="H08034"\w* \w from|strong="H04480"\w* \w the earth|strong="H00776"\w*. \w Then what|strong="H04100"\w* \w will You do|strong="H06213"\w* \w for Your great|strong="H01419"\w* \w name|strong="H08034"\w*?”
\p \v 10 \w But the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Joshua|strong="H03091"\w*, “\w Stand up|strong="H06965"\w*! \w Why|strong="H04100"\w* \w have you|strong="H00859"\w* \w fallen|strong="H05307"\w* \w on|strong="H05921"\w* \w your face|strong="H06440"\w*? \v 11 \w Israel|strong="H03478"\w* \w has sinned|strong="H02398"\w*; \w they have transgressed|strong="H05674"\w* \w My covenant|strong="H01285"\w* \w that|strong="H00834"\w* \w I commanded|strong="H06680"\w* \w them|strong="H00853"\w*, \w and they|strong="H01571"\w* \w have taken|strong="H03947"\w* \w some of|strong="H04480"\w* \w what was devoted to destruction|strong="H02764"\w*. \w Indeed|strong="H01571"\w*, \w they have stolen|strong="H01589"\w* \w and|strong="H01571"\w* \w lied|strong="H03584"\w*, \w and|strong="H01571"\w* \w they have put these things|strong="H07760"\w* \w with their own possessions|strong="H03627"\w*. \v 12 \w This is why the Israelites|strong="H01121"\w* \w cannot|strong="H03808"\w* \w stand|strong="H06965"\w* \w against|strong="H06440"\w* \w their enemies|strong="H00341"\w*. \w They will turn|strong="H06437"\w* \w their backs|strong="H06203"\w* \w and run from|strong="H06440"\w* \w their enemies|strong="H00341"\w*, \w because|strong="H03588"\w* \w they themselves have been|strong="H01961"\w* \w set apart for destruction|strong="H02764"\w*. \w I will no|strong="H03808"\w* \w longer|strong="H03254"\w* \w be|strong="H01961"\w* \w with|strong="H05973"\w* \w you unless|strong="H00518"\w* \w you remove|strong="H08045"\w* \w from among you|strong="H07130"\w* \w whatever is devoted to destruction|strong="H02764"\w*.
\p \v 13 \w Get up|strong="H06965"\w* \w and consecrate|strong="H06942"\w* \w the people|strong="H05971"\w*, \w saying|strong="H00559"\w*, ‘\w Consecrate yourselves|strong="H06942"\w* \w for tomorrow|strong="H04279"\w*, \w for|strong="H03588"\w* \w this is what|strong="H03541"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w says|strong="H00559"\w*: \w Among you|strong="H07130"\w*, \w O Israel|strong="H03478"\w*, \w there are things devoted to destruction|strong="H02764"\w*. \w You cannot|strong="H03808"\w* \w stand|strong="H06965"\w* \w against|strong="H06440"\w* \w your enemies|strong="H00341"\w* \w until|strong="H05704"\w* \w you remove|strong="H05493"\w* \w them|strong="H02764"\w*. \v 14 \w In the morning|strong="H01242"\w* \w you must present yourselves|strong="H07126"\w* \w tribe by tribe|strong="H07626"\w*. \w The tribe|strong="H07626"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w selects|strong="H03920"\w* \w shall come forward|strong="H07126"\w* \w clan by clan|strong="H04940"\w*, \w and the clan|strong="H04940"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w selects|strong="H03920"\w* \w shall come forward|strong="H07126"\w* \w family by family|strong="H01004"\w*, \w and the family|strong="H01004"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w selects|strong="H03920"\w* \w shall come forward|strong="H07126"\w* \w man by man|strong="H01397"\w*. \v 15 \w The one who is caught|strong="H03920"\w* \w with the things devoted to destruction|strong="H02764"\w* \w must be burned|strong="H08313"\w*, \w along with all|strong="H00853"\w* \w that belongs to him|strong="H03605"\w*, \w because|strong="H03588"\w* \w he has transgressed|strong="H05674"\w* \w the covenant|strong="H01285"\w* \w of the LORD|strong="H03068"\w* \w and|strong="H03588"\w* \w committed|strong="H06213"\w* \w an outrage|strong="H05039"\w* \w in Israel|strong="H03478"\w*.’”
\s1 The Sin of Achan
\p \v 16 \w So Joshua|strong="H03091"\w* \w arose early|strong="H07925"\w* \w the next morning|strong="H01242"\w* \w and had Israel|strong="H03478"\w* \w come forward|strong="H07126"\w* \w tribe by tribe|strong="H07626"\w*, \w and the tribe|strong="H07626"\w* \w of Judah|strong="H03063"\w* \w was selected|strong="H03920"\w*. \v 17 \w He had the clans|strong="H04940"\w* \w of Judah|strong="H03063"\w* \w come forward|strong="H07126"\w*, \w and the clan|strong="H04940"\w* \w of the Zerahites|strong="H02227"\w* \w was selected|strong="H03920"\w*. \w He had the clan|strong="H04940"\w* \w of the Zerahites|strong="H02227"\w* \w come forward|strong="H07126"\w*, \w and the family|strong="H01397"\w* \w of Zabdi|strong="H02067"\w* \w was selected|strong="H03920"\w*. \v 18 \w And he had the family of Zabdi|strong="H01004"\w* \w come forward|strong="H07126"\w* \w man by man|strong="H01397"\w*, \w and Achan|strong="H05912"\w* \w son|strong="H01121"\w* \w of Carmi|strong="H03756"\w*, \w the son|strong="H01121"\w* \w of Zabdi|strong="H02067"\w*, \w the son|strong="H01121"\w* \w of Zerah|strong="H02226"\w*, \w of the tribe|strong="H04294"\w* \w of Judah|strong="H03063"\w*, \w was selected|strong="H03920"\w*.
\p \v 19 \w So Joshua|strong="H03091"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Achan|strong="H05912"\w*, “\w My son|strong="H01121"\w*, \w give|strong="H07760"\w* \w glory|strong="H03519"\w* \w to the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w and make|strong="H05414"\w* \w a confession|strong="H08426"\w* to Him. \w I urge you|strong="H04994"\w* \w to tell|strong="H05046"\w* me \w what|strong="H04100"\w* \w you have done|strong="H06213"\w*; \w do not|strong="H00408"\w* \w hide it|strong="H03582"\w* \w from me|strong="H04480"\w*.”
\p \v 20 “\w It is true|strong="H00546"\w*,” \w Achan|strong="H05912"\w* \w replied|strong="H06030"\w*, “\w I|strong="H00595"\w* \w have sinned|strong="H02398"\w* \w against the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*. \w This|strong="H02063"\w* \w is what I did|strong="H06213"\w*: \v 21 \w When I saw|strong="H07200"\w* \w among the spoils|strong="H07998"\w* \w a|strong="H00259"\w* \w beautiful|strong="H02896"\w* \w cloak|strong="H00155"\w* \w from Shinar|strong="H08152"\w*,\f + \fr 7:21 \ft That is, Babylonia \f* \w two hundred|strong="H03967"\w* \w shekels|strong="H08255"\w* \w of silver|strong="H03701"\w*,\f + \fr 7:21 \fqa 200 shekels \ft is approximately 5 pounds or 2.3 kilograms of silver.\f* \w and a|strong="H00259"\w* \w bar|strong="H03956"\w* \w of gold|strong="H02091"\w* \w weighing|strong="H04948"\w* \w fifty|strong="H02572"\w* \w shekels|strong="H08255"\w*,\f + \fr 7:21 \fqa 50 shekels \ft is approximately 1.26 pounds or 569.8 grams of gold.\f* \w I coveted them|strong="H02530"\w* \w and took them|strong="H03947"\w*. \w They are|strong="H02009"\w* \w hidden|strong="H02934"\w* \w in the ground|strong="H00776"\w* \w inside|strong="H08432"\w* \w my tent|strong="H00168"\w*, \w with the silver|strong="H03701"\w* \w underneath|strong="H08478"\w*.”
\p \v 22 \w So Joshua|strong="H03091"\w* \w sent|strong="H07971"\w* \w messengers|strong="H04397"\w* \w who ran|strong="H07323"\w* \w to the tent|strong="H00168"\w*, \w and there it all was|strong="H02009"\w*, \w hidden|strong="H02934"\w* \w in his tent|strong="H00168"\w*, \w with the silver|strong="H03701"\w* \w underneath|strong="H08478"\w*. \v 23 \w They took the things|strong="H03947"\w* \w from inside|strong="H08432"\w* \w the tent|strong="H00168"\w*, \w brought them|strong="H00935"\w* \w to|strong="H00413"\w* \w Joshua|strong="H03091"\w* \w and all|strong="H03605"\w* \w the Israelites|strong="H01121"\w*, \w and spread them out|strong="H03332"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w*.
\p \v 24 \w Then Joshua|strong="H03091"\w*, \w together with|strong="H05973"\w* \w all|strong="H03605"\w* \w Israel|strong="H03478"\w*, \w took|strong="H03947"\w* \w Achan|strong="H05912"\w* \w son|strong="H01121"\w* \w of Zerah|strong="H02226"\w*, \w the silver|strong="H03701"\w*, \w the cloak|strong="H00155"\w*, \w the bar|strong="H03956"\w* \w of gold|strong="H02091"\w*, \w his sons|strong="H01121"\w* \w and daughters|strong="H01323"\w*, \w his oxen|strong="H07794"\w* \w and|strong="H00853"\w* \w donkeys|strong="H02543"\w* \w and|strong="H00853"\w* \w sheep|strong="H06629"\w*, \w his tent|strong="H00168"\w*, \w and everything else|strong="H03605"\w* \w he owned|strong="H00834"\w*, \w and brought them|strong="H05927"\w* \w to the Valley|strong="H06010"\w* \w of Achor|strong="H05911"\w*.
\p \v 25 “\w Why|strong="H04100"\w* \w have you brought this trouble upon us|strong="H05916"\w*?” \w said|strong="H00559"\w* \w Joshua|strong="H03091"\w*. “\w Today|strong="H03117"\w* \w the LORD|strong="H03068"\w* \w will bring trouble upon you|strong="H05916"\w*!” \w And all|strong="H03605"\w* \w Israel|strong="H03478"\w* \w stoned him to death|strong="H07275"\w*. \w Then they stoned the others|strong="H05619"\w* \w and burned their bodies|strong="H08313"\w*. \v 26 \w And they heaped|strong="H06965"\w* \w over Achan|strong="H05921"\w* \w a large|strong="H01419"\w* \w pile|strong="H01530"\w* \w of rocks|strong="H00068"\w* \w that remains to|strong="H05704"\w* \w this|strong="H02088"\w* \w day|strong="H03117"\w*. \w So the LORD|strong="H03068"\w* \w turned|strong="H07725"\w* \w from His burning anger|strong="H02740"\w*. \w Therefore|strong="H05921"\w* \w that|strong="H01931"\w* \w place|strong="H04725"\w* \w is called|strong="H07121"\w* \w the Valley|strong="H06010"\w* \w of Achor|strong="H05911"\w*\f + \fr 7:26 \fqa Achor \ft means \fqa trouble\ft .\f* \w to|strong="H05704"\w* \w this|strong="H02088"\w* \w day|strong="H03117"\w*.
\c 8
\s1 The Conquest of Ai
\p \v 1 \w Then the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Joshua|strong="H03091"\w*, “\w Do not|strong="H00408"\w* \w be afraid|strong="H03372"\w* \w or discouraged|strong="H02865"\w*. \w Take|strong="H03947"\w* \w the whole|strong="H03605"\w* \w army|strong="H04421"\w* \w with you|strong="H05973"\w*, \w and go up|strong="H06965"\w* \w and attack|strong="H05927"\w* \w Ai|strong="H05857"\w*. \w See|strong="H07200"\w*, \w I have delivered|strong="H05414"\w* \w into your hand|strong="H03027"\w* \w the king|strong="H04428"\w* \w of Ai|strong="H05857"\w*, \w his people|strong="H05971"\w*, \w his city|strong="H05892"\w*, \w and|strong="H00853"\w* \w his land|strong="H00776"\w*. \v 2 \w And you shall do|strong="H06213"\w* \w to Ai|strong="H05857"\w* \w and its king|strong="H04428"\w* \w as|strong="H00834"\w* \w you did|strong="H06213"\w* \w to Jericho|strong="H03405"\w* \w and its king|strong="H04428"\w*, \w except that|strong="H07535"\w* \w you may carry off|strong="H00962"\w* \w their plunder|strong="H07998"\w* \w and livestock|strong="H00929"\w* for yourselves. \w Set up|strong="H07760"\w* \w an ambush|strong="H00693"\w* \w behind|strong="H00310"\w* \w the city|strong="H05892"\w*.”
\p \v 3 \w So Joshua|strong="H03091"\w* \w and the whole|strong="H03605"\w* \w army|strong="H04421"\w* \w set out|strong="H06965"\w* \w to attack|strong="H05927"\w* \w Ai|strong="H05857"\w*. \w Joshua|strong="H03091"\w* \w chose|strong="H00977"\w* \w 30,000|strong="H07970"\w* \w mighty men|strong="H01368"\w* \w of valor|strong="H02428"\w* \w and sent them out|strong="H07971"\w* \w at night|strong="H03915"\w* \v 4 \w with these orders|strong="H06680"\w*: “\w Pay attention|strong="H07200"\w*. \w You|strong="H00859"\w* \w are to lie in ambush|strong="H00693"\w* \w behind|strong="H00310"\w* \w the city|strong="H05892"\w*, \w not|strong="H00408"\w* \w too|strong="H03966"\w* \w far|strong="H07368"\w* \w from it|strong="H05892"\w*. \w All of you|strong="H03605"\w* \w must be|strong="H01961"\w* \w ready|strong="H03559"\w*. \v 5 \w Then I|strong="H00589"\w* \w and all|strong="H03605"\w* \w the troops|strong="H05971"\w* \w with me|strong="H00854"\w* \w will advance|strong="H07126"\w* \w on the city|strong="H05892"\w*. \w When|strong="H03588"\w* \w they come out|strong="H03318"\w* \w against us|strong="H07122"\w* \w as|strong="H00834"\w* \w they did the first time|strong="H07223"\w*, \w we will flee|strong="H05127"\w* \w from them|strong="H06440"\w*. \v 6 \w They will pursue us|strong="H03318"\w* \w until|strong="H05704"\w* \w we have drawn them away|strong="H05423"\w* \w from|strong="H04480"\w* \w the city|strong="H05892"\w*, \w for|strong="H03588"\w* \w they will say|strong="H00559"\w*, ‘\w The Israelites are running away|strong="H05127"\w* \w from us|strong="H06440"\w* \w as they did before|strong="H00834"\w*.’ \w So as we flee|strong="H05127"\w* \w from them|strong="H06440"\w*, \v 7 \w you|strong="H00859"\w* \w are to rise|strong="H06965"\w* \w from the ambush|strong="H00693"\w* \w and seize|strong="H03423"\w* \w the city|strong="H05892"\w*, \w for the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w will deliver it|strong="H05414"\w* \w into your hand|strong="H03