\p \v 8 \w Thus the Israelites|strong="H01121"\w* \w did|strong="H06213"\w* \w as|strong="H00834"\w* \w Joshua|strong="H03091"\w* \w had commanded them|strong="H06680"\w*. \w They took up|strong="H05375"\w* \w twelve|strong="H08147"\w* \w stones|strong="H00068"\w* \w from the middle|strong="H08432"\w* \w of the Jordan|strong="H03383"\w*, \w one for each|strong="H04557"\w* \w tribe|strong="H07626"\w* \w of Israel|strong="H03478"\w*, \w just as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had told|strong="H01696"\w* \w Joshua|strong="H03091"\w*; \w and they carried|strong="H05674"\w* \w them|strong="H05973"\w* \w to|strong="H00413"\w* \w the camp|strong="H04411"\w*, \w where they set them down|strong="H05117"\w*.
\p \v 9 \w Joshua also|strong="H03091"\w* \w set up|strong="H06965"\w* \w twelve|strong="H08147"\w* \w stones|strong="H00068"\w* \w in the middle|strong="H08432"\w* \w of the Jordan|strong="H03383"\w*,\f + \fr 4:9 \ft Some translators \fqa And Joshua set up the twelve stones that had been in the middle of the Jordan\f* \w in the place|strong="H08478"\w* \w where the priests|strong="H03548"\w* \w who carried|strong="H05375"\w* \w the ark|strong="H00727"\w* \w of the covenant|strong="H01285"\w* \w stood|strong="H04673"\w*. \w And the stones are|strong="H01961"\w* \w there|strong="H08033"\w* \w to|strong="H05704"\w* \w this|strong="H02088"\w* \w day|strong="H03117"\w*.
\p \v 10 \w Now the priests|strong="H03548"\w* \w who carried|strong="H05375"\w* \w the ark|strong="H00727"\w* \w remained standing|strong="H05975"\w* \w in the middle|strong="H08432"\w* \w of the Jordan|strong="H03383"\w* \w until|strong="H05704"\w* \w the people|strong="H05971"\w* \w had completed|strong="H08552"\w* \w everything|strong="H03605"\w* \w the LORD|strong="H03068"\w* \w had commanded|strong="H06680"\w* \w Joshua|strong="H03091"\w* \w to tell|strong="H01696"\w* \w them|strong="H00413"\w*, \w just as|strong="H03605"\w* \w Moses|strong="H04872"\w* \w had directed|strong="H06680"\w* \w Joshua|strong="H03091"\w*. \w The people|strong="H05971"\w* \w hurried|strong="H04116"\w* \w across|strong="H05674"\w*, \v 11 \w and after|strong="H00834"\w* \w everyone|strong="H03605"\w* \w had finished|strong="H08552"\w* \w crossing|strong="H05674"\w*, \w the priests|strong="H03548"\w* \w with the ark|strong="H00727"\w* \w of the LORD|strong="H03068"\w* \w crossed|strong="H05674"\w* \w in the sight of|strong="H06440"\w* \w the people|strong="H05971"\w*. \v 12 \w The Reubenites|strong="H01121"\w*, \w the Gadites|strong="H01121"\w*, \w and the half-tribe|strong="H02677"\w* \w of Manasseh|strong="H04519"\w* \w crossed over|strong="H05674"\w* \w before|strong="H06440"\w* \w the Israelites|strong="H01121"\w*, \w armed for battle|strong="H02571"\w* \w as|strong="H00834"\w* \w Moses|strong="H04872"\w* \w had instructed them|strong="H01696"\w*. \v 13 \w About 40,000|strong="H00705"\w* \w troops armed|strong="H02502"\w* \w for battle|strong="H04421"\w* \w crossed over|strong="H05674"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w into|strong="H00413"\w* \w the plains|strong="H06160"\w* \w of Jericho|strong="H03405"\w*.
\p \v 14 \w On that|strong="H01931"\w* \w day|strong="H03117"\w* \w the LORD|strong="H03068"\w* \w exalted|strong="H01431"\w* \w Joshua|strong="H03091"\w* \w in the sight|strong="H05869"\w* \w of all|strong="H03605"\w* \w Israel|strong="H03478"\w*, \w and they revered|strong="H03372"\w* \w him|strong="H00853"\w* \w all|strong="H03605"\w* \w the days|strong="H03117"\w* \w of his life|strong="H02416"\w*, \w just as|strong="H00834"\w* \w they had revered|strong="H03372"\w* \w Moses|strong="H04872"\w*.
\p \v 15 \w Then the LORD|strong="H03068"\w* \w said to|strong="H00559"\w* \w Joshua|strong="H03091"\w*, \v 16 “\w Command|strong="H06680"\w* \w the priests|strong="H03548"\w* \w who carry|strong="H05375"\w* \w the ark|strong="H00727"\w* \w of the Testimony|strong="H05715"\w*\f + \fr 4:16 \ft That is, \fqa the ark of the covenant\f* \w to come up|strong="H05927"\w* \w from|strong="H04480"\w* \w the Jordan|strong="H03383"\w*.”
