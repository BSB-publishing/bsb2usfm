\p \v 7 \w Above all|strong="H07535"\w*, \w be strong|strong="H02388"\w* \w and very|strong="H03966"\w* \w courageous|strong="H00553"\w*. \w Be careful|strong="H08104"\w* \w to observe|strong="H06213"\w* \w all|strong="H03605"\w* \w the law|strong="H08451"\w* \w that|strong="H00834"\w* \w My servant|strong="H05650"\w* \w Moses|strong="H04872"\w* \w commanded you|strong="H06680"\w*. \w Do not|strong="H00408"\w* \w turn|strong="H05493"\w* \w from|strong="H04480"\w* \w it to the right|strong="H03225"\w* \w or to the left|strong="H08040"\w*, \w so that|strong="H04616"\w* \w you may prosper|strong="H07919"\w* \w wherever|strong="H03605"\w* \w you go|strong="H01980"\w*. \v 8 \w This|strong="H02088"\w* \w Book|strong="H05612"\w* \w of the Law|strong="H08451"\w* \w must not|strong="H03808"\w* \w depart|strong="H04185"\w* \w from your mouth|strong="H06310"\w*; \w meditate|strong="H01897"\w* on it \w day|strong="H03119"\w* \w and night|strong="H03915"\w*, \w so that|strong="H04616"\w* \w you may be careful|strong="H08104"\w* \w to do|strong="H06213"\w* \w everything|strong="H03605"\w* \w written|strong="H03789"\w* in it. \w For|strong="H03588"\w* \w then|strong="H00227"\w* \w you will prosper|strong="H06743"\w* \w and succeed|strong="H07919"\w* \w in all you do|strong="H01870"\w*.
