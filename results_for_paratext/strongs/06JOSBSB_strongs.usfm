\li1 \v 23 \w the king|strong="H04428"\w* \w of Dor|strong="H01756"\w* \w in Naphath-dor|strong="H01756"\w*,\f + \fr 12:23 \ft Or \fqa in the heights of Dor\ft ; \fqa Naphath-dor \ft is a variant of \fqa Naphoth-dor\ft ; see Joshua 11:2.\f* \w one|strong="H00259"\w*;
\li1 \w the king|strong="H04428"\w* \w of Goiim|strong="H01471"\w* \w in Gilgal|strong="H01537"\w*,\f + \fr 12:23 \ft Hebrew; LXX \fqa Goyim in Galilee\f* \w one|strong="H00259"\w*;
\li1 \v 24 \w and the king|strong="H04428"\w* \w of Tirzah|strong="H08656"\w*, \w one|strong="H00259"\w*.
\p \w So there were thirty-one|strong="H07970"\w* \w kings|strong="H04428"\w* \w in all|strong="H03605"\w*.
\c 13
\s1 Lands Yet Unconquered
\p \v 1 \w Now Joshua|strong="H03091"\w* \w was old|strong="H02204"\w* \w and well along|strong="H00935"\w* \w in years|strong="H03117"\w*, \w and the LORD|strong="H03068"\w* \w said|strong="H00559"\w* \w to him|strong="H00413"\w*, “\w You|strong="H00859"\w* \w are old|strong="H02204"\w* \w and well along|strong="H00935"\w* \w in years|strong="H03117"\w*, \w but very|strong="H03966"\w* \w much|strong="H07235"\w* \w of the land|strong="H00776"\w* \w remains|strong="H07604"\w* \w to be possessed|strong="H03423"\w*. \v 2 \w This|strong="H02063"\w* \w is the land|strong="H00776"\w* \w that remains|strong="H07604"\w*:
\b 
\li1 \w All|strong="H03605"\w* \w the territory|strong="H01552"\w* \w of the Philistines|strong="H06430"\w* \w and the Geshurites|strong="H01651"\w*, \v 3 \w from|strong="H04480"\w* \w the Shihor|strong="H07883"\w* \w east|strong="H05921"\w* \w of Egypt|strong="H04714"\w* \w to|strong="H05704"\w* \w the territory|strong="H01366"\w* \w of Ekron|strong="H06138"\w* \w on the north|strong="H06828"\w* \w (considered|strong="H02803"\w* \w to be Canaanite territory)|strong="H03669"\w*— \w that of the five|strong="H02568"\w* \w Philistine|strong="H06430"\w* \w rulers|strong="H05633"\w* \w of Gaza|strong="H05841"\w*, \w Ashdod|strong="H00796"\w*, \w Ashkelon|strong="H00832"\w*, \w Gath|strong="H01663"\w*, \w and Ekron|strong="H06139"\w*, \w as well as that of the Avvites|strong="H05761"\w*;
\li1 \v 4 \w to the south|strong="H08486"\w*, \w all|strong="H03605"\w* \w the land|strong="H00776"\w* \w of the Canaanites|strong="H03669"\w*, \w from Mearah|strong="H04632"\w*\f + \fr 13:4 \ft Or \fqa Arah\f* \w of|strong="H00834"\w* \w the Sidonians|strong="H06722"\w* \w to|strong="H05704"\w* \w Aphek|strong="H00663"\w*, \w as far as|strong="H05704"\w* \w the border|strong="H01366"\w* \w of the Amorites|strong="H00567"\w*;
\li1 \v 5 \w the land|strong="H00776"\w* \w of the Gebalites|strong="H01382"\w*;\f + \fr 13:5 \ft Or \fqa the area of Byblos\f*
\li1 \w and all|strong="H03605"\w* \w Lebanon|strong="H03844"\w* \w to the east|strong="H04217"\w*, \w from Baal-gad|strong="H01171"\w* \w below|strong="H08478"\w* \w Mount|strong="H02022"\w* \w Hermon|strong="H02768"\w* \w to|strong="H05704"\w* \w Lebo-hamath|strong="H02574"\w*.
\p \v 6 \w All|strong="H03605"\w* \w the inhabitants|strong="H03427"\w* \w of the hill country|strong="H02022"\w* \w from|strong="H04480"\w* \w Lebanon|strong="H03844"\w* \w to|strong="H05704"\w* \w Misrephoth-maim|strong="H04956"\w* — \w all|strong="H03605"\w* \w the Sidonians|strong="H06722"\w* — \w I Myself|strong="H00595"\w* \w will drive out|strong="H03423"\w* \w before|strong="H06440"\w* \w the Israelites|strong="H01121"\w*. \w Be sure to|strong="H07535"\w* \w divide it by lot|strong="H05307"\w* \w as an inheritance|strong="H05159"\w* \w to Israel|strong="H03478"\w*, \w as|strong="H00834"\w* \w I have commanded you|strong="H06680"\w*. \v 7 \w Now therefore|strong="H06258"\w* \w divide|strong="H02505"\w* \w this|strong="H02063"\w* \w land|strong="H00776"\w* \w as an inheritance|strong="H05159"\w* \w to the nine|strong="H08672"\w* \w tribes|strong="H07626"\w* \w and the half-tribe|strong="H02677"\w* \w of Manasseh|strong="H04519"\w*.”
\s1 The Inheritance East of the Jordan
\p \v 8 \w The other half of Manasseh|strong="H05973"\w*, \w along with the Reubenites|strong="H07206"\w* \w and Gadites|strong="H01425"\w*, \w had received|strong="H03947"\w* \w the inheritance|strong="H05159"\w* \w Moses|strong="H04872"\w* \w had given|strong="H05414"\w* them \w beyond|strong="H05676"\w* \w the Jordan|strong="H03383"\w* \w to the east|strong="H04217"\w*, \w just as|strong="H00834"\w* \w Moses|strong="H04872"\w* \w the servant|strong="H05650"\w* \w of the LORD|strong="H03068"\w* \w had assigned|strong="H05414"\w* to them:
\b 
\li1 \v 9 \w The area from Aroer|strong="H06177"\w* \w on|strong="H05921"\w* \w the rim|strong="H08193"\w* \w of the Arnon|strong="H00769"\w* \w Valley|strong="H05158"\w*, \w along with the city|strong="H05892"\w* \w in the middle|strong="H08432"\w* \w of the valley|strong="H05158"\w*, \w the whole|strong="H03605"\w* \w plateau|strong="H04334"\w* \w of Medeba|strong="H04311"\w* \w as|strong="H05704"\w* \w far as Dibon|strong="H01769"\w*, \v 10 \w and all|strong="H03605"\w* \w the cities|strong="H05892"\w* \w of Sihon|strong="H05511"\w* \w king|strong="H04428"\w* \w of the Amorites|strong="H00567"\w* \w who|strong="H00834"\w* \w reigned|strong="H04427"\w* \w in Heshbon|strong="H02809"\w*, \w as far as|strong="H05704"\w* \w the border|strong="H01366"\w* \w of the Ammonites|strong="H01121"\w*;
\li1 \v 11 \w also Gilead|strong="H01568"\w* \w and the territory|strong="H01366"\w* \w of the Geshurites|strong="H01651"\w* \w and Maacathites|strong="H04602"\w*, \w all|strong="H03605"\w* \w of Mount|strong="H02022"\w* \w Hermon|strong="H02768"\w*, \w and all|strong="H03605"\w* \w Bashan|strong="H01316"\w* \w as far as|strong="H05704"\w* \w Salecah|strong="H05548"\w*— \v 12 \w the whole|strong="H03605"\w* \w kingdom|strong="H04468"\w* \w of Og|strong="H05747"\w* \w in Bashan|strong="H01316"\w*, \w who|strong="H00834"\w* \w had reigned|strong="H04427"\w* \w in Ashtaroth|strong="H06252"\w* \w and Edrei|strong="H00154"\w* \w and had remained|strong="H07604"\w* \w as a remnant|strong="H03499"\w* \w of the Rephaim|strong="H07497"\w*.
\p \w Moses|strong="H04872"\w* \w had struck them down|strong="H05221"\w* \w and dispossessed them|strong="H03423"\w*, \v 13 \w but the Israelites|strong="H01121"\w* \w did not|strong="H03808"\w* \w drive out|strong="H03423"\w* \w the Geshurites|strong="H01651"\w* \w or|strong="H00853"\w* \w the Maacathites|strong="H04602"\w*. \w So Geshur|strong="H01650"\w* \w and Maacath|strong="H04601"\w* \w dwell|strong="H03427"\w* \w among|strong="H07130"\w* \w the Israelites|strong="H03478"\w* \w to|strong="H05704"\w* \w this|strong="H02088"\w* \w day|strong="H03117"\w*.
\p \v 14 \w To the tribe|strong="H07626"\w* \w of Levi|strong="H03878"\w*, \w however|strong="H07535"\w*, \w Moses had given|strong="H05414"\w* \w no|strong="H03808"\w* \w inheritance|strong="H05159"\w*. \w The food offerings|strong="H00801"\w* \w to the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w are|strong="H01931"\w* \w their inheritance|strong="H05159"\w*, \w just as|strong="H00834"\w* \w He had promised|strong="H01696"\w* them.
\s1 Reuben’s Inheritance
\p \v 15 \w This is what Moses|strong="H04872"\w* \w had given|strong="H05414"\w* \w to the clans|strong="H04940"\w* \w of the tribe|strong="H04294"\w* \w of Reuben|strong="H07205"\w*:
\b 
\li1 \v 16 \w The territory|strong="H01366"\w* \w from Aroer|strong="H06177"\w* \w on|strong="H05921"\w* \w the rim|strong="H08193"\w* \w of the Arnon|strong="H00769"\w* \w Valley|strong="H05158"\w*, \w along with the city|strong="H05892"\w* \w in the middle|strong="H08432"\w* \w of the valley|strong="H05158"\w*, \w to the whole|strong="H03605"\w* \w plateau|strong="H04334"\w* \w beyond|strong="H05921"\w* \w Medeba|strong="H04311"\w*, \v 17 \w to Heshbon|strong="H02809"\w* \w and all|strong="H03605"\w* \w its cities|strong="H05892"\w* \w on the plateau|strong="H04334"\w*, \w including Dibon|strong="H01769"\w*, \w Bamoth-baal|strong="H01168"\w*, \w Beth-baal-meon|strong="H01010"\w*, \v 18 \w Jahaz|strong="H03096"\w*, \w Kedemoth|strong="H06932"\w*, \w Mephaath|strong="H04158"\w*, \v 19 \w Kiriathaim|strong="H07156"\w*, \w Sibmah|strong="H07643"\w*, \w Zereth-shahar|strong="H06890"\w* \w on the hill|strong="H02022"\w* \w in the valley|strong="H06010"\w*, \v 20 \w Beth-peor|strong="H01047"\w*, \w the slopes|strong="H00794"\w* \w of Pisgah|strong="H06449"\w*, \w and Beth-jeshimoth|strong="H01020"\w*— \v 21 \w all|strong="H03605"\w* \w the cities|strong="H05892"\w* \w of the plateau|strong="H04334"\w* \w and all|strong="H03605"\w* \w the kingdom|strong="H04468"\w* \w of Sihon|strong="H05511"\w* \w king|strong="H04428"\w* \w of the Amorites|strong="H00567"\w*, \w who|strong="H00834"\w* \w reigned|strong="H04427"\w* \w in Heshbon|strong="H02809"\w* \w until|strong="H00834"\w* \w Moses|strong="H04872"\w* \w killed him|strong="H05221"\w* \w and the chiefs|strong="H05387"\w* \w of Midian|strong="H04080"\w* (\w Evi|strong="H00189"\w*, \w Rekem|strong="H07552"\w*, \w Zur|strong="H06698"\w*, \w Hur|strong="H02354"\w*, \w and Reba|strong="H07254"\w*), \w the princes|strong="H05257"\w* \w of Sihon|strong="H05511"\w* \w who lived|strong="H03427"\w* \w in the land|strong="H00776"\w*.
\li1 \v 22 \w The Israelites|strong="H01121"\w* \w also killed|strong="H00853"\w* \w the diviner|strong="H07080"\w* \w Balaam|strong="H01109"\w* \w son of Beor|strong="H01160"\w* \w along with the others they put|strong="H02026"\w* \w to the sword|strong="H02719"\w*. \v 23 \w And the border|strong="H01366"\w* \w of the Reubenites|strong="H01121"\w* \w was|strong="H01961"\w* \w the bank|strong="H01366"\w* \w of the Jordan|strong="H03383"\w*.
\p \w This|strong="H02063"\w* \w was the inheritance|strong="H05159"\w* \w of the clans|strong="H04940"\w* \w of the Reubenites|strong="H01121"\w*, \w including the cities|strong="H05892"\w* \w and villages|strong="H02691"\w*.
\s1 Gad’s Inheritance
\p \v 24 \w This is what Moses|strong="H04872"\w* \w had given|strong="H05414"\w* \w to the clans|strong="H04940"\w* \w of the tribe|strong="H04294"\w* \w of Gad|strong="H01121"\w*:
\b 
\li1 \v 25 \w The territory|strong="H01366"\w* \w of Jazer|strong="H03270"\w*, \w all|strong="H03605"\w* \w the cities|strong="H05892"\w* \w of Gilead|strong="H01568"\w*, \w and half|strong="H02677"\w* \w the land|strong="H00776"\w* \w of the Ammonites|strong="H01121"\w* \w as far as|strong="H05704"\w* \w Aroer|strong="H06177"\w*, \w near|strong="H05921"\w* \w Rabbah|strong="H07237"\w*;
\li1 \v 26 \w the territory from Heshbon|strong="H02809"\w* \w to|strong="H05704"\w* \w Ramath-mizpeh|strong="H07434"\w* \w and Betonim|strong="H00993"\w*, \w and from Mahanaim|strong="H04266"\w* \w to|strong="H05704"\w* \w the border|strong="H01366"\w* \w of Debir|strong="H01688"\w*;\f + \fr 13:26 \ft LXX, Syriac, and Vulgate; Hebrew \fqa Li-debir\ft , a variant of \fqa Lo-debar\ft ; see 2 Samuel 9:4, 2 Samuel 17:27, and Amos 6:13.\f*
\li1 \v 27 \w and in the valley|strong="H06010"\w*, \w Beth-haram|strong="H01027"\w*, \w Beth-nimrah|strong="H01039"\w*, \w Succoth|strong="H05523"\w*, \w and Zaphon|strong="H06829"\w*, \w with the rest|strong="H03499"\w* \w of the kingdom|strong="H04468"\w* \w of Sihon|strong="H05511"\w* \w king|strong="H04428"\w* \w of Heshbon|strong="H02809"\w* \w (the territory|strong="H01366"\w* \w on the east|strong="H04217"\w* \w side|strong="H05676"\w* \w of the Jordan|strong="H03383"\w* \w up|strong="H05704"\w* \w to the edge|strong="H07097"\w* \w of the Sea|strong="H03220"\w* \w of Chinnereth|strong="H03672"\w*\f + \fr 13:27 \ft That is, the Sea of Galilee\f*).
\p \v 28 \w This|strong="H02063"\w* \w was the inheritance|strong="H05159"\w* \w of the clans|strong="H04940"\w* \w of the Gadites|strong="H01121"\w*, \w including the cities|strong="H05892"\w* \w and villages|strong="H02691"\w*.
\s1 Manasseh’s Eastern Inheritance
\p \v 29 \w This is what Moses|strong="H04872"\w* \w had given|strong="H05414"\w* \w to the clans|strong="H04940"\w* \w of the half-tribe|strong="H02677"\w* \w of Manasseh|strong="H04519"\w*, \w that is|strong="H01961"\w*, \w to half|strong="H02677"\w* \w the tribe|strong="H04294"\w* \w of the descendants|strong="H01121"\w* \w of Manasseh|strong="H04519"\w*:
\p \v 30 \w The territory|strong="H01366"\w* \w from Mahanaim|strong="H04266"\w* \w through all|strong="H03605"\w* \w Bashan|strong="H01316"\w*— \w all|strong="H03605"\w* \w the kingdom|strong="H04468"\w* \w of Og|strong="H05747"\w* \w king|strong="H04428"\w* \w of Bashan|strong="H01316"\w*, \w including all|strong="H03605"\w* \w the towns|strong="H02333"\w* \w of Jair|strong="H02971"\w* \w that|strong="H00834"\w* \w are in Bashan|strong="H01316"\w*, \w sixty|strong="H08346"\w* \w cities|strong="H05892"\w*; \v 31 \w half|strong="H02677"\w* \w of Gilead|strong="H01568"\w*; \w and Ashtaroth|strong="H06252"\w* \w and Edrei|strong="H00154"\w*, \w the royal|strong="H04468"\w* \w cities|strong="H05892"\w* \w of Og|strong="H05747"\w* \w in Bashan|strong="H01316"\w*.
\p \w All this was for the clans|strong="H04940"\w* \w of the descendants|strong="H01121"\w* \w of Machir|strong="H04353"\w* \w son|strong="H01121"\w* \w of Manasseh|strong="H04519"\w*, \w that is, half of|strong="H02677"\w* \w the descendants|strong="H01121"\w* \w of Machir|strong="H04353"\w*.
\p \v 32 \w These|strong="H00428"\w* \w were the portions Moses|strong="H04872"\w* \w had given them|strong="H05157"\w* \w on the plains|strong="H06160"\w* \w of Moab|strong="H04124"\w* \w beyond|strong="H05676"\w* \w the Jordan|strong="H03383"\w*, \w east|strong="H04217"\w* \w of Jericho|strong="H03405"\w*.
\p \v 33 \w To the tribe|strong="H07626"\w* \w of Levi|strong="H03878"\w*, \w however|strong="H04872"\w*, \w Moses had given|strong="H05414"\w* \w no|strong="H03808"\w* \w inheritance|strong="H05159"\w*. \w The LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*, \w is their inheritance|strong="H05159"\w*, \w just as|strong="H00834"\w* \w He had promised|strong="H01696"\w* them.
\c 14
\s1 Land Division West of the Jordan
\p \v 1 \w Now these are the portions|strong="H00428"\w* \w that|strong="H00834"\w* \w the Israelites|strong="H01121"\w* \w inherited|strong="H05157"\w* \w in the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*, \w as distributed|strong="H05157"\w* \w by Eleazar|strong="H00499"\w* \w the priest|strong="H03548"\w*, \w Joshua|strong="H03091"\w* \w son|strong="H01121"\w* \w of Nun|strong="H05126"\w*, \w and the heads|strong="H07218"\w* \w of the families|strong="H00001"\w* \w of the tribes|strong="H04294"\w* \w of Israel|strong="H03478"\w*. \v 2 \w Their inheritance|strong="H05159"\w* \w was assigned by lot|strong="H01486"\w* \w for the nine|strong="H08672"\w* \w and a half|strong="H02677"\w* \w tribes|strong="H04294"\w*, \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had commanded|strong="H06680"\w* \w through|strong="H03027"\w* \w Moses|strong="H04872"\w*. \v 3 \w For|strong="H03588"\w* \w Moses|strong="H04872"\w* \w had given|strong="H05414"\w* \w the inheritance|strong="H05159"\w* \w east of|strong="H05676"\w* \w the Jordan|strong="H03383"\w* \w to the other two|strong="H08147"\w* \w and a half|strong="H02677"\w* \w tribes|strong="H04294"\w*. \w But he granted|strong="H05414"\w* \w no|strong="H03808"\w* \w inheritance|strong="H05159"\w* \w among them|strong="H08432"\w* \w to the Levites|strong="H03881"\w*.
\p \v 4 \w The descendants|strong="H01121"\w* \w of Joseph|strong="H03130"\w* \w became|strong="H01961"\w* \w two|strong="H08147"\w* \w tribes|strong="H04294"\w*, \w Manasseh|strong="H04519"\w* \w and Ephraim|strong="H00669"\w*. \w And no|strong="H03808"\w* \w portion|strong="H02506"\w* \w of the land|strong="H00776"\w* \w was given|strong="H05414"\w* \w to the Levites|strong="H03881"\w*, \w except for|strong="H00518"\w* \w cities|strong="H05892"\w* \w in which to live|strong="H03427"\w*, \w along with pasturelands|strong="H04054"\w* \w for their flocks|strong="H04735"\w* \w and herds|strong="H07075"\w*.
\p \v 5 \w So|strong="H03651"\w* \w the Israelites|strong="H01121"\w* \w did|strong="H06213"\w* \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had commanded|strong="H06680"\w* \w Moses|strong="H04872"\w*, \w and they divided|strong="H02505"\w* \w the land|strong="H00776"\w*.
\s1 Caleb Requests Hebron
\p \v 6 \w Then the sons|strong="H01121"\w* \w of Judah|strong="H03063"\w* \w approached|strong="H05066"\w* \w Joshua|strong="H03091"\w* \w at Gilgal|strong="H01537"\w*, \w and Caleb|strong="H03612"\w* \w son|strong="H01121"\w* \w of Jephunneh|strong="H03312"\w* \w the Kenizzite|strong="H07074"\w* \w said|strong="H00559"\w* \w to him|strong="H00413"\w*, “\w You|strong="H00859"\w* \w know|strong="H03045"\w* \w what|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w* \w the man|strong="H00376"\w* \w of God|strong="H00430"\w* \w at Kadesh-barnea|strong="H06947"\w* \w about|strong="H05921"\w* \w you|strong="H00182"\w* \w and|strong="H05921"\w* \w me|strong="H00182"\w*. \v 7 \w I was|strong="H00595"\w* \w forty|strong="H00705"\w* \w years old|strong="H01121"\w* \w when Moses|strong="H04872"\w* \w the servant|strong="H05650"\w* \w of the LORD|strong="H03068"\w* \w sent|strong="H07971"\w* \w me|strong="H00853"\w* \w from|strong="H06947"\w* \w Kadesh-barnea|strong="H06947"\w* \w to spy out|strong="H07270"\w* \w the land|strong="H00776"\w*, \w and I brought back|strong="H07725"\w* \w to him|strong="H00853"\w* \w an honest|strong="H00834"\w* \w report|strong="H01697"\w*.
\p \v 8 \w Although my brothers|strong="H00251"\w* \w who|strong="H00834"\w* \w went|strong="H05927"\w* \w with me|strong="H05973"\w* \w made the hearts|strong="H03820"\w* \w of the people|strong="H05971"\w* \w melt with fear|strong="H04529"\w*, \w I|strong="H00595"\w* \w remained loyal|strong="H04390"\w* \w to|strong="H00310"\w* \w the LORD|strong="H03068"\w* \w my God|strong="H00430"\w*. \v 9 \w On that|strong="H01931"\w* \w day|strong="H03117"\w* \w Moses|strong="H04872"\w* \w swore to me|strong="H07650"\w*, \w saying|strong="H00559"\w*, ‘\w Surely|strong="H00518"\w* \w the land|strong="H00776"\w* \w on which|strong="H00834"\w* \w you have set foot|strong="H01869"\w* \w will be|strong="H01961"\w* \w an inheritance|strong="H05159"\w* to you \w and your children|strong="H01121"\w* \w forever|strong="H05704"\w*, \w because|strong="H03588"\w* \w you have wholly|strong="H04390"\w* \w followed|strong="H00310"\w* \w the LORD|strong="H03068"\w* \w my God|strong="H00430"\w*.’
\p \v 10 \w Now|strong="H06258"\w* \w behold|strong="H02009"\w*, \w as|strong="H00834"\w* \w the LORD promised|strong="H01696"\w*, \w He|strong="H03068"\w* \w has kept me alive|strong="H02421"\w* \w these|strong="H02088"\w* \w forty-five|strong="H00705"\w* \w years|strong="H08141"\w* \w since|strong="H00227"\w* \w He|strong="H03068"\w* \w spoke|strong="H01696"\w* \w this|strong="H02088"\w* \w word|strong="H01697"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*, \w while|strong="H00834"\w* \w Israel|strong="H03478"\w* \w wandered|strong="H01980"\w* \w in the wilderness|strong="H04057"\w*. \w So|strong="H06258"\w* \w here|strong="H02009"\w* \w I am today|strong="H00595"\w*, \w eighty-five|strong="H02568"\w* \w years old|strong="H01121"\w*, \v 11 \w still|strong="H05750"\w* \w as strong|strong="H02389"\w* \w today|strong="H03117"\w* \w as|strong="H00834"\w* \w I was the day|strong="H03117"\w* \w Moses|strong="H04872"\w* \w sent me out|strong="H07971"\w*. \w As my strength|strong="H03581"\w* \w was then|strong="H00227"\w*, \w so it|strong="H03581"\w* \w is now|strong="H06258"\w* \w for war|strong="H04421"\w*, \w for going out|strong="H03318"\w*, \w and for coming in|strong="H00935"\w*.
\p \v 12 \w Now therefore|strong="H06258"\w* \w give|strong="H05414"\w* me \w this|strong="H02088"\w* \w hill country|strong="H02022"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w promised me|strong="H01696"\w* \w on that|strong="H01931"\w* \w day|strong="H03117"\w*, \w for|strong="H03588"\w* \w you yourself|strong="H00859"\w* \w heard|strong="H08085"\w* \w then|strong="H03117"\w* \w that|strong="H03588"\w* \w the Anakim|strong="H06062"\w* \w were there|strong="H08033"\w*, \w with great|strong="H01419"\w* \w and fortified|strong="H01219"\w* \w cities|strong="H05892"\w*. \w Perhaps|strong="H00194"\w* \w with the LORD’s|strong="H03068"\w* \w help|strong="H00854"\w* \w I will drive them out|strong="H03423"\w*, \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w has spoken|strong="H01696"\w*.”
\p \v 13 \w Then Joshua|strong="H03091"\w* \w blessed|strong="H01288"\w* \w Caleb|strong="H03612"\w* \w son|strong="H01121"\w* \w of Jephunneh|strong="H03312"\w* \w and gave|strong="H05414"\w* \w him|strong="H00853"\w* \w Hebron|strong="H02275"\w* \w as his inheritance|strong="H05159"\w*. \v 14 \w Therefore|strong="H05921"\w* \w Hebron|strong="H02275"\w* \w belongs to|strong="H01961"\w* \w Caleb|strong="H03612"\w* \w son|strong="H01121"\w* \w of Jephunneh|strong="H03312"\w* \w the Kenizzite|strong="H07074"\w* \w as an inheritance|strong="H05159"\w* \w to|strong="H05704"\w* \w this|strong="H02088"\w* \w day|strong="H03117"\w*, \w because|strong="H03282"\w* \w he wholly|strong="H04390"\w* \w followed|strong="H00310"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*. \v 15 (\w Hebron|strong="H02275"\w* \w used to be|strong="H06440"\w* \w called|strong="H08034"\w* \w Kiriath-arba|strong="H07153"\w*, \w after Arba|strong="H01931"\w*, \w the greatest|strong="H01419"\w* \w man|strong="H00120"\w* \w among the Anakim|strong="H06062"\w*.)
\p \w Then the land|strong="H00776"\w* \w had rest|strong="H08252"\w* \w from war|strong="H04421"\w*.
\c 15
\s1 Judah’s Inheritance
\p \v 1 \w Now the allotment|strong="H01486"\w* \w for the clans|strong="H04940"\w* \w of the tribe|strong="H04294"\w* \w of Judah|strong="H03063"\w* \w extended|strong="H01961"\w* \w to|strong="H00413"\w* \w the border|strong="H01366"\w* \w of Edom|strong="H00123"\w*, \w to the Wilderness|strong="H04057"\w* \w of Zin|strong="H06790"\w* \w at the extreme|strong="H07097"\w* \w southern boundary|strong="H08486"\w*:
\b 
\li1 \v 2 Their \w southern|strong="H05045"\w* \w border|strong="H01366"\w* \w started|strong="H01961"\w* \w at the bay|strong="H03956"\w* \w on|strong="H04480"\w* \w the southern|strong="H05045"\w* \w tip|strong="H07097"\w* \w of the Salt Sea|strong="H03220"\w*,\f + \fr 15:2 \ft That is, the Dead Sea; also in verse 5\f* \v 3 \w proceeded|strong="H03318"\w* \w south|strong="H05045"\w* \w of the Ascent|strong="H04610"\w* \w of Akrabbim|strong="H04610"\w*,\f + \fr 15:3 \ft Or \fqa the Ascent of Scorpions \ft or \fqa Scorpion Pass\f* \w continued on|strong="H05674"\w* \w to Zin|strong="H06790"\w*, \w went over|strong="H05927"\w* \w to the south|strong="H05045"\w* \w of Kadesh-barnea|strong="H06947"\w*, \w ran past|strong="H05674"\w* \w Hezron|strong="H02696"\w* \w up to|strong="H05927"\w* \w Addar|strong="H00146"\w*, \w and curved|strong="H05437"\w* \w toward Karka|strong="H07173"\w*. \v 4 \w It proceeded|strong="H05674"\w* \w to Azmon|strong="H06111"\w*, \w joined the Brook|strong="H05158"\w* \w of Egypt|strong="H04714"\w*, \w and ended|strong="H08444"\w* \w at the Sea|strong="H03220"\w*.\f + \fr 15:4 \ft That is, the Mediterranean Sea, also called the Great Sea; also in verses 11, 12, and 47\f* \w This|strong="H02088"\w* \w was|strong="H01961"\w* their\f + \fr 15:4 \ft LXX; Hebrew \fqa your\f* \w southern|strong="H05045"\w* \w border|strong="H01366"\w*.
\li1 \v 5 \w The eastern|strong="H06924"\w* \w border|strong="H01366"\w* \w was the Salt Sea|strong="H03220"\w* \w as far as|strong="H05704"\w* \w the mouth|strong="H07097"\w* \w of the Jordan|strong="H03383"\w*.
\li1 \w The northern|strong="H06828"\w* \w border started|strong="H01366"\w* \w from|strong="H06285"\w* \w the bay|strong="H03956"\w* \w of the sea|strong="H03220"\w* \w at the mouth|strong="H07097"\w* \w of the Jordan|strong="H03383"\w*, \v 6 \w went up|strong="H05927"\w* \w to Beth-hoglah|strong="H01031"\w*, \w proceeded|strong="H05674"\w* \w north|strong="H06828"\w* \w of Beth-arabah|strong="H01026"\w*, \w and went up|strong="H05927"\w* \w to the Stone|strong="H00068"\w* \w of Bohan|strong="H00932"\w* \w son|strong="H01121"\w* \w of Reuben|strong="H07205"\w*. \v 7 \w Then the border|strong="H01366"\w* \w went up|strong="H05927"\w* \w to Debir|strong="H01688"\w* \w from the Valley|strong="H06010"\w* \w of Achor|strong="H05911"\w*, \w turning|strong="H06437"\w* \w north|strong="H06828"\w* \w to|strong="H00413"\w* \w Gilgal|strong="H01537"\w*, \w which|strong="H00834"\w* \w faces|strong="H05227"\w* \w the Ascent|strong="H04608"\w* \w of Adummim|strong="H00131"\w* \w south|strong="H05045"\w* \w of the ravine|strong="H05158"\w*. \w It|strong="H01366"\w* \w continued|strong="H05674"\w* \w along|strong="H00413"\w* \w the waters|strong="H04325"\w* \w of En-shemesh|strong="H05885"\w* \w and came out|strong="H01961"\w* \w at|strong="H00413"\w* \w En-rogel|strong="H05883"\w*. \v 8 \w From there the border|strong="H01366"\w* \w went up|strong="H05927"\w* \w the Valley of Ben-hinnom|strong="H01516"\w* \w along|strong="H00413"\w* \w the southern|strong="H05045"\w* \w slope|strong="H03802"\w* \w of the Jebusites|strong="H02983"\w* \w (that is|strong="H01931"\w*, \w Jerusalem|strong="H03389"\w*) \w and ascended|strong="H05927"\w* \w to|strong="H00413"\w* \w the top|strong="H07218"\w* \w of the hill|strong="H02022"\w* \w that|strong="H00834"\w* \w faces|strong="H05921"\w* \w the Valley of Hinnom|strong="H01516"\w* \w on the west|strong="H03220"\w*, \w at the northern|strong="H06828"\w* \w end|strong="H07097"\w* \w of the Valley|strong="H06010"\w* \w of Rephaim|strong="H07497"\w*. \v 9 \w From the hilltop|strong="H07218"\w* \w the border|strong="H01366"\w* \w curved|strong="H08388"\w* \w to|strong="H00413"\w* \w the spring|strong="H04599"\w* \w of the Waters|strong="H04325"\w* \w of Nephtoah|strong="H05318"\w*, \w proceeded|strong="H03318"\w* \w to|strong="H00413"\w* \w the cities|strong="H05892"\w* \w of Mount|strong="H02022"\w* \w Ephron|strong="H06085"\w*, \w and then bent around|strong="H08388"\w* \w toward Baalah|strong="H01173"\w* \w (that is|strong="H01931"\w*, \w Kiriath-jearim)|strong="H07157"\w*. \v 10 \w The border|strong="H01366"\w* \w curled|strong="H05437"\w* \w westward|strong="H03220"\w* \w from Baalah|strong="H01173"\w* \w to|strong="H00413"\w* \w Mount|strong="H02022"\w* \w Seir|strong="H08165"\w*, \w ran|strong="H05674"\w* \w along|strong="H00413"\w* \w the northern|strong="H06828"\w* \w slope|strong="H03802"\w* \w of Mount|strong="H02022"\w* \w Jearim|strong="H03297"\w* \w (that is|strong="H01931"\w*, \w Chesalon|strong="H03693"\w*), \w went down|strong="H03381"\w* \w to Beth-shemesh|strong="H01053"\w*, \w and crossed|strong="H05674"\w* \w to Timnah|strong="H08553"\w*. \v 11 \w Then it|strong="H01366"\w* \w went out|strong="H03318"\w* \w to|strong="H00413"\w* \w the northern|strong="H06828"\w* \w slope|strong="H03802"\w* \w of Ekron|strong="H06138"\w*, \w curved|strong="H08388"\w* \w toward Shikkeron|strong="H07942"\w*, \w proceeded|strong="H05674"\w* \w to Mount|strong="H02022"\w* \w Baalah|strong="H01173"\w*, \w went on|strong="H03318"\w* \w to Jabneel|strong="H02995"\w*, \w and ended|strong="H01961"\w* \w at the Sea|strong="H03220"\w*.
\li1 \v 12 \w And the western|strong="H03220"\w* \w border|strong="H01366"\w* \w was the coastline|strong="H01366"\w* \w of the Great|strong="H01419"\w* \w Sea|strong="H03220"\w*.
\p \w These|strong="H02088"\w* \w are the boundaries|strong="H01366"\w* \w around|strong="H05439"\w* \w the clans|strong="H04940"\w* \w of the descendants|strong="H01121"\w* \w of Judah|strong="H03063"\w*.
\s1 Caleb’s Portion and Conquest
\p \v 13 \w According|strong="H00413"\w* \w to the LORD’s|strong="H03068"\w* \w command|strong="H06310"\w* \w to him|strong="H03091"\w*, \w Joshua gave|strong="H05414"\w* \w Caleb|strong="H03612"\w* \w son|strong="H01121"\w* \w of Jephunneh|strong="H03312"\w* \w a portion|strong="H02506"\w* \w among|strong="H08432"\w* \w the sons|strong="H01121"\w* \w of Judah|strong="H03063"\w* — \w Kiriath-arba|strong="H07153"\w*, \w that is|strong="H01931"\w*, \w Hebron|strong="H02275"\w*. (\w Arba was the forefather|strong="H00001"\w* \w of Anak|strong="H06061"\w*.) \v 14 \w And Caleb|strong="H03612"\w* \w drove out|strong="H03423"\w* \w from there|strong="H08033"\w* \w the three|strong="H07969"\w* \w sons|strong="H01121"\w* \w of Anak|strong="H06061"\w* — \w the descendants of|strong="H00853"\w* \w Sheshai|strong="H08344"\w*, \w Ahiman|strong="H00289"\w*, \w and Talmai|strong="H08526"\w*, \w the children|strong="H03211"\w* \w of Anak|strong="H06061"\w*.
\p \v 15 \w From there|strong="H08033"\w* \w he marched|strong="H05927"\w* \w against|strong="H00413"\w* \w the inhabitants|strong="H03427"\w* \w of Debir|strong="H01688"\w* (\w formerly|strong="H06440"\w* \w known as|strong="H08034"\w* \w Kiriath-sepher|strong="H07158"\w*). \v 16 \w And Caleb|strong="H03612"\w* \w said|strong="H00559"\w*, “\w To the man who|strong="H00834"\w* \w strikes down|strong="H05221"\w* \w Kiriath-sepher|strong="H07158"\w* \w and captures it|strong="H03920"\w*, \w I will give|strong="H05414"\w* \w my daughter|strong="H01323"\w* \w Acsah|strong="H05915"\w* \w in marriage|strong="H00802"\w*.” \v 17 \w So Othniel|strong="H06274"\w* \w son|strong="H01121"\w* \w of Caleb’s|strong="H03612"\w* \w brother|strong="H00251"\w* \w Kenaz|strong="H07073"\w* \w captured the city|strong="H03920"\w*, \w and Caleb gave|strong="H05414"\w* \w his daughter|strong="H01323"\w* \w Acsah|strong="H05915"\w* to him \w in marriage|strong="H00802"\w*.
\p \v 18 \w One day|strong="H01961"\w* \w Acsah came to Othniel|strong="H00935"\w* \w and urged him|strong="H05496"\w*\f + \fr 15:18 \ft Hebrew and some LXX manuscripts; other LXX manuscripts \fqa and he urged her\ft ; see Judges 1:14.\f* \w to ask|strong="H07592"\w* \w her father|strong="H00001"\w* \w for|strong="H00854"\w* \w a field|strong="H07704"\w*. \w When she got off|strong="H06795"\w* \w her donkey|strong="H02543"\w*, \w Caleb|strong="H03612"\w* \w asked|strong="H00559"\w* her, “\w What|strong="H04100"\w* do you desire?”
\p \v 19 “\w Give|strong="H05414"\w* me \w a blessing|strong="H01293"\w*,” \w she answered|strong="H00559"\w*. “\w Since|strong="H03588"\w* \w you have given me|strong="H05414"\w* \w land|strong="H00776"\w* \w in the Negev|strong="H05045"\w*, \w give me|strong="H05414"\w* \w springs|strong="H01543"\w* \w of water|strong="H04325"\w* as well.”
\p \w So Caleb gave|strong="H05414"\w* her \w both the upper|strong="H05942"\w* \w and lower|strong="H08482"\w* \w springs|strong="H01543"\w*.
\s1 The Cities of Judah
\p \v 20 \w This|strong="H02063"\w* \w is the inheritance|strong="H05159"\w* \w of the clans|strong="H04940"\w* \w of the tribe|strong="H04294"\w* \w of Judah|strong="H03063"\w*. \v 21 \w These were|strong="H01961"\w* \w the southernmost|strong="H07097"\w* \w cities|strong="H05892"\w* \w of the tribe|strong="H04294"\w* \w of Judah|strong="H03063"\w* \w in the Negev|strong="H05045"\w* \w toward|strong="H00413"\w* \w the border|strong="H01366"\w* \w of Edom|strong="H00123"\w*:
\b 
\li1 \w Kabzeel|strong="H06909"\w*, \w Eder|strong="H05740"\w*, \w Jagur|strong="H03017"\w*, \v 22 \w Kinah|strong="H07016"\w*, \w Dimonah|strong="H01776"\w*, \w Adadah|strong="H05735"\w*, \v 23 \w Kedesh|strong="H06943"\w*, \w Hazor|strong="H02674"\w*, \w Ithnan|strong="H03497"\w*, \v 24 \w Ziph|strong="H02128"\w*, \w Telem|strong="H02928"\w*, \w Bealoth|strong="H01175"\w*, \v 25 \w Hazor-hadattah|strong="H02675"\w*, \w Kerioth-hezron|strong="H07152"\w* \w (that is|strong="H01931"\w*, \w Hazor|strong="H02674"\w*), \v 26 \w Amam|strong="H00538"\w*, \w Shema|strong="H08090"\w*, \w Moladah|strong="H04137"\w*, \v 27 \w Hazar-gaddah|strong="H02693"\w*, \w Heshmon|strong="H02829"\w*, \w Beth-pelet|strong="H01046"\w*, \v 28 \w Hazar-shual|strong="H02705"\w*, \w Beersheba|strong="H00884"\w*, \w Biziothiah|strong="H00964"\w*, \v 29 \w Baalah|strong="H01173"\w*, \w Iim|strong="H05864"\w*, \w Ezem|strong="H06107"\w*, \v 30 \w Eltolad|strong="H00513"\w*, \w Chesil|strong="H03686"\w*, \w Hormah|strong="H02767"\w*, \v 31 \w Ziklag|strong="H06860"\w*, \w Madmannah|strong="H04089"\w*, \w Sansannah|strong="H05578"\w*, \v 32 \w Lebaoth|strong="H03822"\w*, \w Shilhim|strong="H07978"\w*, \w Ain|strong="H05871"\w*, \w and Rimmon|strong="H07417"\w*— \w twenty-nine|strong="H06242"\w* \w cities|strong="H05892"\w* \w in all|strong="H03605"\w*, \w along with their villages|strong="H02691"\w*.
\p \v 33 \w These were in the foothills|strong="H08219"\w*:\f + \fr 15:33 \ft Hebrew \fqa Shephelah \ft or \fqa lowlands\ft ; that is, the western foothills of Judea\f*
\b 
\li1 \w Eshtaol|strong="H00847"\w*, \w Zorah|strong="H06881"\w*, \w Ashnah|strong="H00823"\w*, \v 34 \w Zanoah|strong="H02182"\w*, \w En-gannim|strong="H05873"\w*, \w Tappuah|strong="H08599"\w*, \w Enam|strong="H05879"\w*, \v 35 \w Jarmuth|strong="H03412"\w*, \w Adullam|strong="H05725"\w*, \w Socoh|strong="H07755"\w*, \w Azekah|strong="H05825"\w*, \v 36 \w Shaaraim|strong="H08189"\w*, \w Adithaim|strong="H05723"\w*, \w and Gederah|strong="H01449"\w* \w (or Gederothaim)|strong="H01453"\w*— \w fourteen|strong="H00702"\w* \w cities|strong="H05892"\w*, \w along with their villages|strong="H02691"\w*.
\li1 \v 37 \w Zenan|strong="H06799"\w*, \w Hadashah|strong="H02322"\w*, \w Migdal-gad|strong="H04028"\w*, \v 38 \w Dilan|strong="H01810"\w*, \w Mizpeh|strong="H04708"\w*, \w Joktheel|strong="H03371"\w*, \v 39 \w Lachish|strong="H03923"\w*, \w Bozkath|strong="H01218"\w*, \w Eglon|strong="H05700"\w*, \v 40 \w Cabbon|strong="H03522"\w*, \w Lahmas|strong="H03903"\w*, \w Chitlish|strong="H03798"\w*, \v 41 \w Gederoth|strong="H01450"\w*, \w Beth-dagon|strong="H01016"\w*, \w Naamah|strong="H05279"\w*, \w and Makkedah|strong="H04719"\w*— \w sixteen|strong="H08337"\w* \w cities|strong="H05892"\w*, \w along with their villages|strong="H02691"\w*.
\li1 \v 42 \w Libnah|strong="H03841"\w*, \w Ether|strong="H06281"\w*, \w Ashan|strong="H06228"\w*, \v 43 \w Iphtah|strong="H03316"\w*, \w Ashnah|strong="H00823"\w*, \w Nezib|strong="H05334"\w*, \v 44 \w Keilah|strong="H07084"\w*, \w Achzib|strong="H00392"\w*, \w and Mareshah|strong="H04762"\w*— \w nine|strong="H08672"\w* \w cities|strong="H05892"\w*, \w along with their villages|strong="H02691"\w*.
\li1 \v 45 \w Ekron|strong="H06138"\w*, \w with its towns|strong="H01323"\w* \w and villages|strong="H02691"\w*; \v 46 \w from Ekron|strong="H06138"\w* \w to the sea|strong="H03220"\w*, \w all|strong="H03605"\w* \w the cities|strong="H00834"\w* \w near|strong="H05921"\w* \w Ashdod|strong="H00795"\w*, \w along with their villages|strong="H02691"\w*; \v 47 \w Ashdod|strong="H00795"\w*, \w with its towns|strong="H01323"\w* \w and villages|strong="H02691"\w*; \w Gaza|strong="H05804"\w*, \w with its towns|strong="H01323"\w* \w and villages|strong="H02691"\w*, \w as far as|strong="H05704"\w* \w the Brook|strong="H05158"\w* \w of Egypt|strong="H04714"\w* \w and the coastline|strong="H01366"\w* \w of the Great|strong="H01366"\w* \w Sea|strong="H03220"\w*.
\p \v 48 \w These were in the hill country|strong="H02022"\w*:
\b 
\li1 \w Shamir|strong="H08069"\w*, \w Jattir|strong="H03492"\w*, \w Socoh|strong="H07755"\w*, \v 49 \w Dannah|strong="H01837"\w*, \w Kiriath-sannah|strong="H07158"\w* \w (that is|strong="H01931"\w*, \w Debir|strong="H01688"\w*), \v 50 \w Anab|strong="H06024"\w*, \w Eshtemoh|strong="H00851"\w*, \w Anim|strong="H06044"\w*, \v 51 \w Goshen|strong="H01657"\w*, \w Holon|strong="H02473"\w*, \w and Giloh|strong="H01542"\w*— \w eleven|strong="H00259"\w* \w cities|strong="H05892"\w*, \w along with their villages|strong="H02691"\w*.
\li1 \v 52 \w Arab|strong="H00694"\w*, \w Dumah|strong="H07316"\w*, \w Eshan|strong="H00824"\w*, \v 53 \w Janim|strong="H03241"\w*, \w Beth-tappuah|strong="H01054"\w*, \w Aphekah|strong="H00664"\w*, \v 54 \w Humtah|strong="H02547"\w*, \w Kiriath-arba|strong="H07153"\w* \w (that is|strong="H01931"\w*, \w Hebron|strong="H02275"\w*), \w and Zior|strong="H06730"\w*— \w nine|strong="H08672"\w* \w cities|strong="H05892"\w*, \w along with their villages|strong="H02691"\w*.
\li1 \v 55 \w Maon|strong="H04584"\w*, \w Carmel|strong="H03760"\w*, \w Ziph|strong="H02128"\w*, \w Juttah|strong="H03194"\w*, \v 56 \w Jezreel|strong="H03157"\w*, \w Jokdeam|strong="H03347"\w*, \w Zanoah|strong="H02182"\w*, \v 57 \w Kain|strong="H07014"\w*, \w Gibeah|strong="H01390"\w*, \w and Timnah|strong="H08553"\w*— \w ten|strong="H06235"\w* \w cities|strong="H05892"\w*, \w along with their villages|strong="H02691"\w*.
\li1 \v 58 \w Halhul|strong="H02478"\w*, \w Beth-zur|strong="H01049"\w*, \w Gedor|strong="H01446"\w*, \v 59 \w Maarath|strong="H04638"\w*, \w Beth-anoth|strong="H01042"\w*, \w and Eltekon|strong="H00515"\w*— \w six|strong="H08337"\w* \w cities|strong="H05892"\w*, \w along with their villages|strong="H02691"\w*.
\li1 \v 60 \w Kiriath-baal|strong="H07154"\w* \w (that is|strong="H01931"\w*, \w Kiriath-jearim|strong="H07157"\w*), \w and Rabbah|strong="H07237"\w*— \w two|strong="H08147"\w* \w cities|strong="H05892"\w*, \w along with their villages|strong="H02691"\w*.
\p \v 61 \w These were in the wilderness|strong="H04057"\w*:
\b 
\li1 \w Beth-arabah|strong="H01026"\w*, \w Middin|strong="H04081"\w*, \w Secacah|strong="H05527"\w*, \v 62 \w Nibshan|strong="H05044"\w*, \w the City of Salt|strong="H05898"\w*, \w and En-gedi|strong="H05872"\w*— \w six|strong="H08337"\w* \w cities|strong="H05892"\w*, \w along with their villages|strong="H02691"\w*.
\p \v 63 \w But the descendants|strong="H01121"\w* \w of Judah|strong="H03063"\w* \w could|strong="H03201"\w* \w not|strong="H03808"\w* \w drive out|strong="H03423"\w* \w the Jebusites|strong="H02983"\w* \w living|strong="H03427"\w* \w in Jerusalem|strong="H03389"\w*. \w So to|strong="H05704"\w* \w this|strong="H02088"\w* \w day|strong="H03117"\w* \w the Jebusites|strong="H02983"\w* \w live|strong="H03427"\w* \w there|strong="H03389"\w* \w among the descendants|strong="H01121"\w* \w of Judah|strong="H03063"\w*.
\c 16
\s1 Ephraim’s Inheritance
\p \v 1 \w The allotment|strong="H01486"\w* \w for the descendants|strong="H01121"\w* \w of Joseph|strong="H03130"\w* \w extended|strong="H03318"\w* \w from the Jordan|strong="H03383"\w* \w at Jericho|strong="H03405"\w* \w to the waters|strong="H04325"\w* \w of Jericho|strong="H03405"\w* \w on the east|strong="H04217"\w*, \w through the wilderness|strong="H04057"\w* \w that goes up|strong="H05927"\w* \w from Jericho|strong="H03405"\w* \w into the hill country|strong="H02022"\w* \w of Bethel|strong="H01008"\w*. \v 2 \w It went on|strong="H03318"\w* \w from|strong="H01008"\w* \w Bethel|strong="H01008"\w* \w (that is, Luz|strong="H03870"\w*)\f + \fr 16:2 \ft LXX (See also Joshua 18:13); Hebrew \fqa from Bethel to Luz\f* \w and proceeded|strong="H05674"\w* \w to|strong="H00413"\w* \w the border|strong="H01366"\w* \w of the Archites|strong="H00757"\w* \w in Ataroth|strong="H05852"\w*. \v 3 \w Then it descended|strong="H03381"\w* \w westward|strong="H03220"\w* \w to|strong="H00413"\w* \w the border|strong="H01366"\w* \w of the Japhletites|strong="H03311"\w* \w as|strong="H05704"\w* \w far as the border|strong="H01366"\w* \w of|strong="H01032"\w* \w Lower|strong="H08481"\w* \w Beth-horon|strong="H01032"\w* \w and on to|strong="H05704"\w* \w Gezer|strong="H01507"\w*, \w and it ended|strong="H01961"\w* \w at the Sea|strong="H03220"\w*.\f + \fr 16:3 \ft That is, the Mediterranean Sea, also called the Great Sea; also in verses 6 and 8\f*
\p \v 4 \w So Ephraim|strong="H00669"\w* \w and Manasseh|strong="H04519"\w*, \w the sons|strong="H01121"\w* \w of Joseph|strong="H03130"\w*, \w received their inheritance|strong="H05157"\w*. \v 5 \w This was|strong="H01961"\w* \w the territory|strong="H01366"\w* \w of the descendants|strong="H01121"\w* \w of Ephraim|strong="H00669"\w* \w by their clans|strong="H04940"\w*:
\p \w The border|strong="H01366"\w* \w of their inheritance|strong="H05159"\w* \w went from Ataroth-addar|strong="H05853"\w* \w in the east|strong="H04217"\w* \w to Upper|strong="H05945"\w* \w Beth-horon|strong="H01032"\w* \v 6 \w and out toward|strong="H03318"\w* \w the Sea|strong="H03220"\w*. \w From Michmethath|strong="H04366"\w* \w on the north|strong="H06828"\w* \w it|strong="H01366"\w* \w turned|strong="H05437"\w* \w eastward|strong="H04217"\w* \w toward Taanath-shiloh|strong="H08387"\w* \w and passed by|strong="H05674"\w* \w it|strong="H00853"\w* \w to Janoah|strong="H03239"\w* \w on the east|strong="H04217"\w*. \v 7 \w From Janoah|strong="H03239"\w* \w it went down|strong="H03381"\w* \w to Ataroth|strong="H05852"\w* \w and Naarah|strong="H05292"\w*, \w and then reached|strong="H06293"\w* \w Jericho|strong="H03405"\w* \w and came out|strong="H03318"\w* \w at the Jordan|strong="H03383"\w*. \v 8 \w From Tappuah|strong="H08599"\w* \w the border|strong="H01366"\w* \w went|strong="H01980"\w* \w westward|strong="H03220"\w* \w to the Brook|strong="H05158"\w* \w of Kanah|strong="H07071"\w* \w and ended|strong="H01961"\w* \w at the Sea|strong="H03220"\w*.
\p \w This|strong="H02063"\w* \w was the inheritance|strong="H05159"\w* \w of the clans|strong="H04940"\w* \w of the tribe|strong="H04294"\w* \w of Ephraim|strong="H00669"\w*, \v 9 \w along with all|strong="H03605"\w* \w the cities|strong="H05892"\w* \w and villages|strong="H02691"\w* \w set apart|strong="H03995"\w* \w for the descendants|strong="H01121"\w* \w of Ephraim|strong="H00669"\w* \w within|strong="H08432"\w* \w the inheritance|strong="H05159"\w* \w of Manasseh|strong="H04519"\w*. \v 10 \w But they did not|strong="H03808"\w* \w drive out|strong="H03423"\w* \w the Canaanites|strong="H03669"\w* \w who lived|strong="H03427"\w* \w in Gezer|strong="H01507"\w*. \w So the Canaanites|strong="H03669"\w* \w dwell|strong="H03427"\w* \w among|strong="H07130"\w* \w the Ephraimites|strong="H00669"\w* \w to|strong="H05704"\w* \w this|strong="H02088"\w* \w day|strong="H03117"\w*, \w but they are|strong="H01961"\w* \w forced|strong="H04522"\w* \w laborers|strong="H05647"\w*.
\c 17
\s1 Manasseh’s Western Inheritance
\p \v 1 \w Now this was|strong="H01961"\w* \w the allotment|strong="H01486"\w* \w for the tribe|strong="H04294"\w* \w of Manasseh|strong="H04519"\w* \w as Joseph’s|strong="H03130"\w* \w firstborn son|strong="H01060"\w*, \w namely for Machir|strong="H04353"\w* \w the firstborn|strong="H01060"\w* \w of Manasseh|strong="H04519"\w* \w and father|strong="H00001"\w* \w of the Gileadites|strong="H01568"\w*, \w who had received|strong="H01961"\w* \w Gilead|strong="H01568"\w* \w and Bashan|strong="H01316"\w* \w because|strong="H03588"\w* \w Machir|strong="H01931"\w* \w was|strong="H01961"\w* \w a man|strong="H00376"\w* \w of war|strong="H04421"\w*. \v 2 \w So this allotment was|strong="H01961"\w* \w for the rest|strong="H03498"\w* \w of the descendants|strong="H01121"\w* \w of Manasseh|strong="H04519"\w* — \w the clans|strong="H01121"\w* \w of Abiezer|strong="H00044"\w*,\f + \fr 17:2 \fqa Abiezer \ft is a variant of \fqa Iezer\ft ; see Numbers 26:30.\f* \w Helek|strong="H02507"\w*, \w Asriel|strong="H00844"\w*, \w Shechem|strong="H07928"\w*, \w Hepher|strong="H02660"\w*, \w and Shemida|strong="H08061"\w*. \w These|strong="H00428"\w* \w are the other male|strong="H02145"\w* \w descendants|strong="H01121"\w* \w of the clans|strong="H04940"\w* \w of Manasseh|strong="H04519"\w* \w son|strong="H01121"\w* \w of Joseph|strong="H03130"\w*.
\p \v 3 \w But Zelophehad|strong="H06765"\w* \w son|strong="H01121"\w* \w of Hepher|strong="H02660"\w* (\w the son|strong="H01121"\w* \w of Gilead|strong="H01568"\w*, \w the son|strong="H01121"\w* \w of Machir|strong="H04353"\w*, \w the son|strong="H01121"\w* \w of Manasseh|strong="H04519"\w*) \w had|strong="H01961"\w* \w no|strong="H03808"\w* \w sons|strong="H01121"\w* \w but|strong="H03588"\w* \w only|strong="H00518"\w* \w daughters|strong="H01323"\w*. \w These|strong="H00428"\w* \w are the names|strong="H08034"\w* \w of his daughters|strong="H01323"\w*: \w Mahlah|strong="H04244"\w*, \w Noah|strong="H05270"\w*, \w Hoglah|strong="H02295"\w*, \w Milcah|strong="H04435"\w*, \w and Tirzah|strong="H08656"\w*. \v 4 \w They approached|strong="H07126"\w* \w Eleazar|strong="H00499"\w* \w the priest|strong="H03548"\w*, \w Joshua|strong="H03091"\w* \w son|strong="H01121"\w* \w of Nun|strong="H05126"\w*, \w and the leaders|strong="H05387"\w*, \w and said|strong="H00559"\w*, “\w The LORD|strong="H03068"\w* \w commanded|strong="H06680"\w* \w Moses|strong="H04872"\w* \w to give|strong="H05414"\w* us \w an inheritance|strong="H05159"\w* \w among|strong="H08432"\w* \w our brothers|strong="H00251"\w*.”
\p \w So Joshua gave|strong="H05414"\w* them \w an inheritance|strong="H05159"\w* \w among|strong="H08432"\w* \w their father’s|strong="H00001"\w* \w brothers|strong="H00251"\w*, \w in keeping with|strong="H00413"\w* \w the command of|strong="H06310"\w* \w the LORD|strong="H03068"\w*. \v 5 \w Thus ten|strong="H06235"\w* \w shares|strong="H02256"\w* \w fell|strong="H05307"\w* \w to Manasseh|strong="H04519"\w*, \w in addition to|strong="H00905"\w* \w the land|strong="H00776"\w* \w of Gilead|strong="H01568"\w* \w and Bashan|strong="H01316"\w* \w beyond|strong="H05676"\w* \w the Jordan|strong="H03383"\w*, \v 6 \w because|strong="H03588"\w* \w the daughters|strong="H01323"\w* \w of Manasseh|strong="H04519"\w* \w received|strong="H05157"\w* \w an inheritance|strong="H05159"\w* \w among|strong="H08432"\w* \w his sons|strong="H01121"\w*. \w And the land|strong="H00776"\w* \w of Gilead|strong="H01568"\w* \w belonged to|strong="H01961"\w* \w the rest|strong="H03498"\w* \w of the sons|strong="H01121"\w* \w of Manasseh|strong="H04519"\w*.
\b 
\li1 \v 7 \w Now the border|strong="H01366"\w* \w of Manasseh|strong="H04519"\w* \w went|strong="H01961"\w* \w from Asher|strong="H00836"\w* \w to Michmethath|strong="H04366"\w* \w near|strong="H05921"\w* \w Shechem|strong="H07927"\w*, \w then|strong="H01980"\w* \w southward|strong="H00413"\w* \w to include|strong="H00413"\w* \w the inhabitants|strong="H03427"\w* \w of En-tappuah|strong="H05887"\w*. \v 8 \w The region|strong="H00776"\w* \w of Tappuah|strong="H08599"\w* \w belonged to|strong="H01961"\w* \w Manasseh|strong="H04519"\w*, \w but Tappuah itself|strong="H08599"\w*, \w on|strong="H00413"\w* \w the border|strong="H01366"\w* \w of Manasseh|strong="H04519"\w*, \w belonged to|strong="H01121"\w* \w Ephraim|strong="H00669"\w*. \v 9 \w From there the border|strong="H01366"\w* \w continued|strong="H03381"\w* \w southward|strong="H05045"\w* \w to the Brook|strong="H05158"\w* \w of Kanah|strong="H07071"\w*. \w There were cities|strong="H05892"\w* \w belonging to Ephraim|strong="H00669"\w* \w among|strong="H08432"\w* \w the cities|strong="H05892"\w* \w of Manasseh|strong="H04519"\w*, \w but the border|strong="H01366"\w* \w of Manasseh|strong="H04519"\w* \w was on the north side|strong="H06828"\w* \w of the brook|strong="H05158"\w* \w and ended|strong="H01961"\w* \w at the Sea|strong="H03220"\w*.\f + \fr 17:9 \ft That is, the Mediterranean Sea, also called the Great Sea; also in verse 10\f* \v 10 \w Ephraim’s territory|strong="H00669"\w* \w was to the south|strong="H05045"\w*, \w and Manasseh’s|strong="H04519"\w* \w was|strong="H01961"\w* \w to the north|strong="H06828"\w*, \w having the Sea|strong="H03220"\w* \w as its border|strong="H01366"\w* \w and adjoining|strong="H06293"\w* \w Asher|strong="H00836"\w* \w on the north|strong="H06828"\w* \w and Issachar|strong="H03485"\w* \w on the east|strong="H04217"\w*.
\li1 \v 11 \w Within Issachar|strong="H03485"\w* \w and Asher|strong="H00836"\w*, \w Manasseh|strong="H04519"\w* \w was assigned|strong="H01961"\w* \w Beth-shean|strong="H01052"\w*, \w Ibleam|strong="H02991"\w*, \w Dor|strong="H01756"\w* \w (that is,|strong="H07969"\w* \w Naphath|strong="H05316"\w*), \w Endor|strong="H05874"\w*, \w Taanach|strong="H08590"\w*, \w and|strong="H03427"\w* \w Megiddo|strong="H04023"\w*, \w each with their surrounding settlements|strong="H01323"\w*.
\p \v 12 \w But the descendants|strong="H01121"\w* \w of Manasseh|strong="H04519"\w* \w were unable|strong="H03201"\w* \w to occupy|strong="H03423"\w* \w these|strong="H00428"\w* \w cities|strong="H05892"\w*, \w because the Canaanites|strong="H03669"\w* \w were determined|strong="H02974"\w* \w to stay|strong="H03427"\w* \w in this|strong="H02063"\w* \w land|strong="H00776"\w*. \v 13 \w However|strong="H01961"\w*, \w when|strong="H03588"\w* \w the Israelites|strong="H01121"\w* \w grew stronger|strong="H02388"\w*, \w they put|strong="H05414"\w* \w the Canaanites|strong="H03669"\w* \w to forced labor|strong="H04522"\w*; \w but they failed|strong="H03808"\w* \w to drive them out|strong="H03423"\w* \w completely|strong="H03423"\w*.
\p \v 14 \w Then the sons|strong="H01121"\w* \w of Joseph|strong="H03130"\w* \w said|strong="H01696"\w* \w to|strong="H00854"\w* \w Joshua|strong="H03091"\w*, “\w Why|strong="H04069"\w* \w have you given|strong="H05414"\w* us \w only|strong="H00259"\w* \w one|strong="H00259"\w* \w portion|strong="H01486"\w* \w as an inheritance|strong="H05159"\w*? \w We|strong="H00589"\w* \w have many|strong="H07227"\w* \w people|strong="H05971"\w*, \w because|strong="H05704"\w* \w the LORD|strong="H03068"\w* \w has blessed us abundantly|strong="H01288"\w*.”
\p \v 15 \w Joshua|strong="H03091"\w* \w answered|strong="H00559"\w* \w them|strong="H00413"\w*, “\w If|strong="H00518"\w* \w you|strong="H00859"\w* \w have so many|strong="H07227"\w* \w people|strong="H05971"\w* \w that|strong="H03588"\w* \w the hill country|strong="H02022"\w* \w of Ephraim|strong="H00669"\w* \w is too small|strong="H00213"\w* for you, \w go|strong="H05927"\w* to \w the forest|strong="H03293"\w* \w and clear|strong="H01254"\w* for yourself \w an area|strong="H08033"\w* \w in the land|strong="H00776"\w* \w of the Perizzites|strong="H06522"\w* \w and the Rephaim|strong="H07497"\w*.”
\p \v 16 “\w The hill country|strong="H02022"\w* \w is not|strong="H03808"\w* \w enough|strong="H04672"\w* for us,” \w they|strong="H01121"\w* \w replied|strong="H00559"\w*, “\w and all|strong="H03605"\w* \w the Canaanites|strong="H03669"\w* \w who live|strong="H03427"\w* \w in the valley|strong="H06010"\w* \w have iron|strong="H01270"\w* \w chariots|strong="H07393"\w*, \w both in Beth-shean|strong="H01052"\w* \w with its towns|strong="H01323"\w* \w and in the Valley|strong="H06010"\w* \w of Jezreel|strong="H03157"\w*.”
\p \v 17 \w So Joshua|strong="H03091"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w the house|strong="H01004"\w* \w of Joseph|strong="H03130"\w* — \w to Ephraim|strong="H00669"\w* \w and Manasseh|strong="H04519"\w* — \w “You have many|strong="H07227"\w* \w people|strong="H05971"\w* \w and great|strong="H01419"\w* \w strength|strong="H03581"\w*. \w You shall not|strong="H03808"\w* \w have|strong="H01961"\w* \w just one|strong="H00259"\w* \w allotment|strong="H01486"\w*, \v 18 \w because|strong="H03588"\w* \w the hill country|strong="H02022"\w* \w will be|strong="H01961"\w* yours as well. \w It|strong="H01931"\w* \w is a forest|strong="H03293"\w*; \w clear it|strong="H01254"\w*, \w and its farthest limits|strong="H08444"\w* \w will be|strong="H01961"\w* yours. \w Although|strong="H03588"\w* \w the Canaanites have iron|strong="H01270"\w* \w chariots|strong="H07393"\w* \w and although|strong="H03588"\w* \w they are strong|strong="H02389"\w*, \w you can|strong="H01931"\w* \w drive them out|strong="H03423"\w*.”
\c 18
\s1 The Remainder Divided
\p \v 1 \w Then the whole|strong="H03605"\w* \w congregation|strong="H05712"\w* \w of Israel|strong="H03478"\w* \w assembled|strong="H06950"\w* \w at Shiloh|strong="H07887"\w* \w and set up|strong="H07931"\w* \w the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w* \w there|strong="H08033"\w*. \w And though the land|strong="H00776"\w* \w was subdued|strong="H03533"\w* \w before them|strong="H06440"\w*, \v 2 \w there were still|strong="H03498"\w* \w seven|strong="H07651"\w* \w tribes|strong="H07626"\w* \w of Israel|strong="H03478"\w* \w who|strong="H00834"\w* \w had not|strong="H03808"\w* \w yet received|strong="H02505"\w* \w their inheritance|strong="H05159"\w*.
\p \v 3 \w So Joshua|strong="H03091"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w the Israelites|strong="H01121"\w*, “\w How long|strong="H05704"\w* \w will you|strong="H00859"\w* \w put off|strong="H07503"\w* \w entering|strong="H00935"\w* \w and possessing|strong="H03423"\w* \w the land|strong="H00776"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of your fathers|strong="H00001"\w*, \w has given|strong="H05414"\w* you? \v 4 \w Appoint|strong="H03051"\w* \w three|strong="H07969"\w* \w men|strong="H00582"\w* \w from each tribe|strong="H07626"\w*, \w and I will send them out|strong="H07971"\w* \w to survey|strong="H01980"\w* \w the land|strong="H00776"\w* \w and map it out|strong="H03789"\w*, \w according to|strong="H06310"\w* \w the inheritance of each|strong="H05159"\w*. \w Then they will return|strong="H00935"\w* \w to me|strong="H00413"\w* \v 5 \w and divide|strong="H02505"\w* \w the land|strong="H00853"\w* \w into seven|strong="H07651"\w* \w portions|strong="H02506"\w*. \w Judah|strong="H03063"\w* \w shall remain|strong="H05975"\w* \w in|strong="H05921"\w* \w their territory|strong="H01366"\w* \w in the south|strong="H05045"\w*, \w and the house|strong="H01004"\w* \w of Joseph|strong="H03130"\w* \w shall remain|strong="H05975"\w* \w in|strong="H05921"\w* \w their territory|strong="H01366"\w* \w in the north|strong="H06828"\w*. \v 6 \w When you|strong="H00859"\w* \w have mapped out|strong="H03789"\w* \w the seven|strong="H07651"\w* \w portions|strong="H02506"\w* \w of land|strong="H00776"\w* \w and brought|strong="H00935"\w* \w it to me|strong="H00413"\w*, \w I will cast|strong="H03384"\w* \w lots|strong="H01486"\w* for you \w here|strong="H06311"\w* \w in the presence|strong="H06440"\w* \w of the LORD|strong="H03068"\w* \w our God|strong="H00430"\w*.
\p \v 7 \w The Levites|strong="H03881"\w*, \w however|strong="H03588"\w*, \w have no|strong="H00369"\w* \w portion|strong="H02506"\w* \w among you|strong="H07130"\w*, \w because|strong="H03588"\w* \w their inheritance|strong="H05159"\w* \w is the priesthood|strong="H03550"\w* \w of the LORD|strong="H03068"\w*. \w And Gad|strong="H01410"\w*, \w Reuben|strong="H07205"\w*, \w and half|strong="H02677"\w* \w the tribe|strong="H07626"\w* \w of Manasseh|strong="H04519"\w* \w have already received|strong="H03947"\w* \w the inheritance|strong="H05159"\w* \w that|strong="H00834"\w* \w Moses|strong="H04872"\w* \w the servant|strong="H05650"\w* \w of the LORD|strong="H03068"\w* \w gave|strong="H05414"\w* them \w beyond|strong="H05676"\w* \w the Jordan|strong="H03383"\w* \w to the east|strong="H04217"\w*.”
\p \v 8 \w As the men|strong="H00582"\w* \w got up|strong="H06965"\w* \w to go out|strong="H01980"\w*, \w Joshua|strong="H03091"\w* \w commanded|strong="H06680"\w* \w them|strong="H01980"\w* \w to map out|strong="H03789"\w* \w the land|strong="H00776"\w*, \w saying|strong="H00559"\w*, “\w Go|strong="H01980"\w* \w and survey|strong="H01980"\w* \w the land|strong="H00776"\w*, \w map it out|strong="H03789"\w*, \w and return|strong="H07725"\w* \w to me|strong="H00413"\w*. \w Then I will cast|strong="H07993"\w* \w lots|strong="H01486"\w* for you \w here|strong="H06311"\w* \w in Shiloh|strong="H07887"\w* \w in the presence|strong="H06440"\w* \w of the LORD|strong="H03068"\w*.”
\p \v 9 \w So the men|strong="H00582"\w* \w departed|strong="H01980"\w* \w and went throughout|strong="H05674"\w* \w the land|strong="H00776"\w*, \w mapping it|strong="H03789"\w* \w city by city|strong="H05892"\w* \w into seven|strong="H07651"\w* \w portions|strong="H02506"\w*. \w Then they returned|strong="H00935"\w* \w with the document|strong="H05612"\w* \w to|strong="H00413"\w* \w Joshua|strong="H03091"\w* \w at|strong="H00413"\w* \w the camp|strong="H04264"\w* \w in Shiloh|strong="H07887"\w*.
\p \v 10 \w And Joshua|strong="H03091"\w* \w cast|strong="H07993"\w* \w lots|strong="H01486"\w* for them \w in the presence|strong="H06440"\w* \w of the LORD|strong="H03068"\w* \w at Shiloh|strong="H07887"\w*, \w where|strong="H08033"\w* \w he|strong="H03091"\w* \w distributed|strong="H02505"\w* \w the land|strong="H00776"\w* \w to the Israelites|strong="H01121"\w* \w according to their divisions|strong="H04256"\w*.
\s1 Benjamin’s Inheritance
\p \v 11 \w The first lot|strong="H01486"\w* \w came up|strong="H05927"\w* \w for the clans|strong="H04940"\w* \w of the tribe|strong="H04294"\w* \w of Benjamin|strong="H01144"\w*. \w Their allotted|strong="H01486"\w* \w territory|strong="H01366"\w* \w lay|strong="H03318"\w* \w between|strong="H00996"\w* \w the tribes|strong="H01121"\w* \w of Judah|strong="H03063"\w* \w and|strong="H00996"\w* \w Joseph|strong="H03130"\w*:
\b 
\li1 \v 12 \w On the north|strong="H06828"\w* \w side|strong="H06285"\w* \w their border|strong="H01366"\w* \w began|strong="H01961"\w* \w at|strong="H04480"\w* \w the Jordan|strong="H03383"\w*, \w went up|strong="H05927"\w* \w past|strong="H00413"\w* \w the northern|strong="H06828"\w* \w slope|strong="H03802"\w* \w of Jericho|strong="H03405"\w*, \w headed|strong="H05927"\w* \w west|strong="H03220"\w* \w through the hill country|strong="H02022"\w*, \w and came out|strong="H01961"\w* \w at the wilderness|strong="H04057"\w* \w of Beth-aven|strong="H01007"\w*. \v 13 \w From there|strong="H08033"\w* \w the border|strong="H01366"\w* \w crossed over|strong="H05674"\w* \w to|strong="H00413"\w* \w the southern|strong="H05045"\w* \w slope|strong="H03802"\w* \w of Luz|strong="H03870"\w* \w (that is|strong="H01931"\w*, \w Bethel|strong="H01008"\w*) \w and went down|strong="H03381"\w* \w to Ataroth-addar|strong="H05853"\w* \w on|strong="H05921"\w* \w the hill|strong="H02022"\w* \w south|strong="H05045"\w* \w of|strong="H01032"\w* \w Lower|strong="H08481"\w* \w Beth-horon|strong="H01032"\w*.
\li1 \v 14 \w On the west|strong="H03220"\w* \w side|strong="H06285"\w* \w the border|strong="H01366"\w* \w curved|strong="H08388"\w* \w southward|strong="H05045"\w* \w from|strong="H04480"\w* \w the hill|strong="H02022"\w* \w facing|strong="H05921"\w* \w Beth-horon|strong="H01032"\w* \w on the south|strong="H05045"\w* \w and came out|strong="H01961"\w* \w at|strong="H00413"\w* \w Kiriath-baal|strong="H07154"\w* \w (that is|strong="H01931"\w*, \w Kiriath-jearim|strong="H07157"\w*), \w a city|strong="H05892"\w* \w of the sons|strong="H01121"\w* \w of Judah|strong="H03063"\w*. \w This|strong="H02063"\w* \w was the western|strong="H03220"\w* \w side|strong="H06285"\w*.
\li1 \v 15 \w On the south|strong="H05045"\w* \w side|strong="H06285"\w* \w the border|strong="H01366"\w* \w began at the outskirts|strong="H07097"\w* \w of Kiriath-jearim|strong="H07157"\w* \w and extended|strong="H03318"\w* \w westward|strong="H03220"\w* \w to|strong="H00413"\w* \w the spring|strong="H04599"\w* \w at the Waters|strong="H04325"\w* \w of Nephtoah|strong="H05318"\w*. \v 16 \w Then it|strong="H01366"\w* \w went down|strong="H03381"\w* \w to|strong="H00413"\w* \w the foot|strong="H07097"\w* \w of the hill|strong="H02022"\w* \w that|strong="H00834"\w* \w faces|strong="H05921"\w* \w the Valley of Ben-hinnom|strong="H01516"\w* \w at the northern|strong="H06828"\w* \w end of the Valley|strong="H06010"\w* \w of Rephaim|strong="H07497"\w* \w and ran down|strong="H03381"\w* \w the Valley of Hinnom|strong="H01516"\w* \w toward|strong="H00413"\w* \w the southern|strong="H05045"\w* \w slope|strong="H03802"\w* \w of the Jebusites|strong="H02983"\w* \w and downward|strong="H03381"\w* \w to En-rogel|strong="H05883"\w*. \v 17 \w From there it curved|strong="H08388"\w* \w northward|strong="H06828"\w* \w and proceeded|strong="H03318"\w* \w to En-shemesh|strong="H05885"\w* \w and on to|strong="H00413"\w* \w Geliloth|strong="H01553"\w* \w facing|strong="H05227"\w* \w the Ascent|strong="H04608"\w* \w of Adummim|strong="H00131"\w*, \w and continued down|strong="H03381"\w* \w to the Stone|strong="H00068"\w* \w of Bohan|strong="H00932"\w* \w son|strong="H01121"\w* \w of Reuben|strong="H07205"\w*. \v 18 \w Then it went on|strong="H05674"\w* \w to|strong="H00413"\w* \w the northern|strong="H06828"\w* \w slope|strong="H03802"\w* \w of|strong="H04136"\w* \w Beth-arabah|strong="H06160"\w*\f + \fr 18:18 \ft LXX; Hebrew \fqa slope facing the Arabah\f* \w and went down|strong="H03381"\w* \w into the valley|strong="H06160"\w*. \v 19 \w The border|strong="H01366"\w* \w continued|strong="H05674"\w* \w to|strong="H00413"\w* \w the northern|strong="H06828"\w* \w slope|strong="H03802"\w* \w of Beth-hoglah|strong="H01031"\w* \w and came out|strong="H01961"\w* \w at|strong="H00413"\w* \w the northern|strong="H06828"\w* \w bay|strong="H03956"\w* \w of the Salt Sea|strong="H03220"\w*,\f + \fr 18:19 \ft That is, the Dead Sea\f* \w at|strong="H00413"\w* \w the mouth|strong="H05045"\w* \w of the Jordan|strong="H03383"\w*. \w This|strong="H02088"\w* \w was the southern|strong="H05045"\w* \w border|strong="H01366"\w*.
\li1 \v 20 \w On the east|strong="H06924"\w* \w side|strong="H06285"\w* \w the border|strong="H01379"\w* \w was the Jordan|strong="H03383"\w*.
\p \w These|strong="H02063"\w* \w were the borders|strong="H01367"\w* \w around|strong="H05439"\w* \w the inheritance|strong="H05159"\w* \w of the clans|strong="H04940"\w* \w of the tribe|strong="H01121"\w* \w of Benjamin|strong="H01144"\w*.
\p \v 21 \w These were|strong="H01961"\w* \w the cities|strong="H05892"\w* \w of the clans|strong="H04940"\w* \w of the tribe|strong="H04294"\w* \w of Benjamin|strong="H01144"\w*:
\b 
\li1 \w Jericho|strong="H03405"\w*, \w Beth-hoglah|strong="H01031"\w*, \w Emek-keziz|strong="H07104"\w*, \v 22 \w Beth-arabah|strong="H01026"\w*, \w Zemaraim|strong="H06787"\w*, \w Bethel|strong="H01008"\w*, \v 23 \w Avvim|strong="H05761"\w*, \w Parah|strong="H06511"\w*, \w Ophrah|strong="H06084"\w*, \v 24 \w Chephar-ammoni|strong="H03726"\w*, \w Ophni|strong="H06078"\w*, \w and Geba|strong="H01387"\w*— \w twelve|strong="H08147"\w* \w cities|strong="H05892"\w*, \w along with their villages|strong="H02691"\w*.
\li1 \v 25 \w Gibeon|strong="H01391"\w*, \w Ramah|strong="H07414"\w*, \w Beeroth|strong="H00881"\w*, \v 26 \w Mizpeh|strong="H04708"\w*, \w Chephirah|strong="H03716"\w*, \w Mozah|strong="H04681"\w*, \v 27 \w Rekem|strong="H07552"\w*, \w Irpeel|strong="H03416"\w*, \w Taralah|strong="H08634"\w*, \v 28 \w Zelah|strong="H06762"\w*, \w Haeleph|strong="H00507"\w*, \w Jebus|strong="H02983"\w*\f + \fr 18:28 \ft LXX, Syriac, and Vulgate; Hebrew \fqa the Jebusite\f* \w (that is|strong="H01931"\w*, \w Jerusalem|strong="H03389"\w*), \w Gibeah|strong="H01394"\w*,\f + \fr 18:28 \ft Hebrew \fqa Gibeath \f* \w and Kiriath-jearim|strong="H07157"\w*\f + \fr 18:28 \ft LXX; Hebrew \fqa Kiriath\f*— \w fourteen|strong="H00702"\w* \w cities|strong="H05892"\w*, \w along with their villages|strong="H02691"\w*.
\p \w This|strong="H02063"\w* \w was the inheritance|strong="H05159"\w* \w of the clans|strong="H04940"\w* \w of the tribe|strong="H01121"\w* \w of Benjamin|strong="H01144"\w*.
\c 19
\s1 Simeon’s Inheritance
\p \v 1 \w The second|strong="H08145"\w* \w lot|strong="H01486"\w* \w came out|strong="H03318"\w* \w for the clans|strong="H04940"\w* \w of the tribe|strong="H04294"\w* \w of Simeon|strong="H08095"\w*:
\b 
\li1 \w Their inheritance|strong="H05159"\w* \w lay|strong="H01961"\w* \w within|strong="H08432"\w* \w the territory|strong="H05159"\w* \w of Judah|strong="H03063"\w* \v 2 \w and included|strong="H05159"\w* \w Beersheba|strong="H00884"\w* \w (or Sheba)|strong="H07652"\w*, \w Moladah|strong="H04137"\w*, \v 3 \w Hazar-shual|strong="H02705"\w*, \w Balah|strong="H01088"\w*, \w Ezem|strong="H06107"\w*, \v 4 \w Eltolad|strong="H00513"\w*, \w Bethul|strong="H01329"\w*, \w Hormah|strong="H02767"\w*, \v 5 \w Ziklag|strong="H06860"\w*, \w Beth-marcaboth|strong="H01024"\w*, \w Hazar-susah|strong="H02701"\w*, \v 6 \w Beth-lebaoth|strong="H01034"\w*, \w and Sharuhen|strong="H08287"\w*— \w thirteen|strong="H07969"\w* \w cities|strong="H05892"\w*, \w along with their villages|strong="H02691"\w*.
\li1 \v 7 \w Ain|strong="H05871"\w*, \w Rimmon|strong="H07417"\w*, \w Ether|strong="H06281"\w*, \w and Ashan|strong="H06228"\w*— \w four|strong="H00702"\w* \w cities|strong="H05892"\w*, \w along with their villages|strong="H02691"\w*, \v 8 \w and all|strong="H03605"\w* \w the villages|strong="H02691"\w* \w surrounding|strong="H05439"\w* \w these|strong="H00428"\w* \w cities|strong="H05892"\w* \w as|strong="H05704"\w* \w far as Baalath-beer|strong="H01192"\w* (\w Ramah|strong="H07414"\w* \w of the Negev|strong="H05045"\w*).
\p \w This|strong="H02063"\w* \w was the inheritance|strong="H05159"\w* \w of the clans|strong="H04940"\w* \w of the tribe|strong="H04294"\w* \w of Simeon|strong="H08095"\w*. \v 9 \w The inheritance|strong="H05159"\w* \w of the Simeonites|strong="H08095"\w* \w was taken from the territory|strong="H02256"\w* \w of Judah|strong="H03063"\w*, \w because|strong="H03588"\w* \w the share|strong="H02506"\w* \w for Judah’s|strong="H03063"\w* \w descendants|strong="H01121"\w* \w was|strong="H01961"\w* \w too large|strong="H07227"\w* for them. \w So the Simeonites|strong="H08095"\w* \w received an inheritance|strong="H05159"\w* \w within|strong="H08432"\w* \w Judah’s portion|strong="H05157"\w*.
\s1 Zebulun’s Inheritance
\p \v 10 \w The third|strong="H07992"\w* \w lot|strong="H01486"\w* \w came up|strong="H05927"\w* \w for the clans|strong="H04940"\w* \w of the tribe|strong="H01121"\w* \w of Zebulun|strong="H02074"\w*:
\b 
\li1 \w The border|strong="H01366"\w* \w of their inheritance|strong="H05159"\w* \w stretched|strong="H01961"\w* \w as far as|strong="H05704"\w* \w Sarid|strong="H08301"\w*. \v 11 \w It|strong="H01366"\w* \w went up|strong="H05927"\w* \w westward|strong="H03220"\w* \w to Maralah|strong="H04831"\w*, \w reached|strong="H06293"\w* \w Dabbesheth|strong="H01708"\w*, \w and met|strong="H06293"\w* \w the brook|strong="H05158"\w* \w east|strong="H05921"\w* \w of Jokneam|strong="H03362"\w*. \v 12 \w From Sarid|strong="H08301"\w* \w it turned|strong="H07725"\w* \w eastward|strong="H06924"\w* \w along|strong="H05921"\w* \w the border|strong="H01366"\w* \w of Chisloth-tabor|strong="H03696"\w* \w and went|strong="H03318"\w* \w on to|strong="H00413"\w* \w Daberath|strong="H01705"\w* \w and up|strong="H05927"\w* \w to Japhia|strong="H03309"\w*. \v 13 \w From there|strong="H08033"\w* \w it crossed|strong="H05674"\w* \w eastward|strong="H06924"\w* \w to Gath-hepher|strong="H01662"\w* \w and to Eth-kazin|strong="H06278"\w*; \w it extended|strong="H03318"\w* \w to Rimmon|strong="H07417"\w* \w and curved|strong="H08388"\w* \w around toward Neah|strong="H05269"\w*. \v 14 \w Then the border|strong="H01366"\w* \w circled around|strong="H05437"\w* \w the north side|strong="H06828"\w* \w of Neah|strong="H00853"\w* \w to Hannathon|strong="H02615"\w* \w and ended|strong="H01961"\w* \w at the Valley|strong="H01516"\w* \w of Iphtah-el|strong="H03317"\w*. \v 15 \w It also included Kattath|strong="H07005"\w*, \w Nahalal|strong="H05096"\w*, \w Shimron|strong="H08110"\w*, \w Idalah|strong="H03030"\w*, \w and Bethlehem|strong="H01035"\w*. \w There were twelve|strong="H08147"\w* \w cities|strong="H05892"\w*, \w along with their villages|strong="H02691"\w*.
\p \v 16 \w This|strong="H02063"\w* \w was the inheritance|strong="H05159"\w* \w of the clans|strong="H04940"\w* \w of the tribe|strong="H01121"\w* \w of Zebulun|strong="H02074"\w*, \w including these|strong="H00428"\w* \w cities|strong="H05892"\w* \w and their villages|strong="H02691"\w*.
\s1 Issachar’s Inheritance
\p \v 17 \w The fourth|strong="H07243"\w* \w lot|strong="H01486"\w* \w came out|strong="H03318"\w* \w for the clans|strong="H04940"\w* \w of the tribe|strong="H01121"\w* \w of Issachar|strong="H03485"\w*:
\b 
\li1 \v 18 \w Their territory|strong="H01366"\w* \w included|strong="H01961"\w* \w Jezreel|strong="H03157"\w*, \w Chesulloth|strong="H03694"\w*, \w Shunem|strong="H07766"\w*, \v 19 \w Hapharaim|strong="H02663"\w*, \w Shion|strong="H07866"\w*, \w Anaharath|strong="H00588"\w*, \v 20 \w Rabbith|strong="H07245"\w*, \w Kishion|strong="H07191"\w*, \w Ebez|strong="H00077"\w*, \v 21 \w Remeth|strong="H07432"\w*, \w En-gannim|strong="H05873"\w*, \w En-haddah|strong="H05876"\w*, \w and Beth-pazzez|strong="H01048"\w*. \v 22 \w The border|strong="H01366"\w* \w reached|strong="H06293"\w* \w Tabor|strong="H08396"\w*, \w Shahazumah|strong="H07831"\w*, \w and Beth-shemesh|strong="H01053"\w*, \w and ended|strong="H01961"\w* \w at the Jordan|strong="H03383"\w*. \w There were sixteen|strong="H08337"\w* \w cities|strong="H05892"\w*, \w along with their villages|strong="H02691"\w*.
\p \v 23 \w This|strong="H02063"\w* \w was the inheritance|strong="H05159"\w* \w of the clans|strong="H04940"\w* \w of the tribe|strong="H04294"\w* \w of Issachar|strong="H03485"\w*, \w including these cities|strong="H05892"\w* \w and their villages|strong="H02691"\w*.
\s1 Asher’s Inheritance
\p \v 24 \w The fifth|strong="H02549"\w* \w lot|strong="H01486"\w* \w came out|strong="H03318"\w* \w for the clans|strong="H04940"\w* \w of the tribe|strong="H04294"\w* \w of Asher|strong="H00836"\w*:
\b 
\li1 \v 25 \w Their territory|strong="H01366"\w* \w included|strong="H01961"\w* \w Helkath|strong="H02520"\w*, \w Hali|strong="H02482"\w*, \w Beten|strong="H00991"\w*, \w Achshaph|strong="H00407"\w*, \v 26 \w Allammelech|strong="H00487"\w*, \w Amad|strong="H06008"\w*, \w and Mishal|strong="H04861"\w*. \w On the west|strong="H03220"\w* \w the border touched|strong="H06293"\w* \w Carmel|strong="H03760"\w* \w and Shihor-libnath|strong="H07884"\w*, \v 27 \w then turned|strong="H07725"\w* \w eastward|strong="H04217"\w* \w toward|strong="H01016"\w* \w Beth-dagon|strong="H01016"\w*, \w touched|strong="H06293"\w* \w Zebulun|strong="H02074"\w* \w and the Valley|strong="H01516"\w* \w of Iphtah-el|strong="H03317"\w*, \w and went north|strong="H06828"\w* \w to Beth-emek|strong="H01025"\w* \w and Neiel|strong="H05272"\w*, \w passing|strong="H03318"\w* \w Cabul|strong="H03521"\w* \w on the left|strong="H08040"\w*. \v 28 \w It went on to Ebron|strong="H05683"\w*,\f + \fr 19:28 \ft Some Hebrew manuscripts \fqa Abdon\ft ; see Joshua 21:30.\f* \w Rehob|strong="H07340"\w*, \w Hammon|strong="H02540"\w*, \w and Kanah|strong="H07071"\w*, \w as|strong="H05704"\w* \w far as Greater|strong="H07227"\w* \w Sidon|strong="H06721"\w*. \v 29 \w The border|strong="H01366"\w* \w then turned back|strong="H07725"\w* \w toward Ramah|strong="H07414"\w* \w as far as|strong="H05704"\w* \w the fortified|strong="H04013"\w* \w city|strong="H05892"\w* \w of Tyre|strong="H06865"\w*, \w turned|strong="H07725"\w* \w toward Hosah|strong="H02621"\w*, \w and came out|strong="H01961"\w* \w at the Sea|strong="H03220"\w*\f + \fr 19:29 \ft That is, the Mediterranean Sea, also called the Great Sea\f* \w in the region|strong="H02256"\w* \w of Achzib|strong="H00392"\w*, \v 30 \w Ummah|strong="H05981"\w*, \w Aphek|strong="H00663"\w*, \w and Rehob|strong="H07340"\w*. \w There were twenty-two|strong="H06242"\w* \w cities|strong="H05892"\w*, \w along with their villages|strong="H02691"\w*.
\p \v 31 \w This|strong="H02063"\w* \w was the inheritance|strong="H05159"\w* \w of the clans|strong="H04940"\w* \w of the tribe|strong="H04294"\w* \w of Asher|strong="H00836"\w*, \w including these|strong="H00428"\w* \w cities|strong="H05892"\w* \w and their villages|strong="H02691"\w*.
\s1 Naphtali’s Inheritance
\p \v 32 \w The sixth|strong="H08345"\w* \w lot|strong="H01486"\w* \w came out|strong="H03318"\w* \w for the clans|strong="H04940"\w* \w of the tribe|strong="H01121"\w* \w of Naphtali|strong="H05321"\w*:
\b 
\li1 \v 33 \w Their border|strong="H01366"\w* \w started|strong="H01961"\w* \w at Heleph|strong="H02501"\w* \w and the great tree|strong="H00438"\w* \w of Zaanannim|strong="H06815"\w*, \w passing Adami-nekeb|strong="H00129"\w* \w and Jabneel|strong="H02995"\w* \w as far as|strong="H05704"\w* \w Lakkum|strong="H03946"\w* \w and ending|strong="H01961"\w* \w at the Jordan|strong="H03383"\w*. \v 34 \w Then the border|strong="H01366"\w* \w turned|strong="H07725"\w* \w westward|strong="H03220"\w* \w to Aznoth-tabor|strong="H00243"\w* \w and ran|strong="H03318"\w* \w from there|strong="H08033"\w* \w to Hukkok|strong="H02712"\w*, \w touching|strong="H06293"\w* \w Zebulun|strong="H02074"\w* \w on the south side|strong="H05045"\w*, \w Asher|strong="H00836"\w* \w on the west|strong="H03220"\w*, \w and Judah|strong="H03063"\w* \w at the Jordan|strong="H03383"\w*\f + \fr 19:34 \ft Hebrew; LXX \fqa west, and the Jordan\f* \w on the east|strong="H04217"\w*. \v 35 \w The fortified|strong="H04013"\w* \w cities|strong="H05892"\w* \w were Ziddim|strong="H06661"\w*, \w Zer|strong="H06863"\w*, \w Hammath|strong="H02575"\w*, \w Rakkath|strong="H07557"\w*, \w Chinnereth|strong="H03672"\w*, \v 36 \w Adamah|strong="H00128"\w*, \w Ramah|strong="H07414"\w*, \w Hazor|strong="H02674"\w*, \v 37 \w Kedesh|strong="H06943"\w*, \w Edrei|strong="H00154"\w*, \w En-hazor|strong="H05877"\w*, \v 38 \w Iron|strong="H03375"\w*, \w Migdal-el|strong="H04027"\w*, \w Horem|strong="H02765"\w*, \w Beth-anath|strong="H01043"\w*, \w and Beth-shemesh|strong="H01053"\w*. \w There were nineteen|strong="H08672"\w* \w cities|strong="H05892"\w*, \w along with their villages|strong="H02691"\w*.
\p \v 39 \w This|strong="H02063"\w* \w was the inheritance|strong="H05159"\w* \w of the clans|strong="H04940"\w* \w of the tribe|strong="H04294"\w* \w of Naphtali|strong="H05321"\w*, \w including these cities|strong="H05892"\w* \w and their villages|strong="H02691"\w*.
\s1 Dan’s Inheritance
\p \v 40 \w The seventh|strong="H07637"\w* \w lot|strong="H01486"\w* \w came out|strong="H03318"\w* \w for the clans|strong="H04940"\w* \w of the tribe|strong="H04294"\w* \w of Dan|strong="H01835"\w*:
\b 
\li1 \v 41 \w The territory|strong="H01366"\w* \w of their inheritance|strong="H05159"\w* \w included Zorah|strong="H06881"\w*, \w Eshtaol|strong="H00847"\w*, \w Ir-shemesh|strong="H05905"\w*, \v 42 \w Shaalabbin|strong="H08169"\w*, \w Aijalon|strong="H00357"\w*, \w Ithlah|strong="H03494"\w*, \v 43 \w Elon|strong="H00356"\w*, \w Timnah|strong="H08553"\w*, \w Ekron|strong="H06138"\w*, \v 44 \w Eltekeh|strong="H00514"\w*, \w Gibbethon|strong="H01405"\w*, \w Baalath|strong="H01191"\w*, \v 45 \w Jehud|strong="H03055"\w*, \w Bene-berak|strong="H01139"\w*, \w Gath-rimmon|strong="H01667"\w*, \v 46 \w Me-jarkon|strong="H04313"\w*, \w and Rakkon|strong="H07542"\w*, \w including|strong="H05973"\w* \w the territory|strong="H01366"\w* \w across from|strong="H04136"\w* \w Joppa|strong="H03305"\w*.
\p \v 47 (\w Later, when the territory|strong="H01366"\w* \w of the Danites|strong="H01121"\w* \w was lost|strong="H03318"\w* \w to them|strong="H01121"\w*, \w they went up|strong="H05927"\w* \w and fought|strong="H03898"\w* \w against|strong="H05973"\w* \w Leshem|strong="H03959"\w*, \w captured it|strong="H03920"\w*, \w and put it|strong="H05221"\w* \w to the sword|strong="H02719"\w*. \w So they took possession|strong="H03423"\w* \w of Leshem|strong="H00853"\w*, \w settled|strong="H03427"\w* there, \w and renamed|strong="H07121"\w* \w it|strong="H03959"\w* \w after|strong="H08034"\w* \w their father|strong="H00001"\w* \w Dan|strong="H01835"\w*.)
\p \v 48 \w This|strong="H02063"\w* \w was the inheritance|strong="H05159"\w* \w of the clans|strong="H04940"\w* \w of the tribe|strong="H04294"\w* \w of Dan|strong="H01835"\w*, \w including these|strong="H00428"\w* \w cities|strong="H05892"\w* \w and their villages|strong="H02691"\w*.
\s1 Joshua’s Inheritance
\p \v 49 \w When they had finished|strong="H03615"\w* \w distributing|strong="H05157"\w* \w the land|strong="H00776"\w* \w into its territories|strong="H01367"\w*, \w the Israelites|strong="H01121"\w* \w gave|strong="H05414"\w* \w Joshua|strong="H03091"\w* \w son|strong="H01121"\w* \w of Nun|strong="H05126"\w* \w an inheritance|strong="H05159"\w* \w among them|strong="H08432"\w*, \v 50 \w as|strong="H05921"\w* \w the LORD|strong="H03068"\w* \w had commanded|strong="H06310"\w*. \w They gave|strong="H05414"\w* him \w the city|strong="H05892"\w* \w of Timnath-serah|strong="H08556"\w*\f + \fr 19:50 \fqa Timnath-serah \ft is also known as \fqa Timnath-heres\ft ; see Judges 2:9.\f* \w in the hill country|strong="H02022"\w* \w of Ephraim|strong="H00669"\w*, \w as|strong="H00834"\w* \w he requested|strong="H07592"\w*. \w He rebuilt|strong="H01129"\w* \w the city|strong="H05892"\w* \w and settled|strong="H03427"\w* in it.
\p \v 51 \w These are|strong="H00428"\w* \w the inheritances|strong="H05159"\w* \w that|strong="H00834"\w* \w Eleazar|strong="H00499"\w* \w the priest|strong="H03548"\w*, \w Joshua|strong="H03091"\w* \w son|strong="H01121"\w* \w of Nun|strong="H05126"\w*, \w and the heads|strong="H07218"\w* \w of the families|strong="H00001"\w* \w distributed|strong="H05157"\w* \w by lot|strong="H01486"\w* \w to the tribes|strong="H04294"\w* \w of Israel|strong="H03478"\w* \w at Shiloh|strong="H07887"\w* \w before|strong="H06440"\w* \w the LORD|strong="H03068"\w* \w at the entrance|strong="H06607"\w* \w to the Tent|strong="H00168"\w* \w of Meeting|strong="H04150"\w*. \w So they finished|strong="H03615"\w* \w dividing up|strong="H02505"\w* \w the land|strong="H00776"\w*.
\c 20
\s1 Six Cities of Refuge
\p \v 1 \w Then the LORD|strong="H03068"\w* \w said|strong="H01696"\w* \w to|strong="H00413"\w* \w Joshua|strong="H03091"\w*, \v 2 “\w Tell|strong="H01696"\w* \w the Israelites|strong="H01121"\w* \w to designate|strong="H05414"\w* \w the cities|strong="H05892"\w* \w of refuge|strong="H04733"\w*, \w as|strong="H00834"\w* \w I instructed|strong="H01696"\w* \w you through|strong="H03027"\w* \w Moses|strong="H04872"\w*, \v 3 \w so that anyone|strong="H07523"\w* \w who kills|strong="H05221"\w* \w another|strong="H05315"\w* \w unintentionally|strong="H07684"\w* \w or accidentally|strong="H01097"\w* \w may flee|strong="H05127"\w* \w there|strong="H08033"\w*. \w These will be|strong="H01961"\w* your \w refuge|strong="H04733"\w* \w from the avenger|strong="H01350"\w* \w of blood|strong="H01818"\w*. \v 4 \w When someone flees|strong="H05127"\w* \w to|strong="H00413"\w* \w one|strong="H00259"\w* \w of these|strong="H00428"\w* \w cities|strong="H05892"\w*, \w stands|strong="H05975"\w* \w at the entrance|strong="H06607"\w* \w of the city|strong="H05892"\w* \w gate|strong="H08179"\w*, \w and states|strong="H01696"\w* \w his case|strong="H01697"\w* \w before its elders|strong="H02205"\w*, \w they are to bring|strong="H00622"\w* \w him|strong="H00853"\w* \w into the city|strong="H05892"\w* \w and give|strong="H05414"\w* him \w a place|strong="H04725"\w* \w to live|strong="H03427"\w* \w among them|strong="H05973"\w*.
\p \v 5 \w Now if|strong="H03588"\w* \w the avenger|strong="H01350"\w* \w of blood|strong="H01818"\w* \w pursues him|strong="H07291"\w*, \w they must not|strong="H03808"\w* \w surrender|strong="H05462"\w* \w the manslayer|strong="H07523"\w* \w into his hand|strong="H03027"\w*, \w because|strong="H03588"\w* \w that man killed|strong="H05221"\w* \w his neighbor|strong="H07453"\w* \w accidentally|strong="H01097"\w* \w without|strong="H03808"\w* \w prior|strong="H08032"\w* \w malice|strong="H08130"\w*. \v 6 \w He is to stay|strong="H03427"\w* \w in that|strong="H01931"\w* \w city|strong="H05892"\w* \w until|strong="H05704"\w* \w he stands|strong="H05975"\w* \w trial|strong="H04941"\w* \w before|strong="H06440"\w* \w the assembly|strong="H05712"\w* \w and until|strong="H05704"\w* \w the death|strong="H04194"\w* \w of the high|strong="H01419"\w* \w priest|strong="H03548"\w* \w serving|strong="H01961"\w* \w at that|strong="H01992"\w* \w time|strong="H03117"\w*. \w Then|strong="H00227"\w* \w the manslayer|strong="H07523"\w* \w may return|strong="H07725"\w* \w to his own home|strong="H01004"\w* \w in|strong="H00413"\w* \w the city|strong="H05892"\w* \w from which|strong="H00834"\w* \w he fled|strong="H05127"\w*.”
\p \v 7 \w So they set apart|strong="H06942"\w* \w Kedesh|strong="H06943"\w* \w in Galilee|strong="H01551"\w* \w in the hill country|strong="H02022"\w* \w of Naphtali|strong="H05321"\w*, \w Shechem|strong="H07927"\w* \w in the hill country|strong="H02022"\w* \w of Ephraim|strong="H00669"\w*, \w and Kiriath-arba|strong="H07153"\w* \w (that is|strong="H01931"\w*, \w Hebron|strong="H02275"\w*) \w in the hill country|strong="H02022"\w* \w of Judah|strong="H03063"\w*.
\p \v 8 \w And beyond|strong="H05676"\w* \w the Jordan|strong="H03383"\w*, \w east|strong="H04217"\w* \w of Jericho|strong="H03405"\w*, \w they designated|strong="H05414"\w* \w Bezer|strong="H01221"\w* \w on the wilderness|strong="H04057"\w* \w plateau|strong="H04334"\w* \w from the tribe|strong="H04294"\w* \w of Reuben|strong="H07205"\w*, \w Ramoth|strong="H07216"\w* \w in Gilead|strong="H01568"\w* \w from the tribe|strong="H04294"\w* \w of Gad|strong="H01410"\w*, \w and|strong="H00853"\w* \w Golan|strong="H01474"\w* \w in Bashan|strong="H01316"\w* \w from the tribe|strong="H04294"\w* \w of Manasseh|strong="H04519"\w*.
\p \v 9 \w These|strong="H00428"\w* \w are|strong="H01961"\w* \w the cities|strong="H05892"\w* \w appointed|strong="H04152"\w* \w for all|strong="H03605"\w* \w the Israelites|strong="H01121"\w* \w and foreigners|strong="H01616"\w* \w among them|strong="H08432"\w*, \w so that anyone|strong="H03605"\w* \w who kills|strong="H05221"\w* \w a person|strong="H05315"\w* \w unintentionally|strong="H07684"\w* \w may flee|strong="H05127"\w* \w there|strong="H08033"\w* \w and not|strong="H03808"\w* \w die|strong="H04191"\w* \w by the hand|strong="H03027"\w* \w of the avenger|strong="H01350"\w* \w of blood|strong="H01818"\w* \w prior|strong="H05704"\w* \w to standing trial|strong="H05975"\w* \w before|strong="H06440"\w* \w the assembly|strong="H05712"\w*.
\c 21
\s1 Forty-Eight Cities for the Levites
\p \v 1 \w Now the family|strong="H00001"\w* \w heads|strong="H07218"\w* \w of the Levites|strong="H03881"\w* \w approached|strong="H05066"\w* \w Eleazar|strong="H00499"\w* \w the priest|strong="H03548"\w*, \w Joshua|strong="H03091"\w* \w son|strong="H01121"\w* \w of Nun|strong="H05126"\w*, \w and|strong="H00413"\w* \w the heads|strong="H07218"\w* \w of the other tribes|strong="H04294"\w* \w of Israel|strong="H03478"\w* \v 2 \w at Shiloh|strong="H07887"\w* \w in the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w* \w and said|strong="H01696"\w* \w to them|strong="H00413"\w*, “\w The LORD|strong="H03068"\w* \w commanded|strong="H06680"\w* \w through|strong="H03027"\w* \w Moses|strong="H04872"\w* \w that we be given|strong="H05414"\w* \w cities|strong="H05892"\w* \w in which to live|strong="H03427"\w*, \w together with pasturelands|strong="H04054"\w* \w for our livestock|strong="H00929"\w*.”
\p \v 3 \w So by|strong="H00413"\w* \w the command|strong="H06310"\w* \w of the LORD|strong="H03068"\w*, \w the Israelites|strong="H01121"\w* \w gave|strong="H05414"\w* \w the Levites|strong="H03881"\w* \w these|strong="H00428"\w* \w cities|strong="H05892"\w* \w and|strong="H00853"\w* \w their pasturelands|strong="H04054"\w* \w out of their own inheritance|strong="H05159"\w*:
\b 
\li1 \v 4 \w The first lot|strong="H01486"\w* \w came out|strong="H03318"\w* \w for the Kohathite|strong="H06956"\w* \w clans|strong="H04940"\w*. \w The Levites|strong="H03881"\w* \w who were descendants|strong="H01121"\w* \w of Aaron|strong="H00175"\w* \w the priest|strong="H03548"\w* \w received|strong="H01961"\w* \w thirteen|strong="H07969"\w* \w cities|strong="H05892"\w* \w by lot|strong="H01486"\w* \w from the tribes|strong="H04294"\w* \w of Judah|strong="H03063"\w*, \w Simeon|strong="H08099"\w*, \w and Benjamin|strong="H01144"\w*.
\li1 \v 5 \w The remaining|strong="H03498"\w* \w descendants|strong="H01121"\w* \w of Kohath|strong="H06955"\w* \w received ten|strong="H06235"\w* \w cities|strong="H05892"\w* \w by lot|strong="H01486"\w* \w from the tribes|strong="H04294"\w* \w of Ephraim|strong="H00669"\w*, \w Dan|strong="H01835"\w*, \w and|strong="H02677"\w* \w the half-tribe|strong="H04294"\w* \w of Manasseh|strong="H04519"\w*.
\li1 \v 6 \w The descendants|strong="H01121"\w* \w of Gershon|strong="H01648"\w* \w received thirteen|strong="H07969"\w* \w cities|strong="H05892"\w* \w by lot|strong="H01486"\w* \w from the tribes|strong="H04294"\w* \w of Issachar|strong="H03485"\w*, \w Asher|strong="H00836"\w*, \w Naphtali|strong="H05321"\w*, \w and the half-tribe|strong="H02677"\w* \w of Manasseh|strong="H04519"\w* \w in Bashan|strong="H01316"\w*.
\li1 \v 7 \w And the descendants|strong="H01121"\w* \w of Merari|strong="H04847"\w* \w received twelve|strong="H08147"\w* \w cities|strong="H05892"\w* \w from the tribes|strong="H04294"\w* \w of Reuben|strong="H07205"\w*, \w Gad|strong="H01410"\w*, \w and Zebulun|strong="H02074"\w*.
\p \v 8 \w So the Israelites|strong="H01121"\w* \w allotted|strong="H05414"\w* \w to the Levites|strong="H03881"\w* \w these|strong="H00428"\w* \w cities|strong="H05892"\w*, \w together with their pasturelands|strong="H04054"\w*, \w as|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had commanded|strong="H06680"\w* \w through|strong="H03027"\w* \w Moses|strong="H04872"\w*.
\p \v 9 \w From the tribes|strong="H04294"\w* \w of Judah|strong="H03063"\w* \w and Simeon|strong="H08095"\w*, \w they designated|strong="H05414"\w* \w these|strong="H00428"\w* \w cities|strong="H05892"\w* \w by name|strong="H08034"\w* \v 10 \w to the descendants|strong="H01121"\w* \w of Aaron|strong="H00175"\w* \w from the Kohathite|strong="H06956"\w* \w clans|strong="H04940"\w* \w of the Levites|strong="H01121"\w*, \w because|strong="H03588"\w* \w the first|strong="H07223"\w* \w lot|strong="H01486"\w* \w fell|strong="H01961"\w* to them:
\b 
\li1 \v 11 \w They gave|strong="H05414"\w* them \w Kiriath-arba|strong="H07153"\w* \w (that is|strong="H01931"\w*, \w Hebron|strong="H02275"\w*), \w with its surrounding|strong="H05439"\w* \w pasturelands|strong="H04054"\w*, \w in the hill country|strong="H02022"\w* \w of Judah|strong="H03063"\w*. (\w Arba was the father|strong="H00001"\w* \w of Anak|strong="H06061"\w*.) \v 12 \w But they had given|strong="H05414"\w* \w the fields|strong="H07704"\w* \w and villages|strong="H02691"\w* \w around the city|strong="H05892"\w* \w to Caleb|strong="H03612"\w* \w son|strong="H01121"\w* \w of Jephunneh|strong="H03312"\w* \w as his possession|strong="H00272"\w*.
\li1 \v 13 \w So to the descendants|strong="H01121"\w* \w of Aaron|strong="H00175"\w* \w the priest|strong="H03548"\w* \w they gave|strong="H05414"\w* \w these cities|strong="H00853"\w*, \w together with|strong="H00853"\w* \w their pasturelands|strong="H04054"\w*: \w Hebron|strong="H02275"\w*, \w a city|strong="H05892"\w* \w of refuge|strong="H04733"\w* \w for the manslayer|strong="H07523"\w*, \w Libnah|strong="H03841"\w*, \v 14 \w Jattir|strong="H03492"\w*, \w Eshtemoa|strong="H00851"\w*, \v 15 \w Holon|strong="H02473"\w*, \w Debir|strong="H01688"\w*, \v 16 \w Ain|strong="H05871"\w*, \w Juttah|strong="H03194"\w*, \w and Beth-shemesh|strong="H01053"\w*— \w nine|strong="H08672"\w* \w cities|strong="H05892"\w* \w from|strong="H00854"\w* \w these|strong="H00428"\w* \w two|strong="H08147"\w* \w tribes|strong="H07626"\w*, \w together with|strong="H00853"\w* \w their pasturelands|strong="H04054"\w*.
\p \v 17 \w And from the tribe|strong="H04294"\w* \w of Benjamin they gave|strong="H01144"\w* \w them|strong="H00853"\w* \w Gibeon|strong="H01391"\w*, \w Geba|strong="H01387"\w*, \v 18 \w Anathoth|strong="H06068"\w*, \w and Almon|strong="H05960"\w*— \w four|strong="H00702"\w* \w cities|strong="H05892"\w*, \w together with|strong="H00853"\w* \w their pasturelands|strong="H04054"\w*.
\p \v 19 \w In all|strong="H03605"\w*, \w thirteen|strong="H07969"\w* \w cities|strong="H05892"\w*, \w together with their pasturelands|strong="H04054"\w*, \w were given to the priests|strong="H03548"\w*, \w the descendants|strong="H01121"\w* \w of Aaron|strong="H00175"\w*.
\p \v 20 \w The remaining|strong="H03498"\w* \w Kohathite|strong="H06955"\w* \w clans|strong="H04940"\w* \w of the Levites|strong="H03881"\w* \w were allotted|strong="H01486"\w* \w these cities|strong="H05892"\w*:
\b 
\li1 \w From the tribe|strong="H04294"\w* \w of Ephraim|strong="H00669"\w* \v 21 \w they were given|strong="H05414"\w* \w Shechem|strong="H07927"\w* \w in the hill country|strong="H02022"\w* \w of Ephraim|strong="H00669"\w* (\w a city|strong="H05892"\w* \w of refuge|strong="H04733"\w* \w for the manslayer|strong="H07523"\w*), \w Gezer|strong="H01507"\w*, \v 22 \w Kibzaim|strong="H06911"\w*, \w and Beth-horon|strong="H01032"\w*— \w four|strong="H00702"\w* \w cities|strong="H05892"\w*, \w together with|strong="H00853"\w* \w their pasturelands|strong="H04054"\w*.
\li1 \v 23 \w From the tribe|strong="H04294"\w* \w of Dan they were given|strong="H01835"\w* \w Elteke|strong="H00514"\w*, \w Gibbethon|strong="H01405"\w*, \v 24 \w Aijalon|strong="H00357"\w*, \w and Gath-rimmon|strong="H01667"\w*— \w four|strong="H00702"\w* \w cities|strong="H05892"\w*, \w together with|strong="H00853"\w* \w their pasturelands|strong="H04054"\w*.
\li1 \v 25 \w And from the half-tribe|strong="H04276"\w* \w of Manasseh they were given|strong="H04519"\w* \w Taanach|strong="H08590"\w* \w and|strong="H00853"\w* \w Gath-rimmon|strong="H01667"\w*— \w two|strong="H08147"\w* \w cities|strong="H05892"\w*, \w together with|strong="H00853"\w* \w their pasturelands|strong="H04054"\w*.
\li1 \v 26 \w In all|strong="H03605"\w*, \w ten|strong="H06235"\w* \w cities|strong="H05892"\w*, \w together with their pasturelands|strong="H04054"\w*, \w were given to the rest|strong="H03498"\w* \w of the Kohathite|strong="H06955"\w* \w clans|strong="H04940"\w*.
\p \v 27 \w This is what the Levite|strong="H03881"\w* \w clans|strong="H04940"\w* \w of the Gershonites were given|strong="H01648"\w*:
\b 
\li1 \w From the half-tribe|strong="H02677"\w* \w of Manasseh|strong="H04519"\w* \w they were given|strong="H00853"\w* \w Golan|strong="H01474"\w* \w in Bashan|strong="H01316"\w*, \w a city|strong="H05892"\w* \w of refuge|strong="H04733"\w* \w for the manslayer|strong="H07523"\w*, \w and Beeshterah|strong="H01203"\w*— \w two|strong="H08147"\w* \w cities|strong="H05892"\w*, \w together with|strong="H00853"\w* \w their pasturelands|strong="H04054"\w*.
\li1 \v 28 \w From the tribe|strong="H04294"\w* \w of Issachar they were given|strong="H03485"\w* \w Kishion|strong="H07191"\w*, \w Daberath|strong="H01705"\w*, \v 29 \w Jarmuth|strong="H03412"\w*, \w and En-gannim|strong="H05873"\w*— \w four|strong="H00702"\w* \w cities|strong="H05892"\w*, \w together with|strong="H00853"\w* \w their pasturelands|strong="H04054"\w*.
