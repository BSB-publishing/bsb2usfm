\p \v 18 \w When the priests|strong="H03548"\w* \w carrying|strong="H05375"\w* \w the ark|strong="H00727"\w* \w of the covenant|strong="H01285"\w* \w of the LORD|strong="H03068"\w* \w came up|strong="H05927"\w* \w out|strong="H08432"\w* \w of the Jordan|strong="H03383"\w* \w and their|strong="H03548"\w* \w feet|strong="H03709"\w* \w touched|strong="H05423"\w* \w the dry land|strong="H02724"\w*, \w the waters|strong="H04325"\w* \w of the Jordan|strong="H03383"\w* \w returned|strong="H07725"\w* \w to their course|strong="H04725"\w* \w and overflowed|strong="H01980"\w* \w all|strong="H03605"\w* \w the banks|strong="H01415"\w* \w as before|strong="H08543"\w*.
\s1 The Camp at Gilgal
\p \v 19 \w On the tenth|strong="H06218"\w* \w day of the first|strong="H07223"\w* \w month|strong="H02320"\w* \w the people|strong="H05971"\w* \w went up|strong="H05927"\w* \w from|strong="H04480"\w* \w the Jordan|strong="H03383"\w* \w and camped|strong="H02583"\w* \w at Gilgal|strong="H01537"\w* \w on the eastern|strong="H04217"\w* \w border|strong="H07097"\w* \w of Jericho|strong="H03405"\w*. \v 20 \w And|strong="H00853"\w* \w there at Gilgal|strong="H01537"\w* \w Joshua|strong="H03091"\w* \w set up|strong="H06965"\w* \w the|strong="H00428"\w* \w twelve|strong="H08147"\w* \w stones|strong="H00068"\w* \w they had taken|strong="H03947"\w* \w from|strong="H04480"\w* \w the Jordan|strong="H03383"\w*.
