\li1 \v 40 \w In all|strong="H03605"\w*, \w twelve|strong="H08147"\w* \w cities|strong="H05892"\w* \w were|strong="H01961"\w* \w allotted|strong="H01486"\w* \w to the clans|strong="H04940"\w* \w of Merari|strong="H04847"\w*, \w the remaining|strong="H03498"\w* \w Levite|strong="H03881"\w* \w clans|strong="H04940"\w*.
\p \v 41 \w For the Levites, then|strong="H03881"\w*, \w there were forty-eight|strong="H00705"\w* \w cities|strong="H05892"\w* \w in all|strong="H03605"\w*, \w together with their pasturelands|strong="H04054"\w*, \w within|strong="H08432"\w* \w the territory|strong="H00272"\w* \w of the Israelites|strong="H03478"\w*. \v 42 \w Each|strong="H05892"\w* \w of these|strong="H00428"\w* \w cities|strong="H05892"\w* \w had|strong="H01961"\w* \w its own surrounding|strong="H05439"\w* \w pasturelands|strong="H04054"\w*; \w this was true|strong="H03651"\w* \w for all|strong="H03605"\w* \w the|strong="H00428"\w* \w cities|strong="H05892"\w*.
\p \v 43 \w Thus the LORD|strong="H03068"\w* \w gave|strong="H05414"\w* \w Israel|strong="H03478"\w* \w all|strong="H03605"\w* \w the land|strong="H00776"\w* \w He had sworn|strong="H07650"\w* \w to give|strong="H05414"\w* \w their fathers|strong="H00001"\w*, \w and they took possession of it|strong="H03423"\w* \w and settled|strong="H03427"\w* in it.
\p \v 44 \w And the LORD|strong="H03068"\w* \w gave them rest|strong="H05117"\w* \w on every side|strong="H05439"\w*, \w just as|strong="H03605"\w* \w He had sworn|strong="H07650"\w* \w to their fathers|strong="H00001"\w*. \w None|strong="H03808"\w* \w of their enemies|strong="H00341"\w* \w could stand|strong="H05975"\w* \w against them|strong="H06440"\w*, \w for the LORD|strong="H03068"\w* \w delivered|strong="H05414"\w* \w all|strong="H03605"\w* \w their enemies|strong="H00341"\w* \w into their hand|strong="H03027"\w*.
\p \v 45 \w Not one|strong="H03808"\w* \w of all|strong="H03605"\w* \w the LORD’s|strong="H03068"\w* \w good|strong="H02896"\w* \w promises|strong="H01697"\w* \w to|strong="H00413"\w* \w the house|strong="H01004"\w* \w of Israel|strong="H03478"\w* \w had failed|strong="H05307"\w*; \w everything|strong="H03605"\w* \w was fulfilled|strong="H00935"\w*.
\c 22
\s1 The Eastern Tribes Return Home
\p \v 1 \w Then|strong="H00227"\w* \w Joshua|strong="H03091"\w* \w summoned|strong="H07121"\w* \w the Reubenites|strong="H07206"\w*, \w the Gadites|strong="H01425"\w*, \w and the half-tribe|strong="H02677"\w* \w of Manasseh|strong="H04519"\w* \v 2 \w and told them|strong="H00559"\w*, “\w You|strong="H00859"\w* \w have done|strong="H08104"\w* \w all|strong="H03605"\w* \w that|strong="H00834"\w* \w Moses|strong="H04872"\w* \w the servant|strong="H05650"\w* \w of the LORD|strong="H03068"\w* \w commanded|strong="H06680"\w* \w you|strong="H00853"\w*, \w and you have obeyed|strong="H08085"\w* \w my voice|strong="H06963"\w* \w in all|strong="H03605"\w* \w that|strong="H00834"\w* \w I commanded|strong="H06680"\w* \w you|strong="H00853"\w*. \v 3 \w All this time|strong="H03117"\w* \w you have not|strong="H03808"\w* \w deserted|strong="H05800"\w* \w your brothers|strong="H00251"\w*, \w up to|strong="H05704"\w* \w this very day|strong="H03117"\w*, \w but have kept|strong="H08104"\w* \w the charge|strong="H04931"\w* \w given you|strong="H04687"\w* \w by the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*.
\p \v 4 \w And now that|strong="H06258"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w* \w has given your brothers|strong="H00251"\w* \w rest|strong="H05117"\w* \w as|strong="H00834"\w* \w He promised|strong="H01696"\w* them, \w you may return|strong="H06437"\w* to \w your homes|strong="H00168"\w* \w in|strong="H00413"\w* \w the land|strong="H00776"\w* \w that|strong="H00834"\w* \w Moses|strong="H04872"\w* \w the servant|strong="H05650"\w* \w of the LORD|strong="H03068"\w* \w gave|strong="H05414"\w* you \w across|strong="H05676"\w* \w the Jordan|strong="H03383"\w*. \v 5 \w But|strong="H07535"\w* \w be very|strong="H03966"\w* \w careful|strong="H08104"\w* \w to observe|strong="H06213"\w* \w the commandment|strong="H04687"\w* \w and|strong="H00853"\w* \w the law|strong="H08451"\w* \w that|strong="H00834"\w* \w Moses|strong="H04872"\w* \w the servant|strong="H05650"\w* \w of the LORD|strong="H03068"\w* \w gave you|strong="H06680"\w*: \w to love|strong="H00157"\w* \w the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*, \w to walk|strong="H01980"\w* \w in all|strong="H03605"\w* \w His ways|strong="H01870"\w*, \w to keep|strong="H08104"\w* \w His commandments|strong="H04687"\w*, \w to hold fast|strong="H01692"\w* to Him, \w and to serve Him|strong="H05647"\w* \w with all|strong="H03605"\w* \w your heart|strong="H03824"\w* \w and with all|strong="H03605"\w* \w your soul|strong="H05315"\w*.”
\p \v 6 \w So Joshua|strong="H03091"\w* \w blessed them|strong="H01288"\w* \w and sent them on their way|strong="H07971"\w*, \w and they went|strong="H01980"\w* \w to|strong="H00413"\w* \w their homes|strong="H00168"\w*. \v 7 (\w To the half-tribe|strong="H02677"\w* \w of Manasseh|strong="H04519"\w* \w Moses|strong="H04872"\w* \w had given land|strong="H05414"\w* \w in Bashan|strong="H01316"\w*, \w and to the other half|strong="H02677"\w* \w Joshua|strong="H03091"\w* \w gave land|strong="H05414"\w* \w on the west|strong="H03220"\w* \w side|strong="H05676"\w* \w of the Jordan|strong="H03383"\w* \w among|strong="H05973"\w* \w their brothers|strong="H00251"\w*.) \w When|strong="H03588"\w* \w Joshua|strong="H03091"\w* \w sent them|strong="H07971"\w* \w to|strong="H00413"\w* \w their homes|strong="H00168"\w* \w he blessed them|strong="H01288"\w*, \v 8 \w saying|strong="H00559"\w*, “\w Return|strong="H07725"\w* \w to|strong="H00413"\w* \w your homes|strong="H00168"\w* \w with your great|strong="H07227"\w* \w wealth|strong="H05233"\w*, \w with immense|strong="H07227"\w* \w herds of livestock|strong="H04735"\w*, \w with silver|strong="H03701"\w*, \w gold|strong="H02091"\w*, \w bronze|strong="H05178"\w*, \w iron|strong="H01270"\w*, \w and very many|strong="H07235"\w* \w clothes|strong="H08008"\w*. \w Divide|strong="H02505"\w* \w with|strong="H05973"\w* \w your brothers|strong="H00251"\w* \w the spoil|strong="H07998"\w* \w of your enemies|strong="H00341"\w*.”
\s1 The Altar of Witness
\p \v 9 \w So the Reubenites|strong="H01121"\w*, \w the Gadites|strong="H01121"\w*, \w and the half-tribe|strong="H02677"\w* \w of Manasseh|strong="H04519"\w* \w left|strong="H01980"\w* \w the Israelites|strong="H01121"\w* \w at Shiloh|strong="H07887"\w* \w in the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w* \w to return|strong="H01980"\w* \w to|strong="H00413"\w* \w their own land|strong="H00776"\w* \w of Gilead|strong="H01568"\w*, \w which|strong="H00834"\w* \w they had acquired|strong="H00270"\w* \w according to|strong="H05921"\w* \w the command|strong="H06310"\w* \w of the LORD|strong="H03068"\w* \w through|strong="H03027"\w* \w Moses|strong="H04872"\w*. \v 10 \w And when they came|strong="H00935"\w* \w to|strong="H00413"\w* \w Geliloth|strong="H01552"\w*\f + \fr 22:10 \ft Or \fqa to the circle of stones \ft or \fqa to the region\ft ; similarly in verse 11\f* \w near the Jordan|strong="H03383"\w* \w in the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*, \w the Reubenites|strong="H01121"\w*, \w the Gadites|strong="H01121"\w*, \w and the half-tribe|strong="H02677"\w* \w of Manasseh|strong="H04519"\w* \w built|strong="H01129"\w* \w an imposing|strong="H04758"\w* \w altar|strong="H04196"\w* \w there|strong="H08033"\w* \w by|strong="H05921"\w* \w the Jordan|strong="H03383"\w*.
\p \v 11 \w Then the Israelites|strong="H01121"\w* \w received|strong="H08085"\w* \w the report|strong="H00559"\w*: “\w Behold|strong="H02009"\w*, \w the Reubenites|strong="H01121"\w*, \w the Gadites|strong="H01121"\w*, \w and the half-tribe|strong="H02677"\w* \w of Manasseh|strong="H04519"\w* \w have built|strong="H01129"\w* \w an altar|strong="H04196"\w* \w on|strong="H00413"\w* \w the border|strong="H04136"\w* \w of the land|strong="H00776"\w* \w of Canaan|strong="H03667"\w*, \w at|strong="H00413"\w* \w Geliloth|strong="H01552"\w* \w near the Jordan|strong="H03383"\w* \w on|strong="H00413"\w* \w the Israelite|strong="H01121"\w* \w side|strong="H05676"\w*.” \v 12 \w And when they|strong="H01121"\w* \w heard this|strong="H08085"\w*, \w the whole|strong="H03605"\w* \w congregation|strong="H05712"\w* \w of Israel|strong="H03478"\w* \w assembled|strong="H06950"\w* \w at Shiloh|strong="H07887"\w* \w to go|strong="H05927"\w* \w to war|strong="H06635"\w* \w against them|strong="H05921"\w*.
\p \v 13 \w The Israelites|strong="H01121"\w* \w sent|strong="H07971"\w* \w Phinehas|strong="H06372"\w* \w son of|strong="H01121"\w* \w Eleazar|strong="H00499"\w* \w the priest|strong="H03548"\w* \w to|strong="H00413"\w* \w the land|strong="H00776"\w* \w of Gilead|strong="H01568"\w*, \w to|strong="H00413"\w* \w the Reubenites|strong="H01121"\w*, \w the Gadites|strong="H01410"\w*, \w and the half-tribe|strong="H02677"\w* \w of Manasseh|strong="H04519"\w*. \v 14 \w With him|strong="H05973"\w* \w they sent ten|strong="H06235"\w* \w chiefs|strong="H05387"\w* — \w one|strong="H00259"\w* \w family|strong="H01004"\w* \w leader|strong="H05387"\w* \w from each|strong="H03605"\w* \w tribe|strong="H04294"\w* \w of Israel|strong="H03478"\w*, \w each|strong="H00376"\w* \w the head|strong="H07218"\w* \w of a family|strong="H01004"\w* \w among the clans|strong="H00505"\w* \w of Israel|strong="H03478"\w*.
\p \v 15 \w They went|strong="H00935"\w* \w to|strong="H00413"\w* \w the Reubenites|strong="H01121"\w*, \w the Gadites|strong="H01121"\w*, \w and the half-tribe|strong="H02677"\w* \w of Manasseh|strong="H04519"\w* \w in the land|strong="H00776"\w* \w of Gilead|strong="H01568"\w* \w and said|strong="H01696"\w* \w to them|strong="H00854"\w*, \v 16 “\w This is what|strong="H03541"\w* \w the whole|strong="H03605"\w* \w congregation|strong="H05712"\w* \w of the LORD|strong="H03068"\w* \w says|strong="H00559"\w*: ‘\w What|strong="H04100"\w* \w is this|strong="H02088"\w* \w breach of faith|strong="H04603"\w* \w you have committed|strong="H04604"\w* \w today|strong="H03117"\w* \w against the God|strong="H00430"\w* \w of Israel|strong="H03478"\w* \w by turning away|strong="H07725"\w* \w from|strong="H00310"\w* \w the LORD|strong="H03068"\w* \w and building|strong="H01129"\w* for yourselves \w an altar|strong="H04196"\w*, \w that you might rebel|strong="H04775"\w* \w against the LORD|strong="H03068"\w* \w this day|strong="H03117"\w*?
\p \v 17 \w Was not the sin|strong="H05771"\w* \w of Peor|strong="H06465"\w* \w enough|strong="H04592"\w* for us, \w from which|strong="H00834"\w* \w we have not|strong="H03808"\w* \w cleansed|strong="H02891"\w* \w ourselves|strong="H04480"\w* \w to|strong="H05704"\w* \w this|strong="H02088"\w* \w day|strong="H03117"\w*? \w It even brought|strong="H01961"\w* \w a plague|strong="H05063"\w* \w upon the congregation|strong="H05712"\w* \w of the LORD|strong="H03068"\w*. \v 18 \w And now|strong="H03117"\w*, \w would you|strong="H00859"\w* \w turn away|strong="H07725"\w* \w from|strong="H00310"\w* \w the LORD|strong="H03068"\w*? \w If you|strong="H00859"\w* \w rebel|strong="H04775"\w* \w today|strong="H03117"\w* \w against the LORD|strong="H03068"\w*, \w tomorrow|strong="H04279"\w* \w He will be angry|strong="H07107"\w* \w with|strong="H00413"\w* \w the whole|strong="H03605"\w* \w congregation|strong="H05712"\w* \w of Israel|strong="H03478"\w*.
\p \v 19 \w If|strong="H00518"\w* \w indeed|strong="H00389"\w* \w the land|strong="H00776"\w* \w of your inheritance|strong="H00272"\w* \w is unclean|strong="H02931"\w*, \w then cross over|strong="H05674"\w* \w to|strong="H00413"\w* \w the land|strong="H00776"\w* \w of the LORD’s|strong="H03068"\w* \w possession|strong="H00272"\w*, \w where|strong="H00834"\w* \w the LORD’s|strong="H03068"\w* \w tabernacle|strong="H04908"\w* \w stands|strong="H07931"\w*, \w and take possession|strong="H00270"\w* \w of it among us|strong="H08432"\w*. \w But do not|strong="H00408"\w* \w rebel|strong="H04775"\w* \w against the LORD|strong="H03068"\w* \w or against us by building|strong="H01129"\w* for yourselves \w an altar|strong="H04196"\w* \w other than|strong="H01107"\w* \w the altar|strong="H04196"\w* \w of the LORD|strong="H03068"\w* \w our God|strong="H00430"\w*.
\p \v 20 \w Was not|strong="H03808"\w* \w Achan|strong="H05912"\w*\f + \fr 22:20 \fqa Achan \ft means \fqa troubler\ft ; also called \fqa Achar\ft in 1 Chronicles 2:7.\f* \w son|strong="H01121"\w* \w of Zerah|strong="H02226"\w* \w unfaithful|strong="H04603"\w* \w regarding|strong="H04604"\w* \w what was set apart for destruction|strong="H02764"\w*,\f + \fr 22:20 \ft Forms of the Hebrew \fqa cherem \ft refer to the giving over of things or persons to the LORD, either by destroying them or by giving them as an offering.\f* \w bringing wrath|strong="H07110"\w* \w upon|strong="H05921"\w* \w the whole|strong="H03605"\w* \w congregation|strong="H05712"\w* \w of Israel|strong="H03478"\w*? \w Yet it was not|strong="H03808"\w* \w only|strong="H00259"\w* \w Achan|strong="H01931"\w* \w who perished|strong="H01478"\w* \w because of his sin|strong="H05771"\w*!’”
\p \v 21 \w Then the Reubenites|strong="H01121"\w*, \w the Gadites|strong="H01121"\w*, \w and the half-tribe|strong="H02677"\w* \w of Manasseh|strong="H04519"\w* \w answered|strong="H06030"\w* \w the leaders|strong="H07218"\w* \w of the clans|strong="H00505"\w* \w of Israel|strong="H03478"\w*: \v 22 “\w The LORD|strong="H03068"\w*, \w the Mighty One|strong="H00410"\w*, \w is God|strong="H00430"\w*! \w The LORD|strong="H03068"\w*, \w the Mighty One|strong="H00410"\w*, \w is God|strong="H00430"\w*! \w He|strong="H01931"\w* \w knows|strong="H03045"\w*, \w and may Israel|strong="H03478"\w* \w also know|strong="H03045"\w*. \w If this|strong="H00518"\w* \w was in rebellion|strong="H04777"\w* \w or breach of faith|strong="H04604"\w* \w against the LORD|strong="H03068"\w*, \w do not|strong="H00408"\w* \w spare us|strong="H03467"\w* \w today|strong="H03117"\w*. \v 23 \w If we have built|strong="H01129"\w* for ourselves \w an altar|strong="H04196"\w* \w to turn away|strong="H07725"\w* \w from|strong="H00310"\w* \w Him|strong="H03068"\w* \w and|strong="H00518"\w* \w to offer|strong="H05927"\w* \w burnt offerings|strong="H05930"\w* \w and grain offerings|strong="H04503"\w* \w on it|strong="H05921"\w*, \w or|strong="H00518"\w* \w to sacrifice|strong="H06213"\w* \w peace|strong="H08002"\w* \w offerings|strong="H02077"\w* \w on it|strong="H05921"\w*, \w may the LORD|strong="H03068"\w* \w Himself|strong="H01931"\w* \w hold us accountable|strong="H01245"\w*.
\p \v 24 \w But in fact|strong="H00518"\w* \w we have done|strong="H06213"\w* \w this|strong="H02063"\w* \w for fear|strong="H01674"\w* \w that in the future|strong="H04279"\w* \w your descendants|strong="H01121"\w* \w might say|strong="H00559"\w* \w to ours|strong="H01121"\w*, ‘\w What|strong="H04100"\w* have you to do \w with the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*? \v 25 \w For the LORD|strong="H03068"\w* \w has made|strong="H05414"\w* \w the Jordan|strong="H03383"\w* \w a border|strong="H01366"\w* \w between us|strong="H00996"\w* \w and you|strong="H00996"\w* \w Reubenites|strong="H07205"\w* \w and|strong="H01121"\w* \w Gadites|strong="H01410"\w*. \w You have no|strong="H00369"\w* \w share|strong="H02506"\w* \w in the LORD|strong="H03068"\w*!’ \w So your descendants could cause|strong="H01121"\w* \w ours|strong="H01121"\w* \w to stop|strong="H07673"\w* \w fearing|strong="H03372"\w* \w the LORD|strong="H03068"\w*.
\p \v 26 \w That is why we said|strong="H00559"\w*, ‘\w Let us take action|strong="H06213"\w* \w and build|strong="H01129"\w* \w an altar for ourselves|strong="H04196"\w*, \w but not|strong="H03808"\w* \w for burnt offerings|strong="H05930"\w* \w or sacrifices|strong="H02077"\w*. \v 27 \w Rather|strong="H03588"\w*, \w let it be|strong="H01931"\w* \w a witness|strong="H05707"\w* \w between us|strong="H00996"\w* \w and you|strong="H00996"\w* \w and|strong="H00996"\w* \w the generations|strong="H01755"\w* \w to come|strong="H00310"\w*, \w that we will worship|strong="H05647"\w* \w the LORD|strong="H03068"\w* \w in His presence|strong="H06440"\w* \w with our burnt offerings|strong="H05930"\w*, \w sacrifices|strong="H02077"\w*, \w and peace offerings|strong="H08002"\w*.’ \w Then in the future|strong="H04279"\w*, \w your descendants|strong="H01121"\w* \w cannot|strong="H03808"\w* \w say|strong="H00559"\w* \w to ours|strong="H01121"\w*, ‘\w You have no|strong="H00369"\w* \w share|strong="H02506"\w* \w in the LORD|strong="H03068"\w*!’
