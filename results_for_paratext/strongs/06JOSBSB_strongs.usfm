\p \v 6 \w Be very|strong="H03966"\w* \w strong, then|strong="H02388"\w*, \w so that you can keep|strong="H08104"\w* \w and obey|strong="H06213"\w* \w all|strong="H03605"\w* \w that is written|strong="H03789"\w* \w in the Book|strong="H05612"\w* \w of the Law|strong="H08451"\w* \w of Moses|strong="H04872"\w*, \w not|strong="H01115"\w* \w turning aside|strong="H05493"\w* \w from it|strong="H04480"\w* \w to the right|strong="H03225"\w* \w or to the left|strong="H08040"\w*. \v 7 \w So you are not|strong="H01115"\w* \w to associate|strong="H00935"\w* \w with these|strong="H00428"\w* \w nations|strong="H01471"\w* \w that remain|strong="H07604"\w* \w among you|strong="H00854"\w*. \w You must not|strong="H03808"\w* \w call on|strong="H02142"\w* \w the names|strong="H08034"\w* \w of their gods|strong="H00430"\w* \w or|strong="H03808"\w* \w swear by them|strong="H07650"\w*, \w and you must not|strong="H03808"\w* \w serve them|strong="H05647"\w* \w or|strong="H03808"\w* \w bow down|strong="H07812"\w* to them. \v 8 \w Instead|strong="H03588"\w*, \w you shall hold fast|strong="H01692"\w* \w to the LORD|strong="H03068"\w* \w your God|strong="H00430"\w*, \w as|strong="H00834"\w* \w you have done|strong="H06213"\w* \w to|strong="H05704"\w* \w this|strong="H02088"\w* \w day|strong="H03117"\w*.
