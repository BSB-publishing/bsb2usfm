\p \v 5 \w Then I sent|strong="H07971"\w* \w Moses|strong="H04872"\w* \w and Aaron|strong="H00175"\w*, \w and I afflicted|strong="H05062"\w* \w the Egyptians|strong="H04714"\w* \w by what|strong="H00834"\w* \w I did|strong="H06213"\w* \w there|strong="H07130"\w*, \w and afterward|strong="H00310"\w* \w I brought you out|strong="H03318"\w*. \v 6 \w When I brought|strong="H03318"\w* \w your fathers|strong="H00001"\w* \w out of Egypt|strong="H04714"\w* \w and you reached|strong="H00935"\w* \w the Red Sea|strong="H03220"\w*,\f + \fr 24:6 \ft Or \fqa the Sea of Reeds\f* \w the Egyptians|strong="H04713"\w* \w pursued|strong="H07291"\w* \w them|strong="H00001"\w* \w with chariots|strong="H07393"\w* \w and horsemen|strong="H06571"\w* \w as far as the Red Sea|strong="H03220"\w*. \v 7 \w So your fathers cried out|strong="H06817"\w* \w to|strong="H00413"\w* \w the LORD|strong="H03068"\w*, \w and He put|strong="H07760"\w* \w darkness|strong="H03990"\w* \w between|strong="H00996"\w* \w you and the Egyptians|strong="H04713"\w*, \w over whom|strong="H05921"\w* \w He brought|strong="H00935"\w* \w the sea|strong="H03220"\w* \w and engulfed them|strong="H03680"\w*. \w Your very eyes|strong="H05869"\w* \w saw|strong="H07200"\w* \w what|strong="H00834"\w* \w I did|strong="H06213"\w* \w to the Egyptians|strong="H04714"\w*. \w Then you lived|strong="H03427"\w* \w in the wilderness|strong="H04057"\w* \w for a long|strong="H07227"\w* \w time|strong="H03117"\w*.
\p \v 8 \w Later, I brought|strong="H00935"\w* \w you to|strong="H00413"\w* \w the land|strong="H00776"\w* \w of the Amorites|strong="H00567"\w* \w who lived|strong="H03427"\w* \w beyond|strong="H05676"\w* \w the Jordan|strong="H03383"\w*. \w They fought|strong="H03898"\w* \w against you|strong="H00854"\w*, \w but I delivered|strong="H05414"\w* \w them|strong="H00853"\w* \w into your hand|strong="H03027"\w*, \w that you should possess|strong="H03423"\w* \w their land|strong="H00776"\w* \w when I destroyed them|strong="H08045"\w* \w before you|strong="H06440"\w*. \v 9 \w Then Balak|strong="H01111"\w* \w son|strong="H01121"\w* \w of Zippor|strong="H06834"\w*, \w the king|strong="H04428"\w* \w of Moab|strong="H04124"\w*, \w set out|strong="H06965"\w* \w to fight|strong="H03898"\w* \w against Israel|strong="H03478"\w*. \w He sent|strong="H07971"\w* \w for Balaam|strong="H01109"\w* \w son|strong="H01121"\w* \w of Beor|strong="H01160"\w* \w to curse you|strong="H07043"\w*, \v 10 \w but I would|strong="H00014"\w* \w not|strong="H03808"\w* \w listen|strong="H08085"\w* \w to Balaam|strong="H01109"\w*. \w So he blessed you again and again|strong="H01288"\w*, \w and I delivered|strong="H05337"\w* \w you|strong="H00853"\w* \w from his hand|strong="H03027"\w*.
\p \v 11 \w After this, you crossed|strong="H05674"\w* \w the Jordan|strong="H03383"\w* \w and came|strong="H00935"\w* \w to|strong="H00413"\w* \w Jericho|strong="H03405"\w*. \w The people|strong="H01167"\w* \w of Jericho|strong="H03405"\w* \w fought|strong="H03898"\w* against you, \w as did the Amorites|strong="H00567"\w*, \w Perizzites|strong="H06522"\w*, \w Canaanites|strong="H03669"\w*, \w Hittites|strong="H02850"\w*, \w Girgashites|strong="H01622"\w*, \w Hivites|strong="H02340"\w*, \w and Jebusites|strong="H02983"\w*, \w and I delivered|strong="H05414"\w* \w them|strong="H00853"\w* \w into your hand|strong="H03027"\w*. \v 12 \w I sent|strong="H07971"\w* \w the hornet|strong="H06880"\w* \w ahead of you|strong="H06440"\w*, \w and it drove out|strong="H01644"\w* \w the two|strong="H08147"\w* \w Amorite|strong="H00567"\w* \w kings|strong="H04428"\w* \w before you|strong="H06440"\w*, \w but not|strong="H03808"\w* \w by your own sword|strong="H02719"\w* \w or bow|strong="H07198"\w*. \v 13 \w So I gave|strong="H05414"\w* you \w a land|strong="H00776"\w* \w on which|strong="H00834"\w* \w you did not|strong="H03808"\w* \w toil|strong="H03021"\w* \w and cities|strong="H05892"\w* \w that|strong="H00834"\w* \w you did not|strong="H03808"\w* \w build|strong="H01129"\w*, \w and now you live|strong="H03427"\w* in them \w and eat|strong="H00398"\w* \w from vineyards|strong="H03754"\w* \w and olive groves|strong="H02132"\w* \w that|strong="H00834"\w* \w you did not|strong="H03808"\w* \w plant|strong="H05193"\w*.’
\s1 Choose Whom You Will Serve
\p \v 14 \w Now, therefore|strong="H06258"\w*, \w fear|strong="H03372"\w* \w the LORD|strong="H03068"\w* \w and serve|strong="H05647"\w* \w Him|strong="H00853"\w* \w in sincerity|strong="H08549"\w* \w and truth|strong="H00571"\w*; \w cast aside|strong="H05493"\w* \w the gods|strong="H00430"\w* \w your fathers|strong="H00001"\w* \w served|strong="H05647"\w* \w beyond|strong="H05676"\w* \w the Euphrates|strong="H05104"\w* \w and in Egypt|strong="H04714"\w*, \w and serve|strong="H05647"\w* \w the LORD|strong="H03068"\w*. \v 15 \w But if|strong="H00518"\w* \w it is unpleasing|strong="H07451"\w* \w in your sight|strong="H05869"\w* \w to serve|strong="H05647"\w* \w the LORD|strong="H03068"\w*, \w then choose|strong="H00977"\w* for yourselves \w this day|strong="H03117"\w* \w whom|strong="H04310"\w* \w you will serve|strong="H05647"\w*, \w whether the|strong="H00518"\w* \w gods|strong="H00430"\w* \w your fathers|strong="H00001"\w* \w served|strong="H05647"\w* \w beyond|strong="H05676"\w* \w the Euphrates|strong="H05104"\w*, \w or|strong="H00518"\w* \w the gods|strong="H00430"\w* \w of the Amorites|strong="H00567"\w* \w in whose|strong="H00834"\w* \w land|strong="H00776"\w* \w you|strong="H00859"\w* \w are living|strong="H03427"\w*. \w As for me|strong="H00595"\w* \w and my house|strong="H01004"\w*, \w we will serve|strong="H05647"\w* \w the LORD|strong="H03068"\w*!”
\p \v 16 \w The people|strong="H05971"\w* \w replied|strong="H06030"\w*, “\w Far be it|strong="H02486"\w* from us \w to forsake|strong="H05800"\w* \w the LORD|strong="H03068"\w* \w to serve|strong="H05647"\w* \w other|strong="H00312"\w* \w gods|strong="H00430"\w*! \v 17 \w For|strong="H03588"\w* \w the LORD|strong="H03068"\w* \w our God|strong="H00430"\w* \w brought|strong="H05927"\w* \w us|strong="H00853"\w* \w and|strong="H00853"\w* \w our fathers|strong="H00001"\w* \w out of the land|strong="H00776"\w* \w of Egypt|strong="H04714"\w*, \w out of the house|strong="H01004"\w* \w of slavery|strong="H05650"\w*, \w and|strong="H00834"\w* \w performed|strong="H06213"\w* \w these|strong="H00428"\w* \w great|strong="H01419"\w* \w signs|strong="H00226"\w* \w before our eyes|strong="H05869"\w*. \w He also protected us|strong="H08104"\w* \w throughout|strong="H03605"\w* \w our journey|strong="H01870"\w* \w and among all|strong="H03605"\w* \w the nations|strong="H05971"\w* \w through which|strong="H00834"\w* \w we traveled|strong="H05674"\w*. \v 18 \w And the LORD|strong="H03068"\w* \w drove out|strong="H01644"\w* \w before us|strong="H06440"\w* \w all|strong="H03605"\w* \w the nations|strong="H05971"\w*, \w including the Amorites|strong="H00567"\w* \w who lived|strong="H03427"\w* \w in the land|strong="H00776"\w*. \w We|strong="H00587"\w* \w too|strong="H01571"\w* \w will serve|strong="H05647"\w* \w the LORD|strong="H03068"\w*, \w because|strong="H03588"\w* \w He|strong="H01931"\w* \w is our God|strong="H00430"\w*!”
\p \v 19 \w But Joshua|strong="H03091"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w the people|strong="H05971"\w*, “\w You are not|strong="H03808"\w* \w able|strong="H03201"\w* \w to serve|strong="H05647"\w* \w the LORD|strong="H03068"\w*, \w for|strong="H03588"\w* \w He|strong="H01931"\w* \w is a holy|strong="H06918"\w* \w God|strong="H00430"\w*; \w He|strong="H01931"\w* \w is a jealous|strong="H07072"\w* \w God|strong="H00410"\w*; \w He will not|strong="H03808"\w* \w forgive|strong="H05375"\w* \w your rebellion|strong="H06588"\w* \w or your sins|strong="H02403"\w*. \v 20 \w If|strong="H03588"\w* \w you forsake|strong="H05800"\w* \w the LORD|strong="H03068"\w* \w and serve|strong="H05647"\w* \w foreign|strong="H05236"\w* \w gods|strong="H00430"\w*, \w He will turn|strong="H07725"\w* \w and bring disaster|strong="H07489"\w* on you \w and consume|strong="H03615"\w* \w you|strong="H00853"\w*, \w even after|strong="H00310"\w* \w He has been good|strong="H03190"\w* to you.”
\p \v 21 “\w No|strong="H03808"\w*!” \w replied|strong="H00559"\w* \w the people|strong="H05971"\w*. “\w We will serve|strong="H05647"\w* \w the LORD|strong="H03068"\w*!”
\p \v 22 \w Then Joshua|strong="H03091"\w* \w told|strong="H00559"\w* \w them|strong="H05971"\w*, “\w You|strong="H00859"\w* \w are witnesses|strong="H05707"\w* against yourselves \w that|strong="H03588"\w* \w you|strong="H00859"\w* \w have chosen|strong="H00977"\w* \w to serve|strong="H05647"\w* \w the LORD|strong="H03068"\w*.”
\p “\w We are witnesses|strong="H05707"\w*!” \w they said|strong="H00559"\w*.
\p \v 23 “\w Now, therefore,” he said,|strong="H06258"\w* “\w get rid of|strong="H05493"\w* \w the foreign|strong="H05236"\w* \w gods|strong="H00430"\w* \w among you|strong="H07130"\w* \w and incline|strong="H05186"\w* \w your hearts|strong="H03824"\w* \w to|strong="H00413"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*.”
\p \v 24 \w So the people|strong="H05971"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w Joshua|strong="H03091"\w*, “\w We will serve|strong="H05647"\w* \w the LORD|strong="H03068"\w* \w our God|strong="H00430"\w* \w and obey|strong="H08085"\w* \w His voice|strong="H06963"\w*.”
\p \v 25 \w On that|strong="H01931"\w* \w day|strong="H03117"\w* \w Joshua|strong="H03091"\w* \w made|strong="H03772"\w* \w a covenant|strong="H01285"\w* \w for the people|strong="H05971"\w*, \w and there at Shechem|strong="H07927"\w* \w he established|strong="H07760"\w* for them \w a statute|strong="H02706"\w* \w and ordinance|strong="H04941"\w*. \v 26 \w Joshua|strong="H03091"\w* \w recorded|strong="H03789"\w* \w these|strong="H00428"\w* \w things|strong="H01697"\w* \w in the Book|strong="H05612"\w* \w of the Law|strong="H08451"\w* \w of God|strong="H00430"\w*. \w Then he took|strong="H03947"\w* \w a large|strong="H01419"\w* \w stone|strong="H00068"\w* \w and set it up|strong="H06965"\w* \w there|strong="H08033"\w* \w under|strong="H08478"\w* \w the oak|strong="H00427"\w*\f + \fr 24:26 \ft Or \fqa terebinth\f* \w that was|strong="H00834"\w* \w near the sanctuary|strong="H04720"\w* \w of the LORD|strong="H03068"\w*. \v 27 \w And Joshua|strong="H03091"\w* \w said|strong="H00559"\w* \w to|strong="H00413"\w* \w all|strong="H03605"\w* \w the people|strong="H05971"\w*, “\w You see|strong="H02009"\w* \w this|strong="H02063"\w* \w stone|strong="H00068"\w*. \w It will be|strong="H01961"\w* \w a witness|strong="H05713"\w* against us, \w for|strong="H03588"\w* \w it|strong="H01931"\w* \w has heard|strong="H08085"\w* \w all|strong="H03605"\w* \w the words|strong="H00561"\w* \w the LORD|strong="H03068"\w* \w has spoken|strong="H01696"\w* \w to us|strong="H05973"\w*, \w and it will be|strong="H01961"\w* \w a witness|strong="H05713"\w* against you \w if you ever|strong="H06435"\w* \w deny|strong="H03584"\w* \w your God|strong="H00430"\w*.”
\p \v 28 \w Then Joshua|strong="H03091"\w* \w sent the people|strong="H05971"\w* \w away|strong="H07971"\w*, \w each|strong="H00376"\w* \w to his own inheritance|strong="H05159"\w*.
\s1 Joshua’s Death and Burial
\p \v 29 \w Some time later|strong="H00310"\w*, \w Joshua|strong="H03091"\w* \w son|strong="H01121"\w* \w of Nun|strong="H05126"\w*, \w the servant|strong="H05650"\w* \w of the LORD|strong="H03068"\w*, \w died|strong="H04191"\w* \w at the age|strong="H01121"\w* \w of 110|strong="H03967"\w*. \v 30 \w And they buried|strong="H06912"\w* \w him|strong="H00853"\w* \w in the land|strong="H01366"\w* \w of his inheritance|strong="H05159"\w*, \w at Timnath-serah|strong="H08556"\w*\f + \fr 24:30 \fqa Timnath-serah \ft is also known as \fqa Timnath-heres\ft ; see Judges 2:9.\f* \w in the hill country|strong="H02022"\w* \w of Ephraim|strong="H00669"\w*, \w north|strong="H06828"\w* \w of Mount|strong="H02022"\w* \w Gaash|strong="H01608"\w*. \v 31 \w Israel|strong="H03478"\w* \w had served|strong="H05647"\w* \w the LORD|strong="H03068"\w* \w throughout|strong="H03605"\w* \w the days|strong="H03117"\w* \w of Joshua|strong="H03091"\w* \w and|strong="H03605"\w* \w of the elders|strong="H02205"\w* \w who|strong="H00834"\w* \w outlived|strong="H00748"\w* \w him|strong="H03091"\w* \w and|strong="H00834"\w* \w who had experienced|strong="H03045"\w* \w all|strong="H03605"\w* \w the works|strong="H04639"\w* \w that|strong="H00834"\w* \w the LORD|strong="H03068"\w* \w had done|strong="H06213"\w* \w for Israel|strong="H03478"\w*.
\p \v 32 \w And|strong="H00853"\w* \w the bones|strong="H06106"\w* \w of Joseph|strong="H03130"\w*, \w which|strong="H00834"\w* \w the Israelites|strong="H01121"\w* \w had brought up|strong="H05927"\w* \w out of Egypt|strong="H04714"\w*, \w were buried|strong="H06912"\w* \w at Shechem|strong="H07927"\w* \w in the plot|strong="H02513"\w* \w of land|strong="H07704"\w* \w that|strong="H00834"\w* \w Jacob|strong="H03290"\w* \w had purchased|strong="H07069"\w* \w from the sons|strong="H01121"\w* \w of Hamor|strong="H02544"\w*, \w Shechem’s|strong="H07927"\w* \w father|strong="H00001"\w*, \w for a hundred|strong="H03967"\w* \w pieces of silver|strong="H07192"\w*.\f + \fr 24:32 \ft Hebrew \fqa a hundred kesitahs\ft ; the value or weight of the kesitah is no longer known.\f* \w So it became|strong="H01961"\w* \w an inheritance|strong="H05159"\w* \w for Joseph’s|strong="H03130"\w* \w descendants|strong="H01121"\w*.
\p \v 33 \w Eleazar|strong="H00499"\w* \w son|strong="H01121"\w* \w of Aaron|strong="H00175"\w* \w also died|strong="H04191"\w*, \w and they buried|strong="H06912"\w* \w him|strong="H00853"\w* \w at Gibeah|strong="H01389"\w*, \w which|strong="H00834"\w* \w had been given|strong="H05414"\w* to his \w son|strong="H01121"\w* \w Phinehas|strong="H06372"\w* \w in the hill country|strong="H02022"\w* \w of Ephraim|strong="H00669"\w*.
