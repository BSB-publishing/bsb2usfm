\s1 God Instructs Joshua
\p \v 1 \w Now|strong="H01961"\w* \w after|strong="H00310"\w* \w the death|strong="H04194"\w* \w of His|strong="H03068"\w* \w servant|strong="H05650"\w* \w Moses|strong="H04872"\w*, \w the LORD|strong="H03068"\w* \w spoke|strong="H00559"\w* \w to|strong="H00413"\w* \w Joshua|strong="H03091"\w* \w son|strong="H01121"\w* \w of Nun|strong="H05126"\w*, \w Moses’|strong="H04872"\w* \w assistant|strong="H08334"\w*, \w saying|strong="H00559"\w*, \v 2 “\w Moses|strong="H04872"\w* \w My servant|strong="H05650"\w* \w is dead|strong="H04191"\w*. \w Now therefore|strong="H06258"\w* \w arise|strong="H06965"\w*, \w you|strong="H00859"\w* \w and all|strong="H03605"\w* \w these people|strong="H05971"\w*, \w and cross over|strong="H05674"\w* \w the Jordan|strong="H03383"\w* \w into|strong="H00413"\w* \w the land|strong="H00776"\w* \w that|strong="H00834"\w* \w I|strong="H00595"\w* \w am giving|strong="H05414"\w* to \w the children|strong="H01121"\w* \w of Israel|strong="H03478"\w*.
\p \v 3 \w I have given you|strong="H05414"\w* \w every|strong="H03605"\w* \w place|strong="H04725"\w* \w where|strong="H00834"\w* \w the sole|strong="H03709"\w* \w of your foot|strong="H07272"\w* \w will tread|strong="H01869"\w*, \w just as|strong="H00834"\w* \w I promised|strong="H01696"\w* \w to|strong="H00413"\w* \w Moses|strong="H04872"\w*. \v 4 \w Your territory|strong="H01366"\w* \w shall extend|strong="H01961"\w* \w from the wilderness|strong="H04057"\w* \w and Lebanon|strong="H03844"\w* \w to|strong="H05704"\w* \w the great|strong="H01419"\w* \w River|strong="H05104"\w* \w Euphrates|strong="H06578"\w*— \w all|strong="H03605"\w* \w the land|strong="H00776"\w* \w of the Hittites|strong="H02850"\w*— \w and west|strong="H03996"\w* \w as far as|strong="H05704"\w* \w the Great|strong="H01419"\w* \w Sea|strong="H03220"\w*.\f + \fr 1:4 \ft That is, the Mediterranean Sea\f*
\p \v 5 \w No|strong="H03808"\w* \w one|strong="H00376"\w* \w shall stand|strong="H03320"\w* \w against you|strong="H06440"\w* \w all|strong="H03605"\w* \w the days|strong="H03117"\w* \w of your life|strong="H02416"\w*. \w As|strong="H00834"\w* \w I was|strong="H01961"\w* \w with|strong="H05973"\w* \w Moses|strong="H04872"\w*, \w so will I be|strong="H01961"\w* \w with you|strong="H05973"\w*; \w I will never|strong="H03808"\w* \w leave you|strong="H07503"\w* \w nor|strong="H03808"\w* \w forsake you|strong="H05800"\w*.\f + \fr 1:5 \ft Cited in Hebrews 13:5\f*
