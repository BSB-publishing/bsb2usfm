\p \v 1 \w When Mordecai|strong="H04782"\w* \w learned of|strong="H03045"\w* \w all|strong="H03605"\w* \w that|strong="H00834"\w* \w had happened|strong="H06213"\w*, \w he|strong="H04782"\w* \w tore|strong="H07167"\w* \w his clothes|strong="H00899"\w*, \w put on|strong="H03847"\w* \w sackcloth|strong="H08242"\w* \w and ashes|strong="H00665"\w*, \w and went out|strong="H03318"\w* \w into the middle|strong="H08432"\w* \w of the city|strong="H05892"\w*, \w wailing|strong="H02199"\w* \w loudly|strong="H01419"\w* \w and bitterly|strong="H04751"\w*. \v 2 \w But he went only|strong="H00935"\w* \w as|strong="H05704"\w* \w far as the king’s|strong="H04428"\w* \w gate|strong="H08179"\w*, \w because|strong="H03588"\w* \w the law prohibited|strong="H00369"\w* \w anyone wearing|strong="H03830"\w* \w sackcloth|strong="H08242"\w* \w from entering|strong="H00935"\w* \w that|strong="H04428"\w* \w gate|strong="H08179"\w*.
\p \v 3 \w In every|strong="H03605"\w* \w province|strong="H04082"\w* \w to which|strong="H04725"\w* \w the king’s|strong="H04428"\w* \w command|strong="H01697"\w* \w and edict|strong="H01881"\w* \w came|strong="H05060"\w*, \w there was great|strong="H01419"\w* \w mourning|strong="H00060"\w* \w among the Jews|strong="H03064"\w*. \w They fasted|strong="H06685"\w*, \w wept|strong="H01065"\w*, \w and lamented|strong="H04553"\w*, \w and many|strong="H07227"\w* \w lay|strong="H03331"\w* \w in sackcloth|strong="H08242"\w* \w and ashes|strong="H00665"\w*.
\p \v 4 \w When Esther’s|strong="H00635"\w* \w maidens|strong="H05291"\w* \w and eunuchs|strong="H05631"\w* \w came|strong="H00935"\w* \w and told|strong="H05046"\w* her about Mordecai, \w the queen|strong="H04436"\w* \w was overcome with distress|strong="H02342"\w*. \w She sent|strong="H07971"\w* \w clothes|strong="H00899"\w* \w for Mordecai|strong="H04782"\w* \w to wear|strong="H03847"\w* \w instead of|strong="H05493"\w* \w his sackcloth|strong="H08242"\w*, \w but he would not|strong="H03808"\w* \w accept them|strong="H06901"\w*.
\p \v 5 \w Then Esther|strong="H00635"\w* \w summoned|strong="H07121"\w* \w Hathach|strong="H02047"\w*, \w one of the king’s|strong="H04428"\w* \w eunuchs|strong="H05631"\w* \w appointed|strong="H05975"\w* \w to her|strong="H06440"\w*, \w and she dispatched him|strong="H06680"\w* \w to|strong="H05921"\w* \w Mordecai|strong="H04782"\w* \w to learn|strong="H03045"\w* \w what was troubling him|strong="H04100"\w* \w and why|strong="H05921"\w*. \v 6 \w So Hathach|strong="H02047"\w* \w went out|strong="H03318"\w* \w to|strong="H00413"\w* \w Mordecai|strong="H04782"\w* \w in|strong="H00413"\w* \w the city|strong="H05892"\w* \w square|strong="H07339"\w* \w in front|strong="H06440"\w* \w of the king’s|strong="H04428"\w* \w gate|strong="H08179"\w*, \v 7 \w and Mordecai|strong="H04782"\w* \w told|strong="H05046"\w* him \w all|strong="H03605"\w* \w that|strong="H00834"\w* \w had happened to him|strong="H07136"\w*, \w including|strong="H00853"\w* \w the exact amount|strong="H06575"\w* \w of money|strong="H03701"\w* \w that|strong="H00834"\w* \w Haman|strong="H02001"\w* \w had promised|strong="H00559"\w* \w to pay|strong="H08254"\w* \w into|strong="H05921"\w* \w the royal|strong="H04428"\w* \w treasury|strong="H01595"\w* \w in order to destroy|strong="H00006"\w* \w the Jews|strong="H03064"\w*.
