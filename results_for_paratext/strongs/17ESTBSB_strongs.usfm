\s1 Haman’s Plot against Mordecai
\p \v 9 \w That|strong="H01931"\w* \w day|strong="H03117"\w* \w Haman|strong="H02001"\w* \w went out|strong="H03318"\w* \w full of joy|strong="H08056"\w* \w and glad|strong="H02896"\w* \w of heart|strong="H03820"\w*. \w At the king’s|strong="H04428"\w* \w gate, however|strong="H08179"\w*, \w he|strong="H02001"\w* \w saw|strong="H07200"\w* \w Mordecai|strong="H04782"\w*, \w who did not|strong="H03808"\w* \w rise|strong="H06965"\w* \w or tremble in fear|strong="H02111"\w* \w at his presence|strong="H04480"\w*. \w And Haman|strong="H02001"\w* \w was filled|strong="H04390"\w* \w with rage|strong="H02534"\w* \w toward|strong="H05921"\w* \w Mordecai|strong="H04782"\w*.
\p \v 10 \w Nevertheless, Haman|strong="H02001"\w* \w restrained himself|strong="H00662"\w* \w and went|strong="H00935"\w* \w home|strong="H01004"\w*. \w And calling for|strong="H07971"\w* \w his friends|strong="H00157"\w* \w and his wife|strong="H00802"\w* \w Zeresh|strong="H02238"\w*, \v 11 \w Haman|strong="H02001"\w* \w recounted|strong="H05608"\w* to them \w his glorious|strong="H03519"\w* \w wealth|strong="H06239"\w*, \w his many|strong="H07230"\w* \w sons|strong="H01121"\w*, \w and|strong="H00853"\w* \w all the ways|strong="H03605"\w* \w the king|strong="H04428"\w* \w had honored|strong="H01431"\w* \w and promoted him|strong="H05375"\w* \w over|strong="H05921"\w* \w the other officials|strong="H08269"\w* \w and servants|strong="H05650"\w*.
