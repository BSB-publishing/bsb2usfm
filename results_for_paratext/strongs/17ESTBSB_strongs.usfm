\p \v 6 \w Haman|strong="H02001"\w* \w entered|strong="H00935"\w*, \w and the king|strong="H04428"\w* \w asked|strong="H00559"\w* him, “\w What|strong="H04100"\w* \w should be done|strong="H06213"\w* \w for the man|strong="H00376"\w* \w whom|strong="H00834"\w* \w the king|strong="H04428"\w* \w is delighted|strong="H02654"\w* \w to honor|strong="H03366"\w*?”
\p \w Now Haman|strong="H02001"\w* \w thought|strong="H00559"\w* \w to himself|strong="H03820"\w*, “\w Whom|strong="H04310"\w* \w would the king|strong="H04428"\w* \w be delighted|strong="H02654"\w* \w to honor|strong="H06213"\w* \w more|strong="H03148"\w* \w than me|strong="H04480"\w*?”
\p \v 7 \w And Haman|strong="H02001"\w* \w told|strong="H00559"\w* \w the king|strong="H04428"\w*, “\w For the man|strong="H00376"\w* \w whom|strong="H00834"\w* \w the king|strong="H04428"\w* \w is delighted|strong="H02654"\w* \w to honor|strong="H03366"\w*, \v 8 \w have them bring|strong="H00935"\w* \w a royal|strong="H04438"\w* \w robe|strong="H03830"\w* \w that|strong="H00834"\w* \w the king himself|strong="H04428"\w* \w has worn|strong="H03847"\w* \w and a horse|strong="H05483"\w* \w on which|strong="H00834"\w* \w the king himself|strong="H04428"\w* \w has ridden|strong="H07392"\w*— \w one with|strong="H00834"\w* \w a royal|strong="H04438"\w* \w crest|strong="H03804"\w* \w placed|strong="H05414"\w* \w on its head|strong="H07218"\w*. \v 9 \w Let|strong="H05414"\w* \w the robe|strong="H03830"\w* \w and the horse|strong="H05483"\w* \w be entrusted|strong="H05921"\w* \w to one|strong="H00376"\w* \w of the king’s|strong="H04428"\w* \w most noble|strong="H06579"\w* \w princes|strong="H08269"\w*. \w Let them array|strong="H03847"\w* \w the man|strong="H00376"\w* \w the king|strong="H04428"\w* \w wants|strong="H02654"\w* \w to honor|strong="H03366"\w* \w and parade him|strong="H07392"\w* \w on|strong="H05921"\w* \w the horse|strong="H05483"\w* \w through the city|strong="H05892"\w* \w square|strong="H07339"\w*, \w proclaiming|strong="H07121"\w* \w before him|strong="H06440"\w*, ‘\w This is what|strong="H03602"\w* \w is done|strong="H06213"\w* \w for the man|strong="H00376"\w* \w whom|strong="H00834"\w* \w the king|strong="H04428"\w* \w is delighted|strong="H02654"\w* \w to honor|strong="H03366"\w*!’”
\p \v 10 “\w Hurry|strong="H04116"\w*,” \w said|strong="H00559"\w* \w the king|strong="H04428"\w* \w to Haman|strong="H02001"\w*, “\w and do|strong="H06213"\w* \w just as|strong="H00834"\w* \w you proposed|strong="H01696"\w*. \w Take|strong="H03947"\w* \w the robe|strong="H03830"\w* \w and|strong="H00853"\w* \w the horse|strong="H05483"\w* \w to Mordecai|strong="H04782"\w* \w the Jew|strong="H03064"\w*, \w who is sitting|strong="H03427"\w* \w at the king’s|strong="H04428"\w* \w gate|strong="H08179"\w*. \w Do not|strong="H00408"\w* \w neglect|strong="H05307"\w* \w anything|strong="H01697"\w* \w that|strong="H00834"\w* \w you have suggested|strong="H01696"\w*.”
\p \v 11 \w So Haman|strong="H02001"\w* \w took|strong="H03947"\w* \w the robe|strong="H03830"\w* \w and the horse|strong="H05483"\w*, \w arrayed|strong="H03847"\w* \w Mordecai|strong="H04782"\w*, \w and paraded him|strong="H07392"\w* \w through the city|strong="H05892"\w* \w square|strong="H07339"\w*, \w crying out|strong="H07121"\w* \w before him|strong="H06440"\w*, “\w This is what|strong="H03602"\w* \w is done|strong="H06213"\w* \w for the man|strong="H00376"\w* \w whom|strong="H00834"\w* \w the king|strong="H04428"\w* \w is delighted|strong="H02654"\w* \w to honor|strong="H03366"\w*!”
\p \v 12 \w Then Mordecai|strong="H04782"\w* \w returned|strong="H07725"\w* \w to|strong="H00413"\w* \w the king’s|strong="H04428"\w* \w gate|strong="H08179"\w*. \w But Haman|strong="H02001"\w* \w rushed|strong="H01765"\w* \w home|strong="H01004"\w*, \w with his head|strong="H07218"\w* \w covered|strong="H02645"\w* \w in grief|strong="H00057"\w*.
\p \v 13 \w Haman|strong="H02001"\w* \w told|strong="H05608"\w* \w his wife|strong="H00802"\w* \w Zeresh|strong="H02238"\w* \w and all|strong="H03605"\w* \w his friends|strong="H00157"\w* \w everything|strong="H03605"\w* \w that|strong="H00834"\w* \w had happened|strong="H07136"\w*. \w His advisers|strong="H02450"\w* \w and his wife|strong="H00802"\w* \w Zeresh|strong="H02238"\w* \w said|strong="H00559"\w* to him, “\w Since|strong="H00518"\w* \w Mordecai|strong="H04782"\w*, \w before|strong="H06440"\w* \w whom|strong="H00834"\w* \w your downfall|strong="H05307"\w* \w has begun|strong="H02490"\w*, \w is Jewish|strong="H03064"\w*, \w you will not prevail|strong="H03201"\w* against him — \w for|strong="H03588"\w* \w surely you will fall|strong="H05307"\w* \w before him|strong="H06440"\w*.”
\p \v 14 \w While they were still|strong="H05750"\w* \w speaking|strong="H01696"\w* \w with Haman|strong="H05973"\w*, \w the king’s|strong="H04428"\w* \w eunuchs|strong="H05631"\w* \w arrived|strong="H05060"\w* \w and rushed|strong="H00926"\w* \w him|strong="H02001"\w* \w to|strong="H00413"\w* \w the banquet|strong="H04960"\w* \w that|strong="H00834"\w* \w Esther|strong="H00635"\w* \w had prepared|strong="H06213"\w*.
\c 7
\s1 Esther Pleads for Her People
\p \v 1 \w So the king|strong="H04428"\w* \w and Haman|strong="H02001"\w* \w went|strong="H00935"\w* \w to dine|strong="H08354"\w* \w with|strong="H05973"\w* \w Esther|strong="H00635"\w* \w the queen|strong="H04436"\w*, \v 2 \w and as they drank|strong="H04960"\w* \w their wine|strong="H03196"\w* \w on that second|strong="H08145"\w* \w day|strong="H03117"\w*, \w the king|strong="H04428"\w* \w asked|strong="H00559"\w* \w once more|strong="H01571"\w*, “\w Queen|strong="H04436"\w* \w Esther|strong="H00635"\w*, \w what is|strong="H04100"\w* \w your petition|strong="H07596"\w*? \w It will be given|strong="H05414"\w* to you. \w What is|strong="H04100"\w* \w your request|strong="H01246"\w*? \w Even up to|strong="H05704"\w* \w half|strong="H02677"\w* \w the kingdom|strong="H04438"\w*, \w it will be fulfilled|strong="H06213"\w*.”
\p \v 3 \w Queen|strong="H04436"\w* \w Esther|strong="H00635"\w* \w replied|strong="H06030"\w*, “\w If|strong="H00518"\w* \w I have found|strong="H04672"\w* \w favor|strong="H02580"\w* \w in your sight|strong="H05869"\w*, \w O king|strong="H04428"\w*, \w and if|strong="H00518"\w* \w it pleases|strong="H02896"\w* \w the king|strong="H04428"\w*, \w grant|strong="H05414"\w* me \w my life|strong="H05315"\w* \w as my petition|strong="H07596"\w*, \w and the lives of my people|strong="H05971"\w* \w as my request|strong="H01246"\w*. \v 4 \w For|strong="H03588"\w* \w my people|strong="H05971"\w* \w and I|strong="H00589"\w* \w have been sold out|strong="H04376"\w* \w to destruction|strong="H08045"\w*, \w death|strong="H02026"\w*, \w and annihilation|strong="H00006"\w*. \w If|strong="H00432"\w* \w we had merely been sold|strong="H04376"\w* \w as menservants|strong="H05650"\w* \w and maidservants|strong="H08198"\w*, \w I would have remained silent|strong="H02790"\w*, \w because|strong="H03588"\w* \w no|strong="H00369"\w* \w such distress|strong="H06862"\w* \w would justify|strong="H07737"\w* \w burdening|strong="H05143"\w* \w the king|strong="H04428"\w*.”
\p \v 5 \w Then King|strong="H04428"\w* \w Xerxes|strong="H00325"\w* \w spoke up|strong="H00559"\w* \w and asked|strong="H00559"\w* \w Queen|strong="H04436"\w* \w Esther|strong="H00635"\w*, “\w Who|strong="H04310"\w* \w is this|strong="H02088"\w*, \w and where|strong="H00335"\w* \w is the one|strong="H01931"\w* \w who|strong="H00834"\w* \w would|strong="H04390"\w* \w devise|strong="H06213"\w*\f + \fr 7:5 \ft Hebrew \fqa whose heart has filled him to do\f* \w such a scheme?|strong="H03651"\w*”
\p \v 6 \w Esther|strong="H00635"\w* \w replied|strong="H00559"\w*, “\w The adversary|strong="H06862"\w* \w and enemy|strong="H00341"\w* \w is this|strong="H02088"\w* \w wicked man|strong="H07451"\w* — \w Haman|strong="H02001"\w*!”
\p \w And Haman|strong="H02001"\w* \w stood in terror|strong="H01204"\w* \w before|strong="H06440"\w* \w the king|strong="H04428"\w* \w and queen|strong="H04436"\w*.
\s1 The Hanging of Haman
\p \v 7 \w In his fury|strong="H02534"\w*, \w the king|strong="H04428"\w* \w arose|strong="H06965"\w* \w from drinking|strong="H04960"\w* \w his wine|strong="H03196"\w* \w and went to|strong="H00413"\w* \w the palace|strong="H01055"\w* \w garden|strong="H01594"\w*, \w while Haman|strong="H02001"\w* \w stayed behind|strong="H05975"\w* \w to beg|strong="H01245"\w* \w Queen|strong="H04436"\w* \w Esther|strong="H00635"\w* \w for|strong="H05921"\w* \w his life|strong="H05315"\w*, \w for|strong="H03588"\w* \w he realized|strong="H07200"\w* \w that|strong="H03588"\w* \w the king|strong="H04428"\w* \w was planning|strong="H03615"\w* \w a terrible fate|strong="H07451"\w* \w for him|strong="H00413"\w*.
\p \v 8 \w Just as the king|strong="H04428"\w* \w returned|strong="H07725"\w* \w from the palace|strong="H01055"\w* \w garden|strong="H01594"\w* \w to|strong="H00413"\w* \w the banquet hall|strong="H01004"\w*, \w Haman|strong="H02001"\w* \w was falling|strong="H05307"\w* \w on|strong="H05921"\w* \w the couch|strong="H04296"\w* \w where|strong="H00834"\w* \w Esther|strong="H00635"\w* \w was reclining|strong="H05921"\w*. \w The king|strong="H04428"\w* \w exclaimed|strong="H00559"\w*, “\w Would he actually|strong="H01571"\w* \w assault|strong="H03533"\w* \w the queen|strong="H04436"\w* \w while|strong="H05973"\w* \w I am in the palace|strong="H01004"\w*?”
\p \w As soon as the words|strong="H01697"\w* \w had left|strong="H03318"\w* \w the king’s|strong="H04428"\w* \w mouth|strong="H06310"\w*, \w they covered|strong="H02645"\w* \w Haman’s|strong="H02001"\w* \w face|strong="H06440"\w*.
\p \v 9 \w Then Harbonah|strong="H02726"\w*, \w one|strong="H00259"\w* \w of|strong="H04480"\w* \w the eunuchs|strong="H05631"\w* \w attending|strong="H06440"\w* \w the king|strong="H04428"\w*, \w said|strong="H00559"\w*: “\w There|strong="H02009"\w* \w is a gallows|strong="H06086"\w* \w fifty|strong="H02572"\w* \w cubits|strong="H00520"\w* \w high|strong="H01364"\w*\f + \fr 7:9 \fqa 50 cubits \ft is approximately 75 feet or 22.9 meters high.\f* \w at Haman’s|strong="H02001"\w* \w house|strong="H01004"\w*. \w He|strong="H02001"\w* \w had it built|strong="H06213"\w* \w for Mordecai|strong="H04782"\w*, \w who|strong="H00834"\w* \w gave the report|strong="H01696"\w* \w that saved|strong="H02896"\w* \w the king|strong="H04428"\w*.”
\p “\w Hang him|strong="H08518"\w* \w on it|strong="H05921"\w*!” \w declared|strong="H00559"\w* \w the king|strong="H04428"\w*.
\p \v 10 \w So they hanged|strong="H08518"\w* \w Haman|strong="H02001"\w* \w on|strong="H05921"\w* \w the gallows|strong="H06086"\w* \w he had prepared|strong="H03559"\w* \w for Mordecai|strong="H04782"\w*. \w Then the fury|strong="H02534"\w* \w of the king|strong="H04428"\w* \w subsided|strong="H07918"\w*.
\c 8
\s1 Esther Appeals for the Jews
\p \v 1 \w That same|strong="H01931"\w* \w day|strong="H03117"\w* \w King|strong="H04428"\w* \w Xerxes|strong="H00325"\w* \w awarded|strong="H05414"\w* \w Queen|strong="H04436"\w* \w Esther|strong="H00635"\w* \w the estate|strong="H01004"\w* \w of Haman|strong="H02001"\w*, \w the enemy|strong="H06887"\w* \w of the Jews|strong="H03064"\w*. \w And Mordecai|strong="H04782"\w* \w entered|strong="H00935"\w* \w the king’s|strong="H04428"\w* \w presence|strong="H06440"\w* \w because|strong="H03588"\w* \w Esther|strong="H00635"\w* \w had revealed|strong="H05046"\w* \w his relation|strong="H01931"\w* to her. \v 2 \w The king|strong="H04428"\w* \w removed|strong="H05493"\w* \w the signet ring|strong="H02885"\w* \w he had recovered|strong="H05674"\w* \w from Haman|strong="H02001"\w* \w and presented it|strong="H05414"\w* \w to Mordecai|strong="H04782"\w*. \w And Esther|strong="H00635"\w* \w appointed|strong="H07760"\w* \w Mordecai|strong="H04782"\w* \w over|strong="H05921"\w* \w the estate|strong="H01004"\w* \w of Haman|strong="H02001"\w*.
\p \v 3 \w And once again|strong="H03254"\w*, \w Esther|strong="H00635"\w* \w addressed|strong="H01696"\w* \w the king|strong="H04428"\w*. \w She fell|strong="H05307"\w* \w at|strong="H06440"\w* \w his feet|strong="H07272"\w* \w weeping|strong="H01058"\w* \w and begged|strong="H02603"\w* him \w to revoke|strong="H05674"\w* \w the evil|strong="H07451"\w* \w scheme|strong="H04284"\w* \w of Haman|strong="H02001"\w* \w the Agagite|strong="H00091"\w*, \w which|strong="H00834"\w* \w he had devised|strong="H02803"\w* \w against|strong="H05921"\w* \w the Jews|strong="H03064"\w*.
\p \v 4 \w The king|strong="H04428"\w* \w extended|strong="H03447"\w* \w the gold|strong="H02091"\w* \w scepter|strong="H08275"\w* \w toward Esther|strong="H00635"\w*, \w and she|strong="H00635"\w* \w arose|strong="H06965"\w* \w and stood|strong="H05975"\w* \w before|strong="H06440"\w* \w the king|strong="H04428"\w*.
\p \v 5 “\w If|strong="H00518"\w* \w it pleases|strong="H05921"\w* \w the king|strong="H04428"\w*,” \w she said|strong="H00559"\w*, “\w and if I have found|strong="H04672"\w* \w favor|strong="H02580"\w* \w in his sight|strong="H06440"\w*, \w and the matter|strong="H01697"\w* \w seems proper|strong="H03787"\w* \w to|strong="H06440"\w* \w the king|strong="H04428"\w*, \w and I|strong="H00589"\w* \w am pleasing|strong="H02896"\w* \w in his sight|strong="H05869"\w*, \w may an order be written|strong="H03789"\w* \w to revoke|strong="H07725"\w* \w the letters|strong="H05612"\w* \w that the scheming|strong="H04284"\w* \w Haman|strong="H02001"\w* \w son|strong="H01121"\w* \w of Hammedatha|strong="H04099"\w*, \w the Agagite|strong="H00091"\w*, \w wrote|strong="H03789"\w* \w to destroy|strong="H00006"\w* \w the Jews|strong="H03064"\w* \w in all|strong="H03605"\w* \w the king’s|strong="H04428"\w* \w provinces|strong="H04082"\w*. \v 6 \w For|strong="H03588"\w* \w how|strong="H00349"\w* \w could I bear|strong="H03201"\w* \w to see|strong="H07200"\w* \w the disaster|strong="H07451"\w* \w that|strong="H00834"\w* \w would befall|strong="H04672"\w* \w my people|strong="H05971"\w*? \w How|strong="H00349"\w* \w could I bear|strong="H03201"\w* \w to see|strong="H07200"\w* \w the destruction|strong="H00013"\w* \w of my kindred|strong="H04138"\w*?”
\s1 The Decree of Xerxes
\p \v 7 \w So King|strong="H04428"\w* \w Xerxes|strong="H00325"\w* \w said|strong="H00559"\w* \w to Esther|strong="H00635"\w* \w the Queen|strong="H04436"\w* \w and Mordecai|strong="H04782"\w* \w the Jew|strong="H03064"\w*, “\w Behold|strong="H02009"\w*, \w I have given|strong="H05414"\w* \w Haman’s|strong="H02001"\w* \w estate|strong="H01004"\w* \w to Esther|strong="H00635"\w*, \w and he was hanged|strong="H08518"\w* \w on|strong="H05921"\w* \w the gallows|strong="H06086"\w* \w because|strong="H05921"\w* \w he attacked|strong="H07971"\w* \w the Jews|strong="H03064"\w*. \v 8 \w Now you|strong="H00859"\w* \w may write|strong="H03789"\w* \w in the king’s|strong="H04428"\w* \w name|strong="H08034"\w* \w as|strong="H02896"\w* \w you please|strong="H05869"\w* \w regarding|strong="H05921"\w* \w the Jews|strong="H03064"\w*, \w and seal it|strong="H02856"\w* \w with the royal|strong="H04428"\w* \w signet ring|strong="H02885"\w*. \w For a decree|strong="H03791"\w* \w that|strong="H00834"\w* \w is written|strong="H03789"\w* \w in the name|strong="H08034"\w* \w of the king|strong="H04428"\w* \w and sealed|strong="H02856"\w* \w with the royal|strong="H04428"\w* \w signet ring|strong="H02885"\w* \w cannot|strong="H00369"\w* \w be revoked|strong="H07725"\w*.”
\p \v 9 \w At once|strong="H06256"\w* \w the royal|strong="H04428"\w* \w scribes|strong="H05613"\w* \w were summoned|strong="H07121"\w*, \w and on the twenty-third day|strong="H07969"\w* \w of the third|strong="H07992"\w* \w month|strong="H02320"\w* (\w the month|strong="H02320"\w* \w of Sivan|strong="H05510"\w*\f + \fr 8:9 \fqa Sivan \ft is the third month of the Hebrew lunar calendar, usually occurring within the months of May and June.\f*), \w they recorded|strong="H03789"\w* \w all of|strong="H03605"\w* \w Mordecai’s|strong="H04782"\w* \w orders|strong="H06680"\w* \w to|strong="H00413"\w* \w the Jews|strong="H03064"\w* \w and to|strong="H00413"\w* \w the satraps|strong="H00323"\w*, \w governors|strong="H06346"\w*, \w and princes|strong="H08269"\w* \w of the 127|strong="H07651"\w* \w provinces|strong="H04082"\w* \w from India|strong="H01912"\w* \w to|strong="H05704"\w* \w Cush|strong="H03568"\w*\f + \fr 8:9 \ft That is, to the upper Nile region\f* — \w writing to each province|strong="H04082"\w* \w in its own script|strong="H04082"\w*, \w to every people|strong="H05971"\w* \w in their own language|strong="H03956"\w*, \w and to|strong="H00413"\w* \w the Jews|strong="H03064"\w* \w in their own script|strong="H03791"\w* \w and language|strong="H03956"\w*.
\p \v 10 \w Mordecai wrote|strong="H03789"\w* \w in the name|strong="H08034"\w* \w of King|strong="H04428"\w* \w Xerxes|strong="H00325"\w* \w and sealed it|strong="H02856"\w* \w with the royal|strong="H04428"\w* \w signet ring|strong="H02885"\w*. \w He sent|strong="H07971"\w* \w the documents|strong="H05612"\w* \w by|strong="H03027"\w* \w mounted|strong="H05483"\w* \w couriers|strong="H07323"\w* \w riding on|strong="H07392"\w* \w swift horses|strong="H07409"\w* \w bred|strong="H01121"\w* \w from the royal|strong="H00327"\w* \w mares|strong="H07424"\w*.
\p \v 11 \w By these letters|strong="H00834"\w* \w the king|strong="H04428"\w* \w permitted|strong="H05414"\w* \w the Jews|strong="H03064"\w* \w in each|strong="H03605"\w* \w and every city|strong="H05892"\w* \w the right to assemble|strong="H06950"\w* \w and defend|strong="H05921"\w* \w themselves|strong="H05315"\w*, \w to destroy|strong="H08045"\w*, \w kill|strong="H02026"\w*, \w and annihilate|strong="H00006"\w* \w all|strong="H03605"\w* \w the forces|strong="H02428"\w* \w of any people|strong="H05971"\w* \w or province|strong="H04082"\w* \w hostile to them|strong="H06696"\w*, \w including women|strong="H00802"\w* \w and children|strong="H02945"\w*, \w and to plunder|strong="H07998"\w* \w their possessions|strong="H00962"\w*. \v 12 \w The single|strong="H00259"\w* \w day appointed|strong="H03117"\w* \w throughout all|strong="H03605"\w* \w the provinces|strong="H04082"\w* \w of King|strong="H04428"\w* \w Xerxes|strong="H00325"\w* \w was the thirteenth|strong="H07969"\w* \w day of the twelfth|strong="H08147"\w* \w month|strong="H02320"\w*, \w the month|strong="H02320"\w* \w of Adar|strong="H00143"\w*.\f + \fr 8:12 \fqa Adar \ft is the twelfth month of the Hebrew lunar calendar, usually occurring within the months of February and March.\f*
\p \v 13 \w A copy|strong="H06572"\w* \w of the text|strong="H03791"\w* \w of the edict|strong="H01881"\w* \w was to be issued|strong="H05414"\w* \w in every|strong="H03605"\w* \w province|strong="H04082"\w* \w and published|strong="H01540"\w* \w to all|strong="H03605"\w* \w the people|strong="H05971"\w*, \w so that the Jews|strong="H03064"\w* \w would be|strong="H01961"\w* \w ready|strong="H06259"\w* \w on that|strong="H02088"\w* \w day|strong="H03117"\w* \w to avenge themselves|strong="H05358"\w* \w on their enemies|strong="H00341"\w*. \v 14 \w The couriers|strong="H07323"\w* \w rode|strong="H07392"\w* \w out|strong="H03318"\w* \w in haste|strong="H00926"\w* \w on their royal|strong="H00327"\w* \w horses|strong="H07409"\w*, \w pressed on|strong="H01765"\w* \w by the command|strong="H01697"\w* \w of the king|strong="H04428"\w*. \w And the edict|strong="H01881"\w* \w was also issued|strong="H05414"\w* \w in the citadel|strong="H01002"\w* \w of Susa|strong="H07800"\w*.
\p \v 15 \w Mordecai|strong="H04782"\w* \w went out|strong="H03318"\w* \w from the presence|strong="H06440"\w* \w of the king|strong="H04428"\w* \w in royal garments|strong="H03830"\w* \w of blue|strong="H08504"\w* \w and white|strong="H02353"\w*, \w with a large|strong="H01419"\w* \w gold|strong="H02091"\w* \w crown|strong="H05850"\w* \w and a purple|strong="H00713"\w* \w robe|strong="H08509"\w* \w of fine linen|strong="H00948"\w*. \w And the city|strong="H05892"\w* \w of Susa|strong="H07800"\w* \w shouted|strong="H06670"\w* \w and rejoiced|strong="H08055"\w*.
\p \v 16 \w For the Jews|strong="H03064"\w* \w it was a time of|strong="H01961"\w* \w light|strong="H00219"\w* \w and gladness|strong="H08057"\w*, \w of joy|strong="H08342"\w* \w and honor|strong="H03366"\w*. \v 17 \w In every|strong="H03605"\w* \w province|strong="H04082"\w* \w and every|strong="H03605"\w* \w city|strong="H05892"\w*, \w wherever|strong="H04725"\w* \w the king’s|strong="H04428"\w* \w edict|strong="H01697"\w* \w and decree|strong="H01881"\w* \w reached|strong="H05060"\w*, \w there was joy|strong="H08057"\w* \w and gladness|strong="H08342"\w* \w among the Jews|strong="H03064"\w*, \w with feasting|strong="H04960"\w* \w and celebrating|strong="H03117"\w*. \w And many|strong="H07227"\w* \w of the people|strong="H05971"\w* \w of the land|strong="H00776"\w* \w themselves became Jews|strong="H03054"\w*, \w because|strong="H03588"\w* \w the fear|strong="H06343"\w* \w of the Jews|strong="H03064"\w* \w had fallen|strong="H05307"\w* \w upon them|strong="H05921"\w*.
\c 9
\s1 The Jews Destroy Their Enemies
\p \v 1 \w On the thirteenth|strong="H07969"\w* \w day|strong="H03117"\w* \w of the twelfth|strong="H08147"\w* \w month|strong="H02320"\w*, \w the month|strong="H02320"\w* \w of Adar|strong="H00143"\w*,\f + \fr 9:1 \fqa Adar \ft is the twelfth month of the Hebrew lunar calendar, usually occurring within the months of February and March; also in verses 15, 17, 19, and 21.\f* \w the king’s|strong="H04428"\w* \w command|strong="H01697"\w* \w and edict|strong="H01881"\w* \w were to be executed|strong="H06213"\w*. \w On this day|strong="H03117"\w* \w the enemies|strong="H00341"\w* \w of the Jews|strong="H03064"\w* \w had hoped|strong="H07663"\w* \w to overpower|strong="H07980"\w* them, \w but their plan was overturned|strong="H02015"\w* \w and the Jews|strong="H03064"\w* \w overpowered|strong="H07980"\w* \w those|strong="H01992"\w* \w who hated them|strong="H08130"\w*. \v 2 \w In each|strong="H03605"\w* \w of the provinces|strong="H04082"\w* \w of King|strong="H04428"\w* \w Xerxes|strong="H00325"\w*, \w the Jews|strong="H03064"\w* \w assembled|strong="H06950"\w* \w in their cities|strong="H05892"\w* \w to attack|strong="H07971"\w* \w those who sought|strong="H01245"\w* \w to harm them|strong="H07451"\w*. \w No|strong="H03808"\w* \w man|strong="H00376"\w* \w could withstand|strong="H05975"\w* \w them|strong="H06440"\w*, \w because|strong="H03588"\w* \w the fear of them|strong="H06343"\w* \w had fallen|strong="H05307"\w* \w upon|strong="H05921"\w* \w all|strong="H03605"\w* \w peoples|strong="H05971"\w*.
\p \v 3 \w And all|strong="H03605"\w* \w the officials|strong="H08269"\w* \w of the provinces|strong="H04082"\w*, \w the satraps|strong="H00323"\w*, \w the governors|strong="H06346"\w*, \w and the king’s|strong="H04428"\w* \w administrators|strong="H06213"\w* \w helped|strong="H05375"\w* \w the Jews|strong="H03064"\w*, \w because|strong="H03588"\w* \w the fear|strong="H06343"\w* \w of Mordecai|strong="H04782"\w* \w had fallen|strong="H05307"\w* \w upon them|strong="H05921"\w*. \v 4 \w For|strong="H03588"\w* \w Mordecai|strong="H04782"\w* \w exercised great|strong="H01419"\w* \w power in the palace|strong="H01004"\w*, \w and his fame|strong="H08089"\w* \w spread|strong="H01980"\w* \w throughout|strong="H03605"\w* \w the provinces|strong="H04082"\w* \w as|strong="H03588"\w* \w he|strong="H04782"\w* \w became|strong="H01980"\w* \w more and more powerful|strong="H01431"\w*.
\p \v 5 \w The Jews|strong="H03064"\w* \w put|strong="H05221"\w* \w all|strong="H03605"\w* \w their enemies|strong="H00341"\w* \w to the sword|strong="H02719"\w*, \w killing|strong="H02027"\w* \w and destroying them|strong="H00012"\w*, \w and they did|strong="H06213"\w* \w as they pleased|strong="H07522"\w* \w to those who hated them|strong="H08130"\w*. \v 6 \w In the citadel|strong="H01002"\w* \w of Susa|strong="H07800"\w*, \w the Jews|strong="H03064"\w* \w killed|strong="H02026"\w* \w and destroyed|strong="H00006"\w* \w five|strong="H02568"\w* \w hundred|strong="H03967"\w* \w men|strong="H00376"\w*, \v 7 \w including Parshandatha|strong="H06577"\w*, \w Dalphon|strong="H01813"\w*, \w Aspatha|strong="H00630"\w*, \v 8 \w Poratha|strong="H06334"\w*, \w Adalia|strong="H00118"\w*, \w Aridatha|strong="H00743"\w*, \v 9 \w Parmashta|strong="H06534"\w*, \w Arisai|strong="H00747"\w*, \w Aridai|strong="H00742"\w*, \w and Vaizatha|strong="H02055"\w*. \v 10 \w They killed|strong="H02026"\w* \w these ten|strong="H06235"\w* \w sons|strong="H01121"\w* \w of Haman|strong="H02001"\w* \w son|strong="H01121"\w* \w of Hammedatha|strong="H04099"\w*, \w the enemy|strong="H06887"\w* \w of the Jews|strong="H03064"\w*, \w but they did not|strong="H03808"\w* \w lay|strong="H07971"\w* \w a hand|strong="H03027"\w* \w on the plunder|strong="H00961"\w*.
\s1 Haman’s Sons Hanged
\p \v 11 \w On that|strong="H01931"\w* \w day|strong="H03117"\w* \w the number|strong="H04557"\w* \w of those killed|strong="H02026"\w* \w in the citadel|strong="H01002"\w* \w of Susa|strong="H07800"\w* \w was reported to|strong="H06440"\w* \w the king|strong="H04428"\w*, \v 12 \w who|strong="H04428"\w* \w said|strong="H00559"\w* \w to Queen|strong="H04436"\w* \w Esther|strong="H00635"\w*, “\w In the citadel|strong="H01002"\w* \w of Susa|strong="H07800"\w* \w the Jews|strong="H03064"\w* \w have killed|strong="H02026"\w* \w and destroyed|strong="H00006"\w* \w five|strong="H02568"\w* \w hundred|strong="H03967"\w* \w men|strong="H00376"\w*, \w including Haman’s|strong="H02001"\w* \w ten|strong="H06235"\w* \w sons|strong="H01121"\w*. \w What|strong="H04100"\w* \w have they done|strong="H06213"\w* \w in the rest|strong="H07605"\w* \w of the royal|strong="H04428"\w* \w provinces|strong="H04082"\w*? \w Now what is|strong="H04100"\w* \w your petition|strong="H07596"\w*? \w It will be given|strong="H05414"\w* to you. \w And what|strong="H04100"\w* \w further|strong="H05750"\w* \w do you request|strong="H01246"\w*? \w It will be fulfilled|strong="H06213"\w*.”
\p \v 13 \w Esther|strong="H00635"\w* \w replied|strong="H00559"\w*, “\w If|strong="H00518"\w* \w it pleases|strong="H05921"\w* \w the king|strong="H04428"\w*, \w may the Jews|strong="H03064"\w* \w in Susa|strong="H07800"\w* \w also|strong="H01571"\w* \w have tomorrow|strong="H04279"\w* \w to carry out|strong="H06213"\w* \w today’s|strong="H03117"\w* \w edict|strong="H01881"\w*, \w and may the bodies of Haman’s|strong="H02001"\w* \w ten|strong="H06235"\w* \w sons|strong="H01121"\w* \w be hanged|strong="H08518"\w* \w on|strong="H05921"\w* \w the gallows|strong="H06086"\w*.”
\p \v 14 \w So the king|strong="H04428"\w* \w commanded|strong="H00559"\w* \w that this|strong="H03651"\w* \w be done|strong="H06213"\w*. \w An edict|strong="H01881"\w* \w was issued|strong="H05414"\w* \w in Susa|strong="H07800"\w*, \w and they hanged|strong="H08518"\w* \w the ten|strong="H06235"\w* \w sons|strong="H01121"\w* \w of Haman|strong="H02001"\w*. \v 15 \w On the fourteenth|strong="H00702"\w* \w day|strong="H03117"\w* \w of the month|strong="H02320"\w* \w of Adar|strong="H00143"\w*, \w the Jews|strong="H03064"\w* \w in Susa|strong="H07800"\w* \w came together|strong="H06950"\w* \w again|strong="H01571"\w* \w and put to death|strong="H02026"\w* \w three|strong="H07969"\w* \w hundred|strong="H03967"\w* \w men|strong="H00376"\w* \w there|strong="H07800"\w*, \w but they did not|strong="H03808"\w* \w lay|strong="H07971"\w* \w a hand|strong="H03027"\w* \w on the plunder|strong="H00961"\w*.
\p \v 16 \w The rest|strong="H07605"\w* \w of the Jews|strong="H03064"\w* \w in the royal|strong="H04428"\w* \w provinces|strong="H04082"\w* \w also assembled|strong="H06950"\w* \w to defend|strong="H05975"\w* \w themselves|strong="H05315"\w* \w and rid themselves|strong="H05118"\w* \w of their enemies|strong="H00341"\w*. \w They killed|strong="H02026"\w* \w 75,000|strong="H02568"\w* \w who hated them|strong="H08130"\w*, \w but they did not|strong="H03808"\w* \w lay|strong="H07971"\w* \w a hand|strong="H03027"\w* \w on the plunder|strong="H00961"\w*. \v 17 \w This was done on the thirteenth|strong="H07969"\w* \w day|strong="H03117"\w* \w of the month|strong="H02320"\w* \w of Adar|strong="H00143"\w*, \w and on the fourteenth day|strong="H00702"\w* \w they rested|strong="H05117"\w*, \w making it|strong="H06213"\w* \w a day|strong="H03117"\w* \w of feasting|strong="H04960"\w* \w and joy|strong="H08057"\w*.
\s1 The Feast of Purim Instituted
\p \v 18 \w The Jews|strong="H03064"\w* \w in Susa, however|strong="H07800"\w*, \w had assembled|strong="H06950"\w* \w on the thirteenth|strong="H07969"\w* \w and the fourteenth|strong="H00702"\w* \w days of the month|strong="H06240"\w*. \w So they rested|strong="H05117"\w* \w on the fifteenth|strong="H02568"\w* \w day|strong="H06240"\w*, \w making|strong="H06213"\w* \w it|strong="H00853"\w* \w a day|strong="H03117"\w* \w of feasting|strong="H04960"\w* \w and joy|strong="H08057"\w*. \v 19 \w This is why|strong="H05921"\w* \w the rural|strong="H06521"\w* \w Jews|strong="H03064"\w*, \w who live|strong="H03427"\w* \w in the villages|strong="H05892"\w*, \w observe|strong="H06213"\w* \w the fourteenth day|strong="H00702"\w* \w of the month|strong="H02320"\w* \w of Adar|strong="H00143"\w* \w as a day|strong="H03117"\w* \w of joy|strong="H08057"\w* \w and feasting|strong="H04960"\w*. \w It is a holiday|strong="H03117"\w* \w for sending|strong="H04916"\w* \w gifts|strong="H04490"\w* \w to one|strong="H00376"\w* \w another|strong="H07453"\w*.
\p \v 20 \w Mordecai|strong="H04782"\w* \w recorded|strong="H03789"\w* \w these|strong="H00428"\w* \w events|strong="H01697"\w* \w and sent|strong="H07971"\w* \w letters|strong="H05612"\w* \w to|strong="H00413"\w* \w all|strong="H03605"\w* \w the Jews|strong="H03064"\w* \w in all|strong="H03605"\w* \w the provinces|strong="H04082"\w* \w of King|strong="H04428"\w* \w Xerxes|strong="H00325"\w*, \w both near|strong="H07138"\w* \w and far|strong="H07350"\w*, \v 21 \w to establish|strong="H06965"\w* \w among them|strong="H05921"\w* \w an annual|strong="H03605"\w* \w celebration|strong="H06213"\w* \w on the fourteenth|strong="H00702"\w* \w and fifteenth|strong="H02568"\w* \w days|strong="H03117"\w* \w of the month|strong="H02320"\w* \w of Adar|strong="H00143"\w* \v 22 \w as the days|strong="H03117"\w* \w on which|strong="H00834"\w* \w the Jews|strong="H03064"\w* \w gained rest|strong="H05117"\w* \w from their enemies|strong="H00341"\w* \w and the month|strong="H02320"\w* \w in which|strong="H00834"\w* \w their sorrow|strong="H03015"\w* \w turned|strong="H02015"\w* \w to joy|strong="H08057"\w* \w and their mourning|strong="H00060"\w* \w into a holiday|strong="H03117"\w*. \w He wrote that these were to be|strong="H06213"\w* \w days|strong="H03117"\w* \w of feasting|strong="H04960"\w* \w and joy|strong="H08057"\w*, \w of sending|strong="H04916"\w* \w gifts|strong="H04490"\w* \w to one|strong="H00376"\w* \w another|strong="H07453"\w* \w and|strong="H04979"\w* \w to the poor|strong="H00034"\w*.
\p \v 23 \w So the Jews|strong="H03064"\w* \w agreed to continue|strong="H06901"\w* \w the custom|strong="H06213"\w* \w they had started|strong="H02490"\w*, \w as|strong="H00834"\w* \w Mordecai|strong="H04782"\w* \w had written|strong="H03789"\w* \w to them|strong="H00413"\w*. \v 24 \w For|strong="H03588"\w* \w Haman|strong="H02001"\w* \w son|strong="H01121"\w* \w of Hammedatha|strong="H04099"\w*, \w the Agagite|strong="H00091"\w*, \w the enemy|strong="H06887"\w* \w of all|strong="H03605"\w* \w the Jews|strong="H03064"\w*, \w had plotted|strong="H02803"\w* \w against|strong="H05921"\w* \w the Jews|strong="H03064"\w* \w to destroy them|strong="H00006"\w* \w and had cast|strong="H05307"\w* \w the Pur|strong="H06332"\w* \w (that is|strong="H01931"\w*, \w the lot|strong="H01486"\w*) \w to crush|strong="H02000"\w* \w and destroy them|strong="H00006"\w*. \v 25 \w But when it came|strong="H00935"\w* \w before|strong="H06440"\w* \w the king|strong="H04428"\w*, \w he commanded|strong="H00559"\w* \w by|strong="H05973"\w* \w letter|strong="H05612"\w* \w that the wicked|strong="H07451"\w* \w scheme|strong="H04284"\w* \w which|strong="H00834"\w* \w Haman had devised|strong="H02803"\w* \w against|strong="H05921"\w* \w the Jews|strong="H03064"\w* \w should come back|strong="H07725"\w* \w upon|strong="H05921"\w* \w his own head|strong="H07218"\w*, \w and that he|strong="H00853"\w* \w and|strong="H00853"\w* \w his sons|strong="H01121"\w* \w should be hanged|strong="H08518"\w* \w on|strong="H05921"\w* \w the gallows|strong="H06086"\w*.
\p \v 26 \w Therefore|strong="H05921"\w* \w these|strong="H00428"\w* \w days|strong="H03117"\w* \w are called|strong="H07121"\w* \w Purim|strong="H06332"\w*, \w from|strong="H05921"\w* \w the word|strong="H08034"\w* \w Pur|strong="H06332"\w*.
\p \w Because of|strong="H05921"\w* \w all|strong="H03605"\w* \w the instructions|strong="H01697"\w* \w in this|strong="H02063"\w* \w letter|strong="H00107"\w*, \w and because of all|strong="H04100"\w* \w they had seen|strong="H07200"\w* \w and experienced|strong="H04100"\w*, \v 27 \w the Jews|strong="H03064"\w* \w bound themselves|strong="H06901"\w* \w to establish the custom|strong="H06965"\w* \w that they|strong="H05921"\w* \w and their descendants|strong="H02233"\w* \w and all|strong="H03605"\w* \w who join|strong="H03867"\w* \w them|strong="H05921"\w* \w should not|strong="H03808"\w* \w fail|strong="H05674"\w* \w to celebrate|strong="H06213"\w* \w these|strong="H00428"\w* \w two|strong="H08147"\w* \w days|strong="H03117"\w* \w at the appointed time|strong="H02165"\w* \w each|strong="H03605"\w* \w and every year|strong="H08141"\w*, \w according to their regulation|strong="H03791"\w*. \v 28 \w These|strong="H00428"\w* \w days|strong="H03117"\w* \w should be remembered|strong="H02142"\w* \w and celebrated|strong="H06213"\w* \w by every|strong="H03605"\w* \w generation|strong="H01755"\w*, \w family|strong="H04940"\w*, \w province|strong="H04082"\w*, \w and city|strong="H05892"\w*, \w so that these|strong="H00428"\w* \w days|strong="H03117"\w* \w of Purim|strong="H06332"\w* \w should not|strong="H03808"\w* \w fail to be observed|strong="H05674"\w* \w among|strong="H08432"\w* \w the Jews|strong="H03064"\w*, \w nor should the memory of them|strong="H02143"\w* \w fade|strong="H05486"\w* \w from their descendants|strong="H02233"\w*.
\p \v 29 \w So Queen|strong="H04436"\w* \w Esther|strong="H00635"\w* \w daughter|strong="H01323"\w* \w of Abihail|strong="H00032"\w*, \w along with Mordecai|strong="H04782"\w* \w the Jew|strong="H03064"\w*, \w wrote|strong="H03789"\w* \w with full|strong="H03605"\w* \w authority|strong="H08633"\w* \w to confirm|strong="H06965"\w* \w this|strong="H02063"\w* \w second|strong="H08145"\w* \w letter|strong="H00107"\w* \w concerning Purim|strong="H06332"\w*. \v 30 \w And Mordecai sent|strong="H07971"\w* \w letters|strong="H05612"\w* \w with words|strong="H01697"\w* \w of peace|strong="H07965"\w* \w and truth|strong="H00571"\w* \w to|strong="H00413"\w* \w all|strong="H03605"\w* \w the Jews|strong="H03064"\w* \w in|strong="H00413"\w* \w the 127|strong="H07651"\w* \w provinces|strong="H04082"\w* \w of the kingdom|strong="H04438"\w* \w of Xerxes|strong="H00325"\w*, \v 31 \w in order to confirm|strong="H06965"\w* \w these|strong="H00428"\w* \w days|strong="H03117"\w* \w of Purim|strong="H06332"\w* \w at their appointed time|strong="H02165"\w*, \w just as|strong="H00834"\w* \w Mordecai|strong="H04782"\w* \w the Jew|strong="H03064"\w* \w and Queen|strong="H04436"\w* \w Esther|strong="H00635"\w* \w had established them|strong="H06965"\w* \w and|strong="H00834"\w* \w had committed|strong="H06965"\w* \w themselves|strong="H05315"\w* \w and their descendants|strong="H02233"\w* \w to the times|strong="H01697"\w* \w of fasting|strong="H06685"\w* \w and lamentation|strong="H02201"\w*.
\p \v 32 \w So Esther’s|strong="H00635"\w* \w decree|strong="H03982"\w* \w confirmed|strong="H06965"\w* \w these|strong="H00428"\w* \w regulations|strong="H01697"\w* \w about Purim|strong="H06332"\w*, \w which were written|strong="H03789"\w* \w into the record|strong="H05612"\w*.
\c 10
\s1 Tribute to Xerxes and Mordecai
\p \v 1 \w Now King|strong="H04428"\w* \w Xerxes|strong="H00325"\w* \w imposed|strong="H07760"\w* \w tribute|strong="H04522"\w* \w throughout|strong="H05921"\w* \w the land|strong="H00776"\w*, \w even to its farthest shores|strong="H00339"\w*.
\p \v 2 \w And all|strong="H03605"\w* \w of Mordecai’s|strong="H04782"\w* \w powerful|strong="H08633"\w* \w and magnificent|strong="H01369"\w* \w accomplishments|strong="H04639"\w*, \w together with the full account|strong="H06575"\w* \w of the greatness|strong="H01420"\w* \w to which|strong="H00834"\w* \w the king|strong="H04428"\w* \w had raised him|strong="H01431"\w*, \w are they|strong="H01992"\w* \w not|strong="H03808"\w* \w written|strong="H03789"\w* \w in|strong="H05921"\w* \w the Book|strong="H05612"\w* \w of the Chronicles|strong="H01697"\w* \w of the Kings|strong="H04428"\w* \w of Media|strong="H04074"\w* \w and Persia|strong="H06539"\w*? \v 3 \w For|strong="H03588"\w* \w Mordecai|strong="H04782"\w* \w the Jew|strong="H03064"\w* \w was second|strong="H04932"\w* \w only to King|strong="H04428"\w* \w Xerxes|strong="H00325"\w*, \w preeminent|strong="H01419"\w* \w among the Jews|strong="H03064"\w* \w and highly favored|strong="H07521"\w* \w by his many|strong="H07230"\w* \w kinsmen|strong="H00251"\w*, \w seeking|strong="H01875"\w* \w the good|strong="H02896"\w* \w of his people|strong="H05971"\w* \w and speaking|strong="H01696"\w* \w peace|strong="H07965"\w* \w to all|strong="H03605"\w* \w his countrymen|strong="H02233"\w*.
