\p \v 17 \w So Mordecai|strong="H04782"\w* \w went|strong="H05674"\w* \w and did|strong="H06213"\w* \w all|strong="H03605"\w* \w that|strong="H00834"\w* \w Esther|strong="H00635"\w* \w had instructed|strong="H06680"\w* \w him|strong="H05921"\w*.
\c 5
