\p \v 1 \w On the third|strong="H07992"\w* \w day|strong="H03117"\w*, \w Esther|strong="H00635"\w* \w put on|strong="H03847"\w* \w her royal robes|strong="H04438"\w* \w and stood|strong="H05975"\w* \w in the inner|strong="H06442"\w* \w court|strong="H02691"\w* \w of the palace|strong="H01004"\w* \w across from|strong="H05227"\w* \w the king’s|strong="H04428"\w* \w quarters|strong="H01004"\w*. \w The king|strong="H04428"\w* \w was sitting|strong="H03427"\w* \w on|strong="H05921"\w* \w his royal|strong="H04438"\w* \w throne|strong="H03678"\w* \w in the royal|strong="H04438"\w* \w courtroom|strong="H01004"\w*, \w facing|strong="H05227"\w* \w the|strong="H01004"\w* \w entrance|strong="H06607"\w*.
