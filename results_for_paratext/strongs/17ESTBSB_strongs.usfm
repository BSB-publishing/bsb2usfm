\s1 Xerxes’ Royal Feast
\p \v 1 \w This is what happened|strong="H01961"\w* \w in the days|strong="H03117"\w* \w of Xerxes|strong="H00325"\w*,\f + \fr 1:1 \ft Hebrew \fqa Ahasuerus\ft ; here and throughout Esther \f* \w who reigned over|strong="H04427"\w* \w 127|strong="H07651"\w* \w provinces|strong="H04082"\w* \w from India|strong="H01912"\w* \w to|strong="H05704"\w* \w Cush|strong="H03568"\w*.\f + \fr 1:1 \ft That is, the upper Nile region\f* \v 2 \w In those|strong="H01992"\w* \w days|strong="H03117"\w* \w King|strong="H04428"\w* \w Xerxes|strong="H00325"\w* \w sat|strong="H03427"\w* \w on|strong="H05921"\w* \w his royal|strong="H04438"\w* \w throne|strong="H03678"\w* \w in the citadel|strong="H01002"\w* \w of Susa|strong="H07800"\w*.
\p \v 3 \w In the third|strong="H07969"\w* \w year|strong="H08141"\w* \w of his reign|strong="H04427"\w*, \w Xerxes held|strong="H06213"\w* \w a feast|strong="H04960"\w* \w for all|strong="H03605"\w* \w his officials|strong="H08269"\w* \w and servants|strong="H05650"\w*. \w The military leaders|strong="H02428"\w* \w of Persia|strong="H06539"\w* \w and Media|strong="H04074"\w* \w were there|strong="H06440"\w*, \w along with the nobles|strong="H06579"\w* \w and princes|strong="H08269"\w* \w of the provinces|strong="H04082"\w*. \v 4 \w And for a full|strong="H07227"\w* \w 180|strong="H08084"\w* \w days|strong="H03117"\w* \w he displayed|strong="H07200"\w* \w the glorious|strong="H03519"\w* \w riches|strong="H06239"\w* \w of his kingdom|strong="H04438"\w* \w and|strong="H00853"\w* \w the magnificent|strong="H08597"\w* \w splendor|strong="H03366"\w* \w of his greatness|strong="H01420"\w*.
\p \v 5 \w At the end|strong="H04390"\w* \w of this|strong="H00428"\w* \w time|strong="H03117"\w*, \w in the garden|strong="H01594"\w* \w court|strong="H02691"\w* \w of the royal|strong="H04428"\w* \w palace|strong="H01055"\w*, \w the king|strong="H04428"\w* \w held|strong="H06213"\w* \w a seven-day|strong="H07651"\w* \w feast|strong="H04960"\w* \w for all|strong="H03605"\w* \w the people|strong="H05971"\w* \w in the citadel|strong="H01002"\w* \w of Susa|strong="H07800"\w*, \w from the least|strong="H06996"\w* \w to|strong="H05704"\w* \w the greatest|strong="H01419"\w*. \v 6 \w Hangings of white|strong="H02353"\w* \w and blue|strong="H08504"\w* \w linen|strong="H03768"\w* \w were fastened|strong="H00270"\w* \w with cords|strong="H02256"\w* \w of fine white|strong="H00948"\w* \w and purple material|strong="H00713"\w* \w to|strong="H05921"\w* \w silver|strong="H03701"\w* \w rings|strong="H01550"\w* \w on the marble|strong="H08336"\w* \w pillars|strong="H05982"\w*. \w Gold|strong="H02091"\w* \w and silver|strong="H03701"\w* \w couches|strong="H04296"\w* \w were arranged|strong="H05921"\w* \w on a mosaic pavement|strong="H07531"\w* \w of porphyry|strong="H00923"\w*, \w marble|strong="H08336"\w*, \w mother-of-pearl|strong="H01858"\w*, \w and other costly stones|strong="H05508"\w*.
\p \v 7 \w Beverages were served|strong="H08248"\w* \w in an array of goblets|strong="H03627"\w* \w of gold|strong="H02091"\w*, \w each|strong="H03627"\w* \w with a different design|strong="H08138"\w*, \w and the royal|strong="H04438"\w* \w wine|strong="H03196"\w* \w flowed freely|strong="H07227"\w*, \w according to the king’s|strong="H04428"\w* \w bounty|strong="H03027"\w*. \v 8 \w By|strong="H01881"\w* \w order|strong="H03245"\w* \w of the king|strong="H04428"\w*, \w no|strong="H00369"\w* \w limit was placed|strong="H00597"\w* \w on the drinking|strong="H08360"\w*, \w and every|strong="H03605"\w* \w official|strong="H07227"\w* \w of his household|strong="H01004"\w* \w was to serve|strong="H06213"\w* \w each|strong="H00376"\w* \w man|strong="H00376"\w* \w whatever he desired|strong="H07522"\w*.
\s1 Queen Vashti’s Refusal
\p \v 9 \w Queen|strong="H04436"\w* \w Vashti|strong="H02060"\w* \w also|strong="H01571"\w* \w gave|strong="H06213"\w* \w a banquet|strong="H04960"\w* \w for the women|strong="H00802"\w* \w in the royal|strong="H04438"\w* \w palace|strong="H01004"\w* \w of King|strong="H04428"\w* \w Xerxes|strong="H00325"\w*.
\p \v 10 \w On the seventh|strong="H07637"\w* \w day|strong="H03117"\w*, \w when the king’s|strong="H04428"\w* \w heart|strong="H03820"\w* \w was merry|strong="H02895"\w* \w with wine|strong="H03196"\w*, \w he ordered|strong="H00559"\w* \w the seven|strong="H07651"\w* \w eunuchs|strong="H05631"\w* \w who served|strong="H08334"\w* \w him|strong="H00325"\w* — \w Mehuman|strong="H04104"\w*, \w Biztha|strong="H00968"\w*, \w Harbona|strong="H02726"\w*, \w Bigtha|strong="H00903"\w*, \w Abagtha|strong="H00005"\w*, \w Zethar|strong="H02242"\w*, \w and Carkas|strong="H03752"\w* — \v 11 \w to bring|strong="H00935"\w* \w Queen|strong="H04436"\w* \w Vashti|strong="H02060"\w* \w before|strong="H06440"\w* \w him|strong="H04428"\w*, \w wearing her royal|strong="H04438"\w* \w crown|strong="H03804"\w*, \w to display|strong="H07200"\w* \w her beauty|strong="H03308"\w* \w to the people|strong="H05971"\w* \w and officials|strong="H08269"\w*. \w For|strong="H03588"\w* \w she was|strong="H01931"\w* \w beautiful|strong="H02896"\w* \w to behold|strong="H04758"\w*.
\p \v 12 \w Queen|strong="H04436"\w* \w Vashti, however|strong="H02060"\w*, \w refused|strong="H03985"\w* \w to come|strong="H00935"\w* \w at the king’s|strong="H04428"\w* \w command|strong="H01697"\w* \w brought by|strong="H03027"\w* \w his eunuchs|strong="H05631"\w*. \w And the king|strong="H04428"\w* \w became furious|strong="H07107"\w*, \w and his anger|strong="H02534"\w* \w burned|strong="H01197"\w* within him.
\s1 Queen Vashti Deposed
\p \v 13 \w Then the king|strong="H04428"\w* \w consulted|strong="H00559"\w* \w the wise men|strong="H02450"\w* \w who knew|strong="H03045"\w* \w the times|strong="H06256"\w*, \w for it was|strong="H03588"\w* \w customary|strong="H03651"\w* \w for him|strong="H04428"\w* \w to confer|strong="H01697"\w* \w with|strong="H06440"\w* \w the experts|strong="H03045"\w* \w in law|strong="H01881"\w* \w and justice|strong="H01779"\w*. \v 14 \w His closest advisors were|strong="H07138"\w* \w Carshena|strong="H03771"\w*, \w Shethar|strong="H08369"\w*, \w Admatha|strong="H00133"\w*, \w Tarshish|strong="H08659"\w*, \w Meres|strong="H04825"\w*, \w Marsena|strong="H04826"\w*, \w and Memucan|strong="H04462"\w*, \w the seven|strong="H07651"\w* \w princes|strong="H08269"\w* \w of Persia|strong="H06539"\w* \w and Media|strong="H04074"\w* \w who had personal access to|strong="H07200"\w* \w the king|strong="H04428"\w* \w and ranked|strong="H03427"\w* \w highest|strong="H07223"\w* \w in the kingdom|strong="H04438"\w*.
\p \v 15 “\w According to law|strong="H01881"\w*,” \w he asked, “what|strong="H04100"\w* \w should be done|strong="H06213"\w* \w with Queen|strong="H04436"\w* \w Vashti|strong="H02060"\w*, \w since|strong="H05921"\w* \w she refused to obey|strong="H03808"\w* \w the command|strong="H03982"\w* \w of King|strong="H04428"\w* \w Xerxes|strong="H00325"\w* \w delivered by|strong="H03027"\w* \w the eunuchs|strong="H05631"\w*?”
\p \v 16 \w And in the presence|strong="H06440"\w* \w of the king|strong="H04428"\w* \w and his princes|strong="H08269"\w*, \w Memucan|strong="H04462"\w* \w replied|strong="H00559"\w*, “\w Queen|strong="H04436"\w* \w Vashti|strong="H02060"\w* \w has wronged|strong="H05753"\w* \w not|strong="H03808"\w* \w only|strong="H00905"\w* \w the king|strong="H04428"\w*, \w but|strong="H03588"\w* \w all|strong="H03605"\w* \w the princes|strong="H08269"\w* \w and the peoples|strong="H05971"\w* \w in all|strong="H03605"\w* \w the provinces|strong="H04082"\w* \w of King|strong="H04428"\w* \w Xerxes|strong="H00325"\w*. \v 17 \w For|strong="H03588"\w* \w the conduct|strong="H01697"\w* \w of the queen|strong="H04436"\w* \w will become known|strong="H03318"\w* \w to|strong="H05921"\w* \w all|strong="H03605"\w* \w women|strong="H00802"\w*, \w causing them to despise|strong="H00959"\w* \w their husbands|strong="H01167"\w*\f + \fr 1:17 \ft Or \fqa to disdain their husbands in their eyes\f* \w and say|strong="H00559"\w*, ‘\w King|strong="H04428"\w* \w Xerxes|strong="H00325"\w* \w ordered|strong="H00559"\w* \w Queen|strong="H04436"\w* \w Vashti|strong="H02060"\w* \w to be brought|strong="H00935"\w* \w before him|strong="H06440"\w*, \w but she did not|strong="H03808"\w* \w come|strong="H00935"\w*.’
\p \v 18 \w This|strong="H02088"\w* \w very day|strong="H03117"\w* \w the noble women|strong="H08282"\w* \w of Persia|strong="H06539"\w* \w and Media|strong="H04074"\w* \w who|strong="H00834"\w* \w have heard|strong="H08085"\w* \w about|strong="H00853"\w* \w the queen’s|strong="H04436"\w* \w conduct|strong="H01697"\w* \w will say|strong="H00559"\w* \w the same thing to all|strong="H03605"\w* \w the king’s|strong="H04428"\w* \w officials|strong="H08269"\w*, \w resulting in much|strong="H01767"\w* \w contempt|strong="H00963"\w* \w and wrath|strong="H07110"\w*.
\p \v 19 \w So if|strong="H00518"\w* \w it pleases|strong="H02896"\w* \w the king|strong="H04428"\w*, \w let him issue|strong="H03318"\w* \w a royal|strong="H04438"\w* \w decree|strong="H01697"\w*, \w and let it be recorded|strong="H03789"\w* \w in the laws|strong="H01881"\w* \w of Persia|strong="H06539"\w* \w and Media|strong="H04074"\w* \w so that it cannot|strong="H03808"\w* \w be repealed|strong="H05674"\w*, \w that|strong="H00834"\w* \w Vashti|strong="H02060"\w* \w shall never again|strong="H03808"\w* \w enter|strong="H00935"\w* \w the presence|strong="H06440"\w* \w of King|strong="H04428"\w* \w Xerxes|strong="H00325"\w*, \w and that her royal position|strong="H04438"\w* \w shall be given|strong="H05414"\w* \w to a woman|strong="H07468"\w* \w better|strong="H02896"\w* \w than she|strong="H04480"\w*. \v 20 \w The edict|strong="H06599"\w* \w the king|strong="H04428"\w* \w issues|strong="H06213"\w* \w will be heard|strong="H08085"\w* \w throughout|strong="H03605"\w* \w his vast|strong="H07227"\w* \w kingdom|strong="H04438"\w* — \w and so|strong="H03588"\w* \w all|strong="H03605"\w* \w women|strong="H00802"\w*, \w from the least|strong="H06996"\w* \w to|strong="H05704"\w* \w the greatest|strong="H01419"\w*, \w will honor|strong="H05414"\w* \w their husbands|strong="H01167"\w*.”
\p \v 21 \w The king|strong="H04428"\w* \w and his princes|strong="H08269"\w* \w were pleased|strong="H03190"\w* \w with this counsel|strong="H01697"\w*; \w so the king|strong="H04428"\w* \w did|strong="H06213"\w* \w as Memucan|strong="H04462"\w* \w advised|strong="H01697"\w*. \v 22 \w He sent|strong="H07971"\w* \w letters|strong="H05612"\w* \w to|strong="H00413"\w* \w all|strong="H03605"\w* \w the provinces|strong="H04082"\w* \w of the kingdom|strong="H04428"\w*, \w to|strong="H00413"\w* \w each province|strong="H04082"\w* \w in its own script|strong="H03791"\w* \w and to|strong="H00413"\w* \w each people|strong="H05971"\w* \w in their own language|strong="H03956"\w*, \w proclaiming|strong="H01696"\w*\f + \fr 1:22 \ft Literally \fqa proclaiming in the language of his own people\f* \w that every|strong="H03605"\w* \w man|strong="H00376"\w* \w should be|strong="H01961"\w* \w master|strong="H08323"\w* \w of his own household|strong="H01004"\w*.
\c 2
\s1 Seeking Vashti’s Successor
\p \v 1 \w Some time later|strong="H00310"\w*, \w when the anger|strong="H02534"\w* \w of King|strong="H04428"\w* \w Xerxes|strong="H00325"\w* \w had subsided|strong="H07918"\w*, \w he remembered|strong="H02142"\w* \w Vashti|strong="H02060"\w* \w and|strong="H00853"\w* \w what|strong="H00834"\w* \w she had done|strong="H06213"\w*, \w and|strong="H00853"\w* \w what|strong="H00834"\w* \w had been decreed|strong="H01504"\w* \w against her|strong="H05921"\w*.
\p \v 2 \w Then the king’s|strong="H04428"\w* \w attendants|strong="H05288"\w* \w proposed|strong="H00559"\w*, “\w Let a search be made|strong="H01245"\w* \w for beautiful|strong="H02896"\w* \w young|strong="H05291"\w* \w virgins|strong="H01330"\w* \w for the king|strong="H04428"\w*, \v 3 \w and let the king|strong="H04428"\w* \w appoint|strong="H06485"\w* \w commissioners|strong="H06496"\w* \w in each|strong="H03605"\w* \w province|strong="H04082"\w* \w of his kingdom|strong="H04438"\w* \w to assemble|strong="H06908"\w* \w all|strong="H03605"\w* \w the beautiful|strong="H02896"\w* \w young|strong="H05291"\w* \w women|strong="H01330"\w* \w into|strong="H00413"\w* \w the harem|strong="H01004"\w* \w at|strong="H00413"\w* \w the citadel|strong="H01002"\w* \w of Susa|strong="H07800"\w*. \w Let them be placed|strong="H00413"\w* \w under the care|strong="H03027"\w* \w of Hegai|strong="H01896"\w*, \w the king’s|strong="H04428"\w* \w eunuch|strong="H05631"\w* \w in charge of|strong="H08104"\w* \w the women|strong="H00802"\w*, \w and let them be given|strong="H05414"\w* \w beauty treatments|strong="H08562"\w*. \v 4 \w Then let the young woman|strong="H05291"\w* \w who|strong="H00834"\w* \w pleases|strong="H03190"\w* \w the king|strong="H04428"\w* \w become queen|strong="H04427"\w* \w in place|strong="H08478"\w* \w of Vashti|strong="H02060"\w*.”
\p \w This suggestion|strong="H01697"\w* \w pleased|strong="H03190"\w* \w the king|strong="H04428"\w*, \w and he acted|strong="H06213"\w* \w accordingly|strong="H03651"\w*.
\s1 Esther Finds Favor
\p \v 5 \w Now there was|strong="H01961"\w* \w at the citadel|strong="H01002"\w* \w of Susa|strong="H07800"\w* \w a Jewish|strong="H03064"\w* \w man|strong="H00376"\w* \w from the tribe of Benjamin|strong="H01145"\w* \w named|strong="H08034"\w* \w Mordecai|strong="H04782"\w* \w son|strong="H01121"\w* \w of Jair|strong="H02971"\w*, \w the son|strong="H01121"\w* \w of Shimei|strong="H08096"\w*, \w the son|strong="H01121"\w* \w of Kish|strong="H07027"\w*. \v 6 \w He|strong="H00834"\w* \w had been carried into exile|strong="H01540"\w* \w from Jerusalem|strong="H03389"\w* \w by Nebuchadnezzar|strong="H05019"\w* \w king|strong="H04428"\w* \w of Babylon|strong="H00894"\w* \w among|strong="H05973"\w* \w those taken captive|strong="H01473"\w* \w with|strong="H05973"\w* \w Jeconiah|strong="H03204"\w*\f + \fr 2:6 \fqa Jeconiah \ft is a variant of \fqa Jehoiachin\ft ; see 2 Kings 24:12.\f* \w king|strong="H04428"\w* \w of Judah|strong="H03063"\w*.
\p \v 7 \w And Mordecai|strong="H01961"\w* \w had brought up|strong="H00539"\w* \w Hadassah|strong="H01919"\w* \w (that is|strong="H01931"\w*, \w Esther|strong="H00635"\w*), \w the daughter|strong="H01323"\w* \w of his uncle|strong="H01730"\w*, \w because|strong="H03588"\w* \w she did not|strong="H00369"\w* have \w a father|strong="H00001"\w* \w or mother|strong="H00517"\w*. \w The young woman|strong="H05291"\w* \w was lovely|strong="H03303"\w* \w in form|strong="H08389"\w* \w and|strong="H02896"\w* \w appearance|strong="H04758"\w*, \w and when her father|strong="H00001"\w* \w and mother|strong="H00517"\w* \w had died|strong="H04194"\w*, \w Mordecai|strong="H04782"\w* \w had taken her|strong="H03947"\w* as his own \w daughter|strong="H01323"\w*.
\p \v 8 \w When|strong="H01961"\w* \w the king’s|strong="H04428"\w* \w command|strong="H01697"\w* \w and edict|strong="H01881"\w* \w had been proclaimed|strong="H08085"\w*, \w many|strong="H07227"\w* \w young women|strong="H05291"\w* \w gathered|strong="H06908"\w* \w at|strong="H00413"\w* \w the citadel|strong="H01002"\w* \w of Susa|strong="H07800"\w* \w under|strong="H00413"\w* \w the care|strong="H03027"\w* \w of Hegai|strong="H01896"\w*. \w Esther|strong="H00635"\w* \w was also taken|strong="H03947"\w* \w to|strong="H00413"\w* \w the palace|strong="H01004"\w* \w and placed under|strong="H00413"\w* \w the care|strong="H03027"\w* \w of Hegai|strong="H01896"\w*, \w the custodian|strong="H08104"\w* \w of the women|strong="H00802"\w*. \v 9 \w And the young woman|strong="H05291"\w* \w pleased him|strong="H03190"\w* \w and obtained|strong="H05375"\w* \w his|strong="H06440"\w* \w favor|strong="H02617"\w*, \w so he quickly|strong="H00926"\w* \w provided|strong="H05414"\w* her \w with beauty treatments|strong="H08562"\w* \w and the special diet|strong="H04490"\w*. \w He assigned|strong="H05414"\w* to her \w seven|strong="H07651"\w* \w select|strong="H07200"\w* \w maidservants|strong="H05291"\w* \w from the palace|strong="H01004"\w* \w and transferred her|strong="H08138"\w* \w with them|strong="H05291"\w* \w to the best|strong="H02896"\w* \w place|strong="H01004"\w* \w in the harem|strong="H00802"\w*.
\p \v 10 \w Esther|strong="H00635"\w* \w did not|strong="H03808"\w* \w reveal|strong="H05046"\w* \w her people|strong="H05971"\w* \w or|strong="H00853"\w* \w her lineage|strong="H04138"\w*, \w because|strong="H03588"\w* \w Mordecai|strong="H04782"\w* \w had instructed|strong="H06680"\w* \w her|strong="H05921"\w* \w not|strong="H03808"\w* \w to do so|strong="H05046"\w*. \v 11 \w And every day|strong="H03605"\w* \w Mordecai|strong="H04782"\w* \w would walk back and forth|strong="H01980"\w* \w in front|strong="H06440"\w* \w of the court|strong="H02691"\w* \w of the harem|strong="H01004"\w* \w to learn|strong="H03045"\w* \w about|strong="H00853"\w* \w Esther’s|strong="H00635"\w* \w welfare|strong="H07965"\w* \w and what|strong="H04100"\w* \w was happening|strong="H06213"\w* to her.
\p \v 12 \w In the twelve|strong="H08147"\w* \w months|strong="H02320"\w* \w before her|strong="H05291"\w* \w turn|strong="H08447"\w* \w to go|strong="H00935"\w* \w to|strong="H00413"\w* \w King|strong="H04428"\w* \w Xerxes|strong="H00325"\w*, \w the harem|strong="H00802"\w* \w regulation required|strong="H01881"\w* \w each young woman|strong="H00802"\w* \w to receive beauty treatments|strong="H04795"\w* \w with oil|strong="H08081"\w* \w of myrrh|strong="H04753"\w* \w for six|strong="H08337"\w* \w months|strong="H02320"\w*, \w and then with perfumes|strong="H01314"\w* \w and cosmetics|strong="H08562"\w* \w for another six|strong="H08337"\w* \w months|strong="H02320"\w*. \v 13 \w When|strong="H02088"\w* \w the young woman|strong="H05291"\w* \w would go|strong="H00935"\w* \w to|strong="H00413"\w* \w the king|strong="H04428"\w*, \w she was given|strong="H05414"\w* \w whatever|strong="H03605"\w* \w she requested|strong="H00559"\w* \w to take|strong="H00935"\w* \w with her|strong="H05973"\w* \w from the harem|strong="H01004"\w* \w to|strong="H05704"\w* \w the king’s|strong="H04428"\w* \w palace|strong="H01004"\w*. \v 14 \w She|strong="H01931"\w* \w would go there|strong="H00935"\w* \w in the evening|strong="H06153"\w*, \w and in the morning|strong="H01242"\w* \w she|strong="H01931"\w* \w would return|strong="H07725"\w* \w to|strong="H00413"\w* \w a second|strong="H08145"\w* \w harem|strong="H01004"\w*\f + \fr 2:14 \ft Or \fqa to another part of the harem\f* \w under|strong="H00413"\w* \w the care|strong="H03027"\w* \w of Shaashgaz|strong="H08190"\w*, \w the king’s|strong="H04428"\w* \w eunuch|strong="H05631"\w* \w in charge of|strong="H08104"\w* \w the concubines|strong="H06370"\w*. \w She would not|strong="H03808"\w* \w return|strong="H00935"\w* \w to|strong="H00413"\w* \w the king|strong="H04428"\w* \w unless|strong="H03588"\w* \w he|strong="H04428"\w* \w delighted|strong="H02654"\w* in her \w and summoned her|strong="H07121"\w* \w by name|strong="H08034"\w*.
