\c 3
\s1 I Will Send My Messenger
\p \v 1 “\w Behold|strong="H02005"\w*, \w I will send|strong="H07971"\w* \w My messenger|strong="H04397"\w*, \w who will prepare|strong="H06437"\w* \w the way|strong="H01870"\w* \w before Me|strong="H06440"\w*.\f + \fr 3:1 \ft Cited in Matthew 11:10, Mark 1:2, and Luke 7:27\f* \w Then the Lord|strong="H00113"\w* \w whom|strong="H00834"\w* \w you|strong="H00859"\w* \w seek|strong="H01245"\w* \w will suddenly|strong="H06597"\w* \w come|strong="H00935"\w* \w to|strong="H00413"\w* \w His temple|strong="H01964"\w* — \w the Messenger|strong="H04397"\w* \w of the covenant|strong="H01285"\w*, \w in whom|strong="H00834"\w* \w you|strong="H00859"\w* \w delight|strong="H02655"\w* — \w see|strong="H02009"\w*, \w He is coming|strong="H00935"\w*,” \w says|strong="H00559"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*.
