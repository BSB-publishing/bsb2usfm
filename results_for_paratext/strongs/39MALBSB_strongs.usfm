\p \v 15 \w Has not the LORD|strong="H03808"\w* \w made them|strong="H06213"\w* \w one|strong="H00259"\w*, \w having a portion|strong="H07605"\w* \w of the Spirit|strong="H07307"\w*? \w And why|strong="H04100"\w* \w one|strong="H00259"\w*? \w Because He seeks|strong="H01245"\w* \w godly|strong="H00430"\w* \w offspring|strong="H02233"\w*. \w So guard yourselves|strong="H08104"\w* \w in your spirit|strong="H07307"\w* \w and do not|strong="H00408"\w* \w break faith|strong="H00898"\w* \w with the wife|strong="H00802"\w* \w of your youth|strong="H05271"\w*.
\p \v 16 “\w For|strong="H03588"\w* \w I hate|strong="H08130"\w* \w divorce|strong="H07971"\w*,” \w says|strong="H00559"\w* \w the LORD|strong="H03068"\w*, \w the God|strong="H00430"\w* \w of Israel|strong="H03478"\w*. “\w He who divorces his wife covers|strong="H03680"\w* \w his garment|strong="H03830"\w* \w with|strong="H05921"\w* \w violence|strong="H02555"\w*,”\f + \fr 2:16 \ft Or \fqa “For the man who hates his wife and divorces her,” says the LORD, the God of Israel, “covers his garment with violence,”\f* \w says|strong="H00559"\w* \w the LORD|strong="H03068"\w* \w of Hosts|strong="H06635"\w*. \w So guard yourselves|strong="H08104"\w* \w in your spirit|strong="H07307"\w* \w and do not|strong="H03808"\w* \w break faith|strong="H00898"\w*.
