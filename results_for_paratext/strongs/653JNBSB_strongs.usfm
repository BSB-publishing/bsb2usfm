\s1 Gaius Commended for Hospitality
\p \v 5 \w Beloved|strong="G00027"\w*, \w you are|strong="G04160"\w* \w faithful|strong="G04103"\w* \w in what|strong="G03739"\w* \w you are doing|strong="G02038"\w* \w for|strong="G01519"\w* \w the|strong="G03588"\w* \w brothers|strong="G00080"\w*, \w and especially since|strong="G02532"\w* \w they are|strong="G03778"\w* \w strangers to you|strong="G03581"\w*. \v 6 \w They|strong="G03739"\w* \w have testified|strong="G03140"\w* \w to|strong="G01799"\w* \w the church|strong="G01577"\w* \w about your|strong="G04771"\w* \w love|strong="G00026"\w*. \w You will do|strong="G04160"\w* \w well|strong="G02573"\w* \w to send them on their way|strong="G04311"\w* \w in a manner worthy|strong="G00516"\w* \w of God|strong="G02316"\w*. \v 7 \w For|strong="G01063"\w* \w they went out|strong="G01831"\w* \w on behalf|strong="G05228"\w* \w of the|strong="G03588"\w* \w Name|strong="G03686"\w*, \w accepting|strong="G02983"\w* \w nothing|strong="G03367"\w* \w from|strong="G00575"\w* \w the|strong="G03588"\w* \w Gentiles|strong="G01482"\w*. \v 8 \w Therefore|strong="G03767"\w* \w we|strong="G01473"\w* \w ought|strong="G03784"\w* \w to support|strong="G05274"\w* \w such men|strong="G05108"\w*, \w so that|strong="G02443"\w* \w we may be|strong="G01096"\w* \w fellow workers|strong="G04904"\w* \w for the|strong="G03588"\w* \w truth|strong="G00225"\w*.
