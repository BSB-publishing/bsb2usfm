\p \v 11 \w Beloved|strong="G00027"\w*, \w do not|strong="G03361"\w* \w imitate|strong="G03401"\w* \w what is|strong="G03588"\w* \w evil|strong="G02556"\w*, \w but|strong="G00235"\w* \w what is|strong="G03588"\w* \w good|strong="G00018"\w*. \w The one who|strong="G03588"\w* \w does good|strong="G00015"\w* \w is|strong="G01510"\w* \w of|strong="G01537"\w* \w God|strong="G02316"\w*; \w the one who|strong="G03588"\w* \w does evil|strong="G02554"\w* \w has not seen|strong="G03708"\w* \w God|strong="G02316"\w*.
\p \v 12 \w Demetrius|strong="G01216"\w* \w has received a good testimony|strong="G03140"\w* \w from|strong="G05259"\w* \w everyone|strong="G03956"\w*, \w and|strong="G02532"\w* \w from|strong="G05259"\w* \w the|strong="G03588"\w* \w truth|strong="G00225"\w* \w itself|strong="G00846"\w*. \w We|strong="G01473"\w* \w also|strong="G01161"\w* \w testify for him|strong="G03140"\w*, \w and|strong="G02532"\w* \w you know|strong="G01492"\w* \w that|strong="G03754"\w* \w our|strong="G01473"\w* \w testimony|strong="G03141"\w* \w is|strong="G01510"\w* \w true|strong="G00227"\w*.
