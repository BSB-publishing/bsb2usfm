\p \v 1 \w When|strong="G02532"\w* \w the|strong="G03588"\w* \w Sabbath|strong="G04521"\w* \w was over|strong="G01230"\w*, \w Mary|strong="G03137"\w* \w Magdalene|strong="G03094"\w*, \w Mary|strong="G03137"\w* \w the mother|strong="G03588"\w* \w of James|strong="G02385"\w*, \w and|strong="G02532"\w* \w Salome|strong="G04539"\w* \w bought|strong="G00059"\w* \w spices|strong="G00759"\w* \w so|strong="G02443"\w* \w they could go|strong="G02064"\w* \w and anoint|strong="G00218"\w* \w the body of Jesus|strong="G00846"\w*. \v 2 \w Very|strong="G03029"\w* \w early|strong="G04404"\w* \w on the|strong="G03588"\w* \w first day|strong="G01520"\w* \w of the|strong="G03588"\w* \w week|strong="G04521"\w*,\f + \fr 16:2 \ft Literally \fqa And very early on the first of the Sabbaths,\f* \w just after sunrise|strong="G02246"\w*, \w they went|strong="G02064"\w* \w to|strong="G01909"\w* \w the|strong="G03588"\w* \w tomb|strong="G03419"\w*. \v 3 \w They were asking|strong="G02036"\w* \w one another|strong="G01438"\w*, “\w Who|strong="G05101"\w* \w will roll away|strong="G00617"\w* \w the|strong="G03588"\w* \w stone|strong="G03037"\w* \w from|strong="G01537"\w* \w the|strong="G03588"\w* \w entrance|strong="G02374"\w* \w of the|strong="G03588"\w* \w tomb|strong="G03419"\w*?” \v 4 \w But|strong="G02532"\w* \w when they looked up|strong="G00308"\w*, \w they saw|strong="G02334"\w* \w that|strong="G03754"\w* \w the|strong="G03588"\w* \w stone|strong="G03037"\w* \w had been rolled away|strong="G00617"\w*, \w even though|strong="G01063"\w* \w it was|strong="G01510"\w* \w extremely|strong="G04970"\w* \w large|strong="G03173"\w*.
\p \v 5 \w When|strong="G02532"\w* \w they entered|strong="G01525"\w* \w the|strong="G03588"\w* \w tomb|strong="G03419"\w*, \w they saw|strong="G03708"\w* \w a young man|strong="G03495"\w* \w dressed in|strong="G04016"\w* \w a white|strong="G03022"\w* \w robe|strong="G04749"\w* \w sitting|strong="G02521"\w* \w on|strong="G01722"\w* \w the|strong="G03588"\w* \w right side|strong="G01188"\w*, \w and|strong="G02532"\w* \w they were alarmed|strong="G01568"\w*. \v 6 \w But|strong="G01161"\w* \w he said|strong="G03004"\w* \w to them|strong="G00846"\w*, “\w Do not|strong="G03361"\w* \w be alarmed|strong="G01568"\w*. \w You are looking for|strong="G02212"\w* \w Jesus|strong="G02424"\w* \w the|strong="G03588"\w* \w Nazarene|strong="G03479"\w*, \w who|strong="G03588"\w* \w was crucified|strong="G04717"\w*. \w He has risen|strong="G01453"\w*! \w He is|strong="G01510"\w* \w not|strong="G03756"\w* \w here|strong="G05602"\w*! \w See|strong="G02400"\w* \w the|strong="G03588"\w* \w place|strong="G05117"\w* \w where|strong="G03699"\w* \w they put|strong="G05087"\w* \w Him|strong="G00846"\w*. \v 7 \w But|strong="G00235"\w* \w go|strong="G05217"\w*, \w tell|strong="G02036"\w* \w His|strong="G00846"\w* \w disciples|strong="G03101"\w* \w and|strong="G02532"\w* \w Peter|strong="G04074"\w*, ‘\w He is going ahead of|strong="G04254"\w* \w you|strong="G04771"\w* \w into|strong="G01519"\w* \w Galilee|strong="G01056"\w*. \w There|strong="G01563"\w* \w you will see|strong="G03708"\w* \w Him|strong="G00846"\w*, \w just as|strong="G02531"\w* \w He told|strong="G02036"\w* \w you|strong="G04771"\w*.’”
\p \v 8 \w So|strong="G02532"\w* \w the women left|strong="G01831"\w* \w the|strong="G03588"\w* \w tomb|strong="G03419"\w* \w and ran away|strong="G05343"\w*, \w trembling|strong="G05156"\w* \w and|strong="G02532"\w* \w bewildered|strong="G01611"\w*. \w And|strong="G02532"\w* \w in their fear|strong="G05399"\w* \w they did not say|strong="G02036"\w* \w a word to anyone|strong="G03762"\w*.\f + \fr 16:8 \ft Some early manuscripts end the Gospel of Mark after verse 8. Other manuscripts contain only a short ending, a version of the following: \fv 9\fv*But they quickly reported all these instructions to Peter’s companions. Afterward, Jesus Himself, through them, sent out from east to west the sacred and imperishable proclamation of eternal salvation. Amen.\f*
\s1 Jesus Appears to Mary Magdalene
\p \v 9 \w Early|strong="G04404"\w* \w on the first day|strong="G04413"\w* \w of the week|strong="G04521"\w*, \w after Jesus had risen|strong="G00450"\w*,\f + \fr 16:9 \ft Or \fqa After Jesus had risen early on the first day of the week\f* \w He appeared|strong="G05316"\w* \w first|strong="G04412"\w* \w to Mary|strong="G03137"\w* \w Magdalene|strong="G03094"\w*, \w from|strong="G03844"\w* \w whom|strong="G03739"\w* \w He had driven out|strong="G01544"\w* \w seven|strong="G02033"\w* \w demons|strong="G01140"\w*. \v 10 \w She|strong="G01565"\w* \w went|strong="G04198"\w* \w and told|strong="G00518"\w* \w those|strong="G03588"\w* \w who had been|strong="G01096"\w* \w with|strong="G03326"\w* \w Him|strong="G00846"\w*, \w who were mourning|strong="G03996"\w* \w and|strong="G02532"\w* \w weeping|strong="G02799"\w*. \v 11 \w And when they|strong="G02548"\w* \w heard|strong="G00191"\w* \w that|strong="G03754"\w* \w Jesus was alive|strong="G02198"\w* \w and|strong="G02532"\w* \w she had seen Him|strong="G02300"\w*, \w they did not believe it|strong="G00569"\w*.
