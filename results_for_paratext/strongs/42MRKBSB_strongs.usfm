\p \v 12 \w After|strong="G03326"\w* \w this|strong="G03778"\w*, \w Jesus appeared|strong="G05319"\w* \w in|strong="G01722"\w* \w a different|strong="G02087"\w* \w form|strong="G03444"\w* \w to two|strong="G01417"\w* \w of|strong="G01537"\w* \w them|strong="G00846"\w* \w as they walked|strong="G04043"\w* \w along|strong="G04198"\w* \w in|strong="G01519"\w* \w the country|strong="G00068"\w*.
\p \v 13 \w And they|strong="G02548"\w* \w went back|strong="G00565"\w* \w and reported it|strong="G00518"\w* \w to the|strong="G03588"\w* \w rest|strong="G03062"\w*, \w but they did not believe|strong="G04100"\w* \w them|strong="G01565"\w* \w either|strong="G03761"\w*.
