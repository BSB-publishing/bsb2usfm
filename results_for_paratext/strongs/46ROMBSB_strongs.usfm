\p \v 19 \w Do not|strong="G03361"\w* \w avenge|strong="G01556"\w* \w yourselves|strong="G01438"\w*, \w beloved|strong="G00027"\w*, \w but|strong="G00235"\w* \w leave|strong="G01325"\w* \w room|strong="G05117"\w* \w for God’s wrath|strong="G03709"\w*. \w For|strong="G01063"\w* \w it is written|strong="G01125"\w*: “\w Vengeance is|strong="G01557"\w* \w Mine|strong="G01473"\w*; \w I|strong="G01473"\w* \w will repay|strong="G00467"\w*, \w says|strong="G03004"\w* \w the Lord|strong="G02962"\w*.”\f + \fr 12:19 \ft Deuteronomy 32:35 (see also LXX)\f*
