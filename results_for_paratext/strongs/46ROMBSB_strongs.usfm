\c 14
\s1 The Law of Liberty
\p \v 1 \w Accept|strong="G04355"\w* \w him whose|strong="G03588"\w* \w faith|strong="G04102"\w* \w is weak|strong="G00770"\w*, \w without|strong="G03361"\w* \w passing judgment|strong="G01253"\w* \w on his opinions|strong="G01261"\w*.\f + \fr 14:1 \ft Or \fqa without quarreling over disputable matters\f* \v 2 \w For|strong="G03303"\w* \w one person|strong="G03739"\w* \w has faith|strong="G04100"\w* \w to eat|strong="G05315"\w* \w all things|strong="G03956"\w*, \w while|strong="G01161"\w* \w another|strong="G03588"\w*, \w who is weak|strong="G00770"\w*, \w eats|strong="G02068"\w* \w only vegetables|strong="G03001"\w*. \v 3 \w The one who|strong="G03588"\w* \w eats everything|strong="G02068"\w* \w must not belittle|strong="G01848"\w* \w the one who|strong="G03588"\w* \w does not|strong="G02068"\w*, \w and|strong="G01161"\w* \w the one who|strong="G03588"\w* \w does not eat everything|strong="G02068"\w* \w must not judge|strong="G02919"\w* \w the one who|strong="G03588"\w* \w does|strong="G02068"\w*, \w for|strong="G01063"\w* \w God|strong="G02316"\w* \w has accepted|strong="G04355"\w* \w him|strong="G00846"\w*. \v 4 \w Who|strong="G05101"\w* \w are|strong="G01510"\w* \w you|strong="G04771"\w* \w to judge|strong="G02919"\w* \w someone else’s|strong="G00245"\w* \w servant|strong="G03610"\w*? \w To his|strong="G03588"\w* \w own|strong="G02398"\w* \w master|strong="G02962"\w* \w he stands|strong="G04739"\w* \w or|strong="G02228"\w* \w falls|strong="G04098"\w*. \w And|strong="G01161"\w* \w he will stand|strong="G02476"\w*, \w for|strong="G01063"\w* \w the|strong="G03588"\w* \w Lord|strong="G02962"\w* \w is able|strong="G01414"\w* \w to make him stand|strong="G02476"\w*.
