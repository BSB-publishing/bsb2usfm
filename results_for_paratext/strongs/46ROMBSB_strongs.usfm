\p \v 1 \w Therefore|strong="G00686"\w*, \w there is now|strong="G03568"\w* \w no|strong="G03762"\w* \w condemnation|strong="G02631"\w* \w for those who are|strong="G03588"\w* \w in|strong="G01722"\w* \w Christ|strong="G05547"\w* \w Jesus|strong="G02424"\w*.\f + \fr 8:1 \ft BYZ and TR \fqa in Christ Jesus, who do not walk according to the flesh but according to the Spirit.\f* \v 2 \w For|strong="G01063"\w* \w in|strong="G01722"\w* \w Christ|strong="G05547"\w* \w Jesus|strong="G02424"\w* \w the|strong="G03588"\w* \w law|strong="G03551"\w* \w of the|strong="G03588"\w* \w Spirit|strong="G04151"\w* \w of|strong="G03588"\w* \w life|strong="G02222"\w* \w set you|strong="G04771"\w*\f + \fr 8:2 \ft BYZ and TR \fqa me\f* \w free|strong="G01659"\w* \w from|strong="G00575"\w* \w the|strong="G03588"\w* \w law|strong="G03551"\w* \w of sin|strong="G00266"\w* \w and|strong="G02532"\w* \w death|strong="G02288"\w*. \v 3 \w For|strong="G01063"\w* \w what|strong="G03588"\w* \w the|strong="G03588"\w* \w law|strong="G03551"\w* \w was powerless to do|strong="G00102"\w* \w in|strong="G01722"\w* \w that|strong="G03739"\w* \w it was weakened|strong="G00770"\w* \w by|strong="G01223"\w* \w the|strong="G03588"\w* \w flesh|strong="G04561"\w*, \w God did|strong="G02316"\w* \w by sending|strong="G03992"\w* \w His|strong="G01438"\w* \w own|strong="G03588"\w* \w Son|strong="G05207"\w* \w in|strong="G01722"\w* \w the likeness|strong="G03667"\w* \w of sinful|strong="G00266"\w* \w man|strong="G04561"\w*, \w as an offering for|strong="G04012"\w* \w sin|strong="G00266"\w*.\f + \fr 8:3 \ft Literally \fqa in the likeness of sinful flesh and for sin\f* \w He thus condemned|strong="G02632"\w* \w sin|strong="G00266"\w* \w in|strong="G01722"\w* \w the|strong="G03588"\w* \w flesh|strong="G04561"\w*, \v 4 \w so that|strong="G02443"\w* \w the|strong="G03588"\w* \w righteous standard|strong="G01345"\w* \w of the|strong="G03588"\w* \w law|strong="G03551"\w* \w might be fulfilled|strong="G04137"\w* \w in|strong="G0