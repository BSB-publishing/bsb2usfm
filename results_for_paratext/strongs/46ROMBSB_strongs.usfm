\p \v 1 \w Do you not know|strong="G00050"\w*, \w brothers|strong="G00080"\w* \w (for|strong="G01063"\w* \w I am speaking|strong="G02980"\w* \w to those who know|strong="G01097"\w* \w the law)|strong="G03551"\w*, \w that|strong="G03754"\w* \w the|strong="G03588"\w* \w law|strong="G03551"\w* \w has authority over|strong="G02961"\w* \w a man|strong="G00444"\w* \w only|strong="G01909"\w* \w as long as|strong="G03745"\w* \w he lives|strong="G02198"\w*? \v 2 \w For instance|strong="G03588"\w*, \w a married|strong="G05220"\w* \w woman|strong="G01135"\w* \w is bound|strong="G01210"\w* \w by law|strong="G03551"\w* \w to her|strong="G03588"\w* \w husband|strong="G00435"\w* \w as long as he lives|strong="G02198"\w*. \w But|strong="G01161"\w* \w if|strong="G01437"\w* \w her|strong="G03588"\w* \w husband|strong="G00435"\w* \w dies|strong="G00599"\w*, \w she is released|strong="G02673"\w* \w from|strong="G00575"\w* \w the|strong="G03588"\w* \w law|strong="G03551"\w* \w of|strong="G03588"\w* \w marriage|strong="G00435"\w*. \v 3 \w So|strong="G03767"\w* \w then|strong="G00686"\w*, \w if|strong="G01437"\w* \w she is joined|strong="G01096"\w* \w to another|strong="G02087"\w* \w man|strong="G00435"\w* \w while her husband|strong="G00435"\w* \w is still alive|strong="G02198"\w*, \w she is called|strong="G05537"\w* \w an adulteress|strong="G03428"\w*; \w but|strong="G01161"\w* \w if|strong="G01437"\w* \w her|strong="G03588"\w* \w husband|strong="G00435"\w* \w dies|strong="G00599"\w*, \w she is|strong="G01510"\w* \w free|strong="G01658"\w* \w from|strong="G00575"\w* \w that|strong="G03588"\w* \w law|strong="G03551"\w* \w and|strong="G00846"\w* \w is|strong="G01510"\w* \w not|strong="G03361"\w* \w an adulteress|strong="G03428"\w* \w if she marries|strong="G01096"\w* \w another|strong="G02087"\w* \w man|strong="G00435"\w*.
\p \v 4 \w Therefore|strong="G05620"\w*, \w my|strong="G01473"\w* \w brothers|strong="G00080"\w*, \w you|strong="G04771"\w* \w also|strong="G02532"\w* \w died|strong="G02289"\w* \w to the|strong="G03588"\w* \w law|strong="G03551"\w* \w through|strong="G01223"\w* \w the|strong="G03588"\w* \w body|strong="G04983"\w* \w of Christ|strong="G05547"\w*, \w that|strong="G01519"\w* \w you|strong="G04771"\w* \w might belong|strong="G01096"\w* \w to another|strong="G02087"\w*, \w to Him who|strong="G03588"\w* \w was raised|strong="G01453"\w* \w from|strong="G01537"\w* \w the dead|strong="G03498"\w*, \w in order that|strong="G02443"\w* \w we might bear fruit|strong="G02592"\w* \w to God|strong="G02316"\w*. \v 5 \w For|strong="G01063"\w* \w when|strong="G03753"\w* \w we lived|strong="G01510"\w* \w according to|strong="G01722"\w* \w the|strong="G03588"\w* \w flesh|strong="G04561"\w*, \w the|strong="G03588"\w* \w sinful|strong="G00266"\w* \w passions|strong="G03804"\w* \w aroused by|strong="G01223"\w* \w the|strong="G03588"\w* \w law|strong="G03551"\w* \w were at work|strong="G01754"\w* \w in|strong="G01722"\w* \w our|strong="G01473"\w* \w bodies|strong="G03196"\w*, \w bearing fruit|strong="G02592"\w* \w for death|strong="G02288"\w*. \v 6 \w But|strong="G01161"\w* \w now|strong="G03570"\w*, \w having died|strong="G00599"\w* \w to|strong="G01722"\w* \w what|strong="G03739"\w* \w bound us|strong="G02722"\w*, \w we have been released|strong="G02673"\w* \w from|strong="G00575"\w* \w the|strong="G03588"\w* \w law|strong="G03551"\w*, \w so that|strong="G05620"\w* \w we|strong="G01473"\w* \w serve|strong="G01398"\w* \w in|strong="G01722"\w* \w the new way|strong="G02538"\w* \w of the Spirit|strong="G04151"\w*, \w and|strong="G02532"\w* \w not|strong="G03756"\w* \w in the old way|strong="G03821"\w* \w of the written code|strong="G01121"\w*.
\s1 God’s Law Is Holy
\p \v 7 \w What|strong="G05101"\w* \w then|strong="G03767"\w* \w shall we say|strong="G02046"\w*? \w Is the|strong="G03588"\w* \w law|strong="G03551"\w* \w sin|strong="G00266"\w*? \w Certainly not|strong="G01096"\w*! \w Indeed|strong="G00235"\w*, \w I would not have been mindful of|strong="G01097"\w* \w sin|strong="G00266"\w* \w if|strong="G01487"\w* \w not|strong="G03361"\w* \w for|strong="G01223"\w* \w the law|strong="G03551"\w*. \w For|strong="G01063"\w* \w I would not have been aware of|strong="G01492"\w* \w coveting|strong="G01939"\w* \w if|strong="G01487"\w* \w the|strong="G03588"\w* \w law|strong="G03551"\w* \w had not|strong="G03361"\w* \w said|strong="G02036"\w*, “\w Do not covet|strong="G01937"\w*.”\f + \fr 7:7 \ft Exodus 20:17; Deuteronomy 5:21\f* \v 8 \w But|strong="G01161"\w* \w sin|strong="G00266"\w*, \w seizing|strong="G02983"\w* \w its opportunity|strong="G00874"\w* \w through|strong="G01223"\w* \w the|strong="G03588"\w* \w commandment|strong="G01785"\w*, \w produced|strong="G02716"\w* \w in|strong="G01722"\w* \w me|strong="G01473"\w* \w every kind|strong="G03956"\w* \w of covetous desire|strong="G01939"\w*. \w For|strong="G01063"\w* \w apart from|strong="G05565"\w* \w the law|strong="G03551"\w*, \w sin|strong="G00266"\w* \w is dead|strong="G03498"\w*.
\p \v 9 \w Once|strong="G04218"\w* \w I|strong="G01473"\w* \w was alive|strong="G02198"\w* \w apart from|strong="G05565"\w* \w the law|strong="G03551"\w*; \w but when|strong="G01161"\w* \w the|strong="G03588"\w* \w commandment|strong="G01785"\w* \w came|strong="G02064"\w*, \w sin|strong="G00266"\w* \w sprang to life|strong="G00326"\w* \w and|strong="G01161"\w* \w I|strong="G01473"\w* \w died|strong="G00599"\w*. \v 10 \w So|strong="G02532"\w* \w I|strong="G01473"\w* \w discovered that|strong="G02147"\w* \w the|strong="G03778"\w* \w very|strong="G03588"\w* \w commandment|strong="G01785"\w* \w that was|strong="G03588"\w* \w meant to bring|strong="G01519"\w* \w life|strong="G02222"\w* \w actually brought|strong="G01519"\w* \w death|strong="G02288"\w*. \v 11 \w For|strong="G01063"\w* \w sin|strong="G00266"\w*, \w seizing|strong="G02983"\w* \w its opportunity|strong="G00874"\w* \w through|strong="G01223"\w* \w the|strong="G03588"\w* \w commandment|strong="G01785"\w*, \w deceived|strong="G01818"\w* \w me|strong="G01473"\w* \w and|strong="G02532"\w* \w through|strong="G01223"\w* \w the commandment|strong="G00846"\w* \w put me to death|strong="G00615"\w*.
\p \v 12 \w So|strong="G05620"\w* \w then|strong="G03303"\w*, \w the|strong="G03588"\w* \w law is|strong="G03551"\w* \w holy|strong="G00040"\w*, \w and|strong="G02532"\w* \w the|strong="G03588"\w* \w commandment is|strong="G01785"\w* \w holy|strong="G00040"\w*, \w righteous|strong="G01342"\w*, \w and|strong="G02532"\w* \w good|strong="G00018"\w*.
\s1 Struggling with Sin
\p \v 13 \w Did that which|strong="G03588"\w* \w is good|strong="G00018"\w*, \w then|strong="G03767"\w*, \w become|strong="G01096"\w* \w death|strong="G02288"\w* \w to me|strong="G01473"\w*? \w Certainly not|strong="G01096"\w*! \w But|strong="G00235"\w* \w in order that|strong="G02443"\w* \w sin|strong="G00266"\w* \w might be exposed as|strong="G05316"\w* \w sin|strong="G00266"\w*, \w it produced|strong="G02716"\w* \w death|strong="G02288"\w* \w in me|strong="G01473"\w* \w through|strong="G01223"\w* \w what was|strong="G03588"\w* \w good|strong="G00018"\w*, \w so that|strong="G02443"\w* \w through|strong="G01223"\w* \w the|strong="G03588"\w* \w commandment|strong="G01785"\w* \w sin|strong="G00266"\w* \w might become|strong="G01096"\w* \w utterly|strong="G05236"\w* \w sinful|strong="G00268"\w*.
\p \v 14 \w We know|strong="G01492"\w* \w that|strong="G03754"\w* \w the law|strong="G03551"\w* \w is|strong="G01510"\w* \w spiritual|strong="G04152"\w*; \w but|strong="G01161"\w* \w I|strong="G01473"\w* \w am|strong="G01510"\w* \w unspiritual|strong="G04560"\w*, \w sold as a slave|strong="G04097"\w* \w to|strong="G05259"\w* \w sin|strong="G00266"\w*. \v 15 \w I do not understand|strong="G01097"\w* \w what|strong="G03739"\w* \w I do|strong="G02716"\w*. \w For|strong="G01063"\w* \w what|strong="G03739"\w* \w I want to do|strong="G02309"\w*, \w I do not do|strong="G04238"\w*. \w But|strong="G00235"\w* \w what|strong="G03739"\w* \w I hate|strong="G03404"\w*, \w I do|strong="G04160"\w*. \v 16 \w And|strong="G01161"\w* \w if|strong="G01487"\w* \w I do|strong="G04160"\w* \w what|strong="G03739"\w* \w I do not want to do|strong="G02309"\w*, \w I admit|strong="G04852"\w* \w that|strong="G03754"\w* \w the|strong="G03588"\w* \w law|strong="G03551"\w* \w is good|strong="G02570"\w*. \v 17 \w In that case|strong="G03570"\w*, \w it is no longer|strong="G03765"\w* \w I|strong="G01473"\w* \w who do|strong="G02716"\w* \w it|strong="G00846"\w*, \w but it is|strong="G00235"\w* \w sin|strong="G00266"\w* \w living|strong="G03611"\w* \w in|strong="G01722"\w* \w me that does it|strong="G01473"\w*.
\p \v 18 \w I know|strong="G01492"\w* \w that|strong="G03754"\w* \w nothing|strong="G03756"\w* \w good|strong="G00018"\w* \w lives|strong="G03611"\w* \w in|strong="G01722"\w* \w me|strong="G01473"\w*, \w that|strong="G03778"\w* \w is|strong="G01510"\w*, \w in|strong="G01722"\w* \w my|strong="G01473"\w* \w flesh|strong="G04561"\w*; \w for|strong="G01063"\w* \w I|strong="G01473"\w* \w have|strong="G03873"\w* \w the|strong="G03588"\w* \w desire|strong="G02309"\w* \w to do|strong="G02716"\w* \w what is|strong="G03588"\w* \w good|strong="G02570"\w*, \w but|strong="G01161"\w* \w I cannot carry it out|strong="G03756"\w*. \v 19 \w For|strong="G01063"\w* \w I do not do|strong="G04160"\w* \w the good|strong="G00018"\w* \w I want to do|strong="G02309"\w*. \w Instead|strong="G00235"\w*, \w I keep on doing|strong="G04238"\w* \w the evil|strong="G02556"\w* \w I do not want to do|strong="G02309"\w*. \v 20 \w And|strong="G01161"\w* \w if|strong="G01487"\w* \w I|strong="G01473"\w* \w do|strong="G04160"\w* \w what|strong="G03739"\w* \w I do not want|strong="G02309"\w*, \w it is no longer|strong="G03765"\w* \w I|strong="G01473"\w* \w who do|strong="G02716"\w* \w it|strong="G00846"\w*, \w but it is|strong="G00235"\w* \w sin|strong="G00266"\w* \w living|strong="G03611"\w* \w in|strong="G01722"\w* \w me that does it|strong="G01473"\w*.
\p \v 21 \w So|strong="G00686"\w* \w this is the|strong="G03588"\w* \w principle|strong="G03551"\w* \w I have discovered|strong="G02147"\w*: \w When I|strong="G01473"\w* \w want|strong="G02309"\w* \w to do|strong="G04160"\w* \w good|strong="G02570"\w*, \w evil|strong="G02556"\w* \w is right there with|strong="G03873"\w* \w me|strong="G01473"\w*. \v 22 \w For|strong="G01063"\w* \w in my|strong="G03588"\w* \w inner|strong="G02080"\w* \w being|strong="G00444"\w* \w I delight|strong="G04913"\w* \w in|strong="G03588"\w* \w God’s|strong="G02316"\w* \w law|strong="G03551"\w*. \v 23 \w But|strong="G01161"\w* \w I see|strong="G00991"\w* \w another|strong="G02087"\w* \w law at work|strong="G03551"\w* \w in|strong="G01722"\w* \w my|strong="G01473"\w* \w body|strong="G03196"\w*, \w warring against|strong="G00497"\w* \w the|strong="G03588"\w* \w law|strong="G03551"\w* \w of my|strong="G01473"\w* \w mind|strong="G03563"\w* \w and|strong="G02532"\w* \w holding me captive|strong="G00163"\w* \w to|strong="G01722"\w* \w the|strong="G03588"\w* \w law|strong="G03551"\w* \w of sin|strong="G00266"\w* \w that dwells|strong="G01510"\w* \w within|strong="G01722"\w* \w me|strong="G03196"\w*.\f + \fr 7:23 \ft Literally \fqa captive to the law of sin being in my members.\f*
\p \v 24 \w What a wretched|strong="G05005"\w* \w man|strong="G00444"\w* \w I am|strong="G01473"\w*! \w Who|strong="G05101"\w* \w will rescue|strong="G04506"\w* \w me|strong="G01473"\w* \w from|strong="G01537"\w* \w this|strong="G03778"\w* \w body|strong="G04983"\w* \w of death|strong="G02288"\w*? \v 25 \w Thanks be|strong="G05485"\w* \w to|strong="G03588"\w* \w God|strong="G02316"\w*, \w through|strong="G01223"\w* \w Jesus|strong="G02424"\w* \w Christ|strong="G05547"\w* \w our|strong="G01473"\w* \w Lord|strong="G02962"\w*!
\p \w So|strong="G03767"\w* \w then|strong="G00686"\w*, \w with my|strong="G03588"\w* \w mind|strong="G03563"\w* \w I|strong="G01473"\w* \w serve|strong="G01398"\w* \w the law|strong="G03551"\w* \w of God|strong="G02316"\w*, \w but|strong="G01161"\w* \w with my|strong="G03588"\w* \w flesh|strong="G04561"\w* \w I serve the law|strong="G03551"\w* \w of sin|strong="G00266"\w*.
