\s1 Submission to Authorities
\p \v 1 \w Everyone|strong="G03956"\w* \w must submit himself|strong="G05293"\w* \w to the governing authorities|strong="G01849"\w*, \w for|strong="G01063"\w* \w there is|strong="G01510"\w* \w no|strong="G03756"\w* \w authority|strong="G01849"\w* \w except|strong="G01487"\w* \w that which is from|strong="G05259"\w* \w God|strong="G02316"\w*. \w The authorities that|strong="G03588"\w* \w exist|strong="G01510"\w* \w have been appointed|strong="G05021"\w* \w by|strong="G05259"\w* \w God|strong="G02316"\w*. \v 2 \w Consequently|strong="G05620"\w*, \w whoever|strong="G03588"\w* \w resists|strong="G00498"\w* \w authority|strong="G01849"\w* \w is opposing|strong="G00436"\w* \w what|strong="G03588"\w* \w God|strong="G02316"\w* \w has set in place|strong="G01296"\w*, \w and|strong="G01161"\w* \w those who|strong="G03588"\w* \w do so|strong="G00436"\w* \w will bring|strong="G02983"\w* \w judgment|strong="G02917"\w* \w on themselves|strong="G01438"\w*.
\p \v 3 \w For|strong="G01063"\w* \w rulers|strong="G00758"\w* \w are|strong="G01510"\w* \w not|strong="G03756"\w* \w a terror|strong="G05401"\w* \w to good|strong="G00018"\w* \w conduct|strong="G02041"\w*, \w but|strong="G00235"\w* \w to bad|strong="G02556"\w*. \w Do you want|strong="G02309"\w* \w to be unafraid|strong="G05399"\w* \w of the|strong="G03588"\w* \w one in authority|strong="G01849"\w*? \w Then do|strong="G04160"\w* \w what is|strong="G03588"\w* \w right|strong="G00018"\w*, \w and|strong="G02532"\w* \w you will have|strong="G02192"\w* \w his|strong="G00846"\w* \w approval|strong="G01868"\w*. \v 4 \w For|strong="G01063"\w* \w he is|strong="G01510"\w* \w God’s|strong="G02316"\w* \w servant|strong="G01249"\w* \w for|strong="G01519"\w* \w your|strong="G04771"\w* \w good|strong="G00018"\w*. \w But|strong="G01161"\w* \w if|strong="G01437"\w* \w you do|strong="G04160"\w* \w wrong|strong="G02556"\w*, \w be afraid|strong="G05399"\w*, \w for|strong="G01063"\w* \w he does not carry|strong="G05409"\w* \w the|strong="G03588"\w* \w sword|strong="G03162"\w* \w in vain|strong="G01500"\w*. \w He is|strong="G01510"\w* \w God’s|strong="G02316"\w* \w servant|strong="G01249"\w*, \w an agent|strong="G01558"\w* \w of|strong="G01519"\w* \w retribution|strong="G03709"\w* \w to the|strong="G03588"\w* \w wrongdoer|strong="G02556"\w*.
\p \v 5 \w Therefore|strong="G01352"\w* \w it is necessary|strong="G00318"\w* \w to submit to authority|strong="G05293"\w*, \w not|strong="G03756"\w* \w only|strong="G03440"\w* \w to avoid|strong="G01223"\w* \w punishment|strong="G03709"\w*, \w but|strong="G00235"\w* \w also|strong="G02532"\w* \w as a matter of|strong="G01223"\w* \w conscience|strong="G04893"\w*. \v 6 \w This is also why|strong="G01223"\w* \w you pay|strong="G05055"\w* \w taxes|strong="G05411"\w*. \w For|strong="G01063"\w* \w the authorities are|strong="G01510"\w* \w God’s|strong="G02316"\w* \w servants|strong="G03011"\w*, \w who devote themselves|strong="G04342"\w* \w to|strong="G01519"\w* \w their work|strong="G03778"\w*. \v 7 \w Pay|strong="G00591"\w* \w everyone|strong="G03956"\w* \w what|strong="G03588"\w* \w you owe him|strong="G03782"\w*: \w taxes|strong="G05411"\w* \w to whom|strong="G03588"\w* \w taxes are due|strong="G05411"\w*, \w revenue|strong="G05056"\w* \w to whom|strong="G03588"\w* \w revenue is due|strong="G05056"\w*, \w respect|strong="G05401"\w* \w to whom|strong="G03588"\w* \w respect is due|strong="G05401"\w*, \w honor|strong="G05092"\w* \w to whom|strong="G03588"\w* \w honor is due|strong="G05092"\w*.
\s1 Love Fulfills the Law
\p \v 8 \w Be indebted|strong="G03784"\w* \w to no one|strong="G03367"\w*, \w except|strong="G01487"\w* \w to one another|strong="G00240"\w* \w in love|strong="G00025"\w*. \w For|strong="G01063"\w* \w he who|strong="G03588"\w* \w loves|strong="G00025"\w* \w his|strong="G03588"\w* \w neighbor|strong="G02087"\w* \w has fulfilled|strong="G04137"\w* \w the law|strong="G03551"\w*. \v 9 \w The commandments|strong="G03588"\w* “\w Do not commit adultery|strong="G03431"\w*,” “\w Do not murder|strong="G05407"\w*,” “\w Do not steal|strong="G02813"\w*,” “\w Do not covet|strong="G01937"\w*,”\f + \fr 13:9 \ft Exodus 20:13–17; Deuteronomy 5:17–21\f* \w and|strong="G02532"\w* \w any|strong="G05100"\w* \w other|strong="G02087"\w* \w commandments|strong="G01785"\w*, \w are summed up|strong="G00346"\w* \w in|strong="G01722"\w* \w this|strong="G03778"\w* \w one|strong="G03588"\w* \w decree|strong="G03056"\w*: “\w Love|strong="G00025"\w* \w your|strong="G04771"\w* \w neighbor|strong="G04139"\w* \w as|strong="G05613"\w* \w yourself|strong="G04572"\w*.”\f + \fr 13:9 \ft Leviticus 19:18\f* \v 10 \w Love|strong="G00026"\w* \w does no wrong|strong="G02556"\w* \w to its|strong="G03588"\w* \w neighbor|strong="G04139"\w*. \w Therefore|strong="G03767"\w* \w love is|strong="G00026"\w* \w the fulfillment|strong="G04138"\w* \w of the law|strong="G03551"\w*.
\s1 The Day Is Near
\p \v 11 \w And do|strong="G02532"\w* \w this|strong="G03778"\w*, \w understanding|strong="G01492"\w* \w the|strong="G03588"\w* \w occasion|strong="G02540"\w*. \w The hour|strong="G05610"\w* \w has come|strong="G02235"\w* \w for you|strong="G04771"\w* \w to wake up|strong="G01453"\w* \w from|strong="G01537"\w* \w your slumber|strong="G05258"\w*, \w for|strong="G01063"\w* \w our|strong="G01473"\w* \w salvation|strong="G04991"\w* \w is nearer|strong="G01452"\w* \w now|strong="G03568"\w* \w than|strong="G02228"\w* \w when|strong="G03753"\w* \w we first believed|strong="G04100"\w*. \v 12 \w The|strong="G03588"\w* \w night|strong="G03571"\w* \w is nearly over|strong="G04298"\w*; \w the|strong="G03588"\w* \w day|strong="G02250"\w* \w has drawn near|strong="G01448"\w*. \w So|strong="G03767"\w* \w let us lay aside|strong="G00659"\w* \w the|strong="G03588"\w* \w deeds|strong="G02041"\w* \w of darkness|strong="G04655"\w* \w and|strong="G01161"\w* \w put on|strong="G01746"\w* \w the|strong="G03588"\w* \w armor|strong="G03696"\w* \w of light|strong="G05457"\w*. \v 13 \w Let us behave|strong="G04043"\w* \w decently|strong="G02156"\w*, \w as|strong="G05613"\w* \w in|strong="G01722"\w* \w the daytime|strong="G02250"\w*, \w not|strong="G03361"\w* \w in carousing|strong="G02970"\w* \w and|strong="G02532"\w* \w drunkenness|strong="G03178"\w*, \w not|strong="G03361"\w* \w in sexual immorality|strong="G02845"\w* \w and|strong="G02532"\w* \w debauchery|strong="G00766"\w*, \w not|strong="G03361"\w* \w in dissension|strong="G02054"\w* \w and|strong="G02532"\w* \w jealousy|strong="G02205"\w*. \v 14 \w Instead|strong="G00235"\w*, \w clothe yourselves with|strong="G01746"\w*\f + \fr 13:14 \ft Or \fqa put on\ft ; see verse 12.\f* \w the|strong="G03588"\w* \w Lord|strong="G02962"\w* \w Jesus|strong="G02424"\w* \w Christ|strong="G05547"\w*, \w and|strong="G02532"\w* \w make|strong="G04160"\w* \w no|strong="G03361"\w* \w provision|strong="G04307"\w* \w for|strong="G01519"\w* \w the desires|stron