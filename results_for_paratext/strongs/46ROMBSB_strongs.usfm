\p \v 1 \w I ask|strong="G03004"\w* \w then|strong="G03767"\w*, \w did God|strong="G02316"\w* \w reject|strong="G00683"\w* \w His|strong="G00846"\w* \w people|strong="G02992"\w*? \w Certainly not|strong="G01096"\w*! \w I|strong="G01473"\w* \w am|strong="G01510"\w* \w an Israelite|strong="G02475"\w* \w myself|strong="G02532"\w*, \w a descendant|strong="G04690"\w* \w of Abraham|strong="G00011"\w*, \w from the tribe|strong="G05443"\w* \w of Benjamin|strong="G00958"\w*. \v 2 \w God|strong="G02316"\w* \w did not reject|strong="G00683"\w* \w His|strong="G00846"\w* \w people|strong="G02992"\w*, \w whom|strong="G03739"\w* \w He foreknew|strong="G04267"\w*. \w Do you not know|strong="G01492"\w* \w what|strong="G05101"\w* \w the|strong="G03588"\w* \w Scripture|strong="G01124"\w* \w says|strong="G03004"\w* \w about|strong="G01722"\w* \w Elijah|strong="G02243"\w*, \w how|strong="G05613"\w* \w he appealed|strong="G01793"\w* \w to God|strong="G02316"\w* \w against|strong="G02596"\w* \w Israel|strong="G02474"\w*: \v 3 “\w Lord|strong="G02962"\w*, \w they have killed|strong="G00615"\w* \w Your|strong="G04771"\w* \w prophets|strong="G04396"\w* \w and torn down|strong="G02679"\w* \w Your|strong="G04771"\w* \w altars|strong="G02379"\w*. \w I|strong="G02504"\w* \w am the only one|strong="G03441"\w* \w left|strong="G05275"\w*, \w and|strong="G02532"\w* \w they are seeking|strong="G02212"\w* \w my|strong="G01473"\w* \w life as well|strong="G05590"\w*”\f + \fr 11:3 \ft 1 Kings 19:10, 14\f*?
