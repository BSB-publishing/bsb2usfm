\p \v 5 \w Those|strong="G03588"\w* \w who live|strong="G01510"\w* \w according to|strong="G02596"\w* \w the flesh|strong="G04561"\w* \w set their minds|strong="G05426"\w* \w on the things|strong="G03588"\w* \w of the|strong="G03588"\w* \w flesh|strong="G04561"\w*; \w but|strong="G01161"\w* \w those who live|strong="G03588"\w* \w according to|strong="G02596"\w* \w the Spirit|strong="G04151"\w* \w set their minds on the things|strong="G03588"\w* \w of the|strong="G03588"\w* \w Spirit|strong="G04151"\w*. \v 6 \w The|strong="G03588"\w* \w mind|strong="G05427"\w* \w of the|strong="G03588"\w* \w flesh|strong="G04561"\w* \w is death|strong="G02288"\w*, \w but|strong="G01161"\w* \w the|strong="G03588"\w* \w mind|strong="G05427"\w* \w of the|strong="G03588"\w* \w Spirit|strong="G04151"\w* \w is life|strong="G02222"\w* \w and|strong="G02532"\w* \w peace|strong="G01515"\w*, \v 7 \w because|strong="G01360"\w* \w the|strong="G03588"\w* \w mind|strong="G05427"\w* \w of the|strong="G03588"\w* \w flesh|strong="G04561"\w* \w is hostile|strong="G02189"\w* \w to|strong="G01519"\w* \w God|strong="G02316"\w*: \w It does not submit|strong="G05293"\w* \w to|strong="G03588"\w* \w God’s|strong="G02316"\w* \w law|strong="G03551"\w*, \w nor|strong="G03761"\w* \w can it do so|strong="G01410"\w*. \v 8 \w Those|strong="G03588"\w* \w controlled by|strong="G01722"\w* \w the flesh|strong="G04561"\w*\f + \fr 8:8 \ft Literally \fqa Those being in the flesh\ft ; similarly in verse 9\f* \w cannot|strong="G01410"\w* \w please|strong="G00700"\w* \w God|strong="G02316"\w*.
\p \v 9 \w You|strong="G04771"\w*, \w however|strong="G01161"\w*, \w are|strong="G01510"\w* \w controlled not by|strong="G01722"\w* \w the flesh|strong="G04561"\w*, \w but|strong="G00235"\w* \w by|strong="G01722"\w* \w the Spirit|strong="G04151"\w*, \w if|strong="G01512"\w* \w the Spirit|strong="G04151"\w* \w of God|strong="G02316"\w* \w lives|strong="G03611"\w* \w in|strong="G01722"\w* \w you|strong="G04771"\w*. \w And|strong="G01161"\w* \w if|strong="G01487"\w* \w anyone|strong="G05100"\w* \w does not|strong="G03756"\w* \w have|strong="G02192"\w* \w the Spirit|strong="G04151"\w* \w of Christ|strong="G05547"\w*, \w he|strong="G03778"\w* \w does not|strong="G03756"\w* \w belong|strong="G01510"\w* \w to Christ|strong="G00846"\w*. \v 10 \w But|strong="G01161"\w* \w if|strong="G01487"\w* \w Christ|strong="G05547"\w* \w is in|strong="G01722"\w* \w you|strong="G04771"\w*, \w your|strong="G03588"\w* \w body is|strong="G04983"\w* \w dead|strong="G03498"\w* \w because of|strong="G01223"\w* \w sin|strong="G00266"\w*, \w yet|strong="G01161"\w* \w your|strong="G03588"\w* \w spirit|strong="G04151"\w* \w is alive|strong="G02222"\w*\f + \fr 8:10 \ft Or \fqa yet the Spirit is life\f* \w because of|strong="G01223"\w* \w righteousness|strong="G01343"\w*. \v 11 \w And|strong="G01161"\w* \w if|strong="G01487"\w* \w the|strong="G03588"\w* \w Spirit|strong="G04151"\w* \w of Him|strong="G03588"\w* \w who raised|strong="G01453"\w* \w Jesus|strong="G02424"\w* \w from|strong="G01537"\w* \w the dead|strong="G03498"\w* \w is living|strong="G03611"\w* \w in|strong="G01722"\w* \w you|strong="G04771"\w*, \w He who|strong="G03588"\w* \w raised|strong="G01453"\w* \w Christ|strong="G05547"\w* \w Jesus|strong="G02424"\w* \w from|strong="G01537"\w* \w the dead|strong="G03498"\w*\f + \fr 8:11 \ft NA, BYZ, and TR \fqa raised Christ from the dead\f* \w will also give life|strong="G02227"\w* \w to your|strong="G04771"\w* \w mortal|strong="G02349"\w* \w bodies|strong="G04983"\w* \w through|strong="G01223"