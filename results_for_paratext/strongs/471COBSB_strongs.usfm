\p \v 4 \w So|strong="G03767"\w* \w if|strong="G01437"\w* \w you need|strong="G02192"\w* \w to settle|strong="G02922"\w* \w everyday matters|strong="G00982"\w*, \w do you appoint as judges|strong="G02523"\w* \w those|strong="G03778"\w* \w of no standing|strong="G01848"\w* \w in|strong="G01722"\w* \w the|strong="G03588"\w* \w church|strong="G01577"\w*? \v 5 \w I say this|strong="G03004"\w* \w to your|strong="G04771"\w* \w shame|strong="G01791"\w*. \w Is there|strong="G01762"\w* \w really|strong="G03779"\w* \w no|strong="G03756"\w* \w one|strong="G03762"\w* \w among|strong="G01722"\w* \w you|strong="G04771"\w* \w wise enough|strong="G04680"\w* \w to arbitrate|strong="G01252"\w* \w between|strong="G03319"\w* \w his|strong="G00846"\w* \w brothers|strong="G00080"\w*? \v 6 \w Instead|strong="G00235"\w*, \w one brother|strong="G00080"\w* \w goes to law|strong="G02919"\w* \w against|strong="G03326"\w* \w another|strong="G00080"\w*, \w and|strong="G02532"\w* \w this|strong="G03778"\w* \w in front of|strong="G01909"\w* \w unbelievers|strong="G00571"\w*!
