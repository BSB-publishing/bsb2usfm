\p \v 1 \w It is actually|strong="G03654"\w* \w reported that there is|strong="G00191"\w* \w sexual immorality|strong="G04202"\w* \w among|strong="G01722"\w* \w you|strong="G04771"\w*, \w and|strong="G02532"\w* \w of a kind|strong="G04202"\w* \w that is|strong="G05108"\w* \w intolerable even|strong="G03761"\w* \w among|strong="G01722"\w* \w pagans|strong="G01484"\w*: \w A man|strong="G05100"\w* \w has|strong="G02192"\w* \w his|strong="G03588"\w* \w father’s|strong="G03962"\w* \w wife|strong="G01135"\w*. \v 2 \w And|strong="G02532"\w* \w you|strong="G04771"\w* \w are|strong="G01510"\w* \w proud|strong="G05448"\w*! \w Shouldn’t you|strong="G03780"\w* \w rather|strong="G03123"\w* \w have been stricken with grief|strong="G03996"\w* \w and|strong="G02443"\w* \w have removed|strong="G00142"\w* \w from|strong="G01537"\w* \w your|strong="G04771"\w* \w fellowship|strong="G03319"\w* \w the man who|strong="G03588"\w* \w did|strong="G04238"\w* \w this|strong="G03778"\w*?
\p \v 3 \w Although|strong="G01063"\w* \w I|strong="G01473"\w* \w am absent from you|strong="G00548"\w* \w in body|strong="G04983"\w*, \w I am present with you|strong="G03918"\w* \w in spirit|strong="G04151"\w*, \w and I have already pronounced judgment|strong="G02919"\w* \w on the one|strong="G03588"\w* \w who|strong="G03779"\w* \w did|strong="G02716"\w* \w this|strong="G03778"\w*, \w just as if|strong="G05613"\w* \w I were present|strong="G03918"\w*. \v 4 \w When you|strong="G04771"\w* \w are assembled|strong="G04863"\w* \w in|strong="G01722"\w* \w the|strong="G03588"\w* \w name|strong="G03686"\w* \w of|strong="G03588"\w* \w our|strong="G01473"\w* \w Lord|strong="G02962"\w* \w Jesus|strong="G02424"\w*\f + \fr 5:4 \ft Or \fqa In the name of our Lord Jesus, when you are assembled\f* \w and|strong="G02532"\w* \w I am with you|strong="G01699"\w* \w in spirit|strong="G04151"\w*, \w along with|strong="G04862"\w* \w the|strong="G03588"\w* \w power|strong="G01411"\w* \w of the|strong="G03588"\w* \w Lord|strong="G02962"\w* \w Jesus|strong="G02424"\w*, \v 5 \w hand|strong="G03860"\w* \w this man over|strong="G05108"\w* \w to Satan|strong="G04567"\w* \w for|strong="G01519"\w* \w the destruction|strong="G03639"\w* \w of the|strong="G03588"\w* \w flesh|strong="G04561"\w*, \w so that|strong="G02443"\w* \w his|strong="G03588"\w* \w spirit|strong="G04151"\w* \w may be saved|strong="G04982"\w* \w on|strong="G01722"\w* \w the|strong="G03588"\w* \w Day|strong="G02250"\w* \w of the|strong="G03588"\w* \w Lord|strong="G02962"\w*.\f + \fr 5:5 \ft BYZ and TR \fqa the Lord Jesus\f*
\p \v 6 \w Your|strong="G04771"\w* \w boasting|strong="G02745"\w* \w is not|strong="G03756"\w* \w good|strong="G02570"\w*. \w Do you not know|strong="G01492"\w* \w that|strong="G03754"\w* \w a little|strong="G03398"\w* \w leaven|strong="G02219"\w* \w works through|strong="G02220"\w* \w the|strong="G03588"\w* \w whole|strong="G03650"\w* \w batch of dough|strong="G05445"\w*? \v 7 \w Get rid of|strong="G01571"\w* \w the|strong="G03588"\w* \w old|strong="G03820"\w* \w leaven|strong="G02219"\w*, \w that|strong="G02443"\w* \w you may be|strong="G01510"\w* \w a new|strong="G03501"\w* \w unleavened|strong="G00106"\w* \w batch|strong="G05445"\w*, \w as|strong="G02531"\w* \w you really are|strong="G01510"\w*. \w For|strong="G01063"\w* \w Christ|strong="G05547"\w*, \w our|strong="G01473"\w* \w Passover lamb|strong="G03957"\w*, \w has been sacrificed|strong="G02380"\w*. \v 8 \w Therefore|strong="G05620"\w* \w let us keep the feast|strong="G01858"\w*, \w not|strong="G03361"\w* \w with|strong="G01722"\w* \w the old|strong="G03820"\w* \w bread, leavened|strong="G02219"\w* \w with malice|strong="G02549"\w* \w and|strong="G02532"\w* \w wickedness|strong="G04189"\w*, \w but|strong="G00235"\w* \w with|strong="G01722"\w* \w the unleavened bread|strong="G00106"\w* \w of sincerity|strong="G01505"\w* \w and|strong="G02532"\w* \w of truth|strong="G00225"\w*.
\s1 Expel the Immoral Brother
