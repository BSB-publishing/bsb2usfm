\p \v 29 \w What|strong="G01161"\w* \w I am saying|strong="G05346"\w*, \w brothers|strong="G00080"\w*, \w is that|strong="G03778"\w* \w the|strong="G03588"\w* \w time|strong="G02540"\w* \w is|strong="G01510"\w* \w short|strong="G04958"\w*. \w From now on|strong="G03063"\w* \w those who|strong="G03588"\w* \w have|strong="G02192"\w* \w wives|strong="G01135"\w* \w should live|strong="G01510"\w* \w as if|strong="G05613"\w* \w they had|strong="G02192"\w* \w none|strong="G03361"\w*; \v 30 \w those who|strong="G03588"\w* \w weep|strong="G02799"\w*, \w as if|strong="G05613"\w* \w they did not|strong="G02799"\w*; \w those who|strong="G03588"\w* \w are joyful|strong="G05463"\w*, \w as if|strong="G05613"\w* \w they were not|strong="G05463"\w*; \w those who|strong="G03588"\w* \w make a purchase|strong="G00059"\w*, \w as if|strong="G05613"\w* \w they had nothing|strong="G02722"\w*; \v 31 \w and|strong="G02532"\w* \w those who|strong="G03588"\w* \w use|strong="G05530"\w* \w the things of|strong="G03588"\w* \w this world|strong="G02889"\w*, \w as if|strong="G05613"\w* \w not dependent on them|strong="G02710"\w*. \w For|strong="G01063"\w* \w this|strong="G03778"\w* \w world|strong="G02889"\w* \w in its|strong="G03588"\w* \w present form|strong="G04976"\w* \w is passing away|strong="G03855"\w*.
