\p \v 1 \w Now|strong="G01161"\w* \w about|strong="G04012"\w* \w the|strong="G03588"\w* \w collection|strong="G03048"\w* \w for|strong="G01519"\w* \w the|strong="G03588"\w* \w saints|strong="G00040"\w*, \w you|strong="G04771"\w* \w are to do|strong="G04160"\w* \w as|strong="G05618"\w* \w I directed|strong="G01299"\w* \w the|strong="G03588"\w* \w churches|strong="G01577"\w* \w of Galatia|strong="G01053"\w*: \v 2 \w On the first day|strong="G01520"\w* \w of every|strong="G02596"\w* \w week|strong="G04521"\w*, \w each|strong="G01538"\w* \w of you|strong="G04771"\w* \w should set|strong="G05087"\w* \w aside|strong="G03844"\w* \w a portion|strong="G01437"\w* \w of his income|strong="G02137"\w*, \w saving it up|strong="G02343"\w*, \w so that|strong="G02443"\w* \w when|strong="G03752"\w* \w I come|strong="G02064"\w* \w no|strong="G03361"\w* \w collections|strong="G03048"\w* \w will be needed|strong="G01096"\w*. \v 3 \w Then|strong="G01161"\w*, \w on my arrival|strong="G03854"\w*, \w I will send|strong="G03992"\w* \w letters|strong="G01992"\w* \w with|strong="G01223"\w* \w those|strong="G03778"\w* \w you recommend|strong="G01381"\w* \w to carry|strong="G00667"\w* \w your|strong="G04771"\w* \w gift|strong="G05485"\w* \w to|strong="G01519"\w* \w Jerusalem|strong="G02419"\w*. \v 4 \w And|strong="G01161"\w* \w if|strong="G01437"\w* \w it is|strong="G01510"\w* \w advisable|strong="G00514"\w* \w for|strong="G03588"\w* \w me|strong="G02504"\w* \w to go also|strong="G04198"\w*, \w they can travel|strong="G04198"\w* \w with|strong="G04862"\w* \w me|strong="G01473"\w*.
\s1 Paul’s Travel Plans
\p \v 5 \w After|strong="G03752"\w* \w I go through|strong="G01330"\w* \w Macedonia|strong="G03109"\w*, \w however|strong="G01161"\w*, \w I will come|strong="G02064"\w* \w to|strong="G04314"\w* \w you|strong="G04771"\w*; \w for|strong="G01063"\w* \w I will be going through|strong="G01330"\w* \w Macedonia|strong="G03109"\w*. \v 6 \w Perhaps|strong="G05177"\w* \w I will stay|strong="G03887"\w* \w with|strong="G04314"\w* \w you awhile|strong="G04771"\w*, \w or|strong="G02228"\w* \w even|strong="G02532"\w* \w spend the winter|strong="G03914"\w*, \w so that|strong="G02443"\w* \w you|strong="G04771"\w* \w can help|strong="G04311"\w* \w me on my journey|strong="G01473"\w*, \w wherever|strong="G03757"\w* \w I go|strong="G04198"\w*. \v 7 \w For|strong="G01063"\w* \w I do not want|strong="G02309"\w* \w to see|strong="G03708"\w* \w you|strong="G04771"\w* \w now|strong="G00737"\w* \w only in|strong="G01722"\w* \w passing|strong="G03938"\w*; \w I hope|strong="G01679"\w* \w to spend|strong="G01961"\w* \w some|strong="G05100"\w* \w time|strong="G05550"\w* \w with|strong="G04314"\w* \w you|strong="G04771"\w*, \w if|strong="G01437"\w* \w the|strong="G03588"\w* \w Lord|strong="G02962"\w* \w permits|strong="G02010"\w*. \v 8 \w But|strong="G01161"\w* \w I will stay|strong="G01961"\w* \w in|strong="G01722"\w* \w Ephesus|strong="G02181"\w* \w until|strong="G02193"\w* \w Pentecost|strong="G04005"\w*,\f + \fr 16:8 \ft That is, Shavuot, the late spring feast of pilgrimage to Jerusalem; it is also known as \fqa the Feast of Harvest\ft (see Exodus 23:16) or \fqa the Feast of Weeks\ft (see Exodus 34:22).\f* \v 9 \w because|strong="G01063"\w* \w a great|strong="G03173"\w* \w door|strong="G02374"\w* \w for|strong="G02532"\w* \w effective work|strong="G01756"\w* \w has opened|strong="G00455"\w* \w to me|strong="G01473"\w*, \w even though|strong="G02532"\w* \w many|strong="G04183"\w* \w oppose me|strong="G00480"\w*.
\s1 Timothy and Apollos
