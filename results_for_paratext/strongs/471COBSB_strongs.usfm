\p \v 12 \w What|strong="G05101"\w* \w business of mine is it|strong="G01473"\w* \w to judge|strong="G02919"\w* \w those|strong="G03588"\w* \w outside the church|strong="G01854"\w*? \w Are you|strong="G04771"\w* \w not|strong="G03780"\w* \w to judge|strong="G02919"\w* \w those|strong="G03588"\w* \w inside|strong="G02080"\w*? \v 13 \w God|strong="G02316"\w* \w will judge|strong="G02919"\w* \w those|strong="G03588"\w* \w outside|strong="G01854"\w*. “\w Expel|strong="G01808"\w* \w the|strong="G03588"\w* \w wicked man|strong="G04190"\w* \w from|strong="G01537"\w* \w among you|strong="G04771"\w*.”\f + \fr 5:13 \ft Literally \fqa Expel the evil from among you\ft ; Deuteronomy 13:5, 17:7, 19:19, 21:21, 22:21, 22:24, and 24:7\f*
