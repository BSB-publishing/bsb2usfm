\s1 Members of Christ
\p \v 9 \w Do you not know|strong="G01492"\w* \w that|strong="G03754"\w* \w the wicked|strong="G00094"\w* \w will not inherit|strong="G02816"\w* \w the kingdom|strong="G00932"\w* \w of God|strong="G02316"\w*? \w Do not|strong="G03361"\w* \w be deceived|strong="G04105"\w*: \w Neither|strong="G03777"\w* \w the sexually immoral|strong="G04205"\w*, \w nor|strong="G03777"\w* \w idolaters|strong="G01496"\w*, \w nor|strong="G03777"\w* \w adulterers|strong="G03432"\w*, \w nor|strong="G03777"\w* \w men who submit to|strong="G03120"\w* \w or|strong="G03777"\w* \w perform homosexual acts|strong="G00733"\w*, \v 10 \w nor|strong="G03777"\w* \w thieves|strong="G02812"\w*, \w nor|strong="G03777"\w* \w the greedy|strong="G04123"\w*, \w nor|strong="G03756"\w* \w drunkards|strong="G03183"\w*, \w nor|strong="G03756"\w* \w verbal abusers|strong="G03060"\w*, \w nor|strong="G03756"\w* \w swindlers|strong="G00727"\w*, \w will inherit|strong="G02816"\w* \w the kingdom|strong="G00932"\w* \w of God|strong="G02316"\w*. \v 11 \w And|strong="G02532"\w* \w that is what|strong="G03778"\w* \w some of|strong="G05100"\w* \w you were|strong="G01510"\w*. \w But|strong="G00235"\w* \w you were washed|strong="G00628"\w*, \w you were sanctified|strong="G00037"\w*, \w you were justified|strong="G01344"\w*, \w in|strong="G01722"\w* \w the|strong="G03588"\w* \w name|strong="G03686"\w* \w of the|strong="G03588"\w* \w Lord|strong="G02962"\w* \w Jesus|strong="G02424"\w* \w Christ|strong="G05547"\w* \w and|strong="G02532"\w* \w by|strong="G01722"\w* \w the|strong="G03588"\w* \w Spirit|strong="G04151"\w* \w of|strong="G03588"\w* \w our|strong="G01473"\w* \w God|strong="G02316"\w*.
\p \v 12 “\w Everything|strong="G03956"\w* \w is permissible|strong="G01832"\w* \w for me|strong="G01473"\w*,” \w but|strong="G00235"\w* \w not|strong="G03756"\w* \w everything|strong="G03956"\w* \w is beneficial|strong="G04851"\w*. “\w Everything|strong="G03956"\w* \w is permissible|strong="G01832"\w* \w for me|strong="G01473"\w*,” \w but|strong="G00235"\w* \w I|strong="G01473"\w* \w will not be mastered|strong="G01850"\w* \w by|strong="G05259"\w* \w anything|strong="G05100"\w*. \v 13 “\w Food|strong="G01033"\w* \w for the|strong="G03588"\w* \w stomach|strong="G02836"\w* \w and|strong="G02532"\w* \w the|strong="G03588"\w* \w stomach|strong="G02836"\w* \w for food|strong="G01033"\w*,” \w but|strong="G01161"\w* \w God|strong="G02316"\w* \w will destroy|strong="G02673"\w* \w them|strong="G03778"\w* \w both|strong="G02532"\w*. \w The|strong="G03588"\w* \w body is|strong="G04983"\w* \w not intended|strong="G03756"\w* \w for sexual immorality|strong="G04202"\w*, \w but|strong="G00235"\w* \w for the|strong="G03588"\w* \w Lord|strong="G02962"\w*, \w and|strong="G02532"\w* \w the|strong="G03588"\w* \w Lord|strong="G02962"\w* \w for the|strong="G03588"\w* \w body|strong="G04983"\w*. \v 14 \w By|strong="G01223"\w* \w His|strong="G00846"\w* \w power|strong="G01411"\w* \w God|strong="G02316"\w* \w raised|strong="G01453"\w* \w the|strong="G03588"\w* \w Lord from the dead|strong="G02962"\w*, \w and|strong="G02532"\w* \w He will raise us also|strong="G01825"\w*.
\p \v 15 \w Do you not know|strong="G01492"\w* \w that|strong="G03754"\w* \w your|strong="G04771"\w* \w bodies|strong="G04983"\w* \w are|strong="G01510"\w* \w members|strong="G03196"\w* \w of Christ|strong="G05547"\w*? \w Shall I then take|strong="G00142"\w* \w the|strong="G03588"\w* \w members|strong="G03196"\w* \w of Christ|strong="G05547"\w* \w and unite them|strong="G04160"\w* \w with a prostitute|strong="G04204"\w*? \w Never|strong="G01096"\w*! \v 16 \w Or|strong="G02228"\w* \w don’t you know|strong="G01492"\w* \w that|strong="G03754"\w* \w he who|strong="G03588"\w* \w unites himself|strong="G02853"\w* \w with a prostitute|strong="G04204"\w* \w is|strong="G01510"\w* \w one with her|strong="G01520"\w* \w in body|strong="G04983"\w*? \w For|strong="G01063"\w* \w it is said|strong="G05346"\w*, “\w The|strong="G03588"\w* \w two|strong="G01417"\w* \w will become|strong="G01510"\w* \w one|strong="G01520"\w* \w flesh|strong="G04561"\w*.”\f + \fr 6:16 \ft Genesis 2:24 (see also LXX)\f* \v 17 \w But|strong="G01161"\w* \w he who|strong="G03588"\w* \w unites himself|strong="G02853"\w* \w with the|strong="G03588"\w* \w Lord|strong="G02962"\w* \w is|strong="G01510"\w* \w one with Him|strong="G01520"\w* \w in spirit|strong="G04151"\w*.
