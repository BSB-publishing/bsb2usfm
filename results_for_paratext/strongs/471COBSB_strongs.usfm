\s1 Concluding Exhortations
\p \v 13 \w Be on the alert|strong="G01127"\w*. \w Stand firm|strong="G04739"\w* \w in|strong="G01722"\w* \w the|strong="G03588"\w* \w faith|strong="G04102"\w*. \w Be men of courage|strong="G00407"\w*. \w Be strong|strong="G02901"\w*. \v 14 \w Do|strong="G01096"\w* \w everything|strong="G03956"\w* \w in|strong="G01722"\w* \w love|strong="G00026"\w*.
\p \v 15 \w You know|strong="G01492"\w* \w that|strong="G03754"\w* \w Stephanas|strong="G04734"\w* \w and his|strong="G03588"\w* \w household|strong="G03614"\w* \w were|strong="G01510"\w* \w the first converts|strong="G00536"\w* \w in Achaia|strong="G00882"\w*, \w and|strong="G02532"\w* \w they have devoted|strong="G05021"\w* \w themselves|strong="G01438"\w* \w to the|strong="G01519"\w* \w service|strong="G01248"\w* \w of the|strong="G03588"\w* \w saints|strong="G00040"\w*. \w Now|strong="G01161"\w* \w I urge|strong="G03870"\w* \w you|strong="G04771"\w*, \w brothers|strong="G00080"\w*, \v 16 \w to|strong="G02443"\w* \w submit|strong="G05293"\w* \w to such as these|strong="G05108"\w*, \w and|strong="G02532"\w* \w to every|strong="G03956"\w* \w fellow worker|strong="G04903"\w* \w and|strong="G02532"\w* \w laborer|strong="G02872"\w*.
