\q1 \v 5 \w The mountains|strong="H02022"\w* \w quake|strong="H07493"\w* \w before Him|strong="H04480"\w*,
\q2 \w and the hills|strong="H01389"\w* \w melt away|strong="H04127"\w*;
\q1 \w the earth|strong="H00776"\w* \w trembles|strong="H05375"\w* \w at His presence|strong="H06440"\w*—
