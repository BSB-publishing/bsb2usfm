\p \v 12 \w The sleep|strong="H08142"\w* \w of the worker|strong="H05647"\w* \w is sweet|strong="H04966"\w*, \w whether|strong="H00518"\w* \w he eats|strong="H00398"\w* \w little|strong="H04592"\w* \w or|strong="H00518"\w* \w much|strong="H07235"\w*, \w but the abundance|strong="H07647"\w* \w of the rich man|strong="H06223"\w* \w permits|strong="H05117"\w* him \w no|strong="H00369"\w* \w sleep|strong="H03462"\w*.
\p \v 13 \w There is|strong="H03426"\w* \w a grievous|strong="H02470"\w* \w evil|strong="H07451"\w* \w I have seen|strong="H07200"\w* \w under|strong="H08478"\w* \w the sun|strong="H08121"\w*: \w wealth|strong="H06239"\w* \w hoarded|strong="H08104"\w* \w to the harm|strong="H07451"\w* \w of its owner|strong="H01167"\w*, \v 14 \w or|strong="H01931"\w* \w wealth|strong="H06239"\w* \w lost|strong="H00006"\w* \w in a failed|strong="H07451"\w* \w venture|strong="H06045"\w*, \w so when that man has|strong="H03205"\w* \w a son|strong="H01121"\w* \w there is nothing|strong="H00369"\w* \w to pass on|strong="H03027"\w*.
\p \v 15 \w As|strong="H00834"\w* \w a man came|strong="H03318"\w* \w from his mother’s|strong="H00517"\w* \w womb|strong="H00990"\w*, \w so he will depart|strong="H01980"\w* \w again|strong="H07725"\w*, \w naked|strong="H06174"\w* \w as he arrived|strong="H00935"\w*. \w He takes|strong="H05375"\w* \w nothing|strong="H03972"\w* \w for his labor|strong="H05999"\w* \w to carry|strong="H01980"\w* \w in his hands|strong="H03027"\w*. \v 16 \w This|strong="H02090"\w* \w too|strong="H01571"\w* \w is a grievous|strong="H02470"\w* \w affliction|strong="H07451"\w*: \w Exactly as|strong="H03605"\w* \w a man is born|strong="H00935"\w*, \w so|strong="H03651"\w* \w he will depart|strong="H01980"\w*. \w What|strong="H04100"\w* \w does he gain|strong="H03504"\w* \w as he toils|strong="H05998"\w* \w for the wind|strong="H07307"\w*? \v 17 \w Moreover|strong="H01571"\w*, \w all|strong="H03605"\w* \w his days|strong="H03117"\w* \w he eats|strong="H00398"\w* \w in darkness|strong="H02822"\w*, \w with much|strong="H07235"\w* \w sorrow|strong="H03708"\w*, \w sickness|strong="H02483"\w*, \w and anger|strong="H07110"\w*.
\p \v 18 \w Here|strong="H02009"\w* \w is what|strong="H00834"\w* \w I|strong="H00589"\w* \w have seen|strong="H07200"\w* \w to be good|strong="H02896"\w* \w and fitting|strong="H03303"\w*: \w to eat|strong="H00398"\w* \w and drink|strong="H08354"\w*, \w and to find|strong="H07200"\w* \w satisfaction|strong="H02896"\w* \w in all|strong="H03605"\w* \w the labor|strong="H05999"\w* \w one does|strong="H05998"\w* \w under|strong="H08478"\w* \w the sun|strong="H08121"\w* \w during the few|strong="H04557"\w* \w days|strong="H03117"\w* \w of life|strong="H02416"\w* \w that|strong="H00834"\w* \w God|strong="H00430"\w* \w has given|strong="H05414"\w* him — \w for|strong="H03588"\w* \w this|strong="H01931"\w* \w is his lot|strong="H02506"\w*.
\p \v 19 \w Furthermore|strong="H01571"\w*, \w God|strong="H00430"\w* \w has given|strong="H05414"\w* \w riches|strong="H06239"\w* \w and wealth|strong="H05233"\w* to \w every|strong="H03605"\w* \w man|strong="H00120"\w*, \w and He has enabled him|strong="H07980"\w* \w to enjoy them|strong="H00398"\w*, \w to accept|strong="H05375"\w* \w his lot|strong="H02506"\w*, \w and to rejoice|strong="H08055"\w* \w in his labor|strong="H05999"\w*. \w This|strong="H02090"\w* \w is a gift|strong="H04991"\w* \w from God|strong="H00430"\w*. \v 20 \w For|strong="H03588"\w* \w a man seldom|strong="H03808"\w* \w considers|strong="H02142"\w* \w the days|strong="H03117"\w* \w of his life|strong="H02416"\w*, \w because|strong="H03588"\w* \w God|strong="H00430"\w* \w keeps him occupied|strong="H06031"\w* \w with the joy|strong="H08057"\w* \w of his heart|strong="H03820"\w*.
\c 6
\s1 The Futility of Life
\p \v 1 \w There is|strong="H03426"\w* \w another evil|strong="H07451"\w* \w I have seen|strong="H07200"\w* \w under|strong="H08478"\w* \w the sun|strong="H08121"\w*, \w and it|strong="H01931"\w* \w weighs heavily|strong="H07227"\w* \w upon|strong="H05921"\w* \w mankind|strong="H00120"\w*: \v 2 \w God|strong="H00430"\w* \w gives|strong="H05414"\w* \w a man|strong="H00376"\w* \w riches|strong="H06239"\w*, \w wealth|strong="H05233"\w*, \w and honor|strong="H03519"\w*, \w so that he lacks|strong="H02638"\w* \w nothing|strong="H00369"\w* \w his heart|strong="H05315"\w* \w desires|strong="H00183"\w*; \w but God|strong="H00430"\w* \w does not|strong="H03808"\w* \w allow him|strong="H07980"\w* \w to enjoy them|strong="H00398"\w*. \w Instead|strong="H03588"\w*, \w a stranger|strong="H00376"\w* \w will enjoy them|strong="H00398"\w*. \w This|strong="H02088"\w* \w is futile|strong="H01892"\w* \w and a grievous|strong="H02483"\w* \w affliction|strong="H07451"\w*.
\p \v 3 \w A man|strong="H00376"\w* \w may father|strong="H03205"\w* \w a hundred children|strong="H03967"\w* \w and live|strong="H02421"\w* \w for many|strong="H07227"\w* \w years|strong="H08141"\w*; \w yet no matter how long|strong="H07227"\w* \w he lives|strong="H03117"\w*, \w if he|strong="H05315"\w* \w is unsatisfied|strong="H07646"\w* \w with|strong="H04480"\w* \w his prosperity|strong="H02896"\w* \w and does not|strong="H03808"\w* \w even|strong="H01571"\w* \w receive a proper burial|strong="H06900"\w*, \w I say|strong="H00559"\w* \w that a stillborn child|strong="H05309"\w* \w is better off|strong="H02896"\w* \w than he|strong="H04480"\w*. \v 4 \w For|strong="H03588"\w* \w a stillborn child enters|strong="H00935"\w* \w in futility|strong="H01892"\w* \w and departs|strong="H01980"\w* \w in darkness|strong="H02822"\w*, \w and his name|strong="H08034"\w* \w is shrouded|strong="H03680"\w* \w in obscurity|strong="H02822"\w*. \v 5 \w The child|strong="H02088"\w*, \w though|strong="H01571"\w* \w neither|strong="H03808"\w* \w seeing|strong="H07200"\w* \w the sun|strong="H08121"\w* \w nor|strong="H03808"\w* \w knowing anything|strong="H03045"\w*, \w has more rest|strong="H05183"\w* \w than that man|strong="H02088"\w*, \v 6 \w even if|strong="H00432"\w* \w he lives|strong="H02421"\w* \w a thousand|strong="H00505"\w* \w years|strong="H08141"\w* \w twice over|strong="H06471"\w* \w but fails to|strong="H03808"\w* \w enjoy|strong="H07200"\w* \w his prosperity|strong="H02896"\w*. \w Do not|strong="H03808"\w* \w all|strong="H03605"\w* \w go|strong="H01980"\w* \w to|strong="H00413"\w* \w the same|strong="H00259"\w* \w place|strong="H04725"\w*?
\b 
\q1 \v 7 \w All|strong="H03605"\w* \w a man’s|strong="H00120"\w* \w labor|strong="H05999"\w* \w is for his mouth|strong="H06310"\w*,
\q2 \w yet|strong="H01571"\w* \w his appetite|strong="H05315"\w* \w is never|strong="H03808"\w* \w satisfied|strong="H04390"\w*.\f + \fr 6:7 \ft Hebrew \fqa filled\f*
\p \v 8 \w What|strong="H04100"\w* \w advantage|strong="H03148"\w*, \w then|strong="H03588"\w*, \w has the wise man|strong="H02450"\w* \w over|strong="H04480"\w* \w the fool|strong="H03684"\w*? \w What gain comes|strong="H04100"\w* \w to the poor man|strong="H06041"\w* \w who knows|strong="H03045"\w* \w how to conduct himself|strong="H01980"\w* \w before|strong="H05048"\w* \w others|strong="H02416"\w*? \v 9 \w Better|strong="H02896"\w* \w what the eye|strong="H05869"\w* \w can see|strong="H04758"\w* \w than the wandering|strong="H01980"\w* \w of desire|strong="H05315"\w*. \w This|strong="H02088"\w* \w too|strong="H01571"\w* \w is futile|strong="H01892"\w* \w and a pursuit|strong="H07469"\w* \w of the wind|strong="H07307"\w*.
\p \v 10 \w Whatever|strong="H04100"\w* \w exists|strong="H01961"\w* \w was named|strong="H07121"\w* \w long ago|strong="H03528"\w*, \w and it is known|strong="H03045"\w* \w what|strong="H00834"\w* \w man is|strong="H00120"\w*; \w but he|strong="H01931"\w* \w cannot|strong="H03808"\w* \w contend|strong="H01777"\w* \w with|strong="H05973"\w* \w one stronger|strong="H08630"\w* \w than he|strong="H04480"\w*. \v 11 \w For|strong="H03588"\w* \w the more|strong="H07235"\w* \w words|strong="H01697"\w*, \w the more|strong="H07235"\w* \w futility|strong="H01892"\w* — \w and how|strong="H04100"\w* \w does that profit|strong="H03148"\w* \w anyone|strong="H00120"\w*? \v 12 \w For|strong="H03588"\w* \w who|strong="H04310"\w* \w knows|strong="H03045"\w* \w what|strong="H04100"\w* \w is good|strong="H02896"\w* \w for a man|strong="H00120"\w* \w during the few|strong="H04557"\w* \w days in which|strong="H03117"\w* \w he passes through|strong="H06213"\w* \w his fleeting|strong="H01892"\w* \w life|strong="H02416"\w* \w like a shadow|strong="H06738"\w*? \w Who|strong="H04310"\w* \w can tell|strong="H05046"\w* \w a man|strong="H00120"\w* \w what|strong="H04100"\w* \w will come|strong="H01961"\w* \w after him|strong="H00310"\w* \w under|strong="H08478"\w* \w the sun|strong="H08121"\w*?
\c 7
\s1 The Value of Wisdom
\q1 \v 1 \w A good name|strong="H08034"\w* \w is better|strong="H02896"\w* \w than fine|strong="H02896"\w* \w perfume|strong="H08081"\w*,
\q2 \w and one’s day|strong="H03117"\w* \w of death|strong="H04194"\w* \w is better than his day|strong="H03117"\w* \w of birth|strong="H03205"\w*.
\q1 \v 2 \w It is better|strong="H02896"\w* \w to enter|strong="H01980"\w* \w a house|strong="H01004"\w* \w of mourning|strong="H00060"\w*
\q2 \w than|strong="H01980"\w* \w a house|strong="H01004"\w* \w of feasting|strong="H04960"\w*,
\q1 \w since|strong="H00834"\w* \w death|strong="H01931"\w* \w is the end|strong="H05490"\w* \w of every|strong="H03605"\w* \w man|strong="H00120"\w*,
\q2 \w and the living|strong="H02416"\w* \w should take this|strong="H05414"\w* \w to|strong="H00413"\w* \w heart|strong="H03820"\w*.
\b 
\q1 \v 3 \w Sorrow|strong="H03708"\w* \w is better|strong="H02896"\w* \w than laughter|strong="H07814"\w*,
\q2 \w for|strong="H03588"\w* \w a sad|strong="H07455"\w* \w countenance|strong="H06440"\w* \w is good|strong="H03190"\w* \w for the heart|strong="H03820"\w*.
\q1 \v 4 \w The heart|strong="H03820"\w* \w of the wise|strong="H02450"\w* \w is in the house|strong="H01004"\w* \w of mourning|strong="H00060"\w*,
\q2 \w but the heart|strong="H03820"\w* \w of fools|strong="H03684"\w* \w is in the house|strong="H01004"\w* \w of pleasure|strong="H08057"\w*.
\b 
\q1 \v 5 \w It is better|strong="H02896"\w* \w to heed|strong="H08085"\w* \w a wise man’s|strong="H02450"\w* \w rebuke|strong="H01606"\w*
\q2 \w than|strong="H00376"\w* \w to listen|strong="H08085"\w* \w to the song|strong="H07892"\w* \w of fools|strong="H03684"\w*.
\q1 \v 6 \w For|strong="H03588"\w* \w like the crackling|strong="H06963"\w* \w of thorns|strong="H05518"\w* \w under|strong="H08478"\w* \w the pot|strong="H05518"\w*,
\q2 \w so|strong="H03651"\w* \w is the laughter|strong="H07814"\w* \w of the fool|strong="H03684"\w*. \w This|strong="H02088"\w* \w too|strong="H01571"\w* \w is futile|strong="H01892"\w*.
\b 
\q1 \v 7 \w Surely|strong="H03588"\w* \w extortion|strong="H06233"\w* \w turns a wise man|strong="H02450"\w* \w into a fool|strong="H01984"\w*,
\q2 \w and a bribe|strong="H04979"\w* \w corrupts|strong="H00006"\w* \w the heart|strong="H03820"\w*.
\q1 \v 8 \w The end|strong="H00319"\w* \w of a matter|strong="H01697"\w* \w is better|strong="H02896"\w* \w than the beginning|strong="H07225"\w*,
\q2 \w and a patient|strong="H00750"\w* \w spirit|strong="H07307"\w* \w is better|strong="H02896"\w* \w than a proud|strong="H01364"\w* \w one|strong="H07307"\w*.
\b 
\q1 \v 9 \w Do not|strong="H00408"\w* \w be quickly|strong="H00926"\w* \w provoked|strong="H03707"\w* \w in your spirit|strong="H07307"\w*,
\q2 \w for|strong="H03588"\w* \w anger|strong="H03708"\w* \w settles|strong="H05117"\w* \w in the lap|strong="H02436"\w* \w of a fool|strong="H03684"\w*.\f + \fr 7:9 \ft Hebrew \fqa in the bosom of fools\f*
\q1 \v 10 \w Do not|strong="H00408"\w* \w say|strong="H00559"\w*, “\w Why|strong="H04100"\w* \w were|strong="H01961"\w* \w the old|strong="H07223"\w* \w days|strong="H03117"\w* \w better|strong="H02896"\w* \w than these|strong="H00428"\w*?”
\q2 \w For|strong="H03588"\w* \w it is unwise|strong="H02451"\w* \w of you to ask|strong="H07592"\w* \w about|strong="H05921"\w* \w this|strong="H02088"\w*.
\b 
\q1 \v 11 \w Wisdom|strong="H02451"\w*, \w like|strong="H05973"\w* \w an inheritance|strong="H05159"\w*, \w is good|strong="H02896"\w*,
\q2 \w and it benefits|strong="H03148"\w* \w those who see|strong="H07200"\w* \w the sun|strong="H08121"\w*.
\q1 \v 12 \w For|strong="H03588"\w* \w wisdom|strong="H02451"\w*, \w like money|strong="H03701"\w*, \w is a shelter|strong="H06738"\w*,
\q2 \w and the advantage|strong="H03504"\w* \w of knowledge|strong="H01847"\w*
\q2 \w is that wisdom|strong="H02451"\w* \w preserves the life|strong="H02421"\w* \w of its owner|strong="H01167"\w*.
\b 
\q1 \v 13 \w Consider|strong="H07200"\w* \w the work|strong="H04639"\w* \w of God|strong="H00430"\w*:
\q2 \w Who|strong="H04310"\w* \w can|strong="H03201"\w* \w straighten|strong="H08626"\w* \w what|strong="H00834"\w* \w He has bent|strong="H05791"\w*?
\q1 \v 14 \w In the day|strong="H03117"\w* \w of prosperity|strong="H02896"\w*, \w be|strong="H01961"\w* \w joyful|strong="H02896"\w*,
\q2 \w but in the day|strong="H03117"\w* \w of adversity|strong="H07451"\w*, \w consider this|strong="H07200"\w*:
\q1 \w God|strong="H00430"\w* \w has made|strong="H06213"\w* \w one of these|strong="H02088"\w* \w along with|strong="H05980"\w* \w the other|strong="H02088"\w*,
\q2 \w so that|strong="H05921"\w* \w a man|strong="H00120"\w* \w cannot|strong="H03808"\w* \w discover|strong="H04672"\w*
\q2 \w anything|strong="H03972"\w* \w that will come after him|strong="H00310"\w*.
\s1 The Limits of Human Wisdom
\p \v 15 \w In my futile|strong="H01892"\w* \w life|strong="H03117"\w* \w I have seen|strong="H07200"\w* \w both of these|strong="H03605"\w*:
\b 
\li1 \w A righteous man|strong="H06662"\w* \w perishing|strong="H00006"\w* \w in his righteousness|strong="H06664"\w*,
\li1 \w and|strong="H03426"\w* \w a wicked man|strong="H07563"\w* \w living long|strong="H00748"\w* \w in his wickedness|strong="H07451"\w*.
\p \v 16 \w Do not|strong="H00408"\w* \w be|strong="H01961"\w* \w overly|strong="H07235"\w* \w righteous|strong="H06662"\w*, \w and do not|strong="H00408"\w* \w make yourself too|strong="H03148"\w* \w wise|strong="H02449"\w*. \w Why|strong="H04100"\w* \w should you destroy yourself?|strong="H08074"\w* \v 17 \w Do not|strong="H00408"\w* \w be excessively|strong="H07235"\w* \w wicked|strong="H07561"\w*, \w and do not|strong="H00408"\w* \w be|strong="H01961"\w* \w a fool|strong="H05530"\w*. \w Why|strong="H04100"\w* \w should you die|strong="H04191"\w* \w before|strong="H03808"\w* \w your time|strong="H06256"\w*? \v 18 \w It is good|strong="H02896"\w* \w to grasp|strong="H00270"\w* \w the one|strong="H02088"\w* \w and|strong="H01571"\w* \w not|strong="H00408"\w* \w let the other slip|strong="H05117"\w* \w from|strong="H02088"\w* \w your hand|strong="H03027"\w*. \w For|strong="H03588"\w* \w he who fears|strong="H03373"\w* \w God|strong="H00430"\w* \w will follow|strong="H03318"\w* \w both warnings|strong="H03605"\w*.\f + \fr 7:18 \ft Or \fqa will avoid all extremes\f*
\b 
\q1 \v 19 \w Wisdom|strong="H02451"\w* \w makes the wise man|strong="H02450"\w*
\q2 \w stronger than|strong="H05810"\w* \w ten|strong="H06235"\w* \w rulers|strong="H07989"\w* \w in a city|strong="H05892"\w*.
\q1 \v 20 \w Surely|strong="H03588"\w* \w there is no|strong="H00369"\w* \w righteous|strong="H06662"\w* \w man|strong="H00120"\w* \w on earth|strong="H00776"\w*
\q2 \w who|strong="H00834"\w* \w does|strong="H06213"\w* \w good|strong="H02896"\w* \w and never|strong="H03808"\w* \w sins|strong="H02398"\w*.
\p \v 21 \w Do not|strong="H00408"\w* \w pay|strong="H05414"\w* \w attention|strong="H03820"\w* \w to every|strong="H03605"\w* \w word|strong="H01697"\w* \w that|strong="H00834"\w* \w is spoken|strong="H01696"\w*, \w or|strong="H03808"\w* \w you may hear|strong="H08085"\w* \w your servant|strong="H05650"\w* \w cursing you|strong="H07043"\w*. \v 22 \w For|strong="H03588"\w* \w you know|strong="H03045"\w* \w in your heart|strong="H03820"\w* \w that|strong="H00834"\w* \w many|strong="H07227"\w* \w times|strong="H06471"\w* \w you yourself|strong="H00859"\w* \w have cursed|strong="H07043"\w* \w others|strong="H00312"\w*.
\p \v 23 \w All|strong="H03605"\w* \w this|strong="H02090"\w* \w I tested|strong="H05254"\w* \w by wisdom, saying|strong="H02451"\w*, “\w I resolve|strong="H00559"\w* \w to be wise|strong="H02449"\w*.” \w But it|strong="H01931"\w* \w was beyond|strong="H07350"\w* \w me|strong="H04480"\w*. \v 24 \w What|strong="H04100"\w* \w exists|strong="H01961"\w* \w is out of reach|strong="H07350"\w* \w and very deep|strong="H06013"\w*. \w Who|strong="H04310"\w* \w can fathom it|strong="H04672"\w*?
\p \v 25 \w I|strong="H00589"\w* \w directed|strong="H05437"\w* \w my mind|strong="H03820"\w* \w to understand|strong="H03045"\w*, \w to explore|strong="H08446"\w*, \w to search out|strong="H01245"\w* \w wisdom|strong="H02451"\w* \w and explanations|strong="H02808"\w*, \w and to understand|strong="H03045"\w* \w the stupidity|strong="H03689"\w* \w of wickedness|strong="H07562"\w* \w and the folly|strong="H05531"\w* \w of madness|strong="H01947"\w*. \v 26 \w And I|strong="H00589"\w* \w find|strong="H04672"\w* \w more bitter|strong="H04751"\w* \w than death|strong="H04194"\w* \w the woman|strong="H00802"\w* \w who|strong="H00834"\w* \w is a snare|strong="H04685"\w*, \w whose heart|strong="H03820"\w* \w is a net|strong="H02764"\w*, \w and whose hands|strong="H03027"\w* \w are chains|strong="H00612"\w*. \w The man who pleases|strong="H02896"\w* \w God|strong="H00430"\w* \w escapes|strong="H04422"\w* \w her|strong="H04480"\w*, \w but the sinner|strong="H02398"\w* \w is ensnared|strong="H03920"\w*.
\p \v 27 “\w Behold|strong="H07200"\w*,” \w says|strong="H00559"\w* \w the Teacher|strong="H06953"\w*, “\w I have discovered|strong="H04672"\w* \w this|strong="H02088"\w* \w by adding one|strong="H00259"\w* \w thing to another|strong="H00259"\w* \w to find|strong="H04672"\w* \w an explanation|strong="H02808"\w*. \v 28 \w While|strong="H00834"\w* \w my soul|strong="H05315"\w* \w was still|strong="H05750"\w* \w searching|strong="H01245"\w* \w but not|strong="H03808"\w* \w finding|strong="H04672"\w*, \w among a thousand|strong="H00505"\w* \w I have found|strong="H04672"\w* \w one|strong="H00259"\w* \w upright man|strong="H00120"\w*, \w but among all|strong="H03605"\w* \w these|strong="H00428"\w* \w I have not|strong="H03808"\w* \w found|strong="H04672"\w* \w one such woman|strong="H00802"\w*. \v 29 \w Only|strong="H00905"\w* \w this|strong="H02088"\w* \w have I found|strong="H07200"\w*: \w I have discovered|strong="H04672"\w* \w that|strong="H00834"\w* \w God|strong="H00430"\w* \w made|strong="H06213"\w* \w mankind|strong="H00120"\w* \w upright|strong="H03477"\w*, \w but they|strong="H01992"\w* \w have sought out|strong="H01245"\w* \w many|strong="H07227"\w* \w schemes|strong="H02810"\w*.”
\c 8
\s1 Obey the King
\q1 
\p \v 1 \w Who|strong="H04310"\w* \w is like the wise man|strong="H02450"\w*? \w Who|strong="H04310"\w* \w knows|strong="H03045"\w* \w the interpretation|strong="H06592"\w* \w of a matter|strong="H01697"\w*? \w A man’s|strong="H00120"\w* \w wisdom|strong="H02451"\w* \w brightens|strong="H00215"\w* \w his face|strong="H06440"\w*, \w and the sternness|strong="H05797"\w* \w of his face|strong="H06440"\w* \w is changed|strong="H08132"\w*.
\p \v 2 \w Keep|strong="H08104"\w* \w the king’s|strong="H04428"\w* \w command|strong="H06310"\w*, \w I say|strong="H00589"\w*, \w because of|strong="H05921"\w* \w your oath|strong="H07621"\w* \w before God|strong="H00430"\w*. \v 3 \w Do not|strong="H00408"\w* \w hasten|strong="H00926"\w* \w to leave|strong="H01980"\w* \w his presence|strong="H06440"\w*, \w and do not|strong="H00408"\w* \w persist|strong="H05975"\w* \w in a bad|strong="H07451"\w* \w cause|strong="H01697"\w*, \w for|strong="H03588"\w* \w he will do|strong="H06213"\w* \w whatever|strong="H03605"\w* \w he pleases|strong="H02654"\w*. \v 4 \w For|strong="H00834"\w* \w the king’s|strong="H04428"\w* \w word|strong="H01697"\w* \w is supreme|strong="H07983"\w*, \w and who|strong="H04310"\w* \w can say|strong="H00559"\w* to him, “\w What|strong="H04100"\w* \w are you doing|strong="H06213"\w*?”
\p \v 5 \w Whoever keeps|strong="H08104"\w* \w his command|strong="H04687"\w* \w will come to|strong="H03045"\w* \w no|strong="H03808"\w* \w harm|strong="H07451"\w*, \w and a wise|strong="H02450"\w* \w heart|strong="H03820"\w* \w knows|strong="H03045"\w* \w the right time|strong="H06256"\w* \w and procedure|strong="H04941"\w*. \v 6 \w For|strong="H03588"\w* \w there is|strong="H03426"\w* \w a right time|strong="H06256"\w* \w and procedure|strong="H04941"\w* \w to every|strong="H03605"\w* \w purpose|strong="H02656"\w*, \w though|strong="H03588"\w* \w a man’s|strong="H00120"\w* \w misery|strong="H07451"\w* \w weighs heavily|strong="H07227"\w* \w upon him|strong="H05921"\w*. \v 7 \w Since|strong="H03588"\w* \w no one|strong="H00369"\w* \w knows|strong="H03045"\w* \w what|strong="H04100"\w* \w will happen|strong="H01961"\w*, \w who|strong="H04310"\w* \w can tell|strong="H05046"\w* him \w what|strong="H00834"\w* \w is to come|strong="H01961"\w*?
\p \v 8 \w As no|strong="H00369"\w* \w man|strong="H00120"\w* \w has power|strong="H07989"\w* \w over the wind|strong="H07307"\w* \w to contain|strong="H03607"\w* \w it|strong="H07307"\w*, \w so no one|strong="H00369"\w* \w has authority|strong="H07983"\w* \w over his day|strong="H03117"\w* \w of death|strong="H04194"\w*. \w As no one|strong="H00369"\w* \w can be discharged|strong="H04917"\w* \w in wartime|strong="H04421"\w*, \w so wickedness|strong="H07562"\w* \w will not|strong="H03808"\w* \w release|strong="H04422"\w* \w those who practice it|strong="H01167"\w*. \v 9 \w All|strong="H03605"\w* \w this|strong="H02088"\w* \w I have seen|strong="H07200"\w*, \w applying|strong="H05414"\w* \w my mind|strong="H03820"\w* \w to every|strong="H03605"\w* \w deed|strong="H04639"\w* \w that|strong="H00834"\w* \w is done|strong="H06213"\w* \w under|strong="H08478"\w* \w the sun|strong="H08121"\w*; \w there is a time|strong="H06256"\w* \w when|strong="H00834"\w* \w one man|strong="H00120"\w* \w lords it|strong="H07980"\w* \w over another|strong="H00120"\w* \w to his own detriment|strong="H07451"\w*.
\s1 Fear God
\r (Isaiah 8:11–15)
\p \v 10 \w Then too|strong="H03651"\w*, \w I saw|strong="H07200"\w* \w the burial|strong="H06912"\w* \w of the wicked|strong="H07563"\w* \w who used to go in|strong="H00935"\w* \w and out|strong="H01980"\w* \w of the holy|strong="H06918"\w* \w place|strong="H04725"\w*, \w and they were praised|strong="H07911"\w*\f + \fr 8:10 \ft Some Hebrew manuscripts, LXX, and Vulgate; most Hebrew manuscripts \fqa were soon forgotten\f* \w in the city|strong="H05892"\w* \w where|strong="H00834"\w* \w they had done|strong="H06213"\w* \w so|strong="H03651"\w*. \w This|strong="H02088"\w* \w too|strong="H01571"\w* \w is futile|strong="H01892"\w*. \v 11 \w When|strong="H00834"\w* \w the sentence|strong="H06599"\w* \w for a crime|strong="H07451"\w* \w is not|strong="H00369"\w* \w speedily|strong="H04120"\w* \w executed|strong="H06213"\w*, \w the hearts|strong="H03820"\w* \w of men|strong="H00120"\w* \w become fully set|strong="H04390"\w* \w on doing|strong="H06213"\w* \w evil|strong="H07451"\w*.
\p \v 12 \w Although|strong="H00834"\w* \w a sinner|strong="H02398"\w* \w does|strong="H06213"\w* \w evil|strong="H07451"\w* \w a hundred times|strong="H03967"\w* \w and still lives long|strong="H00748"\w*, \w yet|strong="H03588"\w* \w I|strong="H00589"\w* \w also|strong="H01571"\w* \w know|strong="H03045"\w* \w that|strong="H00834"\w* \w it will go|strong="H01961"\w* \w well|strong="H02896"\w* \w with those who|strong="H00834"\w* \w fear|strong="H03372"\w* \w God|strong="H00430"\w*, \w who are reverent|strong="H03373"\w* \w in His presence|strong="H06440"\w*. \v 13 \w Yet because|strong="H00834"\w* \w the wicked do not|strong="H00369"\w* \w fear|strong="H03373"\w* \w God|strong="H00430"\w*, \w it will not|strong="H03808"\w* \w go|strong="H01961"\w* \w well|strong="H02896"\w* \w with them|strong="H07563"\w*, \w and their days|strong="H03117"\w* \w will not|strong="H03808"\w* \w lengthen|strong="H00748"\w* \w like a shadow|strong="H06738"\w*.
\s1 God’s Ways Are Mysterious
\p \v 14 \w There is|strong="H03426"\w* \w a futility|strong="H01892"\w* \w that|strong="H00834"\w* \w is done|strong="H06213"\w* \w on|strong="H05921"\w* \w the earth|strong="H00776"\w*: \w There are|strong="H03426"\w* \w righteous men|strong="H06662"\w* \w who|strong="H00834"\w* \w get|strong="H05060"\w* \w what the actions|strong="H04639"\w* \w of the wicked deserve|strong="H07563"\w*, \w and there are|strong="H03426"\w* \w wicked men|strong="H07563"\w* \w who|strong="H00413"\w* \w get|strong="H05060"\w* \w what the actions|strong="H04639"\w* \w of the righteous deserve|strong="H06662"\w*. \w I say|strong="H00559"\w* \w that this|strong="H02088"\w* \w too|strong="H01571"\w* \w is futile|strong="H01892"\w*.
\p \v 15 \w So I|strong="H00589"\w* \w commended|strong="H07623"\w* \w the enjoyment of life|strong="H08057"\w*, \w because|strong="H00834"\w* \w there is nothing|strong="H00369"\w* \w better|strong="H02896"\w* \w for a man|strong="H00120"\w* \w under|strong="H08478"\w* \w the sun|strong="H08121"\w* \w than|strong="H03588"\w* \w to eat|strong="H00398"\w* \w and drink|strong="H08354"\w* \w and be merry|strong="H08055"\w*. \w For this joy|strong="H01931"\w* \w will accompany him|strong="H03867"\w* \w in his labor|strong="H05999"\w* \w during the days|strong="H03117"\w* \w of his life|strong="H02416"\w* \w that|strong="H00834"\w* \w God|strong="H00430"\w* \w gives|strong="H05414"\w* him \w under|strong="H08478"\w* \w the sun|strong="H08121"\w*.
\p \v 16 \w When|strong="H00834"\w* \w I applied|strong="H05414"\w* \w my mind|strong="H03820"\w* \w to know|strong="H03045"\w* \w wisdom|strong="H02451"\w* \w and to observe|strong="H07200"\w* \w the task|strong="H06045"\w* \w that|strong="H00834"\w* \w one performs|strong="H06213"\w* \w on|strong="H05921"\w* \w the earth|strong="H00776"\w* — \w though|strong="H03588"\w* \w his eyes|strong="H05869"\w* \w do not|strong="H00369"\w* \w see|strong="H07200"\w* \w sleep|strong="H08142"\w* \w in the day|strong="H03117"\w* \w or even in the night|strong="H03915"\w* — \v 17 \w I saw|strong="H07200"\w* \w every|strong="H03605"\w* \w work|strong="H04639"\w* \w of God|strong="H00430"\w*, \w and that|strong="H03588"\w* \w a man|strong="H00120"\w* \w is unable|strong="H03808"\w* \w to comprehend|strong="H04672"\w* \w the work|strong="H04639"\w* \w that|strong="H00834"\w* \w is done|strong="H06213"\w* \w under|strong="H08478"\w* \w the sun|strong="H08121"\w*. Despite \w his|strong="H00120"\w* \w efforts|strong="H05998"\w* \w to search it out|strong="H01245"\w*, \w he cannot|strong="H03808"\w* \w find its meaning|strong="H04672"\w*; \w even|strong="H01571"\w* \w if|strong="H00518"\w* \w the wise|strong="H02450"\w* \w man claims|strong="H00559"\w* \w to know|strong="H03045"\w*, \w he is unable|strong="H03808"\w* \w to comprehend|strong="H04672"\w*.
\c 9
\s1 Death Comes to Good and Bad
\p \v 1 \w So|strong="H03588"\w* \w I took|strong="H05414"\w* \w all|strong="H03605"\w* \w this|strong="H02088"\w* \w to|strong="H00413"\w* \w heart|strong="H03820"\w* \w and concluded|strong="H00952"\w* \w that|strong="H00834"\w* \w the righteous|strong="H06662"\w* \w and the wise|strong="H02450"\w*, \w as well as their deeds|strong="H05652"\w*, \w are in God’s|strong="H00430"\w* \w hands|strong="H03027"\w*. \w Man|strong="H00120"\w* \w does not|strong="H00369"\w* \w know|strong="H03045"\w* \w what|strong="H03605"\w* \w lies ahead|strong="H06440"\w*, \w whether|strong="H01571"\w* \w love|strong="H00160"\w* \w or|strong="H01571"\w* \w hate|strong="H08135"\w*.
\p \v 2 \w It is the same|strong="H00834"\w* \w for all|strong="H03605"\w*: \w There is a common|strong="H00259"\w* \w fate|strong="H04745"\w* \w for the righteous|strong="H06662"\w* \w and the wicked|strong="H07563"\w*, \w for the good and the bad|strong="H02896"\w*,\f + \fr 9:2 \ft LXX, Syriac, and Vulgate; Hebrew does not include \fqa and the bad\ft .\f* \w for the clean|strong="H02889"\w* \w and the unclean|strong="H02931"\w*, \w for the one who sacrifices|strong="H02076"\w* \w and the one|strong="H00834"\w* \w who does not|strong="H00369"\w*. \w As it is for the good|strong="H02896"\w*, \w so it is for the sinner|strong="H02398"\w*; \w as it is for the one who makes a vow|strong="H07650"\w*, \w so it is|strong="H00834"\w* \w for the one who refuses|strong="H03373"\w* \w to take a vow|strong="H07621"\w*.
\p \v 3 \w This|strong="H02088"\w* \w is an evil|strong="H07451"\w* \w in everything|strong="H03605"\w* \w that|strong="H00834"\w* \w is done|strong="H06213"\w* \w under|strong="H08478"\w* \w the sun|strong="H08121"\w*: \w There is one|strong="H00259"\w* \w fate|strong="H04745"\w* \w for everyone|strong="H03605"\w*. \w Furthermore|strong="H01571"\w*, \w the hearts|strong="H03820"\w* \w of men|strong="H01121"\w* \w are full of|strong="H04392"\w* \w evil|strong="H07451"\w* \w and madness|strong="H01947"\w* \w while they are alive|strong="H02416"\w*, \w and afterward|strong="H00310"\w* \w they join|strong="H00413"\w* \w the dead|strong="H04191"\w*.
\p \v 4 \w There is|strong="H03426"\w* \w hope|strong="H00986"\w*, \w however|strong="H03588"\w*, \w for anyone who|strong="H04310"\w* \w is among|strong="H00977"\w* \w the living|strong="H02416"\w*; \w for even|strong="H03588"\w* \w a live|strong="H02416"\w* \w dog|strong="H03611"\w* \w is better|strong="H02896"\w* \w than|strong="H04480"\w* \w a dead|strong="H04191"\w* \w lion|strong="H00738"\w*. \v 5 \w For|strong="H03588"\w* \w the living|strong="H02416"\w* \w know|strong="H03045"\w* \w that they will die|strong="H04191"\w*, \w but the dead|strong="H04191"\w* \w know|strong="H03045"\w* \w nothing|strong="H03972"\w*. \w They have no|strong="H00369"\w* \w further|strong="H05750"\w* \w reward|strong="H07939"\w*, \w because|strong="H03588"\w* \w the memory|strong="H02143"\w* \w of them is forgotten|strong="H07911"\w*. \v 6 \w Their love|strong="H00160"\w*, \w their hate|strong="H08135"\w*, \w and|strong="H01571"\w* \w their envy|strong="H07068"\w* \w have already|strong="H03528"\w* \w vanished|strong="H00006"\w*, \w and they will never again have|strong="H00369"\w* \w a share|strong="H02506"\w* \w in all|strong="H03605"\w* \w that|strong="H00834"\w* \w is done|strong="H06213"\w* \w under|strong="H08478"\w* \w the sun|strong="H08121"\w*.
\s1 Enjoy Your Portion in This Life
\q1 
\p \v 7 \w Go|strong="H01980"\w*, \w eat|strong="H00398"\w* \w your bread|strong="H03899"\w* \w with joy|strong="H08057"\w*, \w and drink|strong="H08354"\w* \w your wine|strong="H03196"\w* \w with a cheerful|strong="H02896"\w* \w heart|strong="H03820"\w*, \w for|strong="H03588"\w* \w God|strong="H00430"\w* \w has already|strong="H03528"\w* \w approved|strong="H07521"\w* \w your works|strong="H04639"\w*:
