\q1 \v 8 “\w Futility|strong="H01892"\w* \w of futilities|strong="H01892"\w*,” \w says|strong="H00559"\w* \w the Teacher|strong="H06953"\w*.
\q2 “\w Everything|strong="H03605"\w* \w is futile|strong="H01892"\w*!”
\s1 The Whole Duty of Man
\p \v 9 \w Not only|strong="H03148"\w* \w was|strong="H01961"\w* \w the Teacher|strong="H06953"\w* \w wise|strong="H02450"\w*, \w but he also|strong="H05750"\w* \w taught|strong="H03925"\w* \w the people|strong="H05971"\w* \w knowledge|strong="H01847"\w*; \w he pondered|strong="H00239"\w*, \w searched out|strong="H02713"\w*, \w and arranged|strong="H08626"\w* \w many|strong="H07235"\w* \w proverbs|strong="H04912"\w*. \v 10 \w The Teacher|strong="H06953"\w* \w searched|strong="H01245"\w* \w to find|strong="H04672"\w* \w delightful|strong="H02656"\w* \w sayings|strong="H01697"\w* \w and to record|strong="H03789"\w* \w accurate|strong="H03476"\w* \w words|strong="H01697"\w* \w of truth|strong="H00571"\w*.\f + \fr 12:10 \ft Or \fqa and sought to write what was upright and true\f*
\p \v 11 \w The words|strong="H01697"\w* \w of the wise|strong="H02450"\w* \w are like goads|strong="H01861"\w*, \w and the anthologies|strong="H00627"\w* \w of the masters|strong="H01167"\w* \w are like firmly embedded|strong="H05193"\w* \w nails|strong="H04930"\w* \w driven|strong="H05414"\w* \w by a single|strong="H00259"\w* \w Shepherd|strong="H07462"\w*.\f + \fr 12:11 \ft Or \fqa shepherd\f* \v 12 And by these, \w my son|strong="H01121"\w*, \w be further|strong="H03148"\w* \w warned|strong="H02094"\w*: \w There is no|strong="H00369"\w* \w end|strong="H07093"\w* \w to the making|strong="H06213"\w* \w of many|strong="H07235"\w* \w books|strong="H05612"\w*, \w and much|strong="H07235"\w* \w study|strong="H03854"\w* \w wearies|strong="H03024"\w* \w the body|strong="H01320"\w*.
\p \v 13 \w When all|strong="H03605"\w* \w has been heard|strong="H08085"\w*, \w the conclusion|strong="H05490"\w* \w of the matter is this|strong="H01697"\w*: \w Fear|strong="H03372"\w* \w God|strong="H00430"\w* \w and|strong="H00853"\w* \w keep|strong="H08104"\w* \w His commandments|strong="H04687"\w*, \w because|strong="H03588"\w* \w this is|strong="H02088"\w* \w the whole duty|strong="H03605"\w* \w of man|strong="H00120"\w*. \v 14 \w For|strong="H03588"\w* \w God|strong="H00430"\w* \w will bring|strong="H00935"\w* \w every|strong="H03605"\w* \w deed|strong="H04639"\w* \w into judgment|strong="H04941"\w*, \w along with|strong="H05921"\w* \w every hidden|strong="H05956"\w* \w thing|strong="H03605"\w*, \w whether|strong="H00518"\w* \w good|strong="H02896"\w* \w or|strong="H00518"\w* \w evil|strong="H07451"\w*.
