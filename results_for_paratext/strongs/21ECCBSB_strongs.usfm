\q2 \w and never|strong="H00408"\w* \w spare|strong="H02637"\w* \w the oil|strong="H08081"\w* \w for|strong="H05921"\w* \w your head|strong="H07218"\w*.
\p \v 9 \w Enjoy|strong="H07200"\w* \w life|strong="H02416"\w* \w with|strong="H05973"\w* \w your beloved|strong="H00157"\w* \w wife|strong="H00802"\w* \w all|strong="H03605"\w* \w the days|strong="H03117"\w* \w of the fleeting|strong="H01892"\w*\f + \fr 9:9 \ft Or \fqa futile\ft ; twice in this verse\f* \w life|strong="H02416"\w* \w that|strong="H00834"\w* \w God has given|strong="H05414"\w* you \w under|strong="H08478"\w* \w the sun|strong="H08121"\w* — \w all|strong="H03605"\w* \w your fleeting|strong="H01892"\w* \w days|strong="H03117"\w*. \w For|strong="H03588"\w* \w this|strong="H01931"\w* \w is your portion|strong="H02506"\w* \w in life|strong="H02416"\w* \w and in your labor|strong="H05999"\w* \w under|strong="H08478"\w* \w the sun|strong="H08121"\w*. \v 10 \w Whatever|strong="H03605"\w* \w you find|strong="H04672"\w* \w to do|strong="H06213"\w* \w with your hands|strong="H03027"\w*, \w do it|strong="H06213"\w* \w with all your might|strong="H03581"\w*, \w for|strong="H03588"\w* \w in Sheol|strong="H07585"\w*, \w where|strong="H00834"\w* \w you|strong="H00859"\w* \w are going|strong="H01980"\w*, \w there is|strong="H08033"\w* \w no|strong="H00369"\w* \w work|strong="H04639"\w* \w or planning|strong="H02808"\w* \w or knowledge|strong="H01847"\w* \w or wisdom|strong="H02451"\w*.
\p \v 11 \w I saw|strong="H07200"\w* \w something else|strong="H07725"\w* \w under|strong="H08478"\w* \w the sun|strong="H08121"\w*: \w The race|strong="H04793"\w* \w is not|strong="H03808"\w* \w to the swift|strong="H07031"\w*, \w nor the battle|strong="H04421"\w* \w to the strong|strong="H01368"\w*; \w neither is|strong="H03808"\w* \w the bread|strong="H03899"\w* \w to the wise|strong="H02450"\w*, \w nor|strong="H01571"\w* \w the wealth|strong="H06239"\w* \w to the intelligent|strong="H00995"\w*, \w nor|strong="H01571"\w* \w the favor|strong="H02580"\w* \w to the skillful|strong="H03045"\w*. \w For|strong="H03588"\w* \w time|strong="H06256"\w* \w and chance|strong="H06294"\w* \w happen|strong="H07136"\w* \w to all|strong="H03605"\w*. \v 12 \w For|strong="H03588"\w* \w surely|strong="H01571"\w* \w no|strong="H03808"\w* \w man|strong="H00120"\w* \w knows|strong="H03045"\w* \w his time|strong="H06256"\w*: \w Like fish|strong="H01709"\w* \w caught|strong="H00270"\w* \w in a cruel|strong="H07451"\w* \w net|strong="H04685"\w* \w or birds|strong="H06833"\w* \w trapped|strong="H00270"\w* \w in a snare|strong="H06341"\w*, \w so men|strong="H01121"\w* \w are ensnared|strong="H03369"\w* \w in an evil|strong="H07451"\w* \w time|strong="H06256"\w* \w that suddenly|strong="H06597"\w* \w falls|strong="H05307"\w* \w upon them|strong="H05921"\w*.
\s1 Wisdom Is Better than Strength
\p \v 13 \w I have also seen|strong="H07200"\w* \w this|strong="H02090"\w* \w wisdom|strong="H02451"\w* \w under|strong="H08478"\w* \w the sun|strong="H08121"\w*, \w and it|strong="H01931"\w* \w was great|strong="H01419"\w* \w to me|strong="H00413"\w*: \v 14 \w There was a small|strong="H06996"\w* \w city|strong="H05892"\w* \w with few|strong="H04592"\w* \w men|strong="H00582"\w*. \w A mighty|strong="H01419"\w* \w king|strong="H04428"\w* \w came|strong="H00935"\w* \w against it|strong="H00413"\w*, \w surrounded it|strong="H05437"\w*, \w and built|strong="H01129"\w* \w large|strong="H01419"\w* \w siege ramps|strong="H04685"\w* \w against it|strong="H05921"\w*.
\p \v 15 \w Now a poor|strong="H04542"\w* \w wise|strong="H02450"\w* \w man|strong="H00376"\w* \w was found|strong="H04672"\w* in the city, \w and he|strong="H01931"\w* \w saved|strong="H04422"\w* \w the city|strong="H05892"\w* \w by his wisdom|strong="H02451"\w*. \w Yet no|strong="H03808"\w* \w one|strong="H00120"\w* \w remembered|strong="H02142"\w* \w that|strong="H01931"\w* \w poor|strong="H04542"\w* \w man|strong="H00376"\w*. \v 16 \w And I|strong="H00589"\w* \w said|strong="H00559"\w*, “\w Wisdom|strong="H02451"\w* \w is better|strong="H02896"\w* \w than strength|strong="H01369"\w*, \w but the wisdom|strong="H02451"\w* \w of the poor|strong="H04542"\w* \w man is despised|strong="H00959"\w*, \w and his words|strong="H01697"\w* \w are not|strong="H00369"\w* \w heeded|strong="H08085"\w*.”
\b 
\q1 \v 17 \w The calm|strong="H05183"\w* \w words|strong="H01697"\w* \w of the wise|strong="H02450"\w* \w are heeded|strong="H08085"\w*
\q2 \w over the shouts|strong="H02201"\w* \w of a ruler|strong="H04910"\w* \w among fools|strong="H03684"\w*.
