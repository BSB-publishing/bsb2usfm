\p \v 1 \w Again I looked|strong="H07725"\w*, \w and I|strong="H00589"\w* \w considered|strong="H07200"\w* \w all|strong="H03605"\w* \w the oppression|strong="H06217"\w* \w taking place|strong="H06213"\w* \w under|strong="H08478"\w* \w the sun|strong="H08121"\w*. \w I saw|strong="H02009"\w* \w the tears|strong="H01832"\w* \w of the oppressed|strong="H06217"\w*, \w and they had no|strong="H00369"\w* \w comforter|strong="H05162"\w*; \w the power lay|strong="H03581"\w* \w in the hands|strong="H03027"\w* \w of their oppressors|strong="H06231"\w*, \w and there was no|strong="H00369"\w* \w comforter|strong="H05162"\w*. \v 2 \w So I|strong="H00589"\w* \w admired|strong="H07623"\w* \w the dead|strong="H04191"\w*, \w who had already|strong="H03528"\w* \w died|strong="H04191"\w*, \w above|strong="H04480"\w* \w the living|strong="H02416"\w*, \w who|strong="H00834"\w* \w are still|strong="H05728"\w* \w alive|strong="H02416"\w*. \v 3 \w But better|strong="H02896"\w* \w than both|strong="H08147"\w* \w is he who|strong="H00834"\w* \w has not|strong="H03808"\w* \w yet|strong="H05728"\w* \w existed|strong="H01961"\w*, \w who|strong="H00834"\w* \w has not|strong="H03808"\w* \w seen|strong="H07200"\w* \w the evil|strong="H07451"\w* \w that|strong="H00834"\w* \w is done|strong="H06213"\w* \w under|strong="H08478"\w* \w the sun|strong="H08121"\w*.
