\p \v 7 \w Again|strong="H07725"\w*, \w I|strong="H00589"\w* \w saw|strong="H07200"\w* \w futility|strong="H01892"\w* \w under|strong="H08478"\w* \w the sun|strong="H08121"\w*. \v 8 \w There is|strong="H03426"\w* \w a|strong="H00259"\w* \w man all alone|strong="H00369"\w*, \w without|strong="H00369"\w* \w even|strong="H01571"\w* \w a son|strong="H01121"\w* \w or brother|strong="H00251"\w*. \w And though there is no|strong="H00369"\w* \w end|strong="H07093"\w* \w to his labor|strong="H05999"\w*, \w his eyes|strong="H05869"\w* \w are still|strong="H01571"\w* \w not|strong="H03808"\w* \w content|strong="H07646"\w* \w with his wealth|strong="H06239"\w*: “\w For whom|strong="H04310"\w* \w do I|strong="H00589"\w* \w toil|strong="H06001"\w* \w and bereave|strong="H02637"\w* \w my soul|strong="H05315"\w* \w of enjoyment|strong="H02896"\w*?” \w This|strong="H02088"\w* \w too|strong="H01571"\w* \w is futile|strong="H01892"\w* — \w a miserable|strong="H07451"\w* \w task|strong="H06045"\w*.
